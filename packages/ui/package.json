{
  "name": "@ink/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./browser.ts": "./src/browser.ts",
    "./controller.ts": "./src/controller.ts",
    "./headless.ts": "./src/headless.ts",
    "./layout.ts": "./src/layout.ts",
    "./localization.ts": "./src/localization.ts",
    "./migration.ts": "./src/migration.ts",
    "./semantic.ts": "./src/semantic.ts"
  },
  "scripts": {
    "bench": "deno bench --config ../../deno.json src/*_bench.ts",
    "check": "deno check --config ../../deno.json src/*.ts",
    "test": "deno test --config ../../deno.json src/*_test.ts"
  },
  "dependencies": {
    "@ink/assets": "workspace:*",
    "@ink/input": "workspace:*",
    "@ink/localization": "workspace:*",
    "@ink/math": "workspace:*",
    "@ink/observability": "workspace:*",
    "@ink/runtime": "workspace:*",
    "@ink/scene": "workspace:*"
  }
