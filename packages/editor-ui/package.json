{
  "name": "@ink/editor-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./collections.tsx": "./src/collections.tsx",
    "./controls.tsx": "./src/controls.tsx",
    "./graph.tsx": "./src/graph.tsx",
    "./layout.tsx": "./src/layout.tsx",
    "./states.tsx": "./src/states.tsx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "check": "deno check --config ../../deno.json src/*.ts src/*.tsx",
