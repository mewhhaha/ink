{
  "name": "@ink/procedural",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./experimental/biome.ts": "./src/experimental/biome.ts",
    "./experimental/heightfield.ts": "./src/experimental/heightfield.ts",
    "./experimental/marching.ts": "./src/experimental/marching.ts",
    "./experimental/noise.ts": "./src/experimental/noise.ts",
    "./experimental/sdf.ts": "./src/experimental/sdf.ts",
    "./identity.ts": "./src/identity.ts",
    "./recipe.ts": "./src/recipe.ts",
    "./scatter.ts": "./src/scatter.ts"
  },
  "scripts": {
    "bench": "deno bench --config ../../deno.json src/*_bench.ts",
