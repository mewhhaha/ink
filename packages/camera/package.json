{
  "name": "@ink/camera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "bench": "deno bench --config ../../deno.json src/*_bench.ts",
    "check": "deno check --config ../../deno.json src/*.ts",
    "test": "deno test --config ../../deno.json src/*_test.ts"
  },
  "dependencies": {
    "@ink/geometry": "workspace:*",
    "@ink/input": "workspace:*",
    "@ink/math": "workspace:*",
    "@ink/observability": "workspace:*",
    "@ink/scene": "workspace:*"
  }
}
