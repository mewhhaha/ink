{
  "name": "@ink/camera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./experimental/controllers.ts": "./src/experimental/controllers.ts",
    "./experimental/xr.ts": "./src/experimental/xr.ts",
    "./model.ts": "./src/model.ts",
    "./view.ts": "./src/view.ts"
  },
  "scripts": {
