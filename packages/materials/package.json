{
  "name": "@ink/materials",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./canonical.ts": "./src/canonical.ts",
    "./color.ts": "./src/color.ts",
    "./experimental/import.ts": "./src/experimental/import.ts",
    "./experimental/library.ts": "./src/experimental/library.ts",
    "./experimental/reference.ts": "./src/experimental/reference.ts",
    "./identity.ts": "./src/identity.ts",
    "./texture.ts": "./src/texture.ts"
  },
  "scripts": {
    "bench": "deno bench --config ../../deno.json src/*_bench.ts",
    "check": "deno check --config ../../deno.json src/*.ts src/experimental/*.ts",
    "test": "deno test --config ../../deno.json src/*_test.ts"
  },
  "dependencies": {
    "@ink/assets": "workspace:*",
    "@ink/math": "workspace:*",
    "@ink/observability": "workspace:*"
  },
  "ink": {
