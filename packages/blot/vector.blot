open {} = (@import "./prelude.blot") ();

const M = (@import "./math.blot") ();

const vec3 = fn (x, y, z) => { .x = x; .y = y; .z = z; };
const zero = vec3 (0, 0, 0);
const one = vec3 (M.fixed, M.fixed, M.fixed);

const add = fn (left, right) => vec3 (
  left.x + right.x,
  left.y + right.y,
  left.z + right.z
);

const subtract = fn (left, right) => vec3 (
  left.x - right.x,
  left.y - right.y,
  left.z - right.z
);

const scale = fn (vector, factor) => vec3 (
  M.fixed_mul (vector.x, factor),
  M.fixed_mul (vector.y, factor),
  M.fixed_mul (vector.z, factor)
);

const dot = fn (left, right) =>
  M.fixed_mul (left.x, right.x)
  + M.fixed_mul (left.y, right.y)
  + M.fixed_mul (left.z, right.z);

const length_squared = fn vector => dot (vector, vector);

const lerp = fn (start, finish, amount) => vec3 (
  M.fixed_lerp (start.x, finish.x, amount),
  M.fixed_lerp (start.y, finish.y, amount),
  M.fixed_lerp (start.z, finish.z, amount)
);

return {
  .vec3 = vec3;
  .zero = zero;
  .one = one;
  .add = add;
  .subtract = subtract;
  .scale = scale;
  .dot = dot;
  .length_squared = length_squared;
  .lerp = lerp;
};
