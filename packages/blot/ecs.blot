open {} = (@import "./prelude.blot") ();

const Engine = (@import "./engine.blot") ();
const Cells = Engine.Cells;

const EcsSchema = @effect.host {
  .world = {
    .base = Int;
    .capacity = Int;
    .component_base = Int;
    .component_capacity = Int;
    .component_stride = Int;
    .entity_metadata_base = Int;
    .entity_mode = Int;
    .max_fields = Int;
  } -> Unit;
  .component = {
    .field_count = Int;
    .id = Int;
    .name = Str;
  } -> Unit;
  .seed_indexed = {
    .component = Int;
    .source = Str;
    .world_base = Int;
  } -> Unit;
};

const maximum_component_fields = 8;
const next_entity_cell = 0;
const free_entity_cell = 1;
const world_header_width = 2;
const entity_metadata_width = 3;
const entity_alive_field = 0;
const entity_generation_field = 1;
const entity_next_free_field = 2;
const dynamic_entity_mode = 0;
const indexed_entity_mode = 1;

const cells = fn (a, b, c, d, e, f, g, h) => {
  .a = a;
  .b = b;
  .c = c;
  .d = d;
  .e = e;
  .f = f;
  .g = g;
  .h = h;
};

const validate_component = fn (definition, expected_fields) => do
  let field_names = @shape.names definition.fields;
  let field_count = @array.len field_names;
  let integer_fields = every (field_names, (fn name =>
    refines (@shape.get definition.fields name, Int)
      && refines (Int, @shape.get definition.fields name)
  ));
  let _ = expect (field_count == expected_fields, Text.append
    (Text.append "ECS component " definition.name)
    (Text.append " must declare exactly " (Text.append
      (Text.of_int expected_fields)
      " fields"
    ))
  );
  let _ = expect (integer_fields, Text.append
    (Text.append "ECS component " definition.name)
    " fields must be Int"
  );
  in ()
end;

// Passing the positional projection through one generic factory leaves a
// dynamic shape operation in residual Wasm. Each arity therefore owns the
// destructuring that the compiler can erase completely.
const component_1 = fn definition => do
  let _ = validate_component (definition, 1);
  in {
    .pack = fn value => cells (value, 0, 0, 0, 0, 0, 0, 0);
    .ecs = { .field_count = 1; .name = definition.name; };
  }
end;

const component_2 = fn definition => do
  let _ = validate_component (definition, 2);
  in {
    .pack = fn (a, b) => cells (a, b, 0, 0, 0, 0, 0, 0);
    .ecs = { .field_count = 2; .name = definition.name; };
  }
end;

const component_3 = fn definition => do
  let _ = validate_component (definition, 3);
  in {
    .pack = fn (a, b, c) => cells (a, b, c, 0, 0, 0, 0, 0);
    .ecs = { .field_count = 3; .name = definition.name; };
  }
end;

const component_4 = fn definition => do
  let _ = validate_component (definition, 4);
  in {
    .pack = fn (a, b, c, d) => cells (a, b, c, d, 0, 0, 0, 0);
    .ecs = { .field_count = 4; .name = definition.name; };
  }
end;

const component_5 = fn definition => do
  let _ = validate_component (definition, 5);
  in {
    .pack = fn (a, b, c, d, e) => cells (a, b, c, d, e, 0, 0, 0);
    .ecs = { .field_count = 5; .name = definition.name; };
  }
end;

const component_6 = fn definition => do
  let _ = validate_component (definition, 6);
  in {
    .pack = fn (a, b, c, d, e, f) => cells (a, b, c, d, e, f, 0, 0);
    .ecs = { .field_count = 6; .name = definition.name; };
  }
end;

const component_7 = fn definition => do
  let _ = validate_component (definition, 7);
  in {
    .pack = fn (a, b, c, d, e, f, g) => cells (a, b, c, d, e, f, g, 0);
    .ecs = { .field_count = 7; .name = definition.name; };
  }
end;

const component_8 = fn definition => do
  let _ = validate_component (definition, 8);
  in {
    .pack = fn (a, b, c, d, e, f, g, h) => cells (a, b, c, d, e, f, g, h);
    .ecs = { .field_count = 8; .name = definition.name; };
  }
end;

const component_metadata = fn target =>
  target.ecs;

const entity_metadata = fn (world, entity_index) =>
  world.entity_metadata_base + entity_index * entity_metadata_width;

const entity = fn (world, index, generation) =>
  generation * world.capacity + index;
const entity_index = fn (world, candidate) => @int.rem candidate world.capacity;
const entity_generation = fn (world, candidate) => candidate / world.capacity;

const indexed_alive = fn (world, candidate) =>
  if candidate > -1
  then if candidate < world.capacity then 1 else 0 end
  else 0
  end;

let dynamic_alive = fn (world, candidate) => do
  result <- if candidate > -1
    then do
      let index = entity_index (world, candidate);
      let expected_generation = entity_generation (world, candidate);
      let metadata = entity_metadata (world, index);
      alive <- Cells.get (metadata + entity_alive_field);
      generation <- Cells.get (metadata + entity_generation_field);
      matching_lower_bound <- if generation > expected_generation - 1
        then 1
        else 0
      end;
      matching_generation <- if generation < expected_generation + 1
        then matching_lower_bound
        else 0
      end;
      in if alive > 0 then matching_generation else 0 end
    end
    else 0
  end;
  in result
end;

let is_alive = fn (world, candidate) => do
  result <- if world.entity_mode > dynamic_entity_mode
    then indexed_alive (world, candidate)
    else dynamic_alive (world, candidate)
  end;
  in result
end;

let spawn_dynamic = fn world => do
  free_entity <- Cells.get (world.base + free_entity_cell);
  result <- if free_entity > 0
    then do
      let free_index = free_entity - 1;
      let metadata = entity_metadata (world, free_index);
      generation <- Cells.get (metadata + entity_generation_field);
      next_free <- Cells.get (metadata + entity_next_free_field);
      _ <- Cells.put {
        .index = world.base + free_entity_cell;
        .value = next_free;
      };
      _ <- Cells.put { .index = metadata + entity_alive_field; .value = 1; };
      _ <- Cells.put { .index = metadata + entity_next_free_field; .value = -1; };
      in entity (world, free_index, generation)
    end
    else do
      next_index <- Cells.get (world.base + next_entity_cell);
      allocated <- if next_index < world.capacity
        then do
          let metadata = entity_metadata (world, next_index);
          generation <- Cells.get (metadata + entity_generation_field);
          _ <- Cells.put {
            .index = world.base + next_entity_cell;
            .value = next_index + 1;
          };
          _ <- Cells.put { .index = metadata + entity_alive_field; .value = 1; };
          _ <- Cells.put {
            .index = metadata + entity_next_free_field;
            .value = -1;
          };
          in entity (world, next_index, generation)
        end
        else -1
      end;
      in allocated
    end
  end;
  in result
end;

let spawn = fn world => do
  spawned <- if world.entity_mode < indexed_entity_mode
    then spawn_dynamic world
    else -1
  end;
  in spawned
end;

let despawn_dynamic = fn (world, candidate) => do
  alive <- is_alive (world, candidate);
  removed <- if alive > 0
    then do
      let index = entity_index (world, candidate);
      let generation = entity_generation (world, candidate);
      let metadata = entity_metadata (world, index);
      free_entity <- Cells.get (world.base + free_entity_cell);
      _ <- Cells.put { .index = metadata + entity_alive_field; .value = 0; };
      _ <- Cells.put {
        .index = metadata + entity_generation_field;
        .value = generation + 1;
      };
      _ <- Cells.put {
        .index = metadata + entity_next_free_field;
        .value = free_entity;
      };
      _ <- Cells.put {
        .index = world.base + free_entity_cell;
        .value = index + 1;
      };
      in 1
    end
    else 0
  end;
  in removed
end;

const component_entity_base = fn (world, component_id, index) =>
  world.component_base
  + component_id * world.component_stride
  + index * (world.max_fields + 1);

const component_rows_width = fn world =>
  world.capacity * (world.max_fields + 1);

const component_count_cell = fn (world, component_id) =>
  world.component_base
  + component_id * world.component_stride
  + component_rows_width world;

const component_dense_base = fn (world, component_id) =>
  component_count_cell (world, component_id) + 1;

const component_sparse_base = fn (world, component_id) =>
  component_dense_base (world, component_id) + world.capacity;

let has_component = fn (world, component_id, candidate) => do
  alive <- is_alive (world, candidate);
  present <- if alive > 0
    then do
      let index = entity_index (world, candidate);
      let expected_generation = entity_generation (world, candidate);
      let base = component_entity_base (world, component_id, index);
      generation <- Cells.get base;
      matches_lower_bound <- if generation > expected_generation
        then 1
        else 0
      end;
      in if generation < expected_generation + 2
        then matches_lower_bound
        else 0
      end
    end
    else 0
  end;
  in present
end;

let add_component_membership = fn (world, component_id, candidate) => do
  let index = entity_index (world, candidate);
  let sparse_cell = component_sparse_base (world, component_id) + index;
  existing <- Cells.get sparse_cell;
  _ <- if existing > 0
    then ()
    else do
      let count_cell = component_count_cell (world, component_id);
      count <- Cells.get count_cell;
      _ <- Cells.put {
        .index = component_dense_base (world, component_id) + count;
        .value = index;
      };
      _ <- Cells.put { .index = sparse_cell; .value = count + 1; };
      _ <- Cells.put { .index = count_cell; .value = count + 1; };
      in ()
    end
  end;
  in ()
end;

let write_cells = fn (world, component_id, candidate, value) => do
  let index = entity_index (world, candidate);
  let generation = entity_generation (world, candidate);
  let base = component_entity_base (world, component_id, index);
  _ <- Cells.put { .index = base; .value = generation + 1; };
  _ <- Cells.put { .index = base + 1; .value = value.a; };
  _ <- if world.max_fields > 1
    then Cells.put { .index = base + 2; .value = value.b; }
    else ()
  end;
  _ <- if world.max_fields > 2
    then Cells.put { .index = base + 3; .value = value.c; }
    else ()
  end;
  _ <- if world.max_fields > 3
    then Cells.put { .index = base + 4; .value = value.d; }
    else ()
  end;
  _ <- if world.max_fields > 4
    then Cells.put { .index = base + 5; .value = value.e; }
    else ()
  end;
  _ <- if world.max_fields > 5
    then Cells.put { .index = base + 6; .value = value.f; }
    else ()
  end;
  _ <- if world.max_fields > 6
    then Cells.put { .index = base + 7; .value = value.g; }
    else ()
  end;
  _ <- if world.max_fields > 7
    then Cells.put { .index = base + 8; .value = value.h; }
    else ()
  end;
  _ <- add_component_membership (world, component_id, candidate);
  in 1
end;

let remove_component = fn (world, component_id, candidate) => do
  present <- has_component (world, component_id, candidate);
  removed <- if present > 0
    then do
      let index = entity_index (world, candidate);
      let base = component_entity_base (world, component_id, index);
      let count_cell = component_count_cell (world, component_id);
      let dense_base = component_dense_base (world, component_id);
      let sparse_base = component_sparse_base (world, component_id);
      dense_position <- Cells.get (sparse_base + index);
      count <- Cells.get count_cell;
      last_index <- Cells.get (dense_base + count - 1);
      _ <- Cells.put { .index = base; .value = 0; };
      _ <- Cells.put {
        .index = dense_base + dense_position - 1;
        .value = last_index;
      };
      _ <- Cells.put {
        .index = sparse_base + last_index;
        .value = dense_position;
      };
      _ <- Cells.put { .index = sparse_base + index; .value = 0; };
      _ <- Cells.put { .index = count_cell; .value = count - 1; };
      in 1
    end
    else 0
  end;
  in removed
end;

const component_name = fn target => (component_metadata target).name;

const component_id = fn (components, target) => do
  let target_name = component_name target;
  let found = -1;
  for (index, candidate) in Iter.indexed components do
    found := if text_eq (component_name candidate, target_name)
      then index
      else found
    end;
  end;
  let _ = expect (found > -1, Text.append
    (Text.append "ECS world does not contain component " target_name)
    ""
  );
  in found
end;

const register_world = fn (schema, components) => do
  let register = fn () => do
    _ <- EcsSchema.world schema;
    in ()
  end;
  for (component_id, target) in Iter.indexed components do
    let preceding = register;
    let metadata = component_metadata target;
    register := fn () => do
      _ <- preceding ();
      _ <- EcsSchema.component {
        .field_count = metadata.field_count;
        .id = component_id;
        .name = metadata.name;
      };
      in ()
    end;
  end;
  in register
end;

const world_layout = fn (properties, entity_mode) => do
  let component_capacity = @array.len properties.components;
  let max_fields = fold (properties.components, 0, (fn (maximum, target) =>
    if (component_metadata target).field_count > maximum
      then (component_metadata target).field_count
      else maximum
    end
  ));
  let seen = @array.empty;
  for target in Iter.items properties.components do
    let name = component_name target;
    let duplicate = any (seen, (fn existing => text_eq (existing, name)));
    let _ = expect (not duplicate, Text.append
      (Text.append "ECS world contains component " name)
      " more than once"
    );
    seen := @array.push seen name;
  end;
  let entity_metadata_base = properties.base
    + if entity_mode < indexed_entity_mode then world_header_width else 0 end;
  let component_base = entity_metadata_base
    + if entity_mode < indexed_entity_mode
      then properties.capacity * entity_metadata_width
      else 0
    end;
  let component_stride = properties.capacity * (max_fields + 3) + 1;
  let schema = {
    .base = properties.base;
    .capacity = properties.capacity;
    .component_base = component_base;
    .component_capacity = component_capacity;
    .component_stride = component_stride;
    .entity_metadata_base = entity_metadata_base;
    .entity_mode = entity_mode;
    .max_fields = max_fields;
  };
  in {
    .components = properties.components;
    .despawn = fn candidate => do
      removed <- if schema.entity_mode < indexed_entity_mode
        then despawn_dynamic (schema, candidate)
        else 0
      end;
      in removed
    end;
    .entity = fn (index, generation) => entity (schema, index, generation);
    .entity_generation = fn candidate => entity_generation (schema, candidate);
    .entity_index = fn candidate => entity_index (schema, candidate);
    .is_alive = fn candidate => do
      alive <- is_alive (schema, candidate);
      in alive
    end;
    .layout = schema;
    .register = register_world (schema, properties.components);
    .spawn = fn () => do
      spawned <- spawn schema;
      in spawned
    end;
  }
end;

const world = fn properties => world_layout (properties, dynamic_entity_mode);
const indexed_world = fn properties =>
  world_layout (properties, indexed_entity_mode);

const append_seed_field = fn (source, value) => Text.append
  (Text.append source ",")
  (Text.of_int value);

const encode_seed_row = fn (value, field_count) => case field_count of
  1 => Text.of_int value.a,
  2 => append_seed_field (Text.of_int value.a, value.b),
  3 => append_seed_field (
    append_seed_field (Text.of_int value.a, value.b), value.c
  ),
  4 => append_seed_field (append_seed_field (
    append_seed_field (Text.of_int value.a, value.b), value.c
  ), value.d),
  5 => append_seed_field (append_seed_field (append_seed_field (
    append_seed_field (Text.of_int value.a, value.b), value.c
  ), value.d), value.e),
  6 => append_seed_field (append_seed_field (append_seed_field (
    append_seed_field (append_seed_field (
      Text.of_int value.a, value.b
    ), value.c), value.d
  ), value.e), value.f),
  7 => append_seed_field (append_seed_field (append_seed_field (
    append_seed_field (append_seed_field (append_seed_field (
      Text.of_int value.a, value.b
    ), value.c), value.d), value.e
  ), value.f), value.g),
  _ => append_seed_field (append_seed_field (append_seed_field (
    append_seed_field (append_seed_field (append_seed_field (
      append_seed_field (Text.of_int value.a, value.b), value.c
    ), value.d), value.e), value.f
  ), value.g), value.h)
end;

const seed_encoder = fn target => do
  let field_count = (component_metadata target).field_count;
  let pack = target.pack;
  in fn values => fold (values, "", (fn (source, value) => do
    let packed = pack value;
    in Text.append source (Text.append
      (encode_seed_row (packed, field_count))
      ";"
    )
  end))
end;

const store_at = fn (world, target, id) => do
  let layout = world.layout;
  let metadata = component_metadata target;
  let pack = target.pack;
  let encode_seed = seed_encoder target;
  let field_at = fn field => {
    .column = { .component = id; .field = field; };
    .get = fn candidate => do
      present <- has_component (layout, id, candidate);
      result <- if present > 0
        then do
          let index = entity_index (layout, candidate);
          let base = component_entity_base (layout, id, index);
          value <- Cells.get (base + field + 1);
          in Some value
        end
        else None
      end;
      in result
    end;
    .get_or = fn (candidate, fallback) => do
      present <- has_component (layout, id, candidate);
      value <- if present > 0
        then do
          let index = entity_index (layout, candidate);
          let base = component_entity_base (layout, id, index);
          field_value <- Cells.get (base + field + 1);
          in field_value
        end
        else fallback
      end;
      in value
    end;
    .set = fn (candidate, value) => do
      present <- has_component (layout, id, candidate);
      updated <- if present > 0
        then do
          let index = entity_index (layout, candidate);
          let base = component_entity_base (layout, id, index);
          _ <- Cells.put { .index = base + field + 1; .value = value; };
          in 1
        end
        else 0
      end;
      in updated
    end;
  };
  in {
    .candidate_span = fn () => do
      count <- Cells.get (component_count_cell (layout, id));
      in count
    end;
    .candidate = fn position => do
      count <- Cells.get (component_count_cell (layout, id));
      result <- if position > -1
        then if position < count
          then do
            index <- Cells.get (component_dense_base (layout, id) + position);
            candidate <- if layout.entity_mode > dynamic_entity_mode
              then index
              else do
                generation <- Cells.get (
                  entity_metadata (layout, index) + entity_generation_field
                );
                in entity (layout, index, generation)
              end
            end;
            in candidate
          end
          else -1
        end
        else -1
      end;
      in result
    end;
    .field = field_at;
    .has = fn candidate => do
      present <- has_component (layout, id, candidate);
      in present
    end;
    .insert = fn (candidate, value) => do
      let packed = pack value;
      alive <- is_alive (layout, candidate);
      inserted <- if alive > 0
        then write_cells (layout, id, candidate, packed)
        else 0
      end;
      in inserted
    end;
    .remove = fn candidate => do
      removed <- remove_component (layout, id, candidate);
      in removed
    end;
    .seed = fn values => do
      let source = encode_seed values;
      in fn () => do
        _ <- EcsSchema.seed_indexed {
          .component = id;
          .source = source;
          .world_base = layout.base;
        };
        in ()
      end
    end;
    // Generated grids stay encoded so hot reload does not specialize every
    // asset row into the game module.
    .seed_source = fn source => fn () => do
      _ <- EcsSchema.seed_indexed {
        .component = id;
        .source = source;
        .world_base = layout.base;
      };
      in ()
    end;
    .set = fn (candidate, value) => do
      let packed = pack value;
      present <- has_component (layout, id, candidate);
      updated <- if present > 0
        then write_cells (layout, id, candidate, packed)
        else 0
      end;
      in updated
    end;
    .visit = fn (candidate, visitor) => do
      present <- has_component (layout, id, candidate);
      if present > 0 then do
        _ <- visitor candidate;
      end;
      in present
    end;
    .component_name = metadata.name;
    .world_base = layout.base;
  }
end;

const store = fn (world, target) =>
  store_at (world, target, component_id (world.components, target));

const read_access = 0;
const write_access = 1;

const read = fn store => {
  .candidate = store.candidate;
  .candidate_span = store.candidate_span;
  .component_name = store.component_name;
  .has = store.has;
  .mode = read_access;
  .world_base = store.world_base;
};

const write = fn store => {
  .candidate = store.candidate;
  .candidate_span = store.candidate_span;
  .component_name = store.component_name;
  .has = store.has;
  .mode = write_access;
  .world_base = store.world_base;
};

const validate_query_pair = fn (first, second) => do
  let _ = expect (first.world_base == second.world_base,
    "ECS query stores must belong to the same world"
  );
  in ()
end;

const query_1 = fn first_access => do
  let visit = fn (candidate, visitor) => do
    present <- first_access.has candidate;
    matched <- if present > 0
      then do
        _ <- visitor candidate;
        in 1
      end
      else 0
    end;
    in matched
  end;
  in {
    .access = {
      .first = {
        .component = first_access.component_name;
        .mode = first_access.mode;
      };
    };
    .candidate_span = first_access.candidate_span;
    .visit = visit;
    .visit_at = fn (position, visitor) => do
      candidate <- first_access.candidate position;
      matched <- if candidate > -1
        then visit (candidate, visitor)
        else 0
      end;
      in matched
    end;
  }
end;

const query_2 = fn (first_access, second_access) => do
  let _ = validate_query_pair (first_access, second_access);
  let visit = fn (candidate, visitor) => do
    first_present <- first_access.has candidate;
    second_present <- second_access.has candidate;
    matched <- if first_present > 0
      then if second_present > 0
        then do
          _ <- visitor candidate;
          in 1
        end
        else 0
      end
      else 0
    end;
    in matched
  end;
  in {
    .access = {
      .first = {
        .component = first_access.component_name;
        .mode = first_access.mode;
      };
      .second = {
        .component = second_access.component_name;
        .mode = second_access.mode;
      };
    };
    .candidate_span = first_access.candidate_span;
    .visit = visit;
    .visit_at = fn (position, visitor) => do
      candidate <- first_access.candidate position;
      matched <- if candidate > -1
        then visit (candidate, visitor)
        else 0
      end;
      in matched
    end;
  }
end;

const query_3 = fn (first_access, second_access, third_access) => do
  let _ = validate_query_pair (first_access, second_access);
  let _ = validate_query_pair (first_access, third_access);
  let _ = validate_query_pair (second_access, third_access);
  let visit = fn (candidate, visitor) => do
    first_present <- first_access.has candidate;
    second_present <- second_access.has candidate;
    third_present <- third_access.has candidate;
    matched <- if first_present > 0
      then if second_present > 0
        then if third_present > 0
          then do
            _ <- visitor candidate;
            in 1
          end
          else 0
        end
        else 0
      end
      else 0
    end;
    in matched
  end;
  in {
    .access = {
      .first = {
        .component = first_access.component_name;
        .mode = first_access.mode;
      };
      .second = {
        .component = second_access.component_name;
        .mode = second_access.mode;
      };
      .third = {
        .component = third_access.component_name;
        .mode = third_access.mode;
      };
    };
    .candidate_span = first_access.candidate_span;
    .visit = visit;
    .visit_at = fn (position, visitor) => do
      candidate <- first_access.candidate position;
      matched <- if candidate > -1
        then visit (candidate, visitor)
        else 0
      end;
      in matched
    end;
  }
end;

const system = fn (query, update) => fn candidate => do
  _ <- query.visit (candidate, update);
  in ()
end;

const systems = fn entries => do
  let run = fn _ => do in () end;
  for entry in Iter.items entries do
    let preceding = run;
    run := fn candidate => do
      _ <- preceding candidate;
      _ <- entry candidate;
      in ()
    end;
  end;
  in run
end;

return {
  .component_1 = component_1;
  .component_2 = component_2;
  .component_3 = component_3;
  .component_4 = component_4;
  .component_5 = component_5;
  .component_6 = component_6;
  .component_7 = component_7;
  .component_8 = component_8;
  .entity = entity;
  .entity_generation = entity_generation;
  .entity_index = entity_index;
  .indexed_world = indexed_world;
  .is_alive = is_alive;
  .maximum_component_fields = maximum_component_fields;
  .query_1 = query_1;
  .query_2 = query_2;
  .query_3 = query_3;
  .read = read;
  .spawn = spawn;
  .store = store;
  .system = system;
  .systems = systems;
  .world = world;
  .write = write;
};
