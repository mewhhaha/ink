open import "./prelude.blot"

const Engine = import "./engine.blot"
const Cells = Engine.Cells

const Abi = import "./abi.blot"
const EcsSchema = Abi.EcsSchema

const maximum_component_fields = 8
const next_entity_cell = 0
const free_entity_cell = 1
const world_header_width = 2
const entity_metadata_width = 3
const entity_alive_field = 0
const entity_generation_field = 1
const entity_next_free_field = 2
const dynamic_entity_mode = 0
const indexed_entity_mode = 1

const cells = fn (a, b, c, d, e, f, g, h) => {
  .a = a;
  .b = b;
  .c = c;
  .d = d;
  .e = e;
  .f = f;
  .g = g;
  .h = h;
}

const validate_component = fn (definition, expected_fields) => do:
  let field_names = @shape.names definition.fields
  let field_count = @array.len field_names
  let integer_fields = every (field_names, fn name => refines (@shape.get definition.fields name, Int)
  && refines (Int, @shape.get definition.fields name))
  let _ = expect (field_count == expected_fields, Text.append
  (Text.append "ECS component " definition.name)
  (Text.append " must declare exactly " (Text.append
  (Text.of_int expected_fields)
  " fields"
  ))
)
  let _ = expect (integer_fields, Text.append
  (Text.append "ECS component " definition.name)
  " fields must be Int"
)
  let fields = ""
  for name in Iter.items field_names:
    let encoded = Text.append name ":Int"
    fields := case Text.length fields > 0 of
      #True => Text.append (Text.append fields ";") encoded
      #False => encoded

  return {
    .field_count = expected_fields;
    .fields = fields;
    .name = definition.name;
  }

  // Passing the positional projection through one generic factory leaves a
  // dynamic shape operation in residual Wasm. Each arity therefore owns the
  // destructuring that the compiler can erase completely.
const component_1 = fn definition => do:
  let metadata = validate_component (definition, 1)
  return {
    .pack = fn value => cells (value, 0, 0, 0, 0, 0, 0, 0);
    .ecs = metadata;
  }

const component_2 = fn definition => do:
  let metadata = validate_component (definition, 2)
  return {
    .pack = fn (a, b) => cells (a, b, 0, 0, 0, 0, 0, 0);
    .ecs = metadata;
  }

const component_3 = fn definition => do:
  let metadata = validate_component (definition, 3)
  return {
    .pack = fn (a, b, c) => cells (a, b, c, 0, 0, 0, 0, 0);
    .ecs = metadata;
  }

const component_4 = fn definition => do:
  let metadata = validate_component (definition, 4)
  return {
    .pack = fn (a, b, c, d) => cells (a, b, c, d, 0, 0, 0, 0);
    .ecs = metadata;
  }

const component_5 = fn definition => do:
  let metadata = validate_component (definition, 5)
  return {
    .pack = fn (a, b, c, d, e) => cells (a, b, c, d, e, 0, 0, 0);
    .ecs = metadata;
  }

const component_6 = fn definition => do:
  let metadata = validate_component (definition, 6)
  return {
    .pack = fn (a, b, c, d, e, f) => cells (a, b, c, d, e, f, 0, 0);
    .ecs = metadata;
  }

const component_7 = fn definition => do:
  let metadata = validate_component (definition, 7)
  return {
    .pack = fn (a, b, c, d, e, f, g) => cells (a, b, c, d, e, f, g, 0);
    .ecs = metadata;
  }

const component_8 = fn definition => do:
  let metadata = validate_component (definition, 8)
  return {
    .pack = fn (a, b, c, d, e, f, g, h) => cells (a, b, c, d, e, f, g, h);
    .ecs = metadata;
  }

const component_metadata = fn target => target.ecs

const entity_metadata = fn (world, entity_index) => world.entity_metadata_base + entity_index * entity_metadata_width

const entity = fn (world, index, generation) => generation * world.capacity + index
const entity_index = fn (world, candidate) => @int.rem candidate world.capacity
const entity_generation = fn (world, candidate) => candidate / world.capacity

const indexed_alive = fn (world, candidate) => case candidate > -1 && candidate < world.capacity of
  #True => 1
  #False => 0

let dynamic_alive = fn (world, candidate) => do:
  use result <- case candidate > -1 of
    #True => do:
      let index = entity_index (world, candidate)
      let expected_generation = entity_generation (world, candidate)
      let metadata = entity_metadata (world, index)
      use alive <- Cells.get (metadata + entity_alive_field)
      use generation <- Cells.get (metadata + entity_generation_field)
      let matching_lower_bound = case generation > expected_generation - 1 of
        #True => 1
        #False => 0
      let matching_generation = case generation < expected_generation + 1 of
        #True => matching_lower_bound
        #False => 0
      return case alive > 0 of
        #True => matching_generation
        #False => 0

    #False => 0
  return result

let is_alive = fn (world, candidate) => do:
  use result <- case world.entity_mode > dynamic_entity_mode of
    #True => indexed_alive (world, candidate)
    #False => dynamic_alive (world, candidate)
  return result

let spawn_dynamic = fn world => do:
  use free_entity <- Cells.get (world.base + free_entity_cell)
  use result <- case free_entity > 0 of
    #True => do:
      let free_index = free_entity - 1
      let metadata = entity_metadata (world, free_index)
      use generation <- Cells.get (metadata + entity_generation_field)
      use next_free <- Cells.get (metadata + entity_next_free_field)
      use Cells.put {
        .index = world.base + free_entity_cell;
        .value = next_free;
      }
      use Cells.put { .index = metadata + entity_alive_field; .value = 1; }
      use Cells.put { .index = metadata + entity_next_free_field; .value = -1; }
      return entity (world, free_index, generation)

    #False => do:
      use next_index <- Cells.get (world.base + next_entity_cell)
      use allocated <- case next_index < world.capacity of
        #True => do:
          let metadata = entity_metadata (world, next_index)
          use generation <- Cells.get (metadata + entity_generation_field)
          use Cells.put {
            .index = world.base + next_entity_cell;
            .value = next_index + 1;
          }
          use Cells.put { .index = metadata + entity_alive_field; .value = 1; }
          use Cells.put {
            .index = metadata + entity_next_free_field;
            .value = -1;
          }
          return entity (world, next_index, generation)

        #False => -1
      return allocated

  return result

let spawn = fn world => do:
  use spawned <- case world.entity_mode < indexed_entity_mode of
    #True => spawn_dynamic world
    #False => -1
  return spawned

let despawn_dynamic = fn (world, candidate) => do:
  use alive <- is_alive (world, candidate)
  use removed <- case alive > 0 of
    #True => do:
      let index = entity_index (world, candidate)
      let generation = entity_generation (world, candidate)
      let metadata = entity_metadata (world, index)
      use free_entity <- Cells.get (world.base + free_entity_cell)
      use Cells.put { .index = metadata + entity_alive_field; .value = 0; }
      use Cells.put {
        .index = metadata + entity_generation_field;
        .value = generation + 1;
      }
      use Cells.put {
        .index = metadata + entity_next_free_field;
        .value = free_entity;
      }
      use Cells.put {
        .index = world.base + free_entity_cell;
        .value = index + 1;
      }
      return 1

    #False => 0
  return removed

const component_entity_base = fn (world, component_id, index) => world.component_base
  + component_id * world.component_stride
  + index * (world.max_fields + 1)

const component_rows_width = fn world => world.capacity * (world.max_fields + 1)

const component_count_cell = fn (world, component_id) => world.component_base
  + component_id * world.component_stride
  + component_rows_width world

const component_dense_base = fn (world, component_id) => component_count_cell (world, component_id) + 1

const component_sparse_base = fn (world, component_id) => component_dense_base (world, component_id) + world.capacity

let has_component = fn (world, component_id, candidate) => do:
  use alive <- is_alive (world, candidate)
  use present <- case alive > 0 of
    #True => do:
      let index = entity_index (world, candidate)
      let expected_generation = entity_generation (world, candidate)
      let base = component_entity_base (world, component_id, index)
      use generation <- Cells.get base
      let matches_lower_bound = case generation > expected_generation of
        #True => 1
        #False => 0
      return case generation < expected_generation + 2 of
        #True => matches_lower_bound
        #False => 0

    #False => 0
  return present

let add_component_membership = fn (world, component_id, candidate) => do:
  let index = entity_index (world, candidate)
  let sparse_cell = component_sparse_base (world, component_id) + index
  use existing <- Cells.get sparse_cell
  if existing > 0:
    return ()

  let count_cell = component_count_cell (world, component_id)
  use count <- Cells.get count_cell
  use Cells.put {
    .index = component_dense_base (world, component_id) + count;
    .value = index;
  }
  use Cells.put { .index = sparse_cell; .value = count + 1; }
  use Cells.put { .index = count_cell; .value = count + 1; }
  return ()

let write_cells = fn (world, component_id, candidate, value) => do:
  let index = entity_index (world, candidate)
  let generation = entity_generation (world, candidate)
  let base = component_entity_base (world, component_id, index)
  use Cells.put { .index = base; .value = generation + 1; }
  use Cells.put { .index = base + 1; .value = value.a; }
  if world.max_fields > 1:
    use Cells.put { .index = base + 2; .value = value.b; }

  if world.max_fields > 2:
    use Cells.put { .index = base + 3; .value = value.c; }

  if world.max_fields > 3:
    use Cells.put { .index = base + 4; .value = value.d; }

  if world.max_fields > 4:
    use Cells.put { .index = base + 5; .value = value.e; }

  if world.max_fields > 5:
    use Cells.put { .index = base + 6; .value = value.f; }

  if world.max_fields > 6:
    use Cells.put { .index = base + 7; .value = value.g; }

  if world.max_fields > 7:
    use Cells.put { .index = base + 8; .value = value.h; }

  use add_component_membership (world, component_id, candidate)
  return 1

let remove_component = fn (world, component_id, candidate) => do:
  use present <- has_component (world, component_id, candidate)
  use removed <- case present > 0 of
    #True => do:
      let index = entity_index (world, candidate)
      let base = component_entity_base (world, component_id, index)
      let count_cell = component_count_cell (world, component_id)
      let dense_base = component_dense_base (world, component_id)
      let sparse_base = component_sparse_base (world, component_id)
      use dense_position <- Cells.get (sparse_base + index)
      use count <- Cells.get count_cell
      use last_index <- Cells.get (dense_base + count - 1)
      use Cells.put { .index = base; .value = 0; }
      use Cells.put {
        .index = dense_base + dense_position - 1;
        .value = last_index;
      }
      use Cells.put {
        .index = sparse_base + last_index;
        .value = dense_position;
      }
      use Cells.put { .index = sparse_base + index; .value = 0; }
      use Cells.put { .index = count_cell; .value = count - 1; }
      return 1

    #False => 0
  return removed

const component_name = fn target => (component_metadata target).name

const component_id = fn (components, target) => do:
  let target_name = component_name target
  let result = fold (components, (0, -1), fn (current, candidate) => (
    current.0 + 1,
    case text_eq (component_name candidate, target_name) of
      #True => current.0
      #False => current.1
  ))
  let found = result.1

  let _ = expect (found > -1, Text.append
  (Text.append "ECS world does not contain component " target_name)
  ""
)
  return found

const register_world = fn (schema, components) => do:
  let initial_register = fn () => do:
    use EcsSchema.world schema
    return ()
  let result = fold (components, (0, initial_register), fn (current, target) => do:
    let component_id = current.0
    let preceding = current.1
    let metadata = component_metadata target
    let register = fn () => do:
      use preceding ()
      use EcsSchema.component {
        .field_count = metadata.field_count;
        .fields = metadata.fields;
        .id = component_id;
        .name = metadata.name;
      }
      return ()
    return (component_id + 1, register)
  )
  return result.1

let world_layout = fn (properties, entity_mode) => do:
  let component_capacity = @array.len properties.components
  let max_fields = fold (
    properties.components,
    0,
    fn (maximum, target) => case (component_metadata target).field_count > maximum of
      #True => (component_metadata target).field_count
      #False => maximum
  )
  let seen = @array.empty
  for target in Iter.items properties.components:
    let name = component_name target
    let duplicate = any (seen, fn existing => text_eq (existing, name))
    let _ = expect (not duplicate, Text.append
      (Text.append "ECS world contains component " name)
      " more than once"
    )
    seen := @array.push seen name

  let entity_metadata_base = properties.base + case entity_mode < indexed_entity_mode of
    #True => world_header_width
    #False => 0
  let component_base = entity_metadata_base + case entity_mode < indexed_entity_mode of
    #True => properties.capacity * entity_metadata_width
    #False => 0
  let component_stride = properties.capacity * (max_fields + 3) + 1
  let resource_base = component_base + component_capacity * component_stride
  let schema = {
    .base = properties.base;
    .capacity = properties.capacity;
    .component_base = component_base;
    .component_capacity = component_capacity;
    .component_stride = component_stride;
    .entity_metadata_base = entity_metadata_base;
    .entity_mode = entity_mode;
    .max_fields = max_fields;
    .resource_base = resource_base;
    .resource_capacity = 0;
    .resource_stride = max_fields;
  }
  return {
    .components = properties.components;
    .despawn = fn candidate => do:
      use removed <- case schema.entity_mode < indexed_entity_mode of
        #True => despawn_dynamic (schema, candidate)
        #False => 0
      return removed
    ;
    .entity = fn (index, generation) => entity (schema, index, generation);
    .entity_generation = fn candidate => entity_generation (schema, candidate);
    .entity_index = fn candidate => entity_index (schema, candidate);
    .is_alive = fn candidate => do:
      use alive <- is_alive (schema, candidate)
      return alive
    ;
    .layout = schema;
    .register = register_world (schema, properties.components);
    .spawn = fn () => do:
      use spawned <- spawn schema
      return spawned
    ;
  }

let world = fn properties => world_layout (properties, dynamic_entity_mode)
let indexed_world = fn properties => world_layout (properties, indexed_entity_mode)

const append_seed_field = fn (source, value) => Text.append
  (Text.append source ",")
  (Text.of_int value)

const encode_seed_row = fn (value, field_count) => case field_count of
  1 => Text.of_int value.a
  2 => append_seed_field (Text.of_int value.a, value.b)
  3 => append_seed_field (
    append_seed_field (Text.of_int value.a, value.b), value.c
  )

  4 => append_seed_field (append_seed_field (
    append_seed_field (Text.of_int value.a, value.b), value.c
  ), value.d)

  5 => append_seed_field (append_seed_field (append_seed_field (
    append_seed_field (Text.of_int value.a, value.b), value.c
  ), value.d), value.e)

  6 => append_seed_field (append_seed_field (append_seed_field (
    append_seed_field (append_seed_field (
      Text.of_int value.a, value.b
    ), value.c), value.d
  ), value.e), value.f)

  7 => append_seed_field (append_seed_field (append_seed_field (
    append_seed_field (append_seed_field (append_seed_field (
      Text.of_int value.a, value.b
    ), value.c), value.d), value.e
  ), value.f), value.g)

  _ => append_seed_field (append_seed_field (append_seed_field (
    append_seed_field (append_seed_field (append_seed_field (
      append_seed_field (Text.of_int value.a, value.b), value.c
    ), value.d), value.e), value.f
  ), value.g), value.h)

const seed_encoder = fn target => do:
  let field_count = (component_metadata target).field_count
  let pack = target.pack
  return fn values => fold (values, "", (fn (source, value) => do:
    let packed = pack value
    return Text.append source (Text.append
      (encode_seed_row (packed, field_count))
      ";"
    )
  ))

let store_at = fn (world, target, id) => do:
  let layout = world.layout
  let metadata = component_metadata target
  let pack = target.pack
  let encode_seed = seed_encoder target
  let field_at = fn field => {
    .column = { .component = id; .field = field; };
    .get = fn candidate => do:
      use present <- has_component (layout, id, candidate)
      if present <= 0:
        return None

      let index = entity_index (layout, candidate)
      let base = component_entity_base (layout, id, index)
      use value <- Cells.get (base + field + 1)
      return Some value
    ;
    .get_or = fn (candidate, fallback) => do:
      use present <- has_component (layout, id, candidate)
      if present <= 0:
        return fallback

      let index = entity_index (layout, candidate)
      let base = component_entity_base (layout, id, index)
      use field_value <- Cells.get (base + field + 1)
      return field_value
    ;
    .set = fn (candidate, value) => do:
      use present <- has_component (layout, id, candidate)
      if present <= 0:
        return 0

      let index = entity_index (layout, candidate)
      let base = component_entity_base (layout, id, index)
      use Cells.put { .index = base + field + 1; .value = value; }
      return 1
    ;
  }
  return {
    .candidate_span = fn () => do:
      use count <- Cells.get (component_count_cell (layout, id))
      return count
    ;
    .candidate = fn position => do:
      use count <- Cells.get (component_count_cell (layout, id))
      if position < 0 || position >= count:
        return -1

      use index <- Cells.get (component_dense_base (layout, id) + position)
      if layout.entity_mode > dynamic_entity_mode:
        return index

      use generation <- Cells.get (
        entity_metadata (layout, index) + entity_generation_field
      )
      return entity (layout, index, generation)
    ;
    .field = field_at;
    .has = fn candidate => do:
      use present <- has_component (layout, id, candidate)
      return present
    ;
    .insert = fn (candidate, value) => do:
      let packed = pack value
      use alive <- is_alive (layout, candidate)
      if alive <= 0:
        return 0

      return write_cells (layout, id, candidate, packed)
    ;
    .remove = fn candidate => do:
      use removed <- remove_component (layout, id, candidate)
      return removed
    ;
    .seed = fn values => do:
      let source = encode_seed values
      return fn () => do:
        use EcsSchema.seed_indexed {
          .component = id;
          .source = source;
          .world_base = layout.base;
        }
        return ()
    ;
    // Generated grids stay encoded so hot reload does not specialize every
    // asset row into the game module.
    .seed_source = fn source => fn () => do:
      use EcsSchema.seed_indexed {
        .component = id;
        .source = source;
        .world_base = layout.base;
      }
      return ()
    ;
    .set = fn (candidate, value) => do:
      let packed = pack value
      use present <- has_component (layout, id, candidate)
      if present <= 0:
        return 0

      return write_cells (layout, id, candidate, packed)
    ;
    .visit = fn (candidate, visitor) => do:
      use present <- has_component (layout, id, candidate)
      if present > 0:
        use visitor candidate

      return present
    ;
    .component_name = metadata.name;
    .world_base = layout.base;
  }

let store = fn (world, target) => store_at (world, target, component_id (world.components, target))

const read_access = 0
const write_access = 1

const read = fn store => {
  .candidate = store.candidate;
  .candidate_span = store.candidate_span;
  .component_name = store.component_name;
  .has = store.has;
  .mode = read_access;
  .world_base = store.world_base;
}

const write = fn store => {
  .candidate = store.candidate;
  .candidate_span = store.candidate_span;
  .component_name = store.component_name;
  .has = store.has;
  .mode = write_access;
  .world_base = store.world_base;
}

const validate_query_pair = fn (first, second) => do:
  let _ = expect (first.world_base == second.world_base,
    "ECS query stores must belong to the same world"
  )
  return ()

const query_1 = fn first_access => do:
  let visit = fn (candidate, visitor) => do:
    use present <- first_access.has candidate
    if present <= 0:
      return 0

    use visitor candidate
    return 1
  return {
    .access = {
      .first = {
        .component = first_access.component_name;
        .mode = first_access.mode;
      };
    };
    .candidate_span = first_access.candidate_span;
    .visit = visit;
    .visit_at = fn (position, visitor) => do:
      use candidate <- first_access.candidate position
      if candidate < 0:
        return 0

      return visit (candidate, visitor)
    ;
  }

const query_2 = fn (first_access, second_access) => do:
  let _ = validate_query_pair (first_access, second_access)
  let visit = fn (candidate, visitor) => do:
    use first_present <- first_access.has candidate
    use second_present <- second_access.has candidate
    if first_present <= 0 || second_present <= 0:
      return 0

    use visitor candidate
    return 1
  return {
    .access = {
      .first = {
        .component = first_access.component_name;
        .mode = first_access.mode;
      };
      .second = {
        .component = second_access.component_name;
        .mode = second_access.mode;
      };
    };
    .candidate_span = first_access.candidate_span;
    .visit = visit;
    .visit_at = fn (position, visitor) => do:
      use candidate <- first_access.candidate position
      if candidate < 0:
        return 0

      return visit (candidate, visitor)
    ;
  }

const query_3 = fn (first_access, second_access, third_access) => do:
  let _ = validate_query_pair (first_access, second_access)
  let _ = validate_query_pair (first_access, third_access)
  let _ = validate_query_pair (second_access, third_access)
  let visit = fn (candidate, visitor) => do:
    use first_present <- first_access.has candidate
    use second_present <- second_access.has candidate
    use third_present <- third_access.has candidate
    if first_present <= 0 || second_present <= 0 || third_present <= 0:
      return 0

    use visitor candidate
    return 1
  return {
    .access = {
      .first = {
        .component = first_access.component_name;
        .mode = first_access.mode;
      };
      .second = {
        .component = second_access.component_name;
        .mode = second_access.mode;
      };
      .third = {
        .component = third_access.component_name;
        .mode = third_access.mode;
      };
    };
    .candidate_span = first_access.candidate_span;
    .visit = visit;
    .visit_at = fn (position, visitor) => do:
      use candidate <- first_access.candidate position
      if candidate < 0:
        return 0

      return visit (candidate, visitor)
    ;
  }

const system = fn (query, update) => fn candidate => do:
  use query.visit (candidate, update)
  return ()

const systems = fn entries => do:
  let run = fn _ => do:
    return ()
  for entry in Iter.items entries:
    let preceding = run
    run := fn candidate => do:
      use preceding candidate
      use entry candidate
      return ()

  return run

return {
  .component_1 = component_1;
  .component_2 = component_2;
  .component_3 = component_3;
  .component_4 = component_4;
  .component_5 = component_5;
  .component_6 = component_6;
  .component_7 = component_7;
  .component_8 = component_8;
  .entity = entity;
  .entity_generation = entity_generation;
  .entity_index = entity_index;
  .indexed_world = indexed_world;
  .is_alive = is_alive;
  .maximum_component_fields = maximum_component_fields;
  .query_1 = query_1;
  .query_2 = query_2;
  .query_3 = query_3;
  .read = read;
  .spawn = spawn;
  .store = store;
