open import "./prelude.blot"

const DataAsset =
  @effect.host {
    .copy_to_cells = { .asset = Int; .field = Int; .first_cell = Int; } -> Unit;
    .get = { .asset = Int; .field = Int; .index = Int; } -> Int;
    .length = { .asset = Int; .field = Int; } -> Int;
  }

return { .DataAsset = DataAsset; }
