open @import "./prelude.blot" ()

const FIXED = 1000000
const TURN = 65536

const clamp = fn (value, minimum, maximum) =>
  if value < minimum:
    return minimum
  else if value > maximum:
    return maximum
  else:
    return value

const minimum = fn (left, right) =>
  if left < right:
    return left
  else:
    return right
const maximum = fn (left, right) =>
  if left > right:
    return left
  else:
    return right
const absolute = fn value =>
  if value < 0:
    return -value
  else:
    return value
const sign = fn value =>
  if value < 0:
    return -1
  else if value > 0:
    return 1
  else:
    return 0

const floor_div = fn (dividend, divisor) =>
  let quotient = dividend / divisor
  let remainder = @int.rem dividend divisor
  let opposite_signs = if dividend < 0:
    return divisor > 0
  else:
    return divisor < 0
  if remainder == 0:
    return quotient
  else if opposite_signs:
    return quotient - 1
  else:
    return quotient

const floor_mod = fn (dividend, divisor) =>
  return dividend - floor_div (dividend, divisor) * divisor

const fixed_mul = fn (left, right) => left * right / FIXED
const fixed_div = fn (left, right) => left * FIXED / right
const fixed_lerp = fn (start, finish, amount) =>
  return start + fixed_mul (finish - start, amount)

return {
  .fixed = FIXED;
  .turn = TURN;
  .clamp = clamp;
  .minimum = minimum;
  .maximum = maximum;
  .absolute = absolute;
  .sign = sign;
  .floor_div = floor_div;
  .floor_mod = floor_mod;
  .fixed_mul = fixed_mul;
  .fixed_div = fixed_div;
  .fixed_lerp = fixed_lerp;
}
