open {} = (@import "./prelude.blot") ();

const FIXED = 1000000;
const TURN = 65536;

const clamp = fn (value, minimum, maximum) =>
  if value < minimum then minimum
  else if value > maximum then maximum
  else value
  end;

const minimum = fn (left, right) => if left < right then left else right end;
const maximum = fn (left, right) => if left > right then left else right end;
const absolute = fn value => if value < 0 then -value else value end;
const sign = fn value =>
  if value < 0 then -1
  else if value > 0 then 1
  else 0
  end;

const floor_div = fn (dividend, divisor) => do
  let quotient = dividend / divisor;
  let remainder = @int.rem dividend divisor;
  let opposite_signs = if dividend < 0 then divisor > 0 else divisor < 0 end;
  in if remainder == 0
  then quotient
  else if opposite_signs then quotient - 1 else quotient end
end;

const floor_mod = fn (dividend, divisor) =>
  dividend - floor_div (dividend, divisor) * divisor;

const fixed_mul = fn (left, right) => left * right / FIXED;
const fixed_div = fn (left, right) => left * FIXED / right;
const fixed_lerp = fn (start, finish, amount) =>
  start + fixed_mul (finish - start, amount);

return {
  .fixed = FIXED;
  .turn = TURN;
  .clamp = clamp;
  .minimum = minimum;
  .maximum = maximum;
  .absolute = absolute;
  .sign = sign;
  .floor_div = floor_div;
  .floor_mod = floor_mod;
  .fixed_mul = fixed_mul;
  .fixed_div = fixed_div;
  .fixed_lerp = fixed_lerp;
};
