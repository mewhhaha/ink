open import "./prelude.blot"

const M = import "./math.blot"

const pixel_snap = fn (value, pixel_ratio) => do:
  if pixel_ratio <= 0:
    return value
  else:
    return value * pixel_ratio / M.fixed * M.fixed / pixel_ratio

const atlas_coordinate = fn (cell, cell_count) => cell * M.fixed / cell_count

const atlas_region = fn (column, row, columns, rows) => {
  .left = atlas_coordinate (column, columns);
  .top = atlas_coordinate (row, rows);
  .right = atlas_coordinate (column + 1, columns);
  .bottom = atlas_coordinate (row + 1, rows);
}

const layer_depth = fn (layer, within_layer) => layer * M.fixed + within_layer

return {
  .pixel_snap = pixel_snap;
  .atlas_region = atlas_region;
  .layer_depth = layer_depth;
}
