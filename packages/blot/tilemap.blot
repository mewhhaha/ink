open @import "./prelude.blot" ()

const M = @import "./math.blot" ()
const Vec2 = @import "./vec2.blot" ()

const contains_tile = fn (column, row, columns, rows) =>
  return columns > 0 && rows > 0
    && column >= 0 && column < columns
    && row >= 0 && row < rows

const tile_index = fn (column, row, columns, rows) =>
  if contains_tile (column, row, columns, rows):
    return #Some (row * columns + column)
  else:
    return #None

const tile_coordinates = fn (index, columns, rows) =>
  if columns > 0 && rows > 0 && index >= 0 && index < columns * rows:
    return #Some (Vec2.vec2 (
      @int.rem index columns,
      index / columns
    ))
  else:
    return #None

const orthogonal_tile_to_world = fn (column, row, tile_width, tile_height) =>
  return Vec2.vec2 (
    column * tile_width,
    row * tile_height
  )

const orthogonal_world_to_tile = fn (world_x, world_y, tile_width, tile_height) =>
  return Vec2.vec2 (
  M.floor_div (world_x, tile_width),
  M.floor_div (world_y, tile_height)
  )

const isometric_tile_to_world = fn (column, row, tile_width, tile_height) =>
  return Vec2.vec2 (
  M.floor_div ((column - row) * tile_width, 2),
  M.floor_div ((column + row) * tile_height, 2)
  )

const isometric_world_to_tile = fn (
world_x,
world_y,
tile_width,
tile_height
) =>
  let tile_area = tile_width * tile_height
  return Vec2.vec2 (
  M.floor_div (world_x * tile_height + world_y * tile_width, tile_area),
  M.floor_div (world_y * tile_width - world_x * tile_height, tile_area)
  )

return {
  .contains_tile = contains_tile;
  .tile_index = tile_index;
  .tile_coordinates = tile_coordinates;
  .orthogonal_tile_to_world = orthogonal_tile_to_world;
  .orthogonal_world_to_tile = orthogonal_world_to_tile;
  .isometric_tile_to_world = isometric_tile_to_world;
  .isometric_world_to_tile = isometric_world_to_tile;
}
