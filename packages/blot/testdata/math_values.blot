open @import "../prelude.blot" ()

const Math = @import "../math.blot" ()

return (
  Math.clamp (12, 0, 10),
  Math.minimum (7, 9),
  Math.maximum (7, 9),
  Math.absolute (-4),
  Math.sign (-4),
  Math.floor_div (-7, 3),
  Math.floor_mod (-7, 3),
  Math.floor_div (7, -3),
  Math.floor_mod (7, -3),
  Math.floor_div (-7, -3),
  Math.floor_mod (-7, -3),
  Math.fixed_mul (500000, 250000),
  Math.fixed_div (500000, 250000),
  Math.fixed_lerp (1000000, 3000000, 250000)
)
