open {} = (@import "../prelude.blot") ();
open {} = (@import "../engine.blot") ();

const Ecs = (@import "../ecs.blot") ();

const Position = Ecs.component { .x = Int; .y = Int; };
const InsertPosition = Ecs.system ("insert", { .Position = Position; });
const City = Ecs.world (Ecs.entities.dynamic 4)
  |> Ecs.add_system InsertPosition
  |> Ecs.build;
open {} = City.insert;

let insert_wrong_payload = fn () => do
  _ <- Position.insert (0, { .x = 10; });
  in ()
end;

_ <- insert_wrong_payload ();

return ();
