open @import "../prelude.blot" ()

const Flex = @import "../flex.blot" ()

let vertical_margin = #Edges {
  .left = 0;
  .right = 0;
  .top = 2;
  .bottom = 3;
}

let flex_line = fn () =>
  _ <- Flex.Container.position (10, 20)
  _ <- Flex.Container.size (100, 60)
  _ <- Flex.Container.direction Flex.row
  _ <- Flex.Container.align Flex.centre
  _ <- Flex.Container.padding (#Edges {
    .left = 0;
    .right = 0;
    .top = 10;
    .bottom = 5;
  })
  _ <- Flex.child (fn () =>
    _ <- Flex.Child.size (#Points 20, #Points 10)
    _ <- Flex.Child.margin vertical_margin
    return ()
  )
  _ <- Flex.child (fn () =>
    _ <- Flex.Child.size (#Points 20, #Auto)
    _ <- Flex.Child.align Flex.stretch
    _ <- Flex.Child.margin vertical_margin
    return ()
  )
  _ <- Flex.child (fn () =>
    _ <- Flex.Child.size (#Points 20, #Points 10)
    _ <- Flex.Child.align Flex.end
    _ <- Flex.Child.margin vertical_margin
    return ()
  )
  return ()

return Flex.layout flex_line
