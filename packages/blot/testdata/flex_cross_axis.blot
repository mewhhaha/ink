open import "../prelude.blot"

const Flex = import "../flex.blot"

let vertical_margin =
  #Edges {
    .left = 0;
    .right = 0;
    .top = 2;
    .bottom = 3;
  }

let flex_line = fn () => do:
  use Flex.Container.position (10, 20)
  use Flex.Container.size (100, 60)
  use Flex.Container.direction Flex.row
  use Flex.Container.align Flex.centre
  use Flex.Container.padding (#Edges {
    .left = 0;
    .right = 0;
    .top = 10;
    .bottom = 5;
  })
  use Flex.child (fn () => do:
    use Flex.Child.size (#Points 20, #Points 10)
    use Flex.Child.margin vertical_margin
    return ()
  )
  use Flex.child (fn () => do:
    use Flex.Child.size (#Points 20, #Auto)
    use Flex.Child.align Flex.stretch
    use Flex.Child.margin vertical_margin
    return ()
  )
  use Flex.child (fn () => do:
    use Flex.Child.size (#Points 20, #Points 10)
    use Flex.Child.align Flex.end
    use Flex.Child.margin vertical_margin
    return ()
  )
  return ()

return Flex.layout flex_line
