open {} = (@import "../prelude.blot") ();

const RawAccess = @effect.named (
  "Access",
  { .read = Unit -> Int; }
);
const Access = RawAccess <+ { .ecs = 1; };
const RawOther = @effect.named (
  "Other",
  { .read = Unit -> Int; }
);
const Other = RawOther <+ { .ecs = 1; };

const query = fn (projection, visit) => do
  value <- projection ();
  _ <- visit value;
end;

const projection = fn () => do
  value <- RawAccess.read ();
  _ <- RawOther.read ();
  return value;
end;

const system = fn () => do
  _ <- query (projection, (fn _ => ()));
end;

const access_count = case @type.reflect (@type.of system) of
  #Arrow arrow => sum (map (arrow.effects, (fn effect =>
    if @shape.has (@type.members effect) "ecs" then 1 else 0 end
  ))),
  _ => -1
end;

return {
  .access_count = access_count;
  .projection = projection;
  .system = system;
};
