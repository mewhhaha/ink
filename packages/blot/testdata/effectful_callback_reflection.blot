open @import "../prelude.blot" ()

const RawAccess = @effect.named (
"Access",
{ .read = Unit -> Int; }
)
const Access = RawAccess <+ { .ecs = 1; }
const RawOther = @effect.named (
"Other",
{ .read = Unit -> Int; }
)
const Other = RawOther <+ { .ecs = 1; }

const query = fn (projection, visit) =>
  value <- projection ()
  _ <- visit value

const projection = fn () =>
  value <- RawAccess.read ()
  _ <- RawOther.read ()
  return value

const system = fn () =>
  _ <- query (projection, (fn _ => ()))

const access_count = case @type.reflect (@type.of system) of
  #Arrow arrow => sum (map (
    arrow.effects,
    (fn effect =>
      if @shape.has (@type.members effect) "ecs":
        return 1
      else:
        return 0

    )
  ))
  _ => -1

return {
  .access_count = access_count;
  .projection = projection;
  .system = system;
}
