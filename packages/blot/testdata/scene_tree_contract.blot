open @import "../prelude.blot" ()
open @import "../engine.blot" ()
open @import "../scene.blot" ()

let render = fn () =>
  <Camera .projection={perspective} .zoom=1000000>
    <MeshResource .id=0 .url="/tree.obj" />
    <DirectionalLight
      .color={color (1000000, 1000000, 1000000)}
      .direction={vec3 (0, -1000000, 0)}
      .intensity=1000000
    />
    <Node
      .id=10
      .transform={transform (
        vec3 (1000000, 0, 0),
        vec3 (0, 0, 0),
        uniform_scale 1000000
      )}
      .visible=True
      >
      <ObjectNode
        .id=11
        .material={material {
          .color = color (1000000, 0, 0);
          .surface_mode = local_surface;
        }}
        .mesh=0
        .transform={transform (
          vec3 (0, 2000000, 0),
          vec3 (0, 0, 0),
          uniform_scale 1000000
        )}
        .visible=True
        >
        <ObjectNode
          .id=12
          .material={material { .color = color (0, 1000000, 0); }}
          .mesh=0
          .transform={transform (
            vec3 (0, 0, 3000000),
            vec3 (0, 0, 0),
            uniform_scale 1000000
          )}
          .visible=True
        />
      </ObjectNode>
    </Node>
  </Camera>
  return ()

phase <- Phase.current ()
state <- State.current ()
if phase == start_phase:
  <- State.commit 0

if phase == frame_phase:
  <- State.commit state

if phase == render_phase:
  <- render ()

return ()
