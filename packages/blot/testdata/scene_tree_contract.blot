open import "../prelude.blot"
open import "../engine.blot"
open import "../scene.blot"

let render_mesh = fn () => do:
  use MeshResource { .asset = "tree.obj"; .id = 0; } []

let render_light = fn () => do:
  use DirectionalLight {
    .color = color (1000000, 1000000, 1000000);
    .direction = vec3 (0, -1000000, 0);
    .intensity = 1000000;
  } []

let render_grandchild = fn () => do:
  use ObjectNode {
    .id = 12;
    .material = material { .color = color (0, 1000000, 0); };
    .mesh = 0;
    .transform = transform (
      vec3 (0, 0, 3000000),
      vec3 (0, 0, 0),
      uniform_scale 1000000
    );
    .visible = True;
  } []

let render_child = fn () => do:
  use ObjectNode {
    .id = 11;
    .material = material {
      .color = color (1000000, 0, 0);
      .surface_mode = local_surface;
    };
    .mesh = 0;
    .transform = transform (
      vec3 (0, 2000000, 0),
      vec3 (0, 0, 0),
      uniform_scale 1000000
    );
    .visible = True;
  } [render_grandchild]

let render_node = fn () => do:
  use Node {
    .id = 10;
    .transform = transform (
      vec3 (1000000, 0, 0),
      vec3 (0, 0, 0),
      uniform_scale 1000000
    );
    .visible = True;
  } [render_child]

let render = fn () => do:
  use Camera { .projection = perspective; .zoom = 1000000; } [
    render_mesh,
    render_light,
    render_node
  ]
  return ()

use phase <- Phase.current ()
use state <- State.current ()
if phase == start_phase:
  use State.commit 0

if phase == frame_phase:
  use State.commit state

if phase == render_phase:
  use render ()

return ()
