open {} = (@import "../prelude.blot") ();
open {} = (@import "../engine.blot") ();

const Ecs = (@import "../ecs.blot") ();

const Counter = Ecs.resource { .value = 0; };
const UpdateCounter = Ecs.system ("update", { .Counter = Counter; });
const City = Ecs.world (Ecs.entities.dynamic 4)
  |> Ecs.add_system UpdateCounter
  |> Ecs.build;
open {} = City.update;

let replace_wrong_resource = fn () => do
  _ <- Counter.replace {};
  in ()
end;

_ <- replace_wrong_resource ();

return ();
