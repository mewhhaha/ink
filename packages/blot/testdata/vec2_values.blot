open @import "../prelude.blot" ()

const Vec2 = @import "../vec2.blot" ()

let left = Vec2.vec2 (1000000, 2000000)
let right = Vec2.vec2 (3000000, 4000000)

return (
  Vec2.zero,
  Vec2.add (left, right),
  Vec2.subtract (right, left),
  Vec2.scale (left, 500000),
  Vec2.lerp (left, right, 250000)
)
