open {} = (@import "../prelude.blot") ();
open {} = (@import "../engine.blot") ();

const Ecs = (@import "../ecs.blot") ();
const Layer = seal ("test.Layer", Int);
const Flag = Ecs.component { .active = Bool; .layer = Layer; };
const Toggle = Ecs.system ("toggle", { .Flag = Flag; });
const World = Ecs.world (Ecs.entities.fixed 1)
  |> Ecs.add_system Toggle
  |> Ecs.build;
const Scope = World.toggle;

phase <- Phase.current ();
_ <- if phase == schema_phase then World.register () else () end;
_ <- if phase == start_phase then do
  _ <- Scope.Flag.insert (0, {
    .active = True;
    .layer = seal ("test.Layer", 7);
  });
  _ <- State.commit 0;
  in ()
end else () end;
_ <- if phase == frame_phase then do
  active <- Scope.Flag.active.get_or (0, False);
  layer <- Scope.Flag.layer.get_or (0, seal ("test.Layer", 0));
  _ <- State.commit (if active then unseal layer else 0 end);
  in ()
end else () end;

return ();
