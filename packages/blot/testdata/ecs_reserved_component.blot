open {} = (@import "../prelude.blot") ();
open {} = (@import "../engine.blot") ();

const Ecs = (@import "../ecs.blot") ();
const Invalid = Ecs.component { .has = Int; };

const InvalidSystem = Ecs.system ("invalid", { .Invalid = Invalid; });
const World = Ecs.world (Ecs.entities.fixed 1)
  |> Ecs.add_system InvalidSystem
  |> Ecs.build;
const Scope = World.invalid;

phase <- Phase.current ();
_ <- if phase == schema_phase then World.register () else () end;
_ <- if phase == start_phase then do
  _ <- Scope.Invalid.insert (0, { .has = 7; });
  value <- Scope.Invalid.fields.has.get_or (0, 0);
  _ <- State.commit value;
  in ()
end else () end;

return ();
