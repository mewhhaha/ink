open @import "../prelude.blot" ()

const Html = @import "../html_canvas.blot" ()
const Scene = @import "../scene.blot" ()

let size = Html.element_size (144, 56)
let attached = Html.attachment (
  2,
  Scene.vec3 (3, 4, 5),
  Html.element_size (1200000, 500000)
)
let viewport = Html.viewport_attachment (
  Html.top_right,
  Html.element_size (16, 24)
)
let styled = Html.style ("black", "amber", 10, 2, "white", 14, 600)

return (size, attached, viewport, styled)
