open import "../prelude.blot"

const Html = import "../html_canvas.blot"

let size = Html.element_size (144, 56)
let attached =
  Html.attachment {
    .height = 500000;
    .object = 2;
    .offset_x = 3;
    .offset_y = 4;
    .offset_z = 5;
    .width = 1200000;
  }
let viewport =
  Html.viewport_attachment (
    Html.top_right,
    Html.element_size (16, 24)
  )
return (size, attached, viewport)
