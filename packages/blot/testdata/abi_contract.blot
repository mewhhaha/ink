open @import "../prelude.blot" ()
open @import "../engine.blot" ()
open @import "../html_canvas.blot" ()
open @import "../scene.blot" ()

let describe = fn () =>
  viewport <- Viewport.current ()
  <Button
    .attachment={{
      .object = 7;
      .offset = { .x = 101; .y = 202; .z = 303; };
      .size = { .height = 404; .width = 505; };
    }}
    .description="Button description"
    .element_size={{ .height = viewport.height; .width = viewport.width; }}
    .id="contract-button"
    .label="Contract button"
    .order=30
    .pressed=True
    .selected=False
    .style={{
      .background_color = "button-background";
      .border_color = "button-border";
      .border_radius = 11;
      .border_width = 12;
      .color = "button-color";
      .font_size = 13;
      .font_weight = 14;
    }}
    .target=909
  />
  <Text
    .attachment={viewport_attachment (top_right, element_size (606, 707))}
    .description="Text description"
    .element_size={{ .height = 15; .width = 16; }}
    .id="contract-text"
    .label="Contract text"
    .order=10
    .style={{
      .background_color = "text-background";
      .border_color = "text-border";
      .border_radius = 17;
      .border_width = 18;
      .color = "text-color";
      .font_size = 19;
      .font_weight = 20;
    }}
  />
  <Progress
    .attachment={{
      .object = 9;
      .offset = { .x = 1111; .y = 1212; .z = 1313; };
      .size = { .height = 1414; .width = 1515; };
    }}
    .description="Progress description"
    .element_size={{ .height = 21; .width = 22; }}
    .id="contract-progress"
    .label="Contract progress"
    .maximum=99
    .order=20
    .style={{
      .background_color = "progress-background";
      .border_color = "progress-border";
      .border_radius = 23;
      .border_width = 24;
      .color = "progress-color";
      .font_size = 25;
      .font_weight = 26;
    }}
    .value=37
  />
  <Action
    .id="contract-action"
    .kind=41
    .label="Contract action"
    .target=42
    .value=43
  />
  <Status .done=True .label="Contract status" .value="Complete" />
  return ()

let render = fn () =>
  viewport <- Viewport.current ()
  <Camera .projection={orthographic} .zoom=1250000>
    <MeshResource .id=18 .url="/contract.obj" />
    <TextureResource .id=19 .url="/contract.png" />
    <TextureResource .id=20 .url="/contract-secondary.png" />
    <DirectionalLight
      .color={{ .blue = 600000; .green = 700000; .red = 800000; }}
      .direction={{ .x = -100000; .y = -200000; .z = -300000; }}
      .intensity=900000
    />
    <Object
      .id=7
      .material={{
        .blend_edges = 5;
        .color = { .blue = 750000; .green = 500000; .red = 250000; };
        .emissive = 125000;
        .path_connections = 9;
        .secondary_texture = 20;
        .surface_mode = 2;
        .texture = 19;
        .texture_offset = { .x = 150000; .y = 160000; .z = 0; };
        .texture_scale = { .x = 170000; .y = 180000; .z = 0; };
        .variation_seed = 123;
      }}
      .mesh=6
      .parent=73
      .transform={{
        .position = { .x = viewport.width; .y = viewport.height; .z = -3000000; };
        .rotation = { .x = -250000; .y = 500000; .z = -750000; };
        .scale = { .x = 1000000; .y = 2000000; .z = 3000000; };
      }}
      .visible=False
    />
  </Camera>
  return ()

phase <- Phase.current ()
state <- State.current ()
if phase == start_phase:
  <- State.commit 17

if phase == frame_phase:
  event <- Events.next ()
  delta_us <- Time.delta_us ()
  <- State.commit (
      state + event.kind + event.target + event.value + delta_us
    )

if phase == describe_phase:
  <- describe ()

if phase == render_phase:
  <- render ()

return ()
