open import "../prelude.blot"
open import "../engine.blot"
open import "../html_canvas.blot"
open import "../scene.blot"

const Abi = import "../abi.blot"
const HostEffect = Abi.HostEffect

let describe_button = fn viewport => do:
  use Button {
    .attachment = {
      .object = 7;
      .offset = { .x = 101; .y = 202; .z = 303; };
      .size = { .height = 404; .width = 505; };
    };
    .description = "Button description";
    .element_size = { .height = viewport.height; .width = viewport.width; };
    .id = "contract-button";
    .label = "Contract button";
    .order = 30;
    .pressed = True;
    .selected = False;
    .target = 909;
  } []

let describe_text = fn () => do:
  use Text {
    .attachment = viewport_attachment (top_right, element_size (606, 707));
    .description = "Text description";
    .element_size = { .height = 15; .width = 16; };
    .id = "contract-text";
    .label = "Contract text";
    .order = 10;
  } []

let describe_progress = fn () => do:
  use Progress {
    .attachment = {
      .object = 7;
      .offset = { .x = 1111; .y = 1212; .z = 1313; };
      .size = { .height = 1414; .width = 1515; };
    };
    .description = "Progress description";
    .element_size = { .height = 21; .width = 22; };
    .id = "contract-progress";
    .label = "Contract progress";
    .maximum = 99;
    .order = 20;
    .value = 37;
  } []

let describe_action = fn () => do:
  use Action {
    .id = "contract-action";
    .kind = 41;
    .label = "Contract action";
    .target = 42;
    .value = 43;
  } []

let describe_status = fn () => do:
  use Status { .done = True; .label = "Contract status"; .value = "Complete"; } []

let describe = fn () => do:
  use viewport <- Viewport.current ()
  use describe_button viewport
  use describe_text ()
  use describe_progress ()
  use describe_action ()
  use describe_status ()
  return ()

let render_mesh = fn () => do:
  use MeshResource { .asset = "contract.obj"; .id = 18; } []

let render_texture = fn () => do:
  use TextureResource { .asset = "contract.png"; .id = 19; } []

let render_secondary_texture = fn () => do:
  use TextureResource { .asset = "contract-secondary.png"; .id = 20; } []

let render_light = fn () => do:
  use DirectionalLight {
    .color = { .blue = 600000; .green = 700000; .red = 800000; };
    .direction = { .x = -100000; .y = -200000; .z = -300000; };
    .intensity = 900000;
  } []

let render_object = fn () => do:
  use viewport <- Viewport.current ()
  use Object {
    .id = 7;
    .material = {
      .blend_edges = 5;
      .color = { .blue = 750000; .green = 500000; .red = 250000; };
      .emissive = 125000;
      .path_connections = 9;
      .secondary_texture = 20;
      .surface_mode = 2;
      .texture = 19;
      .texture_offset = { .x = 150000; .y = 160000; .z = 0; };
      .texture_scale = { .x = 170000; .y = 180000; .z = 0; };
      .variation_seed = 123;
    };
    .mesh = 6;
    .parent = 73;
    .transform = {
      .position = { .x = viewport.width; .y = viewport.height; .z = -3000000; };
      .rotation = { .x = -250000; .y = 500000; .z = -750000; };
      .scale = { .x = 1000000; .y = 2000000; .z = 3000000; };
    };
    .visible = False;
  } []

let render_children = fn () => do:
  use render_mesh ()
  use render_texture ()
  use render_secondary_texture ()
  use render_light ()
  use render_object ()

let render = fn () => do:
  use OrthographicCamera {
    .clear_color = color (100000, 200000, 300000);
    .position = vec3 (1000000, 2000000, 3000000);
    .target = vec3 (4000000, 5000000, 6000000);
    .vertical_size = 10000000;
  } [render_children]
  use Environment {
    .ambient_light = color (10000, 20000, 30000);
    .bloom_intensity = 400000;
    .exposure_ev100 = -500000;
    .fog_color = color (60000, 70000, 80000);
    .fog_density = 9000;
  } []
  return ()

use phase <- Phase.current ()
use state <- State.current ()
if phase == start_phase:
  use State.commit 17

if phase == update_phase:
  use event <- Events.next ()
  use delta_us <- Time.delta_us ()
  if event.kind == 1:
    use HostEffect.play_audio {
      .cue = "contract.audio";
      .id = "contract-effect";
    }
  use State.commit (
      state + event.kind + event.target + event.value + delta_us
    )

if phase == describe_phase:
  use describe ()

if phase == render_phase:
  use render ()

return ()
