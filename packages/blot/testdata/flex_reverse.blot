open import "../prelude.blot"

const Flex = import "../flex.blot"

let fixed_child = fn () => do:
  use Flex.Child.size (#Points 10, #Points 10)
  use Flex.Child.shrink 0
  return ()

let flex_line = fn () => do:
  use Flex.Container.position (5, 7)
  use Flex.Container.size (100, 30)
  use Flex.Container.direction Flex.row_reverse
  use Flex.Container.justify Flex.space_between
  use Flex.Container.align Flex.start
  use Flex.Container.gap 5
  use Flex.Container.padding (#Edges {
    .left = 10;
    .right = 20;
    .top = 0;
    .bottom = 0;
  })
  use Flex.child fixed_child
  use Flex.child fixed_child
  return ()

return Flex.layout flex_line
