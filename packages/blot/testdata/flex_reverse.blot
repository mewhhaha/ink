open {} = (@import "../prelude.blot") ();

const Flex = (@import "../flex.blot") ();

let fixed_child = fn () => do
  _ <- Flex.Child.size (#Points 10, #Points 10);
  _ <- Flex.Child.shrink 0;
  in ()
end;

let flex_line = fn () => do
  _ <- Flex.Container.position (5, 7);
  _ <- Flex.Container.size (100, 30);
  _ <- Flex.Container.direction Flex.row_reverse;
  _ <- Flex.Container.justify Flex.space_between;
  _ <- Flex.Container.align Flex.start;
  _ <- Flex.Container.gap 5;
  _ <- Flex.Container.padding (#Edges {
    .left = 10;
    .right = 20;
    .top = 0;
    .bottom = 0;
  });
  _ <- Flex.child fixed_child;
  _ <- Flex.child fixed_child;
  in ()
end;

return Flex.layout flex_line;
