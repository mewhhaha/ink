open import "../prelude.blot"

const Flex = import "../flex.blot"

let fixed_child = fn () => do:
  use Flex.Child.size (#Points 10, #Points 20)
  use Flex.Child.shrink 0
  return ()

let flex_line = fn () => do:
  use Flex.Container.position (10, 20)
  use Flex.Container.size (60, 100)
  use Flex.Container.direction Flex.column_reverse
  use Flex.Container.justify Flex.centre
  use Flex.Container.align Flex.end
  use Flex.Container.gap 5
  use Flex.Container.padding (#Edges {
    .left = 10;
    .right = 10;
    .top = 5;
    .bottom = 15;
  })
  use Flex.child fixed_child
  use Flex.child fixed_child
  return ()

return Flex.layout flex_line
