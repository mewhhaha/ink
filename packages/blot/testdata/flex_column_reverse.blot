open {} = (@import "../prelude.blot") ();

const Flex = (@import "../flex.blot") ();

let fixed_child = fn () => do
  _ <- Flex.Child.size (#Points 10, #Points 20);
  _ <- Flex.Child.shrink 0;
  in ()
end;

let flex_line = fn () => do
  _ <- Flex.Container.position (10, 20);
  _ <- Flex.Container.size (60, 100);
  _ <- Flex.Container.direction Flex.column_reverse;
  _ <- Flex.Container.justify Flex.centre;
  _ <- Flex.Container.align Flex.end;
  _ <- Flex.Container.gap 5;
  _ <- Flex.Container.padding (#Edges {
    .left = 10;
    .right = 10;
    .top = 5;
    .bottom = 15;
  });
  _ <- Flex.child fixed_child;
  _ <- Flex.child fixed_child;
  in ()
end;

return Flex.layout flex_line;
