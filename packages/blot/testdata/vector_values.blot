open {} = (@import "../prelude.blot") ();

const Vector = (@import "../vector.blot") ();

let left = Vector.vec3 (1000000, 2000000, 3000000);
let right = Vector.vec3 (3000000, 4000000, 5000000);

return (
  Vector.zero,
  Vector.one,
  Vector.add (left, right),
  Vector.subtract (right, left),
  Vector.scale (left, 500000),
  Vector.dot (left, right),
  Vector.length_squared left,
  Vector.lerp (left, right, 250000)
);
