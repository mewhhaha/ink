open import "../prelude.blot"

const Flex = import "../flex.blot"

let fixed_child = fn () => do:
  use Flex.Child.size (#Points 10, #Points 10)
  use Flex.Child.shrink 0
  return ()

let flex_line = fn () => do:
  use Flex.Container.size (100, 10)
  use Flex.Container.direction Flex.row
  use Flex.Container.justify Flex.space_around
  use Flex.Container.align Flex.start
  use Flex.child fixed_child
  use Flex.child fixed_child
  return ()

return Flex.layout flex_line
