open import "../prelude.blot"

const Flex = import "../flex.blot"

let flex_line = fn () => do:
  use Flex.Container.size (20, 10)
  use Flex.Container.size (50, 10)
  use Flex.Container.direction Flex.row
  use Flex.Container.justify Flex.start
  use Flex.Container.justify Flex.end
  use Flex.child (fn () => do:
    use Flex.Child.size (#Points 10, #Points 10)
    use Flex.Child.size (#Points 20, #Points 10)
    use Flex.Child.shrink 0
    return ()
  )
  return ()

return Flex.layout flex_line
