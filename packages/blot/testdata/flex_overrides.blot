open {} = (@import "../prelude.blot") ();

const Flex = (@import "../flex.blot") ();

let flex_line = fn () => do
  _ <- Flex.Container.size (20, 10);
  _ <- Flex.Container.size (50, 10);
  _ <- Flex.Container.direction Flex.row;
  _ <- Flex.Container.justify Flex.start;
  _ <- Flex.Container.justify Flex.end;
  _ <- Flex.child (fn () => do
    _ <- Flex.Child.size (#Points 10, #Points 10);
    _ <- Flex.Child.size (#Points 20, #Points 10);
    _ <- Flex.Child.shrink 0;
    in ()
  end);
  in ()
end;

return Flex.layout flex_line;
