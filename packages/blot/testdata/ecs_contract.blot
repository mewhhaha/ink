open import "../prelude.blot"
open import "../engine.blot"

const Ecs = import "../ecs.blot"

const update_event = 1
const read_event = 2
const despawn_event = 3
const spawn_event = 4
const remove_position_event = 5
const count_positions_event = 6
const update_first_moving_event = 7

const Position =
  Ecs.component_2 {
    .fields = { .x = Int; .y = Int; };
    .name = "Position";
  }

const Velocity =
  Ecs.component_2 {
    .fields = { .x = Int; .y = Int; };
    .name = "Velocity";
  }

const World =
  Ecs.world {
    .base = 0;
    .capacity = 4;
    .components = [Position, Velocity];
  }

const Positions = Ecs.store (World, Position)
const Velocities = Ecs.store (World, Velocity)
const PositionX = Positions.field 0
const PositionY = Positions.field 1
const VelocityX = Velocities.field 0
const VelocityY = Velocities.field 1
const Located = Ecs.query_1 (Ecs.write Positions)
const Moving = Ecs.query_2 (Ecs.write Positions, Ecs.read Velocities)
const despawn_entity = World.despawn
const entity_generation = World.entity_generation
const entity_index = World.entity_index
const register_world = World.register
const spawn_entity = World.spawn

let start = fn () => do:
  use spawned <- spawn_entity ()
  use Positions.insert (spawned, (10, 20))
  use Velocities.insert (spawned, (3, -2))
  use State.commit spawned
  return ()

const move = fn candidate => do:
  use x <- PositionX.get_or (candidate, 0)
  use y <- PositionY.get_or (candidate, 0)
  use velocity_x <- VelocityX.get_or (candidate, 0)
  use velocity_y <- VelocityY.get_or (candidate, 0)
  use Positions.set (
    candidate,
    (
      x + velocity_x,
      y + velocity_y
    )
  )
  return ()

const Movement = Ecs.system (Moving, move)

const double_position_x = fn candidate => do:
  use x <- PositionX.get_or (candidate, 0)
  use PositionX.set (candidate, x * 2)
  return ()

const PositionScaling = Ecs.system (Located, double_position_x)
const Update = Ecs.systems [Movement, PositionScaling]

let read_position = fn candidate => do:
  use present <- Positions.has candidate
  if present <= 0:
    return -1

  use x <- PositionX.get_or (candidate, 0)
  use y <- PositionY.get_or (candidate, 0)
  return x * 100 + y

let execute_phase = fn (phase, state) => do:
  if phase == schema_phase:
    use register_world ()

  if phase == start_phase:
    use start ()

  if phase == frame_phase:
    use event <- Events.next ()
    let event_kind = event.kind
    let event_target = event.target
    if event_kind == update_event:
      use Update event_target
      use position <- read_position event_target
      use State.commit position

    if event_kind == read_event:
      use position <- read_position event_target
      use State.commit position

    if event_kind == despawn_event:
      use despawn_entity event_target
      use State.commit state

    if event_kind == spawn_event:
      use spawned <- spawn_entity ()
      use State.commit (
        entity_generation spawned * 100
        + entity_index spawned
      )

    if event_kind == remove_position_event:
      use Positions.remove event_target
      use State.commit state

    if event_kind == count_positions_event:
      use span <- Positions.candidate_span ()
      use State.commit span

    if event_kind == update_first_moving_event:
      use Moving.visit_at (0, move)
      use position <- read_position event_target
      use State.commit position

  return ()

use phase <- Phase.current ()
use state <- State.current ()
use execute_phase (phase, state)

return ()
