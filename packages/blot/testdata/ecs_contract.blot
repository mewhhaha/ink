open @import "../prelude.blot" ()
open @import "../engine.blot" ()

const Ecs = @import "../ecs.blot" ()

const update_event = 1
const read_event = 2
const despawn_event = 3
const spawn_event = 4
const remove_position_event = 5
const count_positions_event = 6
const update_first_moving_event = 7

const Position = Ecs.component_2 {
  .fields = { .x = Int; .y = Int; };
  .name = "Position";
}

const Velocity = Ecs.component_2 {
  .fields = { .x = Int; .y = Int; };
  .name = "Velocity";
}

const World = Ecs.world {
  .base = 0;
  .capacity = 4;
  .components = [Position, Velocity];
}

const Positions = Ecs.store (World, Position)
const Velocities = Ecs.store (World, Velocity)
const PositionX = Positions.field 0
const PositionY = Positions.field 1
const VelocityX = Velocities.field 0
const VelocityY = Velocities.field 1
const Located = Ecs.query_1 (Ecs.write Positions)
const Moving = Ecs.query_2 (Ecs.write Positions, Ecs.read Velocities)
const despawn_entity = World.despawn
const entity_generation = World.entity_generation
const entity_index = World.entity_index
const register_world = World.register
const spawn_entity = World.spawn

let start = fn () =>
  spawned <- spawn_entity ()
  _ <- Positions.insert (spawned, (10, 20))
  _ <- Velocities.insert (spawned, (3, -2))
  _ <- State.commit spawned
  return ()

const move = fn candidate =>
  x <- PositionX.get_or (candidate, 0)
  y <- PositionY.get_or (candidate, 0)
  velocity_x <- VelocityX.get_or (candidate, 0)
  velocity_y <- VelocityY.get_or (candidate, 0)
  _ <- Positions.set (
    candidate,
    (
    x + velocity_x,
    y + velocity_y
    )
  )
  return ()

const Movement = Ecs.system (Moving, move)

const double_position_x = fn candidate =>
  x <- PositionX.get_or (candidate, 0)
  _ <- PositionX.set (candidate, x * 2)
  return ()

const PositionScaling = Ecs.system (Located, double_position_x)
const Update = Ecs.systems [Movement, PositionScaling]

let read_position = fn candidate =>
  present <- Positions.has candidate
  value <- if present > 0:
    x <- PositionX.get_or (candidate, 0)
    y <- PositionY.get_or (candidate, 0)
    return x * 100 + y
  else:
    return -1
  return value

let execute_phase = fn (phase, state) =>
  _ <- if phase == schema_phase:
    _ <- register_world ()
    return ()
  else:
    return ()
  _ <- if phase == start_phase:
    return start ()
  else:
    return ()
  _ <- if phase == frame_phase:
    event <- Events.next ()
    let event_kind = event.kind
    let event_target = event.target
    _ <- if event_kind == update_event:
      _ <- Update event_target
      position <- read_position event_target
      _ <- State.commit position
      return ()
    else:
      return ()
    _ <- if event_kind == read_event:
      position <- read_position event_target
      _ <- State.commit position
      return ()
    else:
      return ()
    _ <- if event_kind == despawn_event:
      _ <- despawn_entity event_target
      _ <- State.commit state
      return ()
    else:
      return ()
    _ <- if event_kind == spawn_event:
      spawned <- spawn_entity ()
      _ <- State.commit (
      entity_generation spawned * 100
      + entity_index spawned
      )
      return ()
    else:
      return ()
    _ <- if event_kind == remove_position_event:
      _ <- Positions.remove event_target
      _ <- State.commit state
      return ()
    else:
      return ()
    _ <- if event_kind == count_positions_event:
      span <- Positions.candidate_span ()
      _ <- State.commit span
      return ()
    else:
      return ()
    _ <- if event_kind == update_first_moving_event:
      _ <- Moving.visit_at (0, move)
      position <- read_position event_target
      _ <- State.commit position
      return ()
    else:
      return ()
    return ()
  else:
    return ()
  return ()

phase <- Phase.current ()
state <- State.current ()
_ <- execute_phase (phase, state)

return ()
