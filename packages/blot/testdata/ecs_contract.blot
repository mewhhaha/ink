open {} = (@import "../prelude.blot") ();
open {} = (@import "../engine.blot") ();

const Ecs = (@import "../ecs.blot") ();

const update_event = 1;
const read_event = 2;
const despawn_event = 3;
const spawn_event = 4;
const remove_position_event = 5;
const count_positions_event = 6;
const update_first_moving_event = 7;
const write_counter_event = 8;
const read_counter_event = 9;

const Position = comptime (Ecs.component ("Position", { .x = Int; .y = Int; }));
const Velocity = comptime (Ecs.component (
  "Velocity",
  { .speed = Int; .x = Int; .y = Int; }
));
const Counter = comptime (Ecs.resource ("Counter", { .value = 7; }));

const move = fn candidate => do
  position_x <- Position.x.get_or (candidate, 0);
  position_y <- Position.y.get_or (candidate, 0);
  velocity_x <- Velocity.x.get_or (candidate, 0);
  velocity_y <- Velocity.y.get_or (candidate, 0);
  _ <- Position.x.set (candidate, position_x + velocity_x);
  _ <- Position.y.set (candidate, position_y + velocity_y);
end;

const double_position_x = fn candidate => do
  x <- Position.x.get_or (candidate, 0);
  _ <- Position.x.set (candidate, x * 2);
end;

const read_position = fn candidate => do
  x <- Position.x.get_or (candidate, -1);
  if x < 0 then do
    return -1;
  end;
  y <- Position.y.get_or (candidate, 0);
  return x * 100 + y;
end;

const start_game = fn () => do
  spawned <- Ecs.spawn ();
  return case spawned of
    #Some candidate => do
      _ <- Position.insert (candidate, { .x = 10; .y = 20; });
      _ <- Velocity.insert (candidate, { .speed = 1; .x = 3; .y = -2; });
      _ <- State.commit candidate;
    end,
    #None => do
      _ <- State.commit (-1);
    end
  end;
end;

const update_game = fn state => do
  event <- Events.next ();
  let event_kind = event.kind;
  let event_target = event.target;
  if event_kind == update_event then do
    let visit = Ecs.query (fn () => do
      _ <- Position.require ();
      _ <- Velocity.require ();
      return Ecs.entity ();
    end);
    _ <- visit (fn candidate => do
      if candidate == event_target then do
        _ <- move candidate;
      end;
    end);
    _ <- double_position_x event_target;
    position <- read_position event_target;
    _ <- State.commit position;
  end;
  if event_kind == read_event then do
    position <- read_position event_target;
    _ <- State.commit position;
  end;
  if event_kind == despawn_event then do
    _ <- Ecs.despawn event_target;
    _ <- State.commit state;
  end;
  if event_kind == spawn_event then do
    spawned <- Ecs.spawn ();
    _ <- case spawned of
      #Some candidate => do
        generation <- Ecs.entity_generation candidate;
        index <- Ecs.entity_index candidate;
        _ <- State.commit (generation * 100 + index);
      end,
      #None => do
        _ <- State.commit (-1);
      end
    end;
  end;
  if event_kind == remove_position_event then do
    _ <- Position.remove event_target;
    _ <- State.commit state;
  end;
  if event_kind == count_positions_event then do
    let visit = Ecs.query (fn () => do
      _ <- Position.require ();
      return Ecs.entity ();
    end);
    let count = 0;
    _ <- visit (fn _ => do
      count := count + 1;
    end);
    _ <- State.commit count;
  end;
  if event_kind == update_first_moving_event then do
    let visit = Ecs.query (fn () => do
      _ <- Position.require ();
      _ <- Velocity.require ();
      return Ecs.entity ();
    end);
    let moved = 0;
    _ <- visit (fn candidate => do
      if moved == 0 then do
        _ <- move candidate;
        moved := 1;
      end;
    end);
    position <- read_position event_target;
    _ <- State.commit position;
  end;
  if event_kind == write_counter_event then do
    _ <- Counter.value.set event_target;
    _ <- State.commit state;
  end;
  if event_kind == read_counter_event then do
    value <- Counter.value.get ();
    _ <- State.commit value;
  end;
end;

const start_system = fn () => do
  phase <- Phase.current ();
  if phase == start_phase then do
    _ <- start_game ();
  end;
end;

const update_system = fn () => do
  phase <- Phase.current ();
  state <- State.current ();
  if phase == frame_phase then do
    _ <- update_game state;
  end;
end;

const City = comptime (Ecs.world (Ecs.entities.dynamic 4)
  |> Ecs.add_system start_system
  |> Ecs.add_system update_system
  |> Ecs.build);

phase <- Phase.current ();
if phase == schema_phase then do
  _ <- City.register ();
end;
_ <- Ecs.run City;

return ();
