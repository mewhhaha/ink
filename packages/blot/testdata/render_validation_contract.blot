open import "../prelude.blot"
open import "../engine.blot"
open import "../scene.blot"

const missing_camera = 101
const duplicate_camera = 102
const invalid_perspective_field_of_view = 103
const invalid_orthographic_size = 104
const camera_fixed_point_overflow = 105
const equal_camera_view = 106
const missing_environment = 107
const duplicate_environment = 108
const negative_fog_density = 109
const negative_bloom_intensity = 110
const negative_light_color = 111
const excessive_light_color = 112
const zero_light_direction = 113
const zero_light_intensity = 114
const negative_light_intensity = 115
const light_fixed_point_overflow = 116
const missing_light = 117
const duplicate_light = 118
const equal_orthographic_view = 119
const excessive_perspective_field_of_view = 120
const negative_orthographic_size = 121

let render_camera = fn scenario => do:
  if scenario == invalid_orthographic_size || scenario == equal_orthographic_view || scenario == negative_orthographic_size:
    let target_z = case scenario == equal_orthographic_view of
      #True => 5000000
      #False => 0
    let vertical_size = case scenario == invalid_orthographic_size of
      #True => 0
      #False => case scenario == negative_orthographic_size of
        #True => -1
        #False => 5000000
    use OrthographicCamera {
      .clear_color = color (0, 0, 0);
      .position = vec3 (0, 0, 5000000);
      .target = vec3 (0, 0, target_z);
      .vertical_size = vertical_size;
    } []

  if scenario != missing_camera && scenario != invalid_orthographic_size && scenario != equal_orthographic_view && scenario != negative_orthographic_size:
    let position_x = case scenario == camera_fixed_point_overflow of
      #True => 9007199254740992
      #False => 0
    let target_z = case scenario == equal_camera_view of
      #True => 5000000
      #False => 0
    let vertical_fov = case scenario of
      103 => 0
      120 => 3141593
      _ => 720000
    use PerspectiveCamera {
      .clear_color = color (0, 0, 0);
      .position = vec3 (position_x, 0, 5000000);
      .target = vec3 (0, 0, target_z);
      .vertical_fov_microradians = vertical_fov;
    } []

  if scenario == duplicate_camera:
    use PerspectiveCamera {
      .clear_color = color (0, 0, 0);
      .position = vec3 (0, 1000000, 5000000);
      .target = vec3 (0, 0, 0);
      .vertical_fov_microradians = 720000;
    } []

  return ()

let render_environment = fn scenario => do:
  if scenario != missing_environment:
    let fog_density = case scenario == negative_fog_density of
      #True => -1
      #False => 1000
    let bloom_intensity = case scenario == negative_bloom_intensity of
      #True => -1
      #False => 100000
    use Environment {
      .ambient_light = color (100000, 100000, 100000);
      .bloom_intensity = bloom_intensity;
      .exposure_ev100 = 0;
      .fog_color = color (0, 0, 0);
      .fog_density = fog_density;
    } []

  if scenario == duplicate_environment:
    use Environment {
      .ambient_light = color (200000, 200000, 200000);
      .bloom_intensity = 0;
      .exposure_ev100 = 0;
      .fog_color = color (0, 0, 0);
      .fog_density = 0;
    } []

  return ()

let render_light = fn scenario => do:
  if scenario != missing_light:
    let red = case scenario of
      111 => -1
      112 => 1000001
      _ => 1000000
    let direction_y = case scenario == zero_light_direction of
      #True => 0
      #False => -1000000
    let intensity = case scenario of
      114 => 0
      115 => -1
      116 => 9007199254740992
      _ => 1000000
    use DirectionalLight {
      .color = color (red, 1000000, 1000000);
      .direction = vec3 (0, direction_y, 0);
      .intensity = intensity;
    } []

  if scenario == duplicate_light:
    use DirectionalLight {
      .color = color (1000000, 1000000, 1000000);
      .direction = vec3 (0, -1000000, 0);
      .intensity = 1000000;
    } []

  return ()

use phase <- Phase.current ()
use state <- State.current ()
if phase == start_phase:
  use State.commit 0

if phase == update_phase:
  use State.commit state

if phase == render_phase:
  use viewport <- Viewport.current ()
  use render_camera viewport.width
  use render_environment viewport.width
  use render_light viewport.width

return ()
