open {} = (@import "../prelude.blot") ();

const Flex = (@import "../flex.blot") ();

let fixed_child = fn () => do
  _ <- Flex.Child.size (#Points 10, #Points 10);
  _ <- Flex.Child.shrink 0;
  in ()
end;

let flex_line = fn () => do
  _ <- Flex.Container.size (100, 10);
  _ <- Flex.Container.direction Flex.row;
  _ <- Flex.Container.justify Flex.space_evenly;
  _ <- Flex.Container.align Flex.start;
  _ <- Flex.child fixed_child;
  _ <- Flex.child fixed_child;
  in ()
end;

return Flex.layout flex_line;
