open import "../prelude.blot"

const Tilemap = import "../tilemap.blot"
return (
  Tilemap.contains_tile (0, 0, 4, 3),
  Tilemap.contains_tile (3, 2, 4, 3),
  Tilemap.contains_tile (4, 2, 4, 3),
  Tilemap.contains_tile (-1, 0, 4, 3),
  Tilemap.tile_index (3, 2, 4, 3),
  Tilemap.tile_index (4, 2, 4, 3),
  Tilemap.tile_coordinates (11, 4, 3),
  Tilemap.tile_coordinates (12, 4, 3),
  Tilemap.orthogonal_tile_to_world (-2, 3, 64, 32),
  Tilemap.orthogonal_world_to_tile (-1, 63, 64, 32),
  Tilemap.isometric_tile_to_world (2, 1, 128, 64),
  Tilemap.isometric_world_to_tile (64, 96, 128, 64),
  Tilemap.isometric_tile_to_world (-2, 1, 128, 64),
  Tilemap.isometric_world_to_tile (-192, -32, 128, 64),
  Tilemap.isometric_tile_to_world (-1, 0, 63, 31)
  )
