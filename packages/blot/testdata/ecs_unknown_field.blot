open {} = (@import "../prelude.blot") ();

const Ecs = (@import "../ecs.blot") ();

const Position = Ecs.component { .x = Int; .y = Int; };
const ReadPosition = Ecs.system (
  "read",
  { .Position = Ecs.read Position; }
);
const City = Ecs.world (Ecs.entities.dynamic 4)
  |> Ecs.add_system ReadPosition
  |> Ecs.build;
open {} = City.read;

return Position.z.column;
