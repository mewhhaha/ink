open {} = (@import "../prelude.blot") ();

const Ecs = (@import "../ecs.blot") ();
const Position = Ecs.component { .x = Int; };
const ReadPosition = Ecs.system (
  "read",
  { .Position = Ecs.read Position; }
);
const World = Ecs.world (Ecs.entities.fixed 1)
  |> Ecs.add_system ReadPosition
  |> Ecs.build;
const Read = World.read;

return Read.Position.insert (0, { .x = 1; });
