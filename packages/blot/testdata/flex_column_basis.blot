open import "../prelude.blot"

const Flex = import "../flex.blot"

let flex_line = fn () => do:
  use Flex.Container.position (5, 10)
  use Flex.Container.size (40, 100)
  use Flex.Container.justify Flex.end
  use Flex.Container.align Flex.start
  use Flex.Container.gap 10
  use Flex.child (fn () => do:
    use Flex.Child.size (#Points 10, #Points 20)
    use Flex.Child.basis (#Points 30)
    use Flex.Child.shrink 0
    return ()
  )
  use Flex.child (fn () => do:
    use Flex.Child.size (#Points 10, #Points 20)
    use Flex.Child.shrink 0
    return ()
  )
  return ()

return Flex.layout flex_line
