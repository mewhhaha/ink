open {} = (@import "../prelude.blot") ();

const Flex = (@import "../flex.blot") ();

let flex_line = fn () => do
  _ <- Flex.Container.position (5, 10);
  _ <- Flex.Container.size (40, 100);
  _ <- Flex.Container.justify Flex.end;
  _ <- Flex.Container.align Flex.start;
  _ <- Flex.Container.gap 10;
  _ <- Flex.child (fn () => do
    _ <- Flex.Child.size (#Points 10, #Points 20);
    _ <- Flex.Child.basis (#Points 30);
    _ <- Flex.Child.shrink 0;
    in ()
  end);
  _ <- Flex.child (fn () => do
    _ <- Flex.Child.size (#Points 10, #Points 20);
    _ <- Flex.Child.shrink 0;
    in ()
  end);
  in ()
end;

return Flex.layout flex_line;
