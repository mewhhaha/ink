open {} = (@import "../prelude.blot") ();
open {} = (@import "../engine.blot") ();

const Ecs = (@import "../ecs.blot") ();
const Position = comptime (Ecs.component ("Position", { .x = Int; }));

const read = fn candidate => do
  value <- Position.x.get_or (candidate, 0);
  return ();
end;
const read_system = fn () => do
  phase <- Phase.current ();
  if phase == start_phase then do
    _ <- Position.insert (0, { .x = 1; });
  end;
  if phase == frame_phase then do
    _ <- read 0;
  end;
end;

const World = comptime (Ecs.world (Ecs.entities.fixed 1)
  |> Ecs.add_system read_system
  |> Ecs.build);

_ <- Ecs.run World;
return ();
