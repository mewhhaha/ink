open import "../prelude.blot"

const Flex = import "../flex.blot"

let flex_line = fn () => do:
  use Flex.Container.size (100, 50)
  use Flex.Container.direction Flex.row
  use Flex.Container.align Flex.start
  use Flex.Container.padding (#Axes (10, 0))
  use Flex.child (fn () => do:
    use Flex.Child.size (#Points 60, #Points 10)
    use Flex.Child.margin (#Axes (5, 0))
    return ()
  )
  use Flex.child (fn () => do:
    use Flex.Child.size (#Points 60, #Points 10)
    use Flex.Child.shrink 3
    return ()
  )
  return ()

return Flex.layout flex_line
