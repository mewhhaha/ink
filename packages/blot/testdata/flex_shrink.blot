open {} = (@import "../prelude.blot") ();

const Flex = (@import "../flex.blot") ();

let flex_line = fn () => do
  _ <- Flex.Container.size (100, 50);
  _ <- Flex.Container.direction Flex.row;
  _ <- Flex.Container.align Flex.start;
  _ <- Flex.Container.padding (#Axes (10, 0));
  _ <- Flex.child (fn () => do
    _ <- Flex.Child.size (#Points 60, #Points 10);
    _ <- Flex.Child.margin (#Axes (5, 0));
    in ()
  end);
  _ <- Flex.child (fn () => do
    _ <- Flex.Child.size (#Points 60, #Points 10);
    _ <- Flex.Child.shrink 3;
    in ()
  end);
  in ()
end;

return Flex.layout flex_line;
