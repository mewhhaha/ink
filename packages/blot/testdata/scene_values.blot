open import "../prelude.blot"

const Scene = import "../scene.blot"

let position = Scene.vec3 (1, 2, 3)
let rotation = Scene.vec3 (4, 5, 6)
let scale = Scene.uniform_scale 7

return (
  Scene.transform (position, rotation, scale),
  Scene.material {
    .blend_edges = 0;
    .color = Scene.color (8, 9, 10);
    .emissive = 11;
    .path_connections = 0;
    .secondary_texture = -1;
    .surface_mode = 0;
    .texture = -1;
    .texture_scale_x = 1000000;
    .texture_scale_y = 1000000;
    .variation_seed = 0;
  }
  )
