open @import "./prelude.blot" ()

const Semantic = @effect.host {
  .action = {
    .id = Str;
    .kind = Int;
    .label = Str;
    .target = Int;
    .value = Int;
  } -> Unit;
  .element = {
    .description = Str;
    .element_height = Int;
    .element_width = Int;
    .id = Str;
    .kind = Int;
    .label = Str;
    .maximum = Int;
    .order = Int;
    .pressed = Bool;
    .selected = Bool;
    .target = Int;
    .value = Int;
  } -> Unit;
  .placement = {
    .id = Str;
    .object = Int;
    .offset_x = Int;
    .offset_y = Int;
    .offset_z = Int;
    .plane_height = Int;
    .plane_width = Int;
  } -> Unit;
  .style = {
    .id = Str;
    .style = {
      .background_color = Str;
      .border_color = Str;
      .border_radius = Int;
      .border_width = Int;
      .color = Str;
      .font_size = Int;
      .font_weight = Int;
    };
  } -> Unit;
  .status = { .done = Bool; .label = Str; .value = Str; } -> Unit;
}

const button_kind = 0
const text_kind = 1
const progress_kind = 2
const top_left = -1
const top_right = -2
const bottom_left = -3
const bottom_right = -4
const center = -5

const element_size = fn (width, height) => {
  .height = height;
  .width = width;
  }

const attachment = fn (object, offset, size) => {
  .object = object;
  .offset = offset;
  .size = size;
  }

const viewport_attachment = fn (anchor, inset) => {
  .object = anchor;
  .offset = { .x = inset.width; .y = inset.height; .z = 0; };
  .size = element_size (0, 0);
  }

const style = fn (
  background_color,
  border_color,
  border_radius,
  border_width,
  color,
  font_size,
  font_weight
  ) => {
    .background_color = background_color;
    .border_color = border_color;
    .border_radius = border_radius;
    .border_width = border_width;
    .color = color;
    .font_size = font_size;
    .font_weight = font_weight;
  }

let Button = fn properties => fn children =>
  let attached = properties.attachment
  let offset = attached.offset
  let plane = attached.size
  _ <- Semantic.placement {
    .id = properties.id;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .plane_height = plane.height;
    .plane_width = plane.width;
  }
  _ <- Semantic.style { .id = properties.id; .style = properties.style; }
  _ <- Semantic.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = button_kind;
    .label = properties.label;
    .maximum = 0;
    .order = properties.order;
    .pressed = properties.pressed;
    .selected = properties.selected;
    .target = properties.target;
    .value = 0;
  }
  _ <- children ()

let Text = fn properties => fn children =>
  let attached = properties.attachment
  let offset = attached.offset
  let plane = attached.size
  _ <- Semantic.placement {
    .id = properties.id;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .plane_height = plane.height;
    .plane_width = plane.width;
  }
  _ <- Semantic.style { .id = properties.id; .style = properties.style; }
  _ <- Semantic.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = text_kind;
    .label = properties.label;
    .maximum = 0;
    .order = properties.order;
    .pressed = False;
    .selected = False;
    .target = 0;
    .value = 0;
  }
  _ <- children ()

let Progress = fn properties => fn children =>
  let attached = properties.attachment
  let offset = attached.offset
  let plane = attached.size
  _ <- Semantic.placement {
    .id = properties.id;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .plane_height = plane.height;
    .plane_width = plane.width;
  }
  _ <- Semantic.style { .id = properties.id; .style = properties.style; }
  _ <- Semantic.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = progress_kind;
    .label = properties.label;
    .maximum = properties.maximum;
    .order = properties.order;
    .pressed = False;
    .selected = False;
    .target = 0;
    .value = properties.value;
  }
  _ <- children ()

let Action = fn properties => fn children =>
  _ <- Semantic.action properties
  _ <- children ()

let Status = fn properties => fn children =>
  _ <- Semantic.status properties
  _ <- children ()

return {
  .Semantic = Semantic;
  .Button = Button;
  .Text = Text;
  .Progress = Progress;
  .Action = Action;
  .Status = Status;
  .element_size = element_size;
  .attachment = attachment;
  .viewport_attachment = viewport_attachment;
  .top_left = top_left;
  .top_right = top_right;
  .bottom_left = bottom_left;
  .bottom_right = bottom_right;
  .center = center;
  .style = style;
}
