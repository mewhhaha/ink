open {} = (@import "./prelude.blot") ();

const Semantic = @effect.host {
  .action = {
    .id = Str;
    .kind = Int;
    .label = Str;
    .target = Int;
    .value = Int;
  } -> Unit;
  .element = {
    .description = Str;
    .element_height = Int;
    .element_width = Int;
    .id = Str;
    .kind = Int;
    .label = Str;
    .maximum = Int;
    .object = Int;
    .offset_x = Int;
    .offset_y = Int;
    .offset_z = Int;
    .order = Int;
    .plane_height = Int;
    .plane_width = Int;
    .pressed = Bool;
    .selected = Bool;
    .style = {
      .background_color = Str;
      .border_color = Str;
      .border_radius = Int;
      .border_width = Int;
      .color = Str;
      .font_size = Int;
      .font_weight = Int;
    };
    .target = Int;
    .value = Int;
  } -> Unit;
  .status = { .done = Bool; .label = Str; .value = Str; } -> Unit;
};

const button_kind = 0;
const text_kind = 1;
const progress_kind = 2;

const element_size = fn (width, height) => {
  .height = height;
  .width = width;
};

const attachment = fn (object, offset, size) => {
  .object = object;
  .offset = offset;
  .size = size;
};

const style = fn (
  background_color,
  border_color,
  border_radius,
  border_width,
  color,
  font_size,
  font_weight
) => {
  .background_color = background_color;
  .border_color = border_color;
  .border_radius = border_radius;
  .border_width = border_width;
  .color = color;
  .font_size = font_size;
  .font_weight = font_weight;
};

let Button = fn properties => fn children => do
  let attached = properties.attachment;
  let offset = attached.offset;
  let plane = attached.size;
  _ <- Semantic.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = button_kind;
    .label = properties.label;
    .maximum = 0;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .order = properties.order;
    .plane_height = plane.height;
    .plane_width = plane.width;
    .pressed = properties.pressed;
    .selected = properties.selected;
    .style = properties.style;
    .target = properties.target;
    .value = 0;
  };
  _ <- children ();
end;

let Text = fn properties => fn children => do
  let attached = properties.attachment;
  let offset = attached.offset;
  let plane = attached.size;
  _ <- Semantic.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = text_kind;
    .label = properties.label;
    .maximum = 0;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .order = properties.order;
    .plane_height = plane.height;
    .plane_width = plane.width;
    .pressed = False;
    .selected = False;
    .style = properties.style;
    .target = 0;
    .value = 0;
  };
  _ <- children ();
end;

let Progress = fn properties => fn children => do
  let attached = properties.attachment;
  let offset = attached.offset;
  let plane = attached.size;
  _ <- Semantic.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = progress_kind;
    .label = properties.label;
    .maximum = properties.maximum;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .order = properties.order;
    .plane_height = plane.height;
    .plane_width = plane.width;
    .pressed = False;
    .selected = False;
    .style = properties.style;
    .target = 0;
    .value = properties.value;
  };
  _ <- children ();
end;

let Action = fn properties => fn children => do
  _ <- Semantic.action properties;
  _ <- children ();
end;

let Status = fn properties => fn children => do
  _ <- Semantic.status properties;
  _ <- children ();
end;

return {
  .Semantic = Semantic;
  .Button = Button;
  .Text = Text;
  .Progress = Progress;
  .Action = Action;
  .Status = Status;
  .element_size = element_size;
  .attachment = attachment;
  .style = style;
};
