open @import "./prelude.blot" ()

const Semantic = @effect.host {
  .action = {
    .id = Str;
    .kind = Int;
    .label = Str;
    .target = Int;
    .value = Int;
  } -> Unit;
  .element = {
    .description = Str;
    .element_height = Int;
    .element_width = Int;
    .id = Str;
    .kind = Int;
    .label = Str;
    .maximum = Int;
    .order = Int;
    .pressed = Bool;
    .selected = Bool;
    .target = Int;
    .value = Int;
  } -> Unit;
  .placement = {
    .id = Str;
    .object = Int;
    .offset_x = Int;
    .offset_y = Int;
    .offset_z = Int;
    .plane_height = Int;
    .plane_width = Int;
  } -> Unit;
  .style = {
    .id = Str;
    .style = {
      .background_color = Str;
      .border_color = Str;
      .border_radius = Int;
      .border_width = Int;
      .color = Str;
      .font_size = Int;
      .font_weight = Int;
    };
  } -> Unit;
  .status = { .done = Bool; .label = Str; .value = Str; } -> Unit;
}

const button_kind = 0
const text_kind = 1
const progress_kind = 2
const top_left = -1
const top_right = -2
const bottom_left = -3
const bottom_right = -4
const center = -5

const Vector3 = { .x = Int; .y = Int; .z = Int; }
const ElementSize = { .height = Int; .width = Int; }
const Attachment = {
  .object = Int;
  .offset = Vector3;
  .size = ElementSize;
}
const AttachmentOptions = {
  .height? = Int;
  .object? = Int;
  .offset_x? = Int;
  .offset_y? = Int;
  .offset_z? = Int;
  .width? = Int;
}
const Style = {
  .background_color = Str;
  .border_color = Str;
  .border_radius = Int;
  .border_width = Int;
  .color = Str;
  .font_size = Int;
  .font_weight = Int;
}
const StyleOptions = {
  .background? = Str;
  .border? = Str;
  .border_radius? = Int;
  .border_width? = Int;
  .color? = Str;
  .font_size? = Int;
  .font_weight? = Int;
}

const element_size = fn (width, height) => {
    .height = height;
    .width = width;
  }

sig attachment = AttachmentOptions -> Attachment
let attachment = fn properties =>
  let object = case properties.object of
    () => center
    present => @satisfies present Int
  let offset_x = case properties.offset_x of
    () => 0
    present => @satisfies present Int
  let offset_y = case properties.offset_y of
    () => 0
    present => @satisfies present Int
  let offset_z = case properties.offset_z of
    () => 0
    present => @satisfies present Int
  let width = case properties.width of
    () => 0
    present => @satisfies present Int
  let height = case properties.height of
    () => 0
    present => @satisfies present Int
  return {
    .object = object;
    .offset = { .x = offset_x; .y = offset_y; .z = offset_z; };
    .size = element_size (width, height);
  }

const viewport_attachment = fn (anchor, inset) => attachment {
    .height = 0;
    .object = anchor;
    .offset_x = inset.width;
    .offset_y = inset.height;
    .offset_z = 0;
    .width = 0;
  }

sig style = StyleOptions -> Style
let style = fn properties =>
  let background = case properties.background of
    () => ""
    present => @satisfies present Str
  let border = case properties.border of
    () => ""
    present => @satisfies present Str
  let border_radius = case properties.border_radius of
    () => 0
    present => @satisfies present Int
  let border_width = case properties.border_width of
    () => 0
    present => @satisfies present Int
  let color = case properties.color of
    () => ""
    present => @satisfies present Str
  let font_size = case properties.font_size of
    () => 16
    present => @satisfies present Int
  let font_weight = case properties.font_weight of
    () => 400
    present => @satisfies present Int
  return {
    .background_color = background;
    .border_color = border;
    .border_radius = border_radius;
    .border_width = border_width;
    .color = color;
    .font_size = font_size;
    .font_weight = font_weight;
  }

let run_children = fn children =>
  for child in Iter.items children:
    <- child ()

  return ()

let Button = fn properties => fn children =>
  let attached = properties.attachment
  let offset = attached.offset
  let plane = attached.size
  <- Semantic.placement {
    .id = properties.id;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .plane_height = plane.height;
    .plane_width = plane.width;
  }
  <- Semantic.style { .id = properties.id; .style = properties.style; }
  <- Semantic.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = button_kind;
    .label = properties.label;
    .maximum = 0;
    .order = properties.order;
    .pressed = properties.pressed;
    .selected = properties.selected;
    .target = properties.target;
    .value = 0;
  }
  <- run_children children

let Text = fn properties => fn children =>
  let attached = properties.attachment
  let offset = attached.offset
  let plane = attached.size
  <- Semantic.placement {
    .id = properties.id;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .plane_height = plane.height;
    .plane_width = plane.width;
  }
  <- Semantic.style { .id = properties.id; .style = properties.style; }
  <- Semantic.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = text_kind;
    .label = properties.label;
    .maximum = 0;
    .order = properties.order;
    .pressed = False;
    .selected = False;
    .target = 0;
    .value = 0;
  }
  <- run_children children

let Progress = fn properties => fn children =>
  let attached = properties.attachment
  let offset = attached.offset
  let plane = attached.size
  <- Semantic.placement {
    .id = properties.id;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .plane_height = plane.height;
    .plane_width = plane.width;
  }
  <- Semantic.style { .id = properties.id; .style = properties.style; }
  <- Semantic.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = progress_kind;
    .label = properties.label;
    .maximum = properties.maximum;
    .order = properties.order;
    .pressed = False;
    .selected = False;
    .target = 0;
    .value = properties.value;
  }
  <- run_children children

let Action = fn properties => fn children =>
  <- Semantic.action properties
  <- run_children children

let Status = fn properties => fn children =>
  <- Semantic.status properties
  <- run_children children

return {
  .Semantic = Semantic;
  .Button = Button;
  .Text = Text;
  .Progress = Progress;
  .Action = Action;
  .Status = Status;
  .element_size = element_size;
  .attachment = attachment;
  .viewport_attachment = viewport_attachment;
  .top_left = top_left;
  .top_right = top_right;
  .bottom_left = bottom_left;
  .bottom_right = bottom_right;
  .center = center;
  .style = style;
}
