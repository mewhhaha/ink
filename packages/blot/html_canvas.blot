open import "./prelude.blot"

const Abi = import "./abi.blot"
const Protocol = Abi.Protocol
const Ui = Abi.Ui

const button_kind = Protocol.ui.roles.button
const text_kind = Protocol.ui.roles.text
const progress_kind = Protocol.ui.roles.progress
const top_left = Protocol.ui.viewport_anchors.top_left
const top_right = Protocol.ui.viewport_anchors.top_right
const bottom_left = Protocol.ui.viewport_anchors.bottom_left
const bottom_right = Protocol.ui.viewport_anchors.bottom_right
const center = Protocol.ui.viewport_anchors.center

const Vector3 = { .x = Int; .y = Int; .z = Int; }
const ElementSize = { .height = Int; .width = Int; }
const Attachment =
  {
    .object = Int;
    .offset = Vector3;
    .size = ElementSize;
  }
const AttachmentOptions =
  {
    .height? = Int;
    .object? = Int;
    .offset_x? = Int;
    .offset_y? = Int;
    .offset_z? = Int;
    .width? = Int;
  }
const element_size = fn (width, height) => {
  .height = height;
  .width = width;
}

let attachment :: AttachmentOptions -> Attachment
let attachment = fn properties => do:
  let object = case properties.object of
    () => center
    present => @satisfies present Int
  let offset_x = case properties.offset_x of
    () => 0
    present => @satisfies present Int
  let offset_y = case properties.offset_y of
    () => 0
    present => @satisfies present Int
  let offset_z = case properties.offset_z of
    () => 0
    present => @satisfies present Int
  let width = case properties.width of
    () => 0
    present => @satisfies present Int
  let height = case properties.height of
    () => 0
    present => @satisfies present Int
  return {
    .object = object;
    .offset = { .x = offset_x; .y = offset_y; .z = offset_z; };
    .size = element_size (width, height);
    }

let viewport_attachment = fn (anchor, inset) => attachment {
  .height = 0;
  .object = anchor;
  .offset_x = inset.width;
  .offset_y = inset.height;
  .offset_z = 0;
  .width = 0;
}

let run_children = fn children => do:
  for child in Iter.items children:
    use child

  return ()

let Button = fn properties => fn children => do:
  let attached = properties.attachment
  let offset = attached.offset
  let plane = attached.size
  use Ui.placement {
    .id = properties.id;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .plane_height = plane.height;
    .plane_width = plane.width;
  }
  use Ui.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = button_kind;
    .label = properties.label;
    .maximum = 0;
    .order = properties.order;
    .pressed = properties.pressed;
    .selected = properties.selected;
    .target = properties.target;
    .value = 0;
  }
  use run_children children

let Text = fn properties => fn children => do:
  let attached = properties.attachment
  let offset = attached.offset
  let plane = attached.size
  use Ui.placement {
    .id = properties.id;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .plane_height = plane.height;
    .plane_width = plane.width;
  }
  use Ui.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = text_kind;
    .label = properties.label;
    .maximum = 0;
    .order = properties.order;
    .pressed = False;
    .selected = False;
    .target = 0;
    .value = 0;
  }
  use run_children children

let Progress = fn properties => fn children => do:
  let attached = properties.attachment
  let offset = attached.offset
  let plane = attached.size
  use Ui.placement {
    .id = properties.id;
    .object = attached.object;
    .offset_x = offset.x;
    .offset_y = offset.y;
    .offset_z = offset.z;
    .plane_height = plane.height;
    .plane_width = plane.width;
  }
  use Ui.element {
    .description = properties.description;
    .element_height = properties.element_size.height;
    .element_width = properties.element_size.width;
    .id = properties.id;
    .kind = progress_kind;
    .label = properties.label;
    .maximum = properties.maximum;
    .order = properties.order;
    .pressed = False;
    .selected = False;
    .target = 0;
    .value = properties.value;
  }
  use run_children children

let Action = fn properties => fn children => do:
  use Ui.action properties
  use run_children children

let Status = fn properties => fn children => do:
  use Ui.status properties
  use run_children children

return {
  .Ui = Ui;
  .Button = Button;
  .Text = Text;
  .Progress = Progress;
  .Action = Action;
  .Status = Status;
  .element_size = element_size;
  .attachment = attachment;
  .viewport_attachment = viewport_attachment;
  .top_left = top_left;
  .top_right = top_right;
  .bottom_left = bottom_left;
  .bottom_right = bottom_right;
  .center = center;
  }
