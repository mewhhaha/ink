open import "./prelude.blot"

const AUTO_SIZE = -1

const Direction = #Row | #RowReverse | #Column | #ColumnReverse
const Justification = #Start | #Centre | #End
  | #SpaceBetween | #SpaceAround | #SpaceEvenly
const Alignment = #Auto | #Stretch | #Start | #Centre | #End
const Length = #Auto | #Points Int
const Spacing = #All Int | #Axes (Int, Int) | #Edges {
  .left = Int;
  .right = Int;
  .top = Int;
  .bottom = Int;
}

const ContainerDeclaration = #Position (Int, Int)
  | #Size (Int, Int)
  | #Direction Direction
  | #Justify Justification
  | #Align (Exclude (Alignment, #Auto))
  | #Gap Int
  | #Padding Spacing

const ChildDeclaration = #Size (Length, Length)
  | #Basis Length
  | #Grow Int
  | #Shrink Int
  | #Align Alignment
  | #Margin Spacing

const Container = @effect {
  .position = (Int, Int) -> Unit;
  .size = (Int, Int) -> Unit;
  .direction = Direction -> Unit;
  .justify = Justification -> Unit;
  .align = Exclude (Alignment, #Auto) -> Unit;
  .gap = Int -> Unit;
  .padding = Spacing -> Unit;
}

const Child = @effect {
  .size = (Length, Length) -> Unit;
  .basis = Length -> Unit;
  .grow = Int -> Unit;
  .shrink = Int -> Unit;
  .align = Alignment -> Unit;
  .margin = Spacing -> Unit;
}

const Children = @effect {
  .add = [ChildDeclaration] -> Unit;
}

const ResolvedContainer = {
  .left = Int;
  .top = Int;
  .width = Int;
  .height = Int;
  .direction = Direction;
  .justify = Justification;
  .align = Exclude (Alignment, #Auto);
  .gap = Int;
  .padding_left = Int;
  .padding_right = Int;
  .padding_top = Int;
  .padding_bottom = Int;
}

const ResolvedChild = {
  .width = Int;
  .height = Int;
  .flex_basis = Int;
  .flex_grow = Int;
  .flex_shrink = Int;
  .align_self = Alignment;
  .margin_left = Int;
  .margin_right = Int;
  .margin_top = Int;
  .margin_bottom = Int;
}

const Frame = {
  .left = Int;
  .top = Int;
  .width = Int;
  .height = Int;
}

const row = #Row
const row_reverse = #RowReverse
const column = #Column
const column_reverse = #ColumnReverse

const start = #Start
const centre = #Centre
const flex_end = #End
const space_between = #SpaceBetween
const space_around = #SpaceAround
const space_evenly = #SpaceEvenly

const auto = #Auto
const stretch = #Stretch

const maximum = fn (left, right) => do:
  if left > right:
    return left
  else:
    return right

const length_value = fn length => case length of
  #Auto => AUTO_SIZE
  #Points value => maximum (value, 0)

const edges = fn spacing => case spacing of
  #All value => {
    .left = value;
    .right = value;
    .top = value;
    .bottom = value;
  }

  #Axes (horizontal, vertical) => {
    .left = horizontal;
    .right = horizontal;
    .top = vertical;
    .bottom = vertical;
  }

  #Edges values => values

const collect_container = {
  .position = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Position value, ...rest]
  ;
  .size = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Size value, ...rest]
  ;
  .direction = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Direction value, ...rest]
  ;
  .justify = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Justify value, ...rest]
  ;
  .align = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Align value, ...rest]
  ;
  .gap = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Gap value, ...rest]
  ;
  .padding = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Padding value, ...rest]
  ;
  .return = fn _ => [];
}

const collect_child = {
  .size = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Size value, ...rest]
  ;
  .basis = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Basis value, ...rest]
  ;
  .grow = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Grow value, ...rest]
  ;
  .shrink = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Shrink value, ...rest]
  ;
  .align = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Align value, ...rest]
  ;
  .margin = fn (value, ?resume) => do:
    use rest <- resume ()
    return [#Margin value, ...rest]
  ;
  .return = fn _ => [];
}

const collect_children = {
  .add = fn (declarations, ?resume) => do:
    use resumed <- resume ()
    let (container_declarations, remaining_children) = resumed
    return (container_declarations, [declarations, ...remaining_children])
  ;
  .return = fn container_declarations => (container_declarations, []);
}

const resolve_container = fn declarations => do:
  let initial = (
    0,
    0,
    0,
    0,
    @satisfies column Direction,
    @satisfies start Justification,
    @satisfies stretch (Exclude (Alignment, #Auto)),
    0,
    @satisfies (#All 0) Spacing
  )
  let resolved = fold (
    declarations,
    initial,
    fn (current, declaration) => case declaration of
      #Position (left, top) => (
        left, top, current.2, current.3, current.4, current.5, current.6,
        current.7, current.8
      )

      #Size (width, height) => (
        current.0, current.1, width, height, current.4, current.5, current.6,
        current.7, current.8
      )

      #Direction direction => (
        current.0, current.1, current.2, current.3, direction, current.5,
        current.6, current.7, current.8
      )

      #Justify justify => (
        current.0, current.1, current.2, current.3, current.4, justify,
        current.6, current.7, current.8
      )

      #Align align => (
        current.0, current.1, current.2, current.3, current.4, current.5,
        align, current.7, current.8
      )

      #Gap gap => (
        current.0, current.1, current.2, current.3, current.4, current.5,
        current.6, gap, current.8
      )

      #Padding padding => (
        current.0, current.1, current.2, current.3, current.4, current.5,
        current.6, current.7, padding
      )
  )
  let (left, top, width, height, direction, justify, align, gap, padding) =
    resolved

  let resolved_padding = edges padding
  return {
    .left = left;
    .top = top;
    .width = width;
    .height = height;
    .direction = direction;
    .justify = justify;
    .align = align;
    .gap = gap;
    .padding_left = resolved_padding.left;
    .padding_right = resolved_padding.right;
    .padding_top = resolved_padding.top;
    .padding_bottom = resolved_padding.bottom;
  }

const resolve_child = fn declarations => do:
  let initial = (
    @satisfies #Auto Length,
    @satisfies #Auto Length,
    @satisfies #Auto Length,
    0,
    1,
    @satisfies auto Alignment,
    @satisfies (#All 0) Spacing
  )
  let resolved = fold (
    declarations,
    initial,
    fn (current, declaration) => case declaration of
      #Size (width, height) => (
        width, height, current.2, current.3, current.4, current.5, current.6
      )

      #Basis basis => (
        current.0, current.1, basis, current.3, current.4, current.5, current.6
      )

      #Grow grow => (
        current.0, current.1, current.2, grow, current.4, current.5, current.6
      )

      #Shrink shrink => (
        current.0, current.1, current.2, current.3, shrink, current.5, current.6
      )

      #Align align => (
        current.0, current.1, current.2, current.3, current.4, align, current.6
      )

      #Margin margin => (
        current.0, current.1, current.2, current.3, current.4, current.5, margin
      )
  )
  let (width, height, flex_basis, flex_grow, flex_shrink, align_self, margin) =
    resolved

  let resolved_margin = edges margin
  return {
    .width = length_value width;
    .height = length_value height;
    .flex_basis = length_value flex_basis;
    .flex_grow = flex_grow;
    .flex_shrink = flex_shrink;
    .align_self = align_self;
    .margin_left = resolved_margin.left;
    .margin_right = resolved_margin.right;
    .margin_top = resolved_margin.top;
    .margin_bottom = resolved_margin.bottom;
  }

const main_basis = fn (style, horizontal) => do:
  if style.flex_basis >= 0:
    return style.flex_basis
  else if horizontal:
    return maximum (style.width, 0)
  else:
    return maximum (style.height, 0)

const main_margin_start = fn (style, horizontal, reverse) => do:
  return case (horizontal, reverse) of
    (#True, #True) => style.margin_right
    (#True, #False) => style.margin_left
    (#False, #True) => style.margin_bottom
    (#False, #False) => style.margin_top

const main_margin_end = fn (style, horizontal, reverse) => do:
  return case (horizontal, reverse) of
    (#True, #True) => style.margin_left
    (#True, #False) => style.margin_right
    (#False, #True) => style.margin_top
    (#False, #False) => style.margin_bottom

const layout_line :: (ResolvedContainer, [ResolvedChild]) -> [Frame]
const layout_line = fn (container_style, child_styles) => do:
  let horizontal = case container_style.direction of
    #Row => True
    #RowReverse => True
    #Column => False
    #ColumnReverse => False
  let reverse = case container_style.direction of
    #Row => False
    #RowReverse => True
    #Column => False
    #ColumnReverse => True
  let main_length = maximum (case horizontal of
    #True => container_style.width
    #False => container_style.height
  , 0)
  let cross_length = maximum (case horizontal of
    #True => container_style.height
    #False => container_style.width
  , 0)
  let main_start = maximum (case (horizontal, reverse) of
    (#True, #True) => container_style.padding_right
    (#True, #False) => container_style.padding_left
    (#False, #True) => container_style.padding_bottom
    (#False, #False) => container_style.padding_top
  , 0)
  let main_end = maximum (case (horizontal, reverse) of
    (#True, #True) => container_style.padding_left
    (#True, #False) => container_style.padding_right
    (#False, #True) => container_style.padding_top
    (#False, #False) => container_style.padding_bottom
  , 0)
  let cross_start = maximum (case horizontal of
    #True => container_style.padding_top
    #False => container_style.padding_left
  , 0)
  let cross_end = maximum (case horizontal of
    #True => container_style.padding_bottom
    #False => container_style.padding_right
  , 0)
  let inner_main = maximum (main_length - main_start - main_end, 0)
  let inner_cross = maximum (cross_length - cross_start - cross_end, 0)
  let child_count = @array.len child_styles
  let gap = maximum (container_style.gap, 0)
  let total_gap = case child_count > 1 of
    #True => gap * (child_count - 1)
    #False => 0
  let totals = fold (child_styles, (0, 0, 0), fn (current, child) => do:
    let basis = main_basis (child, horizontal)
    return (
      current.0 + basis
      + main_margin_start (child, horizontal, reverse)
        + main_margin_end (child, horizontal, reverse),
      current.1 + maximum (child.flex_grow, 0),
      current.2 + maximum (child.flex_shrink, 0) * basis
    )
  )
  let (total_basis, total_grow, total_shrink) = totals

  let free_space = inner_main - total_gap - total_basis
  let growing = free_space > 0
  let shrinking = free_space < 0
  let remaining_free = free_space
  let remaining_factor = case growing of
    #True => total_grow
    #False => total_shrink
  let sized_children = []
  for child in Iter.items child_styles:
    let basis = main_basis (child, horizontal)
    let factor = case (growing, shrinking) of
      (#True, #True) => maximum (child.flex_grow, 0)
      (#True, #False) => maximum (child.flex_grow, 0)
      (#False, #True) => maximum (child.flex_shrink, 0) * basis
      (#False, #False) => 0
    let adjustment = case remaining_factor > 0 of
      #True => remaining_free * factor / remaining_factor
      #False => 0
    let main_size = maximum (basis + adjustment, 0)
    sized_children := [...sized_children, {
      .width = child.width;
      .height = child.height;
      .align_self = child.align_self;
      .margin_left = child.margin_left;
      .margin_right = child.margin_right;
      .margin_top = child.margin_top;
      .margin_bottom = child.margin_bottom;
      .main_size = main_size;
    }]
    remaining_free := remaining_free - (main_size - basis)
    remaining_factor := remaining_factor - factor

  let occupied_main = total_gap
  for child in Iter.items sized_children:
    occupied_main := occupied_main + child.main_size
      + main_margin_start (child, horizontal, reverse)
      + main_margin_end (child, horizontal, reverse)

  let justify_space = inner_main - occupied_main
  let distributed_space = maximum (justify_space, 0)
  let initial_offset = case container_style.justify of
    #Start => 0
    #Centre => justify_space / 2
    #End => justify_space
    #SpaceBetween => 0
    #SpaceAround => case child_count > 0 of
      #True => distributed_space / (child_count * 2)
      #False => 0

    #SpaceEvenly => distributed_space / (child_count + 1)
  let extra_gap = case container_style.justify of
    #Start => 0
    #Centre => 0
    #End => 0
    #SpaceBetween => case child_count > 1 of
      #True => distributed_space / (child_count - 1)
      #False => 0

    #SpaceAround => case child_count > 0 of
      #True => distributed_space / child_count
      #False => 0

    #SpaceEvenly => distributed_space / (child_count + 1)
  let cursor = initial_offset
  let frames = []
  for child in Iter.items sized_children:
    let margin_main_start = main_margin_start (child, horizontal, reverse)
    let margin_main_end = main_margin_end (child, horizontal, reverse)
    let logical_main = cursor + margin_main_start
    let physical_main = case reverse of
      #True => main_length - main_start - logical_main - child.main_size
      #False => main_start + logical_main
    let alignment = case child.align_self of
      #Auto => container_style.align
      #Stretch => stretch
      #Start => start
      #Centre => centre
      #End => flex_end
    let margin_cross_start = case horizontal of
      #True => child.margin_top
      #False => child.margin_left
    let margin_cross_end = case horizontal of
      #True => child.margin_bottom
      #False => child.margin_right
    let available_cross = maximum (
      inner_cross - margin_cross_start - margin_cross_end,
      0
    )
    let preferred_cross = case horizontal of
      #True => child.height
      #False => child.width
    let child_cross = case preferred_cross >= 0 of
      #True => preferred_cross
      #False => case alignment of
        #Stretch => available_cross
        #Start => 0
        #Centre => 0
        #End => 0

    let logical_cross = case alignment of
      #Stretch => margin_cross_start
      #Start => margin_cross_start
      #Centre => margin_cross_start + (available_cross - child_cross) / 2
      #End => inner_cross - margin_cross_end - child_cross
    let physical_cross = cross_start + logical_cross
    let left = container_style.left + case horizontal of
      #True => physical_main
      #False => physical_cross
    let top = container_style.top + case horizontal of
      #True => physical_cross
      #False => physical_main
    let width = case horizontal of
      #True => child.main_size
      #False => child_cross
    let height = case horizontal of
      #True => child_cross
      #False => child.main_size
    frames := [...frames, {
      .left = left;
      .top = top;
      .width = width;
      .height = height;
    }]
    cursor := cursor + margin_main_start + child.main_size + margin_main_end
      + gap + extra_gap

  return frames

const child = fn computation => do:
  use declarations <- @handle (Child, computation, collect_child)
  use Children.add declarations
  return ()

const layout = fn computation => do:
  use collected <- computation
    |> @handle (Container, collect_container)
    |> @handle (Children, collect_children)
  let container_style = resolve_container collected.0
  let child_styles = map (collected.1, resolve_child)
  return layout_line (container_style, child_styles)

return {
  .Direction = Direction;
  .Justification = Justification;
  .Alignment = Alignment;
  .Length = Length;
  .Spacing = Spacing;
  .Frame = Frame;
  .Container = Container;
  .Child = Child;
  .row = row;
  .row_reverse = row_reverse;
  .column = column;
  .column_reverse = column_reverse;
  .start = start;
  .centre = centre;
  .end = flex_end;
  .space_between = space_between;
  .space_around = space_around;
  .space_evenly = space_evenly;
  .auto = auto;
  .stretch = stretch;
  .child = child;
  .layout = layout;
}
