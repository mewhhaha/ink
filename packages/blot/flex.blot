open {} = (@import "./prelude.blot") ();

const AUTO_SIZE = -1;

const Direction = #Row | #RowReverse | #Column | #ColumnReverse;
const Justification = #Start | #Centre | #End
  | #SpaceBetween | #SpaceAround | #SpaceEvenly;
const Alignment = #Auto | #Stretch | #Start | #Centre | #End;
const Length = #Auto | #Points Int;
const Spacing = #All Int | #Axes (Int, Int) | #Edges {
  .left = Int;
  .right = Int;
  .top = Int;
  .bottom = Int;
};

const ContainerDeclaration =
  #Position (Int, Int)
  | #Size (Int, Int)
  | #Direction Direction
  | #Justify Justification
  | #Align (Exclude (Alignment, #Auto))
  | #Gap Int
  | #Padding Spacing;

const ChildDeclaration =
  #Size (Length, Length)
  | #Basis Length
  | #Grow Int
  | #Shrink Int
  | #Align Alignment
  | #Margin Spacing;

const Container = @effect {
  .position = (Int, Int) -> Unit;
  .size = (Int, Int) -> Unit;
  .direction = Direction -> Unit;
  .justify = Justification -> Unit;
  .align = Exclude (Alignment, #Auto) -> Unit;
  .gap = Int -> Unit;
  .padding = Spacing -> Unit;
};

const Child = @effect {
  .size = (Length, Length) -> Unit;
  .basis = Length -> Unit;
  .grow = Int -> Unit;
  .shrink = Int -> Unit;
  .align = Alignment -> Unit;
  .margin = Spacing -> Unit;
};

const Children = @effect {
  .add = [ChildDeclaration] -> Unit;
};

const ResolvedContainer = {
  .left = Int;
  .top = Int;
  .width = Int;
  .height = Int;
  .direction = Direction;
  .justify = Justification;
  .align = Exclude (Alignment, #Auto);
  .gap = Int;
  .padding_left = Int;
  .padding_right = Int;
  .padding_top = Int;
  .padding_bottom = Int;
};

const ResolvedChild = {
  .width = Int;
  .height = Int;
  .flex_basis = Int;
  .flex_grow = Int;
  .flex_shrink = Int;
  .align_self = Alignment;
  .margin_left = Int;
  .margin_right = Int;
  .margin_top = Int;
  .margin_bottom = Int;
};

const Frame = {
  .left = Int;
  .top = Int;
  .width = Int;
  .height = Int;
};

const row = #Row;
const row_reverse = #RowReverse;
const column = #Column;
const column_reverse = #ColumnReverse;

const start = #Start;
const centre = #Centre;
const flex_end = #End;
const space_between = #SpaceBetween;
const space_around = #SpaceAround;
const space_evenly = #SpaceEvenly;

const auto = #Auto;
const stretch = #Stretch;

const maximum = fn (left, right) => if left > right then left else right end;

const length_value = fn length => case length of
  #Auto => AUTO_SIZE,
  #Points value => maximum (value, 0)
end;

const edges = fn spacing => case spacing of
  #All value => {
    .left = value;
    .right = value;
    .top = value;
    .bottom = value;
  },
  #Axes (horizontal, vertical) => {
    .left = horizontal;
    .right = horizontal;
    .top = vertical;
    .bottom = vertical;
  },
  #Edges values => values
end;

const collect_container = {
  .position = fn (value, ?resume) => do
    rest <- resume ();
    in [#Position value, ...rest]
  end;
  .size = fn (value, ?resume) => do
    rest <- resume ();
    in [#Size value, ...rest]
  end;
  .direction = fn (value, ?resume) => do
    rest <- resume ();
    in [#Direction value, ...rest]
  end;
  .justify = fn (value, ?resume) => do
    rest <- resume ();
    in [#Justify value, ...rest]
  end;
  .align = fn (value, ?resume) => do
    rest <- resume ();
    in [#Align value, ...rest]
  end;
  .gap = fn (value, ?resume) => do
    rest <- resume ();
    in [#Gap value, ...rest]
  end;
  .padding = fn (value, ?resume) => do
    rest <- resume ();
    in [#Padding value, ...rest]
  end;
  .return = fn _ => [];
};

const collect_child = {
  .size = fn (value, ?resume) => do
    rest <- resume ();
    in [#Size value, ...rest]
  end;
  .basis = fn (value, ?resume) => do
    rest <- resume ();
    in [#Basis value, ...rest]
  end;
  .grow = fn (value, ?resume) => do
    rest <- resume ();
    in [#Grow value, ...rest]
  end;
  .shrink = fn (value, ?resume) => do
    rest <- resume ();
    in [#Shrink value, ...rest]
  end;
  .align = fn (value, ?resume) => do
    rest <- resume ();
    in [#Align value, ...rest]
  end;
  .margin = fn (value, ?resume) => do
    rest <- resume ();
    in [#Margin value, ...rest]
  end;
  .return = fn _ => [];
};

const collect_children = {
  .add = fn (declarations, ?resume) => do
    resumed <- resume ();
    let (container_declarations, remaining_children) = resumed;
    in (container_declarations, [declarations, ...remaining_children])
  end;
  .return = fn container_declarations => (container_declarations, []);
};

const resolve_container = fn declarations => do
  let left = 0;
  let top = 0;
  let width = 0;
  let height = 0;
  let direction = @satisfies column Direction;
  let justify = @satisfies start Justification;
  let align = @satisfies stretch (Exclude (Alignment, #Auto));
  let gap = 0;
  let padding = @satisfies (#All 0) Spacing;
  for #Position (next_left, next_top) in Iter.items declarations do
    left := next_left;
    top := next_top;
  end;
  for #Size (next_width, next_height) in Iter.items declarations do
    width := next_width;
    height := next_height;
  end;
  for #Direction next_direction in Iter.items declarations do
    direction := next_direction;
  end;
  for #Justify next_justify in Iter.items declarations do
    justify := next_justify;
  end;
  for #Align next_align in Iter.items declarations do
    align := next_align;
  end;
  for #Gap next_gap in Iter.items declarations do
    gap := next_gap;
  end;
  for #Padding next_padding in Iter.items declarations do
    padding := next_padding;
  end;
  let resolved_padding = edges padding;
  in {
    .left = left;
    .top = top;
    .width = width;
    .height = height;
    .direction = direction;
    .justify = justify;
    .align = align;
    .gap = gap;
    .padding_left = resolved_padding.left;
    .padding_right = resolved_padding.right;
    .padding_top = resolved_padding.top;
    .padding_bottom = resolved_padding.bottom;
  }
end;

const resolve_child = fn declarations => do
  let width = @satisfies #Auto Length;
  let height = @satisfies #Auto Length;
  let flex_basis = @satisfies #Auto Length;
  let flex_grow = 0;
  let flex_shrink = 1;
  let align_self = @satisfies auto Alignment;
  let margin = @satisfies (#All 0) Spacing;
  for #Size (next_width, next_height) in Iter.items declarations do
    width := next_width;
    height := next_height;
  end;
  for #Basis next_basis in Iter.items declarations do
    flex_basis := next_basis;
  end;
  for #Grow next_grow in Iter.items declarations do
    flex_grow := next_grow;
  end;
  for #Shrink next_shrink in Iter.items declarations do
    flex_shrink := next_shrink;
  end;
  for #Align next_align in Iter.items declarations do
    align_self := next_align;
  end;
  for #Margin next_margin in Iter.items declarations do
    margin := next_margin;
  end;
  let resolved_margin = edges margin;
  in {
    .width = length_value width;
    .height = length_value height;
    .flex_basis = length_value flex_basis;
    .flex_grow = flex_grow;
    .flex_shrink = flex_shrink;
    .align_self = align_self;
    .margin_left = resolved_margin.left;
    .margin_right = resolved_margin.right;
    .margin_top = resolved_margin.top;
    .margin_bottom = resolved_margin.bottom;
  }
end;

const main_basis = fn (style, horizontal) =>
  if style.flex_basis >= 0 then style.flex_basis
  else if horizontal then maximum (style.width, 0)
  else maximum (style.height, 0)
  end;

const main_margin_start = fn (style, horizontal, reverse) =>
  if horizontal
  then (if reverse then style.margin_right else style.margin_left end)
  else (if reverse then style.margin_bottom else style.margin_top end)
  end;

const main_margin_end = fn (style, horizontal, reverse) =>
  if horizontal
  then (if reverse then style.margin_left else style.margin_right end)
  else (if reverse then style.margin_top else style.margin_bottom end)
  end;

sig layout_line = (ResolvedContainer, [ResolvedChild]) -> [Frame];
const layout_line = fn (container_style, child_styles) => do
  let horizontal = case container_style.direction of
    #Row => True,
    #RowReverse => True,
    #Column => False,
    #ColumnReverse => False
  end;
  let reverse = case container_style.direction of
    #Row => False,
    #RowReverse => True,
    #Column => False,
    #ColumnReverse => True
  end;
  let main_length = maximum (
    if horizontal then container_style.width else container_style.height end,
    0
  );
  let cross_length = maximum (
    if horizontal then container_style.height else container_style.width end,
    0
  );
  let main_start = maximum (
    if horizontal
    then (if reverse then container_style.padding_right else container_style.padding_left end)
    else (if reverse then container_style.padding_bottom else container_style.padding_top end)
    end,
    0
  );
  let main_end = maximum (
    if horizontal
    then (if reverse then container_style.padding_left else container_style.padding_right end)
    else (if reverse then container_style.padding_top else container_style.padding_bottom end)
    end,
    0
  );
  let cross_start = maximum (
    if horizontal then container_style.padding_top else container_style.padding_left end,
    0
  );
  let cross_end = maximum (
    if horizontal then container_style.padding_bottom else container_style.padding_right end,
    0
  );
  let inner_main = maximum (main_length - main_start - main_end, 0);
  let inner_cross = maximum (cross_length - cross_start - cross_end, 0);
  let child_count = @array.len child_styles;
  let gap = maximum (container_style.gap, 0);
  let total_gap = if child_count > 1 then gap * (child_count - 1) else 0 end;

  let total_basis = 0;
  let total_grow = 0;
  let total_shrink = 0;
  for child in Iter.items child_styles do
    let basis = main_basis (child, horizontal);
    total_basis := total_basis + basis
      + main_margin_start (child, horizontal, reverse)
      + main_margin_end (child, horizontal, reverse);
    total_grow := total_grow + maximum (child.flex_grow, 0);
    total_shrink := total_shrink + maximum (child.flex_shrink, 0) * basis;
  end;

  let free_space = inner_main - total_gap - total_basis;
  let remaining_free = free_space;
  let remaining_factor = if free_space > 0 then total_grow else total_shrink end;
  let sized_children = [];
  for child in Iter.items child_styles do
    let basis = main_basis (child, horizontal);
    let factor = if free_space > 0 then maximum (child.flex_grow, 0)
      else if free_space < 0 then maximum (child.flex_shrink, 0) * basis
      else 0
      end;
    let adjustment = if remaining_factor > 0
      then remaining_free * factor / remaining_factor
      else 0
      end;
    let main_size = maximum (basis + adjustment, 0);
    sized_children := [...sized_children, {
      .width = child.width;
      .height = child.height;
      .align_self = child.align_self;
      .margin_left = child.margin_left;
      .margin_right = child.margin_right;
      .margin_top = child.margin_top;
      .margin_bottom = child.margin_bottom;
      .main_size = main_size;
    }];
    remaining_free := remaining_free - (main_size - basis);
    remaining_factor := remaining_factor - factor;
  end;

  let occupied_main = total_gap;
  for child in Iter.items sized_children do
    occupied_main := occupied_main + child.main_size
      + main_margin_start (child, horizontal, reverse)
      + main_margin_end (child, horizontal, reverse);
  end;
  let justify_space = inner_main - occupied_main;
  let distributed_space = maximum (justify_space, 0);
  let initial_offset = case container_style.justify of
    #Start => 0,
    #Centre => justify_space / 2,
    #End => justify_space,
    #SpaceBetween => 0,
    #SpaceAround => if child_count > 0 then distributed_space / (child_count * 2) else 0 end,
    #SpaceEvenly => distributed_space / (child_count + 1)
  end;
  let extra_gap = case container_style.justify of
    #Start => 0,
    #Centre => 0,
    #End => 0,
    #SpaceBetween => if child_count > 1 then distributed_space / (child_count - 1) else 0 end,
    #SpaceAround => if child_count > 0 then distributed_space / child_count else 0 end,
    #SpaceEvenly => distributed_space / (child_count + 1)
  end;

  let cursor = initial_offset;
  let frames = [];
  for child in Iter.items sized_children do
    let margin_main_start = main_margin_start (child, horizontal, reverse);
    let margin_main_end = main_margin_end (child, horizontal, reverse);
    let logical_main = cursor + margin_main_start;
    let physical_main = if reverse
      then main_length - main_start - logical_main - child.main_size
      else main_start + logical_main
      end;
    let alignment = case child.align_self of
      #Auto => container_style.align,
      #Stretch => stretch,
      #Start => start,
      #Centre => centre,
      #End => flex_end
    end;
    let margin_cross_start = if horizontal then child.margin_top else child.margin_left end;
    let margin_cross_end = if horizontal then child.margin_bottom else child.margin_right end;
    let available_cross = maximum (
      inner_cross - margin_cross_start - margin_cross_end,
      0
    );
    let preferred_cross = if horizontal then child.height else child.width end;
    let child_cross = if preferred_cross >= 0 then preferred_cross
      else case alignment of
        #Stretch => available_cross,
        #Start => 0,
        #Centre => 0,
        #End => 0
      end
      end;
    let logical_cross = case alignment of
      #Stretch => margin_cross_start,
      #Start => margin_cross_start,
      #Centre => margin_cross_start + (available_cross - child_cross) / 2,
      #End => inner_cross - margin_cross_end - child_cross
    end;
    let physical_cross = cross_start + logical_cross;
    let left = container_style.left + if horizontal then physical_main else physical_cross end;
    let top = container_style.top + if horizontal then physical_cross else physical_main end;
    let width = if horizontal then child.main_size else child_cross end;
    let height = if horizontal then child_cross else child.main_size end;
    frames := [...frames, {
      .left = left;
      .top = top;
      .width = width;
      .height = height;
    }];
    cursor := cursor + margin_main_start + child.main_size + margin_main_end
      + gap + extra_gap;
  end;
  in frames
end;

const child = fn computation => do
  declarations <- @handle (Child, computation, collect_child);
  _ <- Children.add declarations;
  in ()
end;

const layout = fn computation => do
  let collected = try computation then do
    without_container_style <- @handle (Container, collect_container);
    @handle (Children, collect_children)
  end;
  let container_style = resolve_container collected.0;
  let child_styles = map (collected.1, resolve_child);
  in layout_line (container_style, child_styles)
end;

return {
  .Direction = Direction;
  .Justification = Justification;
  .Alignment = Alignment;
  .Length = Length;
  .Spacing = Spacing;
  .Frame = Frame;
  .Container = Container;
  .Child = Child;
  .row = row;
  .row_reverse = row_reverse;
  .column = column;
  .column_reverse = column_reverse;
  .start = start;
  .centre = centre;
  .end = flex_end;
  .space_between = space_between;
  .space_around = space_around;
  .space_evenly = space_evenly;
  .auto = auto;
  .stretch = stretch;
  .child = child;
  .layout = layout;
};
