open @import "./prelude.blot" ()

const AUTO_SIZE = -1

const Direction = #Row | #RowReverse | #Column | #ColumnReverse
const Justification = #Start | #Centre | #End
  | #SpaceBetween | #SpaceAround | #SpaceEvenly
const Alignment = #Auto | #Stretch | #Start | #Centre | #End
const Length = #Auto | #Points Int
const Spacing = #All Int | #Axes (Int, Int) | #Edges {
  .left = Int;
  .right = Int;
  .top = Int;
  .bottom = Int;
}

const ContainerDeclaration = #Position (Int, Int)
  | #Size (Int, Int)
  | #Direction Direction
  | #Justify Justification
  | #Align (Exclude (Alignment, #Auto))
  | #Gap Int
  | #Padding Spacing

const ChildDeclaration = #Size (Length, Length)
  | #Basis Length
  | #Grow Int
  | #Shrink Int
  | #Align Alignment
  | #Margin Spacing

const Container = @effect {
  .position = (Int, Int) -> Unit;
  .size = (Int, Int) -> Unit;
  .direction = Direction -> Unit;
  .justify = Justification -> Unit;
  .align = Exclude (Alignment, #Auto) -> Unit;
  .gap = Int -> Unit;
  .padding = Spacing -> Unit;
}

const Child = @effect {
  .size = (Length, Length) -> Unit;
  .basis = Length -> Unit;
  .grow = Int -> Unit;
  .shrink = Int -> Unit;
  .align = Alignment -> Unit;
  .margin = Spacing -> Unit;
}

const Children = @effect {
  .add = [ChildDeclaration] -> Unit;
}

const ResolvedContainer = {
  .left = Int;
  .top = Int;
  .width = Int;
  .height = Int;
  .direction = Direction;
  .justify = Justification;
  .align = Exclude (Alignment, #Auto);
  .gap = Int;
  .padding_left = Int;
  .padding_right = Int;
  .padding_top = Int;
  .padding_bottom = Int;
}

const ResolvedChild = {
  .width = Int;
  .height = Int;
  .flex_basis = Int;
  .flex_grow = Int;
  .flex_shrink = Int;
  .align_self = Alignment;
  .margin_left = Int;
  .margin_right = Int;
  .margin_top = Int;
  .margin_bottom = Int;
}

const Frame = {
  .left = Int;
  .top = Int;
  .width = Int;
  .height = Int;
}

const row = #Row
const row_reverse = #RowReverse
const column = #Column
const column_reverse = #ColumnReverse

const start = #Start
const centre = #Centre
const flex_end = #End
const space_between = #SpaceBetween
const space_around = #SpaceAround
const space_evenly = #SpaceEvenly

const auto = #Auto
const stretch = #Stretch

const maximum = fn (left, right) =>
  if left > right:
    return left
  else:
    return right

const length_value = fn length => case length of
  #Auto => AUTO_SIZE
  #Points value => maximum (value, 0)

const edges = fn spacing => case spacing of
  #All value => {
    .left = value;
    .right = value;
    .top = value;
    .bottom = value;
  }
  #Axes (horizontal, vertical) => {
    .left = horizontal;
    .right = horizontal;
    .top = vertical;
    .bottom = vertical;
  }
  #Edges values => values

const collect_container = {
  .position = fn (value, ?resume) =>
    rest <- resume ()
    return [#Position value, ...rest]
  ;
  .size = fn (value, ?resume) =>
    rest <- resume ()
    return [#Size value, ...rest]
  ;
  .direction = fn (value, ?resume) =>
    rest <- resume ()
    return [#Direction value, ...rest]
  ;
  .justify = fn (value, ?resume) =>
    rest <- resume ()
    return [#Justify value, ...rest]
  ;
  .align = fn (value, ?resume) =>
    rest <- resume ()
    return [#Align value, ...rest]
  ;
  .gap = fn (value, ?resume) =>
    rest <- resume ()
    return [#Gap value, ...rest]
  ;
  .padding = fn (value, ?resume) =>
    rest <- resume ()
    return [#Padding value, ...rest]
  ;
  .return = fn _ => [];
}

const collect_child = {
  .size = fn (value, ?resume) =>
    rest <- resume ()
    return [#Size value, ...rest]
  ;
  .basis = fn (value, ?resume) =>
    rest <- resume ()
    return [#Basis value, ...rest]
  ;
  .grow = fn (value, ?resume) =>
    rest <- resume ()
    return [#Grow value, ...rest]
  ;
  .shrink = fn (value, ?resume) =>
    rest <- resume ()
    return [#Shrink value, ...rest]
  ;
  .align = fn (value, ?resume) =>
    rest <- resume ()
    return [#Align value, ...rest]
  ;
  .margin = fn (value, ?resume) =>
    rest <- resume ()
    return [#Margin value, ...rest]
  ;
  .return = fn _ => [];
}

const collect_children = {
  .add = fn (declarations, ?resume) =>
    resumed <- resume ()
    let (container_declarations, remaining_children) = resumed
    return (container_declarations, [declarations, ...remaining_children])
  ;
  .return = fn container_declarations => (container_declarations, []);
}

const resolve_container = fn declarations =>
  let left = 0
  let top = 0
  let width = 0
  let height = 0
  let direction = @satisfies column Direction
  let justify = @satisfies start Justification
  let align = @satisfies stretch (Exclude (Alignment, #Auto))
  let gap = 0
  let padding = @satisfies (#All 0) Spacing
  for #Position (next_left, next_top) in Iter.items declarations:
    left := next_left
    top := next_top
  for #Size (next_width, next_height) in Iter.items declarations:
    width := next_width
    height := next_height
  for #Direction next_direction in Iter.items declarations:
    direction := next_direction
  for #Justify next_justify in Iter.items declarations:
    justify := next_justify
  for #Align next_align in Iter.items declarations:
    align := next_align
  for #Gap next_gap in Iter.items declarations:
    gap := next_gap
  for #Padding next_padding in Iter.items declarations:
    padding := next_padding
  let resolved_padding = edges padding
  return {
    .left = left;
    .top = top;
    .width = width;
    .height = height;
    .direction = direction;
    .justify = justify;
    .align = align;
    .gap = gap;
    .padding_left = resolved_padding.left;
    .padding_right = resolved_padding.right;
    .padding_top = resolved_padding.top;
    .padding_bottom = resolved_padding.bottom;
  }

const resolve_child = fn declarations =>
  let width = @satisfies #Auto Length
  let height = @satisfies #Auto Length
  let flex_basis = @satisfies #Auto Length
  let flex_grow = 0
  let flex_shrink = 1
  let align_self = @satisfies auto Alignment
  let margin = @satisfies (#All 0) Spacing
  for #Size (next_width, next_height) in Iter.items declarations:
    width := next_width
    height := next_height
  for #Basis next_basis in Iter.items declarations:
    flex_basis := next_basis
  for #Grow next_grow in Iter.items declarations:
    flex_grow := next_grow
  for #Shrink next_shrink in Iter.items declarations:
    flex_shrink := next_shrink
  for #Align next_align in Iter.items declarations:
    align_self := next_align
  for #Margin next_margin in Iter.items declarations:
    margin := next_margin
  let resolved_margin = edges margin
  return {
    .width = length_value width;
    .height = length_value height;
    .flex_basis = length_value flex_basis;
    .flex_grow = flex_grow;
    .flex_shrink = flex_shrink;
    .align_self = align_self;
    .margin_left = resolved_margin.left;
    .margin_right = resolved_margin.right;
    .margin_top = resolved_margin.top;
    .margin_bottom = resolved_margin.bottom;
  }

const main_basis = fn (style, horizontal) =>
  if style.flex_basis >= 0:
    return style.flex_basis
  else if horizontal:
    return maximum (style.width, 0)
  else:
    return maximum (style.height, 0)

const main_margin_start = fn (style, horizontal, reverse) =>
  if horizontal:
    return (if reverse:
      return style.margin_right
    else:
      return style.margin_left
    )
  else:
    return (if reverse:
      return style.margin_bottom
    else:
      return style.margin_top
    )

const main_margin_end = fn (style, horizontal, reverse) =>
  if horizontal:
    return (if reverse:
      return style.margin_left
    else:
      return style.margin_right
    )
  else:
    return (if reverse:
      return style.margin_top
    else:
      return style.margin_bottom
    )

sig layout_line = (ResolvedContainer, [ResolvedChild]) -> [Frame]
const layout_line = fn (container_style, child_styles) =>
  let horizontal = case container_style.direction of
    #Row => True
    #RowReverse => True
    #Column => False
    #ColumnReverse => False
  let reverse = case container_style.direction of
    #Row => False
    #RowReverse => True
    #Column => False
    #ColumnReverse => True
  let main_length = maximum (
    if horizontal:
      return container_style.width
    else:
      return container_style.height
    ,
    0
  )
  let cross_length = maximum (
    if horizontal:
      return container_style.height
    else:
      return container_style.width
    ,
    0
  )
  let main_start = maximum (
    if horizontal:
      return (if reverse:
        return container_style.padding_right
      else:
        return container_style.padding_left
      )
    else:
      return (if reverse:
        return container_style.padding_bottom
      else:
        return container_style.padding_top
      )
    ,
    0
  )
  let main_end = maximum (
    if horizontal:
      return (if reverse:
        return container_style.padding_left
      else:
        return container_style.padding_right
      )
    else:
      return (if reverse:
        return container_style.padding_top
      else:
        return container_style.padding_bottom
      )
    ,
    0
  )
  let cross_start = maximum (
    if horizontal:
      return container_style.padding_top
    else:
      return container_style.padding_left
    ,
    0
  )
  let cross_end = maximum (
    if horizontal:
      return container_style.padding_bottom
    else:
      return container_style.padding_right
    ,
    0
  )
  let inner_main = maximum (main_length - main_start - main_end, 0)
  let inner_cross = maximum (cross_length - cross_start - cross_end, 0)
  let child_count = @array.len child_styles
  let gap = maximum (container_style.gap, 0)
  let total_gap = if child_count > 1:
    return gap * (child_count - 1)
  else:
    return 0
  let total_basis = 0
  let total_grow = 0
  let total_shrink = 0
  for child in Iter.items child_styles:
    let basis = main_basis (child, horizontal)
    total_basis := total_basis + basis
      + main_margin_start (child, horizontal, reverse)
      + main_margin_end (child, horizontal, reverse)
    total_grow := total_grow + maximum (child.flex_grow, 0)
    total_shrink := total_shrink + maximum (child.flex_shrink, 0) * basis
  let free_space = inner_main - total_gap - total_basis
  let growing = free_space > 0
  let shrinking = free_space < 0
  let remaining_free = free_space
  let remaining_factor = if growing:
    return total_grow
  else:
    return total_shrink
  let sized_children = []
  for child in Iter.items child_styles:
    let basis = main_basis (child, horizontal)
    let factor = if growing:
      return maximum (child.flex_grow, 0)
    else if shrinking:
      return maximum (child.flex_shrink, 0) * basis
    else:
      return 0
    let adjustment = if remaining_factor > 0:
      return remaining_free * factor / remaining_factor
    else:
      return 0
    let main_size = maximum (basis + adjustment, 0)
    sized_children := [...sized_children, {
      .width = child.width;
      .height = child.height;
      .align_self = child.align_self;
      .margin_left = child.margin_left;
      .margin_right = child.margin_right;
      .margin_top = child.margin_top;
      .margin_bottom = child.margin_bottom;
      .main_size = main_size;
    }]
    remaining_free := remaining_free - (main_size - basis)
    remaining_factor := remaining_factor - factor
  let occupied_main = total_gap
  for child in Iter.items sized_children:
    occupied_main := occupied_main + child.main_size
      + main_margin_start (child, horizontal, reverse)
      + main_margin_end (child, horizontal, reverse)
  let justify_space = inner_main - occupied_main
  let distributed_space = maximum (justify_space, 0)
  let initial_offset = case container_style.justify of
    #Start => 0
    #Centre => justify_space / 2
    #End => justify_space
    #SpaceBetween => 0
    #SpaceAround => if child_count > 0:
      return distributed_space / (child_count * 2)
    else:
      return 0
    #SpaceEvenly => distributed_space / (child_count + 1)
  let extra_gap = case container_style.justify of
    #Start => 0
    #Centre => 0
    #End => 0
    #SpaceBetween => if child_count > 1:
      return distributed_space / (child_count - 1)
    else:
      return 0
    #SpaceAround => if child_count > 0:
      return distributed_space / child_count
    else:
      return 0
    #SpaceEvenly => distributed_space / (child_count + 1)
  let cursor = initial_offset
  let frames = []
  for child in Iter.items sized_children:
    let margin_main_start = main_margin_start (child, horizontal, reverse)
    let margin_main_end = main_margin_end (child, horizontal, reverse)
    let logical_main = cursor + margin_main_start
    let physical_main = if reverse:
      return main_length - main_start - logical_main - child.main_size
    else:
      return main_start + logical_main
    let alignment = case child.align_self of
      #Auto => container_style.align
      #Stretch => stretch
      #Start => start
      #Centre => centre
      #End => flex_end
    let margin_cross_start = if horizontal:
      return child.margin_top
    else:
      return child.margin_left
    let margin_cross_end = if horizontal:
      return child.margin_bottom
    else:
      return child.margin_right
    let available_cross = maximum (
      inner_cross - margin_cross_start - margin_cross_end,
      0
    )
    let preferred_cross = if horizontal:
      return child.height
    else:
      return child.width
    let child_cross = if preferred_cross >= 0:
      return preferred_cross
    else:
      return case alignment of
        #Stretch => available_cross
        #Start => 0
        #Centre => 0
        #End => 0

    let logical_cross = case alignment of
      #Stretch => margin_cross_start
      #Start => margin_cross_start
      #Centre => margin_cross_start + (available_cross - child_cross) / 2
      #End => inner_cross - margin_cross_end - child_cross
    let physical_cross = cross_start + logical_cross
    let left = container_style.left + if horizontal:
      return physical_main
    else:
      return physical_cross
    let top = container_style.top + if horizontal:
      return physical_cross
    else:
      return physical_main
    let width = if horizontal:
      return child.main_size
    else:
      return child_cross
    let height = if horizontal:
      return child_cross
    else:
      return child.main_size
    frames := [...frames, {
      .left = left;
      .top = top;
      .width = width;
      .height = height;
    }]
    cursor := cursor + margin_main_start + child.main_size + margin_main_end
      + gap + extra_gap
  return frames

const child = fn computation =>
  declarations <- @handle (Child, computation, collect_child)
  _ <- Children.add declarations
  return ()

const layout = fn computation =>
  let collected = try computation with
    without_container_style <- @handle (Container, collect_container)
    @handle (Children, collect_children)
  let container_style = resolve_container collected.0
  let child_styles = map (collected.1, resolve_child)
  return layout_line (container_style, child_styles)

return {
  .Direction = Direction;
  .Justification = Justification;
  .Alignment = Alignment;
  .Length = Length;
  .Spacing = Spacing;
  .Frame = Frame;
  .Container = Container;
  .Child = Child;
  .row = row;
  .row_reverse = row_reverse;
  .column = column;
  .column_reverse = column_reverse;
  .start = start;
  .centre = centre;
  .end = flex_end;
  .space_between = space_between;
  .space_around = space_around;
  .space_evenly = space_evenly;
  .auto = auto;
  .stretch = stretch;
  .child = child;
  .layout = layout;
}
