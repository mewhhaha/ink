open import "./prelude.blot"

const Abi = import "./abi.blot"
const Cells = Abi.Cells
const Events = Abi.Events
const Phase = Abi.Phase
const Protocol = Abi.Protocol
const State = Abi.State
const Time = Abi.Time
const Viewport = Abi.Viewport

const start_phase = Protocol.phases.start
const update_phase = Protocol.phases.update
const describe_phase = Protocol.phases.describe
const render_phase = Protocol.phases.render
const schema_phase = Protocol.phases.schema
const elapsed_event = Protocol.events.elapsed
const focus_event = Protocol.events.focus
const activate_event = Protocol.events.activate

return {
  .Phase = Phase;
  .State = State;
  .Cells = Cells;
  .Viewport = Viewport;
  .Events = Events;
  .Time = Time;
  .start_phase = start_phase;
  .update_phase = update_phase;
  .describe_phase = describe_phase;
  .render_phase = render_phase;
  .schema_phase = schema_phase;
  .elapsed_event = elapsed_event;
  .focus_event = focus_event;
  .activate_event = activate_event;
  }
