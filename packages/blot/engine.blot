open @import "./prelude.blot" ()

const Phase = @effect.host {
  .current = Unit -> Int;
}

const State = @effect.host {
  .current = Unit -> Int;
  .commit = Int -> Unit;
}

const Cells = @effect.host {
  .get = Int -> Int;
  .put = { .index = Int; .value = Int; } -> Unit;
}

const Viewport = @effect.host {
  .current = Unit -> { .height = Int; .width = Int; };
}

const Events = @effect.host {
  .next = Unit -> { .kind = Int; .target = Int; .value = Int; };
}

const Time = @effect.host {
  .delta_us = Unit -> Int;
}

const start_phase = 0
const frame_phase = 1
const describe_phase = 2
const render_phase = 3
const schema_phase = 4
const frame_event = 0
const focus_event = 1
const activate_event = 2
const zoom_event = 3

return {
  .Phase = Phase;
  .State = State;
  .Cells = Cells;
  .Viewport = Viewport;
  .Events = Events;
  .Time = Time;
  .start_phase = start_phase;
  .frame_phase = frame_phase;
  .describe_phase = describe_phase;
  .render_phase = render_phase;
  .schema_phase = schema_phase;
  .frame_event = frame_event;
  .focus_event = focus_event;
  .activate_event = activate_event;
  .zoom_event = zoom_event;
}
