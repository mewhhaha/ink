import { Vec2, Vec3 } from "std/vector"
import { Color, Quat, Ray, Vec4 } from "./math"
import { Button, Pointer } from "./input"

// Readers for the numeric packets the host exchanges with a game. Every lane
// is an F32; integers are exact below 2^24. Generated codecs use these.

const u32 = fn (v: Array F32) => fn (o: U32) -> U32 => F32.to_u32 v[o]
const bool = fn (v: Array F32) => fn (o: U32) => v[o] != 0.0
const flag = fn (value: Bool) => if value then 1.0 else 0.0
const vec2 = fn (v: Array F32) => fn (o: U32) => #Vec2 { x: v[o], y: v[o + 1] }
const vec3 = fn (v: Array F32) => fn (o: U32) => #Vec3 { x: v[o], y: v[o + 1], z: v[o + 2] }
const vec4 = fn (v: Array F32) => fn (o: U32) =>
  #Vec4 { x: v[o], y: v[o + 1], z: v[o + 2], w: v[o + 3] }
const quat = fn (v: Array F32) => fn (o: U32) =>
  #Quat { x: v[o], y: v[o + 1], z: v[o + 2], w: v[o + 3] }
const color = fn (v: Array F32) => fn (o: U32) =>
  #Color { r: v[o], g: v[o + 1], b: v[o + 2], a: v[o + 3] }
const button = fn (v: Array F32) => fn (o: U32) =>
  #Button { down: bool v o, pressed: bool v (o + 1), released: bool v (o + 2) }

// Seventeen lanes: position, delta, wheel, ray origin and direction, hovered
// entity, hit point, inside, locked.
const pointer = fn (v: Array F32) => fn (o: U32) => #Pointer {
  position: vec2 v o,
  delta: vec2 v (o + 2),
  wheel: v[o + 4],
  ray: #Ray { origin: vec3 v (o + 5), direction: vec3 v (o + 8) },
  hovered: u32 v (o + 11),
  point: vec3 v (o + 12),
  inside: bool v (o + 15),
  locked: bool v (o + 16),
}

// An optional record: 0, or 1 followed by its lanes.
const optional = fn encode => fn candidate => case candidate of
  #Some value => #[1.0, ...encode value]
  #Nothing => #[0.0]
