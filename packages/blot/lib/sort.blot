// Deterministic sorting. Equal keys keep their original order (the sort is
// stable), so a result never depends on anything but the input.

const identity = fn (n: U32) -> Array U32 => @array.generate n (fn (index: U32) => index)

// The indices 0..n ordered by ascending `keys`: insertion sort on runs of
// eight, then bottom-up merging. Keys that are already in order cost one pass.
const order = fn (keys: Array F32) -> Array U32 => do:
  let n = keys.length
  let in_order = #True
  for i in 1..n:
    if keys[i - 1] > keys[i]:
      in_order := #False
  if in_order:
    return identity n
  let ks: Array F32 = @array.generate n (fn (i: U32) => keys[i])
  let ids: Array U32 = identity n
  for start in 0..((n + 7) / 8):
    let low = start * 8
    let high = min (low + 8) n
    for i in (low + 1)..high:
      let j = i
      for 0..8:
        if j <= low:
          break
        if ks[j - 1] <= ks[j]:
          break
        let key = ks[j]
        ks[j] := ks[j - 1]
        ks[j - 1] := key
        let index = ids[j]
        ids[j] := ids[j - 1]
        ids[j - 1] := index
        j := self - 1
  let kt: Array F32 = @array.fill n 0.0
  let idt: Array U32 = @array.fill n 0
  let width = 8
  for 0..32:
    if width >= n:
      break
    let low = 0
    for 0..n:
      if low >= n:
        break
      let middle = min (low + width) n
      let high = min (low + width * 2) n
      let i = low
      let j = middle
      for k in low..high:
        let take_left = if i >= middle then #False else if j >= high then #True else ks[i] <= ks[j]
        if take_left:
          kt[k] := ks[i]
          idt[k] := ids[i]
          i := self + 1
        else:
          kt[k] := ks[j]
          idt[k] := ids[j]
          j := self + 1
      low := self + width * 2
    let swap_k = ks
    ks := kt
    kt := swap_k
    let swap_i = ids
    ids := idt
    idt := swap_i
    width := self * 2
  return ids
