import { Vec2, Vec3 } from "std/vector"
import { Ray } from "./math"

// A button's state this step: held, and whether it went down or up since the
// previous step.
type Button is data = #Button { down: Bool, pressed: Bool, released: Bool }

// The pointer over the game viewport. `position` is in normalized device
// coordinates (-1..1, y up); `delta` is the movement since the previous step
// in CSS pixels. `ray` leaves the active game camera through the pointer.
// `hovered` is the entity the renderer found under the pointer (0 if none)
// and `point` where it was hit.
type Pointer is data = #Pointer {
  position: Vec2,
  delta: Vec2,
  wheel: F32,
  ray: Ray,
  hovered: U32,
  point: Vec3,
  inside: Bool,
  locked: Bool,
}
