// xorshift32. The state lives in the world, so a replay from the same state
// and inputs draws the same numbers. Zero would stay zero; it restarts from a
// fixed odd seed instead.
const next = fn (state: U32) -> U32 => do:
  let x = if state == 0 then 2654435769 else state
  x := self ^ (self << 13)
  x := self ^ (self >> 17)
  x := self ^ (self << 5)
  return x

// A number in [0, 1) from the state's high 24 bits.
const unit = fn (state: U32) => U32.to_f32 (state >> 8) / 16777216.0
