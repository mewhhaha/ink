// Array helpers.

// A fresh copy. The compiler updates an array in place only when it created
// the array itself in the current function; one passed in (or read from a
// record) is copied again on every write, so a function that updates an array
// it was given starts with `let a = arrays.copy given`.
const copy = fn (a: Array F32) -> Array F32 => @array.generate a.length (fn (i: U32) => a[i])
const copy_u32 = fn (a: Array U32) -> Array U32 => @array.generate a.length (fn (i: U32) => a[i])
