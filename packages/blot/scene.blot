open @import "./prelude.blot" ()

const Vector = @import "./vector.blot" ()

const Resource = @effect.host {
  .mesh = { .id = Int; .url = Str; } -> Unit;
  .texture = { .id = Int; .url = Str; } -> Unit;
}

const Render = @effect.host {
  .directional_light = {
    .color_blue = Int;
    .color_green = Int;
    .color_red = Int;
    .direction_x = Int;
    .direction_y = Int;
    .direction_z = Int;
    .intensity = Int;
  } -> Unit;
  .material = {
    .blend_edges = Int;
    .color_blue = Int;
    .color_green = Int;
    .color_red = Int;
    .id = Int;
    .secondary_texture = Int;
    .surface_mode = Int;
    .texture = Int;
    .texture_scale_x = Int;
    .texture_scale_y = Int;
    .path_connections = Int;
    .variation_seed = Int;
  } -> Unit;
  .isometric_tilemap = {
    .blend_field = Int;
    .columns = Int;
    .detail_field = Int;
    .detail_scale = Int;
    .first_object_id = Int;
    .ground_mesh = Int;
    .origin_y = Int;
    .path_field = Int;
    .road_texture = Int;
    .rows = Int;
    .secondary_texture = Int;
    .terrain_component = Int;
    .terrain_field = Int;
    .tile_half_height = Int;
    .tile_half_width = Int;
    .tile_scale = Int;
    .texture_scale_x = Int;
    .texture_scale_y = Int;
    .variation_seed = Int;
  } -> Unit;
  .isometric_component_layer = {
    .blend_edges = Int;
    .color_blue = Int;
    .color_green = Int;
    .color_red = Int;
    .columns = Int;
    .component = Int;
    .connection_mode = Int;
    .emissive = Int;
    .field = Int;
    .first_object_id = Int;
    .match_value = Int;
    .mesh = Int;
    .origin_y = Int;
    .rows = Int;
    .scale_x = Int;
    .scale_y = Int;
    .scale_z = Int;
    .secondary_texture = Int;
    .surface_mode = Int;
    .texture = Int;
    .texture_scale_x = Int;
    .texture_scale_y = Int;
    .tile_half_height = Int;
    .tile_half_width = Int;
    .variation_seed = Int;
    .z = Int;
  } -> Unit;
  .mesh = { .id = Int; .mesh = Int; } -> Unit;
  .projection = Int -> Unit;
  .zoom = Int -> Unit;
  .object = {
    .emissive = Int;
    .id = Int;
    .parent = Int;
    .rotation_x_microradians = Int;
    .rotation_y_microradians = Int;
    .rotation_z_microradians = Int;
    .scale_x = Int;
    .scale_y = Int;
    .scale_z = Int;
    .visible = Bool;
    .x = Int;
    .y = Int;
    .z = Int;
  } -> Unit;
}

const root = -1
const no_texture = -1
const perspective = 0
const orthographic = 1
const world_surface = 0
const connected_path = 1
const upright_decal = 2
const no_connections = 0
const cardinal_connections = 1

const vec3 = Vector.vec3
const uniform_scale = fn value => vec3 (value, value, value)

const transform = fn (position, rotation, scale) => {
  .position = position;
  .rotation = rotation;
  .scale = scale;
  }

const color = fn (red, green, blue) => {
  .blue = blue;
  .green = green;
  .red = red;
  }

const material = fn (base_color, emissive) => {
  .color = base_color;
  .emissive = emissive;
  .blend_edges = 0;
  .secondary_texture = no_texture;
  .surface_mode = world_surface;
  .texture = no_texture;
  .texture_scale = vec3 (1000000, 1000000, 0);
  .path_connections = 0;
  .variation_seed = 0;
  }

const textured_material = fn (
  base_color,
  emissive,
  texture,
  texture_scale
  ) => {
    .color = base_color;
    .emissive = emissive;
    .blend_edges = 0;
    .secondary_texture = no_texture;
    .surface_mode = world_surface;
    .texture = texture;
    .texture_scale = texture_scale;
    .path_connections = 0;
    .variation_seed = 0;
  }

const layered_material = fn (
  base_color,
  emissive,
  texture,
  secondary_texture,
  texture_scale,
  blend_edges,
  variation_seed
  ) => {
    .color = base_color;
    .emissive = emissive;
    .blend_edges = blend_edges;
    .secondary_texture = secondary_texture;
    .surface_mode = world_surface;
    .texture = texture;
    .texture_scale = texture_scale;
    .path_connections = 0;
    .variation_seed = variation_seed;
  }

const connected_path_material = fn (
  base_color,
  emissive,
  texture,
  texture_scale,
  path_connections
  ) => {
    .color = base_color;
    .emissive = emissive;
    .blend_edges = 0;
    .secondary_texture = no_texture;
    .surface_mode = connected_path;
    .texture = texture;
    .texture_scale = texture_scale;
    .path_connections = path_connections;
    .variation_seed = 0;
  }

const upright_decal_material = fn (
  base_color,
  emissive,
  texture
  ) => {
    .color = base_color;
    .emissive = emissive;
    .blend_edges = 0;
    .secondary_texture = no_texture;
    .surface_mode = upright_decal;
    .texture = texture;
    .texture_scale = vec3 (1000000, 1000000, 0);
    .path_connections = 0;
    .variation_seed = 0;
  }

let Camera = fn properties => fn children =>
  _ <- Render.projection properties.projection
  _ <- Render.zoom properties.zoom
  _ <- children ()

let DirectionalLight = fn properties => fn children =>
  _ <- Render.directional_light {
    .color_blue = properties.color.blue;
    .color_green = properties.color.green;
    .color_red = properties.color.red;
    .direction_x = properties.direction.x;
    .direction_y = properties.direction.y;
    .direction_z = properties.direction.z;
    .intensity = properties.intensity;
  }
  _ <- children ()

let MeshResource = fn properties => fn children =>
  _ <- Resource.mesh { .id = properties.id; .url = properties.url; }
  _ <- children ()

let TextureResource = fn properties => fn children =>
  _ <- Resource.texture { .id = properties.id; .url = properties.url; }
  _ <- children ()

let Object = fn properties => fn children =>
  let position = properties.transform.position
  let rotation = properties.transform.rotation
  let scale = properties.transform.scale
  let base_color = properties.material.color
  let texture_scale = properties.material.texture_scale
  _ <- Render.material {
    .blend_edges = properties.material.blend_edges;
    .color_blue = base_color.blue;
    .color_green = base_color.green;
    .color_red = base_color.red;
    .id = properties.id;
    .secondary_texture = properties.material.secondary_texture;
    .surface_mode = properties.material.surface_mode;
    .texture = properties.material.texture;
    .texture_scale_x = texture_scale.x;
    .texture_scale_y = texture_scale.y;
    .path_connections = properties.material.path_connections;
    .variation_seed = properties.material.variation_seed;
  }
  _ <- Render.mesh { .id = properties.id; .mesh = properties.mesh; }
  _ <- Render.object {
    .emissive = properties.material.emissive;
    .id = properties.id;
    .parent = properties.parent;
    .rotation_x_microradians = rotation.x;
    .rotation_y_microradians = rotation.y;
    .rotation_z_microradians = rotation.z;
    .scale_x = scale.x;
    .scale_y = scale.y;
    .scale_z = scale.z;
    .visible = properties.visible;
    .x = position.x;
    .y = position.y;
    .z = position.z;
  }
  _ <- children ()

let IsometricTilemap = fn properties => fn children =>
  _ <- Render.isometric_tilemap {
    .blend_field = properties.blend.field;
    .columns = properties.columns;
    .detail_field = properties.detail.field;
    .detail_scale = properties.detail_scale;
    .first_object_id = properties.first_object_id;
    .ground_mesh = properties.ground_mesh;
    .origin_y = properties.origin_y;
    .path_field = properties.path.field;
    .road_texture = properties.road_texture;
    .rows = properties.rows;
    .secondary_texture = properties.secondary_texture;
    .terrain_component = properties.terrain.component;
    .terrain_field = properties.terrain.field;
    .tile_half_height = properties.tile_half_height;
    .tile_half_width = properties.tile_half_width;
    .tile_scale = properties.tile_scale;
    .texture_scale_x = properties.texture_scale_x;
    .texture_scale_y = properties.texture_scale_y;
    .variation_seed = properties.variation_seed;
  }
  _ <- children ()

let IsometricComponentLayer = fn properties => fn children =>
  _ <- Render.isometric_component_layer {
    .blend_edges = properties.blend_edges;
    .color_blue = properties.color_blue;
    .color_green = properties.color_green;
    .color_red = properties.color_red;
    .columns = properties.columns;
    .component = properties.source.component;
    .connection_mode = properties.connection_mode;
    .emissive = properties.emissive;
    .field = properties.source.field;
    .first_object_id = properties.first_object_id;
    .match_value = properties.match_value;
    .mesh = properties.mesh;
    .origin_y = properties.origin_y;
    .rows = properties.rows;
    .scale_x = properties.scale_x;
    .scale_y = properties.scale_y;
    .scale_z = properties.scale_z;
    .secondary_texture = properties.secondary_texture;
    .surface_mode = properties.surface_mode;
    .texture = properties.texture;
    .texture_scale_x = properties.texture_scale_x;
    .texture_scale_y = properties.texture_scale_y;
    .tile_half_height = properties.tile_half_height;
    .tile_half_width = properties.tile_half_width;
    .variation_seed = properties.variation_seed;
    .z = properties.z;
  }
  _ <- children ()

return {
  .Resource = Resource;
  .Render = Render;
  .Camera = Camera;
  .DirectionalLight = DirectionalLight;
  .Object = Object;
  .IsometricTilemap = IsometricTilemap;
  .IsometricComponentLayer = IsometricComponentLayer;
  .MeshResource = MeshResource;
  .TextureResource = TextureResource;
  .root = root;
  .no_texture = no_texture;
  .perspective = perspective;
  .orthographic = orthographic;
  .world_surface = world_surface;
  .connected_path = connected_path;
  .upright_decal = upright_decal;
  .no_connections = no_connections;
  .cardinal_connections = cardinal_connections;
  .vec3 = vec3;
  .uniform_scale = uniform_scale;
  .transform = transform;
  .color = color;
  .material = material;
  .textured_material = textured_material;
  .layered_material = layered_material;
  .connected_path_material = connected_path_material;
  .upright_decal_material = upright_decal_material;
  .Vector = Vector;
}
