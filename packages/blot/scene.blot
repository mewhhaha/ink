open {} = (@import "./prelude.blot") ();

const Vector = (@import "./vector.blot") ();

const Render = @effect.host {
  .mesh = { .id = Int; .mesh = Int; } -> Unit;
  .projection = Int -> Unit;
  .object = {
    .color_blue = Int;
    .color_green = Int;
    .color_red = Int;
    .emissive = Int;
    .id = Int;
    .parent = Int;
    .rotation_x_microradians = Int;
    .rotation_y_microradians = Int;
    .rotation_z_microradians = Int;
    .scale_x = Int;
    .scale_y = Int;
    .scale_z = Int;
    .visible = Bool;
    .x = Int;
    .y = Int;
    .z = Int;
  } -> Unit;
};

const root = -1;
const perspective = 0;
const orthographic = 1;

const vec3 = Vector.vec3;
const uniform_scale = fn value => vec3 (value, value, value);

const transform = fn (position, rotation, scale) => {
  .position = position;
  .rotation = rotation;
  .scale = scale;
};

const color = fn (red, green, blue) => {
  .blue = blue;
  .green = green;
  .red = red;
};

const material = fn (base_color, emissive) => {
  .color = base_color;
  .emissive = emissive;
};

let Camera = fn properties => fn children => do
  _ <- Render.projection properties.projection;
  _ <- children ();
end;

let Object = fn properties => fn children => do
  let position = properties.transform.position;
  let rotation = properties.transform.rotation;
  let scale = properties.transform.scale;
  let base_color = properties.material.color;
  _ <- Render.mesh { .id = properties.id; .mesh = properties.mesh; };
  _ <- Render.object {
    .color_blue = base_color.blue;
    .color_green = base_color.green;
    .color_red = base_color.red;
    .emissive = properties.material.emissive;
    .id = properties.id;
    .parent = properties.parent;
    .rotation_x_microradians = rotation.x;
    .rotation_y_microradians = rotation.y;
    .rotation_z_microradians = rotation.z;
    .scale_x = scale.x;
    .scale_y = scale.y;
    .scale_z = scale.z;
    .visible = properties.visible;
    .x = position.x;
    .y = position.y;
    .z = position.z;
  };
  _ <- children ();
end;

return {
  .Render = Render;
  .Camera = Camera;
  .Object = Object;
  .root = root;
  .perspective = perspective;
  .orthographic = orthographic;
  .vec3 = vec3;
  .uniform_scale = uniform_scale;
  .transform = transform;
  .color = color;
  .material = material;
  .Vector = Vector;
};
