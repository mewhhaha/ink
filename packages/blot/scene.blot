open import "./prelude.blot"

const Vector = import "./vector.blot"

const Resource =
  @effect.host {
    .mesh = { .asset = Text; .id = Int; } -> Unit;
    .texture = { .asset = Text; .id = Int; } -> Unit;
  }

const SceneTree =
  @effect.host {
    .enter = Int -> Int;
    .leave = Int -> Unit;
  }

const Render =
  @effect.host {
    .directional_light = {
      .color_blue = Int;
      .color_green = Int;
      .color_red = Int;
      .direction_x = Int;
      .direction_y = Int;
      .direction_z = Int;
      .intensity = Int;
    } -> Unit;
    .material = {
      .blend_edges = Int;
      .color_blue = Int;
      .color_green = Int;
      .color_red = Int;
      .id = Int;
      .secondary_texture = Int;
      .surface_mode = Int;
      .texture = Int;
      .texture_offset_x = Int;
      .texture_offset_y = Int;
      .texture_scale_x = Int;
      .texture_scale_y = Int;
      .path_connections = Int;
      .variation_seed = Int;
    } -> Unit;
    .isometric_tilemap = {
      .blend_field = Int;
      .columns = Int;
      .detail_field = Int;
      .detail_scale = Int;
      .first_object_id = Int;
      .ground_mesh = Int;
      .origin_y = Int;
      .path_field = Int;
      .road_texture = Int;
      .rows = Int;
      .secondary_texture = Int;
      .terrain_component = Int;
      .terrain_field = Int;
      .tile_half_height = Int;
      .tile_half_width = Int;
      .tile_scale = Int;
      .texture_scale_x = Int;
      .texture_scale_y = Int;
      .variation_seed = Int;
    } -> Unit;
    .isometric_component_layer = {
      .blend_edges = Int;
      .color_blue = Int;
      .color_green = Int;
      .color_red = Int;
      .columns = Int;
      .component = Int;
      .connection_mode = Int;
      .emissive = Int;
      .field = Int;
      .first_object_id = Int;
      .match_value = Int;
      .mesh = Int;
      .origin_y = Int;
      .rows = Int;
      .scale_x = Int;
      .scale_y = Int;
      .scale_z = Int;
      .secondary_texture = Int;
      .surface_mode = Int;
      .texture = Int;
      .texture_scale_x = Int;
      .texture_scale_y = Int;
      .tile_half_height = Int;
      .tile_half_width = Int;
      .variation_seed = Int;
      .z = Int;
    } -> Unit;
    .mesh = { .id = Int; .mesh = Int; } -> Unit;
    .node = {
      .id = Int;
      .parent = Int;
      .rotation_x_microradians = Int;
      .rotation_y_microradians = Int;
      .rotation_z_microradians = Int;
      .scale_x = Int;
      .scale_y = Int;
      .scale_z = Int;
      .visible = Bool;
      .x = Int;
      .y = Int;
      .z = Int;
    } -> Unit;
    .orthogonal_tilemap = {
      .atlas_columns = Int;
      .cell_offset = Int;
      .columns = Int;
      .first_object_id = Int;
      .mesh = Int;
      .origin_x = Int;
      .origin_y = Int;
      .rows = Int;
      .texture = Int;
      .tile_size = Int;
      .z = Int;
    } -> Unit;
    .projection = Int -> Unit;
    .zoom = Int -> Unit;
    .object = {
      .emissive = Int;
      .id = Int;
      .parent = Int;
      .rotation_x_microradians = Int;
      .rotation_y_microradians = Int;
      .rotation_z_microradians = Int;
      .scale_x = Int;
      .scale_y = Int;
      .scale_z = Int;
      .visible = Bool;
      .x = Int;
      .y = Int;
      .z = Int;
    } -> Unit;
  }

const root = -1
const no_texture = -1
const perspective = 0
const orthographic = 1
const world_surface = 0
const connected_path = 1
const upright_decal = 2
const local_surface = 3
const pixel_decal = 4
const no_connections = 0
const cardinal_connections = 1

const Vector3 = { .x = Int; .y = Int; .z = Int; }
const Color = { .blue = Int; .green = Int; .red = Int; }
const Material =
  {
    .blend_edges = Int;
    .color = Color;
    .emissive = Int;
    .path_connections = Int;
    .secondary_texture = Int;
    .surface_mode = Int;
    .texture = Int;
    .texture_offset = Vector3;
    .texture_scale = Vector3;
    .variation_seed = Int;
  }
const MaterialOptions =
  {
    .blend_edges? = Int;
    .color = Color;
    .emissive? = Int;
    .path_connections? = Int;
    .secondary_texture? = Int;
    .surface_mode? = Int;
    .texture? = Int;
    .texture_offset_x? = Int;
    .texture_offset_y? = Int;
    .texture_scale_x? = Int;
    .texture_scale_y? = Int;
    .variation_seed? = Int;
  }

const vec3 = Vector.vec3
const uniform_scale = fn value => vec3 (value, value, value)

const transform = fn (position, rotation, scale) => {
  .position = position;
  .rotation = rotation;
  .scale = scale;
}

const color = fn (red, green, blue) => {
  .blue = blue;
  .green = green;
  .red = red;
}

let material :: MaterialOptions -> Material
let material = fn properties => do:
  let base_color = @satisfies properties.color Color
  let texture_scale_x = case properties.texture_scale_x of
    () => 1000000
    present => @satisfies present Int
  let texture_scale_y = case properties.texture_scale_y of
    () => 1000000
    present => @satisfies present Int
  let blend_edges = case properties.blend_edges of
    () => 0
    present => @satisfies present Int
  let emissive = case properties.emissive of
    () => 0
    present => @satisfies present Int
  let path_connections = case properties.path_connections of
    () => no_connections
    present => @satisfies present Int
  let secondary_texture = case properties.secondary_texture of
    () => no_texture
    present => @satisfies present Int
  let surface_mode = case properties.surface_mode of
    () => world_surface
    present => @satisfies present Int
  let texture = case properties.texture of
    () => no_texture
    present => @satisfies present Int
  let texture_offset_x = case properties.texture_offset_x of
    () => 0
    present => @satisfies present Int
  let texture_offset_y = case properties.texture_offset_y of
    () => 0
    present => @satisfies present Int
  let variation_seed = case properties.variation_seed of
    () => 0
    present => @satisfies present Int
  return {
    .blend_edges = blend_edges;
    .color = base_color;
    .emissive = emissive;
    .path_connections = path_connections;
    .secondary_texture = secondary_texture;
    .surface_mode = surface_mode;
    .texture = texture;
    .texture_offset = { .x = texture_offset_x; .y = texture_offset_y; .z = 0; };
    .texture_scale = { .x = texture_scale_x; .y = texture_scale_y; .z = 0; };
    .variation_seed = variation_seed;
    }

let run_children = fn children => do:
  for child in Iter.items children:
    use child

  return ()

let Camera = fn properties => fn children => do:
  use Render.projection properties.projection
  use Render.zoom properties.zoom
  use run_children children

let DirectionalLight = fn properties => fn children => do:
  use Render.directional_light {
    .color_blue = properties.color.blue;
    .color_green = properties.color.green;
    .color_red = properties.color.red;
    .direction_x = properties.direction.x;
    .direction_y = properties.direction.y;
    .direction_z = properties.direction.z;
    .intensity = properties.intensity;
  }
  use run_children children

let MeshResource = fn properties => fn children => do:
  use Resource.mesh { .asset = properties.asset; .id = properties.id; }
  use run_children children

let TextureResource = fn properties => fn children => do:
  use Resource.texture { .asset = properties.asset; .id = properties.id; }
  use run_children children

let Object = fn properties => fn children => do:
  let position = properties.transform.position
  let rotation = properties.transform.rotation
  let scale = properties.transform.scale
  let base_color = properties.material.color
  let texture_scale = properties.material.texture_scale
  let texture_offset = properties.material.texture_offset
  use Render.material {
    .blend_edges = properties.material.blend_edges;
    .color_blue = base_color.blue;
    .color_green = base_color.green;
    .color_red = base_color.red;
    .id = properties.id;
    .secondary_texture = properties.material.secondary_texture;
    .surface_mode = properties.material.surface_mode;
    .texture = properties.material.texture;
    .texture_offset_x = texture_offset.x;
    .texture_offset_y = texture_offset.y;
    .texture_scale_x = texture_scale.x;
    .texture_scale_y = texture_scale.y;
    .path_connections = properties.material.path_connections;
    .variation_seed = properties.material.variation_seed;
  }
  use Render.mesh { .id = properties.id; .mesh = properties.mesh; }
  use Render.object {
    .emissive = properties.material.emissive;
    .id = properties.id;
    .parent = properties.parent;
    .rotation_x_microradians = rotation.x;
    .rotation_y_microradians = rotation.y;
    .rotation_z_microradians = rotation.z;
    .scale_x = scale.x;
    .scale_y = scale.y;
    .scale_z = scale.z;
    .visible = properties.visible;
    .x = position.x;
    .y = position.y;
    .z = position.z;
  }
  use run_children children

let Node = fn properties => fn children => do:
  let position = properties.transform.position
  let rotation = properties.transform.rotation
  let scale = properties.transform.scale
  use parent <- SceneTree.enter properties.id
  use Render.node {
    .id = properties.id;
    .parent = parent;
    .rotation_x_microradians = rotation.x;
    .rotation_y_microradians = rotation.y;
    .rotation_z_microradians = rotation.z;
    .scale_x = scale.x;
    .scale_y = scale.y;
    .scale_z = scale.z;
    .visible = properties.visible;
    .x = position.x;
    .y = position.y;
    .z = position.z;
  }
  use run_children children
  use SceneTree.leave properties.id

let ObjectNode = fn properties => fn children => do:
  let position = properties.transform.position
  let rotation = properties.transform.rotation
  let scale = properties.transform.scale
  let base_color = properties.material.color
  let texture_scale = properties.material.texture_scale
  let texture_offset = properties.material.texture_offset
  use parent <- SceneTree.enter properties.id
  use Render.material {
    .blend_edges = properties.material.blend_edges;
    .color_blue = base_color.blue;
    .color_green = base_color.green;
    .color_red = base_color.red;
    .id = properties.id;
    .secondary_texture = properties.material.secondary_texture;
    .surface_mode = properties.material.surface_mode;
    .texture = properties.material.texture;
    .texture_offset_x = texture_offset.x;
    .texture_offset_y = texture_offset.y;
    .texture_scale_x = texture_scale.x;
    .texture_scale_y = texture_scale.y;
    .path_connections = properties.material.path_connections;
    .variation_seed = properties.material.variation_seed;
  }
  use Render.mesh { .id = properties.id; .mesh = properties.mesh; }
  use Render.object {
    .emissive = properties.material.emissive;
    .id = properties.id;
    .parent = parent;
    .rotation_x_microradians = rotation.x;
    .rotation_y_microradians = rotation.y;
    .rotation_z_microradians = rotation.z;
    .scale_x = scale.x;
    .scale_y = scale.y;
    .scale_z = scale.z;
    .visible = properties.visible;
    .x = position.x;
    .y = position.y;
    .z = position.z;
  }
  use run_children children
  use SceneTree.leave properties.id

let IsometricTilemap = fn properties => fn children => do:
  use Render.isometric_tilemap {
    .blend_field = properties.blend.field;
    .columns = properties.columns;
    .detail_field = properties.detail.field;
    .detail_scale = properties.detail_scale;
    .first_object_id = properties.first_object_id;
    .ground_mesh = properties.ground_mesh;
    .origin_y = properties.origin_y;
    .path_field = properties.path.field;
    .road_texture = properties.road_texture;
    .rows = properties.rows;
    .secondary_texture = properties.secondary_texture;
    .terrain_component = properties.terrain.component;
    .terrain_field = properties.terrain.field;
    .tile_half_height = properties.tile_half_height;
    .tile_half_width = properties.tile_half_width;
    .tile_scale = properties.tile_scale;
    .texture_scale_x = properties.texture_scale_x;
    .texture_scale_y = properties.texture_scale_y;
    .variation_seed = properties.variation_seed;
  }
  use run_children children

let IsometricComponentLayer = fn properties => fn children => do:
  use Render.isometric_component_layer {
    .blend_edges = properties.blend_edges;
    .color_blue = properties.color_blue;
    .color_green = properties.color_green;
    .color_red = properties.color_red;
    .columns = properties.columns;
    .component = properties.source.component;
    .connection_mode = properties.connection_mode;
    .emissive = properties.emissive;
    .field = properties.source.field;
    .first_object_id = properties.first_object_id;
    .match_value = properties.match_value;
    .mesh = properties.mesh;
    .origin_y = properties.origin_y;
    .rows = properties.rows;
    .scale_x = properties.scale_x;
    .scale_y = properties.scale_y;
    .scale_z = properties.scale_z;
    .secondary_texture = properties.secondary_texture;
    .surface_mode = properties.surface_mode;
    .texture = properties.texture;
    .texture_scale_x = properties.texture_scale_x;
    .texture_scale_y = properties.texture_scale_y;
    .tile_half_height = properties.tile_half_height;
    .tile_half_width = properties.tile_half_width;
    .variation_seed = properties.variation_seed;
    .z = properties.z;
  }
  use run_children children

let OrthogonalTilemap = fn properties => fn children => do:
  use Render.orthogonal_tilemap {
    .atlas_columns = properties.atlas_columns;
    .cell_offset = properties.cell_offset;
    .columns = properties.columns;
    .first_object_id = properties.first_object_id;
    .mesh = properties.mesh;
    .origin_x = properties.origin_x;
    .origin_y = properties.origin_y;
    .rows = properties.rows;
    .texture = properties.texture;
    .tile_size = properties.tile_size;
    .z = properties.z;
  }
  use run_children children

return {
  .Resource = Resource;
  .Render = Render;
  .Camera = Camera;
  .DirectionalLight = DirectionalLight;
  .Object = Object;
  .Node = Node;
  .ObjectNode = ObjectNode;
  .IsometricTilemap = IsometricTilemap;
  .IsometricComponentLayer = IsometricComponentLayer;
  .OrthogonalTilemap = OrthogonalTilemap;
  .MeshResource = MeshResource;
  .TextureResource = TextureResource;
  .root = root;
  .no_texture = no_texture;
  .perspective = perspective;
  .orthographic = orthographic;
  .world_surface = world_surface;
  .connected_path = connected_path;
  .upright_decal = upright_decal;
  .local_surface = local_surface;
  .pixel_decal = pixel_decal;
  .no_connections = no_connections;
  .cardinal_connections = cardinal_connections;
  .vec3 = vec3;
  .uniform_scale = uniform_scale;
  .transform = transform;
  .color = color;
  .material = material;
  .Vector = Vector;
  }
