open import "./prelude.blot"

const Vector = import "./vector.blot"

const Abi = import "./abi.blot"
const Render = Abi.Render
const Resource = Abi.Resource
const SceneTree = Abi.SceneTree

const root = -1
const no_texture = -1
const world_surface = 0
const connected_path = 1
const upright_decal = 2
const local_surface = 3
const pixel_decal = 4
const no_connections = 0
const cardinal_connections = 1

const Vector3 = { .x = Int; .y = Int; .z = Int; }
const Color = { .blue = Int; .green = Int; .red = Int; }
const Material =
  {
    .blend_edges = Int;
    .color = Color;
    .emissive = Int;
    .path_connections = Int;
    .secondary_texture = Int;
    .surface_mode = Int;
    .texture = Int;
    .texture_offset = Vector3;
    .texture_scale = Vector3;
    .variation_seed = Int;
  }
const MaterialOptions =
  {
    .blend_edges? = Int;
    .color = Color;
    .emissive? = Int;
    .path_connections? = Int;
    .secondary_texture? = Int;
    .surface_mode? = Int;
    .texture? = Int;
    .texture_offset_x? = Int;
    .texture_offset_y? = Int;
    .texture_scale_x? = Int;
    .texture_scale_y? = Int;
    .variation_seed? = Int;
  }

const vec3 = Vector.vec3
const uniform_scale = fn value => vec3 (value, value, value)

const transform = fn (position, rotation, scale) => {
  .position = position;
  .rotation = rotation;
  .scale = scale;
}

const color = fn (red, green, blue) => {
  .blue = blue;
  .green = green;
  .red = red;
}

let material :: MaterialOptions -> Material
let material = fn properties => do:
  let base_color = @satisfies properties.color Color
  let texture_scale_x = case properties.texture_scale_x of
    () => 1000000
    present => @satisfies present Int
  let texture_scale_y = case properties.texture_scale_y of
    () => 1000000
    present => @satisfies present Int
  let blend_edges = case properties.blend_edges of
    () => 0
    present => @satisfies present Int
  let emissive = case properties.emissive of
    () => 0
    present => @satisfies present Int
  let path_connections = case properties.path_connections of
    () => no_connections
    present => @satisfies present Int
  let secondary_texture = case properties.secondary_texture of
    () => no_texture
    present => @satisfies present Int
  let surface_mode = case properties.surface_mode of
    () => world_surface
    present => @satisfies present Int
  let texture = case properties.texture of
    () => no_texture
    present => @satisfies present Int
  let texture_offset_x = case properties.texture_offset_x of
    () => 0
    present => @satisfies present Int
  let texture_offset_y = case properties.texture_offset_y of
    () => 0
    present => @satisfies present Int
  let variation_seed = case properties.variation_seed of
    () => 0
    present => @satisfies present Int
  return {
    .blend_edges = blend_edges;
    .color = base_color;
    .emissive = emissive;
    .path_connections = path_connections;
    .secondary_texture = secondary_texture;
    .surface_mode = surface_mode;
    .texture = texture;
    .texture_offset = { .x = texture_offset_x; .y = texture_offset_y; .z = 0; };
    .texture_scale = { .x = texture_scale_x; .y = texture_scale_y; .z = 0; };
    .variation_seed = variation_seed;
    }

let run_children = fn children => do:
  for child in Iter.items children:
    use child

  return ()

let PerspectiveCamera = fn properties => fn children => do:
  let position = properties.position
  let target = properties.target
  let clear_color = properties.clear_color
  use Render.perspective_camera {
    .clear_blue = clear_color.blue;
    .clear_green = clear_color.green;
    .clear_red = clear_color.red;
    .position_x = position.x;
    .position_y = position.y;
    .position_z = position.z;
    .target_x = target.x;
    .target_y = target.y;
    .target_z = target.z;
    .vertical_fov_microradians = properties.vertical_fov_microradians;
  }
  use run_children children

let OrthographicCamera = fn properties => fn children => do:
  let position = properties.position
  let target = properties.target
  let clear_color = properties.clear_color
  use Render.orthographic_camera {
    .clear_blue = clear_color.blue;
    .clear_green = clear_color.green;
    .clear_red = clear_color.red;
    .position_x = position.x;
    .position_y = position.y;
    .position_z = position.z;
    .target_x = target.x;
    .target_y = target.y;
    .target_z = target.z;
    .vertical_size = properties.vertical_size;
  }
  use run_children children

let Environment = fn properties => fn children => do:
  let ambient_light = properties.ambient_light
  let fog_color = properties.fog_color
  use Render.environment {
    .ambient_blue = ambient_light.blue;
    .ambient_green = ambient_light.green;
    .ambient_red = ambient_light.red;
    .bloom_intensity = properties.bloom_intensity;
    .exposure_ev100 = properties.exposure_ev100;
    .fog_blue = fog_color.blue;
    .fog_density = properties.fog_density;
    .fog_green = fog_color.green;
    .fog_red = fog_color.red;
  }
  use run_children children

let DirectionalLight = fn properties => fn children => do:
  use Render.directional_light {
    .color_blue = properties.color.blue;
    .color_green = properties.color.green;
    .color_red = properties.color.red;
    .direction_x = properties.direction.x;
    .direction_y = properties.direction.y;
    .direction_z = properties.direction.z;
    .intensity = properties.intensity;
  }
  use run_children children

let MeshResource = fn properties => fn children => do:
  use Resource.mesh { .asset = properties.asset; .id = properties.id; }
  use run_children children

let TextureResource = fn properties => fn children => do:
  use Resource.texture { .asset = properties.asset; .id = properties.id; }
  use run_children children

let Object = fn properties => fn children => do:
  let position = properties.transform.position
  let rotation = properties.transform.rotation
  let scale = properties.transform.scale
  let base_color = properties.material.color
  let texture_scale = properties.material.texture_scale
  let texture_offset = properties.material.texture_offset
  use Render.material {
    .blend_edges = properties.material.blend_edges;
    .color_blue = base_color.blue;
    .color_green = base_color.green;
    .color_red = base_color.red;
    .id = properties.id;
    .secondary_texture = properties.material.secondary_texture;
    .surface_mode = properties.material.surface_mode;
    .texture = properties.material.texture;
    .texture_offset_x = texture_offset.x;
    .texture_offset_y = texture_offset.y;
    .texture_scale_x = texture_scale.x;
    .texture_scale_y = texture_scale.y;
    .path_connections = properties.material.path_connections;
    .variation_seed = properties.material.variation_seed;
  }
  use Render.mesh { .id = properties.id; .mesh = properties.mesh; }
  use Render.object {
    .emissive = properties.material.emissive;
    .id = properties.id;
    .parent = properties.parent;
    .rotation_x_microradians = rotation.x;
    .rotation_y_microradians = rotation.y;
    .rotation_z_microradians = rotation.z;
    .scale_x = scale.x;
    .scale_y = scale.y;
    .scale_z = scale.z;
    .visible = properties.visible;
    .x = position.x;
    .y = position.y;
    .z = position.z;
  }
  use run_children children

let Node = fn properties => fn children => do:
  let position = properties.transform.position
  let rotation = properties.transform.rotation
  let scale = properties.transform.scale
  use parent <- SceneTree.enter properties.id
  use Render.node {
    .id = properties.id;
    .parent = parent;
    .rotation_x_microradians = rotation.x;
    .rotation_y_microradians = rotation.y;
    .rotation_z_microradians = rotation.z;
    .scale_x = scale.x;
    .scale_y = scale.y;
    .scale_z = scale.z;
    .visible = properties.visible;
    .x = position.x;
    .y = position.y;
    .z = position.z;
  }
  use run_children children
  use SceneTree.leave properties.id

let ObjectNode = fn properties => fn children => do:
  let position = properties.transform.position
  let rotation = properties.transform.rotation
  let scale = properties.transform.scale
  let base_color = properties.material.color
  let texture_scale = properties.material.texture_scale
  let texture_offset = properties.material.texture_offset
  use parent <- SceneTree.enter properties.id
  use Render.material {
    .blend_edges = properties.material.blend_edges;
    .color_blue = base_color.blue;
    .color_green = base_color.green;
    .color_red = base_color.red;
    .id = properties.id;
    .secondary_texture = properties.material.secondary_texture;
    .surface_mode = properties.material.surface_mode;
    .texture = properties.material.texture;
    .texture_offset_x = texture_offset.x;
    .texture_offset_y = texture_offset.y;
    .texture_scale_x = texture_scale.x;
    .texture_scale_y = texture_scale.y;
    .path_connections = properties.material.path_connections;
    .variation_seed = properties.material.variation_seed;
  }
  use Render.mesh { .id = properties.id; .mesh = properties.mesh; }
  use Render.object {
    .emissive = properties.material.emissive;
    .id = properties.id;
    .parent = parent;
    .rotation_x_microradians = rotation.x;
    .rotation_y_microradians = rotation.y;
    .rotation_z_microradians = rotation.z;
    .scale_x = scale.x;
    .scale_y = scale.y;
    .scale_z = scale.z;
    .visible = properties.visible;
    .x = position.x;
    .y = position.y;
    .z = position.z;
  }
  use run_children children
  use SceneTree.leave properties.id

let OrthogonalTilemap = fn properties => fn children => do:
  use Render.orthogonal_tilemap {
    .atlas_columns = properties.atlas_columns;
    .cell_offset = properties.cell_offset;
    .columns = properties.columns;
    .first_object_id = properties.first_object_id;
    .mesh = properties.mesh;
    .origin_x = properties.origin_x;
    .origin_y = properties.origin_y;
    .rows = properties.rows;
    .texture = properties.texture;
    .tile_size = properties.tile_size;
    .z = properties.z;
  }
  use run_children children

return {
  .Resource = Resource;
  .Render = Render;
  .PerspectiveCamera = PerspectiveCamera;
  .OrthographicCamera = OrthographicCamera;
  .Environment = Environment;
  .DirectionalLight = DirectionalLight;
  .Object = Object;
  .Node = Node;
  .ObjectNode = ObjectNode;
  .OrthogonalTilemap = OrthogonalTilemap;
  .MeshResource = MeshResource;
  .TextureResource = TextureResource;
  .root = root;
  .no_texture = no_texture;
  .world_surface = world_surface;
  .connected_path = connected_path;
  .upright_decal = upright_decal;
  .local_surface = local_surface;
  .pixel_decal = pixel_decal;
  .no_connections = no_connections;
  .cardinal_connections = cardinal_connections;
  .vec3 = vec3;
  .uniform_scale = uniform_scale;
  .transform = transform;
  .color = color;
  .material = material;
  .Vector = Vector;
  }
