{
  "name": "@ink/blot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./abi.blot": "./abi.blot",
    "./adapter.ts": "./src/adapter.ts",
    "./build.ts": "./src/build.ts",
    "./data_asset.ts": "./src/data_asset.ts",
    "./data.blot": "./data.blot",
    "./ecs.blot": "./ecs.blot",
    "./engine.blot": "./engine.blot",
    "./html_canvas.blot": "./html_canvas.blot",
    "./math.blot": "./math.blot",
    "./protocol.ts": "./src/protocol.ts",
    "./runtime.ts": "./src/runtime.ts",
    "./scene.blot": "./scene.blot"
  },
  "scripts": {
    "check": "deno check --config ../../deno.json src/*.ts *_test.ts",
    "generate:abi": "deno run --allow-write=abi.blot,testdata/abi_registry_contract.blot src/generate_abi.ts",
    "test": "deno test --config ../../deno.json --allow-read --allow-write=testdata --allow-run=deno *_test.ts src/*_test.ts"
  },
  "dependencies": {
    "@ink/assets": "workspace:*",
    "@ink/ecs": "workspace:*",
    "@ink/math": "workspace:*",
    "@ink/observability": "workspace:*",
    "@ink/runtime": "workspace:*",
    "@ink/scene": "workspace:*",
    "@ink/ui": "workspace:*",
    "@mewhhaha/blot": "link:../../../blot",
    "@mewhhaha/typeclasses": "catalog:"
  },
  "ink": {
    "kind": "adapter"
  }
}
