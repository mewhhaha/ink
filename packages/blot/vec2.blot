open import "./prelude.blot"

const M = import "./math.blot"

const vec2 = fn (x, y) => { .x = x; .y = y; }
const zero = vec2 (0, 0)

const add = fn (left, right) => vec2 ( left.x + right.x, left.y + right.y )

const subtract = fn (left, right) => vec2 ( left.x - right.x, left.y - right.y )

const scale = fn (vector, factor) => do:
  return vec2 (
    M.fixed_mul (vector.x, factor),
    M.fixed_mul (vector.y, factor)
    )

const lerp = fn (start, finish, amount) => do:
  return vec2 (
    M.fixed_lerp (start.x, finish.x, amount),
    M.fixed_lerp (start.y, finish.y, amount)
    )

return {
  .vec2 = vec2;
  .zero = zero;
  .add = add;
  .subtract = subtract;
  .scale = scale;
  .lerp = lerp;
  }
