open {} = (@import "./prelude.blot") ();

const M = (@import "./math.blot") ();

const FOCAL_PIXELS = 420;
const ORTHOGRAPHIC_PIXELS = 70;
const CAMERA_DISTANCE = 6000000;

const depth = fn z => M.clamp (CAMERA_DISTANCE - z, 250000, 30000000);

const screen_x = fn (x, z, projection, width) =>
  if projection == 0
  then width / 2 + x * FOCAL_PIXELS / depth z
  else width / 2 + x * ORTHOGRAPHIC_PIXELS / M.fixed
  end;

const screen_y = fn (y, z, projection, height) =>
  if projection == 0
  then height / 2 - y * FOCAL_PIXELS / depth z
  else height / 2 - y * ORTHOGRAPHIC_PIXELS / M.fixed
  end;

const screen_size = fn (scale, z, projection) =>
  if projection == 0
  then M.clamp (scale * FOCAL_PIXELS / depth z, 24, 180)
  else M.clamp (scale * ORTHOGRAPHIC_PIXELS / M.fixed, 24, 180)
  end;

const bounds = fn (x, y, z, scale, projection, width, height) => do
  let size = screen_size (scale, z, projection);
  let centre_x = screen_x (x, z, projection, width);
  let centre_y = screen_y (y, z, projection, height);
  in {
    .left = centre_x - size / 2;
    .top = centre_y - size / 2;
    .width = size;
    .height = size;
  }
end;

return {
  .screen_x = screen_x;
  .screen_y = screen_y;
  .screen_size = screen_size;
  .bounds = bounds;
};
