{
  "name": "@ink/shaders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./compose.ts": "./src/compose.ts",
    "./diagnostics.ts": "./src/diagnostics.ts",
    "./experimental/builtins.ts": "./src/experimental/builtins.ts",
    "./experimental/noise.ts": "./src/experimental/noise.ts",
    "./experimental/reload.ts": "./src/experimental/reload.ts",
    "./experimental/variant.ts": "./src/experimental/variant.ts",
    "./identity.ts": "./src/identity.ts",
    "./module.ts": "./src/module.ts",
    "./pbr.ts": "./src/pbr.ts"
  },
  "scripts": {
    "bench": "deno bench --config ../../deno.json src/*_bench.ts",
    "check": "deno check --config ../../deno.json src/*.ts src/experimental/*.ts",
    "test": "deno test --config ../../deno.json src/*_test.ts"
  },
  "dependencies": {
    "@ink/noise": "workspace:*"
  },
  "ink": {
    "kind": "core"
  }
}
