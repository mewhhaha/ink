{
  "name": "@ink/assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./build.ts": "./src/build.ts",
    "./bundle.ts": "./src/bundle.ts",
    "./cache.ts": "./src/cache.ts",
    "./digest.ts": "./src/digest.ts",
    "./experimental/gltf.ts": "./src/experimental/gltf.ts",
    "./experimental/media.ts": "./src/experimental/media.ts",
    "./experimental/stream.ts": "./src/experimental/stream.ts",
    "./identity.ts": "./src/identity.ts",
    "./load.ts": "./src/load.ts",
    "./manifest.ts": "./src/manifest.ts",
    "./mesh.ts": "./src/mesh.ts",
    "./prepared_scene.ts": "./src/prepared_scene.ts"
  },
  "scripts": {
    "bench": "deno bench --config ../../deno.json src/*_bench.ts",
    "check": "deno check --config ../../deno.json src/*.ts src/experimental/*.ts src/internal/*.ts",
    "test": "deno test --config ../../deno.json --allow-read=package.json src/*_test.ts src/experimental/*_test.ts src/internal/*_test.ts"
  },
  "dependencies": {
    "@ink/observability": "workspace:*"
  },
  "ink": {
    "kind": "core"
  }
}
