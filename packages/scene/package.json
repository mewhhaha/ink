{
  "name": "@ink/scene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./experimental/scene.ts": "./src/experimental/scene.ts",
    "./experimental/serialization.ts": "./src/experimental/serialization.ts",
    "./hierarchy.ts": "./src/hierarchy.ts",
    "./identity.ts": "./src/identity.ts"
  },
  "scripts": {
    "bench": "deno bench --config ../../deno.json src/*_bench.ts",
    "check": "deno check --config ../../deno.json src/*.ts src/experimental/*.ts",
    "test": "deno test --config ../../deno.json src/*_test.ts"
  },
  "dependencies": {
    "@ink/assets": "workspace:*",
    "@ink/geometry": "workspace:*",
    "@ink/math": "workspace:*",
    "@ink/observability": "workspace:*"
  },
  "ink": {
    "kind": "core"
  }
}
