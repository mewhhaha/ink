    "./experimental/model.ts": "./src/experimental/model.ts",
    "./experimental/occlusion.ts": "./src/experimental/occlusion.ts",
    "./experimental/paths.ts": "./src/experimental/paths.ts",
    "./experimental/postprocess.ts": "./src/experimental/postprocess.ts",
    "./experimental/resources.ts": "./src/experimental/resources.ts",
    "./experimental/shader_contract.ts": "./src/experimental/shader_contract.ts",
    "./experimental/shader.ts": "./src/experimental/shader.ts",
