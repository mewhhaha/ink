{
  "name": "@ink/rendering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./experimental/device.ts": "./src/experimental/device.ts",
    "./experimental/extraction.ts": "./src/experimental/extraction.ts",
    "./experimental/gpu_resources.ts": "./src/experimental/gpu_resources.ts",
    "./experimental/graph.ts": "./src/experimental/graph.ts",
