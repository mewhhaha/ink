{
  "name": "ink-engine",
  "version": "0.1.0",
  "exports": "./main.ts",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "deno.ns", "esnext"],
    "types": ["@types/react", "@types/react-dom"],
    "strict": true
  },
  "lint": {
    "exclude": ["public/editor.js"]
  },
  "tasks": {
    "build:game": "deno run -A tooling/build_game.ts",
    "build": "deno install --vendor=true && deno task build:game && deno run -A npm:vite@8.2.0 build",
    "check": "deno check main.ts vite.config.ts editor/main.tsx editor/logic.ts editor/webgpu.ts runtime/*.ts headless/main.ts tooling/*.ts *_test.ts blocks/blot/*_test.ts editor/*_test.ts runtime/*_test.ts",
    "dev": "deno run -A tooling/dev.ts",
    "desktop": "deno task build && deno desktop --backend cef --allow-net --allow-read --include public main.ts",
    "serve": "deno task build && deno run --watch --allow-net --allow-read main.ts",
    "headless": "deno task build:game && deno run --allow-read headless/main.ts",
    "test": "deno task build && deno test --allow-read --allow-run=deno"
  },
  "desktop": {
    "app": {
      "name": "Ink Engine",
      "identifier": "com.mewhhaha.ink-engine"
    },
    "backend": "cef",
    "output": {
      "linux": "./dist/ink-engine.AppImage",
      "macos": "./dist/Ink Engine.app",
      "windows": "./dist/Ink Engine"
    }
  },
  "imports": {
    "@heroicons/react": "npm:@heroicons/react@2.2.0",
    "@heroicons/react/24/solid": "npm:@heroicons/react@2.2.0/24/solid",
    "@comp0/react": "npm:@comp0/react@0.1.0-next.0",
    "@mewhhaha/typeclasses": "jsr:@mewhhaha/typeclasses@0.8.0",
    "@rolldown/plugin-babel": "npm:@rolldown/plugin-babel@0.2.3",
    "@std/assert": "jsr:@std/assert@1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.3.3",
    "@types/react": "npm:@types/react@19.2.18",
    "@types/react-dom": "npm:@types/react-dom@19.2.4",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.0.5",
    "babel-plugin-react-compiler": "npm:babel-plugin-react-compiler@1.0.0",
    "react": "npm:react@19.2.8",
    "react/compiler-runtime": "npm:react@19.2.8/compiler-runtime",
    "react-dom": "npm:react-dom@19.2.8",
    "react-dom/client": "npm:react-dom@19.2.8/client",
    "react/jsx-runtime": "npm:react@19.2.8/jsx-runtime",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "vite": "npm:vite@8.2.0"
  }
}
