{
  "workspace": [
    "./packages/schema",
    "./packages/blot",
    "./packages/core",
    "./packages/geometry",
    "./packages/render",
    "./packages/react",
    "./packages/brushes",
    "./packages/dev",
    "./packages/player"
  ],
  "nodeModulesDir": "auto",
  "links": [
    "../blot2"
  ],
  "imports": {
    "@electron/packager": "npm:@electron/packager@20.3.0",
    "@mewhhaha/blot": "jsr:@mewhhaha/blot@0.2.0",
    "@mewhhaha/blot/guest": "jsr:@mewhhaha/blot@0.2.0/guest",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.0.5",
    "playwright-core": "npm:playwright-core@1.62.1",
    "react": "npm:react@19.2.8",
    "react/jsx-runtime": "npm:react@19.2.8/jsx-runtime",
    "react/jsx-dev-runtime": "npm:react@19.2.8/jsx-dev-runtime",
    "react-dom": "npm:react-dom@19.2.8",
    "react-dom/client": "npm:react-dom@19.2.8/client",
    "@types/react": "npm:@types/react@19.2.18",
    "@types/react-dom": "npm:@types/react-dom@19.2.4",
    "vite": "npm:vite@8.2.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "esnext"
    ],
    "strict": true
  },
  "tasks": {
    "ink": "deno run -A packages/dev/cli.ts",
    "dev:godot": "deno run -A packages/dev/cli.ts dev examples/godot",
    "dev:trenchbroom": "deno run -A packages/dev/cli.ts dev examples/trenchbroom",
    "dev:hammer": "deno run -A packages/dev/cli.ts dev examples/hammer",
    "test": "deno test -A packages",
    "check": "deno fmt --check && deno lint && deno check packages examples scripts",
    "test:browser": "deno run -A scripts/smoke.ts",
    "test:brushes": "deno run -A scripts/brush-smoke.ts",
    "test:scenarios": "deno run -A scripts/scenario-smoke.ts",
    "test:live": "deno run -A scripts/live-smoke.ts",
    "test:build": "deno run -A scripts/build-smoke.ts",
    "test:desktop": "deno run -A scripts/desktop-smoke.ts",
    "test:multiplayer": "deno run -A scripts/multiplayer-smoke.ts",
    "test:shared": "deno run -A scripts/shared-smoke.ts",
    "test:render": "deno run -A scripts/render-smoke.ts",
    "test:clusters": "deno run -A scripts/cluster-smoke.ts",
    "test:particles": "deno run -A scripts/particles-smoke.ts",
    "test:animation": "deno run -A scripts/animation-smoke.ts",
    "test:temporal": "deno run -A scripts/temporal-smoke.ts",
    "test:gi": "deno run -A scripts/gi-smoke.ts",
    "dev:feel": "deno run -A packages/dev/cli.ts dev examples/feel"
  },
  "fmt": {
    "exclude": [
      "**/*.gen.blot",
      "**/*.gen.ts",
      ".ink/",
      "**/.ink/",
      "dist/",
      "**/dist/"
    ]
  },
  "lint": {
    "exclude": [
      ".ink/",
      "**/.ink/",
      "dist/",
      "**/dist/"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  }
}
