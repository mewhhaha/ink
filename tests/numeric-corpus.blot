import * as color from "ink/color"
import * as lighting from "ink/lighting"
import * as camera from "ink/camera"
import * as shadow from "ink/shadow"
import * as math from "ink/math"
const vec = func (a: Array F32) => return func (i: U32) => return math.vec3 a[i] a[i + 1] a[i + 2]
entry const colors = func (a: Array F32) : Array F32 => return #[color.linear_channel a[0],color.srgb_channel a[0],color.tone_channel a[0],(color.display a[1] (math.rgb a[0] a[0] a[0])).r]
entry const brdf = func (a: Array F32) : Array F32 => return do:
  let material = $lighting.Material { base: math.rgb a[0] a[1] a[2],metallic: a[3],roughness: a[4],emission: math.rgb 0.0 0.0 0.0 }
  let result = lighting.brdf material (vec a 5) (vec a 8) (vec a 11)
  return #[result.r,result.g,result.b]
entry const projection = func (a: Array F32) : Array F32 => return do:
  let projection = $camera.Perspective { fov_y: a[0],aspect: a[1],near: a[2],far: a[3],reversed: a[4] > 0.0 }
  if a[5] > 0.0:
    projection := $camera.Orthographic { height: a[0],aspect: a[1],near: a[2],far: a[3],reversed: a[4] > 0.0 }
  let c = $camera.Camera { position: math.zero3,rotation: math.identity_quat,projection }
  let p = case camera.project c (vec a 6) of
    $Nothing => math.zero3
    $Some value => value
  let m = camera.matrix c
  return #[p.x,p.y,p.z,m.x.x,m.x.y,m.x.z,m.x.w,m.y.x,m.y.y,m.y.z,m.y.w,m.z.x,m.z.y,m.z.z,m.z.w,m.w.x,m.w.y,m.w.z,m.w.w]
entry const splits = func (a: Array F32) : Array F32 => return shadow.splits a[0] a[1] (F32.to_u32 a[2]) a[3]
