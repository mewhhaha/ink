// Ink's headless controls (lib/ui.sq): how stepping, sliding and
// the keys change a toggle, a slider and a choice, and how a menu of them
// answers a key; and numbers in decimal digits.
import * as array from "std/array"
import * as test from "std/test"
import * as keys from "ink/input/keys"
import * as tree from "ink/ui/tree"
import * as ui from "ink/ui"

const name_span = $tree.Span { start: 0, count: 1 }
const options_span = $tree.Span { start: 0, count: 3 }
const toggle = $ui.Toggle { label: name_span, on: false }
const slider = $ui.Slider { label: name_span, value: 0.5, low: 0.0, high: 1.0, step: 0.25 }
const button = $ui.Button { label: name_span }
const choice = $ui.Choice { label: name_span, options: options_span, chosen: 0 }

// A control's value as a number: on, the slider's value, the chosen option.
func value (control: ui.Control) => case control of
  $ui.Toggle { on } => do:
    if on:
      break 1.0
    break 0.0
  $ui.Slider { value } => value
  $ui.Choice { chosen } => U32.to_f32 chosen
  $ui.Button _ => -1.0

@[test.suite]
test "a toggle flips":
  use test.near_array "check 1" 0.0 #[1.0] #[value (ui.step toggle 1.0)]
  return ()

@[test.suite]
test "a slider steps within its range":
  use test.near_array "check 1" 0.0 #[0.75, 1.0, 0.25] #[
      value (ui.step slider 1.0),
      value (ui.step (ui.step (ui.step slider 1.0) 1.0) 1.0),
      value (ui.step slider (-1.0)),
    ]
  return ()

@[test.suite]
test "a choice wraps round":
  use test.near_array "check 1" 0.0 #[2.0, 1.0] #[value (ui.step choice (-1.0)), value (ui.step choice 1.0)]
  return ()

@[test.suite]
test "a slide snaps to a step within the range":
  use test.near_array "check 1" 0.0 #[0.5, 1.0] #[value (ui.slide slider 0.6), value (ui.slide slider 7.0)]
  use test.near_array "check 2" 0.0 #[0.25] #[ui.fraction ($ui.Slider { label: name_span, value: 3.0, low: 2.0, high: 6.0, step: 1.0 })]
  return ()

  // What a key does: 0 moved, 1 pressed, 2 changed, 3 ignored, then the index
  // and the changed control's value.
func outcome (result: ui.Outcome) => case result of
  $ui.Moved index => #[0.0, U32.to_f32 index, 0.0]
  $ui.Pressed index => #[1.0, U32.to_f32 index, 0.0]
  $ui.Changed { index, control } => #[2.0, U32.to_f32 index, value control]
  $ui.Ignored => #[3.0, 0.0, 0.0]


@[test.suite]
test "up and down wrap round the menu":
  let menu = #[button, toggle, choice]
  use test.near_array "check 1" 0.0 #[0.0, 2.0, 0.0] (outcome (ui.key menu 0 keys.up))
  use test.near_array "check 2" 0.0 #[0.0, 0.0, 0.0] (outcome (ui.key menu 2 keys.down))
  return ()

@[test.suite]
test "enter presses a button and arrows leave it alone":
  let menu = #[button, toggle, choice]
  use test.near_array "check 1" 0.0 #[1.0, 0.0, 0.0] (outcome (ui.key menu 0 keys.enter))
  use test.near_array "check 2" 0.0 #[3.0, 0.0, 0.0] (outcome (ui.key menu 0 keys.right))
  return ()

@[test.suite]
test "space flips a toggle":
  let menu = #[button, toggle, choice]
  use test.near_array "check 1" 0.0 #[2.0, 1.0, 1.0] (outcome (ui.key menu 1 keys.space))
  return ()

@[test.suite]
test "left moves a choice back wrapping":
  let menu = #[button, toggle, choice]
  use test.near_array "check 1" 0.0 #[2.0, 2.0, 2.0] (outcome (ui.key menu 2 keys.left))
  return ()

@[test.suite]
test "other keys do nothing":
  let menu = #[button, toggle, choice]
  use test.near_array "check 1" 0.0 #[3.0, 0.0, 0.0] (outcome (ui.key menu 2 keys.a))
  return ()

  // `value`'s digits read back as a number.
func read_digits (value: U32) =>
  let result = 0.0
  for code in ui.digits value:
    result := self * 10.0 + U32.to_f32 (code - 48)
  return result

@[test.suite]
test "digits spell a number":
  use test.near_array "check 1" 0.0 #[0.0, 7.0, 42.0, 1234567.0] (array.map read_digits #[0, 7, 42, 1234567])
  return ()
