import * as array from "std/array"
import * as check from "./check"
import * as ground from "ink/navigation/ground"
import * as packet from "ink/navigation/packet"
import * as math from "ink/math"
const source = Maybe.unwrap_or ground.closed (ground.make
  #[#ground.Box { left: -3.0, right: -1.0, front: 1.0, back: 4.0 }]
  #[#ground.Round { x: 2.0, z: -1.0, radius: 1.5 }] 12.0)
entry const encoded = fn () => packet.encode source
entry const accepted = fn (values: Array F32) => if Maybe.is_some (packet.decode values) then 1 else 0
entry const geometry = fn () => do:
  let #Some copy = packet.decode (packet.encode source) else:
    return 0
  for ix in 0 .. 25:
    for iz in 0 .. 25:
      let x = U32.to_f32 ix - 12.0
      let z = U32.to_f32 iz - 12.0
      if ground.clear source x z != ground.clear copy x z:
        return 0
      let at = math.vec3 x 0.0 z
      let target = math.vec3 (x + 3.0) 0.0 (z - 2.0)
      if ground.line_clear source at target != ground.line_clear copy at target:
        return 0
      let a = ground.step source x z 0.4 target 0.2 0.1
      let b = ground.step copy x z 0.4 target 0.2 0.1
      case a, b of
        #Some a, #Some b => do:
          if a.x != b.x || a.z != b.z || a.yaw != b.yaw || a.moved != b.moved:
            return 0
        #Nothing, #Nothing => ()
        _, _ => do:
          return 0
  copy.rounds[0].radius := 7.0
  if source.rounds[0].radius != 1.5:
    return 0
  return 1

entry const test_packet_geometry_and_malformed_input = fn () => do:
  let values = encoded ()
  let checks = #[check.words #[1] #[geometry ()],check.words #[1] #[accepted values]]
  for end in 0 .. values.length:
    checks := array.push (check.words #[0] #[accepted (array.slice 0 end values)]) self
  checks := array.push (check.words #[0] #[accepted (array.push 0.0 values)]) self
  for (index,value) in #[(0,2.0),(1,-1.0),(1,10000000.0),(2,0.5),(3,1025.0),(4,3.0),(10,-1.0)]:
    let bad = values
    bad[index] := value
    checks := array.push (check.words #[0] #[accepted bad]) self
  for index in 0 .. values.length:
    for value in #[0.0 / 0.0,1.0 / 0.0,-1.0 / 0.0]:
      let bad = values
      bad[index] := value
      checks := array.push (check.words #[0] #[accepted bad]) self
  return check.report checks
