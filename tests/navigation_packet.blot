import * as array from "std/array"
import * as check from "./check"
import * as ground from "ink/navigation/ground"
import * as packet from "ink/navigation/packet"
import * as math from "ink/math"
const boxes: #[ground.Box] = #[$ground.Box {left: -3.0, right: -1.0, front: 1.0, back: 4.0}]
const rounds: #[ground.Round] = #[$ground.Round {x: 2.0, z: -1.0, radius: 1.5}]
func with_source run =>
  let box_rows: #[ground.Box] = #[]
  let round_rows: #[ground.Round] = #[]
  let words: #[U32] = #[]
  let shapes: #[F32] = #[]
  let storage = $ground.Storage {boxes: box_rows, rounds: round_rows, words, shapes}
  let (maybe_stored, storage) = ground.make_into storage (&boxes[0..boxes.length]) (&rounds[0..rounds.length]) 12.0
  let $Some stored = maybe_stored else:
    return panic "invalid fixture navigation ground"
  return run (ground.read storage stored)
entry func encoded () => with_source (func source => packet.encode source)
entry func accepted (values: #[F32]) =>
  let boxes: #[ground.Box] = #[]
  let rounds: #[ground.Round] = #[]
  let words: #[U32] = #[]
  let shapes: #[F32] = #[]
  let storage = $ground.Storage {boxes, rounds, words, shapes}
  let (decoded, _) = packet.decode_into storage values
  return if Maybe.is_some decoded then 1 else 0
entry func geometry () => with_source (func source =>
  let copy_boxes: #[ground.Box] = #[]
  let copy_rounds: #[ground.Round] = #[]
  let copy_words: #[U32] = #[]
  let copy_shapes: #[F32] = #[]
  let storage = $ground.Storage {boxes: copy_boxes, rounds: copy_rounds, words: copy_words, shapes: copy_shapes}
  let (maybe_stored, storage) = packet.decode_into storage (packet.encode source)
  let $Some stored = maybe_stored else:
    return 0
  let copy = ground.read storage stored
  for ix in 0 .. 25:
    for iz in 0 .. 25:
      let x = U32.to_f32 ix - 12.0
      let z = U32.to_f32 iz - 12.0
      if ground.clear source x z != ground.clear copy x z:
        return 0
      let at = math.vec3 x 0.0 z
      let target = math.vec3 (x + 3.0) 0.0 (z - 2.0)
      if ground.line_clear source at target != ground.line_clear copy at target:
        return 0
      let a = ground.step source x z 0.4 target 0.2 0.1
      let b = ground.step copy x z 0.4 target 0.2 0.1
      case a, b of
        $Some a, $Some b => do:
          if a.x != b.x or a.z != b.z or a.yaw != b.yaw or a.moved != b.moved:
            return 0
        $Nothing, $Nothing => ()
        _, _ => do:
          return 0
  storage.rounds[stored.rounds.start].radius := 7.0
  if source.rounds[0].radius != 1.5:
    return 0
  return 1)

entry func test_packet_geometry_and_malformed_input () =>
  let values = encoded ()
  let checks: #[check.Check] = #[check.words #[1] #[geometry ()],check.words #[1] #[accepted values]]
  for end in 0 .. values.length:
    @storage.push checks (check.words #[0] #[accepted (array.slice 0 end values)])
  @storage.push checks (check.words #[0] #[accepted (array.push 0.0 values)])
  for (index,value) in #[(0,2.0),(1,-1.0),(1,10000000.0),(2,0.5),(3,1025.0),(4,3.0),(10,-1.0)]:
    let bad = copy values
    bad[index] := value
    @storage.push checks (check.words #[0] #[accepted bad])
  for index in 0 .. values.length:
    for value in #[0.0 / 0.0,1.0 / 0.0,-1.0 / 0.0]:
      let bad = copy values
      bad[index] := value
      @storage.push checks (check.words #[0] #[accepted bad])
  return check.report checks
