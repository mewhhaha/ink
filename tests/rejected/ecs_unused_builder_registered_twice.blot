// rejects: component type already registered
// A builder that registers a component type twice does not compile even when
// nothing builds a world from it: a constant a test reaches is checked
// (ecs_test.ts). This module must not compile, and the compiler's diagnostics
// must contain the text after `rejects:`.
import * as ecs from "ink/ecs"
type Position is data = #Position U32
const invalid = do:
  let builder = ecs.new ()
  builder := ecs.register_component (#Position 1) self
  builder := ecs.register_component (#Position 2) self
  return ecs.build builder
entry const probe = fn () => do:
  let kept = invalid
  return 0
