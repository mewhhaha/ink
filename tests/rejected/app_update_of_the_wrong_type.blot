// rejects: type_mismatch
// Fixed updates promise Unit; returning seconds violates that contract.
import * as app from "ink/app"
import * as clock from "ink/clock"
const update = func access -> (seconds: F32) : Unit => return seconds
const stages = app.stages app.no_action app.no_action app.no_action app.no_action app.route_event app.no_event app.no_event update app.no_render app.no_action
entry const invalid_update = func () => return do:
  let control = app.control ()
  let wall = app.wall ()
  let current = #[clock.clock]
  let policy = $clock.Policy {step_seconds: 1.0 / 60.0, max_elapsed: 1.0, max_steps: 2}
  app.advance stages {} policy current control wall (1.0 / 60.0) #[] 960.0 640.0
  return ()
