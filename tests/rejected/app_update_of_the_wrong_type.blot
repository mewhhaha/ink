// rejects: type_mismatch
// A fixed update system must take the seconds and run in the world; one that
// returns them instead does not compile (app_test.ts). This module must not
// compile, and the compiler's diagnostics must contain the text after
// `rejects:`.
import * as clock from "ink/clock"
import * as app from "ink/app"
import * as input from "ink/input"
const invalid = do:
  let application = app.new $clock.Policy { step_seconds: 0.016666667, max_elapsed: 0.25, max_steps: 5 }
  application := app.add_plugin input.plugin self
  application := app.add_system $app.Update (func (seconds: F32) => return seconds) self
  break app.build application
entry const invalid_update = func () => return do:
  let world = app.advance invalid (app.create_world invalid ()) (1.0 / 60.0) #[] 960.0 640.0
  return ()
