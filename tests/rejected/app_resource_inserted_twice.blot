// (app_test.ts). This module must not compile, and the compiler's diagnostics
// must contain the text after `rejects:`.
import * as clock from "ink/clock"
import * as app from "ink/app"
import * as input from "ink/input"
const invalid = do:
  let application = app.new #clock.Policy { step_seconds: 0.016666667, max_elapsed: 0.25, max_steps: 5 }
  application := app.insert_resource input.codec input.empty self
  application := app.insert_resource input.codec input.empty self
  break application
entry const probe = fn () => do:
  let kept = invalid
  return 0
