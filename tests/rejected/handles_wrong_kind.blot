// rejects: type_mismatch
// A Building handle cannot address a Pile store, regardless of physical indices.
import * as h from "ink/handles"
type Building is data = $Building
type Pile is data = $Pile
#entry func invalid () =>
  let buildings: h.Store [Building, U32] = h.empty $Building 1 1 4
  let (found, buildings) = h.insert $Building 42 buildings
  let $Some target = found else:
    return $Nothing
  let piles: h.Store [Pile, U32] = h.empty $Pile 2 1 4
  return h.get target piles
