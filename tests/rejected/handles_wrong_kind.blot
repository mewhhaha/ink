// rejects: type_mismatch
// A Building handle cannot address a Pile store, regardless of physical indices.
import * as h from "ink/handles"
type Building is data = $Building
type Pile is data = $Pile
entry func invalid () => return do:
  let building_values: ResizeArray U32 = #[]
  let buildings = h.store $Building building_values
  let building_owners: ResizeArray U32 = #[]
  let building_slots: ResizeArray h.Slot = #[]
  let building_free: ResizeArray U32 = #[]
  let building_meta = h.metadata 1 1 4
  let $Some target = h.insert $Building 42 buildings building_owners building_slots building_free building_meta else:
    return $Nothing
  let pile_values: ResizeArray U32 = #[]
  let piles = h.store $Pile pile_values
  let pile_slots: ResizeArray h.Slot = #[]
  let pile_meta = h.metadata 2 1 4
  return h.get target piles pile_slots pile_meta
