// rejects: effect_mismatch
// Cache computation is pure even when its callback is known at compilation.
import * as d from "ink/derived"
func invalid (read: Unit -> U32 ! { Foreign }) =>
  let retained: #[d.Dependency] = #[]
  return d.evaluate (d.clock 1 1) #[] read (d.cache 1) retained
io probe () : U32 => 0
