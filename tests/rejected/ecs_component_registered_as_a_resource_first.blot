// rejects: component type already registered
// A type inserted as a resource, then registered as a component does not compile (packages/ecs.blot checks a builder's
// registrations as it compiles; ecs_test.ts). This module must not compile,
// and the compiler's diagnostics must contain the text after `rejects:`.
import * as ecs from "ink/ecs"
type Position is data = #Position U32
const invalid = do:
  let builder = ecs.new ()
  builder := ecs.insert_resource (#Position 1) self
  builder := ecs.register_component (#Position 2) self
  return ecs.build builder
entry const run = fn () => do:
  let (_, result) = ecs.create invalid (fn () => 42)
  return result
