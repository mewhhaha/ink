import * as array from "std/array"
import * as test from "std/test"
import * as bits from "./support/bits"
import * as field from "ink/field"
import * as derived from "ink/derived/keyed"
import * as history from "ink/history"
import * as statistics from "ink/statistics"
import * as anchor from "ink/ui/anchor"
import * as outline from "ink/ui/outline"
import * as console from "ink/ui/console"
import * as locale from "ink/locale"
import * as ui from "ink/ui"
import * as math from "ink/math"

@[test.suite]
test "field regions cross tiles clip and preserve snapshots":
  let grid = field.grid 17 11 4 3
  let mask = field.affected grid #[{left:3,top:2,right:5,bottom:4}, {left:16,top:10,right:99,bottom:99}]
  let old = array.fill (field.count grid) derived.initial
  let (rev, next) = field.revise mask derived.initial (copy old)
  let (_, restored) = field.revise mask rev (copy next)
  let valid = true
  for y in 0 .. 4:
    for x in 0 .. 5:
      let expected = (x < 2 and y < 2) or (x == 4 and y == 3)
      valid := self and (if expected then mask[y*5+x] else not mask[y*5+x])
  let old_init = array.all (derived.same_revision derived.initial) old
  let c1 = not (field.unchanged grid {left:0,top:0,right:4,bottom:3} old next)
  let c2 = field.unchanged grid {left:8,top:0,right:12,bottom:3} old next
  let c3 = field.unchanged grid {left:99,top:0,right:100,bottom:1} old next
  let c4 = field.unchanged grid {left:8,top:8,right:2,bottom:2} old next
  let c5 = not (derived.same_revision next[0] restored[0])
  use test.holds "mask" valid
  use test.holds "old unchanged" old_init
  use test.holds "dirty region" c1
  use test.holds "clean region" c2
  use test.holds "out of bounds region" c3
  use test.holds "inverted region" c4
  use test.holds "restored revision" c5
  return ()

@[test.suite]
test "field dirty rows compare implicit zero and edge tiles":
  let grid = field.grid 17 11 4 3
  let values = array.generate (11 * 17) (func i => if i == 10 * 17 + 16 then 1.0 else 0.0)
  let rows = array.fill 11 false
  let ignored = field.changed_rows grid rows #[] values
  rows[10] := true
  let changed = field.changed_rows grid rows #[] values
  let c1 = array.all (func x => not x) ignored
  let c2 = array.all (func x => not x) (array.slice 0 19 changed)
  let c3 = changed[19]
  let c4 = array.all (func x => not x) (field.changed_rows grid rows values values)
  use test.holds "ignored" c1
  use test.holds "leading clean" c2
  use test.holds "edge dirty" c3
  use test.holds "equal values clean" c4
  return ()

#entry func history_values (steps: U32) : #[F32] =>
  let capacity = steps % 17
  let buffer: history.Buffer U32 = history.empty ()
  let meta = history.metadata capacity
  let old: history.Buffer U32 = history.empty ()
  let old_meta = history.metadata capacity
  for i in 0 .. steps:
    let (pushed, pushed_meta) = history.push i buffer meta
    buffer := pushed
    meta := pushed_meta
    if i == steps / 2:
      @storage.truncate old 0
      for value in buffer:
        @storage.push old value
      for slot in 0 .. meta.length:
        old_meta[slot] := meta[slot]
  return array.concat #[from meta[2], from old_meta[2]] (array.concat
    (array.map from (history.values buffer meta)) (array.map from (history.values old old_meta)))

@[test.suite]
test "history expiry keeps cutoff wraps and retains old buffers":
  let buffer: history.Buffer (history.Sample U32) = history.empty ()
  let meta = history.metadata 3
  for i in 0 .. 8:
    let (sampled, sampled_meta) = history.sample (from i) (0xFFFFFFFF - i) buffer meta
    buffer := sampled
    meta := sampled_meta
  let kept: history.Buffer (history.Sample U32) = copy buffer
  let kept_meta = copy meta
  let meta = history.expire 6.0 buffer meta
  let (buffer, meta) = history.sample 8.0 44 buffer meta
  let first = history.get buffer meta 0
  let old = history.get kept kept_meta 0
  let third = (history.get buffer meta 2).value
  let shifted: history.Buffer (history.Sample U32) = copy buffer
  let shifted_meta = copy meta
  let shifted = history.shift (-8.0) shifted shifted_meta
  let shift_valid = (history.get shifted shifted_meta 0).at == -2.0 and (history.get buffer meta 0).at == 6.0
  let meta = history.expire 9.0 buffer meta
  let m2 = meta[2]
  use test.holds "first cutoff" (first.at == 6.0 and first.value == 0xFFFFFFFF - 6)
  use test.holds "old buffer kept" (old.at == 5.0 and old.value == 0xFFFFFFFF - 5)
  use test.eq "third value" 44 third
  use test.holds "shift valid" shift_valid
  use test.eq "expired empty" 0 m2
  return ()

@[test.suite]
test "history partial drop then append keeps order":
  let buffer: history.Buffer U32 = history.empty ()
  let meta = history.metadata 7
  for i in 0 .. 5:
    let (pushed, pushed_meta) = history.push i buffer meta
    buffer := pushed
    meta := pushed_meta
  meta := history.drop 3 buffer meta
  for i in 5 .. 20:
    let (pushed, pushed_meta) = history.push i buffer meta
    buffer := pushed
    meta := pushed_meta
  let vals = history.values buffer meta
  use test.eq "ordered values" #[13, 14, 15, 16, 17, 18, 19] vals
  return ()

@[test.suite]
test "statistics counter resets and exact rank endpoints":
  let $Some rates = statistics.counter_rates 2.0 #[0xFFFFFF00,5] #[0xFFFFFFFF,9] else:
    use test.fail "counter_rates" "expected Some"
    return ()
  let samples = #[9.0, 1.0, 5.0, 3.0, 7.0, 7.0]
  let qs = #[Maybe.unwrap_or (-1.0) (statistics.quantile p samples) | p <- #[0.0, 0.5, 1.0]]
  let top3 = statistics.largest 3 samples
  let top0 = statistics.largest 0 samples
  let r_dec = statistics.counter_rates 1.0 #[9] #[1]
  let r_zero = statistics.counter_rates 0.0 #[1] #[2]
  let r_len = statistics.counter_rates 1.0 #[1] #[2, 3]
  let q_empty = statistics.quantile 0.5 #[]
  use test.near_array "rates" 0.0 #[127.5, 2.0] rates
  use test.is_nothing "decreasing counter" r_dec
  use test.is_nothing "zero dt" r_zero
  use test.is_nothing "mismatched lengths" r_len
  use test.near_array "quantiles" 0.0 #[1.0, 5.0, 9.0] qs
  use test.near_array "largest 3" 0.0 #[9.0, 7.0, 7.0] top3
  use test.near_array "largest 0" 0.0 #[] top0
  use test.is_nothing "empty quantile" q_empty
  return ()

@[test.suite]
test "anchor chooses fitting side and handles oversized content":
  let bounds = $ui.Rect {x:10.0,y:20.0,width:100.0,height:80.0}
  let above = anchor.attach $anchor.Above 0.5 5.0 (math.vec2 30.0 20.0) (math.vec2 60.0 25.0)
  let below = anchor.attach $anchor.Below 0.5 5.0 (math.vec2 30.0 20.0) (math.vec2 60.0 25.0)
  let $Some chosen = anchor.place bounds #[above,below] else:
    use test.fail "place" "expected Some"
    return ()
  let huge = anchor.fit bounds ($ui.Rect {x:90.0,y:90.0,width:200.0,height:300.0})
  let empty_place = anchor.place bounds #[]
  use test.near_array "chosen" 0.0 #[45.0, 30.0, 30.0, 20.0] #[chosen.x, chosen.y, chosen.width, chosen.height]
  use test.near_array "huge" 0.0 #[10.0, 20.0, 200.0, 300.0] #[huge.x, huge.y, huge.width, huge.height]
  use test.is_nothing "empty place" empty_place
  return ()

@[test.suite]
test "outline distance point roundtrips and degenerate geometry":
  let valid = true
  for radius in #[0.0, 1.0, 15.0, 100.0]:
    let shape = outline.rounded ($ui.Rect {x:7.0,y:11.0,width:80.0,height:30.0}) radius
    let length = outline.length shape
    for i in 0 .. 129:
      let distance = length * U32.to_f32 i / 128.0
      let point = outline.point shape distance
      let returned = outline.distance shape point
      let delta = abs (wrap length returned - wrap length distance)
      valid := self and min delta (length - delta) < 0.005
      let repeated = outline.point shape (distance - length * 2.0)
      valid := self and abs (point.x - repeated.x) < 0.005 and abs (point.y - repeated.y) < 0.005
  let dot = outline.point (outline.rounded ($ui.Rect {x:4.0,y:8.0,width:0.0,height:0.0}) 10.0) 99.0
  use test.holds "roundtrip valid" valid
  use test.near_array "degenerate dot" 0.0 #[4.0, 8.0] #[dot.x, dot.y]
  return ()

@[test.suite]
test "console completion is catalog driven and restores drafts":
  let b_name = #[98]
  let b_about = #[2]
  let a_name = #[97]
  let a_about = #[1]
  let option_text = #[0x3B1, 98]
  let option_about = #[3]
  let c_name = #[99]
  let blank: #[U32] = #[]
  let none: #[console.Choice] = #[]
  let options = #[$console.Choice {value: &option_text[0..2], about: &option_about[0..1]}]
  let catalog = #[$console.Entry {name: &b_name[0..1], about: &b_about[0..1], argument: false, options: &none[0..0]},
    $console.Entry {name: &a_name[0..1], about: &a_about[0..1], argument: true, options: &options[0..1]},
    $console.Entry {name: &c_name[0..1], about: &blank[0..0], argument: true, options: &none[0..0]}]
  let entries = console.sorted (&catalog[0..catalog.length])
  let payload: #[U32] = #[]
  let named: #[console.Suggestion] = #[]
  let valued: #[console.Suggestion] = #[]
  let freeform: #[console.Suggestion] = #[]
  let (payload, named) = console.named #[58] #[32] (&entries[0..entries.length]) #[97] payload named
  let (payload, valued) = console.valued #[58] #[32] (&entries[0..entries.length]) #[97] #[0x3B1] payload valued
  let (payload, freeform) = console.named #[] #[32] (&entries[0..entries.length]) #[99] payload freeform
  let lines: #[console.Span] = #[]
  let history_payload: #[U32] = #[]
  let browse = #[console.fresh]
  let (lines, history_payload) = console.remember 2 3 #[1] lines history_payload
  let (lines, history_payload) = console.remember 2 3 #[2] lines history_payload
  let (lines, history_payload) = console.remember 2 3 #[3, 4, 5, 6] lines history_payload
  let (newest_span, history_payload, browse) = console.recall true #[9, 8] lines history_payload browse
  let newest = array.map U32.to_f32 (console.range history_payload newest_span)
  let (draft_span, history_payload, browse) = console.recall false #[3, 4, 5] lines history_payload browse
  let draft = array.map U32.to_f32 (console.range history_payload draft_span)
  let forward = browse[0].place
  let (lines, history_payload, browse) = console.compact lines history_payload browse
  let remembered = console.range history_payload lines[lines.length - 1]
  let newest_kept = bits.near_equal 0.0 #[3.0, 4.0, 5.0] (array.map U32.to_f32 remembered)
  let (lines, history_payload) = console.remember 0 4 #[1] lines history_payload
  let named_text = array.map U32.to_f32 (console.range payload named[0].text)
  let valued_text = array.map U32.to_f32 (console.range payload valued[0].text)
  let freeform_ok = not freeform[0].ready and (console.range payload freeform[0].text)[1] == 32
  let named_ready_ok = not named[0].ready and valued[0].ready
  let tail_ok = forward == 0 and newest_kept and lines.length == 0
  use test.near_array "named text" 0.0 #[58.0, 97.0, 32.0] named_text
  use test.holds "named/valued ready" named_ready_ok
  use test.holds "freeform" freeform_ok
  use test.near_array "valued text" 0.0 #[58.0, 97.0, 32.0, 945.0, 98.0] valued_text
  use test.near_array "newest" 0.0 #[3.0, 4.0, 5.0] newest
  use test.near_array "draft" 0.0 #[9.0, 8.0] draft
  use test.holds "compacted and cleared" tail_ok
  return ()

@[test.suite]
test "locale stale replies fallback growth and old snapshots":
  let cache = locale.empty ()
  let payload: #[U32] = #[]
  let direction = #[false]
  let pending = locale.empty ()
  let pending_payload: #[U32] = #[]
  let pending_direction = #[false]
  let cache = locale.grow 2 cache
  let cache = locale.begin 1 0xFFFFFFFF cache
  let (pending, pending_payload, pending_direction) = locale.copy_into pending pending_payload pending_direction cache payload direction
  let cache = locale.begin 1 22 cache
  let wrong_drawn = #[3]
  let wrong_spoken = #[4]
  let fallback = #[9]
  let drawn = #[0xFE8E]
  let spoken = #[0x627]
  let (cache, payload, direction) = locale.resolve 1 0xFFFFFFFF ($Some $locale.Text {drawn: wrong_drawn, spoken: wrong_spoken}) true cache payload direction
  let stale = array.map identity (locale.word cache payload 1 (&fallback[0..1]))
  let (cache, payload, direction) = locale.resolve 1 22 ($Some $locale.Text {drawn, spoken}) true cache payload direction
  let cache = locale.grow 4 cache
  let cache = locale.begin 1 23 cache
  let (cache, payload, direction) = locale.resolve 1 23 $Nothing false cache payload direction
  let got_word = array.map identity (locale.word cache payload 1 (&fallback[0..1]))
  let got_spoken = array.map identity (locale.spoken cache payload 1 (&fallback[0..1]))
  let missing_spoken = array.map identity (locale.spoken cache payload 99 (&fallback[0..1]))
  let pending_ok = pending[1].request == 0xFFFFFFFF and pending[1].drawn_count == 0
  let cache_ok = cache.length == 4 and cache[1].request == 0 and direction[0]
  use test.eq "stale fallback" #[9] stale
  use test.eq "resolved word" #[65166] got_word
  use test.eq "resolved spoken" #[1575] got_spoken
  use test.holds "pending snapshot" pending_ok
  use test.holds "grown cache" cache_ok
  use test.eq "missing fallback" #[9] missing_spoken
  return ()

#entry func trigger_history_backwards (n: U32) =>
  let buffer: history.Buffer (history.Sample U32) = history.empty ()
  let meta = history.metadata 4
  let (buffer, meta) = history.sample 2.0 n buffer meta
  let (buffer, meta) = history.sample 1.0 n buffer meta
  return meta[2]
#entry func trigger_field_dimensions (n: U32) => field.count (field.grid n 4 0 2)
#entry func trigger_locale_request (n: U32) =>
  let cache = locale.empty ()
  let cache = locale.grow 2 cache
  let cache = locale.begin n 0 cache
  return cache.length

test expect_trap "history rejects backwards timestamps":
  let _ = trigger_history_backwards 1
  return ()
test expect_trap "field rejects zero tile size":
  let _ = trigger_field_dimensions 1
  return ()
test expect_trap "locale rejects zero request id":
  let _ = trigger_locale_request 1
  return ()
