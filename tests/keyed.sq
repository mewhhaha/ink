import * as array from "std/array"
import * as test from "std/test"
import * as derived from "ink/derived/keyed"
io rebuilding () : #[U32] =>
  let cold: derived.Cache [#[U32], U32] = $derived.Cold
  let (warm, value) = derived.resolve derived.same_u32 (func key => key[0] * 2) #[4, 1] cold
  let (_, same) = derived.resolve derived.same_u32 (func key => 99) #[4, 1] warm
  let (_, changed) = derived.resolve derived.same_u32 (func key => key[0] * 3) #[4, 2] warm
  let (_, restored) = derived.resolve derived.same_u32 (func key => key[0] * 2) #[4, 1] cold
  let rolled = derived.bump ($derived.Revision { epoch: 3, change: 0xFFFFFFFF })
  return #[value, same, changed, restored, rolled.epoch, rolled.change]

@[test.suite]
test "complete keys and restore":
  use test.eq "check 1" #[8, 8, 12, 8, 4, 0] (rebuilding ())
  return ()
