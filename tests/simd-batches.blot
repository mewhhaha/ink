import * as check from "./check"
import * as array from "std/array"
import * as simd from "std/simd"
import * as field from "ink/field"
import * as codec from "ink/codec"
import * as reference from "./perf/simd_reference"
import * as springs from "ink/motion/springs"
import * as motion from "ink/motion"
import * as bounds from "ink/render/bounds"
import * as render from "ink/render"
import * as lod from "ink/render/lod"
import * as math from "ink/math"
import * as partition from "ink/partition"
import * as schedule from "ink/schedule"
import * as graph from "ink/graph"

func masks values => return array.map (func value => return if value then 1 else 0) values
entry func test_field_simd_edges_and_dirty_contract () => return do:
  let valid = true
  let (nan, inf, negzero, _) = simd.f32_from_bits (0x7FC00000, 0x7F800000, 0x80000000, 0)
  for width in #[1, 3, 4, 5, 7, 16, 17, 65]:
    for tile in #[1, 3, 4, 7, 16, 99]:
      let grid = field.grid width 9 tile 3
      let before = array.generate (7 * width) (func i => return U32.to_f32 (i % width + i / width))
      for mode in 0 .. 6:
        let after = @storage.copy before
        if mode == 1:
          after[width - 1] := -1.0
        if mode == 2:
          after := array.concat self (array.fill width 0.0)
        if mode == 3:
          after[3 * width] := nan
        if mode == 4:
          before[5 * width - 1] := inf
          after[5 * width - 1] := inf
        if mode == 5:
          after[0] := negzero
        for odd in #[false, true]:
          let dirty = array.generate 9 (func i => return Bool.not odd or i % 2 == 1)
          let a = masks (reference.changed_rows grid dirty before after)
          let b = masks (field.changed_rows grid dirty before after)
          valid := self and (check.words a b).passed
  return check.report #[check.holds valid]

entry func test_pack_simd_padding_tails_and_full_words () => return do:
  let valid = true
  for count in #[0, 1, 3, 4, 5, 63, 64, 65, 257]:
    let words = array.generate count (func i => return (i * 2654435761) ^ 0xFFFFFFFF)
    for extra in #[0, 1, 7]:
      let capacity = count + extra
      let actual = codec.pack capacity words
      valid := self and (check.bits (reference.pack capacity words) actual).passed
      valid := self and (check.words words (Maybe.unwrap_or #[] (codec.unpack capacity actual))).passed
  return check.report #[check.holds valid]

entry func test_spring_preparation_matches_all_scalar_regimes () => return do:
  let valid = true
  for count in #[0, 1, 3, 4, 5, 67]:
    let values = array.generate count (func i => return if i == 0 then -0.0 else U32.to_f32 (i % 17) - 8.0)
    let speeds = array.generate count (func i => return U32.to_f32 (i % 13) * 0.125 - 0.75)
    let targets = array.generate count (func i => return U32.to_f32 (i % 7) - 3.0)
    for frequency in #[0.0, 0.01, 8.0, 64.0]:
      for damping in #[0.0, 0.4, 0.99998, 0.999999, 1.0, 1.000001, 1.00002, 2.5]:
        for dt in #[0.0, 0.0001, 0.016, 0.5]:
          let $Some prepared = springs.prepare frequency damping dt else:
            return check.report #[check.holds false]
          let (p, v) = springs.columns_into prepared values speeds targets (array.fill count 0.0) (array.fill count 0.0)
          for i in 0 .. count:
            let initial = $motion.Spring {value: values[i], velocity: speeds[i]}
            let expected = motion.spring initial targets[i] frequency damping dt
            let actual = springs.step prepared initial targets[i]
            valid := self and (check.bits #[expected.value, expected.velocity] #[p[i], v[i]]).passed
            valid := self and (check.bits #[expected.value, expected.velocity] #[actual.value, actual.velocity]).passed
  let (nan, inf, _, _) = simd.f32_from_bits (0x7FC00000, 0x7F800000, 0, 0)
  return check.report #[check.holds valid,
    check.holds (Bool.not (Maybe.is_some (springs.prepare nan 1.0 0.1))),
    check.holds (Bool.not (Maybe.is_some (springs.prepare 1.0 inf 0.1))),
    check.holds (Bool.not (Maybe.is_some (springs.prepare 1.0 1.0 nan))),
    check.holds (Bool.not (Maybe.is_some (springs.prepare 1.0 3.0e38 0.01))),
    check.holds (Bool.not (Maybe.is_some (springs.prepare (-1.0) 1.0 0.1))),
    check.holds (Bool.not (Maybe.is_some (springs.prepare 1.0 (-1.0) 0.1))),
    check.holds (Bool.not (Maybe.is_some (springs.prepare 10000.0 1.0 1.0)))]

const camera = $render.Sight { view: math.Mat4.identity, fx: 1.2, fy: 1.4,
  horizontal: sqrt (1.2 * 1.2 + 1.0), vertical: sqrt (1.4 * 1.4 + 1.0), near: 0.1, far: 100.0 }
entry func test_sphere_columns_match_scalar_planes_and_projection () => return do:
  let valid = true
  for count in #[0, 1, 3, 4, 5, 129]:
    let x = array.generate count (func i => return U32.to_f32 (i % 9) - 4.0)
    let y = array.generate count (func i => return U32.to_f32 (i % 11) - 5.0)
    let z = array.generate count (func i => return 3.0 - U32.to_f32 i)
    let radius = array.generate count (func i => return U32.to_f32 (i % 3) * 0.5)
    let $Some spheres = bounds.spheres x y z radius else:
      return check.report #[check.holds false]
    for rotated in #[false, true]:
      let camera = camera
      if rotated:
        camera.view := math.Mat4.from_columns (math.vec4 0.6 0.0 (-0.8) 0.0) (math.vec4 0.0 1.0 0.0 0.0) (math.vec4 0.8 0.0 0.6 0.0) (math.vec4 3.0 (-2.0) 4.0 1.0)
      for height in #[0.0, 1080.0]:
        let classified_visible = array.fill count 0
        let classified_pixels = array.fill count 0.0
        let (classified_visible, classified_pixels) = bounds.classify_into camera height spheres classified_visible classified_pixels
        for i in 0 .. count:
          let visible = if render.sees camera (math.vec3 x[i] y[i] z[i]) radius[i] then 1 else 0
          let depth = -(camera.view.x.z * x[i] + camera.view.y.z * y[i] + camera.view.z.z * z[i] + camera.view.w.z)
          let pixels = lod.projected height camera.fy camera.near depth (2.0 * radius[i]) radius[i]
          valid := self and classified_visible[i] == visible and (check.bits #[pixels] #[classified_pixels[i]]).passed
  let $Some ties = bounds.spheres #[0.0, 0.0, 10.0, 0.0] #[0.0, 0.0, 0.0, 10.0] #[-0.1, -100.0, -12.0, -14.0] #[0.0, 0.0, 0.0, 0.0] else:
    return check.report #[check.holds false]
  let tie_visible = array.fill 4 0
  let tie_pixels = array.fill 4 0.0
  let (tie_visible, tie_pixels) = bounds.classify_into camera 1080.0 ties tie_visible tie_pixels
  return check.report #[check.holds valid, check.words #[1, 1, 1, 1] tie_visible,
    check.holds (Bool.not (Maybe.is_some (bounds.spheres #[0.0] #[] #[] #[]))),
    check.holds (Bool.not (Maybe.is_some (bounds.spheres #[0.0] #[0.0] #[0.0] #[-1.0])))]

entry func test_coarse_partitions_and_wave_dispatch () => return do:
  let valid = true
  for count in #[0, 1, 3, 4, 5, 129, 0xFFFFFFFF]:
    for minimum in #[1, 3, 64, 0xFFFFFFFF]:
      let ranges = partition.ranges count 8 minimum
      let visited = 0
      for range in ranges:
        valid := self and range.start == visited and range.count > 0 and (range.count >= minimum or count < minimum)
        visited := self + range.count
      valid := self and visited == count and ranges.length <= 8
  let dependency_starts = #[0, 0, 0, 2]
  let dependency_targets = #[0, 1]
  let wave_starts = #[0, 2, 3]
  let wave_nodes = #[0, 1, 2]
  let plan = $schedule.Plan {
    dependencies: $graph.Graph {starts: &dependency_starts[0..4], targets: &dependency_targets[0..2]},
    waves: $graph.Waves {starts: &wave_starts[0..3], nodes: &wave_nodes[0..3]}}
  let output = #[0]
  let ran = schedule.execute plan output
    (func state -> wave => return array.map (func i => return state[0] + i + 1) wave)
    (func state -> i -> delta => return do:
      state[0] = state[0] * 10 + delta)
  let bad_starts = #[0, 0, 1]
  let bad_targets = #[0]
  let bad_wave_starts = #[0, 2]
  let bad_wave_nodes = #[0, 1]
  let bad = $schedule.Plan {
    dependencies: $graph.Graph {starts: &bad_starts[0..3], targets: &bad_targets[0..1]},
    waves: $graph.Waves {starts: &bad_wave_starts[0..2], nodes: &bad_wave_nodes[0..2]}}
  let rejected = schedule.execute bad output
    (func state -> wave : Array U32 => return @panic "invalid plan dispatched")
    (func state -> i -> delta => return do:
      state[0] = state[0] + delta)
  return check.report #[check.holds valid, check.holds (ran and output[0] == 135), check.holds (Bool.not rejected)]

func spring_outputs (positions: U32) -> (velocities: U32) => return do:
  let input = #[1.0]
  let output_positions = array.fill positions 0.0
  let output_velocities = array.fill velocities 0.0
  let $Some prepared = springs.prepare 1.0 1.0 0.0 else:
    return @panic "valid spring preparation rejected"
  springs.columns_into prepared input input input output_positions output_velocities
  return #[]
entry func trap_spring_output_positions () : Array F32 => return spring_outputs 0 1
entry func trap_spring_output_velocities () : Array F32 => return spring_outputs 1 0

func sphere_outputs (visible: U32) -> (pixels: U32) => return do:
  let input = #[1.0]
  let output_visible = array.fill visible 0
  let output_pixels = array.fill pixels 0.0
  let $Some spheres = bounds.spheres input input input input else:
    return @panic "valid sphere columns rejected"
  let (output_visible, output_pixels) = bounds.classify_into camera 1080.0 spheres output_visible output_pixels
  return #[]
entry func trap_sphere_output_visible () : Array F32 => return sphere_outputs 0 1
entry func trap_sphere_output_pixels () : Array F32 => return sphere_outputs 1 0
