import * as math from "ink/math"
import * as rterrain from "ink/render/terrain"
import * as water from "ink/render/water"
import * as foliage from "ink/render/foliage"

entry func terrain_eval (a: #[F32]) : #[F32] =>
  let sw = rterrain.splat_weights a[0] a[1] a[2] a[3] a[4] a[5] a[6] a[7] a[8]
  let tw = rterrain.triplanar_weights (math.vec3 a[9] a[10] a[11]) a[12]
  let mf = rterrain.morph_factor a[13] a[14] a[15]
  return #[sw.x, sw.y, sw.z, sw.w, tw.x, tw.y, tw.z, mf]

entry func water_eval (a: #[F32]) : #[F32] =>
  let waves = #[
    $water.Wave { dir_x: a[0], dir_z: a[1], amplitude: a[2], wavelength: a[3], steepness: a[4], speed: a[5] },
    $water.Wave { dir_x: a[6], dir_z: a[7], amplitude: a[8], wavelength: a[9], steepness: a[10], speed: a[11] },
  ]
  let s = water.sample_gerstner waves a[12] a[13] a[14]
  let tr = water.depth_transmittance a[15] (math.vec3 a[16] a[17] a[18])
  let fr = water.fresnel a[19] a[20]
  return #[s.position.x, s.position.y, s.position.z, s.normal.x, s.normal.y, s.normal.z, s.foam, tr.x, tr.y, tr.z, fr]

entry func foliage_eval (a: #[F32]) : #[F32] =>
  let w = $foliage.Wind {
    dir_x: a[0],
    dir_z: a[1],
    strength: a[2],
    gust_freq: a[3],
    gust_speed: a[4],
    turbulence: a[5],
  }
  let disp = foliage.bend_displacement w (math.vec3 a[6] a[7] a[8]) a[9] a[10] a[11]
  let d = math.vec3 a[12] a[13] a[14]
  let uv_full = foliage.oct_encode d false
  let rt_full = foliage.oct_decode uv_full false
  let uv_hemi = foliage.oct_encode (math.vec3 a[12] (abs a[13]) a[14]) true
  let rt_hemi = foliage.oct_decode uv_hemi true
  return #[disp.x, disp.y, disp.z, rt_full.x, rt_full.y, rt_full.z, rt_hemi.x, rt_hemi.y, rt_hemi.z]
