import * as check from "./check"
import * as recipe from "ink/ecs/recipe"
import * as array from "std/array"
const words = func view : Array U32 => return array.generate view.length (func i => return view.at i)
entry const test_dependency_order_overrides_and_unrelated_cycle = func () => return do:
  let requirements = #[20, 10, 99]
  let definitions = #[$recipe.Requirement {key: 30, requires: recipe.span 0 1},
    $recipe.Requirement {key: 10, requires: recipe.span 0 0},
    $recipe.Requirement {key: 20, requires: recipe.span 1 1},
    $recipe.Requirement {key: 99, requires: recipe.span 2 1}]
  let ordered: ResizeArray U32 = #[]
  let $recipe.Ok plan = recipe.plan definitions requirements #[30] ordered else:
    return check.report #[check.words #[1] #[0]]
  let installed = array.fill 100 false
  let calls: ResizeArray U32 = #[]
  recipe.apply plan (func () => return do:
    installed[20] := true
    @storage.push calls 20)
    (func key => return installed[key])
    (func key => return do:
      installed[key] := true
      @storage.push calls key)
  let rejected_order: ResizeArray U32 = #[]
  let cycle = case recipe.plan definitions requirements #[99] rejected_order of
    $recipe.Err $recipe.Cycle => 1
    _ => 0
  return check.report #[check.words #[10, 20, 30] (words plan.keys),
    check.words #[20, 10, 30] (@storage.freeze (@storage.copy calls)), check.words #[1] #[cycle]]
entry const test_missing_duplicate_and_invalid_span = func () => return do:
  let out: ResizeArray U32 = #[]
  let empty: Array U32 = #[]
  let duplicate = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 0}, $recipe.Requirement {key: 1, requires: recipe.span 0 0}] empty #[1] out of
    $recipe.Err ($recipe.Duplicate 1) => 1
    _ => 0
  let missing = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 1}] #[2] #[1] out of
    $recipe.Err ($recipe.Missing 2) => 1
    _ => 0
  let span = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 1}] empty #[1] out of
    $recipe.Err ($recipe.InvalidSpan 1) => 1
    _ => 0
  return check.report #[check.words #[1, 1, 1] #[duplicate, missing, span]]
