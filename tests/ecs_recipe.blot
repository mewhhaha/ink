import * as test from "std/test"
import * as recipe from "ink/ecs/recipe"
import * as array from "std/array"
func words view : #[U32] => array.generate view.length (func i => view.at i)
@[test.suite]
test "dependency order overrides and unrelated cycle":
  let requirements = #[20, 10, 99]
  let definitions = #[$recipe.Requirement {key: 30, requires: recipe.span 0 1},
    $recipe.Requirement {key: 10, requires: recipe.span 0 0},
    $recipe.Requirement {key: 20, requires: recipe.span 1 1},
    $recipe.Requirement {key: 99, requires: recipe.span 2 1}]
  let ordered: #[U32] = #[]
  let $recipe.Ok plan = recipe.plan definitions requirements #[30] ordered else:
    use test.eq "check 1" #[1] #[0]
    return ()
  let calls: #[U32] = #[]
  calls := recipe.apply_on plan calls
    (func (own calls) =>
      @storage.push calls 20
      return calls)
    (func calls -> key => array.any (func k => k == key) calls)
    (func (own calls) -> key =>
      @storage.push calls key
      return calls)
  let rejected_order: #[U32] = #[]
  let cycle = case recipe.plan definitions requirements #[99] rejected_order of
    $recipe.Err $recipe.Cycle => 1
    _ => 0
  use test.eq "check 1" #[10, 20, 30] (words plan.keys)
  use test.eq "check 2" #[20, 10, 30] calls
  use test.eq "check 3" #[1] #[cycle]
  return ()
@[test.suite]
test "missing duplicate and invalid span":
  let out1: #[U32] = #[]
  let out2: #[U32] = #[]
  let out3: #[U32] = #[]
  let empty: #[U32] = #[]
  let duplicate = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 0}, $recipe.Requirement {key: 1, requires: recipe.span 0 0}] empty #[1] out1 of
    $recipe.Err ($recipe.Duplicate 1) => 1
    _ => 0
  let missing = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 1}] #[2] #[1] out2 of
    $recipe.Err ($recipe.Missing 2) => 1
    _ => 0
  let span = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 1}] empty #[1] out3 of
    $recipe.Err ($recipe.InvalidSpan 1) => 1
    _ => 0
  use test.eq "check 1" #[1, 1, 1] #[duplicate, missing, span]
  return ()
