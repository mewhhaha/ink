// Ink's tree and focus on their own (lib/ui/tree.blot), on a bare
// ECS world: a toolbar of two buttons, and a dialog (modal from the 14th
// frame) of a button and a slider. Each frame routes its events (`route`),
// then declares the nodes and settles.
import * as array from "std/array"
import * as test from "std/test"
import * as keys from "ink/input/keys"
import * as protocol from "ink/ui/vocabulary"
import * as tree from "ink/ui/tree"
import * as ui from "ink/ui"
import * as window from "ink/events"

const id = ui.node_id 9
const words = #[72, 105]
const description = #[33]
const percentage = #[53, 48, 37]
const box = $ui.Rect { x: 10.0, y: 20.0, width: 30.0, height: 40.0 }

// The frame's nodes, as Render systems declare them, then settled.
func render (modal: Bool) -> (held: own tree.Focus) : tree.Focus =>
  let labels: #[U32] = #[]
  let nodes: #[tree.StoredNode] = #[]
  let marked: #[tree.StoredNode] = #[]
  let (labels, nodes) = tree.declare_owned (ui.toolbar_node (id 1) 0 (&words[0..words.length]) ui.nowhere) labels nodes
  let (labels, nodes) = tree.declare_owned (ui.button_node (id 2) (id 1) (&words[0..words.length]) box) labels nodes
  let (labels, nodes) = tree.declare_owned (ui.button_node (id 3) (id 1) (&words[0..words.length]) box) labels nodes
  let (labels, nodes) = tree.declare_owned (ui.dialog_node (id 4) 0 (&words[0..words.length]) modal box) labels nodes
  let (labels, nodes) = tree.declare_owned (ui.button_node (id 5) (id 4) (&words[0..words.length]) box) labels nodes
  let (labels, nodes) = tree.declare_owned (ui.described (&description[0..description.length]) (ui.slider_node (id 6) (id 4) (&words[0..words.length]) 0.5 0.0 1.0 0.1 (&percentage[0..percentage.length]) box)) labels nodes
  let (held, _) = tree.settle (&nodes[0..nodes.length]) held marked
  return held

// What reaches the game for `event`: a UiAction as its node's key, action
// and value, a key as -1 and its code, anything else as nothing.
func routed (event: window.Event) -> (held: own tree.Focus) =>
  let (reached, next_state) = tree.route event held
  held.state[0] := next_state
  let lanes = case reached of
    $window.UiAction { node, action, value } => #[U32.to_f32 (node % 65536), U32.to_f32 action, value]
    $window.KeyDown code => #[-1.0, U32.to_f32 code]
    _ => #[]
  return (lanes, held)

func key (code: U32) => #[$window.KeyDown code, $window.KeyUp code]

// A frame: its events, then its nodes; the focused node's key, the modal
// dialog's, then what the events became.
func frame (modal: Bool) -> (events: #[window.Event]) -> (held: own tree.Focus) =>
  let seen: #[F32] = #[]
  for event in events:
    held := do:
      let (lanes, next_held) = routed event self
      for value in lanes:
        @storage.push seen value
      break next_held
  held := render modal held
  let readings = array.concat #[U32.to_f32 (held.state[0].node % 65536), U32.to_f32 (held.state[0].modal % 65536)] seen
  return (readings, held)

// Each frame's reading; the dialog turns modal at the 14th (index 13).
type Span is data = $Span {start: U32, count: U32}
type Readings is data = $Readings {rows: &[Span], values: &[F32]}
func events_at (index: U32) => case index of
  1 => key keys.tab
  2 => key keys.f10
  3 => key keys.right
  4 => key keys.tab
  5 => key keys.down
  6 => key keys.right
  7 => key keys.enter
  8 => key keys.left
  9 => #[$window.UiAction {node: id 3, action: 0, value: 0.0}]
  10 => #[$window.PointerDown {button: 0, x: 1.0, y: 1.0}]
  11 => key keys.f10
  12 => key keys.escape
  15 => key keys.tab
  16 => key keys.tab
  17 => key keys.escape
  18 => #[$window.UiAction {node: id 3, action: 0, value: 0.0}]
  _ => #[]
func with_readings run =>
  let state = #[tree.unfocused]
  let returns: #[tree.Return] = #[]
  let stops: #[tree.Stop] = #[]
  let order: #[U32] = #[]
  let reached: #[U32] = #[]
  let held = $tree.Focus {state, returns, nodes: stops, order, reached}
  let rows: #[Span] = #[]
  let values: #[F32] = #[]
  for index in 0 .. 20:
    held := do:
      let (reading, next) = frame (index >= 13) (events_at index) self
      let start = values.length
      for value in reading:
        @storage.push values value
      @storage.push rows $Span {start, count: reading.length}
      break next
  return run ($Readings {rows: &rows[0..rows.length], values: &values[0..values.length]})
func frame_at (readings: Readings) -> (index: U32) =>
  let span = readings.rows[index]
  return array.slice span.start span.count readings.values

// What the frame's events reached the game as, after the focus and modal.
func seen (reading: #[F32]) => array.slice 2 (reading.length - 2) reading

// A UiAction on node `node`, as `routed` reads it.
func action (node: F32) => func (code: U32) => #[node, U32.to_f32 code, 0.0]

const focus = protocol.action_focus

@[test.suite]
test "tab is the games while nothing is focused":
  let (f0, f1) = with_readings (func frames => (frame_at frames 0, seen (frame_at frames 1)))
  use test.near_array "frame 0" 0.0 #[0.0, 0.0] f0
  use test.near_array "tab reaches game" 0.0 #[-1.0, U32.to_f32 keys.tab] f1
  return ()

// F10 focuses the first node, Right the next in its toolbar, Tab the next
// focusable at all, and Down the next in the dialog.
@[test.suite]
test "f10 and the arrows and tab move the focus":
  let (s2, s3, s4, s5, f5_0) = with_readings (func frames =>
    (seen (frame_at frames 2), seen (frame_at frames 3), seen (frame_at frames 4), seen (frame_at frames 5), (frame_at frames 5)[0]))
  let exp2 = action 2.0 focus
  let exp3 = action 3.0 focus
  let exp5 = action 5.0 focus
  let exp6 = action 6.0 focus
  use test.near_array "f10 focus" 0.0 exp2 s2
  use test.near_array "right focus" 0.0 exp3 s3
  use test.near_array "tab focus" 0.0 exp5 s4
  use test.near_array "down focus" 0.0 exp6 s5
  use test.near "focused node id" 0.0 6.0 f5_0
  return ()

// On a slider, Right and Enter step it up and Left down.
@[test.suite]
test "keys step a focused slider":
  let (s6, s7, s8) = with_readings (func frames =>
    (seen (frame_at frames 6), seen (frame_at frames 7), seen (frame_at frames 8)))
  let inc = action 6.0 protocol.action_increment
  let dec = action 6.0 protocol.action_decrement
  use test.near_array "right increment" 0.0 inc s6
  use test.near_array "enter increment" 0.0 inc s7
  use test.near_array "left decrement" 0.0 dec s8
  return ()

@[test.suite]
test "assistive technology moves the focus":
  let f9 = with_readings (func frames => frame_at frames 9)
  let exp = array.concat #[3.0, 0.0] (action 3.0 focus)
  use test.near_array "AT focus" 0.0 exp f9
  return ()

// A click takes the focus back to the world, as Escape does after F10.
@[test.suite]
test "a click or escape gives the keys back to the world":
  let (f10_0, f11, f12) = with_readings (func frames =>
    ((frame_at frames 10)[0], frame_at frames 11, frame_at frames 12))
  let exp11 = array.concat #[2.0, 0.0] (action 2.0 focus)
  let exp12 = array.concat #[0.0, 0.0] (action 2.0 protocol.action_blur)
  use test.near "click unfocuses" 0.0 0.0 f10_0
  use test.near_array "f10 refocuses" 0.0 exp11 f11
  use test.near_array "escape blurs" 0.0 exp12 f12
  return ()

// A modal dialog takes the focus to its first node and keeps it: Tab wraps
// round inside it, and Escape is the dialog's own.
@[test.suite]
test "a modal dialog takes the focus and keeps it":
  let (f13, s15, s16, f17) = with_readings (func frames =>
    (array.slice 0 2 (frame_at frames 13), seen (frame_at frames 15), seen (frame_at frames 16), frame_at frames 17))
  let exp15 = action 6.0 focus
  let exp16 = action 5.0 focus
  use test.near_array "modal opens" 0.0 #[5.0, 4.0] f13
  use test.near_array "tab inside modal" 0.0 exp15 s15
  use test.near_array "tab wraps in modal" 0.0 exp16 s16
  use test.near_array "escape stays in modal" 0.0 #[5.0, 4.0, -1.0, U32.to_f32 keys.escape] f17
  return ()

@[test.suite]
test "a focus moved outside a modal dialog comes back":
  let f19 = with_readings (func frames => array.slice 0 2 (frame_at frames 19))
  use test.near_array "modal reclaims focus" 0.0 #[5.0, 4.0] f19
  return ()

// Ancestor availability is inherited, and host focus/blur cannot escape modal.
@[test.suite]
test "hidden and disabled ancestors remove stops":
  let state = #[tree.unfocused]
  let returns: #[tree.Return] = #[]
  let stops: #[tree.Stop] = #[]
  let order: #[U32] = #[]
  let reached: #[U32] = #[]
  let held = $tree.Focus {state, returns, nodes: stops, order, reached}
  let labels: #[U32] = #[]
  let nodes: #[tree.StoredNode] = #[]
  let marked: #[tree.StoredNode] = #[]
  let hidden = ui.group_node (id 1) 0 (&words[0..words.length]) ui.nowhere
  hidden.hidden := true
  let (labels, nodes) = tree.declare_owned hidden labels nodes
  let (labels, nodes) = tree.declare_owned (ui.button_node (id 2) (id 1) (&words[0..words.length]) box) labels nodes
  let (labels, nodes) = tree.declare_owned (ui.disabled_when true (ui.group_node (id 3) 0 (&words[0..words.length]) ui.nowhere)) labels nodes
  let (labels, nodes) = tree.declare_owned (ui.button_node (id 4) (id 3) (&words[0..words.length]) box) labels nodes
  let (labels, nodes) = tree.declare_owned (ui.button_node (id 5) 0 (&words[0..words.length]) box) labels nodes
  let (held, _) = tree.settle (&nodes[0..nodes.length]) held marked
  let exp = #[id 5]
  let act = held.order
  use test.eq "only visible enabled stop" exp act
  return ()

@[test.suite]
test "modal focus is kept between events":
  let state = #[tree.unfocused]
  let returns: #[tree.Return] = #[]
  let stops: #[tree.Stop] = #[]
  let order: #[U32] = #[]
  let reached: #[U32] = #[]
  let held = $tree.Focus {state, returns, nodes: stops, order, reached}
  held := render true held
  let (_, next_state) = tree.route ($window.UiAction {node: id 3, action: protocol.action_focus, value: 0.0}) held
  held.state[0] := next_state
  let focused = held.state[0].node
  let (_, next_state) = tree.route ($window.UiAction {node: id 5, action: protocol.action_blur, value: 0.0}) held
  held.state[0] := next_state
  let final_node = held.state[0].node
  use test.eq "kept on modal node" #[5, 5] #[focused % 65536, final_node % 65536]
  return ()
