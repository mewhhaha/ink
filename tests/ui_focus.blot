// Ink's tree and focus on their own (lib/ui/tree.blot), on a bare
// ECS world: a toolbar of two buttons, and a dialog (modal from the 14th
// frame) of a button and a slider. Each frame routes its events (`route`),
// then declares the nodes and settles.
import * as array from "std/array"
import * as check from "./check"
import * as ecs from "ink/ecs"
import * as keys from "ink/input/keys"
import * as protocol from "ink/ui/vocabulary"
import * as tree from "ink/ui/tree"
import * as ui from "ink/ui"
import * as window from "ink/events"

const id = ui.node_id 9
const words = #[72, 105]
const box = #ui.Rect { x: 10.0, y: 20.0, width: 30.0, height: 40.0 }
const engine = ecs.build (ecs.insert_resource tree.unfocused (ecs.insert_resource tree.empty (ecs.new ())))

// The frame's nodes, as Render systems declare them, then settled.
const render = fn (modal: Bool) => do:
  use ecs.set tree.empty
  use ui.declare (ui.toolbar_node (id 1) 0 words ui.nowhere)
  use ui.declare (ui.button_node (id 2) (id 1) words box)
  use ui.declare (ui.button_node (id 3) (id 1) words box)
  use ui.declare (ui.dialog_node (id 4) 0 words modal box)
  use ui.declare (ui.button_node (id 5) (id 4) words box)
  use ui.declare (ui.described #[33] (ui.slider_node (id 6) (id 4) words 0.5 0.0 1.0 0.1 #[53, 48, 37] box))
  return tree.settle ()

// What reaches the game for `event`: a UiAction as its node's key, action
// and value, a key as -1 and its code, anything else as nothing.
const routed = fn (event: window.Event) => do:
  use reached <- tree.route event
  return case reached of
    #window.UiAction { node, action, value } => #[U32.to_f32 (node % 65536), U32.to_f32 action, value]
    #window.KeyDown code => #[-1.0, U32.to_f32 code]
    _ => #[]

const key = fn (code: U32) => #[#window.KeyDown code, #window.KeyUp code]

// A frame: its events, then its nodes; the focused node's key, the modal
// dialog's, then what the events became.
const frame = fn (modal: Bool) => fn (events: Array window.Event) => do:
  let seen = #[]
  for event in events:
    use lanes <- routed event
    seen := array.concat self lanes
  use render modal
  use held <- ecs.get #tree.Focus
  return array.concat #[U32.to_f32 (held.node % 65536), U32.to_f32 (held.modal % 65536)] seen

// Each frame's reading; the dialog turns modal at the 14th (index 13).
const readings = fn () => do:
  let script: Array (Array window.Event) = #[
    #[],
    key keys.tab,
    key keys.f10,
    key keys.right,
    key keys.tab,
    key keys.down,
    key keys.right,
    key keys.enter,
    key keys.left,
    #[#window.UiAction { node: id 3, action: 0, value: 0.0 }],
    #[#window.PointerDown { button: 0, x: 1.0, y: 1.0 }],
    key keys.f10,
    key keys.escape,
    #[],
    #[],
    key keys.tab,
    key keys.tab,
    key keys.escape,
    #[#window.UiAction { node: id 3, action: 0, value: 0.0 }],
    #[],
  ]
  let (start, _) = ecs.create engine (fn () => ())
  let world = start
  let found: Array (Array F32) = #[]
  for index in 0 .. script.length:
    let (next, reading) = ecs.run engine world (fn () => frame (index >= 13) script[index])
    world := next
    found := array.push reading self
  return found

// What the frame's events reached the game as, after the focus and modal.
const seen = fn (reading: Array F32) => array.slice 2 (reading.length - 2) reading

// A UiAction on node `node`, as `routed` reads it.
const action = fn (node: F32) => fn (code: U32) => #[node, U32.to_f32 code, 0.0]

const focus = protocol.action_focus

entry const test_tab_is_the_games_while_nothing_is_focused = fn () => do:
  let frames = readings ()
  return check.report #[
    check.equal #[0.0, 0.0] frames[0],
    check.equal #[-1.0, U32.to_f32 keys.tab] (seen frames[1]),
  ]

// F10 focuses the first node, Right the next in its toolbar, Tab the next
// focusable at all, and Down the next in the dialog.
entry const test_f10_and_the_arrows_and_tab_move_the_focus = fn () => do:
  let frames = readings ()
  return check.report #[
    check.equal (action 2.0 focus) (seen frames[2]),
    check.equal (action 3.0 focus) (seen frames[3]),
    check.equal (action 5.0 focus) (seen frames[4]),
    check.equal (action 6.0 focus) (seen frames[5]),
    check.equal #[6.0] #[frames[5][0]],
  ]

// On a slider, Right and Enter step it up and Left down.
entry const test_keys_step_a_focused_slider = fn () => do:
  let frames = readings ()
  return check.report #[
    check.equal (action 6.0 protocol.action_increment) (seen frames[6]),
    check.equal (action 6.0 protocol.action_increment) (seen frames[7]),
    check.equal (action 6.0 protocol.action_decrement) (seen frames[8]),
  ]

entry const test_assistive_technology_moves_the_focus = fn () => do:
  let frames = readings ()
  return check.report #[check.equal (array.concat #[3.0, 0.0] (action 3.0 focus)) frames[9]]

// A click takes the focus back to the world, as Escape does after F10.
entry const test_a_click_or_escape_gives_the_keys_back_to_the_world = fn () => do:
  let frames = readings ()
  return check.report #[
    check.equal #[0.0] #[frames[10][0]],
    check.equal (array.concat #[2.0, 0.0] (action 2.0 focus)) frames[11],
    check.equal (array.concat #[0.0, 0.0] (action 2.0 protocol.action_blur)) frames[12],
  ]

// A modal dialog takes the focus to its first node and keeps it: Tab wraps
// round inside it, and Escape is the dialog's own.
entry const test_a_modal_dialog_takes_the_focus_and_keeps_it = fn () => do:
  let frames = readings ()
  return check.report #[
    check.equal #[5.0, 4.0] (array.slice 0 2 frames[13]),
    check.equal (action 6.0 focus) (seen frames[15]),
    check.equal (action 5.0 focus) (seen frames[16]),
    check.equal #[5.0, 4.0, -1.0, U32.to_f32 keys.escape] frames[17],
  ]

entry const test_a_focus_moved_outside_a_modal_dialog_comes_back = fn () => do:
  let frames = readings ()
  return check.report #[check.equal #[5.0, 4.0] (array.slice 0 2 frames[19])]

// Ancestor availability is inherited, and host focus/blur cannot escape modal.
entry const test_hidden_and_disabled_ancestors_remove_stops = fn () => do:
  let (world, _) = ecs.create engine (fn () => ())
  let (_, result) = ecs.run engine world (fn () => do:
    let hidden = ui.group_node (id 1) 0 words ui.nowhere
    hidden.hidden := #True
    use ui.declare hidden
    use ui.declare (ui.button_node (id 2) (id 1) words box)
    use ui.declare (ui.disabled_when #True (ui.group_node (id 3) 0 words ui.nowhere))
    use ui.declare (ui.button_node (id 4) (id 3) words box)
    use ui.declare (ui.button_node (id 5) 0 words box)
    use tree.settle ()
    use held <- ecs.get #tree.Focus
    return check.report #[check.equal #[U32.to_f32 (id 5)] (array.map U32.to_f32 held.order)])
  return result

entry const test_modal_focus_is_kept_between_events = fn () => do:
  let (world, _) = ecs.create engine (fn () => ())
  let (_, result) = ecs.run engine world (fn () => do:
    use render #True
    use tree.route (#window.UiAction { node: id 3, action: protocol.action_focus, value: 0.0 })
    use held <- ecs.get #tree.Focus
    use tree.route (#window.UiAction { node: id 5, action: protocol.action_blur, value: 0.0 })
    use blurred <- ecs.get #tree.Focus
    return check.report #[check.equal #[5.0, 5.0] #[U32.to_f32 (held.node % 65536), U32.to_f32 (blurred.node % 65536)]])
  return result
