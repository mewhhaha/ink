// Ink's tree and focus on their own (lib/ui/tree.blot), on a bare
// ECS world: a toolbar of two buttons, and a dialog (modal from the 14th
// frame) of a button and a slider. Each frame routes its events (`route`),
// then declares the nodes and settles.
import * as array from "std/array"
import * as check from "./check"
import * as keys from "ink/input/keys"
import * as protocol from "ink/ui/vocabulary"
import * as tree from "ink/ui/tree"
import * as ui from "ink/ui"
import * as window from "ink/events"

const id = ui.node_id 9
const words = #[72, 105]
const description = #[33]
const percentage = #[53, 48, 37]
const box = $ui.Rect { x: 10.0, y: 20.0, width: 30.0, height: 40.0 }

// The frame's nodes, as Render systems declare them, then settled.
func render (modal: Bool) -> (held:tree.Focus) -> (nodes:ResizeArray tree.Node) -> (marked:ResizeArray tree.Node) => return do:
  @storage.truncate nodes 0
  ui.declare (ui.toolbar_node (id 1) 0 (&words[0..words.length]) ui.nowhere) nodes
  ui.declare (ui.button_node (id 2) (id 1) (&words[0..words.length]) box) nodes
  ui.declare (ui.button_node (id 3) (id 1) (&words[0..words.length]) box) nodes
  ui.declare (ui.dialog_node (id 4) 0 (&words[0..words.length]) modal box) nodes
  ui.declare (ui.button_node (id 5) (id 4) (&words[0..words.length]) box) nodes
  ui.declare (ui.described (&description[0..description.length]) (ui.slider_node (id 6) (id 4) (&words[0..words.length]) 0.5 0.0 1.0 0.1 (&percentage[0..percentage.length]) box)) nodes
  return tree.settle (&nodes[0..nodes.length]) held marked

// What reaches the game for `event`: a UiAction as its node's key, action
// and value, a key as -1 and its code, anything else as nothing.
func routed (event: window.Event) -> (held:tree.Focus) => return do:
  let reached = tree.route event held
  return case reached of
    $window.UiAction { node, action, value } => #[U32.to_f32 (node % 65536), U32.to_f32 action, value]
    $window.KeyDown code => #[-1.0, U32.to_f32 code]
    _ => #[]

func key (code: U32) => return #[$window.KeyDown code, $window.KeyUp code]

// A frame: its events, then its nodes; the focused node's key, the modal
// dialog's, then what the events became.
func frame (modal: Bool) -> (events: Array window.Event) -> (held:tree.Focus) -> (nodes:ResizeArray tree.Node) -> (marked:ResizeArray tree.Node) => return do:
  let seen: GrowArray F32 = #[]
  for event in events:
    let lanes = routed event held
    for value in lanes:
      @storage.push seen value
  render modal held nodes marked
  return array.concat #[U32.to_f32 (held.state[0].node % 65536), U32.to_f32 (held.state[0].modal % 65536)] (@storage.freeze seen)

// Each frame's reading; the dialog turns modal at the 14th (index 13).
type Span is data = $Span {start: U32, count: U32}
type Readings is data = $Readings {rows: &[Span], values: &[F32]}
func events_at (index: U32) => return case index of
  1 => key keys.tab
  2 => key keys.f10
  3 => key keys.right
  4 => key keys.tab
  5 => key keys.down
  6 => key keys.right
  7 => key keys.enter
  8 => key keys.left
  9 => #[$window.UiAction {node: id 3, action: 0, value: 0.0}]
  10 => #[$window.PointerDown {button: 0, x: 1.0, y: 1.0}]
  11 => key keys.f10
  12 => key keys.escape
  15 => key keys.tab
  16 => key keys.tab
  17 => key keys.escape
  18 => #[$window.UiAction {node: id 3, action: 0, value: 0.0}]
  _ => #[]
func with_readings run => return do:
  let state = #[tree.unfocused]
  let returns: ResizeArray tree.Return = #[]
  let stops: ResizeArray tree.Stop = #[]
  let order: ResizeArray U32 = #[]
  let reached: ResizeArray U32 = #[]
  let held = $tree.Focus {state, returns, nodes: stops, order, reached}
  let nodes: ResizeArray tree.Node = #[]
  let marked: ResizeArray tree.Node = #[]
  let rows: ResizeArray Span = #[]
  let values: ResizeArray F32 = #[]
  for index in 0 .. 20:
    let reading = frame (index >= 13) (events_at index) held nodes marked
    let start = values.length
    for value in reading:
      @storage.push values value
    @storage.push rows $Span {start, count: reading.length}
  return run ($Readings {rows: &rows[0..rows.length], values: &values[0..values.length]})
func frame_at (readings: Readings) -> (index: U32) => return do:
  let span = readings.rows[index]
  return array.slice span.start span.count readings.values

// What the frame's events reached the game as, after the focus and modal.
func seen (reading: Array F32) => return array.slice 2 (reading.length - 2) reading

// A UiAction on node `node`, as `routed` reads it.
func action (node: F32) => return func (code: U32) => return #[node, U32.to_f32 code, 0.0]

const focus = protocol.action_focus

entry func test_tab_is_the_games_while_nothing_is_focused () => return with_readings (func frames => return do:
  return check.report #[
    check.equal #[0.0, 0.0] (frame_at frames 0),
    check.equal #[-1.0, U32.to_f32 keys.tab] (seen (frame_at frames 1)),
  ])

// F10 focuses the first node, Right the next in its toolbar, Tab the next
// focusable at all, and Down the next in the dialog.
entry func test_f10_and_the_arrows_and_tab_move_the_focus () => return with_readings (func frames => return do:
  return check.report #[
    check.equal (action 2.0 focus) (seen (frame_at frames 2)),
    check.equal (action 3.0 focus) (seen (frame_at frames 3)),
    check.equal (action 5.0 focus) (seen (frame_at frames 4)),
    check.equal (action 6.0 focus) (seen (frame_at frames 5)),
    check.equal #[6.0] #[(frame_at frames 5)[0]],
  ])

// On a slider, Right and Enter step it up and Left down.
entry func test_keys_step_a_focused_slider () => return with_readings (func frames => return do:
  return check.report #[
    check.equal (action 6.0 protocol.action_increment) (seen (frame_at frames 6)),
    check.equal (action 6.0 protocol.action_increment) (seen (frame_at frames 7)),
    check.equal (action 6.0 protocol.action_decrement) (seen (frame_at frames 8)),
  ])

entry func test_assistive_technology_moves_the_focus () => return with_readings (func frames => return do:
  return check.report #[check.equal (array.concat #[3.0, 0.0] (action 3.0 focus)) (frame_at frames 9)])

// A click takes the focus back to the world, as Escape does after F10.
entry func test_a_click_or_escape_gives_the_keys_back_to_the_world () => return with_readings (func frames => return do:
  return check.report #[
    check.equal #[0.0] #[(frame_at frames 10)[0]],
    check.equal (array.concat #[2.0, 0.0] (action 2.0 focus)) (frame_at frames 11),
    check.equal (array.concat #[0.0, 0.0] (action 2.0 protocol.action_blur)) (frame_at frames 12),
  ])

// A modal dialog takes the focus to its first node and keeps it: Tab wraps
// round inside it, and Escape is the dialog's own.
entry func test_a_modal_dialog_takes_the_focus_and_keeps_it () => return with_readings (func frames => return do:
  return check.report #[
    check.equal #[5.0, 4.0] (array.slice 0 2 (frame_at frames 13)),
    check.equal (action 6.0 focus) (seen (frame_at frames 15)),
    check.equal (action 5.0 focus) (seen (frame_at frames 16)),
    check.equal #[5.0, 4.0, -1.0, U32.to_f32 keys.escape] (frame_at frames 17),
  ])

entry func test_a_focus_moved_outside_a_modal_dialog_comes_back () => return with_readings (func frames => return do:
  return check.report #[check.equal #[5.0, 4.0] (array.slice 0 2 (frame_at frames 19))])

// Ancestor availability is inherited, and host focus/blur cannot escape modal.
entry func test_hidden_and_disabled_ancestors_remove_stops () => return do:
  let state = #[tree.unfocused]
  let returns: ResizeArray tree.Return = #[]
  let stops: ResizeArray tree.Stop = #[]
  let order: ResizeArray U32 = #[]
  let reached: ResizeArray U32 = #[]
  let held = $tree.Focus {state, returns, nodes: stops, order, reached}
  let nodes: ResizeArray tree.Node = #[]
  let marked: ResizeArray tree.Node = #[]
  let hidden = ui.group_node (id 1) 0 (&words[0..words.length]) ui.nowhere
  hidden.hidden := true
  ui.declare hidden nodes
  ui.declare (ui.button_node (id 2) (id 1) (&words[0..words.length]) box) nodes
  ui.declare (ui.disabled_when true (ui.group_node (id 3) 0 (&words[0..words.length]) ui.nowhere)) nodes
  ui.declare (ui.button_node (id 4) (id 3) (&words[0..words.length]) box) nodes
  ui.declare (ui.button_node (id 5) 0 (&words[0..words.length]) box) nodes
  tree.settle (&nodes[0..nodes.length]) held marked
  return check.report #[check.equal #[from (id 5)] (array.map U32.to_f32 held.order)]
entry func test_modal_focus_is_kept_between_events () => return do:
  let state = #[tree.unfocused]
  let returns: ResizeArray tree.Return = #[]
  let stops: ResizeArray tree.Stop = #[]
  let order: ResizeArray U32 = #[]
  let reached: ResizeArray U32 = #[]
  let held = $tree.Focus {state, returns, nodes: stops, order, reached}
  let nodes: ResizeArray tree.Node = #[]
  let marked: ResizeArray tree.Node = #[]
  render true held nodes marked
  tree.route ($window.UiAction {node: id 3, action: protocol.action_focus, value: 0.0}) held
  let focused = held.state[0].node
  tree.route ($window.UiAction {node: id 5, action: protocol.action_blur, value: 0.0}) held
  return check.report #[check.equal #[5.0, 5.0] #[from (focused % 65536), from (held.state[0].node % 65536)]]
