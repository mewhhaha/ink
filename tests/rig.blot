import * as math from "ink/math"
import * as rig from "ink/rig"
import * as scene from "ink/physics/scene"
import * as spline from "ink/spline"
import * as terrain from "ink/terrain"
import * as view from "ink/view"
import { Vec3 } from "std/vector"

func vec (input: #[F32]) => func (at: U32) => math.vec3 input[at] input[at + 1] input[at + 2]

func camera_lanes (camera: view.Camera) =>
  let p = camera.position
  let q = camera.rotation
  let f = q.forward
  let u = q.up
  return #[p.x, p.y, p.z, q.x, q.y, q.z, q.w, f.x, f.y, f.z, u.x, u.y, u.z]

// Input: eye, target, up. The camera: position, rotation, forward, up.
#entry func look (input: #[F32]) : #[F32] => return
  camera_lanes (rig.look_at (vec input 0) (vec input 3) (vec input 6))

// Input: from yaw, to yaw, rate, seconds, steps. Turns from one yaw toward
// the other in that many equal steps; the rotation reached.
#entry func turning (input: #[F32]) : #[F32] =>
  let desired = math.Quat.yaw input[1]
  let steps = F32.to_u32 input[4]
  let current = math.Quat.yaw input[0]
  for 0..steps:
    current := rig.turn self desired input[2] (input[3] / U32.to_f32 steps)
  if steps == 0:
    current := rig.turn self desired input[2] input[3]
  return #[current.x, current.y, current.z, current.w]

func settings (input: #[F32]) => $rig.Follow {
  offset: vec input 0,
  turns: input[3] > 0.5,
  dead_zone: input[4],
  lookahead: input[5],
  frequency: input[6],
  damping: input[7],
  turn_rate: input[8],
}

// Input: settings (offset, turns, dead zone, lookahead, frequency, damping,
// turn rate), whether they are valid, as 1 or 0.
#entry func valid (input: #[F32]) : F32 => if rig.valid_follow (settings input) then 1.0 else 0.0

func state_lanes (state: rig.Follower) =>
  let a = state.anchor
  let s = state.seat
  let f = state.focus.value
  let e = state.eye.value
  let q = state.rotation
  return #[a.x, a.y, a.z, s.x, s.y, s.z, f.x, f.y, f.z, e.x, e.y, e.z, q.x, q.y, q.z, q.w]

// Input: settings (9), steps, dt, then per step a target, a velocity and a
// heading (7 each). The follower starts settled on the first target, velocity
// and heading. How many steps showed a camera other than their state's, then
// the state (anchor, seat, focus, eye, rotation; 16 each) at the start and
// after each step.
#entry func following (input: #[F32]) : #[F32] =>
  let rules = settings input
  let steps = F32.to_u32 input[9]
  let dt = input[10]
  let state = rig.follower rules (vec input 11) (vec input 14) input[17]
  let result = @array.fill (1 + 16 * (steps + 1)) 0.0
  let first = state_lanes state
  for k in 0..16:
    result[1 + k] := first[k]
  let wrong = 0.0
  for i in 0..steps:
    let at = 18 + i * 7
    let (next, camera) = rig.follow rules state (vec input at) (vec input (at + 3)) input[at + 6] dt
    if (camera.position - next.eye.value).length_squared > 0.0 or math.Quat.dot camera.rotation next.rotation < 1.0 - 0.000001:
      wrong := self + 1.0
    state := next
    let lanes = state_lanes state
    for k in 0..16:
      result[1 + 16 * (i + 1) + k] := lanes[k]
  result[0] := wrong
  return result

func lens (focal: F32) => $view.Lens { focal_length: focal, near: 0.1, far: 1000.0 }

func inside (camera: view.Camera) => func (focal: F32) => func (p: Vec3) => func (width: F32) => func (height: F32) => case view.viewport_point (lens focal) camera p width height of
  $Some (x, y) => x >= 0.0 and x <= width and y >= 0.0 and y <= height
  $Nothing => false

// Input: aspect, focal length, padding, yaw, pitch, then points. The eye
// that frames them; how much nearer than it (metres along the view) the
// nearest valid eye found by searching is; then each point's pixel in a
// viewport 1000 high. Empty when framing is refused.
#entry func framing (input: #[F32]) : #[F32] =>
  let aspect = input[0]
  let rotation = math.yaw_pitch input[3] input[4]
  let points = @array.generate ((input.length - 5) / 3) (func (i: U32) => vec input (5 + i * 3))
  let $Some eye = rig.frame (lens input[1]) aspect rotation points input[2] else:
    return #[]
  let height = 1000.0
  let width = aspect * height
  let camera = $view.Camera { position: eye, rotation }
  // Step forward until a point leaves the view: none should stay inside.
  let inside_ahead = 0.0
  for step in 1..21:
    let moved = $view.Camera { position: eye + rotation.forward * (U32.to_f32 step * 0.0005), rotation }
    let all = true
    for p in points:
      if not (inside moved input[1] p width height):
        all := false
    if all:
      inside_ahead := U32.to_f32 step * 0.0005
  let result: #[F32] = #[eye.x, eye.y, eye.z, inside_ahead]
  for p in points:
    let $Some (x, y) = view.viewport_point (lens input[1]) camera p width height else:
      return #[]
    @storage.push result x
    @storage.push result y
  return result

// Input: pivot, eye, radius, variant. A wall (id 3) fills x in [1.5, 2.5],
// y and z in [-2, 2]; a floor of terrain (id 5) lies at y = -1 about
// (0, -1, 0). Variant 1 makes the wall a trigger, 2 skips its id, 3 leaves its
// layer out of the mask and 4 leaves out the terrain. The eye `collide` gives.
#entry func collision (input: #[F32]) : #[F32] =>
  let wall = scene.box 3 (math.vec3 2.0 0.0 0.0) (math.vec3 1.0 4.0 4.0)
  let variant = F32.to_u32 input[7]
  let mask = 65535
  let skip = 0
  if variant == 1:
    let $Some c = wall.collider else:
      return #[]
    c.trigger := true
    wall.collider := $Some c
  if variant == 2:
    skip := 3
  if variant == 3:
    let $Some c = wall.collider else:
      return #[]
    c.layer := 2
    wall.collider := $Some c
    mask := 1
  let ground = scene.ground 5 (terrain.make (math.vec3 0.0 (-1.0) 0.0) 16.0 1 (&owned_terrain_samples[0..owned_terrain_samples.length]) 0.0 1.0 0 0)
  if variant == 4:
    let $Some c = ground.collider else:
      return #[]
    c.layer := 4
    ground.collider := $Some c
    mask := 3
  let sources = #[wall, ground]
  return scene.with_built sources (func world =>
    let eye = rig.collide world (vec input 0) (vec input 3) input[6] mask skip
    return #[eye.x, eye.y, eye.z])

  // Input: aim (0 along, 1 at a point, 2 fixed), distance, then the aim's
  // point (3) or yaw and pitch (2). A dolly along a path from the origin out
  // along +x, curving toward -z. Its camera: position, rotation, forward, up,
  // then the path's tangent there.

#entry func dollying (input: #[F32]) : #[F32] =>
  let spline_coefficients_1: #[F32] = #[]
  let spline_lengths_1: #[F32] = #[]
  let $Some path = spline.make_into #[math.zero3, math.vec3 4.0 0.0 0.0, math.vec3 8.0 0.0 (-2.0), math.vec3 10.0 1.0 (-6.0)] spline_coefficients_1 spline_lengths_1 else:
    return #[]
  let aim = $rig.Along
  if input[0] > 1.5:
    aim := $rig.Fixed (math.yaw_pitch input[2] input[3])
  else:
    if input[0] > 0.5:
      aim := $rig.At (vec input 2)
  let t = spline.tangent path input[1]
  let lanes = camera_lanes (rig.dolly path input[1] aim)
  return #[...lanes, t.x, t.y, t.z]

const owned_terrain_samples: #[F32] = #[0.0, 0.0, 0.0, 0.0]
