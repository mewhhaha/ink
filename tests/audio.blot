import * as array from "std/array"
import * as check from "./check"
import * as audio from "ink/audio"
import * as math from "ink/math"
import * as scene from "ink/scene"

const listener = $audio.Listener { position: math.zero3, velocity: math.zero3, right: math.right }
entry func mix (values: #[F32]) : #[F32] =>
  let emitter = $audio.Emitter { position: math.vec3 values[0] 0.0 0.0, velocity: math.vec3 values[1] 0.0 0.0, gain: 1.0 }
  return case audio.mix audio.default_config listener emitter (values[2] > 0.0) of
    $Some value => #[value.gain, value.pan, value.rate, value.cutoff]
    $Nothing => #[]
entry func occlusion (blocked: Bool) : #[F32] =>
  let sources = #[]
  if blocked:
    sources := #[scene.box 4 (math.vec3 3.0 0.0 0.0) math.one3]
  let emitter = $audio.Emitter { position: math.vec3 6.0 0.0 0.0, velocity: math.zero3, gain: 1.0 }
  return scene.with_built sources (func built => case audio.query audio.default_config listener emitter built 4294967295 0 of
    $Some value => #[value.gain, value.pan, value.rate, value.cutoff]
    $Nothing => #[])

entry func fade (elapsed: F32) : F32 => audio.fade 1.0 elapsed 0.0 1.0

entry func test_spatial_sound () => check.report #[
  check.equal #[1.0,0.0,1.0,20000.0] (mix #[0.0,0.0,0.0]),
  check.equal #[1.0] #[(mix #[1.0,0.0,0.0])[1]],
  check.equal #[-1.0] #[(mix #[-1.0,0.0,0.0])[1]],
  check.equal #[0.0,0.0] #[(mix #[100.0,0.0,0.0])[0],(mix #[1000.0,0.0,0.0])[0]],
  check.near 0.0000001 #[90.0 / 99.0 / 10.0] #[(mix #[10.0,0.0,0.0])[0]],
  check.holds ((mix #[10.0,-50.0,0.0])[2] > 1.0),
  check.holds ((mix #[10.0,50.0,0.0])[2] < 1.0),
  check.equal #[2.0] #[(mix #[10.0,-1000.0,0.0])[2]],
  check.equal #[] (mix #[0.0 / 0.0,0.0,0.0])]
entry func test_solid_occlusion () =>
  let clear = occlusion false
  let blocked = occlusion true
  return check.report #[check.near 0.0000001 #[clear[0] * 0.25] #[blocked[0]],check.equal #[1200.0,20000.0] #[blocked[3],clear[3]]]
entry func test_fade_envelope () =>
  let checks: #[+check.Check] = #[]
  for (elapsed,expected) in #[(0.0,0.0),(0.25,0.25),(1.0,1.0),(2.0,1.0),(-1.0,0.0)]:
    @storage.push checks (check.equal #[expected] #[fade elapsed])
  return check.report (seal checks)
