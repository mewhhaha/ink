import * as test from "std/test"
import * as audio from "ink/audio"
import * as math from "ink/math"
import * as scene from "ink/physics/scene"

const listener = $audio.Listener { position: math.zero3, velocity: math.zero3, right: math.right }
io mix (values: #[F32]) : #[F32] =>
  let emitter = $audio.Emitter { position: math.vec3 values[0] 0.0 0.0, velocity: math.vec3 values[1] 0.0 0.0, gain: 1.0 }
  return case audio.mix audio.default_config listener emitter (values[2] > 0.0) of
    $Some value => #[value.gain, value.pan, value.rate, value.cutoff]
    $Nothing => #[]
io occlusion (blocked: Bool) : #[F32] =>
  let sources = #[]
  if blocked:
    sources := #[scene.box 4 (math.vec3 3.0 0.0 0.0) math.one3]
  let emitter = $audio.Emitter { position: math.vec3 6.0 0.0 0.0, velocity: math.zero3, gain: 1.0 }
  return scene.with_built sources (func built => case audio.query audio.default_config listener emitter built 4294967295 0 of
    $Some value => #[value.gain, value.pan, value.rate, value.cutoff]
    $Nothing => #[])

io fade (elapsed: F32) : F32 => audio.fade 1.0 elapsed 0.0 1.0

@[test.suite]
test "spatial sound":
  use test.near_array "at listener" 0.0 #[1.0, 0.0, 1.0, 20000.0] (mix #[0.0, 0.0, 0.0])
  use test.near "pan right" 0.0 1.0 ((mix #[1.0, 0.0, 0.0])[1])
  use test.near "pan left" 0.0 (-1.0) ((mix #[-1.0, 0.0, 0.0])[1])
  use test.near_array "far attenuation" 0.0 #[0.0, 0.0] #[(mix #[100.0, 0.0, 0.0])[0], (mix #[1000.0, 0.0, 0.0])[0]]
  use test.near "distance rolloff" 0.0000001 (90.0 / 99.0 / 10.0) ((mix #[10.0, 0.0, 0.0])[0])
  use test.holds "approaching doppler > 1" ((mix #[10.0, -50.0, 0.0])[2] > 1.0)
  use test.holds "receding doppler < 1" ((mix #[10.0, 50.0, 0.0])[2] < 1.0)
  use test.near "doppler clamped max" 0.0 2.0 ((mix #[10.0, -1000.0, 0.0])[2])
  use test.near_array "non-finite rejected" 0.0 #[] (mix #[0.0 / 0.0, 0.0, 0.0])
  return ()

@[test.suite]
test "solid occlusion":
  let clear = occlusion false
  let blocked = occlusion true
  use test.near "occluded gain" 0.0000001 (clear[0] * 0.25) blocked[0]
  use test.near_array "occluded vs clear cutoff" 0.0 #[1200.0, 20000.0] #[blocked[3], clear[3]]
  return ()

@[test.suite]
test "fade envelope":
  for (elapsed, expected) in #[(0.0, 0.0), (0.25, 0.25), (1.0, 1.0), (2.0, 1.0), (-1.0, 0.0)]:
    use test.near "fade" 0.0 expected (fade elapsed)
  return ()
