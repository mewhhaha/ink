import * as array from "std/array"
import * as math from "ink/math"
import * as render from "ink/render"
import * as transform from "ink/transform"

// A quarter of columns are absent and a quarter are culled before matrices.
entry const render_columns = fn (count: U32) => do:
  let current = array.generate count (fn index => do:
    if index % 4 == 0:
      return #Nothing
    let pose = transform.identity
    pose.position := math.vec3 (U32.to_f32 index) 0.0 0.0
    return #Some pose)
  let previous = array.generate count (fn index => do:
    let pose = transform.identity
    pose.position := math.vec3 (U32.to_f32 index - 2.0) 0.0 0.0
    return #Some pose)
  let appearances = array.generate count (fn index => #Some #render.Appearance { mesh: index, material: 1 })
  let drawn = render.draw_columns_where (fn (pose: transform.Pose3) => fn (look: render.Appearance) => look.mesh % 4 != 1) current previous appearances 0.5
  let sum = 0.0
  let ids = 0
  for draw in drawn:
    sum := self + draw.matrix.w.x
    ids := self + draw.mesh
  return #[U32.to_f32 drawn.length, sum, U32.to_f32 ids]
