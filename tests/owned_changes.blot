import * as array from "std/array"
import * as changes from "ink/changes"
import * as journal from "ink/journal"
import * as check from "./check"
#entry func test_normalization_composition_and_reset_use_separate_destination_owners () =>
  let updated: #[U32] = #[]
  let removed: #[U32] = #[]
  let result = changes.make_into true #[3, 1, 3, 0xFFFFFFFF] #[2, 2] updated removed
  let combined_updated: #[U32] = #[]
  let combined_removed: #[U32] = #[]
  let combined = changes.compose_into result (changes.borrow false #[2, 4] #[1, 3]) combined_updated combined_removed
  let reset_updated: #[U32] = #[]
  let reset_removed: #[U32] = #[]
  let reset = changes.compose_into combined (changes.borrow true #[9, 9] #[4]) reset_updated reset_removed
  let membership = changes.apply (changes.borrow false #[8, 7, 1, 8] #[7]) #[2, 7, 0xFFFFFFFF]
  return check.report #[check.words #[2, 4, 0xFFFFFFFF] (array.map identity combined.updated),
    check.words #[1, 3] (array.map identity combined.removed),
    check.words #[9] (array.map identity reset.updated),
    check.words #[4] (array.map identity reset.removed),
    check.words #[1, 2, 8, 0xFFFFFFFF] membership,
    check.holds (combined.reset and reset.reset),
    check.words #[1, 3, 0xFFFFFFFF] (array.map identity result.updated)]
func read_journal_delta start -> log -> meta =>
  let scratch: #[journal.Change] = #[]
  let updated: #[U32] = #[]
  let removed: #[U32] = #[]
  return case journal.read_into start log meta scratch updated removed of
    $journal.Delta {changes: delta} => (true, array.map identity delta.updated, array.map identity delta.removed)
    _ => (false, #[], #[])
#entry func test_journal_coalesces_into_borrowed_deltas_and_detects_replacement () =>
  let log: journal.Journal = journal.empty ()
  let meta = journal.metadata 1 20
  let start = journal.cursor meta
  let (log, meta) = journal.record_many #[$journal.Added 0xFFFFFFFF, $journal.Removed 4, $journal.Added 4, $journal.Updated 7, $journal.Removed 7] log meta
  let (ok, written, deleted) = read_journal_delta start log meta
  let (log, meta) = journal.record $journal.Replaced log meta
  let scratch: #[journal.Change] = #[]
  let updated: #[U32] = #[]
  let removed: #[U32] = #[]
  let reset = case journal.read_into start log meta scratch updated removed of
    $journal.Reset _ => true
    _ => false
  return check.report #[check.holds ok, check.words #[4, 0xFFFFFFFF] written, check.words #[7] deleted, check.holds reset]
