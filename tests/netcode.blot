import * as array from "std/array"
import * as game from "./support/rollback_game"
import * as replication from "ink/replication"

// Entries driven by tools/native/src/netcode.rs, which checks them against
// independent Rust implementations of the delta codec and the arena game.

// args: seq, time bits, baseline, lanes, base[lanes], current[lanes]
entry func delta_encode (args: #[U32]) : #[U32] =>
  let lanes = args[3]
  let base = array.generate lanes (func i => args[4 + i])
  let current = array.generate lanes (func i => args[4 + lanes + i])
  return replication.encode args[0] (replication.f32_of args[1]) args[2] (&base[0..lanes]) (&current[0..lanes])

// args: lanes, packet length, packet words, base[lanes]. Returns ok, lanes...
entry func delta_decode (args: #[U32]) : #[U32] =>
  let lanes = args[0]
  let length = args[1]
  let packet = array.generate length (func i => args[2 + i])
  let base = array.generate lanes (func i => args[2 + length + i])
  let out: #[U32] = array.fill lanes 0xABCDEF01
  let (result, ok) = replication.decode_into (&packet[0..length]) (&base[0..lanes]) out
  let reply: #[U32] = #[]
  @storage.push reply (if ok then 1 else 0)
  for word in result:
    @storage.push reply word
  return reply

// args: players, frames, delay, seed. Returns the final arena state.
entry func lockstep (args: #[U32]) : #[U32] => game.lockstep args[0] args[1] args[2] args[3]
