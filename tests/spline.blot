import * as math from "ink/math"
import * as spline from "ink/spline"
import { Vec3 } from "std/vector"

// Points packed as xyz from `start`.
const points = fn (input: Array F32) => fn (start: U32) =>
  @array.generate ((input.length - start) / 3) (fn (i: U32) => math.vec3 input[start + i * 3] input[start + i * 3 + 1] input[start + i * 3 + 2])

const built = fn (closed: F32) => fn (p: Array Vec3) => do:
  if closed > 0.5:
    return spline.make_loop p
  return spline.make p

// Input: closed (0 or 1), a count m, m distances, then points. The length,
// then for each distance the point and unit tangent there; empty when the
// curve is refused.
entry const query = fn (input: Array F32) -> Array F32 => do:
  let m = F32.to_u32 input[1]
  let #Some curve = built input[0] (points input (2 + m)) else:
    return #[]
  let result: List F32 = [spline.length curve]
  for i in 0..m:
    let p = spline.at curve input[2 + i]
    let t = spline.tangent curve input[2 + i]
    result := [...self, p.x, p.y, p.z, t.x, t.y, t.z]
  return Array.from_list result

// Input: closed, steps n, then points. The length and the n + 1 points at
// equal distances from the start to the end (to the start again on a loop).
entry const walk = fn (input: Array F32) -> Array F32 => do:
  let n = F32.to_u32 input[1]
  let #Some curve = built input[0] (points input 2) else:
    return #[]
  let total = spline.length curve
  let result: List F32 = [total]
  for i in 0..(n + 1):
    let p = spline.at curve (total * U32.to_f32 i / U32.to_f32 n)
    result := [...self, p.x, p.y, p.z]
  return Array.from_list result

// Input: closed, then points. How far along each kept point lies, then the
// curve's point at each of those distances.
entry const marks = fn (input: Array F32) -> Array F32 => do:
  let #Some curve = built input[0] (points input 1) else:
    return #[]
  let marks = spline.marks curve
  let result: List F32 = []
  for d in marks:
    result := [...self, d]
  for d in marks:
    let p = spline.at curve d
    result := [...self, p.x, p.y, p.z]
  return Array.from_list result
