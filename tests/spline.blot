import * as math from "ink/math"
import * as spline from "ink/spline"
import { Vec3 } from "std/vector"

// Points packed as xyz from `start`.
const points = func (input: Array F32) => return func (start: U32) => return
  @array.generate ((input.length - start) / 3) (func (i: U32) => return math.vec3 input[start + i * 3] input[start + i * 3 + 1] input[start + i * 3 + 2])

const built = func (closed: F32) -> (p: Array Vec3) -> (coefficients: ResizeArray F32) -> (lengths: ResizeArray F32) => return do:
  if closed > 0.5:
    return spline.make_loop_into p coefficients lengths
  return spline.make_into p coefficients lengths

// Input: closed (0 or 1), a count m, m distances, then points. The length,
// then for each distance the point and unit tangent there; empty when the
// curve is refused.
entry const query = func (input: Array F32) : Array F32 => return do:
  let m = F32.to_u32 input[1]
  let coefficients: ResizeArray F32 = #[]
  let lengths: ResizeArray F32 = #[]
  let $Some curve = built input[0] (points input (2 + m)) coefficients lengths else:
    return #[]
  let result: GrowArray F32 = #[spline.length curve]
  for i in 0..m:
    let p = spline.at curve input[2 + i]
    let t = spline.tangent curve input[2 + i]
    for value in #[p.x, p.y, p.z, t.x, t.y, t.z]:
      @storage.push result value
  return @storage.freeze result

// Input: closed, steps n, then points. The length and the n + 1 points at
// equal distances from the start to the end (to the start again on a loop).
entry const walk = func (input: Array F32) : Array F32 => return do:
  let n = F32.to_u32 input[1]
  let coefficients: ResizeArray F32 = #[]
  let lengths: ResizeArray F32 = #[]
  let $Some curve = built input[0] (points input 2) coefficients lengths else:
    return #[]
  let total = spline.length curve
  let result: GrowArray F32 = #[total]
  for i in 0..(n + 1):
    let p = spline.at curve (total * U32.to_f32 i / U32.to_f32 n)
    for value in #[p.x, p.y, p.z]:
      @storage.push result value
  return @storage.freeze result

// Input: closed, then points. How far along each kept point lies, then the
// curve's point at each of those distances.
entry const marks = func (input: Array F32) : Array F32 => return do:
  let coefficients: ResizeArray F32 = #[]
  let lengths: ResizeArray F32 = #[]
  let $Some curve = built input[0] (points input 1) coefficients lengths else:
    return #[]
  let marks = spline.marks curve
  let result: GrowArray F32 = #[]
  for d in marks:
    for value in #[d]:
      @storage.push result value
  for d in marks:
    let p = spline.at curve d
    for value in #[p.x, p.y, p.z]:
      @storage.push result value
  return @storage.freeze result
