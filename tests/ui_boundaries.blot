import * as array from "std/array"
import * as check from "./check"
import * as keys from "ink/input/keys"
import * as ui from "ink/ui"
import * as ui_font from "./ui_font"
import * as menu from "ink/menu"
import * as math from "ink/math"
import * as tree from "ink/ui/tree"
import * as vocabulary from "ink/ui/vocabulary"
const no_text: #[U32] = #[]
const letters = #[65, 32, 128578]
const single = #[65]
const unicode_line = #[65, 128578, 66]
const unicode_short = #[65, 128578]
const insertion = #[128578, 66]

func value (control: ui.Control) => case control of
  $ui.Slider { value } => value
  $ui.Choice { chosen } => U32.to_f32 chosen
  _ => -1.0
func ignored (outcome: ui.Outcome) => case outcome of
  $ui.Ignored => true
  _ => false

entry func test_empty_controls_and_invalid_indices_are_ignored () =>
  let menu_rows: #[~ui.Rect] = #[]
  let options: #[&[U32]] = #[]
  let empty_choice = $ui.Choice {label: &no_text[0..0], options: &options[0..0], chosen: 999}
  let zero_slider = $ui.Slider {label: &no_text[0..0], value: 0.25, low: 0.0, high: 1.0, step: 0.0}
  return check.report #[
    check.holds (ignored (ui.key #[] 0 keys.down)),
    check.holds (ignored (ui.key #[empty_choice] 5 keys.enter)),
    check.holds (ignored (ui.acted #[] 0 vocabulary.action_activate 0.0)),
    check.equal #[0.0, 0.0] #[value (ui.step empty_choice 1.0), value (ui.set empty_choice 1.0)],
    check.holds (ui.control_node 1 0 empty_choice (&no_text[0..0]) ui.nowhere).disabled,
    check.equal #[0.0] #[U32.to_f32 (menu.value_of $menu.Words { on: &no_text[0..0], off: &no_text[0..0], percent: &no_text[0..0] } empty_choice).length],
    check.equal #[] #[rect.width | rect <- menu.tabs (menu.column_into menu_rows 0 0.0 100.0 20.0 12.0 1.0 100.0) 3],
  ]

entry func test_zero_steps_are_continuous_and_ranges_never_divide_by_zero () =>
  let options: #[&[U32]] = #[]
  let empty_choice = $ui.Choice {label: &no_text[0..0], options: &options[0..0], chosen: 999}
  let zero_slider = $ui.Slider {label: &no_text[0..0], value: 0.25, low: 0.0, high: 1.0, step: 0.0}
  return check.report #[
    check.equal #[0.25, 0.6, 0.9, 0.0] #[value (ui.step zero_slider 1.0), value (ui.slide zero_slider 0.6), value (ui.set zero_slider 0.9), ui.fraction ($ui.Slider { label: &no_text[0..0], value: 3.0, low: 3.0, high: 3.0, step: 1.0 })],
    check.near 0.00001 #[2.3] #[value (ui.set ($ui.Slider { label: &no_text[0..0], value: 2.1, low: 2.1, high: 3.0, step: 0.2 }) 2.32)],
  ]

func line_lanes (line: ui.Line) => array.concat #[U32.to_f32 line.caret] (array.map U32.to_f32 line.text)
func edit (line: ui.Line) -> code =>
  let output: #[~U32] = #[]
  return case ui.edit line code output of
    $Some result => line_lanes result
    $Nothing => #[]
func code wanted => case ui.character wanted false of
  $Some code => U32.to_f32 code
  $Nothing => -1.0

entry func test_text_edits_code_points_and_clamps_invalid_carets () =>
  let output: #[~U32] = #[]
  let options: #[&[U32]] = #[]
  let empty_choice = $ui.Choice {label: &no_text[0..0], options: &options[0..0], chosen: 999}
  let zero_slider = $ui.Slider {label: &no_text[0..0], value: 0.25, low: 0.0, high: 1.0, step: 0.0}
  return check.report #[
    check.equal #[3.0, 65.0, 128578.0, 66.0] (line_lanes (ui.typed ($ui.Line { text: &single[0..single.length], caret: 99 }) (&insertion[0..insertion.length]) output)),
    check.equal #[1.0, 65.0, 66.0] (edit ($ui.Line { text: &unicode_line[0..unicode_line.length], caret: 2 }) keys.backspace),
    check.equal #[1.0, 65.0] (edit ($ui.Line { text: &unicode_short[0..unicode_short.length], caret: 99 }) keys.backspace),
    check.equal #[0.0] (edit ui.blank keys.left),
    check.equal #[97.0, 128578.0, -1.0, -1.0] #[code keys.a, code 128578, code 0xD800, code 0x110000],
  ]

const face = ui_font.face

entry func test_text_uses_caller_metrics_and_preserves_space_advance () =>
  let options: #[&[U32]] = #[]
  let empty_choice = $ui.Choice {label: &no_text[0..0], options: &options[0..0], chosen: 999}
  let zero_slider = $ui.Slider {label: &no_text[0..0], value: 0.25, low: 0.0, high: 1.0, step: 0.0}
  let sprites = ui.text face (&letters[0..letters.length]) 10.0 20.0 10.0 (math.vec4 1.0 1.0 1.0 1.0)
  return check.report #[
    check.equal #[18.0] #[ui.measure face (&letters[0..letters.length]) 10.0],
    check.equal #[2.0, 7.0, 11.0, 12.5, 23.0, 5.0] #[U32.to_f32 sprites.length, U32.to_f32 sprites[0].material, sprites[0].x, sprites[0].y, sprites[1].x, sprites[1].width],
    check.equal #[0.0] #[U32.to_f32 (tree.bit 32)],
  ]

entry func ui_workload (count: U32) =>
  let options: #[&[U32]] = #[]
  let empty_choice = $ui.Choice {label: &no_text[0..0], options: &options[0..0], chosen: 999}
  let zero_slider = $ui.Slider {label: &no_text[0..0], value: 0.25, low: 0.0, high: 1.0, step: 0.0}
  let checksum = 0.0
  for index in 0 .. count:
    let value = U32.to_f32 (index % 101) * 0.01
    let control = ui.slide zero_slider value
    checksum := self + ui.fraction control
    let sprites = ui.text face (&letters[0..letters.length]) value 20.0 10.0 (math.vec4 1.0 1.0 1.0 1.0)
    checksum := self + sprites[1].x
  return checksum

entry func invalid_slider (values: #[F32]) =>
  let options: #[&[U32]] = #[]
  let empty_choice = $ui.Choice {label: &no_text[0..0], options: &options[0..0], chosen: 999}
  let zero_slider = $ui.Slider {label: &no_text[0..0], value: 0.25, low: 0.0, high: 1.0, step: 0.0}
  let slider = $ui.Slider { label: &no_text[0..0], value: values[0], low: values[1], high: values[2], step: values[3] }
  return #[value (ui.step slider 1.0), value (ui.slide slider 0.5), ui.fraction slider]
