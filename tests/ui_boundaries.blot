import * as array from "std/array"
import * as check from "./check"
import * as keys from "ink/input/keys"
import * as ui from "ink/ui"
import * as ui_font from "./ui_font"
import * as menu from "ink/menu"
import * as math from "ink/math"
import * as tree from "ink/ui/tree"
import * as vocabulary from "ink/ui/vocabulary"

const empty_choice = #ui.Choice { label: #[], options: #[], chosen: 999 }
const zero_slider = #ui.Slider { label: #[], value: 0.25, low: 0.0, high: 1.0, step: 0.0 }
const value = fn (control: ui.Control) => case control of
  #ui.Slider { value } => value
  #ui.Choice { chosen } => U32.to_f32 chosen
  _ => -1.0
const ignored = fn (outcome: ui.Outcome) => case outcome of
  #ui.Ignored => #True
  _ => #False

entry const test_empty_controls_and_invalid_indices_are_ignored = fn () => check.report #[
  check.holds (ignored (ui.key #[] 0 keys.down)),
  check.holds (ignored (ui.key #[empty_choice] 5 keys.enter)),
  check.holds (ignored (ui.acted #[] 0 vocabulary.action_activate 0.0)),
  check.equal #[0.0, 0.0] #[value (ui.step empty_choice 1.0), value (ui.set empty_choice 1.0)],
  check.holds (ui.control_node 1 0 empty_choice #[] ui.nowhere).disabled,
  check.equal #[0.0] #[U32.to_f32 (menu.value_of #menu.Words { on: #[], off: #[], percent: #[] } empty_choice).length],
  check.equal #[] #[rect.width | rect <- menu.tabs (menu.column 0 0.0 100.0 20.0 12.0 1.0 100.0) 3],
]

entry const test_zero_steps_are_continuous_and_ranges_never_divide_by_zero = fn () => check.report #[
  check.equal #[0.25, 0.6, 0.9, 0.0] #[value (ui.step zero_slider 1.0), value (ui.slide zero_slider 0.6), value (ui.set zero_slider 0.9), ui.fraction (#ui.Slider { label: #[], value: 3.0, low: 3.0, high: 3.0, step: 1.0 })],
  check.near 0.00001 #[2.3] #[value (ui.set (#ui.Slider { label: #[], value: 2.1, low: 2.1, high: 3.0, step: 0.2 }) 2.32)],
]

const line_lanes = fn (line: ui.Line) => array.concat #[U32.to_f32 line.caret] (array.map U32.to_f32 line.text)
const edit = fn (line: ui.Line) => fn code => case ui.edit line code of
  #Some result => line_lanes result
  #Nothing => #[]
const code = fn wanted => case ui.character wanted #False of
  #Some code => U32.to_f32 code
  #Nothing => -1.0

entry const test_text_edits_code_points_and_clamps_invalid_carets = fn () => check.report #[
  check.equal #[3.0, 65.0, 128578.0, 66.0] (line_lanes (ui.typed (#ui.Line { text: #[65], caret: 99 }) #[128578, 66])),
  check.equal #[1.0, 65.0, 66.0] (edit (#ui.Line { text: #[65, 128578, 66], caret: 2 }) keys.backspace),
  check.equal #[1.0, 65.0] (edit (#ui.Line { text: #[65, 128578], caret: 99 }) keys.backspace),
  check.equal #[0.0] (edit ui.blank keys.left),
  check.equal #[97.0, 128578.0, -1.0, -1.0] #[code keys.a, code 128578, code 0xD800, code 0x110000],
]

const face = ui_font.face

entry const test_text_uses_caller_metrics_and_preserves_space_advance = fn () => do:
  let sprites = ui.text face #[65, 32, 128578] 10.0 20.0 10.0 (math.vec4 1.0 1.0 1.0 1.0)
  return check.report #[
    check.equal #[18.0] #[ui.measure face #[65, 32, 128578] 10.0],
    check.equal #[2.0, 7.0, 11.0, 12.5, 23.0, 5.0] #[U32.to_f32 sprites.length, U32.to_f32 sprites[0].material, sprites[0].x, sprites[0].y, sprites[1].x, sprites[1].width],
    check.equal #[0.0] #[U32.to_f32 (tree.bit 32)],
  ]

entry const ui_workload = fn (count: U32) => do:
  let checksum = 0.0
  for index in 0 .. count:
    let value = U32.to_f32 (index % 101) * 0.01
    let control = ui.slide zero_slider value
    checksum := self + ui.fraction control
    let sprites = ui.text face #[65, 32, 128578] value 20.0 10.0 (math.vec4 1.0 1.0 1.0 1.0)
    checksum := self + sprites[1].x
  return checksum

entry const invalid_slider = fn (values: Array F32) => do:
  let slider = #ui.Slider { label: #[], value: values[0], low: values[1], high: values[2], step: values[3] }
  return #[value (ui.step slider 1.0), value (ui.slide slider 0.5), ui.fraction slider]
