import * as app from "ink/app"
import * as clock from "ink/clock"
import * as events from "ink/events"
import * as input from "ink/input"
import * as check from "./check"
func push_seen (seen: own #[F32]) -> (stage: F32) -> (x: F32) -> (dx: F32) -> (claimed: Bool) : #[F32] =>
  @storage.push seen stage
  @storage.push seen x
  @storage.push seen dx
  @storage.push seen (if claimed then 1.0 else 0.0)
  return seen
func observe (own access) -> stage =>
  let held = input.read access.pointer access.held access.fresh access.buttons
  access.seen := push_seen self stage held.x held.dx held.claimed
  return access
func interface (own access) -> (context: app.EventContext) =>
  let (pointer, held, fresh, buttons) = input.receive access.pointer access.held access.fresh access.buttons context.event
  access.pointer := pointer
  access.held := held
  access.fresh := fresh
  access.buttons := buttons
  access := observe self 1.0
  if let $events.PointerDown {} = context.event:
    access.pointer := input.claim self
  return access
func event (own access) -> context => observe access 2.0
const stages = app.stages app.no_action app.no_action app.no_action app.no_action app.route_event
  interface event app.no_update app.no_render app.no_action
const policy = $clock.Policy {step_seconds: 0.1, max_elapsed: 0.25, max_steps: 2}
#entry func test_current_pointer_and_claim_are_shared_by_ui_and_world_then_reset_next_event () =>
  let pointer = #[input.initial]
  let held: #[U32] = #[]
  let fresh: #[U32] = #[]
  let buttons: #[U32] = #[]
  let seen: #[F32] = #[]
  let access = {pointer, held, fresh, buttons, seen, clock: #[clock.clock], control: app.control (), wall: app.wall ()}
  let (step, moved) = app.advance stages access policy 0.0 #[$events.PointerDown {button: 0, x: 10.0, y: 20.0}, $events.PointerMove {x: 14.0, y: 20.0}] 100.0 100.0
  access := moved
  return check.report #[check.equal #[1.0,10.0,10.0,0.0, 2.0,10.0,10.0,1.0, 1.0,14.0,4.0,0.0, 2.0,14.0,4.0,0.0] access.seen]
#entry func test_paused_input_still_tracks_pointer_without_running_world_handlers () =>
  let pointer = #[input.initial]
  let held: #[U32] = #[]
  let fresh: #[U32] = #[]
  let buttons: #[U32] = #[]
  let seen: #[F32] = #[]
  let access = {pointer, held, fresh, buttons, seen, clock: #[clock.clock], control: app.control (), wall: app.wall ()}
  access.control := app.pause self true
  let (step, moved) = app.advance stages access policy 0.0 #[$events.PointerDown {button: 2, x: 17.0, y: 20.0}] 100.0 100.0
  access := moved
  return check.report #[check.equal #[1.0,17.0,17.0,0.0] access.seen]
