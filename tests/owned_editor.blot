import * as check from "./check"
import {Vec3} from "std/vector"
import * as editor from "ink/editor"
import * as brush from "ink/brush"
import * as view from "ink/view"
import * as math from "ink/math"
import * as render from "ink/render"

entry func test_drag_origin_and_editor_codec_are_explicit_copies () =>
  let camera = $view.Camera {position: math.zero3, rotation: math.identity_quat}
  let world_faces: #[~render.Face] = #[]
  let solid = brush.box world_faces math.zero3 (math.vec3 1.0 1.0 1.0) 0
  let before = solid.faces[0].distance
  let drag_faces: #[~render.Face] = #[]
  let (origin, drag_faces) = editor.store_origin drag_faces solid
  let clips: #[~Vec3] = #[]
  let access = {editor: #[editor.initial camera], editor_clips: clips, editor_drag_faces: drag_faces}
  let points = #[math.zero3]
  let state = $editor.Editor {mode: $editor.Edit, tool: $editor.Brushes,
    selected: $Some 0, face: $Nothing, grid: 0.5, paint: 0,
    clips: &points[0..points.length],
    drag: $editor.StoredMove {origin, anchor: math.zero3, vertical: false}, view: camera}
  access := editor.write_state access state
  // A live brush edit changes the world owner. The drag before-image owns an
  // independent copy; reading editor state does not allocate another copy.
  world_faces[0].distance := before + 8.0
  let retained = editor.read_state access ()
  let $editor.StoredMove {origin: saved} = retained.drag else:
    return check.report #[check.holds false]
  let encoded = editor.encode_storage access
  let restored_row = #[editor.initial camera]
  let restored_clips: #[~Vec3] = #[]
  let restored_faces: #[~render.Face] = #[]
  let restored = {editor: restored_row, editor_clips: restored_clips, editor_drag_faces: restored_faces}
  let restored = editor.decode_into encoded restored
  return check.report #[
    check.equal #[before] #[access.editor_drag_faces[saved.faces_start].distance],
    check.equal #[before + 8.0] #[world_faces[0].distance],
    check.equal encoded (editor.encode_storage restored),
  ]

entry func test_borrowed_editor_clips_keep_their_captured_length () =>
  let camera = $view.Camera {position: math.zero3, rotation: math.identity_quat}
  let stored = #[editor.initial camera]
  let clips: #[~Vec3] = #[]
  let faces: #[~render.Face] = #[]
  let access = {editor: stored, editor_clips: clips, editor_drag_faces: faces}
  let first = #[math.zero3]
  access.editor_clips := editor.store_clips self first
  let one = (access.editor_clips.view 0 first.length).length
  let more = #[math.zero3, math.one3, math.right]
  access.editor_clips := editor.store_clips self more
  let three = (access.editor_clips.view 0 more.length).length
  return check.report #[check.equal #[1.0, 3.0] #[U32.to_f32 one, U32.to_f32 three]]
