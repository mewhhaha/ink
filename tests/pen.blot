import * as pen_platform from "ink/pen/platform"
import * as array from "std/array"
import * as host from "ink/pen/host"
import * as pen_events from "ink/pen/events"
import * as pen_program from "ink/pen/program"
import * as pen_settings from "ink/pen/settings"
import * as events from "ink/events"
import * as math from "ink/math"
import * as persist from "ink/persist"
import * as preferences from "ink/preferences"
import * as render from "ink/render"
import * as services from "ink/services"
import * as sound from "ink/sound"
import * as tree from "ink/ui/tree"
import * as protocol from "pen/protocol"
import * as protocol_render from "pen/protocol_render"

const kept = #preferences.Preferences {
  quality: #preferences.Quality { msaa: 1, fxaa: #False, scale: 1.0, filtering: 0,
    shadows: 0, occlusion: #False, sky: #False, fog: 1.0, effects: #False, bloom: #False },
  volumes: #preferences.Volumes { master: 0.5, music: 0.25, effects: 0.75 },
  controls: #preferences.Controls { left_handed: #False }, changed: #True,
}

entry const frame_packet = fn (unused: U32) => do:
  let frame = render.empty
  let draw = #render.Draw { mesh: 0, material: 0, matrix: math.Mat4.identity,
    parameters: #Some (math.vec4 1.0 2.0 3.0 4.0), extra: @array.fill 35 (math.vec4 5.0 6.0 7.0 8.0) }
  frame.draws := #[draw]
  frame.solids := #[#render.Solid { faces: #[#render.Face { normal: math.up, distance: 1.0, material: 0 }] }]
  frame.decals := #[#render.Decal { material: 0, matrix: math.Mat4.identity, opacity: 0.5 }]
  frame.sprites := #[#render.Sprite { x: 1.0, y: 2.0, width: 3.0, height: 4.0,
    u0: 0.0, v0: 0.0, u1: 1.0, v1: 1.0, color: math.vec4 0.25 0.5 0.75 1.0,
    material: 0, parameters: math.vec4 9.0 8.0 7.0 6.0 }]
  frame.insets := #[#render.Inset { x: 10.0, y: 20.0, width: 30.0, height: 40.0,
    pixel_size: 2.0, view: math.Mat4.identity, projection: math.Mat4.identity,
    light: render.studio, draws: #[draw] }]
  frame.fields := #[#render.Field { material: 0, width: 2, height: 2, x: 0, z: 0,
    columns: 2, values: #[1.0, 2.0, 3.0, 4.0] }]
  let request = #services.Request { id: 7, service: protocol.service_clipboard,
    operation: protocol.clipboard_op_copy, a: 1.0, b: 2.0, c: 3.0, d: 4.0,
    values: #[65.0, 66.0], kept: #False, sent: 0, tries: 0 }
  let played = sound.silent
  played.sounds := #[#sound.Sound { clip: 0, bus: 2, volume: 0.5, pitch: 1.25,
    reverb: 0.25, position: #Nothing }]
  played.voices := #[#sound.Voice { id: 9, clip: 0, bus: 1, gain: 0.75, pan: 0.5,
    pitch: 1.0, lowpass: 12000.0, reverb: 0.25, looping: #True,
    start: 0.0, fade_in: 0.5, fade_out: 0.25, position: #Nothing }]
  return host.encode_frame 3 persist.no_requests played kept tree.empty frame #[request] #[42.0]

entry const events_packet = fn (unused: U32) => do:
  let decoded = pen_events.decode_events #[1.0, 65.0, 0.0, 0.0, 0.0, 14.0, 7.0, 1.0, 2.0, 3.0] 0 2
  let #events.KeyDown key = decoded[0] else:
    return #[]
  let #events.ServiceData { request, a, b, c } = decoded[1] else:
    return #[]
  return #[U32.to_f32 key, U32.to_f32 request, a, b, c]

entry const occlusion_default = fn (unused: U32) => do:
  let frame = render.empty
  return frame.occlusion

entry const occlusion_packet = fn (flags: U32) => do:
  let frame = render.empty
  frame.occlusion := flags % 2 == 1
  let preferences = kept
  preferences.quality.occlusion := flags / 2 == 1
  return host.encode_frame 3 persist.no_requests sound.silent preferences tree.empty frame #[] #[]

entry const render_scale_default = fn (unused: U32) => do:
  let frame = render.empty
  return frame.render_scale

entry const render_scale_packet = fn (values: Array F32) => do:
  let frame = render.empty
  frame.render_scale := values[1]
  let preferences = kept
  preferences.quality.scale := values[0]
  preferences.changed := values[2] == 1.0
  return host.encode_frame 3 persist.no_requests sound.silent preferences tree.empty frame #[] #[]

entry const commands_packet = fn (values: Array F32) => (pen_program.decode_command values).code
entry const settings_back = fn (page: U32) => pen_settings.back page

const node = fn (id: U32) => fn (parent: U32) => fn (name: Array U32) => #tree.Node {
  id, parent, role: 0, name, description: #[66], value_text: #[67],
  x: 0.0, y: 0.0, width: 1.0, height: 1.0,
  focusable: #True, focused: #False, disabled: #False, hidden: #False, modal: #False,
  checked: 0, expanded: 0, selected: 0, live: 0, value: 0.5,
  minimum: 0.0, maximum: 1.0, step: 0.1, actions: 1,
}

entry const ui_nodes_packet = fn (unused: U32) => do:
  let nodes = host.wire_nodes #[node 11 0 (@array.fill 1025 65), node 12 11 #[68], node 13 99 #[]]
  return array.flatten (array.map protocol_render.encode_ui_node nodes)

entry const platform_packet = fn (unused: U32) => pen_platform.encode pen_platform.unknown

entry const service_packet = fn (unused: U32) => do:
  let request = #services.Request { id: 16777215, service: 5, operation: 255,
    a: 1.0, b: 2.0, c: 3.0, d: 4.0, values: #[-0.25, 0.5],
    kept: #True, sent: 0xFFFFFFFF, tries: 2 }
  return protocol_render.encode_service_request (host.wire_service request)
