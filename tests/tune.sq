import * as test from "std/test"
import * as events from "ink/events"
import * as tune from "ink/tune"

const speed: (U32, F32, F32, F32) = (7, 3.0, 1.0, 5.0)
@[test.suite]
test "tunables keep last setting and read within range":
  let defaults = tune.empty ()
  let tuned = tune.empty ()
  let restored = tune.empty ()
  tuned := tune.receive tuned ($events.Tune { index: 7, value: 2.0 })
  tuned := tune.receive tuned ($events.Tune { index: 8, value: 9.0 })
  tuned := tune.receive tuned ($events.Tune { index: 7, value: 8.0 })
  let read = tune.value tuned speed
  restored := tune.decode (tune.encode tuned) self
  use test.near_array "check 1" 0.0 #[3.0, 5.0, 5.0] #[tune.read defaults speed, read, tune.read restored speed]
  use test.near_array "check 2" 0.0 #[7.0, 8.0, 8.0, 9.0] (tune.encode restored)
  return ()

// Saved settings with one id twice do not restore, wherever the two lie.
io decode_ids (ids: #[F32]) : U32 =>
  let settings = tune.empty ()
  settings := tune.decode #[lane | id <- ids, lane <- #[id, 0.5]] self
  return settings.length
