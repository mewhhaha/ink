import * as array from "std/array"
import * as test from "std/test"
import * as bits from "./support/bits"
import * as old from "./perf/next_reference"
import * as changes from "ink/changes"
import * as jobs from "ink/task_queue"
import * as codec from "ink/codec"
import * as spatial from "ink/spatial"
import * as scene from "ink/physics/scene"
import * as math from "ink/math"
import * as tree from "ink/ui/tree"
import * as ui from "ink/ui"
import * as vocabulary from "ink/ui/vocabulary"
import * as shapes from "ink/physics/shapes"

func same_words (a: #[U32]) -> (b: #[U32]) : Bool =>
  if a.length != b.length:
    return false
  for i in 0 .. a.length:
    if a[i] != b[i]:
      return false
  return true

@[test.suite]
test "change sets preserve conflicts resets and full width keys":
  let valid = true
  for seed in 0 .. 80:
    let a = array.generate (seed % 31) (func i => (i * 17 + seed) % 43 ^ (if seed % 2 == 0 then 0xFFFFFF00 else 0))
    let b = array.generate (seed % 23) (func i => (i * 7 + seed) % 43 ^ (if seed % 2 == 0 then 0xFFFFFF00 else 0))
    let early = changes.borrow (seed % 3 == 0) a b
    let late = changes.borrow (seed % 5 == 0) b a
    let expected_updated: #[U32] = #[]
    let expected_removed: #[U32] = #[]
    let actual_updated: #[U32] = #[]
    let actual_removed: #[U32] = #[]
    let expected = old.compose_into early late expected_updated expected_removed
    let actual = changes.compose_into early late actual_updated actual_removed
    valid := self and same_words (old.fixed expected.updated) (old.fixed actual.updated) and same_words (old.fixed expected.removed) (old.fixed actual.removed)
    valid := self and (if expected.reset then actual.reset else not actual.reset)
    valid := self and same_words (old.apply early (old.unique b)) (changes.apply early (changes.unique b))
    valid := self and same_words (old.affected early) (changes.affected early)
  let many = array.generate 4096 identity
  let diff = changes.difference #[4095, 0xFFFFFFFF] many
  let without = changes.without #[9, 1, 2, 9] #[2]
  let united = changes.union #[0, 0xFFFFFFFF] #[1, 0xFFFFFFFF]
  use test.holds "compose matches reference" valid
  use test.eq "difference" #[0xFFFFFFFF] diff
  use test.eq "without" #[9, 1, 9] without
  use test.eq "union" #[0, 1, 0xFFFFFFFF] united
  return ()

@[test.suite]
test "queue chunks preserve exact mixed outcomes":
  let valid = true
  for count in #[0, 1, 3, 4, 65, 257]:
    let queue: jobs.Queue [U32, U32, U32] = jobs.empty ()
    let meta = jobs.metadata 0xFFFFFFFF count false
    meta[1] := count + 1
    meta[4] := 1
    for i in 0 .. count:
      let state: jobs.State U32 = case i % 4 of
        0 => $jobs.Pending
        1 => $jobs.Ready {tick: 1, outcome: $jobs.Value (i * 5)}
        2 => $jobs.Ready {tick: 1, outcome: $jobs.Failed 0xFFFFFFFF}
        _ => $jobs.Ready {tick: 1, outcome: $jobs.Cancelled i}
      @storage.push queue ($jobs.Job {ticket: $jobs.Ticket {epoch: 0xFFFFFFFF, sequence: i + 1}, submitted: 0, earliest: 1, request: i, continuation: i, state})
    let encode = func i => array.generate (i % 5) (func k => i ^ k ^ 0xFFFFFFFF)
    valid := self and same_words (old.encode_queue encode encode encode queue meta) (jobs.encode encode encode encode queue meta)
  use test.holds "queue chunks match reference" valid
  return ()

@[test.suite]
test "simd decoder validates padding and tails":
  let valid = true
  for count in #[0, 1, 3, 4, 5, 63, 64, 65, 257]:
    let words = array.generate count (func i => i * 2654435761 ^ 0xFFFFFFFF)
    for extra in #[0, 1, 7]:
      let packet = codec.pack (count + extra) words
      valid := self and same_words words (Maybe.unwrap_or #[] (codec.unpack (count + extra) packet))
      for i in 0 .. packet.length:
        let invalid = copy packet
        invalid[i] := 0.5
        valid := self and not (Maybe.is_some (codec.unpack (count + extra) invalid))
      if extra > 0:
        let invalid = copy packet
        invalid[invalid.length - 1] := 1.0
        valid := self and not (Maybe.is_some (codec.unpack (count + extra) invalid))
  use test.holds "simd decoder validation" valid
  return ()

func boxes count => array.generate count (func i =>
  let p = math.vec3 (U32.to_f32 (i % 31)) (U32.to_f32 (i % 7)) (U32.to_f32 (i / 31))
  return $spatial.Bounds {low: p, high: p + math.one3})
func with_index items -> run =>
  let bounds: #[F32] = #[]
  let order: #[U32] = #[]
  let leaves: #[U32] = #[]
  let index = spatial.build_into (spatial.access 0 bounds order leaves) items
  return run (own index)
func index_copy (source: spatial.Index) : spatial.Index =>
  let bounds: #[F32] = #[]
  let order: #[U32] = #[]
  let leaves: #[U32] = #[]
  return spatial.copy_into (spatial.access 0 bounds order leaves) source
func same_bounds left -> right : Bool =>
  let count: U32 = left.length
  let right_count: U32 = right.length
  let left_at: U32 -> F32 = left.at
  let right_at: U32 -> F32 = right.at
  if count != right_count:
    return false
  for i in 0 .. count:
    if bits.word (left_at i) != bits.word (right_at i):
      return false
  return true
@[test.suite]
test "paged refits match dense and preserve snapshots":
  let valid = true
  for count in #[0, 1, 17, 256, 513, 4097]:
    let unchanged = with_index (boxes count) (func before =>
      let before_bounds = spatial.flat_bounds before
      let before_words = array.generate before_bounds.length (func i => before_bounds[i])
      let current = index_copy before
      let reference = index_copy before
      let matched = true
      for step in 0 .. 4:
        let changed = #[count / 2, 0, count / 2, count + 1, 0xFFFFFFFF]
        let replacement = boxes changed.length
        replacement[0].low.x := -8.0 - U32.to_f32 step
        replacement[2].low.x := -9.0 - U32.to_f32 step
        current := spatial.refit current changed replacement
        reference := spatial.refit_dense reference changed replacement
        matched := self and same_bounds (spatial.flat_bounds reference) (spatial.flat_bounds current)
        matched := self and same_bounds before_words (spatial.flat_bounds before)
        matched := self and same_words (spatial.query reference (math.vec3 (-20.0) (-20.0) (-20.0)) math.one3) (spatial.query current (math.vec3 (-20.0) (-20.0) (-20.0)) math.one3)
      let dense = spatial.refit (index_copy current) (array.generate count identity) (boxes count)
      let back = spatial.refit (index_copy dense) #[0] #[$spatial.Bounds {low: math.zero3, high: math.one3}]
      let expected = spatial.refit_dense (index_copy dense) #[0] #[$spatial.Bounds {low: math.zero3, high: math.one3}]
      return matched and same_bounds (spatial.flat_bounds expected) (spatial.flat_bounds back))
    valid := self and unchanged
  use test.holds "paged refits match dense" valid
  return ()

func with_scene sources -> run =>
  let geometry = shapes.empty ()
  let proxies: #[scene.ProxyRow] = #[]
  let bounds: #[F32] = #[]
  let order: #[U32] = #[]
  let leaves: #[U32] = #[]
  let slots: #[U32] = #[]
  let world = scene.build_into (scene.access geometry proxies bounds order leaves slots) sources
  return run (own world)

func brute_cast world -> a -> b -> radius -> delta -> filter =>
  let (low, high) = scene.swept_bounds a b radius delta
  let best = $Nothing
  let time = 2.0
  for i in 0 .. scene.count world:
    let p = scene.proxy world i
    if scene.accepts filter p and scene.touches_bounds p low high:
      if let $Some found = scene.cast_shape p.shape a b radius delta:
        let (t, point, normal, surface, depth) = found
        if t < time:
          time := t
          best := $Some ($scene.Hit {id: p.id, proxy: i, time: t, distance: t * delta.length, point, normal, surface, depth})
  return best
func hit_words (hit: Maybe scene.Hit) => case hit of
  $Nothing => #[0]
  $Some h => #[1, h.id, h.proxy, bits.word h.time, bits.word h.distance, bits.word h.point.x, bits.word h.point.y, bits.word h.point.z,
    bits.word h.normal.x, bits.word h.normal.y, bits.word h.normal.z, bits.word h.depth]
func cast_witness world =>
  let valid = true
  for i in 0 .. 50:
    let a = math.vec3 (U32.to_f32 (i % 13) - 2.0) (if i % 3 == 0 then 0.75 else 0.0) (-2.0)
    let delta = math.vec3 (U32.to_f32 (i % 5) - 2.0) 0.0 50.0
    let filter = scene.solid_filter 0xFFFFFFFF
    valid := self and same_words (hit_words (brute_cast world a a 0.0 delta filter)) (hit_words (scene.cast world a a 0.0 delta filter))
  return valid
@[test.suite]
test "direct casts match source order and old scenes":
  let sources = array.generate 300 (func i => scene.sphere (0xFFFFFFFF - i) (math.vec3 (U32.to_f32 (i % 11) * 2.0) 0.0 (U32.to_f32 (i / 11) * 2.0)) 0.75)
  sources[1] := scene.sphere 4 math.zero3 0.75
  let (valid, origin_solid, far_clear, tie_first, moved_ok) = with_scene sources (func before => with_scene sources (func (own after) =>
    let moved = copy sources
    moved[0].position := math.vec3 1000.0 0.0 0.0
    after := scene.update moved after #[0, 0, 0xFFFFFFFF]
    let valid = cast_witness before and cast_witness after
    let tie = scene.cast before (math.vec3 0.0 0.0 (-2.0)) (math.vec3 0.0 0.0 (-2.0)) 0.0 (math.vec3 0.0 0.0 4.0) (scene.solid_filter 0xFFFFFFFF)
    let tie_first = case tie of
      $Some hit => hit.proxy == 0
      $Nothing => false
    return (valid, scene.point_solid before math.zero3 0xFFFFFFFF,
      not (scene.point_solid before (math.vec3 (-100.0) 0.0 0.0) 0xFFFFFFFF),
      tie_first, (scene.proxy before 0).low.x < 0.0 and (scene.proxy after 0).low.x > 900.0)))
  use test.holds "cast witness" valid
  use test.holds "origin solid" origin_solid
  use test.holds "far clear" far_clear
  use test.holds "tie first proxy" tie_first
  use test.holds "before preserved after moved" moved_ok
  return ()

@[test.suite]
test "dirty hulls reuse geometry and rebuild slots":
  let initial = #[scene.box 3 math.zero3 math.one3]
  let world = scene.build_into (scene.empty ()) initial
  let points = world.geometry.points.length
  let planes = world.geometry.planes.length
  let next = initial.copy
  let reused = true
  for i in 1 .. 17:
    next[0].position.x := U32.to_f32 i
    world := scene.update next world #[0]
    reused := self and world.geometry.points.length == points and world.geometry.planes.length == planes
  let added = array.concat next #[scene.box 7 (math.vec3 40.0 0.0 0.0) math.one3]
  world := scene.update added world #[1]
  let counts = #[world.source_count, world.index.base, scene.count world]
  let ov3 = scene.overlap_sphere world (math.vec3 16.0 0.0 0.0) 0.25 65535
  let ov7 = scene.overlap_sphere world (math.vec3 40.0 0.0 0.0) 0.25 65535
  use test.holds "geometry reused" (reused and points > 0 and planes > 0)
  use test.eq "counts" #[2, 2, 2] counts
  use test.eq "overlap 3" #[3] ov3
  use test.eq "overlap 7" #[7] ov7
  return ()

func with_focus (initial: tree.FocusState) -> (initial_returns: #[tree.Return]) -> run =>
  let state: #[tree.FocusState] = #[initial]
  let returns: #[tree.Return] = #[]
  for value in initial_returns:
    @storage.push returns value
  let nodes: #[tree.Stop] = #[]
  let order: #[U32] = #[]
  let reached: #[U32] = #[]
  return run (own ($tree.Focus {state, returns, nodes, order, reached}))
func witness (held: tree.Focus) -> (nodes: &[tree.StoredNode]) => return
  array.concat (array.map bits.word (tree.encode held)) (array.map (func (n: tree.StoredNode) => (if n.hidden then 1 else 0) + (if n.focused then 2 else 0)) nodes)
func settled_witness (nodes: &[tree.StoredNode]) -> held -> returns => with_focus held returns (func (own focus) =>
  let marked: #[tree.StoredNode] = #[]
  let (focus, marked) = tree.settle nodes focus marked
  return witness focus (&marked[0..marked.length]))
func prepared_witness (prepared: tree.Prepared) -> (nodes: &[tree.StoredNode]) -> held -> returns => with_focus held returns (func (own focus) =>
  let marked: #[tree.StoredNode] = #[]
  let (focus, marked) = tree.resolve_prepared prepared nodes focus marked
  return witness focus (&marked[0..marked.length]))
func stored_button_node (id: U32) -> (parent: U32) : tree.StoredNode =>
  let empty_text: #[U32] = #[]
  let (node, _) = tree.store_node (ui.button_node id parent (&empty_text[0..0]) ui.nowhere) #[]
  return node
@[test.suite]
test "prepared ui matches cycles depth modals and dirty properties":
  let valid = true
  for count in #[0, 1, 16, 65, 257]:
    let matched = do:
      let before = tree.empty_prepared ()
      let prepared = tree.empty_prepared ()
      let labels: #[U32] = #[]
      let make_nodes = func () =>
        let list = array.generate count (func i => stored_button_node (0xFFFFFFFF - i) (if i % 70 == 0 then 0 else 0xFFFFFFFF - i + 1))
        if count > 16:
          list[2].parent := list[3].id
          list[3].parent := list[2].id
          list[9].parent := 1234
          list[11].id := list[10].id
          list[15].id := 0
        return list
      let nodes = make_nodes ()
      let original = make_nodes ()
      before := tree.prepare 1 (&original[0..original.length]) before
      prepared := tree.prepare 1 (&nodes[0..nodes.length]) prepared
      let same = true
      for step in 0 .. 6:
        let dirty = array.generate count identity
        if count > 0:
          nodes[0].modal := step % 2 == 0
          nodes[0].disabled := step == 3
          nodes[0].hidden := step == 4
          labels := do:
            let (span, next_labels) = tree.store_text #[step] self
            nodes[0].name := span
            break next_labels
        if count > 17:
          nodes[16].role := vocabulary.role_tab
          nodes[16].selected := if step == 2 then vocabulary.state_true else vocabulary.state_false
          nodes[17].parent := 0
        prepared := tree.update_prepared 2 (&nodes[0..nodes.length]) dirty prepared
        let held = tree.unfocused
        if count > 0:
          held.node := nodes[0].id
        same := self and same_words (settled_witness (&nodes[0..nodes.length]) held #[]) (prepared_witness prepared (&nodes[0..nodes.length]) held #[])
      break same and same_words (settled_witness (&original[0..original.length]) tree.unfocused #[]) (prepared_witness before (&original[0..original.length]) tree.unfocused #[])
    valid := self and matched
  use test.holds "prepared ui matches settled" valid
  return ()

@[test.suite]
test "prepared ui sparse flags and focus return":
  let prepared = tree.empty_prepared ()
  let labels: #[U32] = #[]
  let nodes = array.generate 96 (func i => stored_button_node (i + 1) (if i % 32 == 0 then 0 else i))
  prepared := tree.prepare 1 (&nodes[0..nodes.length]) prepared
  let held = tree.unfocused
  held.node := 20
  let returns: #[tree.Return] = #[{scope: 33, node: 2}, {scope: 999, node: 20}]
  let valid = true
  for step in 0 .. 9:
    let dirty = if step < 6 then 8 else 64
    labels := do:
      let (span, next_labels) = tree.store_text #[step] self
      nodes[dirty].name := span
      break next_labels
    nodes[dirty].hidden := step == 1
    nodes[dirty].disabled := step == 3
    nodes[dirty].modal := step == 5
    nodes[dirty].actions := step
    prepared := tree.update_prepared 1 (&nodes[0..nodes.length]) #[dirty] prepared
    valid := self and same_words (settled_witness (&nodes[0..nodes.length]) held returns) (prepared_witness prepared (&nodes[0..nodes.length]) held returns)
  let reduced = array.generate 32 (func i => nodes[i])
  prepared := tree.update_prepared 2 (&reduced[0..reduced.length]) #[] prepared
  let expected_reduced = settled_witness (&reduced[0..reduced.length]) held returns
  let actual_reduced = prepared_witness prepared (&reduced[0..reduced.length]) held returns
  use test.holds "sparse updates match" valid
  use test.eq "reduced tree matches" expected_reduced actual_reduced
  return ()

@[test.suite]
test "direct capsule casts at large coordinates and zero axes":
  let valid = true
  for offset in #[0.0, 100000.0, -100000.0]:
    let sources = array.generate 64 (func i =>
      let p = math.vec3 (offset + U32.to_f32 (i % 8) * 4.0) 0.0 (offset + U32.to_f32 (i / 8) * 4.0)
      return case i % 3 of
        0 => scene.box (i + 1) p (math.vec3 2.0 3.0 2.0)
        1 => scene.capsule (i + 1) p 0.75 3.0
        _ => scene.sphere (i + 1) p 1.0)
    let matched = with_scene sources (func world =>
      let current = true
      for i in 0 .. 60:
        let a = math.vec3 (offset + U32.to_f32 (i % 11) * 3.0 - 1.0) (U32.to_f32 (i % 3) - 1.0) (offset - 2.0)
        let b = a + math.up * 1.5
        let delta = math.vec3 (if i % 2 == 0 then -0.0 else -4.0) 0.0 (if i % 5 == 0 then 0.0 else 35.0)
        let filter = scene.solid_filter 1
        filter.skip := i % 8
        let radius = U32.to_f32 (i % 3) * 0.25
        current := self and same_words (hit_words (brute_cast world a b radius delta filter)) (hit_words (scene.cast world a b radius delta filter))
      return current)
    valid := self and matched
  use test.holds "capsule casts match brute force" valid
  return ()

@[test.suite]
test "spatial direct query limits predicates and ties":
  let (tie, tight_none, inf_none, has_seven, has_none) = with_index (array.fill 8 ($spatial.Bounds {low: math.zero3, high: math.one3})) (func index =>
    let nearest = spatial.closest index (func _ -> _ => 0.5) (func i => if i == 0 then $Nothing else $Some i) (func _ => 0.5) 0.5
    let tie = case nearest of
      $Some hit => hit.index == 1 and hit.value == 1 and hit.time == 0.5
      $Nothing => false
    return (tie,
      not (Maybe.is_some (spatial.closest index (func _ -> _ => 0.5) (func i => $Some i) (func _ => 0.5) 0.49)),
      not (Maybe.is_some (spatial.closest index (func _ -> _ => 1.0 / 0.0) (func i => $Some i) (func _ => 0.0) (1.0 / 0.0))),
      spatial.any index math.zero3 math.one3 (func i => i == 7),
      not (spatial.any index math.zero3 math.one3 (func _ => false))))
  use test.holds "tie chooses lowest matching" tie
  use test.holds "limit excludes farther" tight_none
  use test.holds "infinite distance excluded" inf_none
  use test.holds "any finds match" has_seven
  use test.holds "any false when predicate false" has_none
  return ()
