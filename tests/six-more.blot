import * as array from "std/array"
import * as check from "./check"
import * as map from "ink/map"
import * as set from "ink/set"
import * as relations from "ink/relations"
import * as pages from "ink/pages"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as grid from "ink/spatial/point_grid"
import * as math from "ink/math"
import * as codec from "ink/codec"
import * as jobs from "ink/task_queue"

type Key = {id: U32, label: U32}
const key_policy = map.key (fn (key: Key) => key.id % 17) (fn a b => a.id % 17 == b.id % 17)
const collide = map.key (fn (key: Key) => 0) (fn a b => a.id % 17 == b.id % 17)
const old_from = fn policy (values: Array Key) => do:
  let result = set.empty ()
  for value in values:
    result := set.insert policy value self
  return result
const key_words = fn (value: set.Set Key) => array.flatten (array.map (fn (key: Key) => #[key.id, key.label]) (set.values value))
entry const test_set_batch_algebra_preserves_equivalent_representatives_and_order = fn () => do:
  let left = array.generate 70 (fn i -> Key => {id: i * 7, label: i + 100})
  let right = array.generate 90 (fn i -> Key => {id: i * 11, label: i + 1000})
  let good = #True
  for policy in #[key_policy, collide]:
    let before = old_from policy left
    let other = old_from policy right
    let actual = set.from policy left
    let original = key_words actual
    let u = set.fold (fn result key => set.insert policy key result) before other
    let i = set.fold (fn result key => if set.contains policy key other then set.insert policy key result else result) (set.empty ()) before
    let d = set.fold (fn result key => set.remove policy key result) before other
    good := self && (check.words (key_words before) (key_words actual)).passed
    good := self && (check.words (key_words u) (key_words (set.union policy actual other))).passed
    good := self && (check.words (key_words i) (key_words (set.intersection policy actual other))).passed
    good := self && (check.words (key_words d) (key_words (set.difference policy actual other))).passed
    good := self && (check.words original (key_words actual)).passed
  return check.report #[check.holds good]

const target_policy = map.key (fn (key: U32) => key % 3) (fn a b => a % 3 == b % 3)
const relation_words = fn (edges: relations.Relations [U32,U32]) => do:
  let forward = array.flatten (array.map (fn pair => do:
    let (source, edge) = pair
    return #[source, edge.target, edge.slot]) (map.entries edges.forward))
  let inverse = array.flatten (array.map (fn key => do:
    let values = relations.sources target_policy key edges
    return array.concat #[values.length] values) #[0,1,2])
  return array.concat #[map.count edges.forward, map.count edges.inverse] (array.concat forward inverse)
entry const test_bulk_relationship_removal_matches_sequential_collision_cases = fn () => do:
  let good = #True
  for policy in #[map.u32, map.key (fn (key: U32) => 0) U32.eq]:
    let before = relations.empty ()
    for source in 0 .. 150:
      before := relations.link policy target_policy source (source % 9) self
    let original = relation_words before
    for destination in #[0, 1, 2, 7]:
      let expected = before
      for source in relations.sources target_policy destination before:
        expected := relations.unlink policy target_policy source self
      let actual = relations.remove_target policy target_policy destination before
      good := self && (check.words (relation_words expected) (relation_words actual)).passed
      good := self && (check.words original (relation_words before)).passed
  return check.report #[check.holds good]

type Counter is data = #Counter U32
const sim = do:
  let builder = ecs.new ()
  builder := ecs.register_tracked_component 9 64 (#Counter 0) self
  break ecs.build builder
const counter = fn x => case x of
  #Some (#Counter n) => n
  _ => 0xFFFFFFFF
entry const test_membership_batches_keep_old_views_and_transition_only_changed_words = fn () => do:
  let (_, checks) = ecs.create sim (fn () => do:
    use ecs.spawn_many 2049
    use ecs.insert_selected #Counter #[0,1,31,32,64,1024,2048] (array.map (fn i => #Counter i) #[0,1,31,32,64,1024,2048])
    use before <- ecs.view #Counter
    use original <- query.source 1 #Counter
    use cursor <- ecs.component_cursor #Counter
    use ecs.edit_selected #Counter #[0,1,33,64,96,2048] #[#Some (#Counter 77), #Nothing, #Some (#Counter 33), #Nothing, #Some (#Counter 96), #Nothing]
    use current <- ecs.view #Counter
    use changed <- query.source 1 #Counter
    use result <- ecs.component_changes cursor #Counter
    use ecs.edit_selected #Counter #[0,31] #[#Some (#Counter 88), #Some (#Counter 99)]
    use payload <- query.source 1 #Counter
    let (updates, removes) = case result of
      #ecs.Delta {changes} => (changes.updated, changes.removed)
      _ => (#[], #[])
    return #[check.words #[0,1,31,32,64,1024,2048] (ecs.indices before),
      check.words #[0,31,32,33,96,1024] (ecs.indices current),
      check.words #[0,1,3,32] current.occupied,
      check.words #[0,33,96] updates, check.words #[1,64,2048] removes,
      check.holds (original.revision + 1 == changed.revision && changed.revision == payload.revision),
      check.words #[0,1,31,32,64,1024,2048] (array.map (fn i => counter (ecs.read before i)) #[0,1,31,32,64,1024,2048]),
      check.words #[77,31,32,33,96,1024] (array.map (fn i => counter (ecs.read current i)) #[0,31,32,33,96,1024])])
  return check.report checks
entry const test_sparse_and_dense_bit_iteration_matches_scalar_reference = fn () => do:
  let masks = #[0, 1, 0x80000000, 0x10101010, 0x000001FF, 0xFFFFFFFF, 0x7FFFFFFF, 0xAAAAAAAA]
  let view: ecs.ReadView U32 = #ecs.ReadView {count: masks.length * 32, bits: array.fill masks.length 0xFFFFFFFF, masks, occupied: array.generate masks.length identity, values: #[]}
  let expected = #[i | i <- array.generate (masks.length * 32) identity, (masks[i / 32] >> (i % 32)) & 1 != 0]
  return check.report #[check.words expected (ecs.indices view)]

entry const test_point_grid_build_keeps_all_hash_chains_and_old_snapshots = fn () => do:
  let positions = array.generate 220 (fn i => math.vec3 (U32.to_f32 (i % 17) * 0.4 - 3.2) 0.0 (U32.to_f32 (i / 17) * 0.4 - 2.0))
  let result = grid.build 0.4 16 positions
  let expected = array.fill 16 0
  let ok = #True
  for i in 0 .. positions.length:
    let point = pages.get result.points i
    let key = grid.bucket result.mask point.cx point.cz
    ok := self && point.next == expected[key]
    ok := self && codec.float_word point.x == codec.float_word positions[i].x && codec.float_word point.z == codec.float_word positions[i].z
    expected[key] := i + 1
  let grown = grid.push positions[12] result
  return check.report #[check.holds ok, check.words expected (pages.flatten result.heads),
    check.holds (result.points.count == positions.length && grown.points.count == positions.length + 1),
    check.holds ((grid.within result positions[12].x positions[12].z 0.0).length + 1 == (grid.within grown positions[12].x positions[12].z 0.0).length)]
entry const test_dense_membership_edits_preserve_order_and_previous_view = fn () => do:
  let (_, checks) = ecs.create sim (fn () => do:
    use ecs.spawn_many 1024
    let ids = array.generate 1024 identity
    use ecs.insert_selected #Counter ids (array.map (fn i => #Counter i) ids)
    use before <- ecs.view #Counter
    use ecs.edit_selected #Counter ids (array.generate 1024 (fn i => if i % 3 == 0 then #Nothing else #Some (#Counter (i + 10))))
    use after <- ecs.view #Counter
    let expected = #[i | i <- ids, i % 3 != 0]
    return #[check.words ids (ecs.indices before), check.words expected (ecs.indices after),
      check.holds (counter (ecs.read before 999) == 999 && counter (ecs.read after 999) == 0xFFFFFFFF),
      check.holds (counter (ecs.read before 1000) == 1000 && counter (ecs.read after 1000) == 1010)])
  return check.report checks

entry const test_batch_queue_preserves_reference_payloads_and_snapshot = fn () => do:
  let requests = array.generate 32 (fn i => #[i, i * 3, 0xFFFFFFFF])
  let locals = array.generate 32 (fn i => #[i * 7, i + 1])
  let before: jobs.Queue [Array U32, Array U32, Array U32] = jobs.make 3 32 #False
  let #Some (batch, tickets) = jobs.submit_many 1 1 requests locals before else:
    return @panic "valid reference batch rejected"
  let individual = before
  for i in 0 .. requests.length:
    let #Some (next, _) = jobs.submit 1 1 requests[i] locals[i] individual else:
      return @panic "valid reference submission rejected"
    individual := next
  let source = requests
  source[0] := #[99]
  let encode = jobs.encode (fn (words: Array U32) => words) (fn (words: Array U32) => words) (fn (words: Array U32) => words)
  let batch_words = encode batch
  let individual_words = encode individual
  let current = batch
  for i in 0 .. tickets.length:
    let (next, accepted) = jobs.settle 2 tickets[i] (#jobs.Value #[i, 0xFFFFFFFF]) current
    if Bool.not accepted:
      return @panic "valid reference completion rejected"
    current := next
  let (finished, delivered) = jobs.publish 2 current
  return check.report #[check.words individual_words batch_words,
    check.words #[0,0,0xFFFFFFFF] batch.jobs[0].request,
    check.words #[99] source[0], check.holds (before.jobs.length == 0 && finished.jobs.length == 0),
    check.holds (delivered.length == requests.length)]
