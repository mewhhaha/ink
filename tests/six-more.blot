import * as array from "std/array"
import * as check from "./check"
import * as map from "ink/map"
import * as set from "ink/set"
import * as relations from "ink/relations"
import * as pages from "ink/pages"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as grid from "ink/spatial/point_grid"
import * as math from "ink/math"
import * as codec from "ink/codec"
import * as jobs from "ink/task_queue"
import * as journal from "ink/journal"

type Key = {id: U32, label: U32}
const key_policy = map.key (func (key: Key) => return key.id % 17) (func a -> b => return a.id % 17 == b.id % 17)
const collide = map.key (func (key: Key) => return 0) (func a -> b => return a.id % 17 == b.id % 17)
func key_words (rows:set.Set Key) => return do:
  let result:GrowArray U32 = #[]
  for key in set.values rows:
    array.append_into result #[key.id,key.label]
  return @storage.freeze result
func contains_key (policy:map.Key Key) -> (key:Key) -> values => return array.any (func value => return policy.equal key value) values
func reference_keys (policy:map.Key Key) -> (values:Array Key) => return do:
  let result:GrowArray Key = #[]
  for value in values:
    if Bool.not (contains_key policy value result):
      result.push value
  return @storage.freeze result
func set_case (policy:map.Key Key) => return do:
  let left = array.generate 70 (func i:Key => return {id:i*7,label:i+100})
  let right = array.generate 90 (func i:Key => return {id:i*11,label:i+1000})
  let before = reference_keys policy left
  let other = reference_keys policy right
  let actual:set.Set Key = set.empty ()
  let slots = set.buckets ()
  set.from policy left actual slots
  let original = key_words actual
  let united:set.Set Key = set.empty ()
  let united_slots = set.buckets ()
  map.copy_into policy identity identity united united_slots actual
  let others:set.Set Key = set.empty ()
  let other_slots = set.buckets ()
  set.from policy right others other_slots
  set.union policy united united_slots others
  let intersected:set.Set Key = set.empty ()
  let intersected_slots = set.buckets ()
  map.copy_into policy identity identity intersected intersected_slots actual
  set.intersection policy intersected intersected_slots others other_slots
  let different:set.Set Key = set.empty ()
  let different_slots = set.buckets ()
  map.copy_into policy identity identity different different_slots actual
  set.difference policy different different_slots others
  let words = func values => return do:
    let result:GrowArray U32 = #[]
    for key in values:
      array.append_into result #[key.id,key.label]
    return @storage.freeze result
  return (check.words (words before) (key_words actual)).passed and
    (check.words (words (reference_keys policy (array.concat before other))) (key_words united)).passed and
    (check.words (words (array.filter (func key => return contains_key policy key other) before)) (key_words intersected)).passed and
    (check.words (words (array.filter (func key => return Bool.not (contains_key policy key other)) before)) (key_words different)).passed and
    (check.words original (key_words actual)).passed
entry func test_set_batch_algebra_preserves_equivalent_representatives_and_order () => return check.report #[check.holds (set_case key_policy and set_case collide)]

const target_policy = map.key (func (key:U32) => return key%3) (func a -> b => return a%3==b%3)
func relation_words (edges:relations.Relations [U32,U32]) -> slots => return do:
  let result:GrowArray U32 = #[]
  result.push (map.count slots)
  for pair in map.entries edges:
    let (source,target)=pair
    array.append_into result #[source,target]
  for target in #[0,1,2]:
    let values=relations.sources target_policy.equal target edges
    result.push values.length
    array.append_into result values
  return @storage.freeze result
func relation_case (policy:map.Key U32) => return do:
  let good=true
  for destination in #[0,1,2,7]:
    let edges:relations.Relations [U32,U32]=relations.empty ()
    let slots=relations.buckets ()
    for source in 0 .. 150:
      relations.link policy source (source%9) edges slots
    let original=relation_words edges slots
    let copied:relations.Relations [U32,U32]=relations.empty ()
    let copied_slots=relations.buckets ()
    relations.copy_into policy identity identity copied copied_slots edges
    for source in relations.sources target_policy.equal destination copied:
      relations.unlink policy source copied copied_slots
    let actual:relations.Relations [U32,U32]=relations.empty ()
    let actual_slots=relations.buckets ()
    relations.copy_into policy identity identity actual actual_slots edges
    relations.remove_target policy target_policy.equal destination actual actual_slots
    good := self and (check.words (relation_words copied copied_slots) (relation_words actual actual_slots)).passed and (check.words original (relation_words edges slots)).passed
  return good
const source_collision=map.key (func (key:U32) => return 0) U32.eq
entry func test_bulk_relationship_removal_matches_sequential_collision_cases () => return check.report #[check.holds (relation_case map.u32 and relation_case source_collision)]

type Counter is data = $Counter U32
func counter x => return case x of
  $Some ($Counter n) => n
  _ => 0xFFFFFFFF
func occupied ids => return do:
  let result:GrowArray U32=#[]
  let previous=0xFFFFFFFF
  for id in ids:
    let word=id/32
    if word != previous:
      result.push word
      previous := word
  return @storage.freeze result
entry func test_membership_batches_keep_old_views_and_transition_only_changed_words () => return do:
  let alive:ecs.Entities=ecs.entities ()
  let alive_meta=ecs.metadata 9
  ecs.spawn_many alive alive_meta 2049
  let pool:ecs.Pool Counter=ecs.pool ()
  let meta=ecs.metadata 9
  let ids=#[0,1,31,32,64,1024,2048]
  ecs.insert_selected alive pool meta ids (array.map (func i => return $Counter i) ids)
  let before:ecs.Pool Counter=ecs.pool ()
  ecs.copy_into identity before pool
  let membership_before:ResizeArray Bool=#[]
  let original=query.source 1 pool meta membership_before
  let original_structure=original.structure
  let log:journal.Journal=journal.empty ()
  let log_meta=journal.metadata 9 64
  let cursor=journal.cursor log_meta
  let selected=#[0,1,33,64,96,2048]
  let values=#[$Some ($Counter 77),$Nothing,$Some ($Counter 33),$Nothing,$Some ($Counter 96),$Nothing]
  for i in 0 .. selected.length:
    case values[i] of
      $Some value => ecs.insert_tracked alive pool meta log log_meta selected[i] value
      $Nothing => ecs.remove_tracked pool meta log log_meta selected[i]
  let current:ecs.Pool Counter=ecs.pool ()
  ecs.copy_into identity current pool
  let membership_after:ResizeArray Bool=#[]
  let changed=query.source 1 pool meta membership_after
  let changed_structure=changed.structure
  let scratch:ResizeArray journal.Change=#[]
  let updates:ResizeArray U32=#[]
  let removes:ResizeArray U32=#[]
  let result=journal.read_into cursor log log_meta scratch updates removes
  ecs.write pool meta 0 ($Counter 88)
  ecs.write pool meta 31 ($Counter 99)
  let membership_payload:ResizeArray Bool=#[]
  let payload=query.source 1 pool meta membership_payload
  return check.report #[check.words #[0,1,31,32,64,1024,2048] (ecs.indices alive before),
    check.words #[0,31,32,33,96,1024] (ecs.indices alive current),
    check.words #[0,1,3,32] (occupied (ecs.indices alive current)),
    check.words #[0,33,96] (array.map identity updates),check.words #[1,64,2048] (array.map identity removes),
    check.holds (original_structure+5==changed_structure and changed_structure==payload.structure),
    check.words #[0,1,31,32,64,1024,2048] (array.map (func i => return counter (ecs.read before i)) ids),
    check.words #[77,31,32,33,96,1024] (array.map (func i => return counter (ecs.read current i)) #[0,31,32,33,96,1024])]
entry func test_sparse_and_dense_bit_iteration_matches_scalar_reference () => return do:
  let masks=#[0,1,0x80000000,0x10101010,0x000001FF,0xFFFFFFFF,0x7FFFFFFF,0xAAAAAAAA]
  let alive:ecs.Entities=ecs.entities ()
  let alive_meta=ecs.metadata 1
  ecs.spawn_many alive alive_meta (masks.length*32)
  let pool:ecs.Pool U32=ecs.pool ()
  let meta=ecs.metadata 1
  for i in 0 .. masks.length*32:
    if (masks[i/32] >> (i%32))&1 != 0:
      ecs.insert alive pool meta i i
  let expected=#[i | i <- array.generate (masks.length*32) identity,(masks[i/32] >> (i%32))&1 != 0]
  return check.report #[check.words expected (ecs.indices alive pool)]

entry func test_point_grid_build_keeps_all_hash_chains_and_old_snapshots () => return do:
  let positions = array.generate 220 (func i => return math.vec3 (U32.to_f32 (i % 17) * 0.4 - 3.2) 0.0 (U32.to_f32 (i / 17) * 0.4 - 2.0))
  let heads:ResizeArray U32=#[]
  let points:ResizeArray grid.Point=#[]
  let storage= $grid.Storage {heads,points}
  let stored=grid.build_into storage $Nothing 0.4 16 positions
  let result=grid.read storage stored
  let old_heads=array.map identity result.heads
  let old_points=array.map identity result.points
  let expected=array.fill 16 0
  let ok=true
  for i in 0 .. positions.length:
    let point=old_points[i]
    let key=grid.bucket result.mask point.cx point.cz
    ok := self and point.next==expected[key]
    ok := self and codec.float_word point.x==codec.float_word positions[i].x and codec.float_word point.z==codec.float_word positions[i].z
    expected[key] := i+1
  let old_count=(grid.within result positions[12].x positions[12].z 0.0).length
  let grown=grid.push_stored storage stored positions[12]
  let current=grid.read storage grown
  return check.report #[check.holds ok,check.words expected old_heads,
    check.holds (old_points.length==positions.length and current.points.length==positions.length+1),
    check.holds (old_count+1==(grid.within current positions[12].x positions[12].z 0.0).length)]
// An exclusive writer can take over a nonzero range, then rebuild at zero.
entry func test_exclusive_point_grid_extends_a_packed_range_and_rebuilds () => return do:
  let heads: ResizeArray U32 = #[]
  let points: ResizeArray grid.Point = #[]
  let storage = $grid.Storage {heads, points}
  let at = math.vec3 3.0 0.0 4.0
  grid.build_into storage $Nothing 1.0 16 #[math.zero3]
  let packed = grid.build_into storage $Nothing 1.0 16 (array.fill 16 at)
  let (grown, next) = grid.append packed at storage
  let count = (grid.within (grid.read next grown) at.x at.z 0.0).length
  let (small, cleared) = grid.rebuild 1.0 16 #[at] next
  let (two, last) = grid.append small math.zero3 cleared
  let current = grid.read last two
  return check.report #[
    check.holds (packed.points.start > 0 and packed.heads.start > 0),
    check.words #[17, 0, 0, 2] #[count, small.points.start, small.heads.start, current.points.length],
    check.words #[0] (grid.within current at.x at.z 0.0),
    check.words #[1] (grid.within current 0.0 0.0 0.0),
  ]

entry func test_dense_membership_edits_preserve_order_and_previous_view () => return do:
  let alive:ecs.Entities=ecs.entities ()
  let alive_meta=ecs.metadata 9
  ecs.spawn_many alive alive_meta 1024
  let pool:ecs.Pool Counter=ecs.pool ()
  let meta=ecs.metadata 9
  let ids=array.generate 1024 identity
  ecs.insert_selected alive pool meta ids (array.map (func i => return $Counter i) ids)
  let before:ecs.Pool Counter=ecs.pool ()
  ecs.copy_into identity before pool
  for id in ids:
    if id%3==0:
      ecs.remove pool meta id
    else:
      ecs.write pool meta id ($Counter (id+10))
  let expected=#[i | i <- ids,i%3!=0]
  return check.report #[check.words ids (ecs.indices alive before),check.words expected (ecs.indices alive pool),
    check.holds (counter (ecs.read before 999)==999 and counter (ecs.read pool 999)==0xFFFFFFFF),
    check.holds (counter (ecs.read before 1000)==1000 and counter (ecs.read pool 1000)==1010)]

type Span is data = $Span {start:U32,count:U32}
entry func test_batch_queue_preserves_reference_payloads_and_snapshot () => return do:
  let source_payload:ResizeArray U32=#[]
  let requests=array.generate 32 (func i => return $Span {start:i*3,count:3})
  for i in 0 .. 32:
    for value in #[i,i*3,0xFFFFFFFF]:
      source_payload.push value
  let locals=array.generate 32 (func i => return $Span {start:96+i*2,count:2})
  for i in 0 .. 32:
    source_payload.push (i*7)
    source_payload.push (i+1)
  let payload:ResizeArray U32=#[]
  for value in source_payload:
    payload.push value
  let before:jobs.Queue [Span,Span,Span]=jobs.empty ()
  let before_meta=jobs.metadata 3 32 false
  let history:ResizeArray jobs.Mark=#[]
  let before_count=before.length
  let ($Some tickets,before_meta,history)=jobs.submit_many 1 1 requests locals before before_meta history else:
    return @panic "valid reference batch rejected"
  let individual:jobs.Queue [Span,Span,Span]=jobs.empty ()
  let individual_meta=jobs.metadata 3 32 false
  let individual_history:ResizeArray jobs.Mark=#[]
  for i in 0 .. requests.length:
    let ($Some ticket,submitted_meta,submitted_history)=jobs.submit 1 1 requests[i] locals[i] individual individual_meta individual_history else:
      return @panic "valid reference submission rejected"
    individual_meta := submitted_meta
    individual_history := submitted_history
  source_payload[0] := 99
  requests[0] := $Span {start:0,count:1}
  let encode_words=func span => return array.slice span.start span.count payload
  let batch_words=jobs.encode encode_words encode_words encode_words before before_meta
  let individual_words=jobs.encode encode_words encode_words encode_words individual individual_meta
  let first_request=encode_words before[0].request
  for i in 0 .. tickets.length:
    let start=payload.length
    payload.push i
    payload.push 0xFFFFFFFF
    let (settled,settled_queue,settled_meta,settled_history)=jobs.settle 2 tickets[i] ($jobs.Value ($Span {start,count:2})) before before_meta history
    if Bool.not settled:
      return @panic "valid reference completion rejected"
    before := settled_queue
    before_meta := settled_meta
    history := settled_history
  let (delivered,before,before_meta,history)=jobs.publish 2 before before_meta history
  return check.report #[check.words individual_words batch_words,
    check.words #[0,0,0xFFFFFFFF] first_request,
    check.words #[99] (array.slice requests[0].start requests[0].count source_payload),
    check.holds (before_count==0 and before.length==0),check.holds (delivered.length==requests.length)]
