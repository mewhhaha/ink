import * as check from "./check"
import * as ecs from "ink/ecs"
import * as array from "std/array"
import * as d from "ink/derived"

const equal = fn (a: U32) => fn (b: U32) => a == b
entry const lifecycle = fn () => do:
  let clock = d.clock 42 1
  let (clock, staff) = d.source 7 10 clock
  let old = staff
  let (clock, cached, a) = d.evaluate clock #[d.dependency staff] (fn () => staff.value * 2) (d.cache 2)
  let saved_cache = cached
  let (clock, cached, b) = d.evaluate clock #[d.dependency staff] (fn () => staff.value * 2) cached
  let (clock, staff) = d.replace_equal equal 10 staff clock
  let (clock, cached, c) = d.evaluate clock #[d.dependency staff] (fn () => staff.value * 2) cached
  let (clock, staff) = d.replace 99 staff clock
  let (clock, cached, changed) = d.evaluate clock #[d.dependency staff] (fn () => staff.value * 2) cached
  let (clock, staff) = d.replace old.value staff clock
  let (clock, cached, restored) = d.evaluate clock #[d.dependency staff] (fn () => staff.value * 2) cached
  let (forked, other) = d.replace 77 staff (d.fork 2 clock)
  let (forked, branch, branched) = d.evaluate forked #[d.dependency other] (fn () => other.value * 2) cached
  let (clock, downstream, chained) = d.evaluate clock #[d.result_dependency 8 cached] (fn () => restored + 1) (d.cache 1)
  let (forked, downstream, chained_branch) = d.evaluate forked #[d.result_dependency 8 branch] (fn () => branched + 1) downstream
  let (clock, evicted, warm) = d.evaluate clock #[d.dependency staff] (fn () => staff.value * 2) (d.evict cached)
  let old_value = case saved_cache.value of
    #Some value => value
    #Nothing => 0
  let cause = case branch.cause of
    #d.Changed key => key
    _ => 0
  return #[a, b, c, changed, restored, branched, chained, chained_branch, warm,
    cached.computes, cached.hits, downstream.computes, evicted.computes, old_value, cause]

entry const conditional = fn () => do:
  let (clock, a) = d.source 1 5 (d.clock 1 1)
  let (clock, b) = d.source 2 7 clock
  let (clock, cache, first) = d.evaluate clock #[d.dependency a] (fn () => a.value) (d.cache 2)
  let (clock, cache, second) = d.evaluate clock #[d.dependency b] (fn () => b.value) cache
  let (clock, b) = d.replace 8 b clock
  let (clock, cache, third) = d.evaluate clock #[d.dependency b] (fn () => b.value) cache
  return #[first, second, third, cache.computes]

entry const graph = fn () => do:
  let #Some order = d.order #[#[2], #[0], #[]] else:
    return #[]
  let cycles = if Maybe.is_some (d.order #[#[1], #[0]]) then 0 else 1
  let bad = if Maybe.is_some (d.order #[#[3]]) then 0 else 1
  return #[order[0], order[1], order[2], cycles, bad]

entry const exhaustion = fn () => do:
  let (clock, stamp) = d.issue (#d.Clock { region: 1, origin: 1, sequence: 4294967295 })
  return clock.sequence

entry const workload = fn (count: U32) => do:
  let (clock, source) = d.source 1 3 (d.clock 5 6)
  let cache = d.cache 1
  let sum = 0
  for i in 0 .. count:
    let (next, updated, value) = d.evaluate clock #[d.dependency source] (fn () => source.value * 2) cache
    clock := next
    cache := updated
    sum := self + value
  return #[sum, cache.computes, cache.hits]

type Staffing is data = #Staffing { clock: d.Clock, employment: d.Source (Array U32), capacity: d.Source U32, position: U32, cache: d.Cache U32 }
const total = fn (values: Array U32) => do:
  let sum = 0
  for value in values:
    sum := self + value
  return sum
const initial = do:
  let (clock, employment) = d.source 1 #[1, 2] (d.clock 9 1)
  let (clock, capacity) = d.source 2 10 clock
  break #Staffing { clock, employment, capacity, position: 0, cache: d.cache 2 }
const simulation = ecs.build (ecs.insert_resource initial (ecs.empty ()))
const update = fn (edit: U32) => do:
  use s <- ecs.get #Staffing
  if edit == 0:
    s.position := self + 1
  if edit == 1:
    let (clock, capacity) = d.replace_equal equal 10 s.capacity s.clock
    s.clock := clock
    s.capacity := capacity
  if edit >= 2:
    let values = case edit of
      2 => #[1, 3]
      3 => #[1, 3, 2]
      4 => #[3, 2]
      _ => #[1, 2]
    let (clock, employment) = d.replace values s.employment s.clock
    s.clock := clock
    s.employment := employment
  let reference = min s.capacity.value (total s.employment.value)
  let (clock, cache, result) = d.evaluate s.clock #[d.dependency s.employment, d.dependency s.capacity]
    (fn () => min s.capacity.value (total s.employment.value)) s.cache
  s.clock := clock
  s.cache := cache
  use ecs.set s
  return #[result, reference, cache.computes, cache.hits]
entry const staffing = fn () => do:
  let (world, first) = ecs.create simulation (fn () => update 0)
  let original = world
  let trace = first
  for edit in #[0, 1, 2, 3, 4, 5]:
    let (next, row) = ecs.run simulation world (fn () => update edit)
    world := next
    trace := array.concat self row
  let (_, old) = ecs.run simulation original (fn () => update 0)
  return array.concat trace old
entry const terrain = fn () => do:
  let (clock, height) = d.source 1 4 (d.clock 10 1)
  let (clock, cache, first) = d.evaluate clock #[d.dependency height] (fn () => height.value * 2) (d.cache 1)
  let saved = height
  let (clock, height) = d.replace 7 height clock
  let (clock, cache, second) = d.evaluate clock #[d.dependency height] (fn () => height.value * 2) cache
  let (clock, height) = d.replace saved.value height clock
  let (clock, cache, third) = d.evaluate clock #[d.dependency height] (fn () => height.value * 2) cache
  // An unrelated restored world can use the same counters, but a fresh region.
  let (other_clock, other) = d.source 1 9 (d.clock 11 1)
  let (other_clock, cache, last) = d.evaluate other_clock #[d.dependency other] (fn () => other.value * 2) cache
  let foreign = case cache.cause of
    #d.ForeignRegion => 1
    _ => 0
  return #[first, second, third, last, cache.computes, foreign]

// Paired cold/full-scan and warm validation workloads. Writes issue one stamp;
// warm validation visits one dependency regardless of employment row count.
entry const staffing_cached = fn (count: U32) => do:
  let (clock, source) = d.source 1 (array.generate count identity) (d.clock 12 1)
  let cache = d.cache 1
  let sum = 0
  for pass in 0 .. 32:
    let (next, updated, value) = d.evaluate clock #[d.dependency source] (fn () => total source.value) cache
    clock := next
    cache := updated
    sum := self + value
  return #[sum, cache.computes, cache.hits]
entry const staffing_uncached = fn (count: U32) => do:
  let values = array.generate count identity
  let sum = 0
  for pass in 0 .. 32:
    sum := self + total values
  return #[sum, 32, 0]

entry const test_derived_lifetimes = fn () => check.report #[
  check.words #[20,20,20,198,20,154,21,155,20,3,2,2,4,20,7] (lifecycle ()),
  check.words #[5,7,8,3] (conditional ()),
  check.words #[2,0,1,1,1] (graph ())]
entry const test_derived_crowd_noops = fn () => check.report #[check.words #[6 * n,1,n - 1] (workload n) | n <- #[1,100,10000]]
entry const test_derived_membership_and_restore = fn () => do:
  let rows = staffing ()
  let results = #[3,3,3,4,6,5,3,3]
  let computes = #[1,1,1,2,3,4,5,1]
  let checks = #[check.words #[8,14,8,18,4,1] (terrain ())]
  for i in 0 .. results.length:
    checks := array.push (check.words #[results[i],results[i],computes[i]] (array.slice (i * 4) 3 rows)) self
  for n in #[64,256,1024]:
    checks := array.concat self #[check.words #[16 * n * (n - 1),1,31] (staffing_cached n),check.words #[16 * n * (n - 1),32,0] (staffing_uncached n)]
  return check.report checks
entry const trap_derived_revision_exhaustion = fn () => #[U32.to_f32 (exhaustion ())]
