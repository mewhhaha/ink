import * as check from "./check"
import * as graphlib from "ink/graph"
import * as array from "std/array"
import * as d from "ink/derived"

func equal (a: U32) => func (b: U32) => a == b
entry func lifecycle () =>
  let dependencies: #[d.Dependency] = #[]
  let clock = d.clock 42 1
  let (clock, staff) = d.source 7 10 clock
  let old = staff
  let (clock, cached, a, dependencies) = d.evaluate clock #[d.dependency staff] (func () => staff.value * 2) (d.cache 2) dependencies
  let saved_cache = cached
  let (clock, cached, b, dependencies) = d.evaluate clock #[d.dependency staff] (func () => staff.value * 2) cached dependencies
  let (clock, staff) = d.replace_equal equal 10 staff clock
  let (clock, cached, c, dependencies) = d.evaluate clock #[d.dependency staff] (func () => staff.value * 2) cached dependencies
  let (clock, staff) = d.replace 99 staff clock
  let (clock, cached, changed, dependencies) = d.evaluate clock #[d.dependency staff] (func () => staff.value * 2) cached dependencies
  let (clock, staff) = d.replace old.value staff clock
  let (clock, cached, restored, dependencies) = d.evaluate clock #[d.dependency staff] (func () => staff.value * 2) cached dependencies
  let (forked, other) = d.replace 77 staff (d.branch 2 clock)
  let branch_dependencies: #[d.Dependency] = copy dependencies
  let (forked, branch, branched, branch_dependencies) = d.evaluate forked #[d.dependency other] (func () => other.value * 2) cached branch_dependencies
  let downstream_dependencies: #[d.Dependency] = #[]
  let (clock, downstream, chained, downstream_dependencies) = d.evaluate clock #[d.result_dependency 8 cached] (func () => restored + 1) (d.cache 1) downstream_dependencies
  let (forked, downstream, chained_branch, downstream_dependencies) = d.evaluate forked #[d.result_dependency 8 branch] (func () => branched + 1) downstream downstream_dependencies
  let evicted_dependencies: #[d.Dependency] = #[]
  let (clock, evicted, warm, evicted_dependencies) = d.evaluate clock #[d.dependency staff] (func () => staff.value * 2) (d.evict cached) evicted_dependencies
  let old_value = case saved_cache.value of
    $Some value => value
    $Nothing => 0
  let cause = case branch.cause of
    $d.Changed key => key
    _ => 0
  return #[a, b, c, changed, restored, branched, chained, chained_branch, warm,
    cached.computes, cached.hits, downstream.computes, evicted.computes, old_value, cause]
entry func conditional () =>
  let dependencies: #[d.Dependency] = #[]
  let (clock, a) = d.source 1 5 (d.clock 1 1)
  let (clock, b) = d.source 2 7 clock
  let (clock, cache, first, dependencies) = d.evaluate clock #[d.dependency a] (func () => a.value) (d.cache 2) dependencies
  let (clock, cache, second, dependencies) = d.evaluate clock #[d.dependency b] (func () => b.value) cache dependencies
  let (clock, b) = d.replace 8 b clock
  let (clock, cache, third, dependencies) = d.evaluate clock #[d.dependency b] (func () => b.value) cache dependencies
  return #[first, second, third, cache.computes]
entry func graph () =>
  let starts: #[U32] = #[0, 1, 2, 2]
  let targets: #[U32] = #[2, 0]
  let $Some order = d.order ($graphlib.Graph {starts: &starts[0..starts.length], targets: &targets[0..targets.length]}) else:
    return #[]
  let cycle_starts: #[U32] = #[0, 1, 2]
  let cycle_targets: #[U32] = #[1, 0]
  let bad_starts: #[U32] = #[0, 1]
  let bad_targets: #[U32] = #[3]
  let cycles = if Maybe.is_some (d.order ($graphlib.Graph {starts: &cycle_starts[0..cycle_starts.length], targets: &cycle_targets[0..cycle_targets.length]})) then 0 else 1
  let bad = if Maybe.is_some (d.order ($graphlib.Graph {starts: &bad_starts[0..bad_starts.length], targets: &bad_targets[0..bad_targets.length]})) then 0 else 1
  return #[order[0], order[1], order[2], cycles, bad]

entry func exhaustion () =>
  let (clock, stamp) = d.issue ($d.Clock { region: 1, origin: 1, sequence: 4294967295 })
  return clock.sequence

entry func workload (count: U32) =>
  let dependencies: #[d.Dependency] = #[]
  let (clock, source) = d.source 1 3 (d.clock 5 6)
  let cache = d.cache 1
  let sum = 0
  for i in 0 .. count:
    let (next, updated, value, next_deps) = d.evaluate clock #[d.dependency source] (func () => source.value * 2) cache dependencies
    clock := next
    cache := updated
    dependencies := next_deps
    sum := self + value
  return #[sum, cache.computes, cache.hits]

type Staffing = {clock: #[d.Clock], employment: #[U32], employment_source: #[d.Source U32], capacity: #[d.Source U32], position: #[U32], cache: #[d.Cache U32], dependencies: #[d.Dependency]}
func total values =>
  let sum = 0
  for value in values:
    sum := self + value
  return sum
func read_eval_inputs (s: Staffing) => (s.clock[0], s.cache[0], s.capacity[0].value, copy s.employment, #[d.dependency s.employment_source[0], d.dependency s.capacity[0]], min s.capacity[0].value (total s.employment))
func update (s: own Staffing) -> (edit: U32): (#[U32], Staffing) =>
  if edit == 0:
    s.position[0] := self + 1
  if edit == 1:
    let (clock, capacity) = d.replace_equal equal 10 s.capacity[0] s.clock[0]
    s.clock[0] := clock
    s.capacity[0] := capacity
  if edit >= 2:
    let values = case edit of
      2 => #[1, 3]
      3 => #[1, 3, 2]
      4 => #[3, 2]
      _ => #[1, 2]
    let (clock, employment) = d.replace values.length s.employment_source[0] s.clock[0]
    @storage.truncate s.employment 0
    for value in values:
      @storage.push s.employment value
    s.clock[0] := clock
    s.employment_source[0] := employment
  let (cur_clock, cur_cache, cap, emp, dep_list, reference) = read_eval_inputs s
  let { clock: clock_arr, employment, employment_source, capacity, position, cache: cache_arr, dependencies } = s
  let (clock, cache, result, deps) = d.evaluate cur_clock dep_list (func () => min cap (total emp)) cur_cache dependencies
  clock_arr[0] := clock
  cache_arr[0] := cache
  return (#[result, reference, cache.computes, cache.hits], { clock: clock_arr, employment, employment_source, capacity, position, cache: cache_arr, dependencies: deps })
entry func staffing () =>
  let (initial_clock, employment_value) = d.source 1 2 (d.clock 9 1)
  let (initial_clock, capacity_value) = d.source 2 10 initial_clock
  let clock: #[d.Clock] = #[initial_clock]
  let employment: #[U32] = #[1, 2]
  let employment_source: #[d.Source U32] = #[employment_value]
  let capacity: #[d.Source U32] = #[capacity_value]
  let position: #[U32] = #[0]
  let cache: #[d.Cache U32] = #[d.cache 2]
  let dependencies: #[d.Dependency] = #[]
  let state = {clock, employment, employment_source, capacity, position, cache, dependencies}
  let (first, state) = update state 0
  // Independently retained history copies every pool and its dependency payload.
  let original = {
    clock: copy state.clock,
    employment: copy state.employment,
    employment_source: copy state.employment_source,
    capacity: copy state.capacity,
    position: copy state.position,
    cache: copy state.cache,
    dependencies: copy state.dependencies,
  }
  let trace: #[U32] = #[]
  for value in first:
    @storage.push trace value
  for edit in #[0, 1, 2, 3, 4, 5]:
    state := do:
      let (row, next) = update self edit
      for value in row:
        @storage.push trace value
      break next
  let (old, _) = update original 0
  for value in old:
    @storage.push trace value
  return trace
entry func terrain () =>
  let dependencies: #[d.Dependency] = #[]
  let (clock, height) = d.source 1 4 (d.clock 10 1)
  let (clock, cache, first, dependencies) = d.evaluate clock #[d.dependency height] (func () => height.value * 2) (d.cache 1) dependencies
  let saved = height
  let (clock, height) = d.replace 7 height clock
  let (clock, cache, second, dependencies) = d.evaluate clock #[d.dependency height] (func () => height.value * 2) cache dependencies
  let (clock, height) = d.replace saved.value height clock
  let (clock, cache, third, dependencies) = d.evaluate clock #[d.dependency height] (func () => height.value * 2) cache dependencies
  // An unrelated restored world can use the same counters, but a fresh region.
  let (other_clock, other) = d.source 1 9 (d.clock 11 1)
  let (other_clock, cache, last, dependencies) = d.evaluate other_clock #[d.dependency other] (func () => other.value * 2) cache dependencies
  let foreign = case cache.cause of
    $d.ForeignRegion => 1
    _ => 0
  return #[first, second, third, last, cache.computes, foreign]

// Paired cold/full-scan and warm validation workloads. Writes issue one stamp;
// warm validation visits one dependency regardless of employment row count.
entry func staffing_cached (count: U32) =>
  let dependencies: #[d.Dependency] = #[]
  let values = array.generate count identity
  let (clock, source) = d.source 1 count (d.clock 12 1)
  let cache = d.cache 1
  let sum = 0
  for pass in 0 .. 32:
    let (next, updated, value, next_deps) = d.evaluate clock #[d.dependency source] (func () => total values) cache dependencies
    clock := next
    cache := updated
    dependencies := next_deps
    sum := self + value
  return #[sum, cache.computes, cache.hits]
entry func staffing_uncached (count: U32) =>
  let values = array.generate count identity
  let sum = 0
  for pass in 0 .. 32:
    sum := self + total values
  return #[sum, 32, 0]

entry func test_derived_lifetimes () => check.report #[
  check.words #[20,20,20,198,20,154,21,155,20,3,2,2,4,20,7] (lifecycle ()),
  check.words #[5,7,8,3] (conditional ()),
  check.words #[2,0,1,1,1] (graph ())]
entry func test_derived_crowd_noops () => check.report #[check.words #[6 * n,1,n - 1] (workload n) | n <- #[1,100,10000]]
entry func test_derived_membership_and_restore () =>
  let rows = staffing ()
  let results = #[3,3,3,4,6,5,3,3]
  let computes = #[1,1,1,2,3,4,5,1]
  let checks: #[check.Check] = #[check.words #[8,14,8,18,4,1] (terrain ())]
  for i in 0 .. results.length:
    @storage.push checks (check.words #[results[i],results[i],computes[i]] (array.slice (i * 4) 3 rows))
  for n in #[64,256,1024]:
    @storage.push checks (check.words #[16 * n * (n - 1),1,31] (staffing_cached n))
    @storage.push checks (check.words #[16 * n * (n - 1),32,0] (staffing_uncached n))
  return check.report checks
entry func trap_derived_revision_exhaustion () => #[U32.to_f32 (exhaustion ())]
