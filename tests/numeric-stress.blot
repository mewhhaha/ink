import * as math from "ink/math"
import * as transform from "ink/transform"
import * as camera from "ink/camera"
import * as color from "ink/color"
import * as lighting from "ink/lighting"
import * as environment from "ink/environment"
import * as shadow from "ink/shadow"
import * as animation from "ink/animation"
import * as audio from "ink/audio"
import * as time from "ink/time"
import * as random from "ink/random"
import * as noise from "ink/noise"
import * as motion from "ink/motion"
import * as particles from "ink/particles"
import * as steering from "ink/steering"
import * as array from "std/array"
func vec (a: Array F32) => return func (i: U32) => return math.vec3 a[i] a[i + 1] a[i + 2]
func lanes (v: math.Quat) => return #[v.x,v.y,v.z,v.w]
entry func rotations (a: Array F32) : Array F32 => return array.concat (lanes (math.axis_angle (vec a 0) a[3])) (lanes (math.look_rotation (vec a 0) (vec a 4)))
entry func sequence (seed: U32) : Array U32 => return do:
  let state = seed
  let result = @array.fill 4096 0
  for i in 0..4096:
    state := random.next self
    result[i] := state
  return result
entry func unit (seed: U32) : F32 => return random.unit seed
entry func noises (a: Array F32) : Array F32 => return do:
  let p = vec a 0
  let p2 = math.vec2 p.x p.y
  let seed = 3735928559
  return #[noise.perlin1 seed p.x,noise.perlin2 seed p2,noise.perlin3 seed p,noise.value2 seed p2,noise.fbm2 seed 6 p2,noise.fbm3 seed 6 p,noise.fbm2 seed 0 p2,noise.fbm3 seed 0 p,noise.at seed (F32.to_u32 a[3]) (F32.to_u32 a[4])]
entry func spring (a: Array F32) : Array F32 => return case motion.checked_spring ($motion.Spring { value: a[0],velocity: a[1] }) a[2] a[3] a[4] a[5] of
  $Nothing => #[]
  $Some s => #[s.value,s.velocity]
entry func fixed (a: Array F32) : Array F32 => return case time.fixed a[0] 8 a[1] a[2] of
  $Nothing => #[]
  $Some s => #[U32.to_f32 s.steps,s.remainder,s.alpha,s.dropped]
entry func timer (a: Array F32) : Array F32 => return case time.tick ($time.Timer { remaining: a[0] }) a[1] of
  $Nothing => #[]
  $Some s => do:
    let expired = 0.0
    if s.expired:
      expired := 1.0
    break #[s.timer.remaining,expired,s.overshoot]
entry func affine (a: Array F32) : Array F32 => return do:
  let parent = transform.affine3 ($transform.Pose3 { position: vec a 0,rotation: math.yaw_pitch a[3] a[4],scale: vec a 5 })
  let child = transform.affine3 ($transform.Pose3 { position: vec a 8,rotation: math.yaw_pitch a[11] a[12],scale: vec a 13 })
  let basis = transform.compose3 parent child
  let p = transform.point3 basis (vec a 16)
  let nested = transform.point3 parent (transform.point3 child (vec a 16))
  return case transform.inverse3 basis of
    $Nothing => #[]
    $Some inverse => do:
      let restored = transform.point3 inverse p
      break #[p.x,p.y,p.z,nested.x,nested.y,nested.z,restored.x,restored.y,restored.z]
entry func lens (a: Array F32) : Array F32 => return do:
  let projection = $camera.Perspective { fov_y: a[0],aspect: a[1],near: a[2],far: a[3],reversed: a[4] > 0.0 }
  if a[5] > 0.0:
    projection := $camera.Orthographic { height: a[0],aspect: a[1],near: a[2],far: a[3],reversed: a[4] > 0.0 }
  let c = $camera.Camera { position: vec a 6,rotation: math.yaw_pitch a[9] a[10],projection }
  let world = c.position + math.Quat.rotate c.rotation (vec a 11)
  return case camera.project c world of
    $Nothing => #[]
    $Some p => case camera.unproject c p of
      $Nothing => #[]
      $Some restored => case camera.pick_ray c p.x p.y of
        $Nothing => #[]
        $Some ray => do:
          let f = camera.frustum c
          let visible = 0.0
          if camera.sphere_visible f world 0.0:
            visible := 1.0
          let lengths = @array.generate f.planes.length (func (i: U32) => return f.planes[i].normal.length)
          break array.concat #[world.x,world.y,world.z,restored.x,restored.y,restored.z,ray.direction.x,ray.direction.y,ray.direction.z,visible,p.x,p.y,p.z] lengths
entry func cascade (a: Array F32) : Array F32 => return do:
  let corners = @array.generate 8 (func (i: U32) => return do:
    let x = a[6]
    let y = a[7]
    let z = a[8]
    if (i & 1) == 0:
      x := F32.neg self
    if (i & 2) == 0:
      y := F32.neg self
    if (i & 4) == 0:
      z := F32.neg self
    return math.vec3 (a[3] + x) (a[4] + y) (a[5] + z))
  return case shadow.fit corners (vec a 0) (F32.to_u32 a[9]) a[10] of
    $Nothing => #[]
    $Some c => @array.generate 24 (func (i: U32) => return case camera.project c corners[i / 3] of
      $Nothing => 999.0
      $Some p => do:
        if i % 3 == 0:
          break p.x
        if i % 3 == 1:
          break p.y
        break p.z)
entry func display (a: Array F32) : Array F32 => return do:
  let c = math.rgba a[0] a[1] a[2] a[3]
  let encoded = color.srgb (color.linear c)
  let mapped = color.display a[4] c
  return #[encoded.r,encoded.g,encoded.b,encoded.a,mapped.r,mapped.g,mapped.b,mapped.a,color.exp2 a[5],color.log2 a[6]]
entry func irradiance (a: Array F32) : Array F32 => return do:
  let directions = #[math.right,math.right * (-1.0),math.up,math.up * (-1.0),math.forward,math.forward * (-1.0)]
  let samples = @array.generate 6 (func (i: U32) => return $environment.Sample { direction: directions[i],radiance: math.rgb a[0] a[1] a[2],solid_angle: 2.0943951 })
  let result = environment.evaluate (environment.integrate samples) (vec a 3)
  return #[result.r,result.g,result.b]
entry func local_light (a: Array F32) : Array F32 => return do:
  let light = $lighting.Point { position: vec a 0,intensity: math.rgb a[3] a[4] a[5],range: a[6] }
  let s = lighting.sample light math.zero3
  return #[s.direction.x,s.direction.y,s.direction.z,s.radiance.r,s.radiance.g,s.radiance.b]
entry func sound (a: Array F32) : Array F32 => return do:
  let listener = $audio.Listener { position: math.zero3,velocity: vec a 3,right: math.right }
  let emitter = $audio.Emitter { position: vec a 0,velocity: vec a 6,gain: a[9] }
  return case audio.mix audio.default_config listener emitter (a[10] > 0.0) of
    $Nothing => #[]
    $Some s => #[s.gain,s.pan,s.rate,s.cutoff,audio.fade a[11] a[12] a[13] a[14]]
func pose (x: F32) => return $transform.Pose3 { position: math.vec3 x 0.0 0.0,rotation: math.axis_angle math.up (x * 0.1),scale: math.one3 }
const clip_keys = #[$animation.Key {time: 0.0,pose: pose 0.0},$animation.Key {time: 1.0,pose: pose 10.0}]
const clip_tracks = #[$animation.Track {start: 0,count: clip_keys.length}]
const clip_events = #[{time: 0.0,id: 7},{time: 0.25,id: 9},{time: 0.75,id: 13}]
const clip = $animation.Clip {duration: 1.0,keys: clip_keys.view 0 clip_keys.length,tracks: clip_tracks.view 0 clip_tracks.length,events: clip_events.view 0 clip_events.length}
entry func root (a: Array F32) : Array F32 => return do:
  let result = animation.root_motion clip a[0] a[1] true
  let found = animation.events clip a[0] a[1] true
  return array.concat #[result.translation.x,result.rotation.x,result.rotation.y,result.rotation.z,result.rotation.w] (@array.generate found.length (func (i: U32) => return U32.to_f32 found[i]))
entry func ballistic (a: Array F32) : Array F32 => return do:
  let p: particles.Particle = { x: a[0],y: a[1],z: a[2],vx: a[3],vy: a[4],vz: a[5],age: a[6],lifetime: 1000.0,size: 1.0,rotation: 0.0,seed: 4294967295 }
  let result = particles.update #[p] (vec a 7) a[10]
  if result.is_empty:
    return #[]
  let next = result[0]
  return #[next.x,next.y,next.z,next.vx,next.vy,next.vz,next.age,U32.to_f32 (particles.frame next.seed next.age 12.0 13 true)]
entry func chase (a: Array F32) : Array F32 => return do:
  let p = vec a 0
  let v = vec a 3
  let desired = steering.arrive p (vec a 6) a[9] a[10] a[11]
  let acceleration = steering.accelerate v desired a[12] a[13]
  let separation = steering.separation p #[p,p + math.right,p - math.right,p + math.up * 0.5] 2.0 a[13]
  return #[desired.x,desired.y,desired.z,acceleration.x,acceleration.y,acceleration.z,separation.x,separation.y,separation.z]
entry func normalize_quaternion (a: Array F32) : Array F32 => return lanes (math.Quat.normalized ($math.Quat { x: a[0],y: a[1],z: a[2],w: a[3] }))
entry func event_workload (a: Array F32) : Array U32 => return do:
  let duration = 1.0
  if a.length > 3:
    duration := a[3]
  let count = 512
  if a.length > 4:
    count := F32.to_u32 a[4]
  let events = @array.generate count (func (i: U32) => return {time: (U32.to_f32 i / U32.to_f32 count) * duration,id: 2147483648 + i})
  let tracks: Array animation.Track = #[]
  let keys: Array animation.Key = #[]
  let authored = $animation.Clip {duration,keys: keys.view 0 0,tracks: tracks.view 0 0,events: events.view 0 events.length}
  return animation.events authored a[0] a[1] (a[2] > 0.0)
