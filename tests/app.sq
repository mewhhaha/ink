import * as clock from "ink/clock"
import * as app from "ink/app"
import * as array from "std/array"
import * as test from "std/test"
import * as ecs from "ink/ecs"
import * as input from "ink/input"
import * as lanes from "ink/lanes"
import * as persist from "ink/persist"
import * as events from "ink/events"
import * as fixture from "./fixtures/lifecycle_app"
// A persistent app world (packages/app.sq): transient resources, its own
// and those a gated plugin adds, start each frame afresh, whether or not the
// frame runs a fixed update, while saved resources (the input) carry on; and
// a world restored from its lanes starts its transients afresh too.

@[test.suite]
test "a new world starts with its transients":
  let obs = fixture.with_access (func access => fixture.observe access)
  use test.near_array "initial observe" 0.0 #[7.0, 10.0, 0.0, 0.0] obs
  return ()

@[test.suite]
test "explicit preview copy discards state and outbox without advancing the live world":
  let (before, result, repeated, unchanged, after) = fixture.with_access (func live =>
    let before = fixture.observe live
    let result = fixture.with_copy live (func preview =>
      preview := fixture.update preview 0.5
      return #[U32.to_f32 preview.scratch[0], if persist.has preview.requests $persist.Save then 1.0 else 0.0])
    let repeated = fixture.with_copy live (func preview =>
      preview := fixture.update preview 0.5
      return #[U32.to_f32 preview.scratch[0]])
    let unchanged = fixture.observe live
    live := fixture.frame live (1.0 / 60.0) #[]
    return (before, result, repeated, unchanged, fixture.observe live))
  use test.near_array "preview result" 0.0 #[8.0, 1.0] result
  use test.near_array "live unchanged" 0.0 before unchanged
  use test.near_array "repeated preview" 0.0 #[8.0] repeated
  use test.near_array "live after frame" 0.0 #[8.0, 12.0, 1.0, 1.0] after
  return ()

@[test.suite]
test "a frame runs its fixed update on fresh transients":
  let obs = fixture.with_access (func access =>
    access := fixture.setup access 1
    return fixture.observe access)
  use test.near_array "after fixed update" 0.0 #[8.0, 12.0, 1.0, 1.0] obs
  return ()

@[test.suite]
test "a frame without an update still resets the transients":
  let obs = fixture.with_access (func access =>
    access := fixture.setup access 2
    return fixture.observe access)
  use test.near_array "reset without update" 0.0 #[7.0, 10.0, 1.0, 0.0] obs
  return ()

@[test.suite]
test "transients reset once a frame not once an update":
  let obs = fixture.with_access (func access =>
    access := fixture.setup access 3
    return fixture.observe access)
  use test.near_array "multi-step frame" 0.0 #[9.0, 14.0, 3.0, 1.0] obs
  return ()

@[test.suite]
test "a restored world keeps saved resources and starts transients afresh":
  let obs = fixture.with_access (func access =>
    access := fixture.setup access 3
    let saved = input.encode (input.read access.input_pointer access.input_held access.input_fresh access.input_buttons)
    return fixture.with_access (func (own restored) =>
      let (ptr, held, fresh, buttons) = input.decode_into saved restored.input_pointer restored.input_held restored.input_fresh restored.input_buttons
      restored.input_pointer := ptr
      restored.input_held := held
      restored.input_fresh := fresh
      restored.input_buttons := buttons
      return fixture.observe restored))
  use test.near_array "restored observe" 0.0 #[7.0, 10.0, 3.0, 0.0] obs
  return ()

@[test.suite]
test "contact holds the entire frame without pausing or catching up":
  let (held, held_values, timing_after, obs_after) = fixture.with_access (func access =>
    access.clock[0] := $clock.Clock {tick: 12, remainder: 0.007}
    access := fixture.frame access 0.25 #[$events.KeyDown 42]
    let held = fixture.timing access
    let held_values = fixture.observe access
    access := fixture.frame access 0.016666667 #[]
    return (held, held_values, fixture.timing access, fixture.observe access))
  use test.near_array "held timing" 0.0 #[12.0, 0.007, 0.0] held
  use test.near_array "timing after hold" 0.000001 #[13.0, 0.007, 0.0] timing_after
  use test.near_array "held values" 0.0 #[7.0, 10.0, 0.0, 0.0] held_values
  use test.near_array "observe after hold" 0.0 #[8.0, 12.0, 1.0, 1.0] obs_after
  return ()

@[test.suite]
test "contact on a frame without a fixed step is consumed":
  let timing = fixture.with_access (func access =>
    access := fixture.frame access 0.0 #[$events.KeyDown 42]
    let (result, moved) = app.advance fixture.application access fixture.policy 0.016666667 #[] 960.0 640.0
    access := moved
    return fixture.timing access)
  use test.near_array "timing" 0.0 #[1.0, 0.0, 0.0] timing
  return ()
