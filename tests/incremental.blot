import * as check from "./check"
import * as array from "std/array"
import * as changes from "ink/changes"
import * as pages from "ink/pages"

entry const composition = fn () => do:
  let a = changes.make #True #[3, 1, 3, 0xFFFFFFFF] #[2]
  let b = changes.make #False #[2, 4] #[1, 3]
  let c = changes.compose a b
  return array.concat #[if c.reset then 1 else 0, c.updated.length, c.removed.length] (array.concat c.updated c.removed)
entry const snapshots = fn () => do:
  let before = pages.from (array.generate 130 identity)
  let changed = pages.update 131 #[64, 64, 129, 999] (fn i => i + 1000) before
  let small = pages.update 65 #[] (fn i => i) changed
  let grown = pages.update 131 #[] (fn i => i + 2000) small
  return #[pages.get before 64, pages.get changed 64, pages.get changed 63, pages.get changed 129,
    pages.get changed 130, pages.get small 64, pages.get grown 65, pages.get grown 130, before.count]
entry const workload = fn (count: U32) => do:
  let before = pages.from (array.generate count identity)
  let current = before
  let change = changes.make #False #[count / 2, count / 2, count - 1] #[]
  for step in 0 .. 32:
    current := pages.update count (changes.affected change) (fn i => i + step) self
  return #[pages.get before (count - 1), pages.get current (count - 1), pages.get current (count / 2)]

entry const test_change_composition = fn () => check.report #[check.words #[1,3,2,2,4,4294967295,1,3] (composition ())]
entry const test_paged_snapshots_and_regrowth = fn () => check.report (array.concat
  #[check.words #[64,1064,63,1129,1130,1064,2065,2130,130] (snapshots ())]
  #[check.words #[count - 1,count + 30,count / 2 + 31] (workload count) | count <- #[64,1024,65536]])
