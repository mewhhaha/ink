import * as test from "std/test"
import * as array from "std/array"
import * as changes from "ink/changes"
import * as pages from "ink/pages"

#entry func composition () =>
  let a = changes.borrow true #[3, 1, 3, 0xFFFFFFFF] #[2]
  let b = changes.borrow false #[2, 4] #[1, 3]
  let updated: #[U32] = #[]
  let removed: #[U32] = #[]
  let c = changes.compose_into a b updated removed
  return array.concat #[if c.reset then 1 else 0, c.updated.length, c.removed.length] (array.concat c.updated c.removed)
#entry func snapshots () =>
  let before = pages.from (array.generate 130 identity)
  let changed = pages.copy_using identity before
  changed := pages.update 131 #[64, 64, 129, 999] (func i => i + 1000) changed
  let small = pages.copy_using identity changed
  small := pages.update 65 #[] (func i => i) small
  let grown = pages.copy_using identity small
  grown := pages.update 131 #[] (func i => i + 2000) grown
  return #[pages.get before 64, pages.get changed 64, pages.get changed 63, pages.get changed 129,
    pages.get changed 130, pages.get small 64, pages.get grown 65, pages.get grown 130, pages.count before]
#entry func workload (count: U32) =>
  let before = pages.from (array.generate count identity)
  let current = pages.copy_using identity before
  let change = changes.borrow false #[count / 2, count / 2, count - 1] #[]
  for step in 0 .. 32:
    current := pages.update count (changes.affected change) (func i => i + step) current
  return #[pages.get before (count - 1), pages.get current (count - 1), pages.get current (count / 2)]

@[test.suite]
test "change composition":
  let c = composition ()
  use test.eq "composed batch" #[1, 3, 2, 2, 4, 4294967295, 1, 3] c
  return ()

@[test.suite]
test "explicit page copies and regrowth":
  let s = snapshots ()
  use test.eq "snapshots" #[64, 1064, 63, 1129, 1130, 1064, 2065, 2130, 130] s
  for count in #[64, 1024, 65536]:
    let w = workload count
    use test.eq "workload" #[count - 1, count + 30, count / 2 + 31] w
  return ()
