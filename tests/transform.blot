import * as array from "std/array"
import * as math from "ink/math"
import * as transform from "ink/transform"

func vec2 (a: Array F32) => return func (i: U32) => return math.vec2 a[i] a[i + 1]
func vec3 (a: Array F32) => return func (i: U32) => return math.vec3 a[i] a[i + 1] a[i + 2]
func basis2 (a: Array F32) => return func (i: U32) => return $transform.Affine2 { position: vec2 a i, x: vec2 a (i + 2), y: vec2 a (i + 4) }
func basis3 (a: Array F32) => return func (i: U32) => return $transform.Affine3 { position: vec3 a i, x: vec3 a (i + 3), y: vec3 a (i + 6), z: vec3 a (i + 9) }
func lanes2 (v: transform.Affine2) => return #[v.position.x, v.position.y, v.x.x, v.x.y, v.y.x, v.y.y]
func lanes3 (v: transform.Affine3) => return #[v.position.x, v.position.y, v.position.z, v.x.x, v.x.y, v.x.z, v.y.x, v.y.y, v.y.z, v.z.x, v.z.y, v.z.z]

entry func affine2 (a: Array F32) : Array F32 => return do:
  let value = transform.compose2 (basis2 a 0) (basis2 a 6)
  let p = transform.point2 value (vec2 a 12)
  let v = transform.vector2 value (vec2 a 12)
  let inverse = case transform.inverse2 value of
    $Nothing => #[0.0]
    $Some result => array.concat #[1.0] (lanes2 result)
  return array.concat (array.concat (lanes2 value) #[p.x, p.y, v.x, v.y]) inverse

entry func affine3 (a: Array F32) : Array F32 => return do:
  let value = transform.compose3 (basis3 a 0) (basis3 a 12)
  let p = transform.point3 value (vec3 a 24)
  let v = transform.vector3 value (vec3 a 24)
  let inverse = case transform.inverse3 value of
    $Nothing => #[0.0]
    $Some result => array.concat #[1.0] (lanes3 result)
  return array.concat (array.concat (lanes3 value) #[p.x, p.y, p.z, v.x, v.y, v.z]) inverse

func pose2 (a: Array F32) => return func (i: U32) => return $transform.Pose2 { position: vec2 a i, angle: a[i + 2], scale: vec2 a (i + 3) }
func pose3 (a: Array F32) => return func (i: U32) => return $transform.Pose3 {
  position: vec3 a i,
  rotation: $math.Quat { x: a[i + 3], y: a[i + 4], z: a[i + 5], w: a[i + 6] },
  scale: vec3 a (i + 7),
}

entry func interpolate2 (a: Array F32) : Array F32 => return do:
  let pose = transform.lerp2 (pose2 a 0) (pose2 a 5) a[10]
  return array.concat #[pose.position.x, pose.position.y, pose.angle, pose.scale.x, pose.scale.y] (lanes2 (transform.affine2 pose))

entry func interpolate3 (a: Array F32) : Array F32 => return do:
  let pose = transform.lerp3 (pose3 a 0) (pose3 a 10) a[20]
  return array.concat #[pose.position.x, pose.position.y, pose.position.z, pose.rotation.x, pose.rotation.y, pose.rotation.z, pose.rotation.w, pose.scale.x, pose.scale.y, pose.scale.z] (lanes3 (transform.affine3 pose))

entry func identity (unused: Array F32) : Array F32 => return array.concat (lanes2 transform.identity2) (lanes3 transform.identity3)


// Current/previous pools have independent ownership; writes after checkpoint
// cannot turn interpolation into an alias of the current pose.
entry func checkpoint (value: F32) : Array F32 => return do:
  let current = #[$Some (transform.from_xyz value 0.0 0.0)]
  let previous = #[$Nothing]
  transform.checkpoint current previous
  current[0] = $Some (transform.from_xyz (value + 1.0) 0.0 0.0)
  let $Some before = previous[0] else:
    return #[]
  let $Some after = current[0] else:
    return #[]
  return #[before.position.x, after.position.x]
