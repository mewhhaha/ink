import * as array from "std/array"
import * as math from "ink/math"
import * as transform from "ink/transform"

const vec2 = fn (a: Array F32) => fn (i: U32) => math.vec2 a[i] a[i + 1]
const vec3 = fn (a: Array F32) => fn (i: U32) => math.vec3 a[i] a[i + 1] a[i + 2]
const basis2 = fn (a: Array F32) => fn (i: U32) => #transform.Affine2 { position: vec2 a i, x: vec2 a (i + 2), y: vec2 a (i + 4) }
const basis3 = fn (a: Array F32) => fn (i: U32) => #transform.Affine3 { position: vec3 a i, x: vec3 a (i + 3), y: vec3 a (i + 6), z: vec3 a (i + 9) }
const lanes2 = fn (v: transform.Affine2) => #[v.position.x, v.position.y, v.x.x, v.x.y, v.y.x, v.y.y]
const lanes3 = fn (v: transform.Affine3) => #[v.position.x, v.position.y, v.position.z, v.x.x, v.x.y, v.x.z, v.y.x, v.y.y, v.y.z, v.z.x, v.z.y, v.z.z]

entry const affine2 = fn (a: Array F32) -> Array F32 => do:
  let value = transform.compose2 (basis2 a 0) (basis2 a 6)
  let p = transform.point2 value (vec2 a 12)
  let v = transform.vector2 value (vec2 a 12)
  let inverse = case transform.inverse2 value of
    #Nothing => #[0.0]
    #Some result => array.concat #[1.0] (lanes2 result)
  return array.concat (array.concat (lanes2 value) #[p.x, p.y, v.x, v.y]) inverse

entry const affine3 = fn (a: Array F32) -> Array F32 => do:
  let value = transform.compose3 (basis3 a 0) (basis3 a 12)
  let p = transform.point3 value (vec3 a 24)
  let v = transform.vector3 value (vec3 a 24)
  let inverse = case transform.inverse3 value of
    #Nothing => #[0.0]
    #Some result => array.concat #[1.0] (lanes3 result)
  return array.concat (array.concat (lanes3 value) #[p.x, p.y, p.z, v.x, v.y, v.z]) inverse

const pose2 = fn (a: Array F32) => fn (i: U32) => #transform.Pose2 { position: vec2 a i, angle: a[i + 2], scale: vec2 a (i + 3) }
const pose3 = fn (a: Array F32) => fn (i: U32) => #transform.Pose3 {
  position: vec3 a i,
  rotation: #math.Quat { x: a[i + 3], y: a[i + 4], z: a[i + 5], w: a[i + 6] },
  scale: vec3 a (i + 7),
}

entry const interpolate2 = fn (a: Array F32) -> Array F32 => do:
  let pose = transform.lerp2 (pose2 a 0) (pose2 a 5) a[10]
  return array.concat #[pose.position.x, pose.position.y, pose.angle, pose.scale.x, pose.scale.y] (lanes2 (transform.affine2 pose))

entry const interpolate3 = fn (a: Array F32) -> Array F32 => do:
  let pose = transform.lerp3 (pose3 a 0) (pose3 a 10) a[20]
  return array.concat #[pose.position.x, pose.position.y, pose.position.z, pose.rotation.x, pose.rotation.y, pose.rotation.z, pose.rotation.w, pose.scale.x, pose.scale.y, pose.scale.z] (lanes3 (transform.affine3 pose))

entry const identity = fn (unused: Array F32) -> Array F32 => array.concat (lanes2 transform.identity2) (lanes3 transform.identity3)
