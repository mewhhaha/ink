import { Vec3 } from "std/vector"
import * as math from "ink/math"
import * as tween from "ink/tween"

type Phase is data = #Idle | #Walk | #Run

const phase_index = fn (phase: Phase) -> F32 => case phase of
  #Idle => 0.0
  #Walk => 1.0
  #Run => 2.0

const bit = fn (value: Bool) -> F32 => if value then 1.0 else 0.0

// Every easing at linear progress `t`, in declaration order, then Steps 0, 1
// and 3.
entry const eases = fn (t: F32) -> Array F32 => #[
  tween.eased #tween.Linear t,
  tween.eased #tween.Smooth t,
  tween.eased #tween.Smoother t,
  tween.eased #tween.CubicIn t,
  tween.eased #tween.CubicOut t,
  tween.eased #tween.CubicInOut t,
  tween.eased #tween.Back t,
  tween.eased #tween.Hold t,
  tween.eased (#tween.Steps 4) t,
  tween.eased (#tween.Steps 0) t,
  tween.eased (#tween.Steps 1) t,
  tween.eased (#tween.Steps 3) t,
]

// Lanes: start, duration, time. A linear 2 -> 10 tween's value, progress,
// done and end, or [0] when make refuses.
entry const scalar = fn (lanes: Array F32) -> Array F32 => do:
  let #Some value = tween.make 2.0 10.0 lanes[0] lanes[1] #tween.Linear else:
    return #[0.0]
  let time = lanes[2]
  return #[1.0, tween.at value time, tween.progress value time, bit (tween.done value time), tween.ends value]

// Lanes: interruption time, sample time. A Smooth 0 -> 10 tween over [0, 4]
// redirected toward 20 over 2 seconds.
entry const toward = fn (lanes: Array F32) -> Array F32 => do:
  let #Some first = tween.make 0.0 10.0 0.0 4.0 #tween.Smooth else:
    return #[0.0]
  let #Some second = tween.toward first lanes[0] 20.0 2.0 #tween.CubicOut else:
    return #[0.0]
  return #[1.0, tween.at first lanes[0], tween.at second lanes[0], tween.at second lanes[1], second.start, second.duration, second.from, second.to]

// Lanes: ease (0 Linear, 1 CubicIn), time. A 0 -> 10 tween over [1, 3] and
// its reversal at the same time.
entry const reversed = fn (lanes: Array F32) -> Array F32 => do:
  let ease = if lanes[0] == 0.0 then #tween.Linear else #tween.CubicIn
  let #Some forward = tween.make 0.0 10.0 1.0 2.0 ease else:
    return #[0.0]
  let backward = tween.reversed forward
  return #[tween.at forward lanes[1], tween.at backward lanes[1], backward.from, backward.to, backward.start, backward.duration]

// Lanes: duration, time, ease (0 Linear, 1 Back). Idle -> Run.
entry const variant = fn (lanes: Array F32) -> F32 => do:
  let ease = if lanes[2] == 0.0 then #tween.Linear else #tween.Back
  let #Some phases = tween.make (#tween.Discrete #Idle) (#tween.Discrete #Run) 0.0 lanes[0] ease else:
    return (-1.0)
  let #tween.Discrete phase = tween.at phases lanes[1]
  return phase_index phase

// Lanes: start, duration, time. A held count, 3 -> 7.
entry const count = fn (lanes: Array F32) -> U32 => do:
  let #Some counts = tween.make (#tween.Discrete 3) (#tween.Discrete 7) lanes[0] lanes[1] #tween.Smoother else:
    return 0
  let #tween.Discrete value = tween.at counts lanes[2]
  return value

entry const vector = fn (time: F32) -> Array F32 => do:
  let #Some moving = tween.make math.zero3 (math.vec3 2.0 (-4.0) 6.0) 0.0 2.0 #tween.Linear else:
    return #[]
  let p = tween.at moving time
  return #[p.x, p.y, p.z]

// Lanes: a (xyzw), b (xyzw), t.
entry const slerp = fn (lanes: Array F32) -> Array F32 => do:
  let a = #math.Quat { x: lanes[0], y: lanes[1], z: lanes[2], w: lanes[3] }
  let b = #math.Quat { x: lanes[4], y: lanes[5], z: lanes[6], w: lanes[7] }
  let q = math.Quat.slerp a b lanes[8]
  return #[q.x, q.y, q.z, q.w]

// Lanes: angle about +Y, ease (0 Linear, 1 Smooth), time. A rotation tween
// from identity over [0, 1].
entry const turning = fn (lanes: Array F32) -> Array F32 => do:
  let ease = if lanes[1] == 0.0 then #tween.Linear else #tween.Smooth
  let #Some turn = tween.make math.identity_quat (math.axis_angle math.up lanes[0]) 0.0 1.0 ease else:
    return #[]
  let q = tween.at turn lanes[2]
  return #[q.x, q.y, q.z, q.w]

// A type of the fixture's own, tweened through its own lerp: the level
// interpolates and the glow takes the brighter end.
type Gauge is data = #Gauge { level: F32, glow: F32 }

const Gauge.lerp = fn (a: Gauge) => fn (b: Gauge) => fn (t: F32) => #Gauge { level: F32.lerp a.level b.level t, glow: max a.glow b.glow }

entry const gauge = fn (time: F32) -> Array F32 => do:
  let #Some filling = tween.make (#Gauge { level: 0.0, glow: 0.25 }) (#Gauge { level: 8.0, glow: 1.0 }) 0.0 2.0 #tween.Linear else:
    return #[]
  let value = tween.at filling time
  return #[value.level, value.glow]
