import * as bt from "ink/ai/bt"
import * as goap from "ink/ai/goap"
import * as perception from "ink/ai/perception"
import * as utility from "ink/ai/utility"
import * as attributes from "ink/gameplay/attributes"
import * as tags from "ink/gameplay/tags"
import * as links from "ink/navigation/links"
import * as voxel from "ink/navigation/voxel"
import * as math from "ink/math"
import * as test from "std/test"

@[test.suite]
test "off mesh links and dynamic carving":
  // 4 polygons in a line: 0 -- 1 -- 2 -- 3, plus a jump link 0 -> 3 (flag 2, cost 1.5).
  let centers = #[math.vec3 0.0 0.0 0.0, math.vec3 2.0 0.0 0.0, math.vec3 4.0 0.0 0.0, math.vec3 6.0 0.0 0.0]
  let radii = #[0.5, 0.5, 0.5, 0.5]
  let offsets = #[0, 1, 3, 5, 6]
  let neighbors = #[1, 0, 2, 1, 3, 2]
  let obs = #[$links.Circle { center: math.vec3 2.0 0.0 0.0, radius: 0.6 }]
  let blocked = links.carve_mask centers radii obs
  let off_links = #[$links.Link { from_poly: 0, to_poly: 3, start: centers[0], end: centers[3], cost: 1.5, flags: 2, bidirectional: false }]
  // Without jump capability (flags=0), polygon 1 is blocked so path fails.
  let $Some no_jump = links.search centers offsets neighbors blocked off_links 0 0 3 else:
    use test.holds "check 1" false
    return ()
  // With jump capability (flags=2), takes the off-mesh link directly.
  let $Some with_jump = links.search centers offsets neighbors blocked off_links 2 0 3 else:
    use test.holds "check 1" false
    return ()
  let _v1 = (blocked[1] and not blocked[0] and not blocked[3])
  use test.holds "check 1" _v1
  let _v2 = (not no_jump.found)
  use test.holds "check 2" _v2
  let _v3 = (with_jump.found and with_jump.steps.length == 2)
  use test.holds "check 3" _v3
  let _v4 = 0.001
  let _v5 = #[1.5]
  let _v6 = #[with_jump.cost]
  use test.near_array "check 4" _v4 _v5 _v6
  return ()

@[test.suite]
test "voxel navmesh bake separates elevated ledges":
  // Two flat walkable quads: low floor (y=0, x in [0,4]) and high ledge (y=3, x in [4,8]).
  let verts = #[
    math.vec3 0.0 0.0 0.0, math.vec3 4.0 0.0 0.0, math.vec3 4.0 0.0 4.0, math.vec3 0.0 0.0 4.0,
    math.vec3 4.0 3.0 0.0, math.vec3 8.0 3.0 0.0, math.vec3 8.0 3.0 4.0, math.vec3 4.0 3.0 4.0,
  ]
  // Winding CCW from +Y so cross(b-a, c-a) has +Y normal.
  let indices = #[0, 2, 1, 0, 3, 2, 4, 6, 5, 4, 7, 6]
  let cfg = $voxel.Config {
    origin: math.zero3, cell_size: 1.0, width: 8, depth: 4,
    max_slope_cos: 0.7, max_step: 0.5, agent_radius: 0.0,
  }
  let $Some field = voxel.bake cfg verts indices else:
    use test.holds "check 1" false
    return ()
  // Low (x=1,z=1) and high (x=6,z=1) must be walkable in two distinct regions.
  let r_low = field.regions[1 * 8 + 1]
  let r_high = field.regions[1 * 8 + 6]
  let _v7 = #[2]
  let _v8 = #[field.region_count]
  use test.eq "check 1" _v7 _v8
  let _v9 = (field.walkable[9] and field.walkable[14] and r_low != r_high)
  use test.holds "check 2" _v9
  let _v10 = 0.001
  let _v11 = #[0.0, 3.0]
  let _v12 = #[field.heights[9], field.heights[14]]
  use test.near_array "check 3" _v10 _v11 _v12
  return ()

@[test.suite]
test "behavior tree sequence running and cooldown":
  // Node 0: Cooldown(1.0s) -> Node 1: Sequence(Node 2 Cond(0), Node 3 Action(1))
  let tree = $bt.Tree {
    root: 0,
    nodes: #[
      $bt.Cooldown { child: 1, duration: 1.0 },
      $bt.Sequence { first: 0, count: 2 },
      $bt.Condition { id: 0 },
      $bt.Action { id: 1 },
    ],
    children: #[2, 3],
  }
  let mem = bt.memory 4
  let (s1, mem) = bt.tick tree 0.1 (func id => id == 0) (func id => $bt.Running) mem
  let (s2, mem) = bt.tick tree 0.1 (func id => id == 0) (func id => $bt.Success) mem
  // Immediately after Success, Cooldown blocks for 1.0s.
  let (s3, mem) = bt.tick tree 0.4 (func id => id == 0) (func id => $bt.Success) mem
  // After 1.1s total elapsed, Cooldown clears and succeeds again.
  let (s4, mem) = bt.tick tree 0.7 (func id => id == 0) (func id => $bt.Success) mem
  let code = func (s: bt.Status) : U32 => case s of
    $bt.Idle => 0
    $bt.Running => 1
    $bt.Success => 2
    $bt.Failure => 3
  let _v13 = #[1, 2, 3, 2]
  let _v14 = #[code s1, code s2, code s3, code s4]
  use test.eq "check 1" _v13 _v14
  return ()

@[test.suite]
test "utility ai curves and momentum":
  let cons = #[
    $utility.Consideration { input: 0, min_val: 0.0, max_val: 100.0, curve: $utility.Linear { slope: 1.0, intercept: 0.0 } },
    $utility.Consideration { input: 1, min_val: 0.0, max_val: 100.0, curve: $utility.InverseLinear { slope: 1.0, intercept: 1.0 } },
  ]
  let actions = #[
    $utility.Action { id: 10, weight: 1.0, start: 0, count: 1 },
    $utility.Action { id: 20, weight: 1.0, start: 1, count: 1 },
  ]
  // Input 0 = 48 (score 0.48), Input 1 = 48 (inverse score 0.52).
  let $Some pick_fresh = utility.select actions cons #[48.0, 48.0] 4294967295 1.2 else:
    use test.holds "check 1" false
    return ()
  // With momentum 1.2 on action 0 (0.48 * 1.2 = 0.576 > 0.52), stick to action 0.
  let $Some pick_sticky = utility.select actions cons #[48.0, 48.0] 0 1.2 else:
    use test.holds "check 1" false
    return ()
  let _v15 = #[20, 10]
  let _v16 = #[pick_fresh.id, pick_sticky.id]
  use test.eq "check 1" _v15 _v16
  return ()

@[test.suite]
test "goap finds minimum cost action chain":
  // Facts: bit 0 = has_wood, bit 1 = has_axe, bit 2 = has_fire.
  let actions = #[
    $goap.Action { id: 1, cost: 1.0, pre_mask: 0, pre_value: 0, eff_mask: 2, eff_value: 2 },
    $goap.Action { id: 2, cost: 1.0, pre_mask: 2, pre_value: 2, eff_mask: 1, eff_value: 1 },
    $goap.Action { id: 3, cost: 5.0, pre_mask: 0, pre_value: 0, eff_mask: 1, eff_value: 1 },
    $goap.Action { id: 4, cost: 1.0, pre_mask: 1, pre_value: 1, eff_mask: 4, eff_value: 4 },
  ]
  // Getting axe (1) + chopping wood (1) + lighting fire (1) = cost 3 beats gathering bare-handed (5) + fire (1) = 6.
  let $Some p = goap.plan 0 ($goap.Condition { mask: 4, value: 4 }) actions 64 else:
    use test.holds "check 1" false
    return ()
  let _v17 = p.found
  use test.holds "check 1" _v17
  let _v18 = 0.001
  let _v19 = #[3.0]
  let _v20 = #[p.cost]
  use test.near_array "check 2" _v18 _v19 _v20
  let _v21 = #[1, 2, 4]
  let _v22 = p.actions
  use test.eq "check 3" _v21 _v22
  return ()

@[test.suite]
test "perception memory and tactical eqs":
  let sensor = $perception.Sensor {
    position: math.zero3, forward: math.forward, sight_range: 10.0,
    cos_half_fov: 0.5, hearing_range: 8.0, memory_seconds: 5.0,
  }
  let stim = #[
    $perception.Stimulus { id: 7, position: math.vec3 0.0 0.0 (-5.0), loudness: 0.0, visible: true },
    $perception.Stimulus { id: 8, position: math.vec3 0.0 0.0 4.0, loudness: 1.0, visible: true },
  ]
  let empty_mem: #[perception.Memory] = #[]
  let mem1 = perception.update_memory sensor 0.1 stim empty_mem
  let no_stim: #[perception.Stimulus] = #[]
  let mem2 = perception.update_memory sensor 6.0 no_stim mem1
  // EQS tactical pick: prefers covered position behind threat at ideal distance.
  let cands = #[math.vec3 0.0 0.0 (-5.0), math.vec3 0.0 0.0 5.0, math.vec3 5.0 0.0 0.0]
  let cover = #[false, true, false]
  let q = $perception.TacticalQuery {
    threat: math.zero3, threat_forward: math.forward,
    ideal_distance: 5.0, distance_band: 5.0,
    weight_distance: 1.0, weight_cover: 2.0, weight_flank: 1.0,
  }
  let $Some pick = perception.choose_tactical q cands cover else:
    use test.holds "check 1" false
    return ()
  let _v23 = #[2, 0]
  let _v24 = #[mem1.length, mem2.length]
  use test.eq "check 1" _v23 _v24
  let _v25 = 0.001
  let _v26 = #[1.0, 0.5]
  let _v27 = #[mem1[0].confidence, mem1[1].confidence]
  use test.near_array "check 2" _v25 _v26 _v27
  let _v28 = #[1]
  let _v29 = #[pick.index]
  use test.eq "check 3" _v28 _v29
  return ()

@[test.suite]
test "gameplay tags and attribute modifiers":
  // Tag 0: [1] (State), Tag 1: [1, 2] (State.Move), Tag 2: [1, 2, 3] (State.Move.Sprint), Tag 3: [4] (Stunned).
  let pool = $tags.Pool {
    segments: #[1, 1, 2, 1, 2, 3, 4],
    tags: #[$tags.Tag { start: 0, count: 1 }, $tags.Tag { start: 1, count: 2 }, $tags.Tag { start: 3, count: 3 }, $tags.Tag { start: 6, count: 1 }],
  }
  let held: #[U32] = #[]
  held := tags.add 2 held
  let match_parent = tags.has_tag pool held 0 and tags.has_tag pool held 1 and not (tags.has_tag pool held 3)
  held := tags.remove_matching pool 1 held
  let cleared = held.length == 0
  // Attributes: base 10 + add 5 = 15, * 2.0 = 30. Timed buff expires after 2.0s.
  let spec = $attributes.Spec { base: 10.0, min_val: 0.0, max_val: 100.0 }
  let mods: #[attributes.Modifier] = #[
    $attributes.Modifier { attribute: 0, source: 1, op: $attributes.Add, value: 5.0, remaining: (-1.0) },
    $attributes.Modifier { attribute: 0, source: 2, op: $attributes.Multiply, value: 2.0, remaining: 1.5 },
  ]
  let v1 = attributes.evaluate 0 spec mods
  mods := attributes.tick_modifiers 2.0 mods
  let v2 = attributes.evaluate 0 spec mods
  let cds: #[attributes.Cooldown] = #[]
  let (ok_cd, cds) = attributes.trigger_cooldown 9 1.0 cds
  let blocked_cd = not (attributes.ready 9 cds)
  cds := attributes.tick_cooldowns 1.2 cds
  let ready_cd = attributes.ready 9 cds
  let _v30 = (match_parent and cleared)
  use test.holds "check 1" _v30
  let _v31 = 0.001
  let _v32 = #[30.0, 15.0]
  let _v33 = #[v1, v2]
  use test.near_array "check 2" _v31 _v32 _v33
  let _v34 = (ok_cd and blocked_cd and ready_cd)
  use test.holds "check 3" _v34
  return ()
