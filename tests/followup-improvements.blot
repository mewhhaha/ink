import * as test from "std/test"
import * as reference from "./fixtures/flat_queue_reference"
import * as linear from "./fixtures/linear_map_reference"
import * as array from "std/array"
import * as jobs from "ink/task_queue"
import * as map from "ink/map"
import * as pages from "ink/pages"
import * as ecs from "ink/ecs"
import * as journal from "ink/journal"
import * as messages from "ink/messages"
import * as schedule from "ink/schedule"
import * as graph from "ink/graph"
const encode=jobs.encode (func (i:U32) => #[i]) (func (i:U32) => #[i]) (func (i:U32) => #[i])
func scalar (words:#[U32]) => if words.length==1 then $Some words[0] else $Nothing
func same_words (a: #[U32]) -> (b: #[U32]) : Bool =>
  if a.length != b.length:
    return false
  for i in 0 .. a.length:
    if a[i] != b[i]:
      return false
  return true
func append_u32 (dst: own #[U32]) -> (src: #[U32]) : #[U32] =>
  for v in src:
    @storage.push dst v
  return dst
func qwords (queue:jobs.Queue [U32,U32,U32]) -> (meta:jobs.Metadata) -> (history:#[jobs.Mark]) =>
  let result:#[U32]=#[]
  result := append_u32 self (encode queue meta)
  for mark in history:
    let tag=case mark.event of
      $jobs.Submitted => 1
      $jobs.Completed => 2
      $jobs.Published => 3
      $jobs.Rejected => 4
      $jobs.Stopped => 5
      $jobs.Reissued => 6
    result := append_u32 self #[mark.ticket.epoch,mark.ticket.sequence,mark.tick,tag]
  return result
func copy_queue (destination: own jobs.Queue [U32,U32,U32]) -> (meta:own jobs.Metadata) -> (history: own #[jobs.Mark]) -> (source:jobs.Queue [U32,U32,U32]) -> (source_meta:jobs.Metadata) -> (source_history:#[jobs.Mark]) : (jobs.Queue [U32,U32,U32], jobs.Metadata, #[jobs.Mark]) =>
  @storage.truncate destination 0
  for job in source:
    @storage.push destination job
  for index in 0 .. 6:
    meta[index] := source_meta[index]
  @storage.truncate history 0
  for mark in source_history:
    @storage.push history mark
  return (destination, meta, history)
@[test.suite]
test "queue batches preserve tickets traces snapshots and exhaustion":
  let valid=true
  for count in #[0,1,17,257]:
    for trace in #[false,true]:
      let actual:jobs.Queue [U32,U32,U32]=jobs.empty ()
      let actual_meta=jobs.metadata 0xFFFFFFFF count trace
      let actual_history:#[jobs.Mark]=#[]
      let before=qwords actual actual_meta actual_history
      let expected:jobs.Queue [U32,U32,U32]=jobs.empty ()
      let expected_meta=jobs.metadata 0xFFFFFFFF count trace
      let expected_history:#[jobs.Mark]=#[]
      let values=array.generate count identity
      let exp_state = (expected, expected_meta, expected_history)
      for i in values:
        exp_state := do:
          let (q, m, h) = self
          let ($Some _, q, m, h) = reference.submit 1 3 i i q m h else:
            return panic "reference submit rejected"
          break (q, m, h)
      let (expected, expected_meta, expected_history) = exp_state
      let ($Some tickets,actual,actual_meta,actual_history)=jobs.submit_many 1 3 values values actual actual_meta actual_history else:
        panic "batch submit rejected"
      valid := self and tickets.length==count and same_words (qwords expected expected_meta expected_history) (qwords actual actual_meta actual_history)
      let closed:jobs.Queue [U32,U32,U32]=jobs.empty ()
      let closed_meta=jobs.metadata 1 count trace
      let closed_history:#[jobs.Mark]=#[]
      let (closed,closed_meta,closed_history)=copy_queue closed closed_meta closed_history actual actual_meta actual_history
      let reference_closed:jobs.Queue [U32,U32,U32]=jobs.empty ()
      let reference_meta=jobs.metadata 1 count trace
      let reference_history:#[jobs.Mark]=#[]
      let (reference_closed,reference_meta,reference_history)=copy_queue reference_closed reference_meta reference_history expected expected_meta expected_history
      let (closed,closed_meta,closed_history)=jobs.close 2 99 closed closed_meta closed_history
      let (reference_closed,reference_meta,reference_history)=reference.close 2 99 reference_closed reference_meta reference_history
      valid := self and same_words (qwords reference_closed reference_meta reference_history) (qwords closed closed_meta closed_history)
      let (actual,actual_meta,actual_history)=jobs.reissue 7 (copy actual) (copy actual_meta) (copy actual_history)
      let (expected,expected_meta,expected_history)=reference.reissue 7 (copy expected) (copy expected_meta) (copy expected_history)
      valid := self and same_words (qwords expected expected_meta expected_history) (qwords actual actual_meta actual_history)
      let (delivered,closed,closed_meta,closed_history)=jobs.publish 2 closed closed_meta closed_history
      let (reference_delivered,reference_closed,reference_meta,reference_history)=reference.publish 2 reference_closed reference_meta reference_history
      valid := self and same_words (qwords closed closed_meta closed_history) (qwords reference_closed reference_meta reference_history) and delivered.length==reference_delivered.length and before[6]==0
  let near:jobs.Queue [U32,U32,U32]=jobs.empty ()
  let near_meta=jobs.metadata 1 4 false
  let history:#[jobs.Mark]=#[]
  near_meta[1] := 0xFFFFFFFE
  let before=copy near_meta
  let before_count=near.length
  let (rejected,near,near_meta,history)=jobs.submit_many 0 0 #[1,2,3] #[1,2,3] near near_meta history
  let too_many=not (Maybe.is_some rejected)
  let ($Some tickets,near,near_meta,history)=jobs.submit_many 0 0 #[1,2] #[3,4] near near_meta history else:
    panic "last tickets rejected"
  let mismatch:jobs.Queue [U32,U32,U32]=jobs.empty ()
  let mismatch_meta=jobs.metadata 1 4 false
  let mismatch_history:#[jobs.Mark]=#[]
  mismatch_meta[1] := 0xFFFFFFFE
  let (mismatched,mismatch,mismatch_meta,mismatch_history)=jobs.submit_many 0 0 #[1] #[] mismatch mismatch_meta mismatch_history
  let sequences = array.map (func (t:jobs.Ticket) => t.sequence) tickets
  let wrap_ok = near_meta[1]==0 and before[1]==0xFFFFFFFE and before_count==0
  let mismatch_ok = not (Maybe.is_some mismatched)
  use test.holds "batch equivalence" valid
  use test.holds "too many rejected" too_many
  use test.eq "ticket sequences" #[0xFFFFFFFE,0xFFFFFFFF] sequences
  use test.holds "sequence wrapped" wrap_ok
  use test.holds "mismatch rejected" mismatch_ok
  return ()
func settle_test_job (i: U32) -> (ticket: jobs.Ticket) -> (state: own (jobs.Queue [U32,U32,U32], jobs.Metadata, #[jobs.Mark])) : (jobs.Queue [U32,U32,U32], jobs.Metadata, #[jobs.Mark]) =>
  let (q, m, h) = state
  let (_, q, m, h) = jobs.settle 2 ticket ($jobs.Value (i*17)) q m h
  return (q, m, h)
@[test.suite]
test "queue decoder matches reference on mutations and early prefixes":
  let valid=true
  let queue:jobs.Queue [U32,U32,U32]=jobs.empty ()
  let meta=jobs.metadata 7 20 true
  let history:#[jobs.Mark]=#[]
  let ids=array.generate 20 identity
  let ($Some tickets,queue,meta,history)=jobs.submit_many 1 3 ids ids queue meta history else:
    panic "submit rejected"
  let qstate = (queue, meta, history)
  for i in ids:
    if i != 7:
      qstate := settle_test_job i tickets[i] self
  let (queue, meta, history) = qstate
  for tick in #[2,3]:
    let actual:jobs.Queue [U32,U32,U32]=jobs.empty ()
    let actual_meta=jobs.metadata 1 20 true
    let actual_history:#[jobs.Mark]=#[]
    let (actual,actual_meta,actual_history)=copy_queue actual actual_meta actual_history queue meta history
    let expected:jobs.Queue [U32,U32,U32]=jobs.empty ()
    let expected_meta=jobs.metadata 1 20 true
    let expected_history:#[jobs.Mark]=#[]
    let (expected,expected_meta,expected_history)=copy_queue expected expected_meta expected_history queue meta history
    let (delivered,actual,actual_meta,actual_history)=jobs.publish tick actual actual_meta actual_history
    let (expected_delivered,expected,expected_meta,expected_history)=reference.publish tick expected expected_meta expected_history
    valid := self and same_words (qwords actual actual_meta actual_history) (qwords expected expected_meta expected_history) and delivered.length==expected_delivered.length
  let words=encode queue meta
  for seed in 0 .. 512:
    let changed=copy words
    changed[seed%words.length] := seed*2654435761
    let actual:jobs.Queue [U32,U32,U32]=jobs.empty ()
    let actual_meta=jobs.metadata 1 20 true
    let actual_history:#[jobs.Mark]=#[]
    let expected:jobs.Queue [U32,U32,U32]=jobs.empty ()
    let expected_meta=jobs.metadata 1 20 true
    let expected_history:#[jobs.Mark]=#[]
    let (a,actual,actual_meta,actual_history)=jobs.decode 20 true scalar scalar scalar changed actual actual_meta actual_history
    let (b,expected,expected_meta,expected_history)=reference.decode 20 true scalar scalar scalar changed expected expected_meta expected_history
    let actual_words=if a then qwords actual actual_meta actual_history else #[0xFFFFFFFF]
    let expected_words=if b then qwords expected expected_meta expected_history else #[0xFFFFFFFF]
    valid := self and same_words actual_words expected_words
  use test.holds "decoder matches reference" valid
  return ()
func map_words entries =>
  let result:#[U32]=#[]
  for pair in entries:
    let (key,value)=pair
    result := append_u32 self #[key,value]
  return result
func map_case policy =>
  let valid=true
  for seed in 0 .. 24:
    let entries=array.generate (seed*3) (func i => (i*2654435761,i))
    let before:map.Map [U32,U32]=map.from policy entries (map.empty ())
    let reference:linear.Rows=#[]
    reference := linear.from policy entries reference
    valid := self and same_words (map_words (map.entries before)) (map_words (linear.entries reference))
    let edits=array.generate 101 (func i => ((i*7+seed)%53,if i%5==0 then $Nothing else $Some (i^0xFFFFFFFF)))
    let after:map.Map [U32,U32]=map.copy_into policy identity identity (map.empty ()) before
    after := map.edit_many policy edits after
    let expected:linear.Rows=#[]
    expected := linear.copy self reference
    expected := linear.edit policy edits expected
    valid := self and map.count after==linear.count expected and same_words (map_words (map.entries after)) (map_words (linear.entries expected))
    let removed:map.Map [U32,U32]=map.copy_into policy identity identity (map.empty ()) after
    removed := map.remove_many policy (array.generate 53 identity) removed
    let removed_expected:linear.Rows=#[]
    removed_expected := linear.copy self expected
    for key in 0 .. 53:
      removed_expected := linear.remove policy key self
    valid := self and map.count removed==linear.count removed_expected and same_words (map_words (map.entries removed)) (map_words (linear.entries removed_expected))
    for key in #[0,1,17,34,0xFFFFFFFF]:
      for erase in #[false,true]:
        let change=func value => if erase then $Nothing else $Some (Maybe.unwrap_or 7 value+1)
        let a:map.Map [U32,U32]=map.copy_into policy identity identity (map.empty ()) after
        a := map.alter policy key change a
        let b:linear.Rows=#[]
        b := linear.copy self expected
        b := linear.alter policy key change b
        valid := self and map.count a==linear.count b and same_words (map_words (map.entries a)) (map_words (linear.entries b))
    valid := self and same_words (map_words (map.entries before)) (map_words (linear.entries reference))
  return valid
const identity_key=map.key identity U32.eq
const collision_key=map.key (func _ => 0xFFFFFFFF) U32.eq
const equivalent_key=map.key (func k => k%17) (func a -> b => a%17==b%17)
@[test.suite]
test "bulk maps match ordered edits collisions key identity and snapshots":
  let ok = map_case map.u32 and map_case identity_key and map_case collision_key and map_case equivalent_key
  use test.holds "bulk map policies" ok
  return ()
func event_words entry => case entry of
  $journal.Added id => #[1,id]
  $journal.Updated id => #[2,id]
  $journal.Removed id => #[3,id]
  $journal.Replaced => #[4,0]
func reference_pages count -> dirty -> value -> before => array.generate count (func i => if i>=before.length or array.any (func selected => selected==i) dirty then value i else before.at i)
@[test.suite]
test "journal batches and page edits preserve retention and old storage":
  let valid=true
  for count in #[0,1,63,64,65,257,4097]:
    let before=pages.from (array.generate count identity)
    let dirty=#[0,0,count,count+1,0xFFFFFFFF]
    let a=pages.copy_using identity before
    a := pages.update (count+65) dirty (func i => i+100) a
    let b=reference_pages (count+65) dirty (func i => i+100) before
    valid := self and same_words (pages.flatten a) b
    a := pages.update (count/2) dirty (func i => i+200) a
    valid := self and same_words (pages.flatten a) (reference_pages (count/2) dirty (func i => i+200) b)
    valid := self and same_words (array.generate count identity) (pages.flatten before)
  for capacity in #[0,1,17,300]:
    let alive:ecs.Entities=ecs.entities ()
    let alive_meta=ecs.metadata 1
    let (_, alive, alive_meta) = ecs.spawn_many alive alive_meta 96
    let pool:ecs.Pool U32=ecs.pool ()
    let meta=ecs.metadata 1
    let before_masks=#[0xFFFFFFFF,0,0x55555555]
    let after_masks=#[0x55555555,0xFFFFFFFF,0]
    for id in 0 .. 96:
      if before_masks[id/32]>>(id%32)&1!=0:
        let was=ecs.contains pool id
        pool := ecs.put_row alive self id id
        meta := ecs.bump_insert was self
    meta[1] := 7
    meta[2] := 11
    let log:journal.Journal=journal.empty ()
    let log_meta=journal.metadata 1 capacity
    let before_words=#[meta[1],meta[2],log_meta[2],log_meta[3]]
    let all:#[journal.Change]=#[]
    let writes=0
    let structural=0
    let logged = (pool, meta, log, log_meta)
    for id in 0 .. 96:
      let was=before_masks[id/32]>>(id%32)&1!=0
      let now=after_masks[id/32]>>(id%32)&1!=0
      if now:
        @storage.push all (if was then $journal.Updated id else $journal.Added id)
        writes := writes+1
        if not was:
          structural := structural+1
      else:
        if was:
          @storage.push all ($journal.Removed id)
          writes := writes+1
          structural := structural+1
      logged := do:
        let (p, pm, l, m) = self
        break if now then ecs.insert_tracked alive p pm l m id (id+1)
          else if was then ecs.remove_tracked p pm l m id
          else (p, pm, l, m)
    let (pool, meta, log, log_meta) = logged
    let expected:#[U32]=#[]
    expected := append_u32 self #[7+writes,11+structural,all.length,all.length-min all.length capacity]
    for index in all.length-min all.length capacity .. all.length:
      expected := append_u32 self (event_words all[index])
    let actual:#[U32]=#[]
    actual := append_u32 self #[meta[1],meta[2],log_meta[2],log_meta[3]]
    let scratch:#[journal.Change]=#[]
    let read=messages.read (messages.beginning log_meta) log log_meta scratch
    if let $messages.Items {values} = read:
      for event in values:
        actual := append_u32 self (event_words event)
    else:
      panic "current journal reader unexpectedly reset"
    valid := self and same_words actual expected
    valid := self and same_words #[7,11,0,0] before_words
  use test.holds "journal and page edits" valid
  return ()
@[test.suite]
test "prepared schedules keep validated order across plan replacement":
  let dependency_starts=#[0,0,0,2,3]
  let dependency_targets=#[0,1,2]
  let wave_starts=#[0,2,3,4]
  let wave_nodes=#[0,1,2,3]
  let plan= $schedule.Plan {dependency_starts,dependency_targets,waves:$graph.Waves {starts:wave_starts,nodes:wave_nodes}}
  let $Some prepared=schedule.prepare plan else:
    panic "valid plan rejected"
  let expected=#[7]
  let dispatch=func state -> selected => array.map (func index => state[0]*3+index) selected
  let commit=func (own state) -> index -> value =>
    state[0] := state[0]+value*(index+1)
    return state
  let (_, expected) = schedule.execute plan expected dispatch commit
  let bad_starts=#[0,4]
  let bad_nodes=#[3,2,1,0]
  let bad_plan = $schedule.Plan {dependency_starts: copy plan.dependency_starts, dependency_targets: copy plan.dependency_targets, waves:$graph.Waves {starts:bad_starts,nodes:bad_nodes}}
  let actual=#[7]
  actual := schedule.execute_prepared prepared actual dispatch commit
  let empty_starts=#[0]
  let empty_nodes:#[U32]=#[]
  let empty= $schedule.Plan {dependency_starts:copy empty_starts,dependency_targets:copy empty_nodes,waves:$graph.Waves {starts:empty_starts,nodes:empty_nodes}}
  let bad_rejected = not (Maybe.is_some (schedule.prepare bad_plan))
  let empty_accepted = Maybe.is_some (schedule.prepare empty)
  use test.eq "prepared schedule result" expected[0] actual[0]
  use test.holds "bad plan rejected" bad_rejected
  use test.holds "empty plan accepted" empty_accepted
  return ()
