import * as check from "./check"
import * as reference from "./fixtures/flat_queue_reference"
import * as linear from "./fixtures/linear_map_reference"
import * as array from "std/array"
import * as jobs from "ink/task_queue"
import * as map from "ink/map"
import * as pages from "ink/pages"
import * as ecs from "ink/ecs"
import * as journal from "ink/journal"
import * as messages from "ink/messages"
import * as schedule from "ink/schedule"
import * as graph from "ink/graph"
const encode=jobs.encode (func (i:U32) => return #[i]) (func (i:U32) => return #[i]) (func (i:U32) => return #[i])
func scalar (words:Array U32) => return if words.length==1 then $Some words[0] else $Nothing
func qwords (queue:jobs.Queue [U32,U32,U32]) -> (meta:jobs.Metadata) -> (history:ResizeArray jobs.Mark) => return do:
  let result:GrowArray U32=#[]
  array.append_into result (encode queue meta)
  for mark in history:
    let tag=case mark.event of
      $jobs.Submitted => 1
      $jobs.Completed => 2
      $jobs.Published => 3
      $jobs.Rejected => 4
      $jobs.Stopped => 5
      $jobs.Reissued => 6
    array.append_into result #[mark.ticket.epoch,mark.ticket.sequence,mark.tick,tag]
  return @storage.freeze result
func copy_queue (destination:jobs.Queue [U32,U32,U32]) -> (meta:jobs.Metadata) -> (history:ResizeArray jobs.Mark) -> (source:jobs.Queue [U32,U32,U32]) -> (source_meta:jobs.Metadata) -> (source_history:ResizeArray jobs.Mark) => return do:
  destination.truncate 0
  for job in source:
    destination.push job
  for index in 0 .. 6:
    meta[index] = source_meta[index]
  history.truncate 0
  for mark in source_history:
    history.push mark
entry func test_queue_batches_preserve_tickets_traces_snapshots_and_exhaustion () => return do:
  let valid=true
  for count in #[0,1,17,257]:
    for trace in #[false,true]:
      let actual:jobs.Queue [U32,U32,U32]=jobs.empty ()
      let actual_meta=jobs.metadata 0xFFFFFFFF count trace
      let actual_history:ResizeArray jobs.Mark=#[]
      let before=qwords actual actual_meta actual_history
      let expected:jobs.Queue [U32,U32,U32]=jobs.empty ()
      let expected_meta=jobs.metadata 0xFFFFFFFF count trace
      let expected_history:ResizeArray jobs.Mark=#[]
      let values=array.generate count identity
      for i in values:
        let $Some ticket=reference.submit 1 3 i i expected expected_meta expected_history else:
          @panic "reference submit rejected"
      let $Some tickets=jobs.submit_many 1 3 values values actual actual_meta actual_history else:
        @panic "batch submit rejected"
      valid := self and tickets.length==count and (check.words (qwords expected expected_meta expected_history) (qwords actual actual_meta actual_history)).passed
      let closed:jobs.Queue [U32,U32,U32]=jobs.empty ()
      let closed_meta=jobs.metadata 1 count trace
      let closed_history:ResizeArray jobs.Mark=#[]
      copy_queue closed closed_meta closed_history actual actual_meta actual_history
      let reference_closed:jobs.Queue [U32,U32,U32]=jobs.empty ()
      let reference_meta=jobs.metadata 1 count trace
      let reference_history:ResizeArray jobs.Mark=#[]
      copy_queue reference_closed reference_meta reference_history expected expected_meta expected_history
      jobs.close 2 99 closed closed_meta closed_history
      reference.close 2 99 reference_closed reference_meta reference_history
      valid := self and (check.words (qwords reference_closed reference_meta reference_history) (qwords closed closed_meta closed_history)).passed
      jobs.reissue 7 actual actual_meta actual_history
      reference.reissue 7 expected expected_meta expected_history
      valid := self and (check.words (qwords expected expected_meta expected_history) (qwords actual actual_meta actual_history)).passed
      let delivered=jobs.publish 2 closed closed_meta closed_history
      let reference_delivered=reference.publish 2 reference_closed reference_meta reference_history
      valid := self and (check.words (qwords closed closed_meta closed_history) (qwords reference_closed reference_meta reference_history)).passed and delivered.length==reference_delivered.length and before[6]==0
  let near:jobs.Queue [U32,U32,U32]=jobs.empty ()
  let near_meta=jobs.metadata 1 4 false
  let history:ResizeArray jobs.Mark=#[]
  near_meta[1] = 0xFFFFFFFE
  let before=@storage.copy near_meta
  let before_count=near.length
  let too_many=Bool.not (Maybe.is_some (jobs.submit_many 0 0 #[1,2,3] #[1,2,3] near near_meta history))
  let $Some tickets=jobs.submit_many 0 0 #[1,2] #[3,4] near near_meta history else:
    @panic "last tickets rejected"
  let mismatch:jobs.Queue [U32,U32,U32]=jobs.empty ()
  let mismatch_meta=jobs.metadata 1 4 false
  let mismatch_history:ResizeArray jobs.Mark=#[]
  mismatch_meta[1] = 0xFFFFFFFE
  return check.report #[check.holds valid,check.holds too_many,
    check.words #[0xFFFFFFFE,0xFFFFFFFF] (array.map (func (t:jobs.Ticket) => return t.sequence) tickets),
    check.holds (near_meta[1]==0 and before[1]==0xFFFFFFFE and before_count==0),
    check.holds (Bool.not (Maybe.is_some (jobs.submit_many 0 0 #[1] #[] mismatch mismatch_meta mismatch_history)))]
entry func test_queue_decoder_matches_reference_on_mutations_and_early_prefixes () => return do:
  let valid=true
  let queue:jobs.Queue [U32,U32,U32]=jobs.empty ()
  let meta=jobs.metadata 7 20 true
  let history:ResizeArray jobs.Mark=#[]
  let ids=array.generate 20 identity
  let $Some tickets=jobs.submit_many 1 3 ids ids queue meta history else:
    @panic "submit rejected"
  for i in ids:
    if i!=7:
      jobs.settle 2 tickets[i] ($jobs.Value (i*17)) queue meta history
  for tick in #[2,3]:
    let actual:jobs.Queue [U32,U32,U32]=jobs.empty ()
    let actual_meta=jobs.metadata 1 20 true
    let actual_history:ResizeArray jobs.Mark=#[]
    copy_queue actual actual_meta actual_history queue meta history
    let expected:jobs.Queue [U32,U32,U32]=jobs.empty ()
    let expected_meta=jobs.metadata 1 20 true
    let expected_history:ResizeArray jobs.Mark=#[]
    copy_queue expected expected_meta expected_history queue meta history
    let delivered=jobs.publish tick actual actual_meta actual_history
    let expected_delivered=reference.publish tick expected expected_meta expected_history
    valid := self and (check.words (qwords actual actual_meta actual_history) (qwords expected expected_meta expected_history)).passed and delivered.length==expected_delivered.length
  let words=encode queue meta
  for seed in 0 .. 512:
    let changed=@storage.copy words
    changed[seed%words.length] := seed*2654435761
    let actual:jobs.Queue [U32,U32,U32]=jobs.empty ()
    let actual_meta=jobs.metadata 1 20 true
    let actual_history:ResizeArray jobs.Mark=#[]
    let expected:jobs.Queue [U32,U32,U32]=jobs.empty ()
    let expected_meta=jobs.metadata 1 20 true
    let expected_history:ResizeArray jobs.Mark=#[]
    let a=jobs.decode 20 true scalar scalar scalar changed actual actual_meta actual_history
    let b=reference.decode 20 true scalar scalar scalar changed expected expected_meta expected_history
    let actual_words=if a then qwords actual actual_meta actual_history else #[0xFFFFFFFF]
    let expected_words=if b then qwords expected expected_meta expected_history else #[0xFFFFFFFF]
    valid := self and (check.words actual_words expected_words).passed
  return check.report #[check.holds valid]
func map_words entries => return do:
  let result:GrowArray U32=#[]
  for pair in entries:
    let (key,value)=pair
    array.append_into result #[key,value]
  return @storage.freeze result
func map_case policy => return do:
  let valid=true
  for seed in 0 .. 24:
    let entries=array.generate (seed*3) (func i => return (i*2654435761,i))
    let before:map.Map [U32,U32]=map.empty ()
    let before_slots=map.buckets ()
    map.from policy entries before before_slots
    let reference:linear.Rows=#[]
    linear.from policy entries reference
    valid := self and (check.words (map_words (map.entries before)) (map_words (linear.entries reference))).passed
    let edits=array.generate 101 (func i => return ((i*7+seed)%53,if i%5==0 then $Nothing else $Some (i^0xFFFFFFFF)))
    let after:map.Map [U32,U32]=map.empty ()
    let slots=map.buckets ()
    map.copy_into policy identity identity after slots before
    map.edit_many policy edits after slots
    let expected:linear.Rows=#[]
    linear.copy expected reference
    linear.edit policy edits expected
    valid := self and map.count slots==linear.count expected and (check.words (map_words (map.entries after)) (map_words (linear.entries expected))).passed
    let removed:map.Map [U32,U32]=map.empty ()
    let removed_slots=map.buckets ()
    map.copy_into policy identity identity removed removed_slots after
    map.remove_many policy (array.generate 53 identity) removed removed_slots
    let removed_expected:linear.Rows=#[]
    linear.copy removed_expected expected
    for key in 0 .. 53:
      linear.remove policy key removed_expected
    valid := self and map.count removed_slots==linear.count removed_expected and (check.words (map_words (map.entries removed)) (map_words (linear.entries removed_expected))).passed
    for key in #[0,1,17,34,0xFFFFFFFF]:
      for erase in #[false,true]:
        let change=func value => return if erase then $Nothing else $Some (Maybe.unwrap_or 7 value+1)
        let a:map.Map [U32,U32]=map.empty ()
        let a_slots=map.buckets ()
        map.copy_into policy identity identity a a_slots after
        map.alter policy key change a a_slots
        let b:linear.Rows=#[]
        linear.copy b expected
        linear.alter policy key change b
        valid := self and map.count a_slots==linear.count b and (check.words (map_words (map.entries a)) (map_words (linear.entries b))).passed
    valid := self and (check.words (map_words (map.entries before)) (map_words (linear.entries reference))).passed
  return valid
const identity_key=map.key identity U32.eq
const collision_key=map.key (func _ => return 0xFFFFFFFF) U32.eq
const equivalent_key=map.key (func k => return k%17) (func a -> b => return a%17==b%17)
entry func test_bulk_maps_match_ordered_edits_collisions_key_identity_and_snapshots () => return check.report #[check.holds (map_case map.u32 and map_case identity_key and map_case collision_key and map_case equivalent_key)]
func event_words entry => return case entry of
  $journal.Added id => #[1,id]
  $journal.Updated id => #[2,id]
  $journal.Removed id => #[3,id]
  $journal.Replaced => #[4,0]
func reference_pages count -> dirty -> value -> before => return array.generate count (func i => return if i>=before.length or array.any (func selected => return selected==i) dirty then value i else before.at i)
entry func test_journal_batches_and_page_edits_preserve_retention_and_old_storage () => return do:
  let valid=true
  for count in #[0,1,63,64,65,257,4097]:
    let before=pages.from (array.generate count identity)
    let dirty=#[0,0,count,count+1,0xFFFFFFFF]
    let a=pages.copy_using identity before
    pages.update (count+65) dirty (func i => return i+100) a
    let b=reference_pages (count+65) dirty (func i => return i+100) before
    valid := self and (check.words (pages.flatten a) b).passed
    pages.update (count/2) dirty (func i => return i+200) a
    valid := self and (check.words (pages.flatten a) (reference_pages (count/2) dirty (func i => return i+200) b)).passed
    valid := self and (check.words (array.generate count identity) (pages.flatten before)).passed
  for capacity in #[0,1,17,300]:
    let alive:ecs.Entities=ecs.entities ()
    let alive_meta=ecs.metadata 1
    ecs.spawn_many alive alive_meta 96
    let pool:ecs.Pool U32=ecs.pool ()
    let meta=ecs.metadata 1
    let before_masks=#[0xFFFFFFFF,0,0x55555555]
    let after_masks=#[0x55555555,0xFFFFFFFF,0]
    for id in 0 .. 96:
      if before_masks[id/32]>>(id%32)&1!=0:
        ecs.insert alive pool meta id id
    meta[1] = 7
    meta[2] = 11
    let log:journal.Journal=journal.empty ()
    let log_meta=journal.metadata 1 capacity
    let before_words=#[meta[1],meta[2],log_meta[2],log_meta[3]]
    let all:GrowArray journal.Change=#[]
    let writes=0
    let structural=0
    for id in 0 .. 96:
      let was=before_masks[id/32]>>(id%32)&1!=0
      let now=after_masks[id/32]>>(id%32)&1!=0
      if now:
        all.push (if was then $journal.Updated id else $journal.Added id)
        ecs.insert_tracked alive pool meta log log_meta id (id+1)
        writes := writes+1
        if Bool.not was:
          structural := structural+1
      else:
        if was:
          all.push ($journal.Removed id)
          ecs.remove_tracked pool meta log log_meta id
          writes := writes+1
          structural := structural+1
    let expected:GrowArray U32=#[]
    array.append_into expected #[7+writes,11+structural,all.length,all.length-min all.length capacity]
    for index in all.length-min all.length capacity .. all.length:
      array.append_into expected (event_words all[index])
    let actual:GrowArray U32=#[]
    array.append_into actual #[meta[1],meta[2],log_meta[2],log_meta[3]]
    let scratch:ResizeArray journal.Change=#[]
    let read=messages.read (messages.beginning log_meta) log log_meta scratch
    case read of
      $messages.Items {values} => do:
        for event in values:
          array.append_into actual (event_words event)
      $messages.Reset _ => @panic "current journal reader unexpectedly reset"
    valid := self and (check.words (@storage.freeze actual) (@storage.freeze expected)).passed
    valid := self and (check.words #[7,11,0,0] before_words).passed
  return check.report #[check.holds valid]
entry func test_prepared_schedules_keep_validated_order_across_plan_replacement () => return do:
  let dependency_starts=#[0,0,0,2,3]
  let dependency_targets=#[0,1,2]
  let wave_starts=#[0,2,3,4]
  let wave_nodes=#[0,1,2,3]
  let plan= $schedule.Plan {dependencies:$graph.Graph {starts:&dependency_starts[0..5],targets:&dependency_targets[0..3]},waves:$graph.Waves {starts:&wave_starts[0..4],nodes:&wave_nodes[0..4]}}
  let $Some prepared=schedule.prepare plan else:
    @panic "valid plan rejected"
  let expected=#[7]
  let dispatch=func state -> selected => return array.map (func index => return state[0]*3+index) selected
  let commit=func state -> index -> value => return do:
    state[0] = state[0]+value*(index+1)
  schedule.execute plan expected dispatch commit
  let bad_starts=#[0,4]
  let bad_nodes=#[3,2,1,0]
  plan.waves := $graph.Waves {starts:&bad_starts[0..2],nodes:&bad_nodes[0..4]}
  let actual=#[7]
  schedule.execute_prepared prepared actual dispatch commit
  let empty_starts=#[0]
  let empty_nodes:Array U32=#[]
  let empty= $schedule.Plan {dependencies:$graph.Graph {starts:&empty_starts[0..1],targets:&empty_nodes[0..0]},waves:$graph.Waves {starts:&empty_starts[0..1],nodes:&empty_nodes[0..0]}}
  return check.report #[check.holds (actual[0]==expected[0]),check.holds (Bool.not (Maybe.is_some (schedule.prepare plan))),check.holds (Maybe.is_some (schedule.prepare empty))]
