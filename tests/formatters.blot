import * as ui from "ink/ui"
import * as text from "ink/text"

io decimal (value: F32) => ui.decimal value 6
io decimal_precision (places: U32) => ui.decimal 1.25 places
io fixed (value: F32) => text.fixed value 2
io fixed_six (value: F32) => text.fixed value 6
io fixed_precision (places: U32) => text.fixed 1.25 places
io shown (value: F32) => text.shown value
io power (exponent: U32) => text.power exponent
io rest (start: U32) => text.rest start #[65, 66, 67]
