import * as ui from "ink/ui"
import * as text from "ink/text"

entry const decimal = fn (value: F32) => ui.decimal value 6
entry const decimal_precision = fn (places: U32) => ui.decimal 1.25 places
entry const fixed = fn (value: F32) => text.fixed value 2
entry const fixed_six = fn (value: F32) => text.fixed value 6
entry const fixed_precision = fn (places: U32) => text.fixed 1.25 places
entry const shown = fn (value: F32) => text.shown value
entry const power = fn (exponent: U32) => text.power exponent
entry const rest = fn (start: U32) => text.rest start #[65, 66, 67]
