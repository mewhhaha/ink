import * as ui from "ink/ui"
import * as text from "ink/text"

entry const decimal = func (value: F32) => return ui.decimal value 6
entry const decimal_precision = func (places: U32) => return ui.decimal 1.25 places
entry const fixed = func (value: F32) => return text.fixed value 2
entry const fixed_six = func (value: F32) => return text.fixed value 6
entry const fixed_precision = func (places: U32) => return text.fixed 1.25 places
entry const shown = func (value: F32) => return text.shown value
entry const power = func (exponent: U32) => return text.power exponent
entry const rest = func (start: U32) => return text.rest start #[65, 66, 67]
