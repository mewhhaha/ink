import * as ui from "ink/ui"
import * as text from "ink/text"

entry func decimal (value: F32) => return ui.decimal value 6
entry func decimal_precision (places: U32) => return ui.decimal 1.25 places
entry func fixed (value: F32) => return text.fixed value 2
entry func fixed_six (value: F32) => return text.fixed value 6
entry func fixed_precision (places: U32) => return text.fixed 1.25 places
entry func shown (value: F32) => return text.shown value
entry func power (exponent: U32) => return text.power exponent
entry func rest (start: U32) => return text.rest start #[65, 66, 67]
