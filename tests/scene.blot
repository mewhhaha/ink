import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as math from "ink/math"
import * as scene from "ink/scene"
import * as shapes from "ink/shapes"

// Query: mode, mask, skip, triggers, walkers, dynamics, a.xyz, b.xyz,
// radius, delta.xyz. Source: id, shape, p.xyz, q.xyzw, scale.xyz,
// size.xyz, radius, height, layer, trigger, body kind.
const stride: U32 = 20
func vec (a: Array F32) => return func (o: U32) => return math.vec3 a[o] a[o + 1] a[o + 2]
func sources (a: Array F32) => return func (start: U32) => return func (count: U32) => return @array.generate count (func (i: U32) => return do:
  let o = start + i * stride
  let id = F32.to_u32 a[o]
  let p = vec a (o + 2)
  let source = case F32.to_u32 a[o + 1] of
    1 => scene.box id p (vec a (o + 12))
    2 => scene.sphere id p a[o + 15]
    3 => scene.capsule id p a[o + 15] a[o + 16]
    _ => scene.source id p
  source.index := i
  source.rotation := $math.Quat { x: a[o + 5], y: a[o + 6], z: a[o + 7], w: a[o + 8] }
  source.scale := vec a (o + 9)
  if let $Some collider = source.collider:
    collider.layer := F32.to_u32 a[o + 17]
    collider.trigger := a[o + 18] > 0.0
    source.collider := $Some collider
  if a[o + 19] == 1.0 or a[o + 19] == 2.0:
    let body = scene.default_rigid
    if a[o + 19] == 2.0:
      body.kind := $scene.Kinematic
    source.rigid := $Some body
  if a[o + 19] == 3.0:
    source.walker := $Some scene.default_walker
  return source)

func filter (q: Array F32) => return $scene.Filter {
  mask: F32.to_u32 q[1], skip: F32.to_u32 q[2],
  triggers: q[3] > 0.0, walkers: q[4] > 0.0, dynamics: q[5] > 0.0,
}

func answer (hit: Maybe scene.Hit) => return case hit of
  $Nothing => #[0.0]
  $Some h => #[1.0, U32.to_f32 h.id, U32.to_f32 h.proxy, h.time, h.distance,
    h.point.x, h.point.y, h.point.z, h.normal.x, h.normal.y, h.normal.z,
    h.surface.x, h.surface.y, h.surface.z, h.depth]

// Exhaustive geometry references intentionally bypass all scene bounds/indexing.
func exhaustive_cast (sc: scene.Scene) => return func (a: Vec3) => return func (b: Vec3) => return func (radius: F32) => return func (delta: Vec3) => return func (f: scene.Filter) => return do:
  let best: Maybe scene.Hit = $Nothing
  let time = 2.0
  for i in 0..(scene.count sc):
    let proxy = (scene.proxy sc i)
    if scene.accepts f proxy:
      if let $Some (t, point, normal, surface, depth) = scene.cast_shape proxy.shape a b radius delta:
        if t < time:
          time := t
          best := $Some ($scene.Hit { id: proxy.id, proxy: i, time: t, distance: t * delta.length, point, normal, surface, depth })
  return best

func query (sc: scene.Scene) => return func (q: Array F32) => return func (exhaustive: Bool) : Array F32 => return do:
  let mode = F32.to_u32 q[0]
  let mask = F32.to_u32 q[1]
  let a = vec q 6
  let b = vec q 9
  let radius = q[12]
  let delta = vec q 13
  if mode == 0 or mode == 1:
    let f = filter q
    let end = b
    let r = radius
    let motion = delta
    if mode == 0:
      end := a
      r := 0.0
      motion := delta.normalized * delta.length
      f := $scene.Filter { mask, skip: F32.to_u32 q[2], triggers: false, walkers: true, dynamics: true }
    if exhaustive:
      return answer (exhaustive_cast sc a end r motion f)
    if mode == 0:
      return answer (scene.ray sc a delta delta.length mask (F32.to_u32 q[2]))
    return answer (scene.cast sc a end r motion f)
  if Bool.not exhaustive:
    if mode == 2:
      return array.map U32.to_f32 (scene.overlap_sphere sc a radius mask)
    if mode == 3:
      return array.map U32.to_f32 (scene.overlap_capsule sc a b radius mask)
    let solid = 0.0
    if scene.point_solid sc a mask:
      solid := 1.0
    return #[solid]
  let found: GrowArray F32 = #[]
  for proxy in scene.proxies sc:
    if (proxy.layer & mask) != 0:
      if mode == 4:
        if Bool.not proxy.trigger and (shapes.segment_gap proxy.shape a a).dist <= 0.0:
          return #[1.0]
      else:
        let end = a
        if mode == 3:
          end := b
        if (shapes.segment_gap proxy.shape a end).dist <= radius:
          @storage.push found (U32.to_f32 proxy.id)
  if mode == 4:
    return #[0.0]
  return @storage.freeze found

func packed (values: Array F32) => return array.concat #[U32.to_f32 values.length] values

entry func probe (a: Array F32) : Array F32 => return do:
  let q = array.slice 1 16 a
  let authored = sources a 17 (F32.to_u32 a[0])
  return scene.with_built authored (func sc => return do:
    return array.concat (packed (query sc q false)) (packed (query sc q true)))

  // Return old-before, updated, rebuilt, exhaustive-new, old-after, exhaustive-old.

entry func update (a: Array F32) : Array F32 => return do:
  let before_count = F32.to_u32 a[0]
  let after_count = F32.to_u32 a[1]
  let dirty_count = F32.to_u32 a[2]
  let q = array.slice 3 16 a
  let before = sources a 19 before_count
  let after_start = 19 + before_count * stride
  let after = sources a after_start after_count
  let dirty_start = after_start + after_count * stride
  let dirty = @array.generate dirty_count (func (i: U32) => return F32.to_u32 a[dirty_start + i])
  return scene.with_built before (func live => return do:
    let empty: Array scene.Source = #[]
    return scene.with_built empty (func destination => return do:
      let old = scene.copy_into destination live
      let before_result = query live q false
      let changed = scene.update after live dirty
      return scene.with_built after (func fresh => return do:
        let out = packed before_result
        out := array.concat self (packed (query changed q false))
        out := array.concat self (packed (query fresh q false))
        out := array.concat self (packed (query fresh q true))
        out := array.concat self (packed (query old q false))
        out := array.concat self (packed (query old q true))
        return out)))


// A stored source/proxy carries spans, not live borrowed descriptors. Growing
// the named geometry pools does not change the earlier shape's captured extent.
entry func stored_geometry () : Array U32 => return do:
  return shapes.with_geometry (func geometry => return do:
    let first = shapes.box_poly geometry math.zero3 math.identity_quat math.one3
    let stored = shapes.pack geometry ($shapes.Hull first)
    let before = geometry.points.length
    shapes.box_poly geometry (math.vec3 10.0 0.0 0.0) math.identity_quat math.one3
    let restored = shapes.unpack geometry stored
    let (low, high) = shapes.bounds restored
    let source = scene.box 42 math.zero3 math.one3
    let row = scene.pack_source geometry source
    let unpacked = scene.unpack_source geometry row
    return #[unpacked.id, if geometry.points.length > before then 1 else 0,
      if low.x == -1.0 and high.x == 1.0 then 1 else 0])
