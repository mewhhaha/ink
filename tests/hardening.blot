  let aim_big = anim_ik.aim_chain #[math.identity_quat, math.identity_quat] #[3.0e38, 3.0e38] ($anim_ik.Axes { forward: math.forward, up: math.up }) math.right math.up 1.0 1.0
  let aim_big_ok = case aim_big of
