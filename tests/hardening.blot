  let refl_nan = reflections.influence (render.room_probe 1 1 math.zero3 math.one3) (math.vec3 nan 0.0 0.0)
  let refl_dist = reflections.box_distance (render.room_probe 1 1 math.zero3 math.zero3) (math.vec3 2.0e20 0.0 0.0)
  let aud_big = audio.mix audio.default_config
