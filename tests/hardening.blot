  let (p2_out, _) = d2_world.step_world ($Vec2 { x: 0.0, y: 0.0 }) 2.0 2 #[big_c]

  // animation/motion_match: zero weights skip Inf terms (no 0 * Inf = NaN); stats avoids raw sum overflow.
  let mm_neg = $anim_mm.Feature {
    foot_l: math.vec3 (-3.0e38) 0.0 0.0, foot_r: math.zero3, vel_l: math.zero3, vel_r: math.zero3, hip_vel: math.zero3,
