    $soft.Particle { position: math.vec3 (-1.0) 0.0 0.0, previous: math.vec3 (-1.0) 0.0 0.0, inv_mass: 1.0e38, radius: 0.1 },
    $soft.Particle { position: math.vec3 1.0 0.0 0.0, previous: math.vec3 1.0 0.0 0.0, inv_mass: 1.0e38, radius: 0.1 },
  ]

