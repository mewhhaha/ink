    $Some (c, r) => math.finite3 c and abs c.x < 1.0 and abs (r - 2.0) < 0.001
    $Nothing => false
  let rhs_big = net_interest.ray_hit_sphere (math.vec3 2.0e20 0.0 0.0) math.right 3.0e20 math.zero3 3.0e20
  let rhs_ok = case rhs_big of
    $Some t => is_finite t and abs (t - 1.0e20) < 1.0e17
    $Nothing => false
  let rhs_ext = net_interest.ray_hit_sphere (math.vec3 2.0e38 0.0 0.0) (math.vec3 (-1.0) 0.0 0.0) 3.0e38 (math.vec3 (-2.0e38) 0.0 0.0) 1.0e38
  let rhs_ext_ok = case rhs_ext of
