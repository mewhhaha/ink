  let proj0 = $ballistics.Projectile { position: math.vec3 1.0 0.0 0.0, velocity: math.vec3 3.0e38 0.0 0.0, drag: 0.0, gravity_scale: 0.0 }
  let proj1 = ballistics.step_projectile ($ballistics.Environment { gravity: math.zero3, wind: math.zero3 }) 2.0 proj0

