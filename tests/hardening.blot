    $Nothing => false
  let mm_hi_pos = $anim_mm.Feature {
    foot_l: math.vec3 3.3e38 0.0 0.0, foot_r: math.zero3, vel_l: math.zero3, vel_r: math.zero3, hip_vel: math.zero3,
    traj_pos0: math.zero3, traj_dir0: math.zero3, traj_pos1: math.zero3, traj_dir1: math.zero3, traj_pos2: math.zero3, traj_dir2: math.zero3,
  }
  let mm_hi_neg = $anim_mm.Feature {
    foot_l: math.vec3 (-3.3e38) 0.0 0.0, foot_r: math.zero3, vel_l: math.zero3, vel_r: math.zero3, hip_vel: math.zero3,
    traj_pos0: math.zero3, traj_dir0: math.zero3, traj_pos1: math.zero3, traj_dir1: math.zero3, traj_pos2: math.zero3, traj_dir2: math.zero3,
  }
  let mm_hi_stats = anim_mm.stats #[mm_hi_pos, mm_hi_neg, mm_hi_neg, mm_hi_neg]
  let mm_hi_ok = case mm_hi_stats of
