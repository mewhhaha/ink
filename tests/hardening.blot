  let tf_big = transform.affine2 ($transform.Pose2 { position: $Vec2 { x: 0.0, y: 0.0 }, angle: 50000.0, scale: $Vec2 { x: 1.0, y: 1.0 } })
  let sh_big = shadow.splits 0.1 100.0 0xFFFFFFFF 0.5
  let sh_eye = $shadow.Eye { position: math.zero3, forward: math.forward, fx: 1.0, fy: 1.0, near: 1.0, far: 2.0e20, perspective: true }
