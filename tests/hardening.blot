  let p_neg = #[$transform.Pose3 { position: math.vec3 (-3.0e38) 0.0 0.0, rotation: math.identity_quat, scale: math.one3 }]
  let p_pos = #[$transform.Pose3 { position: math.vec3 3.0e38 0.0 0.0, rotation: math.identity_quat, scale: math.one3 }]
  let pv_ov = anim_inert.pose_velocity p_neg p_pos 1.0
  let (tr_ok, tr_state) = anim_inert.transition p_neg #[anim_inert.zero_velocity] p_pos #[anim_inert.zero_velocity] #[anim_inert.zero_bone]

