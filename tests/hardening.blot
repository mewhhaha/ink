  }
  let mm_pos = $anim_mm.Feature {
    foot_l: math.vec3 3.0e38 0.0 0.0, foot_r: math.zero3, vel_l: math.zero3, vel_r: math.zero3, hip_vel: math.zero3,
    traj_pos0: math.zero3, traj_dir0: math.zero3, traj_pos1: math.zero3, traj_dir1: math.zero3, traj_pos2: math.zero3, traj_dir2: math.zero3,
  }
  let mm_zero_w = $anim_mm.Weights { foot_pos: 0.0, foot_vel: 0.0, hip_vel: 0.0, traj_pos: 0.0, traj_dir: 0.0 }
  let mm_match = anim_mm.search #[mm_neg] mm_pos mm_zero_w 0 0.0
  let mm_match_ok = case mm_match of
    $Some m => m.cost == 0.0
    $Nothing => false
  let mm_stats = anim_mm.stats #[mm_pos, mm_pos]
  let mm_stats_ok = case mm_stats of
    $Some (mu, sd) => math.finite3 mu.foot_l and math.finite3 sd.foot_l
    $Nothing => false
  let mm_w_neg = $anim_mm.Feature {
    foot_l: math.vec3 (-2.0e20) 0.0 0.0, foot_r: math.zero3, vel_l: math.zero3, vel_r: math.zero3, hip_vel: math.zero3,
    traj_pos0: math.zero3, traj_dir0: math.zero3, traj_pos1: math.zero3, traj_dir1: math.zero3, traj_pos2: math.zero3, traj_dir2: math.zero3,
  }
  let mm_w_pos = $anim_mm.Feature {
