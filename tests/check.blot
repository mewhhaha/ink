import * as array from "std/array"

// A check's outcome: whether it passed, and what it expected and what came.
type Check is data = #Check { passed: Bool, expected: Array F32, actual: Array F32 }

// `actual` is exactly `expected`, lane for lane.
const equal = fn (expected: Array F32) => fn (actual: Array F32) =>
  #Check { passed: same 0.0 expected actual, expected, actual }

// `actual` is `expected` to within `tolerance` in every lane.
const near = fn (tolerance: F32) => fn (expected: Array F32) => fn (actual: Array F32) =>
  #Check { passed: same tolerance expected actual, expected, actual }

// `condition` holds.
const holds = fn (condition: Bool) => do:
  let value = 0.0
  if condition:
    value := 1.0
  return #Check { passed: condition, expected: #[1.0], actual: #[value] }

// `value` lies in `low..high`, both ends included.
const within = fn (low: F32) => fn (high: F32) => fn (value: F32) =>
  #Check { passed: value >= low && value <= high, expected: #[low, high], actual: #[value] }

const same = fn (tolerance: F32) => fn (expected: Array F32) => fn (actual: Array F32) => do:
  if expected.length != actual.length:
    return #False
  for index in 0 .. expected.length:
    let exact = expected[index] == actual[index]
    if Bool.not (exact || abs (expected[index] - actual[index]) <= tolerance):
      return #False
  return #True

// What a test returns, as pen reads it: the checks made, the failures, then
// each failure's place (from 1), its expected lanes' count and lanes, and its
// actual lanes' count and lanes.
const report = fn (checks: Array Check) => do:
  let failures = #[]
  for index in 0 .. checks.length:
    let found = checks[index]
    if Bool.not found.passed:
      failures := array.concat self (array.flatten #[
        #[U32.to_f32 (index + 1), U32.to_f32 found.expected.length], found.expected,
        #[U32.to_f32 found.actual.length], found.actual,
      ])
  let failed = do:
    let count = 0
    for found in checks:
      if Bool.not found.passed:
        count := self + 1
    break count
  return array.concat #[U32.to_f32 checks.length, U32.to_f32 failed] failures

// Compare unsigned lanes without rounding identities through F32. Failure
// reports split each word into two exact 16-bit lanes (low, high).
const words = fn (expected: Array U32) (actual: Array U32) => do:
  let passed = expected.length == actual.length
  for index in 0 .. min expected.length actual.length:
    passed := self && expected[index] == actual[index]
  let lanes = fn values => array.flatten (array.map (fn value => #[U32.to_f32 (value % 65536), U32.to_f32 (value / 65536)]) values)
  return #Check {passed, expected: lanes expected, actual: lanes actual}
