import * as owned from "./physics_support"
import * as math from "ink/math"
import * as scene from "ink/physics/scene"
import * as physics from "ink/physics"
import * as joints from "ink/physics/joints"
import * as rigid from "ink/physics/rigid"

// Header: mode, dt, speed, anchor xyz, anchor velocity xyz; then body state.
// Cache is explicitly encoded after state (six contact lanes plus pair IDs
// constant in this handwritten fixture). One guest call advances one tick.
io tick (input: #[F32]) : #[F32] =>
  let mode = F32.to_u32 input[0]
  let anchor = scene.source 16777217 (math.vec3 input[3] input[4] input[5])
  let anchor_body = scene.default_rigid
  anchor_body.kind := $scene.Kinematic
  anchor_body.linear_velocity := math.vec3 input[6] input[7] input[8]
  if mode == 3:
    anchor.rigid := $Some anchor_body
  let source = scene.dynamic (scene.sphere 4294967295 (math.vec3 input[9] input[10] input[11]) 0.3)
  source.rotation := rigid.quat input 12
  let body = scene.default_rigid
  body.can_sleep := false
  body.continuous := false
  body.angular_damping := 0.0
  if mode == 6:
    body.sleeping := true
  body.linear_velocity := math.vec3 input[16] input[17] input[18]
  body.angular_velocity := math.vec3 input[19] input[20] input[21]
  source.rigid := $Some body
  let joint = joints.distance 0 1 math.zero3 math.zero3 1.0
  if mode == 1:
    joint := joints.spring 0 1 math.zero3 math.zero3 1.0 40.0 8.0
  if mode == 2:
    joint := joints.motor (joints.hinge 0 1 math.zero3 (math.vec3 (-1.0) 0.0 0.0) shapes_z shapes_z) input[2] 5.0
  let sources = #[anchor, source]
  if mode == 4:
    sources := #[...self, scene.box 3 (math.vec3 0.0 (-0.5) 0.0) (math.vec3 20.0 1.0 20.0)]
  let config = physics.default_config
  config.substeps := 8
  if mode == 1 or mode == 2 or mode == 3:
    config.gravity := math.zero3
  let contacts = @array.generate ((input.length - 22) / 10) (func (i: U32) =>
    let o = 22 + i * 10
    return $physics.CachedContact { a: 3, b: 4294967295, point: math.vec3 input[o] input[o + 1] input[o + 2], normal: math.vec3 input[o + 3] input[o + 4] input[o + 5], normal_impulse: input[o + 6], tangent_impulse: math.vec3 input[o + 7] input[o + 8] input[o + 9] })
  return owned.with_step sources contacts (func (own owned_step) =>
    owned_step := physics.step_joints_into #[joint] config input[1] owned_step
    let next = owned_step.sources
    let cache = physics.read_cache owned_step.cache
    let s = next[1]
    let $Some b = physics.source_rigid owned_step 1 else:
      return #[]
    let out = @array.fill (22 + cache.contacts.length * 10) 0.0
    for i in 0..9:
      out[i] := input[i]
    out[9] := s.position.x
    out[10] := s.position.y
    out[11] := s.position.z
    out[12] := s.rotation.x
    out[13] := s.rotation.y
    out[14] := s.rotation.z
    out[15] := s.rotation.w
    out[16] := b.linear_velocity.x
    out[17] := b.linear_velocity.y
    out[18] := b.linear_velocity.z
    out[19] := b.angular_velocity.x
    out[20] := b.angular_velocity.y
    out[21] := b.angular_velocity.z
    for i in 0..cache.contacts.length:
      let c = cache.contacts[i]
      let o = 22 + i * 10
      out[o] := c.point.x
      out[o + 1] := c.point.y
      out[o + 2] := c.point.z
      out[o + 3] := c.normal.x
      out[o + 4] := c.normal.y
      out[o + 5] := c.normal.z
      out[o + 6] := c.normal_impulse
      out[o + 7] := c.tangent_impulse.x
      out[o + 8] := c.tangent_impulse.y
      out[o + 9] := c.tangent_impulse.z
    return out
  )
const shapes_z = math.vec3 0.0 0.0 1.0

// Direct solver witness isolates joint cost without broad-phase scene building.
io thousand (count: U32) : F32 =>
  let pos = @array.fill (count * 3) 0.0
  let rot = @array.fill (count * 4) 0.0
  let iw = @array.fill (count * 6) 0.0
  for i in 0..count:
    pos[i * 3] := 1.1
    rot[i * 4 + 3] := 1.0
    iw[i * 6] := 1.0
    iw[i * 6 + 1] := 1.0
    iw[i * 6 + 2] := 1.0
  let links = @array.generate count (func (i: U32) => $joints.Link { joint: joints.distance 0 1 math.zero3 math.zero3 1.0, a: (-1.0), b: U32.to_f32 i, position_a: math.zero3, position_b: math.zero3, rotation_a: math.identity_quat, rotation_b: math.identity_quat, velocity_a: math.zero3, velocity_b: math.zero3, angular_a: math.zero3, angular_b: math.zero3 })
  let velocity = joints.solve (1.0 / 240.0) 0.0 pos rot (@array.fill count 1.0) iw links (@array.fill (count * 6) 0.0)
  let sum = 0.0
  for i in 0..count:
    sum := self + abs velocity[i * 6]
  return sum
io validity (input: #[F32]) : U32 =>
  let j = joints.distance 0 1 math.zero3 math.zero3 1.0
  j.length := input[0]
  j.stiffness := input[1]
  j.damping := input[2]
  j.motor_speed := input[3]
  j.motor_torque := input[4]
  if joints.valid j:
    return 1
  return 0
