import * as check from "./check"
import * as math from "ink/math"
import * as sg from "ink/scene_graph"
import * as transform from "ink/transform"

func pose_at (x: F32) -> (y: F32) -> (z: F32) : transform.Pose3 =>
  return $transform.Pose3 { position: math.vec3 x y z, rotation: math.identity_quat, scale: math.one3 }

entry func test_hierarchy_propagates_transforms_and_visibility () =>
  let nodes: #[sg.Node] = #[
    sg.root_node 10 (pose_at 5.0 0.0 0.0) 1 1,
    sg.child_node 20 0 ($transform.Pose3 {
      position: math.vec3 0.0 2.0 0.0,
      rotation: math.Quat.yaw 1.5707963,
      scale: math.vec3 2.0 2.0 2.0,
    }) 2 1,
    sg.child_node 30 1 (pose_at 0.0 0.0 3.0) 3 1,
  ]
  let resolved = sg.resolve (&nodes[0..3])
  let barrel_pos = Maybe.unwrap_or math.zero3 (sg.world_position_of (&resolved[0..3]) 30)
  // Yaw +90 deg maps local +Z (0, 0, 3) * scale 2 -> (+6, 0, 0), plus parent (5, 2, 0) = (11, 2, 0).
  nodes[0].visible := false
  let hidden = sg.resolve (&nodes[0..3])
  return check.report #[
    check.near 0.01 #[11.0, 2.0, 0.0] #[barrel_pos.x, barrel_pos.y, barrel_pos.z],
    check.holds resolved[2].visible,
    check.holds (not hidden[2].visible),
  ]

entry func test_prefab_instantiation_applies_sparse_overrides () =>
  let prefab: #[sg.Node] = #[
    sg.root_node 1 (pose_at 0.0 1.0 0.0) 0 1,
    sg.child_node 2 0 (pose_at 0.0 0.0 2.0) 1 1,
  ]
  let ovs: #[sg.PrefabOverride] = #[
    $sg.PrefabOverride {
      target_id: 2,
      flags: sg.ov_position | sg.ov_material | sg.ov_tag,
      position: math.vec3 0.0 0.0 4.0,
      rotation: math.identity_quat,
      scale: math.one3,
      visible: true,
      material: 9,
      tag: 42,
    },
  ]
  let inst = sg.instantiate_prefab 100 (&prefab[0..2]) (pose_at 10.0 0.0 0.0) (&ovs[0..1])
  let resolved = sg.resolve (&inst[0..inst.length])
  let p = resolved[2].world.position
  return check.report #[
    check.words #[3, sg.no_mesh, 9, 42, 1] #[resolved.length, inst[0].mesh, resolved[2].material, resolved[2].tag, prefab[1].material],
    check.near 0.01 #[10.0, 1.0, 4.0] #[p.x, p.y, p.z],
    check.holds (sg.valid_topology (&inst[0..inst.length])),
  ]

entry func test_prefab_instantiation_preserves_shear_under_nonuniform_root () =>
  // Template root rotated 45 deg about Y under non-uniform root scale (2, 1, 1) must
  // compose via Affine3 so world X and Z columns become non-orthogonal (sheared), and
  // child offsets inherit the exact sheared basis rather than TRS-approximated scale.
  let prefab: #[sg.Node] = #[
    sg.root_node 1 ($transform.Pose3 {
      position: math.vec3 0.0 1.0 0.0,
      rotation: math.Quat.yaw 0.7853982,
      scale: math.one3,
    }) 0 1,
    sg.child_node 2 0 (pose_at 1.0 0.0 0.0) 1 1,
  ]
  let root_pose = $transform.Pose3 {
    position: math.vec3 10.0 0.0 0.0,
    rotation: math.identity_quat,
    scale: math.vec3 2.0 1.0 1.0,
  }
  let empty_ovs: #[sg.PrefabOverride] = #[]
  let inst = sg.instantiate_prefab 999 (&prefab[0..2]) root_pose (&empty_ovs[0..0])
  let resolved = sg.resolve (&inst[0..inst.length])
  let rw = resolved[1].world
  // Local +X rotated +45 deg about Y is (c, 0, -s); scaled by (2, 1, 1) -> (sqrt(2), 0, -sqrt(2)/2).
  // Local +Z rotated +45 deg about Y is (s, 0,  c); scaled by (2, 1, 1) -> (sqrt(2), 0,  sqrt(2)/2).
  // Dot product x . z = 2.0 - 0.5 = 1.5 (exact shear!).
  let shear_dot = rw.x.dot rw.z
  let child_p = resolved[2].world.position
  return check.report #[
    check.near 0.002 #[1.5, 11.414214, 1.0, (-0.707107)] #[shear_dot, child_p.x, child_p.y, child_p.z],
    check.holds (sg.valid_topology (&inst[0..inst.length])),
  ]
