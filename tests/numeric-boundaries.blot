import * as math from "ink/math"
import * as camera from "ink/camera"
import * as color from "ink/color"
import * as motion from "ink/motion"
import * as animation from "ink/animation"
import * as transform from "ink/transform"
import * as audio from "ink/audio"
import * as scene from "ink/scene"
func pose (x: F32) => $transform.Pose3 { position: math.vec3 x 0.0 0.0,rotation: math.identity_quat,scale: math.one3 }
entry func quaternion (a: #[F32]) : #[F32] => case math.normalize_quat ($math.Quat { x: a[0],y: a[1],z: a[2],w: a[3] }) of
  $Nothing => #[]
  $Some q => #[q.x,q.y,q.z,q.w]
entry func directions (a: #[F32]) : #[F32] =>
  let look = math.look_rotation (math.vec3 a[0] a[1] a[2]) math.up
  let axis = math.axis_angle math.zero3 1.2
  return #[look.x,look.y,look.z,look.w,axis.x,axis.y,axis.z,axis.w]
entry func logarithm (x: F32) : #[F32] => case color.logarithm x of
  $Nothing => #[]
  $Some value => #[value]
entry func tone (x: F32) : F32 => color.tone_channel x
entry func unchecked_log (x: F32) : F32 => color.log2 x
entry func project (a: #[F32]) : #[F32] =>
  let c = $camera.Camera { position: math.vec3 a[0] 0.0 0.0,rotation: $math.Quat { x: 0.0,y: 0.0,z: 0.0,w: a[1] },projection: $camera.Perspective { fov_y: 1.0,aspect: 1.0,near: 0.1,far: 100.0,reversed: false } }
  return case camera.project c (math.vec3 a[2] 0.0 a[3]) of
    $Nothing => #[]
    $Some value => #[value.x,value.y,value.z]
entry func unproject (z: F32) : #[F32] =>
  let c = $camera.Camera { position: math.zero3,rotation: math.identity_quat,projection: $camera.Orthographic { height: 1.0,aspect: 1.0,near: 0.0,far: 1.0,reversed: false } }
  return case camera.unproject c (math.vec3 0.0 0.0 z) of
    $Nothing => #[]
    $Some value => #[value.x,value.y,value.z]
entry func spring (a: #[F32]) : #[F32] => case motion.checked_spring ($motion.Spring { value: a[0],velocity: a[1] }) a[2] a[3] a[4] a[5] of
  $Nothing => #[]
  $Some value => #[value.value,value.velocity]
func with_authored (a: #[F32]) -> consume =>
  let keys = @array.generate ((a.length - 3) / 2) (func (i: U32) => $animation.Key { time: a[i * 2 + 3],pose: pose a[i * 2 + 4] })
  let tracks = #[$animation.Track {start: 0,count: keys.length}]
  let events = #[{time: a[1],id: 7}]
  return consume ($animation.Clip {duration: a[0],keys: keys.view 0 keys.length,tracks: tracks.view 0 tracks.length,events: events.view 0 events.length})
entry func validate_clip (a: #[F32]) : #[F32] => with_authored a (func authored => case animation.validate authored of
  $Nothing => #[]
  $Some clip => #[(animation.sample clip a[2] false)[0].position.x])
entry func window (a: #[F32]) : #[F32] =>
  let keys = #[$animation.Key {time: 0.0,pose: pose 0.0},$animation.Key {time: a[0],pose: pose 10.0}]
  let tracks = #[$animation.Track {start: 0,count: keys.length}]
  let events = #[{time: 0.0,id: 7}]
  let clip = $animation.Clip {duration: a[0],keys: keys.view 0 keys.length,tracks: tracks.view 0 tracks.length,events: events.view 0 events.length}
  let root = animation.root_motion clip a[1] a[2] true
  return #[root.translation.x,U32.to_f32 (animation.events clip a[1] a[2] true).length]
entry func parents (a: #[U32]) : Bool => animation.valid_parents a a.length
entry func sound (a: #[F32]) : #[F32] =>
  let config = audio.default_config
  config.reference := a[0]
  let listener = $audio.Listener { position: math.zero3,velocity: math.zero3,right: math.zero3 }
  let emitter = $audio.Emitter { position: math.vec3 a[1] 0.0 0.0,velocity: math.zero3,gain: a[2] }
  let sources: #[scene.Source] = #[]
  return scene.with_built sources (func built => case audio.query config listener emitter built 4294967295 0 of
    $Nothing => #[]
    $Some value => #[value.gain,value.pan,value.rate,value.cutoff])

entry func normalize_vector (a: #[F32]) : #[F32] => case math.normalize3 (math.vec3 a[0] a[1] a[2]) of
  $Nothing => #[]
  $Some value => #[value.x,value.y,value.z]
entry func pick (x: F32) : #[F32] =>
  let c = $camera.Camera { position: math.zero3,rotation: math.identity_quat,projection: $camera.Perspective { fov_y: 1.0,aspect: 1.0,near: 0.1,far: 100.0,reversed: false } }
  return case camera.pick_ray c x 0.0 of
    $Nothing => #[]
    $Some ray => #[ray.direction.x,ray.direction.y,ray.direction.z]
