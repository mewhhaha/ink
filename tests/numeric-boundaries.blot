import * as math from "ink/math"
import * as camera from "ink/camera"
import * as color from "ink/color"
import * as motion from "ink/motion"
import * as animation from "ink/animation"
import * as transform from "ink/transform"
import * as audio from "ink/audio"
import * as scene from "ink/scene"
const pose = func (x: F32) => return $transform.Pose3 { position: math.vec3 x 0.0 0.0,rotation: math.identity_quat,scale: math.one3 }
entry const quaternion = func (a: Array F32) : Array F32 => return case math.normalize_quat ($math.Quat { x: a[0],y: a[1],z: a[2],w: a[3] }) of
  $Nothing => #[]
  $Some q => #[q.x,q.y,q.z,q.w]
entry const directions = func (a: Array F32) : Array F32 => return do:
  let look = math.look_rotation (math.vec3 a[0] a[1] a[2]) math.up
  let axis = math.axis_angle math.zero3 1.2
  return #[look.x,look.y,look.z,look.w,axis.x,axis.y,axis.z,axis.w]
entry const logarithm = func (x: F32) : Array F32 => return case color.logarithm x of
  $Nothing => #[]
  $Some value => #[value]
entry const tone = func (x: F32) : F32 => return color.tone_channel x
entry const unchecked_log = func (x: F32) : F32 => return color.log2 x
entry const project = func (a: Array F32) : Array F32 => return do:
  let c = $camera.Camera { position: math.vec3 a[0] 0.0 0.0,rotation: $math.Quat { x: 0.0,y: 0.0,z: 0.0,w: a[1] },projection: $camera.Perspective { fov_y: 1.0,aspect: 1.0,near: 0.1,far: 100.0,reversed: false } }
  return case camera.project c (math.vec3 a[2] 0.0 a[3]) of
    $Nothing => #[]
    $Some value => #[value.x,value.y,value.z]
entry const unproject = func (z: F32) : Array F32 => return do:
  let c = $camera.Camera { position: math.zero3,rotation: math.identity_quat,projection: $camera.Orthographic { height: 1.0,aspect: 1.0,near: 0.0,far: 1.0,reversed: false } }
  return case camera.unproject c (math.vec3 0.0 0.0 z) of
    $Nothing => #[]
    $Some value => #[value.x,value.y,value.z]
entry const spring = func (a: Array F32) : Array F32 => return case motion.checked_spring ($motion.Spring { value: a[0],velocity: a[1] }) a[2] a[3] a[4] a[5] of
  $Nothing => #[]
  $Some value => #[value.value,value.velocity]
const authored = func (a: Array F32) => return do:
  let keys = @array.generate ((a.length - 3) / 2) (func (i: U32) => return $animation.Key { time: a[i * 2 + 3],pose: pose a[i * 2 + 4] })
  return $animation.Clip { duration: a[0],tracks: #[$animation.Track { keys }],events: #[{ time: a[1],id: 7 }] }
entry const validate_clip = func (a: Array F32) : Array F32 => return case animation.validate (authored a) of
  $Nothing => #[]
  $Some clip => #[(animation.sample clip a[2] false)[0].position.x]
entry const window = func (a: Array F32) : Array F32 => return do:
  let clip = $animation.Clip { duration: a[0],tracks: #[$animation.Track { keys: #[$animation.Key { time: 0.0,pose: pose 0.0 },$animation.Key { time: a[0],pose: pose 10.0 }] }],events: #[{ time: 0.0,id: 7 }] }
  let root = animation.root_motion clip a[1] a[2] true
  return #[root.translation.x,U32.to_f32 (animation.events clip a[1] a[2] true).length]
entry const parents = func (a: Array U32) : Bool => return animation.valid_parents a a.length
entry const sound = func (a: Array F32) : Array F32 => return do:
  let config = audio.default_config
  config.reference := a[0]
  let listener = $audio.Listener { position: math.zero3,velocity: math.zero3,right: math.zero3 }
  let emitter = $audio.Emitter { position: math.vec3 a[1] 0.0 0.0,velocity: math.zero3,gain: a[2] }
  return case audio.query config listener emitter (scene.build #[]) 4294967295 0 of
    $Nothing => #[]
    $Some value => #[value.gain,value.pan,value.rate,value.cutoff]

entry const normalize_vector = func (a: Array F32) : Array F32 => return case math.normalize3 (math.vec3 a[0] a[1] a[2]) of
  $Nothing => #[]
  $Some value => #[value.x,value.y,value.z]
entry const pick = func (x: F32) : Array F32 => return do:
  let c = $camera.Camera { position: math.zero3,rotation: math.identity_quat,projection: $camera.Perspective { fov_y: 1.0,aspect: 1.0,near: 0.1,far: 100.0,reversed: false } }
  return case camera.pick_ray c x 0.0 of
    $Nothing => #[]
    $Some ray => #[ray.direction.x,ray.direction.y,ray.direction.z]
