import * as owned from "./physics_support"
import * as math from "ink/math"
import * as physics from "ink/physics"
import * as scene from "ink/physics/scene"

io ids (ids: #[U32]) : #[U32] =>
  let floor = scene.box ids[0] (math.vec3 0.0 (-0.5) 0.0) (math.vec3 20.0 1.0 20.0)
  let left = scene.dynamic (scene.box ids[1] (math.vec3 (-2.0) 0.49 0.0) math.one3)
  let right = scene.dynamic (scene.box ids[2] (math.vec3 2.0 0.49 0.0) math.one3)
  return owned.with_step #[floor, left, right] #[] (func (own step) =>
    step := physics.step_into physics.default_config (1.0 / 60.0) step
    step := physics.step_into physics.default_config (1.0 / 60.0) step
    let cache = physics.read_cache step.cache
    let out: #[U32] = #[physics.contact_count cache]
    for c in cache.contacts:
      @storage.push out c.a
      @storage.push out c.b
    @storage.push out (if physics.touching cache ids[0] ids[1] then 1 else 0)
    @storage.push out (if physics.touching cache ids[2] ids[0] then 1 else 0)
    @storage.push out (if physics.touching cache ids[1] ids[2] then 1 else 0)
    @storage.push out (if physics.touching cache ids[0] ids[3] then 1 else 0)
    let hit = physics.with_sources step (func values => scene.with_built values (func built => scene.ray built (math.vec3 2.0 4.0 0.0) (math.up * (-1.0)) 8.0 65535 0))
    if let $Some h = hit:
      @storage.push out h.id
    return out)

io sleeping (ids: #[U32]) : #[U32] =>
  let floor = scene.box ids[0] (math.vec3 0.0 (-0.5) 0.0) (math.vec3 20.0 1.0 20.0)
  let body = scene.dynamic (scene.box ids[1] (math.vec3 0.0 0.49 0.0) math.one3)
  return owned.with_step #[floor, body] #[] (func (own step) =>
    step := physics.step_into physics.default_config (1.0 / 60.0) step
    let first_snapshot: #[physics.CachedContact] = physics.copy_cache_into (physics.read_cache step.cache) #[]
    let $Some b = physics.source_rigid step 1 else:
      return #[]
    b.sleeping := true
    b.linear_velocity := math.zero3
    b.angular_velocity := math.zero3
    step := physics.set_rigid 1 b step
    step := physics.step_into physics.default_config (1.0 / 60.0) step
    let retained_snapshot: #[physics.CachedContact] = physics.copy_cache_into (physics.read_cache step.cache) #[]
    let replaced = (step.sources.at 1)
    replaced.id := ids[2]
    step.sources[1] := replaced
    step := physics.step_into physics.default_config (1.0 / 60.0) step
    let cleaned = physics.read_cache step.cache
    return #[first_snapshot.length, retained_snapshot.length, physics.contact_count cleaned, retained_snapshot[0].a, retained_snapshot[0].b])

io unchanged (dt: F32) : #[F32] =>
  let body = scene.dynamic (scene.box 1 (math.vec3 0.0 10.0 0.0) math.one3)
  return owned.with_step #[body] #[] (func (own step) =>
    step := physics.step_into physics.default_config dt step
    return #[(step.sources.at 0).position.y, U32.to_f32 (physics.contact_count (physics.read_cache step.cache))])
