import * as math from "ink/math"
import * as physics from "ink/physics"
import * as scene from "ink/scene"

entry const ids = fn (ids: Array U32) -> Array U32 => do:
  let floor = scene.box ids[0] (math.vec3 0.0 (-0.5) 0.0) (math.vec3 20.0 1.0 20.0)
  let left = scene.dynamic (scene.box ids[1] (math.vec3 (-2.0) 0.49 0.0) math.one3)
  let right = scene.dynamic (scene.box ids[2] (math.vec3 2.0 0.49 0.0) math.one3)
  let sources = #[floor, left, right]
  let (next, first) = physics.step physics.default_config (1.0 / 60.0) sources physics.empty_cache
  let (last, cache) = physics.step physics.default_config (1.0 / 60.0) next first
  let out: List U32 = [physics.contact_count cache]
  for c in cache.contacts:
    out := [...self, c.a, c.b]
  out := [...self, if physics.touching cache ids[0] ids[1] then 1 else 0]
  out := [...self, if physics.touching cache ids[2] ids[0] then 1 else 0]
  out := [...self, if physics.touching cache ids[1] ids[2] then 1 else 0]
  out := [...self, if physics.touching cache ids[0] ids[3] then 1 else 0]
  let hit = scene.ray (scene.build last) (math.vec3 2.0 4.0 0.0) (math.up * (-1.0)) 8.0 65535 0
  if let #Some h = hit:
    out := [...self, h.id]
  return Array.from_list out

entry const sleeping = fn (ids: Array U32) -> Array U32 => do:
  let floor = scene.box ids[0] (math.vec3 0.0 (-0.5) 0.0) (math.vec3 20.0 1.0 20.0)
  let body = scene.dynamic (scene.box ids[1] (math.vec3 0.0 0.49 0.0) math.one3)
  let (sources, cache) = physics.step physics.default_config (1.0 / 60.0) #[floor, body] physics.empty_cache
  let #Some b = sources[1].rigid else:
    return #[]
  b.sleeping := #True
  b.linear_velocity := math.zero3
  b.angular_velocity := math.zero3
  let s = sources[1]
  s.rigid := #Some b
  sources[1] := s
  let (same, retained) = physics.step physics.default_config (1.0 / 60.0) sources cache
  let replaced = same[1]
  replaced.id := ids[2]
  same[1] := replaced
  let (removed, cleaned) = physics.step physics.default_config (1.0 / 60.0) same retained
  return #[physics.contact_count cache, physics.contact_count retained, physics.contact_count cleaned, retained.contacts[0].a, retained.contacts[0].b]

entry const unchanged = fn (dt: F32) -> Array F32 => do:
  let body = scene.dynamic (scene.box 1 (math.vec3 0.0 10.0 0.0) math.one3)
  let (sources, cache) = physics.step physics.default_config dt #[body] physics.empty_cache
  return #[sources[0].position.y, U32.to_f32 (physics.contact_count cache)]
