import * as array from "std/array"
import * as director from "ink/director"
import * as math from "ink/math"
import * as motion from "ink/motion"
import * as tween from "ink/tween"
import * as view from "ink/view"

func at (x: F32) => func (y: F32) => func (z: F32) => func (rotation: math.Quat) => func (focal_length: F32) => return
  $director.Pose { camera: $view.Camera { position: math.vec3 x y z, rotation }, focal_length }

// Shot 1 starts at the origin and moves along +X at `speed` metres a second
// of `time`; shots 2 and 3 stand still.
func moving (time: F32) => func (speed: F32) => func (id: U32) => case id of
  1 => at (time * speed) 0.0 0.0 math.identity_quat 1.0
  2 => at 4.0 2.0 (-8.0) (math.axis_angle math.up (pi * 0.5)) 4.0
  3 => at (-2.0) 6.0 2.0 (math.axis_angle math.right (-0.5)) 2.0
  _ => at 0.0 0.0 0.0 math.identity_quat 1.0

const shots = moving 0.0 0.0

func ease (kind: F32) => case F32.to_u32 kind of
  0 => $tween.Linear
  1 => $tween.Smooth
  2 => $tween.Smoother
  3 => $tween.CubicIn
  4 => $tween.CubicOut
  5 => $tween.CubicInOut
  6 => $tween.Back
  7 => $tween.Hold
  _ => $tween.Steps 4

func lanes (pose: director.Pose) => director.pose_lanes pose

func flag (value: Bool) => if value then 1.0 else 0.0

func append (output: #[+F32]) -> (values: #[F32]) =>
  for value in values:
    @storage.push output value
  return ()

// Blends from shot 1 to shot 2 over input[1] seconds eased by input[0], then
// advances input[2] and input[3] seconds: whether it still blends, the pose.
entry func blended (input: #[F32]) : #[F32] =>
  let $Some state = director.blend (director.start 1) 2 input[1] (ease input[0]) shots else:
    return #[]
  let $Some first = director.advance state input[2] else:
    return #[]
  let $Some second = director.advance first input[3] else:
    return #[]
  return array.concat #[flag (director.blending second)] (lanes (director.pose second shots))

entry func shot (id: U32) : #[F32] => lanes (shots id)

// Cuts to shot 3 half a second into a blend from shot 1 to shot 2.
entry func cut () : #[F32] =>
  let $Some state = director.blend (director.start 1) 2 2.0 $tween.Linear shots else:
    return #[]
  let $Some later = director.advance state 0.5 else:
    return #[]
  let instant = director.cut later 3
  return array.concat #[flag (director.blending instant)] (lanes (director.pose instant shots))

// Blends from shot 1 to 2 over 2 s (smooth), advances input[0] seconds, then
// blends to shot 3 over 1 s (smoother) and advances input[1] seconds: the pose
// before the interruption, just after it, input[1] later, and the source tag.
entry func interrupted (input: #[F32]) : #[F32] =>
  let $Some state = director.blend (director.start 1) 2 2.0 $tween.Smooth shots else:
    return #[]
  let $Some later = director.advance state input[0] else:
    return #[]
  let before = director.pose later shots
  let $Some redirected = director.blend later 3 1.0 $tween.Smoother shots else:
    return #[]
  let after = director.pose redirected shots
  let $Some ended = director.advance redirected input[1] else:
    return #[]
  let saved = director.encode redirected
  let output: #[+F32] = #[]
  append output (lanes before)
  append output (lanes after)
  append output (lanes (director.pose ended shots))
  append output #[saved[2], flag (director.blending ended)]
  return seal output

// A blend from shot 1, which moves at input[1] m/s, to shot 2 over 1 s,
// input[0] seconds in: the outgoing shot is evaluated where it is now.
entry func live (input: #[F32]) : #[F32] =>
  let $Some state = director.blend (director.start 1) 2 1.0 $tween.Linear (moving 0.0 input[1]) else:
    return #[]
  let $Some later = director.advance state input[0] else:
    return #[]
  return lanes (director.pose later (moving input[0] input[1]))

// Whether blending over input[0] seconds and advancing input[1] seconds are
// accepted.
entry func accepted (input: #[F32]) : #[F32] =>
  let state = director.start 1
  let blends = case director.blend state 2 input[0] $tween.Linear shots of
    $Some _ => 1.0
    $Nothing => 0.0
  let advances = case director.advance state input[1] of
    $Some _ => 1.0
    $Nothing => 0.0
  return #[blends, advances]

// Blending to the live shot mid-blend changes nothing; a zero-duration blend
// cuts. The saved lanes before and after, then the cut's blending flag and pose.
entry func unchanged () : #[F32] =>
  let $Some state = director.blend (director.start 1) 2 2.0 $tween.CubicOut shots else:
    return #[]
  let $Some later = director.advance state 0.5 else:
    return #[]
  let $Some again = director.blend later 2 0.25 $tween.Linear shots else:
    return #[]
  let $Some instant = director.blend later 3 0.0 $tween.Linear shots else:
    return #[]
  let output: #[+F32] = #[]
  append output (director.encode later)
  append output (director.encode again)
  append output #[flag (director.blending instant)]
  append output (lanes (director.pose instant shots))
  return seal output

// The saved lanes of a settled, a live and a frozen director, each followed by
// the lanes it decodes back to.
entry func saved () : #[F32] =>
  let settled = director.start 7
  let $Some live = director.blend settled 9 1.5 ($tween.Steps 5) shots else:
    return #[]
  let $Some later = director.advance live 0.25 else:
    return #[]
  let $Some frozen = director.blend (director.cut later 1) 2 2.0 $tween.Back shots else:
    return #[]
  let $Some moved = director.advance frozen 0.5 else:
    return #[]
  let $Some held = director.blend moved 3 3.0 $tween.CubicInOut shots else:
    return #[]
  let states = #[settled, later, held]
  let output: #[+F32] = #[]
  for state in states:
    append output (director.encode state)
  for state in states:
    let saved = director.encode state
    append output (director.encode (director.decode saved))
  return seal output

entry func saved_shot (id: U32) : U32 =>
  let other = if id == 0 then 1 else id - 1
  let $Some state = director.blend (director.start other) id 1.0 ($tween.Steps id) shots else:
    return 0
  let restored = director.decode (director.encode state)
  let outgoing = case restored.source of
    $director.Live value => value
    _ => 0
  let steps = case restored.ease of
    $tween.Steps count => count
    _ => 0
  if outgoing != other or steps != id:
    return 0
  return restored.shot

entry func decode (values: #[F32]) : F32 => (director.decode values).elapsed

// Shot 2 shaken by an impulse with translation input[0..3] and rotation
// input[3..6].
entry func shaken (input: #[F32]) : #[F32] =>
  let impulse = $motion.Impulse {
    translation: $motion.Spring3 { value: math.vec3 input[0] input[1] input[2], velocity: math.vec3 1.0 2.0 3.0 },
    rotation: $motion.Spring3 { value: math.vec3 input[3] input[4] input[5], velocity: math.vec3 3.0 2.0 1.0 },
  }
  return lanes (director.shaken (shots 2) impulse)

// A seeded kick settled for `seconds`: its translation and rotation, then
// shot 2 shaken by it.
entry func settled_shake (seconds: F32) : #[F32] =>
  let (kicked, _) = motion.seeded_kick motion.empty_impulse 99 2.0
  let impulse = motion.settle kicked 20.0 0.8 seconds
  let $motion.Impulse { translation, rotation } = impulse
  let moved = translation.value
  let turned = rotation.value
  return array.concat #[moved.x, moved.y, moved.z, turned.x, turned.y, turned.z] (lanes (director.shaken (shots 2) impulse))

// A tween of poses from shot 1 to shot 3 between 1 and 3 seconds, at `time`,
// then Pose.lerp of the two at a half.
entry func tweened (time: F32) : #[F32] =>
  let $Some travel = tween.make (shots 1) (shots 3) 1.0 2.0 $tween.Linear else:
    return #[]
  return array.concat (lanes (tween.at travel time)) (lanes ((shots 1).lerp (shots 3) 0.5))

// The focal length at `t` of the way from input[0] to input[1].
entry func zoom (input: #[F32]) : F32 =>
  let a = at 0.0 0.0 0.0 math.identity_quat input[0]
  let b = at 0.0 0.0 0.0 math.identity_quat input[1]
  return (a.lerp b input[2]).focal_length

// Shot 2's lens over a base lens, and its projection's focal lanes.
entry func lens () : #[F32] =>
  let base = $view.Lens { focal_length: 1.0, near: 0.25, far: 500.0 }
  let pose = shots 2
  let applied = director.lens pose base
  let projection = director.projection pose base 2.0
  let expected = view.perspective applied 2.0
  let framed = director.framed pose.camera applied
  let view_matrix = director.matrix pose
  return #[
    applied.focal_length, applied.near, applied.far,
    projection.x.x, projection.y.y, projection.z.z, projection.w.z,
    expected.x.x, expected.y.y, expected.z.z, expected.w.z,
    framed.focal_length, view_matrix.w.x, view_matrix.w.y, view_matrix.w.z,
  ]

// Benchmark: `count` frames of 1/16 s, eight a group. Each group blends from
// shot 2g + 1 (x = g) to shot 2g + 2 (x = g + 1) over a quarter second, is
// interrupted two frames in toward shot 2g + 3 (also x = g + 1), and settles
// three frames later. Frames sum x; interruptions record their largest jump;
// every state round-trips its lanes; a tween of poses and a shake run beside.
func group_shot (id: U32) =>
  let rotation = math.axis_angle math.up (U32.to_f32 (id % 7) * 0.25)
  return at (U32.to_f32 (id / 2)) 0.0 0.0 rotation (1.0 + U32.to_f32 (id % 3))

func difference (a: director.Pose) => func (b: director.Pose) =>
  let x = director.pose_lanes a
  let y = director.pose_lanes b
  let most = 0.0
  for index in 0 .. 8:
    most := max self (abs (x[index] - y[index]))
  return most

entry func director_workload (count: U32) : #[F32] =>
  let state = director.start 1
  let sum = 0.0
  let jump = 0.0
  let mismatched = 0
  let settled = 0
  let tweens = 0.0
  let shake = 0.0
  let impulse = $motion.Impulse { translation: $motion.Spring3 { value: math.vec3 0.0 0.5 0.0, velocity: math.zero3 }, rotation: $motion.Spring3 { value: math.vec3 0.0 0.1 0.0, velocity: math.zero3 } }
  let $Some travel = tween.make (group_shot 0) (group_shot 2) 0.0 1.0 $tween.Linear else:
    return #[]
  for i in 0 .. count:
    let group = i / 8
    let frame = i % 8
    if frame == 0:
      let $Some next = director.blend state (2 * group + 2) 0.25 $tween.Linear group_shot else:
        return #[]
      state := next
    if frame == 2:
      let before = director.pose state group_shot
      let $Some next = director.blend state (2 * group + 3) 0.25 $tween.Linear group_shot else:
        return #[]
      state := next
      jump := max self (difference before (director.pose state group_shot))
    let $Some next = director.advance state 0.0625 else:
      return #[]
    state := next
    if not (director.blending state):
      settled := self + 1
    let saved = director.encode state
    let again = director.encode (director.decode saved)
    for index in 0 .. 16:
      if saved[index] != again[index]:
        mismatched := self + 1
    let shown = director.pose state group_shot
    sum := self + shown.camera.position.x
    shake := self + (director.shaken shown impulse).camera.position.y
    tweens := self + (tween.at travel (U32.to_f32 frame * 0.125)).camera.position.x
  return #[U32.to_f32 count, sum, jump, U32.to_f32 mismatched, U32.to_f32 settled, tweens, shake]
