import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as math from "ink/math"
import * as render from "ink/render"
import * as reflections from "ink/render/reflections"

func vec (a: #[F32]) => func (i: U32) => math.vec3 a[i] a[i + 1] a[i + 2]

// Probes packed as id, priority, centre3, extent3, blend (nine lanes each),
// from lane `first`; position and parallax box are the box's.
func probes_from (a: #[F32]) => func (first: U32) =>
  let n = F32.to_u32 a[first]
  return array.generate n (func (i: U32) =>
    let o = first + 1 + i * 9
    let centre = vec a (o + 2)
    let half = vec a (o + 5)
    return $render.ReflectionProbe {
      id: F32.to_u32 a[o], revision: 1, priority: F32.to_u32 a[o + 1], capture: false,
      position: centre, centre, extent: half, blend: a[o + 8],
      parallax_centre: centre, parallax_extent: half, far: 10.0,
    })

// The query point (3 lanes), then the probes. Each probe's share, then the coverage.
entry func shares (a: #[F32]) : #[F32] =>
  let probes = probes_from a 3
  let found = reflections.shares (&probes[0..probes.length]) (vec a 0)
  let sum = 0.0
  for i in 0 .. found.length:
    sum := self + found[i]
  return array.concat found #[sum, reflections.coverage (&probes[0..probes.length]) (vec a 0)]

// The probe's position3, parallax centre3 and half size3, a point3 and a direction3.
entry func projected (a: #[F32]) : #[F32] =>
  let probe = $render.ReflectionProbe {
    id: 1, revision: 1, priority: 0, capture: false,
    position: vec a 0, centre: math.zero3, extent: math.vec3 1.0 1.0 1.0, blend: 0.0,
    parallax_centre: vec a 3, parallax_extent: vec a 6, far: 10.0,
  }
  let out = reflections.box_projected probe (vec a 9) (vec a 12)
  return #[out.x, out.y, out.z]

// The eye3 and slots, then the probes. The indices the host would keep.
entry func chosen (a: #[F32]) : #[F32] =>
  let probes = probes_from a 4
  let kept = reflections.choose (&probes[0..probes.length]) (vec a 0) (F32.to_u32 a[3])
  return array.generate kept.length (func (i: U32) => U32.to_f32 kept[i])
