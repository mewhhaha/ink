import * as check from "./check"
import * as ecs from "ink/ecs"
import * as persist from "ink/persist"
import * as words from "ink/persist/words"
import * as lanes from "ink/lanes"
import * as codec from "ink/codec"
func number_decode (values: Array F32) => return do:
  lanes.exact values 1
  return lanes.integer values[0] lanes.max_integer
const number = $lanes.Codec {key: 200, version: 1,
  encode: func (value: U32) => return #[U32.to_f32 value],
  decode: number_decode, migrate: lanes.no_migration}
func scalar value => return Maybe.unwrap_or 0 value
entry func test_current_and_previous_columns_round_trip_independently () => return do:
  let alive: ecs.Entities = ecs.entities ()
  let meta = ecs.metadata 1
  let current: ecs.Pool U32 = ecs.pool ()
  let current_meta = ecs.metadata 1
  let previous: ecs.Pool U32 = ecs.pool ()
  let first = ecs.spawn alive meta
  let second = ecs.spawn alive meta
  ecs.insert alive current current_meta first 3
  ecs.insert alive current current_meta second 5
  ecs.checkpoint identity previous current
  ecs.write current current_meta first 8
  ecs.remove current current_meta second
  let sections: ResizeArray persist.Section = #[]
  let payload: ResizeArray F32 = #[]
  let packet: ResizeArray F32 = #[]
  persist.write_alive alive sections payload
  persist.write_snapshotted_component number 1 alive current previous sections payload
  persist.frame_sections persist.magic 4 sections payload packet
  let parsed: ResizeArray persist.Section = #[]
  persist.parse_sections persist.magic 4 packet parsed
  let restored_alive: ecs.Entities = ecs.entities ()
  let restored_entities_meta = ecs.metadata 2
  let restored: ecs.Pool U32 = ecs.pool ()
  let restored_meta = ecs.metadata 2
  let restored_previous: ecs.Pool U32 = ecs.pool ()
  let previous_meta = ecs.metadata 2
  let outcomes: ResizeArray persist.Outcome = #[]
  persist.restore_alive parsed packet restored_alive restored_entities_meta outcomes
  persist.restore_snapshotted_component number 1 identity restored_alive restored restored_meta restored_previous previous_meta parsed packet outcomes
  ecs.write restored restored_meta first 13
  return check.report #[check.words #[13, 0, 3, 5] #[scalar (ecs.read restored 0), scalar (ecs.read restored 1), scalar (ecs.read restored_previous 0), scalar (ecs.read restored_previous 1)]]
const exact_word = $codec.Persistence {key: 201, version: 1,
  encode: func (value: U32) => return #[value],
  decode: func (value: Array U32) => return if value.length == 1 then $Some value[0] else $Nothing,
  migrate: codec.no_migration}
entry func test_word_native_component_keeps_full_unsigned_bits () => return do:
  let alive: ecs.Entities = #[true]
  let original: ecs.Pool U32 = #[$Some 4294967295]
  let sections: ResizeArray words.Section = #[]
  let payload: ResizeArray U32 = #[]
  let packet: ResizeArray U32 = #[]
  words.write_alive alive sections payload
  words.write_component exact_word original sections payload
  words.frame words.magic 5 sections payload packet
  let parsed: ResizeArray words.Section = #[]
  words.split words.magic 5 packet parsed
  let restored: ecs.Pool U32 = ecs.pool ()
  let meta = ecs.metadata 2
  let outcomes: ResizeArray persist.Outcome = #[]
  words.restore_component exact_word alive restored meta parsed packet outcomes
  return check.report #[check.words #[4294967295] #[scalar (ecs.read restored 0)]]
