import * as test from "std/test"
import * as ecs from "ink/ecs"
import * as persist from "ink/persist"
import * as words from "ink/persist/words"
import * as lanes from "ink/lanes"
import * as codec from "ink/codec"
func number_decode (values: #[F32]) =>
  lanes.exact values 1
  return lanes.integer values[0] lanes.max_integer
const number = $lanes.Codec {key: 200, version: 1,
  encode: func (value: U32) => #[U32.to_f32 value],
  decode: number_decode, migrate: lanes.no_migration}
func scalar value => Maybe.unwrap_or 0 value
@[test.suite]
test "current and previous columns round trip independently":
  let alive: ecs.Entities = ecs.entities ()
  let meta = ecs.metadata 1
  let current: ecs.Pool U32 = ecs.pool ()
  let current_meta = ecs.metadata 1
  let previous: ecs.Pool U32 = ecs.pool ()
  let (first, alive, meta) = ecs.spawn alive meta
  let (second, alive, meta) = ecs.spawn alive meta
  let (current, current_meta) = ecs.insert alive current current_meta first 3
  let (current, current_meta) = ecs.insert alive current current_meta second 5
  previous := ecs.checkpoint identity self current
  let (current, current_meta) = ecs.write current current_meta first 8
  let (current, current_meta) = ecs.remove current current_meta second
  let w = persist.writer ()
  w := persist.write_alive alive self
  w := persist.write_snapshotted_component number 1 alive current previous self
  let packet = persist.frame_sections persist.magic 4 w #[]
  let parsed = persist.parse_sections persist.magic 4 packet #[]
  let restored_alive: ecs.Entities = ecs.entities ()
  let restored_entities_meta = ecs.metadata 2
  let restored: ecs.Pool U32 = ecs.pool ()
  let restored_meta = ecs.metadata 2
  let restored_previous: ecs.Pool U32 = ecs.pool ()
  let previous_meta = ecs.metadata 2
  let (restored_alive, restored_entities_meta, _) = persist.restore_alive parsed packet restored_alive restored_entities_meta
  let (restored, restored_meta, restored_previous, previous_meta, _) = persist.restore_snapshotted_component number 1 identity restored_alive restored restored_meta restored_previous previous_meta parsed packet
  let (restored, restored_meta) = ecs.write restored restored_meta first 13
  use test.eq "check 1" #[13, 0, 3, 5] #[scalar (ecs.read restored 0), scalar (ecs.read restored 1), scalar (ecs.read restored_previous 0), scalar (ecs.read restored_previous 1)]
  return ()
const exact_word = $codec.Persistence {key: 201, version: 1,
  encode: func (value: U32) => #[value],
  decode: func (value: #[U32]) => if value.length == 1 then $Some value[0] else $Nothing,
  migrate: codec.no_migration}
@[test.suite]
test "word native component keeps full unsigned bits":
  let alive: ecs.Entities = ecs.entities_from #[true]
  let original: ecs.Pool U32 = ecs.pool_from #[$Some 4294967295]
  let w = words.writer ()
  w := words.write_alive alive self
  w := words.write_component exact_word original self
  let packet = words.frame words.magic 5 w #[]
  let parsed = words.split words.magic 5 packet #[]
  let restored: ecs.Pool U32 = ecs.pool ()
  let meta = ecs.metadata 2
  let (restored, meta, _) = words.restore_component exact_word alive restored meta parsed packet
  use test.eq "check 1" #[4294967295] #[scalar (ecs.read restored 0)]
  return ()
