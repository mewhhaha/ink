import * as check from "./check"
import * as preferences from "ink/preferences"

const quality = $preferences.Quality { msaa: 1, fxaa: true, scale: 0.75, filtering: 1, shadows: 1024, occlusion: false, sky: true, fog: 0.5, effects: true, bloom: false, reflections: 1, volumetrics: 2 }
const volumes = $preferences.Volumes { master: 0.25, effects: 0.5, music: 1.0 }
const controls = $preferences.Controls { left_handed: true }
const initial = preferences.make quality volumes controls

entry func test_initial_preferences_are_caller_policy_and_round_trip () =>
  use restored <- preferences.decode (preferences.encode_saved initial)
  return check.report #[
    check.equal #[1.0, 1.0, 0.75, 1.0, 1024.0, 0.0, 1.0, 0.5, 1.0, 0.25, 0.5, 1.0, 0.0, 1.0, 1.0, 2.0] (preferences.encode initial),
    check.equal (preferences.encode_saved initial) (preferences.encode_saved restored),
    check.equal #[1.0, 2.0] #[U32.to_f32 restored.quality.reflections, U32.to_f32 restored.quality.volumetrics],
  ]

// The fog's lighting tier is its own lane, after reflections and before the
// saved flag: off, low and high round trip beside the other tiers.
entry func test_the_volumetrics_lane_round_trips_beside_reflections () =>
  let low = preferences.apply initial 15 1.0
  let off = preferences.apply initial 15 0.0
  use restored <- preferences.decode (preferences.encode_saved low)
  return check.report #[
    check.equal #[1.0, 1.0] #[U32.to_f32 low.quality.volumetrics, U32.to_f32 restored.quality.volumetrics],
    check.equal #[0.0, 1.0] #[U32.to_f32 off.quality.volumetrics, U32.to_f32 low.quality.reflections],
    check.equal #[17.0, 16.0] #[U32.to_f32 (preferences.encode_saved initial).length, U32.to_f32 preferences.lanes_count],
  ]

// The saved lanes of `initial` with lane `lane` set to `value`, decoded and
// saved again; a lane that does not decode traps.
entry func resaved (a: #[F32]) : #[F32] =>
  let lanes = preferences.encode_saved initial
  lanes[F32.to_u32 a[0]] := a[1]
  use restored <- preferences.decode lanes
  return preferences.encode_saved restored

entry func test_changes_clamp_ranges_and_reject_unknown_enumerations () =>
  let updated = preferences.apply initial 2 7.0
  updated := preferences.apply self 9 (-0.5)
  updated := preferences.apply self 0 2.0
  updated := preferences.apply self 3 3.0
  let reflected = preferences.apply initial 14 2.0
  let rejected = preferences.apply initial 14 3.0
  let toned = preferences.apply initial 15 1.0
  let toned_over = preferences.apply initial 15 3.0
  return check.report #[
    check.equal #[2.0, 0.0, 1.0, 1.0] #[updated.quality.scale, updated.volumes.master, U32.to_f32 updated.quality.msaa, U32.to_f32 updated.quality.filtering],
    check.equal #[2.0, 1.0] #[U32.to_f32 reflected.quality.reflections, U32.to_f32 rejected.quality.reflections],
    check.equal #[1.0, 2.0] #[U32.to_f32 toned.quality.volumetrics, U32.to_f32 toned_over.quality.volumetrics],
    check.equal (preferences.encode initial) (preferences.encode (preferences.apply initial 999 7.0)),
    check.equal (preferences.encode initial) (preferences.encode (preferences.apply initial 0 1.5)),
  ]
