import * as check from "./check"
import * as preferences from "ink/preferences"

const quality = #preferences.Quality { msaa: 1, fxaa: #True, scale: 0.75, filtering: 1, shadows: 1024, occlusion: #False, sky: #True, fog: 0.5, effects: #True, bloom: #False }
const volumes = #preferences.Volumes { master: 0.25, effects: 0.5, music: 1.0 }
const controls = #preferences.Controls { left_handed: #True }
const initial = preferences.make quality volumes controls

entry const test_initial_preferences_are_caller_policy_and_round_trip = fn () => do:
  use restored <- preferences.decode (preferences.encode_saved initial)
  return check.report #[
    check.equal #[1.0, 1.0, 0.75, 1.0, 1024.0, 0.0, 1.0, 0.5, 1.0, 0.25, 0.5, 1.0, 0.0, 1.0] (preferences.encode initial),
    check.equal (preferences.encode_saved initial) (preferences.encode_saved restored),
  ]

entry const test_changes_clamp_ranges_and_reject_unknown_enumerations = fn () => do:
  let updated = preferences.apply initial 2 7.0
  updated := preferences.apply self 9 (-0.5)
  updated := preferences.apply self 0 2.0
  updated := preferences.apply self 3 3.0
  return check.report #[
    check.equal #[2.0, 0.0, 1.0, 1.0] #[updated.quality.scale, updated.volumes.master, U32.to_f32 updated.quality.msaa, U32.to_f32 updated.quality.filtering],
    check.equal (preferences.encode initial) (preferences.encode (preferences.apply initial 999 7.0)),
    check.equal (preferences.encode initial) (preferences.encode (preferences.apply initial 0 1.5)),
  ]
