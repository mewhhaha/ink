// Daylight (packages/daylight.blot): the phase of the day from the whole saved
// clock, and the light through the day, which changes smoothly through the
// horizon.
import * as array from "std/array"
import * as test from "std/test"
import * as daylight from "ink/daylight"

// The clear sky, the ambient light and the sun's (or moon's) colour at phase.
func sample (phase: F32) =>
  let light = daylight.lighting daylight.default_palette phase
  return #[light.clear.x, light.clear.y, light.clear.z,
    light.ambient.x, light.ambient.y, light.ambient.z,
    light.color.x, light.color.y, light.color.z]

// Each lane finite and not negative.
func lit (light: #[F32]) => array.all (func (lane: F32) => F32.is_finite lane and lane >= 0.0) light

// That, and the sky (the first three lanes) in display range, at most 1.
func valid (light: #[F32]) => lit light and array.all (func (lane: F32) => lane <= 1.0) (array.slice 0 3 light)

// ((tick + alpha) % 216000 / 216000 + 0.125) % 1, the day starting an eighth in.
@[test.suite]
test "the phase follows the whole saved clock":
  use test.near_array "check 1" 0.00002 #[0.125, 0.12583333, 0.625, 0.125, 0.79729630, 0.23284722, 0.79729861] #[
    daylight.phase day 0 0.0, daylight.phase day 180 0.0,
    daylight.phase day 108000 0.0, daylight.phase day 216000 0.0,
    daylight.phase day 16777216 0.0, daylight.phase day 4294967295 0.0,
    daylight.phase day 16777216 0.5,
  ]
  return ()

// One check a step, at 241 steps through the day: a failure's place less one
// is the step (of 240) whose light is not.
@[test.suite]
test "the light stays valid through the day":
  for step in array.generate 241 identity:
    let ok = valid (sample (U32.to_f32 step / 240.0))
    use test.holds "valid daylight sample" ok
  return ()

@[test.suite]
test "morning noon and night light is valid":
  use test.holds "check 1" (lit (sample 0.125))
  use test.holds "check 2" (lit (sample 0.25))
  use test.holds "check 3" (lit (sample 0.75))
  use test.holds "check 4" (lit (sample 0.4999))
  use test.holds "check 5" (lit (sample 0.5001))
  return ()

// The sky is darker at night than at noon, and the sun brighter than the moon.
@[test.suite]
test "night is darker than noon":
  let noon = sample 0.25
  let night = sample 0.75
  use test.holds "check 1" (noon[1] > night[1] * 3.0)
  use test.holds "check 2" (noon[6] > night[6] * 3.0)
  return ()

@[test.suite]
test "the light does not jump at the horizon":
  use test.near_array "check 1" 0.002 (sample 0.4999) (sample 0.5001)
  return ()

const day = $daylight.Day { ticks: 216000, start: 0.125, daylight: 0.5 }
