import * as check from "./check"
import * as math from "ink/math"
import * as render from "ink/render"
import * as retained from "ink/render/retained"
import * as changes from "ink/changes"
import * as transform from "ink/transform"
const draw = func (x: F32) => return render.draw (transform.from_xyz x 0.0 0.0) ($render.Appearance {mesh: 0, material: 0})
const order = func group -> slot => return group * 32 + slot
// Every output owner is named; this helper returns only their invocation access.
const with_frame = func run => return do:
  let settings = #[render.defaults]
  let draws: ResizeArray render.Draw = #[]
  let solids: ResizeArray render.Solid = #[]
  let decals: ResizeArray render.Decal = #[]
  let sprites: ResizeArray render.Sprite = #[]
  let insets: ResizeArray render.Inset = #[]
  let fields: ResizeArray render.Field = #[]
  let poses: ResizeArray render.Pose = #[]
  let emitters: ResizeArray render.Emitter = #[]
  let extensions: ResizeArray render.Extension = #[]
  let updates: ResizeArray render.Instance = #[]
  let removed: ResizeArray U32 = #[]
  return run ($render.FrameAccess {settings, draws, solids, decals, sprites, insets, fields, poses, emitters, extensions, updates, removed})
entry const lifecycle = func () => return with_frame (func (frame:render.FrameAccess) => return do:
  let state = retained.state ()
  let entries = retained.empty ()
  let ids: ResizeArray U32 = #[]
  let fork_state = retained.state ()
  let fork_entries = retained.empty ()
  let fork_ids: ResizeArray U32 = #[]
  let first = #[draw 1.0, draw 2.0]
  let second = #[draw 3.0]
  let groups = #[&first[0..2], &second[0..1]]
  render.begin_frame frame
  retained.update order groups #[] state entries ids frame
  let cold_reset = frame.settings[0].retained_reset
  let cold_count = frame.updates.length
  retained.copy_into fork_state fork_entries fork_ids state entries ids
  render.begin_frame frame
  retained.update order groups #[] state entries ids frame
  let quiet_count = frame.updates.length
  let quiet_removed = frame.removed.length
  let quiet_reset = frame.settings[0].retained_reset
  render.begin_frame frame
  retained.update order #[&first[0..1]] #[] state entries ids frame
  let removed_count = frame.removed.length
  let removed_first = frame.removed[0]
  let removed_second = frame.removed[1]
  let active = #[entry.key | entry <- entries, entry.active]
  let shrink_count = entries[0].count
  let grown = #[draw 1.0, draw 4.0]
  render.begin_frame frame
  retained.update order #[&grown[0..2]] #[] state entries ids frame
  let added_id = frame.updates[1].id
  let next = state[1]
  let original_id = fork_ids[fork_entries[0].start + 1]
  let original_next = fork_state[1]
  let fork_first = #[draw 9.0, draw 2.0]
  let fork_second = #[draw 8.0]
  render.begin_frame frame
  retained.update order #[&fork_first[0..2], &fork_second[0..1]] #[1, 0, 1] fork_state fork_entries fork_ids frame
  return #[if cold_reset then 1 else 0, cold_count, quiet_count, quiet_removed, if quiet_reset then 1 else 0,
    removed_count, removed_first, removed_second, added_id, next, original_id, original_next,
    frame.updates.length, frame.updates[0].id, frame.updates[2].id, active.length, shrink_count])

entry const test_retained_stream_lifetimes = func () => return
  check.report #[check.words #[1, 3, 0, 0, 0, 2, 1, 2, 3, 4, 1, 3, 3, 0, 2, 1, 1] (lifecycle ())]
entry const test_keyed_stream_only_visits_changes_and_keeps_rejected_snapshots = func () => return with_frame (func (frame:render.FrameAccess) => return do:
  let state = retained.state ()
  let entries = retained.empty ()
  let ids: ResizeArray U32 = #[]
  let ordering = func key -> slot => return key
  render.begin_frame frame
  retained.update_keyed ordering (func key => return #[draw (from key), draw 2.0]) (changes.borrow true #[0xFFFFFFFF, 7] #[]) state entries ids frame
  let cold_reset = frame.settings[0].retained_reset
  let cold = frame.updates.length
  render.begin_frame frame
  retained.update_keyed ordering (func (key:U32) : Array render.Draw => return @panic "unchanged draw requested") (changes.borrow false #[] #[]) state entries ids frame
  let quiet = frame.updates.length
  let quiet_removed = frame.removed.length
  render.begin_frame frame
  retained.update_keyed ordering (func key => return #[draw 9.0]) (changes.borrow false #[7, 7] #[0xFFFFFFFF]) state entries ids frame
  let edited = frame.updates.length
  let removed = frame.removed.length
  render.begin_frame frame
  retained.update_keyed ordering (func key => return #[draw 11.0]) (changes.borrow false #[3] #[]) state entries ids frame
  let added_id = frame.updates[0].id
  retained.rejected state
  render.begin_frame frame
  // No world rewind: the accepted host scene is rebuilt from both current keys.
  retained.update_keyed ordering (func key => return #[draw (from key)]) (changes.borrow false #[] #[]) state entries ids frame
  let replay = frame.settings[0].retained_reset and frame.updates.length == 2
  let replay_keys = #[entry.key | entry <- entries, entry.active]
  render.begin_frame frame
  retained.update_keyed ordering (func key => return #[draw 3.0]) (changes.borrow true #[1] #[]) state entries ids frame
  return check.report #[check.holds cold_reset, check.holds replay, check.holds frame.settings[0].retained_reset,
    check.words #[4, 0, 0, 1, 3, 4] #[cold, quiet, quiet_removed, edited, removed, added_id],
    check.words #[3, 7] replay_keys, check.words #[1] #[entry.key | entry <- entries, entry.active]])
