// The orbit camera (packages/orbit.blot) against the mountains round the
// floor: panned out to the boundary, then turned all the way round there.
import { Vec3 } from "std/vector"
import * as check from "./check"
import * as math from "ink/math"
import * as orbit from "ink/orbit"

const initial = #orbit.Orbit { focus: math.zero3, yaw: 0.0, pitch: 0.6, distance: 6.0 }
const bounds = #orbit.Settings { bindings: #orbit.Bindings { ahead: 17, back: 31, left: 30, right: 32, fast: 42, button: 2 }, start: initial, nearest: 3.0, farthest: 20.0, lowest: 0.3, steepest: 1.4, room: 10.0, overlook: #False }

// `value` is above `low`, or below `high`.
const above = fn (low: F32) => fn (value: F32) =>
  #check.Check { passed: value > low, expected: #[low], actual: #[value] }
const below = fn (high: F32) => fn (value: F32) =>
  #check.Check { passed: value < high, expected: #[high], actual: #[value] }

const radius = fn (point: Vec3) => sqrt (point.x * point.x + point.z * point.z)

// Panned 60 times toward -z, well past the boundary.
const panned_out = do:
  let moved = initial
  for 0 .. 60:
    moved := orbit.panned bounds self (math.vec3 0.0 0.0 (-0.8))
  return moved

entry const test_panning_reaches_the_camera_boundary = fn () => check.report #[
  check.near 0.001 #[-10.0] #[(orbit.view bounds panned_out).position.z],
]

// Every yaw at the boundary: the farthest the camera gets from the middle,
// and how far its height strays from where panning left it.
entry const test_a_full_turn_stays_inside_the_mountains_at_the_same_height = fn () => do:
  let close = orbit.view bounds panned_out
  let moved = panned_out
  let farthest = 0.0
  let height_error = 0.0
  for index in 0 .. 120:
    moved.yaw := U32.to_f32 index * tau / 120.0
    let camera = orbit.view bounds moved
    farthest := max self (radius camera.position)
    height_error := max self (abs (camera.position.y - close.position.y))
  return check.report #[
    check.within 0.0 10.001 farthest,
    below 0.001 height_error,
  ]

// Turned to face out at the wall, panning back inward moves the camera at
// once.
entry const test_panning_inward_responds_at_once_after_turning = fn () => do:
  let moved = panned_out
  moved.yaw := pi
  let before = radius (orbit.view bounds moved).position
  let after = radius (orbit.view bounds (orbit.panned bounds moved (math.vec3 0.0 0.0 1.0))).position
  return check.report #[above 0.99 (before - after)]

const overlook = do:
  let settings = bounds
  settings.overlook := #True
  return settings

entry const test_looking_inward_can_back_beyond_the_rim_without_losing_the_focus = fn () => do:
  let far = orbit.zoomed overlook 1.0 initial 10.0
  let (_, back) = orbit.turning far
  let shown = orbit.view overlook far
  let aimed = shown.position - back * far.distance
  return check.report #[
    above overlook.room (radius shown.position),
    check.near 0.001 #[0.0, 0.0, 0.0] #[aimed.x, aimed.y, aimed.z],
  ]

entry const test_overlook_still_stops_an_outward_view_and_rebases_after_turning = fn () => do:
  let moved = initial
  for 0 .. 60:
    moved := orbit.panned overlook self (math.vec3 0.0 0.0 (-0.8))
  let outward = orbit.view overlook moved
  moved.yaw := pi
  let before = orbit.view overlook moved
  let after = orbit.view overlook (orbit.panned overlook moved (math.vec3 0.0 0.0 1.0))
  return check.report #[
    check.near 0.001 #[-10.0, 1.0] #[outward.position.z, after.position.z - before.position.z],
    above overlook.room (radius before.position),
  ]

entry const test_turning_over_the_rim_remains_continuous_and_keeps_the_arena_in_reach = fn () => do:
  let moved = initial
  moved.distance := 20.0
  moved.focus := math.vec3 7.0 0.0 (-14.0)
  let previous = orbit.view overlook moved
  let checks = #[]
  for index in 1 .. 361:
    moved.yaw := U32.to_f32 index * tau / 360.0
    let (_, back) = orbit.turning moved
    let reach = back * moved.distance
    let eye = (orbit.view overlook moved).position
    let t = clamp 0.0 1.0 ((eye.x * reach.x + eye.z * reach.z) / (reach.x * reach.x + reach.z * reach.z))
    let nearest = eye - reach * t
    checks := #[...checks,
      check.within 0.0 10.001 (radius nearest),
      below 0.8 ((eye - previous.position).length),
      check.near 0.001 #[previous.position.y] #[eye.y]]
    previous := orbit.view overlook moved
  return check.report checks
