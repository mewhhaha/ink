import * as array from "std/array"
import * as render from "ink/render"
import * as events from "ink/events"
import * as keys from "ink/input/keys"
import * as math from "ink/math"
import * as menu from "ink/menu"
import * as preferences from "ink/preferences"
import * as services from "ink/services"
import * as sound from "ink/sound"
import * as text from "ink/text"
import * as tree from "ink/ui/tree"
import * as tune from "ink/tune"
import * as ui from "ink/ui"
import * as ui_fixture from "./ui_font"

const label_a: #[U32] = #[65]
const label_b: #[U32] = #[66]
const word_on: #[U32] = #[89]
const word_off: #[U32] = #[78]
const word_percent: #[U32] = #[37]
const style = menu.plain ui_fixture.face 3

entry func ui_tree_menu (count: U32) : #[U32] =>
  let controls: #[ui.Control] = #[$ui.Button { label: &label_a[0..label_a.length] }]
  let words = $menu.Words { on: &word_on[0..word_on.length], off: &word_off[0..word_off.length], percent: &word_percent[0..word_percent.length] }
  let menu_rows: #[~ui.Rect] = #[]
  let shape = menu.column_into menu_rows 1 0.0 200.0 20.0 10.0 1.0 200.0
  let state: #[tree.FocusState] = #[tree.unfocused]
  let returns: #[~tree.Return] = #[]
  let stops: #[~tree.Stop] = #[]
  let order: #[~U32] = #[]
  let reached: #[~U32] = #[]
  let held = $tree.Focus {state, returns, nodes: stops, order, reached}
  let nodes: #[~tree.Node] = #[]
  let marked: #[~tree.Node] = #[]
  let drawn: #[~render.Sprite] = #[]
  let sprites = 0
  let presses = 0
  for index in 0 .. count:
    @storage.truncate nodes 0
    ui.declare (ui.group_node 3 0 (&tree.no_text[0..0]) ui.nowhere) nodes
    ui.declare (ui.button_node 1 3 (&label_a[0..label_a.length]) ui.nowhere) nodes
    ui.declare (ui.button_node 2 3 (&label_b[0..label_b.length]) ui.nowhere) nodes
    held := tree.settle (&nodes[0..nodes.length]) held marked
    if index == 0:
      let (_, next_state) = tree.route ($events.KeyDown keys.f10) held
      held.state[0] := next_state
    let (_, next_state) = tree.route ($events.KeyDown keys.tab) held
    held.state[0] := next_state
    let (_, outcome) = menu.receive menu.unfocused shape controls ($events.PointerDown { button: 0, x: 5.0, y: 5.0 })
    if let $ui.Pressed 0 = outcome:
      presses := self + 1
    @storage.truncate drawn 0
    menu.sprites style words menu.unfocused shape controls 0.0 0.0 1.0 (math.vec2 (-1.0) (-1.0)) drawn
    sprites := self + drawn.length
  return #[count, marked.length, held.state[0].node, sprites, presses]

const quality = $preferences.Quality { msaa: 1, fxaa: false, scale: 1.0, filtering: 0, shadows: 0, occlusion: false, sky: false, fog: 0.0, effects: false, bloom: false, reflections: 0, volumetrics: 0 }
const defaults = preferences.make quality $preferences.Volumes { master: 0.5, effects: 1.0, music: 0.5 } $preferences.Controls { left_handed: false }
entry func preference_tune (count: U32) : #[F32] =>
  let checksum = 0.0
  let tuned = tune.empty ()
  for index in 0 .. count:
    let value = U32.to_f32 (index % 101) * 0.01
    let changed = preferences.apply defaults 9 value
    let restored = preferences.decode (preferences.encode_saved changed)
    tuned := tune.with_setting 7 value tuned
    checksum := self + restored.volumes.master + tune.read tuned (7, 0.5, 0.0, 1.0)
  return #[U32.to_f32 count, checksum, U32.to_f32 (tune.encode tuned).length]

entry func text_workload (count: U32) : #[F32] =>
  let checksum = 0.0
  let points = 0
  let bounded = 0.0
  for index in 0 .. count:
    let input: #[U32] = #[32, 65, 32, 128578, 32]
    let words = text.words input
    let parts = array.map (func (span: text.Span) => &input[span.start..span.start + span.count]) words
    let joined = text.joined #[32] parts
    points := self + joined.length
    let value = U32.to_f32 (index % 100) * 0.25
    let $Some parsed = text.number (text.fixed value 2) else:
      return #[0.0]
    checksum := self + parsed
    let overflow = text.power 0xffffffff
    for code in ui.decimal 1.25 0xffffffff:
      bounded := self + U32.to_f32 code
    for code in text.fixed 1.25 0xffffffff:
      bounded := self + U32.to_f32 code
    for code in text.shown overflow:
      bounded := self + U32.to_f32 code
    for code in text.fixed (overflow - overflow) 0xffffffff:
      bounded := self + U32.to_f32 code
    for code in text.fixed 1e20 0xffffffff:
      bounded := self + U32.to_f32 code
    for code in text.rest 0xffffffff joined:
      bounded := self + U32.to_f32 code
  return #[U32.to_f32 count, checksum, U32.to_f32 points, bounded]

const request_policy = $services.Policy { retry_ticks: 8, tries: 2, most_answers: 16 }
entry func service_workload (count: U32) : #[F32] =>
  let next: #[U32] = #[1]
  let outbox: #[~services.Request] = #[]
  let waiting: #[~services.Request] = #[]
  let filling: #[~services.Filling] = #[]
  let answers: #[~services.Answer] = #[]
  let statuses: #[~U32] = #[]
  let payload: #[~F32] = #[]
  let state = services.access next outbox waiting filling answers statuses payload
  state := services.idle state 1
  let outgoing: #[~services.Request] = #[]
  let checksum = 0.0
  let sent_count = 0
  for index in 0 .. count:
    let value = U32.to_f32 index
    let (id, next_state) = services.ask state 0 0 value 0.0 0.0 0.0 #[]
    state := next_state
    state := services.send state request_policy 0 outgoing
    sent_count := self + outgoing.length
    state := services.receive state request_policy ($events.ServiceAnswer { request: id, status: 0, value, length: 3 })
    state := services.receive state request_policy ($events.ServiceData { request: id, a: value, b: 2.0, c: 3.0 })
    let (found_opt, next_state) = services.take state id
    state := next_state
    let $Some found = found_opt else:
      return #[0.0]
    checksum := self + found.value
    for value in services.values state found.values:
      checksum := self + value
  let decoded_next: #[U32] = #[1]
  let decoded_outbox: #[~services.Request] = #[]
  let decoded_waiting: #[~services.Request] = #[]
  let decoded_filling: #[~services.Filling] = #[]
  let decoded_answers: #[~services.Answer] = #[]
  let decoded_statuses: #[~U32] = #[]
  let decoded_payload: #[~F32] = #[]
  let decoded_state = services.access decoded_next decoded_outbox decoded_waiting decoded_filling decoded_answers decoded_statuses decoded_payload
  let encoded = services.encode state
  decoded_state := services.decode encoded decoded_state
  return #[U32.to_f32 count, U32.to_f32 sent_count, checksum, U32.to_f32 decoded_state.waiting.length, U32.to_f32 decoded_state.statuses[0]]

entry func sound_workload (count: U32) : #[F32] =>
  let sounds: #[~sound.Sound] = #[]
  let voices: #[~sound.Voice] = #[]
  let buses = copy sound.mix_start
  let audio = $sound.Access {sounds, voices, buses}
  for index in 0 .. count:
    sound.at audio 1 0.5 1.0 (math.vec3 0.0 0.0 (-6.0))
    sound.keep audio (sound.voice (index + 1) 1 sound.effects)
  let heard = sound.hear math.Mat4.identity ($Some (math.vec3 0.0 0.0 (-6.0)))
  return #[U32.to_f32 count, U32.to_f32 sounds.length, U32.to_f32 voices.length, heard.gain, heard.pan]
