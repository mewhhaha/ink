import * as ecs from "ink/ecs"
import * as events from "ink/events"
import * as keys from "ink/input/keys"
import * as math from "ink/math"
import * as menu from "ink/menu"
import * as preferences from "ink/preferences"
import * as services from "ink/services"
import * as sound from "ink/sound"
import * as text from "ink/text"
import * as tree from "ink/ui/tree"
import * as tune from "ink/tune"
import * as ui from "ink/ui"
import * as ui_fixture from "./ui_font"
import * as clock from "ink/clock"

const ui_engine = ecs.build (ecs.insert_resource tree.empty (ecs.insert_resource tree.unfocused (ecs.new ())))
const controls = #[#ui.Button { label: #[65] }]
const shape = menu.column 1 0.0 200.0 20.0 10.0 1.0 200.0
const words = #menu.Words { on: #[89], off: #[78], percent: #[37] }
const style = menu.plain ui_fixture.face 3

entry const ui_tree_menu = fn (count: U32) -> Array U32 => do:
  let (_, result) = ecs.create ui_engine (fn () => do:
    let sprites = 0
    let presses = 0
    for index in 0 .. count:
      use ecs.set tree.empty
      use ui.declare (ui.group_node 3 0 #[] ui.nowhere)
      use ui.declare (ui.button_node 1 3 #[65] ui.nowhere)
      use ui.declare (ui.button_node 2 3 #[66] ui.nowhere)
      use tree.settle ()
      if index == 0:
        use tree.route (#events.KeyDown keys.f10)
      use tree.route (#events.KeyDown keys.tab)
      let (_, outcome) = menu.receive menu.unfocused shape controls (#events.PointerDown { button: 0, x: 5.0, y: 5.0 })
      if let #ui.Pressed 0 = outcome:
        presses := self + 1
      let drawn = menu.sprites style words menu.unfocused shape controls 0.0 0.0 1.0 (math.vec2 (-1.0) (-1.0))
      sprites := self + drawn.length
    use current <- ecs.get #tree.Tree
    use held <- ecs.get #tree.Focus
    return #[count, current.nodes.length, held.node, sprites, presses])
  return result

const quality = #preferences.Quality { msaa: 1, fxaa: #False, scale: 1.0, filtering: 0, shadows: 0, occlusion: #False, sky: #False, fog: 0.0, effects: #False, bloom: #False }
const defaults = preferences.make quality #preferences.Volumes { master: 0.5, effects: 1.0, music: 0.5 } #preferences.Controls { left_handed: #False }
entry const preference_tune = fn (count: U32) -> Array F32 => do:
  let checksum = 0.0
  let tuned = tune.untuned
  for index in 0 .. count:
    let value = U32.to_f32 (index % 101) * 0.01
    let changed = preferences.apply defaults 9 value
    use restored <- preferences.decode (preferences.encode_saved changed)
    let #tune.Tuned settings = tuned
    tuned := #tune.Tuned (tune.with_setting 7 value settings)
    checksum := self + restored.volumes.master + tune.read tuned (7, 0.5, 0.0, 1.0)
  return #[U32.to_f32 count, checksum, U32.to_f32 (tune.encode tuned).length]

entry const text_workload = fn (count: U32) -> Array F32 => do:
  let checksum = 0.0
  let points = 0
  let bounded = 0.0
  for index in 0 .. count:
    let words = text.words #[32, 65, 32, 128578, 32]
    let joined = text.joined #[32] words
    points := self + joined.length
    let value = U32.to_f32 (index % 100) * 0.25
    let #Some parsed = text.number (text.fixed value 2) else:
      return #[0.0]
    checksum := self + parsed
    let overflow = text.power 0xffffffff
    let formats = #[
      ui.decimal 1.25 0xffffffff,
      text.fixed 1.25 0xffffffff,
      text.shown overflow,
      text.fixed (overflow - overflow) 0xffffffff,
      text.fixed 1e20 0xffffffff,
      text.rest 0xffffffff joined,
    ]
    for formatted in formats:
      for code in formatted:
        bounded := self + U32.to_f32 code
  return #[U32.to_f32 count, checksum, U32.to_f32 points, bounded]

const request_policy = #services.Policy { retry_ticks: 8, tries: 2, most_answers: 16 }
const service_engine = do:
  let builder = ecs.new ()
  builder := ecs.insert_resource (services.idle 1) self
  builder := ecs.insert_resource request_policy self
  builder := ecs.insert_resource clock.clock self
  break ecs.build builder
entry const service_workload = fn (count: U32) -> Array F32 => do:
  let (_, result) = ecs.create service_engine (fn () => do:
    let checksum = 0.0
    let sent_count = 0
    for index in 0 .. count:
      let value = U32.to_f32 index
      use id <- services.ask 0 0 value 0.0 0.0 0.0 #[]
      use requests <- services.send ()
      sent_count := self + requests.length
      use services.receive (#events.ServiceAnswer { request: id, status: 0, value, length: 3 })
      use services.receive (#events.ServiceData { request: id, a: value, b: 2.0, c: 3.0 })
      use answer <- services.take id
      let #Some found = answer else:
        return #[0.0]
      checksum := self + found.value
      for value in found.values:
        checksum := self + value
    use current <- ecs.get #services.Services
    use decoded <- services.decode (services.encode current)
    return #[U32.to_f32 count, U32.to_f32 sent_count, checksum, U32.to_f32 decoded.waiting.length, U32.to_f32 decoded.statuses[0]])
  return result

const sound_engine = ecs.build (ecs.insert_resource sound.silent (ecs.new ()))
entry const sound_workload = fn (count: U32) -> Array F32 => do:
  let (_, result) = ecs.create sound_engine (fn () => do:
    for index in 0 .. count:
      use sound.at 1 0.5 1.0 (math.vec3 0.0 0.0 (-6.0))
      use sound.keep (sound.voice (index + 1) 1 sound.effects)
    use current <- ecs.get #sound.Audio
    let heard = sound.hear math.Mat4.identity (#Some (math.vec3 0.0 0.0 (-6.0)))
    return #[U32.to_f32 count, U32.to_f32 current.sounds.length, U32.to_f32 current.voices.length, heard.gain, heard.pan])
  return result
