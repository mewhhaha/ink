// Owned storage witnesses. The application supplies each independently named
// owner explicitly; copying/checkpointing is an operation, not assignment.
import * as check from "./check"
import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as commands from "ink/ecs/commands"
import * as query from "ink/ecs/query"
import * as journal from "ink/journal"
import * as messages from "ink/messages"

type Position is data = $Position { x: U32, y: U32 }
func x value => case value of
  $Some position => position.x
  $Nothing => 0
func flag value => if value then 1 else 0

#entry func test_checkpoint_and_growth () =>
  let alive: ecs.Entities = ecs.entities ()
  let entities_meta = ecs.metadata 1
  let current: ecs.Pool Position = ecs.pool ()
  let current_meta = ecs.metadata 1
  let previous: ecs.Pool Position = ecs.pool ()
  let (first, alive, entities_meta) = ecs.spawn alive entities_meta
  let (current, current_meta) = ecs.insert alive current current_meta first ($Position {x: 3, y: 5})
  previous := ecs.checkpoint identity self current
  let captured_len = (ecs.rows current).length
  let (second, alive, entities_meta) = ecs.spawn alive entities_meta
  let (current, current_meta) = ecs.insert alive current current_meta second ($Position {x: 8, y: 13})
  let (current, current_meta) = ecs.write current current_meta first ($Position {x: 21, y: 34})
  return check.report #[check.words #[1, 21, 3, 2, 2] #[captured_len,
    x (ecs.read current 0), x (ecs.read previous first), current.length, ecs.membership_revision current_meta]]

#entry func test_structural_batch () =>
  let alive: ecs.Entities = ecs.entities ()
  let entities_meta = ecs.metadata 7
  let positions: ecs.Pool Position = ecs.pool ()
  let meta = ecs.metadata 7
  let (first, alive, entities_meta) = ecs.spawn alive entities_meta
  let (second, alive, entities_meta) = ecs.spawn alive entities_meta
  let (positions, meta) = commands.apply alive positions meta #[$commands.Put {entity: second, value: $Position {x: 5, y: 0}},
    $commands.Put {entity: first, value: $Position {x: 2, y: 0}},
    $commands.Remove second, $commands.Put {entity: first, value: $Position {x: 9, y: 0}}]
  let before = ecs.indices alive positions
  let (positions, meta) = ecs.remove positions meta first
  let (alive, entities_meta) = ecs.despawn alive entities_meta first
  let (third, alive, entities_meta) = ecs.spawn alive entities_meta
  return check.report #[check.words #[1, 0, 0, 2] #[before.length, before[0],
    flag (ecs.contains positions first), third]]

func run_query (use_select: Bool) -> (alive: ecs.Entities) -> (entity_meta: ecs.Metadata) -> (filter: query.Filter) -> (positions: ecs.Pool Position) -> (meta: ecs.Metadata) -> (query_key: own #[U32]) -> (selected: own #[U32]) -> (query_meta: own #[U32]): (#[U32], #[U32], #[U32]) =>
  let membership: #[Bool] = #[]
  if use_select:
    return query.select alive entity_meta filter #[query.source 41 positions meta membership] query_key selected query_meta
  return query.prepare alive entity_meta filter #[query.source 41 positions meta membership] query_key selected query_meta

#entry func test_query_revisions () =>
  let alive: ecs.Entities = ecs.entities ()
  let entity_meta = ecs.metadata 9
  let positions: ecs.Pool Position = ecs.pool ()
  let meta = ecs.metadata 9
  let (first, alive, entity_meta) = ecs.spawn alive entity_meta
  let (positions, meta) = ecs.insert alive positions meta first ($Position {x: 1, y: 0})
  let filter = #[$query.With 41]
  let query_key: #[U32] = #[]
  let selected: #[U32] = #[]
  let query_meta: #[U32] = #[0]
  let (query_key, selected, query_meta) = run_query true alive entity_meta filter positions meta query_key selected query_meta
  let initial_builds = query_meta[0]
  let (positions, meta) = ecs.write positions meta first ($Position {x: 2, y: 0})
  let (query_key, selected, query_meta) = run_query false alive entity_meta filter positions meta query_key selected query_meta
  let payload_builds = query_meta[0]
  let (positions, meta) = ecs.remove positions meta first
  let (query_key, selected, query_meta) = run_query false alive entity_meta filter positions meta query_key selected query_meta
  return check.report #[check.words #[1, 1, 2, 0] #[initial_builds, payload_builds, query_meta[0], selected.length]]

func journal_read_count reader -> (log: journal.Journal) -> (meta: messages.Metadata): U32 =>
  let rows: #[journal.Change] = #[]
  return case messages.read reader log meta rows of
    $messages.Items {values} => values.length
    _ => 0

#entry func test_journal_reset_and_copy () =>
  let log: journal.Journal = journal.empty ()
  let meta = journal.metadata 13 2
  let before = journal.cursor meta
  let (log, meta) = journal.record ($journal.Added 4) log meta
  let (log, meta) = journal.record ($journal.Updated 4) log meta
  let retained = journal_read_count before log meta
  let (log, meta) = journal.record ($journal.Removed 4) log meta
  let gap_rows: #[journal.Change] = #[]
  let gap = case messages.read before log meta gap_rows of
    $messages.Reset _ => 1
    _ => 0
  return check.report #[check.words #[2, 1] #[retained, gap]]

// Fixed rows carry spans; independently owned variable payloads live elsewhere.
type Span is data = $Span { start: U32, count: U32 }
#entry func test_payload_copy_policy () =>
  let payload: #[U32] = #[5, 8]
  let copied_payload: #[U32] = #[]
  let source: ecs.Pool Span = ecs.pool ()
  let destination: ecs.Pool Span = ecs.pool ()
  let alive: ecs.Entities = ecs.entities ()
  let entity_meta = ecs.metadata 17
  let source_meta = ecs.metadata 17
  let (id, alive, entity_meta) = ecs.spawn alive entity_meta
  let (source, source_meta) = ecs.insert alive source source_meta id ($Span {start: 0, count: 2})
  for id in 0 .. source.length:
    if let $Some span = source[id]:
      let start = copied_payload.length
      for i in 0 .. span.count:
        @storage.push copied_payload payload[span.start + i]
      @storage.push destination ($Some ($Span {start, count: span.count}))
    else:
      @storage.push destination $Nothing
  payload[0] := 13
  let $Some copied = ecs.read destination id else:
    return check.report #[check.words #[1] #[0]]
  return check.report #[check.words #[13, 5, 2] #[payload[0], copied_payload[copied.start], copied.count]]

func bulk (count: U32) -> (stride: U32) -> (churn: Bool) : #[U32] =>
  let alive = ecs.entities ()
  let entities_meta = ecs.metadata 1
  let positions: ecs.Pool Position = ecs.pool ()
  let positions_meta = ecs.metadata 1
  let previous: ecs.Pool Position = ecs.pool ()
  let previous_meta = ecs.metadata 1
  let velocities: ecs.Pool U32 = ecs.pool ()
  let velocities_meta = ecs.metadata 1
  let (ids, alive, entities_meta) = ecs.spawn_many alive entities_meta count
  let rows = array.map (func id => $Position {x: id, y: 0}) ids
  let (positions, positions_meta) = ecs.insert_many alive positions positions_meta ids rows
  let deltas = array.generate count (func id => if id % stride == 0 then $Some 3 else $Nothing)
  let (velocities, velocities_meta) = ecs.replace_components alive velocities velocities_meta deltas
  previous := ecs.checkpoint identity self positions
  if churn:
    for id in ids:
      if id % 4 == 0:
        let p_was = ecs.contains positions id
        positions := ecs.remove_row self id
        positions_meta := ecs.bump_remove p_was self
        let pr_was = ecs.contains previous id
        previous := ecs.remove_row self id
        previous_meta := ecs.bump_remove pr_was self
        let v_was = ecs.contains velocities id
        velocities := ecs.remove_row self id
        velocities_meta := ecs.bump_remove v_was self
        let was_live = ecs.live alive id
        alive := ecs.despawn_entity self id
        if was_live:
          entities_meta := ecs.bump_membership self
      if id % 4 == 1:
        let v_was = ecs.contains velocities id
        velocities := ecs.remove_row self id
        velocities_meta := ecs.bump_remove v_was self
  let total = 0
  let before = 0
  let live = 0
  for id in ids:
    if let $Some delta = ecs.read velocities id:
      if let $Some row = ecs.read positions id:
        row.x := self + delta
        positions := ecs.write_row self id row
        positions_meta := ecs.bump_payload self
    total := self + x (ecs.read positions id)
    before := self + x (ecs.read previous id)
    if ecs.live alive id:
      live := self + 1
  return #[positions.length, live, total, before]

#entry func dense (count: U32) : #[U32] => bulk count 1 false
#entry func sparse (count: U32) : #[U32] => bulk count 16 false
#entry func churn (count: U32) : #[U32] => bulk count 1 true
