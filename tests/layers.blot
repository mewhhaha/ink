import * as app from "ink/app"
import * as array from "std/array"
import * as sort from "ink/sort"
import * as test from "std/test"

type Trace is data = $Trace U32
type Access = {trace: #[Trace], frame: #[U32], control: app.Control}
func draw (id: U32) -> (access: own Access) -> (_: app.Presentation): Access =>
  access.trace[0] := $Trace id
  @storage.push access.frame id
  return access
// Layer metadata is caller-owned data. Known dispatch keeps callbacks static;
// stable ordering uses each declaration's source index within its layer.
const layers = #[30, 10, 0, 10, 20]
const names = #[30, 10, 0, 11, 20]
func render (access: own Access) -> presentation: Access =>
  for index in sort.order_u32 layers:
    access := case index of
      0 => draw 30 self presentation
      1 => draw 10 self presentation
      2 => draw 0 self presentation
      3 => draw 11 self presentation
      _ => do:
        let visible = false
        break if visible then draw 20 self presentation else self
  return access
func reset_trace (access: own Access): Access =>
  access.trace[0] := $Trace 0
  return access
const stages = app.stages app.no_action reset_trace reset_trace app.no_action app.route_event
  app.no_event app.no_event app.no_update render app.no_action
@[test.suite]
test "render order is explicit stable and keeps guards and diagnostic labels":
  let trace: #[Trace] = #[$Trace 0]
  let shown: #[U32] = #[]
  let access: Access = {trace, frame: shown, control: app.control ()}
  access := app.start stages access
  access := app.render stages access 0.0 100.0 100.0
  let labels = array.map (func index => U32.to_f32 names[index]) (sort.order_u32 layers)
  use test.near_array "check 1" 0.0 #[0.0,10.0,11.0,30.0] (array.map U32.to_f32 access.frame)
  use test.near_array "check 2" 0.0 #[0.0,10.0,11.0,20.0,30.0] labels
  return ()
