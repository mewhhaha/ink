import * as app from "ink/app"
import * as array from "std/array"
import * as sort from "ink/sort"
import * as check from "./check"

type Trace is data = $Trace U32
type Access = {trace: #[Trace], frame: #[~U32], control: app.Control}
func draw (id: U32) -> (access: Access) -> (_: app.Presentation) =>
  access.trace[0] = $Trace id
  @storage.push access.frame id
  return ()
// Layer metadata is caller-owned data. Known dispatch keeps callbacks static;
// stable ordering uses each declaration's source index within its layer.
const layers = #[30, 10, 0, 10, 20]
const names = #[30, 10, 0, 11, 20]
func render (access: Access) -> presentation =>
  for index in sort.order_u32 layers:
    case index of
      0 => draw 30 access presentation
      1 => draw 10 access presentation
      2 => draw 0 access presentation
      3 => draw 11 access presentation
      _ => do:
        let visible = false
        if visible:
          draw 20 access presentation
  return ()
func reset_trace (access: Access) =>
  access.trace[0] = $Trace 0
  return ()
const stages = app.stages app.no_action (app.lent reset_trace) (app.lent reset_trace) app.no_action app.route_event
  app.no_event app.no_event app.no_update (app.lent_with render) app.no_action
entry func test_render_order_is_explicit_stable_and_keeps_guards_and_diagnostic_labels () : #[F32] =>
  let trace: #[Trace] = #[$Trace 0]
  let shown: #[~U32] = #[]
  let access: Access = {trace, frame: shown, control: app.control ()}
  access := app.start stages access
  access := app.render stages access 0.0 100.0 100.0
  let labels = array.map (func index => U32.to_f32 names[index]) (sort.order_u32 layers)
  return check.report #[
    check.equal #[0.0,10.0,11.0,30.0] (array.map U32.to_f32 access.frame),
    check.equal #[0.0,10.0,11.0,20.0,30.0] labels,
  ]
