import * as app from "ink/app"
import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as clock from "ink/clock"
import * as check from "./check"
type Trace is data = $Trace U32
const draw = func (id: U32) -> (_: app.Presentation) -> (frame: Array U32) => return do:
  use ecs.set ($Trace id)
  return array.push id frame
const make = func () => return do:
  let b = app.new $clock.Policy {step_seconds:0.016666667,max_elapsed:0.25,max_steps:5}
  b := app.insert_unsaved_resource ($Trace 0) b
  b := app.in_layer 30 (func builder => return app.add_named_system $app.Render #[30] (draw 30) builder) b
  b := app.in_layer 10 (func builder => return app.add_named_system $app.Render #[10] (draw 10) builder) b
  b := app.add_named_system $app.Render #[0] (draw 0) b
  b := app.in_layer 10 (func builder => return app.add_named_system $app.Render #[11] (draw 11) builder) b
  b := app.render_if (func () => return false) (app.in_layer 20 (func builder => return app.add_named_system $app.Render #[20] (draw 20) builder)) b
  b := app.add_system $app.Start (func () => return ecs.set ($Trace 0)) b
  b := app.add_system $app.Normalize (func () => return ecs.set ($Trace 0)) b
  b := app.add_system $app.Event (func (_: app.EventContext) => return ()) b
  b := app.add_system $app.Interface (func (_: app.EventContext) => return ()) b
  b := app.add_system $app.Update (func (_: F32) => return ()) b
  break app.build b
entry const test_render_order_is_explicit_stable_and_keeps_guards_and_diagnostic_labels = func () : Array F32 => return do:
  let application = make ()
  let world = app.create_world application ()
  let (_, shown) = app.run application world $ func () => return app.render_scoped application #[] 0.0 100.0 100.0
  let $app.Application { labels: schedule } = application
  let labels = array.map (func (label: app.Label) => return U32.to_f32 label.name[0]) schedule.renders
  return check.report #[
    check.equal #[0.0,10.0,11.0,30.0] (array.map U32.to_f32 shown),
    check.equal #[0.0,10.0,11.0,20.0,30.0] labels,
  ]
