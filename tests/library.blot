import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as arrays from "ink/arrays"
import * as math from "ink/math"
import * as noise from "ink/noise"
import * as random from "ink/random"
import * as sort from "ink/sort"

entry const order_u32 = func (keys: Array U32) : Array U32 => return sort.order_u32 keys

entry const order = func (keys: Array F32) : Array U32 => return sort.order keys

entry const copy = func (values: Array F32) : Array F32 => return do:
  let copied = arrays.copy values
  if copied.length > 0:
    copied[0] := self + 10.0
  return array.concat values copied

entry const copy_u32 = func (values: Array U32) : Array U32 => return do:
  let copied = arrays.copy_u32 values
  if copied.length > 0:
    copied[0] := self + 10
  return array.concat values copied

entry const next = func (seed: U32) : U32 => return random.next seed
entry const unit = func (seed: U32) : F32 => return random.unit seed

entry const rotation = func (angle: F32) : Array F32 => return do:
  let q = math.axis_angle math.up angle
  let v = math.Quat.rotate q math.forward
  let identity = q * math.Quat.conjugate q
  let zero = math.Quat.normalized ($math.Quat { x: 0.0, y: 0.0, z: 0.0, w: 0.0 })
  return #[v.x, v.y, v.z, identity.x, identity.y, identity.z, identity.w, zero.w]

entry const plane = func (lanes: Array F32) : F32 => return do:
  let ray = $math.Ray {
    origin: $Vec3 { x: 0.0, y: lanes[0], z: 0.0 },
    direction: $Vec3 { x: 0.0, y: lanes[1], z: 0.0 },
  }
  return case math.Ray.plane ray math.up math.zero3 of
    $Some distance => distance
    $Nothing => (-1.0)

entry const fractal = func (octaves: U32) : Array F32 => return #[
  noise.fbm2 7 octaves (math.vec2 0.25 (-0.75)),
  noise.fbm3 7 octaves (math.vec3 0.25 (-0.75) 1.5),
]
