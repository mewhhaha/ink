import * as host from "ink/pen/host"
import * as array from "std/array"
import * as math from "ink/math"
import * as persist from "ink/persist"
import * as preferences from "ink/preferences"
import * as render from "ink/render"
import * as services from "ink/services"
import * as sound from "ink/sound"
import * as tree from "ink/ui/tree"
import * as extensions from "pen/extensions"
import * as protocol from "pen/protocol_render"
import * as wire from "pen/types"

type EncodingAccess = {
  frame: render.FrameAccess, audio: sound.Access,
  frame_vectors: #[~math.Vec4], frame_faces: #[~render.Face], frame_values: #[~F32],
  frame_inset_draws: #[~render.Draw],
  ui_labels: #[~U32], ui_marked: #[~tree.Node], service_output: #[~services.Request], encoder_text: #[~F32],
}
func bind_frame base -> (own bindings): EncodingAccess => {
  frame: bindings.frame, audio: bindings.audio, frame_vectors: bindings.frame_vectors,
  frame_faces: bindings.frame_faces, frame_values: bindings.frame_values,
  frame_inset_draws: bindings.frame_inset_draws,
  ui_labels: bindings.ui_labels, ui_marked: bindings.ui_marked, service_output: bindings.service_output, encoder_text: bindings.encoder_text,
}

entry func solid (count: U32): #[F32] =>
  let faces: #[+wire.SolidFace] = #[]
  for index in 0 .. count:
    @storage.push faces ($wire.SolidFace {normal: $wire.Vector {x: 0.0, y: 1.0, z: 0.0}, distance: U32.to_f32 index, material: 7 + index})
  return protocol.encode_solid ($wire.Solid {faces: faces.view 0 faces.length})

entry func extension (byte: U32): #[F32] =>
  let records: #[+extensions.ActorObservation] = #[]
  @storage.push records ($extensions.ActorObservation {byte})
  let encoded: #[~F32] = #[]
  extensions.append_actor_observation (seal records) encoded
  if encoded.length != 3 or encoded[0] != 42.0 or encoded[1] != 1.0:
    return panic "invalid actor observation extension framing"
  return array.generate (encoded.length - 2) (func i => encoded[i + 2])

entry func packet (count: U32): #[F32] =>
  let requests = persist.requests ()
  let next = #[1]
  let outbox: #[~services.Request] = #[]
  let waiting: #[~services.Request] = #[]
  let filling: #[~services.Filling] = #[]
  let answers: #[~services.Answer] = #[]
  let statuses: #[~U32] = #[]
  let payload: #[~F32] = #[]
  let service_state = services.access next outbox waiting filling answers statuses payload
  let kept = preferences.make ($preferences.Quality {msaa: 1, fxaa: false, scale: 1.0, filtering: 0, shadows: 0, occlusion: false, sky: false, fog: 0.0, effects: false, bloom: false})
    ($preferences.Volumes {master: 1.0, effects: 1.0, music: 1.0}) ($preferences.Controls {left_handed: false})
  kept.changed := count > 0
  let access: EncodingAccess = bind_frame () (own (host.frame_owners ()))
  let destination: #[~F32] = #[]
  @storage.push destination (-999.0)
  if count > 0:
    @storage.push access.frame_vectors (math.vec4 10.0 (-0.0) 12.0 13.0)
    let draw: render.Draw = $render.Draw {mesh: 7, material: 9, matrix: math.Mat4.identity, parameters: $Some (math.vec4 2.0 3.0 4.0 5.0), extra: &access.frame_vectors[0..1]}
    @storage.push access.frame.draws draw
    for index in 0 .. count:
      @storage.push access.frame_faces ($render.Face {normal: math.vec3 0.0 1.0 0.0, distance: U32.to_f32 index, material: 7 + index})
    @storage.push access.frame.solids ($render.Solid {faces: &access.frame_faces[0..access.frame_faces.length]})
    let retained: render.Draw = $render.Draw {mesh: 11, material: 13, matrix: math.Mat4.identity, parameters: $Nothing, extra: &access.frame_vectors[0..0]}
    @storage.push access.frame_inset_draws retained
    @storage.push access.frame.insets ($render.Inset {x: 0.0, y: 0.0, width: 2.0, height: 2.0, pixel_size: 1.0, after_sprites: 0,
      view: math.Mat4.identity, projection: math.Mat4.identity, light: render.defaults.lighting, draws: &access.frame_inset_draws[0..1]})
    @storage.push access.frame.updates ($render.Instance {id: 4294967295, order: 16777215, draw: retained})
    @storage.push access.frame.removed 65536
    access.frame.settings[0].retained_enabled := true
    access.frame.settings[0].retained_reset := true
    access.frame.settings[0].retained_after := 1
    @storage.push access.frame_values 123.0
    @storage.push access.frame_values 125.0
    @storage.push access.frame.fields ($render.Field {material: 17, width: 2, height: 1, x: 0, z: 0, columns: 2, values: &access.frame_values[0..2]})
    @storage.push access.frame.extensions ($render.Extension {tag: 42, values: &access.frame_values[0..2]})
    @storage.push access.ui_labels 65
    @storage.push access.ui_labels 66
    @storage.push access.ui_labels 67
    @storage.push access.ui_marked ($tree.Node {
      id: 3, parent: 0, role: 1, name: &access.ui_labels[0..1], description: &access.ui_labels[1..2], value_text: &access.ui_labels[2..3],
      x: 1.0, y: 2.0, width: 3.0, height: 4.0,
      focusable: true, focused: false, disabled: false, hidden: false, modal: false,
      checked: 0, expanded: 0, selected: 0, live: 0, value: 5.0, minimum: 0.0, maximum: 10.0, step: 1.0, actions: 1,
    })
  let audio = $sound.Audio {sounds: &access.audio.sounds[0..0], voices: &access.audio.voices[0..0], buses: &access.audio.buses[0..0]}
  destination := host.encode_frame 26 requests audio kept (&access.ui_marked[0..access.ui_marked.length]) (render.finish access.frame)
    (&access.service_output[0..0]) service_state access.encoder_text destination
  return array.generate destination.length (func index => destination[index])
