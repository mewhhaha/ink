import * as array from "std/array"
import * as check from "./check"
import * as ecs from "ink/ecs"
type Position is data = #Position U32
entry const components = fn (amount: U32) => do:
  let builder = ecs.new ()
  builder := ecs.register_component (#Position 0) self
  let simulation = ecs.build builder
  let (_, result) = ecs.create simulation (fn () => do:
    use first <- ecs.spawn (fn () => ecs.set (#Position amount))
    use membership <- ecs.membership_revision ()
    use written <- ecs.component_revision #Position
    use ecs.at first (fn () => ecs.set (#Position 4))
    use edited <- ecs.component_revision #Position
    use ecs.despawn first
    use removed <- ecs.membership_revision ()
    use after <- ecs.component_revision #Position
    use ecs.replace_components #Position #[]
    use replaced <- ecs.component_revision #Position
    use ecs.replace_entities #[]
    use reset <- ecs.membership_revision ()
    return #[amount, membership, written, edited, removed, after, replaced, reset])
  return result

entry const test_component_revisions = fn () => check.report #[check.words #[3, 1, 1, 2, 2, 3, 4, 3] (components 3)]
