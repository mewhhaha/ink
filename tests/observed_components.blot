import * as array from "std/array"
import * as check from "./check"
import * as ecs from "ink/ecs"
type Position is data = $Position U32
entry func components (amount:U32) =>
  let alive:ecs.Entities=ecs.entities ()
  let alive_meta=ecs.metadata 1
  let pool:ecs.Pool Position=ecs.pool ()
  let meta=ecs.metadata 1
  let first=ecs.spawn alive alive_meta
  ecs.insert alive pool meta first ($Position amount)
  let membership=alive_meta[2]
  let written=meta[1]
  ecs.write pool meta first ($Position 4)
  let edited=meta[1]
  ecs.remove pool meta first
  ecs.despawn alive alive_meta first
  let removed=alive_meta[2]
  let after=meta[1]
  ecs.replace_components alive pool meta #[]
  let replaced=meta[1]
  // Empty replacement makes no row transition. A fresh entity lifetime has
  // its own epoch and starts at revision zero, never recycling old IDs.
  let reset_alive:ecs.Entities=ecs.entities ()
  let reset_meta=ecs.metadata 2
  return #[amount,membership,written,edited,removed,after,replaced,reset_meta[2]]
entry func test_component_revisions () => check.report #[check.words #[3,1,1,2,2,3,3,0] (components 3)]
