import * as array from "std/array"
import * as eq from "std/equality"
import * as test from "std/test"
import * as map from "ink/map"
import * as set from "ink/set"
import * as relations from "ink/relations"
import * as pages from "ink/pages"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as grid from "ink/spatial/point_grid"
import * as math from "ink/math"
import * as codec from "ink/codec"
import * as jobs from "ink/task_queue"
import * as journal from "ink/journal"

type Key = {id: U32, label: U32}
const key_policy = map.key (func (key: Key) => key.id % 17) (func a -> b => a.id % 17 == b.id % 17)
const collide = map.key (func (key: Key) => 0) (func a -> b => a.id % 17 == b.id % 17)
func append_u32 (dst: own #[U32]) -> (src: #[U32]) : #[U32] =>
  for v in src:
    @storage.push dst v
  return dst
func key_words (rows:set.Set Key) =>
  let result:#[U32] = #[]
  for key in set.values rows:
    result := append_u32 self #[key.id,key.label]
  return result
func contains_key (policy:map.Key Key) -> (key:Key) -> values => array.any (func value => policy.equal key value) values
func reference_keys (policy:map.Key Key) -> (values:#[Key]) =>
  let result:#[Key] = #[]
  for value in values:
    if not (contains_key policy value result):
      @storage.push result value
  return result
func set_case (policy:map.Key Key) =>
  let left = array.generate 70 (func i:Key => {id:i*7,label:i+100})
  let right = array.generate 90 (func i:Key => {id:i*11,label:i+1000})
  let before = reference_keys policy left
  let other = reference_keys policy right
  let actual:set.Set Key = set.from policy left (set.empty ())
  let original = key_words actual
  let united:set.Set Key = map.copy_into policy identity identity (set.empty ()) actual
  let others:set.Set Key = set.from policy right (set.empty ())
  united := set.union policy united others
  let intersected:set.Set Key = map.copy_into policy identity identity (set.empty ()) actual
  intersected := set.intersection policy intersected others
  let different:set.Set Key = map.copy_into policy identity identity (set.empty ()) actual
  different := set.difference policy different others
  let words = func values =>
    let result:#[U32] = #[]
    for key in values:
      result := append_u32 self #[key.id,key.label]
    return result
  return eq.equal_array (words before) (key_words actual) and
    eq.equal_array (words (reference_keys policy (array.concat before other))) (key_words united) and
    eq.equal_array (words (array.filter (func key => contains_key policy key other) before)) (key_words intersected) and
    eq.equal_array (words (array.filter (func key => not (contains_key policy key other)) before)) (key_words different) and
    eq.equal_array original (key_words actual)
@[test.suite]
test "set batch algebra preserves equivalent representatives and order":
  let ok = set_case key_policy and set_case collide
  use test.holds "set batch algebra" ok
  return ()

const target_policy = map.key (func (key:U32) => key%3) (func a -> b => a%3==b%3)
func relation_words (edges:relations.Relations [U32,U32]) =>
  let result:#[U32] = #[]
  @storage.push result (map.count edges)
  for pair in map.entries edges:
    let (source,target)=pair
    result := append_u32 self #[source,target]
  for target in #[0,1,2]:
    let values=relations.sources target_policy.equal target edges
    @storage.push result values.length
    result := append_u32 self values
  return result
func relation_case (policy:map.Key U32) =>
  let good=true
  for destination in #[0,1,2,7]:
    let edges:relations.Relations [U32,U32]=relations.empty ()
    for source in 0 .. 150:
      edges := relations.link policy source (source%9) edges
    let original=relation_words edges
    let copied:relations.Relations [U32,U32]=relations.copy_into policy identity identity (relations.empty ()) edges
    for source in relations.sources target_policy.equal destination copied:
      copied := relations.unlink policy source copied
    let actual:relations.Relations [U32,U32]=relations.copy_into policy identity identity (relations.empty ()) edges
    actual := relations.remove_target policy target_policy.equal destination actual
    good := self and eq.equal_array (relation_words copied) (relation_words actual) and eq.equal_array original (relation_words edges)
  return good
const source_collision=map.key (func (key:U32) => 0) U32.eq
@[test.suite]
test "bulk relationship removal matches sequential collision cases":
  let ok = relation_case map.u32 and relation_case source_collision
  use test.holds "bulk relationship removal" ok
  return ()

type Counter is data = $Counter U32
func counter x => case x of
  $Some ($Counter n) => n
  _ => 0xFFFFFFFF
func occupied ids =>
  let result:#[U32]=#[]
  let previous=0xFFFFFFFF
  for id in ids:
    let word=id/32
    if word != previous:
      @storage.push result word
      previous := word
  return result
@[test.suite]
test "membership batches keep old views and transition only changed words":
  let alive:ecs.Entities=ecs.entities ()
  let alive_meta=ecs.metadata 9
  let (_, alive, alive_meta) = ecs.spawn_many alive alive_meta 2049
  let pool:ecs.Pool Counter=ecs.pool ()
  let meta=ecs.metadata 9
  let ids=#[0,1,31,32,64,1024,2048]
  let (pool, meta) = ecs.insert_selected alive pool meta ids (array.map (func i => $Counter i) ids)
  let before:ecs.Pool Counter=ecs.copy_into identity (ecs.pool ()) pool
  let membership_before:#[Bool]=#[]
  let original=query.source 1 pool meta membership_before
  let original_structure=original.structure
  let log:journal.Journal=journal.empty ()
  let log_meta=journal.metadata 9 64
  let cursor=journal.cursor log_meta
  let selected=#[0,1,33,64,96,2048]
  let values=#[$Some ($Counter 77),$Nothing,$Some ($Counter 33),$Nothing,$Some ($Counter 96),$Nothing]
  let logged = (pool, meta, log, log_meta)
  for i in 0 .. selected.length:
    logged := do:
      let (p, pm, l, m) = self
      break case values[i] of
        $Some value => ecs.insert_tracked alive p pm l m selected[i] value
        $Nothing => ecs.remove_tracked p pm l m selected[i]
  let (pool, meta, log, log_meta) = logged
  let current:ecs.Pool Counter=ecs.copy_into identity (ecs.pool ()) pool
  let membership_after:#[Bool]=#[]
  let changed=query.source 1 pool meta membership_after
  let changed_structure=changed.structure
  let scratch:#[journal.Change]=#[]
  let updates:#[U32]=#[]
  let removes:#[U32]=#[]
  let result=journal.read_into cursor log log_meta scratch updates removes
  let (got_updates, got_removes) = case result of
    $journal.Delta {changes} => (copy changes.updated, copy changes.removed)
    _ => (#[], #[])
  let (pool, meta) = ecs.write pool meta 0 ($Counter 88)
  let (pool, meta) = ecs.write pool meta 31 ($Counter 99)
  let membership_payload:#[Bool]=#[]
  let payload=query.source 1 pool meta membership_payload
  let idx_before = ecs.indices alive before
  let idx_curr = ecs.indices alive current
  let occ = occupied idx_curr
  let vals_before = array.map (func i => counter (ecs.read before i)) ids
  let vals_curr = array.map (func i => counter (ecs.read current i)) #[0, 31, 32, 33, 96, 1024]
  let struct_ok = original_structure + 5 == changed_structure and changed_structure == payload.structure
  use test.eq "before indices" #[0, 1, 31, 32, 64, 1024, 2048] idx_before
  use test.eq "current indices" #[0, 31, 32, 33, 96, 1024] idx_curr
  use test.eq "occupied words" #[0, 1, 3, 32] occ
  use test.eq "updates" #[0, 33, 96] got_updates
  use test.eq "removes" #[1, 64, 2048] got_removes
  use test.holds "structure transitions" struct_ok
  use test.eq "before values" #[0, 1, 31, 32, 64, 1024, 2048] vals_before
  use test.eq "current values" #[77, 31, 32, 33, 96, 1024] vals_curr
  return ()

@[test.suite]
test "sparse and dense bit iteration matches scalar reference":
  let masks = #[0, 1, 0x80000000, 0x10101010, 0x000001FF, 0xFFFFFFFF, 0x7FFFFFFF, 0xAAAAAAAA]
  let alive: ecs.Entities = ecs.entities ()
  let alive_meta = ecs.metadata 1
  let (_, alive, alive_meta) = ecs.spawn_many alive alive_meta (masks.length * 32)
  let pool: ecs.Pool U32 = ecs.pool ()
  let meta = ecs.metadata 1
  for i in 0 .. masks.length * 32:
    if (masks[i / 32] >> (i % 32)) & 1 != 0:
      let was = ecs.contains pool i
      pool := ecs.put_row alive self i i
      meta := ecs.bump_insert was self
  let expected = #[i | i <- array.generate (masks.length * 32) identity, (masks[i / 32] >> (i % 32)) & 1 != 0]
  let act = ecs.indices alive pool
  use test.eq "indices" expected act
  return ()

@[test.suite]
test "point grid build keeps all hash chains and old snapshots":
  let positions = array.generate 220 (func i => math.vec3 (U32.to_f32 (i % 17) * 0.4 - 3.2) 0.0 (U32.to_f32 (i / 17) * 0.4 - 2.0))
  let heads: #[U32] = #[]
  let points: #[grid.Point] = #[]
  let storage = $grid.Storage {heads, points}
  let (stored, storage) = grid.build_into storage $Nothing 0.4 16 positions
  let result = grid.read storage stored
  let old_heads = array.map identity result.heads
  let old_points = array.map identity result.points
  let expected = array.fill 16 0
  let ok = true
  for i in 0 .. positions.length:
    let point = old_points[i]
    let key = grid.bucket result.mask point.cx point.cz
    ok := self and point.next == expected[key]
    ok := self and codec.float_word point.x == codec.float_word positions[i].x and codec.float_word point.z == codec.float_word positions[i].z
    expected[key] := i + 1
  let old_count = (grid.within result positions[12].x positions[12].z 0.0).length
  let (grown, storage) = grid.push_stored storage stored positions[12]
  let current = grid.read storage grown
  let lens_ok = old_points.length == positions.length and current.points.length == positions.length + 1
  let new_count = (grid.within current positions[12].x positions[12].z 0.0).length
  use test.holds "hash chains" ok
  use test.eq "old heads" expected old_heads
  use test.holds "snapshot lengths" lens_ok
  use test.eq "pushed point count" (old_count + 1) new_count
  return ()

// An exclusive writer can take over a nonzero range, then rebuild at zero.
@[test.suite]
test "exclusive point grid extends a packed range and rebuilds":
  let heads: #[U32] = #[]
  let points: #[grid.Point] = #[]
  let storage = $grid.Storage {heads, points}
  let at = math.vec3 3.0 0.0 4.0
  let (_, storage) = grid.build_into storage $Nothing 1.0 16 #[math.zero3]
  let (packed, storage) = grid.build_into storage $Nothing 1.0 16 (array.fill 16 at)
  let (grown, next) = grid.append packed at storage
  let count = (grid.within (grid.read next grown) at.x at.z 0.0).length
  let (small, cleared) = grid.rebuild 1.0 16 #[at] next
  let (two, last) = grid.append small math.zero3 cleared
  let current = grid.read last two
  let starts_ok = packed.points.start > 0 and packed.heads.start > 0
  let summary = #[count, small.points.start, small.heads.start, current.points.length]
  let w_at = grid.within current at.x at.z 0.0
  let w_zero = grid.within current 0.0 0.0 0.0
  use test.holds "nonzero packed range" starts_ok
  use test.eq "summary" #[17, 0, 0, 2] summary
  use test.eq "at point" #[0] w_at
  use test.eq "zero point" #[1] w_zero
  return ()

@[test.suite]
test "dense membership edits preserve order and previous view":
  let alive: ecs.Entities = ecs.entities ()
  let alive_meta = ecs.metadata 9
  let (_, alive, alive_meta) = ecs.spawn_many alive alive_meta 1024
  let pool: ecs.Pool Counter = ecs.pool ()
  let meta = ecs.metadata 9
  let ids = array.generate 1024 identity
  let (pool, meta) = ecs.insert_selected alive pool meta ids (array.map (func i => $Counter i) ids)
  let before: ecs.Pool Counter = ecs.copy_into identity (ecs.pool ()) pool
  for id in ids:
    if id % 3 == 0:
      let was = ecs.contains pool id
      pool := ecs.remove_row self id
      meta := ecs.bump_remove was self
    else:
      pool := ecs.write_row self id ($Counter (id + 10))
      meta := ecs.bump_payload self
  let expected = #[i | i <- ids, i % 3 != 0]
  let b_idx = ecs.indices alive before
  let p_idx = ecs.indices alive pool
  let ok_999 = counter (ecs.read before 999) == 999 and counter (ecs.read pool 999) == 0xFFFFFFFF
  let ok_1000 = counter (ecs.read before 1000) == 1000 and counter (ecs.read pool 1000) == 1010
  use test.eq "before indices" ids b_idx
  use test.eq "after indices" expected p_idx
  use test.holds "removed 999" ok_999
  use test.holds "updated 1000" ok_1000
  return ()

type Span is data = $Span {start: U32, count: U32}
@[test.suite]
test "batch queue preserves reference payloads and snapshot":
  let source_payload: #[U32] = #[]
  let requests = array.generate 32 (func i => $Span {start: i * 3, count: 3})
  for i in 0 .. 32:
    for value in #[i, i * 3, 0xFFFFFFFF]:
      @storage.push source_payload value
  let locals = array.generate 32 (func i => $Span {start: 96 + i * 2, count: 2})
  for i in 0 .. 32:
    @storage.push source_payload (i * 7)
    @storage.push source_payload (i + 1)
  let payload: #[U32] = #[]
  for value in source_payload:
    @storage.push payload value
  let before: jobs.Queue [Span, Span, Span] = jobs.empty ()
  let before_meta = jobs.metadata 3 32 false
  let history: #[jobs.Mark] = #[]
  let before_count = before.length
  let ($Some tickets, before, before_meta, history) = jobs.submit_many 1 1 (copy requests) locals before before_meta history else:
    return panic "valid reference batch rejected"
  let individual: jobs.Queue [Span, Span, Span] = jobs.empty ()
  let individual_meta = jobs.metadata 3 32 false
  let individual_history: #[jobs.Mark] = #[]
  let ind_state = (individual, individual_meta, individual_history)
  for i in 0 .. requests.length:
    ind_state := do:
      let (q, m, h) = self
      let ($Some _, q, m, h) = jobs.submit 1 1 requests[i] locals[i] q m h else:
        return panic "valid reference submission rejected"
      break (q, m, h)
  let (individual, individual_meta, individual_history) = ind_state
  source_payload[0] := 99
  requests[0] := $Span {start: 0, count: 1}
  let encode_payload = copy payload
  let encode_words = func span => array.slice span.start span.count encode_payload
  let batch_words = jobs.encode encode_words encode_words encode_words before before_meta
  let individual_words = jobs.encode encode_words encode_words encode_words individual individual_meta
  let first_request = encode_words before[0].request
  let bstate = (before, before_meta, history)
  for i in 0 .. tickets.length:
    let start = payload.length
    @storage.push payload i
    @storage.push payload 0xFFFFFFFF
    bstate := do:
      let (q, m, h) = self
      let (settled, q, m, h) = jobs.settle 2 tickets[i] ($jobs.Value ($Span {start, count: 2})) q m h
      if not settled:
        return panic "valid reference completion rejected"
      break (q, m, h)
  let (before, before_meta, history) = bstate
  let (delivered, before, before_meta, history) = jobs.publish 2 before before_meta history
  let mutated_src = array.slice requests[0].start requests[0].count source_payload
  let empty_ok = before_count == 0 and before.length == 0
  let deliv_ok = delivered.length == requests.length
  use test.eq "individual vs batch" individual_words batch_words
  use test.eq "first request" #[0, 0, 0xFFFFFFFF] first_request
  use test.eq "source payload isolated" #[99] mutated_src
  use test.holds "queue empty" empty_ok
  use test.holds "all delivered" deliv_ok
  return ()
