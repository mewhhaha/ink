import * as check from "./check"
import * as input from "ink/input"
import * as keys from "ink/input/keys"
import * as events from "ink/events"

entry func test_repeat_focus_and_pointer_claims_are_event_local () =>
  let state = #[input.initial]
  let held: #[~U32] = #[]
  let fresh: #[~U32] = #[]
  let buttons: #[~U32] = #[]
  input.receive state held fresh buttons ($events.KeyDown keys.a)
  let first = input.just_pressed (input.read state held fresh buttons) keys.a
  input.receive state held fresh buttons ($events.KeyDown keys.a)
  let repeated = not (input.just_pressed (input.read state held fresh buttons) keys.a)
  let down = input.pressed (input.read state held fresh buttons) keys.a
  input.receive state held fresh buttons ($events.PointerMove {x: 30.0, y: 10.0})
  input.claim state
  input.receive state held fresh buttons ($events.PointerDown {button: 0, x: 33.0, y: 8.0})
  let clicked = state[0]
  let button = input.button_held (input.read state held fresh buttons) input.primary
  input.receive state held fresh buttons $events.FocusLost
  return check.report #[check.holds first, check.holds repeated, check.holds down, check.holds button,
    check.holds (not clicked.claimed),
    check.equal #[3.0, -2.0, 33.0, 8.0, 0.0, 0.0] #[clicked.dx, clicked.dy, state[0].x, state[0].y, from held.length, from buttons.length]]
entry func test_axes_balance_and_codec_round_trips () =>
  let state = #[input.initial]
  let held: #[~U32] = #[]
  let fresh: #[~U32] = #[]
  let buttons: #[~U32] = #[]
  input.receive state held fresh buttons ($events.KeyDown keys.left)
  let left = input.axis (input.read state held fresh buttons) keys.left keys.right
  input.receive state held fresh buttons ($events.KeyDown keys.right)
  let balanced = input.axis (input.read state held fresh buttons) keys.left keys.right
  input.receive state held fresh buttons ($events.PointerDown {button: 2, x: 5.0, y: 8.0})
  let encoded = input.encode (input.read state held fresh buttons)
  input.receive state held fresh buttons $events.FocusLost
  input.decode_into encoded state held fresh buttons
  let restored = input.read state held fresh buttons
  return check.report #[check.equal #[-1.0, 0.0] #[left, balanced],
    check.holds (input.pressed restored keys.left), check.holds (input.pressed restored keys.right),
    check.holds (input.button_held restored input.secondary), check.equal encoded (input.encode restored)]
entry func test_new_sessions_release_saved_keys_and_buttons () =>
  let state = #[input.initial]
  let held: #[~U32] = #[]
  let fresh: #[~U32] = #[]
  let buttons: #[~U32] = #[]
  input.receive state held fresh buttons ($events.KeyDown keys.w)
  input.receive state held fresh buttons ($events.PointerDown {button: input.primary, x: 33.0, y: 8.0})
  input.claim state
  input.receive state held fresh buttons ($events.SessionStarted {restored: true})
  return check.report #[check.equal #[0.0, 0.0, 0.0, 33.0, 8.0] #[from held.length, from buttons.length, from fresh.length, state[0].x, state[0].y], check.holds (not state[0].claimed)]
entry func input_workload (count: U32) =>
  let state = #[input.initial]
  let held: #[~U32] = #[]
  let fresh: #[~U32] = #[]
  let buttons: #[~U32] = #[]
  let checksum = 0.0
  for index in 0 .. count:
    input.receive state held fresh buttons ($events.PointerMove {x: from index, y: 10.0})
    input.receive state held fresh buttons ($events.KeyDown keys.a)
    checksum := self + input.axis (input.read state held fresh buttons) keys.left keys.a
    input.receive state held fresh buttons ($events.KeyUp keys.a)
  return checksum + state[0].x
entry func test_wheel_uses_its_current_pointer_without_creating_drag_motion () =>
  let state = #[input.initial]
  let held: #[~U32] = #[]
  let fresh: #[~U32] = #[]
  let buttons: #[~U32] = #[]
  input.receive state held fresh buttons ($events.PointerDown {button: 2, x: 10.0, y: 20.0})
  input.receive state held fresh buttons ($events.Wheel {delta: 1.0, x: 30.0, y: 40.0})
  return check.report #[check.equal #[30.0, 40.0, 0.0, 0.0] #[state[0].x, state[0].y, state[0].dx, state[0].dy],
    check.holds (input.button_held (input.read state held fresh buttons) input.secondary and not state[0].claimed)]
