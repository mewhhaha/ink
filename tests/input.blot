import * as check from "./check"
import * as input from "ink/input"
import * as keys from "ink/input/keys"
import * as events from "ink/events"

entry const test_repeat_focus_and_pointer_claims_are_event_local = fn () => do:
  let pressed = input.apply input.empty (#events.KeyDown keys.a)
  let repeated = input.apply pressed (#events.KeyDown keys.a)
  let pointer = input.apply repeated (#events.PointerMove { x: 30.0, y: 10.0 })
  pointer.claimed := #True
  let clicked = input.apply pointer (#events.PointerDown { button: 0, x: 33.0, y: 8.0 })
  let cleared = input.apply clicked #events.FocusLost
  return check.report #[
    check.holds (input.just_pressed pressed keys.a),
    check.holds (Bool.not (input.just_pressed repeated keys.a)),
    check.holds (input.pressed repeated keys.a),
    check.holds (input.button_held clicked input.primary),
    check.holds (Bool.not clicked.claimed),
    check.equal #[3.0, -2.0, 33.0, 8.0, 0.0, 0.0] #[clicked.dx, clicked.dy, cleared.x, cleared.y, U32.to_f32 cleared.held.length, U32.to_f32 cleared.buttons.length],
  ]

entry const test_axes_balance_and_codec_round_trips = fn () => do:
  let held = input.apply input.empty (#events.KeyDown keys.left)
  let both = input.apply held (#events.KeyDown keys.right)
  let pointer = input.apply both (#events.PointerDown { button: 2, x: 5.0, y: 8.0 })
  use restored <- input.decode (input.encode pointer)
  return check.report #[
    check.equal #[-1.0, 0.0] #[input.axis held keys.left keys.right, input.axis both keys.left keys.right],
    check.holds (input.pressed restored keys.left),
    check.holds (input.pressed restored keys.right),
    check.holds (input.button_held restored input.secondary),
    check.equal (input.encode pointer) (input.encode restored),
  ]

entry const input_workload = fn (count: U32) => do:
  let controls = input.empty
  let checksum = 0.0
  for index in 0 .. count:
    let x = U32.to_f32 index
    controls := input.apply self (#events.PointerMove { x, y: 10.0 })
    controls := input.apply self (#events.KeyDown keys.a)
    checksum := self + input.axis controls keys.left keys.a
    controls := input.apply self (#events.KeyUp keys.a)
  return checksum + controls.x
