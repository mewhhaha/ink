import { Vec2 } from "std/vector"
import * as test from "std/test"
import * as bits from "./support/bits"
import * as events from "ink/events"
import * as keys from "ink/input/keys"
import * as math from "ink/math"
import * as render from "ink/render"
import * as sketch from "ink/ui/sketch"
import * as testing from "ink/ui/testing"
import * as tree from "ink/ui/tree"
import * as vocabulary from "ink/ui/vocabulary"

private const vp = math.vec2 800.0 600.0
private const panel_r = math.vec4 20.0 20.0 300.0 420.0

@[test.suite]
test "sketch button checkbox toggle and rows":
  // Frame 1: press pointer over the first button inside panel.
  // Panel header is font_px (13) + 18 = 31; padding = 14 -> first widget y = 20 + 31 + 14 = 65.
  // Button height = 13 + 18 = 31 -> center y = 80, x = 100.
  let s = sketch.init_state ()
  let press_evs: #[events.Event] = #[$events.PointerDown { button: 0, x: 100.0, y: 80.0 }]
  s := sketch.feed_events (&press_evs[0..press_evs.length]) self
  let ui = sketch.begin s vp 0.0 sketch.paper_theme
  ui := sketch.panel "TEST" panel_r self
  let (clicked1, ui) = sketch.button "PLAY!" ui
  let (checked1, ui) = sketch.checkbox "SOUND" false ui
  let (on1, ui) = sketch.toggle "BOIL" false ui
  let (s, frame1) = sketch.finish_into ui (render.empty_frame ())

  // Frame 2: release pointer on the same button -> fires click!
  let rel_evs: #[events.Event] = #[$events.PointerUp { button: 0, x: 100.0, y: 80.0 }]
  s := sketch.feed_events (&rel_evs[0..rel_evs.length]) self
  let ui2 = sketch.begin s vp 0.0 sketch.paper_theme
  ui2 := sketch.panel "TEST" panel_r self
  let (clicked2, ui2) = sketch.button "PLAY!" ui2
  let (checked2, ui2) = sketch.checkbox "SOUND" checked1 ui2
  let (on2, ui2) = sketch.toggle "BOIL" on1 ui2
  let (s, _) = sketch.finish_into ui2 (render.empty_frame ())

  // Frame 3 & 4: click checkbox (y = 65 + 31 + 9 = 105, h = 24 -> y = 117) and row button.
  let cb_down: #[events.Event] = #[$events.PointerDown { button: 0, x: 50.0, y: 117.0 }]
  s := sketch.feed_events (&cb_down[0..cb_down.length]) self
  let ui3 = sketch.begin s vp 0.0 sketch.paper_theme
  ui3 := sketch.panel "TEST" panel_r self
  let (_, ui3) = sketch.button "PLAY!" ui3
  let (checked3, ui3) = sketch.checkbox "SOUND" checked2 ui3
  let (s, _) = sketch.finish_into ui3 (render.empty_frame ())

  let cb_up: #[events.Event] = #[$events.PointerUp { button: 0, x: 50.0, y: 117.0 }]
  s := sketch.feed_events (&cb_up[0..cb_up.length]) self
  let ui4 = sketch.begin s vp 0.0 sketch.paper_theme
  ui4 := sketch.panel "TEST" panel_r self
  let (_, ui4) = sketch.button "PLAY!" ui4
  let (checked4, ui4) = sketch.checkbox "SOUND" checked3 ui4
  // Horizontal 2-column row
  ui4 := sketch.row_begin 2 self
  let (_, ui4) = sketch.button "LEFT" ui4
  let (_, ui4) = sketch.button "RIGHT" ui4
  ui4 := sketch.row_end self
  let (_, frame4, nodes4, labels4) = sketch.finish_with_tree ui4 (render.empty_frame ())
  let l4 = &labels4[0..labels4.length]
  let n4 = &nodes4[0..nodes4.length]
  let left_btn = testing.get_by_role vocabulary.role_button "LEFT" l4 n4
  let right_btn = testing.get_by_role vocabulary.role_button "RIGHT" l4 n4

  let ok_click = not clicked1 and clicked2
  let ok_check = not checked1 and not checked2 and not checked3 and checked4
  let ok_ext = frame1.extensions.length == 2 and frame1.extensions[0].tag == 65008 and frame1.extensions[1].tag == 65006
  let ok_row = frame4.extensions.length == 2 and left_btn.x + left_btn.width < right_btn.x
    and abs (left_btn.y - right_btn.y) < 0.01 and abs (left_btn.width - right_btn.width) < 0.01
  use test.holds "check 1" ok_click
  use test.holds "check 2" ok_check
  use test.holds "check 3" (not on1 and not on2)
  use test.holds "check 4" ok_ext
  use test.holds "check 5" ok_row
  return ()

@[test.suite]
test "sketch slider radio textbox and doodle":
  // Slider occupies y = 65..106 (track_y = 65 + 13 + 10 = 88, track_x = 34..306, width = 272).
  let s = sketch.init_state ()
  let drag_start: #[events.Event] = #[$events.PointerDown { button: 0, x: 170.0, y: 92.0 }]
  s := sketch.feed_events (&drag_start[0..drag_start.length]) self
  let ui = sketch.begin s vp 0.0 sketch.chalkboard_theme
  ui := sketch.panel "TOOLS" panel_r self
  let (v1, ui) = sketch.slider "SPEED" 0.0 0.0 10.0 ui
  let opts: #[Text] = #["PEN", "CHALK", "CRAYON"]
  let (sel1, ui) = sketch.radio "BRUSH" (&opts[0..opts.length]) 0 ui
  let (open1, ui) = sketch.collapsing "EXTRA" false ui
  let name: Text = "HI"
  let (name1, ui) = sketch.text_box "NAME" name ui
  let strokes: #[Vec2] = #[]
  let (strokes1, ui) = sketch.doodle_pad 80.0 strokes ui
  let (s, _) = sketch.finish_into ui (render.empty_frame ())

  // Drag right even with pointer outside track Y (active capture!) -> reaches 10.0.
  let drag_far: #[events.Event] = #[$events.PointerMove { x: 400.0, y: 10.0 }]
  s := sketch.feed_events (&drag_far[0..drag_far.length]) self
  let ui2 = sketch.begin s vp 0.0 sketch.chalkboard_theme
  ui2 := sketch.panel "TOOLS" panel_r self
  let (v2, ui2) = sketch.slider "SPEED" v1 0.0 10.0 ui2
  let (s, _) = sketch.finish_into ui2 (render.empty_frame ())

  // Release slider, click textbox and type '!' (33) then check text update.
  let rel: #[events.Event] = #[$events.PointerUp { button: 0, x: 400.0, y: 10.0 }]
  s := sketch.feed_events (&rel[0..rel.length]) self
  let ui3 = sketch.begin s vp 0.0 sketch.sticky_note_theme
  ui3 := sketch.panel "INPUT" panel_r self
  let (t_in, ui3) = sketch.text_box "NAME" name1 ui3
  let (s, _) = sketch.finish_into ui3 (render.empty_frame ())

  // Focus text box (label y=65..80, box y=89..118 -> click y=102) and type '!'.
  let focus_evs: #[events.Event] = #[
    $events.PointerDown { button: 0, x: 80.0, y: 102.0 },
    $events.PointerUp { button: 0, x: 80.0, y: 102.0 },
    $events.TextInput { character: 33, composing: 0 },
  ]
  s := sketch.feed_events (&focus_evs[0..focus_evs.length]) self
  let ui4 = sketch.begin s vp 0.0 sketch.sticky_note_theme
  ui4 := sketch.panel "INPUT" panel_r self
  let (t_typed, ui4) = sketch.text_box "NAME" t_in ui4
  let (s, _) = sketch.finish_into ui4 (render.empty_frame ())
  let typed_len = t_typed.length
  let typed_last = if typed_len >= 3 then t_typed[2] else 0

  // Backspace deletes '!' back to length 2.
  let bs_evs: #[events.Event] = #[$events.KeyDown keys.backspace]
  s := sketch.feed_events (&bs_evs[0..bs_evs.length]) self
  let ui5 = sketch.begin s vp 0.0 sketch.sticky_note_theme
  ui5 := sketch.panel "INPUT" panel_r self
  let (t_bs, ui5) = sketch.text_box "NAME" t_typed ui5
  let (_, _) = sketch.finish_into ui5 (render.empty_frame ())

  // Doodle pad freehand drag records vertices.
  let ds = sketch.init_state ()
  let dp1: #[events.Event] = #[$events.PointerDown { button: 0, x: 80.0, y: 100.0 }]
  ds := sketch.feed_events (&dp1[0..dp1.length]) self
  let dui1 = sketch.begin ds vp 0.0 sketch.paper_theme
  dui1 := sketch.panel "PAD" panel_r self
  let (st1, dui1) = sketch.doodle_pad 100.0 strokes1 dui1
  let (ds, _) = sketch.finish_into dui1 (render.empty_frame ())

  let dp2: #[events.Event] = #[$events.PointerMove { x: 140.0, y: 130.0 }]
  ds := sketch.feed_events (&dp2[0..dp2.length]) self
  let dui2 = sketch.begin ds vp 0.0 sketch.paper_theme
  dui2 := sketch.panel "PAD" panel_r self
  let (st2, dui2) = sketch.doodle_pad 100.0 st1 dui2
  let (_, dframe) = sketch.finish_into dui2 (render.empty_frame ())

  let ok_slider = v1 > 4.5 and v1 < 5.5 and v2 == 10.0
  let ok_text = typed_len == 3 and typed_last == 33 and t_bs.length == 2
  let ok_doodle = st2.length == 2 and dframe.extensions[1].values.count > 100
  use test.holds "check 1" ok_slider
  use test.holds "check 2" (sel1 == 0 and not open1)
  use test.holds "check 3" ok_text
  use test.holds "check 4" ok_doodle
  return ()

@[test.suite]
test "sketch line boil determinism and a11y tree":
  let s = sketch.init_state ()
  let ui_a = sketch.begin s vp 0.0 sketch.paper_theme
  ui_a := sketch.panel "CARD" panel_r self
  ui_a := sketch.heading "DRAWFUL" self
  let (_, ui_a) = sketch.button "GO!" ui_a
  ui_a := sketch.progress "HEAT" 0.65 self
  let (_, frame_a) = sketch.finish_into ui_a (render.empty_frame ())

  // Same time => bit-identical line boil.
  let ui_b = sketch.begin s vp 0.0 sketch.paper_theme
  ui_b := sketch.panel "CARD" panel_r self
  ui_b := sketch.heading "DRAWFUL" self
  let (_, ui_b) = sketch.button "GO!" ui_b
  ui_b := sketch.progress "HEAT" 0.65 self
  let (_, frame_b) = sketch.finish_into ui_b (render.empty_frame ())

  // Next boil frame (time = 0.25s at 5 fps -> boil 1) => same count, jittered coordinates!
  let ui_c = sketch.begin s vp 0.25 sketch.paper_theme
  ui_c := sketch.panel "CARD" panel_r self
  ui_c := sketch.heading "DRAWFUL" self
  let (_, ui_c) = sketch.button "GO!" ui_c
  ui_c := sketch.progress "HEAT" 0.65 self
  let nodes = @storage.copy ui_c.nodes
  let labels = @storage.copy ui_c.labels
  let (_, frame_c) = sketch.finish_into ui_c (render.empty_frame ())

  let same_count = frame_a.extension_values.length == frame_c.extension_values.length
  let differed = false
  let n_check = min frame_a.extension_values.length frame_c.extension_values.length
  for i in 0 .. n_check:
    if frame_a.extension_values[i] != frame_c.extension_values[i]:
      differed := true

  // Semantic accessibility tree integrates directly with Ink's role testing!
  let lview = &labels[0..labels.length]
  let nview = &nodes[0..nodes.length]
  let btn_node = testing.get_by_role vocabulary.role_button "GO!" lview nview
  let pb_node = testing.get_by_role vocabulary.role_progressbar "HEAT" lview nview
  let btn_ok = btn_node.role == vocabulary.role_button and btn_node.focusable
  let pb_ok = pb_node.role == vocabulary.role_progressbar and pb_node.value > 0.6 and pb_node.value < 0.7
  let audit = testing.audit_tree lview nview

  use bits.bits_array "check 1" frame_a.extension_values frame_b.extension_values
  use test.holds "check 2" (same_count and differed)
  use test.holds "check 3" (btn_ok and pb_ok)
  use test.holds "check 4" (audit.length == 0)
  return ()
