import * as array from "std/array"
import * as check from "./check"
import * as services from "ink/services"
import * as typed from "ink/services/typed"
import * as ecs from "ink/ecs"
type Request is data = #Request { count: U32 }
type Count is data = #Count U32
const method = #typed.Method { service: 2, operation: 3,
  encode: fn (request: Request) => #typed.Arguments { a: from request.count, b: 0.0, c: 0.0, d: 0.0, values: #[] },
  decode: fn (answer: services.Answer) => if answer.status == 0 && is_finite answer.value && answer.value >= 0.0 && answer.value <= 16777215.0 && floor answer.value == answer.value then #Some (#Count (from answer.value)) else #Nothing }
entry const query = fn () => do:
  let simulation = ecs.build (ecs.insert_resource (services.idle 3) (ecs.new ()))
  let (_, values) = ecs.create simulation (fn () => do:
    use requested <- typed.ask method (#Request { count: 10 })
    use state <- ecs.get #services.Services
    state.answers := #[#services.Answer { id: typed.id requested, status: 0, value: 42.0, values: #[] }]
    use ecs.set state
    use result <- typed.take method requested
    use duplicate <- typed.take method requested
    let #Some (#typed.Received (#Count value)) = result else:
      break #[0]
    break #[value, if Maybe.is_some duplicate then 1 else 0, state.outbox[0].operation, from state.outbox[0].a])
  return values
entry const invalid = fn (value: F32) => case typed.receive method (#services.Answer { id: 1, status: 0, value, values: #[] }) of
  #typed.Invalid _ => 1
  #typed.Received _ => 0
entry const wrong_method = fn (operation: U32) => do:
  let simulation = ecs.build (ecs.insert_resource (services.idle 3) (ecs.new ()))
  let (_, value) = ecs.create simulation (fn () => do:
    use requested <- typed.ask method (#Request { count: 10 })
    let other = method
    other.operation := operation
    use result <- typed.take other requested
    return if Maybe.is_some result then 1 else 0)
  return value

entry const test_typed_service_domains_and_consumption = fn () => check.report (array.concat
  #[check.words #[42,0,3,10] (query ()),check.words #[0] #[invalid 0.0],check.words #[0] #[wrong_method 3]]
  #[check.words #[1] #[invalid value] | value <- #[-1.0,0.5,16777216.0,0.0 / 0.0,1.0 / 0.0]])
entry const trap_wrong_service_method = fn () => #[U32.to_f32 (wrong_method 4)]
