import * as array from "std/array"
import * as check from "./check"
import * as services from "ink/services"
import * as typed from "ink/services/typed"
import * as ecs from "ink/ecs"
type Request is data = $Request { count: U32 }
type Count is data = $Count U32
const empty: Array F32 = #[]
const method = $typed.Method {service:2,operation:3,
  encode:func (request:Request) => return $typed.Arguments {a:from request.count,b:0.0,c:0.0,d:0.0,values:&empty[0..0]},
  decode:func state -> (answer:services.Answer) => return if answer.status == 0 and is_finite answer.value and answer.value >= 0.0 and answer.value <= 16777215.0 and floor answer.value == answer.value then $Some ($Count (from answer.value)) else $Nothing}
const with_services = func consume => return do:
  let next: Array U32 = #[1]
  let outbox: ResizeArray services.Request = #[]
  let waiting: ResizeArray services.Request = #[]
  let filling: ResizeArray services.Filling = #[]
  let answers: ResizeArray services.Answer = #[]
  let statuses: ResizeArray U32 = #[]
  let payload: ResizeArray F32 = #[]
  let state = services.access next outbox waiting filling answers statuses payload
  services.idle state 3
  return consume state
entry const query = func () => return with_services (func state => return do:
  let requested = typed.ask method state ($Request {count:10})
  state.answers.push ($services.Answer {id:typed.id requested,status:0,value:42.0,values:$services.Span {start:0,count:0}})
  let result = typed.take method state requested
  let duplicate = typed.take method state requested
  let $Some ($typed.Received ($Count value)) = result else:
    return #[0]
  return #[value,if Maybe.is_some duplicate then 1 else 0,state.outbox[0].operation,from state.outbox[0].a])
entry const invalid = func (value:F32) => return with_services (func state => return case typed.receive method state ($services.Answer {id:1,status:0,value,values:$services.Span {start:0,count:0}}) of
  $typed.Invalid _ => 1
  $typed.Received _ => 0)
entry const wrong_method = func (operation:U32) => return with_services (func state => return do:
  let requested = typed.ask method state ($Request {count:10})
  let other = method
  other.operation := operation
  let result = typed.take other state requested
  return if Maybe.is_some result then 1 else 0)

entry const test_typed_service_domains_and_consumption = func () => return check.report (array.concat
  #[check.words #[42,0,3,10] (query ()),check.words #[0] #[invalid 0.0],check.words #[0] #[wrong_method 3]]
  #[check.words #[1] #[invalid value] | value <- #[-1.0,0.5,16777216.0,0.0 / 0.0,1.0 / 0.0]])
entry const trap_wrong_service_method = func () => return #[U32.to_f32 (wrong_method 4)]
