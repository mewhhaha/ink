// Scalar differential oracle adapted from the frozen pre-batch queue kernel.
// Rows, metadata and trace are independent caller owners; no whole queue return.
import * as jobs from "ink/task_queue"
import * as array from "std/array"
const same=func (a:jobs.Ticket) -> (b:jobs.Ticket) => return a.epoch==b.epoch and a.sequence==b.sequence
const mark=func ticket -> tick -> event -> (history:ResizeArray jobs.Mark) -> meta => return do:
  if meta[5]!=0:
    if history.length==256:
      for i in 1 .. history.length:
        history[i-1] := history[i]
      history.truncate (history.length-1)
    history.push ($jobs.Mark {ticket,tick,event})
const submit=func tick -> earliest -> request -> continuation -> (queue:jobs.Queue [U32,U32,U32]) -> meta -> history => return do:
  if meta[3]==0 or meta[1]==0 or queue.length>=meta[2] or tick<meta[4] or earliest<tick:
    return $Nothing
  let ticket= $jobs.Ticket {epoch:meta[0],sequence:meta[1]}
  meta[1] := if meta[1]==0xFFFFFFFF then 0 else meta[1]+1
  meta[4] := tick
  queue.push ($jobs.Job {ticket,submitted:tick,earliest,request,continuation,state:$jobs.Pending})
  mark ticket tick $jobs.Submitted history meta
  return $Some ticket
const locate=func (ticket:jobs.Ticket) -> (queue:jobs.Queue [U32,U32,U32]) -> (meta:jobs.Metadata) : Maybe U32 => return do:
  if ticket.epoch!=meta[0]:
    return $Nothing
  let low=0
  let high=queue.length
  for 0 .. 32:
    if low>=high:
      break
    let middle=low+(high-low)/2
    if queue[middle].ticket.sequence<ticket.sequence:
      low := middle+1
    else:
      high := middle
  return if low<queue.length and same ticket queue[low].ticket then $Some low else $Nothing
const settle=func (tick:U32) -> (ticket:jobs.Ticket) -> (outcome:jobs.Outcome U32) -> (queue:jobs.Queue [U32,U32,U32]) -> meta -> history => return do:
  if meta[3]!=0 and tick>=meta[4]:
    if let $Some index=locate ticket queue meta:
      let job=queue[index]
      if tick>=job.submitted:
        if let $jobs.Pending=job.state:
          job.state := $jobs.Ready {tick,outcome}
          queue[index] := job
          meta[4] := tick
          mark ticket tick $jobs.Completed history meta
          return true
  mark ticket tick $jobs.Rejected history meta
  return false
const cancel=func (tick:U32) -> (ticket:jobs.Ticket) -> (reason:U32) -> (queue:jobs.Queue [U32,U32,U32]) -> meta -> history => return do:
  if tick<meta[4]:
    return false
  if let $Some index=locate ticket queue meta:
    let job=queue[index]
    if tick>=job.submitted:
      if let $jobs.Ready {outcome:$jobs.Cancelled _}=job.state:
        return false
      let stopped:jobs.State U32= $jobs.Ready {tick,outcome:$jobs.Cancelled reason}
      job.state := stopped
      job.earliest := min job.earliest tick
      queue[index] := job
      meta[4] := tick
      mark ticket tick $jobs.Stopped history meta
      return true
  return false
const close=func tick -> reason -> (queue:jobs.Queue [U32,U32,U32]) -> meta -> history => return do:
  if meta[3]==0:
    return ()
  if tick<meta[4]:
    @panic "task close tick moved backwards"
  for index in 0 .. queue.length:
    cancel tick queue[index].ticket reason queue meta history
  meta[3] := 0
  meta[4] := tick
const reissue=func epoch -> (queue:jobs.Queue [U32,U32,U32]) -> meta -> history => return do:
  if epoch==0 or epoch==meta[0]:
    @panic "task restore requires a fresh epoch"
  meta[0] := epoch
  history.truncate 0
  for index in 0 .. queue.length:
    let job=queue[index]
    job.ticket.epoch := epoch
    queue[index] := job
    if let $jobs.Pending=job.state:
      mark job.ticket meta[4] $jobs.Reissued history meta
const publish=func tick -> (queue:jobs.Queue [U32,U32,U32]) -> meta -> history => return do:
  if tick<meta[4]:
    @panic "task delivery tick moved backwards"
  let delivered:GrowArray (jobs.Delivery [U32,U32])=#[]
  let count=0
  for job in queue:
    let $jobs.Ready {tick:ready,outcome}=job.state else:
      break
    if tick<ready or tick<job.earliest:
      break
    delivered.push ($jobs.Delivery {ticket:job.ticket,continuation:job.continuation,outcome})
    mark job.ticket tick $jobs.Published history meta
    count := count+1
  for i in count .. queue.length:
    queue[i-count] := queue[i]
  queue.truncate (queue.length-count)
  meta[4] := tick
  return @storage.freeze delivered
const decode = func (maximum: U32) -> (trace: Bool) -> decode_request -> decode_value -> decode_local -> (words: Array U32) -> (queue: jobs.Queue [U32,U32,U32]) -> (meta:jobs.Metadata) -> (history:ResizeArray jobs.Mark) => return do:
  if words.length < 7 or words[0] != 1 or words[1] == 0 or words[3] > min 4096 maximum or words[4] > 1 or words[6] > words[3]:
    return false
  let decoded:jobs.Queue [U32,U32,U32]=jobs.empty ()
  let offset = 7
  let previous = 0
  for 0 .. words[6]:
    if words.length - offset < 8:
      return false
    let sequence = words[offset]
    let submitted = words[offset + 1]
    let earliest = words[offset + 2]
    let tag = words[offset + 3]
    let ready = words[offset + 4]
    let requests = words[offset + 5]
    let locals = words[offset + 6]
    let values = words[offset + 7]
    if sequence <= previous or (words[2] != 0 and sequence >= words[2]) or submitted > words[5] or earliest < submitted or tag > 3:
      return false
    offset := self + 8
    if requests > words.length - offset:
      return false
    let $Some request = decode_request (array.slice offset requests words) else:
      return false
    offset := self + requests
    if locals > words.length - offset:
      return false
    let $Some local = decode_local (array.slice offset locals words) else:
      return false
    offset := self + locals
    if values > words.length - offset:
      return false
    let payload = array.slice offset values words
    offset := self + values
    let state = $jobs.Pending
    if tag == 0:
      if values != 0 or ready != 0 or Bool.not (words[4]==1):
        return false
    else:
      if ready < submitted or ready > words[5] or (Bool.not (words[4]==1) and tag != 3):
        return false
      let outcome = $jobs.Failed 0
      if tag == 1:
        let $Some value = decode_value payload else:
          return false
        outcome := $jobs.Value value
      else:
        if values != 1:
          return false
        outcome := if tag == 2 then $jobs.Failed payload[0] else $jobs.Cancelled payload[0]
      state := $jobs.Ready { tick: ready, outcome }
    decoded.push ($jobs.Job {ticket:$jobs.Ticket {epoch:words[1],sequence},submitted,earliest,request,continuation:local,state})
    previous := sequence
  if offset != words.length:
    return false
  queue.truncate 0
  history.truncate 0
  for job in decoded:
    queue.push job
  for i in 0 .. 5:
    meta[i] := words[i+1]
  meta[5] := if trace then 1 else 0
  return true
