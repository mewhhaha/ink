// Scalar differential oracle adapted from the frozen pre-batch queue kernel.
// Rows, metadata and trace are independent caller owners; no whole queue return.
import * as jobs from "ink/task_queue"
import * as array from "std/array"
func same (a:jobs.Ticket) -> (b:jobs.Ticket) => return a.epoch==b.epoch and a.sequence==b.sequence
func mark ticket -> tick -> event -> (history:own ResizeArray jobs.Mark) -> meta => return do:
  if meta[5]!=0:
    if history.length==256:
      for i in 1 .. history.length:
        history[i-1] := history[i]
      history.truncate (history.length-1)
    history.push ($jobs.Mark {ticket,tick,event})
  return history
func submit tick -> earliest -> request -> continuation -> (queue:jobs.Queue [U32,U32,U32]) -> (meta:own jobs.Metadata) -> (history:own ResizeArray jobs.Mark) : (Maybe jobs.Ticket,jobs.Metadata,ResizeArray jobs.Mark) => return do:
  if meta[3]==0 or meta[1]==0 or queue.length>=meta[2] or tick<meta[4] or earliest<tick:
    return ($Nothing,meta,history)
  let ticket= $jobs.Ticket {epoch:meta[0],sequence:meta[1]}
  meta[1] := if meta[1]==0xFFFFFFFF then 0 else meta[1]+1
  meta[4] := tick
  let job: jobs.Job [U32,U32,U32] = $jobs.Job {ticket,submitted:tick,earliest,request,continuation,state:$jobs.Pending}
  queue.push job
  history := mark ticket tick $jobs.Submitted history meta
  return ($Some ticket,meta,history)
func locate (ticket:jobs.Ticket) -> (queue:jobs.Queue [U32,U32,U32]) -> (meta:jobs.Metadata) : Maybe U32 => return do:
  if ticket.epoch!=meta[0]:
    return $Nothing
  let low=0
  let high=queue.length
  for 0 .. 32:
    if low>=high:
      break
    let middle=low+(high-low)/2
    if queue[middle].ticket.sequence<ticket.sequence:
      low := middle+1
    else:
      high := middle
  return if low<queue.length and same ticket queue[low].ticket then $Some low else $Nothing
func settle (tick:U32) -> (ticket:jobs.Ticket) -> (outcome:jobs.Outcome U32) -> (queue:own jobs.Queue [U32,U32,U32]) -> (meta:own jobs.Metadata) -> (history:own ResizeArray jobs.Mark) => return do:
  if meta[3]!=0 and tick>=meta[4]:
    if let $Some index=locate ticket queue meta:
      if tick>=queue[index].submitted:
        if let $jobs.Pending=queue[index].state:
          queue[index].state := $jobs.Ready {tick,outcome}
          meta[4] := tick
          history := mark ticket tick $jobs.Completed history meta
          return (true,queue,meta,history)
  history := mark ticket tick $jobs.Rejected history meta
  return (false,queue,meta,history)
func cancel (tick:U32) -> (ticket:jobs.Ticket) -> (reason:U32) -> (queue:own jobs.Queue [U32,U32,U32]) -> (meta:own jobs.Metadata) -> (history:own ResizeArray jobs.Mark) => return do:
  if tick<meta[4]:
    return (false,queue,meta,history)
  if let $Some index=locate ticket queue meta:
    if tick>=queue[index].submitted:
      if let $jobs.Ready {outcome:$jobs.Cancelled _}=queue[index].state:
        return (false,queue,meta,history)
      let stopped:jobs.State U32= $jobs.Ready {tick,outcome:$jobs.Cancelled reason}
      queue[index].state := stopped
      queue[index].earliest := min self tick
      meta[4] := tick
      history := mark ticket tick $jobs.Stopped history meta
      return (true,queue,meta,history)
  return (false,queue,meta,history)
func close tick -> reason -> (queue:own jobs.Queue [U32,U32,U32]) -> (meta:own jobs.Metadata) -> (history:own ResizeArray jobs.Mark) => return do:
  if meta[3]==0:
    return (queue,meta,history)
  if tick<meta[4]:
    @panic "task close tick moved backwards"
  for index in 0 .. queue.length:
    let (unused,cancelled,cancelled_meta,cancelled_history)=cancel tick queue[index].ticket reason queue meta history
    queue := cancelled
    meta := cancelled_meta
    history := cancelled_history
  meta[3] := 0
  meta[4] := tick
  return (queue,meta,history)
func reissue epoch -> (queue:own jobs.Queue [U32,U32,U32]) -> (meta:own jobs.Metadata) -> (history:own ResizeArray jobs.Mark) => return do:
  if epoch==0 or epoch==meta[0]:
    @panic "task restore requires a fresh epoch"
  meta[0] := epoch
  history.truncate 0
  for index in 0 .. queue.length:
    queue[index].ticket.epoch := epoch
    if let $jobs.Pending=queue[index].state:
      history := mark queue[index].ticket meta[4] $jobs.Reissued history meta
  return (queue,meta,history)
func publish tick -> (queue:own jobs.Queue [U32,U32,U32]) -> (meta:own jobs.Metadata) -> (history:own ResizeArray jobs.Mark) => return do:
  if tick<meta[4]:
    @panic "task delivery tick moved backwards"
  let delivered:GrowArray (jobs.Delivery [U32,U32])=#[]
  let count=0
  for job in queue:
    let $jobs.Ready {tick:ready,outcome}=job.state else:
      break
    if tick<ready or tick<job.earliest:
      break
    delivered.push ($jobs.Delivery {ticket:job.ticket,continuation:job.continuation,outcome})
    history := mark job.ticket tick $jobs.Published history meta
    count := count+1
  for i in count .. queue.length:
    queue[i-count] := $jobs.Job {ticket:queue[i].ticket,submitted:queue[i].submitted,earliest:queue[i].earliest,request:queue[i].request,continuation:queue[i].continuation,state:queue[i].state}
  queue.truncate (queue.length-count)
  meta[4] := tick
  return (@storage.freeze delivered,queue,meta,history)
func decode (maximum: U32) -> (trace: Bool) -> decode_request -> decode_value -> decode_local -> (words: Array U32) -> (queue: jobs.Queue [U32,U32,U32]) -> (meta:own jobs.Metadata) -> (history:ResizeArray jobs.Mark) => return do:
  if words.length < 7 or words[0] != 1 or words[1] == 0 or words[3] > min 4096 maximum or words[4] > 1 or words[6] > words[3]:
    return (false,meta)
  let decoded:jobs.Queue [U32,U32,U32]=jobs.empty ()
  let offset = 7
  let previous = 0
  for 0 .. words[6]:
    if words.length - offset < 8:
      return (false,meta)
    let sequence = words[offset]
    let submitted = words[offset + 1]
    let earliest = words[offset + 2]
    let tag = words[offset + 3]
    let ready = words[offset + 4]
    let requests = words[offset + 5]
    let locals = words[offset + 6]
    let values = words[offset + 7]
    if sequence <= previous or (words[2] != 0 and sequence >= words[2]) or submitted > words[5] or earliest < submitted or tag > 3:
      return (false,meta)
    offset := self + 8
    if requests > words.length - offset:
      return (false,meta)
    let $Some request = decode_request (array.slice offset requests words) else:
      return (false,meta)
    offset := self + requests
    if locals > words.length - offset:
      return (false,meta)
    let $Some local = decode_local (array.slice offset locals words) else:
      return (false,meta)
    offset := self + locals
    if values > words.length - offset:
      return (false,meta)
    let payload = array.slice offset values words
    offset := self + values
    let state: jobs.State U32 = $jobs.Pending
    if tag == 0:
      if values != 0 or ready != 0 or Bool.not (words[4]==1):
        return (false,meta)
    else:
      if ready < submitted or ready > words[5] or (Bool.not (words[4]==1) and tag != 3):
        return (false,meta)
      let outcome: jobs.Outcome U32 = $jobs.Failed 0
      if tag == 1:
        let $Some value = decode_value payload else:
          return (false,meta)
        outcome := $jobs.Value value
      else:
        if values != 1:
          return (false,meta)
        outcome := if tag == 2 then $jobs.Failed payload[0] else $jobs.Cancelled payload[0]
      state := $jobs.Ready { tick: ready, outcome }
    let job: jobs.Job [U32,U32,U32] = $jobs.Job {ticket:$jobs.Ticket {epoch:words[1],sequence},submitted,earliest,request,continuation:local,state}
    decoded.push job
    previous := sequence
  if offset != words.length:
    return (false,meta)
  queue.truncate 0
  history.truncate 0
  for job in decoded:
    queue.push job
  for i in 0 .. 5:
    meta[i] := words[i+1]
  meta[5] := if trace then 1 else 0
  return (true,meta)
