import * as host from "ink/pen/host"
import * as array from "std/array"
import * as math from "ink/math"
import * as persist from "ink/persist"
import * as preferences from "ink/preferences"
import * as render from "ink/render"
import * as services from "ink/services"
import * as sound from "ink/sound"
import * as tree from "ink/ui/tree"

// Test consumers run while every frame/payload owner is alive. No frame view
// escapes this known callback; the result is an independent numeric packet.
type Access = {
  frame: render.FrameAccess, audio: sound.Access,
  ui_labels: #[U32], ui_nodes: #[tree.StoredNode],
  service_output: #[services.Request],
}
func bind_frame base -> (own bindings) : Access => {
  frame: bindings.frame, audio: bindings.audio,
  ui_labels: bindings.ui_labels, ui_nodes: bindings.ui_nodes,
  service_output: bindings.service_output,
}
func with_access consume => host.with_frame {bind_frame} () consume
func with_output consume : #[F32] =>
  let requests = persist.requests ()
  let next = #[1]
  let outbox: #[services.Request] = #[]
  let waiting: #[services.Request] = #[]
  let filling: #[services.Filling] = #[]
  let answers: #[services.Answer] = #[]
  let statuses: #[U32] = #[]
  let payload: #[F32] = #[]
  let state = services.access next outbox waiting filling answers statuses payload
  let access = bind_frame () (own (host.frame_owners ()))
  let output: #[F32] = #[]
  let written: #[F32] = consume (own access) (own state) requests (own output)
  return written
func encode (schema: U32) -> (kept: preferences.Preferences) -> (buses: Bool) -> (access: Access) -> (state: services.Services) -> (requests: #[U32]) -> (output: own #[F32]) : #[F32] =>
  let audio: sound.Audio = $sound.Audio {sounds: &access.audio.sounds[0..access.audio.sounds.length],
    voices: &access.audio.voices[0..access.audio.voices.length],
    buses: &access.audio.buses[0..if buses then access.audio.buses.length else 0],
    listener: &access.audio.listener[0..access.audio.listener.length],
    panners: &access.audio.panners[0..access.audio.panners.length],
    reverb_zones: &access.audio.reverb_zones[0..access.audio.reverb_zones.length],
    synths: &access.audio.synths[0..access.audio.synths.length]}
  return host.encode_frame schema requests audio kept (&access.ui_nodes[0..access.ui_nodes.length]) (&access.ui_labels[0..access.ui_labels.length]) (render.finish access.frame)
    (&access.service_output[0..access.service_output.length]) state output
