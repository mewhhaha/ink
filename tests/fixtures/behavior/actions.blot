import * as b from "ink/behavior"
type Action is data = $Hit | $Wait | $Fail | $Invalid
type Condition is data = $Enabled | $Failure
const act = func (action: Action) => return func (tick: b.Tick) => return func (local: U32) => return case action of
  $Hit => $b.Done { local: local + 1, remaining: tick.seconds }
  $Wait => if tick.elapsed + tick.seconds >= 0.5 then $b.Done { local, remaining: max 0.0 (tick.elapsed + tick.seconds - 0.5) } else $b.Waiting { local, reason: 17 }
  $Fail => $b.Abort { local, reason: 99 }
  $Invalid => $b.Done { local, remaining: tick.seconds + 1.0 }
const ready = func (condition: Condition) => return func (local: U32) => return case condition of
  $Enabled => local % 2 == 0
  $Failure => local >= 100
const cleanup = func (reason: U32) => return func (local: U32) => return local + reason
