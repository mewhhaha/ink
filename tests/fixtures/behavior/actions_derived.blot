// Generated checked behavior; graph IDs are saved-state identity.
import * as _behavior from "ink/behavior"
import * as b from "ink/behavior"
type Action is data = #Hit | #Wait | #Fail | #Invalid
type Condition is data = #Enabled | #Failure
const act = fn (action: Action) => fn (tick: b.Tick) => fn (local: U32) => case action of
  #Hit => #b.Done { local: local + 1, remaining: tick.seconds }
  #Wait => if tick.elapsed + tick.seconds >= 0.5 then #b.Done { local, remaining: max 0.0 (tick.elapsed + tick.seconds - 0.5) } else #b.Waiting { local, reason: 17 }
  #Fail => #b.Abort { local, reason: 99 }
  #Invalid => #b.Done { local, remaining: tick.seconds + 1.0 }
const ready = fn (condition: Condition) => fn (local: U32) => case condition of
  #Enabled => local % 2 == 0
  #Failure => local >= 100
const cleanup = fn (reason: U32) => fn (local: U32) => local + reason

const actor_program: _behavior.Program [Action, Condition] = do:
  let #Some program = _behavior.build 7 10 #[_behavior.wait 10 0.25 20, _behavior.branch 20 (#Failure) 90 30, _behavior.until 30 (#Enabled) 40, _behavior.repeat 40 3 45 80, _behavior.repeat 45 2 50 70, _behavior.action 50 (#Hit) 60, _behavior.again 60 45, _behavior.again 70 40, _behavior.repeat 80 0 95 85, _behavior.action 85 (#Wait) 100, _behavior.action 90 (#Fail) 100, _behavior.action 95 (#Invalid) 100, _behavior.stop 100] else:
    break @panic "invalid generated behavior program"
  break program
const actor_advance: _behavior.State U32 -> F32 -> U32 -> U32 -> Maybe (_behavior.Advanced U32) = fn state => fn seconds => fn budget => fn max_frames => do:
  if state.version != 7 || Bool.not (is_finite seconds) || seconds < 0.0:
    return #Nothing
  if state.frames.length > max_frames || Bool.not (is_finite state.elapsed) || state.elapsed < 0.0:
    return #Nothing
  let remaining = seconds
  let transitions = 0
  let visited: Array U32 = #[]
  if _behavior.terminal state.status:
    return #Some (#_behavior.Advanced { state, remaining, transitions, visited })
  let step = state.step
  let age = state.elapsed
  let local_value = state.local
  let frames = state.frames
  let status = #_behavior.Running
  let waiting = #False
  for used in 0 .. budget:
    if waiting || _behavior.terminal status:
      break
    let elapsed = age + remaining
    if Bool.not (is_finite elapsed):
      return #Nothing
    case step of
      10 => do:
        visited := @array.concat self #[10]
        remaining := max 0.0 (elapsed - 0.25)
        if elapsed >= 0.25:
          step := 20
          age := 0.0
          transitions := self + 1
        else:
          age := elapsed
          status := #_behavior.Time
          waiting := #True
      20 => do:
        visited := @array.concat self #[20]
        step := if ready (#Failure) local_value then 90 else 30
        age := 0.0
        transitions := self + 1
      30 => do:
        visited := @array.concat self #[30]
        if ready (#Enabled) local_value:
          step := 40
          age := 0.0
          transitions := self + 1
        else:
          age := elapsed
          remaining := 0.0
          status := #_behavior.Condition
          waiting := #True
      40 => do:
        visited := @array.concat self #[40]
        if frames.length >= max_frames:
          status := #_behavior.StackFull
          waiting := #True
        else:
          frames := @array.concat self #[{ owner: 40, remaining: 3 }]
          step := 45
          age := 0.0
          transitions := self + 1
      45 => do:
        visited := @array.concat self #[45]
        if frames.length >= max_frames:
          status := #_behavior.StackFull
          waiting := #True
        else:
          frames := @array.concat self #[{ owner: 45, remaining: 2 }]
          step := 50
          age := 0.0
          transitions := self + 1
      50 => do:
        visited := @array.concat self #[50]
        let outcome = act (#Hit) (#_behavior.Tick { seconds: remaining, elapsed: age }) local_value
        case outcome of
          #_behavior.Done { local, remaining: left } => do:
            if Bool.not (is_finite left) || left < 0.0 || left > remaining:
              return #Nothing
            local_value := local
            remaining := left
            step := 60
            age := 0.0
            transitions := self + 1
          #_behavior.Waiting { local, reason } => do:
            local_value := local
            age := elapsed
            remaining := 0.0
            status := #_behavior.Action reason
            waiting := #True
          #_behavior.Abort { local, reason } => do:
            local_value := cleanup reason local
            frames := #[]
            status := #_behavior.Interrupted reason
      60 => do:
        visited := @array.concat self #[60]
        if frames.length == 0:
          return #Nothing
        let at = frames.length - 1
        let frame = frames[at]
        if frame.owner != 45:
          return #Nothing
        if frame.remaining > 1:
          frame.remaining := self - 1
          frames[at] := frame
          step := 50
        else:
          frames := @array.slice self 0 at
          step := 70
        age := 0.0
        transitions := self + 1
      70 => do:
        visited := @array.concat self #[70]
        if frames.length == 0:
          return #Nothing
        let at = frames.length - 1
        let frame = frames[at]
        if frame.owner != 40:
          return #Nothing
        if frame.remaining > 1:
          frame.remaining := self - 1
          frames[at] := frame
          step := 45
        else:
          frames := @array.slice self 0 at
          step := 80
        age := 0.0
        transitions := self + 1
      80 => do:
        visited := @array.concat self #[80]
        step := 85
        age := 0.0
        transitions := self + 1
      85 => do:
        visited := @array.concat self #[85]
        let outcome = act (#Wait) (#_behavior.Tick { seconds: remaining, elapsed: age }) local_value
        case outcome of
          #_behavior.Done { local, remaining: left } => do:
            if Bool.not (is_finite left) || left < 0.0 || left > remaining:
              return #Nothing
            local_value := local
            remaining := left
            step := 100
            age := 0.0
            transitions := self + 1
          #_behavior.Waiting { local, reason } => do:
            local_value := local
            age := elapsed
            remaining := 0.0
            status := #_behavior.Action reason
            waiting := #True
          #_behavior.Abort { local, reason } => do:
            local_value := cleanup reason local
            frames := #[]
            status := #_behavior.Interrupted reason
      90 => do:
        visited := @array.concat self #[90]
        let outcome = act (#Fail) (#_behavior.Tick { seconds: remaining, elapsed: age }) local_value
        case outcome of
          #_behavior.Done { local, remaining: left } => do:
            if Bool.not (is_finite left) || left < 0.0 || left > remaining:
              return #Nothing
            local_value := local
            remaining := left
            step := 100
            age := 0.0
            transitions := self + 1
          #_behavior.Waiting { local, reason } => do:
            local_value := local
            age := elapsed
            remaining := 0.0
            status := #_behavior.Action reason
            waiting := #True
          #_behavior.Abort { local, reason } => do:
            local_value := cleanup reason local
            frames := #[]
            status := #_behavior.Interrupted reason
      95 => do:
        visited := @array.concat self #[95]
        let outcome = act (#Invalid) (#_behavior.Tick { seconds: remaining, elapsed: age }) local_value
        case outcome of
          #_behavior.Done { local, remaining: left } => do:
            if Bool.not (is_finite left) || left < 0.0 || left > remaining:
              return #Nothing
            local_value := local
            remaining := left
            step := 100
            age := 0.0
            transitions := self + 1
          #_behavior.Waiting { local, reason } => do:
            local_value := local
            age := elapsed
            remaining := 0.0
            status := #_behavior.Action reason
            waiting := #True
          #_behavior.Abort { local, reason } => do:
            local_value := cleanup reason local
            frames := #[]
            status := #_behavior.Interrupted reason
      100 => do:
        visited := @array.concat self #[100]
        status := #_behavior.Finished
        frames := #[]
      _ => do:
        return #Nothing
  if Bool.not waiting && Bool.not (_behavior.terminal status):
    status := #_behavior.Budget
  return #Some (#_behavior.Advanced { state: #_behavior.State { version: state.version, step, elapsed: age, local: local_value, frames, status }, remaining, transitions, visited })
