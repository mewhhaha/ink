// Independent linear ordered-map oracle; no bucket/probe implementation reuse.
import * as array from "std/array"
type Rows = #[~Maybe (U32,U32)]
func locate policy -> key -> (rows:Rows) =>
  for index in 0 .. rows.length:
    if let $Some (saved,_)=rows[index]:
      if policy.equal saved key:
        return $Some index
  return $Nothing
func set policy -> key -> value -> (rows:own Rows) : Rows =>
  if let $Some index=locate policy key rows:
    let $Some (saved,_)=rows[index] else:
      panic "linear reference invariant"
    rows[index] := $Some (saved,value)
  else:
    rows.push ($Some (key,value))
  return rows
func remove policy -> key -> (rows:own Rows) : Rows =>
  if let $Some index=locate policy key rows:
    rows[index] := $Nothing
  return rows
func get policy -> key -> (rows:Rows) =>
  if let $Some index=locate policy key rows:
    let $Some (_,value)=rows[index] else:
      panic "linear reference invariant"
    return $Some value
  return $Nothing
func from policy -> entries -> (rows:own Rows) : Rows =>
  for entry in entries:
    let (key,value)=entry
    rows := set policy key value self
  return rows
func edit policy -> edits -> (rows:own Rows) : Rows =>
  for edit in edits:
    let (key,value)=edit
    rows := case value of
      $Some value => set policy key value self
      $Nothing => remove policy key self
  return rows
func entries (rows:Rows) => array.filter_map identity rows
func count rows => (entries rows).length
func copy (destination:Rows) -> (source:Rows) =>
  destination.truncate 0
  for row in source:
    destination.push row
  return ()
func alter policy -> key -> change -> (rows:own Rows) : Rows => case change (get policy key rows) of
  $Some value => set policy key value rows
  $Nothing => remove policy key rows
