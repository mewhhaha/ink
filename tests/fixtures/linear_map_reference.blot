// Independent linear ordered-map oracle; no bucket/probe implementation reuse.
import * as array from "std/array"
type Rows = ResizeArray (Maybe (U32,U32))
func locate policy -> key -> (rows:Rows) => return do:
  for index in 0 .. rows.length:
    if let $Some (saved,_)=rows[index]:
      if policy.equal saved key:
        return $Some index
  return $Nothing
func set policy -> key -> value -> (rows:Rows) => return do:
  if let $Some index=locate policy key rows:
    let $Some (saved,_)=rows[index] else:
      @panic "linear reference invariant"
    rows[index] := $Some (saved,value)
  else:
    rows.push ($Some (key,value))
func remove policy -> key -> (rows:Rows) => return do:
  if let $Some index=locate policy key rows:
    rows[index] := $Nothing
func get policy -> key -> (rows:Rows) => return do:
  if let $Some index=locate policy key rows:
    let $Some (_,value)=rows[index] else:
      @panic "linear reference invariant"
    return $Some value
  return $Nothing
func from policy -> entries -> (rows:Rows) => return do:
  for entry in entries:
    let (key,value)=entry
    set policy key value rows
func edit policy -> edits -> (rows:Rows) => return do:
  for edit in edits:
    let (key,value)=edit
    case value of
      $Some value => set policy key value rows
      $Nothing => remove policy key rows
func entries (rows:Rows) => return array.filter_map identity rows
func count rows => return (entries rows).length
func copy (destination:Rows) -> (source:Rows) => return do:
  destination.truncate 0
  for row in source:
    destination.push row
func alter policy -> key -> change -> (rows:Rows) => return case change (get policy key rows) of
  $Some value => set policy key value rows
  $Nothing => remove policy key rows
