// What assistive technology, or the game's keyboard focus, does to an interface
// node: moves the focus to it or away from it, does what clicking it does, steps
// its value up or down or sets it (to the UiAction event's value), opens or
// closes it. A node lists the actions it takes in its `actions` bits, 1 << code
// each.
const ui_action_focus = 0
const ui_action_blur = 1
const ui_action_activate = 2
const ui_action_increment = 3
const ui_action_decrement = 4
const ui_action_set_value = 5
const ui_action_expand = 6
const ui_action_collapse = 7

// An interface node's checked, expanded or selected state: none for a node
// without one.
const ui_state_none = 0
const ui_state_false = 1
const ui_state_true = 2
const ui_state_mixed = 3

// Whether assistive technology announces an interface node's changes as they
