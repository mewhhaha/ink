// Which service a request is for: Steam's achievements, stats and rich presence,
// the system clipboard, the browser for a web address, what the game runs on, a
// native compute library (grid pathfinding), and the host's developer tools
// (DEVTOOLS_OP_*), which only a dev tools program asks of. A host without one
// answers unavailable.
const service_steam = 0
const service_clipboard = 1
const service_url = 2
const service_platform = 3
const service_pathfinding = 4
const service_devtools = 5

// How a service request went: done; the service is not there (Steam is off, no
// clipboard, the browser cannot); it is there but refused or failed; or the host
// does not know the service or operation.
const service_status_ok = 0
const service_status_unavailable = 1
const service_status_failed = 2
const service_status_unknown = 3

// Steam's operations. Achievements and stats go by their API names (the text);
// set_stat and set_stat_float set `a`, add_stat adds `a` to an integer stat, and
// these and get_stat answer the stat's value. set_presence sets rich presence
// key (the text's first `a` code points) to the rest of the text; clear_presence
// clears every key. status answers ok while Steam runs for the game, unavailable
// otherwise.
const steam_op_unlock_achievement = 0
const steam_op_clear_achievement = 1
const steam_op_set_stat = 2
const steam_op_set_stat_float = 3
const steam_op_add_stat = 4
const steam_op_get_stat = 5
const steam_op_set_presence = 6
const steam_op_clear_presence = 7
const steam_op_status = 8

// The clipboard's operations: copy the text to it, or answer with the text on
// it.
const clipboard_op_copy = 0
const clipboard_op_paste = 1

// Open the http or https address in the text in the player's browser.
const url_op_open = 0

// What the game runs on, answered as text: the operating system (linux, windows,
// macos, web), the player's locale (a BCP 47 tag, en-US), and the device (value
// 1 on a Steam Deck, with its name as text).
const platform_op_os = 0
const platform_op_locale = 1
const platform_op_device = 2

// The shortest 4-connected path over a grid of `a` columns and `b` rows whose
// cells are the request's values (0 open, anything else blocked), from cell `c`
// to cell `d` (row * columns + column): it answers the path's cells in order,
// start and goal included, its length as the value, or none when there is no
// path.
const pathfinding_op_find = 0

// The host's developer tools. log answers the log's lines from serial `a` on,
// value the serial after the last, each line as its source (0 game, 1 build, 2
// reload, 3 asset, 4 pipeline, 5 session), 1 if an error, its length and its
// code points. frame answers the last frame's numbers in DEVTOOLS_FRAME's order,
// timing the game's frames while `a` is 1. gpu answers the graphics adapter's
// name. command sends the game console command `a` with argument `b`. pause and
// play stop and start the game's clock; step runs `a` frames and stays paused;
// rewind goes back `a` seconds of game time, paused; replay plays the last `a`
// seconds again, then live; history keeps the past to travel in (unavailable
// answers what needs it while none is kept). record starts recording the input
// to the text's path, or a new file when it is empty, or stops a recording. shot
// saves the window with the dev tools over it to the text's path, or a new file.
// tune sets the live-tunable constant whose id is `a` to `b`, and tuned answers
// the game's tuned values as id and value pairs. bake writes them into the
// checkout as the defaults.
const devtools_op_log = 0
const devtools_op_frame = 1
const devtools_op_gpu = 2
const devtools_op_command = 3
const devtools_op_pause = 4
const devtools_op_play = 5
const devtools_op_step = 6
const devtools_op_rewind = 7
const devtools_op_replay = 8
const devtools_op_history = 9
const devtools_op_record = 10
const devtools_op_shot = 11
const devtools_op_tune = 12
const devtools_op_bake = 13
const devtools_op_tuned = 14

