// Static application stages over separately named persistent/transient owners.
import * as app from "ink/app"
import * as clock from "ink/clock"
import * as input from "ink/input"
import * as persist from "ink/persist"
import * as events from "ink/events"
type Access = {
  scratch: #[U32], tally: #[U32], input_pointer: #[input.Pointer],
  input_held: #[~U32], input_fresh: #[~U32], input_buttons: #[~U32],
  requests: persist.Requests, clock: #[clock.Clock], control: app.Control, wall: #[app.Wall],
}
const policy= $clock.Policy {step_seconds:0.016666667,max_elapsed:0.25,max_steps:5}
func reset (access: Access) =>
  access.scratch[0] = 7
  access.tally[0] = 10
  persist.clear_requests access.requests
  return ()
func update (access: Access) -> (seconds:F32) =>
  access.scratch[0] = access.scratch[0]+1
  access.tally[0] = access.tally[0]+2
  access.input_pointer[0].x = access.input_pointer[0].x+1.0
  persist.request access.requests $persist.Save
  return ()
func event (access: Access) -> (context:app.EventContext) => case context.event of
  $events.KeyDown 42 => app.hold_frame access.control
  _ => ()
const application=app.stages (app.lent reset) app.no_action app.no_action app.no_action app.route_event
  app.no_event (app.lent_with event) (app.lent_with update) app.no_render app.no_action
func with_access consume =>
  let scratch= #[7]
  let tally= #[10]
  let input_pointer= #[input.initial]
  let input_held:#[~U32]= #[]
  let input_fresh:#[~U32]= #[]
  let input_buttons:#[~U32]= #[]
  let requests=persist.requests ()
  let current= #[clock.clock]
  let control=app.control ()
  let wall=app.wall ()
  let access={scratch,tally,input_pointer,input_held,input_fresh,input_buttons,requests,clock:current,control,wall}
  access := app.start application access
  return consume (own access)
func copy_into (destination: Access) -> (source: Access) =>
  destination.scratch[0] = source.scratch[0]
  destination.tally[0] = source.tally[0]
  destination.input_pointer[0] = source.input_pointer[0]
  destination.requests[0] = source.requests[0]
  destination.clock[0] = source.clock[0]
  destination.wall[0] = source.wall[0]
  for i in 0 .. source.control.length:
    destination.control[i] = source.control[i]
  for value in source.input_held:
    destination.input_held.push value
  for value in source.input_fresh:
    destination.input_fresh.push value
  for value in source.input_buttons:
    destination.input_buttons.push value
  return ()
func with_copy (source: Access) -> consume => with_access (func (access: own Access) =>
  copy_into access source
  return consume (own access))
func observe (access: Access) : #[F32] => #[U32.to_f32 access.scratch[0],U32.to_f32 access.tally[0],access.input_pointer[0].x,if persist.has access.requests $persist.Save then 1.0 else 0.0]
func frame (access: own Access) -> (seconds:F32) -> events =>
  access := app.begin_frame application access
  return app.advanced application access policy seconds events 960.0 640.0
func setup (access: own Access) -> (steps:U32) =>
  if steps>=1:
    access := frame access (1.0/60.0) #[]
  if steps>=2:
    access := frame access 0.0 #[]
  if steps>=3:
    access := frame access (2.0/60.0) #[]
  return access
func timing (access: Access) : #[F32] => #[U32.to_f32 access.clock[0].tick,access.clock[0].remainder,if app.paused access.control then 1.0 else 0.0]
