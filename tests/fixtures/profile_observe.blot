// Consume caller-owned parser buffers before returning independent numeric lanes.
import * as array from "std/array"
import * as profile from "ink/profile"
import * as packet_profile from "ink/pen/profile"
func flame_words (found:Maybe profile.Flame) =>
  let output:#[+F32] = #[]
  if let $Some flame = found:
    array.append_into output #[1.0,from flame.hottest.length,from flame.nodes.length]
    for node in flame.hottest:
      array.append_into output #[from node.function,node.samples,from node.name.length]
      array.append_into output (array.map U32.to_f32 node.name)
    for node in flame.nodes:
      array.append_into output #[from node.depth,from node.function,node.first,node.samples,node.alone,from node.name.length]
      array.append_into output (array.map U32.to_f32 node.name)
  return seal output
func flame (reader:#[~U32] -> #[~profile.Hot] -> #[~profile.Node] -> #[F32] -> Maybe profile.Flame) -> (packet:#[F32]) =>
  let text:#[~U32] = #[]
  let hottest:#[~profile.Hot] = #[]
  let nodes:#[~profile.Node] = #[]
  return flame_words (reader text hottest nodes packet)
func memory_words (found:Maybe packet_profile.Memory) =>
  let output:#[+F32] = #[]
  if let $Some memory = found:
    array.append_into output #[1.0,memory.committed,memory.most]
    for counter in memory.counters:
      array.append_into output #[counter.value,from counter.name.length]
      array.append_into output (array.map U32.to_f32 counter.name)
  return seal output
func memory (reader:#[~U32] -> #[~packet_profile.Counter] -> #[F32] -> Maybe packet_profile.Memory) -> (packet:#[F32]) =>
  let text:#[~U32] = #[]
  let counters:#[~packet_profile.Counter] = #[]
  return memory_words (reader text counters packet)
func accepted packet => (flame packet_profile.flame packet).length != 0
func accepted_memory packet => (memory packet_profile.memory packet).length != 0
