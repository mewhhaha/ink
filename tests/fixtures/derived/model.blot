import * as word from "ink/codec"
import * as ink_codec from "ink/codec"

type Positive is data = $Positive U32
const positive_encode = func value => return do:
  let $Positive number = value
  return #[number]
impl ValidPositive : word.Codec Positive = {
  const encode = func value => return positive_encode value,
  const decode = func values => return
    if values.length == 1 and values[0] > 0 then $Some ($Positive values[0]) else $Nothing,
}

type Site is data = $Site { ring: U32, sector: U32, kind: U32, age: F32, work: U32, impact: F32, delivered: U32 }
type Delivery is data = $Idle | $To { home: U32, amount: Positive } | $Batch { sites_start: U32, sites_count: U32 }
type Town is data = $Town { sites_start: U32, sites_count: U32, deliveries_start: U32, deliveries_count: U32 }
