import * as word from "ink/codec"
import * as ink_codec from "ink/codec"

type Positive is data = #Positive U32
const positive_encode = fn value => do:
  let #Positive number = value
  return #[number]
impl ValidPositive : word.Codec Positive = {
  const encode = fn value => positive_encode value,
  const decode = fn values =>
    if values.length == 1 && values[0] > 0 then #Some (#Positive values[0]) else #Nothing,
}

type Site is data = #Site { ring: U32, sector: U32, kind: U32, age: F32, work: U32, impact: F32, delivered: U32 }
type Delivery is data = #Idle | #To { home: U32, amount: Positive } | #Batch { sites: Array Site }
type Town is data = #Town { sites: Array Site, deliveries: Array Delivery }
