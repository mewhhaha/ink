// Consume caller-owned parser buffers before returning independent numeric lanes.
import * as array from "std/array"
import * as profile from "ink/profile"
import * as packet_profile from "ink/pen/profile"
func flame_words (found:Maybe profile.Flame) =>
  let output:#[F32] = #[]
  if let $Some flame = found:
    output := array.extend self #[1.0,from flame.hottest.length,from flame.nodes.length]
    for node in flame.hottest:
      let name = profile.name_of flame.text node.name
      output := array.extend self #[from node.function,node.samples,from name.length]
      output := array.extend self (array.map U32.to_f32 name)
    for node in flame.nodes:
      let name = profile.name_of flame.text node.name
      output := array.extend self #[from node.depth,from node.function,node.first,node.samples,node.alone,from name.length]
      output := array.extend self (array.map U32.to_f32 name)
  return output
func flame (reader:own #[U32] -> own #[profile.Hot] -> own #[profile.Node] -> #[F32] -> Maybe profile.Flame) -> (packet:#[F32]) =>
  let text:#[U32] = #[]
  let hottest:#[profile.Hot] = #[]
  let nodes:#[profile.Node] = #[]
  return flame_words (reader text hottest nodes packet)
func memory_words (found:Maybe packet_profile.Memory) =>
  let output:#[F32] = #[]
  if let $Some memory = found:
    output := array.extend self #[1.0,memory.committed,memory.most]
    for counter in memory.counters:
      let name = profile.name_of memory.text counter.name
      output := array.extend self #[counter.value,from name.length]
      output := array.extend self (array.map U32.to_f32 name)
  return output
func memory (reader:own #[U32] -> own #[packet_profile.Counter] -> #[F32] -> Maybe packet_profile.Memory) -> (packet:#[F32]) =>
  let text:#[U32] = #[]
  let counters:#[packet_profile.Counter] = #[]
  return memory_words (reader text counters packet)
func accepted packet => (flame packet_profile.flame packet).length != 0
func accepted_memory packet => (memory packet_profile.memory packet).length != 0
