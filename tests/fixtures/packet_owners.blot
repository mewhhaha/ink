import * as host from "ink/pen/host"
import * as array from "std/array"
import * as math from "ink/math"
import * as persist from "ink/persist"
import * as preferences from "ink/preferences"
import * as render from "ink/render"
import * as services from "ink/services"
import * as sound from "ink/sound"
import * as tree from "ink/ui/tree"

// Test consumers run while every frame/payload owner is alive. No frame view
// escapes this known callback; the result is an independent numeric packet.
type Access = {
  frame: render.FrameAccess, audio: sound.Access,
  frame_vectors: ResizeArray math.Vec4, frame_faces: ResizeArray render.Face,
  frame_values: ResizeArray F32, frame_inset_draws: ResizeArray render.Draw,
  ui_labels: ResizeArray U32, ui_nodes: ResizeArray tree.Node,
  service_output: ResizeArray services.Request, encoder_text: ResizeArray F32,
}
func bind_frame base -> bindings : Access => return {
  frame: bindings.frame, audio: bindings.audio,
  frame_vectors: bindings.frame_vectors, frame_faces: bindings.frame_faces,
  frame_values: bindings.frame_values, frame_inset_draws: bindings.frame_inset_draws,
  ui_labels: bindings.ui_labels, ui_nodes: bindings.ui_nodes,
  service_output: bindings.service_output, encoder_text: bindings.encoder_text,
}
func with_access consume => return host.with_frame {bind_frame} () consume
func with_output consume : Array F32 => return do:
  let output: ResizeArray F32 = #[]
  let requests = persist.requests ()
  let next = #[1]
  let outbox: ResizeArray services.Request = #[]
  let waiting: ResizeArray services.Request = #[]
  let filling: ResizeArray services.Filling = #[]
  let answers: ResizeArray services.Answer = #[]
  let statuses: ResizeArray U32 = #[]
  let payload: ResizeArray F32 = #[]
  let state = services.access next outbox waiting filling answers statuses payload
  with_access (func (access: Access) => return consume access state requests output)
  return array.generate output.length (func (index: U32) : F32 => return output[index])
func encode (schema: U32) -> (kept: preferences.Preferences) -> (buses: Bool) -> (access: Access) -> (state: services.Services) -> (requests: Array U32) -> (output: ResizeArray F32) : Unit => return do:
  let audio: sound.Audio = $sound.Audio {sounds: &access.audio.sounds[0..access.audio.sounds.length],
    voices: &access.audio.voices[0..access.audio.voices.length],
    buses: &access.audio.buses[0..if buses then access.audio.buses.length else 0]}
  host.encode_frame schema requests audio kept (&access.ui_nodes[0..access.ui_nodes.length]) (render.finish access.frame)
    (&access.service_output[0..access.service_output.length]) state access.encoder_text output
