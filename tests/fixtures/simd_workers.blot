import * as array from "std/array"
import * as session from "ink/pen/worker_session"
import * as schedule from "ink/schedule"
import * as points from "ink/spatial/points"
import * as math from "ink/math"
const prepare = func (context: Array F32) => return points.build (array.generate (context.length / 2) (func i => return math.vec3 context[i*2] 0.0 context[i*2+1]))
const solve = func (context: points.Index) -> (queries: Array F32) => return array.generate (queries.length / 2) (func i => return U32.to_f32 (Maybe.unwrap_or 0 (points.nearest context (math.vec3 queries[i*2] 0.0 queries[i*2+1]))))
entry const service = session.serve prepare solve
entry const client = func (host: Array F32 -> Array F32 ! { Foreign }) => return do:
  use session.configure host 0xFFFFFFFF #[0.0, 0.0, 2.0, 2.0]
  let plan = $schedule.Plan {dependencies: #[#[], #[], #[0, 1]], waves: #[#[1, 0], #[2]]}
  use result <- schedule.execute_with plan #[] (func state -> wave => return session.run host (array.map (func i => return #[U32.to_f32 i, U32.to_f32 i]) wave))
    (func state -> index -> delta => return array.concat state delta)
  use session.reset host
  return Maybe.unwrap_or #[] result
entry const invalid_plan = func (host: Array F32 -> Array F32 ! { Foreign }) => return do:
  let plan = $schedule.Plan {dependencies: #[#[], #[0]], waves: #[#[0, 1]]}
  use result <- schedule.execute_with plan #[] (func state -> wave => return session.run host #[#[0.0]]) (func state -> index -> delta => return array.concat state delta)
  return Maybe.is_some result
entry const wrong_result_count = func () => return do:
  let result = schedule.execute_with ($schedule.Plan {dependencies: #[#[]], waves: #[#[0]]}) 0 (func state -> wave => return #[]) (func state -> index -> delta => return state + delta)
  return Maybe.unwrap_or 0 result
entry const prepared_wrong_result_count = func () => return do:
  let $Some prepared = schedule.prepare ($schedule.Plan {dependencies: #[#[]], waves: #[#[0]]}) else:
    return @panic "valid plan rejected"
  return schedule.execute_prepared_with prepared 0 (func state -> wave => return #[]) (func state -> index -> delta => return state + delta)
