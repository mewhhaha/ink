import * as array from "std/array"
import * as schedule from "ink/schedule"
import * as graph from "ink/graph"
import * as points from "ink/spatial/points"
import * as math from "ink/math"

type PointContext = { storage: points.Storage, stored: points.Stored }

func prepare_points (payload: #[F32]): PointContext =>
  if payload.length % 2 != 0:
    return panic "point context needs coordinate pairs"
  let bounds: #[~F32] = #[]
  let order: #[~U32] = #[]
  let leaves: #[~U32] = #[]
  let storage = $points.Storage { bounds, order, leaves }
  let positions = array.generate (payload.length / 2) (func i => math.vec3 payload[i * 2] 0.0 payload[i * 2 + 1])
  let stored = points.build_into storage positions
  return { storage, stored }

func solve_point (ctx: PointContext) -> (query: #[2; F32]): U32 =>
  let index = points.read ctx.storage ctx.stored
  return Maybe.unwrap_or 0 (points.nearest index (math.vec3 query[0] 0.0 query[1]))

entry kernel nearest_points: Kernel [#[F32], #[2; F32], U32] = { prepare: prepare_points, run: solve_point }

entry func client (host: #[F32] -> #[F32] ! { Foreign }): #[F32] ! { Foreign } =>
  let dependency_starts = #[0, 0, 0, 2]
  let dependency_targets = #[0, 1]
  let wave_starts = #[0, 2, 3]
  let wave_nodes = #[0, 1, 2]
  let plan = $schedule.Plan {
    dependencies: $graph.Graph { starts: &dependency_starts[0..4], targets: &dependency_targets[0..2] },
    waves: $graph.Waves { starts: &wave_starts[0..3], nodes: &wave_nodes[0..3] } }
  let state: #[~F32] = #[]
  let batch: #[~F32] = #[]
  use ran <- schedule.execute plan state
    (func (state: #[~F32]) -> (wave: &[U32]): #[F32] ! { Foreign } =>
      @storage.truncate batch 0
      for i in 0 .. wave.length:
        let index: U32 = wave.at i
        @storage.push batch (U32.to_f32 index)
        @storage.push batch (U32.to_f32 index)
      use reply <- host (seal (copy batch))
      if reply.length != wave.length:
        return panic "point worker returned wrong width"
      return reply)
    (func (state: #[~F32]) -> (index: U32) -> (delta: F32): Unit => @storage.push state delta)
  return if ran then seal state else #[]

entry func invalid_plan (host: #[F32] -> #[F32] ! { Foreign }): Bool ! { Foreign } =>
  let dependency_starts = #[0, 0, 1]
  let dependency_targets = #[0]
  let wave_starts = #[0, 2]
  let wave_nodes = #[0, 1]
  let plan = $schedule.Plan {
    dependencies: $graph.Graph { starts: &dependency_starts[0..3], targets: &dependency_targets[0..1] },
    waves: $graph.Waves { starts: &wave_starts[0..2], nodes: &wave_nodes[0..2] } }
  let state: #[U32] = #[0]
  return schedule.execute plan state
    (func state -> wave: #[U32] ! { Foreign } =>
      use ignored <- host #[0.0]
      return array.fill wave.length 0)
    (func state -> index -> delta =>
      state[0] = state[0] + delta
      return ())

func with_single consume =>
  let dependency_starts = #[0, 0]
  let dependency_targets: #[U32] = #[]
  let wave_starts = #[0, 1]
  let wave_nodes = #[0]
  return consume ($schedule.Plan {
    dependencies: $graph.Graph { starts: &dependency_starts[0..2], targets: &dependency_targets[0..0] },
    waves: $graph.Waves { starts: &wave_starts[0..2], nodes: &wave_nodes[0..1] } })

entry func wrong_result_count () => with_single (func plan =>
  let state = #[0]
  let ran = schedule.execute plan state (func state -> wave: #[U32] => #[])
    (func state -> index -> delta =>
      state[0] = state[0] + delta
      return ())
  return state[0])

entry func prepared_wrong_result_count () => with_single (func plan =>
  let $Some prepared = schedule.prepare plan else:
    return panic "valid plan rejected"
  let state = #[0]
  schedule.execute_prepared prepared state (func state -> wave: #[U32] => #[])
    (func state -> index -> delta =>
      state[0] = state[0] + delta
      return ())
  return state[0])
