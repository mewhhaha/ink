import * as array from "std/array"
import * as schedule from "ink/schedule"
import * as graph from "ink/graph"
import * as points from "ink/spatial/points"
import * as math from "ink/math"

type PointContext = { storage: points.Storage, stored: points.Stored }

func prepare_points (payload: #[F32]): PointContext =>
  if payload.length % 2 != 0:
    return panic "point context needs coordinate pairs"
  let bounds: #[F32] = #[]
  let order: #[U32] = #[]
  let leaves: #[U32] = #[]
  let storage = $points.Storage { bounds, order, leaves }
  let positions = array.generate (payload.length / 2) (func i => math.vec3 payload[i * 2] 0.0 payload[i * 2 + 1])
  let (stored, storage) = points.build_into storage positions
  return { storage, stored }

func solve_point (ctx: PointContext) -> (query: #[2; F32]): U32 =>
  let index = points.read ctx.storage ctx.stored
  return Maybe.unwrap_or 0 (points.nearest index (math.vec3 query[0] 0.0 query[1]))

#kernel const nearest_points: Kernel [#[F32], #[2; F32], U32] = { prepare: prepare_points, run: solve_point }

io client (host: #[F32] -> #[F32] ! { Foreign }): #[F32] ! { Foreign } =>
  let dependency_starts = #[0, 0, 0, 2]
  let dependency_targets = #[0, 1]
  let wave_starts = #[0, 2, 3]
  let wave_nodes = #[0, 1, 2]
  let plan = $schedule.Plan {
    dependency_starts, dependency_targets,
    waves: $graph.Waves { starts: wave_starts, nodes: wave_nodes } }
  let state: #[F32] = #[]
  use result <- schedule.execute plan state
    (func (state: #[F32]) -> (wave: &[U32]): #[F32] ! { Foreign } =>
      let batch: #[F32] = #[]
      for i in 0 .. wave.length:
        let index: U32 = wave.at i
        @storage.push batch (U32.to_f32 index)
        @storage.push batch (U32.to_f32 index)
      use reply <- host batch
      if reply.length != wave.length:
        return panic "point worker returned wrong width"
      return reply)
    (func (state: own #[F32]) -> (index: U32) -> (delta: F32): #[F32] =>
      @storage.push state delta
      return state)
  let (ran, state) = result
  return if ran then state else #[]

io invalid_plan (host: #[F32] -> #[F32] ! { Foreign }): Bool ! { Foreign } =>
  let dependency_starts = #[0, 0, 1]
  let dependency_targets = #[0]
  let wave_starts = #[0, 2]
  let wave_nodes = #[0, 1]
  let plan = $schedule.Plan {
    dependency_starts, dependency_targets,
    waves: $graph.Waves { starts: wave_starts, nodes: wave_nodes } }
  let state: #[U32] = #[0]
  use result <- schedule.execute plan state
    (func state -> wave: #[U32] ! { Foreign } =>
      use ignored <- host #[0.0]
      return array.fill wave.length 0)
    (func (own state) -> index -> delta =>
      state[0] := state[0] + delta
      return state)
  let (ran, _) = result
  return ran

func with_single consume =>
  let dependency_starts = #[0, 0]
  let dependency_targets: #[U32] = #[]
  let wave_starts = #[0, 1]
  let wave_nodes = #[0]
  return consume ($schedule.Plan {
    dependency_starts, dependency_targets,
    waves: $graph.Waves { starts: wave_starts, nodes: wave_nodes } })

io wrong_result_count () => with_single (func plan =>
  let state = #[0]
  let (_, state) = schedule.execute plan state (func state -> wave: #[U32] => #[])
    (func (own state) -> index -> delta =>
      state[0] := state[0] + delta
      return state)
  return state[0])

io prepared_wrong_result_count () => with_single (func plan =>
  let $Some prepared = schedule.prepare plan else:
    return panic "valid plan rejected"
  let state = #[0]
  state := schedule.execute_prepared prepared state (func state -> wave: #[U32] => #[])
    (func (own state) -> index -> delta =>
      state[0] := state[0] + delta
      return state)
  return state[0])
