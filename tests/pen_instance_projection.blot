import * as host from "ink/pen/host"
import * as math from "ink/math"
import * as render from "ink/render"
import * as protocol from "pen/protocol_render"

const encode = func (id: U32) -> (order: U32) -> (extra: &[math.Vec4]): Array F32 => return do:
  let parameters: Maybe math.Vec4 = if @u32.eq (@u32.bit_and id 1) 0 then $Nothing else $Some (math.vec4 (-0.0) 2.0 (-3.0) 4.0)
  let draw: render.Draw = $render.Draw {mesh: 7, material: 9, matrix: math.Mat4.identity, parameters, extra}
  let rows: Array render.Instance = #[$render.Instance {id, order, draw}]
  return protocol.encode_instance (host.project_instance () rows[0])

entry const packet = func (id: U32): Array F32 => return do:
  let vectors: ResizeArray math.Vec4 = #[]
  @storage.push vectors (math.vec4 1.0 2.0 3.0 4.0)
  let order = if @u32.eq (@u32.bit_and id 2) 0 then 0 else 16777215
  return encode id order (&vectors[0..0])

entry const checked_order = func (order: U32): Array F32 => return do:
  let vectors: ResizeArray math.Vec4 = #[]
  @storage.push vectors (math.vec4 1.0 2.0 3.0 4.0)
  return encode 4294967295 order (&vectors[0..0])

entry const checked_extra = func (count: U32): Array F32 => return do:
  let vectors: ResizeArray math.Vec4 = #[]
  @storage.push vectors (math.vec4 1.0 2.0 3.0 4.0)
  return encode 4294967295 0 (&vectors[0..count])
