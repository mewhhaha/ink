import * as test from "std/test"
import * as graph from "ink/graph"
import * as array from "std/array"
func words view : #[U32] => array.generate view.length (func i => view.at i)
@[test.suite]
test "adjacency reverse and reachability":
  let starts: #[U32] = #[]
  let targets: #[U32] = #[]
  let (built, starts, targets) = graph.from_edges 4 #[0, 0, 1, 2] #[1, 2, 3, 3] starts targets
  if not built:
    use test.eq "check 1" #[1] #[0]
    return ()
  let adjacency = graph.borrow starts targets
  let reverse_starts: #[U32] = #[]
  let reverse_targets: #[U32] = #[]
  let (reverse_starts, reverse_targets) = graph.reverse adjacency reverse_starts reverse_targets
  let reversed = graph.borrow reverse_starts reverse_targets
  let reached = graph.reachable adjacency #[0] #[true, false, true, true]
  let saved_starts: #[U32] = #[0, 1]
  let saved_targets: #[U32] = #[0]
  let (accepted, saved_starts, saved_targets) = graph.from_edges 1 #[0] #[1] saved_starts saved_targets
  let preserved = graph.borrow saved_starts saved_targets
  use test.eq "check 1" #[0, 2, 3, 4, 4] (words adjacency.starts)
  use test.eq "check 2" #[0, 0, 1, 2, 4] (words reversed.starts)
  use test.eq "check 3" #[0, 0, 1, 2] (words reversed.targets)
  use test.eq "check 4" #[1, 0, 1, 1] (array.map (func value => if value then 1 else 0) reached)
  use test.holds "check 5" (not accepted)
  use test.eq "check 6" #[0, 1] (words preserved.starts)
  use test.eq "check 7" #[0] (words preserved.targets)
  return ()
@[test.suite]
test "stable waves and cycle":
  let starts: #[U32] = #[]
  let targets: #[U32] = #[]
  let (built, starts, targets) = graph.from_edges 4 #[1, 2, 3, 3] #[0, 0, 1, 2] starts targets
  if not built:
    use test.eq "check 1" #[1] #[0]
    return ()
  let dependencies = graph.borrow starts targets
  let wave_starts: #[U32] = #[]
  let wave_nodes: #[U32] = #[]
  let $Some waves = graph.waves 2 dependencies wave_starts wave_nodes else:
    use test.eq "check 1" #[1] #[0]
    return ()
  let cycle_starts: #[U32] = #[]
  let cycle_targets: #[U32] = #[]
  let (built, cycle_starts, cycle_targets) = graph.from_edges 2 #[0, 1] #[1, 0] cycle_starts cycle_targets
  if not built:
    use test.eq "check 1" #[1] #[0]
    return ()
  let cycle = graph.borrow cycle_starts cycle_targets
  let rejected_starts: #[U32] = #[]
  let rejected_nodes: #[U32] = #[]
  let rejected = if Maybe.is_some (graph.waves 2 cycle rejected_starts rejected_nodes) then 0 else 1
  use test.eq "check 1" #[0, 1, 3, 4] (words waves.starts)
  use test.eq "check 2" #[0, 1, 2, 3] (words waves.nodes)
  use test.eq "check 3" #[1] #[rejected]
  return ()
