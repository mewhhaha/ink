import * as check from "./check"
import * as graph from "ink/graph"
import * as array from "std/array"
const words = func view => return array.generate view.length (func i => return view[i])
entry const test_adjacency_reverse_and_reachability = func () => return do:
  let starts: ResizeArray U32 = #[]
  let targets: ResizeArray U32 = #[]
  let $Some adjacency = graph.from_edges 4 #[0, 0, 1, 2] #[1, 2, 3, 3] starts targets else:
    return check.report #[check.words #[1] #[0]]
  let reverse_starts: ResizeArray U32 = #[]
  let reverse_targets: ResizeArray U32 = #[]
  let reversed = graph.reverse adjacency reverse_starts reverse_targets
  let reached = graph.reachable adjacency #[0] #[true, false, true, true]
  return check.report #[check.words #[0, 2, 3, 4, 4] (words adjacency.starts),
    check.words #[0, 0, 1, 2, 4] (words reversed.starts),
    check.words #[0, 0, 1, 2] (words reversed.targets),
    check.words #[1, 0, 1, 1] (array.map (func value => return if value then 1 else 0) reached)]
entry const test_stable_waves_and_cycle = func () => return do:
  let starts: ResizeArray U32 = #[]
  let targets: ResizeArray U32 = #[]
  let $Some dependencies = graph.from_edges 4 #[1, 2, 3, 3] #[0, 0, 1, 2] starts targets else:
    return check.report #[check.words #[1] #[0]]
  let wave_starts: ResizeArray U32 = #[]
  let wave_nodes: ResizeArray U32 = #[]
  let $Some waves = graph.waves 2 dependencies wave_starts wave_nodes else:
    return check.report #[check.words #[1] #[0]]
  let cycle_starts: ResizeArray U32 = #[]
  let cycle_targets: ResizeArray U32 = #[]
  let $Some cycle = graph.from_edges 2 #[0, 1] #[1, 0] cycle_starts cycle_targets else:
    return check.report #[check.words #[1] #[0]]
  let rejected_starts: ResizeArray U32 = #[]
  let rejected_nodes: ResizeArray U32 = #[]
  let rejected = if Maybe.is_some (graph.waves 2 cycle rejected_starts rejected_nodes) then 0 else 1
  return check.report #[check.words #[0, 1, 3, 4] (words waves.starts),
    check.words #[0, 1, 2, 3] (words waves.nodes), check.words #[1] #[rejected]]
