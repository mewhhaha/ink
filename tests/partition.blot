import * as array from "std/array"
import * as check from "./check"
import * as partition from "ink/partition"
entry const range = fn (values: Array U32) => case partition.at values[0] values[1] values[2] of
  #Nothing => #[]
  #Some range => #[range.start, range.count]

entry const test_partitions_cover_once_and_balance = fn () => do:
  let checks = #[]
  for count in #[0,1,3,4,5,31,32,33,4294967295]:
    for parts in #[1,2,4,16]:
      let cursor = 0
      let smallest = 4294967295
      let largest = 0
      for index in 0 .. parts:
        let out = range #[count,parts,index]
        checks := array.push (check.words #[cursor] #[out[0]]) self
        cursor := self + out[1]
        smallest := min self out[1]
        largest := max self out[1]
      checks := array.concat self #[check.words #[count] #[cursor],check.holds (largest - smallest <= 1)]
  for input in #[#[5,0,0],#[5,4,4],#[5,4,4294967295]]:
    checks := array.push (check.words #[] (range input)) self
  return check.report checks
