import * as check from "./check"
import * as partition from "ink/partition"
entry func range (values: #[U32]) => case partition.at values[0] values[1] values[2] of
  $Nothing => #[]
  $Some range => #[range.start, range.count]

entry func test_partitions_cover_once_and_balance () =>
  let checks: #[check.Check] = #[]
  for count in #[0,1,3,4,5,31,32,33,4294967295]:
    for parts in #[1,2,4,16]:
      let cursor = 0
      let smallest = 4294967295
      let largest = 0
      for index in 0 .. parts:
        let out = range #[count,parts,index]
        @storage.push checks (check.words #[cursor] #[out[0]])
        cursor := self + out[1]
        smallest := min self out[1]
        largest := max self out[1]
      @storage.push checks (check.words #[count] #[cursor])
      @storage.push checks (check.holds (largest - smallest <= 1))
  for (count, parts, index) in #[(5,0,0),(5,4,4),(5,4,4294967295)]:
    let input = #[count, parts, index]
    @storage.push checks (check.words #[] (range input))
  return check.report checks
