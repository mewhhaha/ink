import * as check from "./check"
import * as array from "std/array"
import * as ecs from "ink/ecs"
type Position is data = $Position U32
type Velocity is data = $Velocity U32
type Total is data = $Total U32
#entry func workload (history: U32) =>
  let alive:ecs.Entities=ecs.entities ()
  let alive_meta=ecs.metadata 1
  for id in 0 .. history:
    @storage.push alive (id>=history-64)
  let positions:ecs.Pool Position=ecs.pool ()
  let positions_meta=ecs.metadata 1
  let velocities:ecs.Pool Velocity=ecs.pool ()
  let velocities_meta=ecs.metadata 1
  let previous:ecs.Pool Position=ecs.pool ()
  for index in 0 .. 64:
    let id=history-64+index
    let p_was=ecs.contains positions id
    positions := ecs.put_row alive self id ($Position index)
    positions_meta := ecs.bump_insert p_was self
    let v_was=ecs.contains velocities id
    velocities := ecs.put_row alive self id ($Velocity (index+1))
    velocities_meta := ecs.bump_insert v_was self
  previous := ecs.checkpoint identity self positions
  let old:ecs.Pool Position=ecs.copy_into identity (ecs.pool ()) positions
  let (velocities, velocities_meta) = ecs.remove velocities velocities_meta (history-32)
  let (positions, positions_meta) = ecs.remove positions positions_meta (history-1)
  let (velocities, velocities_meta) = ecs.remove velocities velocities_meta (history-1)
  let (alive, alive_meta) = ecs.despawn alive alive_meta (history-1)
  let total=0
  for 0 .. 32:
    for id in ecs.indices alive positions:
      if let $Some ($Velocity v)=ecs.read velocities id:
        let $Some ($Position p)=ecs.read positions id else:
          panic "position membership changed"
        total := total+p+v
  let (velocities, velocities_meta) = ecs.insert alive velocities velocities_meta (history-32) ($Velocity 100)
  for id in ecs.indices alive positions:
    if let $Some ($Velocity v)=ecs.read velocities id:
      let $Some ($Position p)=ecs.read positions id else:
        panic "position membership changed"
      positions := ecs.write_row self id ($Position (p+v))
      positions_meta := ecs.bump_payload self
      velocities := ecs.write_row self id ($Velocity v)
      velocities_meta := ecs.bump_payload self
  let $Some ($Position before)=ecs.read old (history-32) else:
    return #[0]
  let $Some ($Position after)=ecs.read positions (history-32) else:
    return #[0]
  return #[total,before,after,if Maybe.is_some (ecs.read positions (history-1)) then 1 else 0]

#entry func test_sparse_history () => check.report #[
  check.words #[32 * (4096 - 65 - 127), 32, 132, 0] (workload count)
  | count <- #[64, 513, 4096, 65536]
]
