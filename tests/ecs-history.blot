import * as array from "std/array"
import * as ecs from "ink/ecs"
type Position is data = #Position U32
type Velocity is data = #Velocity U32
type Total is data = #Total U32
const simulation = do:
  let builder = ecs.new ()
  builder := ecs.register_snapshotted_component (#Position 0) self
  builder := ecs.register_component (#Velocity 0) self
  builder := ecs.insert_resource (#Total 0) self
  break ecs.build builder
entry const workload = fn (history: U32) => do:
  let (_, result) = ecs.create simulation (fn () => do:
    use ecs.replace_entities (array.generate history (fn i => i >= history - 64))
    use ecs.insert_many #Position (history - 64) (array.generate 64 (fn i => #Position i))
    use ecs.insert_many #Velocity (history - 64) (array.generate 64 (fn i => #Velocity (i + 1)))
    use ecs.checkpoint simulation
    use old <- ecs.view #Position
    use ecs.at (history - 32) (fn () => ecs.remove #Velocity)
    use ecs.despawn (history - 1)
    for 0 .. 32:
      use ecs.query_pair #Position #Velocity (fn p => fn v => do:
        let #Position p = p
        let #Velocity v = v
        use total <- ecs.get #Total
        let #Total total = total
        return ecs.set (#Total (total + p + v)))
    use ecs.at (history - 32) (fn () => ecs.set (#Velocity 100))
    use ecs.update_pair #Position #Velocity (fn p => fn v => do:
      let #Position p = p
      let #Velocity v = v
      return (#Position (p + v), #Velocity v))
    use now <- ecs.view #Position
    use total <- ecs.get #Total
    let #Total total = total
    let #Some (#Position before) = ecs.read old (history - 32) else:
      return #[0]
    let #Some (#Position after) = ecs.read now (history - 32) else:
      return #[0]
    return #[total, before, after, if Maybe.is_some (ecs.read now (history - 1)) then 1 else 0])
  return result
