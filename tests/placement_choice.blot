import * as placement from "ink/placement"
// The guest ABI accepts one numeric argument. Two exact 16-bit lanes carry
// the seed without ever converting the complete U32 through F32.
entry func choose (input: #[F32]) : #[U32] =>
  let seed = F32.to_u32 input[0] | (F32.to_u32 input[1] << 16)
  let weights = @array.generate (input.length - 2) (func (i: U32) => input[i + 2])
  return case placement.choose weights seed of
    $Nothing => #[]
    $Some choice => #[choice.index,choice.seed]
entry func distribution (seed: U32) : #[U32] =>
  let state = seed
  let counts = @array.fill 4 0
  for iteration in 0..10000:
    let choice = case placement.choose #[0.0,1.0,2.0,7.0] state of
      $Nothing => $placement.Choice { index: 0,seed: state }
      $Some value => value
    let index = choice.index
    counts[index] := self + 1
    state := choice.seed
  return #[counts[0],counts[1],counts[2],counts[3],state]
