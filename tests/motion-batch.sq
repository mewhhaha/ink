import * as test from "std/test"
import * as bits from "./support/bits"
import * as array from "std/array"
import * as motion from "ink/motion"

func scalar_step acceleration -> dt -> (positions: #[F32]) -> (velocities: #[F32]) -> (p: own #[F32]) -> (v: own #[F32]) : (#[F32], #[F32]) =>
  if positions.length != velocities.length or p.length != positions.length or v.length != positions.length:
    panic "motion columns must have equal lengths"
  for i in 0 .. positions.length:
    let next = velocities[i] + acceleration * dt
    p[i] := positions[i] + next * dt
    v[i] := next
  return (p, v)
func workload (step: F32 -> F32 -> #[F32] -> #[F32] -> own #[F32] -> own #[F32] -> (#[F32], #[F32])) -> count =>
  let before_p = array.generate count (func i => (U32.to_f32 (i % 37) - 18.0) * 0.125)
  let before_v = array.generate count (func i => (U32.to_f32 (i % 19) - 9.0) * 0.25)
  let p = copy before_p
  let v = copy before_v
  let next_p = array.fill count 0.0
  let next_v = array.fill count 0.0
  for 0 .. 32:
    let (updated_p, updated_v) = step (-9.81) 0.016 p v next_p next_v
    next_p := updated_p
    next_v := updated_v
    for index in 0 .. count:
      p[index] := next_p[index]
      v[index] := next_v[index]
  let output: #[F32] = #[]
  output := array.extend self p
  output := array.extend self v
  output := array.extend self before_p
  output := array.extend self before_v
  return output
io original (count:U32) => workload scalar_step count
io vector (count:U32) => workload motion.integrate_columns_into count

io varied (input: #[F32]) =>
  let count = (input.length-2)/2
  let p = array.slice 2 count input
  let v = array.slice (2+count) count input
  let next_p = array.fill count 0.0
  let next_v = array.fill count 0.0
  let (next_p, next_v) = motion.integrate_columns_into input[0] input[1] p v next_p next_v
  let expected = array.generate count (func i => motion.integrate input[0] input[1] p[i] v[i])
  let p_check = array.map (func pair =>
    let (a,b)=pair
    return a) expected
  let v_check = array.map (func pair =>
    let (a,b)=pair
    return b) expected
  let output: #[F32] = #[]
  output := array.extend self next_p
  output := array.extend self next_v
  output := array.extend self p_check
  output := array.extend self v_check
  output := array.extend self p
  output := array.extend self v
  return output
io lanes (input: #[F32]) =>
  let ((a,b,c,d),(e,f,g,h)) = motion.integrate4 input[0] input[1]
    (input[2],input[3],input[4],input[5]) (input[6],input[7],input[8],input[9])
  return #[a,b,c,d,e,f,g,h]
io mismatched (n: U32) =>
  let positions = array.fill n 1.0
  let p = array.fill n 0.0
  let v = array.fill n 0.0
  let (p, v) = motion.integrate_columns_into 1.0 0.5 positions #[] p v
  return array.concat p v

@[test.suite]
test "scalar vector motion bits":
  for count in #[0, 1, 3, 4, 5, 7, 8, 31, 32, 33, 256, 2048]:
    let exp = original count
    let act = vector count
    use bits.bits_array "scalar vs vector motion" exp act
  return ()

@[test.suite]
test "motion extreme rounding and snapshots":
  let values = #[0.0, -0.0, 1.0, -1.0, 1e-30, -1e-30, 1e20, -1e20, 0.125]
  for count in #[0, 1, 3, 4, 5, 8, 9]:
    for acceleration in #[-9.81, 0.0, -0.0, 1e-15]:
      for dt in #[0.0, -0.0, 0.016, -0.5]:
        let p = array.generate count (func i => values[i])
        let v = array.generate count (func i => values[count - i - 1])
        let input = array.concat #[acceleration, dt] (array.concat p v)
        let velocities = array.map (func value => value + acceleration * dt) v
        let positions = array.generate count (func i => p[i] + velocities[i] * dt)
        let updated = array.concat positions velocities
        let expected = array.concat updated (array.concat updated (array.concat p v))
        let act_varied = varied input
        use bits.bits_array "varied columns" expected act_varied
        if count == 4:
          let exp_lanes = array.slice 0 8 expected
          let act_lanes = lanes input
          use bits.bits_array "4-lane SIMD" exp_lanes act_lanes
  return ()

test expect_trap "mismatched motion columns":
  let _ = mismatched 1
  return ()
