import * as array from "std/array"
import * as check from "./check"
import * as math from "ink/math"
import * as render from "ink/render"
import * as cache from "ink/render/cache"
import * as changes from "ink/changes"
import * as transform from "ink/transform"
func pose (x: F32) => return transform.from_xyz x 0.0 0.0
func look (id: U32) => return $render.Appearance {mesh: id, material: 1}
func summary (cached: cache.Cache) => return do:
  let out: ResizeArray F32 = #[]
  for row in cached:
    if let $Some draw = row:
      @storage.push out (from draw.mesh)
      @storage.push out draw.matrix.wx
      @storage.push out (from draw.material)
  return @storage.freeze out
entry func edits () => return do:
  let current: ResizeArray (Maybe transform.Pose3) = #[]
  let previous: ResizeArray (Maybe transform.Pose3) = #[]
  let appearances: ResizeArray (Maybe render.Appearance) = #[]
  for i in 0 .. 70:
    @storage.push current ($Some (pose (from i)))
    @storage.push previous ($Some (pose (from i)))
    @storage.push appearances ($Some (look i))
  let cached = cache.empty ()
  let payload: ResizeArray math.Vec4 = #[]
  let saved = cache.empty ()
  let saved_payload: ResizeArray math.Vec4 = #[]
  cache.update (&current[0..current.length]) (&previous[0..previous.length]) (&appearances[0..appearances.length]) 0.5 #[] cached payload
  cache.copy_into saved saved_payload cached payload
  appearances[0] = $Some $render.Appearance {mesh: 700, material: 9}
  current[32] = $Some (pose 132.0)
  appearances[69] = $Nothing
  current[2] = $Nothing
  @storage.push current ($Some (pose 999.0))
  @storage.push previous $Nothing
  @storage.push appearances ($Some (look 70))
  cache.update (&current[0..current.length]) (&previous[0..previous.length]) (&appearances[0..appearances.length]) 0.5 #[32, 0, 69, 2, 32, 999] cached payload
  let after = summary cached
  cache.update (&current[0..current.length]) (&previous[0..previous.length]) (&appearances[0..appearances.length]) 0.5 #[] cached payload
  @storage.truncate current 33
  @storage.truncate previous 33
  @storage.truncate appearances 33
  cache.update (&current[0..current.length]) (&previous[0..previous.length]) (&appearances[0..appearances.length]) 0.5 #[] cached payload
  return array.concat (summary saved) (array.concat after (summary cached))
func batch (retained: Bool) -> (divisor: U32) -> (count: U32) => return do:
  let changing = if divisor == 0 then 0 else count / divisor
  let current: ResizeArray (Maybe transform.Pose3) = #[]
  let previous: ResizeArray (Maybe transform.Pose3) = #[]
  let appearances: ResizeArray (Maybe render.Appearance) = #[]
  for i in 0 .. count:
    @storage.push current ($Some (pose (U32.to_f32 i + (if i < changing then 2.0 else 0.0))))
    @storage.push previous ($Some (pose (from i)))
    @storage.push appearances ($Some (look i))
  let cached = cache.empty ()
  let payload: ResizeArray math.Vec4 = #[]
  let output: ResizeArray render.Draw = #[]
  let dirty = array.generate changing identity
  cache.update (&current[0..count]) (&previous[0..count]) (&appearances[0..count]) 0.0 #[] cached payload
  let first = case cache.read cached 0 of
    $Some draw => draw.matrix.wx
    $Nothing => -1.0
  let length = 0
  let sum = 0.0
  for frame in 0 .. 16:
    let alpha = U32.to_f32 frame / 15.0
    @storage.truncate output 0
    if retained:
      cache.update (&current[0..count]) (&previous[0..count]) (&appearances[0..count]) alpha dirty cached payload
      cache.collect cache.all cached payload output
    else:
      let draws = render.draw_views_using (func index => return render.draw) render.always_visible (&current[0..count]) (&previous[0..count]) (&appearances[0..count]) alpha
      for draw in draws:
        @storage.push output draw
    length := self + output.length
    for draw in output:
      sum := self + draw.matrix.wx
  return #[from length, sum, first]
entry func static_frames (count: U32) => return batch true 0 count
entry func sparse_frames (count: U32) => return batch true 100 count
entry func moving_frames (count: U32) => return batch true 1 count
entry func static_uncached (count: U32) => return batch false 0 count
entry func sparse_uncached (count: U32) => return batch false 100 count
entry func moving_uncached (count: U32) => return batch false 1 count
entry func explicit_changes () => return do:
  let current = array.generate 130 (func i => return $Some (pose (from i)))
  let previous = @storage.copy current
  let appearances = array.generate 130 (func i => return $Some (look i))
  let cached = cache.empty ()
  let payload: ResizeArray math.Vec4 = #[]
  let output: ResizeArray render.Draw = #[]
  cache.update (&current[0..130]) (&previous[0..130]) (&appearances[0..130]) 1.0 #[] cached payload
  cache.collect cache.all cached payload output
  let before = output.length
  let before_present = Maybe.is_some (cache.read cached 64)
  @storage.truncate output 0
  cache.update_changes (&current[0..130]) (&previous[0..130]) (&appearances[0..130]) 1.0 ($changes.Changes {reset: false, updated: #[64], removed: #[129, 64, 64]}) cached payload
  cache.collect cache.all cached payload output
  let removed = output.length
  let removed_present = Maybe.is_some (cache.read cached 64)
  @storage.truncate output 0
  cache.update_changes (&current[0..130]) (&previous[0..130]) (&appearances[0..130]) 1.0 (changes.borrow true #[] #[]) cached payload
  cache.collect cache.all cached payload output
  return #[before, removed, output.length, if before_present then 1 else 0, if removed_present then 1 else 0, if Maybe.is_some (cache.read cached 64) then 1 else 0]
entry func test_retained_edits_and_shrink () => return do:
  let expected: ResizeArray F32 = #[]
  for i in 0 .. 70:
    @storage.push expected (from i)
    @storage.push expected (from i)
    @storage.push expected 1.0
  let after: ResizeArray F32 = #[]
  for i in 0 .. 71:
    if i != 2 and i != 69:
      @storage.push after (if i == 0 then 700.0 else from i)
      @storage.push after (if i == 32 then 82.0 else if i == 70 then 999.0 else from i)
      @storage.push after (if i == 0 then 9.0 else 1.0)
  let copied = array.map identity after
  return check.report #[check.equal (array.concat (array.map identity expected) (array.concat copied (array.slice 0 96 copied))) (edits ())]
entry func test_retained_interpolation_witnesses () => return do:
  let checks: ResizeArray check.Check = #[]
  for divisor in #[0, 100, 1]:
    for count in #[128, 1024]:
      let changing = if divisor == 0 then 0 else count / divisor
      let sum = 0.0
      for frame in 0 .. 16:
        let alpha = U32.to_f32 frame / 15.0
        for i in 0 .. count:
          sum := self + (U32.to_f32 i + (if i < changing then 2.0 * alpha else 0.0))
      @storage.push checks (check.equal #[from (16 * count), sum, 0.0] (batch true divisor count))
  return check.report (array.map identity checks)
entry func test_retained_removal_and_reset () => return check.report #[check.words #[130, 128, 130, 1, 0, 1] (explicit_changes ())]
