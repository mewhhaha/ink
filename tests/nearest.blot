import * as check from "./check"
import * as array from "std/array"
import * as points from "ink/spatial/points"
import { Vec3 } from "std/vector"

const positions = func count => return array.generate count (func i => return $Vec3 {
  x: from ((i * 47) % 127) * 0.125 - 8.0, y: 0.0,
  z: from ((i * 29) % 131) * 0.25 - 16.0 })
const reference = func (values: Array Vec3) -> at => return do:
  let best = 4294967295
  let closest = 1.0 / 0.0
  for id in 0 .. values.length:
    if id % 7 != 2:
      let dx = values[id].x - at.x
      let dz = values[id].z - at.z
      let apart = dx * dx + dz * dz
      if apart < closest or (apart == closest and id < best):
        best := id
        closest := apart
  return best
const indexed = func values -> at => return Maybe.unwrap_or 4294967295
  (points.nearest_where (func id => return id % 7 != 2) (points.build values) at)
const queries = func find -> count => return do:
  let values = positions count
  return array.generate 100 (func i => return find values ($Vec3 {
    x: from (i * 11 % 37) - 18.0, y: 600.0, z: from (i * 17 % 41) - 20.0 }))
entry const expected = queries reference
entry const actual = queries indexed
// Build once, then reuse the index for the complete query batch.
entry const batched = func count => return do:
  let index = points.build (positions count)
  return array.generate 100 (func i => return Maybe.unwrap_or 4294967295
    (points.nearest_where (func id => return id % 7 != 2) index ($Vec3 {
      x: from (i * 11 % 37) - 18.0, y: 600.0, z: from (i * 17 % 41) - 20.0 })))
entry const ties = func () => return do:
  let values = #[$Vec3 { x: -1.0, y: 0.0, z: 0.0 }, $Vec3 { x: 1.0, y: 9.0, z: 0.0 }]
  let index = points.build values
  let at = $Vec3 { x: 0.0, y: 0.0, z: 0.0 }
  return #[Maybe.unwrap_or 9 (points.nearest index at),
    Maybe.unwrap_or 9 (points.nearest_where (func id => return id == 1) index at),
    Maybe.unwrap_or 9 (points.nearest_where (func id => return false) index at)]

entry const test_index_matches_exhaustive_search = func () => return check.report (array.concat
  #[check.words (expected count) (actual count) | count <- #[0,1,2,31,32,33,400,2000]]
  #[check.words #[0,1,9] (ties ())])
