import * as array from "std/array"
import * as points from "ink/spatial/points"
import { Vec3 } from "std/vector"

const positions = fn count => array.generate count (fn i => #Vec3 {
  x: from ((i * 47) % 127) * 0.125 - 8.0, y: 0.0,
  z: from ((i * 29) % 131) * 0.25 - 16.0 })
const reference = fn (values: Array Vec3) at => do:
  let best = 4294967295
  let closest = 1.0 / 0.0
  for id in 0 .. values.length:
    if id % 7 != 2:
      let dx = values[id].x - at.x
      let dz = values[id].z - at.z
      let apart = dx * dx + dz * dz
      if apart < closest || (apart == closest && id < best):
        best := id
        closest := apart
  return best
const indexed = fn values at => Maybe.unwrap_or 4294967295
  (points.nearest_where (fn id => id % 7 != 2) (points.build values) at)
const queries = fn find count => do:
  let values = positions count
  return array.generate 100 (fn i => find values (#Vec3 {
    x: from (i * 11 % 37) - 18.0, y: 600.0, z: from (i * 17 % 41) - 20.0 }))
entry const expected = queries reference
entry const actual = queries indexed
// Build once, then reuse the index for the complete query batch.
entry const batched = fn count => do:
  let index = points.build (positions count)
  return array.generate 100 (fn i => Maybe.unwrap_or 4294967295
    (points.nearest_where (fn id => id % 7 != 2) index (#Vec3 {
      x: from (i * 11 % 37) - 18.0, y: 600.0, z: from (i * 17 % 41) - 20.0 })))
entry const ties = fn () => do:
  let values = #[#Vec3 { x: -1.0, y: 0.0, z: 0.0 }, #Vec3 { x: 1.0, y: 9.0, z: 0.0 }]
  let index = points.build values
  let at = #Vec3 { x: 0.0, y: 0.0, z: 0.0 }
  return #[Maybe.unwrap_or 9 (points.nearest index at),
    Maybe.unwrap_or 9 (points.nearest_where (fn id => id == 1) index at),
    Maybe.unwrap_or 9 (points.nearest_where (fn id => #False) index at)]
