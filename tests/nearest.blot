import * as check from "./check"
import * as array from "std/array"
import * as points from "ink/spatial/points"
import { Vec3 } from "std/vector"

func positions (count: U32) : #[Vec3] => array.generate count (func i => $Vec3 {
  x: U32.to_f32 ((i * 47) % 127) * 0.125 - 8.0, y: 0.0,
  z: U32.to_f32 ((i * 29) % 131) * 0.25 - 16.0 })
func reference (values: #[Vec3]) -> (at: Vec3) : U32 =>
  let best = 4294967295
  let closest = 1.0 / 0.0
  for id in 0 .. values.length:
    if id % 7 != 2:
      let dx = values[id].x - at.x
      let dz = values[id].z - at.z
      let apart = dx * dx + dz * dz
      if apart < closest or (apart == closest and id < best):
        best := id
        closest := apart
  return best
func indexed (values: #[Vec3]) -> (at: Vec3) : U32 => points.with_index values (func index => Maybe.unwrap_or 4294967295
  (points.nearest_where (func id => id % 7 != 2) index at))
func queries (find: #[Vec3] -> Vec3 -> U32) -> (count: U32) : #[U32] =>
  let values = positions count
  return array.generate 100 (func i => find values ($Vec3 {
    x: U32.to_f32 (i * 11 % 37) - 18.0, y: 600.0, z: U32.to_f32 (i * 17 % 41) - 20.0 }))
entry func expected (count: U32) : #[U32] => queries reference count
entry func actual (count: U32) : #[U32] => queries indexed count
// Build once, then reuse the index for the complete query batch.
entry func batched (count: U32) : #[U32] =>
  let values = positions count
  return points.with_index values (func index => array.generate 100 (func i => Maybe.unwrap_or 4294967295
    (points.nearest_where (func id => id % 7 != 2) index ($Vec3 {
      x: U32.to_f32 (i * 11 % 37) - 18.0, y: 600.0, z: U32.to_f32 (i * 17 % 41) - 20.0 }))))
entry func ties () =>
  let values = #[$Vec3 { x: -1.0, y: 0.0, z: 0.0 }, $Vec3 { x: 1.0, y: 9.0, z: 0.0 }]
  return points.with_index values (func index =>
    let at = $Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    return #[Maybe.unwrap_or 9 (points.nearest index at),
      Maybe.unwrap_or 9 (points.nearest_where (func id => id == 1) index at),
      Maybe.unwrap_or 9 (points.nearest_where (func id => false) index at)])

entry func test_index_matches_exhaustive_search () => check.report (array.concat
  #[check.words (expected count) (actual count) | count <- #[0,1,2,31,32,33,400,2000]]
  #[check.words #[0,1,9] (ties ())])
