import * as check from "./check"
import * as gizmos from "ink/gizmos"
import * as math from "ink/math"
import * as render from "ink/render"
import * as scene_editor from "ink/editor/scene"
import * as scene_graph from "ink/scene_graph"
import * as transform from "ink/transform"

entry func test_editor_scene () =>
  let root_pose = $transform.Pose3 { position: math.vec3 2.0 0.0 0.0, rotation: math.identity_quat, scale: math.one3 }
  let child_pose = $transform.Pose3 { position: math.vec3 0.0 3.0 0.0, rotation: math.identity_quat, scale: math.one3 }
  let nodes: #[scene_graph.Node] = #[
    scene_graph.root_node 10 root_pose 1 1,
    scene_graph.child_node 20 0 child_pose 2 2,
  ]
  let resolved = scene_graph.resolve (&nodes[0..nodes.length])

  // 0. Topology validation accepts valid DAG and rejects duplicate IDs / forward parent links.
  let valid_ok = scene_graph.valid_topology (&nodes[0..nodes.length])
  let bad_nodes: #[scene_graph.Node] = #[
    scene_graph.child_node 10 1 root_pose 1 1,
    scene_graph.root_node 20 child_pose 2 2,
  ]
  let invalid_order = not (scene_graph.valid_topology (&bad_nodes[0..bad_nodes.length]))
  let dup_nodes: #[scene_graph.Node] = #[
    scene_graph.root_node 10 root_pose 1 1,
    scene_graph.child_node 10 0 child_pose 2 2,
  ]
  let invalid_dup = case scene_graph.resolve_checked (&dup_nodes[0..dup_nodes.length]) of
    $Nothing => true
    $Some _ => false

  // 1. Hierarchical ray-box picking selects child at world (2, 3, 0) ahead of root.
  let pick_ray = $math.Ray { origin: math.vec3 2.0 3.0 10.0, direction: math.vec3 0.0 0.0 (-1.0) }
  let picked = case scene_editor.pick_node pick_ray (&resolved[0..resolved.length]) 0.5 of
    $Some id => id
    $Nothing => 0

  // 2. Gizmo axis picking + snapped translate drag along +X on root node.
  let st = scene_editor.new_state ()
  st.selected_id := 10
  st.snap := $scene_editor.Snap { enabled: true, translate: 0.5, rotate_rad: 0.5, scale: 0.25 }
  let axes = scene_editor.gizmo_axes scene_editor.space_world math.identity_quat
  let hit_x_ray = $math.Ray { origin: math.vec3 2.8 0.05 5.0, direction: math.vec3 0.0 0.0 (-1.0) }
  let picked_axis = scene_editor.pick_gizmo_axis hit_x_ray root_pose.position axes 1.5 0.2
  st := scene_editor.begin_drag self picked_axis hit_x_ray root_pose.position axes root_pose
  let drag_x_ray = $math.Ray { origin: math.vec3 4.05 0.05 5.0, direction: math.vec3 0.0 0.0 (-1.0) }
  let moved_pose = scene_editor.solve_drag st drag_x_ray axes transform.identity3

  // 3. Rotation and scale gizmo drags on root node.
  let rot_st = scene_editor.new_state ()
  rot_st.mode := scene_editor.mode_rotate
  let r_start = $math.Ray { origin: math.vec3 3.0 2.0 0.0, direction: math.vec3 0.0 (-1.0) 0.0 }
  let r_end = $math.Ray { origin: math.vec3 2.0 2.0 1.0, direction: math.vec3 0.0 (-1.0) 0.0 }
  rot_st := scene_editor.begin_drag self scene_editor.axis_y r_start root_pose.position axes root_pose
  let rotated_pose = scene_editor.solve_drag rot_st r_end axes transform.identity3

  let scale_st = scene_editor.new_state ()
  scale_st.mode := scene_editor.mode_scale
  scale_st := scene_editor.begin_drag self scene_editor.axis_y ($math.Ray { origin: math.vec3 2.0 0.5 5.0, direction: math.vec3 0.0 0.0 (-1.0) }) root_pose.position axes root_pose
  let scaled_pose = scene_editor.solve_drag scale_st ($math.Ray { origin: math.vec3 2.0 1.25 5.0, direction: math.vec3 0.0 0.0 (-1.0) }) axes transform.identity3

  // 4. Child under a 90-degree Y-rotated, 2x-scaled parent: world-space +X drag maps to exact
  // local space so the child moves by exactly (+2, 0, 0) in world space, and local gizmo axes
  // follow the parent's resolved world orientation rather than unrotated local identity!
  let rot_parent_pose = $transform.Pose3 {
    position: math.vec3 1.0 0.0 0.0,
    rotation: math.axis_angle math.up 1.5707963,
    scale: math.vec3 2.0 2.0 2.0,
  }
  let nested_child_pose = $transform.Pose3 {
    position: math.vec3 0.0 1.0 0.0,
    rotation: math.identity_quat,
    scale: math.one3,
  }
  let hier_nodes: #[scene_graph.Node] = #[
    scene_graph.root_node 100 rot_parent_pose 1 1,
    scene_graph.child_node 200 0 nested_child_pose 2 2,
  ]
  let hier_resolved = scene_graph.resolve (&hier_nodes[0..hier_nodes.length])
  let parent_world = scene_graph.parent_world_of (&hier_nodes[0..hier_nodes.length]) (&hier_resolved[0..hier_resolved.length]) 1
  let child_origin = hier_resolved[1].world.position
  let child_local_axes = scene_editor.gizmo_axes_world scene_editor.space_local hier_resolved[1].world
  // Parent rotated +90 deg around Y maps local +X -> world (0, 0, -1).
  let child_st = scene_editor.new_state ()
  child_st.selected_id := 200
  let c_start = $math.Ray { origin: math.vec3 1.5 2.0 5.0, direction: math.vec3 0.0 0.0 (-1.0) }
  let c_end = $math.Ray { origin: math.vec3 3.5 2.0 5.0, direction: math.vec3 0.0 0.0 (-1.0) }
  child_st := scene_editor.begin_drag self scene_editor.axis_x c_start child_origin axes nested_child_pose
  let moved_child_pose = scene_editor.solve_drag child_st c_end axes parent_world
  let moved_child_world = transform.point3 parent_world moved_child_pose.position

  // 5. Immediate-mode gizmo rendering emits 12 selection box edges + 3 axis lines = 15 draws.
  let gstyle = $scene_editor.GizmoStyle {
    x: $gizmos.Style { mesh: 0, material: 1, thickness: 0.05 },
    y: $gizmos.Style { mesh: 0, material: 2, thickness: 0.05 },
    z: $gizmos.Style { mesh: 0, material: 3, thickness: 0.05 },
    active: $gizmos.Style { mesh: 0, material: 4, thickness: 0.08 },
    selection: $gizmos.Style { mesh: 0, material: 5, thickness: 0.03 },
    handle_length: 1.5,
  }
  let frame = render.empty_frame ()
  frame := scene_editor.draw_gizmo gstyle st (&resolved[0..resolved.length]) self
  let draw_count = frame.draws.length

  // 6. Bounded Undo/Redo command history.
  let hist = scene_editor.new_history 8
  let (hist, nodes) = scene_editor.commit_command ($scene_editor.SetPose { node_id: 10, before: root_pose, after: moved_pose }) hist nodes
  let after_commit_x = nodes[0].local.position.x
  let (undid, hist, nodes) = scene_editor.undo hist nodes
  let after_undo_x = nodes[0].local.position.x
  let (redid, hist, nodes) = scene_editor.redo hist nodes
  let after_redo_x = nodes[0].local.position.x

  // 7. Explicit-copy Play-in-Editor snapshot and exact restore.
  let (play_st, snap) = scene_editor.enter_play st (&nodes[0..nodes.length])
  let mutated = nodes[0]
  mutated.local.position := math.vec3 99.0 99.0 99.0
  mutated.visible := false
  nodes[0] := mutated
  let during_play_x = nodes[0].local.position.x
  let (stop_st, nodes) = scene_editor.exit_play play_st snap nodes
  let after_stop_x = nodes[0].local.position.x
  let after_stop_vis = nodes[0].visible

  return check.report #[
    check.words #[20, scene_editor.axis_x, 15] #[picked, picked_axis, draw_count],
    check.near 0.001 #[3.5, 1.75, 3.5, 2.0, 3.5, 99.0, 3.5, 3.0, 2.0, 0.0, (-1.0)] #[moved_pose.position.x, scaled_pose.scale.y, after_commit_x, after_undo_x, after_redo_x, during_play_x, after_stop_x, moved_child_world.x, moved_child_world.y, moved_child_world.z, child_local_axes.x.z],
    check.holds (abs rotated_pose.rotation.y > 0.5),
    check.holds valid_ok,
    check.holds invalid_order,
    check.holds invalid_dup,
    check.holds undid,
    check.holds redid,
    check.holds play_st.playing,
    check.holds (not stop_st.playing),
    check.holds after_stop_vis,
  ]
