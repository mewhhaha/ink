import * as array from "std/array"
import * as check from "./check"
import * as ecs from "ink/ecs"
type Example is data = $Example { members: U32, animation: F32 }
const initial = $Example { members: 0, animation: 0.0 }
func same (a: Example) -> (b: Example) => a.members == b.members
// Semantic invalidation is an explicit application policy over named owners.
func write (state:#[Example]) -> (revision:#[U32]) -> (next:Example) =>
  if not (same state[0] next):
    revision[0] = ecs.bumped_revision revision[0]
  state[0] = next
  return ()
entry func observed () =>
  let state=#[initial]
  let revision=#[0]
  write state revision ($Example {members:0,animation:1.0})
  let before=revision[0]
  let old=copy state
  let old_revision=copy revision
  write state revision ($Example {members:3,animation:1.0})
  return #[before,revision[0],old[0].members,old_revision[0],state[0].members]

entry func test_semantic_revisions () => check.report #[check.words #[0, 1, 0, 0, 3] (observed ())]

type Value is data = $Value { count: U32, derived: U32 }
const zero = $Value { count: 0, derived: 0 }
func prepare (before: Value) -> (next: Value) => $Value { count: next.count, derived: next.count * 2 }
func equal (a: Value) -> (b: Value) => a.count == b.count
entry func test_explicit_writes_and_replacements_preserve_independent_copies () =>
  let state=#[zero]
  let revision=#[0]
  let before=copy state
  let old_revision=copy revision
  // The caller supplies a prepared value and its known semantic change.
  state[0] := $Value {count:3,derived:6}
  revision[0] := ecs.bumped_revision revision[0]
  let known=revision[0]
  let next=prepare state[0] ($Value {count:0,derived:99})
  if not (equal state[0] next):
    revision[0] := ecs.bumped_revision revision[0]
  state[0] := next
  let restored=#[revision[0],state[0].count,state[0].derived]
  return check.report #[check.holds (known==1 and old_revision[0]==0),check.holds (restored[0]==2 and restored[1]==0 and restored[2]==0)]
