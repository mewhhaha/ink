import * as array from "std/array"
import * as check from "./check"
import * as ecs from "ink/ecs"
type Example is data = #Example { members: U32, animation: F32 }
const initial = #Example { members: 0, animation: 0.0 }
const same = fn (a: Example) (b: Example) => a.members == b.members
entry const observed = fn () => do:
  let simulation = ecs.build (ecs.insert_observed_resource same initial (ecs.new ()))
  let (world, before) = ecs.create simulation (fn () => do:
    use ecs.set (#Example { members: 0, animation: 1.0 })
    return ecs.revision initial)
  let (changed, revision) = ecs.run simulation world (fn () => do:
    use ecs.set (#Example { members: 3, animation: 1.0 })
    return ecs.revision initial)
  let (_, old) = ecs.run simulation world (fn () => do:
    use value <- ecs.get #Example
    use revision <- ecs.revision initial
    return (value.members, revision))
  let (_, current) = ecs.run simulation changed (fn () => do:
    use value <- ecs.get #Example
    return value.members)
  let (old_members, old_revision) = old
  return #[before, revision, old_members, old_revision, current]

entry const test_semantic_revisions = fn () => check.report #[check.words #[0, 1, 0, 0, 3] (observed ())]

type Value is data = #Value { count: U32, derived: U32 }
const zero = #Value { count: 0, derived: 0 }
const prepare = fn (before: Value) (next: Value) => #Value { count: next.count, derived: next.count * 2 }
const equal = fn (a: Value) (b: Value) => a.count == b.count
entry const test_explicit_writes_and_replacements_preserve_forks = fn () => do:
  let program = ecs.build (ecs.insert_observed_resource_using prepare equal zero (ecs.new ()))
  let (before, _) = ecs.create program (fn () => ())
  let (after, known) = ecs.run program before (fn () => do:
    use ecs.write_observed #True (#Value { count: 3, derived: 6 })
    return ecs.revision zero)
  let (_, restored) = ecs.run program after (fn () => do:
    use ecs.set (#Value { count: 0, derived: 99 })
    use revision <- ecs.revision zero
    use value <- ecs.get #Value
    return #[revision, value.count, value.derived])
  let (_, old) = ecs.run program before (fn () => ecs.revision zero)
  return check.report #[check.holds (known == 1 && old == 0), check.holds (restored[0] == 2 && restored[1] == 0 && restored[2] == 0)]
