import * as array from "std/array"
import * as check from "./check"
import * as ecs from "ink/ecs"
type Example is data = #Example { members: U32, animation: F32 }
const initial = #Example { members: 0, animation: 0.0 }
const same = fn (a: Example) (b: Example) => a.members == b.members
entry const observed = fn () => do:
  let simulation = ecs.build (ecs.insert_observed_resource same initial (ecs.new ()))
  let (world, before) = ecs.create simulation (fn () => do:
    use ecs.set (#Example { members: 0, animation: 1.0 })
    return ecs.revision initial)
  let (changed, revision) = ecs.run simulation world (fn () => do:
    use ecs.set (#Example { members: 3, animation: 1.0 })
    return ecs.revision initial)
  let (_, old) = ecs.run simulation world (fn () => do:
    use value <- ecs.get #Example
    use revision <- ecs.revision initial
    return (value.members, revision))
  let (_, current) = ecs.run simulation changed (fn () => do:
    use value <- ecs.get #Example
    return value.members)
  let (old_members, old_revision) = old
  return #[before, revision, old_members, old_revision, current]

entry const test_semantic_revisions = fn () => check.report #[check.words #[0, 1, 0, 0, 3] (observed ())]
