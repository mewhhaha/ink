import * as array from "std/array"
import * as lanes from "ink/lanes"
import * as math from "ink/math"
import * as timeline from "ink/timeline"
import * as tween from "ink/tween"

const key = fn (time: F32) => fn value => fn (ease: tween.Ease) => #timeline.Key { time, value, ease }

const bit = fn (value: Bool) -> F32 => if value then 1.0 else 0.0

// 10 at 1, linear to 20 at 2, smooth to 0 at 4, then 50 at 4 too, in two
// steps to 60 at 6, held to 80 at 8.
const levels = timeline.track #[
  key 1.0 10.0 #tween.Linear,
  key 2.0 20.0 #tween.Linear,
  key 4.0 0.0 #tween.Smooth,
  key 4.0 50.0 #tween.Hold,
  key 6.0 60.0 (#tween.Steps 2),
  key 8.0 80.0 #tween.Hold,
]

entry const level = fn (time: F32) -> F32 => case levels of
  #Some track => timeline.sample track time
  #Nothing => (-1.0)

entry const span = fn (unused: U32) -> Array F32 => case levels of
  #Some track => #[timeline.starts track, timeline.ends track]
  #Nothing => #[]

// Key times from lanes; 1 when they make a track.
entry const keyed = fn (times: Array F32) -> U32 => do:
  let keys = @array.generate times.length (fn (i: U32) => key times[i] (U32.to_f32 i) #tween.Linear)
  return case timeline.track keys of
    #Some _ => 1
    #Nothing => 0

// Cue times from lanes; 1 when they make a cue list.
entry const listed = fn (times: Array F32) -> U32 => do:
  let list = @array.generate times.length (fn (i: U32) => #timeline.Cue { time: times[i], value: i })
  return case timeline.cues list of
    #Some _ => 1
    #Nothing => 0

// A held count: 1, 2 from 1 (Linear), 3 from 2 (Smoother).
entry const held = fn (time: F32) -> U32 => do:
  let #Some counts = timeline.track #[key 0.0 (#tween.Discrete 1) #tween.Linear, key 1.0 (#tween.Discrete 2) #tween.Linear, key 2.0 (#tween.Discrete 3) #tween.Smoother] else:
    return 0
  let #tween.Discrete count = timeline.sample counts time
  return count

// Identity at 0, a 2 radian turn about +Y at 1.
entry const turned = fn (time: F32) -> Array F32 => do:
  let #Some turns = timeline.track #[key 0.0 math.identity_quat #tween.Linear, key 1.0 (math.axis_angle math.up 2.0) #tween.Linear] else:
    return #[]
  let q = timeline.sample turns time
  return #[q.x, q.y, q.z, q.w]

const mode_of = fn (index: F32) => do:
  if index == 1.0:
    return #timeline.Loop
  if index == 2.0:
    return #timeline.PingPong
  return #timeline.Once

// Lanes: duration, mode (0 Once, 1 Loop, 2 PingPong), cue count, cue times,
// then operations as pairs: 0 advance by seconds, 1 seek, 2 pause, 3 resume,
// 4 set speed. Cue values are their indices. Each operation records its code,
// position, returning, finished, dropped, the passes (count, then from, to,
// inclusive each) and the fired cues (count, then values). A refusal records
// -1 and stops. Statement `case` arms drop assignments to outer locals, so
// refusals use `let ... else`.
entry const run = fn (lanes: Array F32) -> Array F32 => do:
  let #Some started = timeline.play lanes[0] (mode_of lanes[1]) else:
    return #[(-1.0)]
  let count = F32.to_u32 lanes[2]
  let list = @array.generate count (fn (i: U32) => #timeline.Cue { time: lanes[3 + i], value: U32.to_f32 i })
  let #Some sheet = timeline.cues list else:
    return #[(-1.0)]
  let playback = started
  let output: List F32 = []
  let operations = (lanes.length - 3 - count) / 2
  for operation in 0..operations:
    let code = lanes[3 + count + operation * 2]
    let value = lanes[4 + count + operation * 2]
    let passes: Array timeline.Pass = #[]
    let finished = #False
    let dropped = 0.0
    if code == 0.0:
      let #Some advanced = timeline.advance playback value else:
        return Array.from_list [...output, (-1.0)]
      playback := advanced.playback
      passes := advanced.passes
      finished := advanced.finished
      dropped := advanced.dropped
    if code == 1.0:
      let #Some moved = timeline.seek playback value else:
        return Array.from_list [...output, (-1.0)]
      playback := moved
    if code == 2.0:
      playback := timeline.pause playback
    if code == 3.0:
      playback := timeline.resume playback
    if code == 4.0:
      let #Some faster = timeline.with_speed playback value else:
        return Array.from_list [...output, (-1.0)]
      playback := faster
    let fired = timeline.fired sheet passes
    output := [...self, code, timeline.position playback, bit playback.returning, bit finished, dropped, U32.to_f32 passes.length]
    for pass in passes:
      output := [...self, pass.from, pass.to, bit pass.inclusive]
    output := [...self, U32.to_f32 fired.length]
    for value in fired:
      output := [...self, value]
  return Array.from_list output

// Lanes: play duration. 1 when play accepts it.
entry const started = fn (duration: F32) -> U32 => case timeline.play duration #timeline.Loop of
  #Some _ => 1
  #Nothing => 0

entry const restored = fn (values: Array F32) -> Array F32 => timeline.encode (timeline.decode values)

entry const saved = fn (unused: U32) -> Array F32 => do:
  let #Some playback = timeline.play 2.5 #timeline.PingPong else:
    return #[]
  let #Some faster = timeline.with_speed playback (-1.5) else:
    return #[]
  let #Some moved = timeline.seek (timeline.pause faster) 1.25 else:
    return #[]
  return timeline.encode moved

entry const codec_key = fn (unused: U32) -> Array U32 => do:
  let #lanes.Codec { key, version } = timeline.codec
  return #[key, version]

// A type of the fixture's own, sampled through its own lerp: the level
// interpolates and the glow takes the brighter key.
type Gauge is data = #Gauge { level: F32, glow: F32 }

const Gauge.lerp = fn (a: Gauge) => fn (b: Gauge) => fn (t: F32) => #Gauge { level: F32.lerp a.level b.level t, glow: max a.glow b.glow }

entry const gauge = fn (time: F32) -> Array F32 => do:
  let #Some gauges = timeline.track #[key 0.0 (#Gauge { level: 0.0, glow: 0.25 }) #tween.Linear, key 2.0 (#Gauge { level: 8.0, glow: 1.0 }) #tween.Linear, key 3.0 (#Gauge { level: 2.0, glow: 0.5 }) #tween.Linear] else:
    return #[]
  let value = timeline.sample gauges time
  return #[value.level, value.glow]
