import * as check from "./check"
import * as services from "ink/services"
import * as locale from "ink/pen/locale"
import * as protocol from "pen/protocol"
entry func test_locale_adapter_preserves_drawn_spoken_and_request_arguments () => return do:
  let text: ResizeArray U32 = #[]
  let same_text: ResizeArray U32 = #[]
  let words = locale.parts #[65.0,66.0,0.0,67.0,68.0] text
  let same = locale.parts #[945.0] same_text
  let next: Array U32 = #[1]
  let outbox: ResizeArray services.Request = #[]
  let waiting: ResizeArray services.Request = #[]
  let filling: ResizeArray services.Filling = #[]
  let answers: ResizeArray services.Answer = #[]
  let statuses: ResizeArray U32 = #[]
  let payload: ResizeArray F32 = #[]
  let pending = services.access next outbox waiting filling answers statuses payload
  pending := services.idle pending 32
  let first = locale.ask pending #[65] $Nothing
  let second = locale.ask pending #[66] ($Some 12)
  let a = pending.outbox[0]
  let b = pending.outbox[1]
  let valid = first != second and a.service == protocol.service_locale and a.operation == protocol.locale_op_text and a.a == 0.0 and a.b == 0.0 and b.a == 12.0 and b.b == 1.0 and (services.values pending b.values)[0] == 66.0
  return check.report #[check.holds valid,
    check.equal #[65.0,66.0,67.0,68.0] #[from words.drawn[0],from words.drawn[1],from words.spoken[0],from words.spoken[1]],
    check.holds (same.drawn[0] == same.spoken[0]),
    check.holds (Bool.not (Maybe.is_some (locale.decoded pending ($services.Answer {id:1,status:255,value:0.0,values:$services.Span {start:0,count:0}}) text)))]
