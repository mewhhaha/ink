import * as check from "./check"
import * as ecs from "ink/ecs"
import * as clock from "ink/clock"
import * as services from "ink/services"
import * as locale from "ink/pen/locale"
import * as protocol from "pen/protocol"
const engine = ecs.build (ecs.insert_resource (#clock.Clock {tick:0,remainder:0.0}) (ecs.insert_resource (services.idle 32) (ecs.new ())))
entry const test_locale_adapter_preserves_drawn_spoken_and_request_arguments = fn () => do:
  let words = locale.parts #[65.0,66.0,0.0,67.0,68.0]
  let same = locale.parts #[945.0]
  let (_, valid) = ecs.create engine (fn () => do:
    use first <- locale.ask #[65] #Nothing
    use second <- locale.ask #[66] (#Some 12)
    use pending <- ecs.get #services.Services
    let a = pending.outbox[0]
    let b = pending.outbox[1]
    return first != second && a.service == protocol.service_locale && a.operation == protocol.locale_op_text && a.a == 0.0 && a.b == 0.0 && b.a == 12.0 && b.b == 1.0 && b.values[0] == 66.0)
  return check.report #[check.holds valid,
    check.equal #[65.0,66.0,67.0,68.0] #[from words.drawn[0],from words.drawn[1],from words.spoken[0],from words.spoken[1]],
    check.holds (same.drawn[0] == same.spoken[0]),
    check.holds (Bool.not (Maybe.is_some (locale.decoded (#services.Answer {id:1,status:255,value:0.0,values:#[]}))))]
