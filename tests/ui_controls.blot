// Ink's headless controls (lib/ui.blot): how stepping, sliding and
// the keys change a toggle, a slider and a choice, and how a menu of them
// answers a key; and numbers in decimal digits.
import * as array from "std/array"
import * as check from "./check"
import * as keys from "ink/input/keys"
import * as ui from "ink/ui"

const name = #[65]
const toggle = $ui.Toggle { label: &name[0..name.length], on: false }
const slider = $ui.Slider { label: &name[0..name.length], value: 0.5, low: 0.0, high: 1.0, step: 0.25 }
const button = $ui.Button { label: &name[0..name.length] }

// A control's value as a number: on, the slider's value, the chosen option.
const value = func (control: ui.Control) => return case control of
  $ui.Toggle { on } => do:
    if on:
      break 1.0
    break 0.0
  $ui.Slider { value } => value
  $ui.Choice { chosen } => U32.to_f32 chosen
  $ui.Button _ => -1.0

entry const test_a_toggle_flips = func () => return do:
  let option_values = #[&name[0..name.length], &name[0..name.length], &name[0..name.length]]
  let choice = $ui.Choice {label: &name[0..name.length], options: &option_values[0..option_values.length], chosen: 0}
  let menu = #[button, toggle, choice]
  return check.report #[
    check.equal #[1.0] #[value (ui.step toggle 1.0)],
  ]

entry const test_a_slider_steps_within_its_range = func () => return do:
  let option_values = #[&name[0..name.length], &name[0..name.length], &name[0..name.length]]
  let choice = $ui.Choice {label: &name[0..name.length], options: &option_values[0..option_values.length], chosen: 0}
  let menu = #[button, toggle, choice]
  return check.report #[
    check.equal #[0.75, 1.0, 0.25] #[
      value (ui.step slider 1.0),
      value (ui.step (ui.step (ui.step slider 1.0) 1.0) 1.0),
      value (ui.step slider (-1.0)),
    ],
  ]

entry const test_a_choice_wraps_round = func () => return do:
  let option_values = #[&name[0..name.length], &name[0..name.length], &name[0..name.length]]
  let choice = $ui.Choice {label: &name[0..name.length], options: &option_values[0..option_values.length], chosen: 0}
  let menu = #[button, toggle, choice]
  return check.report #[
    check.equal #[2.0, 1.0] #[value (ui.step choice (-1.0)), value (ui.step choice 1.0)],
  ]

entry const test_a_slide_snaps_to_a_step_within_the_range = func () => return do:
  let option_values = #[&name[0..name.length], &name[0..name.length], &name[0..name.length]]
  let choice = $ui.Choice {label: &name[0..name.length], options: &option_values[0..option_values.length], chosen: 0}
  let menu = #[button, toggle, choice]
  return check.report #[
    check.equal #[0.5, 1.0] #[value (ui.slide slider 0.6), value (ui.slide slider 7.0)],
    check.equal #[0.25] #[ui.fraction ($ui.Slider { label: &name[0..name.length], value: 3.0, low: 2.0, high: 6.0, step: 1.0 })],
  ]

  // What a key does: 0 moved, 1 pressed, 2 changed, 3 ignored, then the index
  // and the changed control's value.
const outcome = func (result: ui.Outcome) => return case result of
  $ui.Moved index => #[0.0, U32.to_f32 index, 0.0]
  $ui.Pressed index => #[1.0, U32.to_f32 index, 0.0]
  $ui.Changed { index, control } => #[2.0, U32.to_f32 index, value control]
  $ui.Ignored => #[3.0, 0.0, 0.0]


entry const test_up_and_down_wrap_round_the_menu = func () => return do:
  let option_values = #[&name[0..name.length], &name[0..name.length], &name[0..name.length]]
  let choice = $ui.Choice {label: &name[0..name.length], options: &option_values[0..option_values.length], chosen: 0}
  let menu = #[button, toggle, choice]
  return check.report #[
    check.equal #[0.0, 2.0, 0.0] (outcome (ui.key menu 0 keys.up)),
    check.equal #[0.0, 0.0, 0.0] (outcome (ui.key menu 2 keys.down)),
  ]

entry const test_enter_presses_a_button_and_arrows_leave_it_alone = func () => return do:
  let option_values = #[&name[0..name.length], &name[0..name.length], &name[0..name.length]]
  let choice = $ui.Choice {label: &name[0..name.length], options: &option_values[0..option_values.length], chosen: 0}
  let menu = #[button, toggle, choice]
  return check.report #[
    check.equal #[1.0, 0.0, 0.0] (outcome (ui.key menu 0 keys.enter)),
    check.equal #[3.0, 0.0, 0.0] (outcome (ui.key menu 0 keys.right)),
  ]

entry const test_space_flips_a_toggle = func () => return do:
  let option_values = #[&name[0..name.length], &name[0..name.length], &name[0..name.length]]
  let choice = $ui.Choice {label: &name[0..name.length], options: &option_values[0..option_values.length], chosen: 0}
  let menu = #[button, toggle, choice]
  return check.report #[
    check.equal #[2.0, 1.0, 1.0] (outcome (ui.key menu 1 keys.space)),
  ]

entry const test_left_moves_a_choice_back_wrapping = func () => return do:
  let option_values = #[&name[0..name.length], &name[0..name.length], &name[0..name.length]]
  let choice = $ui.Choice {label: &name[0..name.length], options: &option_values[0..option_values.length], chosen: 0}
  let menu = #[button, toggle, choice]
  return check.report #[
    check.equal #[2.0, 2.0, 2.0] (outcome (ui.key menu 2 keys.left)),
  ]

entry const test_other_keys_do_nothing = func () => return do:
  let option_values = #[&name[0..name.length], &name[0..name.length], &name[0..name.length]]
  let choice = $ui.Choice {label: &name[0..name.length], options: &option_values[0..option_values.length], chosen: 0}
  let menu = #[button, toggle, choice]
  return check.report #[
    check.equal #[3.0, 0.0, 0.0] (outcome (ui.key menu 2 keys.a)),
  ]

  // `value`'s digits read back as a number.
const read_digits = func (value: U32) => return do:
  let result = 0.0
  for code in ui.digits value:
    result := self * 10.0 + U32.to_f32 (code - 48)
  return result

entry const test_digits_spell_a_number = func () => return do:
  let option_values = #[&name[0..name.length], &name[0..name.length], &name[0..name.length]]
  let choice = $ui.Choice {label: &name[0..name.length], options: &option_values[0..option_values.length], chosen: 0}
  let menu = #[button, toggle, choice]
  return check.report #[
    check.equal #[0.0, 7.0, 42.0, 1234567.0] (array.map read_digits #[0, 7, 42, 1234567]),
  ]
