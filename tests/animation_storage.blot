import * as check from "./check"
import * as animation from "ink/animation"
import * as math from "ink/math"
import * as transform from "ink/transform"
func pose (x: F32) => $transform.Pose3 {position: math.vec3 x 0.0 0.0,rotation: math.identity_quat,scale: math.one3}
#entry func test_flat_track_spans () =>
  let keys = #[$animation.Key {time:0.0,pose:pose 0.0},$animation.Key {time:1.0,pose:pose 10.0},
    $animation.Key {time:0.0,pose:pose 100.0},$animation.Key {time:1.0,pose:pose 110.0}]
  let tracks = #[$animation.Track {start:0,count:2},$animation.Track {start:2,count:2}]
  let events = #[{time:0.25,id:0xFFFFFFFF},{time:0.75,id:0x80000000}]
  let clip = $animation.Clip {duration:1.0,keys:keys.view 0 keys.length,tracks:tracks.view 0 tracks.length,events:events.view 0 events.length}
  let $Some valid = animation.validate clip else:
    return check.report #[check.holds false]
  let sampled = animation.sample valid 0.5 false
  let offset = animation.sample_track (keys.view 0 keys.length) tracks[1] 0.5
  let bad_tracks = #[$animation.Track {start:3,count:2}]
  let invalid = $animation.Clip {duration:1.0,keys:keys.view 0 keys.length,tracks:bad_tracks.view 0 bad_tracks.length,events:events.view 0 events.length}
  let empty = animation.sample_track (keys.view 0 keys.length) ($animation.Track {start:4,count:0}) 0.5
  return check.report #[
    check.equal #[5.0,105.0,105.0] #[sampled[0].position.x,sampled[1].position.x,offset.position.x],
    check.words #[0xFFFFFFFF,0x80000000] (animation.events valid 0.0 1.0 false),
    check.holds (not (Maybe.is_some (animation.validate invalid))),
    check.equal #[0.0,1.0] #[empty.position.x,empty.scale.x],
  ]
