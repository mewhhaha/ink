import * as array from "std/array"
import * as test from "std/test"
import * as services from "ink/services"
import * as typed from "ink/services/typed"
import * as ecs from "ink/ecs"
type Request is data = $Request { count: U32 }
type Count is data = $Count U32
const empty: #[F32] = #[]
const method = $typed.Method {service:2,operation:3,
  encode:func (request:Request) => $typed.Arguments {a:from request.count,b:0.0,c:0.0,d:0.0,values:&empty[0..0]},
  decode:func state -> (answer:services.Answer) => if answer.status == 0 and is_finite answer.value and answer.value >= 0.0 and answer.value <= 16777215.0 and floor answer.value == answer.value then $Some ($Count (from answer.value)) else $Nothing}
func with_services consume =>
  let next: #[U32] = #[1]
  let outbox: #[services.Request] = #[]
  let waiting: #[services.Request] = #[]
  let filling: #[services.Filling] = #[]
  let answers: #[services.Answer] = #[]
  let statuses: #[U32] = #[]
  let payload: #[F32] = #[]
  let state = services.access next outbox waiting filling answers statuses payload
  state := services.idle state 3
  return consume (own state)
io query () => with_services (func (state: own services.Services) =>
  let (requested, state) = typed.ask method state ($Request {count:10})
  @storage.push state.answers ($services.Answer {id:typed.id requested,status:0,value:42.0,values:$services.Span {start:0,count:0}})
  let (result, state) = typed.take method state requested
  let (duplicate, state) = typed.take method state requested
  let $Some ($typed.Received ($Count value)) = result else:
    return #[0]
  return #[value,if Maybe.is_some duplicate then 1 else 0,state.outbox[0].operation,from state.outbox[0].a])
io invalid (value:F32) => with_services (func (state: services.Services) => case typed.receive method state ($services.Answer {id:1,status:0,value,values:$services.Span {start:0,count:0}}) of
  $typed.Invalid _ => 1
  $typed.Received _ => 0)
io wrong_method (operation:U32) => with_services (func (state: own services.Services) =>
  let (requested, state) = typed.ask method state ($Request {count:10})
  let other = method
  other.operation := operation
  let (result, _) = typed.take other state requested
  return if Maybe.is_some result then 1 else 0)

@[test.suite]
test "typed service domains and consumption":
  let q = query ()
  let inv0 = invalid 0.0
  let wm3 = wrong_method 3
  use test.eq "query" #[42, 0, 3, 10] q
  use test.eq "valid zero" 0 inv0
  use test.eq "matching operation" 0 wm3
  for value in #[-1.0, 0.5, 16777216.0, 0.0 / 0.0, 1.0 / 0.0]:
    let inv = invalid value
    use test.eq "rejected invalid value" 1 inv
  return ()

test expect_trap "wrong service method":
  let _ = wrong_method 4
  return ()
