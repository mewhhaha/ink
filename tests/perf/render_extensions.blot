// Benchmark workload covering ink/render/lines, ink/render/outlines,
// ink/render/gpu_particles and ink/render/d2 wire extension packing.
import * as math from "ink/math"
import * as render from "ink/render"
import * as particles from "ink/render/gpu_particles"
import * as lines from "ink/render/lines"
import * as outlines from "ink/render/outlines"
import * as d2 from "ink/render/d2"

#entry func render_extensions_batch (size: U32) : #[F32] =>
  let color = math.vec4 0.25 0.75 1.0 1.0
  let style = $lines.LineStyle { width_px: 2.0, dash_len_px: 6.0, gap_len_px: 3.0, feather_px: 1.0, layer: $lines.XRay }
  let segments: #[lines.Segment] = #[]
  let parts: #[particles.Particle] = #[]
  let targets: #[outlines.OutlineTarget] = #[]
  let shapes: #[d2.SdfShape] = #[]
  let sprites: #[d2.Sprite2d] = #[]
  for i in 0 .. size:
    let f = U32.to_f32 i
    segments := lines.push_segment (math.vec3 f 0.0 0.0) (math.vec3 (f + 1.0) 1.0 0.0) color style self
    @storage.push parts (particles.particle (math.vec3 f 1.0 0.0) (math.vec3 0.0 2.0 0.0) 3.0 0.25 color)
    @storage.push targets ($outlines.OutlineTarget { draw_index: i, style_index: 0 })
    @storage.push shapes (d2.rounded_rect (math.vec4 f 12.0 24.0 16.0) (math.vec4 4.0 4.0 4.0 4.0) color)
    @storage.push sprites ($d2.Sprite2d {
      material_idx: -1.0, pos: math.vec2 f 0.0, size: math.vec2 16.0 16.0,
      pivot: math.vec2 0.5 0.5, rotation: 0.0, z_layer: 0.0,
      uv_rect: math.vec4 0.0 0.0 1.0 1.0, color, nine_slice: math.vec4 0.0 0.0 0.0 0.0,
      flip_x: false, flip_y: false, tex_size: math.vec2 16.0 16.0,
    })
  let styles = #[outlines.style color 4.0]
  let camera = $d2.Camera2d { center: math.vec2 0.0 0.0, zoom: 1.0, rotation: 0.0 }
  let cells: #[d2.TileCell] = #[d2.tile_cell 1 false false false 0, d2.tile_cell 2 true false false 1]
  let tilemap = $d2.TilemapHeader {
    material_idx: -1.0, origin: math.vec2 0.0 0.0, tile_size: math.vec2 16.0 16.0,
    grid_w: 2, grid_h: 1, atlas_cols: 2, atlas_rows: 1,
    anim_time: 0.0, anim_fps: 0.0, tint: color,
  }
  let rc = $d2.Rc2dConfig { mode: 1, c0_spacing: 2, c0_dirs: 4, cascades: 0, ambient: 0.1, multiply: 1.0, add: 0.0 }
  let emitters: #[d2.Emitter2d] = #[$d2.Circle { center: math.vec2 32.0 32.0, radius: 12.0, material: color }]
  let frame = render.empty_frame ()
  frame := particles.emit_extension particles.default_config (&parts[0..parts.length]) self
  frame := lines.emit_extension ($lines.XRayConfig { alpha: 0.3, desaturate: 0.5 }) (&segments[0..segments.length]) self
  frame := outlines.emit_extension (&styles[0..styles.length]) (&targets[0..targets.length]) 8.0 0.001 self
  frame := d2.emit_sdf_extension (&shapes[0..shapes.length]) self
  frame := d2.emit_world_extension camera true ($Some tilemap) (&cells[0..cells.length]) (&sprites[0..sprites.length]) rc (&emitters[0..emitters.length]) self
  return #[
    U32.to_f32 size,
    U32.to_f32 frame.extensions.length,
    U32.to_f32 frame.extension_values.length,
    U32.to_f32 cells[1],
  ]
