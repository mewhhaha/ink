import * as array from "std/array"
import * as jobs from "ink/task_queue"
import * as schedule from "ink/schedule"
import * as partition from "ink/partition"
import * as typed from "ink/services/typed"
import * as services from "ink/services"
import * as claims from "ink/claims"

entry func claims_workload (count: U32) => return do:
  let bids = array.generate count (func index => return $claims.Bid { resource: index % 32, owner: index, priority: 0 })
  let $Some grants = claims.resolve 32 bids else:
    return @panic "claim fixture rejected"
  return array.map (func grant => return case grant of
    $Some bid => bid.owner
    $Nothing => 4294967295) grants

entry func queue_workload (count: U32) => return do:
  let queue: jobs.Queue [U32, U32, U32] = jobs.empty ()
  let meta = jobs.metadata 1 count false
  let history: ResizeArray jobs.Mark = #[]
  for index in 0 .. count:
    let $Some ticket = jobs.submit 0 1 index index queue meta history else:
      return @panic "full benchmark queue"
  for index in 0 .. count:
    let at = count - 1 - index
    let settled = jobs.settle 1 ($jobs.Ticket { epoch: 1, sequence: at + 1 }) ($jobs.Value (at * 3)) queue meta history
  let values = jobs.publish 1 queue meta history
  let sum = 0
  for delivery in values:
    if let $jobs.Value value = delivery.outcome:
      sum := self + value
  return #[values.length, sum, queue.length]

entry func schedule_workload (count: U32) => return do:
  let channels = array.generate (count * 2) (func i => return if i % 2 == 0 then 0 else i / 2 + 1)
  let nodes = array.generate count (func index => return $schedule.Node {
    access: schedule.access (schedule.span (index * 2) 1) (schedule.span (index * 2 + 1) 1), mode: $schedule.Pure, after: schedule.span 0 0})
  let dependency_starts: ResizeArray U32 = #[]
  let dependency_targets: ResizeArray U32 = #[]
  let wave_starts: ResizeArray U32 = #[]
  let wave_nodes: ResizeArray U32 = #[]
  let $Some planned = schedule.plan 4 nodes channels dependency_starts dependency_targets wave_starts wave_nodes else:
    return @panic "schedule rejected"
  let sum = 0
  for index in planned.waves.nodes:
    sum := self + index
  return #[planned.waves.starts.length - 1,sum]

entry func partition_workload (count: U32) => return do:
  let sum = 0
  let end = 0
  for size in 0 .. count:
    for part in 0 .. 4:
      let range = partition.four size part
      sum := self + range.count
      end := range.start + range.count
  return #[sum, end]

const empty: Array F32 = #[]
const method = $typed.Method { service: 1, operation: 2,
  encode: func (value: U32) => return $typed.Arguments { a: U32.to_f32 value, b: 0.0, c: 0.0, d: 0.0, values: &empty[0..0] },
  decode: func state -> (answer: services.Answer) => return if answer.status == 0 then $Some (F32.to_u32 answer.value) else $Nothing }
entry func service_workload (count: U32) => return do:
  let next = #[1]
  let outbox: ResizeArray services.Request = #[]
  let waiting: ResizeArray services.Request = #[]
  let filling: ResizeArray services.Filling = #[]
  let answers: ResizeArray services.Answer = #[]
  let statuses: ResizeArray U32 = #[]
  let payload: ResizeArray F32 = #[]
  let state = services.access next outbox waiting filling answers statuses payload
  let sum = 0
  for index in 0 .. count:
    let arguments = method.encode index
    let $typed.Received value = typed.receive method state ($services.Answer { id: index, status: 0, value: arguments.a, values: $services.Span {start:0,count:0} }) else:
      return @panic "service answer rejected"
    sum := self + value
  return #[sum]
