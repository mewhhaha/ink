import * as math from "ink/math"
import * as bubbles from "ink/ui/bubbles"

// Move the controls every frame, then project the curve onto a rotated plane.
entry const bubbles_workload = fn (count: U32) -> Array F32 => do:
  let plane = #bubbles.Plane { origin: math.vec3 8.0 3.0 (-2.0), rotation: math.yaw_pitch 0.8 0.4, unit: 0.025 }
  let sum = 0.0
  let error = 0.0
  for index in 0 .. count:
    let x = U32.to_f32 (index % 32)
    let shift = U32.to_f32 (index % 8)
    let curve = #bubbles.Curve {
      a: math.vec2 x 20.0, b: math.vec2 x (80.0 + shift),
      c: math.vec2 (x + 80.0) 80.0, d: math.vec2 (x + 80.0 + shift) 20.0,
    }
    let middle = bubbles.at curve 0.5
    let world = bubbles.point plane middle.x middle.y
    let screen = bubbles.coordinates plane world
    let matrix = bubbles.matrix plane middle.x middle.y 44.0
    let controls = bubbles.controls curve
    sum := self + middle.x + middle.y + controls[3].x
    error := max self (max (abs (screen.x - middle.x)) (abs (screen.y - middle.y)))
    error := max self ((math.vec3 matrix.w.x matrix.w.y matrix.w.z - world).length)
  return #[U32.to_f32 count, sum, error]
