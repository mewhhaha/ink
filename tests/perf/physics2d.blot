import { Vec2 } from "std/vector"
import * as triggers from "ink/physics/triggers"
import * as shapes from "ink/physics/d2/shapes"
import * as broadphase from "ink/physics/d2/broadphase"
import * as narrowphase from "ink/physics/d2/narrowphase"
import * as joints from "ink/physics/d2/joints"
import * as queries from "ink/physics/d2/queries"
import * as character from "ink/physics/d2/character"
import * as world from "ink/physics/d2/world"

// Benchmark workload covering all seven ink/physics/d2/* modules.

entry func physics2d_world_batch (count: U32) : #[F32] =>
  let floor_b = shapes.static_box ($Vec2 { x: 0.0, y: (-0.5) }) 40.0 0.5 0.0 0.5
  let edge_b = shapes.static_edge ($Vec2 { x: (-15.0), y: 0.0 }) ($Vec2 { x: 15.0, y: 0.0 }) 0.4
  let bodies: #[shapes.Body2D] = #[floor_b, edge_b]
  let n_dyn = max (min count 32) 4
  for i in 0 .. n_dyn:
    let col = i % 4
    let row = i / 4
    let x = U32.to_f32 col * 1.4 - 2.1
    let y = 0.6 + U32.to_f32 row * 1.15
    if i % 3 == 0:
      @storage.push bodies (shapes.dynamic_box ($Vec2 { x, y }) 0.45 0.45 1.0 0.1 0.5)
    else:
      if i % 3 == 1:
        @storage.push bodies (shapes.dynamic_circle ($Vec2 { x, y }) 0.45 1.0 0.3 0.4)
      else:
        @storage.push bodies (shapes.dynamic_capsule ($Vec2 { x, y }) 0.25 0.35 1.0 0.2 0.4)
  let jlist: #[joints.Joint2D] = #[joints.distance_joint 2 3 shapes.zero2 shapes.zero2 1.4]
  let cfg = world.default_config ($Vec2 { x: 0.0, y: (-9.81) })
  let cache: #[world.CachedImpulse2D] = #[]
  let prev: #[triggers.Pair] = #[]
  let ch = character.character_capsule ($Vec2 { x: (-8.0), y: 1.0 }) 0.35 0.4 45.0
  let ray_hits = 0
  let contacts = 0
  let steps = max (count / 4) 4
  for _ in 0 .. steps:
    let (nb, _, nc, np, st) = world.step cfg (1.0 / 60.0) bodies jlist cache prev
    bodies := nb
    cache := nc
    prev := np
    contacts := self + st.contacts
    let mr = character.move_character (1.0 / 60.0) ($Vec2 { x: 2.0, y: (-3.0) }) false ch bodies
    ch := mr.character
    let hit = case queries.raycast ($Vec2 { x: (-10.0), y: 0.6 }) ($Vec2 { x: 1.0, y: 0.0 }) 25.0 shapes.default_filter false bodies of
      $Some _ => 1
      $Nothing => 0
    ray_hits := self + hit
  let bp = broadphase.broadphase_pairs 2.0 0.0 bodies
  let np_ok = case narrowphase.collide_bodies 2 bodies[2] 0 bodies[0] of
    $Some m => U32.to_f32 m.count
    $Nothing => 0.0
  return #[
    U32.to_f32 count,
    U32.to_f32 bodies.length,
    U32.to_f32 contacts + U32.to_f32 bp.length + np_ok,
    U32.to_f32 ray_hits + ch.pos.x,
  ]
