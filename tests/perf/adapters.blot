import * as array from "std/array"
import * as host from "ink/pen/host"
import * as pen_events from "ink/pen/events"
import * as pen_platform from "ink/pen/platform"
import * as pen_program from "ink/pen/program"
import * as pen_services from "ink/pen/services"
import * as simulation from "ink/pen/simulation"
import * as pen_settings from "ink/pen/settings"
import * as preferences from "ink/preferences"
import * as persist from "ink/persist"
import * as ecs from "ink/ecs"
import * as services from "ink/services"
import * as events from "ink/events"
import * as sound from "ink/sound"
import * as render from "ink/render"
import * as math from "ink/math"
import * as ui from "ink/ui"
import * as tree from "ink/ui/tree"
import * as lanes from "ink/lanes"
import * as protocol from "pen/protocol"

const kept = $preferences.Preferences {
  quality: $preferences.Quality { msaa: 1, fxaa: false, scale: 1.0, filtering: 0,
    shadows: 0, occlusion: false, sky: false, fog: 1.0, effects: false, bloom: false, reflections: 0, volumetrics: 0 },
  volumes: $preferences.Volumes { master: 0.5, music: 0.25, effects: 0.75 },
  controls: $preferences.Controls { left_handed: false }, changed: false,
}

// Descending ids and predecessor parents force a full parent lookup.
const button_text = #[65]
const empty_text: #[U32] = #[]
func wire_parents (nodes: #[tree.Node]) =>
  let parents = tree.parents_of (&nodes[0..nodes.length])
  let text: #[~F32] = #[]
  return array.generate nodes.length (func index => (host.wire_node {nodes,parents,text} index).parent)
entry func wire_tree (count: U32) =>
  let nodes = array.generate count (func index =>
    let parent = 0
    if index > 0:
      parent := count - index + 1
    return ui.button_node (count-index) parent (&button_text[0..1]) ui.nowhere)
  let parents = tree.parents_of (&nodes[0..nodes.length])
  let text: #[~F32] = #[]
  let parent_sum=0
  let ids=0
  let text_count=0
  for index in 0 .. nodes.length:
    let node=host.wire_node {nodes,parents,text} index
    parent_sum := self+node.parent
    ids := self+node.id
    text_count := self+node.text_length
  return #[nodes.length,parent_sum,ids,text_count]
entry func parent_indices (pairs: #[U32]) =>
  let nodes=array.generate (pairs.length/2) (func index => ui.button_node pairs[index*2] pairs[index*2+1] (&empty_text[0..0]) ui.nowhere)
  return wire_parents nodes

func with_services run =>
  let next=#[1]
  let outbox:#[~services.Request]=#[]
  let waiting:#[~services.Request]=#[]
  let filling:#[~services.Filling]=#[]
  let answers:#[~services.Answer]=#[]
  let statuses:#[~U32]=#[]
  let payload:#[~F32]=#[]
  let state=services.access next outbox waiting filling answers statuses payload
  state := services.idle state 6
  return run (own state)
func with_frame run =>
  let settings=#[render.defaults]
  let draws:#[~render.Draw]=#[]
  let solids:#[~render.Solid]=#[]
  let decals:#[~render.Decal]=#[]
  let sprites:#[~render.Sprite]=#[]
  let insets:#[~render.Inset]=#[]
  let fields:#[~render.Field]=#[]
  let poses:#[~render.Pose]=#[]
  let bone_matrices:#[~render.BoneMatrix]=#[]
  let morph_weights:#[~render.MorphWeight]=#[]
  let motions:#[~render.Motion]=#[]
  let lights: #[~render.PointLight] = #[]
  let emitters:#[~render.Emitter]=#[]
  let ribbons:#[~render.RibbonPoint]=#[]
  let extensions:#[~render.Extension]=#[]
  let updates:#[~render.Instance]=#[]
  let removed:#[~U32]=#[]
  return run ($render.FrameAccess {settings,draws,solids,decals,sprites,insets,fields,poses,bone_matrices,morph_weights,motions,lights,emitters,ribbons,extensions,updates,removed})
entry func frame_packet (count:U32) => with_services (func state => with_frame (func frame =>
  for index in 0 .. count:
    let matrix=math.Mat4.identity
    matrix.wx := U32.to_f32 index
    render.push ($render.Draw {mesh:index,material:1,matrix,parameters:$Nothing,extra:&render.no_extra[0..0]}) frame
  let sounds:#[~sound.Sound]=#[]
  let voices:#[~sound.Voice]=#[]
  let buses=copy sound.mix_start
  let listener:#[~sound.Listener]=#[]
  let panners:#[~sound.Panner]=#[]
  let audio=sound.read ($sound.Access {sounds,voices,buses,listener,panners})
  let nodes:#[tree.Node]=#[]
  let requested:#[services.Request]=#[]
  let text_scratch:#[~F32]=#[]
  let encoded:#[~F32]=#[]
  let requests=persist.requests ()
  let encoded=host.encode_frame 3 requests audio kept (&nodes[0..0]) (render.finish frame) (&requested[0..0]) state text_scratch encoded
  let sum=0.0
  for index in 0 .. count:
    sum := self+encoded[protocol.packet_header_floats+index*protocol.draw_floats]
  return #[U32.to_f32 encoded.length,encoded[3],sum]))

entry func decoded_events (count: U32) =>
  let values = array.generate (count*5) (func lane => case lane%5 of
    0 => 1.0
    1 => U32.to_f32 (lane/5+65)
    _ => 0.0)
  let decoded = pen_events.decode_events values 0 count
  let sum = 0
  for event in decoded:
    if let $events.KeyDown code = event:
      sum := self + code
  return #[decoded.length, sum]

entry func commands (count:U32) =>
  let values=#[1.0,4.0,...array.generate count U32.to_f32]
  let incoming:#[~F32]=#[]
  let outgoing:#[~F32]=#[]
  let acknowledge=func (state: own #[F32]) -> _ => state
  let host=func (packet:#[F32]) =>
    return if packet.length>=2 and packet[0]==4670544.0 then copy values else #[1.0,0.0]
  use result <- pen_program.run (func (state: own #[F32]) -> operation -> (payload:&[F32]) -> (out: own #[~F32]) =>
    state[0] := U32.to_f32 operation
    for value in payload:
      state[1] := self+value
    return (state, out)) acknowledge #[0.0,0.0] 3 false incoming outgoing host
  return #[result[0],result[1],if pen_program.valid_state values then 1.0 else 0.0]

entry func platform_codec (count:U32) =>
  let os=array.generate count (func index => 65+index%26)
  let locale=#[101,110]
  let device=#[112,99]
  let asked=#[1,2,3,4]
  let known= $pen_platform.Platform {os:&os[0..os.length],locale:&locale[0..locale.length],device:&device[0..device.length],deck:false,steam:services.unanswered,asked:&asked[0..asked.length]}
  let encoded=pen_platform.encode known
  let state=#[pen_platform.initial]
  let text:#[~U32]=#[]
  let requests:#[~U32]=#[]
  let access=pen_platform.access state text requests
  access := pen_platform.decode encoded access
  let restored=pen_platform.read access
  let sum=0
  for code in restored.os:
    sum := self+code
  return #[encoded.length,restored.os.length,sum,restored.asked.length]
entry func service_requests (count:U32) => with_services (func (state: own services.Services) =>
  for index in 0 .. count:
    state := pen_services.copy_text state #[65,index+65]
  let sum=0.0
  for request in state.outbox:
    let wired=host.wire_service state request
    sum := self+wired.values[1]
  return #[U32.to_f32 state.outbox.length,sum])

const word_a=#[65]
const word_percent=#[37]
const words = $pen_settings.Words {
  antialiasing: &word_a[0..1], render_scale: &word_a[0..1], filtering: &word_a[0..1], shadows: &word_a[0..1],
  occlusion: &word_a[0..1], sky: &word_a[0..1], fog: &word_a[0..1], volumetrics: &word_a[0..1], effects: &word_a[0..1], bloom: &word_a[0..1],
  master: &word_a[0..1], effects_volume: &word_a[0..1], music: &word_a[0..1], back: &word_a[0..1],
  off: &word_a[0..1], fxaa: &word_a[0..1], msaa: &word_a[0..1], msaa_fxaa: &word_a[0..1],
  linear: &word_a[0..1], trilinear: &word_a[0..1], anisotropic_4: &word_a[0..1], anisotropic_8: &word_a[0..1], anisotropic_16: &word_a[0..1],
  low: &word_a[0..1], medium: &word_a[0..1], high: &word_a[0..1], percent: &word_percent[0..1],
  handedness: &word_a[0..1], right_hand: &word_a[0..1], left_hand: &word_a[0..1],
}
entry func settings_controls (count: U32) =>
  let checksum = 0.0
  let controls = 0
  for index in 0 .. count:
    let state = kept
    state.volumes.master := U32.to_f32 (index % 100) * 0.01
    let labels:#[~U32]=#[]
    let options:#[~ &[U32]]=#[]
    let made = pen_settings.controls words pen_settings.audio state labels options
    controls := self + made.length
    if let $ui.Slider { value } = made[0]:
      checksum := self + value
  return #[U32.to_f32 controls, checksum]

entry func simulation_colliders (count: U32) =>
  let colliders = array.generate count (func index => simulation.place (simulation.ball 0.5) (math.vec3 (U32.to_f32 index) 0.0 0.0))
  let encoded = simulation.collider_values colliders
  let sum = 0.0
  for index in 0 .. count:
    sum := self + encoded[index * 11 + 4]
  return #[U32.to_f32 encoded.length, sum]
