// Frozen references from before the six library improvements.
import * as jobs from "ink/task_queue"
import * as changes from "ink/changes"
import * as array from "std/array"
import * as sort from "ink/sort"

// Explicit caller-owned invalidation. Removal wins within a batch; a later
// batch wins when composing. Reset discards every earlier retained value.
func unique (values: #[U32]) =>
  let ordered = true
  for i in 1 .. values.length:
    if values[i] <= values[i - 1]:
      ordered := false
      break
  if ordered:
    return values.copy
  let order = sort.order_u32 values
  let output = array.fill values.length 0
  let count = 0
  for at in order:
    let value = values[at]
    if count == 0 or output[count - 1] != value:
      output[count] := value
      count := self + 1
  return array.slice 0 count output
func contains (values: #[U32]) => func (value: U32) =>
  let low = 0
  let high = values.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if values[middle] < value:
      low := middle + 1
    else:
      high := middle
  return low < values.length and values[low] == value
func without (values: #[U32]) => func (excluded: #[U32]) =>
  if excluded.length == 0:
    return values.copy
  let out = array.fill values.length 0
  let count = 0
  for value in values:
    if not (contains excluded value):
      out[count] := value
      count := self + 1
  return array.slice 0 count out
// The reference keeps its original sort/without/concat algorithms. Only the
// output ownership boundary changes: two named destinations hold the delta.
func fixed values : #[U32] => array.generate values.length (func i => values.at i)
type Delta = changes.Changes [#[U32], #[U32]]
func make_into reset -> (updated: #[U32]) -> (removed: #[U32]) -> (out_updated: own #[U32]) -> (out_removed: own #[U32]) : Delta =>
  let removed = unique removed
  let updated = without (unique updated) removed
  @storage.truncate out_updated 0
  @storage.truncate out_removed 0
  for value in updated:
    @storage.push out_updated value
  for value in removed:
    @storage.push out_removed value
  return $changes.Changes {reset, updated: out_updated, removed: out_removed}
func affected (change: changes.Changes [u, r]) =>
  let updated = fixed change.updated
  let removed = fixed change.removed
  if removed.length == 0:
    return unique updated
  if updated.length == 0:
    return unique removed
  return unique (array.concat updated removed)
func compose_into (earlier: changes.Changes [eu, er]) -> (later: changes.Changes [lu, lr]) -> (out_updated: own #[U32]) -> (out_removed: own #[U32]) : Delta =>
  if later.reset:
    return make_into true (fixed later.updated) (fixed later.removed) out_updated out_removed
  let touched = affected later
  return make_into earlier.reset (array.concat (without (fixed earlier.updated) touched) (fixed later.updated))
    (array.concat (without (fixed earlier.removed) touched) (fixed later.removed)) out_updated out_removed

// Apply a membership delta to sorted unique keys. This is also an explicit
// active set: updated wakes keys, removed sleeps them, and reset starts empty.
// Full-width keys have no reserved sentinel. The old set remains a snapshot.
func apply (change: changes.Changes [u, r]) -> (before: #[U32]) =>
  let updated: #[U32] = #[]
  let removed: #[U32] = #[]
  let delta = make_into change.reset (fixed change.updated) (fixed change.removed) updated removed
  let kept = if delta.reset then #[] else without before (fixed delta.removed)
  let out = array.fill (kept.length + delta.updated.length) 0
  let left = 0
  let right = 0
  let count = 0
  for 0 .. out.length:
    if left == kept.length and right == delta.updated.length:
      break
    let value = 0
    if right == delta.updated.length:
      value := kept[left]
      left := self + 1
    else:
      if left == kept.length:
        value := delta.updated[right]
        right := self + 1
      else:
        value := min kept[left] delta.updated[right]
        if kept[left] == value:
          left := self + 1
        if delta.updated[right] == value:
          right := self + 1
    out[count] := value
    count := self + 1
  return array.slice 0 count out

func encode_queue encode_request -> encode_value -> encode_local -> (queue: jobs.Queue [request, value, local]) -> (meta: jobs.Metadata) =>
  let words: #[U32] = #[1, meta[0], meta[1], meta[2], meta[3], meta[4], queue.length]
  for job in queue:
    let request = encode_request job.request
    let local = encode_local job.continuation
    let tag = case job.state of
      $jobs.Pending => 0
      $jobs.Ready {outcome} => case outcome of
        $jobs.Value _ => 1
        $jobs.Failed _ => 2
        $jobs.Cancelled _ => 3
    let tick = case job.state of
      $jobs.Pending => 0
      $jobs.Ready {tick} => tick
    let value: #[U32] = case job.state of
      $jobs.Pending => #[]
      $jobs.Ready {outcome} => case outcome of
        $jobs.Value value => encode_value value
        $jobs.Failed reason => #[reason]
        $jobs.Cancelled reason => #[reason]
    // Preserve the reference's full-prefix copy on every job, using one named
    // destination rather than carrying a fresh owner through loop state.
    let prefix = copy words
    @storage.truncate words 0
    for word in prefix:
      @storage.push words word
    for word in #[job.ticket.sequence, job.submitted, job.earliest, tag, tick, request.length, local.length, value.length]:
      @storage.push words word
    for word in request:
      @storage.push words word
    for word in local:
      @storage.push words word
    for word in value:
      @storage.push words word
  return words

func unpack (capacity: U32) => func (payload: #[F32]) : Maybe (#[U32]) =>
  if payload.length < 2 or payload.length % 2 != 0:
    return $Nothing
  for value in payload:
    if not (is_finite value) or value < 0.0 or value > 65535.0 or floor value != value:
      return $Nothing
  let count = F32.to_u32 payload[0] | (F32.to_u32 payload[1] << 16)
  let size = (payload.length - 2) / 2
  if count > size or (capacity == 0 and count != size) or (capacity != 0 and size != capacity):
    return $Nothing
  for i in 2 + count * 2 .. payload.length:
    if payload[i] != 0.0:
      return $Nothing
  return $Some (array.generate count (func i => F32.to_u32 payload[2 + i * 2] | (F32.to_u32 payload[3 + i * 2] << 16)))

