import * as array from "std/array"
import * as jobs from "ink/task_queue"
import * as ecs from "ink/ecs"
import * as journal from "ink/journal"
import * as messages from "ink/messages"
import * as pages from "ink/pages"
import * as schedule from "ink/schedule"
import * as old from "./followup_reference"
import * as map from "ink/map"
import * as scene from "ink/scene"
import * as physics from "ink/physics"
import * as math from "ink/math"

const constructing = func build -> count => return do:
  let entries = array.generate count (func i => return (i * 2654435761, i * 3))
  let table = build map.u32 entries
  return array.generate count (func i => return Maybe.unwrap_or 0xFFFFFFFF (map.get map.u32 (i * 2654435761) table))
entry const map_before = constructing old.from_map
entry const map_after = constructing map.from
const editing_map = func edit -> count => return do:
  let original = map.from map.u32 (array.generate count (func i => return (i * 2654435761, i)))
  let current = original
  for step in 0 .. 16:
    let edits = array.generate (count / 8) (func i => return (i * 8 * 2654435761, if i % 2 == 0 then $Nothing else $Some (i * 8 + step + 1)))
    current := edit map.u32 edits self
  return array.concat #[Maybe.unwrap_or 0xFFFFFFFF (map.get map.u32 0 original), map.count current]
    (array.generate count (func i => return Maybe.unwrap_or 0xFFFFFFFF (map.get map.u32 (i * 2654435761) current)))
entry const map_edits_before = editing_map old.edit_map
entry const map_edits_after = editing_map map.edit_many
const broad = func indexed -> dense -> count => return do:
  let sources = array.generate (count + 8) (func i => return do:
    let x = if dense then 0.0 else U32.to_f32 (i % count % 128) * 4.0
    let z = if dense then 0.0 else U32.to_f32 (i % count / 128) * 4.0
    let s = scene.sphere (i + 1) (math.vec3 x (if i < count then 0.0 else 0.9) z) 0.5
    return if i < count then s else scene.dynamic s)
  let sc = scene.build sources
  let proxies = scene.proxies sc
  let movers = physics.mover_ids proxies
  let grow = array.fill movers.length 0.04
  let by_id = array.generate proxies.length identity
  let found = #[]
  let total = 0
  for step in 0 .. 16:
    let active = array.generate proxies.length (func i => return if i >= count and (step % 2 == 0 or i % 2 == 0) then 1.0 else 0.0)
    let pairs = if indexed then physics.broad_phase_indexed sc.index proxies movers grow active else physics.broad_phase proxies movers grow active
    found := physics.canonical_pairs proxies by_id pairs
    total := self + found.length
  return array.concat #[total] found
entry const broad_before = broad false false
entry const broad_after = broad true false
entry const broad_dense_before = broad false true
entry const broad_dense_after = broad true true

const queue = func count => return do:
  let q: jobs.Queue [U32, U32, U32] = jobs.make 1 count false
  q.next := count + 1
  q.tick := 1
  q.jobs := array.generate count (func i => return $jobs.Job {ticket: $jobs.Ticket {epoch: 1, sequence: i + 1}, submitted: 0, earliest: 1,
    request: i, continuation: i * 3, state: $jobs.Ready {tick: 1, outcome: case i % 3 of
      0 => $jobs.Value (i * 5)
      1 => $jobs.Failed (i * 7)
      _ => $jobs.Cancelled (i * 11)}})
  return q
const encode = jobs.encode (func i => return #[i]) (func i => return #[i]) (func i => return #[i])
const decode_one = func (words: Array U32) => return if words.length == 1 then $Some words[0] else $Nothing
const decoding = func decode -> count => return do:
  let packet = encode (queue count)
  let $Some result = decode count false decode_one decode_one decode_one packet else:
    return @panic "valid queue rejected"
  return encode result
entry const decode_before = decoding old.decode
entry const decode_after = decoding jobs.decode
const publication = func publish -> count => return do:
  let original = queue count
  let (next, delivered) = publish 1 original
  return array.concat #[next.jobs.length, next.tick, delivered.length, original.jobs.length] (array.flatten (array.map (func (d: jobs.Delivery [U32,U32]) => return do:
    let (tag, value) = case d.outcome of
      $jobs.Value value => (1, value)
      $jobs.Failed reason => (2, reason)
      $jobs.Cancelled reason => (3, reason)
    return #[d.ticket.sequence, d.ticket.epoch, d.continuation, tag, value]) delivered))
entry const publish_before = publication old.publish
entry const publish_after = publication jobs.publish
const journaling = func change -> count => return do:
  let before: ecs.Column U32 = $ecs.Column {revision: 7, structure: 11, journal: $Some (journal.empty 1 count), values: #[], masks: array.fill ((count + 31) / 32) 0xFFFFFFFF, occupied: #[]}
  let next = before
  next.masks := array.fill before.masks.length 0x55555555
  let result = change before next (array.generate count identity)
  let $Some journal = result.journal else:
    return @panic "missing journal"
  let $messages.Items {values} = messages.read (messages.beginning journal.log) journal.log else:
    return @panic "missing entries"
  return array.concat #[result.revision, result.structure, before.revision, before.structure] (array.flatten (array.map (func entry => return case entry of
    $journal.Added id => #[1, id]
    $journal.Updated id => #[2, id]
    $journal.Removed id => #[3, id]
    $journal.Replaced => #[4, 0]) values))
entry const journal_before = journaling old.changed_column
entry const journal_after = journaling ecs.changed_column
const editing = func update -> stride -> count => return do:
  let original = pages.from (array.generate count identity)
  let stored = original
  let dirty = array.generate (count / stride) (func i => return i * stride)
  for step in 0 .. 16:
    stored := update count dirty (func i => return i + (step + 1) * 100000) self
  return array.concat #[pages.get original 0, pages.get original (count - 1), stored.count] (pages.flatten stored)
entry const sparse_before = editing old.update_pages 64
entry const sparse_after = editing pages.update 64
entry const dense_before = editing old.update_pages 1
entry const dense_after = editing pages.update 1

const scheduling = func prepared -> count => return do:
  let plan = $schedule.Plan {
    dependencies: array.generate count (func i => return if i < 16 then #[] else #[i - 16]),
    waves: array.generate ((count + 15) / 16) (func wave => return array.generate (min 16 (count - wave * 16)) (func slot => return wave * 16 + slot))}
  let $Some order = schedule.prepare plan else:
    return @panic "valid schedule rejected"
  let result = 0
  for tick in 0 .. 64:
    result := Maybe.unwrap_or 0xFFFFFFFF (if prepared then ($Some (schedule.execute_prepared order result (func i -> _ => return i) (func state -> _ -> delta => return state + delta)))
      else old.execute_plan plan result (func i -> _ => return i) (func state -> _ -> delta => return state + delta))
  return #[result]
entry const schedule_before = scheduling false
entry const schedule_after = scheduling true

