// Benchmark workload covering i18n, headless UI widgets (controls, tabs,
// listbox, overlay, text_input), RTL layout and Testing-Library role queries.
import * as i18n from "ink/i18n"
import * as keys from "ink/input/keys"
import * as ui from "ink/ui"
import * as layout from "ink/ui/layout"
import * as tree from "ink/ui/tree"
import * as vocabulary from "ink/ui/vocabulary"
import * as testing from "ink/ui/testing"
import * as controls from "ink/ui/headless/controls"
import * as tabs from "ink/ui/headless/tabs"
import * as listbox from "ink/ui/headless/listbox"
import * as overlay from "ink/ui/headless/overlay"
import * as text_input from "ink/ui/headless/text_input"
import * as window from "ink/events"

#entry func ui_headless_batch (size: U32) : #[F32] =>
  let en = #[101, 110]
  let ru = #[114, 117]
  let ar = #[97, 114]
  let plural_sum = 0
  for i in 0 .. size:
    let c = U32.to_f32 i
    plural_sum := self + i18n.plural_cardinal en c + i18n.plural_cardinal ru c + i18n.plural_cardinal ar c
  // Build semantic tree for `size` headless controls + tabs + listbox + toasts + text input.
  let pool: #[U32] = #[73, 116, 101, 109] // "Item"
  let item_span = $tree.Span { start: 0, count: 4 }
  let pview = &pool[0..4]
  let labels: #[U32] = #[]
  let nodes: #[tree.StoredNode] = #[]
  let box_r = $ui.Rect { x: 0.0, y: 0.0, width: 120.0, height: 32.0 }
  for i in 0 .. size:
    let cb = controls.make_checkbox (1000 + i) 0 item_span (if i % 2 == 0 then controls.check_checked else controls.check_unchecked) false
    let (nl, nn) = controls.checkbox_declare cb box_r pview labels nodes
    labels := nl
    nodes := nn
  let tab_items = #[
    $tabs.TabItem { id: 10, panel_id: 20, label: item_span, disabled: false },
    $tabs.TabItem { id: 11, panel_id: 21, label: item_span, disabled: false },
  ]
  let tab_rects = #[box_r, box_r]
  let tstate = $tabs.Tabs { id: 9, parent: 0, label: item_span, selected: 0, focused: 0, automatic: true, vertical: false, rtl: false }
  let (tstate, _) = tabs.tabs_handle (&tab_items[0..2]) (&tab_rects[0..2]) tstate true ($window.KeyDown keys.right)
  let (labels, nodes) = tabs.tabs_declare (&tab_items[0..2]) (&tab_rects[0..2]) box_r box_r tstate pview labels nodes
  let lb_opts: #[listbox.OptionItem] = #[
    $listbox.OptionItem { id: 31, label: item_span, disabled: false, selected: false },
    $listbox.OptionItem { id: 32, label: item_span, disabled: false, selected: true },
  ]
  let lb = $listbox.Listbox {
    id: 30, parent: 0, trigger_id: 0, label: item_span, active: 0, open: true, popup: false, multi: false,
    page_size: 4, scroll_y: 0.0, row_height: 32.0, viewport_height: 128.0, typeahead_timer: 0.0,
  }
  let (labels, nodes) = listbox.listbox_declare box_r box_r (&tab_rects[0..2]) lb (&lb_opts[0..2]) pview labels nodes
  let toasts: #[overlay.Toast] = #[]
  let toasts = overlay.toast_push 41 item_span 2.0 false toasts
  let toasts = overlay.toast_tick 0.5 toasts
  let (labels, nodes) = overlay.toast_declare 0 ($overlay.ToastConfig { max_visible: 4, default_duration: 2.0 }) (&tab_rects[0..1]) (&toasts[0..1]) pview labels nodes
  let ti = text_input.make_text_input 50 0 item_span 32
  let tbuf: #[U32] = #[]
  let (ti, tbuf, _) = text_input.text_handle true ti tbuf ($window.TextInput { character: 65, composing: 0 })
  let (labels, nodes) = text_input.text_declare ti (&tbuf[0..tbuf.length]) box_r pview labels nodes
  let lview = &labels[0..labels.length]
  let nview = &nodes[0..nodes.length]
  let checked_boxes = testing.query_all (testing.with_checked controls.check_checked (testing.by_role vocabulary.role_checkbox)) (&tree.no_text[0..0]) lview nview
  let findings = testing.audit_tree lview nview
  let rtl_boxes = layout.layout_flex_dir true ($layout.Box { x: 0.0, y: 0.0, width: 400.0, height: 40.0 }) ($layout.Container {
    direction: $layout.Row, justify: $layout.Start, align: $layout.AlignStart,
    gap: 8.0, pad_left: 0.0, pad_top: 0.0, pad_right: 0.0, pad_bottom: 0.0,
  }) #[
    $layout.Item { basis: 100.0, cross: 32.0, min_main: 0.0, max_main: 0.0, grow: 0.0, shrink: 0.0 },
    $layout.Item { basis: 100.0, cross: 32.0, min_main: 0.0, max_main: 0.0, grow: 0.0, shrink: 0.0 },
  ]
  return #[
    U32.to_f32 size,
    U32.to_f32 checked_boxes.length,
    U32.to_f32 findings.length,
    U32.to_f32 plural_sum,
    rtl_boxes[0].x,
  ]
