import * as array from "std/array"
import * as jobs from "ink/task_queue"
const encode = jobs.encode (func (i: U32) => return #[i]) (func (i: U32) => return #[i]) (func (i: U32) => return #[i])
const work = func bulk -> (count: U32) => return do:
  let values = array.generate count identity
  let queue: jobs.Queue [U32,U32,U32] = jobs.empty ()
  let meta = jobs.metadata 1 count false
  let history: ResizeArray jobs.Mark = #[]
  if bulk:
    let $Some tickets = jobs.submit_many 1 1 values (array.map (func i => return i * 3) values) queue meta history else:
      return @panic "bulk submission rejected"
  else:
    for i in values:
      let $Some ticket = jobs.submit 1 1 i (i * 3) queue meta history else:
        return @panic "individual submission rejected"
  return encode queue meta
entry const individual = func (count: U32) : Array U32 => return work false count
entry const bulk = func (count: U32) : Array U32 => return work true count
