import * as array from "std/array"
import * as jobs from "ink/task_queue"
const encode = jobs.encode (fn (i: U32) => #[i]) (fn (i: U32) => #[i]) (fn (i: U32) => #[i])
const work = fn bulk (count: U32) => do:
  let values = array.generate count identity
  let queue: jobs.Queue [U32,U32,U32] = jobs.make 1 count #False
  if bulk:
    let #Some (next, tickets) = jobs.submit_many 1 1 values (array.map (fn i => i * 3) values) queue else:
      return @panic "bulk submission rejected"
    queue := next
  else:
    for i in values:
      let #Some (next, ticket) = jobs.submit 1 1 i (i * 3) queue else:
        return @panic "individual submission rejected"
      queue := next
  return encode queue
entry const individual = work #False
entry const bulk = work #True
