import * as array from "std/array"
import * as jobs from "ink/task_queue"
const encode = jobs.encode (func (i: U32) => #[i]) (func (i: U32) => #[i]) (func (i: U32) => #[i])
func work bulk -> (count: U32) =>
  let values = array.generate count identity
  let queue: jobs.Queue [U32,U32,U32] = jobs.empty ()
  let meta = jobs.metadata 1 count false
  let history: #[jobs.Mark] = #[]
  if bulk:
    let (found, submitted_queue, submitted_meta, submitted_history) = jobs.submit_many 1 1 values (array.map (func i => i * 3) values) queue meta history
    queue := submitted_queue
    meta := submitted_meta
    history := submitted_history
    let $Some tickets = found else:
      return panic "bulk submission rejected"
  else:
    for i in values:
      let (found, submitted_queue, submitted_meta, submitted_history) = jobs.submit 1 1 i (i * 3) queue meta history
      queue := submitted_queue
      meta := submitted_meta
      history := submitted_history
      let $Some ticket = found else:
        return panic "individual submission rejected"
  return encode queue meta
entry func individual (count: U32) : #[U32] => work false count
entry func bulk (count: U32) : #[U32] => work true count
