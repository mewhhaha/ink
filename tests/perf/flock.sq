import { Vec3 } from "std/vector"
import * as math from "ink/math"
import * as steering from "ink/ai/steering"

const rules = $steering.Flocking { goal: 0.0, alignment: 1.0, cohesion: 0.0, separation: 0.0, force: 100.0, speed: 100.0, turn: pi, stray: pi }

func measure (positions: #[Vec3]) => func (velocities: #[Vec3]) => func (radius: F32) =>
  let groups = @array.generate positions.length (func (_: U32) => 0)
  return steering.with_flock 3.0 positions velocities groups (func (members:steering.Flock) =>
    let neighbours = 0.0
    let headings = 0.0
    let speeds = 0.0
    let pushes = 0.0
    for i in 0..positions.length:
      let near = steering.neighbourhood members i radius 1.0 8
      let output = steering.flocking rules positions[i] velocities[i] velocities[i] near 1.0
      neighbours := self + U32.to_f32 near.count
      headings := self + near.hx
      speeds := self + output.length
      pushes := self + (steering.push near).length
    return #[neighbours, headings, speeds, pushes])

// 32 columns; radius includes only the four immediate grid neighbours.
io sparse (count: U32) =>
  let positions = @array.generate count (func (i: U32) => math.vec3 (U32.to_f32 (i % 32) * 3.0) 0.0 (U32.to_f32 (i / 32) * 3.0))
  let velocities = @array.generate count (func (_: U32) => math.vec3 1.0 0.0 0.0)
  return measure positions velocities 3.1

// One cell and all coincident: a budget of eight must stop reading the crowd.
io dense (count: U32) =>
  let positions = @array.generate count (func (_: U32) => math.zero3)
  let velocities = @array.generate count (func (i: U32) => math.vec3 (U32.to_f32 (i % 8 + 1)) 0.0 0.0)
  return measure positions velocities 3.1

// A second occupied row must not contribute after the first row fills the budget.
io row_budget (most: U32) =>
  let positions = @array.generate 64 (func (i: U32) => math.vec3 (U32.to_f32 (i % 32) * 0.01) 0.0 (U32.to_f32 (i / 32)))
  let velocities = @array.generate 64 (func (i: U32) => math.vec3 (U32.to_f32 i) 0.0 0.0)
  let groups = @array.generate 64 (func (_: U32) => 0)
  return steering.with_flock 1.0 positions velocities groups (func members =>
    let near = steering.neighbourhood members 0 4.0 0.0 most
    return #[U32.to_f32 near.count, near.hx, near.cx, near.cz])

// The normal caller-owned next snapshot writes a fresh array while querying.
io dense_outputs (count: U32) =>
  let positions = @array.generate count (func (_: U32) => math.zero3)
  let velocities = @array.generate count (func (i: U32) => math.vec3 (U32.to_f32 (i % 8 + 1)) 0.0 0.0)
  let groups = @array.generate count (func (_: U32) => 0)
  return steering.with_flock 3.0 positions velocities groups (func (members:steering.Flock) =>
    let outputs = @array.generate count (func (i: U32) =>
      let near = steering.neighbourhood members i 3.1 1.0 8
      return steering.flocking rules positions[i] velocities[i] velocities[i] near 1.0)
    let speeds = 0.0
    for velocity in outputs:
      speeds := self + velocity.length
    return #[U32.to_f32 outputs.length, speeds])
