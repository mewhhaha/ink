import { Vec3 } from "std/vector"
import { Vec4 } from "ink/math"
import * as shapes from "ink/shapes"

// Return full face topology, then closest point witnesses for supplied points.
entry const hull = func (input: Array F32) : Array F32 => return do:
  let count = F32.to_u32 input[0]
  let planes = @array.generate count (func (i: U32) => return do:
    let at = 1 + i * 4
    return $Vec4 { x: input[at], y: input[at + 1], z: input[at + 2], w: input[at + 3] })
  let geometry = shapes.geometry ()
  let $Some poly = shapes.hull_poly geometry (&planes[0..planes.length]) else:
    return #[]
  let output: List F32 = [U32.to_f32 poly.verts.length, U32.to_f32 poly.planes.length, U32.to_f32 poly.ea.length]
  for v in poly.verts:
    output := [...self, v.x, v.y, v.z]
  for i in 0..poly.planes.length:
    let p = poly.planes[i]
    output := [...self, p.x, p.y, p.z, p.w, U32.to_f32 poly.rings[i].length]
    for ring_index in 0 .. poly.rings[i].length:
      let id = shapes.ring_vertex poly poly.rings[i] ring_index
      output := [...self, U32.to_f32 id]
  let start = 1 + count * 4
  for i in 0..((input.length - start) / 3):
    let at = start + i * 3
    let p = $Vec3 { x: input[at], y: input[at + 1], z: input[at + 2] }
    let gap = shapes.segment_gap ($shapes.Hull poly) p p
    output := [...self, gap.dist, gap.normal.x, gap.normal.y, gap.normal.z, gap.on_shape.x, gap.on_shape.y, gap.on_shape.z]
  return Array.from_list output
