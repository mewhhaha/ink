import * as array from "std/array"
import * as map from "ink/map"
import * as set from "ink/set"
import * as relations from "ink/relations"
import * as pages from "ink/pages"
import * as grid from "ink/spatial/point_grid"
import * as math from "ink/math"
import * as ecs from "ink/ecs"
import * as sort from "ink/sort"

type Counter is data = #Counter U32
const sim = do:
  let builder = ecs.new ()
  builder := ecs.register_component (#Counter 0) self
  break ecs.build builder
const number = fn x => case x of
  #Some (#Counter n) => n
  _ => 0xFFFFFFFF
entry const point_grid_build = fn (count: U32) => do:
  let positions = array.generate count (fn i => math.vec3 (U32.to_f32 (i % 128)) 0.0 (U32.to_f32 (i / 128)))
  let result = grid.build 1.0 count positions
  return array.concat (pages.flatten result.heads) (array.flatten (array.map (fn (p: grid.Point) =>
    #[F32.to_u32 p.x, F32.to_u32 p.z, F32.to_u32 p.cx, F32.to_u32 p.cz, p.next]) (pages.flatten result.points)))
entry const set_build = fn (count: U32) => do:
  let keys = array.generate count (fn i => i * 2654435761)
  let result = set.from set.u32 keys
  let values = set.values result
  let order = sort.order_u32 values
  return array.concat #[set.count result] (array.map (fn i => values[i]) order)
entry const relation_remove = fn (count: U32) => do:
  let ids = array.generate count identity
  let before = #relations.Relations {
    forward: map.from map.u32 (array.generate (count + 1) (fn i => (i, #relations.Edge {target: if i == count then 9 else 7, slot: if i == count then 0 else i}))),
    inverse: map.from map.u32 #[(7, pages.from ids), (9, pages.from #[count])]}
  let after = relations.remove_target map.u32 map.u32 7 before
  return array.concat #[map.count after.forward, map.count after.inverse, map.count before.forward]
    (array.concat (relations.sources map.u32 7 before) (relations.sources map.u32 9 after))
const index_work = fn dense (count: U32) => do:
  let view: ecs.ReadView U32 = #ecs.ReadView {count: count * 32, bits: array.fill count 0xFFFFFFFF,
    masks: array.generate count (fn i => if dense then 0xFFFFFFFF else 1 << (i % 32)),
    occupied: array.generate count identity, values: #[]}
  return ecs.indices view
entry const indices_sparse = index_work #False
entry const indices_dense = index_work #True
entry const ecs_payload_edits = fn (count: U32) => do:
  let (_, output) = ecs.create sim (fn () => do:
    use first <- ecs.spawn_many count
    use ecs.insert_many #Counter first (array.generate count (fn i => #Counter i))
    use before <- ecs.view #Counter
    for step in 0 .. 16:
      use ecs.edit_selected #Counter #[0, count / 2, count - 1] #[#Some (#Counter (1000 + step)), #Some (#Counter (2000 + step)), #Some (#Counter (3000 + step))]
    use after <- ecs.view #Counter
    return #[number (ecs.read before 0), number (ecs.read before (count / 2)), number (ecs.read before (count - 1)),
      number (ecs.read after 0), number (ecs.read after (count / 2)), number (ecs.read after (count - 1)),
      before.occupied.length, after.occupied.length, (ecs.indices after).length])
  return output
entry const ecs_membership_edits = fn (count: U32) => do:
  let (_, output) = ecs.create sim (fn () => do:
    use ecs.spawn_many count
    use ecs.insert_selected #Counter #[0, count / 2, count - 1] #[#Counter 0, #Counter 1, #Counter 2]
    use before <- ecs.view #Counter
    for step in 0 .. 16:
      let next = if step % 2 == 0 then #Nothing else #Some (#Counter (step + 10))
      use ecs.edit_selected #Counter #[0, count / 2, count - 1] #[next, next, next]
    use after <- ecs.view #Counter
    return array.concat #[before.occupied.length, after.occupied.length, number (ecs.read before 0), number (ecs.read after 0)] (ecs.indices after))
  return output
entry const ecs_dense_edits = fn (count: U32) => do:
  let (_, output) = ecs.create sim (fn () => do:
    use first <- ecs.spawn_many count
    use ecs.insert_many #Counter first (array.generate count (fn i => #Counter i))
    use before <- ecs.view #Counter
    let ids = array.generate count identity
    for step in 0 .. 4:
      use ecs.edit_selected #Counter ids (array.generate count (fn i => #Some (#Counter (i + step + 1))))
    use after <- ecs.view #Counter
    return #[number (ecs.read before 0), number (ecs.read before (count - 1)), number (ecs.read after 0),
      number (ecs.read after (count - 1)), before.occupied.length, after.occupied.length, (ecs.indices after).length])
  return output
