import * as array from "std/array"
import * as map from "ink/map"
import * as set from "ink/set"
import * as relations from "ink/relations"
import * as grid from "ink/spatial/point_grid"
import * as math from "ink/math"
import * as ecs from "ink/ecs"
import * as sort from "ink/sort"
import * as changes from "ink/changes"
type Counter is data = $Counter U32
func number x => case x of
  $Some ($Counter n) => n
  _ => 0xFFFFFFFF
entry func point_grid_build (count:U32) =>
  let positions=array.generate count (func i => math.vec3 (U32.to_f32 (i%128)) 0.0 (U32.to_f32 (i/128)))
  let heads:#[~U32]=#[]
  let points:#[~grid.Point]=#[]
  let storage= $grid.Storage {heads,points}
  let stored=grid.build_into storage $Nothing 1.0 count positions
  let result=grid.read storage stored
  let output:#[+U32]=#[]
  for value in result.heads:
    @storage.push output value
  for p in result.points:
    for value in #[F32.to_u32 p.x,F32.to_u32 p.z,F32.to_u32 p.cx,F32.to_u32 p.cz,p.next]:
      @storage.push output value
  return seal output
entry func set_build (count:U32) =>
  let keys=array.generate count (func i => i*2654435761)
  let result:set.Set U32=set.empty ()
  let slots=set.buckets ()
  set.from set.u32 keys result slots
  let values=set.values result
  let order=sort.order_u32 values
  return array.concat #[set.count slots] (array.map (func i => values[i]) order)
entry func relation_remove (count:U32) =>
  let before:relations.Relations [U32,U32]=relations.empty ()
  let before_slots=relations.buckets ()
  for i in 0 .. count+1:
    relations.link map.u32 i (if i==count then 9 else 7) before before_slots
  let after:relations.Relations [U32,U32]=relations.empty ()
  let after_slots=relations.buckets ()
  relations.copy_into map.u32 identity identity after after_slots before
  relations.remove_target map.u32 map.u32.equal 7 after after_slots
  // Incoming groups are a logical target count; storage is one named forward map.
  let targets=changes.unique (map.values after)
  return array.concat #[map.count after_slots,targets.length,map.count before_slots]
    (array.concat (relations.sources map.u32.equal 7 before) (relations.sources map.u32.equal 9 after))
func index_work dense -> (count:U32) =>
  let alive=ecs.entities ()
  let entity_meta=ecs.metadata 1
  let values:ecs.Pool U32=ecs.pool ()
  let meta=ecs.metadata 1
  for id in 0 .. count*32:
    ecs.spawn alive entity_meta
    if dense or id%32==(id/32)%32:
      ecs.insert alive values meta id id
  return ecs.indices alive values
entry func indices_sparse (count:U32) => index_work false count
entry func indices_dense (count:U32) => index_work true count
type Column={alive:ecs.Entities,values:ecs.Pool Counter,meta:ecs.Metadata}
func with_column count -> run =>
  let alive=ecs.entities ()
  let entity_meta=ecs.metadata 1
  let values:ecs.Pool Counter=ecs.pool ()
  let meta=ecs.metadata 1
  ecs.spawn_many alive entity_meta count
  return run {alive,values,meta}
// Retain the original observable: number of occupied 32-entity membership groups.
func occupied alive -> values => (changes.unique (array.map (func id => id>>5) (ecs.indices alive values))).length
entry func ecs_payload_edits (count:U32) => with_column count (func (column:Column) =>
  ecs.insert_selected column.alive column.values column.meta (array.generate count identity) (array.generate count (func i => $Counter i))
  let before:ecs.Pool Counter=ecs.pool ()
  ecs.copy_into identity before column.values
  for step in 0 .. 16:
    ecs.insert_selected column.alive column.values column.meta #[0,count/2,count-1] #[$Counter (1000+step),$Counter (2000+step),$Counter (3000+step)]
  return #[number (ecs.read before 0),number (ecs.read before (count/2)),number (ecs.read before (count-1)),
    number (ecs.read column.values 0),number (ecs.read column.values (count/2)),number (ecs.read column.values (count-1)),
    occupied column.alive before,occupied column.alive column.values,(ecs.indices column.alive column.values).length])
entry func ecs_membership_edits (count:U32) => with_column count (func (column:Column) =>
  let ids=#[0,count/2,count-1]
  ecs.insert_selected column.alive column.values column.meta ids #[$Counter 0,$Counter 1,$Counter 2]
  let before:ecs.Pool Counter=ecs.pool ()
  ecs.copy_into identity before column.values
  for step in 0 .. 16:
    for id in ids:
      if step%2==0:
        ecs.remove column.values column.meta id
      else:
        ecs.insert column.alive column.values column.meta id ($Counter (step+10))
  return array.concat #[occupied column.alive before,occupied column.alive column.values,number (ecs.read before 0),number (ecs.read column.values 0)] (ecs.indices column.alive column.values))
entry func ecs_dense_edits (count:U32) => with_column count (func (column:Column) =>
  let ids=array.generate count identity
  ecs.insert_selected column.alive column.values column.meta ids (array.generate count (func i => $Counter i))
  let before:ecs.Pool Counter=ecs.pool ()
  ecs.copy_into identity before column.values
  for step in 0 .. 4:
    ecs.insert_selected column.alive column.values column.meta ids (array.generate count (func i => $Counter (i+step+1)))
  return #[number (ecs.read before 0),number (ecs.read before (count-1)),number (ecs.read column.values 0),number (ecs.read column.values (count-1)),
    occupied column.alive before,occupied column.alive column.values,(ecs.indices column.alive column.values).length])
