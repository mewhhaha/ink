import * as array from "std/array"
import * as map from "ink/map"
import * as set from "ink/set"

func source (count: U32) => array.generate count (func i => (i, i*3+1))
#entry func map_lookup (count: U32) =>
  let table: map.Map [U32,U32] = map.from map.u32 (source count) (map.empty ())
  let total = 0
  for i in 0 .. count*4:
    let $Some value = map.get map.u32 (i*17%count) table else:
      return panic "missing map key"
    total := self + value
  return #[map.count table, total]
#entry func linear_lookup (count: U32) =>
  let entries = source count
  let total = 0
  for i in 0 .. count*4:
    let key = i*17%count
    for pair in entries:
      let (stored, value) = pair
      if stored == key:
        total := self + value
        break
  return #[entries.length, total]
#entry func map_edits (count: U32) =>
  let before: map.Map [U32,U32] = map.from map.u32 (source count) (map.empty ())
  let after: map.Map [U32,U32] = map.copy_into map.u32 identity identity (map.empty ()) before
  for i in 0 .. count:
    after := map.set map.u32 i (i+10) after
  for i in 0 .. count/4:
    after := map.remove map.u32 (i*4) after
  for i in 0 .. count/4:
    after := map.set map.u32 (count+i) i after
  return #[map.count before, map.count after,
    map.fold (func total -> key -> value => total+value) 0 before,
    map.fold (func total -> key -> value => total+value) 0 after]
#entry func map_collisions (count: U32) =>
  let policy = map.key (func (key: U32) => 0) U32.eq
  let before: map.Map [U32,U32] = map.from policy (source count) (map.empty ())
  let after: map.Map [U32,U32] = map.copy_into policy identity identity (map.empty ()) before
  for i in 0 .. count/2:
    after := map.remove policy (i*2) after
  let total = 0
  for i in 0 .. count:
    let $Some value = map.get policy i before else:
      return panic "missing collided key"
    total := self + value
  return #[map.count before, map.count after, total,
    map.fold (func total -> key -> value => total+value) 0 after]
#entry func map_entries (count: U32) =>
  let table: map.Map [U32,U32] = map.from map.u32 (source count) (map.empty ())
  let total = 0
  let visited = 0
  for _ in 0 .. 4:
    for pair in map.entries table:
      let (_, value) = pair
      total := self + value
      visited := self + 1
  return #[visited, total]
#entry func set_algebra (count: U32) =>
  let a: set.Set U32 = set.from set.u32 (array.generate count identity) (set.empty ())
  let b: set.Set U32 = set.from set.u32 (array.generate count (func i => i + count/2)) (set.empty ())
  let combined: set.Set U32 = set.union set.u32 (map.copy_into map.u32 identity identity (set.empty ()) a) b
  let common: set.Set U32 = set.intersection set.u32 (map.copy_into map.u32 identity identity (set.empty ()) a) b
  let unique: set.Set U32 = set.difference set.u32 (map.copy_into map.u32 identity identity (set.empty ()) a) b
  return #[set.count combined,set.count common,set.count unique,
    set.fold (func total -> key => total+key) 0 combined,
    set.fold (func total -> key => total+key) 0 common,
    set.fold (func total -> key => total+key) 0 unique]
