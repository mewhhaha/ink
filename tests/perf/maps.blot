import * as array from "std/array"
import * as map from "ink/map"
import * as set from "ink/set"

const source = func (count: U32) => return array.generate count (func i => return (i, i*3+1))
entry const map_lookup = func (count: U32) => return do:
  let table = map.from map.u32 (source count)
  let total = 0
  for i in 0 .. count*4:
    let $Some value = map.get map.u32 (i*17%count) table else:
      return @panic "missing map key"
    total := self + value
  return #[map.count table, total]
entry const linear_lookup = func (count: U32) => return do:
  let entries = source count
  let total = 0
  for i in 0 .. count*4:
    let key = i*17%count
    for pair in entries:
      let (stored, value) = pair
      if stored == key:
        total := self + value
        break
  return #[entries.length, total]
entry const map_edits = func (count: U32) => return do:
  let before = map.from map.u32 (source count)
  let after = before
  for i in 0 .. count:
    after := map.set map.u32 i (i+10) self
  for i in 0 .. count/4:
    after := map.remove map.u32 (i*4) self
  for i in 0 .. count/4:
    after := map.set map.u32 (count+i) i self
  return #[map.count before, map.count after,
    map.fold (func total -> key -> value => return total+value) 0 before,
    map.fold (func total -> key -> value => return total+value) 0 after]
entry const map_collisions = func (count: U32) => return do:
  let policy = map.key (func (key: U32) => return 0) U32.eq
  let before = map.from policy (source count)
  let after = before
  for i in 0 .. count/2:
    after := map.remove policy (i*2) self
  let total = 0
  for i in 0 .. count:
    let $Some value = map.get policy i before else:
      return @panic "missing collided key"
    total := self + value
  return #[map.count before, map.count after, total,
    map.fold (func total -> key -> value => return total+value) 0 after]
entry const map_entries = func (count: U32) => return do:
  let table = map.from map.u32 (source count)
  let total = 0
  let visited = 0
  for _ in 0 .. 4:
    for pair in map.entries table:
      let (_, value) = pair
      total := self + value
      visited := self + 1
  return #[visited, total]
entry const set_algebra = func (count: U32) => return do:
  let a = set.from set.u32 (array.generate count identity)
  let b = set.from set.u32 (array.generate count (func i => return i + count/2))
  let combined = set.union set.u32 a b
  let common = set.intersection set.u32 a b
  let unique = set.difference set.u32 a b
  return #[set.count combined, set.count common, set.count unique,
    set.fold (func total -> key => return total+key) 0 combined,
    set.fold (func total -> key => return total+key) 0 common,
    set.fold (func total -> key => return total+key) 0 unique]
