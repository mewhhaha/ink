import * as array from "std/array"
import * as map from "ink/map"
import * as set from "ink/set"

const source = func (count: U32) => return array.generate count (func i => return (i, i*3+1))
entry const map_lookup = func (count: U32) => return do:
  let table: map.Map [U32,U32] = map.empty ()
  let slots = map.buckets ()
  map.from map.u32 (source count) table slots
  let total = 0
  for i in 0 .. count*4:
    let $Some value = map.get map.u32 (i*17%count) table slots else:
      return @panic "missing map key"
    total := self + value
  return #[map.count slots, total]
entry const linear_lookup = func (count: U32) => return do:
  let entries = source count
  let total = 0
  for i in 0 .. count*4:
    let key = i*17%count
    for pair in entries:
      let (stored, value) = pair
      if stored == key:
        total := self + value
        break
  return #[entries.length, total]
entry const map_edits = func (count: U32) => return do:
  let before: map.Map [U32,U32] = map.empty ()
  let before_slots = map.buckets ()
  map.from map.u32 (source count) before before_slots
  let after: map.Map [U32,U32] = map.empty ()
  let after_slots = map.buckets ()
  map.copy_into map.u32 identity identity after after_slots before
  for i in 0 .. count:
    map.set map.u32 i (i+10) after after_slots
  for i in 0 .. count/4:
    map.remove map.u32 (i*4) after after_slots
  for i in 0 .. count/4:
    map.set map.u32 (count+i) i after after_slots
  return #[map.count before_slots, map.count after_slots,
    map.fold (func total -> key -> value => return total+value) 0 before,
    map.fold (func total -> key -> value => return total+value) 0 after]
entry const map_collisions = func (count: U32) => return do:
  let policy = map.key (func (key: U32) => return 0) U32.eq
  let before: map.Map [U32,U32] = map.empty ()
  let before_slots = map.buckets ()
  map.from policy (source count) before before_slots
  let after: map.Map [U32,U32] = map.empty ()
  let after_slots = map.buckets ()
  map.copy_into policy identity identity after after_slots before
  for i in 0 .. count/2:
    map.remove policy (i*2) after after_slots
  let total = 0
  for i in 0 .. count:
    let $Some value = map.get policy i before before_slots else:
      return @panic "missing collided key"
    total := self + value
  return #[map.count before_slots, map.count after_slots, total,
    map.fold (func total -> key -> value => return total+value) 0 after]
entry const map_entries = func (count: U32) => return do:
  let table: map.Map [U32,U32] = map.empty ()
  let slots = map.buckets ()
  map.from map.u32 (source count) table slots
  let total = 0
  let visited = 0
  for _ in 0 .. 4:
    for pair in map.entries table:
      let (_, value) = pair
      total := self + value
      visited := self + 1
  return #[visited, total]
entry const set_algebra = func (count: U32) => return do:
  let a: set.Set U32 = set.empty ()
  let a_slots = set.buckets ()
  let b: set.Set U32 = set.empty ()
  let b_slots = set.buckets ()
  set.from set.u32 (array.generate count identity) a a_slots
  set.from set.u32 (array.generate count (func i => return i + count/2)) b b_slots
  let combined: set.Set U32 = set.empty ()
  let combined_slots = set.buckets ()
  let common: set.Set U32 = set.empty ()
  let common_slots = set.buckets ()
  let unique: set.Set U32 = set.empty ()
  let unique_slots = set.buckets ()
  map.copy_into map.u32 identity identity combined combined_slots a
  map.copy_into map.u32 identity identity common common_slots a
  map.copy_into map.u32 identity identity unique unique_slots a
  set.union set.u32 combined combined_slots b
  set.intersection set.u32 common common_slots b b_slots
  set.difference set.u32 unique unique_slots b
  return #[set.count combined_slots,set.count common_slots,set.count unique_slots,
    set.fold (func total -> key => return total+key) 0 combined,
    set.fold (func total -> key => return total+key) 0 common,
    set.fold (func total -> key => return total+key) 0 unique]
