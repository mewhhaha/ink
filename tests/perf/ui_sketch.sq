// Benchmark workload covering ink/ui/sketch immediate-mode Drawful UI.
import * as math from "ink/math"
import * as render from "ink/render"
import * as sketch from "ink/ui/sketch"

io ui_sketch_batch (size: U32) : #[F32] =>
  let s = sketch.init_state ()
  let ui = sketch.begin s (math.vec2 1280.0 720.0) 0.5 sketch.paper_theme
  ui := sketch.panel "BENCH" (math.vec4 16.0 16.0 340.0 680.0) self
  ui := sketch.heading "SKETCH" self
  for i in 0 .. size:
    if i % 3 == 0:
      let (_, next_ui) = sketch.button "ACT" ui
      ui := next_ui
    else:
      if i % 3 == 1:
        let (_, next_ui) = sketch.checkbox "OPT" (i % 2 == 0) ui
        ui := next_ui
      else:
        let (_, next_ui) = sketch.slider "VAL" 0.5 0.0 1.0 ui
        ui := next_ui
  let n_shapes = ui.shapes.length
  let n_segs = ui.segments.length
  let n_nodes = ui.nodes.length
  let (_, frame) = sketch.finish_into ui (render.empty_frame ())
  return #[
    U32.to_f32 size,
    U32.to_f32 n_shapes,
    U32.to_f32 n_segs,
    U32.to_f32 n_nodes,
    U32.to_f32 frame.extensions.length,
  ]
