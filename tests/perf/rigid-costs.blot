import * as arrays from "ink/arrays"
import * as rigid from "ink/rigid"
import * as array from "std/array"
import * as simd from "std/simd"
import { Vec3 } from "std/vector"
const old_restitution = fn (w: rigid.World) => fn (rows: Array F32) => fn (jac: Array F32) => fn (vel_in: Array F32) => fn (imp_in: Array F32) => do:
  let vel = arrays.copy vel_in
  let imp = arrays.copy imp_in
  let count = rows.length / rigid.stride
  for c in 0..count:
    let o = c * rigid.stride
    let j = c * rigid.jac_stride
    let q = c * rigid.impulse_stride
    let e = rows[o + 13]
    if e > 0.0 && rows[o + 23] < F32.neg rigid.restitution_threshold && imp[q + 3] > 0.0:
      let a = rows[o]
      let b = rows[o + 1]
      let has_a = a >= 0.0
      let has_b = b >= 0.0
      let ia = if has_a then F32.to_u32 a else 0
      let ib = if has_b then F32.to_u32 b else 0
      let ma = if has_a then w.inv_mass[ia] else 0.0
      let mb = if has_b then w.inv_mass[ib] else 0.0
      let vax = if has_a then vel[ia * 6] else 0.0
      let vay = if has_a then vel[ia * 6 + 1] else 0.0
      let vaz = if has_a then vel[ia * 6 + 2] else 0.0
      let wax = if has_a then vel[ia * 6 + 3] else 0.0
      let way = if has_a then vel[ia * 6 + 4] else 0.0
      let waz = if has_a then vel[ia * 6 + 5] else 0.0
      let vbx = if has_b then vel[ib * 6] else 0.0
      let vby = if has_b then vel[ib * 6 + 1] else 0.0
      let vbz = if has_b then vel[ib * 6 + 2] else 0.0
      let wbx = if has_b then vel[ib * 6 + 3] else 0.0
      let wby = if has_b then vel[ib * 6 + 4] else 0.0
      let wbz = if has_b then vel[ib * 6 + 5] else 0.0
      let nx = rows[o + 2]
      let ny = rows[o + 3]
      let nz = rows[o + 4]
      let vn = nx * (vbx - vax) + ny * (vby - vay) + nz * (vbz - vaz) + jac[j + 3] * wbx + jac[j + 4] * wby + jac[j + 5] * wbz - jac[j] * wax - jac[j + 1] * way - jac[j + 2] * waz
      let impulse = F32.neg rows[o + 14] * (vn + e * rows[o + 23])
      let new_jn = max 0.0 (imp[q] + impulse)
      let dj = new_jn - imp[q]
      imp[q] := new_jn
      if has_a:
        vel[ia * 6] := vax - nx * dj * ma
        vel[ia * 6 + 1] := vay - ny * dj * ma
        vel[ia * 6 + 2] := vaz - nz * dj * ma
        vel[ia * 6 + 3] := wax - jac[j + 6] * dj
        vel[ia * 6 + 4] := way - jac[j + 7] * dj
        vel[ia * 6 + 5] := waz - jac[j + 8] * dj
      if has_b:
        vel[ib * 6] := vbx + nx * dj * mb
        vel[ib * 6 + 1] := vby + ny * dj * mb
        vel[ib * 6 + 2] := vbz + nz * dj * mb
        vel[ib * 6 + 3] := wbx + jac[j + 9] * dj
        vel[ib * 6 + 4] := wby + jac[j + 10] * dj
        vel[ib * 6 + 5] := wbz + jac[j + 11] * dj
  return (vel, imp)


const old_accelerate = fn (h: F32) => fn (gravity: Vec3) => fn (b: rigid.Bodies) => fn (touching: Array F32) => fn (vel_in: Array F32) => do:
  let vel = arrays.copy vel_in
  for i in 0..b.inv_mass.length:
    if b.inv_mass[i] > 0.0:
      let gs = b.gravity_scale[i] * h
      let lin2 = vel[i * 6] * vel[i * 6] + vel[i * 6 + 1] * vel[i * 6 + 1] + vel[i * 6 + 2] * vel[i * 6 + 2]
      let slide = if touching[i] > 0.0 && lin2 < 0.25 then rigid.resting_linear_damping else 0.0
      let damp_l = 1.0 / (1.0 + h * (b.linear_damping[i] + slide))
      let spin2 = vel[i * 6 + 3] * vel[i * 6 + 3] + vel[i * 6 + 4] * vel[i * 6 + 4] + vel[i * 6 + 5] * vel[i * 6 + 5]
      let calm = if touching[i] > 0.0 && spin2 < 4.0 then rigid.resting_spin_damping else 0.0
      let damp_a = 1.0 / (1.0 + h * (b.angular_damping[i] + calm))
      vel[i * 6] := (vel[i * 6] + gravity.x * gs) * damp_l
      vel[i * 6 + 1] := (vel[i * 6 + 1] + gravity.y * gs) * damp_l
      vel[i * 6 + 2] := (vel[i * 6 + 2] + gravity.z * gs) * damp_l
      vel[i * 6 + 3] := vel[i * 6 + 3] * damp_a
      vel[i * 6 + 4] := vel[i * 6 + 4] * damp_a
      vel[i * 6 + 5] := vel[i * 6 + 5] * damp_a
  return vel


const gravity = #Vec3 { x: 0.31, y: -9.81, z: -0.71 }
const body = fn (count: U32) => #rigid.Bodies {
 pos: array.fill (count*3) 0.0, rot: array.fill (count*4) 0.0,
 vel: array.generate (count*6) (fn i => (from (i%17) - 7.0) * 0.03),
 inv_mass: array.generate count (fn i => if i%7==0 then 0.0 else 1.0),
 inv_inertia: array.fill (count*3) 1.0, gravity_scale: array.fill count 1.0,
 linear_damping: array.fill count 0.25, angular_damping: array.fill count 0.75 }
const vectorized = fn (h: F32) (gravity: Vec3) (b: rigid.Bodies) (touching: Array F32) (vel_in: Array F32) => do:
  let vel = array.generate vel_in.length (fn i => vel_in[i])
  for i in 0 .. b.inv_mass.length:
    if b.inv_mass[i] > 0.0:
      let o = i * 6
      let gs = b.gravity_scale[i] * h
      let lin2 = vel_in[o] * vel_in[o] + vel_in[o+1] * vel_in[o+1] + vel_in[o+2] * vel_in[o+2]
      let slide = if touching[i] > 0.0 && lin2 < 0.25 then rigid.resting_linear_damping else 0.0
      let dl = 1.0 / (1.0 + h * (b.linear_damping[i] + slide))
      let spin2 = vel_in[o+3] * vel_in[o+3] + vel_in[o+4] * vel_in[o+4] + vel_in[o+5] * vel_in[o+5]
      let calm = if touching[i] > 0.0 && spin2 < 4.0 then rigid.resting_spin_damping else 0.0
      let da = 1.0 / (1.0 + h * (b.angular_damping[i] + calm))
      let x = vel_in[o] + gravity.x * gs
      let y = vel_in[o+1] + gravity.y * gs
      let z = vel_in[o+2] + gravity.z * gs
      vel := simd.store o (simd.f32_mul (x,y,z,vel_in[o+3]) (dl,dl,dl,da)) self
      vel := simd.store (o+2) (simd.f32_mul (z,vel_in[o+3],vel_in[o+4],vel_in[o+5]) (dl,da,da,da)) self
  return vel
const work = fn accelerate (count: U32) => do:
  let b = body count
  let touching: Array F32 = array.generate count (fn i => from (i%2))
  return accelerate 0.016 gravity b touching b.vel
entry const accelerated = work rigid.accelerate
entry const vector = work vectorized
entry const original = fn (count: U32) => do:
  let b = body count
  let before = #rigid.Bodies { pos:b.pos,rot:b.rot,vel:b.vel,inv_mass:b.inv_mass,inv_inertia:b.inv_inertia,gravity_scale:b.gravity_scale,linear_damping:b.linear_damping,angular_damping:b.angular_damping }
  return old_accelerate 0.016 gravity before (array.generate count (fn i => from (i%2))) b.vel

const restitution_input = fn (count: U32) => do:
  let inv_mass = array.fill count 1.0
  let rows = array.generate (count * 32) (fn lane => do:
    let c = lane / 32
    return case lane % 32 of
      0 => from c
      1 => -1.0
      3 => 1.0
      13 => if c % 3 == 0 then 0.0 else 0.8
      14 => 1.0
      23 => -3.0
      _ => 0.0)
  let vel = array.generate (count * 6) (fn i => from (i % 9) * 0.13)
  let imp = array.generate (count * 4) (fn i => if i % 4 == 3 then 1.0 else 0.25)
  let jac = array.fill (count * 42) 0.0
  return (inv_mass, rows, vel, imp, jac)
entry const bounce_original = fn count => do:
  let (inv_mass, rows, vel, imp, jac) = restitution_input count
  let world = #rigid.World { pos: #[], rot: #[], iw: #[], inv_mass,
    soft: #rigid.Soft { bias_rate: 0.0, mass_scale: 0.0, impulse_scale: 0.0, inv_h: 60.0 } }
  let (next, impulses) = old_restitution world rows jac vel imp
  return array.flatten #[next, impulses, vel, imp]
entry const bounce_fixed = fn count => do:
  let (inv_mass, rows, vel, imp, jac) = restitution_input count
  let world = #rigid.World { pos: #[], rot: #[], iw: #[], inv_mass,
    soft: #rigid.Soft { bias_rate: 0.0, mass_scale: 0.0, impulse_scale: 0.0, inv_h: 60.0 } }
  let (next, impulses) = rigid.restitution_pass world rows jac vel imp
  return array.flatten #[next, impulses, vel, imp]
