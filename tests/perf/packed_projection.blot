import * as array from "std/array"
type Point is data = $Point { x: F32, y: F32, z: F32 }
type Body is data = $Body { position: Point, velocity: Point, mass: F32, id: U32 }
entry const nested_read = func (count: U32) => return do:
  let rows = array.generate count (func i => return $Body { position: $Point { x: from i, y: 0.0, z: 0.0 }, velocity: $Point { x: 0.25, y: 0.5, z: 1.0 }, mass: 1.0, id: i })
  let sum = 0.0
  for pass in 0 .. 32:
    for i in 0 .. count:
      sum := self + rows[i].position.x
  return #[sum, rows[count-1].velocity.z]
