import * as array from "std/array"
import * as jobs from "ink/task_queue"
import * as ecs from "ink/ecs"
import * as pages from "ink/pages"
import * as messages from "ink/messages"
import * as journal from "ink/journal"
import * as changes from "ink/changes"
import * as schedule from "ink/schedule"
import * as map from "ink/map"

const history_limit = 256
func metadata (epoch:U32) -> (capacity:U32) -> (trace:Bool) => return do:
  if epoch==0 or capacity>4096:
    return @panic "invalid task queue lifetime or capacity"
  return #[epoch,1,capacity,1,0,if trace then 1 else 0]
func same (a: jobs.Ticket) -> (b: jobs.Ticket) => return a.epoch == b.epoch and a.sequence == b.sequence
func mark (ticket:jobs.Ticket) -> (tick:U32) -> (event:jobs.Event) -> (history:ResizeArray jobs.Mark) -> (meta:jobs.Metadata) => return do:
  if meta[5]!=0:
    @storage.push history ($jobs.Mark {ticket,tick,event})
    if history.length>history_limit:
      let before=array.slice (history.length-history_limit) history_limit (@storage.freeze (@storage.copy history))
      @storage.truncate history 0
      for entry in before:
        @storage.push history entry
func submit (tick:U32) -> (earliest:U32) -> (request:request) -> (continuation:local) -> (queue:jobs.Queue [request,value,local]) -> (meta:own jobs.Metadata) -> history => return do:
  if meta[3]==0 or meta[1]==0 or queue.length>=meta[2] or tick<meta[4] or earliest<tick:
    return ($Nothing,meta)
  let ticket= $jobs.Ticket {epoch:meta[0],sequence:meta[1]}
  meta[1] := if meta[1]==0xFFFFFFFF then 0 else meta[1]+1
  meta[4] := tick
  let job:jobs.Job [request,value,local]= $jobs.Job {ticket,submitted:tick,earliest,request,continuation,state:$jobs.Pending}
  @storage.push queue job
  mark ticket tick $jobs.Submitted history meta
  return ($Some ticket,meta)
// Tickets are monotonic even after earlier rows have been published. Binary
// lookup also handles validated sparse saved sequences without a linear scan.
func locate (ticket: jobs.Ticket) -> (queue: jobs.Queue [request, value, local]) -> (meta:jobs.Metadata) -> (history:ResizeArray jobs.Mark) => return do:
  if ticket.epoch != meta[0]:
    return $Nothing
  let low = 0
  let high = queue.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if queue[middle].ticket.sequence < ticket.sequence:
      low := middle + 1
    else:
      high := middle
  if low < queue.length and same ticket queue[low].ticket:
    return $Some low
  return $Nothing
// Unknown, duplicate and previous-world answers cannot complete another job.
func settle (tick: U32) -> (ticket: jobs.Ticket) -> (outcome: jobs.Outcome value) -> (queue: own jobs.Queue [request, value, local]) -> (meta:own jobs.Metadata) -> (history:ResizeArray jobs.Mark) => return do:
  if (meta[3]!=0) and tick >= meta[4]:
    if let $Some index = locate ticket queue meta history:
      if tick >= queue[index].submitted:
        if let $jobs.Pending = queue[index].state:
          queue[index].state := $jobs.Ready { tick, outcome }
          meta[4] := tick
          mark ticket tick $jobs.Completed history meta
          return (true,queue,meta)
  mark ticket tick $jobs.Rejected history meta
  return (false,queue,meta)
// Publish a ready prefix in submission order. Completion timing is recorded
// input; replay supplies the same ticks. A missing head intentionally holds
// later answers, even if they finished first on another CPU.
func publish (tick:U32) -> (queue:own jobs.Queue [request,value,local]) -> (meta:own jobs.Metadata) -> (history:own ResizeArray jobs.Mark) : (Array (jobs.Delivery [value,local]),jobs.Queue [request,value,local],jobs.Metadata,ResizeArray jobs.Mark) => return do:
  if tick<meta[4]:
    return @panic "task delivery tick moved backwards"
  let delivered:GrowArray (jobs.Delivery [value,local])=#[]
  let count=0
  for job in queue:
    let $jobs.Ready {tick:ready,outcome}=job.state else:
      break
    if tick<ready or tick<job.earliest:
      break
    @storage.push delivered ($jobs.Delivery {ticket:job.ticket,continuation:job.continuation,outcome})
    mark job.ticket tick $jobs.Published history meta
    count := self+1
  // The reference copies the entire suffix; production compacts in place.
  let suffix:GrowArray (jobs.Job [request,value,local])=#[]
  for index in count .. queue.length:
    @storage.push suffix ($jobs.Job {ticket:queue[index].ticket,submitted:queue[index].submitted,earliest:queue[index].earliest,request:queue[index].request,continuation:queue[index].continuation,state:queue[index].state})
  @storage.truncate queue 0
  for job in suffix:
    @storage.push queue job
  meta[4] := tick
  return (@storage.freeze delivered,queue,meta,history)
func cancel (tick: U32) -> (ticket: jobs.Ticket) -> (reason: U32) -> (queue: own jobs.Queue [request, value, local]) -> (meta:own jobs.Metadata) -> (history:ResizeArray jobs.Mark) => return do:
  if tick < meta[4]:
    return (false,queue,meta)
  if let $Some index = locate ticket queue meta history:
    if tick >= queue[index].submitted:
      if let $jobs.Ready { outcome: $jobs.Cancelled _ } = queue[index].state:
        return (false,queue,meta)
      queue[index].state := $jobs.Ready { tick, outcome: $jobs.Cancelled reason }
      queue[index].earliest := min self tick
      meta[4] := tick
      mark ticket tick $jobs.Stopped history meta
      return (true,queue,meta)
  return (false,queue,meta)
func close (tick: U32) -> (reason: U32) -> (queue: own jobs.Queue [request, value, local]) -> (meta:own jobs.Metadata) -> (history:ResizeArray jobs.Mark) => return do:
  if Bool.not (meta[3]!=0):
    return (queue,meta)
  if tick < meta[4]:
    return @panic "task close tick moved backwards"
  for index in 0 .. queue.length:
    let (unused,cancelled,cancelled_meta)=cancel tick queue[index].ticket reason queue meta history
    queue := cancelled
    meta := cancelled_meta
  meta[3] := 0
  meta[4] := tick
  return (queue,meta)
// Restore/fork under a fresh epoch before reconnecting transports. jobs.Completed
// outcomes remain saved; only jobs.Pending requests need reissuing. Transport-side
// effects must use an application idempotency key, not this lifetime's ticket.
func reissue (epoch: U32) -> (queue: own jobs.Queue [request, value, local]) -> (meta:own jobs.Metadata) -> (history:ResizeArray jobs.Mark) => return do:
  if epoch == 0 or epoch == meta[0]:
    return @panic "task restore requires a fresh epoch"
  meta[0] := epoch
  @storage.truncate history 0
  for index in 0 .. queue.length:
    queue[index].ticket.epoch := epoch
    if let $jobs.Pending = queue[index].state:
      mark queue[index].ticket meta[4] $jobs.Reissued history meta
  return (queue,meta)
func is_pending state => return case state of
  $jobs.Pending => true
  _ => false
func pending (queue: jobs.Queue [request, value, local]) => return #[job | job <- queue, is_pending job.state]

// Exact U32 framing. Callers validate the request/result/continuation domain
// in their decoders. Trace history is transient; accepted results are saved.
func append words -> (output:ResizeArray U32) => return do:
  for word in words:
    @storage.push output word
func encode encode_request -> encode_value -> encode_local -> (q:jobs.Queue [request,value,local]) -> (meta:jobs.Metadata) => return do:
  // Build all independent row chunks first, then concatenate their spans.
  let chunks:ResizeArray U32=#[]
  let starts:GrowArray U32=#[0]
  for job in q:
    let request=encode_request job.request
    let local=encode_local job.continuation
    let payload:ResizeArray U32=#[]
    let tag=0
    let tick=0
    case job.state of
      $jobs.Pending => ()
      $jobs.Ready {tick:ready,outcome} => do:
        tick := ready
        case outcome of
          $jobs.Value value => do:
            tag := 1
            append (encode_value value) payload
          $jobs.Failed reason => do:
            tag := 2
            @storage.push payload reason
          $jobs.Cancelled reason => do:
            tag := 3
            @storage.push payload reason
    append #[job.ticket.sequence,job.submitted,job.earliest,tag,tick,request.length,local.length,payload.length] chunks
    append request chunks
    append local chunks
    append payload chunks
    @storage.push starts chunks.length
  let output:ResizeArray U32=#[]
  append #[1,meta[0],meta[1],meta[2],meta[3],meta[4],q.length] output
  for row in 0 .. q.length:
    append (&chunks[starts[row]..starts[row+1]]) output
  return @storage.freeze output
func decode (maximum: U32) -> (trace: Bool) -> decode_request -> decode_value -> decode_local -> (words: Array U32) -> (queue:jobs.Queue [request,value,local]) -> (meta:own jobs.Metadata) -> (history:ResizeArray jobs.Mark) => return do:
  if words.length < 7 or words[0] != 1 or words[1] == 0 or words[3] > min 4096 maximum or words[4] > 1 or words[6] > words[3]:
    return (false,meta)
  @storage.truncate queue 0
  @storage.truncate history 0
  meta[0] := words[1]
  meta[2] := words[3]
  meta[5] := if trace then 1 else 0
  meta[1] := words[2]
  meta[3] := words[4]
  meta[4] := words[5]
  let offset = 7
  let previous = 0
  for 0 .. words[6]:
    if words.length - offset < 8:
      return (false,meta)
    let sequence = words[offset]
    let submitted = words[offset + 1]
    let earliest = words[offset + 2]
    let tag = words[offset + 3]
    let ready = words[offset + 4]
    let requests = words[offset + 5]
    let locals = words[offset + 6]
    let values = words[offset + 7]
    if sequence <= previous or (meta[1] != 0 and sequence >= meta[1]) or submitted > meta[4] or earliest < submitted or tag > 3:
      return (false,meta)
    offset := self + 8
    if requests > words.length - offset:
      return (false,meta)
    let $Some request = decode_request (array.slice offset requests words) else:
      return (false,meta)
    offset := self + requests
    if locals > words.length - offset:
      return (false,meta)
    let $Some local = decode_local (array.slice offset locals words) else:
      return (false,meta)
    offset := self + locals
    if values > words.length - offset:
      return (false,meta)
    let payload = array.slice offset values words
    offset := self + values
    let state:jobs.State value = $jobs.Pending
    if tag == 0:
      if values != 0 or ready != 0 or Bool.not (meta[3]!=0):
        return (false,meta)
    else:
      if ready < submitted or ready > meta[4] or (Bool.not (meta[3]!=0) and tag != 3):
        return (false,meta)
      let outcome:jobs.Outcome value = $jobs.Failed 0
      if tag == 1:
        let $Some value = decode_value payload else:
          return (false,meta)
        outcome := $jobs.Value value
      else:
        if values != 1:
          return (false,meta)
        outcome := if tag == 2 then $jobs.Failed payload[0] else $jobs.Cancelled payload[0]
      state := $jobs.Ready { tick: ready, outcome }
    let job:jobs.Job [request,value,local]= $jobs.Job {ticket:$jobs.Ticket {epoch:meta[0],sequence},submitted,earliest,request,continuation:local,state}
    @storage.push queue job
    previous := sequence
  if offset != words.length:
    return (false,meta)
  return (true,meta)

func changed_column (before_meta:ecs.Metadata) -> (before:Array Bool) -> (next:Array Bool) -> selected -> (log:journal.Journal) -> (log_meta:messages.Metadata) => return do:
  let structural=false
  let entries:GrowArray journal.Change=#[]
  for id in selected:
    let was=id<before.length and before[id]
    let now=id<next.length and next[id]
    structural := structural or (was and Bool.not now) or (now and Bool.not was)
    if now:
      @storage.push entries (if was then $journal.Updated id else $journal.Added id)
    else:
      if was:
        @storage.push entries ($journal.Removed id)
  journal.record_many (@storage.freeze entries) log log_meta
  return (ecs.bumped_revision before_meta[1],if structural then ecs.bumped_revision before_meta[2] else before_meta[2])

func update_pages (count:U32) -> (dirty:Array U32) -> (value:U32->U32) -> (before:pages.Pages U32) : Unit => return do:
  let old_count:U32=before.length
  if count==old_count and dirty.length==0:
    return ()
  if old_count==0:
    let generated:Array U32=array.generate count value
    for item in generated:
      @storage.push before item
    return ()
  let selected:Array U32=changes.unique dirty
  let blocks:Array U32=array.map (func (index:U32) : U32 => return index>>6) selected
  // Preserve the historical whole-page copy path independently of the
  // production sparse per-row updater. Each replacement page is fixed extent.
  for page in 0 .. pages.length count:
    let start=page<<6
    let take=min pages.size (count-start)
    let old_take=if start<old_count then min pages.size (old_count-start) else 0
    if changes.contains blocks page or take!=old_take:
      let old:Array U32=array.generate old_take (func (i:U32) : U32 => return before[start+i])
      let next:Array U32=array.generate take (func (slot:U32) : U32 => return do:
        let index=start+slot
        if index>=old_count or changes.contains selected index:
          return value index
        return old[slot])
      for slot in 0 .. take:
        if start+slot<before.length:
          before[start+slot] = next[slot]
        else:
          @storage.push before next[slot]
  if count<before.length:
    @storage.truncate before count

func validate (plan:schedule.Plan) -> (order:ResizeArray U32) => return do:
  let count=plan.dependencies.starts.length-1
  let waves=plan.waves.starts.length-1
  if count>1024 or waves>count:
    return false
  let done=array.fill count false
  @storage.truncate order 0
  let visited=0
  for wave in 0 .. waves:
    let start=plan.waves.starts[wave]
    let end=plan.waves.starts[wave+1]
    let row=array.generate (end-start) (func i => return plan.waves.nodes[start+i])
    let sorted=changes.unique row
    if row.length==0 or row.length>32 or sorted.length!=row.length:
      return false
    for index in sorted:
      if index>=count or done[index]:
        return false
      for at in plan.dependencies.starts[index] .. plan.dependencies.starts[index+1]:
        let dependency=plan.dependencies.targets[at]
        if dependency>=count or Bool.not done[dependency]:
          return false
    for index in sorted:
      done[index] := true
      @storage.push order index
    visited := self+sorted.length
  return visited==count

// The independent validator sorts every wave on every execution; production
// borrows a once-prepared ascending plan. State and output owners are explicit.
func execute_plan_with (plan:schedule.Plan) -> access -> dispatch -> commit => return do:
  let order:ResizeArray U32=#[]
  if Bool.not (validate plan order):
    return false
  for wave in 0 .. plan.waves.starts.length-1:
    let start=plan.waves.starts[wave]
    let end=plan.waves.starts[wave+1]
    let selected= &order[start..end]
    use deltas <- dispatch access selected
    if deltas.length!=selected.length:
      return @panic "scheduler result count differs from its wave"
    for slot in 0 .. selected.length:
      use commit access selected[slot] deltas[slot]
  return true
func edit_map policy -> edits -> before -> slots => return do:
  for pair in edits:
    let (key,value)=pair
    case value of
      $Some value => map.set policy key value before slots
      $Nothing => map.remove policy key before slots
func from_map policy -> entries -> result -> slots => return do:
  for pair in entries:
    let (key,value)=pair
    map.set policy key value result slots
func alter_map policy -> key -> change -> values -> slots => return case change (map.get policy key values slots) of
  $Some value => map.set policy key value values slots
  $Nothing => map.remove policy key values slots
