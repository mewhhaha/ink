import * as pen_profile from "ink/pen/profile"
import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as math from "ink/math"
import * as ui from "ink/ui"
import * as profile from "ink/profile"
import * as profile_packet from "ink/pen/profile"
import * as sample from "ink/field/sample"
import * as reconcile from "ink/reconcile"
import * as lod from "ink/render/lod"
import * as trajectory from "ink/trajectory"

entry func matching (count: U32) : Array U32 => return do:
  let before = array.generate count (func i => return 2147483648 + i * 2)
  let after = array.generate count (func i => return if i % 2 == 0 then 2147483648 + (count - 1 - i) * 2 else 2147483649 + i * 2)
  let previous_rows: ResizeArray U32 = #[]
  let added_rows: ResizeArray U32 = #[]
  let removed_rows: ResizeArray U32 = #[]
  let $Some plan = reconcile.match_keys before after previous_rows added_rows removed_rows else:
    return @panic "unique keys failed"
  let rebuilt: Array U32 = reconcile.build plan (func old -> fresh => return old + fresh) (func fresh => return fresh * 3)
  let previous = 0
  let added = 0
  let removed = 0
  let built = 0
  for value in plan.previous:
    previous := self + value
  for value in plan.added:
    added := self + value
  for value in plan.removed:
    removed := self + value
  for value in rebuilt:
    built := self + value
  return #[plan.before_count, previous, plan.added.length, added, plan.removed.length, removed, built]

entry func sampling (count: U32) : Array F32 => return do:
  let $Some grid = sample.mapping 16 16 0.0 0.0 1.0 1.0 else:
    return @panic "mapping failed"
  let field = func (x: U32) -> (y: U32) => return U32.to_f32 (x * 2 + y * 3 + 1)
  let sum = 0.0
  for i in 0 .. count:
    let x = 2.0 + U32.to_f32 (i % 8) * 0.125
    let y = 3.0 + U32.to_f32 ((i / 8) % 8) * 0.125
    let $Some value = sample.cubic grid $sample.Clamp field x y else:
      return @panic "sample failed"
    sum := self + value
  let $Some outside = sample.cubic grid $sample.Zero field (-5.0) (-5.0) else:
    return @panic "outside sample failed"
  return #[U32.to_f32 count, sum, outside]

entry func flight (count: U32) : Array F32 => return do:
  let $Some arc = trajectory.prepare 8.0 math.zero3 (math.vec3 8.0 0.0 4.0) 4.0 else:
    return @panic "flight failed"
  let sum = 0.0
  let error = 0.0
  for i in 0 .. count:
    let seconds = U32.to_f32 (i % 17) * 0.125
    let at = trajectory.position arc seconds
    let authored = trajectory.arch arc.from arc.to 4.0 (seconds / 2.0)
    sum := self + at.x + at.y + at.z
    error := max self ((at - authored).length)
  let hit = func (a: Vec3) -> (b: Vec3) => return if a.x < 4.0 and b.x >= 4.0 then $Some b.x else $Nothing
  let $Some crossing = trajectory.traverse (trajectory.position arc) 0.0 2.0 8 hit else:
    return @panic "crossing failed"
  return #[U32.to_f32 count, sum, error, arc.duration, crossing]

entry func levels (count: U32) : Array F32 => return do:
  let $Some thresholds = lod.levels #[4.0, 16.0, 64.0] else:
    return @panic "levels failed"
  let previous = 4
  let projected = 0.0
  let selected = 0
  let stable = 0
  for i in 0 .. count:
    let pixels = lod.projected 128.0 1.0 1.0 (U32.to_f32 (1 + i % 16)) 1.0 0.0
    previous := lod.stable thresholds pixels 2.0 self
    projected := self + pixels
    selected := self + lod.select thresholds pixels
    stable := self + previous
  return #[U32.to_f32 count, projected, U32.to_f32 selected, U32.to_f32 stable]

entry func profiling (count: U32) : Array F32 => return do:
  let values = array.fill (1 + count * 6) 0.0
  let counters = array.fill (2 + count * 4) 0.0
  counters[0] := 1024.0
  counters[1] := 2048.0
  for i in 0 .. count:
    let at = 1 + i * 6
    values[at] := U32.to_f32 (i % 4)
    values[at + 1] := U32.to_f32 (i % 8)
    values[at + 2] := U32.to_f32 i
    values[at + 3] := 8.0
    values[at + 4] := U32.to_f32 (i % 8 + 1)
    let counter = 2 + i * 4
    counters[counter] := 1.0
    counters[counter + 1] := U32.to_f32 (65 + i % 26)
    counters[counter + 3] := U32.to_f32 i
  let parsed_1_text:ResizeArray U32 = #[]
  let parsed_1_hot:ResizeArray profile.Hot = #[]
  let parsed_1_nodes:ResizeArray profile.Node = #[]
  let $Some flame = profile_packet.flame parsed_1_text parsed_1_hot parsed_1_nodes values else:
    return @panic "flame packet failed"
  let parsed_2_text:ResizeArray U32 = #[]
  let parsed_2_counters:ResizeArray pen_profile.Counter = #[]
  let $Some memory = profile_packet.memory parsed_2_text parsed_2_counters counters else:
    return @panic "memory packet failed"
  let hot = profile.hottest flame.nodes 4
  let plots = profile.layout ($ui.Rect { x: 0.0, y: 0.0, width: 128.0, height: 32.0 }) 8.0 0 (U32.to_f32 count) flame.nodes
  let hottest = 0.0
  let widths = 0.0
  let sum = 0.0
  for row in hot:
    hottest := self + row.samples
  for plot in plots:
    widths := self + plot.rect.width
  for counter in memory.counters:
    sum := self + counter.value
  return #[U32.to_f32 count, U32.to_f32 hot.length, U32.to_f32 hot[0].function, hot[0].samples,
    hottest, U32.to_f32 plots.length, widths, U32.to_f32 memory.counters.length, sum,
    U32.to_f32 (profile.trunk flame.nodes 8.0 1.0)]
