import * as compound from "ink/physics/compound"
import * as fracture from "ink/physics/fracture"
import * as soft from "ink/physics/soft"
import * as triggers from "ink/physics/triggers"
import * as vehicle from "ink/physics/vehicle"
import * as math from "ink/math"

#entry func triggers_batch (size: U32) : #[F32] =>
  let prev = @array.generate size (func (i: U32) => $triggers.Pair { trigger: i / 4, body: size - i })
  let curr = @array.generate size (func (i: U32) => $triggers.Pair { trigger: (i + 1) / 4, body: size - i })
  let ev = triggers.diff prev curr
  return #[U32.to_f32 size, U32.to_f32 ev.length]

#entry func compound_batch (size: U32) : #[F32] =>
  let parts = @array.generate size (func (i: U32) =>
    let x = U32.to_f32 i - U32.to_f32 size * 0.5
    return $compound.Part { shape: $compound.Sphere { radius: 0.5 }, position: math.vec3 x 0.0 0.0, rotation: math.identity_quat, mass: 1.0 })
  let $Some s = compound.combine parts else:
    return #[U32.to_f32 size, 0.0]
  return #[U32.to_f32 size, s.mass]

#entry func vehicle_batch (size: U32) : #[F32] =>
  let spec = $vehicle.WheelSpec { mount: math.vec3 0.0 0.0 0.0, rest_length: 0.4, radius: 0.35, stiffness: 20000.0, damping: 2000.0, max_steer: 0.5, drive_share: 0.25, brake_share: 0.25, grip_long: 1.0, grip_lat: 1.0 }
  let specs = #[spec, spec, spec, spec]
  let hit = $vehicle.WheelHit { grounded: true, distance: 0.55, normal: math.up, point: math.vec3 0.0 (-0.55) 0.0, surface_velocity: math.zero3 }
  let hits = #[hit, hit, hit, hit]
  let ctrl = $vehicle.Controls { throttle: 0.8, brake: 0.0, steer: 0.2, handbrake: 0.0 }
  let states = #[vehicle.rest_wheel, vehicle.rest_wheel, vehicle.rest_wheel, vehicle.rest_wheel]
  let fy = 0.0
  for 0 .. size:
    let $Some res = vehicle.step_wheels math.zero3 math.identity_quat math.zero3 math.zero3 specs hits ctrl 4000.0 8000.0 5000.0 (1.0 / 60.0) states else:
      return #[U32.to_f32 size, 0.0]
    states := res.states
    fy := res.force.y
  return #[U32.to_f32 size, fy]

#entry func soft_batch (size: U32) : #[F32] =>
  let cols = 4
  let rows = 4
  let links = soft.grid_links cols rows 0.25 0.0 0.001
  let pts = @array.generate (cols * rows) (func (i: U32) =>
    let r = i / cols
    let c = i % cols
    let p = math.vec3 (U32.to_f32 c * 0.25) 2.0 (U32.to_f32 r * 0.25)
    return $soft.Particle { position: p, previous: p, inv_mass: if r == 0 then 0.0 else 1.0, radius: 0.02 })
  let colliders: #[soft.Collider] = #[]
  for 0 .. size:
    let (ok, next) = soft.step_cloth (math.vec3 0.0 (-9.8) 0.0) math.zero3 0.02 (1.0 / 60.0) 4 links colliders pts
    pts := next
  return #[U32.to_f32 size, pts[0].position.y]

#entry func fracture_batch (size: U32) : #[F32] =>
  let bonds = @array.generate (size - 1) (func (i: U32) => $fracture.Bond { a: i, b: i + 1, strength: 10.0, damage: if i == size / 2 then 12.0 else 0.0 })
  let anchored = @array.generate size (func (i: U32) => i == 0)
  let $Some isl = fracture.components size anchored bonds else:
    return #[U32.to_f32 size, 0.0]
  return #[U32.to_f32 size, U32.to_f32 isl.count]
