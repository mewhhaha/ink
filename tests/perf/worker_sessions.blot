import * as array from "std/array"
import * as session from "ink/pen/worker_session"
import * as points from "ink/spatial/points"
import * as spatial from "ink/spatial"
import * as math from "ink/math"

const prepare = fn (context: Array F32) => do:
  if context.length % 2 != 0:
    return @panic "point context needs pairs"
  return points.build (array.generate (context.length / 2) (fn i => math.vec3 context[i*2] 0.0 context[i*2+1]))
const plan = fn (context: spatial.Index) (queries: Array F32) => do:
  if queries.length % 2 != 0:
    return @panic "point query needs pairs"
  return array.generate (queries.length / 2) (fn i => do:
    let nearest = points.nearest context (math.vec3 queries[i*2] 0.0 queries[i*2+1])
    return case nearest of
      #Some index => U32.to_f32 index
      #Nothing => (-1.0))
entry const main = fn host => session.serve prepare plan host
entry const fresh = fn (packet: Array F32) => do:
  let count = F32.to_u32 packet[0]
  return plan (prepare (array.slice 1 count packet)) (array.slice (count+1) (packet.length-count-1) packet)
entry const context_build = fn (count: U32) => do:
  let context = array.generate (count*2) (fn i => U32.to_f32 i)
  return array.concat #[from count] (plan (prepare context) #[0.0,1.0])
