import * as array from "std/array"
import * as points from "ink/spatial/points"
import * as math from "ink/math"

type PointContext = { storage: points.Storage, stored: points.Stored }

func prepare_points (payload: #[F32]): PointContext =>
  if payload.length % 2 != 0:
    return panic "point context needs pairs"
  let bounds: #[~F32] = #[]
  let order: #[~U32] = #[]
  let leaves: #[~U32] = #[]
  let storage = $points.Storage { bounds, order, leaves }
  let positions = array.generate (payload.length / 2) (func i => math.vec3 payload[i * 2] 0.0 payload[i * 2 + 1])
  let stored = points.build_into storage positions
  return { storage, stored }

func plan_point (ctx: PointContext) -> (query: #[2; F32]): F32 =>
  let index = points.read ctx.storage ctx.stored
  let nearest = points.nearest index (math.vec3 query[0] 0.0 query[1])
  return case nearest of
    $Some idx => U32.to_f32 idx
    $Nothing => (-1.0)

entry kernel nearest_points: Kernel [#[F32], #[2; F32], F32] = { prepare: prepare_points, run: plan_point }

entry func fresh (packet: #[F32]) =>
  let count = F32.to_u32 packet[0]
  let ctx = prepare_points (array.slice 1 count packet)
  let index = points.read ctx.storage ctx.stored
  let q_start = count + 1
  let q_count = (packet.length - q_start) / 2
  return array.generate q_count (func i =>
    let nearest = points.nearest index (math.vec3 packet[q_start + i * 2] 0.0 packet[q_start + i * 2 + 1])
    return case nearest of
      $Some idx => U32.to_f32 idx
      $Nothing => (-1.0))

entry func context_build (count: U32) =>
  let payload = array.generate (count * 2) (func i => U32.to_f32 i)
  let ctx = prepare_points payload
  let index = points.read ctx.storage ctx.stored
  let nearest = points.nearest index (math.vec3 0.0 0.0 1.0)
  let out = case nearest of
    $Some idx => U32.to_f32 idx
    $Nothing => (-1.0)
  return #[U32.to_f32 count, out]
