import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as reconcile from "ink/reconcile"
import * as trajectory from "ink/trajectory"
import * as sampling from "ink/field/sample"
import * as noise from "ink/noise"
import * as profile from "ink/profile"
import * as pen_profile from "ink/pen/profile"
import * as lod from "ink/render/lod"
import * as math from "ink/math"


#entry func reconcile_original (size: U32) : #[F32] =>
  let before = array.generate size (func i => 0xFF000000 + i)
  let after = array.generate size (func i => 0xFF000000 + size - 1 - i)
  let indices = array.generate size identity
  let sum = 0.0
  for key in after:
    let found = #[i | i <- indices, before[i] == key]
    sum := self + U32.to_f32 found[0]
  return #[U32.to_f32 size,sum]

#entry func reconcile_indexed (size: U32) : #[F32] =>
  let before = array.generate size (func i => 0xFF000000 + i)
  let after = array.generate size (func i => 0xFF000000 + size - 1 - i)
  let previous: #[U32] = #[]
  let added: #[U32] = #[]
  let removed: #[U32] = #[]
  let $Some plan = reconcile.match_keys before after previous added removed else:
    return #[]
  let sum = 0.0
  for old in plan.previous:
    sum := self + U32.to_f32 old
  return #[U32.to_f32 size,sum]


func old_position (from: Vec3) -> (to: Vec3) -> (gravity: F32) -> (rise: F32) -> (age: F32) =>
  let total = (sqrt (2.0 * gravity * rise) + sqrt (2.0 * gravity * max 0.0 (from.y + rise - to.y))) / gravity
  let up = sqrt (2.0 * gravity * rise)
  let t = min age total
  let fraction = t / total
  let x = lerp from.x to.x fraction
  let z = lerp from.z to.z fraction
  return math.vec3 x (from.y + up * t - 0.5 * gravity * t * t) z
#entry func trajectory_original (size: U32) : #[F32] =>
  let sum = 0.0
  for i in 0 .. size:
    let p = old_position math.zero3 (math.vec3 10.0 0.0 0.0) 10.0 5.0 (U32.to_f32 (i % 16) * 0.125)
    sum := self + p.x + p.y
  return #[U32.to_f32 size,sum]

#entry func trajectory_prepared (size: U32) : #[F32] =>
  let $Some path = trajectory.prepare 10.0 math.zero3 (math.vec3 10.0 0.0 0.0) 5.0 else:
    return #[]
  let sum = 0.0
  for i in 0 .. size:
    let p = trajectory.position path (U32.to_f32 (i % 16) * 0.125)
    sum := self + p.x + p.y
  return #[U32.to_f32 size,sum]


#entry func sampling_original (size: U32) : #[F32] =>
  let sum = 0.0
  for i in 0 .. size:
    let wx = noise.bspline_weights (U32.to_f32 (i % 8) * 0.125)
    let wy = noise.bspline_weights (U32.to_f32 (i % 4) * 0.25)
    let value = 0.0
    for b in 0 .. 4:
      for a in 0 .. 4:
        value := self + U32.to_f32 (a + b * 2 + 5) * wx[a] * wy[b]
    sum := self + value
  return #[U32.to_f32 size,sum]

#entry func sampling_rows (size: U32) : #[F32] =>
  let sum = 0.0
  for i in 0 .. size:
    let wx = noise.bspline_weights (U32.to_f32 (i % 8) * 0.125)
    let wy = noise.bspline_weights (U32.to_f32 (i % 4) * 0.25)
    let value = 0.0
    for b in 0 .. 4:
      value := sampling.accumulate4 self wx wy[b] (U32.to_f32 (b*2+5)) (U32.to_f32 (b*2+6)) (U32.to_f32 (b*2+7)) (U32.to_f32 (b*2+8))
    sum := self + value
  return #[U32.to_f32 size,sum]

func nodes (size: U32) => array.generate size (func i => $profile.Node {
  depth:i%8,function:0xFF000000+i%64,first:0.0,samples:1.0,alone:1.0,name:$profile.Span {start: 0, count: 0}})
func original_hot (nodes: #[profile.Node]) -> (most: U32) =>
  let totals: #[(U32,F32)] = #[]
  for node in nodes:
    let found = totals.length
    for index in 0 .. totals.length:
      let (id, _) = totals[index]
      if found == totals.length and id == node.function:
        found := index
    if found == totals.length:
      @storage.push totals (node.function,node.alone)
    else:
      let (id, amount) = totals[found]
      totals[found] := (id,amount+node.alone)
  let sorted: #[(U32,F32)] = #[]
  for total in totals:
    let (_, amount) = total
    if amount > 0.0:
      let at = sorted.length
      for index in 0 .. sorted.length:
        let (_, other) = sorted[index]
        if at == sorted.length and amount > other:
          at := index
      @storage.push sorted total
      let cursor=sorted.length-1
      for _ in 0 .. sorted.length-1-at:
        sorted[cursor] := sorted[cursor-1]
        cursor := cursor-1
      sorted[at] := total
  return array.slice 0 (min most sorted.length) sorted

#entry func profile_original (size: U32) : #[F32] =>
  let hot = original_hot (nodes size) 5
  let result:#[F32]=#[from size]
  for pair in hot:
    let (id,amount)=pair
    @storage.push result (from (id-0xFF000000))
    @storage.push result amount
  return result

#entry func profile_grouped (size: U32) : #[F32] =>
  let hot = profile.hottest (nodes size) 5
  let result:#[F32]=#[from size]
  for row in hot:
    @storage.push result (from (row.function-0xFF000000))
    @storage.push result row.samples
  return result


#entry func lod_batch (size: U32) : #[F32] =>
  let $Some levels = lod.levels #[10.0,20.0] else:
    return #[]
  let sum = 0
  for i in 0 .. size:
    let pixels = lod.projected 1000.0 1.0 0.1 (25.0 + U32.to_f32 (i%200)) 2.0 0.0
    sum := self + lod.select levels pixels
  return #[U32.to_f32 size,U32.to_f32 sum]

#entry func pen_profile_batch (size: U32) : #[F32] =>
  let sum = 0.0
  for i in 0 .. size:
    let parsed_1_text:#[U32] = #[]
    let parsed_1_hot:#[profile.Hot] = #[]
    let parsed_1_nodes:#[profile.Node] = #[]
    let $Some frame = pen_profile.flame parsed_1_text parsed_1_hot parsed_1_nodes #[1.0,7.0,5.0,1.0,955.0,0.0,7.0,0.0,8.0,5.0,1.0,955.0] else:
      return #[]
    sum := self + frame.nodes[0].alone
  return #[U32.to_f32 size,sum]
