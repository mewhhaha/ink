import {Vec3} from "std/vector"
import * as derived from "ink/derived/keyed"
import * as locomotion from "ink/navigation/locomotion"
import * as ground from "ink/navigation/ground"
import * as lookahead from "ink/navigation/lookahead"
import * as packet from "ink/navigation/packet"
import * as math from "ink/math"
import * as transform from "ink/transform"

entry const cache_changes = func (count: U32) => return do:
  let cached: derived.Cache [U32, U32] = $derived.Cold
  let sum = 0
  let misses = 0
  let same = func (a: U32) => return func (b: U32) => return a == b
  for index in 0 .. count:
    let key = index / 4
    if Bool.not (Maybe.is_some (derived.read same key cached)):
      misses := self + 1
    let (next, value) = derived.resolve same (func key => return key * 2) key cached
    cached := next
    sum := self + value
  return #[sum, misses]

entry const motion_requests = func (count: U32) => return do:
  let solids = Maybe.unwrap_or ground.closed (ground.make #[] #[] 100.0)
  let gait = $locomotion.Gait { height: 1.0, turn: 5.0, phase_per_unit: 2.0, phases: 8.0 }
  let request = $locomotion.Request { target: math.vec3 0.0 0.0 0.2, speed: 2.0, reach: 0.01 }
  let motion = $locomotion.Motion { yaw: 0.0, speed: 0.0, phase: 0.0 }
  let arrived = 0.0
  let height = 0.0
  for 0 .. count:
    let one = locomotion.toward solids gait 0.05 request motion transform.identity
    let two = locomotion.toward solids gait 0.05 request one.motion one.pose
    if two.arrived:
      arrived := self + 1.0
    height := self + two.pose.position.y
  return #[arrived, height]

entry const path_preparation = func (count: U32) => return do:
  let arrived = 0.0
  let sum = 0.0
  let failures = 0.0
  let gait = $locomotion.Gait { height: 1.0, turn: 5.0, phase_per_unit: 2.0, phases: 8.0 }
  let motion = $locomotion.Motion { yaw: 0.0, speed: 0.0, phase: 0.0 }
  for index in 0 .. count:
    let radius = 0.5 + U32.to_f32 (index % 4) * 0.1
    let boxes: ResizeArray ground.Box = #[]
    let rounds: ResizeArray ground.Round = #[]
    let words: ResizeArray U32 = #[]
    let shapes: ResizeArray F32 = #[]
    let source = $ground.Storage {boxes, rounds, words, shapes}
    let no_boxes: Array ground.Box = #[]
    let source_rounds = #[$ground.Round {x: -3.0, z: 0.0, radius}]
    let original = Maybe.unwrap_or ground.closed_stored (ground.make_into source (&no_boxes[0..0]) (&source_rounds[0..source_rounds.length]) 20.0)
    let decoded_boxes: ResizeArray ground.Box = #[]
    let decoded_rounds: ResizeArray ground.Round = #[]
    let decoded_words: ResizeArray U32 = #[]
    let decoded_shapes: ResizeArray F32 = #[]
    let decoded = $ground.Storage {boxes: decoded_boxes, rounds: decoded_rounds, words: decoded_words, shapes: decoded_shapes}
    let $Some stored = packet.decode_into decoded (packet.encode (ground.read source original)) else:
      return #[999.0]
    let solids = ground.read decoded stored
    let target = 0.2 + U32.to_f32 (index % 7) * 0.1
    let route = #[math.vec3 0.0 0.0 target]
    let path_points: ResizeArray Vec3 = #[]
    let request = $lookahead.Request { points: &route[0..route.length], seconds: 0.05, steps: 32, speed: 2.0, reach: 0.01 }
    let $Some path = lookahead.forecast_into path_points solids gait request motion transform.identity else:
      return #[998.0]
    if lookahead.arrived path:
      arrived := self + 1.0
    sum := self + U32.to_f32 index
    if abs (path.pose.position.z - target) > 0.011 or path.points.length < 2 or path.points.length > 33 or solids.rounds[0].radius != radius or ground.clear solids (-3.0) 0.0:
      failures := self + 1.0
  return #[arrived, sum, failures]
