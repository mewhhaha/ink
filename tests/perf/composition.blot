import * as derived from "ink/derived/keyed"
import * as locomotion from "ink/navigation/locomotion"
import * as ground from "ink/navigation/ground"
import * as lookahead from "ink/navigation/lookahead"
import * as packet from "ink/navigation/packet"
import * as math from "ink/math"
import * as transform from "ink/transform"

entry const cache_changes = fn (count: U32) => do:
  let cached: derived.Cache [U32, U32] = #derived.Cold
  let sum = 0
  let misses = 0
  let same = fn (a: U32) => fn (b: U32) => a == b
  for index in 0 .. count:
    let key = index / 4
    if Bool.not (Maybe.is_some (derived.read same key cached)):
      misses := self + 1
    let (next, value) = derived.resolve same (fn key => key * 2) key cached
    cached := next
    sum := self + value
  return #[sum, misses]

entry const motion_requests = fn (count: U32) => do:
  let solids = Maybe.unwrap_or ground.closed (ground.make #[] #[] 100.0)
  let gait = #locomotion.Gait { height: 1.0, turn: 5.0, phase_per_unit: 2.0, phases: 8.0 }
  let request = #locomotion.Request { target: math.vec3 0.0 0.0 0.2, speed: 2.0, reach: 0.01 }
  let motion = #locomotion.Motion { yaw: 0.0, speed: 0.0, phase: 0.0 }
  let arrived = 0.0
  let height = 0.0
  for 0 .. count:
    let one = locomotion.toward solids gait 0.05 request motion transform.identity
    let two = locomotion.toward solids gait 0.05 request one.motion one.pose
    if two.arrived:
      arrived := self + 1.0
    height := self + two.pose.position.y
  return #[arrived, height]

entry const path_preparation = fn (count: U32) => do:
  let arrived = 0.0
  let sum = 0.0
  let failures = 0.0
  let gait = #locomotion.Gait { height: 1.0, turn: 5.0, phase_per_unit: 2.0, phases: 8.0 }
  let motion = #locomotion.Motion { yaw: 0.0, speed: 0.0, phase: 0.0 }
  for index in 0 .. count:
    let radius = 0.5 + U32.to_f32 (index % 4) * 0.1
    let original = Maybe.unwrap_or ground.closed (ground.make #[] #[#ground.Round { x: -3.0, z: 0.0, radius }] 20.0)
    let #Some solids = packet.decode (packet.encode original) else:
      return #[999.0]
    let target = 0.2 + U32.to_f32 (index % 7) * 0.1
    let request = #lookahead.Request { points: #[math.vec3 0.0 0.0 target], seconds: 0.05, steps: 32, speed: 2.0, reach: 0.01 }
    let #Some path = lookahead.forecast solids gait request motion transform.identity else:
      return #[998.0]
    if lookahead.arrived path:
      arrived := self + 1.0
    sum := self + U32.to_f32 index
    if abs (path.pose.position.z - target) > 0.011 || path.points.length < 2 || path.points.length > 33 || solids.rounds[0].radius != radius || ground.clear solids (-3.0) 0.0:
      failures := self + 1.0
  return #[arrived, sum, failures]
