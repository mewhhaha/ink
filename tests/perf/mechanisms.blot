import * as array from "std/array"
import * as field from "ink/field"
import * as derived from "ink/derived/keyed"
import * as history from "ink/history"
import * as statistics from "ink/statistics"
import * as anchor from "ink/ui/anchor"
import * as outline from "ink/ui/outline"
import * as console from "ink/ui/console"
import * as locale from "ink/locale"
import * as pen_locale from "ink/pen/locale"
import * as ui from "ink/ui"
import * as math from "ink/math"

entry func field_batch (size: U32) : #[F32] =>
  let grid = field.grid size size 16 16
  let rows = array.generate size (func i => i == 0)
  let values = array.fill size 1.0
  let changed = field.changed_rows grid rows #[] values
  let before = array.fill (field.count grid) derived.initial
  let (_, after) = field.revise changed derived.initial (copy before)
  let count = 0
  for i in 0 .. changed.length:
    if not (derived.same_revision before[i] after[i]):
      count := self + 1
  return #[U32.to_f32 size, U32.to_f32 count]
type Aged is data = $Aged { age: F32, value: F32 }
entry func history_original (size: U32) : #[F32] =>
  let samples: #[~Aged] = #[]
  for i in 0 .. size:
    let before = array.generate samples.length (func i => samples[i])
    @storage.truncate samples 0
    for sample in before:
      if sample.age+1.0 <= 63.0:
        @storage.push samples ($Aged {age:sample.age+1.0,value:sample.value})
    @storage.push samples ($Aged {age:0.0,value:U32.to_f32 i})
  let sum = 0.0
  for s in samples:
    sum := self + s.value
  return #[U32.to_f32 size, U32.to_f32 samples.length, sum]
entry func history_buffer (size: U32) : #[F32] =>
  let samples: history.Buffer (history.Sample F32) = history.empty ()
  let meta=history.metadata 64
  for i in 0 .. size:
    meta := history.expire (U32.to_f32 i - 63.0) samples meta
    let (sampled,sampled_meta)=history.sample (U32.to_f32 i) (U32.to_f32 i) samples meta
    samples := sampled
    meta := sampled_meta
  let sum = 0.0
  for i in 0 .. meta[2]:
    sum := self + (history.get samples meta i).value
  return #[U32.to_f32 size, U32.to_f32 meta[2], sum]
entry func statistics_batch (size: U32) : #[F32] =>
  let values = array.generate size (func i => U32.to_f32 ((size-i) % 101))
  return #[U32.to_f32 size, Maybe.unwrap_or (-1.0) (statistics.quantile 0.95 values), (statistics.largest 1 values)[0]]
entry func anchor_batch (size: U32) : #[F32] =>
  let bounds = $ui.Rect {x:0.0,y:0.0,width:100.0,height:100.0}
  let sum = 0.0
  for i in 0 .. size:
    let at = math.vec2 (U32.to_f32 (i % 100)) 50.0
    let a = anchor.attach $anchor.Above 0.5 2.0 (math.vec2 20.0 10.0) at
    let b = anchor.attach $anchor.Below 0.5 2.0 (math.vec2 20.0 10.0) at
    let $Some chosen = anchor.place bounds #[a,b] else:
      return #[]
    sum := self + chosen.x + chosen.y
  return #[U32.to_f32 size,sum]
entry func outline_batch (size: U32) : #[F32] =>
  let shape = outline.rounded ($ui.Rect {x:0.0,y:0.0,width:80.0,height:20.0}) 5.0
  let sum_x = 0.0
  let sum_y = 0.0
  let error = 0.0
  let length = outline.length shape
  for i in 0 .. size:
    let distance = length * U32.to_f32 i / U32.to_f32 size
    let point = outline.point shape distance
    sum_x := self + point.x
    sum_y := self + point.y
    let delta = abs (outline.distance shape point - distance)
    error := max self (min delta (length-delta))
  return #[U32.to_f32 size,sum_x,sum_y,error]
const empty_codes:#[U32]=#[]
entry func console_batch (size:U32) : #[F32] =>
  let empty_choices:#[console.Choice]=#[]
  let labels:#[~U32]=#[]
  let catalog:#[+console.Entry]=#[]
  for i in 0 .. size:
    let name=console.append (ui.digits (size-i)) labels
    @storage.push catalog ($console.Entry {name:console.range labels name,about:&empty_codes[0..0],argument:false,options:&empty_choices[0..0]})
  let authored=seal catalog
  let entries=console.sorted (&authored[0..authored.length])
  let payload:#[~U32]=#[]
  let choices:#[~console.Suggestion]=#[]
  console.named #[47] #[32] (&entries[0..entries.length]) #[49] payload choices
  return #[U32.to_f32 size,U32.to_f32 choices.length]
entry func locale_batch (size:U32) : #[F32] =>
  let cache=locale.empty ()
  let payload:#[~U32]=#[]
  let direction=#[false]
  let original=locale.empty ()
  let original_payload:#[~U32]=#[]
  let original_direction=#[false]
  locale.grow size cache
  let original_direction=locale.copy_into original original_payload original_direction cache payload direction
  for i in 0 .. size:
    cache := locale.begin i (i+1) cache
    let drawn=#[65+i%26]
    let spoken=#[97+i%26]
    let (resolved,resolved_payload,resolved_direction)=locale.resolve i (i+1) ($Some ($locale.Text {drawn:&drawn[0..drawn.length],spoken:&spoken[0..spoken.length]})) false cache payload direction
    cache := resolved
    payload := resolved_payload
    direction := resolved_direction
  let sum=0.0
  for i in 0 .. size:
    sum := self+U32.to_f32 (locale.spoken cache payload i (&empty_codes[0..0]))[0]
  return #[U32.to_f32 size,sum,U32.to_f32 original[0].drawn_count]
func localized_sum input =>
  let text:#[~U32]=#[]
  let result=pen_locale.parts input text
  return U32.to_f32 result.drawn[0]+U32.to_f32 result.spoken[0]
entry func pen_locale_batch (size:U32) : #[F32] =>
  let sum=0.0
  for i in 0 .. size:
    sum := self+localized_sum #[65.0,0.0,97.0]
  return #[U32.to_f32 size,sum]
