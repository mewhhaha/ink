import * as array from "std/array"
import * as field from "ink/field"
import * as derived from "ink/derived/keyed"
import * as history from "ink/history"
import * as statistics from "ink/statistics"
import * as anchor from "ink/ui/anchor"
import * as outline from "ink/ui/outline"
import * as console from "ink/ui/console"
import * as locale from "ink/locale"
import * as pen_locale from "ink/pen/locale"
import * as ui from "ink/ui"
import * as math from "ink/math"

entry const field_batch = func (size: U32) : Array F32 => return do:
  let grid = field.grid size size 16 16
  let rows = array.generate size (func i => return i == 0)
  let values = #[array.fill size 1.0]
  let changed = field.changed_rows grid rows #[] values
  let before = array.fill (field.count grid) derived.initial
  let (_, after) = field.revise changed derived.initial before
  let count = 0
  for i in 0 .. changed.length:
    if Bool.not (derived.same_revision before[i] after[i]):
      count := self + 1
  return #[from size, from count]
type Aged is data = $Aged { age: F32, value: F32 }
entry const history_original = func (size: U32) : Array F32 => return do:
  let samples: Array Aged = #[]
  for i in 0 .. size:
    samples := #[$Aged {age:s.age+1.0,value:s.value} | s <- self, s.age+1.0 <= 63.0]
    samples := array.push ($Aged {age:0.0,value:from i}) self
  let sum = 0.0
  for s in samples:
    sum := self + s.value
  return #[from size, from samples.length, sum]
entry const history_buffer = func (size: U32) : Array F32 => return do:
  let samples: history.Buffer (history.Sample F32) = history.empty 64
  for i in 0 .. size:
    samples := history.expire (from i - 63.0) self
    samples := history.sample (from i) (from i) self
  let sum = 0.0
  for i in 0 .. samples.count:
    sum := self + (history.get samples i).value
  return #[from size, from samples.count, sum]
entry const statistics_batch = func (size: U32) : Array F32 => return do:
  let values = array.generate size (func i => return U32.to_f32 ((size-i) % 101))
  return #[from size, Maybe.unwrap_or (-1.0) (statistics.quantile 0.95 values), (statistics.largest 1 values)[0]]
entry const anchor_batch = func (size: U32) : Array F32 => return do:
  let bounds = $ui.Rect {x:0.0,y:0.0,width:100.0,height:100.0}
  let sum = 0.0
  for i in 0 .. size:
    let at = math.vec2 (from (i % 100)) 50.0
    let a = anchor.attach $anchor.Above 0.5 2.0 (math.vec2 20.0 10.0) at
    let b = anchor.attach $anchor.Below 0.5 2.0 (math.vec2 20.0 10.0) at
    let $Some chosen = anchor.place bounds #[a,b] else:
      return #[]
    sum := self + chosen.x + chosen.y
  return #[from size,sum]
entry const outline_batch = func (size: U32) : Array F32 => return do:
  let shape = outline.rounded ($ui.Rect {x:0.0,y:0.0,width:80.0,height:20.0}) 5.0
  let sum_x = 0.0
  let sum_y = 0.0
  let error = 0.0
  let length = outline.length shape
  for i in 0 .. size:
    let distance = length * from i / from size
    let point = outline.point shape distance
    sum_x := self + point.x
    sum_y := self + point.y
    let delta = abs (outline.distance shape point - distance)
    error := max self (min delta (length-delta))
  return #[from size,sum_x,sum_y,error]
entry const console_batch = func (size: U32) : Array F32 => return do:
  let entries = console.sorted (array.generate size (func i => return $console.Entry {name:ui.digits (size-i),about:#[],argument:false,options:#[]}))
  let choices = console.named #[47] #[32] entries #[49]
  return #[from size,from choices.length]
entry const locale_batch = func (size: U32) : Array F32 => return do:
  let cache = locale.grow size locale.empty
  let original = cache
  for i in 0 .. size:
    cache := locale.begin i (i+1) self
    cache := locale.resolve i (i+1) ($Some $locale.Text {drawn:#[65+i%26],spoken:#[97+i%26]}) false self
  let sum = 0.0
  for i in 0 .. size:
    sum := self + from (locale.spoken cache i #[])[0]
  return #[from size,sum,from original.drawn[0].length]
entry const pen_locale_batch = func (size: U32) : Array F32 => return do:
  let sum = 0.0
  for i in 0 .. size:
    let result = pen_locale.parts #[65.0,0.0,97.0]
    sum := self + from result.drawn[0] + from result.spoken[0]
  return #[from size,sum]
