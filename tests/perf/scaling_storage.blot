import * as array from "std/array"
import * as lookup from "ink/lookup"
import * as grid from "ink/spatial/point_grid"
import * as math from "ink/math"

func keys (count: U32) => array.generate count (func i => 0x80000000 + (count - 1 - i) * 2)
entry func lookup_indexed (count: U32) =>
  let key_values: #[~U32] = #[]
  let key_order: #[~U32] = #[]
  let index = lookup.build_into (keys count) key_values key_order
  let total = 0
  for i in 0 .. count * 4:
    let $Some slot = lookup.find index (0x80000000 + (i * 17 % count) * 2) else:
      return panic "missing indexed key"
    total := self + slot
  return #[count, total]
entry func lookup_linear (count: U32) =>
  let source = keys count
  let total = 0
  for i in 0 .. count * 4:
    let key = 0x80000000 + (i * 17 % count) * 2
    for slot in 0 .. source.length:
      if source[slot] == key:
        total := self + slot
        break
  return #[count, total]
entry func point_grid (count: U32) =>
  let positions = array.generate count (func i => math.vec3 (U32.to_f32 (i % 32) * 2.0) 0.0 (U32.to_f32 (i / 32) * 2.0))
  let before_heads: #[~U32] = #[]
  let before_points: #[~grid.Point] = #[]
  let before_storage = $grid.Storage {heads: before_heads,points: before_points}
  let before = grid.build_into before_storage $Nothing 2.0 count positions
  let after_heads: #[~U32] = #[]
  let after_points: #[~grid.Point] = #[]
  let after_storage = $grid.Storage {heads: after_heads,points: after_points}
  let after = grid.build_into after_storage $Nothing 2.0 count positions
  for position in positions:
    after := grid.push_stored after_storage self position
  let hits = 0
  let total = 0
  for position in positions:
    for index in grid.within (grid.read after_storage after) position.x position.z 0.25:
      hits := self + 1
      total := self + index
  return #[before.points.count, after.points.count, hits, total]
