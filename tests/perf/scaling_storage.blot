import * as array from "std/array"
import * as lookup from "ink/lookup"
import * as grid from "ink/spatial/point_grid"
import * as math from "ink/math"

const keys = func (count: U32) => return array.generate count (func i => return 0x80000000 + (count - 1 - i) * 2)
entry const lookup_indexed = func (count: U32) => return do:
  let key_values: ResizeArray U32 = #[]
  let key_order: ResizeArray U32 = #[]
  let index = lookup.build_into (keys count) key_values key_order
  let total = 0
  for i in 0 .. count * 4:
    let $Some slot = lookup.find index (0x80000000 + (i * 17 % count) * 2) else:
      return @panic "missing indexed key"
    total := self + slot
  return #[count, total]
entry const lookup_linear = func (count: U32) => return do:
  let source = keys count
  let total = 0
  for i in 0 .. count * 4:
    let key = 0x80000000 + (i * 17 % count) * 2
    for slot in 0 .. source.length:
      if source[slot] == key:
        total := self + slot
        break
  return #[count, total]
entry const point_grid = func (count: U32) => return do:
  let positions = array.generate count (func i => return math.vec3 (U32.to_f32 (i % 32) * 2.0) 0.0 (U32.to_f32 (i / 32) * 2.0))
  let before = grid.build 2.0 count positions
  let after = before
  for position in positions:
    after := grid.push position self
  let hits = 0
  let total = 0
  for position in positions:
    for index in grid.within after position.x position.z 0.25:
      hits := self + 1
      total := self + index
  return #[before.points.count, after.points.count, hits, total]
