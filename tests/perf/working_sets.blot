import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as field from "ink/field"
import * as buckets from "ink/field/buckets"
import * as retained from "ink/render/retained"
import * as changes from "ink/changes"
import * as render from "ink/render"
import * as math from "ink/math"

type A is data = $A U32
type B is data = $B U32
type C is data = $C U32
type Columns={alive:ecs.Entities,a:ecs.Pool A,a_meta:ecs.Metadata,b:ecs.Pool B,b_meta:ecs.Metadata,c:ecs.Pool C,c_meta:ecs.Metadata}
func ecs_work sparse -> (count:U32) =>
  let alive=ecs.entities ()
  let entity_meta=ecs.metadata 1
  let a:ecs.Pool A=ecs.pool ()
  let a_meta=ecs.metadata 1
  let b:ecs.Pool B=ecs.pool ()
  let b_meta=ecs.metadata 1
  let c:ecs.Pool C=ecs.pool ()
  let c_meta=ecs.metadata 1
  let (ids, alive, entity_meta) = ecs.spawn_many alive entity_meta count
  let (a, a_meta) = ecs.insert_selected alive a a_meta ids (array.generate count (func i => $A i))
  let (b, b_meta) = ecs.insert_selected alive b b_meta ids (array.generate count (func i => $B i))
  let (c, c_meta) = ecs.insert_selected alive c c_meta ids (array.generate count (func i => $C i))
  let before:ecs.Pool A=ecs.copy_into identity (ecs.pool ()) a
  let selected=array.generate ((count+256)/257) (func i => i*257)
  let cols: Columns = {alive, a, a_meta, b, b_meta, c, c_meta}
  let step=func (cols: own Columns) -> i : Columns =>
    let $Some ($A value)=ecs.read cols.a i else:
      return panic "missing A"
    let $Some old_b=ecs.read cols.b i else:
      return panic "missing B"
    let $Some old_c=ecs.read cols.c i else:
      return panic "missing C"
    cols.a := ecs.write_row self i ($A (value+(if i%257==0 then 1 else 0)))
    cols.a_meta := ecs.bump_payload self
    cols.b := ecs.write_row self i old_b
    cols.b_meta := ecs.bump_payload self
    cols.c := ecs.write_row self i old_c
    cols.c_meta := ecs.bump_payload self
    return cols
  for 0 .. 16:
    if sparse:
      for i in selected:
        cols := step self i
    else:
      for i in 0 .. count:
        cols := step self i
  let sum=0
  let prior=0
  for i in 0 .. count:
    let $Some ($A n)=ecs.read cols.a i else:
      return panic "missing result"
    let $Some ($A old)=ecs.read before i else:
      return panic "missing snapshot"
    sum := self+n
    prior := self+old
  return #[count,sum,prior]
entry func ecs_full (count:U32) => ecs_work false count
entry func ecs_sparse (count:U32) => ecs_work true count

entry func field_buckets (count: U32) =>
  let grid = field.grid 1024 1024 16 16
  let regions = array.generate count (func i : field.Region => return
    { left: i%64*16, top: i/64%64*16, right: i%64*16+4, bottom: i/64%64*16+4 })
  let offsets: #[U32] = #[]
  let indices: #[U32] = #[]
  let occupied: #[U32] = #[]
  let result = buckets.build_into grid regions offsets indices occupied
  let sum = array.fold_left (func (a:U32) -> (b:U32) => a+b) 0 result.indices
  return #[result.indices.length,sum,result.occupied.length]

func draw key => render.placed 0 0 (math.vec3 (U32.to_f32 key) 0.0 0.0) 0.0 math.one3
func with_frame run => run (own (render.empty_frame ()))
entry func retained_sparse (count:U32) => with_frame (func (own frame) =>
  let keys=array.generate count identity
  let state=retained.state ()
  let entries=retained.empty ()
  let ids:#[U32]=#[]
  frame := render.begin_frame frame
  let (state,entries,ids,frame)=retained.update_keyed (func key -> slot => key) (func key => #[draw key]) (changes.borrow true keys #[]) state entries ids frame
  let original_next=state[1]
  let total=0
  for 0 .. 32:
    frame := render.begin_frame frame
    let (next_state,next_entries,next_ids,next_frame)=retained.update_keyed (func key -> slot => key) (func key => #[draw key]) (changes.borrow false #[count/2] #[]) state entries ids frame
    state := next_state
    entries := next_entries
    ids := next_ids
    frame := next_frame
    total := self+frame.updates.length
  return #[count,total,original_next,state[1]])

type Point is data = $Point { x: F32, y: F32, z: F32 }
type Body is data = $Body { position: Point, velocity: Point, mass: F32, id: U32 }
type Flat = { x: F32, y: F32, z: F32, vx: F32, vy: F32, vz: F32, mass: F32, id: U32 }
func nested_step (body: Body) => $Body {
  position: $Point { x: body.position.x + body.velocity.x, y: body.position.y + body.velocity.y, z: body.position.z + body.velocity.z },
  velocity: body.velocity, mass: body.mass, id: body.id }
func flat_step (body: Flat) : Flat => return
  { x: body.x+body.vx, y: body.y+body.vy, z: body.z+body.vz, vx: body.vx, vy: body.vy, vz: body.vz, mass: body.mass, id: body.id }
entry func packing_nested (count: U32) =>
  let before = array.generate count (func i => $Body { position: $Point { x: U32.to_f32 i, y: 0.0, z: 0.0 }, velocity: $Point { x: 0.25, y: 0.5, z: 1.0 }, mass: 1.0, id: i })
  let current = copy before
  for 0 .. 16:
    for i in 0 .. current.length:
      current[i] := nested_step current[i]
  return #[U32.to_f32 count,array.fold_left (func sum -> (body: Body) => sum + body.position.x) 0.0 current,before[count-1].position.x]
entry func packing_flat (count: U32) =>
  let before = array.generate count (func i : Flat => { x: U32.to_f32 i, y: 0.0, z: 0.0, vx: 0.25, vy: 0.5, vz: 1.0, mass: 1.0, id: i })
  let current = copy before
  for 0 .. 16:
    for i in 0 .. current.length:
      current[i] := flat_step current[i]
  return #[U32.to_f32 count,array.fold_left (func sum -> (body: Flat) => sum+body.x) 0.0 current,before[count-1].x]
