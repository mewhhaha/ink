import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as field from "ink/field"
import * as buckets from "ink/field/buckets"
import * as retained from "ink/render/retained"
import * as changes from "ink/changes"
import * as render from "ink/render"
import * as math from "ink/math"

type A is data = $A U32
type B is data = $B U32
type C is data = $C U32
type Columns={alive:ecs.Entities,a:ecs.Pool A,a_meta:ecs.Metadata,b:ecs.Pool B,b_meta:ecs.Metadata,c:ecs.Pool C,c_meta:ecs.Metadata}
func ecs_work sparse -> (count:U32) => return do:
  let alive=ecs.entities ()
  let entity_meta=ecs.metadata 1
  let a:ecs.Pool A=ecs.pool ()
  let a_meta=ecs.metadata 1
  let b:ecs.Pool B=ecs.pool ()
  let b_meta=ecs.metadata 1
  let c:ecs.Pool C=ecs.pool ()
  let c_meta=ecs.metadata 1
  let ids=ecs.spawn_many alive entity_meta count
  ecs.insert_selected alive a a_meta ids (array.generate count (func i => return $A i))
  ecs.insert_selected alive b b_meta ids (array.generate count (func i => return $B i))
  ecs.insert_selected alive c c_meta ids (array.generate count (func i => return $C i))
  let before:ecs.Pool A=ecs.pool ()
  ecs.copy_into identity before a
  let selected=array.generate ((count+256)/257) (func i => return i*257)
  let step=func i => return do:
    let $Some ($A value)=ecs.read a i else:
      return @panic "missing A"
    let $Some old_b=ecs.read b i else:
      return @panic "missing B"
    let $Some old_c=ecs.read c i else:
      return @panic "missing C"
    ecs.write a a_meta i ($A (value+(if i%257==0 then 1 else 0)))
    ecs.write b b_meta i old_b
    ecs.write c c_meta i old_c
  for 0 .. 16:
    if sparse:
      for i in selected:
        step i
    else:
      for i in 0 .. count:
        step i
  let sum=0
  let prior=0
  for i in 0 .. count:
    let $Some ($A n)=ecs.read a i else:
      return @panic "missing result"
    let $Some ($A old)=ecs.read before i else:
      return @panic "missing snapshot"
    sum := self+n
    prior := self+old
  return #[count,sum,prior]
entry func ecs_full (count:U32) => return ecs_work false count
entry func ecs_sparse (count:U32) => return ecs_work true count

entry func field_buckets (count: U32) => return do:
  let grid = field.grid 1024 1024 16 16
  let regions = array.generate count (func i : field.Region => return
    { left: i%64*16, top: i/64%64*16, right: i%64*16+4, bottom: i/64%64*16+4 })
  let offsets: ResizeArray U32 = #[]
  let indices: ResizeArray U32 = #[]
  let occupied: ResizeArray U32 = #[]
  let result = buckets.build_into grid regions offsets indices occupied
  let sum = array.fold_left (func (a:U32) -> (b:U32) => return a+b) 0 result.indices
  return #[result.indices.length,sum,result.occupied.length]

func draw key => return render.placed 0 0 (math.vec3 (U32.to_f32 key) 0.0 0.0) 0.0 math.one3
func with_frame run => return do:
  let settings=#[render.defaults]
  let draws:ResizeArray render.Draw=#[]
  let solids:ResizeArray render.Solid=#[]
  let decals:ResizeArray render.Decal=#[]
  let sprites:ResizeArray render.Sprite=#[]
  let insets:ResizeArray render.Inset=#[]
  let fields:ResizeArray render.Field=#[]
  let poses:ResizeArray render.Pose=#[]
  let emitters:ResizeArray render.Emitter=#[]
  let extensions:ResizeArray render.Extension=#[]
  let updates:ResizeArray render.Instance=#[]
  let removed:ResizeArray U32=#[]
  return run ($render.FrameAccess {settings,draws,solids,decals,sprites,insets,fields,poses,emitters,extensions,updates,removed})
entry func retained_sparse (count:U32) => return with_frame (func frame => return do:
  let keys=array.generate count identity
  let state=retained.state ()
  let entries=retained.empty ()
  let ids:ResizeArray U32=#[]
  render.begin_frame frame
  retained.update_keyed (func key -> slot => return key) (func key => return #[draw key]) (changes.borrow true keys #[]) state entries ids frame
  let original_next=state[1]
  let total=0
  for 0 .. 32:
    render.begin_frame frame
    retained.update_keyed (func key -> slot => return key) (func key => return #[draw key]) (changes.borrow false #[count/2] #[]) state entries ids frame
    total := self+frame.updates.length
  return #[count,total,original_next,state[1]])

type Point is data = $Point { x: F32, y: F32, z: F32 }
type Body is data = $Body { position: Point, velocity: Point, mass: F32, id: U32 }
type Flat = { x: F32, y: F32, z: F32, vx: F32, vy: F32, vz: F32, mass: F32, id: U32 }
func nested_step (body: Body) => return $Body {
  position: $Point { x: body.position.x + body.velocity.x, y: body.position.y + body.velocity.y, z: body.position.z + body.velocity.z },
  velocity: body.velocity, mass: body.mass, id: body.id }
func flat_step (body: Flat) : Flat => return
  { x: body.x+body.vx, y: body.y+body.vy, z: body.z+body.vz, vx: body.vx, vy: body.vy, vz: body.vz, mass: body.mass, id: body.id }
entry func packing_nested (count: U32) => return do:
  let before = array.generate count (func i => return $Body { position: $Point { x: U32.to_f32 i, y: 0.0, z: 0.0 }, velocity: $Point { x: 0.25, y: 0.5, z: 1.0 }, mass: 1.0, id: i })
  let current = @storage.copy before
  for 0 .. 16:
    for i in 0 .. current.length:
      current[i] := nested_step current[i]
  return #[U32.to_f32 count,array.fold_left (func sum -> (body: Body) => return sum + body.position.x) 0.0 current,before[count-1].position.x]
entry func packing_flat (count: U32) => return do:
  let before = array.generate count (func i : Flat => return { x: U32.to_f32 i, y: 0.0, z: 0.0, vx: 0.25, vy: 0.5, vz: 1.0, mass: 1.0, id: i })
  let current = @storage.copy before
  for 0 .. 16:
    for i in 0 .. current.length:
      current[i] := flat_step current[i]
  return #[U32.to_f32 count,array.fold_left (func sum -> (body: Flat) => return sum+body.x) 0.0 current,before[count-1].x]
