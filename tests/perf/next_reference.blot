// Frozen references from before the six library improvements.
import * as jobs from "ink/task_queue"
import * as changes from "ink/changes"
import * as array from "std/array"
import * as sort from "ink/sort"

// Explicit caller-owned invalidation. Removal wins within a batch; a later
// batch wins when composing. Reset discards every earlier retained value.
const unique = func (values: Array U32) => return do:
  let ordered = true
  for i in 1 .. values.length:
    if values[i] <= values[i - 1]:
      ordered := false
      break
  if ordered:
    return values
  let order = sort.order_u32 values
  let output = array.fill values.length 0
  let count = 0
  for at in order:
    let value = values[at]
    if count == 0 or output[count - 1] != value:
      output[count] := value
      count := self + 1
  return array.slice 0 count output
const contains = func (values: Array U32) => return func (value: U32) => return do:
  let low = 0
  let high = values.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if values[middle] < value:
      low := middle + 1
    else:
      high := middle
  return low < values.length and values[low] == value
const without = func (values: Array U32) => return func (excluded: Array U32) => return do:
  if excluded.length == 0:
    return values
  let out = array.fill values.length 0
  let count = 0
  for value in values:
    if Bool.not (contains excluded value):
      out[count] := value
      count := self + 1
  return array.slice 0 count out
const make = func reset => return func updated => return func removed => return do:
  let removed = unique removed
  return $changes.Changes { reset, updated: without (unique updated) removed, removed }
const empty = $changes.Changes { reset: false, updated: #[], removed: #[] }
const affected = func (changes: changes.Changes) => return do:
  if changes.removed.length == 0:
    return unique changes.updated
  if changes.updated.length == 0:
    return unique changes.removed
  return unique (array.concat changes.updated changes.removed)
const compose = func (earlier: changes.Changes) => return func (later: changes.Changes) => return do:
  if later.reset:
    return make true later.updated later.removed
  let touched = affected later
  return make earlier.reset (array.concat (without earlier.updated touched) later.updated)
    (array.concat (without earlier.removed touched) later.removed)

// Apply a membership delta to sorted unique keys. This is also an explicit
// active set: updated wakes keys, removed sleeps them, and reset starts empty.
// Full-width keys have no reserved sentinel. The old set remains a snapshot.
const apply = func (change: changes.Changes) -> (before: Array U32) => return do:
  let delta = make change.reset change.updated change.removed
  let kept = if delta.reset then #[] else without before delta.removed
  let out = array.fill (kept.length + delta.updated.length) 0
  let left = 0
  let right = 0
  let count = 0
  for 0 .. out.length:
    if left == kept.length and right == delta.updated.length:
      break
    let value = 0
    if right == delta.updated.length:
      value := kept[left]
      left := self + 1
    else:
      if left == kept.length:
        value := delta.updated[right]
        right := self + 1
      else:
        value := min kept[left] delta.updated[right]
        if kept[left] == value:
          left := self + 1
        if delta.updated[right] == value:
          right := self + 1
    out[count] := value
    count := self + 1
  return array.slice 0 count out

const encode_queue = func encode_request -> encode_value -> encode_local -> (queue: jobs.Queue [request, value, local]) => return do:
  let words = #[1, queue.epoch, queue.next, queue.capacity, if queue.open then 1 else 0, queue.tick, queue.jobs.length]
  for job in queue.jobs:
    let request = encode_request job.request
    let local = encode_local job.continuation
    let (tag, tick, value) = case job.state of
      $jobs.Pending => (0, 0, #[])
      $jobs.Ready { tick, outcome } => case outcome of
        $jobs.Value value => (1, tick, encode_value value)
        $jobs.Failed reason => (2, tick, #[reason])
        $jobs.Cancelled reason => (3, tick, #[reason])
    words := array.flatten #[words, #[job.ticket.sequence, job.submitted, job.earliest, tag, tick, request.length, local.length, value.length], request, local, value]
  return words

const unpack = func (capacity: U32) => return func (payload: Array F32) : Maybe (Array U32) => return do:
  if payload.length < 2 or payload.length % 2 != 0:
    return $Nothing
  for value in payload:
    if Bool.not (is_finite value) or value < 0.0 or value > 65535.0 or floor value != value:
      return $Nothing
  let count = F32.to_u32 payload[0] | (F32.to_u32 payload[1] << 16)
  let size = (payload.length - 2) / 2
  if count > size or (capacity == 0 and count != size) or (capacity != 0 and size != capacity):
    return $Nothing
  for i in 2 + count * 2 .. payload.length:
    if payload[i] != 0.0:
      return $Nothing
  return $Some (array.generate count (func i => return F32.to_u32 payload[2 + i * 2] | (F32.to_u32 payload[3 + i * 2] << 16)))

