import * as array from "std/array"
import * as field from "ink/field"
import * as codec from "ink/codec"
import * as reference from "./simd_reference"
import * as springs from "ink/motion/springs"
import * as motion from "ink/motion"
import * as bounds from "ink/render/bounds"
import * as render from "ink/render"
import * as lod from "ink/render/lod"
import * as math from "ink/math"

func field_run compare -> (count: U32) => return do:
  let grid = field.grid count count 16 16
  let rows = array.generate (count*count) (func i => return U32.to_f32 (i%count+i/count))
  return array.map (func b => return if b then 1 else 0) (compare grid (array.fill count true) rows rows)
entry func field_scalar (count:U32) => return field_run reference.changed_rows count
entry func field_simd (count:U32) => return field_run field.changed_rows count
func pack_run pack -> (count: U32) => return pack (count + 7) (array.generate count (func i => return i * 2654435761))
entry func pack_scalar (count:U32) => return pack_run reference.pack count
entry func pack_simd (count:U32) => return pack_run codec.pack count

func spring_run (mode: U32) -> (damping: F32) -> (count: U32) => return do:
  let p = array.generate count (func i => return U32.to_f32 (i % 17) - 8.0)
  let v = array.generate count (func i => return U32.to_f32 (i % 13) * 0.125 - 0.75)
  let target = array.generate count (func i => return U32.to_f32 (i % 7) - 3.0)
  let $Some prepared = springs.prepare 8.0 damping 0.016 else:
    return @panic "spring rates"
  let out_p=array.fill count 0.0
  let out_v=array.fill count 0.0
  for 0 .. 16:
    if mode == 2:
      springs.columns_into prepared p v target out_p out_v
      for i in 0 .. count:
        p[i] := out_p[i]
        v[i] := out_v[i]
    else:
      if mode >= 3:
        let next_p = array.fill count 0.0
        let next_v = array.fill count 0.0
        for i in 0 .. count:
          let current = $motion.Spring {value: p[i], velocity: v[i]}
          let next = if mode == 3 then springs.step prepared current target[i] else motion.spring current target[i] 8.0 damping 0.016
          next_p[i] := next.value
          next_v[i] := next.velocity
        for i in 0 .. count:
          p[i] := next_p[i]
          v[i] := next_v[i]
      else:
        let next = array.generate count (func i => return do:
          let s = $motion.Spring {value: p[i], velocity: v[i]}
          return if mode == 0 then motion.spring s target[i] 8.0 damping 0.016 else springs.step prepared s target[i])
        for i in 0 .. count:
          p[i] := next[i].value
          v[i] := next[i].velocity
  return array.concat p v
entry func spring_scalar (count:U32) => return spring_run 0 0.4 count
entry func spring_prepared (count:U32) => return spring_run 1 0.4 count
entry func spring_columns (count:U32) => return spring_run 3 0.4 count
entry func spring_columns_unprepared (count:U32) => return spring_run 4 0.4 count
entry func spring_simd (count:U32) => return spring_run 2 0.4 count
entry func critical_scalar (count:U32) => return spring_run 0 1.0 count
entry func critical_simd (count:U32) => return spring_run 2 1.0 count
entry func over_scalar (count:U32) => return spring_run 0 2.5 count
entry func over_simd (count:U32) => return spring_run 2 2.5 count

const camera = $render.Sight { view: math.Mat4.identity, fx: 1.2, fy: 1.4,
  horizontal: sqrt (1.2 * 1.2 + 1.0), vertical: sqrt (1.4 * 1.4 + 1.0), near: 0.1, far: 100.0 }
func bounds_run (vector: Bool) -> (count: U32) => return do:
  let x = array.generate count (func i => return U32.to_f32 (i % 9) - 4.0)
  let y = array.generate count (func i => return U32.to_f32 (i % 11) - 5.0)
  let z = array.generate count (func i => return 3.0 - U32.to_f32 (i % 129))
  let radius = array.generate count (func i => return U32.to_f32 (i % 3) * 0.5)
  let $Some spheres = bounds.spheres x y z radius else:
    return @panic "sphere bounds"
  let visible = array.fill count 0
  let pixels = array.fill count 0.0
  for 0 .. 16:
    if vector:
      bounds.classify_into camera 1080.0 spheres visible pixels
    else:
      for i in 0 .. count:
        visible[i] := if render.sees camera (math.vec3 x[i] y[i] z[i]) radius[i] then 1 else 0
      for i in 0 .. count:
        pixels[i] := lod.projected 1080.0 camera.fy camera.near (-z[i]) (2.0*radius[i]) radius[i]
  return array.concat (array.map U32.to_f32 visible) pixels
entry func bounds_scalar (count:U32) => return bounds_run false count
entry func bounds_simd (count:U32) => return bounds_run true count
