import * as frozen_library from "ink/map/frozen"
import * as buffer from "ink/buffer"
import * as graph from "ink/graph"
import * as path from "ink/path"
import { Vec3 } from "std/vector"
// Audit experiments, not replacement library APIs. Paired entries preserve
// witnesses; restricted prototypes state their assumptions at the boundary.
import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as pages from "ink/pages"
import * as messages from "ink/messages"
import * as map from "ink/map"
import * as hash from "ink/hash"
import * as handles from "ink/handles"
import * as profile from "ink/profile"
import * as pen_profile from "ink/pen/profile"
import * as audit_profile from "./audit_profile"
import * as ui from "ink/ui"
import * as navigation from "ink/navigation"
const sum = fn (values: Array U32) => do:
  let total = 0
  for value in values:
    total := self + value
  return total

// Equivalent single-item append using one paged edit, bypassing general dirty
// selection. Epoch and overflow handling must be retained in a production API.
const direct_write = fn value (log: messages.Messages U32) => do:
  let next = log.next + 1
  let storage = log.storage
  if log.capacity > 0:
    if storage.count < log.capacity:
      storage := pages.push value storage
    else:
      storage := pages.set (log.next % log.capacity) value storage
  return #messages.Messages {epoch: log.epoch, capacity: log.capacity, next,
    oldest: next - min next log.capacity, storage}
const single_messages = fn direct (count: U32) => do:
  let log: messages.Messages U32 = messages.empty 1 count
  for i in 0 .. count * 2:
    log := if direct then direct_write i log else messages.write i log
  let #messages.Items {values} = messages.read (messages.beginning log) log else:
    return @panic "message retention witness"
  return #[values.length, sum values, log.next]
entry const message_general = single_messages #False
entry const message_direct = single_messages #True

type Value is data = #Value U32
const simulation = ecs.build (ecs.register_component (#Value 0) (ecs.new ()))
const rare = fn anchored (count: U32) => do:
  let (_, result) = ecs.create simulation (fn () => do:
    use ecs.spawn_many count
    use ecs.insert_selected #Value (array.generate 64 (fn i => i * (count / 64))) (array.generate 64 (fn i => #Value i))
    use source <- query.source 1 #Value
    use view <- ecs.view #Value
    let total = 0
    let length = 0
    for round in 0 .. 32:
      let ids = #[]
      if anchored:
        ids := ecs.indices view
      else:
        use plan <- query.select (#query.With 1) #[source]
        ids := plan.indices
      total := self + sum ids
      length := self + ids.length
    return #[length, total])
  return result
entry const query_universe = rare #False
entry const query_anchor = rare #True

// A deliberately read-only U32 prototype. Keys include the whole U32 range;
// occupancy is separate. It has no persistent edits or generic key policy.
type Frozen is data = #Frozen {mask: U32, keys: Array U32, values: Array U32, used: Array Bool}
const frozen = fn (count: U32) => do:
  let capacity = 1
  for unused in 0 .. 31:
    if capacity >= count * 2:
      break
    capacity := self * 2
  let mask = capacity - 1
  let keys = array.fill capacity 0
  let values = array.fill capacity 0
  let used = array.fill capacity #False
  for i in 0 .. count:
    let key = 0xFFFFFFFF - i
    let at = hash.u32 key & mask
    for unused in 0 .. capacity:
      if Bool.not used[at]:
        break
      at := (self + 1) & mask
    keys[at] := key
    values[at] := i * 3 + 1
    used[at] := #True
  return #Frozen {mask, keys, values, used}
const frozen_get = fn (key: U32) (table: Frozen) => do:
  let at = hash.u32 key & table.mask
  for unused in 0 .. table.keys.length:
    if Bool.not table.used[at]:
      return #Nothing
    if table.keys[at] == key:
      return #Some table.values[at]
    at := (self + 1) & table.mask
  return #Nothing
const map_reads = fn flat (count: U32) => do:
  let total = 0
  if flat:
    let table = frozen count
    for i in 0 .. count * 4:
      total := self + Maybe.unwrap_or 0 (frozen_get (0xFFFFFFFF - (i * 17 % count)) table)
  else:
    let table = map.from map.u32 (array.generate count (fn i => (0xFFFFFFFF - i, i * 3 + 1)))
    for i in 0 .. count * 4:
      total := self + Maybe.unwrap_or 0 (map.get map.u32 (0xFFFFFFFF - (i * 17 % count)) table)
  return #[count, total]
entry const map_persistent = map_reads #False
entry const map_frozen = map_reads #True

// Separate entry bodies avoid letting a shared conditional itself defeat the
// ownership optimization being compared.
entry const writes_slice = fn (count: U32) => do:
  let before = array.generate count identity
  let values = array.slice 0 count before
  for i in 0 .. count:
    values[i] := self + 1
  return #[sum before, sum values]
entry const writes_generate = fn (count: U32) => do:
  let before = array.generate count identity
  let values = array.generate count (fn i => before[i])
  for i in 0 .. count:
    values[i] := self + 1
  return #[sum before, sum values]
entry const writes_branches = fn (count: U32) => do:
  let values = array.fill count 0
  for i in 0 .. count:
    if i % 2 == 0:
      values[i] := i + 1
    else:
      values[i] := i + 3
  return #[sum values]
entry const writes_merged = fn (count: U32) => do:
  let values = array.fill count 0
  for i in 0 .. count:
    values[i] := i + (if i % 2 == 0 then 1 else 3)
  return #[sum values]
const collected = fn comprehension (count: U32) => do:
  let indices = array.generate count identity
  let rows = if comprehension then #[#[i, i + 1] | i <- indices] else array.generate count (fn i => #[i, i + 1])
  let total = 0
  for row in rows:
    total := self + row[0] + row[1]
  return #[rows.length, total]
entry const collect_comprehension = collected #True
entry const collect_generate = collected #False

type Kind is data = #Kind
const encode_handles = fn exact (count: U32) => do:
  let (store, _) = handles.from_dense #Kind 7 13 (array.generate count identity)
  let values = handles.values store
  let words = #[]
  if exact:
    // Exact format for this dense, never-deleted store. Production requires
    // a generic two-pass writer that also includes free/retired slots.
    let header = #[1, 7, 13, 0xFFFFFFFF, count, count, 0]
    words := array.generate (7 + count * 7) (fn at => do:
      if at < 7:
        return header[at]
      let slot = at - 7
      if slot < count * 4:
        return case slot % 4 of
          0 => slot / 4
          1 => 13
          2 => 0
          _ => 1
      let owner = slot - count * 4
      if owner < count:
        return owner
      let value = owner - count
      return if value % 2 == 0 then 1 else values[value / 2])
  else:
    words := handles.encode (fn value => #[value]) store
  return #[words.length, sum words]
entry const handles_concat = encode_handles #False
entry const handles_exact = encode_handles #True

const profile_nodes = fn count => array.generate count (fn i => #profile.Node {
  depth: i % 4, function: i % 8, first: U32.to_f32 i, samples: 8.0,
  alone: U32.to_f32 (i % 8 + 1), name: #[]})
entry const profile_parse = fn (count: U32) => do:
  let packet = array.generate (1 + count * 6) (fn at => do:
    if at == 0:
      return 0.0
    let i = (at - 1) / 6
    return case (at - 1) % 6 of
      0 => U32.to_f32 (i % 4)
      1 => U32.to_f32 (i % 8)
      2 => U32.to_f32 i
      3 => 8.0
      4 => U32.to_f32 (i % 8 + 1)
      _ => 0.0)
  let #Some flame = pen_profile.flame packet else:
    return @panic "profile decode witness"
  return #[flame.nodes.length, flame.hottest.length]
entry const profile_two_pass = fn (count: U32) => do:
  let packet = array.generate (1 + count * 6) (fn at => do:
    if at == 0:
      return 0.0
    let i = (at - 1) / 6
    return case (at - 1) % 6 of
      0 => U32.to_f32 (i % 4)
      1 => U32.to_f32 (i % 8)
      2 => U32.to_f32 i
      3 => 8.0
      4 => U32.to_f32 (i % 8 + 1)
      _ => 0.0)
  let #Some flame = audit_profile.flame_two_pass packet else:
    return @panic "profile decode witness"
  return #[flame.nodes.length, flame.hottest.length]
entry const profile_hot = fn (count: U32) => do:
  let hot = profile.hottest (profile_nodes count) 8
  return #[hot.length, hot[0].function]
entry const profile_layout = fn (count: U32) => do:
  let blocks = profile.layout (#ui.Rect {x: 0.0, y: 0.0, width: 1000.0, height: 100.0}) 10.0 0 (U32.to_f32 (count + 8)) (profile_nodes count)
  return #[blocks.length]

entry const navigation_short = fn (count: U32) => do:
  let #Some grid = navigation.grid count count (array.fill (count * count) 1.0) else:
    return @panic "grid witness"
  let cells = 0
  let expanded = 0
  for round in 0 .. 16:
    let #Some path = navigation.astar grid 0 1 2 else:
      return @panic "short path witness"
    cells := self + path.cells.length
    expanded := self + path.expanded
  return #[cells, expanded]


entry const map_frozen_library = fn (count: U32) => do:
  let table = frozen_library.from map.u32 (array.generate count (fn i => (0xFFFFFFFF - i, i * 3 + 1)))
  let total = 0
  for i in 0 .. count * 4:
    total := self + Maybe.unwrap_or 0 (frozen_library.get map.u32 (0xFFFFFFFF - (i * 17 % count)) table)
  return #[count, total]
entry const buffer_build = fn (count: U32) => do:
  let collected = buffer.empty ()
  for i in 0 .. count:
    collected := buffer.append #[i, i + 1] collected
  let words = buffer.finish collected
  return #[words.length, sum words]
entry const graph_chain = fn (count: U32) => do:
  let adjacency = graph.from_lists (array.generate count (fn i => if i + 1 == count then #[] else #[i + 1]))
  let reached = graph.reachable adjacency #[0] (array.fill count #True)
  let #Some waves = graph.waves 16 adjacency else:
    return @panic "graph chain witness"
  let total = 0
  for seen in reached:
    total := self + (if seen then 1 else 0)
  return #[total, waves.length, sum (array.flatten waves)]
const path_queries = fn prepared (count: U32) => do:
  let points = array.generate count (fn i => #Vec3 {x: U32.to_f32 i, y: 0.0, z: 0.0})
  let #Some cached = path.prepare points else:
    return @panic "prepared path witness"
  let total = 0
  for i in 0 .. count * 4:
    let distance = U32.to_f32 ((i * 17) % count)
    let #Some (point, yaw) = (if prepared then path.sample cached distance else path.along points distance) else:
      return @panic "path query witness"
    total := self + F32.to_u32 point.x
  return #[count, total]
entry const path_prepared = path_queries #True
entry const path_scanned = path_queries #False
