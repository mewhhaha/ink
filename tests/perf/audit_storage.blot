import * as frozen_library from "ink/map/frozen"
import * as buffer from "ink/buffer"
import * as graph from "ink/graph"
import * as path from "ink/path"
import { Vec3 } from "std/vector"
// Audit experiments, not replacement library APIs. Paired entries preserve
// witnesses; restricted prototypes state their assumptions at the boundary.
import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as pages from "ink/pages"
import * as messages from "ink/messages"
import * as map from "ink/map"
import * as hash from "ink/hash"
import * as handles from "ink/handles"
import * as profile from "ink/profile"
import * as pen_profile from "ink/pen/profile"
import * as audit_profile from "./audit_profile"
import * as ui from "ink/ui"
import * as navigation from "ink/navigation"
func sum values =>
  let total = 0
  for value in values:
    total := self + value
  return total

// Restricted single-item ring append, independent of the general writer.
// These bounded experiments never exhaust U32 sequence numbers.
func direct_write value -> (log:own messages.Messages U32) -> (meta:own messages.Metadata) =>
  let next=meta[2]+1
  if meta[1]>0:
    if log.length<meta[1]:
      @storage.push log value
    else:
      log[meta[2]%meta[1]] := value
  meta[2] := next
  meta[3] := next-min next meta[1]
  return (log, meta)
func single_messages direct -> (count:U32) =>
  let log:messages.Messages U32=messages.empty ()
  let meta=messages.metadata 1 count
  let state = (log, meta)
  for i in 0 .. count*2:
    state := do:
      let (l, m) = self
      break if direct then direct_write i l m else messages.write i l m
  let (log, meta) = state
  let output:#[~U32]=#[]
  let $messages.Items {values}=messages.read (messages.beginning meta) log meta output else:
    return panic "message retention witness"
  return #[values.length,sum values,meta[2]]
entry func message_general (count:U32) => single_messages false count
entry func message_direct (count:U32) => single_messages true count

type Value is data = $Value U32
func rare anchored -> (count:U32) =>
  let alive=ecs.entities ()
  let entity_meta=ecs.metadata 1
  let values:ecs.Pool Value=ecs.pool ()
  let value_meta=ecs.metadata 1
  let (_, alive, entity_meta) = ecs.spawn_many alive entity_meta count
  let (values, value_meta) = ecs.insert_selected alive values value_meta (array.generate 64 (func i => i*(count/64))) (array.generate 64 (func i => $Value i))
  let membership:#[~Bool]=#[]
  let source=query.source 1 values value_meta membership
  let key:#[~U32]=#[]
  let selected:#[~U32]=#[]
  let plan_meta=#[0]
  let total=0
  let length=0
  for round in 0 .. 32:
    if anchored:
      let ids=ecs.indices alive values
      total := self+sum ids
      length := self+ids.length
    else:
      plan_meta[0] := 0
      plan_meta := query.prepare alive entity_meta #[$query.With 1] #[source] key selected plan_meta
      total := self+sum selected
      length := self+selected.length
  return #[length,total]
entry func query_universe (count:U32) => rare false count
entry func query_anchor (count:U32) => rare true count

// A deliberately read-only U32 prototype. Keys include the whole U32 range;
// occupancy is separate. It has no persistent edits or generic key policy.
type Frozen is data = $Frozen {mask: U32, keys: #[U32], values: #[U32], used: #[Bool]}
func with_frozen (count: U32) -> run =>
  let capacity = 1
  for unused in 0 .. 31:
    if capacity >= count * 2:
      break
    capacity := self * 2
  let mask = capacity - 1
  let keys = array.fill capacity 0
  let values = array.fill capacity 0
  let used = array.fill capacity false
  for i in 0 .. count:
    let key = 0xFFFFFFFF - i
    let at = hash.u32 key & mask
    for unused in 0 .. capacity:
      if not used[at]:
        break
      at := (self + 1) & mask
    keys[at] := key
    values[at] := i * 3 + 1
    used[at] := true
  return run ($Frozen {mask,keys,values,used})
func frozen_get (key: U32) -> (table: Frozen) =>
  let at = hash.u32 key & table.mask
  for unused in 0 .. table.keys.length:
    if not table.used[at]:
      return $Nothing
    if table.keys[at] == key:
      return $Some table.values[at]
    at := (self + 1) & table.mask
  return $Nothing
func map_reads flat -> (count:U32) =>
  let total=0
  if flat:
    total := with_frozen count (func table =>
      let subtotal=0
      for i in 0 .. count*4:
        subtotal := self+Maybe.unwrap_or 0 (frozen_get (0xFFFFFFFF-(i*17%count)) table)
      return subtotal)
  else:
    let table:map.Map [U32,U32]=map.from map.u32 (array.generate count (func i => (0xFFFFFFFF-i,i*3+1))) (map.empty ())
    for i in 0 .. count*4:
      total := self+Maybe.unwrap_or 0 (map.get map.u32 (0xFFFFFFFF-(i*17%count)) table)
  return #[count,total]
entry func map_persistent (count:U32) => map_reads false count
entry func map_frozen (count:U32) => map_reads true count

// Separate entry bodies avoid letting a shared conditional itself defeat the
// ownership optimization being compared.
entry func writes_slice (count: U32) =>
  let before = array.generate count identity
  let values = array.slice 0 count before
  for i in 0 .. count:
    values[i] := self + 1
  return #[sum before, sum values]
entry func writes_generate (count: U32) =>
  let before = array.generate count identity
  let values = array.generate count (func i => before[i])
  for i in 0 .. count:
    values[i] := self + 1
  return #[sum before, sum values]
entry func writes_branches (count: U32) =>
  let values = array.fill count 0
  for i in 0 .. count:
    if i % 2 == 0:
      values[i] := i + 1
    else:
      values[i] := i + 3
  return #[sum values]
entry func writes_merged (count: U32) =>
  let values = array.fill count 0
  for i in 0 .. count:
    values[i] := i + (if i % 2 == 0 then 1 else 3)
  return #[sum values]
func collected comprehension -> (count: U32) =>
  let indices = array.generate count identity
  let rows = if comprehension then #[(i,i+1) | i <- indices] else array.generate count (func i => (i,i+1))
  let total = 0
  for row in rows:
    let (first,second)=row
    total := self+first+second
  return #[rows.length, total]
entry func collect_comprehension (count:U32) => collected true count
entry func collect_generate (count:U32) => collected false count

type Kind is data = $Kind
func encode_handles exact -> (count: U32) =>
  let store: handles.Store [Kind, U32] = handles.empty $Kind 7 13 0xFFFFFFFF
  for i in 0 .. count:
    let (_, next_store) = handles.insert $Kind i store
    store := next_store
  let values = handles.values store
  let words:#[~U32]=#[]
  if exact:
    // Exact format for this dense, never-deleted store. Production requires
    // a generic two-pass writer that also includes free/retired slots.
    let header = #[1, 7, 13, 0xFFFFFFFF, count, count, 0]
    let exact_words=array.generate (7 + count * 7) (func at =>
      if at < 7:
        return header[at]
      let slot = at - 7
      if slot < count * 4:
        return case slot % 4 of
          0 => slot / 4
          1 => 13
          2 => 0
          _ => 1
      let owner = slot - count * 4
      if owner < count:
        return owner
      let value = owner - count
      return if value % 2 == 0 then 1 else values[value / 2])
    for word in exact_words:
      @storage.push words word
  else:
    let general_words=handles.encode (func value => #[value]) store
    for word in general_words:
      @storage.push words word
  return #[words.length, sum words]
entry func handles_concat (count:U32) => encode_handles false count
entry func handles_exact (count:U32) => encode_handles true count

const empty_profile_name:#[U32]=#[]
func profile_nodes count => array.generate count (func i => $profile.Node {
  depth: i % 4, function: i % 8, first: U32.to_f32 i, samples: 8.0,
  alone: U32.to_f32 (i % 8 + 1), name: &empty_profile_name[0..0]})
entry func profile_parse (count: U32) =>
  let packet = array.generate (1 + count * 6) (func at =>
    if at == 0:
      return 0.0
    let i = (at - 1) / 6
    return case (at - 1) % 6 of
      0 => U32.to_f32 (i % 4)
      1 => U32.to_f32 (i % 8)
      2 => U32.to_f32 i
      3 => 8.0
      4 => U32.to_f32 (i % 8 + 1)
      _ => 0.0)
  let parsed_1_text:#[~U32] = #[]
  let parsed_1_hot:#[~profile.Hot] = #[]
  let parsed_1_nodes:#[~profile.Node] = #[]
  let $Some flame = pen_profile.flame parsed_1_text parsed_1_hot parsed_1_nodes packet else:
    return panic "profile decode witness"
  return #[flame.nodes.length, flame.hottest.length]
entry func profile_two_pass (count: U32) =>
  let packet = array.generate (1 + count * 6) (func at =>
    if at == 0:
      return 0.0
    let i = (at - 1) / 6
    return case (at - 1) % 6 of
      0 => U32.to_f32 (i % 4)
      1 => U32.to_f32 (i % 8)
      2 => U32.to_f32 i
      3 => 8.0
      4 => U32.to_f32 (i % 8 + 1)
      _ => 0.0)
  let parsed_2_text:#[~U32] = #[]
  let parsed_2_hot:#[~profile.Hot] = #[]
  let parsed_2_nodes:#[~profile.Node] = #[]
  let $Some flame = audit_profile.flame_two_pass parsed_2_text parsed_2_hot parsed_2_nodes packet else:
    return panic "profile decode witness"
  return #[flame.nodes.length, flame.hottest.length]
entry func profile_hot (count: U32) =>
  let hot = profile.hottest (profile_nodes count) 8
  return #[hot.length, hot[0].function]
entry func profile_layout (count: U32) =>
  let blocks = profile.layout ($ui.Rect {x: 0.0, y: 0.0, width: 1000.0, height: 100.0}) 10.0 0 (U32.to_f32 (count + 8)) (profile_nodes count)
  return #[blocks.length]

entry func navigation_short (count: U32) =>
  let costs=array.fill (count*count) 1.0
  let $Some grid=navigation.grid count count (&costs[0..costs.length]) else:
    return panic "grid witness"
  let cells = 0
  let expanded = 0
  let path_points:#[~U32]=#[]
  for round in 0 .. 16:
    let $Some path = navigation.astar_into path_points grid 0 1 2 else:
      return panic "short path witness"
    cells := self + path.cells.length
    expanded := self + path.expanded
  return #[cells, expanded]


entry func map_frozen_library (count: U32) =>
  let table = frozen_library.from map.u32 (array.generate count (func i => (0xFFFFFFFF - i, i * 3 + 1)))
  let total = 0
  for i in 0 .. count * 4:
    total := self + Maybe.unwrap_or 0 (frozen_library.get map.u32 (0xFFFFFFFF - (i * 17 % count)) table)
  return #[count, total]
entry func buffer_build (count: U32) =>
  let collected:buffer.Buffer U32=buffer.empty ()
  for i in 0 .. count:
    buffer.append #[i,i+1] collected
  let words = buffer.finish collected
  return #[words.length, sum words]
entry func graph_chain (count: U32) =>
  let starts:#[~U32]=#[]
  let targets:#[~U32]=#[]
  let edge_count=if count==0 then 0 else count-1
  let (built, starts, targets) = graph.from_edges count (array.generate edge_count identity) (array.generate edge_count (func i => i+1)) starts targets
  if not built:
    panic "graph chain endpoints"
  let adjacency = graph.borrow starts targets
  let reached=graph.reachable adjacency #[0] (array.fill count true)
  let wave_starts:#[~U32]=#[]
  let wave_nodes:#[~U32]=#[]
  let $Some waves=graph.waves 16 adjacency wave_starts wave_nodes else:
    panic "graph chain witness"
  let total=0
  for seen in reached:
    total := total+(if seen then 1 else 0)
  return #[total,waves.starts.length-1,sum waves.nodes]
func path_queries prepared -> (count: U32) =>
  let points = array.generate count (func i => $Vec3 {x: U32.to_f32 i, y: 0.0, z: 0.0})
  let $Some cached = path.prepare points else:
    return panic "prepared path witness"
  let total = 0
  for i in 0 .. count * 4:
    let distance = U32.to_f32 ((i * 17) % count)
    let $Some (point, yaw) = (if prepared then path.sample cached distance else path.along points distance) else:
      return panic "path query witness"
    total := self + F32.to_u32 point.x
  return #[count, total]
entry func path_prepared (count:U32) => path_queries true count
entry func path_scanned (count:U32) => path_queries false count
