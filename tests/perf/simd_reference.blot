// Frozen pre-SIMD kernels for differential checks and paired measurements.
import * as array from "std/array"
import * as field from "ink/field"
import * as lanes from "ink/lanes"
func changed_rows (grid: field.Grid) -> (dirty: Array Bool) -> (before: Array F32) -> (after: Array F32) => return do:
  if dirty.length != grid.height:
    return @panic "field row mask length mismatch"
  let mask = array.fill (field.count grid) false
  let zero = array.fill grid.width 0.0
  for y in 0 .. grid.height:
    if dirty[y]:
      if before.length % grid.width != 0 or after.length % grid.width != 0:
        return @panic "field sample row width mismatch"
      let has_a = y < before.length / grid.width
      let has_b = y < after.length / grid.width
      let a = if has_a then before else zero
      let b = if has_b then after else zero
      let offset_a = if has_a then y * grid.width else 0
      let offset_b = if has_b then y * grid.width else 0
      for column in 0 .. grid.columns:
        let tile = y / grid.tile_height * grid.columns + column
        if Bool.not mask[tile]:
          let left = column * grid.tile_width
          let right = left + min grid.tile_width (grid.width - left)
          for x in left .. right:
            if a[offset_a + x] != b[offset_b + x]:
              mask[tile] = true
              break
  return mask

func pack (capacity: U32) => return func (payload: Array U32) => return do:
  let size = if capacity == 0 then payload.length else capacity
  use lanes.require (payload.length <= size and size <= (lanes.max_integer - 2) / 2)
  return array.generate (2 + size * 2) (func i => return do:
    let word = 0
    if i < 2:
      word := payload.length
    else:
      let at = (i - 2) / 2
      if at < payload.length:
        word := payload[at]
    return U32.to_f32 (if i % 2 == 0 then word & 65535 else word >> 16))

func unpack (capacity: U32) => return func (payload: Array F32) : Maybe (Array U32) => return do:
  if payload.length < 2 or payload.length % 2 != 0:
    return $Nothing
  for value in payload:
    if Bool.not (is_finite value) or value < 0.0 or value > 65535.0 or floor value != value:
      return $Nothing
  let count = F32.to_u32 payload[0] | (F32.to_u32 payload[1] << 16)
  let size = (payload.length - 2) / 2
  if count > size or (capacity == 0 and count != size) or (capacity != 0 and size != capacity):
    return $Nothing
  for i in 2 + count * 2 .. payload.length:
    if payload[i] != 0.0:
      return $Nothing
  return $Some (array.generate count (func i => return F32.to_u32 payload[2 + i * 2] | (F32.to_u32 payload[3 + i * 2] << 16)))

