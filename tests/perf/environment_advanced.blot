import * as math from "ink/math"
import * as rterrain from "ink/render/terrain"
import * as water from "ink/render/water"
import * as foliage from "ink/render/foliage"

entry func render_terrain_batch (count: U32) : #[F32] =>
  let cfg = rterrain.default_config ()
  let total_nodes = 0
  let morph_sum = 0.0
  for i in 0 .. count:
    let nodes = rterrain.select_nodes cfg (U32.to_f32 (i * 3 % 256)) (U32.to_f32 (i * 5 % 256)) 0.0 0.0
    total_nodes := self + nodes.length
    let sw = rterrain.splat_weights 0.5 0.3 0.15 0.05 0.4 0.7 0.2 0.1 0.25
    morph_sum := self + sw.x + sw.y + sw.z + sw.w
  return #[U32.to_f32 count, U32.to_f32 total_nodes, morph_sum]

entry func render_water_batch (count: U32) : #[F32] =>
  let waves = #[
    $water.Wave { dir_x: 1.0, dir_z: 0.2, amplitude: 0.35, wavelength: 14.0, steepness: 0.65, speed: 3.1 },
    $water.Wave { dir_x: (-0.3), dir_z: 0.95, amplitude: 0.22, wavelength: 8.5, steepness: 0.5, speed: 2.4 },
    $water.Wave { dir_x: 0.7, dir_z: (-0.7), amplitude: 0.12, wavelength: 4.2, steepness: 0.4, speed: 1.8 },
  ]
  let ny_sum = 0.0
  let foam_sum = 0.0
  for i in 0 .. count:
    let fi = U32.to_f32 i
    let s = water.sample_gerstner waves (fi * 0.75) (fi * 0.5) 1.25
    ny_sum := self + s.normal.y
    foam_sum := self + s.foam
  return #[U32.to_f32 count, ny_sum, foam_sum]

entry func render_foliage_batch (count: U32) : #[F32] =>
  let w = $foliage.Wind { dir_x: 0.8, dir_z: 0.6, strength: 1.4, gust_freq: 0.25, gust_speed: 2.2, turbulence: 0.35 }
  let bend_sum = 0.0
  let tile_sum = 0
  for i in 0 .. count:
    let fi = U32.to_f32 i
    let disp = foliage.bend_displacement w (math.vec3 fi 0.0 (fi * 0.5)) 0.85 1.2 2.5
    bend_sum := self + disp.x + disp.z
    let frame = foliage.impostor_frame (math.vec3 (cos fi) 0.5 (sin fi)) 8 true
    tile_sum := self + frame.col + frame.row
  return #[U32.to_f32 count, bend_sum, U32.to_f32 tile_sum]
