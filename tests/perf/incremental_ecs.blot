import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as commands from "ink/ecs/commands"
import * as recipe from "ink/ecs/recipe"
import * as messages from "ink/messages"
import * as journal from "ink/journal"
import * as relations from "ink/relations"
import * as map from "ink/map"
type Value is data = $Value U32
type Column = {alive:ecs.Entities,entity_meta:ecs.Metadata,values:ecs.Pool Value,meta:ecs.Metadata}
func with_column count -> run =>
  let alive=ecs.entities ()
  let entity_meta=ecs.metadata 1
  let values:ecs.Pool Value=ecs.pool ()
  let meta=ecs.metadata 1
  let ids=ecs.spawn_many alive entity_meta count
  ecs.insert_selected alive values meta ids (array.generate count (func i => $Value i))
  return run {alive,entity_meta,values,meta}
func value entry => case entry of
  $Some ($Value n) => n
  _ => 0
func prepare (column:Column) -> key -> selected -> meta =>
  let membership:#[~Bool]=#[]
  let source=query.source 1 column.values column.meta membership
  query.prepare column.alive column.entity_meta #[$query.With 1] #[source] key selected meta
  return ()
func queries cached -> (count:U32) => with_column count (func (column:Column) =>
  let key:#[~U32]=#[]
  let selected:#[~U32]=#[]
  let meta:#[U32]=#[0]
  let total=0
  for round in 0 .. 32:
    if ecs.contains column.values 0:
      ecs.write column.values column.meta 0 ($Value round)
    if not cached:
      meta[0] := 0
      @storage.truncate key 0
      @storage.truncate selected 0
    prepare column key selected meta
    total := self+selected.length
  return #[total,value (ecs.read column.values 0)])
entry func query_cached (count:U32) : #[U32] => queries true count
entry func query_uncached (count:U32) : #[U32] => queries false count
func edits batch -> (count:U32) => with_column count (func (column:Column) =>
  let old:ecs.Pool Value=ecs.pool ()
  ecs.copy_into identity old column.values
  if batch:
    commands.apply column.alive column.values column.meta (array.generate count (func i => $commands.Put {entity:i,value:$Value (i+1)}))
  else:
    for i in 0 .. count:
      ecs.insert column.alive column.values column.meta i ($Value (i+1))
  let total=0
  for component in column.values:
    if let $Some ($Value n)=component:
      total := self+n
  return #[total,value (ecs.read old (count-1))])
entry func command_batch (count:U32) : #[U32] => edits true count
entry func immediate_edits (count:U32) : #[U32] => edits false count
entry func streams (count:U32) =>
  let log:messages.Messages U32=messages.empty ()
  let meta=messages.metadata 1 count
  let reader=messages.cursor meta
  messages.write_many (array.generate count identity) log meta
  let delivered:#[~U32]=#[]
  let $messages.Items {values}=messages.read reader log meta delivered else:
    return panic "message gap"
  let tracked=journal.empty ()
  let tracked_meta=journal.metadata 1 (count*2)
  let cursor=journal.cursor tracked_meta
  journal.record_many (array.generate count (func i => $journal.Added i)) tracked tracked_meta
  journal.record_many (array.generate (count/2) (func i => $journal.Removed (i*2))) tracked tracked_meta
  let scratch:#[~journal.Change]=#[]
  let updated:#[~U32]=#[]
  let removed:#[~U32]=#[]
  let $journal.Delta {changes}=journal.read_into cursor tracked tracked_meta scratch updated removed else:
    return panic "journal gap"
  let total=0
  for value in values:
    total := self+value
  return #[total,changes.updated.length,changes.removed.length]
func incoming indexed -> (rounds:U32) -> (count:U32) =>
  let total=0
  if indexed:
    let edges:relations.Relations [U32,U32]=relations.empty ()
    let slots=relations.buckets ()
    for i in 0 .. count:
      relations.link map.u32 i (i%32) edges slots
    for round in 0 .. rounds:
      for target in 0 .. 32:
        total := relations.fold_sources map.u32.equal (func (sum:U32) -> (source:U32) => sum+source) total target edges
  else:
    let edges=array.generate count (func i => (i,i%32))
    for round in 0 .. rounds:
      for target in 0 .. 32:
        for edge in edges:
          let (source,destination)=edge
          if target==destination:
            total := self+source
  return #[total]
entry func relations_indexed (count:U32) : #[U32] => incoming true 16 count
entry func relations_scanned (count:U32) : #[U32] => incoming false 16 count
entry func recipes (count:U32) =>
  let requirements=array.generate (if count==0 then 0 else count-1) identity
  let definitions=array.generate count (func i => $recipe.Requirement {key:i,requires:recipe.span (if i==0 then 0 else i-1) (if i==0 then 0 else 1)})
  let keys:#[~U32]=#[]
  let $recipe.Ok plan=recipe.plan definitions requirements #[count-1] keys else:
    return panic "invalid recipe"
  let total=0
  for key in plan.keys:
    total := self+key
  return #[plan.keys.length,total]
entry func relations_reused (count:U32) : #[U32] => incoming true 128 count
entry func relations_rescanned (count:U32) : #[U32] => incoming false 128 count
