import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as commands from "ink/ecs/commands"
import * as recipe from "ink/ecs/recipe"
import * as messages from "ink/messages"
import * as journal from "ink/journal"
import * as relations from "ink/relations"
import * as map from "ink/map"
type Value is data = $Value U32
const simulation = ecs.build (ecs.register_component ($Value 0) (ecs.new ()))
const value = func entry => return case entry of
  $Some ($Value n) => n
  _ => 0
const queries = func cached -> (count: U32) => return do:
  let (_, result) = ecs.create simulation (func () => return do:
    use ecs.spawn_many count
    use ecs.insert_selected $Value (array.generate count identity) (array.generate count (func i => return $Value i))
    let cache = query.empty
    let total = 0
    for round in 0 .. 32:
      use ecs.update_selected $Value #[0] (func id -> value => return $Value round)
      use source <- query.source 1 $Value
      use next <- query.prepare 1 ($query.With 1) #[source] (if cached then cache else query.empty)
      cache := next
      total := self + cache.indices.length
    use end <- ecs.component_of $Value 0
    return #[total, value end])
  return result
entry const query_cached = queries true
entry const query_uncached = queries false
const edits = func batch -> (count: U32) => return do:
  let (_, result) = ecs.create simulation (func () => return do:
    use ecs.spawn_many count
    use ecs.insert_selected $Value (array.generate count identity) (array.generate count (func i => return $Value i))
    use old <- ecs.view $Value
    if batch:
      use commands.apply $Value (array.generate count (func i => return $commands.Put {entity: i, value: $Value (i + 1)}))
    else:
      for i in 0 .. count:
        use ecs.at i (func () => return ecs.set ($Value (i + 1)))
    use current <- ecs.present $Value
    let total = 0
    for component in current:
      let $Value n = component
      total := self + n
    return #[total, value (ecs.read old (count - 1))])
  return result
entry const command_batch = edits true
entry const immediate_edits = edits false
entry const streams = func (count: U32) => return do:
  let log: messages.Messages U32 = messages.empty 1 count
  let reader = messages.cursor log
  log := messages.write_many (array.generate count identity) log
  let $messages.Items {values} = messages.read reader log else:
    return @panic "message gap"
  let tracked = journal.empty 1 (count * 2)
  let cursor = journal.cursor tracked
  tracked := journal.record_many (array.generate count (func i => return $journal.Added i)) tracked
  tracked := journal.record_many (array.generate (count / 2) (func i => return $journal.Removed (i * 2))) tracked
  let $journal.Delta {changes} = journal.read cursor tracked else:
    return @panic "journal gap"
  let total = 0
  for value in values:
    total := self + value
  return #[total, changes.updated.length, changes.removed.length]
const incoming = func indexed -> (rounds: U32) -> (count: U32) => return do:
  let total = 0
  if indexed:
    let edges = relations.empty ()
    for i in 0 .. count:
      edges := relations.link map.u32 map.u32 i (i % 32) edges
    for round in 0 .. rounds:
      for target in 0 .. 32:
        total := relations.fold_sources map.u32 target (func sum -> source => return sum + source) total edges
  else:
    let edges = array.generate count (func i => return (i, i % 32))
    for round in 0 .. rounds:
      for target in 0 .. 32:
        for edge in edges:
          let (source, destination) = edge
          if target == destination:
            total := self + source
  return #[total]
entry const relations_indexed = incoming true 16
entry const relations_scanned = incoming false 16
entry const recipes = func (count: U32) => return do:
  let definitions = array.generate count (func i => return $recipe.Requirement {key: i, requires: if i == 0 then #[] else #[i - 1]})
  let $recipe.Ok plan = recipe.plan definitions #[count - 1] else:
    return @panic "invalid recipe"
  let total = 0
  for key in plan.keys:
    total := self + key
  return #[plan.keys.length, total]

entry const relations_reused = incoming true 128
entry const relations_rescanned = incoming false 128
