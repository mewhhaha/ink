import * as array from "std/array"
import * as math from "ink/math"
import * as render from "ink/render"
import * as flap from "ink/ui/split_flap"
import * as font from "ink/ui/font"
import * as ui from "ink/ui"
import * as transform from "ink/transform"

// A quarter of columns are absent and a quarter are culled before matrices.
entry const render_columns = fn (count: U32) => do:
  let current = array.generate count (fn index => do:
    if index % 4 == 0:
      return #Nothing
    let pose = transform.identity
    pose.position := math.vec3 (U32.to_f32 index) 0.0 0.0
    return #Some pose)
  let previous = array.generate count (fn index => do:
    let pose = transform.identity
    pose.position := math.vec3 (U32.to_f32 index - 2.0) 0.0 0.0
    return #Some pose)
  let appearances = array.generate count (fn index => #Some #render.Appearance { mesh: index, material: 1 })
  let drawn = render.draw_columns_where (fn (pose: transform.Pose3) => fn (look: render.Appearance) => look.mesh % 4 != 1) current previous appearances 0.5
  let sum = 0.0
  let ids = 0
  for draw in drawn:
    sum := self + draw.matrix.w.x
    ids := self + draw.mesh
  return #[U32.to_f32 drawn.length, sum, U32.to_f32 ids]

// Oversized glyphs must stay inside their own cell throughout each half-turn.
const face = #font.Font { material: 2, ascent: 1.0, descent: 0.0, spread: 1.0,
  glyph: fn (code: U32) => #font.Glyph { u0: 0.0, v0: 0.0, u1: 1.0, v1: 1.0,
    left: 0.0, top: -1.0, width: 1.0, height: 1.0, advance: 1.0 } }
entry const split_flaps = fn (count: U32) => do:
  let sprites = 0
  let violations = 0
  for index in 0 .. count:
    let rect = #ui.Rect { x: from index * 12.0, y: 5.0, width: 10.0, height: 20.0 }
    let pieces = flap.cell face 1 65 66 rect 20.0 (from (index % 5) * 0.25)
    sprites := self + pieces.length
    for piece in pieces:
      if piece.x < rect.x || piece.y < rect.y || piece.x + piece.width > rect.x + rect.width + 0.001 || piece.y + piece.height > rect.y + rect.height + 0.001 || piece.width <= 0.0 || piece.height <= 0.0 || piece.u0 < 0.0 || piece.v0 < 0.0 || piece.u1 > 1.0 || piece.v1 > 1.0:
        violations := self + 1
  return #[U32.to_f32 sprites, U32.to_f32 violations]
