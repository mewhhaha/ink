import * as array from "std/array"
import * as math from "ink/math"
import * as render from "ink/render"
import * as flap from "ink/ui/split_flap"
import * as font from "ink/ui/font"
import * as ui from "ink/ui"
import * as transform from "ink/transform"
import * as ecs from "ink/ecs"
import * as app from "ink/app"

// A quarter of columns are absent and a quarter are culled before matrices.
entry func render_columns (count: U32) =>
  let current = array.generate count (func index =>
    if index % 4 == 0:
      return $Nothing
    let pose = transform.identity
    pose.position := math.vec3 (U32.to_f32 index) 0.0 0.0
    return $Some pose)
  let previous = array.generate count (func index =>
    let pose = transform.identity
    pose.position := math.vec3 (U32.to_f32 index - 2.0) 0.0 0.0
    return $Some pose)
  let appearances = array.generate count (func index => $Some $render.Appearance { mesh: index, material: 1 })
  let drawn = render.draw_columns_where (func (pose: transform.Pose3) => func (look: render.Appearance) => look.mesh % 4 != 1) current previous appearances 0.5
  let sum = 0.0
  let ids = 0
  for draw in drawn:
    sum := self + draw.matrix.w.x
    ids := self + draw.mesh
  return #[U32.to_f32 drawn.length, sum, U32.to_f32 ids]

type Columns={alive:ecs.Entities,entity_meta:ecs.Metadata,current:ecs.Pool transform.Pose3,current_meta:ecs.Metadata,previous:ecs.Pool transform.Pose3,previous_meta:ecs.Metadata,looks:ecs.Pool render.Appearance,look_meta:ecs.Metadata}
func with_columns count -> run =>
  let alive=ecs.entities ()
  let entity_meta=ecs.metadata 1
  let current:ecs.Pool transform.Pose3=ecs.pool ()
  let current_meta=ecs.metadata 1
  let previous:ecs.Pool transform.Pose3=ecs.pool ()
  let previous_meta=ecs.metadata 1
  let looks:ecs.Pool render.Appearance=ecs.pool ()
  let look_meta=ecs.metadata 1
  let (_, alive, entity_meta) = ecs.spawn_many alive entity_meta count
  return run (own {alive,entity_meta,current,current_meta,previous,previous_meta,looks,look_meta})
func with_frame run =>
  let settings=#[render.defaults]
  let draws:#[~render.Draw]=#[]
  let solids:#[~render.Solid]=#[]
  let decals:#[~render.Decal]=#[]
  let sprites:#[~render.Sprite]=#[]
  let insets:#[~render.Inset]=#[]
  let fields:#[~render.Field]=#[]
  let poses:#[~render.Pose]=#[]
  let bone_matrices:#[~render.BoneMatrix]=#[]
  let morph_weights:#[~render.MorphWeight]=#[]
  let motions:#[~render.Motion]=#[]
  let lights: #[~render.PointLight] = #[]
  let emitters:#[~render.Emitter]=#[]
  let ribbons:#[~render.RibbonPoint]=#[]
  let haptics:#[~render.Haptic]=#[]
  let extensions:#[~render.Extension]=#[]
  let updates:#[~render.Instance]=#[]
  let removed:#[~U32]=#[]
  return run ($render.FrameAccess {settings,draws,solids,decals,sprites,insets,fields,poses,bone_matrices,morph_weights,motions,lights,emitters,ribbons,haptics,extensions,updates,removed})
const presentation = $app.Presentation { alpha: 0.5, width: 640.0, height: 480.0 }
func pose_at (x: F32) =>
  let pose = transform.identity
  pose.position := math.vec3 x 0.0 0.0
  return pose

// Exercise the default renderer's ECS reads, including sparse columns. Setup
// and final chunk flattening are included in the benchmark.
entry func render_meshes (count:U32) => with_columns count (func (column: own Columns) =>
  let (current, current_meta) = ecs.replace_components column.alive column.current column.current_meta (array.generate count (func index => if index%4==0 then $Nothing else $Some (pose_at (U32.to_f32 index))))
  column.current := current
  column.current_meta := current_meta
  let ids=array.generate count identity
  let (previous, previous_meta) = ecs.insert_selected column.alive column.previous column.previous_meta ids (array.generate count (func index => pose_at (U32.to_f32 index-2.0)))
  column.previous := previous
  column.previous_meta := previous_meta
  let (looks, look_meta) = ecs.insert_selected column.alive column.looks column.look_meta ids (array.generate count (func index => $render.Appearance {mesh:index,material:1}))
  column.looks := looks
  column.look_meta := look_meta
  return with_frame (func frame =>
    render.draw_meshes_where (func _ -> (_:transform.Pose3) -> (look:render.Appearance) => look.mesh%4!=1) column.current column.previous column.looks presentation frame
    let shown=render.finish frame
    let sum=0.0
    let ids=0
    for draw in shown.draws:
      sum := self+draw.matrix.w.x
      ids := self+draw.mesh
    return #[U32.to_f32 shown.draws.length,sum,U32.to_f32 ids]))

// Retained views survive edits and despawns. A new entity has no previous pose;
// its current pose must be used without interpolation. Entity order is stable.
entry func render_snapshots () => with_columns 35 (func (column: own Columns) =>
  let ids=array.generate 35 identity
  let (current, current_meta) = ecs.insert_selected column.alive column.current column.current_meta ids (array.generate 35 (func index => pose_at (U32.to_f32 index*10.0)))
  column.current := current
  column.current_meta := current_meta
  let (looks, look_meta) = ecs.insert_selected column.alive column.looks column.look_meta ids (array.generate 35 (func index => $render.Appearance {mesh:index,material:1}))
  column.looks := looks
  column.look_meta := look_meta
  column.previous := ecs.checkpoint identity self column.current
  let old_current:ecs.Pool transform.Pose3=ecs.copy_into identity (ecs.pool ()) column.current
  let old_previous:ecs.Pool transform.Pose3=ecs.copy_into identity (ecs.pool ()) column.previous
  let old_looks:ecs.Pool render.Appearance=ecs.copy_into identity (ecs.pool ()) column.looks
  let (current, current_meta) = ecs.insert_selected column.alive column.current column.current_meta ids (array.generate 35 (func index => pose_at (U32.to_f32 index*10.0+4.0)))
  let (current, current_meta) = ecs.remove current current_meta 1
  let (current, current_meta) = ecs.remove current current_meta 3
  column.current := current
  column.current_meta := current_meta
  let (looks, look_meta) = ecs.remove column.looks column.look_meta 2
  let (looks, look_meta) = ecs.remove looks look_meta 3
  column.looks := looks
  column.look_meta := look_meta
  let (alive, entity_meta) = ecs.despawn column.alive column.entity_meta 3
  let (id, alive, entity_meta) = ecs.spawn alive entity_meta
  column.alive := alive
  column.entity_meta := entity_meta
  let (current, current_meta) = ecs.insert column.alive column.current column.current_meta id (pose_at 999.0)
  column.current := current
  column.current_meta := current_meta
  let (looks, look_meta) = ecs.insert column.alive column.looks column.look_meta id ($render.Appearance {mesh:35,material:1})
  column.looks := looks
  column.look_meta := look_meta
  let show=func (index:U32) -> (pose:transform.Pose3) -> (look:render.Appearance) => (index,pose.position.x,look.mesh)
  let visible=func (index:U32) -> (_:transform.Pose3) -> (_:render.Appearance) => index%4!=0
  let old=render.draw_views_indexed show visible old_current old_previous old_looks 0.5
  let next=render.draw_views_indexed show visible column.current column.previous column.looks 0.5
  return with_frame (func frame =>
    let sentinel=func (id:U32) => render.draw transform.identity ($render.Appearance {mesh:id,material:1})
    render.emit #[sentinel 100] frame
    render.push (sentinel 101) frame
    render.draw_meshes_where (func _ -> (_:transform.Pose3) -> (look:render.Appearance) => look.mesh%4!=0) column.current column.previous column.looks presentation frame
    render.push (sentinel 102) frame
    let shown=render.finish frame
    let output:#[+F32]=#[]
    for row in old:
      let (index,x,mesh)=row
      for value in #[U32.to_f32 index,x,U32.to_f32 mesh]:
        @storage.push output value
    for row in next:
      let (index,x,mesh)=row
      for value in #[U32.to_f32 index,x,U32.to_f32 mesh]:
        @storage.push output value
    for draw in shown.draws:
      @storage.push output (U32.to_f32 draw.mesh)
      @storage.push output draw.matrix.w.x
    return seal output))

// Oversized glyphs must stay inside their own cell throughout each half-turn.
const glyph= $font.Glyph {u0:0.0,v0:0.0,u1:1.0,v1:1.0,left:0.0,top:-1.0,width:1.0,height:1.0,advance:1.0}
const glyphs:#[font.Entry]=#[$font.Entry {code:65,glyph},$font.Entry {code:66,glyph}]
const face= $font.Font {material:2,ascent:1.0,descent:0.0,spread:1.0,glyphs:&glyphs[0..glyphs.length],fallback:glyph}
entry func split_flaps (count: U32) =>
  let sprites = 0
  let violations = 0
  for index in 0 .. count:
    let rect = $ui.Rect { x: U32.to_f32 index * 12.0, y: 5.0, width: 10.0, height: 20.0 }
    let pieces = flap.cell face 1 65 66 rect 20.0 (U32.to_f32 (index % 5) * 0.25)
    sprites := self + pieces.length
    for piece in pieces:
      if piece.x < rect.x or piece.y < rect.y or piece.x + piece.width > rect.x + rect.width + 0.001 or piece.y + piece.height > rect.y + rect.height + 0.001 or piece.width <= 0.0 or piece.height <= 0.0 or piece.u0 < 0.0 or piece.v0 < 0.0 or piece.u1 > 1.0 or piece.v1 > 1.0:
        violations := self + 1
  return #[U32.to_f32 sprites, U32.to_f32 violations]
