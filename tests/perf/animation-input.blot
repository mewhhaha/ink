import * as animation from "ink/animation"
import * as input from "ink/input"
import * as math from "ink/math"
import * as transform from "ink/transform"

const pose = fn (index: U32) => #transform.Pose3 { position: math.vec3 (U32.to_f32 index) 0.0 0.0, rotation: math.identity_quat, scale: math.one3 }

// First lane is the sample time; the remaining lanes are sorted key times.
entry const sample = fn (values: Array F32) => do:
  let track = #animation.Track { keys: @array.generate (values.length - 1) (fn (i: U32) => #animation.Key { time: values[i + 1], pose: pose i }) }
  let result = animation.sample_track track values[0]
  return #[result.position.x, result.position.y, result.position.z, result.rotation.x, result.rotation.y, result.rotation.z, result.rotation.w, result.scale.x, result.scale.y, result.scale.z]

// Repeated late queries isolate lookup work from authoring the key array.
entry const late_queries = fn (count: U32) => do:
  let track = #animation.Track { keys: @array.generate count (fn (i: U32) => #animation.Key { time: U32.to_f32 i, pose: pose i }) }
  let checksum = 0.0
  for i in 0..1024:
    let time = U32.to_f32 (count - 2) + U32.to_f32 (i % 4) * 0.25
    let sampled = animation.sample_track track time
    checksum := self + sampled.position.x
  return checksum

entry const restore = fn (values: Array F32) => do:
  use controls <- input.decode values
  return input.encode controls

entry const input_codec = fn (count: U32) -> Array U32 => do:
  let controls = input.empty
  controls.held := @array.generate count (fn (i: U32) => count - i)
  use restored <- input.decode (input.encode controls)
  let checksum = 0
  for i in 0..restored.held.length:
    checksum := self + (i + 1) * restored.held[i]
  return #[restored.held.length, checksum]
