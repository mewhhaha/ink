import * as array from "std/array"
import * as text from "ink/text"
import * as tree from "ink/ui/tree"
import * as ui from "ink/ui"

const empty_name:#[U32]=#[]
func flag (value:Bool) : U32 => if value then 1 else 0
func append values -> (output: own #[U32]) : #[U32] =>
  for value in values:
    @storage.push output value
  return output
func packed_views (parts:#[&[U32]]) =>
  let output:#[U32]=#[]
  for part in parts:
    @storage.push output part.length
    output := append part self
  return output
func packed_spans (input:#[U32]) -> (parts:#[text.Span]) =>
  let output:#[U32]=#[]
  for part in parts:
    @storage.push output part.count
    for i in part.start .. part.start+part.count:
      @storage.push output input[i]
  return output
func part_views (input:#[U32]) -> (parts:#[text.Span]) : #[&[U32]] =>
  return array.map (func (part:text.Span) => &input[part.start..part.start+part.count]) parts
entry func words (input:#[U32]) => packed_spans input (text.words input)
entry func lines (input:#[U32]) => packed_spans input (text.lines input)
entry func text_snapshots (input:#[U32]) =>
  let joined=text.joined #[32] #[&input[0..input.length],&input[0..input.length]]
  let words=text.words input
  let lines=text.lines input
  let changed=copy input
  for index in 0 .. changed.length:
    changed[index] := 0
  let words_joined=text.joined #[32] (part_views input words)
  let lines_joined=text.joined #[10] (part_views input lines)
  return packed_views #[&joined[0..joined.length],&words_joined[0..words_joined.length],&lines_joined[0..lines_joined.length],&changed[0..changed.length]]
entry func joined (input:#[U32]) =>
  let separator=array.slice 1 input[0] input
  let parts:#[ &[U32]]=#[]
  let at=input[0]+1
  for 0 .. input.length:
    if at<input.length:
      let length=input[at]
      let part= &input[at+1..at+1+length]
      @storage.push parts part
      at := self+length+1
  return text.joined separator parts
func with_focus run =>
  let state:#[tree.FocusState]=#[tree.unfocused]
  let returns:#[tree.Return]=#[]
  let nodes:#[tree.Stop]=#[]
  let order:#[U32]=#[]
  let reached:#[U32]=#[]
  let marked:#[tree.StoredNode]=#[]
  return run (own ($tree.Focus {state,returns,nodes,order,reached})) (own marked)
// Packed nodes: id, parent, focusable, hidden, disabled, modal, selected, role.
entry func focus (input:#[U32]) =>
  let labels:#[U32]=#[]
  let nodes:#[tree.StoredNode]=#[]
  for index in 0 .. (input.length-1)/8:
    let at=1+index*8
    let node=ui.button_node input[at] input[at+1] (&empty_name[0..0]) ui.nowhere
    node.focusable := input[at+2]!=0
    node.hidden := input[at+3]!=0
    node.disabled := input[at+4]!=0
    node.modal := input[at+5]!=0
    node.selected := input[at+6]
    node.role := input[at+7]
    let (next_labels, next_nodes) = tree.declare_owned node labels nodes
    labels := next_labels
    nodes := next_nodes
  let original=array.map (func (node:tree.StoredNode) => flag node.hidden) nodes
  return with_focus (func (held: own tree.Focus) -> (marked: own #[tree.StoredNode]) =>
    held.state[0].node := input[0]
    let (held, marked) = tree.settle (&nodes[0..nodes.length]) held marked
    let output:#[U32]=#[held.state[0].node,held.state[0].modal]
    @storage.push output held.order.length
    output := append held.order self
    @storage.push output held.reached.length
    output := append held.reached self
    for node in marked:
      @storage.push output (flag node.hidden)
    for node in marked:
      @storage.push output (flag node.focused)
    output := append original self
    return output)
entry func text_join_many (count:U32) =>
  let values=array.generate (count*2) (func i => if i%2==0 then 128578 else 97+i/2%26)
  let parts:#[&[U32]]=array.generate count (func i => &values[i*2..i*2+2])
  let joined=text.joined #[10,66615] parts
  let sum=0
  for code in joined:
    sum := self+code
  return #[count,joined.length,sum]
func split_input (count:U32) -> (delimiter:U32) => array.generate (count*3) (func index =>
  if index%3==0:
    return 128578
  if index%3==1:
    return 97+index/3%26
  return delimiter)
func split_witness (count:U32) -> input -> parts =>
  let sum=0
  let points=0
  for part in parts:
    points := self+part.count
    for index in part.start .. part.start+part.count:
      sum := self+(input.at index)
  return #[count,parts.length,points,sum]
entry func text_words_long (count:U32) =>
  let input=split_input count 32
  return split_witness count input (text.words input)
entry func text_lines_long (count:U32) =>
  let input=split_input count 10
  return split_witness count input (text.lines input)
// 32-deep groups with full-width descending ids and an open modal at each root.
entry func ui_deep_tree (count:U32) =>
  let labels:#[U32]=#[]
  let nodes:#[tree.StoredNode]=#[]
  for index in 0 .. count:
    let parent=0
    if index%32!=0:
      parent := 0xffffffff-index+1
    let node=ui.button_node (0xffffffff-index) parent (&empty_name[0..0]) ui.nowhere
    node.modal := index%32==0
    let (next_labels, next_nodes) = tree.declare_owned node labels nodes
    labels := next_labels
    nodes := next_nodes
  return with_focus (func (held: own tree.Focus) -> (marked: own #[tree.StoredNode]) =>
    let (held, marked) = tree.settle (&nodes[0..nodes.length]) held marked
    let hidden=0
    for node in marked:
      if node.hidden:
        hidden := self+1
    return #[count,held.order.length,held.reached.length,held.state[0].node,held.state[0].modal,hidden])
