import * as bt from "ink/ai/bt"
import * as goap from "ink/ai/goap"
import * as perception from "ink/ai/perception"
import * as utility from "ink/ai/utility"
import * as attributes from "ink/gameplay/attributes"
import * as tags from "ink/gameplay/tags"
import * as links from "ink/navigation/links"
import * as voxel from "ink/navigation/voxel"
import * as math from "ink/math"

entry func links_batch (size: U32) : #[F32] =>
  let centers = @array.generate size (func (i: U32) => math.vec3 (U32.to_f32 i * 2.0) 0.0 0.0)
  let offsets = @array.generate (size + 1) (func (i: U32) => if i == 0 then 0 else if i == size then (size - 1) * 2 else i * 2 - 1)
  let neighbors: #[~U32] = #[]
  for i in 0 .. size:
    if i > 0:
      @storage.push neighbors (i - 1)
    if i + 1 < size:
      @storage.push neighbors (i + 1)
  let blocked = @array.fill size false
  let off_links = #[$links.Link { from_poly: 0, to_poly: size - 1, start: centers[0], end: centers[size - 1], cost: 2.0, flags: 1, bidirectional: false }]
  let $Some plan = links.search centers offsets (@storage.freeze neighbors) blocked off_links 1 0 (size - 1) else:
    return #[U32.to_f32 size, 0.0]
  return #[U32.to_f32 size, plan.cost]

entry func voxel_batch (size: U32) : #[F32] =>
  let s = U32.to_f32 size
  let verts = #[math.vec3 0.0 0.0 0.0, math.vec3 s 0.0 0.0, math.vec3 s 0.0 s, math.vec3 0.0 0.0 s]
  let indices = #[0, 2, 1, 0, 3, 2]
  let cfg = $voxel.Config { origin: math.zero3, cell_size: 1.0, width: size, depth: size, max_slope_cos: 0.7, max_step: 0.5, agent_radius: 0.0 }
  let $Some field = voxel.bake cfg verts indices else:
    return #[U32.to_f32 size, 0.0]
  return #[U32.to_f32 size, U32.to_f32 field.region_count]

entry func bt_batch (size: U32) : #[F32] =>
  let tree = $bt.Tree {
    root: 0,
    nodes: #[$bt.Selector { first: 0, count: 2 }, $bt.Condition { id: 0 }, $bt.Action { id: 1 }],
    children: #[1, 2],
  }
  let mem = bt.memory 3
  let ok = 0
  for 0 .. size:
    let (st, next_m) = bt.tick tree (1.0 / 60.0) (func id => false) (func id => $bt.Success) mem
    mem := next_m
    if let $bt.Success = st:
      ok := self + 1
  return #[U32.to_f32 size, U32.to_f32 ok]

entry func utility_batch (size: U32) : #[F32] =>
  let cons = @array.generate size (func (i: U32) => $utility.Consideration { input: 0, min_val: 0.0, max_val: 100.0, curve: $utility.Linear { slope: 1.0, intercept: 0.0 } })
  let actions = @array.generate size (func (i: U32) => $utility.Action { id: i, weight: 1.0 + U32.to_f32 i * 0.01, start: i, count: 1 })
  let $Some c = utility.select actions cons #[50.0] 4294967295 1.0 else:
    return #[U32.to_f32 size, 0.0]
  return #[U32.to_f32 size, U32.to_f32 c.id]

entry func goap_batch (size: U32) : #[F32] =>
  let actions = #[
    $goap.Action { id: 1, cost: 1.0, pre_mask: 0, pre_value: 0, eff_mask: 1, eff_value: 1 },
    $goap.Action { id: 2, cost: 1.0, pre_mask: 1, pre_value: 1, eff_mask: 2, eff_value: 2 },
    $goap.Action { id: 3, cost: 1.0, pre_mask: 2, pre_value: 2, eff_mask: 4, eff_value: 4 },
  ]
  let ok = 0
  for 0 .. size:
    let $Some p = goap.plan 0 ($goap.Condition { mask: 4, value: 4 }) actions 32 else:
      return #[U32.to_f32 size, 0.0]
    if p.found and p.actions.length == 3:
      ok := self + 1
  return #[U32.to_f32 size, U32.to_f32 ok]

entry func perception_batch (size: U32) : #[F32] =>
  let cands = perception.ring_candidates math.zero3 #[4.0, 8.0] (max 4 size)
  let cover = @array.generate cands.length (func (i: U32) => i % 2 == 0)
  let q = $perception.TacticalQuery { threat: math.vec3 10.0 0.0 0.0, threat_forward: math.vec3 (-1.0) 0.0 0.0, ideal_distance: 8.0, distance_band: 8.0, weight_distance: 1.0, weight_cover: 1.5, weight_flank: 1.0 }
  let $Some pick = perception.choose_tactical q cands cover else:
    return #[U32.to_f32 size, 0.0]
  return #[U32.to_f32 size, pick.score]

entry func tags_batch (size: U32) : #[F32] =>
  let segs = @array.generate (size * 2) (func (i: U32) => if i % 2 == 0 then 1 else i / 2 + 2)
  let t = @array.generate size (func (i: U32) => $tags.Tag { start: i * 2, count: 2 })
  let pool = $tags.Pool { segments: segs, tags: t }
  let held = @array.generate size (func (i: U32) => i)
  let hits = 0
  for i in 0 .. size:
    if tags.has_tag pool held i:
      hits := self + 1
  return #[U32.to_f32 size, U32.to_f32 hits]

entry func attributes_batch (size: U32) : #[F32] =>
  let spec = $attributes.Spec { base: 10.0, min_val: 0.0, max_val: 10000.0 }
  let mods = @array.generate size (func (i: U32) => $attributes.Modifier { attribute: 0, source: i, op: $attributes.Add, value: 1.0, remaining: (-1.0) })
  return #[U32.to_f32 size, attributes.evaluate 0 spec mods]
