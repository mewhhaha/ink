import * as array from "std/array"
import * as math from "ink/math"
import * as radial from "ink/radial"
entry func workload (count: U32) => return radial.row
  ($radial.Grid { cells: 193, origin: -48.0, spacing: 0.5 })
  (array.generate count (func i => return math.vec4 (U32.to_f32 (i % 9) - 4.0) 0.0 2.0 1.0)) 96
