import * as array from "std/array"
import * as codec from "ink/codec"
import * as changes from "ink/changes"
import * as queue from "ink/task_queue"
import * as old from "./next_reference"
import * as spatial from "ink/spatial"
import * as scene from "ink/scene"
import * as math from "ink/math"
import * as tree from "ink/ui/tree"
import * as ui from "ink/ui"
import * as ecs from "ink/ecs"


func decode_run decode -> (count: U32) =>
  let packet = codec.pack (count + 7) (array.generate count (func i => i * 2654435761))
  let $Some decoded = decode (count + 7) packet else:
    return #[]
  return decoded
entry func decode_before (count:U32) => decode_run old.unpack count
entry func decode_after (count:U32) => decode_run codec.unpack count
func change_run subtract -> (count: U32) =>
  let values = array.generate count (func i => i * 2)
  let excluded = array.generate count (func i => i * 3)
  let result:#[~U32]=#[]
  for 0 .. 16:
    let next=subtract values excluded
    @storage.truncate result 0
    for value in next:
      @storage.push result value
  return seal result
entry func changes_before (count:U32) => change_run old.without count
entry func changes_after (count:U32) => change_run changes.difference count

func queue_run serialize -> (count: U32) =>
  let q:queue.Queue [U32,U32,U32]=queue.empty ()
  let meta=queue.metadata 1 count false
  meta[1] := count+1
  meta[4] := 1
  let jobs= array.generate count (func i => $queue.Job {ticket: $queue.Ticket {epoch: 1, sequence: i + 1}, submitted: 0, earliest: 1,
    request: i, continuation: i * 3, state: case i % 4 of
      0 => $queue.Pending
      1 => $queue.Ready {tick: 1, outcome: $queue.Value (i * 5)}
      2 => $queue.Ready {tick: 1, outcome: $queue.Failed (i * 7)}
      _ => $queue.Ready {tick: 1, outcome: $queue.Cancelled (i * 11)}})
  for job in jobs:
    @storage.push q job
  return serialize (func i => #[i,i+1]) (func i => #[i,i+1,i+2]) (func i => #[i]) q meta
entry func queue_before (count:U32) => queue_run old.encode_queue count
entry func queue_after (count:U32) => queue_run queue.encode count

func refits (refit: own spatial.Index -> #[U32] -> #[spatial.Bounds] -> spatial.Index) -> (count: U32) =>
  let items = array.generate count (func i =>
    let x = U32.to_f32 i * 4.0
    return $spatial.Bounds {low: math.vec3 x 0.0 0.0, high: math.vec3 (x + 1.0) 1.0 1.0})
  let original_bounds:#[~F32]=#[]
  let original_order:#[~U32]=#[]
  let original_leaves:#[~U32]=#[]
  let original=spatial.build_into (spatial.access 0 original_bounds original_order original_leaves) items
  let bounds:#[~F32]=#[]
  let order:#[~U32]=#[]
  let leaves:#[~U32]=#[]
  let index = spatial.copy_into (spatial.access original.base bounds order leaves) original
  for step in 0 .. 16:
    let x = -(U32.to_f32 step + 1.0)
    index := refit index #[count / 2] #[$spatial.Bounds {low: math.vec3 x 0.0 0.0, high: math.vec3 (x + 1.0) 1.0 1.0}]
  let values = spatial.flat_bounds index
  let offset = spatial.node_offset 1
  let before = spatial.flat_bounds original
  let old_offset = spatial.node_offset 1
  return #[values[offset], values[offset + 3], before[old_offset], before[old_offset + 3], U32.to_f32 (spatial.query index (math.vec3 (-16.0) 0.0 0.0) (math.vec3 (-15.0) 1.0 1.0))[0]]
entry func refit_dense (count:U32) => refits spatial.refit_dense count
entry func refit_sparse (count:U32) => refits spatial.refit count

// Previous complete sorted-candidate cast, using the same current storage.
func cast_ordered (world: scene.Scene) -> a -> b -> radius -> delta -> filter =>
  let (low, high) = scene.swept_bounds a b radius delta
  let best = $Nothing
  let best_time = 2.0
  for index in spatial.query world.index low high:
    let proxy = scene.proxy world index
    if scene.accepts filter proxy and scene.touches_bounds proxy low high:
      if let $Some (t, point, normal, surface, depth) = scene.cast_shape proxy.shape a b radius delta:
        if t < best_time:
          best_time := t
          best := $Some ($scene.Hit {id: proxy.id, proxy: index, time: t, distance: t * delta.length, point, normal, surface, depth})
  return best
func casts cast -> (count: U32) =>
  let sources = array.generate count (func i => scene.sphere (i + 1) (math.vec3 0.0 0.0 (U32.to_f32 i * 2.0)) 0.5)
  return scene.with_built sources (func (world:scene.Scene) =>
    let origin = math.vec3 0.0 0.0 (-2.0)
    let delta = math.vec3 0.0 0.0 (U32.to_f32 count * 2.0)
    let sum = 0.0
    for 0 .. 16:
      let $Some hit = cast world origin origin 0.0 delta (scene.solid_filter 0xFFFFFFFF) else:
        return panic "missing benchmark ray hit"
      sum := self + hit.distance
    return #[sum])
entry func casts_ordered (count:U32) => casts cast_ordered count
entry func casts_direct (count:U32) => casts scene.cast count

func with_focus (initial: tree.FocusState) -> (initial_returns: #[tree.Return]) -> run =>
  let state: #[tree.FocusState] = #[initial]
  let returns: #[~tree.Return] = #[]
  for value in initial_returns:
    @storage.push returns value
  let nodes: #[~tree.Stop] = #[]
  let order: #[~U32] = #[]
  let reached: #[~U32] = #[]
  return run (own ($tree.Focus {state, returns, nodes, order, reached}))
func interfaces cached -> (count:U32) => with_focus tree.unfocused #[] (func (held: own tree.Focus) =>
  let prepared = tree.empty_prepared ()
  let labels:#[~U32]=#[]
  let nodes=array.generate count (func i =>
    let n=ui.button_node (i+1) (if i%32==0 then 0 else i) (&labels[0..0]) ui.nowhere
    n.modal := i%32==0
    return n)
  let empty:#[tree.Node]=#[]
  prepared := tree.prepare 1 (if cached then &nodes[0..nodes.length] else &empty[0..0]) prepared
  let marked:#[~tree.Node]=#[]
  for step in 0 .. 16:
    nodes[0].name = tree.store_text #[step] labels
    if cached:
      prepared := tree.update_prepared 1 (&nodes[0..nodes.length]) #[0] prepared
      held := tree.resolve_prepared prepared (&nodes[0..nodes.length]) held marked
    else:
      held := tree.settle (&nodes[0..nodes.length]) held marked
  let hidden=0
  for node in marked:
    if node.hidden:
      hidden := self+1
  return #[count,held.order.length,held.reached.length,held.state[0].node,held.state[0].modal,hidden])
entry func ui_unprepared (count:U32) => interfaces false count
entry func ui_prepared (count:U32) => interfaces true count
