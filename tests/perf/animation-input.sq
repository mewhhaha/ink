import * as animation from "ink/animation"
import * as input from "ink/input"
import * as math from "ink/math"
import * as transform from "ink/transform"

func pose (index: U32) => $transform.Pose3 { position: math.vec3 (U32.to_f32 index) 0.0 0.0, rotation: math.identity_quat, scale: math.one3 }

// First lane is the sample time; the remaining lanes are sorted key times.
io sample (values: #[F32]) =>
  let keys = @array.generate (values.length - 1) (func (i: U32) => $animation.Key {time: values[i + 1],pose: pose i})
  let track = $animation.Track {start: 0,count: keys.length}
  let result = animation.sample_track (keys.view 0 keys.length) track values[0]
  return #[result.position.x, result.position.y, result.position.z, result.rotation.x, result.rotation.y, result.rotation.z, result.rotation.w, result.scale.x, result.scale.y, result.scale.z]

// Repeated late queries isolate lookup work from authoring the key array.
io late_queries (count: U32) =>
  let keys = @array.generate count (func (i: U32) => $animation.Key {time: U32.to_f32 i,pose: pose i})
  let track = $animation.Track {start: 0,count: keys.length}
  let checksum = 0.0
  for i in 0..1024:
    let time = U32.to_f32 (count - 2) + U32.to_f32 (i % 4) * 0.25
    let sampled = animation.sample_track (keys.view 0 keys.length) track time
    checksum := self + sampled.position.x
  return checksum

io restore (values: #[F32]) =>
  let pointer = #[input.initial]
  let held: #[U32] = #[]
  let fresh: #[U32] = #[]
  let buttons: #[U32] = #[]
  let (pointer, held, fresh, buttons) = input.decode_into values pointer held fresh buttons
  return input.encode (input.read pointer held fresh buttons)

io input_codec (count: U32) : #[U32] =>
  let pointer = #[input.initial]
  let held: #[U32] = #[]
  let fresh: #[U32] = #[]
  let buttons: #[U32] = #[]
  for i in 0 .. count:
    @storage.push held (count - i)
  let encoded = input.encode (input.read pointer held fresh buttons)
  let (pointer, held, fresh, buttons) = input.decode_into encoded pointer held fresh buttons
  let restored = input.read pointer held fresh buttons
  let checksum = 0
  for i in 0..restored.held.length:
    checksum := self + (i + 1) * restored.held[i]
  return #[restored.held.length, checksum]
