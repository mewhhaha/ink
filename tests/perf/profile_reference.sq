// Frozen pre-optimization parser used as a differential oracle.
import * as array from "std/array"
import * as profile from "ink/profile"
import * as packet_profile from "ink/pen/profile"

// Pen devtools flame and memory answers. Framing is validated in full; partial,
// fractional, nonfinite and malformed packets return Nothing. No request timing,
// polling, labels or display policy is imposed by this adapter.
private func integer (value: F32) => is_finite value and value >= 0.0 and value <= 4294967040.0 and floor value == value
private func positive (value: F32) => is_finite value and value >= 0.0
private func name (text:own #[U32]) -> (values: #[F32]) -> (start: U32) -> (length: U32) : (Maybe profile.Span, #[U32]) =>
  let valid = true
  for i in start .. start + length:
    let code = values[i]
    valid := self and integer code and code <= 1114111.0 and (code < 55296.0 or code > 57343.0)
  if not valid:
    return ($Nothing, text)
  let at = text.length
  for i in 0 .. length:
    @storage.push text (F32.to_u32 values[start+i])
  return ($Some ($profile.Span { start: at, count: length }), text)

private func flame_using (partial: Bool) -> (text:own #[U32]) -> (hottest:own #[profile.Hot]) -> (nodes:own #[profile.Node]) -> (values: #[F32]) : Maybe profile.Flame =>
  if values.length == 0:
    return $Some (profile.empty text hottest nodes)
  if not (integer values[0]) or values[0] > U32.to_f32 ((values.length - 1) / 3):
    return $Nothing
  @storage.truncate text 0
  @storage.truncate hottest 0
  @storage.truncate nodes 0
  let count = F32.to_u32 values[0]
  let at = 1
  for i in 0 .. count:
    if values.length - at < 3:
      return $Nothing
    if not (integer values[at] and positive values[at + 1] and integer values[at + 2]):
      return $Nothing
    let length = F32.to_u32 values[at + 2]
    if length > values.length - at - 3:
      return $Nothing
    let (maybe_name, next_text) = name text values (at + 3) length
    text := next_text
    let $Some span = maybe_name else:
      return $Nothing
    @storage.push hottest ($profile.Hot { function: F32.to_u32 values[at], samples: values[at + 1], name: span })
    at := self + 3 + length
  // At most one node per six lanes. Fill once, then trim the unused tail.
  let maximum = (values.length-at)/6
  let used = 0
  for 0 .. maximum:
    if values.length - at < 6:
      break
    if not (integer values[at] and integer values[at + 1] and positive values[at + 2] and positive values[at + 3] and positive values[at + 4] and integer values[at + 5]):
      return $Nothing
    if values[at + 4] > values[at + 3]:
      return $Nothing
    let length = F32.to_u32 values[at + 5]
    if length > values.length - at - 6:
      break
    let (maybe_name, next_text) = name text values (at + 6) length
    text := next_text
    let $Some span = maybe_name else:
      return $Nothing
    @storage.push nodes ($profile.Node { depth: F32.to_u32 values[at], function: F32.to_u32 values[at + 1],
      first: values[at + 2], samples: values[at + 3], alone: values[at + 4], name: span })
    used := self + 1
    at := self + 6 + length
  return if partial or at == values.length then $Some ($profile.Flame { text, hottest, nodes }) else $Nothing

func flame (own text) -> (own hottest) -> (own nodes) -> values => flame_using false text hottest nodes values
// Explicit recovery for an inspector whose final node was cut short. Complete
// hot-list framing is still required; malformed complete records are rejected.
func flame_prefix (own text) -> (own hottest) -> (own nodes) -> values => flame_using true text hottest nodes values

type Counter = packet_profile.Counter
type Memory = packet_profile.Memory
private func memory_using (partial: Bool) -> (text:own #[U32]) -> (counters:own #[Counter]) -> (values: #[F32]) : Maybe Memory =>
  if values.length < 2 or not (positive values[0] and positive values[1]):
    return $Nothing
  @storage.truncate text 0
  @storage.truncate counters 0
  let maximum = (values.length-2)/3
  let at = 2
  let used = 0
  for 0 .. maximum:
    if values.length - at < 3:
      break
    if not (integer values[at]):
      return $Nothing
    let length = F32.to_u32 values[at]
    if length > values.length - at - 3:
      break
    let (maybe_name, next_text) = name text values (at + 1) length
    text := next_text
    let $Some span = maybe_name else:
      return $Nothing
    let high = values[at + 1 + length]
    let low = values[at + 2 + length]
    if not (integer high and integer low) or low >= 16777216.0:
      return $Nothing
    @storage.push counters ($packet_profile.Counter { name: span, value: high * 16777216.0 + low })
    used := self + 1
    at := self + 3 + length
  return if partial or at == values.length then $Some ($packet_profile.Memory { committed: values[0], most: values[1], text, counters }) else $Nothing
func memory (own text) -> (own counters) -> values => memory_using false text counters values
func memory_prefix (own text) -> (own counters) -> values => memory_using true text counters values
