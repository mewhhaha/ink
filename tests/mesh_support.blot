import * as array from "std/array"
import * as math from "ink/math"
import * as shapes from "ink/shapes"
import * as scene from "ink/scene"
import * as mesh from "ink/mesh"

// Procedural level geometry for the mesh witnesses, centred on x = z = 0.
//   0 flat tessellated grid, 1 slope along +x (param = rise per metre),
//   2 stairs along +x (n steps of 0.4 m, param = rise), 3 gentle bumps
//   (param = amplitude). Kinds >= 100 are a single box floor.
func quad_height (kind: U32) -> (param: F32) -> (x: F32) -> (z: F32) : F32 =>
  if kind == 1:
    return param * x
  if kind == 3:
    return param * sin (x * 1.3) * cos (z * 0.9)
  return 0.0

func grid_vertices (kind: U32) -> (n: U32) -> (size: F32) -> (param: F32) : #[shapes.Point3] =>
  let side = n + 1
  return @array.generate (side * side) (func (k: U32) =>
    let x = (U32.to_f32 (k % side) / U32.to_f32 n - 0.5) * size
    let z = (U32.to_f32 (k / side) / U32.to_f32 n - 0.5) * size
    return { x, y: quad_height kind param x z, z })

// Alternating diagonals, so no seam direction is special.
func grid_indices (n: U32) : #[U32] =>
  let side = n + 1
  return @array.generate (n * n * 6) (func (k: U32) =>
    let cell = k / 6
    let i = cell % n
    let j = cell / n
    let a = j * side + i
    let b = a + 1
    let c = a + side
    let d = c + 1
    let corner = k % 6
    if (i + j) % 2 == 0:
      return if corner == 0 then a else if corner == 1 then c else if corner == 2 then b else if corner == 3 then b else if corner == 4 then c else d
    return if corner == 0 then a else if corner == 1 then c else if corner == 2 then d else if corner == 3 then a else if corner == 4 then d else b)

// Stairs: a profile of 2n + 3 points (a landing, then base and top of every
// riser, then the last tread and the top landing) extruded along z.
func stair_vertices (n: U32) -> (size: F32) -> (rise: F32) : #[shapes.Point3] =>
  let half = size * 0.5
  let last = 2 * n + 2
  return @array.generate ((last + 1) * 2) (func (v: U32) =>
    let pt = v / 2
    let z = if v % 2 == 0 then F32.neg half else half
    if pt == 0:
      return { x: F32.neg half, y: 0.0, z }
    if pt == last:
      return { x: 0.4 * U32.to_f32 n + half, y: rise * U32.to_f32 n, z }
    if pt == last - 1:
      return { x: 0.4 * U32.to_f32 n, y: rise * U32.to_f32 n, z }
    let j = pt - 1
    let k = j / 2
    let level = if j % 2 == 0 then k else k + 1
    return { x: 0.4 * U32.to_f32 k, y: rise * U32.to_f32 level, z })

func stair_indices (n: U32) : #[U32] =>
  return @array.generate ((2 * n + 2) * 6) (func (q: U32) =>
    let s = q / 6
    let corner = q % 6
    let a = s * 2
    return if corner == 0 then a else if corner == 1 then a + 1 else if corner == 2 then a + 2 else if corner == 3 then a + 1 else if corner == 4 then a + 3 else a + 2)

// Cook the floor and hand the source to a consumer that finishes with it
// before the geometry closes.
func with_floor (kind: U32) -> (n: U32) -> (size: F32) -> (param: F32) -> consume =>
  if kind >= 100:
    return consume (scene.box 900000 (math.vec3 0.0 (-0.5) 0.0) (math.vec3 size 1.0 size))
  return shapes.with_geometry (func geometry =>
    let points = if kind == 2 then stair_vertices n size param else grid_vertices kind n size param
    let indices = if kind == 2 then stair_indices n else grid_indices n
    let $Some m = shapes.cook_mesh geometry (&points[0..points.length]) (&indices[0..indices.length]) else:
      return consume (scene.source 900000 math.zero3)
    return consume (scene.level 900000 m))
