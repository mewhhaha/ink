import * as check from "./check"
import * as jobs from "ink/task_queue"

func flag value => if value then 1 else 0
func encode (value: U32) => #[value]
func decode (words: #[U32]) => if words.length == 1 then $Some words[0] else $Nothing
entry func test_ordered_publication_and_epoch () =>
  let queue: jobs.Queue [U32, U32, U32] = jobs.empty ()
  let meta = jobs.metadata 1 4 false
  let history: #[jobs.Mark] = #[]
  let ($Some tickets, queue, meta, history) = jobs.submit_many 0 1 #[10, 20] #[30, 40] queue meta history else:
    return check.report #[check.words #[1] #[0]]
  let (second, queue, meta, history) = jobs.settle 1 tickets[1] ($jobs.Value 200) queue meta history
  let (waiting, queue, meta, history) = jobs.publish 1 queue meta history
  let (first, queue, meta, history) = jobs.settle 2 tickets[0] ($jobs.Value 100) queue meta history
  let (delivered, queue, meta, history) = jobs.publish 2 queue meta history
  let (queue, meta, history) = jobs.reissue 2 queue meta history
  let (stale, queue, meta, history) = jobs.settle 3 tickets[0] ($jobs.Value 99) queue meta history
  return check.report #[check.words #[1, 0, 1, 2, 30, 40, 0] #[flag second,
    waiting.length, flag first, delivered.length, delivered[0].continuation,
    delivered[1].continuation, flag stale]]
entry func test_saved_framing_and_rejected_decode () =>
  let queue: jobs.Queue [U32, U32, U32] = jobs.empty ()
  let meta = jobs.metadata 7 4 false
  let history: #[jobs.Mark] = #[]
  let (unused, queue, meta, history) = jobs.submit 3 4 11 13 queue meta history
  let saved = jobs.encode encode encode encode queue meta
  let copy: jobs.Queue [U32, U32, U32] = jobs.empty ()
  let copy_meta = jobs.metadata 9 4 false
  let copy_history: #[jobs.Mark] = #[]
  let (accepted, copy, copy_meta, copy_history) = jobs.decode 4 false decode decode decode saved copy copy_meta copy_history
  let (rejected, copy, copy_meta, copy_history) = jobs.decode 4 false decode decode decode #[1, 7, 2] copy copy_meta copy_history
  return check.report #[check.words #[1, 1, 0, 1, 7, 11] #[saved[0], flag accepted,
    flag rejected, copy.length, copy_meta[0], copy[0].request]]
entry func test_batch_rejection_consumes_no_tickets () =>
  let queue: jobs.Queue [U32, U32, U32] = jobs.empty ()
  let meta = jobs.metadata 5 1 false
  let history: #[jobs.Mark] = #[]
  let (rejected, queue, meta, history) = jobs.submit_many 0 0 #[1, 2] #[3, 4] queue meta history
  let count = queue.length
  let ($Some ticket, queue, meta, history) = jobs.submit 0 0 5 6 queue meta history else:
    return check.report #[check.words #[1] #[0]]
  return check.report #[check.words #[0, 1] #[count, ticket.sequence]]
