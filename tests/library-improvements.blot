import * as check from "./check"
import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as pages from "ink/pages"
import * as buffer from "ink/buffer"
import * as graph from "ink/graph"
import * as ecs from "ink/ecs"
import * as path from "ink/path"
import * as navigation from "ink/navigation"
import * as statistics from "ink/statistics"
import * as sort from "ink/sort"
import * as codec from "ink/codec"

entry func test_radix_resize_dirty_boundaries_and_snapshots () =>
  let before=pages.from (array.generate 65537 identity)
  let changed=pages.copy_using identity before
  changed := pages.update 65538 #[65537,4096,63,64,4096,0xFFFFFFFF] (func i => i+100000) changed
  let trimmed=pages.copy_using identity changed
  trimmed := pages.update 64 #[] identity trimmed
  let grown=pages.copy_using identity trimmed
  grown := pages.update 4097 #[] (func i => i+200000) grown
  let restored=pages.copy_using identity grown
  restored := pages.update 4096 #[] identity restored
  restored := pages.push 123 restored
  restored := pages.set 63 9 restored
  let valid=true
  for i in 0 .. before.length:
    valid := self and pages.get before i==i
  for i in 0 .. changed.length:
    let expected=if i==63 or i==64 or i==4096 or i==65537 then i+100000 else i
    valid := self and pages.get changed i==expected
  for i in 0 .. grown.length:
    let expected=if i>=64 then i+200000 else if i==63 then i+100000 else i
    valid := self and pages.get grown i==expected
  let payload:#[U32]=#[]
  for i in 0 .. 4097:
    @storage.push payload i
    @storage.push payload (i+1)
  let boxed=pages.from (array.generate 4097 (func i => {start:i*2,count:2}))
  let next=pages.copy_using identity boxed
  let start=payload.length
  @storage.push payload 9
  next := pages.set 4096 {start,count:1} next
  let build:buffer.Buffer U32=buffer.empty ()
  build := buffer.append #[0,1] self
  build := buffer.push 2 self
  build := buffer.append #[3,4] self
  let before_build=buffer.finish build
  build := buffer.push 5 self
  let row=pages.get boxed 4096
  let changed_row=pages.get next 4096
  return check.report #[check.holds valid,check.holds (pages.get restored 4096==123 and pages.get restored 63==9),
    check.words #[4096,4097] (array.slice row.start row.count payload),check.words #[9] (array.slice changed_row.start changed_row.count payload),
    check.words #[0,1,2,3,4] before_build,check.words #[0,1,2,3,4,5] (buffer.finish build)]

type Position is data = $Position U32
type Extra is data = $Extra {start:U32,count:U32}
type Reference is data = $Reference U32
entry func test_despawn_releases_payloads_and_compaction_remaps_all_columns () =>
  let alive:ecs.Entities=ecs.entities ()
  let alive_meta=ecs.metadata 1
  let (_, alive, alive_meta) = ecs.spawn_many alive alive_meta 70
  let positions:ecs.Pool Position=ecs.pool ()
  let position_meta=ecs.metadata 1
  let previous:ecs.Pool Position=ecs.pool ()
  let old_previous_meta=ecs.metadata 1
  let extras:ecs.Pool Extra=ecs.pool ()
  let extra_meta=ecs.metadata 1
  let payload=array.generate 70 identity
  let ids=array.generate 70 identity
  let (positions, position_meta) = ecs.insert_selected alive positions position_meta ids (array.map (func i => $Position i) ids)
  let (extras, extra_meta) = ecs.insert_selected alive extras extra_meta ids (array.map (func i => $Extra {start:i,count:1}) ids)
  previous := ecs.copy_into identity self positions
  let old:ecs.Pool Position=ecs.copy_into identity (ecs.pool ()) positions
  let (positions, position_meta) = ecs.write positions position_meta 33 ($Position 133)
  for i in 0 .. 70:
    if i!=1 and i!=33 and i!=69:
      let p_was=ecs.contains positions i
      positions := ecs.remove_row self i
      position_meta := ecs.bump_remove p_was self
      let pr_was=ecs.contains previous i
      previous := ecs.remove_row self i
      old_previous_meta := ecs.bump_remove pr_was self
      let e_was=ecs.contains extras i
      extras := ecs.remove_row self i
      extra_meta := ecs.bump_remove e_was self
      let was_live=ecs.live alive i
      alive := ecs.despawn_entity self i
      if was_live:
        alive_meta := ecs.bump_membership self
  let released=not (ecs.contains extras 32)
  // Explicit cold compaction creates a new entity epoch and remaps every
  // caller-named column/reference. Neither old IDs nor payloads are recycled.
  let compact_alive:ecs.Entities=ecs.entities ()
  let compact_meta=ecs.metadata 2
  let current:ecs.Pool Position=ecs.pool ()
  let current_meta=ecs.metadata 2
  let compact_previous:ecs.Pool Position=ecs.pool ()
  let previous_meta=ecs.metadata 2
  let compact_extras:ecs.Pool Extra=ecs.pool ()
  let compact_extra_meta=ecs.metadata 2
  let prior_ids=ecs.indices alive positions
  let remap=array.fill 70 ecs.no_entity
  for previous_id in prior_ids:
    let id=compact_alive.length
    compact_alive := ecs.spawn_entity self
    compact_meta := ecs.bump_membership self
    remap[previous_id] := id
    let $Some value=ecs.read positions previous_id else:
      return check.report #[check.holds false]
    let $Some prior=ecs.read previous previous_id else:
      return check.report #[check.holds false]
    let $Some extra=ecs.read extras previous_id else:
      return check.report #[check.holds false]
    let c_was=ecs.contains current id
    current := ecs.put_row compact_alive self id value
    current_meta := ecs.bump_insert c_was self
    let cp_was=ecs.contains compact_previous id
    compact_previous := ecs.put_row compact_alive self id prior
    previous_meta := ecs.bump_insert cp_was self
    let ce_was=ecs.contains compact_extras id
    compact_extras := ecs.put_row compact_alive self id extra
    compact_extra_meta := ecs.bump_insert ce_was self
  let reference= $Reference remap[69]
  let $Reference id=reference
  let (spawned, compact_alive, compact_meta) = ecs.spawn compact_alive compact_meta
  let $Some ($Position was)=ecs.read old 33 else:
    return check.report #[check.holds false]
  let $Some ($Position now)=ecs.read current 1 else:
    return check.report #[check.holds false]
  let $Some ($Position prior)=ecs.read compact_previous 1 else:
    return check.report #[check.holds false]
  let $Some ($Extra {start,count})=ecs.read compact_extras 2 else:
    return check.report #[check.holds false]
  return check.report #[check.holds released,check.words #[1,33,69] prior_ids,
    check.words #[0,1,2] (ecs.indices compact_alive current),check.holds (prior_ids.length==3 and spawned==3 and id==2),
    check.holds (was==33 and prior==33 and now==133),check.words #[69] (array.slice start count payload),
    check.holds (remap[32]==ecs.no_entity and remap[33]==1)]

entry func test_graph_long_reverse_chain_waves_and_cycles () =>
  let low=array.generate 129 identity
  let high=array.generate 129 (func i => i+1)
  let starts:#[U32]=#[]
  let targets:#[U32]=#[]
  let (built, starts, targets) = graph.from_edges 130 (array.concat low high) (array.concat high low) starts targets
  if not built:
    return check.report #[check.holds false]
  let connected = graph.borrow starts targets
  let reached=graph.reachable connected #[129,129] (array.fill 130 true)
  let blocked=graph.reachable connected #[129] (array.generate 130 (func i => i!=65))
  let chain_starts:#[U32]=#[]
  let chain_targets:#[U32]=#[]
  let (built, chain_starts, chain_targets) = graph.from_edges 130 low high chain_starts chain_targets
  if not built:
    return check.report #[check.holds false]
  let chain = graph.borrow chain_starts chain_targets
  let wave_starts:#[U32]=#[]
  let wave_nodes:#[U32]=#[]
  let $Some waves=graph.waves 8 chain wave_starts wave_nodes else:
    return check.report #[check.holds false]
  let cyclic_starts:#[U32]=#[]
  let cyclic_targets:#[U32]=#[]
  let (built, cyclic_starts, cyclic_targets) = graph.from_edges 2 #[0,1] #[1,0] cyclic_starts cyclic_targets
  if not built:
    return check.report #[check.holds false]
  let cycle = graph.borrow cyclic_starts cyclic_targets
  let bad_starts:#[U32]=#[]
  let bad_nodes:#[U32]=#[]
  let cyclic=graph.waves 8 cycle bad_starts bad_nodes
  return check.report #[check.holds (array.all identity reached),
    check.holds (array.all (func i => if i<=65 then not blocked[i] else blocked[i]) (array.generate 130 identity)),
    check.words (array.generate 130 (func i => 129-i)) (array.map identity waves.nodes),check.holds (not (Maybe.is_some cyclic))]

entry func test_prepared_paths_and_stable_quantiles () =>
  let points = #[$Vec3 {x: 0.0, y: 0.0, z: 0.0}, $Vec3 {x: 0.0, y: 0.0, z: 0.0}, $Vec3 {x: 2.0, y: 0.0, z: 0.0}, $Vec3 {x: 2.0, y: 0.0, z: 2.0}]
  let $Some prepared = path.prepare points else:
    return check.report #[check.holds false]
  let checks:#[check.Check]=#[]
  @storage.push checks (check.holds (not (Maybe.is_some (path.prepare #[]))))
  let invalid = $Vec3 {x: 0.0 / 0.0, y: 0.0, z: 0.0}
  @storage.push checks (check.holds (not (Maybe.is_some (path.prepare #[invalid]))))
  @storage.push checks (check.holds (not (Maybe.is_some (path.prepare #[points[0], invalid]))))
  let $Some singleton = path.prepare #[points[2]] else:
    return check.report #[check.holds false]
  let $Some (single, yaw) = path.sample singleton 100.0 else:
    return check.report #[check.holds false]
  @storage.push checks (check.near 0.0 #[single.x, yaw] #[2.0, 0.0])
  for distance in #[(-1.0), 0.0, 0.5, 1.0, 2.0, 3.0, 4.0, 100.0]:
    let $Some (a, ay) = path.along points distance else:
      return check.report #[check.holds false]
    let $Some (b, by) = path.sample prepared distance else:
      return check.report #[check.holds false]
    @storage.push checks (check.near 0.00001 #[a.x,a.y,a.z,ay] #[b.x,b.y,b.z,by])
  for variant in 0 .. 4:
    let values=case variant of
      0 => #[(-0.0),0.0,(-0.0),1.0]
      1 => array.generate 101 (func i => U32.to_f32 ((i*47)%101))
      2 => array.fill 65 3.0
      _ => array.generate 97 (func i => U32.to_f32 (97-i))
    let order = sort.order values
    for i in 0 .. values.length + 1:
      let fraction = U32.to_f32 i / U32.to_f32 values.length
      let rank = min (max 1 (F32.to_u32 (ceil (U32.to_f32 values.length * fraction))) - 1) (values.length - 1)
      let $Some actual = statistics.quantile fraction values else:
        return check.report #[check.holds false]
      @storage.push checks (check.holds (codec.float_word values[order[rank]] == codec.float_word actual))
  return check.report checks

entry func test_bounded_navigation_matches_full_search_and_budget () =>
  let costs=array.generate 1024 (func i => if i%19==3 then 0.0 else U32.to_f32 (i%3+1))
  let $Some grid=navigation.grid 32 32 (&costs[0..costs.length]) else:
    return check.report #[check.holds false]
  let valid = true
  for start in #[0, 1, 30, 31, 32, 255, 511, 1023]:
    for goal in #[0, 1, 29, 32, 64, 256, 1023]:
      for budget in #[0, 1, 2, 7, 31, 127]:
        let actual=navigation.astar grid start goal budget
        let (field, slots) = navigation.run_search grid start goal false budget
        let matched = false
        if let $Some path = actual:
          let good = slots[goal] == 1025 and path.cost == field.costs[goal] and path.expanded == field.expanded
          let cell = goal
          for i in 0 .. path.cells.length:
            good := self and path.cells[path.cells.length-i-1] == cell
            if cell != start:
              cell := field.next[cell]
          matched := good
        else:
          matched := slots[goal] != 1025
        valid := self and matched
  return check.report #[check.holds valid]
