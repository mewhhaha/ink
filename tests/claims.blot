import * as check from "./check"
import * as array from "std/array"
import * as claims from "ink/claims"
const bid = fn resource owner priority => #claims.Bid { resource, owner, priority }
entry const witness = fn (seed: U32) => do:
  let bids = array.generate 127 (fn index => bid ((index * 19 + seed) % 17) (index * 65537) ((index * 7 + seed) % 9))
  let #Some forward = claims.resolve 17 bids else:
    return 0
  let #Some reverse = claims.resolve 17 (array.generate bids.length (fn index => bids[bids.length - index - 1])) else:
    return 0
  for resource in 0 .. 17:
    let expected_owner = 4294967295
    let expected_priority = 4294967295
    for candidate in bids:
      if candidate.resource == resource:
        if candidate.priority < expected_priority || (candidate.priority == expected_priority && candidate.owner < expected_owner):
          expected_priority := candidate.priority
          expected_owner := candidate.owner
    let #Some a = forward[resource] else:
      return 0
    let #Some b = reverse[resource] else:
      return 0
    if a.owner != expected_owner || a.priority != expected_priority || b.owner != expected_owner:
      return 0
  return 1
entry const bounds = fn () => #[
  if Maybe.is_some (claims.resolve 65537 #[]) then 0 else 1,
  if Maybe.is_some (claims.resolve 0 #[bid 0 1 0]) then 0 else 1,
  if Maybe.is_some (claims.resolve 0 #[]) then 1 else 0,
  if Maybe.is_some (claims.resolve 1 #[bid 1 1 0]) then 0 else 1]

entry const test_claim_priority_and_delivery_order = fn () => check.report (array.concat
  #[check.words #[1,1,1,1] (bounds ())]
  #[check.words #[1] #[witness seed] | seed <- array.generate 128 identity])
