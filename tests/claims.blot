import * as test from "std/test"
import * as array from "std/array"
import * as claims from "ink/claims"
func bid resource -> owner -> priority => $claims.Bid { resource, owner, priority }
io witness (seed: U32) =>
  let bids = array.generate 127 (func index => bid ((index * 19 + seed) % 17) (index * 65537) ((index * 7 + seed) % 9))
  let $Some forward = claims.resolve 17 bids else:
    return 0
  let $Some reverse = claims.resolve 17 (array.generate bids.length (func index => bids[bids.length - index - 1])) else:
    return 0
  for resource in 0 .. 17:
    let expected_owner = 4294967295
    let expected_priority = 4294967295
    for candidate in bids:
      if candidate.resource == resource:
        if candidate.priority < expected_priority or (candidate.priority == expected_priority and candidate.owner < expected_owner):
          expected_priority := candidate.priority
          expected_owner := candidate.owner
    let $Some a = forward[resource] else:
      return 0
    let $Some b = reverse[resource] else:
      return 0
    if a.owner != expected_owner or a.priority != expected_priority or b.owner != expected_owner:
      return 0
  return 1
io bounds () => #[
  if Maybe.is_some (claims.resolve 65537 #[]) then 0 else 1,
  if Maybe.is_some (claims.resolve 0 #[bid 0 1 0]) then 0 else 1,
  if Maybe.is_some (claims.resolve 0 #[]) then 1 else 0,
  if Maybe.is_some (claims.resolve 1 #[bid 1 1 0]) then 0 else 1]

@[test.suite]
test "claim priority and delivery order":
  let b = bounds ()
  use test.eq "bounds" #[1, 1, 1, 1] b
  for seed in 0 .. 128:
    let w = witness seed
    use test.eq "witness" 1 w
  return ()

@[test.suite]
test "resolve into reuses buffer and matches resolve":
  let scratch: #[Maybe claims.Bid] = #[]
  let state = (true, scratch)
  for seed in 0 .. 16:
    let bids = array.generate 40 (func i => bid ((i * 11 + seed) % 13) (i * 17) ((i * 5 + seed) % 7))
    let $Some expected = claims.resolve 13 bids else:
      use test.fail "resolve" "expected Some resolution"
      return ()
    state := do:
      let (ok, buf) = self
      let (valid, buf) = claims.resolve_into 13 (&bids[0..bids.length]) buf
      ok := self and valid and buf.length == 13
      for r in 0 .. 13:
        let matched = case expected[r], buf[r] of
          $Some a, $Some b => a.owner == b.owner and a.priority == b.priority
          $Nothing, $Nothing => true
          _, _ => false
        ok := self and matched
      break (ok, buf)
  let (ok, scratch) = state
  let empty_bids: #[claims.Bid] = #[]
  let (over, _) = claims.resolve_into 65537 (&empty_bids[0..0]) scratch
  ok := self and not over
  use test.holds "resolve_into matches resolve" ok
  return ()
