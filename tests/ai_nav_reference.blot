import * as goap from "ink/ai/goap"
import * as perception from "ink/ai/perception"
import * as utility from "ink/ai/utility"
import * as attributes from "ink/gameplay/attributes"
import * as math from "ink/math"

// Numeric fixture for tools/native/src/ai_nav_gameplay.rs.

// Input: [x, steepness, midpoint, slope, exp, w0, w1, w2] = 8 floats.
// Output: [logistic, quadratic, compensated_score] = 3 floats.
#entry func utility_eval (a: #[F32]) : #[F32] =>
  let log_v = utility.evaluate_curve ($utility.Logistic { steepness: a[1], midpoint: a[2] }) a[0]
  let quad_v = utility.evaluate_curve ($utility.Quadratic { slope: a[3], exponent: a[4], shift_x: 0.0, shift_y: 0.0 }) a[0]
  let cons = #[
    $utility.Consideration { input: 0, min_val: 0.0, max_val: 1.0, curve: $utility.Linear { slope: 1.0, intercept: 0.0 } },
    $utility.Consideration { input: 1, min_val: 0.0, max_val: 1.0, curve: $utility.Linear { slope: 1.0, intercept: 0.0 } },
    $utility.Consideration { input: 2, min_val: 0.0, max_val: 1.0, curve: $utility.Linear { slope: 1.0, intercept: 0.0 } },
  ]
  let act = $utility.Action { id: 0, weight: 1.0, start: 0, count: 3 }
  let sc = utility.score_action act cons #[a[5], a[6], a[7]]
  return #[log_v, quad_v, sc]

// Input: [base, min_v, max_v, add0, add1, mul0, mul1] = 7 floats.
// Output: [value] = 1 float.
#entry func attribute_eval (a: #[F32]) : #[F32] =>
  let spec = $attributes.Spec { base: a[0], min_val: a[1], max_val: a[2] }
  let mods = #[
    $attributes.Modifier { attribute: 0, source: 1, op: $attributes.Add, value: a[3], remaining: (-1.0) },
    $attributes.Modifier { attribute: 0, source: 2, op: $attributes.Add, value: a[4], remaining: (-1.0) },
    $attributes.Modifier { attribute: 0, source: 3, op: $attributes.Multiply, value: a[5], remaining: (-1.0) },
    $attributes.Modifier { attribute: 0, source: 4, op: $attributes.Multiply, value: a[6], remaining: (-1.0) },
  ]
  return #[attributes.evaluate 0 spec mods]

// Input: [dist, hearing_range, loudness] = 3 floats.
// Output: [strength] = 1 float.
#entry func hearing_eval (a: #[F32]) : #[F32] =>
  let s = $perception.Sensor { position: math.zero3, forward: math.forward, sight_range: 10.0, cos_half_fov: 0.5, hearing_range: a[1], memory_seconds: 5.0 }
  return #[perception.heard_strength s (math.vec3 a[0] 0.0 0.0) a[2]]
