import * as test from "std/test"
import * as services from "ink/services"
import * as locale from "ink/pen/locale"
import * as protocol from "pen/protocol"
@[test.suite]
test "locale adapter preserves drawn spoken and request arguments":
  let words = locale.parts #[65.0,66.0,0.0,67.0,68.0]
  let same = locale.parts #[945.0]
  let empty = locale.parts #[0.0]
  let fractional = locale.parts #[0.5, 945.0]
  let next: #[U32] = #[1]
  let outbox: #[services.Request] = #[]
  let waiting: #[services.Request] = #[]
  let filling: #[services.Filling] = #[]
  let answers: #[services.Answer] = #[]
  let statuses: #[U32] = #[]
  let payload: #[F32] = #[]
  let pending = services.access next outbox waiting filling answers statuses payload
  pending := services.idle pending 32
  let (first, pending) = locale.ask pending #[65] $Nothing
  let (second, pending) = locale.ask pending #[66] ($Some 12)
  let (inexact, pending) = locale.ask pending #[67] ($Some 16777221)
  let (nul, pending) = locale.ask pending #[68, 0, 69] $Nothing
  let (out_of_range, pending) = locale.ask pending #[70] ($Some 0xFFFFFFFF)
  let (exact, pending) = locale.ask pending #[71] ($Some 16777218)
  let (boundary, pending) = locale.ask pending #[72] ($Some 16777216)
  let a = pending.outbox[0]
  let b = pending.outbox[1]
  let valid = first != second and a.service == protocol.service_locale and a.operation == protocol.locale_op_text and a.a == 0.0 and a.b == 0.0 and b.a == 12.0 and b.b == 1.0 and (services.values pending b.values)[0] == 66.0
  use test.holds "check 1" valid
  let _v1 = 0.0
  let _v2 = #[65.0,66.0,67.0,68.0]
  let _v3 = #[from words.drawn[0],from words.drawn[1],from words.spoken[0],from words.spoken[1]]
  use test.near_array "check 2" _v1 _v2 _v3
  let _v4 = (same.drawn[0] == same.spoken[0])
  use test.holds "check 3" _v4
  let _v5 = #[0, 0, 0, 4]
  let _v6 = #[inexact, nul, out_of_range, pending.outbox.length]
  use test.eq "check 4" _v5 _v6
  let _v7 = (exact != 0 and boundary != 0 and exact != boundary)
  use test.holds "check 5" _v7
  let _v8 = 0.0
  let _v9 = #[16777218.0, 16777216.0]
  let _v10 = #[pending.outbox[2].a, pending.outbox[3].a]
  use test.near_array "check 6" _v8 _v9 _v10
  let _v11 = #[0, 0, 1, 945]
  let _v12 = #[empty.drawn.length, empty.spoken.length, fractional.drawn.length, fractional.drawn[0]]
  use test.eq "check 7" _v11 _v12
  let _v13 = (not (Maybe.is_some (locale.decoded pending ($services.Answer {id:1,status:255,value:0.0,values:$services.Span {start:0,count:0}}))))
  use test.holds "check 8" _v13
  return ()
