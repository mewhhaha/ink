import * as h from "ink/handles"
import * as c from "ink/codec"
import * as b from "ink/behavior"
import * as array from "std/array"

type Action is data = $Hit | $Missing
type Condition is data = $Morning
const act = func (action: Action) => return func (tick: b.Tick) => return func (local: U32) => return case action of
  $Hit => $b.Done { local: local + 1, remaining: tick.seconds }
  $Missing => $b.Abort { local, reason: 99 }
const ready = func (morning: Bool) => return func (condition: Condition) => return func (local: U32) => return morning
const cleanup = func (reason: U32) => return func (local: U32) => return local + 1000
const encode = func (value: U32) => return #[value]
const decode = func (words: Array U32) => return if words.length == 1 then $Some words[0] else $Nothing
const program = func nodes => return b.build_into nodes 1 10 #[b.wait 10 1.0 20, b.repeat 20 3 30 50,
  b.action 30 $Hit 40, b.again 40 20, b.stop 50]

entry const replay = func (deltas: Array F32) => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let visited: ResizeArray U32 = #[]
  let restored_frames: ResizeArray b.Frame = #[]
  let restored_visited: ResizeArray U32 = #[]
  let $Some program = program nodes else:
    return #[]
  let state = b.start program 0
  let restored = state
  let trace: GrowArray U32 = #[]
  let saved_trace: GrowArray U32 = #[]
  for dt in deltas:
    let $Some a = b.advance program state frames visited dt 32 4 act (ready true) cleanup else:
      return #[]
    let $Some loaded = b.restore_into restored_frames program 4 decode (b.encode encode restored restored_frames) else:
      return #[]
    let $Some z = b.advance program loaded restored_frames restored_visited dt 32 4 act (ready true) cleanup else:
      return #[]
    state := a.state
    restored := z.state
    for id in a.visited:
      trace.push id
    for id in z.visited:
      saved_trace.push id
  return array.concat #[state.local, restored.local, trace.length, saved_trace.length] (array.concat (@storage.freeze trace) (@storage.freeze saved_trace))

entry const budget = func () => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let visited: ResizeArray U32 = #[]
  let $Some program = b.build_into nodes 1 1 #[b.wait 1 0.0 1] else:
    return #[]
  let $Some result = b.advance program (b.start program 0) frames visited 100.0 7 4 act (ready true) cleanup else:
    return #[]
  let status = case result.state.status of
    $b.Budget => 1
    _ => 0
  return #[result.transitions, result.visited.length, status, F32.to_u32 result.remaining]

entry const interruption = func () => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let visited: ResizeArray U32 = #[]
  let $Some program = b.build_into nodes 1 1 #[b.action 1 $Missing 2, b.stop 2] else:
    return #[]
  let before = b.start program 3
  let $Some result = b.advance program before frames visited 0.0 4 4 act (ready true) cleanup else:
    return #[]
  let result_state: b.State U32 = result.state
  let twice = b.interrupt 99 cleanup result_state frames
  let $Some after = b.advance program twice frames visited 100.0 4 4 act (ready true) cleanup else:
    return #[]
  return #[before.local, result_state.local, twice.local, after.state.local, after.visited.length]

entry const conditions = func () => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let visited: ResizeArray U32 = #[]
  let $Some program = b.build_into nodes 1 1 #[b.branch 1 $Morning 2 3, b.action 2 $Hit 3, b.until 3 $Morning 4, b.stop 4] else:
    return #[]
  let $Some night = b.advance program (b.start program 0) frames visited 3.0 12 4 act (ready false) cleanup else:
    return #[]
  let night_state: b.State U32 = night.state
  let $Some morning = b.advance program night_state frames visited 0.0 12 4 act (ready true) cleanup else:
    return #[]
  return #[night_state.step, night_state.local, F32.to_u32 night_state.elapsed, morning.state.step, morning.state.local]

entry const workload = func (count: U32) => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let visited: ResizeArray U32 = #[]
  let $Some program = program nodes else:
    return #[]
  let sum = 0
  let transitions = 0
  for i in 0 .. count:
    frames.truncate 0
    let $Some result = b.advance program (b.start program 0) frames visited 1.25 32 4 act (ready true) cleanup else:
      return #[]
    sum := self + result.state.local
    transitions := self + result.transitions
  return #[sum, transitions]

entry const boundaries = func () => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let visited: ResizeArray U32 = #[]
  let restored_frames: ResizeArray b.Frame = #[]
  let restored_visited: ResizeArray U32 = #[]
  let $Some program = program nodes else:
    return #[]
  let state = b.start program 0
  let restored = state
  let trace: GrowArray U32 = #[]
  for i in 0 .. 12:
    let $Some a = b.advance program state frames visited 1.0 1 4 act (ready true) cleanup else:
      return #[]
    let $Some loaded = b.restore_into restored_frames program 4 decode (b.encode encode restored restored_frames) else:
      return #[]
    let $Some z = b.advance program loaded restored_frames restored_visited 1.0 1 4 act (ready true) cleanup else:
      return #[]
    if a.state.step != z.state.step or a.state.local != z.state.local or a.transitions != z.transitions:
      return #[]
    state := a.state
    restored := z.state
    for id in a.visited:
      trace.push id
  return array.concat #[state.local, restored.local] (@storage.freeze trace)
entry const invalid_time = func (seconds: F32) => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let visited: ResizeArray U32 = #[]
  let $Some program = program nodes else:
    return 0
  return if Maybe.is_some (b.advance program (b.start program 0) frames visited seconds 0 0 act (ready true) cleanup) then 1 else 0
entry const saved = func () => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let $Some program = program nodes else:
    return #[]
  return b.encode encode (b.start program 0) frames
entry const read = func (words: Array U32) => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let $Some program = program nodes else:
    return 0
  return if Maybe.is_some (b.restore_into frames program 4 decode words) then 1 else 0
entry const stack_limit = func () => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let visited: ResizeArray U32 = #[]
  let $Some program = b.build_into nodes 1 1 #[b.repeat 1 3 2 3, b.again 2 1, b.stop 3] else:
    return #[]
  let $Some result = b.advance program (b.start program 0) frames visited 2.0 10 0 act (ready true) cleanup else:
    return #[]
  let full = case result.state.status of
    $b.StackFull => 1
    _ => 0
  let bad_nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let bad = b.build_into bad_nodes 1 1 #[b.again 1 2, b.stop 2]
  return #[full, result.transitions, F32.to_u32 result.remaining, if Maybe.is_some bad then 0 else 1]

// Delivery targets use stable identities. A removed pile aborts into an
// application-defined fallback; recycling its slot never redirects delivery.
type Pile is data = $Pile
type DeliveryAction is data = $Walk | $Deliver
type Delivery is data = $Delivery { target: h.Handle Pile, carried: U32, delivered: U32, cleaned: U32 }
const delivery_act = func (piles: h.Store [Pile,U32]) -> (slots: ResizeArray h.Slot) -> (meta: h.Metadata) -> (action: DeliveryAction) -> (tick: b.Tick) -> (local: Delivery) : b.Result Delivery => return do:
  let $Some available = h.get local.target piles slots meta else:
    return $b.Abort { local, reason: 404 }
  let delivering = case action of
    $Deliver => true
    $Walk => false
  if delivering:
    local.delivered := self + min available local.carried
    local.carried := 0
  return $b.Done { local, remaining: tick.seconds }
const delivery_cleanup = func (reason: U32) -> (local: Delivery) : Delivery => return do:
  local.cleaned := self + 1
  return local
const local_encode = func (local: Delivery) => return array.concat (h.encode_handle local.target) #[local.carried, local.delivered, local.cleaned]
const local_decode = func (words: Array U32) => return do:
  if words.length != 7:
    return $Nothing
  let $Some target = h.decode_handle $Pile (array.slice 0 4 words) else:
    return $Nothing
  return $Some ($Delivery { target, carried: words[4], delivered: words[5], cleaned: words[6] })
entry const delivery = func (remove: U32) => return do:
  let nodes: ResizeArray (b.Node [DeliveryAction, Unit]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let visited: ResizeArray U32 = #[]
  let piles_rows: ResizeArray U32 = #[]
  let piles: h.Store [Pile, U32] = h.store $Pile piles_rows
  let owners: ResizeArray U32 = #[]
  let slots: ResizeArray h.Slot = #[]
  let free: ResizeArray U32 = #[]
  let meta = h.metadata 12 1 3
  let ids: ResizeArray (h.Handle Pile) = h.handle_pool $Pile
  for amount in #[5,8,13]:
    let $Some id = h.insert $Pile amount piles owners slots free meta else:
      return #[]
    ids.push id
  let $Some program = b.build_into nodes 2 10 #[b.action 10 $Walk 20, b.wait 20 1.0 30, b.action 30 $Deliver 40, b.stop 40] else:
    return #[]
  let local = $Delivery { target: ids[1], carried: 4, delivered: 0, cleaned: 0 }
  let $Some before = b.advance program (b.start program local) frames visited 0.25 8 2 (delivery_act piles slots meta) (func (condition: Unit) -> (local: Delivery) : Bool => return true) delivery_cleanup else:
    return #[]
  let before_state: b.State Delivery = before.state
  let saved = b.encode local_encode before_state frames
  // The same lossless adapter used for generated data carries behavior saves.
  let $Some words = c.unpack 0 (c.pack 0 saved) else:
    return #[]
  let $Some loaded = b.restore_into frames program 2 local_decode words else:
    return #[]
  if Bool.not (h.remove ids[if remove == 0 then 0 else 1] piles owners slots free meta):
    return #[]
  let $Some replacement = h.insert $Pile 99 piles owners slots free meta else:
    return #[]
  let $Some after = b.advance program loaded frames visited 2.0 8 2 (delivery_act piles slots meta) (func (condition: Unit) -> (local: Delivery) : Bool => return true) delivery_cleanup else:
    return #[]
  let after_state: b.State Delivery = after.state
  let after_visited = array.generate after.visited.length (func i => return after.visited[i])
  let twice = b.interrupt 404 delivery_cleanup after_state frames
  return array.concat #[after_state.local.delivered, after_state.local.carried, twice.local.cleaned, before_state.local.carried] after_visited
entry const version_migration = func () => return do:
  let nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let frames: ResizeArray b.Frame = #[]
  let visited: ResizeArray U32 = #[]
  let $Some old = b.build_into nodes 1 10 #[b.wait 10 1.0 20, b.stop 20] else:
    return #[]
  let next_nodes: ResizeArray (b.Node [Action, Condition]) = #[]
  let $Some next = b.build_into next_nodes 2 100 #[b.wait 100 1.0 200, b.stop 200] else:
    return #[]
  let $Some pending = b.advance old (b.start old 7) frames visited 0.25 4 2 act (ready true) cleanup else:
    return #[]
  let saved = b.encode encode pending.state frames
  let migrated = @storage.copy saved
  // Explicit application migration: old wait 10 became wait 100; same timer.
  migrated[1] := 2
  migrated[2] := 100
  let $Some loaded = b.restore_into frames next 2 decode migrated else:
    return #[]
  let $Some after = b.advance next loaded frames visited 0.75 4 2 act (ready true) cleanup else:
    return #[]
  return #[saved[1], saved[2], after.state.step, after.state.local]

entry const reference = func (count: U32) => return do:
  let sum = 0
  let transitions = 0
  for actor in 0 .. count:
    let local = 0
    let step = 10
    let repeat = 0
    for dispatch in 0 .. 9:
      case step of
        10 => do:
          step := 20
        20 => do:
          repeat := 3
          step := 30
        30 => do:
          local := self + 1
          step := 40
        40 => do:
          repeat := self - 1
          step := if repeat > 0 then 30 else 50
        _ => ()
      if dispatch < 8:
        transitions := self + 1
    sum := self + local
  return #[sum, transitions]
