import * as g from "./fixtures/behavior/actions_derived"
import * as b from "ink/behavior"
import * as c from "ink/codec"
import * as array from "std/array"
const encode = func (local: U32) => return #[local]
const decode = func (words: Array U32) => return if words.length == 1 then $Some words[0] else $Nothing
const advance = func fast => return func state => return func seconds => return func budget => return func frames => return
  if fast then g.actor_advance state seconds budget frames else b.advance g.actor_program state seconds budget frames g.act g.ready g.cleanup
entry const replay = func (input: Array U32) => return do:
  let state = b.start g.actor_program input[3]
  state.step := input[5]
  let out = #[]
  for i in 6 .. input.length:
    let $Some dt = c.float_from_word input[i] else:
      return #[]
    if input[4] == 1:
      let $Some restored = b.restore g.actor_program input[2] decode (b.encode encode state) else:
        return #[]
      state := restored
    let $Some result = advance (input[0] == 1) state dt input[1] input[2] else:
      return #[]
    let saved = b.encode encode result.state
    out := array.concat self #[saved.length, c.float_word result.remaining, result.transitions, result.visited.length]
    out := array.concat self saved
    out := array.concat self result.visited
    state := result.state
  return out
const batch = func fast => return func count => return do:
  let sum = 0
  let transitions = 0
  let visits = 0
  for i in 0 .. count:
    let $Some result = advance fast (b.start g.actor_program 0) 1.0 64 4 else:
      return #[]
    sum := self + result.state.local
    transitions := self + result.transitions
    visits := self + result.visited.length
  return #[sum, transitions, visits]
entry const compiled = func (count: U32) => return batch true count
entry const interpreted = func (count: U32) => return batch false count
