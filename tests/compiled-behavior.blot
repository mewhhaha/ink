import * as g from "./fixtures/behavior/actions_derived"
import * as b from "ink/behavior"
import * as c from "ink/codec"
func encode (local: U32) => #[local]
func decode (words: #[U32]) => if words.length == 1 then $Some words[0] else $Nothing
func advance fast -> state -> frames -> visited -> seconds -> budget -> max_frames => return
  if fast then g.actor_advance state frames visited seconds budget max_frames
  else b.advance g.actor_program state frames visited seconds budget max_frames g.act g.ready g.cleanup
entry func replay (input: #[U32]) =>
  let frames: #[~b.Frame] = #[]
  let visited: #[~U32] = #[]
  let state = b.start g.actor_program input[3]
  state.step := input[5]
  let out: #[+U32] = #[]
  for i in 6 .. input.length:
    let $Some dt = c.float_from_word input[i] else:
      return #[]
    if input[4] == 1:
      let saved = b.encode encode state frames
      let $Some restored = b.restore_into frames g.actor_program input[2] decode saved else:
        return #[]
      state := restored
    let $Some result = advance (input[0] == 1) state frames visited dt input[1] input[2] else:
      return #[]
    let saved = b.encode encode result.state frames
    for word in #[saved.length, c.float_word result.remaining, result.transitions, result.visited.length]:
      out.push word
    for word in saved:
      out.push word
    for word in result.visited:
      out.push word
    state := result.state
  return seal out
func batch fast -> count =>
  let frames: #[~b.Frame] = #[]
  let visited: #[~U32] = #[]
  let sum = 0
  let transitions = 0
  let visits = 0
  for i in 0 .. count:
    frames.truncate 0
    let $Some result = advance fast (b.start g.actor_program 0) frames visited 1.0 64 4 else:
      return #[]
    sum := self + result.state.local
    transitions := self + result.transitions
    visits := self + result.visited.length
  return #[sum, transitions, visits]
entry func compiled (count: U32) => batch true count
entry func interpreted (count: U32) => batch false count
