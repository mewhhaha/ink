import * as time from "ink/time"

entry const fixed = func (lanes: Array F32) : Array F32 => return case time.fixed lanes[0] (F32.to_u32 lanes[1]) lanes[2] lanes[3] of
  $Nothing => #[0.0]
  $Some result => #[1.0, U32.to_f32 result.steps, result.remainder, result.alpha, result.dropped]

// Keep the limit and result in the guest's U32 ABI, beyond F32's integer precision.
entry const huge_steps = func (limit: U32) : U32 => return case time.fixed 1.0 limit 0.0 1e20 of
  $Nothing => 0
  $Some result => result.steps

entry const near_steps = func (limit: U32) : U32 => return case time.fixed 1.0 limit 0.0 (U32.to_f32 limit) of
  $Nothing => 0
  $Some result => result.steps

entry const three_ticks = func (delta: F32) : Array F32 => return case time.fixed (1.0 / 60.0) 8 0.0 delta of
  $Nothing => #[0.0]
  $Some result => #[1.0, U32.to_f32 result.steps, result.remainder, result.alpha, result.dropped]

entry const timer = func (lanes: Array F32) : Array F32 => return case time.timer lanes[0] of
  $Nothing => #[0.0]
  $Some value => case time.tick value lanes[1] of
    $Nothing => #[0.0]
    $Some result => do:
      let expired = 0.0
      if result.expired:
        expired := 1.0
      let done = 0.0
      if time.done result.timer:
        done := 1.0
      break #[1.0, result.timer.remaining, expired, result.overshoot, done]
