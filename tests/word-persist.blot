import * as array from "std/array"
import * as c from "ink/codec"
import * as ecs from "ink/ecs"
import * as words from "ink/persist/words"
import * as persist from "ink/persist"
import * as m from "./fixtures/derived/model_derived"
type Counter is data = $Counter U32
func counter_encode (counter: Counter) =>
  let $Counter value = counter
  return #[value]
func counter_decode (values: #[U32]) => if values.length == 1 then $Some ($Counter values[0]) else $Nothing
func migrate (version: U32) -> (values: #[U32]) => if version == 0 then $Some #[values[0] + 100] else $Nothing
const counter = c.saved 4294967293 4294967295 counter_encode counter_decode migrate
const old_counter = c.saved 4294967293 0 counter_encode counter_decode c.no_migration
func site id => $m.Site { ring: 4294967295, sector: 16777217, kind: id, age: -0.0, work: 100, impact: 0.375, delivered: 4 }
const town = $m.Town { sites_start: 0, sites_count: 1, deliveries_start: 0, deliveries_count: 1 }
const site_codec = m.site_words c.no_migration
const delivery_codec = m.delivery_words c.no_migration
const town_site_codec = c.saved 500 1 site_codec.encode site_codec.decode c.no_migration
const town_delivery_codec = c.saved 501 1 delivery_codec.encode delivery_codec.decode c.no_migration
type State = {alive: ecs.Entities, entity_meta: ecs.Metadata, current: #[Counter], previous: #[Counter], town: #[m.Town],
  sites: ecs.Pool m.Site, site_meta: ecs.Metadata, previous_sites: ecs.Pool m.Site, previous_meta: ecs.Metadata,
  deliveries: ecs.Pool m.Delivery, delivery_meta: ecs.Metadata, payload_alive: ecs.Entities,
  town_sites: ecs.Pool m.Site, town_site_meta: ecs.Metadata, town_deliveries: ecs.Pool m.Delivery, town_delivery_meta: ecs.Metadata}
func with_world (count: U32) -> run =>
  let alive = ecs.entities ()
  let entity_meta = ecs.metadata 1
  let current: #[Counter] = #[$Counter 7]
  let previous: #[Counter] = #[$Counter 7]
  let town_owner: #[m.Town] = #[town]
  let sites: ecs.Pool m.Site = ecs.pool ()
  let site_meta = ecs.metadata 1
  let previous_sites: ecs.Pool m.Site = ecs.pool ()
  let previous_meta = ecs.metadata 1
  let deliveries: ecs.Pool m.Delivery = ecs.pool ()
  let delivery_meta = ecs.metadata 1
  let payload_alive: ecs.Entities = #[true]
  let town_sites: ecs.Pool m.Site = #[$Some (site 4294967295)]
  let town_site_meta = ecs.metadata 1
  let town_deliveries: ecs.Pool m.Delivery = #[$Some ($m.To {home: 4294967295, amount: $m.Positive 7})]
  let town_delivery_meta = ecs.metadata 1
  let (_, alive, entity_meta) = ecs.spawn_many alive entity_meta count
  let (sites, site_meta) = ecs.insert_selected alive sites site_meta (array.generate count identity) (array.generate count site)
  previous_sites := ecs.checkpoint identity self sites
  previous[0] := current[0]
  current[0] := $Counter 9
  let (sites, site_meta) = ecs.insert_selected alive sites site_meta (array.generate count identity) (array.generate count (func i => site (i + 10)))
  if count > 0:
    let was = ecs.contains deliveries 0
    deliveries := ecs.put_row alive self 0 ($m.To {home: 4294967295, amount: $m.Positive 9})
    delivery_meta := ecs.bump_insert was self
  return run (own {alive, entity_meta, current, previous, town: town_owner, sites, site_meta, previous_sites, previous_meta,
    deliveries, delivery_meta, payload_alive, town_sites, town_site_meta, town_deliveries, town_delivery_meta})
func encode_with counter -> (state: State) -> sections -> payload =>
  words.write_alive state.alive sections payload
  words.write_snapshotted_resource counter state.current[0] state.previous[0] sections payload
  words.write_resource (m.town_words c.no_migration) state.town[0] sections payload
  words.write_snapshotted_component site_codec state.sites state.previous_sites sections payload
  words.write_component delivery_codec state.deliveries sections payload
  // The generated Town contains checked spans; its two payload pools are saved
  // independently, rather than being owning arrays inside a resource row.
  words.write_component town_site_codec state.town_sites sections payload
  words.write_component town_delivery_codec state.town_deliveries sections payload
  return ()
const encode_schema = encode_with counter
func decode_schema (state: own State) -> sections -> input -> outcomes =>
  state.entity_meta := words.restore_alive sections input state.alive state.entity_meta outcomes
  let (current, previous) = words.restore_snapshotted_resource counter ($Counter 7) state.current state.previous sections input outcomes
  state.current := current
  state.previous := previous
  state.town := words.restore_resource (m.town_words c.no_migration) town state.town sections input outcomes
  let (sites, site_meta, previous_sites, previous_meta) = words.restore_snapshotted_component site_codec state.alive state.sites state.site_meta state.previous_sites state.previous_meta sections input outcomes
  state.sites := sites
  state.site_meta := site_meta
  state.previous_sites := previous_sites
  state.previous_meta := previous_meta
  let (deliveries, delivery_meta) = words.restore_component delivery_codec state.alive state.deliveries state.delivery_meta sections input outcomes
  state.deliveries := deliveries
  state.delivery_meta := delivery_meta
  let (town_sites, town_site_meta) = words.restore_component town_site_codec state.payload_alive state.town_sites state.town_site_meta sections input outcomes
  state.town_sites := town_sites
  state.town_site_meta := town_site_meta
  let (town_deliveries, town_delivery_meta) = words.restore_component town_delivery_codec state.payload_alive state.town_deliveries state.town_delivery_meta sections input outcomes
  state.town_deliveries := town_deliveries
  state.town_delivery_meta := town_delivery_meta
  return state
func summary (state: State) =>
  let $Counter a = state.current[0]
  let $Counter b = state.previous[0]
  let sum = 0
  for value in state.sites:
    if let $Some s = value:
      sum := self + s.kind
  let first = 0
  if state.previous_sites.length > 0:
    first := case state.previous_sites[0] of
      $Some s => s.kind
      $Nothing => 4294967295
  let stored = state.town[0]
  words.require (stored.sites_start < state.town_sites.length and stored.sites_count == 1 and stored.deliveries_start < state.town_deliveries.length and stored.deliveries_count == 1)
  let $Some saved_site = state.town_sites[stored.sites_start] else:
    return panic "missing town site payload"
  return #[state.alive.length, a, b, sum, first, saved_site.ring]
entry func save (count: U32) => with_world count (func (state: own State) =>
  let sections: #[~words.Section] = #[]
  let payload: #[~U32] = #[]
  let destination: #[~U32] = #[]
  words.encode_state 4294967295 sections payload encode_schema state destination
  return seal destination)
entry func restore (saved: #[U32]) => with_world 0 (func (state: own State) =>
  let sections: #[~words.Section] = #[]
  let outcomes: #[~persist.Outcome] = #[]
  state := words.decode_state 4294967295 saved sections decode_schema state outcomes
  return summary state)
entry func roundtrip (count: U32) =>
  let saved = save count
  return with_world 0 (func (state: own State) =>
    let sections: #[~words.Section] = #[]
    let payload: #[~U32] = #[]
    let again: #[~U32] = #[]
    let outcomes: #[~persist.Outcome] = #[]
    state := words.decode_state 4294967295 saved sections decode_schema state outcomes
    words.encode_state 4294967295 sections payload encode_schema state again
    let before = save count
    return array.concat #[if c.same_words saved again and c.same_words before saved then 1 else 0] (summary state))
func encode_scene (state: State) -> sections -> payload =>
  words.write_alive state.alive sections payload
  words.write_component site_codec state.sites sections payload
  words.write_component delivery_codec state.deliveries sections payload
  return ()
func decode_scene (state: own State) -> sections -> input -> outcomes =>
  state.entity_meta := words.restore_alive sections input state.alive state.entity_meta outcomes
  let (sites, site_meta) = words.restore_component site_codec state.alive state.sites state.site_meta sections input outcomes
  state.sites := sites
  state.site_meta := site_meta
  state.previous_sites := ecs.checkpoint identity self state.sites
  let (deliveries, delivery_meta) = words.restore_component delivery_codec state.alive state.deliveries state.delivery_meta sections input outcomes
  state.deliveries := deliveries
  state.delivery_meta := delivery_meta
  return state
entry func scene_restore () => with_world 3 (func (state: own State) =>
  let sections: #[~words.Section] = #[]
  let payload: #[~U32] = #[]
  let destination: #[~U32] = #[]
  let outcomes: #[~persist.Outcome] = #[]
  words.encode_scene 4294967295 sections payload encode_scene state destination
  state.current[0] := $Counter 42
  state := words.decode_scene 4294967295 destination sections decode_scene state outcomes
  return summary state)
entry func migration () => with_world 3 (func (original: own State) =>
  let sections: #[~words.Section] = #[]
  let payload: #[~U32] = #[]
  let destination: #[~U32] = #[]
  words.encode_state 4294967295 sections payload (encode_with old_counter) original destination
  return with_world 0 (func (state: own State) =>
    let outcomes: #[~persist.Outcome] = #[]
    state := words.decode_state 4294967295 destination sections decode_schema state outcomes
    let migrated = 0
    for outcome in outcomes:
      if let $persist.Migrated = outcome.fate:
        migrated := self + 1
    return array.concat #[migrated] (summary state)))
entry func codec_roundtrips (count: U32) =>
  let codec = m.site_words c.no_migration
  let sum = 0
  let size = 0
  for id in 0 .. count:
    let saved = codec.encode (site id)
    let $Some value = codec.decode saved else:
      return #[]
    sum := self + value.kind
    size := self + saved.length
  return #[sum, size]
entry func codec_bridge (count: U32) =>
  let codec = m.site_codec c.no_migration
  let sum = 0
  let size = 0
  for id in 0 .. count:
    let saved = codec.encode (site id)
    let value = codec.decode saved
    sum := self + value.kind
    size := self + saved.length
  return #[sum, size]
const counter_bridge = c.bridge 1 1 0 counter_encode counter_decode c.no_migration
const delivery_bridge = c.bridge 101 1 32 delivery_codec.encode delivery_codec.decode c.no_migration
const town_site_bridge = c.bridge 500 1 32 site_codec.encode site_codec.decode c.no_migration
const town_delivery_bridge = c.bridge 501 1 32 delivery_codec.encode delivery_codec.decode c.no_migration
func encode_bridge (state: State) -> sections -> payload =>
  persist.write_alive state.alive sections payload
  persist.write_snapshotted_resource counter_bridge state.current[0] state.previous[0] sections payload
  persist.write_resource (m.town_codec c.no_migration) state.town[0] sections payload
  persist.write_snapshotted_component (m.site_codec c.no_migration) 66 state.alive state.sites state.previous_sites sections payload
  persist.write_component delivery_bridge 66 state.deliveries sections payload
  persist.write_component town_site_bridge 66 state.town_sites sections payload
  persist.write_component town_delivery_bridge 66 state.town_deliveries sections payload
  return ()
func decode_bridge (state: own State) -> sections -> input -> outcomes =>
  let (alive, entity_meta) = persist.restore_alive sections input state.alive state.entity_meta outcomes
  state.alive := alive
  state.entity_meta := entity_meta
  let (current, previous) = persist.restore_snapshotted_resource counter_bridge ($Counter 7) state.current state.previous sections input outcomes
  state.current := current
  state.previous := previous
  state.town := persist.restore_resource (m.town_codec c.no_migration) town state.town sections input outcomes
  let (sites, site_meta, previous_sites, previous_meta) = persist.restore_snapshotted_component (m.site_codec c.no_migration) 66 identity state.alive state.sites state.site_meta state.previous_sites state.previous_meta sections input outcomes
  state.sites := sites
  state.site_meta := site_meta
  state.previous_sites := previous_sites
  state.previous_meta := previous_meta
  let (deliveries, delivery_meta) = persist.restore_component delivery_bridge 66 state.alive state.deliveries state.delivery_meta sections input outcomes
  state.deliveries := deliveries
  state.delivery_meta := delivery_meta
  let (town_sites, town_site_meta) = persist.restore_component town_site_bridge 66 state.payload_alive state.town_sites state.town_site_meta sections input outcomes
  state.town_sites := town_sites
  state.town_site_meta := town_site_meta
  let (town_deliveries, town_delivery_meta) = persist.restore_component town_delivery_bridge 66 state.payload_alive state.town_deliveries state.town_delivery_meta sections input outcomes
  state.town_deliveries := town_deliveries
  state.town_delivery_meta := town_delivery_meta
  return state
entry func bridge_roundtrip (count: U32) => with_world count (func (original: own State) =>
  let sections: #[~persist.Section] = #[]
  let payload: #[~F32] = #[]
  let saved: #[~F32] = #[]
  let before: #[~F32] = #[]
  let again: #[~F32] = #[]
  persist.encode_state 1 sections payload encode_bridge original saved
  return with_world 0 (func (state: own State) =>
    let (_, state) = persist.decode_state 1 saved decode_bridge state
    persist.encode_state 1 sections payload encode_bridge state again
    persist.encode_state 1 sections payload encode_bridge original before
    let same = saved.length == again.length and saved.length == before.length
    for i in 0 .. saved.length:
      if saved[i] != again[i] or saved[i] != before[i]:
        same := false
    return array.concat #[if same then 1 else 0] (summary state)))
