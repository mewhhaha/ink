import * as array from "std/array"
import * as c from "ink/codec"
import * as ecs from "ink/ecs"
import * as words from "ink/persist/words"
import * as persist from "ink/persist"
import * as m from "./fixtures/derived/model_derived"
type Counter is data = $Counter U32
const counter_encode = func (counter: Counter) => return do:
  let $Counter value = counter
  return #[value]
const counter_decode = func (values: Array U32) => return if values.length == 1 then $Some ($Counter values[0]) else $Nothing
const migrate = func (version: U32) => return if version == 0 then $Some (func (values: Array U32) => return #[values[0] + 100]) else $Nothing
const counter = c.saved 4294967293 4294967295 counter_encode counter_decode migrate
const site = func id => return $m.Site { ring: 4294967295, sector: 16777217, kind: id, age: -0.0, work: 100, impact: 0.375, delivered: 4 }
const town = $m.Town { sites: #[site 4294967295], deliveries: #[$m.To { home: 4294967295, amount: $m.Positive 7 }] }
const simulation = do:
  let builder = ecs.new ()
  builder := ecs.insert_snapshotted_resource ($Counter 7) self
  builder := ecs.insert_resource town self
  builder := ecs.register_snapshotted_component (site 0) self
  builder := ecs.register_component $m.Idle self
  break ecs.build builder
const saves_for = func counter => return do:
  let saves = words.new ()
  saves := words.snapshotted_resource counter ($Counter 7) self
  saves := words.resource (m.Town_words c.no_migration) town self
  saves := words.snapshotted_component (m.Site_words c.no_migration) (site 0) self
  saves := words.component (m.Delivery_words c.no_migration) $m.Idle self
  return saves
const saves = saves_for counter
const world = func (count: U32) => return do:
  let (world, _) = ecs.create simulation (func () => return do:
    use ecs.spawn_many count
    use ecs.insert_many $m.Site 0 (array.generate count site)
    use ecs.checkpoint simulation
    use ecs.set ($Counter 9)
    use ecs.insert_many $m.Site 0 (array.generate count (func i => return site (i + 10)))
    if count > 0:
      use ecs.at 0 (func () => return ecs.set ($m.To { home: 4294967295, amount: $m.Positive 9 })))
  return world
const summary = func () => return do:
  use alive <- ecs.entities ()
  use current <- ecs.get $Counter
  use previous <- ecs.previous $Counter
  let $Counter a = current
  let $Counter b = previous
  use current <- ecs.components $m.Site
  use previous <- ecs.previous_components $m.Site
  let sum = 0
  for value in current:
    if let $Some s = value:
      sum := self + s.kind
  let first = 0
  if previous.length > 0:
    first := case previous[0] of
      $Some s => s.kind
      $Nothing => 4294967295
  use stored <- ecs.get $m.Town
  return #[alive.length, a, b, sum, first, stored.sites[0].ring]
entry const save = func count => return do:
  let (_, saved) = ecs.run simulation (world count) (func () => return words.encode_state saves 4294967295)
  return saved
entry const restore = func (saved: Array U32) => return do:
  let (restored, _) = ecs.create simulation (func () => return words.decode_state saves 4294967295 saved)
  let (_, result) = ecs.run simulation restored summary
  return result
entry const roundtrip = func (count: U32) => return do:
  let original = world count
  let (_, saved) = ecs.run simulation original (func () => return words.encode_state saves 4294967295)
  let (restored, _) = ecs.create simulation (func () => return words.decode_state saves 4294967295 saved)
  let (_, again) = ecs.run simulation restored (func () => return words.encode_state saves 4294967295)
  let (_, before) = ecs.run simulation original (func () => return words.encode_state saves 4294967295)
  let (_, result) = ecs.run simulation restored summary
  return array.concat #[if c.same_words saved again and c.same_words before saved then 1 else 0] result
entry const scene_restore = func () => return do:
  let original = world 3
  let (_, saved) = ecs.run simulation original (func () => return words.encode_scene saves 4294967295)
  let (restored, _) = ecs.run simulation original (func () => return do:
    use ecs.set ($Counter 42)
    return words.decode_scene saves 4294967295 saved)
  let (_, result) = ecs.run simulation restored summary
  return result
entry const migration = func () => return do:
  let old = saves_for (c.saved 4294967293 0 counter_encode counter_decode c.no_migration)
  let (_, saved) = ecs.run simulation (world 3) (func () => return words.encode_state old 4294967295)
  let (restored, outcomes) = ecs.create simulation (func () => return words.decode_state saves 4294967295 saved)
  let (_, result) = ecs.run simulation restored summary
  let migrated = 0
  for outcome in outcomes:
    if let $persist.Migrated = outcome.fate:
      migrated := self + 1
  return array.concat #[migrated] result
entry const codec_roundtrips = func (count: U32) => return do:
  let codec = m.Site_words c.no_migration
  let sum = 0
  let size = 0
  for id in 0 .. count:
    let saved = codec.encode (site id)
    let $Some value = codec.decode saved else:
      return #[]
    sum := self + value.kind
    size := self + saved.length
  return #[sum, size]

entry const codec_bridge = func (count: U32) => return do:
  let codec = m.Site_codec c.no_migration
  let sum = 0
  let size = 0
  for id in 0 .. count:
    let saved = codec.encode (site id)
    let value = codec.decode saved
    sum := self + value.kind
    size := self + saved.length
  return #[sum, size]

const bridge_saves = do:
  let saves = persist.new ()
  saves := persist.snapshotted_resource (c.bridge 1 1 0 counter_encode counter_decode c.no_migration) ($Counter 7) self
  saves := persist.resource (m.Town_codec c.no_migration) town self
  saves := persist.snapshotted_component (m.Site_codec c.no_migration) (site 0) self
  let delivery = m.Delivery_words c.no_migration
  saves := persist.component (c.bridge 101 1 32 delivery.encode delivery.decode c.no_migration) $m.Idle self
  break saves
entry const bridge_roundtrip = func (count: U32) => return do:
  let original = world count
  let (_, saved) = ecs.run simulation original (func () => return persist.encode_state bridge_saves 1)
  let (restored, _) = ecs.create simulation (func () => return persist.decode_state bridge_saves 1 saved)
  let (_, again) = ecs.run simulation restored (func () => return persist.encode_state bridge_saves 1)
  let (_, before) = ecs.run simulation original (func () => return persist.encode_state bridge_saves 1)
  let (_, result) = ecs.run simulation restored summary
  let same = saved.length == again.length and saved.length == before.length
  for i in 0 .. saved.length:
    if saved[i] != again[i] or saved[i] != before[i]:
      same := false
  return array.concat #[if same then 1 else 0] result
