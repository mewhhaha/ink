import * as check from "./check"
import * as array from "std/array"
import * as math from "ink/math"
import * as radial from "ink/radial"

const configuration = func (input: Array U32) => return $radial.Grid { cells: input[0], origin: -4.75, spacing: 0.5 }
const circles = func (input: Array U32) => return array.generate input[1] (func i => return math.vec4
  (U32.to_f32 (i % 11) * 1.3 - 6.0) (U32.to_f32 (i / 11) * 1.7 - 5.0)
  (0.1 + U32.to_f32 (i % 5) * 1.3) (0.2 + U32.to_f32 (i % 3) * 0.1))

// Independent full-grid evaluation: no clipping spans or vector operations.
entry const reference = func (input: Array U32) => return do:
  let grid = configuration input
  let patches = circles input
  return array.generate grid.cells (func x => return do:
    let value = 0.0
    for place in patches:
      let dx = grid.origin + U32.to_f32 x * grid.spacing - place.x
      let dz = grid.origin + U32.to_f32 input[2] * grid.spacing - place.y
      value := max self (clamp 0.0 1.0 ((place.z - sqrt (dx * dx + dz * dz)) / place.w))
    return value)
entry const scalar = func (input: Array U32) => return radial.scalar (configuration input) (circles input) input[2]
entry const vectorized = func (input: Array U32) => return radial.vectorized (configuration input) (circles input) input[2]
entry const selected = func (input: Array U32) => return radial.row (configuration input) (circles input) input[2]

entry const test_circle_union_simd_tails = func () => return do:
  let checks = #[]
  for size in #[1,2,3,4,5,17,193]:
    for count in #[0,1,31,63,64,128]:
      for z in #[0,size / 2,size - 1]:
        let input = #[size,count,z]
        let expected = reference input
        checks := array.concat self #[check.equal expected (scalar input),check.equal expected (vectorized input),check.equal expected (selected input)]
  return check.report checks
