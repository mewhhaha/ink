import * as check from "./check"
import * as array from "std/array"
import * as math from "ink/math"
import * as radial from "ink/radial"

func configuration (input: #[U32]) => $radial.Grid { cells: input[0], origin: -4.75, spacing: 0.5 }
func circles (input: #[U32]) => array.generate input[1] (func i => math.vec4
  (U32.to_f32 (i % 11) * 1.3 - 6.0) (U32.to_f32 (i / 11) * 1.7 - 5.0)
  (0.1 + U32.to_f32 (i % 5) * 1.3) (0.2 + U32.to_f32 (i % 3) * 0.1))

// Independent full-grid evaluation: no clipping spans or vector operations.
#entry func reference (input: #[U32]) =>
  let grid = configuration input
  let patches = circles input
  return array.generate grid.cells (func x =>
    let value = 0.0
    for place in patches:
      let dx = grid.origin + U32.to_f32 x * grid.spacing - place.x
      let dz = grid.origin + U32.to_f32 input[2] * grid.spacing - place.y
      value := max self (clamp 0.0 1.0 ((place.z - sqrt (dx * dx + dz * dz)) / place.w))
    return value)
#entry func scalar (input: #[U32]) => radial.scalar (configuration input) (circles input) input[2]
#entry func vectorized (input: #[U32]) => radial.vectorized (configuration input) (circles input) input[2]
#entry func selected (input: #[U32]) => radial.row (configuration input) (circles input) input[2]

#entry func test_circle_union_simd_tails () =>
  let checks: #[check.Check] = #[]
  for size in #[1,2,3,4,5,17,193]:
    for count in #[0,1,31,63,64,128]:
      for z in #[0,size / 2,size - 1]:
        let input = #[size,count,z]
        let expected = reference input
        @storage.push checks (check.equal expected (scalar input))
        @storage.push checks (check.equal expected (vectorized input))
        @storage.push checks (check.equal expected (selected input))
  return check.report checks
