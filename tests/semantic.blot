import * as codec from "ink/codec"
import * as model from "./fixtures/derived/model_derived"
import * as s from "ink/pen/semantic"

import * as array from "std/array"
#entry func observation (tick: U32) =>
  let arena: #[U32] = #[]
  let (who, arena) = s.identity arena "gnorp" #[4294967295, 16777217]
  let (f1, arena) = s.field arena 1 "destination" "U32" $s.Unsigned
  let (f2, arena) = s.field arena 2 "bits" "Array U32" $s.Encoded
  let (f3, arena) = s.field arena 3 "ready" "Bool" $s.Boolean
  let (v0, arena) = s.variant arena 0 "Waiting" #[f1, f2, f3]
  let (d1, arena) = s.described arena 1 "Żuraw 👾" 1 #[v0]
  let (schema, arena) = s.schema arena "unicode-v1" #[d1]
  let (u1, arena) = s.unsigned arena 1 4294967295
  let (e2, arena) = s.encoded arena 2 #[2147483648, 1]
  let (b3, arena) = s.boolean arena 3 true
  let (object, arena) = s.object arena who 1 0 #[u1, e2, b3]
  let (event, arena) = s.decision arena 4294967295 who "routing" "Quoted \"line\"\\path\n👾"
  let (result, _) = s.observation arena schema tick #[object] ($Some #[event]) 0 0
  return result
#entry func escaped () =>
  let arena: #[U32] = #[]
  let (quoted, arena) = s.quote arena "start 👾 end"
  return array.map identity (s.bytes arena quoted)
// Every original object contributes; output rows borrow one named numeric pool.
#entry func semantic_batch (count: U32) =>
  let arena: #[U32] = #[]
  let (f1, arena) = s.field arena 1 #[99] #[85, 51, 50] $s.Unsigned
  let (v0, arena) = s.variant arena 0 #[87] #[f1]
  let (d1, arena) = s.described arena 1 #[82] 1 #[v0]
  let (schema, arena) = s.schema arena #[98] #[d1]
  let objects: #[s.Slice] = #[]
  for index in 0 .. count:
    let (who, next_arena) = s.identity arena #[101] #[index]
    let (val, next_arena) = s.unsigned next_arena 1 index
    let (obj, next_arena) = s.object next_arena who 1 0 #[val]
    arena := next_arena
    @storage.push objects obj
  let (packet, _) = s.observation arena schema 17 objects ($Some #[]) 0 0
  let sum = 0.0
  for lane in packet:
    sum := self + lane
  return #[U32.to_f32 count, U32.to_f32 packet.length, sum]
#entry func derived_observation () =>
  let arena: #[U32] = #[]
  let value = $model.Site {ring: 16777217, sector: 7, kind: 4294967295, age: -0.125, work: 100, impact: 0.375, delivered: 4}
  let decode = func (words: #[U32]): Maybe model.Site => codec.Codec.decode words
  let payload = codec.encode value
  let fields: #[codec.FieldView] = #[]
  let descriptor = model.site_descriptor ()
  let $Some (_, view) = codec.inspect descriptor decode payload fields else:
    return #[]
  let (described, arena) = s.describe_codec arena 1 "Site" descriptor
  let (schema, arena) = s.schema arena "derived-v1" #[described]
  let (who, arena) = s.identity arena "site" #[4294967295]
  let (object, arena) = s.codec_object arena who 1 view
  let (packet, _) = s.observation arena schema 0 #[object] $Nothing 0 0
  return packet
