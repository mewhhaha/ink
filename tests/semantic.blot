import * as codec from "ink/codec"
import * as model from "./fixtures/derived/model_derived"
import * as s from "ink/pen/semantic"

import * as array from "std/array"
entry const observation = func (tick: U32) => return do:
  let arena: ResizeArray U32 = #[]
  let output: ResizeArray F32 = #[]
  let who = s.identity arena "gnorp" #[4294967295, 16777217]
  let schema = s.schema arena "unicode-v1" #[s.described arena 1 "Żuraw 👾" 1 #[s.variant arena 0 "Waiting" #[
    s.field arena 1 "destination" "U32" $s.Unsigned,
    s.field arena 2 "bits" "Array U32" $s.Encoded,
    s.field arena 3 "ready" "Bool" $s.Boolean,
  ]]]
  let object = s.object arena who 1 0 #[s.unsigned arena 1 4294967295, s.encoded arena 2 #[2147483648, 1], s.boolean arena 3 true]
  let event = s.decision arena 4294967295 who "routing" "Quoted \"line\"\\path\n👾"
  let result = s.observation arena output 42 schema tick #[object] ($Some #[event]) 0 0
  return array.map identity result.values
entry const escaped = func () => return do:
  let arena: ResizeArray U32 = #[]
  return array.map identity (s.bytes arena (s.quote arena "start 👾 end"))
// Every original object contributes; output rows borrow one named numeric pool.
entry const semantic_batch = func (count: U32) => return do:
  let arena: ResizeArray U32 = #[]
  let output: ResizeArray F32 = #[]
  let fields = #[s.field arena 1 #[99] #[85, 51, 50] $s.Unsigned]
  let schema = s.schema arena #[98] #[s.described arena 1 #[82] 1 #[s.variant arena 0 #[87] fields]]
  let objects = @array.generate count (func index => return
    s.object arena (s.identity arena #[101] #[index]) 1 0 #[s.unsigned arena 1 index])
  let packet = s.observation arena output 42 schema 17 objects ($Some #[]) 0 0
  let sum = 0.0
  for lane in packet.values:
    sum := self + lane
  return #[U32.to_f32 count, U32.to_f32 packet.values.length, sum]
entry const derived_observation = func () => return do:
  let arena: ResizeArray U32 = #[]
  let output: ResizeArray F32 = #[]
  let value = $model.Site {ring: 16777217, sector: 7, kind: 4294967295, age: -0.125, work: 100, impact: 0.375, delivered: 4}
  let decode = func (words: Array U32): Maybe model.Site => return codec.Codec.decode words
  let payload = codec.encode value
  let fields: ResizeArray codec.FieldView = #[]
  let descriptor = model.Site_descriptor ()
  let $Some (_, view) = codec.inspect descriptor decode payload fields else:
    return #[]
  let schema = s.schema arena "derived-v1" #[s.describe_codec arena 1 "Site" descriptor]
  let object = s.codec_object arena (s.identity arena "site" #[4294967295]) 1 view
  let packet = s.observation arena output 42 schema 0 #[object] $Nothing 0 0
  return array.map identity packet.values
