import * as s from "ink/pen/semantic"

entry const observation = fn (tick: U32) => do:
  let who = s.identity "gnorp" #[4294967295, 16777217]
  let schema = s.schema "unicode-v1" #[s.described 1 "Żuraw 👾" 1 #[s.variant 0 "Waiting" #[
    s.field 1 "destination" "U32" #s.Unsigned,
    s.field 2 "bits" "Array U32" #s.Encoded,
    s.field 3 "ready" "Bool" #s.Boolean,
  ]]]
  let object = s.object who 1 0 #[s.unsigned 1 4294967295, s.encoded 2 #[2147483648, 1], s.boolean 3 #True]
  let event = s.decision 4294967295 who "routing" "Quoted \"line\"\\path\n👾"
  let result = s.observation 42 schema tick #[object] (#Some #[event]) 0 0
  return result.values
entry const escaped = fn () => s.quote "start 👾 end"

// Every emitted sample contributes to the witness; size is selected objects.
entry const semantic_batch = fn (count: U32) => do:
  let fields = #[s.field 1 #[99] #[85, 51, 50] #s.Unsigned]
  let schema = s.schema #[98] #[s.described 1 #[82] 1 #[s.variant 0 #[87] fields]]
  let objects = @array.generate count (fn index =>
    s.object (s.identity #[101] #[index]) 1 0 #[s.unsigned 1 index])
  let packet = s.observation 42 schema 17 objects (#Some #[]) 0 0
  let sum = 0.0
  for lane in packet.values:
    sum := self + lane
  return #[U32.to_f32 count, U32.to_f32 packet.values.length, sum]
