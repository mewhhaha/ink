import * as font from "ink/ui/font"
// Handwritten font: callers own glyphs and atlas metadata.
func glyph (code: U32) =>
  let width = 0.5
  if code == 32:
    width := 0.0
  return $font.Glyph { u0: 0.1, v0: 0.2, u1: 0.3, v1: 0.4, left: 0.1, top: -0.75, width, height: 0.75, advance: 0.6 }
const glyphs: #[font.Entry] = @array.generate 128 (func code => $font.Entry {code, glyph: glyph code})
const face = $font.Font { material: 7, glyphs: &glyphs[0..glyphs.length], fallback: glyph 63, ascent: 0.75, descent: 0.25, spread: 0.05 }
