import * as retained_stream from "ink/render/retained"
import * as array from "std/array"
import * as math from "ink/math"
import * as render from "ink/render"
import * as instances from "ink/pen/instances"
import * as host from "ink/pen/host"
import * as persist from "ink/persist"
import * as services from "ink/services"
import * as preferences from "ink/preferences"
import * as owners from "./fixtures/packet_owners"

func draw (extra: &[math.Vec4]) -> (i: U32) : render.Draw => $render.Draw {mesh: 0, material: 0,
  matrix: math.Mat4.compose (math.vec3 (U32.to_f32 i) 0.0 0.0) math.Quat.identity (math.vec3 1.0 1.0 1.0),
  parameters: $Nothing, extra}
func update (extra: &[math.Vec4]) -> (i: U32) => $instances.Update {id: 4294967295 - i, order: i, draw: draw extra i}
const kept = $preferences.Preferences {
  quality: $preferences.Quality {msaa: 1, fxaa: false, scale: 1.0, filtering: 0,
    shadows: 0, occlusion: false, sky: false, fog: 1.0, effects: false, bloom: false},
  volumes: $preferences.Volumes {master: 0.5, music: 0.25, effects: 0.75},
  controls: $preferences.Controls {left_handed: false}, changed: false,
}
// Each test owns its frame, so what attaches to the frame can take it over.
func fresh () => owners.bind_frame () (own (host.frame_owners ()))
func packed (buses: Bool) -> (access: owners.Access) : #[F32] =>
  let requests = persist.requests ()
  let next = #[1]
  let outbox: #[~services.Request] = #[]
  let waiting: #[~services.Request] = #[]
  let filling: #[~services.Filling] = #[]
  let answers: #[~services.Answer] = #[]
  let statuses: #[~U32] = #[]
  let payload: #[~F32] = #[]
  let state = services.access next outbox waiting filling answers statuses payload
  let output: #[~F32] = #[]
  return seal (owners.encode 1 kept buses access state requests output)
entry func packet (count: U32) =>
  let access = fresh ()
  let extra: #[~math.Vec4] = access.frame_vectors
  let updates: #[instances.Update] = array.generate count (update (&extra[0..0]))
  let removed: #[U32] = #[16777217]
  let (attached, frame) = instances.attach true updates removed access.frame
  if not attached:
    return panic "valid retained packet was rejected"
  access.frame := frame
  return packed false access
entry func unsupported () =>
  let access = fresh ()
  let extra: #[~math.Vec4] = access.frame_vectors
  extra.push (math.vec4 1.0 2.0 3.0 4.0)
  let value = update (&extra[0..0]) 0
  value.draw.extra := &extra[0..1]
  let (attached, frame) = instances.attach true #[value] #[] access.frame
  return attached
func batch (retained: Bool) -> (count: U32) =>
  let extra: #[math.Vec4] = #[]
  let full: #[instances.Update] = array.generate count (update (&extra[0..0]))
  let dirty: #[instances.Update] = array.generate (count / 100) (update (&extra[0..0]))
  let lengths = 0
  let sum = 0.0
  for tick in 0 .. 16:
    let access = fresh ()
    if retained:
      let (attached, frame) = instances.attach (tick == 0) (if tick == 0 then full else dirty) #[] access.frame
      if not attached:
        return panic "valid retained batch was rejected"
      access.frame := frame
    else:
      for value in full:
        access.frame.draws.push value.draw
    let words: #[F32] = packed false access
    lengths := self + words.length
    sum := self + words[0]
  return #[U32.to_f32 lengths, sum]
entry func retained (count: U32) => batch true count
entry func immediate (count: U32) => batch false count
entry func adapted () =>
  let access = fresh ()
  let extra: #[~math.Vec4] = access.frame_vectors
  access.frame.updates.push ($render.Instance {id: 4294967295, order: 0, draw: draw (&extra[0..0]) 0})
  access.frame.settings[0].retained_enabled := true
  access.frame.settings[0].retained_reset := true
  return packed true access
entry func unchanged_host () => packed true (fresh ())
entry func unchanged_retained () => packed true (fresh ())
entry func stream (count: U32) =>
  let extra: #[math.Vec4] = #[]
  let flat: #[render.Draw] = array.generate ((count / 8) * 8) (draw (&extra[0..0]))
  let groups: #[&[render.Draw]] = array.generate (count / 8) (func group : &[render.Draw] => &flat[group * 8..group * 8 + 8])
  let state = retained_stream.state ()
  let stored = retained_stream.empty ()
  let ids: #[~U32] = #[]
  let counts: #[U32] = #[0,0,0]
  let headers = 0
  for tick in 0 .. 16:
    let access = fresh ()
    let (next_state, next_stored, next_ids, frame) = retained_stream.update (func group -> slot => group * 8 + slot) groups #[0] state stored ids access.frame
    state := next_state
    stored := next_stored
    ids := next_ids
    access.frame := frame
    counts[0] := self + access.frame.updates.length
    counts[1] := self + access.frame.removed.length
    for value in access.frame.updates:
      counts[2] := self + value.order
    let packet = packed true access
    if packet[0] == 4670534.0:
      headers := self + 1
  return #[counts[0], counts[1], state[1], counts[2], headers]
