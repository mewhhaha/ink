import * as retained_stream from "ink/render/retained"
import * as array from "std/array"
import * as math from "ink/math"
import * as render from "ink/render"
import * as instances from "ink/pen/instances"
import * as preferences from "ink/preferences"
import * as owners from "./fixtures/packet_owners"

func draw (extra: &[math.Vec4]) -> (i: U32) : render.Draw => return $render.Draw {mesh: 0, material: 0,
  matrix: math.Mat4.compose (math.vec3 (U32.to_f32 i) 0.0 0.0) math.Quat.identity (math.vec3 1.0 1.0 1.0),
  parameters: $Nothing, extra}
func update (extra: &[math.Vec4]) -> (i: U32) => return $instances.Update {id: 4294967295 - i, order: i, draw: draw extra i}
const kept = $preferences.Preferences {
  quality: $preferences.Quality {msaa: 1, fxaa: false, scale: 1.0, filtering: 0,
    shadows: 0, occlusion: false, sky: false, fog: 1.0, effects: false, bloom: false},
  volumes: $preferences.Volumes {master: 0.5, music: 0.25, effects: 0.75},
  controls: $preferences.Controls {left_handed: false}, changed: false,
}
func encode (buses: Bool) -> configure => return owners.with_output (func (access: owners.Access) -> state -> requests -> output => return do:
  configure access
  owners.encode 1 kept buses access state requests output
)
entry func packet (count: U32) => return encode false (func (access: owners.Access) => return do:
  let updates: Array instances.Update = array.generate count (update (&access.frame_vectors[0..0]))
  let removed: Array U32 = #[16777217]
  if Bool.not (instances.attach true updates removed access.frame):
    return @panic "valid retained packet was rejected"
)
entry func unsupported () => return owners.with_access (func (access: owners.Access) => return do:
  let extra: ResizeArray math.Vec4 = access.frame_vectors
  extra.push (math.vec4 1.0 2.0 3.0 4.0)
  let value = update (&extra[0..0]) 0
  value.draw.extra := &extra[0..1]
  return instances.attach true #[value] #[] access.frame
)
func batch (retained: Bool) -> (count: U32) => return do:
  let extra: Array math.Vec4 = #[]
  let full: Array instances.Update = array.generate count (update (&extra[0..0]))
  let dirty: Array instances.Update = array.generate (count / 100) (update (&extra[0..0]))
  let lengths = 0
  let sum = 0.0
  for tick in 0 .. 16:
    let words: Array F32 = encode false (func (access: owners.Access) => return do:
      if retained:
        if Bool.not (instances.attach (tick == 0) (if tick == 0 then full else dirty) #[] access.frame):
          return @panic "valid retained batch was rejected"
      else:
        for value in full:
          access.frame.draws.push value.draw
    )
    lengths := self + words.length
    sum := self + words[0]
  return #[U32.to_f32 lengths, sum]
entry func retained (count: U32) => return batch true count
entry func immediate (count: U32) => return batch false count
entry func adapted () => return encode true (func (access: owners.Access) => return do:
  access.frame.updates.push ($render.Instance {id: 4294967295, order: 0, draw: draw (&access.frame_vectors[0..0]) 0})
  access.frame.settings[0].retained_enabled := true
  access.frame.settings[0].retained_reset := true
)
entry func unchanged_host () => return encode true (func (access: owners.Access) => return ())
entry func unchanged_retained () => return encode true (func (access: owners.Access) => return ())
entry func stream (count: U32) => return do:
  let extra: Array math.Vec4 = #[]
  let flat: Array render.Draw = array.generate ((count / 8) * 8) (draw (&extra[0..0]))
  let groups: Array (&[render.Draw]) = array.generate (count / 8) (func group : &[render.Draw] => return &flat[group * 8..group * 8 + 8])
  let state = retained_stream.state ()
  let stored = retained_stream.empty ()
  let ids: ResizeArray U32 = #[]
  let counts: Array U32 = #[0,0,0]
  let headers = 0
  for tick in 0 .. 16:
    let packet = encode true (func (access: owners.Access) => return do:
      retained_stream.update (func group -> slot => return group * 8 + slot) groups #[0] state stored ids access.frame
      counts[0] := self + access.frame.updates.length
      counts[1] := self + access.frame.removed.length
      for value in access.frame.updates:
        counts[2] := self + value.order
    )
    if packet[0] == 4670534.0:
      headers := self + 1
  return #[counts[0], counts[1], state[1], counts[2], headers]
