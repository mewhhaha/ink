import * as test from "std/test"
import * as text from "ink/text"

@[test.suite]
test "readonly ranges":
  let source = #[0,32,49,50,32,51,52,32,0]
  let view = source.view 1 8
  let left = #[49,50]
  let right = #[51,52]
  let prefix = source.view 2 4
  let parts = text.words view
  let lines_source = #[65,10,66,10]
  let lines = text.lines (lines_source.view 0 lines_source.length)
  let numeric = #[0,45,49,46,50,53,101,50,0]
  let parsed = text.number (numeric.view 1 8)
  let _v1 = (text.same left prefix)
  use test.holds "check 1" _v1
  let _v2 = (text.starts left prefix)
  use test.holds "check 2" _v2
  let _v3 = (text.before prefix right)
  use test.holds "check 3" _v3
  let _v4 = #[1]
  let _v5 = #[Maybe.unwrap_or 99 (text.find 50 prefix)]
  use test.eq "check 4" _v4 _v5
  let _v6 = #[49,50,32]
  let _v7 = (text.part 1 3 view)
  use test.eq "check 5" _v6 _v7
  let _v8 = #[51,52,32]
  let _v9 = (text.rest 4 view)
  use test.eq "check 6" _v8 _v9
  let _v10 = #[49,50,32,51,52]
  let _v11 = (text.trimmed view)
  use test.eq "check 7" _v10 _v11
  let _v12 = #[2,1,2,4,2]
  let _v13 = #[parts.length,parts[0].start,parts[0].count,parts[1].start,parts[1].count]
  use test.eq "check 8" _v12 _v13
  let _v14 = #[3,0,1,2,1,4,0]
  let _v15 = #[lines.length,lines[0].start,lines[0].count,lines[1].start,lines[1].count,lines[2].start,lines[2].count]
  use test.eq "check 9" _v14 _v15
  let _v16 = #[12]
  let _v17 = #[Maybe.unwrap_or 99 (text.count prefix)]
  use test.eq "check 10" _v16 _v17
  let _v18 = 0.0
  let _v19 = #[(-125.0)]
  let _v20 = #[Maybe.unwrap_or 0.0 parsed]
  use test.near_array "check 11" _v18 _v19 _v20
  return ()
