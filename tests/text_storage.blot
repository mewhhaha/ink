import * as check from "./check"
import * as text from "ink/text"

entry const test_readonly_ranges = func () => return do:
  let source = #[0,32,49,50,32,51,52,32,0]
  let view = source.view 1 8
  let left = #[49,50]
  let right = #[51,52]
  let prefix = source.view 2 4
  let parts = text.words view
  let lines_source = #[65,10,66,10]
  let lines = text.lines (lines_source.view 0 lines_source.length)
  let numeric = #[0,45,49,46,50,53,101,50,0]
  let parsed = text.number (numeric.view 1 8)
  return check.report #[
    check.holds (text.same left prefix),
    check.holds (text.starts left prefix),
    check.holds (text.before prefix right),
    check.words #[1] #[Maybe.unwrap_or 99 (text.find 50 prefix)],
    check.words #[49,50,32] (text.part 1 3 view),
    check.words #[51,52,32] (text.rest 4 view),
    check.words #[49,50,32,51,52] (text.trimmed view),
    check.words #[2,1,2,4,2] #[parts.length,parts[0].start,parts[0].count,parts[1].start,parts[1].count],
    check.words #[3,0,1,2,1,4,0] #[lines.length,lines[0].start,lines[0].count,lines[1].start,lines[1].count,lines[2].start,lines[2].count],
    check.words #[12] #[Maybe.unwrap_or 99 (text.count prefix)],
    check.near 0.0 #[(-125.0)] #[Maybe.unwrap_or 0.0 parsed],
  ]
