import * as check from "./check"
import * as array from "std/array"
import * as lookahead from "ink/navigation/lookahead"
import * as locomotion from "ink/navigation/locomotion"
import * as transform from "ink/transform"
import {Vec3} from "std/vector"
func probe_forecast points -> end -> (distance: F32) -> (remaining: F32): lookahead.Forecast => $lookahead.Forecast {end, pose: transform.identity, motion: ($locomotion.Motion {yaw: 0.0, speed: 0.0, phase: 0.0}), points, elapsed: 0.0, distance, remaining}
func selection_laws (): #[U32] =>
  let points: #[Vec3] = #[]
  let a = probe_forecast (&points[0..0]) $lookahead.Arrived 2.0 0.0
  let b = probe_forecast (&points[0..0]) $lookahead.Arrived 1.0 0.0
  let c = probe_forecast (&points[0..0]) $lookahead.Budget 2.0 5.0
  let d = probe_forecast (&points[0..0]) $lookahead.Budget 2.0 2.0
  let e = probe_forecast (&points[0..0]) $lookahead.Budget 1.0 2.0
  return #[Maybe.unwrap_or 99 (lookahead.choose #[]), Maybe.unwrap_or 99 (lookahead.choose #[$Nothing]),
    Maybe.unwrap_or 99 (lookahead.choose #[$Nothing, $Some a]),
    Maybe.unwrap_or 99 (lookahead.choose #[$Some c, $Some a]),
    Maybe.unwrap_or 99 (lookahead.choose #[$Some a, $Some b]),
    Maybe.unwrap_or 99 (lookahead.choose #[$Some c, $Some d]),
    Maybe.unwrap_or 99 (lookahead.choose #[$Some d, $Some e]),
    Maybe.unwrap_or 99 (lookahead.choose #[$Some a, $Some a]),
    Maybe.unwrap_or 99 (lookahead.choose #[$Some a,$Some a,$Some a,$Some a,$Some a,$Some a,$Some a,$Some a,$Some a])]

entry func test_selection_laws () =>
  let actual = selection_laws ()
  let expected = #[99,99,1,1,1,1,1,0,99]
  return check.report (array.generate expected.length (func index => return
    check.words #[expected[index]] #[actual[index]]))
