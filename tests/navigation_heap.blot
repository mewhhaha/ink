import * as test from "std/test"
import * as heap from "ink/navigation/heap"

@[test.suite]
test "heap orders by key then tie then id":
  let keys: #[F32] = #[]
  let ties: #[F32] = #[]
  let ids: #[U32] = #[]
  let h = $heap.Heap { keys, ties, ids }
  h := heap.push h 3.0 0.0 7
  h := heap.push h 1.0 0.0 5
  h := heap.push h 1.0 2.0 9
  h := heap.push h 1.0 2.0 4
  h := heap.push h 2.0 0.0 1
  let out: #[U32] = #[]
  for 0 .. 5:
    @storage.push out (heap.top h)
    h := heap.pop h
  use test.eq "check 1" #[4, 9, 5, 1, 7] out
  use test.holds "check 2" (h.ids.length == 0)
  return ()
