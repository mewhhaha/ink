import * as check from "./check"
import * as heap from "ink/navigation/heap"

entry func test_heap_orders_by_key_then_tie_then_id () =>
  let keys: #[~F32] = #[]
  let ties: #[~F32] = #[]
  let ids: #[~U32] = #[]
  let h = $heap.Heap { keys, ties, ids }
  h := heap.push h 3.0 0.0 7
  h := heap.push h 1.0 0.0 5
  h := heap.push h 1.0 2.0 9
  h := heap.push h 1.0 2.0 4
  h := heap.push h 2.0 0.0 1
  let out: #[~U32] = #[]
  for 0 .. 5:
    @storage.push out (heap.top h)
    h := heap.pop h
  return check.report #[check.words #[4, 9, 5, 1, 7] out, check.holds (h.ids.length == 0)]
