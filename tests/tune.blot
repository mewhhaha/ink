import * as check from "./check"
import * as ecs from "ink/ecs"
import * as events from "ink/events"
import * as tune from "ink/tune"

const speed: (U32, F32, F32, F32) = (7, 3.0, 1.0, 5.0)
const engine = ecs.build (ecs.insert_resource tune.untuned (ecs.new ()))

entry const test_tunables_keep_last_setting_and_read_within_range = fn () => do:
  let (world, _) = ecs.create engine (fn () => ())
  let (_, result) = ecs.run engine world (fn () => do:
    use tune.receive (#events.Tune { index: 7, value: 2.0 })
    use tune.receive (#events.Tune { index: 8, value: 9.0 })
    use tune.receive (#events.Tune { index: 7, value: 8.0 })
    use tuned <- ecs.get #tune.Tuned
    use read <- tune.value speed
    use restored <- tune.decode (tune.encode tuned)
    return check.report #[
      check.equal #[3.0, 5.0, 5.0] #[tune.read tune.untuned speed, read, tune.read restored speed],
      check.equal #[7.0, 8.0, 8.0, 9.0] (tune.encode restored),
    ])
  return result
