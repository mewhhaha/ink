import * as check from "./check"
import * as events from "ink/events"
import * as tune from "ink/tune"

const speed: (U32, F32, F32, F32) = (7, 3.0, 1.0, 5.0)
entry const test_tunables_keep_last_setting_and_read_within_range = func () => return do:
  let defaults = tune.empty ()
  let tuned = tune.empty ()
  let restored = tune.empty ()
  tune.receive tuned ($events.Tune { index: 7, value: 2.0 })
  tune.receive tuned ($events.Tune { index: 8, value: 9.0 })
  tune.receive tuned ($events.Tune { index: 7, value: 8.0 })
  let read = tune.value tuned speed
  tune.decode (tune.encode tuned) restored
  return check.report #[
    check.equal #[3.0, 5.0, 5.0] #[tune.read defaults speed, read, tune.read restored speed],
    check.equal #[7.0, 8.0, 8.0, 9.0] (tune.encode restored),
  ]

// Saved settings with one id twice do not restore, wherever the two lie.
entry const decode_ids = func (ids: Array F32) : U32 => return do:
  let settings = tune.empty ()
  tune.decode #[lane | id <- ids, lane <- #[id, 0.5]] settings
  return settings.length
