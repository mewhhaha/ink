import * as physics from "ink/physics"
import * as prepared from "ink/physics/prepared"
import * as scene from "ink/physics/scene"
import * as shapes from "ink/physics/shapes"
import * as math from "ink/math"

// Fixture lifetimes enclose the complete sequence of ticks. Only a final
// numeric packet/scalar leaves the known consumer, never owner-bearing state.
func with_step (sources: #[scene.Source]) -> (contacts: #[physics.CachedContact]) -> consume =>
  let geometry = shapes.empty ()
  let bodies = scene.empty_bodies ()
  let rows: #[scene.SourceRow] = #[]
  let first: #[physics.CachedContact] = #[]
  let second: #[physics.CachedContact] = #[]
  let results: #[physics.Result] = #[]
  let access = physics.load_sources_into sources ($physics.StepAccess {sources: rows, bodies, geometry,
    cache: $physics.CacheAccess {first_active: true, first, second}, results})
  access.cache := physics.seed_cache_into (&contacts[0..contacts.length]) access.cache
  return consume (own access)

func with_prepared (key: prepared.Key) -> (sources: #[scene.Source]) -> consume =>
  let geometry = shapes.empty ()
  let bodies = scene.empty_bodies ()
  let proxies: #[scene.ProxyRow] = #[]
  let bounds: #[F32] = #[]
  let order: #[U32] = #[]
  let leaves: #[U32] = #[]
  let slots: #[U32] = #[]
  let rows: #[scene.SourceRow] = #[]
  let ids: #[U32] = #[]
  let by_id: #[U32] = #[]
  let empty = scene.access geometry proxies bounds order leaves slots
  let access = prepared.prepare_into key sources ($prepared.Access {state: prepared.initial, sources: rows, bodies,
    scene: empty, ids, by_id})
  return consume (own access)
