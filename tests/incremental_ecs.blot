import * as lanes from "ink/lanes"
import * as array from "std/array"
import * as changes from "ink/changes"
import * as check from "./check"
import * as messages from "ink/messages"
import * as journal from "ink/journal"
import * as relations from "ink/relations"
import * as recipe from "ink/ecs/recipe"
import * as map from "ink/map"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as commands from "ink/ecs/commands"
import * as persist from "ink/persist"

const copy_words = func (values: &[U32]) : Array U32 => return array.generate values.length (func i => return values[i])

entry const test_broadcast_readers_and_overflow = func () => return do:
  let first: messages.Messages U32 = messages.empty ()
  let first_meta = messages.metadata 7 3
  let start = messages.cursor first_meta
  messages.write_many #[10, 20] first first_meta
  let a_rows: ResizeArray U32 = #[]
  let $messages.Items { values: a, cursor: fast } = messages.read start first first_meta a_rows else:
    return check.report #[check.holds false]
  let second: messages.Messages U32 = @storage.copy first
  let second_meta = @storage.copy first_meta
  messages.write_many #[30, 40] second second_meta
  let b_rows: ResizeArray U32 = #[]
  let $messages.Items { values: b } = messages.read fast second second_meta b_rows else:
    return check.report #[check.holds false]
  let scratch: ResizeArray U32 = #[]
  let lagged = case messages.read start second second_meta scratch of
    $messages.Reset _ => true
    _ => false
  let restarted_log: messages.Messages U32 = @storage.copy second
  let restarted_meta = @storage.copy second_meta
  messages.restart 8 restarted_log restarted_meta
  let restarted = case messages.read fast restarted_log restarted_meta scratch of
    $messages.Reset _ => true
    _ => false
  let old_rows: ResizeArray U32 = #[]
  let $messages.Items { values: old } = messages.read start first first_meta old_rows else:
    return check.report #[check.holds false]
  messages.write_many #[1, 2, 3, 4, 5, 6, 7] second second_meta
  let retained_rows: ResizeArray U32 = #[]
  let $messages.Items { values: retained } = messages.read (messages.beginning second_meta) second second_meta retained_rows else:
    return check.report #[check.holds false]
  let zero: messages.Messages U32 = messages.empty ()
  let zero_meta = messages.metadata 2 0
  messages.write 1 zero zero_meta
  return check.report #[check.words #[10, 20] (copy_words a), check.words #[30, 40] (copy_words b),
    check.words (copy_words a) (copy_words old), check.words #[5, 6, 7] (copy_words retained),
    check.holds (lagged and restarted and zero_meta[2] == 1 and zero_meta[3] == 1)]

entry const test_journal_last_operation_wins_and_replacement_resets = func () => return do:
  let log = journal.empty ()
  let meta = journal.metadata 1 20
  let start = journal.cursor meta
  journal.record_many #[$journal.Added 0xFFFFFFFF, $journal.Removed 4, $journal.Added 4, $journal.Updated 7, $journal.Removed 7] log meta
  let scratch: ResizeArray journal.Change = #[]
  let updated: ResizeArray U32 = #[]
  let removed: ResizeArray U32 = #[]
  let $journal.Delta {changes} = journal.read_into start log meta scratch updated removed else:
    return check.report #[check.holds false]
  let updated_copy = copy_words changes.updated
  let removed_copy = copy_words changes.removed
  journal.record $journal.Replaced log meta
  let reset = case journal.read_into start log meta scratch updated removed of
    $journal.Reset _ => true
    _ => false
  return check.report #[check.words #[4, 0xFFFFFFFF] updated_copy, check.words #[7] removed_copy, check.holds reset]

entry const test_relationship_retarget_unlink_and_cycle_policy = func () => return do:
  let old: relations.Relations [U32, U32] = relations.empty ()
  let old_slots = relations.buckets ()
  relations.link map.u32 2 1 old old_slots
  relations.link map.u32 0xFFFFFFFF 1 old old_slots
  let moved: relations.Relations [U32, U32] = relations.empty ()
  let moved_slots = relations.buckets ()
  relations.copy_into map.u32 identity identity moved moved_slots old
  relations.link map.u32 2 3 moved moved_slots
  let cleared: relations.Relations [U32, U32] = relations.empty ()
  let cleared_slots = relations.buckets ()
  relations.copy_into map.u32 identity identity cleared cleared_slots moved
  relations.remove_target map.u32 map.u32.equal 1 cleared cleared_slots
  let chain: relations.Relations [U32, U32] = relations.empty ()
  let chain_slots = relations.buckets ()
  relations.link map.u32 1 2 chain chain_slots
  let cycle = relations.link_acyclic map.u32 2 1 chain chain_slots
  let linked = relations.link_acyclic map.u32 3 1 chain chain_slots
  return check.report #[check.holds ((relations.sources map.u32.equal 1 old).length == 2),
    check.words #[0xFFFFFFFF] (relations.sources map.u32.equal 1 moved),
    check.holds (relations.fold_sources map.u32.equal (func count -> source => return count + 1) 0 1 old == 2),
    check.holds (Maybe.unwrap_or 0 (relations.target map.u32 2 cleared cleared_slots) == 3),
    check.holds (Bool.not cycle), check.holds linked]

entry const test_recipe_dependency_order_and_errors = func () => return do:
  let keys: ResizeArray U32 = #[]
  let $recipe.Ok plan = recipe.plan #[$recipe.Requirement {key: 5, requires: recipe.span 0 1}, $recipe.Requirement {key: 3, requires: recipe.span 1 1}, $recipe.Requirement {key: 1, requires: recipe.span 2 0}] #[3, 1] #[5] keys else:
    return check.report #[check.holds false]
  let failed_keys: ResizeArray U32 = #[]
  let cycle = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 1}, $recipe.Requirement {key: 2, requires: recipe.span 1 1}] #[2, 1] #[1] failed_keys of
    $recipe.Err $recipe.Cycle => true
    _ => false
  let missing = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 1}] #[9] #[1] failed_keys of
    $recipe.Err ($recipe.Missing 9) => true
    _ => false
  let duplicate = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 0}, $recipe.Requirement {key: 1, requires: recipe.span 0 0}] #[] #[1] failed_keys of
    $recipe.Err ($recipe.Duplicate 1) => true
    _ => false
  return check.report #[check.words #[1, 3, 5] (copy_words plan.keys), check.holds (cycle and missing and duplicate)]

type Position is data = $Position U32
type Velocity is data = $Velocity U32
type Disabled is data = $Disabled
type Columns = {alive: ecs.Entities, entity_meta: ecs.Metadata, positions: ecs.Pool Position, position_meta: ecs.Metadata,
  velocities: ecs.Pool Velocity, velocity_meta: ecs.Metadata, disabled: ecs.Pool Disabled, disabled_meta: ecs.Metadata,
  log: journal.Journal, log_meta: messages.Metadata}
// This known consumer keeps every separately declared fixture owner alive for
// the full callback. Its access record only aliases those owners.
const with_columns = func run => return do:
  let alive = ecs.entities ()
  let entity_meta = ecs.metadata 1
  let positions: ecs.Pool Position = ecs.pool ()
  let position_meta = ecs.metadata 1
  let velocities: ecs.Pool Velocity = ecs.pool ()
  let velocity_meta = ecs.metadata 1
  let disabled: ecs.Pool Disabled = ecs.pool ()
  let disabled_meta = ecs.metadata 1
  let log = journal.empty ()
  let log_meta = journal.metadata 1 128
  return run {alive, entity_meta, positions, position_meta, velocities, velocity_meta, disabled, disabled_meta, log, log_meta}
const position = func value => return case value of
  $Some ($Position n) => n
  _ => 0
const insert_position = func (columns: Columns) -> id -> value => return
  ecs.insert_tracked columns.alive columns.positions columns.position_meta columns.log columns.log_meta id value
const kill = func (columns: Columns) -> id => return do:
  if ecs.live columns.alive id:
    ecs.remove columns.positions columns.position_meta id
    ecs.remove columns.velocities columns.velocity_meta id
    ecs.remove columns.disabled columns.disabled_meta id
    ecs.despawn columns.alive columns.entity_meta id
    // This schema asks tracked consumers to rebuild after entity removal.
    journal.record $journal.Replaced columns.log columns.log_meta
const sources = func (columns: Columns) -> a -> b -> c => return #[
  query.source 1 columns.positions columns.position_meta a,
  query.source 2 columns.velocities columns.velocity_meta b,
  query.source 3 columns.disabled columns.disabled_meta c]
const filter: query.Filter = #[$query.With 1, $query.Without 3, $query.Optional 2, $query.All 3]
entry const test_query_cache_tracks_membership_not_payload_and_reads_optional_values = func () => return with_columns (func columns => return do:
  ecs.spawn_many columns.alive columns.entity_meta 70
  ecs.insert_selected columns.alive columns.positions columns.position_meta #[1, 31, 32, 69] (array.map (func n => return $Position n) #[1, 31, 32, 69])
  ecs.insert columns.alive columns.disabled columns.disabled_meta 32 $Disabled
  let membership_a: ResizeArray Bool = #[]
  let membership_b: ResizeArray Bool = #[]
  let membership_c: ResizeArray Bool = #[]
  let key: ResizeArray U32 = #[]
  let indices: ResizeArray U32 = #[]
  let meta: Array U32 = #[0]
  query.prepare columns.alive columns.entity_meta filter (sources columns membership_a membership_b membership_c) key indices meta
  let first_indices = @storage.freeze (@storage.copy indices)
  let first_builds = meta[0]
  let old: ecs.Pool Position = ecs.pool ()
  ecs.copy_into identity old columns.positions
  for id in #[1, 69]:
    ecs.write columns.positions columns.position_meta id ($Position (id + 100))
  ecs.insert columns.alive columns.velocities columns.velocity_meta 1 ($Velocity 5)
  let membership_a_1: ResizeArray Bool = #[]
  let membership_b_1: ResizeArray Bool = #[]
  let membership_c_1: ResizeArray Bool = #[]
  query.prepare columns.alive columns.entity_meta filter (sources columns membership_a_1 membership_b_1 membership_c_1) key indices meta
  let next_indices = @storage.freeze (@storage.copy indices)
  let next_builds = meta[0]
  let current: ecs.Pool Position = ecs.pool ()
  let optional: ecs.Pool Velocity = ecs.pool ()
  ecs.copy_into identity current columns.positions
  ecs.copy_into identity optional columns.velocities
  ecs.remove columns.positions columns.position_meta 31
  let membership_a_2: ResizeArray Bool = #[]
  let membership_b_2: ResizeArray Bool = #[]
  let membership_c_2: ResizeArray Bool = #[]
  query.prepare columns.alive columns.entity_meta filter (sources columns membership_a_2 membership_b_2 membership_c_2) key indices meta
  let changed_indices = @storage.freeze (@storage.copy indices)
  let changed_builds = meta[0]
  let other_key: ResizeArray U32 = #[]
  let other_indices: ResizeArray U32 = #[]
  let other_meta: Array U32 = #[0]
  let membership_a_3: ResizeArray Bool = #[]
  let membership_b_3: ResizeArray Bool = #[]
  let membership_c_3: ResizeArray Bool = #[]
  query.select columns.alive columns.entity_meta #[$query.With 2, $query.With 3, $query.Any 2] (sources columns membership_a_3 membership_b_3 membership_c_3) other_key other_indices other_meta
  let alternatives = @storage.freeze (@storage.copy other_indices)
  let membership_a_4: ResizeArray Bool = #[]
  let membership_b_4: ResizeArray Bool = #[]
  let membership_c_4: ResizeArray Bool = #[]
  query.select columns.alive columns.entity_meta #[$query.All 0] (sources columns membership_a_4 membership_b_4 membership_c_4) other_key other_indices other_meta
  let all_count = other_indices.length
  let membership_a_5: ResizeArray Bool = #[]
  let membership_b_5: ResizeArray Bool = #[]
  let membership_c_5: ResizeArray Bool = #[]
  query.select columns.alive columns.entity_meta #[$query.Any 0] (sources columns membership_a_5 membership_b_5 membership_c_5) other_key other_indices other_meta
  let none_count = other_indices.length
  kill columns 1
  let membership_a_6: ResizeArray Bool = #[]
  let membership_b_6: ResizeArray Bool = #[]
  let membership_c_6: ResizeArray Bool = #[]
  query.prepare columns.alive columns.entity_meta filter (sources columns membership_a_6 membership_b_6 membership_c_6) key indices meta
  return check.report #[check.words #[1, 31, 69] first_indices, check.words first_indices next_indices,
    check.holds (first_builds == next_builds and changed_builds == next_builds + 1),
    check.words #[1, 69] changed_indices, check.words #[69] (@storage.freeze (@storage.copy indices)),
    check.words #[1, 32] alternatives, check.holds (all_count == 70 and none_count == 0),
    check.holds (position (ecs.read old 1) == 1 and position (ecs.read current 1) == 101),
    check.holds (Maybe.is_some (ecs.read optional 1) and Bool.not (Maybe.is_some (ecs.read optional 69)))])
const delta_updated = func result => return case result of
  $journal.Delta {changes} => copy_words changes.updated
  _ => #[]
const is_reset = func result => return case result of
  $journal.Reset _ => true
  _ => false
// Apply a canonical coalesced component batch, then publish its final row
// changes into the separately owned journal. Nothing observes intermediate edits.
const apply_positions = func (columns: Columns) -> (edits: Array (commands.Edit Position)) => return do:
  let before: ecs.Pool Position = @storage.copy columns.positions
  commands.apply columns.alive columns.positions columns.position_meta edits
  let keys = changes.unique (array.map (func edit => return case edit of
    $commands.Put {entity} => entity
    $commands.Remove entity => entity) edits)
  for id in keys:
    if ecs.live columns.alive id:
      if ecs.contains columns.positions id:
        journal.record ($journal.Updated id) columns.log columns.log_meta
      else:
        if ecs.contains before id:
          journal.record ($journal.Removed id) columns.log columns.log_meta
entry const test_tracked_writes_batch_removals_and_snapshot_independence = func () => return with_columns (func columns => return do:
  ecs.spawn_many columns.alive columns.entity_meta 1100
  for id in #[1, 31, 32, 1024]:
    insert_position columns id ($Position id)
  let old: ecs.Pool Position = ecs.pool ()
  let previous: ecs.Pool Position = ecs.pool ()
  ecs.checkpoint identity old columns.positions
  ecs.checkpoint identity previous columns.positions
  let start = journal.cursor columns.log_meta
  apply_positions columns #[$commands.Put {entity: 31, value: $Position 3}, $commands.Remove 31,
    $commands.Put {entity: 31, value: $Position 9}, $commands.Remove 32,
    $commands.Put {entity: 512, value: $Position 8}, $commands.Put {entity: 2000, value: $Position 9}]
  let scratch: ResizeArray journal.Change = #[]
  let updated: ResizeArray U32 = #[]
  let removed: ResizeArray U32 = #[]
  let $journal.Delta {changes: delta, cursor: next} = journal.read_into start columns.log columns.log_meta scratch updated removed else:
    return check.report #[check.holds false]
  let delta_updated_copy = copy_words delta.updated
  let delta_removed_copy = copy_words delta.removed
  let again = (delta_updated (journal.read_into start columns.log columns.log_meta scratch updated removed)).length
  let fresh = (delta_updated (journal.read_into next columns.log columns.log_meta scratch updated removed)).length
  let current: ecs.Pool Position = ecs.pool ()
  ecs.copy_into identity current columns.positions
  let current_indices = ecs.indices columns.alive current
  for id in #[1024, 1, 1]:
    ecs.write_tracked columns.positions columns.position_meta columns.log columns.log_meta id ($Position 77)
  let sparse = delta_updated (journal.read_into next columns.log columns.log_meta scratch updated removed)
  let cursor = journal.cursor columns.log_meta
  ecs.replace_components columns.alive columns.positions columns.position_meta #[$Some ($Position 5)]
  journal.record $journal.Replaced columns.log columns.log_meta
  let replaced = is_reset (journal.read_into cursor columns.log columns.log_meta scratch updated removed)
  let cursor = journal.cursor columns.log_meta
  kill columns 0
  let despawned = is_reset (journal.read_into cursor columns.log columns.log_meta scratch updated removed)
  return check.report #[check.words #[31, 512] delta_updated_copy, check.words #[32] delta_removed_copy,
    check.holds (position (ecs.read old 31) == 31 and position (ecs.read previous 31) == 31 and position (ecs.read current 31) == 9),
    check.words #[1, 31, 512, 1024] current_indices,
    check.holds (again == 2), check.holds (fresh == 0),
    check.holds (query.same sparse #[1, 1024]), check.holds replaced, check.holds despawned])

const has = func (columns: Columns) -> id -> (key: U32) => return
  if key == 1 then ecs.contains columns.positions id else ecs.contains columns.velocities id
const install = func (columns: Columns) -> id -> (key: U32) => return do:
  if key == 1:
    return insert_position columns id ($Position 10)
  return ecs.insert columns.alive columns.velocities columns.velocity_meta id ($Velocity 20)
type Command is data = $Patch {start: U32, count: U32} | $Capture U32 | $Kill U32
const interpret = func (columns: Columns) -> (edits: Array (commands.Edit Position)) -> (seen: ResizeArray U32) -> (command: Command) => return case command of
  $Patch {start, count} => apply_positions columns (array.slice start count edits)
  $Capture id => @storage.push seen (position (ecs.read columns.positions id))
  $Kill id => kill columns id
entry const test_recipe_overrides_and_ordered_command_boundaries = func () => return with_columns (func columns => return do:
  let keys: ResizeArray U32 = #[]
  let $recipe.Ok plan = recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 1}, $recipe.Requirement {key: 2, requires: recipe.span 1 0}] #[2] #[1] keys else:
    return check.report #[check.holds false]
  let id = recipe.spawn columns.alive columns.entity_meta plan (func id => return insert_position columns id ($Position 99)) (has columns) (install columns)
  let speed = ecs.read columns.velocities id
  let before = ecs.read columns.positions id
  let edits = #[$commands.Put {entity: id, value: $Position 4}]
  let queue: commands.Commands Command = commands.empty ()
  commands.append #[$Capture id, $Patch {start: 0, count: 1}, $Capture id, $Kill id, $Capture id] queue
  let original: commands.Commands Command = @storage.copy queue
  let seen: ResizeArray U32 = #[]
  commands.flush queue (interpret columns edits seen)
  return check.report #[check.holds (position before == 99 and Maybe.is_some speed), check.words #[99, 4, 0] (@storage.freeze (@storage.copy seen)),
    check.holds (commands.count queue == 0 and commands.count original == 5)])

entry const test_mixed_batches_match_sequential_writes_across_pages = func () => return with_columns (func columns => return do:
  ecs.spawn_many columns.alive columns.entity_meta 1300
  let edits = array.generate 700 (func i => return do:
    let id = (i * 47 + 13) % 1400
    if i % 3 == 0:
      return $commands.Remove id
    return $commands.Put {entity: id, value: $Position i})
  let reference: ecs.Pool Position = ecs.pool ()
  let reference_meta = ecs.metadata 1
  commands.apply columns.alive columns.positions columns.position_meta edits
  for edit in edits:
    let id = case edit of
      $commands.Remove id => id
      $commands.Put {entity} => entity
    if ecs.live columns.alive id:
      case edit of
        $commands.Remove _ => ecs.remove reference reference_meta id
        $commands.Put {value} => ecs.insert columns.alive reference reference_meta id value
  let batched = ecs.rows columns.positions
  return check.report #[check.words (array.map position reference) (array.map position batched),
    check.words (array.map (func value => return if Maybe.is_some value then 1 else 0) reference) (array.map (func value => return if Maybe.is_some value then 1 else 0) batched)])

entry const test_relationship_inverse_matches_forward_after_repeated_edits = func () => return do:
  let edges: relations.Relations [U32, U32] = relations.empty ()
  let slots = relations.buckets ()
  let reference: Array (Maybe U32) = array.fill 97 $Nothing
  let checks: GrowArray check.Check = #[]
  for i in 0 .. 500:
    let source = (i * 41) % 97
    let target = (i * 17) % 13
    if i % 5 == 0:
      relations.unlink map.u32 source edges slots
      reference[source] := $Nothing
    else:
      relations.link map.u32 source target edges slots
      reference[source] := $Some target
    if i % 31 == 0:
      for target in 0 .. 13:
        let expected = #[source | source <- array.generate 97 identity, Maybe.unwrap_or 99 reference[source] == target]
        let found = relations.sources map.u32.equal target edges
        @storage.push checks (check.words expected (changes.unique found))
  return check.report (@storage.freeze checks)

entry const test_query_boolean_algebra_matches_scalar_membership = func () => return with_columns (func columns => return do:
  ecs.spawn_many columns.alive columns.entity_meta 257
  for i in 0 .. 257:
    if i % 2 == 0:
      ecs.insert columns.alive columns.positions columns.position_meta i ($Position i)
    if i % 3 == 0:
      ecs.insert columns.alive columns.velocities columns.velocity_meta i ($Velocity i)
    if i % 7 == 0:
      ecs.insert columns.alive columns.disabled columns.disabled_meta i $Disabled
    if i % 11 == 0:
      kill columns i
  let a: ResizeArray Bool = #[]
  let b: ResizeArray Bool = #[]
  let c: ResizeArray Bool = #[]
  let key: ResizeArray U32 = #[]
  let selected: ResizeArray U32 = #[]
  let meta: Array U32 = #[0]
  query.select columns.alive columns.entity_meta #[$query.With 1, $query.With 2, $query.Any 2, $query.Without 3, $query.All 2] (sources columns a b c) key selected meta
  let expected = #[i | i <- array.generate 257 identity, (i % 2 == 0 or i % 3 == 0) and i % 7 != 0 and i % 11 != 0]
  return check.report #[check.words expected (@storage.freeze (@storage.copy selected))])

entry const test_broadcast_batches_match_retained_sequence_for_every_reader = func () => return do:
  let log: messages.Messages U32 = messages.empty ()
  let meta = messages.metadata 42 65
  let checks: GrowArray check.Check = #[]
  let destination: ResizeArray U32 = #[]
  for batch in #[0, 1, 63, 2, 140, 0, 64, 66]:
    let start = meta[2]
    let old: messages.Messages U32 = @storage.copy log
    let old_meta = @storage.copy meta
    messages.write_many (array.generate batch (func i => return start + i)) log meta
    let oldest = meta[2] - min 65 meta[2]
    for sequence in 0 .. meta[2] + 1:
      let result = messages.read ($messages.Reader {epoch: 42, next: sequence}) log meta destination
      let valid = sequence >= oldest
      let correct = case result of
        $messages.Reset _ => Bool.not valid
        $messages.Items {values, cursor} => valid and query.same values (array.generate (meta[2] - sequence) (func i => return sequence + i)) and cursor.next == meta[2]
      @storage.push checks (check.holds correct)
    let $messages.Items {values} = messages.read (messages.beginning old_meta) old old_meta destination else:
      return check.report #[check.holds false]
    @storage.push checks (check.holds (values.length == min 65 start))
  return check.report (@storage.freeze checks)

entry const test_relationship_swap_removal_across_pages_preserves_old_snapshots = func () => return do:
  let initial: relations.Relations [U32, U32] = relations.empty ()
  let initial_slots = relations.buckets ()
  for i in 0 .. 320:
    relations.link map.u32 i 0 initial initial_slots
  let edited: relations.Relations [U32, U32] = relations.empty ()
  let edited_slots = relations.buckets ()
  relations.copy_into map.u32 identity identity edited edited_slots initial
  for id in #[0, 64, 127, 319]:
    relations.unlink map.u32 id edited edited_slots
  relations.link map.u32 65 1 edited edited_slots
  let expected = #[i | i <- array.generate 320 identity, i != 0 and i != 64 and i != 65 and i != 127 and i != 319]
  let cleared: relations.Relations [U32, U32] = relations.empty ()
  let cleared_slots = relations.buckets ()
  relations.copy_into map.u32 identity identity cleared cleared_slots edited
  relations.remove_target map.u32 map.u32.equal 0 cleared cleared_slots
  return check.report #[check.words expected (changes.unique (relations.sources map.u32.equal 0 edited)),
    check.words #[65] (relations.sources map.u32.equal 1 edited),
    check.holds ((relations.sources map.u32.equal 0 initial).length == 320 and map.count cleared_slots == 1),
    check.holds (Maybe.unwrap_or 9 (relations.target map.u32 65 cleared cleared_slots) == 1)]

entry const test_component_reader_reports_retention_gap_and_empty_commits_do_not_write = func () => return with_columns (func columns => return do:
  ecs.spawn_many columns.alive columns.entity_meta 160
  let cursor = journal.cursor columns.log_meta
  let revision = ecs.component_revision columns.position_meta
  apply_positions columns #[]
  let unchanged = ecs.component_revision columns.position_meta
  for i in 0 .. 160:
    insert_position columns i ($Position i)
  let scratch: ResizeArray journal.Change = #[]
  let updated: ResizeArray U32 = #[]
  let removed: ResizeArray U32 = #[]
  let result = is_reset (journal.read_into cursor columns.log columns.log_meta scratch updated removed)
  let current = journal.cursor columns.log_meta
  journal.restart 2 columns.log columns.log_meta
  let reset = is_reset (journal.read_into current columns.log columns.log_meta scratch updated removed)
  return check.report #[check.holds (revision == unchanged), check.holds result,
