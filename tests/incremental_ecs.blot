import * as lanes from "ink/lanes"
import * as array from "std/array"
import * as changes from "ink/changes"
import * as check from "./check"
import * as messages from "ink/messages"
import * as journal from "ink/journal"
import * as relations from "ink/relations"
import * as recipe from "ink/ecs/recipe"
import * as map from "ink/map"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as commands from "ink/ecs/commands"
import * as persist from "ink/persist"

func copy_words (values: &[U32]) : #[U32] => array.generate values.length (func i => values[i])
func read_message_words reader -> (log: messages.Messages U32) -> (meta: messages.Metadata): Maybe (#[U32], messages.Reader) =>
  let rows: #[~U32] = #[]
  return case messages.read reader log meta rows of
    $messages.Items { values, cursor } => $Some (copy_words values, cursor)
    _ => $Nothing
func is_message_reset reader -> log -> meta: Bool =>
  let scratch: #[~U32] = #[]
  return case messages.read reader log meta scratch of
    $messages.Reset _ => true
    _ => false

entry func test_broadcast_readers_and_overflow () =>
  let first: messages.Messages U32 = messages.empty ()
  let first_meta = messages.metadata 7 3
  let start = messages.cursor first_meta
  let (first, first_meta) = messages.write_many #[10, 20] first first_meta
  let $Some (a_words, fast) = read_message_words start first first_meta else:
    return check.report #[check.holds false]
  let second: messages.Messages U32 = copy first
  let second_meta = copy first_meta
  let (second, second_meta) = messages.write_many #[30, 40] second second_meta
  let $Some (b_words, _) = read_message_words fast second second_meta else:
    return check.report #[check.holds false]
  let lagged = is_message_reset start second second_meta
  let restarted_log: messages.Messages U32 = copy second
  let restarted_meta = copy second_meta
  let (restarted_log, restarted_meta) = messages.restart 8 restarted_log restarted_meta
  let restarted = is_message_reset fast restarted_log restarted_meta
  let $Some (old_words, _) = read_message_words start first first_meta else:
    return check.report #[check.holds false]
  let (second, second_meta) = messages.write_many #[1, 2, 3, 4, 5, 6, 7] second second_meta
  let $Some (retained_words, _) = read_message_words (messages.beginning second_meta) second second_meta else:
    return check.report #[check.holds false]
  let zero: messages.Messages U32 = messages.empty ()
  let zero_meta = messages.metadata 2 0
  let (zero, zero_meta) = messages.write 1 zero zero_meta
  return check.report #[check.words #[10, 20] a_words, check.words #[30, 40] b_words,
    check.words a_words old_words, check.words #[5, 6, 7] retained_words,
    check.holds (lagged and restarted and zero_meta[2] == 1 and zero_meta[3] == 1)]

func read_journal_words start -> (log: journal.Journal) -> (meta: messages.Metadata): Maybe (#[U32], #[U32]) =>
  let scratch: #[~journal.Change] = #[]
  let updated: #[~U32] = #[]
  let removed: #[~U32] = #[]
  return case journal.read_into start log meta scratch updated removed of
    $journal.Delta {changes} => $Some (copy_words changes.updated, copy_words changes.removed)
    _ => $Nothing

entry func test_journal_last_operation_wins_and_replacement_resets () =>
  let log = journal.empty ()
  let meta = journal.metadata 1 20
  let start = journal.cursor meta
  let (log, meta) = journal.record_many #[$journal.Added 0xFFFFFFFF, $journal.Removed 4, $journal.Added 4, $journal.Updated 7, $journal.Removed 7] log meta
  let $Some (updated_copy, removed_copy) = read_journal_words start log meta else:
    return check.report #[check.holds false]
  let (log, meta) = journal.record $journal.Replaced log meta
  let scratch: #[~journal.Change] = #[]
  let updated: #[~U32] = #[]
  let removed: #[~U32] = #[]
  let reset = case journal.read_into start log meta scratch updated removed of
    $journal.Reset _ => true
    _ => false
  return check.report #[check.words #[4, 0xFFFFFFFF] updated_copy, check.words #[7] removed_copy, check.holds reset]

entry func test_relationship_retarget_unlink_and_cycle_policy () =>
  let old: relations.Relations [U32, U32] = relations.empty ()
  old := relations.link map.u32 2 1 old
  old := relations.link map.u32 0xFFFFFFFF 1 old
  let moved: relations.Relations [U32, U32] = relations.copy_into map.u32 identity identity (relations.empty ()) old
  moved := relations.link map.u32 2 3 moved
  let cleared: relations.Relations [U32, U32] = relations.copy_into map.u32 identity identity (relations.empty ()) moved
  cleared := relations.remove_target map.u32 map.u32.equal 1 cleared
  let chain: relations.Relations [U32, U32] = relations.link map.u32 1 2 (relations.empty ())
  let (cycle, chain) = relations.link_acyclic map.u32 2 1 chain
  let (linked, chain) = relations.link_acyclic map.u32 3 1 chain
  return check.report #[check.holds ((relations.sources map.u32.equal 1 old).length == 2),
    check.words #[0xFFFFFFFF] (relations.sources map.u32.equal 1 moved),
    check.holds (relations.fold_sources map.u32.equal (func count -> source => count + 1) 0 1 old == 2),
    check.holds (Maybe.unwrap_or 0 (relations.target map.u32 2 cleared) == 3),
    check.holds (not cycle), check.holds linked]

entry func test_recipe_dependency_order_and_errors () =>
  let keys: #[~U32] = #[]
  let $recipe.Ok plan = recipe.plan #[$recipe.Requirement {key: 5, requires: recipe.span 0 1}, $recipe.Requirement {key: 3, requires: recipe.span 1 1}, $recipe.Requirement {key: 1, requires: recipe.span 2 0}] #[3, 1] #[5] keys else:
    return check.report #[check.holds false]
  let failed_keys: #[~U32] = #[]
  let cycle = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 1}, $recipe.Requirement {key: 2, requires: recipe.span 1 1}] #[2, 1] #[1] failed_keys of
    $recipe.Err $recipe.Cycle => true
    _ => false
  let missing = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 1}] #[9] #[1] failed_keys of
    $recipe.Err ($recipe.Missing 9) => true
    _ => false
  let duplicate = case recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 0}, $recipe.Requirement {key: 1, requires: recipe.span 0 0}] #[] #[1] failed_keys of
    $recipe.Err ($recipe.Duplicate 1) => true
    _ => false
  return check.report #[check.words #[1, 3, 5] (copy_words plan.keys), check.holds (cycle and missing and duplicate)]

type Position is data = $Position U32
type Velocity is data = $Velocity U32
type Disabled is data = $Disabled
type Columns = {alive: ecs.Entities, entity_meta: ecs.Metadata, positions: ecs.Pool Position, position_meta: ecs.Metadata,
  velocities: ecs.Pool Velocity, velocity_meta: ecs.Metadata, disabled: ecs.Pool Disabled, disabled_meta: ecs.Metadata,
  log: journal.Journal, log_meta: messages.Metadata}
// This known consumer keeps every separately declared fixture owner alive for
// the full callback. Its access record only aliases those owners.
func with_columns run =>
  let alive = ecs.entities ()
  let entity_meta = ecs.metadata 1
  let positions: ecs.Pool Position = ecs.pool ()
  let position_meta = ecs.metadata 1
  let velocities: ecs.Pool Velocity = ecs.pool ()
  let velocity_meta = ecs.metadata 1
  let disabled: ecs.Pool Disabled = ecs.pool ()
  let disabled_meta = ecs.metadata 1
  let log = journal.empty ()
  let log_meta = journal.metadata 1 128
  return run (own {alive, entity_meta, positions, position_meta, velocities, velocity_meta, disabled, disabled_meta, log, log_meta})
func position value => case value of
  $Some ($Position n) => n
  _ => 0
func insert_position (columns: own Columns) -> id -> value: Columns =>
  let (positions, position_meta, log, log_meta) = ecs.insert_tracked columns.alive columns.positions columns.position_meta columns.log columns.log_meta id value
  columns.positions := positions
  columns.position_meta := position_meta
  columns.log := log
  columns.log_meta := log_meta
  return columns
func kill (columns: own Columns) -> id: Columns =>
  if ecs.live columns.alive id:
    let (positions, position_meta) = ecs.remove columns.positions columns.position_meta id
    columns.positions := positions
    columns.position_meta := position_meta
    let (velocities, velocity_meta) = ecs.remove columns.velocities columns.velocity_meta id
    columns.velocities := velocities
    columns.velocity_meta := velocity_meta
    let (disabled, disabled_meta) = ecs.remove columns.disabled columns.disabled_meta id
    columns.disabled := disabled
    columns.disabled_meta := disabled_meta
    let (alive, entity_meta) = ecs.despawn columns.alive columns.entity_meta id
    columns.alive := alive
    columns.entity_meta := entity_meta
    // This schema asks tracked consumers to rebuild after entity removal.
    let (log, log_meta) = journal.record $journal.Replaced columns.log columns.log_meta
    columns.log := log
    columns.log_meta := log_meta
  return columns
func sources (columns: Columns) -> a -> b -> c => #[
  query.source 1 columns.positions columns.position_meta a,
  query.source 2 columns.velocities columns.velocity_meta b,
  query.source 3 columns.disabled columns.disabled_meta c]
func prepare_query (columns: Columns) -> (filter: query.Filter) -> (key: #[~U32]) -> (indices: #[~U32]) -> (meta: own #[U32]): #[U32] =>
  let membership_a: #[~Bool] = #[]
  let membership_b: #[~Bool] = #[]
  let membership_c: #[~Bool] = #[]
  return query.prepare columns.alive columns.entity_meta filter (sources columns membership_a membership_b membership_c) key indices meta
func select_query (columns: Columns) -> (filter: query.Filter) -> (key: #[~U32]) -> (indices: #[~U32]) -> (meta: own #[U32]): #[U32] =>
  let membership_a: #[~Bool] = #[]
  let membership_b: #[~Bool] = #[]
  let membership_c: #[~Bool] = #[]
  return query.select columns.alive columns.entity_meta filter (sources columns membership_a membership_b membership_c) key indices meta
const filter: query.Filter = #[$query.With 1, $query.Without 3, $query.Optional 2, $query.All 3]
entry func test_query_cache_tracks_membership_not_payload_and_reads_optional_values () => with_columns (func (own columns) =>
  let (_, alive, entity_meta) = ecs.spawn_many columns.alive columns.entity_meta 70
  columns.alive := alive
  columns.entity_meta := entity_meta
  let (positions, position_meta) = ecs.insert_selected columns.alive columns.positions columns.position_meta #[1, 31, 32, 69] (array.map (func n => $Position n) #[1, 31, 32, 69])
  columns.positions := positions
  columns.position_meta := position_meta
  let (disabled, disabled_meta) = ecs.insert columns.alive columns.disabled columns.disabled_meta 32 $Disabled
  columns.disabled := disabled
  columns.disabled_meta := disabled_meta
  let key: #[~U32] = #[]
  let indices: #[~U32] = #[]
  let meta: #[U32] = #[0]
  meta := prepare_query columns filter key indices meta
  let first_indices = seal (copy indices)
  let first_builds = meta[0]
  let old: ecs.Pool Position = ecs.copy_into identity (ecs.pool ()) columns.positions
  for id in #[1, 69]:
    columns.positions := ecs.write_row self id ($Position (id + 100))
    columns.position_meta := ecs.bump_payload self
  let (velocities, velocity_meta) = ecs.insert columns.alive columns.velocities columns.velocity_meta 1 ($Velocity 5)
  columns.velocities := velocities
  columns.velocity_meta := velocity_meta
  meta := prepare_query columns filter key indices meta
  let next_indices = seal (copy indices)
  let next_builds = meta[0]
  let current: ecs.Pool Position = ecs.copy_into identity (ecs.pool ()) columns.positions
  let optional: ecs.Pool Velocity = ecs.copy_into identity (ecs.pool ()) columns.velocities
  let (positions, position_meta) = ecs.remove columns.positions columns.position_meta 31
  columns.positions := positions
  columns.position_meta := position_meta
  meta := prepare_query columns filter key indices meta
  let changed_indices = seal (copy indices)
  let changed_builds = meta[0]
  let other_key: #[~U32] = #[]
  let other_indices: #[~U32] = #[]
  let other_meta: #[U32] = #[0]
  other_meta := select_query columns #[$query.With 2, $query.With 3, $query.Any 2] other_key other_indices other_meta
  let alternatives = seal (copy other_indices)
  other_meta := select_query columns #[$query.All 0] other_key other_indices other_meta
  let all_count = other_indices.length
  other_meta := select_query columns #[$query.Any 0] other_key other_indices other_meta
  let none_count = other_indices.length
  columns := kill columns 1
  meta := prepare_query columns filter key indices meta
  return check.report #[check.words #[1, 31, 69] first_indices, check.words first_indices next_indices,
    check.holds (first_builds == next_builds and changed_builds == next_builds + 1),
    check.words #[1, 69] changed_indices, check.words #[69] (seal (copy indices)),
    check.words #[1, 32] alternatives, check.holds (all_count == 70 and none_count == 0),
    check.holds (position (ecs.read old 1) == 1 and position (ecs.read current 1) == 101),
    check.holds (Maybe.is_some (ecs.read optional 1) and not (Maybe.is_some (ecs.read optional 69)))])
func delta_updated result => case result of
  $journal.Delta {changes} => copy_words changes.updated
  _ => #[]
func is_reset result => case result of
  $journal.Reset _ => true
  _ => false
func record_journal (columns: own Columns) -> (change: journal.Change): Columns =>
  let (log, log_meta) = journal.record change columns.log columns.log_meta
  columns.log := log
  columns.log_meta := log_meta
  return columns
func write_position (columns: own Columns) -> id -> value: Columns =>
  let (positions, position_meta, log, log_meta) = ecs.write_tracked columns.positions columns.position_meta columns.log columns.log_meta id value
  columns.positions := positions
  columns.position_meta := position_meta
  columns.log := log
  columns.log_meta := log_meta
  return columns
// Apply a canonical coalesced component batch, then publish its final row
// changes into the separately owned journal. Nothing observes intermediate edits.
func apply_positions (columns: own Columns) -> (edits: #[commands.Edit Position]): Columns =>
  let before: ecs.Pool Position = copy columns.positions
  let (positions, position_meta) = commands.apply columns.alive columns.positions columns.position_meta edits
  columns.positions := positions
  columns.position_meta := position_meta
  let keys = changes.unique (array.map (func edit => case edit of
    $commands.Put {entity} => entity
    $commands.Remove entity => entity) edits)
  for id in keys:
    if ecs.live columns.alive id:
      if ecs.contains columns.positions id:
        columns := record_journal self ($journal.Updated id)
      else:
        if ecs.contains before id:
          columns := record_journal self ($journal.Removed id)
  return columns
func read_journal_delta start -> (log: journal.Journal) -> (meta: messages.Metadata): Maybe (#[U32], #[U32], messages.Reader) =>
  let scratch: #[~journal.Change] = #[]
  let updated: #[~U32] = #[]
  let removed: #[~U32] = #[]
  return case journal.read_into start log meta scratch updated removed of
    $journal.Delta {changes, cursor} => $Some (copy_words changes.updated, copy_words changes.removed, cursor)
    _ => $Nothing
func journal_updated_words start -> (log: journal.Journal) -> (meta: messages.Metadata): #[U32] =>
  let scratch: #[~journal.Change] = #[]
  let updated: #[~U32] = #[]
  let removed: #[~U32] = #[]
  return delta_updated (journal.read_into start log meta scratch updated removed)
func journal_is_reset start -> (log: journal.Journal) -> (meta: messages.Metadata): Bool =>
  let scratch: #[~journal.Change] = #[]
  let updated: #[~U32] = #[]
  let removed: #[~U32] = #[]
  return is_reset (journal.read_into start log meta scratch updated removed)
entry func test_tracked_writes_batch_removals_and_snapshot_independence () => with_columns (func (own columns) =>
  let (_, alive, entity_meta) = ecs.spawn_many columns.alive columns.entity_meta 1100
  columns.alive := alive
  columns.entity_meta := entity_meta
  for id in #[1, 31, 32, 1024]:
    columns := insert_position self id ($Position id)
  let old: ecs.Pool Position = ecs.checkpoint identity (ecs.pool ()) columns.positions
  let previous: ecs.Pool Position = ecs.checkpoint identity (ecs.pool ()) columns.positions
  let start = journal.cursor columns.log_meta
  columns := apply_positions columns #[$commands.Put {entity: 31, value: $Position 3}, $commands.Remove 31,
    $commands.Put {entity: 31, value: $Position 9}, $commands.Remove 32,
    $commands.Put {entity: 512, value: $Position 8}, $commands.Put {entity: 2000, value: $Position 9}]
  let $Some (delta_updated_copy, delta_removed_copy, next) = read_journal_delta start columns.log columns.log_meta else:
    return check.report #[check.holds false]
  let again = (journal_updated_words start columns.log columns.log_meta).length
  let fresh = (journal_updated_words next columns.log columns.log_meta).length
  let current: ecs.Pool Position = ecs.copy_into identity (ecs.pool ()) columns.positions
  let current_indices = ecs.indices columns.alive current
  for id in #[1024, 1, 1]:
    columns := write_position self id ($Position 77)
  let sparse = journal_updated_words next columns.log columns.log_meta
  let cursor = journal.cursor columns.log_meta
  let (positions, position_meta) = ecs.replace_components columns.alive columns.positions columns.position_meta #[$Some ($Position 5)]
  columns.positions := positions
  columns.position_meta := position_meta
  let (log, log_meta) = journal.record $journal.Replaced columns.log columns.log_meta
  columns.log := log
  columns.log_meta := log_meta
  let replaced = journal_is_reset cursor columns.log columns.log_meta
  let cursor = journal.cursor columns.log_meta
  columns := kill columns 0
  let despawned = journal_is_reset cursor columns.log columns.log_meta
  return check.report #[check.words #[31, 512] delta_updated_copy, check.words #[32] delta_removed_copy,
    check.holds (position (ecs.read old 31) == 31 and position (ecs.read previous 31) == 31 and position (ecs.read current 31) == 9),
    check.words #[1, 31, 512, 1024] current_indices,
    check.holds (again == 2), check.holds (fresh == 0),
    check.holds (query.same sparse #[1, 1024]), check.holds replaced, check.holds despawned])

func spawn_column (columns: own Columns) : (U32, Columns) =>
  let id = columns.alive.length
  columns.alive := ecs.spawn_entity self
  columns.entity_meta := ecs.bump_membership self
  return (id, columns)
func has (columns: Columns) -> id -> (key: U32) => return
  if key == 1 then ecs.contains columns.positions id else ecs.contains columns.velocities id
func install (columns: own Columns) -> id -> (key: U32) : Columns =>
  if key == 1:
    let was = ecs.contains columns.positions id
    columns.positions := ecs.put_row columns.alive self id ($Position 10)
    columns.position_meta := ecs.bump_insert was self
    return columns
  let was = ecs.contains columns.velocities id
  columns.velocities := ecs.put_row columns.alive self id ($Velocity 20)
  columns.velocity_meta := ecs.bump_insert was self
  return columns
type Command is data = $Patch {start: U32, count: U32} | $Capture U32 | $Kill U32
func interpret (columns: own Columns) -> (edits: #[commands.Edit Position]) -> (seen: #[~U32]) -> (command: Command) : Columns =>
  if let $Patch {start, count} = command:
    let (positions, position_meta) = commands.apply columns.alive columns.positions columns.position_meta (array.slice start count edits)
    columns.positions := positions
    columns.position_meta := position_meta
    return columns
  if let $Capture id = command:
    @storage.push seen (position (ecs.read columns.positions id))
    return columns
  if let $Kill id = command:
    return kill columns id
  return columns
entry func test_recipe_overrides_and_ordered_command_boundaries () => with_columns (func (own columns) =>
  let keys: #[~U32] = #[]
  let $recipe.Ok plan = recipe.plan #[$recipe.Requirement {key: 1, requires: recipe.span 0 1}, $recipe.Requirement {key: 2, requires: recipe.span 1 0}] #[2] #[1] keys else:
    return check.report #[check.holds false]
  let (id, columns) = recipe.spawn_on columns plan spawn_column (func (cols: own Columns) -> id =>
    let was = ecs.contains cols.positions id
    cols.positions := ecs.put_row cols.alive self id ($Position 99)
    cols.position_meta := ecs.bump_insert was self
    return cols) has install
  let speed = ecs.read columns.velocities id
  let before = ecs.read columns.positions id
  let edits = #[$commands.Put {entity: id, value: $Position 4}]
  let queue: commands.Commands Command = commands.empty ()
  commands.append #[$Capture id, $Patch {start: 0, count: 1}, $Capture id, $Kill id, $Capture id] queue
  let original: commands.Commands Command = copy queue
  let seen: #[~U32] = #[]
  columns := commands.flush_on queue columns (func (cols: own Columns) -> cmd => interpret cols edits seen cmd)
  return check.report #[check.holds (position before == 99 and Maybe.is_some speed), check.words #[99, 4, 0] (seal (copy seen)),
    check.holds (commands.count queue == 0 and commands.count original == 5)])

entry func test_mixed_batches_match_sequential_writes_across_pages () => with_columns (func (own columns) =>
  let (_, alive, entity_meta) = ecs.spawn_many columns.alive columns.entity_meta 1300
  columns.alive := alive
  columns.entity_meta := entity_meta
  let edits = array.generate 700 (func i =>
    let id = (i * 47 + 13) % 1400
    if i % 3 == 0:
      return $commands.Remove id
    return $commands.Put {entity: id, value: $Position i})
  let reference: ecs.Pool Position = ecs.pool ()
  let reference_meta = ecs.metadata 1
  let (positions, position_meta) = commands.apply columns.alive columns.positions columns.position_meta edits
  columns.positions := positions
  columns.position_meta := position_meta
  for edit in edits:
    let id = case edit of
      $commands.Remove id => id
      $commands.Put {entity} => entity
    if ecs.live columns.alive id:
      let was = ecs.contains reference id
      if let $commands.Put {value} = edit:
        reference := ecs.put_row columns.alive self id value
        reference_meta := ecs.bump_insert was self
      else:
        reference := ecs.remove_row self id
        reference_meta := ecs.bump_remove was self
  let batched = ecs.rows columns.positions
  return check.report #[check.words (array.map position reference) (array.map position batched),
    check.words (array.map (func value => if Maybe.is_some value then 1 else 0) reference) (array.map (func value => if Maybe.is_some value then 1 else 0) batched)])

entry func test_relationship_inverse_matches_forward_after_repeated_edits () =>
  let edges: relations.Relations [U32, U32] = relations.empty ()
  let reference: #[Maybe U32] = array.fill 97 $Nothing
  let checks: #[+check.Check] = #[]
  for i in 0 .. 500:
    let source = (i * 41) % 97
    let target = (i * 17) % 13
    if i % 5 == 0:
      edges := relations.unlink map.u32 source edges
      reference[source] := $Nothing
    else:
      edges := relations.link map.u32 source target edges
      reference[source] := $Some target
    if i % 31 == 0:
      for target in 0 .. 13:
        let expected = #[source | source <- array.generate 97 identity, Maybe.unwrap_or 99 reference[source] == target]
        let found = relations.sources map.u32.equal target edges
        @storage.push checks (check.words expected (changes.unique found))
  return check.report (seal checks)

entry func test_query_boolean_algebra_matches_scalar_membership () => with_columns (func (own columns) =>
  let (_, alive, entity_meta) = ecs.spawn_many columns.alive columns.entity_meta 257
  columns.alive := alive
  columns.entity_meta := entity_meta
  for i in 0 .. 257:
    if i % 2 == 0:
      let was = ecs.contains columns.positions i
      columns.positions := ecs.put_row columns.alive self i ($Position i)
      columns.position_meta := ecs.bump_insert was self
    if i % 3 == 0:
      let was = ecs.contains columns.velocities i
      columns.velocities := ecs.put_row columns.alive self i ($Velocity i)
      columns.velocity_meta := ecs.bump_insert was self
    if i % 7 == 0:
      let was = ecs.contains columns.disabled i
      columns.disabled := ecs.put_row columns.alive self i $Disabled
      columns.disabled_meta := ecs.bump_insert was self
    if i % 11 == 0:
      columns := kill self i
  let a: #[~Bool] = #[]
  let b: #[~Bool] = #[]
  let c: #[~Bool] = #[]
  let key: #[~U32] = #[]
  let selected: #[~U32] = #[]
  let meta: #[U32] = #[0]
  meta := query.select columns.alive columns.entity_meta #[$query.With 1, $query.With 2, $query.Any 2, $query.Without 3, $query.All 2] (sources columns a b c) key selected meta
  let expected = #[i | i <- array.generate 257 identity, (i % 2 == 0 or i % 3 == 0) and i % 7 != 0 and i % 11 != 0]
  return check.report #[check.words expected (seal (copy selected))])

type BroadcastState = { log: messages.Messages U32, meta: messages.Metadata }
func check_broadcast_sequence (l: messages.Messages U32) -> (m: messages.Metadata) -> (sequence: U32) -> (oldest: U32): Bool =>
  let destination: #[~U32] = #[]
  let result = messages.read ($messages.Reader {epoch: 42, next: sequence}) l m destination
  let valid = sequence >= oldest
  return case result of
    $messages.Reset _ => not valid
    $messages.Items {values, cursor} => valid and query.same values (array.generate (m[2] - sequence) (func i => sequence + i)) and cursor.next == m[2]
func check_old_retained (old: messages.Messages U32) -> (old_meta: messages.Metadata) -> (start: U32): Bool =>
  let destination: #[~U32] = #[]
  return case messages.read (messages.beginning old_meta) old old_meta destination of
    $messages.Items {values} => values.length == min 65 start
    _ => false
func step_broadcast_batch (s: own BroadcastState) -> (batch: U32) -> (checks: #[+check.Check]): BroadcastState =>
  let start = s.meta[2]
  let old: messages.Messages U32 = copy s.log
  let old_meta = copy s.meta
  let (l, m) = messages.write_many (array.generate batch (func i => start + i)) s.log s.meta
  let oldest = m[2] - min 65 m[2]
  for sequence in 0 .. m[2] + 1:
    @storage.push checks (check.holds (check_broadcast_sequence l m sequence oldest))
  @storage.push checks (check.holds (check_old_retained old old_meta start))
  return { log: l, meta: m }

entry func test_broadcast_batches_match_retained_sequence_for_every_reader () =>
  let log: messages.Messages U32 = messages.empty ()
  let meta = messages.metadata 42 65
  let checks: #[+check.Check] = #[]
  let state: BroadcastState = { log, meta }
  for batch in #[0, 1, 63, 2, 140, 0, 64, 66]:
    state := step_broadcast_batch self batch checks
  return check.report (seal checks)

entry func test_relationship_swap_removal_across_pages_preserves_old_snapshots () =>
  let initial: relations.Relations [U32, U32] = relations.empty ()
  for i in 0 .. 320:
    initial := relations.link map.u32 i 0 initial
  let edited: relations.Relations [U32, U32] = relations.copy_into map.u32 identity identity (relations.empty ()) initial
  for id in #[0, 64, 127, 319]:
    edited := relations.unlink map.u32 id edited
  edited := relations.link map.u32 65 1 edited
  let expected = #[i | i <- array.generate 320 identity, i != 0 and i != 64 and i != 65 and i != 127 and i != 319]
  let cleared: relations.Relations [U32, U32] = relations.copy_into map.u32 identity identity (relations.empty ()) edited
  cleared := relations.remove_target map.u32 map.u32.equal 0 cleared
  return check.report #[check.words expected (changes.unique (relations.sources map.u32.equal 0 edited)),
    check.words #[65] (relations.sources map.u32.equal 1 edited),
    check.holds ((relations.sources map.u32.equal 0 initial).length == 320 and map.count cleared == 1),
    check.holds (Maybe.unwrap_or 9 (relations.target map.u32 65 cleared) == 1)]

entry func test_component_reader_reports_retention_gap_and_empty_commits_do_not_write () => with_columns (func (own columns) =>
  let (_, alive, entity_meta) = ecs.spawn_many columns.alive columns.entity_meta 160
  columns.alive := alive
  columns.entity_meta := entity_meta
  let cursor = journal.cursor columns.log_meta
  let revision = ecs.component_revision columns.position_meta
  columns := apply_positions columns #[]
  let unchanged = ecs.component_revision columns.position_meta
  for i in 0 .. 160:
    columns := insert_position self i ($Position i)
  let result = journal_is_reset cursor columns.log columns.log_meta
  let current = journal.cursor columns.log_meta
  let (log, log_meta) = journal.restart 2 columns.log columns.log_meta
  columns.log := log
  columns.log_meta := log_meta
  let reset = journal_is_reset current columns.log columns.log_meta
  return check.report #[check.holds (revision == unchanged), check.holds result,
    check.holds (reset and (ecs.indices columns.alive columns.positions).length == 160)])
func encode_position value =>
  let $Position n = value
  return lanes.halves n
func decode_position values =>
  lanes.exact values 2
  return $Position (lanes.whole values 0)
const position_codec = $lanes.Codec {key: 900, version: 1, encode: encode_position, decode: decode_position, migrate: lanes.no_migration}
func encode_schema access -> sections -> payload =>
  persist.write_alive access.alive sections payload
  persist.write_snapshotted_component position_codec 2 access.alive access.current access.previous sections payload
  return ()
func decode_schema (own access) -> sections -> values -> outcomes =>
  let (alive, entity_meta) = persist.restore_alive sections values access.alive access.entity_meta outcomes
  access.alive := alive
  access.entity_meta := entity_meta
  let (current, current_meta, previous, previous_meta) = persist.restore_snapshotted_component position_codec 2 identity access.alive access.current access.current_meta access.previous access.previous_meta sections values outcomes
  access.current := current
  access.current_meta := current_meta
  access.previous := previous
  access.previous_meta := previous_meta
  return access
func encode_columns (columns: Columns) -> previous -> previous_meta -> sections -> payload -> saved =>
  let access = {alive: columns.alive, entity_meta: columns.entity_meta, current: columns.positions, current_meta: columns.position_meta, previous, previous_meta}
  return persist.encode_state 1 sections payload encode_schema access saved
entry func test_tracked_app_codec_restores_values_without_saving_journal_history () => with_columns (func (own columns) =>
  let previous: ecs.Pool Position = ecs.pool ()
  let previous_meta = ecs.metadata 1
  let (id, alive, entity_meta) = ecs.spawn columns.alive columns.entity_meta
  columns.alive := alive
  columns.entity_meta := entity_meta
  columns := insert_position columns id ($Position 0xFFFFFFFF)
  let sections: #[~persist.Section] = #[]
  let payload: #[~F32] = #[]
  let saved: #[~F32] = #[]
  let encoded_again: #[~F32] = #[]
  encode_columns columns previous previous_meta sections payload saved
  columns := insert_position columns id ($Position 0xFFFFFFFF)
  encode_columns columns previous previous_meta sections payload encoded_again
  // Decoded into a world of its own: the columns stay as they were.
  let target_previous: ecs.Pool Position = ecs.pool ()
  let target_current: ecs.Pool Position = ecs.pool ()
  let target = {alive: ecs.entities (), entity_meta: ecs.metadata 1, current: target_current, current_meta: ecs.metadata 1, previous: target_previous, previous_meta: ecs.metadata 1}
  let (_, target) = persist.decode_state 1 encoded_again decode_schema target
  let (log, log_meta) = journal.restart 2 columns.log columns.log_meta
  columns.log := log
  columns.log_meta := log_meta
  let after = ecs.read target.current 0
  return check.report #[check.equal (seal (copy saved)) (seal (copy encoded_again)), check.words #[0xFFFFFFFF] #[position after]])
