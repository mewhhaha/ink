import * as app from "ink/app"
import * as clock from "ink/clock"
import * as lanes from "ink/lanes"
import * as array from "std/array"
import * as changes from "ink/changes"
import * as check from "./check"
import * as messages from "ink/messages"
import * as journal from "ink/journal"
import * as relations from "ink/relations"
import * as recipe from "ink/ecs/recipe"
import * as map from "ink/map"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as commands from "ink/ecs/commands"

entry const test_broadcast_readers_and_overflow = fn () => do:
  let initial: messages.Messages U32 = messages.empty 7 3
  let start = messages.cursor initial
  let first = messages.write_many #[10, 20] initial
  let #messages.Items { values: a, cursor: fast } = messages.read start first else:
    return check.report #[check.holds #False]
  let second = messages.write_many #[30, 40] first
  let #messages.Items { values: b } = messages.read fast second else:
    return check.report #[check.holds #False]
  let lagged = case messages.read start second of
    #messages.Reset _ => #True
    _ => #False
  let restarted = case messages.read fast (messages.restart 8 second) of
    #messages.Reset _ => #True
    _ => #False
  let #messages.Items { values: old } = messages.read start first else:
    return check.report #[check.holds #False]
  let big = messages.write_many #[1, 2, 3, 4, 5, 6, 7] second
  let #messages.Items { values: retained } = messages.read (messages.beginning big) big else:
    return check.report #[check.holds #False]
  let zero: messages.Messages U32 = messages.write 1 (messages.empty 2 0)
  return check.report #[check.words #[10, 20] a, check.words #[30, 40] b,
    check.words a old, check.words #[5, 6, 7] retained,
    check.holds (lagged && restarted && zero.next == 1 && zero.oldest == 1)]

entry const test_journal_last_operation_wins_and_replacement_resets = fn () => do:
  let initial = journal.empty 1 20
  let start = journal.cursor initial
  let next = journal.record_many #[#journal.Added 0xFFFFFFFF, #journal.Removed 4, #journal.Added 4, #journal.Updated 7, #journal.Removed 7] initial
  let #journal.Delta { changes } = journal.read start next else:
    return check.report #[check.holds #False]
  let reset = case journal.read start (journal.record #journal.Replaced next) of
    #journal.Reset _ => #True
    _ => #False
  return check.report #[check.words #[4, 0xFFFFFFFF] changes.updated, check.words #[7] changes.removed, check.holds reset]

entry const test_relationship_retarget_unlink_and_cycle_policy = fn () => do:
  let old = relations.link map.u32 map.u32 0xFFFFFFFF 1 (relations.link map.u32 map.u32 2 1 (relations.empty ()))
  let moved = relations.link map.u32 map.u32 2 3 old
  let cleared = relations.remove_target map.u32 map.u32 1 moved
  let chain = relations.link map.u32 map.u32 1 2 (relations.empty ())
  return check.report #[check.holds ((relations.sources map.u32 1 old).length == 2),
    check.words #[0xFFFFFFFF] (relations.sources map.u32 1 moved),
    check.holds (relations.fold_sources map.u32 1 (fn count source => count + 1) 0 old == 2),
    check.holds (Maybe.unwrap_or 0 (relations.target map.u32 2 cleared) == 3),
    check.holds (Bool.not (Maybe.is_some (relations.link_acyclic map.u32 2 1 chain))),
    check.holds (Maybe.is_some (relations.link_acyclic map.u32 3 1 chain))]

entry const test_recipe_dependency_order_and_errors = fn () => do:
  let #recipe.Ok plan = recipe.plan #[#recipe.Requirement {key: 5, requires: #[3]}, #recipe.Requirement {key: 3, requires: #[1]}, #recipe.Requirement {key: 1, requires: #[]}] #[5] else:
    return check.report #[check.holds #False]
  let cycle = case recipe.plan #[#recipe.Requirement {key: 1, requires: #[2]}, #recipe.Requirement {key: 2, requires: #[1]}] #[1] of
    #recipe.Err #recipe.Cycle => #True
    _ => #False
  let missing = case recipe.plan #[#recipe.Requirement {key: 1, requires: #[9]}] #[1] of
    #recipe.Err (#recipe.Missing 9) => #True
    _ => #False
  let duplicate = case recipe.plan #[#recipe.Requirement {key: 1, requires: #[]}, #recipe.Requirement {key: 1, requires: #[]}] #[1] of
    #recipe.Err (#recipe.Duplicate 1) => #True
    _ => #False
  return check.report #[check.words #[1, 3, 5] plan.keys, check.holds (cycle && missing && duplicate)]

type Position is data = #Position U32
type Velocity is data = #Velocity U32
type Disabled is data = #Disabled
type Seen is data = #Seen (Array U32)
const simulation = do:
  let builder = ecs.new ()
  builder := ecs.register_tracked_snapshotted_component 1 128 (#Position 0) self
  builder := ecs.register_component (#Velocity 0) self
  builder := ecs.register_component #Disabled self
  builder := ecs.insert_resource (#Seen #[]) self
  break ecs.build builder
const position = fn value => case value of
  #Some (#Position n) => n
  _ => 0
const sources = fn () => do:
  use a <- query.source 1 #Position
  use b <- query.source 2 #Velocity
  use c <- query.source 3 (fn () => #Disabled)
  return #[a, b, c]
const filter = #query.All #[#query.With 1, #query.Without 3, #query.Optional 2]
entry const test_query_cache_tracks_membership_not_payload_and_reads_optional_values = fn () => do:
  let (_, checks) = ecs.create simulation (fn () => do:
    use ecs.spawn_many 70
    use ecs.insert_selected #Position #[1, 31, 32, 69] (array.map (fn n => #Position n) #[1, 31, 32, 69])
    use ecs.at 32 (fn () => ecs.set #Disabled)
    use first_sources <- sources ()
    use first <- query.prepare 1 filter first_sources query.empty
    use old <- ecs.view #Position
    use ecs.update_selected #Position #[1, 69] (fn id value => #Position (id + 100))
    use ecs.at 1 (fn () => ecs.set (#Velocity 5))
    use next_sources <- sources ()
    use next <- query.prepare 1 filter next_sources first
    use current <- ecs.view #Position
    use optional <- ecs.view #Velocity
    use ecs.at 31 (fn () => ecs.remove #Position)
    use changed_sources <- sources ()
    use changed <- query.prepare 1 filter changed_sources next
    use alternatives <- query.select (#query.Any #[#query.With 2, #query.With 3]) changed_sources
    use all <- query.select (#query.All #[]) changed_sources
    use none <- query.select (#query.Any #[]) changed_sources
    use ecs.despawn 1
    use dead_sources <- sources ()
    use dead <- query.prepare 1 filter dead_sources changed
    return #[check.words #[1, 31, 69] first.indices, check.words first.indices next.indices,
      check.holds (first.builds == next.builds && changed.builds == next.builds + 1),
      check.words #[1, 69] changed.indices, check.words #[69] dead.indices,
      check.words #[1, 32] alternatives.indices, check.holds (all.indices.length == 70 && none.indices.length == 0),
      check.holds (position (ecs.read old 1) == 1 && position (ecs.read current 1) == 101),
      check.holds (Maybe.is_some (ecs.read optional 1) && Bool.not (Maybe.is_some (ecs.read optional 69)))])
  return check.report checks

const delta_updated = fn result => case result of
  #ecs.Delta { changes } => changes.updated
  _ => #[]
const is_reset = fn result => case result of
  #ecs.Reset _ => #True
  _ => #False
entry const test_tracked_writes_batch_removals_and_snapshot_independence = fn () => do:
  let (_, checks) = ecs.create simulation (fn () => do:
    use ecs.spawn_many 1100
    use ecs.insert_selected #Position #[1, 31, 32, 1024] (array.map (fn n => #Position n) #[1, 31, 32, 1024])
    use ecs.checkpoint simulation
    use old <- ecs.view #Position
    use start <- ecs.component_cursor #Position
    use commands.apply #Position #[#commands.Put {entity: 31, value: #Position 3}, #commands.Remove 31,
      #commands.Put {entity: 31, value: #Position 9}, #commands.Remove 32,
      #commands.Put {entity: 512, value: #Position 8}, #commands.Put {entity: 2000, value: #Position 9}]
    use result <- ecs.component_changes start #Position
    let #ecs.Delta { changes: delta, cursor: next } = result else:
      return #[check.holds #False]
    use again <- ecs.component_changes start #Position
    use fresh <- ecs.component_changes next #Position
    use current <- ecs.view #Position
    use previous <- ecs.previous_view #Position
    use ecs.update_selected #Position #[1024, 1, 1] (fn id value => #Position 77)
    use sparse <- ecs.component_changes next #Position
    use cursor <- ecs.component_cursor #Position
    use ecs.replace_components #Position #[#Some (#Position 5)]
    use replaced <- ecs.component_changes cursor #Position
    use cursor <- ecs.component_cursor #Position
    use ecs.despawn 0
    use despawned <- ecs.component_changes cursor #Position
    return #[check.words #[31, 512] delta.updated, check.words #[32] delta.removed,
      check.holds (position (ecs.read old 31) == 31 && position (ecs.read previous 31) == 31 && position (ecs.read current 31) == 9),
      check.words #[1, 31, 512, 1024] (ecs.indices current),
      check.holds ((delta_updated again).length == 2),
      check.holds ((delta_updated fresh).length == 0),
      check.holds (query.same (delta_updated sparse) #[1, 1024]),
      check.holds (is_reset replaced),
      check.holds (is_reset despawned)])
  return check.report checks

const has = fn (key: U32) => do:
  use id <- ecs.entity ()
  if key == 1:
    use value <- ecs.component_of #Position id
    return Maybe.is_some value
  use value <- ecs.component_of #Velocity id
  return Maybe.is_some value
const install = fn (key: U32) => do:
  if key == 1:
    return ecs.set (#Position 10)
  return ecs.set (#Velocity 20)
type Command is data = #Patch (Array (commands.Edit Position)) | #Capture U32 | #Kill U32
const interpret = fn (command: Command) => case command of
  #Patch edits => commands.apply #Position edits
  #Capture id => do:
    use value <- ecs.component_of #Position id
    use seen <- ecs.get #Seen
    let #Seen values = seen
    return ecs.set (#Seen (array.push (position value) values))
  #Kill id => ecs.despawn id
entry const test_recipe_overrides_and_ordered_command_boundaries = fn () => do:
  let #recipe.Ok plan = recipe.plan #[#recipe.Requirement {key: 1, requires: #[2]}, #recipe.Requirement {key: 2, requires: #[]}] #[1] else:
    return check.report #[check.holds #False]
  let (_, checks) = ecs.create simulation (fn () => do:
    use id <- recipe.spawn plan (fn () => ecs.set (#Position 99)) has install
    use speed <- ecs.component_of #Velocity id
    use before <- ecs.component_of #Position id
    let queue = commands.append #[#Capture id, #Patch #[#commands.Put {entity: id, value: #Position 4}], #Capture id, #Kill id, #Capture id] (commands.empty ())
    use cleared <- commands.flush queue interpret
    use seen <- ecs.get #Seen
    let #Seen values = seen
    return #[check.holds (position before == 99 && Maybe.is_some speed), check.words #[99, 4, 0] values,
      check.holds (commands.count cleared == 0 && commands.count queue == 5)])
  return check.report checks

entry const test_mixed_batches_match_sequential_writes_across_pages = fn () => do:
  let (initial, _) = ecs.create simulation (fn () => ecs.spawn_many 1300)
  let edits = array.generate 700 (fn i => do:
    let id = (i * 47 + 13) % 1400
    if i % 3 == 0:
      return #commands.Remove id
    return #commands.Put {entity: id, value: #Position i})
  let (_, batched) = ecs.run simulation initial (fn () => do:
    use commands.apply #Position edits
    return ecs.components #Position)
  let (_, reference) = ecs.run simulation initial (fn () => do:
    for edit in edits:
      let id = case edit of
        #commands.Remove id => id
        #commands.Put {entity} => entity
      use live <- ecs.alive id
      if live:
        use ecs.at id (fn () => case edit of
          #commands.Remove _ => ecs.remove #Position
          #commands.Put {value} => ecs.set value)
    return ecs.components #Position)
  return check.report #[check.words (array.map position reference) (array.map position batched),
    check.words (array.map (fn value => if Maybe.is_some value then 1 else 0) reference) (array.map (fn value => if Maybe.is_some value then 1 else 0) batched)]

entry const test_relationship_inverse_matches_forward_after_repeated_edits = fn () => do:
  let edges = relations.empty ()
  let reference: Array (Maybe U32) = array.fill 97 #Nothing
  let checks = #[]
  for i in 0 .. 500:
    let source = (i * 41) % 97
    let target = (i * 17) % 13
    if i % 5 == 0:
      edges := relations.unlink map.u32 map.u32 source edges
      reference[source] := #Nothing
    else:
      edges := relations.link map.u32 map.u32 source target edges
      reference[source] := #Some target
    if i % 31 == 0:
      for target in 0 .. 13:
        let expected = #[source | source <- array.generate 97 identity, Maybe.unwrap_or 99 reference[source] == target]
        let found = relations.sources map.u32 target edges
        checks := array.push (check.words expected (changes.unique found)) checks
  return check.report checks

entry const test_query_boolean_algebra_matches_scalar_membership = fn () => do:
  let (_, checks) = ecs.create simulation (fn () => do:
    use ecs.spawn_many 257
    for i in 0 .. 257:
      use ecs.at i (fn () => do:
        if i % 2 == 0:
          use ecs.set (#Position i)
        if i % 3 == 0:
          use ecs.set (#Velocity i)
        if i % 7 == 0:
          use ecs.set #Disabled)
      if i % 11 == 0:
        use ecs.despawn i
    use bound <- sources ()
    use selected <- query.select (#query.All #[#query.Any #[#query.With 1, #query.With 2], #query.Without 3]) bound
    let expected = #[i | i <- array.generate 257 identity, (i % 2 == 0 || i % 3 == 0) && i % 7 != 0 && i % 11 != 0]
    return #[check.words expected selected.indices])
  return check.report checks

entry const test_broadcast_batches_match_retained_sequence_for_every_reader = fn () => do:
  let log: messages.Messages U32 = messages.empty 42 65
  let checks = #[]
  for batch in #[0, 1, 63, 2, 140, 0, 64, 66]:
    let start = log.next
    let old = log
    log := messages.write_many (array.generate batch (fn i => start + i)) log
    let oldest = log.next - min 65 log.next
    for sequence in 0 .. log.next + 1:
      let result = messages.read (#messages.Reader {epoch: 42, next: sequence}) log
      let valid = sequence >= oldest
      let correct = case result of
        #messages.Reset _ => Bool.not valid
        #messages.Items {values, cursor} => valid && query.same values (array.generate (log.next - sequence) (fn i => sequence + i)) && cursor.next == log.next
      checks := array.push (check.holds correct) checks
    let #messages.Items {values} = messages.read (messages.beginning old) old else:
      return check.report #[check.holds #False]
    checks := array.push (check.holds (values.length == min 65 start)) checks
  return check.report checks

entry const test_relationship_swap_removal_across_pages_preserves_old_snapshots = fn () => do:
  let initial = relations.empty ()
  for i in 0 .. 320:
    initial := relations.link map.u32 map.u32 i 0 initial
  let edited = initial
  for id in #[0, 64, 127, 319]:
    edited := relations.unlink map.u32 map.u32 id edited
  edited := relations.link map.u32 map.u32 65 1 edited
  let expected = #[i | i <- array.generate 320 identity, i != 0 && i != 64 && i != 65 && i != 127 && i != 319]
  let cleared = relations.remove_target map.u32 map.u32 0 edited
  return check.report #[check.words expected (changes.unique (relations.sources map.u32 0 edited)),
    check.words #[65] (relations.sources map.u32 1 edited),
    check.holds ((relations.sources map.u32 0 initial).length == 320 && map.count cleared.forward == 1),
    check.holds (Maybe.unwrap_or 9 (relations.target map.u32 65 cleared) == 1)]

entry const test_component_reader_reports_retention_gap_and_empty_commits_do_not_write = fn () => do:
  let (_, checks) = ecs.create simulation (fn () => do:
    use ecs.spawn_many 160
    use cursor <- ecs.component_cursor #Position
    use revision <- ecs.component_revision #Position
    use commands.apply #Position #[]
    use unchanged <- ecs.component_revision #Position
    use ecs.insert_selected #Position (array.generate 160 identity) (array.generate 160 (fn i => #Position i))
    use result <- ecs.component_changes cursor #Position
    use current <- ecs.component_cursor #Position
    use ecs.restart_component_journal 2 #Position
    use reset <- ecs.component_changes current #Position
    use view <- ecs.view #Position
    return #[check.holds (revision == unchanged), check.holds (is_reset result),
      check.holds (is_reset reset && (ecs.indices view).length == 160)])
  return check.report checks
const encode_position = fn value => do:
  let #Position n = value
  return lanes.halves n
const decode_position = fn values => do:
  use lanes.exact values 2
  return #Position (lanes.whole values 0)
const position_codec = #lanes.Codec {key: 900, version: 1, encode: encode_position, decode: decode_position, migrate: lanes.no_migration}
const tracked_app = do:
  let builder = app.new #clock.Policy {step_seconds: 0.05, max_elapsed: 0.25, max_steps: 4}
  builder := app.register_tracked_snapshotted_component 10 32 position_codec (#Position 0) self
  break app.build builder
entry const test_tracked_app_codec_restores_values_without_saving_journal_history = fn () => do:
  let initial = app.create_world tracked_app ()
  let (world, _) = app.run tracked_app initial (fn () => ecs.spawn (fn () => ecs.set (#Position 0xFFFFFFFF)))
  let saved = app.encode tracked_app 1 world
  let (edited, _) = app.run tracked_app world (fn () => ecs.at 0 (fn () => ecs.set (#Position 0xFFFFFFFF)))
  let encoded_again = app.encode tracked_app 1 edited
  let restored = app.restore tracked_app 1 encoded_again
  let (_, after) = app.run tracked_app restored (fn () => ecs.component_of #Position 0)
  return check.report #[check.equal saved encoded_again, check.words #[0xFFFFFFFF] #[position after]]
