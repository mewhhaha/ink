  persist.write_alive access.alive sections payload
  persist.write_snapshotted_component position_codec 2 access.alive access.current access.previous sections payload
const decode_schema = func access -> sections -> values -> outcomes => return do:
  persist.restore_alive sections values access.alive access.entity_meta outcomes
  persist.restore_snapshotted_component position_codec 2 identity access.alive access.current access.current_meta access.previous access.previous_meta sections values outcomes
