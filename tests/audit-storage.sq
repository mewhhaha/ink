import * as reference from "./perf/profile_reference"
import * as array from "std/array"
import * as test from "std/test"
import * as pen_profile from "ink/pen/profile"
import * as audit from "./perf/audit_profile"
import * as observe from "./fixtures/profile_observe"
func flame_packet index => case index of
  0 => #[]
  1 => #[0.0]
  _ => #[1.0,7.0,8.0,1.0,65.0,0.0,9.0,0.0,8.0,4.0,2.0,66.0,128512.0]
const memory_packet = #[64.0,128.0,1.0,97.0,2.0,3.0,5.0,98.0,0.0]

@[test.suite]
test "profile two pass preserves validation and payload":
  for index in 0 .. 3:
    let packet = flame_packet index
    for length in 0 .. packet.length + 1:
      let prefix = array.slice 0 length packet
      let exp = observe.flame pen_profile.flame prefix
      let act = observe.flame audit.flame_two_pass prefix
      use test.near_array "prefix parity" 0.0 exp act
    for at in 0 .. packet.length:
      for invalid in #[(-1.0), 0.5, (1.0 / 0.0), (0.0 / 0.0), 55296.0, 1114112.0]:
        let changed = array.generate packet.length (func i => if i == at then invalid else packet[i])
        let exp = observe.flame pen_profile.flame changed
        let act = observe.flame audit.flame_two_pass changed
        use test.near_array "invalid lane parity" 0.0 exp act
  return ()

func compare_packets (packet: #[F32]): Unit ! { test.Test } =>
  let f_exp = observe.flame reference.flame packet
  let f_act = observe.flame pen_profile.flame packet
  use test.near_array "flame" 0.0 f_exp f_act
  let fp_exp = observe.flame reference.flame_prefix packet
  let fp_act = observe.flame pen_profile.flame_prefix packet
  use test.near_array "flame_prefix" 0.0 fp_exp fp_act
  let m_exp = observe.memory reference.memory packet
  let m_act = observe.memory pen_profile.memory packet
  use test.near_array "memory" 0.0 m_exp m_act
  let mp_exp = observe.memory reference.memory_prefix packet
  let mp_act = observe.memory pen_profile.memory_prefix packet
  use test.near_array "memory_prefix" 0.0 mp_exp mp_act
  return ()

@[test.suite]
test "profile complete and partial parsers preserve original contracts":
  for index in 0 .. 4:
    let packet = if index == 2 then memory_packet else flame_packet (if index == 3 then 2 else index)
    for count in 0 .. packet.length + 1:
      let slice = array.slice 0 count packet
      use compare_packets slice
    for at in 0 .. packet.length:
      for invalid in #[(-1.0), 0.5, (1.0 / 0.0), (0.0 / 0.0), 55296.0, 1114112.0, 16777216.0]:
        let mutated = array.generate packet.length (func i => if i == at then invalid else packet[i])
        use compare_packets mutated
  return ()
