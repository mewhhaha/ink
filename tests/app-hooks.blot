import * as app from "ink/app"
import * as array from "std/array"
import * as clock from "ink/clock"
import * as events from "ink/events"
import * as lanes from "ink/lanes"

const policy = $clock.Policy {step_seconds: 0.125, max_elapsed: 1.0, max_steps: 2}
// Static metadata belongs beside its known stage, outside runtime callback rows.
const names = {update: 50, render: 77, disabled: 101}
func note access -> (value: U32) => access.trace.push value
func quiet (code: U32): U32 => 0
func observed (send: U32 -> U32 ! {| e}) -> code -> (action: Unit -> result ! {| f}) =>
  use _ <- send code
  use result <- action ()
  use _ <- send (code + 1)
  return result
func reset access => access.trace.truncate 0
func start (send: U32 -> U32 ! {| e}) -> access => observed send 4 (func () => note access 0)
func route (send: U32 -> U32 ! {| e}) -> access -> (context: app.EventContext) => observed send 100 (func () =>
  note access 1
  context.event := case context.event of
    $events.KeyDown code => $events.KeyDown (code + 10)
    other => other
  return context)
func interface (send: U32 -> U32 ! {| e}) -> (own access) -> (context: app.EventContext) =>
  use _ <- send 206
  note access 2
  if let $events.KeyDown code = context.event:
    if code == 11:
      access.control := app.pause self true
    if code == 12:
      access.control := app.pause self false
  use _ <- send 207
  return access
func event (send: U32 -> U32 ! {| e}) -> access -> context => observed send 308 (func () => note access 3)
func update (send: U32 -> U32 ! {| e}) -> access -> seconds =>
  use observed send 410 (func () => note access 4)
  // A disabled known stage still observes its guard; it never runs its body.
  use observed send 414 (func () =>
    if false:
      note access 9
    return ())
  return ()
func render (send: U32 -> U32 ! {| e}) -> (own access) -> presentation =>
  use _ <- send 512
  note access 5
  access.frame[0] := access.frame[0] + 1.0
  use _ <- send 513
  return access
func settle (send: U32 -> U32 ! {| e}) -> access => observed send 602 (func () => note access 6)
func stages (send: U32 -> U32 ! {| e}) => return
  app.stages (app.lent reset) (app.lent (start send)) app.no_action app.no_action (route send)
    (interface send) (app.lent_with (event send)) (app.lent_with (update send))
    (render send) (app.lent (settle send))
func run (send: U32 -> U32 ! {| e}) -> input -> elapsed -> consume =>
  let trace: #[~U32] = #[]
  let frame = #[10.0]
  let time = #[clock.clock]
  let control = app.control ()
  let wall = app.wall ()
  let access = {trace, frame, control, clock: time, wall}
  let application = stages send
  use access <- app.start application access
  use access <- app.begin_frame application access
  use access <- app.advanced application access policy elapsed input 640.0 480.0
  use access <- app.render application access 0.0 640.0 480.0
  return consume access access.clock access.wall
entry func pause_events (): #[F32] => return
  run quiet #[$events.KeyDown 1, $events.KeyDown 2, $events.KeyDown 3] 0.5 (func access -> time -> wall => return
    array.concat #[access.frame[0], U32.to_f32 time[0].tick, time[0].remainder, wall[0].seconds, lanes.bit (app.paused access.control)]
      (array.map U32.to_f32 access.trace))
entry func paused_frame (): #[F32] => return
  run quiet #[$events.KeyDown 1] 0.5 (func access -> time -> wall => return
    array.concat #[access.frame[0], U32.to_f32 time[0].tick, time[0].remainder, wall[0].seconds]
      (array.map U32.to_f32 access.trace))
type Work is data = $Work {updates: U32, sum: U32}
func work_update (own access) -> seconds =>
  let work: Work = access.work[0]
  work.updates := work.updates + 1
  work.sum := work.sum + work.updates
  access.work[0] := work
  return access
entry func schedule_workload (count: U32): #[U32] =>
  let work = #[$Work {updates: 0, sum: 0}]
  let time = #[clock.clock]
  let control = app.control ()
  let wall = app.wall ()
  let access = {work, clock: time, control, wall}
  let application = app.stages app.no_action app.no_action app.no_action app.no_action app.route_event
    app.no_event app.no_event work_update app.no_render app.no_action
  access := app.start application access
  for 0 .. count:
    access := app.begin_frame application access
    access := app.advanced application access policy 0.125 #[] 640.0 480.0
  return #[access.clock[0].tick, access.work[0].updates, access.work[0].sum]
// The ordinary Foreign callback observes known stages directly. It needs no
// general effect provider, runtime function registry or captured world scope.
entry func observed_calls (host: U32 -> U32 ! {Foreign}) => return
  run host #[$events.KeyDown 3] 0.25 (func access -> time -> wall => return
    array.concat #[access.frame[0]] (array.map U32.to_f32 access.trace))
entry func named_plugins (): #[U32] => #[names.update, names.render, names.disabled]
