import * as app from "ink/app"
import * as array from "std/array"
import * as clock from "ink/clock"
import * as events from "ink/events"
import * as lanes from "ink/lanes"

const policy = $clock.Policy {step_seconds: 0.125, max_elapsed: 1.0, max_steps: 2}
// Static metadata belongs beside its known stage, outside runtime callback rows.
const names = {update: 50, render: 77, disabled: 101}
const note = func access -> (value: U32) => return access.trace.push value
const quiet = func (code: U32): U32 => return 0
const observed = func (send: U32 -> U32 ! {| e}) -> code -> (action: Unit -> result ! {| f}) => return do:
  use _ <- send code
  use result <- action ()
  use _ <- send (code + 1)
  return result
const reset = func access => return access.trace.truncate 0
const start = func (send: U32 -> U32 ! {| e}) -> access => return observed send 4 (func () => return note access 0)
const route = func (send: U32 -> U32 ! {| e}) -> access -> (context: app.EventContext) => return observed send 100 (func () => return do:
  note access 1
  context.event := case context.event of
    $events.KeyDown code => $events.KeyDown (code + 10)
    other => other
  return context)
const interface = func (send: U32 -> U32 ! {| e}) -> access -> (context: app.EventContext) => return observed send 206 (func () => return do:
  note access 2
  return case context.event of
    $events.KeyDown 11 => app.pause access.control true
    $events.KeyDown 12 => app.pause access.control false
    _ => ())
const event = func (send: U32 -> U32 ! {| e}) -> access -> context => return observed send 308 (func () => return note access 3)
const update = func (send: U32 -> U32 ! {| e}) -> access -> seconds => return do:
  observed send 410 (func () => return note access 4)
  // A disabled known stage still observes its guard; it never runs its body.
  observed send 414 (func () => return do:
    if false:
      note access 9)
const render = func (send: U32 -> U32 ! {| e}) -> access -> presentation => return observed send 512 (func () => return do:
  note access 5
  access.frame[0] := access.frame[0] + 1.0)
const settle = func (send: U32 -> U32 ! {| e}) -> access => return observed send 602 (func () => return note access 6)
const stages = func (send: U32 -> U32 ! {| e}) => return app.stages reset (start send) app.no_action app.no_action
  (route send) (interface send) (event send) (update send) (render send) (settle send)
const run = func (send: U32 -> U32 ! {| e}) -> input -> elapsed -> consume => return do:
  let trace: ResizeArray U32 = #[]
  let frame = #[10.0]
  let time = #[clock.clock]
  let control = app.control ()
  let wall = app.wall ()
  let access = {trace, frame, control}
  let application = stages send
  app.start application access control
  app.begin_frame application access
  app.advance application access policy time control wall elapsed input 640.0 480.0
  app.render application access control 0.0 640.0 480.0
  return consume access time wall
entry const pause_events = func (): Array F32 => return
  run quiet #[$events.KeyDown 1, $events.KeyDown 2, $events.KeyDown 3] 0.5 (func access -> time -> wall => return
    array.concat #[access.frame[0], U32.to_f32 time[0].tick, time[0].remainder, wall[0].seconds, lanes.bit (app.paused access.control)]
      (array.map U32.to_f32 access.trace))
entry const paused_frame = func (): Array F32 => return
  run quiet #[$events.KeyDown 1] 0.5 (func access -> time -> wall => return
    array.concat #[access.frame[0], U32.to_f32 time[0].tick, time[0].remainder, wall[0].seconds]
      (array.map U32.to_f32 access.trace))
type Work is data = $Work {updates: U32, sum: U32}
const work_update = func access -> seconds => return do:
  let work: Work = access.work[0]
  work.updates := work.updates + 1
  work.sum := work.sum + work.updates
  access.work[0] := work
entry const schedule_workload = func (count: U32): Array U32 => return do:
  let work = #[$Work {updates: 0, sum: 0}]
  let time = #[clock.clock]
  let control = app.control ()
  let wall = app.wall ()
  let access = {work}
  let application = app.stages app.no_action app.no_action app.no_action app.no_action
    app.route_event app.no_event app.no_event work_update app.no_render app.no_action
  app.start application access control
  for 0 .. count:
    app.begin_frame application access
    app.advance application access policy time control wall 0.125 #[] 640.0 480.0
  return #[time[0].tick, work[0].updates, work[0].sum]
// The ordinary Foreign callback observes known stages directly. It needs no
// general effect provider, runtime function registry or captured world scope.
entry const observed_calls = func (host: U32 -> U32 ! {Foreign}) => return
  run host #[$events.KeyDown 3] 0.25 (func access -> time -> wall => return
    array.concat #[access.frame[0]] (array.map U32.to_f32 access.trace))
entry const named_plugins = func (): Array U32 => return #[names.update, names.render, names.disabled]
