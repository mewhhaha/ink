import * as array from "std/array"
import * as check from "./check"
import * as derived from "ink/derived/keyed"
entry func rebuilding () : Array U32 => return do:
  let cold: derived.Cache [Array U32, U32] = $derived.Cold
  let (warm, value) = derived.resolve derived.same_u32 (func key => return key[0] * 2) #[4, 1] cold
  let (_, same) = derived.resolve derived.same_u32 (func key => return 99) #[4, 1] warm
  let (_, changed) = derived.resolve derived.same_u32 (func key => return key[0] * 3) #[4, 2] warm
  let (_, restored) = derived.resolve derived.same_u32 (func key => return key[0] * 2) #[4, 1] cold
  let rolled = derived.bump ($derived.Revision { epoch: 3, change: 0xFFFFFFFF })
  return #[value, same, changed, restored, rolled.epoch, rolled.change]

entry func test_complete_keys_and_restore () => return check.report #[check.words #[8, 8, 12, 8, 4, 0] (rebuilding ())]
