import * as array from "std/array"
import * as check from "./check"
import * as clock from "ink/clock"

const policy = $clock.Policy { step_seconds: 0.125, max_elapsed: 1.0, max_steps: 3 }
type World = {clock: #[clock.Clock], sums: #[F32]}
func checkpoint (world: own World) =>
  world.sums[1] := world.sums[0]
  return world
func update (world: own World) -> (seconds: F32) =>
  world.sums[0] := self + seconds
  return world

entry func advance (values: #[F32]) : #[F32] =>
  let world: World = {clock: #[$clock.Clock { tick: 10, remainder: values[0] }], sums: #[0.0, 0.0]}
  let (planned, after) = clock.advance policy world checkpoint update values[1]
  return #[U32.to_f32 after.clock[0].tick, after.clock[0].remainder, U32.to_f32 planned.steps,
    planned.alpha, planned.dropped, after.sums[0], after.sums[1]]

entry func roundtrip_tick (tick: U32) : U32 =>
  let saved = clock.encode_clock $clock.Clock { tick, remainder: 0.0625 }
  return (clock.decode_clock policy saved).tick

entry func decode (values: #[F32]) : F32 => (clock.decode_clock policy values).remainder
entry func zero_cadence () : Bool => clock.every 0 clock.clock
entry func invalid_policy (step: F32) : Unit => clock.validate $clock.Policy { step_seconds: step, max_elapsed: 1.0, max_steps: 3 }
entry func steps (count: U32) : #[U32] =>
  let chosen = $clock.Policy { step_seconds: 0.125, max_elapsed: U32.to_f32 count * 0.125, max_steps: count }
  let world: World = {clock: #[clock.clock], sums: #[0.0, 0.0]}
  let (planned, after) = clock.advance chosen world checkpoint update chosen.max_elapsed
  return #[after.clock[0].tick, F32.to_u32 (after.sums[0] * 8.0)]

entry func test_clock_policy_and_discarded_time () => check.report #[
  check.equal #[13.0,0.0625,3.0,0.5,0.125,0.375,0.25] (advance #[0.0625,0.5]),
  check.equal #[13.0,0.0,3.0,0.0,9.625,0.375,0.25] (advance #[0.0,10.0]),
  check.equal #[10.0,0.0625,0.0,0.5,0.0,0.0,0.0] (advance #[0.0625,0.0])]
entry func test_clock_full_width_ticks () => check.report (array.concat
  #[check.words #[tick] #[roundtrip_tick tick] | tick <- #[0,65535,65536,16777217,4294967295]]
  #[check.holds (not (zero_cadence ()))])

entry func trap_decode_0 () => #[decode (#[0.0,0.0,-1.0])]
entry func trap_decode_1 () => #[decode (#[0.0,0.0,0.125])]
entry func trap_decode_2 () => #[decode (#[65536.0,0.0,0.0])]
entry func trap_decode_3 () => #[decode (#[0.0,0.0,0.0 / 0.0])]
entry func trap_decode_4 () => #[decode (#[0.0,0.0])]
entry func trap_decode_5 () => #[decode (#[0.0,0.0,0.0,0.0])]

entry func trap_advance_0 () => advance (#[0.0,-1.0])
entry func trap_advance_1 () => advance (#[0.0,0.0 / 0.0])
entry func trap_advance_2 () => advance (#[0.0,1.0 / 0.0])

entry func trap_invalid_policy_0 () =>
  use invalid_policy (0.0)
  return #[0.0]
entry func trap_invalid_policy_1 () =>
  use invalid_policy (-1.0)
  return #[0.0]
entry func trap_invalid_policy_2 () =>
  use invalid_policy (0.0 / 0.0)
  return #[0.0]
entry func trap_invalid_policy_3 () =>
  use invalid_policy (1.0 / 0.0)
  return #[0.0]
