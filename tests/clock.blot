import * as array from "std/array"
import * as check from "./check"
import * as clock from "ink/clock"
import * as ecs from "ink/ecs"

type Sum is data = #Sum F32
const policy = #clock.Policy { step_seconds: 0.125, max_elapsed: 1.0, max_steps: 3 }
const simulation = do:
  let builder = ecs.new ()
  builder := ecs.insert_resource clock.clock self
  builder := ecs.insert_snapshotted_resource (#Sum 0.0) self
  break ecs.build builder
const update = fn (seconds: F32) => do:
  use sum <- ecs.get #Sum
  let #Sum total = sum
  return ecs.set (#Sum (total + seconds))

entry const advance = fn (values: Array F32) -> Array F32 => do:
  let (_, result) = ecs.create simulation (fn () => do:
    use ecs.set #clock.Clock { tick: 10, remainder: values[0] }
    use planned <- clock.advance policy (fn () => ecs.checkpoint simulation) update values[1]
    use current <- ecs.get #clock.Clock
    use sum <- ecs.get #Sum
    use previous <- ecs.previous #Sum
    let #Sum total = sum
    let #Sum before = previous
    return #[U32.to_f32 current.tick, current.remainder, U32.to_f32 planned.steps, planned.alpha, planned.dropped, total, before])
  return result

entry const roundtrip_tick = fn (tick: U32) -> U32 => do:
  let saved = clock.encode_clock #clock.Clock { tick, remainder: 0.0625 }
  return (clock.decode_clock policy saved).tick

entry const decode = fn (values: Array F32) -> F32 => (clock.decode_clock policy values).remainder
entry const zero_cadence = fn () -> Bool => clock.every 0 clock.clock
entry const invalid_policy = fn (step: F32) -> Unit => clock.validate #clock.Policy { step_seconds: step, max_elapsed: 1.0, max_steps: 3 }
entry const steps = fn (count: U32) -> Array U32 => do:
  let (_, result) = ecs.create simulation (fn () => do:
    let chosen = #clock.Policy { step_seconds: 0.125, max_elapsed: U32.to_f32 count * 0.125, max_steps: count }
    use clock.advance chosen (fn () => ecs.checkpoint simulation) update chosen.max_elapsed
    use current <- ecs.get #clock.Clock
    use sum <- ecs.get #Sum
    let #Sum total = sum
    return #[current.tick, F32.to_u32 (total * 8.0)])
  return result

entry const test_clock_policy_and_discarded_time = fn () => check.report #[
  check.equal #[13.0,0.0625,3.0,0.5,0.125,0.375,0.25] (advance #[0.0625,0.5]),
  check.equal #[13.0,0.0,3.0,0.0,9.625,0.375,0.25] (advance #[0.0,10.0]),
  check.equal #[10.0,0.0625,0.0,0.5,0.0,0.0,0.0] (advance #[0.0625,0.0])]
entry const test_clock_full_width_ticks = fn () => check.report (array.concat
  #[check.words #[tick] #[roundtrip_tick tick] | tick <- #[0,65535,65536,16777217,4294967295]]
  #[check.holds (Bool.not (zero_cadence ()))])

entry const trap_decode_0 = fn () => #[decode (#[0.0,0.0,-1.0])]
entry const trap_decode_1 = fn () => #[decode (#[0.0,0.0,0.125])]
entry const trap_decode_2 = fn () => #[decode (#[65536.0,0.0,0.0])]
entry const trap_decode_3 = fn () => #[decode (#[0.0,0.0,0.0 / 0.0])]
entry const trap_decode_4 = fn () => #[decode (#[0.0,0.0])]
entry const trap_decode_5 = fn () => #[decode (#[0.0,0.0,0.0,0.0])]

entry const trap_advance_0 = fn () => advance (#[0.0,-1.0])
entry const trap_advance_1 = fn () => advance (#[0.0,0.0 / 0.0])
entry const trap_advance_2 = fn () => advance (#[0.0,1.0 / 0.0])

entry const trap_invalid_policy_0 = fn () => do:
  use invalid_policy (0.0)
  return #[0.0]
entry const trap_invalid_policy_1 = fn () => do:
  use invalid_policy (-1.0)
  return #[0.0]
entry const trap_invalid_policy_2 = fn () => do:
  use invalid_policy (0.0 / 0.0)
  return #[0.0]
entry const trap_invalid_policy_3 = fn () => do:
  use invalid_policy (1.0 / 0.0)
  return #[0.0]
