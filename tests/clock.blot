import * as array from "std/array"
import * as check from "./check"
import * as clock from "ink/clock"

const policy = $clock.Policy { step_seconds: 0.125, max_elapsed: 1.0, max_steps: 3 }
const checkpoint = func (values: Array F32) => return do:
  values[1] := values[0]
const update = func (values: Array F32) -> (seconds: F32) => return do:
  values[0] := self + seconds

entry const advance = func (values: Array F32) : Array F32 => return do:
  let current = #[$clock.Clock { tick: 10, remainder: values[0] }]
  let sums = #[0.0, 0.0]
  let planned = clock.advance policy current sums checkpoint update values[1]
  return #[U32.to_f32 current[0].tick, current[0].remainder, U32.to_f32 planned.steps,
    planned.alpha, planned.dropped, sums[0], sums[1]]

entry const roundtrip_tick = func (tick: U32) : U32 => return do:
  let saved = clock.encode_clock $clock.Clock { tick, remainder: 0.0625 }
  return (clock.decode_clock policy saved).tick

entry const decode = func (values: Array F32) : F32 => return (clock.decode_clock policy values).remainder
entry const zero_cadence = func () : Bool => return clock.every 0 clock.clock
entry const invalid_policy = func (step: F32) : Unit => return clock.validate $clock.Policy { step_seconds: step, max_elapsed: 1.0, max_steps: 3 }
entry const steps = func (count: U32) : Array U32 => return do:
  let chosen = $clock.Policy { step_seconds: 0.125, max_elapsed: U32.to_f32 count * 0.125, max_steps: count }
  let current = #[clock.clock]
  let sums = #[0.0, 0.0]
  clock.advance chosen current sums checkpoint update chosen.max_elapsed
  return #[current[0].tick, F32.to_u32 (sums[0] * 8.0)]

entry const test_clock_policy_and_discarded_time = func () => return check.report #[
  check.equal #[13.0,0.0625,3.0,0.5,0.125,0.375,0.25] (advance #[0.0625,0.5]),
  check.equal #[13.0,0.0,3.0,0.0,9.625,0.375,0.25] (advance #[0.0,10.0]),
  check.equal #[10.0,0.0625,0.0,0.5,0.0,0.0,0.0] (advance #[0.0625,0.0])]
entry const test_clock_full_width_ticks = func () => return check.report (array.concat
  #[check.words #[tick] #[roundtrip_tick tick] | tick <- #[0,65535,65536,16777217,4294967295]]
  #[check.holds (Bool.not (zero_cadence ()))])

entry const trap_decode_0 = func () => return #[decode (#[0.0,0.0,-1.0])]
entry const trap_decode_1 = func () => return #[decode (#[0.0,0.0,0.125])]
entry const trap_decode_2 = func () => return #[decode (#[65536.0,0.0,0.0])]
entry const trap_decode_3 = func () => return #[decode (#[0.0,0.0,0.0 / 0.0])]
entry const trap_decode_4 = func () => return #[decode (#[0.0,0.0])]
entry const trap_decode_5 = func () => return #[decode (#[0.0,0.0,0.0,0.0])]

entry const trap_advance_0 = func () => return advance (#[0.0,-1.0])
entry const trap_advance_1 = func () => return advance (#[0.0,0.0 / 0.0])
entry const trap_advance_2 = func () => return advance (#[0.0,1.0 / 0.0])

entry const trap_invalid_policy_0 = func () => return do:
  use invalid_policy (0.0)
  return #[0.0]
entry const trap_invalid_policy_1 = func () => return do:
  use invalid_policy (-1.0)
  return #[0.0]
entry const trap_invalid_policy_2 = func () => return do:
  use invalid_policy (0.0 / 0.0)
  return #[0.0]
entry const trap_invalid_policy_3 = func () => return do:
  use invalid_policy (1.0 / 0.0)
  return #[0.0]
