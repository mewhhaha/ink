import * as reference from "./perf/profile_reference"
import * as array from "std/array"
import * as check from "./check"
import * as pen_profile from "ink/pen/profile"
import * as audit from "./perf/audit_profile"
import * as observe from "./fixtures/profile_observe"
func flame_packet index => case index of
  0 => #[]
  1 => #[0.0]
  _ => #[1.0,7.0,8.0,1.0,65.0,0.0,9.0,0.0,8.0,4.0,2.0,66.0,128512.0]
const memory_packet = #[64.0,128.0,1.0,97.0,2.0,3.0,5.0,98.0,0.0]
entry func test_profile_two_pass_preserves_validation_and_payload () =>
  let checks:#[+check.Check] = #[]
  for index in 0 .. 3:
    let packet = flame_packet index
    for length in 0 .. packet.length + 1:
      let prefix = array.slice 0 length packet
      checks.push (check.equal (observe.flame pen_profile.flame prefix) (observe.flame audit.flame_two_pass prefix))
    for at in 0 .. packet.length:
      for invalid in #[(-1.0), 0.5, (1.0 / 0.0), (0.0 / 0.0), 55296.0, 1114112.0]:
        let changed = array.generate packet.length (func i => if i == at then invalid else packet[i])
        checks.push (check.equal (observe.flame pen_profile.flame changed) (observe.flame audit.flame_two_pass changed))
  return check.report (seal checks)

func compare_packets (packet: #[F32]) => #[
  check.equal (observe.flame reference.flame packet) (observe.flame pen_profile.flame packet),
  check.equal (observe.flame reference.flame_prefix packet) (observe.flame pen_profile.flame_prefix packet),
  check.equal (observe.memory reference.memory packet) (observe.memory pen_profile.memory packet),
  check.equal (observe.memory reference.memory_prefix packet) (observe.memory pen_profile.memory_prefix packet)]
entry func test_profile_complete_and_partial_parsers_preserve_original_contracts () =>
  let checks:#[+check.Check] = #[]
  for index in 0 .. 4:
    let packet = if index == 2 then memory_packet else flame_packet (if index == 3 then 2 else index)
    for count in 0 .. packet.length + 1:
      array.append_into checks (compare_packets (array.slice 0 count packet))
    for at in 0 .. packet.length:
      for invalid in #[(-1.0), 0.5, (1.0 / 0.0), (0.0 / 0.0), 55296.0, 1114112.0, 16777216.0]:
        array.append_into checks (compare_packets (array.generate packet.length (func i => if i == at then invalid else packet[i])))
  return check.report (seal checks)
