import * as reference from "./perf/profile_reference"
import * as array from "std/array"
import * as check from "./check"
import * as pen_profile from "ink/pen/profile"
import * as audit from "./perf/audit_profile"
const flame_words = fn value => case value of
  #Nothing => #[]
  #Some flame => array.flatten #[#[1.0, U32.to_f32 flame.hottest.length, U32.to_f32 flame.nodes.length],
    array.flatten (array.map (fn node => array.concat #[U32.to_f32 node.function, node.samples, U32.to_f32 node.name.length] (array.map U32.to_f32 node.name)) flame.hottest),
    array.flatten (array.map (fn node => array.concat #[U32.to_f32 node.depth, U32.to_f32 node.function, node.first, node.samples, node.alone, U32.to_f32 node.name.length] (array.map U32.to_f32 node.name)) flame.nodes)]
entry const test_profile_two_pass_preserves_validation_and_payload = fn () => do:
  let checks = #[]
  for packet in #[#[], #[0.0], #[1.0, 7.0, 8.0, 1.0, 65.0, 0.0, 9.0, 0.0, 8.0, 4.0, 2.0, 66.0, 128512.0]]:
    for length in 0 .. packet.length + 1:
      let prefix = array.slice 0 length packet
      checks := array.push (check.equal (flame_words (pen_profile.flame prefix)) (flame_words (audit.flame_two_pass prefix))) checks
    for at in 0 .. packet.length:
      for invalid in #[(-1.0), 0.5, (1.0 / 0.0), (0.0 / 0.0), 55296.0, 1114112.0]:
        let changed = array.generate packet.length (fn i => if i == at then invalid else packet[i])
        checks := array.push (check.equal (flame_words (pen_profile.flame changed)) (flame_words (audit.flame_two_pass changed))) checks
  return check.report checks

const memory_words = fn value => case value of
  #Nothing => #[]
  #Some memory => array.concat #[1.0, memory.committed, memory.most] (array.flatten (array.map (fn counter => array.concat #[counter.value, U32.to_f32 counter.name.length] (array.map U32.to_f32 counter.name)) memory.counters))
const compare_packets = fn (packet: Array F32) => #[
  check.equal (flame_words (reference.flame packet)) (flame_words (pen_profile.flame packet)),
  check.equal (flame_words (reference.flame_prefix packet)) (flame_words (pen_profile.flame_prefix packet)),
  check.equal (memory_words (reference.memory packet)) (memory_words (pen_profile.memory packet)),
  check.equal (memory_words (reference.memory_prefix packet)) (memory_words (pen_profile.memory_prefix packet))]
entry const test_profile_complete_and_partial_parsers_preserve_original_contracts = fn () => do:
  let checks = #[]
  for packet in #[#[], #[0.0], #[64.0,128.0,1.0,97.0,2.0,3.0,5.0,98.0,0.0], #[1.0,7.0,8.0,1.0,65.0,0.0,9.0,0.0,8.0,4.0,2.0,66.0,128512.0]]:
    for count in 0 .. packet.length + 1:
      checks := array.concat self (compare_packets (array.slice 0 count packet))
    for at in 0 .. packet.length:
      for invalid in #[(-1.0), 0.5, (1.0 / 0.0), (0.0 / 0.0), 55296.0, 1114112.0, 16777216.0]:
        checks := array.concat self (compare_packets (array.generate packet.length (fn i => if i == at then invalid else packet[i])))
  return check.report checks
