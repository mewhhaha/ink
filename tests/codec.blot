import * as c from "ink/codec"
import * as m from "./fixtures/derived/model_derived"
import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as persist from "ink/persist"
import * as model_owners from "./support/word_model"

func site (id: U32) => $m.Site { ring: 16777217, sector: 7, kind: id, age: -0.125, work: 100, impact: 0.375, delivered: 4 }
func encode_site (value: m.Site) => c.encode value
func decode_site (words: #[U32]) : Maybe m.Site => c.Codec.decode words
func encode_town (value: m.Town) => c.encode value
func decode_town (words: #[U32]) : Maybe m.Town => c.Codec.decode words
const site_codec = m.site_codec c.no_migration
const town_codec = m.town_codec c.no_migration
const sample = site 4294967295
entry func persistence () => model_owners.with_model (func source =>
  let entity = ecs.spawn source.alive source.alive_meta
  ecs.insert source.alive source.current source.current_meta entity sample
  ecs.copy_into (func value => value) source.previous source.current
  ecs.write source.current source.current_meta entity (site 16777219)
  source.site_payload.push sample
  source.delivery_payload.push $m.Idle
  source.delivery_payload.push ($m.To {home: 4294967295, amount: $m.Positive 7})
  source.delivery_payload.push ($m.Batch {sites_start: 0, sites_count: 1})
  source.town[0] := $m.Town {sites_start: 0, sites_count: 1, deliveries_start: 0, deliveries_count: 3}
  use saved <- model_owners.encode_bridge_state source
  return model_owners.with_model (func restored =>
    restored := model_owners.decode_bridge_state restored saved
    let $Some current = ecs.read restored.current 0 else:
      return #[]
    let $Some previous = ecs.read restored.previous 0 else:
      return #[]
    let metadata: m.Town = restored.town[0]
    let site_rows: #[~m.Site] = restored.site_payload
    return #[current.kind, previous.kind, site_rows[metadata.sites_start].ring, metadata.deliveries_count, F32.to_u32 (current.impact * 8.0)]))
entry func encoded (id: U32) => encode_site (site id)
entry func decoded (words: #[U32]) => case decode_site words of
  $Nothing => #[0]
  $Some value => #[1, value.kind, value.ring]
entry func float_bits (value: F32) => c.float_encode value
entry func float_read (words: #[U32]) => case c.float_decode words of
  $Nothing => #[0.0]
  $Some value => #[1.0, value]
entry func packed (words: #[U32]) => c.pack 0 words
entry func unpacked (lanes: #[F32]) => case c.unpack 0 lanes of
  $Nothing => #[]
  $Some words => words
entry func inspection () =>
  let descriptor = m.site_descriptor ()
  let before_words = encode_site sample
  let after_words = encode_site (site 42)
  let before_fields: #[~c.FieldView] = #[]
  let after_fields: #[~c.FieldView] = #[]
  let $Some (_, before) = c.inspect descriptor decode_site before_words before_fields else:
    return #[]
  let $Some (_, after) = c.inspect descriptor decode_site after_words after_fields else:
    return #[]
  return c.changed before after
func old_to_new (words: #[U32]) =>
  if words.length != 6 or words[0] != 0 or words[1] != 1 or words[2] != 1 or words[3] != 30 or words[4] != 1:
    return panic "invalid old Site"
  return encode_site (site words[5])
func migrate (version: U32) -> (values: #[U32]) => if version == 0 then $Some (old_to_new values) else $Nothing
entry func migration () =>
  let codec = m.site_codec migrate
  let old = c.pack 0 #[0, 1, 1, 30, 1, 4294967295]
  let $Some converted = codec.migrate 0 old else:
    return #[]
  let value = codec.decode converted
  let $Some preserved = c.unpack 0 old else:
    return #[]
  return #[value.kind, preserved[0], preserved[5]]
entry func workload (count: U32) =>
  let sum = 0
  let size = 0
  for id in 0 .. count:
    let saved = site_codec.encode (site id)
    let decoded = site_codec.decode saved
    sum := self + decoded.kind
    size := self + saved.length
  return #[sum, size]

// Handwritten seven-lane baseline, qualified only for these small exact ids.
entry func handwritten (count: U32) =>
  let sum = 0
  let size = 0
  for id in 0 .. count:
    let s = site id
    let saved = #[U32.to_f32 s.ring, U32.to_f32 s.sector, U32.to_f32 s.kind, s.age,
      U32.to_f32 s.work, s.impact, U32.to_f32 s.delivered]
    let decoded = $m.Site { ring: F32.to_u32 saved[0], sector: F32.to_u32 saved[1], kind: F32.to_u32 saved[2], age: saved[3], work: F32.to_u32 saved[4], impact: saved[5], delivered: F32.to_u32 saved[6] }
    sum := self + decoded.kind
    size := self + saved.length
  return #[sum, size]
entry func delivery_decode (words: #[U32]) =>
  let decoded: Maybe m.Delivery = c.Codec.decode words
  return if Maybe.is_some decoded then 1 else 0
entry func delivery_encode () => c.encode ($m.To { home: 1, amount: $m.Positive 7 })

// Compare upstream and optimized codecs at the word boundary, including nested
// span metadata and custom validation. Re-encoding observes every decoded field.
entry func sample_words (choice: U32) => case choice of
  0 => encode_site sample
  1 => c.encode $m.Idle
  2 => c.encode ($m.To { home: 4294967295, amount: $m.Positive 7 })
  3 => c.encode ($m.Batch {sites_start: 0, sites_count: 2})
  _ => encode_town ($m.Town {sites_start: 0, sites_count: 2, deliveries_start: 0, deliveries_count: 3})
entry func read_sample (packet: #[U32]) =>
  let words = @array.slice packet 1 (packet.length - 1)
  if packet[0] == 0:
    return case decode_site words of
      $Nothing => #[]
      $Some value => encode_site value
  if packet[0] == 4:
    return case decode_town words of
      $Nothing => #[]
      $Some value => encode_town value
  let decoded: Maybe m.Delivery = c.Codec.decode words
  return case decoded of
    $Nothing => #[]
    $Some value => c.encode value
