import { Vec3 } from "std/vector"
import * as vector from "std/vector"
import * as check from "./check"
import * as feet from "ink/animation/feet"
import * as ik from "ink/animation/ik"
import * as math from "ink/math"
import * as random from "ink/random"

func length (v: Vec3) : F32 => vector.Vec3.length v
func between (seed: U32) => func (low: F32) => func (high: F32) : F32 => random.between low high seed
func direction (seed: U32) : Vec3 =>
  let z = random.between (-1.0) 1.0 seed
  let a = random.angle (random.next seed)
  let r = sqrt (1.0 - z * z)
  return math.vec3 (r * cos a) z (r * sin a)

// Randomised reachable chains: the end meets the target, bone lengths hold
// and the knee bends toward the pole's side of the reach axis.
entry func test_two_bone_reaches_reachable_targets_and_keeps_lengths () =>
  let bad_reach = 0
  let bad_length = 0
  let bad_side = 0
  let seed = 12345
  for 0 .. 200:
    seed := random.next self
    let l1 = between seed 0.3 1.5
    seed := random.next self
    let l2 = between seed 0.3 1.5
    seed := random.next self
    let root = direction seed * 2.0
    seed := random.next self
    let first = direction seed
    seed := random.next self
    let bend = direction seed
    let side = bend - first * vector.Vec3.dot bend first
    let mid = root + first * l1
    let end = mid + vector.Vec3.normalized side * l2
    seed := random.next self
    let aim = direction seed
    seed := random.next self
    let distance = between seed (abs (l1 - l2) + 0.05) (l1 + l2 - 0.05)
    let target = root + aim * distance
    seed := random.next self
    let pole = direction seed
    let $Some c = ik.two_bone root mid end target pole 0.0 1.0 else:
      return check.report #[check.holds false]
    if length (c.end - target) > 0.0001:
      bad_reach := self + 1
    let e1 = abs (length (c.mid - root) - l1)
    let e2 = abs (length (c.end - c.mid) - l2)
    if e1 > 0.00001 or e2 > 0.00001:
      bad_length := self + 1
    let axis = vector.Vec3.normalized (target - root)
    let bent = (c.mid - root) - axis * vector.Vec3.dot (c.mid - root) axis
    let wanted = pole - axis * vector.Vec3.dot pole axis
    if vector.Vec3.dot bent wanted < 0.0:
      bad_side := self + 1
  return check.report #[check.words #[0, 0, 0] #[bad_reach, bad_length, bad_side]]

entry func test_two_bone_unreachable_targets_extend_toward_the_target () =>
  let root = math.vec3 1.0 2.0 3.0
  let mid = math.vec3 1.0 3.0 3.0
  let end = math.vec3 1.0 3.0 4.5
  let target = math.vec3 11.0 2.0 3.0
  let $Some c = ik.two_bone root mid end target math.up 0.0 1.0 else:
    return check.report #[check.holds false]
  let total = 1.0 + 1.5
  return check.report #[
    check.near 0.00001 #[1.0 + total, 2.0, 3.0] #[c.end.x, c.end.y, c.end.z],
    check.near 0.00001 #[1.0 + 1.0, 2.0, 3.0] #[c.mid.x, c.mid.y, c.mid.z],
  ]

// Soft limits ease into the hard reach: identity below the start, monotone,
// never above the maximum, C1 at the start and a hard clamp at zero softness.
entry func test_soft_reach_is_monotone_continuous_and_bounded () =>
  let monotone = 0
  let bounded = 0
  let previous = 0.0
  for step in 0 .. 400:
    let d = U32.to_f32 step * 0.01
    let r = ik.soft_reach 0.2 2.0 0.25 d
    if r < previous:
      monotone := self + 1
    if r > 2.0 or r < 0.2:
      bounded := self + 1
    previous := r
  let slope = (ik.soft_reach 0.0 2.0 0.25 1.5001 - ik.soft_reach 0.0 2.0 0.25 1.5) / 0.0001
  return check.report #[
    check.words #[0, 0] #[monotone, bounded],
    check.equal #[1.0, 1.4, 0.2, 2.0] #[ik.soft_reach 0.0 2.0 0.25 1.0, ik.soft_reach 0.0 2.0 0.25 1.4, ik.soft_reach 0.2 2.0 0.0 0.1, ik.soft_reach 0.0 2.0 0.0 5.0],
    check.near 0.01 #[1.0] #[slope],
    check.holds (ik.soft_reach 0.0 2.0 0.25 100.0 < 2.0 and ik.soft_reach 0.0 2.0 0.25 100.0 > 1.9),
  ]

entry func test_two_bone_weight_blends_without_changing_bone_lengths () =>
  let root = math.zero3
  let mid = math.vec3 0.0 1.0 0.0
  let end = math.vec3 0.0 2.0 0.5
  let target = math.vec3 1.0 0.6 0.0
  let bad = 0
  let moved = 0.0
  for step in 0 .. 11:
    let w = U32.to_f32 step * 0.1
    let $Some c = ik.two_bone root mid end target math.right 0.0 w else:
      return check.report #[check.holds false]
    let e1 = abs (length (c.mid - root) - 1.0)
    let e2 = abs (length (c.end - c.mid) - length (end - mid))
    if e1 > 0.00001 or e2 > 0.00001:
      bad := self + 1
    if step == 5:
      moved := length (c.end - end)
  let $Some none = ik.two_bone root mid end target math.right 0.0 0.0 else:
    return check.report #[check.holds false]
  let $Some below = ik.two_bone root mid end target math.right 0.0 (-3.0) else:
    return check.report #[check.holds false]
  let $Some full = ik.two_bone root mid end target math.right 0.0 1.0 else:
    return check.report #[check.holds false]
  let $Some over = ik.two_bone root mid end target math.right 0.0 7.0 else:
    return check.report #[check.holds false]
  return check.report #[
    check.words #[0] #[bad],
    check.bits #[mid.x, mid.y, mid.z, end.x, end.y, end.z] #[none.mid.x, none.mid.y, none.mid.z, none.end.x, none.end.y, none.end.z],
    check.bits #[none.mid.x, none.mid.y, none.mid.z] #[below.mid.x, below.mid.y, below.mid.z],
    check.bits #[full.end.x, full.end.y, full.end.z] #[over.end.x, over.end.y, over.end.z],
    check.holds (moved > 0.1 and moved < length (full.end - end)),
  ]

// The returned rotations carry the old bone directions onto the new ones.
entry func test_two_bone_rotation_deltas_turn_old_bones_onto_new_bones () =>
  let root = math.zero3
  let mid = math.vec3 0.0 1.0 0.0
  let end = math.vec3 0.0 2.0 0.0
  let $Some c = ik.two_bone root mid end (math.vec3 1.2 0.5 0.0) math.forward 0.0 1.0 else:
    return check.report #[check.holds false]
  let d1 = math.Quat.rotate c.root_delta (math.vec3 0.0 1.0 0.0)
  let d2 = math.Quat.rotate (c.mid_delta * c.root_delta) (math.vec3 0.0 1.0 0.0)
  let n1 = vector.Vec3.normalized (c.mid - root)
  let n2 = vector.Vec3.normalized (c.end - c.mid)
  return check.report #[
    check.near 0.00001 #[n1.x, n1.y, n1.z, n2.x, n2.y, n2.z] #[d1.x, d1.y, d1.z, d2.x, d2.y, d2.z],
  ]

entry func test_two_bone_adversarial_inputs () =>
  let root = math.vec3 0.0 1.0 0.0
  let bone = math.vec3 0.0 2.0 0.0
  let tip = math.vec3 0.0 3.0 0.0
  let target = math.vec3 0.5 2.0 0.5
  let nan = 0.0 / 0.0
  let inf = 1.0 / 0.0
  // Zero-length first, second and both bones.
  let $Some z1 = ik.two_bone root root tip target math.up 0.0 1.0 else:
    return check.report #[check.holds false]
  let $Some z2 = ik.two_bone root bone bone target math.up 0.0 1.0 else:
    return check.report #[check.holds false]
  let $Some z3 = ik.two_bone root root root target math.up 0.0 1.0 else:
    return check.report #[check.holds false]
  // Target at the root, and with a pole along the reach axis.
  let $Some at_root = ik.two_bone root bone tip root math.up 0.0 1.0 else:
    return check.report #[check.holds false]
  let $Some parallel = ik.two_bone root (math.vec3 0.3 2.0 0.0) (math.vec3 0.0 3.0 0.1) (math.vec3 0.0 2.5 0.0) (math.vec3 0.0 4.0 0.0) 0.0 1.0 else:
    return check.report #[check.holds false]
  let $Some no_pole = ik.two_bone root bone tip target math.zero3 0.0 1.0 else:
    return check.report #[check.holds false]
  let finite = math.finite3 z1.mid and math.finite3 z1.end and math.finite3 z2.mid and math.finite3 z2.end and math.finite3 z3.end
    and math.finite3 at_root.mid and math.finite3 at_root.end and math.finite3 parallel.mid and math.finite3 parallel.end and math.finite3 no_pole.mid
  return check.report #[
    check.holds finite,
    check.near 0.00001 #[0.0, 2.0] #[length (z1.mid - root), length (z1.end - z1.mid)],
    check.near 0.00001 #[1.0, 0.0] #[length (z2.mid - root), length (z2.end - z2.mid)],
    check.near 0.00001 #[0.0, 0.0] #[length (z3.mid - root), length (z3.end - z3.mid)],
    // Fully folded: both bones one metre, target at the root.
    check.near 0.00001 #[1.0, 1.0, 0.0] #[length (at_root.mid - root), length (at_root.end - at_root.mid), length (at_root.end - root)],
    check.near 0.00001 #[length (math.vec3 0.3 1.0 0.0), length (math.vec3 (-0.3) 1.0 0.1)] #[length (parallel.mid - root), length (parallel.end - parallel.mid)],
    check.near 0.00001 #[1.0, 1.0] #[length (no_pole.mid - root), length (no_pole.end - no_pole.mid)],
    check.holds (not (Maybe.is_some (ik.two_bone (math.vec3 nan 0.0 0.0) bone tip target math.up 0.0 1.0))),
    check.holds (not (Maybe.is_some (ik.two_bone root (math.vec3 0.0 inf 0.0) tip target math.up 0.0 1.0))),
    check.holds (not (Maybe.is_some (ik.two_bone root bone tip (math.vec3 0.0 0.0 inf) math.up 0.0 1.0))),
    check.holds (not (Maybe.is_some (ik.two_bone root bone tip target (math.vec3 nan nan nan) 0.0 1.0))),
    check.holds (not (Maybe.is_some (ik.two_bone root bone tip target math.up nan 1.0))),
    check.holds (not (Maybe.is_some (ik.two_bone root bone tip target math.up 0.0 inf))),
  ]

func turn_angle (a: math.Quat) => func (b: math.Quat) : F32 =>
  let d = abs (math.Quat.dot a b)
  return 2.0 * acos_clamped (min 1.0 d)
func forward_of (q: math.Quat) : Vec3 => math.Quat.forward q
func angle_between (a: Vec3) => func (b: Vec3) : F32 =>
  return acos_clamped (vector.Vec3.dot (vector.Vec3.normalized a) (vector.Vec3.normalized b))
func acos_clamped (c: F32) : F32 =>
  let d = clamp (-1.0) 1.0 c
  return math.atan2 (sqrt (max 0.0 (1.0 - d * d))) d

entry func test_aim_points_the_forward_axis_and_respects_limit_and_weight () =>
  let axes = $ik.Axes { forward: math.forward, up: math.up }
  let start = math.axis_angle math.up 0.3
  let want = vector.Vec3.normalized (math.vec3 3.0 2.0 (-4.0))
  let $Some full = ik.aim_rotation start axes want math.up 10.0 1.0 else:
    return check.report #[check.holds false]
  let $Some limited = ik.aim_rotation start axes want math.up 0.2 1.0 else:
    return check.report #[check.holds false]
  let $Some half = ik.aim_rotation start axes want math.up 10.0 0.5 else:
    return check.report #[check.holds false]
  let $Some zero = ik.aim_rotation start axes want math.up 10.0 0.0 else:
    return check.report #[check.holds false]
  let $Some swing = ik.aim_rotation start ($ik.Axes { forward: math.forward, up: math.zero3 }) want math.zero3 10.0 1.0 else:
    return check.report #[check.holds false]
  let $Some stay = ik.aim_rotation start axes math.zero3 math.up 10.0 1.0 else:
    return check.report #[check.holds false]
  let $Some swing_limited = ik.aim_rotation start ($ik.Axes { forward: math.forward, up: math.zero3 }) want math.zero3 0.2 1.0 else:
    return check.report #[check.holds false]
  let before = forward_of start
  let total = angle_between before want
  let upward = math.Quat.rotate full math.up
  let f = forward_of full
  let s = forward_of swing
  let l = forward_of limited
  let h = forward_of half
  return check.report #[
    check.near 0.00001 #[want.x, want.y, want.z] #[f.x, f.y, f.z],
    check.near 0.00001 #[want.x, want.y, want.z] #[s.x, s.y, s.z],
    check.holds (upward.y > 0.5),
    check.near 0.0001 #[0.2] #[angle_between before (forward_of swing_limited)],
    check.holds (turn_angle limited start <= 0.2001 and turn_angle limited start > 0.19),
    check.holds (total > 0.2),
    check.near 0.001 #[total * 0.5] #[angle_between before h],
    check.near 0.00001 #[start.x, start.y, start.z, start.w] #[zero.x, zero.y, zero.z, zero.w],
    check.near 0.00001 #[start.x, start.y, start.z, start.w] #[stay.x, stay.y, stay.z, stay.w],
    check.holds (not (Maybe.is_some (ik.aim_rotation start axes (math.vec3 (0.0 / 0.0) 0.0 1.0) math.up 1.0 1.0))),
    check.holds (not (Maybe.is_some (ik.aim_rotation start axes want math.up (1.0 / 0.0) 1.0))),
  ]

entry func test_aim_chain_distributes_the_turn_and_reaches_with_the_tip () =>
  let axes = $ik.Axes { forward: math.forward, up: math.up }
  let rotations = #[math.axis_angle math.up 0.1, math.axis_angle math.up 0.2, math.axis_angle math.up 0.3]
  let shares = #[0.2, 0.3, 0.5]
  let want = vector.Vec3.normalized (math.vec3 (-2.0) 1.0 (-3.0))
  let $Some out = ik.aim_chain rotations shares axes want math.up 10.0 1.0 else:
    return check.report #[check.holds false]
  let tip = forward_of out[2]
  let a0 = turn_angle out[0] rotations[0]
  let a1 = turn_angle out[1] rotations[1]
  let a2 = turn_angle out[2] rotations[2]
  let $Some limited = ik.aim_chain rotations shares axes want math.up 0.1 1.0 else:
    return check.report #[check.holds false]
  let $Some nothing = ik.aim_chain rotations #[0.0, 0.0, 0.0] axes want math.up 10.0 1.0 else:
    return check.report #[check.holds false]
  let $Some single = ik.aim_chain #[rotations[0]] #[1.0] axes want math.up 10.0 1.0 else:
    return check.report #[check.holds false]
  let f = forward_of single[0]
  return check.report #[
    check.near 0.00001 #[want.x, want.y, want.z] #[tip.x, tip.y, tip.z],
    check.near 0.00001 #[want.x, want.y, want.z] #[f.x, f.y, f.z],
    check.holds (a0 > 0.0 and a0 < a1 and a1 < a2),
    check.holds (turn_angle limited[2] rotations[2] <= 0.1001),
    check.near 0.00001 #[rotations[0].y, rotations[1].y, rotations[2].y] #[nothing[0].y, nothing[1].y, nothing[2].y],
    check.holds (not (Maybe.is_some (ik.aim_chain rotations #[1.0, 1.0] axes want math.up 1.0 1.0))),
    check.holds (not (Maybe.is_some (ik.aim_chain #[] #[] axes want math.up 1.0 1.0))),
    check.holds (not (Maybe.is_some (ik.aim_chain rotations #[1.0, 1.0, 0.0 / 0.0] axes want math.up 1.0 1.0))),
  ]

func settings () => $feet.Settings { ankle: math.vec3 0.0 0.1 0.0, max_drop: 0.5, max_raise: 0.5, pelvis_rate: 12.0, foot_rate: 12.0, align_limit: 0.6 }
func standing (x: F32) => func (plant: F32) => func (height: F32) => func (normal: Vec3) : feet.Foot =>
  return $feet.Foot { sole: math.vec3 x 0.0 0.0, rotation: math.identity_quat, plant, hit: true, height, normal }

// Both feet over lower ground: the pelvis settles on the lowest planted hit,
// every sole ends on its ground and none is ever below it on the way.
entry func test_feet_settle_pelvis_and_never_sink_below_ground () =>
  let tilt = math.vec3 0.0 0.9396926 0.3420201
  let rig = #[standing (-0.2) 1.0 (-0.1) math.up, standing 0.2 1.0 (-0.2) tilt]
  let slots = #[feet.rest, feet.rest]
  let pelvis = 0.0
  let below = 0
  let rising = 0
  let previous = 0.0
  for 0 .. 60:
    let (ok, p, out) = feet.place (settings ()) 0.016 pelvis rig slots
    if not ok:
      return check.report #[check.holds false]
    if out[0].sole.y < -0.1 or out[1].sole.y < -0.2:
      below := self + 1
    if p > previous:
      rising := self + 1
    previous := p
    pelvis := p
    slots := out
  let aligned = math.Quat.rotate slots[1].rotation math.up
  return check.report #[
    check.words #[0, 0] #[below, rising],
    check.near 0.0001 #[-0.2] #[pelvis],
    check.near 0.0001 #[-0.1, -0.2] #[slots[0].sole.y, slots[1].sole.y],
    check.near 0.001 #[tilt.x, tilt.y, tilt.z] #[aligned.x, aligned.y, aligned.z],
    check.near 0.0001 #[0.1] #[slots[0].ankle.y - slots[0].sole.y],
    check.near 0.0001 #[-0.2, 0.2, 0.0] #[slots[0].sole.x, slots[1].sole.x, slots[1].sole.z],
  ]

entry func test_feet_limits_swing_phase_and_missing_hits () =>
  // Alignment is limited; a swing foot (plant 0) follows the pelvis; no hit leaves the foot.
  let steep = math.vec3 0.0 0.0 1.0
  let rig = #[standing 0.0 1.0 0.0 steep, standing 1.0 0.0 (-5.0) math.up, $feet.Foot { sole: math.vec3 2.0 0.3 0.0, rotation: math.identity_quat, plant: 1.0, hit: false, height: 99.0, normal: math.zero3 }]
  let slots = #[feet.rest, feet.rest, feet.rest]
  let pelvis = 0.0
  for 0 .. 200:
    let (ok, p, out) = feet.place (settings ()) 0.05 pelvis rig slots
    if not ok:
      return check.report #[check.holds false]
    pelvis := p
    slots := out
  let tilted = math.Quat.rotate slots[0].rotation math.up
  return check.report #[
    check.near 0.001 #[0.0] #[pelvis],
    check.near 0.001 #[0.6] #[math.atan2 (sqrt (tilted.x * tilted.x + tilted.z * tilted.z)) tilted.y],
    check.near 0.0001 #[0.0] #[slots[1].sole.y],
    check.near 0.0001 #[0.3, 0.0] #[slots[2].sole.y, slots[2].lift],
    check.near 0.0001 #[0.0, 0.0, 0.0, 1.0] #[slots[2].rotation.x, slots[2].rotation.y, slots[2].rotation.z, slots[2].rotation.w],
  ]

entry func test_feet_zero_dt_invalid_inputs_and_raising () =>
  let nan = 0.0 / 0.0
  let rig = #[standing 0.0 1.0 0.2 math.up]
  let slots = #[feet.rest]
  let (ok0, p0, held) = feet.place (settings ()) 0.0 0.0 rig slots
  let (ok1, p1, one) = feet.place (settings ()) 0.1 0.0 rig (@storage.copy held)
  let (bad_dt, _, _) = feet.place (settings ()) nan 0.0 rig #[feet.rest]
  let (neg_dt, _, _) = feet.place (settings ()) (-0.1) 0.0 rig #[feet.rest]
  let (bad_normal, bn, kept) = feet.place (settings ()) 0.1 0.3 #[standing 0.0 1.0 0.0 math.zero3] #[feet.rest]
  let (bad_height, _, _) = feet.place (settings ()) 0.1 0.0 #[standing 0.0 1.0 nan math.up] #[feet.rest]
  let (bad_count, _, _) = feet.place (settings ()) 0.1 0.0 rig #[feet.rest, feet.rest]
  let (bad_settings, _, _) = feet.place ($feet.Settings { ankle: math.zero3, max_drop: (-1.0), max_raise: 0.5, pelvis_rate: 1.0, foot_rate: 1.0, align_limit: 1.0 }) 0.1 0.0 rig #[feet.rest]
  let (none_ok, none_p, none_out) = feet.place (settings ()) 0.1 0.0 #[] #[]
  // Clamped by max_raise: ground 2 m above the animated sole.
  let (hi_ok, hi_p, hi) = feet.place (settings ()) 1000.0 0.0 #[standing 0.0 1.0 2.0 math.up] #[feet.rest]
  return check.report #[
    check.holds (ok0 and ok1),
    check.bits #[0.0, 0.0] #[p0, held[0].lift],
    check.holds (p1 > 0.0 and p1 < 0.2 and one[0].sole.y >= 0.2),
    check.holds (not bad_dt and not neg_dt and not bad_normal and not bad_height and not bad_count and not bad_settings),
    check.bits #[0.3] #[bn],
    check.bits #[0.0] #[kept[0].lift],
    check.holds (none_ok and none_p == 0.0 and none_out.length == 0),
    check.near 0.00001 #[0.5, 2.0] #[hi_p, hi[0].sole.y],
  ]
