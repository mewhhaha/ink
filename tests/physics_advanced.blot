import { Vec3 } from "std/vector"
import * as vector from "std/vector"
import * as compound from "ink/physics/compound"
import * as fracture from "ink/physics/fracture"
import * as soft from "ink/physics/soft"
import * as triggers from "ink/physics/triggers"
import * as vehicle from "ink/physics/vehicle"
import * as math from "ink/math"
import * as test from "std/test"

func phase_code (p: triggers.Phase) : U32 =>
  return case p of
    $triggers.Enter => 1
    $triggers.Stay => 2
    $triggers.Exit => 3

@[test.suite]
test "trigger lifecycle dedupes and emits enter stay exit":
  let held: #[triggers.Pair] = #[]
  let (e1, held) = triggers.step held #[
    $triggers.Pair { trigger: 5, body: 100 },
    $triggers.Pair { trigger: 2, body: 4294967290 },
    $triggers.Pair { trigger: 5, body: 100 },
  ]
  let (e2, held) = triggers.step held #[
    $triggers.Pair { trigger: 5, body: 100 },
    $triggers.Pair { trigger: 9, body: 1 },
  ]
  // Frame 1: (2, 4294967290) Enter, (5, 100) Enter.
  // Frame 2: (2, 4294967290) Exit, (5, 100) Stay, (9, 1) Enter.
  let _v1 = #[2, 2, 1, 5, 1]
  let _v2 = #[e1.length, e1[0].trigger, phase_code e1[0].phase, e1[1].trigger, phase_code e1[1].phase]
  use test.eq "check 1" _v1 _v2
  let _v3 = #[3, 2, 3, 5, 2, 9, 1]
  let _v4 = #[e2.length, e2[0].trigger, phase_code e2[0].phase, e2[1].trigger, phase_code e2[1].phase, e2[2].trigger, phase_code e2[2].phase]
  use test.eq "check 2" _v3 _v4
  let _v5 = #[4294967290]
  let _v6 = #[e2[0].body]
  use test.eq "check 3" _v5 _v6
  return ()

@[test.suite]
test "compound parallel axis inertia and containment":
  // Two symmetric 1 kg unit spheres at x = -2 and x = +2:
  // COM = (0,0,0), M = 2, Ix = 2*(0.4) = 0.8, Iy = Iz = 2*(0.4 + 4.0) = 8.8, radius = 3.
  let parts = #[
    $compound.Part { shape: $compound.Sphere { radius: 1.0 }, position: math.vec3 (-2.0) 0.0 0.0, rotation: math.identity_quat, mass: 1.0 },
    $compound.Part { shape: $compound.Sphere { radius: 1.0 }, position: math.vec3 2.0 0.0 0.0, rotation: math.identity_quat, mass: 1.0 },
  ]
  let $Some s = compound.combine parts else:
    use test.holds "check 1" false
    return ()
  let inside_left = compound.contains_point math.zero3 math.identity_quat s.center_of_mass parts (math.vec3 (-2.5) 0.0 0.0)
  let outside_mid = not (compound.contains_point math.zero3 math.identity_quat s.center_of_mass parts math.zero3)
  let _v7 = 0.0002
  let _v8 = #[2.0, 0.0, 0.0, 0.0, 3.0]
  let _v9 = #[s.mass, s.center_of_mass.x, s.center_of_mass.y, s.center_of_mass.z, s.radius]
  use test.near_array "check 1" _v7 _v8 _v9
  let _v10 = 0.0005
  let _v11 = #[0.8, 8.8, 8.8, 0.0, 0.0, 0.0]
  let _v12 = #[s.inertia.xx, s.inertia.yy, s.inertia.zz, s.inertia.xy, s.inertia.xz, s.inertia.yz]
  use test.near_array "check 2" _v10 _v11 _v12
  let _v13 = (inside_left and outside_mid)
  use test.holds "check 3" _v13
  return ()

@[test.suite]
test "vehicle ackermann pacejka and wheel forces":
  let (left, right) = vehicle.ackermann 2.6 1.6 0.35
  // Turning left: inner (left) wheel steers sharper than outer (right) wheel.
  let p0 = vehicle.pacejka 0.0 10.0 1.9 1.0 0.97
  let p_pos = vehicle.pacejka 0.12 10.0 1.9 1.0 0.97
  let p_neg = vehicle.pacejka (-0.12) 10.0 1.9 1.0 0.97
  let make_spec = func (mx: F32) -> (mz: F32) -> (steer: F32) => $vehicle.WheelSpec {
    mount: math.vec3 mx 0.0 mz,
    rest_length: 0.4,
    radius: 0.35,
    stiffness: 20000.0,
    damping: 2000.0,
    max_steer: steer,
    drive_share: 0.25,
    brake_share: 0.25,
    grip_long: 1.0,
    grip_lat: 1.0,
  }
  let specs = #[
    make_spec (-0.8) (-1.3) 0.5,
    make_spec 0.8 (-1.3) 0.5,
    make_spec (-0.8) 1.3 0.0,
    make_spec 0.8 1.3 0.0,
  ]
  let make_hit = func (mx: F32) -> (mz: F32) => $vehicle.WheelHit {
    grounded: true,
    distance: 0.55,
    normal: math.up,
    point: math.vec3 mx (-0.55) mz,
    surface_velocity: math.zero3,
  }
  let hits = #[make_hit (-0.8) (-1.3), make_hit 0.8 (-1.3), make_hit (-0.8) 1.3, make_hit 0.8 1.3]
  let prev = #[vehicle.rest_wheel, vehicle.rest_wheel, vehicle.rest_wheel, vehicle.rest_wheel]
  let ctrl = $vehicle.Controls { throttle: 1.0, brake: 0.0, steer: 0.0, handbrake: 0.0 }
  let $Some res = vehicle.step_wheels math.zero3 math.identity_quat math.zero3 math.zero3 specs hits ctrl 4000.0 8000.0 5000.0 (1.0 / 60.0) prev else:
    use test.holds "check 1" false
    return ()
  // Suspension pushes up (+Y) and throttle pushes forward (-Z).
  let _v14 = (left > right and right > 0.0)
  use test.holds "check 1" _v14
  let _v15 = 0.0001
  let _v16 = #[0.0]
  let _v17 = #[p0]
  use test.near_array "check 2" _v15 _v16 _v17
  let _v18 = (p_pos > 0.8 and abs (p_pos + p_neg) < 0.0001)
  use test.holds "check 3" _v18
  let _v19 = (res.force.y > 0.0 and res.force.z < (-1000.0))
  use test.holds "check 4" _v19
  return ()

@[test.suite]
test "soft cloth pins links and buoyancy equilibrium":
  // 4-node hanging rope pinned at node 0 with exact rest spacing 0.5.
  let pts = #[
    $soft.Particle { position: math.vec3 0.0 2.0 0.0, previous: math.vec3 0.0 2.0 0.0, inv_mass: 0.0, radius: 0.05 },
    $soft.Particle { position: math.vec3 0.5 2.0 0.0, previous: math.vec3 0.5 2.0 0.0, inv_mass: 1.0, radius: 0.05 },
    $soft.Particle { position: math.vec3 1.0 2.0 0.0, previous: math.vec3 1.0 2.0 0.0, inv_mass: 1.0, radius: 0.05 },
    $soft.Particle { position: math.vec3 1.5 2.0 0.0, previous: math.vec3 1.5 2.0 0.0, inv_mass: 1.0, radius: 0.05 },
  ]
  let links = #[
    $soft.Link { a: 0, b: 1, rest: 0.5, compliance: 0.0 },
    $soft.Link { a: 1, b: 2, rest: 0.5, compliance: 0.0 },
    $soft.Link { a: 2, b: 3, rest: 0.5, compliance: 0.0 },
  ]
  let floor = #[$soft.Plane { normal: math.up, distance: 0.0 }]
  for 0 .. 45:
    let (ok, next) = soft.step_cloth (math.vec3 0.0 (-9.8) 0.0) math.zero3 0.02 (1.0 / 60.0) 8 links floor pts
    pts := next
  let worst_len = 0.0
  for i in 0 .. 3:
    worst_len := max self (abs (vector.Vec3.length (pts[i + 1].position - pts[i].position) - 0.5))
  let grid = soft.grid_links 3 3 0.5 0.0 0.001
  // Half-submerged sphere has exact submerged fraction 0.5 -> buoyancy = 0.5 * 1000 * 9.8 * 2.0 = 9800 N.
  let pontoons = #[$soft.Pontoon { offset: math.zero3, radius: 1.0, volume: 2.0 }]
  let $Some buoy = soft.buoyancy (math.vec3 0.0 0.0 0.0) math.identity_quat math.zero3 math.zero3 pontoons 0.0 1000.0 9.8 10.0 5.0 else:
    use test.holds "check 1" false
    return ()
  let _v20 = 0.0001
  let _v21 = #[0.0, 2.0, 0.0]
  let _v22 = #[pts[0].position.x, pts[0].position.y, pts[0].position.z]
  use test.near_array "check 1" _v20 _v21 _v22
  let _v23 = (worst_len < 0.02 and pts[3].position.y < 1.5)
  use test.holds "check 2" _v23
  let _v24 = #[26]
  let _v25 = #[grid.length]
  use test.eq "check 3" _v24 _v25
  let _v26 = 0.001
  let _v27 = #[0.5, 9800.0]
  let _v28 = #[buoy.submerged_fraction, buoy.force.y]
  use test.near_array "check 4" _v26 _v27 _v28
  return ()

@[test.suite]
test "fracture damage splits detached islands":
  // Pillar of 4 pieces: 0(anchored)-1-2-3. Break bond 1 (between 1 and 2).
  let bonds = #[
    $fracture.Bond { a: 0, b: 1, strength: 10.0, damage: 0.0 },
    $fracture.Bond { a: 1, b: 2, strength: 10.0, damage: 0.0 },
    $fracture.Bond { a: 2, b: 3, strength: 10.0, damage: 0.0 },
  ]
  let anchored = #[true, false, false, false]
  let $Some before = fracture.components 4 anchored bonds else:
    use test.holds "check 1" false
    return ()
  let (broken, bonds) = fracture.apply_impacts #[$fracture.Impact { bond: 1, impulse: 6.0 }, $fracture.Impact { bond: 1, impulse: 5.0 }] bonds
  let $Some after = fracture.components 4 anchored bonds else:
    use test.holds "check 1" false
    return ()
  let _v29 = #[1, 1]
  let _v30 = #[before.count, if before.grounded[0] then 1 else 0]
  use test.eq "check 1" _v29 _v30
  let _v31 = #[1, 2]
  let _v32 = #[broken, after.count]
  use test.eq "check 2" _v31 _v32
  let _v33 = #[0, 0, 1, 1]
  let _v34 = after.component
  use test.eq "check 3" _v33 _v34
  let _v35 = #[1, 0]
  let _v36 = #[if after.grounded[0] then 1 else 0, if after.grounded[1] then 1 else 0]
  use test.eq "check 4" _v35 _v36
  return ()
