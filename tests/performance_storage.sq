import * as array from "std/array"
import * as test from "std/test"
import * as pages from "ink/pages"
import * as lookup from "ink/lookup"
import * as grid from "ink/spatial/point_grid"
import * as points from "ink/spatial/points"
import * as sort from "ink/sort"
import * as math from "ink/math"
import * as ecs from "ink/ecs"

@[test.suite]
test "paged edits and appends preserve previous storage":
  let old = pages.from (array.generate 130 identity)
  let grown = pages.copy_using identity old
  grown := pages.set 64 999 grown
  grown := pages.push 130 grown
  use test.holds "check 1" (pages.get old 64 == 64 and pages.count old == 130)
  use test.holds "check 2" (pages.get grown 64 == 999 and pages.get grown 130 == 130 and pages.count grown == 131)
  use test.near_array "check 3" 0.0 (array.map U32.to_f32 (pages.flatten old)) (array.map U32.to_f32 (array.generate 130 identity))
  return ()

@[test.suite]
test "point grid queries match exhaustive radius tests through collisions and append":
  let positions = array.generate 180 (func i => math.vec3 (U32.to_f32 (i % 17) * 0.4 - 3.2) 0.0 (U32.to_f32 (i / 17) * 0.4 - 2.0))
  let old_heads: #[U32] = #[]
  let old_points: #[grid.Point] = #[]
  let old_storage = $grid.Storage {heads: old_heads, points: old_points}
  let (old_stored, old_storage) = grid.build_into old_storage $Nothing 0.4 16 positions
  let old = grid.read old_storage old_stored
  let grown_heads: #[U32] = #[]
  let grown_points: #[grid.Point] = #[]
  let grown_storage = $grid.Storage {heads: grown_heads, points: grown_points}
  let (grown_stored, grown_storage) = grid.build_into grown_storage $Nothing 0.4 16 positions
  let (grown_stored, grown_storage) = grid.push_stored grown_storage grown_stored positions[12]
  let grown = grid.read grown_storage grown_stored
  for at in #[math.zero3, positions[12], math.vec3 (-3.6) 0.0 (-2.4), math.vec3 0.39999998 0.0 0.40000003]:
    for radius in #[0.0, 0.4, 0.9, 1000.0]:
      let expected = #[i | i <- array.generate positions.length identity, (positions[i].x - at.x) * (positions[i].x - at.x) + (positions[i].z - at.z) * (positions[i].z - at.z) <= radius * radius]
      let actual = grid.within old at.x at.z radius
      let order = sort.order_u32 actual
      use test.near_array "check 1" 0.0 (array.map U32.to_f32 expected) (array.map (func i => U32.to_f32 actual[i]) order)
  use test.holds "check 2" ((grid.within old positions[12].x positions[12].z 0.0).length == 1 and (grid.within grown positions[12].x positions[12].z 0.0).length == 2)
  return ()

@[test.suite]
test "key lookup preserves full width and first duplicate":
  let key_values: #[U32] = #[]
  let key_order: #[U32] = #[]
  let keys = lookup.build_into #[0xFFFFFFFF, 8, 2, 8, 0xFFFFFFFE] key_values key_order
  let found = array.map (func k => Maybe.unwrap_or 99 (lookup.find keys k)) #[8, 0xFFFFFFFF, 0xFFFFFFFE, 0, 2]
  use test.near_array "check 1" 0.0 #[1.0, 0.0, 4.0, 99.0, 2.0] (array.map U32.to_f32 found)
  return ()

type Counter is data = $Counter U32
func value entry => case entry of
  $Some ($Counter n) => n
  _ => 0
@[test.suite]
test "sparse insert then scoped edits fill skipped leaves and preserve snapshots":
  let alive: ecs.Entities = ecs.entities ()
  let entity_meta = ecs.metadata 1
  let current: ecs.Pool Counter = ecs.pool ()
  let current_meta = ecs.metadata 1
  let old: ecs.Pool Counter = ecs.pool ()
  let previous: ecs.Pool Counter = ecs.pool ()
  let (_, alive, entity_meta) = ecs.spawn_many alive entity_meta 1025
  let (current, current_meta) = ecs.insert_selected alive current current_meta #[96, 1024] #[$Counter 96, $Counter 1024]
  old := ecs.checkpoint identity self current
  previous := ecs.checkpoint identity self current
  let (current, current_meta) = ecs.insert alive current current_meta 1 ($Counter 11)
  let (current, current_meta) = ecs.insert alive current current_meta 65 ($Counter 65)
  let (current, current_meta) = ecs.insert alive current current_meta 512 ($Counter 512)
  let (current, current_meta) = ecs.remove current current_meta 33
  let (alive, entity_meta) = ecs.despawn alive entity_meta 33
  use test.eq "check 1" #[1, 65, 96, 512, 1024] (ecs.indices alive current)
  use test.eq "check 2" #[96, 1024] (ecs.indices alive old)
  use test.eq "check 3" #[96, 1024] (ecs.indices alive previous)
  use test.eq "check 4" #[11, 65, 96, 512, 1024] (array.map (func i => value (ecs.read current i)) #[1, 65, 96, 512, 1024])
  return ()
@[test.suite]
test "sparse insert grows leaves and blocks without changing other entities or snapshots":
  let alive: ecs.Entities = ecs.entities ()
  let entity_meta = ecs.metadata 1
  let current: ecs.Pool Counter = ecs.pool ()
  let current_meta = ecs.metadata 1
  let old: ecs.Pool Counter = ecs.pool ()
  let previous: ecs.Pool Counter = ecs.pool ()
  let (_, alive, entity_meta) = ecs.spawn_many alive entity_meta 2050
  let (current, current_meta) = ecs.insert_selected alive current current_meta #[1, 31, 32, 1023, 1024, 2049] (array.map (func n => $Counter n) #[11, 31, 32, 1023, 1024, 2049])
  old := ecs.checkpoint identity self current
  previous := ecs.checkpoint identity self current
  let (current, current_meta) = ecs.insert_selected alive current current_meta #[31, 512, 1024] (array.map (func n => $Counter n) #[999, 512, 777])
  let (current, current_meta) = ecs.remove current current_meta 32
  let (alive, entity_meta) = ecs.despawn alive entity_meta 32
  use test.near_array "check 1" 0.0 #[1.0, 31.0, 512.0, 1023.0, 1024.0, 2049.0] (array.map U32.to_f32 (ecs.indices alive current))
  use test.near_array "check 2" 0.0 #[31.0, 0.0, 1024.0] (array.map (func i => U32.to_f32 (value (ecs.read old i))) #[31, 512, 1024])
  use test.near_array "check 3" 0.0 #[999.0, 512.0, 777.0] (array.map (func i => U32.to_f32 (value (ecs.read current i))) #[31, 512, 1024])
  use test.holds "check 4" (value (ecs.read previous 31) == 31 and value (ecs.read old 32) == 32 and value (ecs.read current 32) == 0)
  return ()

@[test.suite]
test "page append crosses empty leaf and table boundaries without changing retained values":
  for count in #[0, 63, 64, 65, 127, 128, 4095, 4096]:
    let old = pages.from (array.generate count identity)
    let next = pages.copy_using identity old
    for i in 0 .. 67:
      next := pages.push (count + i) next
    use test.near_array "check 3" 0.0 (array.map U32.to_f32 (array.generate (count + 67) identity)) (array.map U32.to_f32 (pages.flatten next))
    use test.near_array "check 4" 0.0 (array.map U32.to_f32 (array.generate count identity)) (array.map U32.to_f32 (pages.flatten old))
  return ()
