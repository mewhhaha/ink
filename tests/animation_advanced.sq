import { Vec3 } from "std/vector"
import * as vector from "std/vector"
import * as animation from "ink/animation"
import * as ik from "ink/animation/ik"
import * as inertialize from "ink/animation/inertialize"
import * as morph from "ink/animation/morph"
import * as motion_match from "ink/animation/motion_match"
import * as retarget from "ink/animation/retarget"
import * as secondary from "ink/animation/secondary"
import * as math from "ink/math"
import * as transform from "ink/transform"
import * as test from "std/test"

func pose_of (p: Vec3) -> (r: math.Quat) : transform.Pose3 =>
  return $transform.Pose3 { position: p, rotation: r, scale: math.one3 }

@[test.suite]
test "skin matrices bind inverses and socket":
  let none = 4294967295
  let parents = #[none, 0, 1]
  let rest = #[
    pose_of (math.vec3 0.0 1.0 0.0) math.identity_quat,
    pose_of (math.vec3 0.0 1.0 0.0) (math.axis_angle math.up 0.5),
    pose_of (math.vec3 1.0 0.0 0.0) math.identity_quat,
  ]
  let joints = #[0, 1, 2]
  let $Some inv = animation.bind_inverses rest parents joints else:
    use test.holds "check 1" false
    return ()
  let rest_world = animation.world rest parents
  let $Some rest_mats = animation.skin_matrices rest_world joints inv else:
    use test.holds "check 1" false
    return ()
  // At rest pose every skinning matrix must be identity.
  let rest_err = 0.0
  for m in rest_mats:
    rest_err := max self (max (abs (m.xx - 1.0)) (max (abs (m.yy - 1.0)) (max (abs (m.zz - 1.0)) (abs (m.ww - 1.0)))))
    rest_err := max self (max (abs m.wx) (max (abs m.wy) (abs m.wz)))
  // Rotate joint 1 by 90 deg around Y from rest; check a point in bind space.
  let posed = #[
    rest[0],
    pose_of rest[1].position (math.axis_angle math.up (0.5 + 1.5707963)),
    rest[2],
  ]
  let posed_world = animation.world posed parents
  let $Some mats = animation.skin_matrices posed_world joints inv else:
    use test.holds "check 1" false
    return ()
  let bind_tip = rest_world[2].position
  let m2 = mats[2]
  let skinned = math.vec3 (m2.xx * bind_tip.x + m2.yx * bind_tip.y + m2.zx * bind_tip.z + m2.wx) (m2.xy * bind_tip.x + m2.yy * bind_tip.y + m2.zy * bind_tip.z + m2.wy) (m2.xz * bind_tip.x + m2.yz * bind_tip.y + m2.zz * bind_tip.z + m2.wz)
  let expected_tip = posed_world[2].position
  let $Some sock = animation.socket posed_world 2 (pose_of (math.vec3 0.5 0.0 0.0) math.identity_quat) else:
    use test.holds "check 1" false
    return ()
  let bad = case animation.socket posed_world 99 (pose_of math.zero3 math.identity_quat) of
    $Nothing => true
    $Some _ => false
  let _v1 = (rest_err < 0.0001)
  use test.holds "check 1" _v1
  let _v2 = 0.0002
  let _v3 = #[expected_tip.x, expected_tip.y, expected_tip.z]
  let _v4 = #[skinned.x, skinned.y, skinned.z]
  use test.near_array "check 2" _v2 _v3 _v4
  let _v5 = 0.0002
  let _v6 = #[0.5]
  let _v7 = #[vector.Vec3.length (sock.position - expected_tip)]
  use test.near_array "check 3" _v5 _v6 _v7
  use test.holds "check 4" bad
  return ()

@[test.suite]
test "fabrik and ccd preserve bone lengths and reach targets":
  let chain = #[math.zero3, math.vec3 0.0 1.0 0.0, math.vec3 0.0 2.0 0.0, math.vec3 0.0 3.0 0.0, math.vec3 0.0 4.0 0.0]
  let empty_limits: #[F32] = #[]
  let target = math.vec3 2.0 1.5 1.0
  let $Some solved = ik.fabrik chain target (math.vec3 0.0 0.0 1.0) empty_limits 24 0.0001 1.0 else:
    use test.holds "check 1" false
    return ()
  let len_err = 0.0
  for i in 0 .. 4:
    len_err := max self (abs (vector.Vec3.length (solved[i + 1] - solved[i]) - 1.0))
  let reach_err = vector.Vec3.length (solved[4] - target)
  // Unreachable target straightens along direction.
  let far = math.vec3 10.0 0.0 0.0
  let $Some stretched = ik.fabrik chain far math.zero3 empty_limits 8 0.001 1.0 else:
    use test.holds "check 1" false
    return ()
  // Cone-limited chain never violates per-joint bend angle.
  let cone_limits = #[0.0, 0.35, 0.35, 0.35, 0.0]
  let $Some limited = ik.fabrik chain (math.vec3 2.5 0.5 0.0) (math.vec3 0.0 0.0 1.0) cone_limits 20 0.001 1.0 else:
    use test.holds "check 1" false
    return ()
  let worst_bend = 0.0
  for i in 1 .. 4:
    let prev_d = vector.Vec3.normalized (limited[i] - limited[i - 1])
    let next_d = vector.Vec3.normalized (limited[i + 1] - limited[i])
    let ang = math.atan2 (vector.Vec3.length (vector.Vec3.cross prev_d next_d)) (vector.Vec3.dot prev_d next_d)
    worst_bend := max self ang
  // Chain rotations map rest directions onto solved directions.
  let rest_rots = #[math.identity_quat, math.identity_quat, math.identity_quat, math.identity_quat, math.identity_quat]
  let $Some rots = ik.chain_rotations chain solved rest_rots else:
    use test.holds "check 1" false
    return ()
  let rot_err = 0.0
  for i in 0 .. 4:
    let got_d = math.Quat.rotate rots[i] math.up
    let want_d = vector.Vec3.normalized (solved[i + 1] - solved[i])
    rot_err := max self (vector.Vec3.length (got_d - want_d))
  // CCD reaches target and respects joint limits.
  let $Some ccd_out = ik.ccd chain rest_rots target empty_limits 24 0.0005 1.0 else:
    use test.holds "check 1" false
    return ()
  let ccd_reach = vector.Vec3.length (ccd_out.positions[4] - target)
  let ccd_len_err = 0.0
  for i in 0 .. 4:
    ccd_len_err := max self (abs (vector.Vec3.length (ccd_out.positions[i + 1] - ccd_out.positions[i]) - 1.0))
  let _v8 = (len_err < 0.0001 and reach_err < 0.002)
  use test.holds "check 1" _v8
  let _v9 = 0.0002
  let _v10 = #[4.0, 0.0, 0.0]
  let _v11 = #[stretched[4].x, stretched[4].y, stretched[4].z]
  use test.near_array "check 2" _v9 _v10 _v11
  let _v12 = (worst_bend <= 0.351)
  use test.holds "check 3" _v12
  let _v13 = (rot_err < 0.0005)
  use test.holds "check 4" _v13
  let _v14 = (ccd_reach < 0.01 and ccd_len_err < 0.0002)
  use test.holds "check 5" _v14
  return ()

@[test.suite]
test "inertialization is continuous and converges":
  let src0 = #[pose_of (math.vec3 0.0 0.0 0.0) math.identity_quat]
  let src1 = #[pose_of (math.vec3 0.1 0.0 0.0) (math.axis_angle math.up 0.1)]
  let tgt0 = #[pose_of (math.vec3 2.0 1.0 (-1.0)) (math.axis_angle math.right 1.2)]
  let tgt1 = #[pose_of (math.vec3 2.0 1.0 (-1.0)) (math.axis_angle math.right 1.2)]
  let dt = 1.0 / 60.0
  let $Some sv = inertialize.pose_velocity src0 src1 dt else:
    use test.holds "check 1" false
    return ()
  let $Some tv = inertialize.pose_velocity tgt0 tgt1 dt else:
    use test.holds "check 1" false
    return ()
  let state = inertialize.empty 1
  let (ok_tr, state) = inertialize.transition src1 sv tgt1 tv state
  // At dt = 0 the output must match source_pose exactly (zero pop).
  let (ok0, out0, state) = inertialize.step 0.1 0.0 tgt1 state
  let start_pos_err = vector.Vec3.length (out0[0].position - src1[0].position)
  let start_rot_dot = abs (math.Quat.dot out0[0].rotation src1[0].rotation)
  // Step 120 frames (2 seconds >> halflife 0.1s): must converge to target.
  let out = out0
  for 0 .. 120:
    let (ok_s, p, next_state) = inertialize.step 0.1 dt tgt1 state
    state := next_state
    out := p
  let end_pos_err = vector.Vec3.length (out[0].position - tgt1[0].position)
  let end_rot_dot = abs (math.Quat.dot out[0].rotation tgt1[0].rotation)
  // Zero halflife snaps cleanly.
  let (ok_snap, snapped, state) = inertialize.step 0.0 dt src0 state
  let _v15 = (ok_tr and ok0 and ok_snap)
  use test.holds "check 1" _v15
  let _v16 = (start_pos_err < 0.0001 and start_rot_dot > 0.9999)
  use test.holds "check 2" _v16
  let _v17 = (end_pos_err < 0.0005 and end_rot_dot > 0.9999)
  use test.holds "check 3" _v17
  let _v18 = 0.0001
  let _v19 = #[0.0, 0.0, 0.0]
  let _v20 = #[snapped[0].position.x, snapped[0].position.y, snapped[0].position.z]
  use test.near_array "check 4" _v18 _v19 _v20
  return ()

@[test.suite]
test "secondary bones preserve lengths and respect colliders":
  let rest_pos = #[math.vec3 0.0 2.0 0.0, math.vec3 0.0 1.5 0.0, math.vec3 0.0 1.0 0.0, math.vec3 0.0 0.5 0.0]
  let radii = #[0.0, 0.05, 0.05, 0.05]
  let dirs = #[math.vec3 0.0 (-1.0) 0.0, math.vec3 0.0 (-1.0) 0.0, math.vec3 0.0 (-1.0) 0.0]
  let $Some nodes = secondary.init rest_pos radii else:
    use test.holds "check 1" false
    return ()
  let params = $secondary.Params {
    stiffness: 4.0,
    damping: 0.05,
    gravity: math.vec3 0.0 (-9.8) 0.0,
    wind: math.vec3 6.0 0.0 0.0,
    max_angle: 1.2,
    iterations: 6,
  }
  let sphere = $secondary.Sphere { center: math.vec3 (-0.1) 1.0 0.0, radius: 0.4 }
  let colliders = #[sphere]
  for 0 .. 40:
    let (ok, next) = secondary.step params (1.0 / 60.0) (math.vec3 0.0 2.0 0.0) math.identity_quat dirs colliders nodes
    nodes := next
  let len_err = 0.0
  let pen_err = 0.0
  for i in 1 .. 4:
    len_err := max self (abs (vector.Vec3.length (nodes[i].position - nodes[i - 1].position) - 0.5))
    let dist = vector.Vec3.length (nodes[i].position - math.vec3 (-0.1) 1.0 0.0)
    if dist < 0.45:
      pen_err := max self (0.45 - dist)
  let rots = secondary.rotations nodes dirs math.identity_quat
  // Sphere behind (-0.1) + wind (+X) pushes tail decisively to +X while keeping exact lengths and zero penetration.
  let _v21 = (len_err < 0.0005)
  use test.holds "check 1" _v21
  let _v22 = (pen_err < 0.002)
  use test.holds "check 2" _v22
  let _v23 = (nodes[3].position.x > 0.2)
  use test.holds "check 3" _v23
  let _v24 = (rots.length == 3)
  use test.holds "check 4" _v24
  return ()

@[test.suite]
test "retargeting transfers world delta and scales root":
  let none = 4294967295
  let src_rig = $retarget.Rig {
    parents: #[none, 0],
    rest: #[pose_of (math.vec3 0.0 1.0 0.0) math.identity_quat, pose_of (math.vec3 0.0 0.5 0.0) math.identity_quat],
  }
  // Target rig has a 90-degree-rotated rest bone and taller hips (2.0 vs 1.0).
  let tgt_rig = $retarget.Rig {
    parents: #[none, 0],
    rest: #[pose_of (math.vec3 0.0 2.0 0.0) math.identity_quat, pose_of (math.vec3 0.0 1.0 0.0) (math.axis_angle math.right 1.5707963)],
  }
  let mappings = #[$retarget.Mapping { source_bone: 0, target_bone: 0 }, $retarget.Mapping { source_bone: 1, target_bone: 1 }]
  let turn = math.axis_angle math.up 0.7
  let src_pose = #[pose_of (math.vec3 0.0 1.25 0.0) math.identity_quat, pose_of (math.vec3 0.0 0.5 0.0) turn]
  let $Some out = retarget.retarget src_rig tgt_rig mappings src_pose 0 0 2.0 else:
    use test.holds "check 1" false
    return ()
  let out_world = retarget.world_rotations out tgt_rig.parents
  let tgt_rest_w = retarget.world_rotations tgt_rig.rest tgt_rig.parents
  let expected_w = math.Quat.normalized (turn * tgt_rest_w[1])
  let dot_w = abs (math.Quat.dot out_world[1] expected_w)
  // Root moved +0.25 on source -> +0.50 on target -> y = 2.50.
  let _v25 = 0.0005
  let _v26 = #[0.0, 2.5, 0.0]
  let _v27 = #[out[0].position.x, out[0].position.y, out[0].position.z]
  use test.near_array "check 1" _v25 _v26 _v27
  let _v28 = (dot_w > 0.9999)
  use test.holds "check 2" _v28
  return ()

@[test.suite]
test "motion matching bias and standardization":
  let make = func (speed: F32) => $motion_match.Feature {
    foot_l: math.vec3 (-0.2) 0.0 0.0,
    foot_r: math.vec3 0.2 0.0 0.0,
    vel_l: math.vec3 0.0 0.0 speed,
    vel_r: math.vec3 0.0 0.0 speed,
    hip_vel: math.vec3 0.0 0.0 speed,
    traj_pos0: math.vec3 0.0 0.0 (speed * 0.2),
    traj_dir0: math.forward,
    traj_pos1: math.vec3 0.0 0.0 (speed * 0.4),
    traj_dir1: math.forward,
    traj_pos2: math.vec3 0.0 0.0 (speed * 0.6),
    traj_dir2: math.forward,
  }
  let db = #[make 0.0, make 2.0, make 4.0, make 6.0]
  let query = make 3.9
  let $Some m1 = motion_match.search db query motion_match.default_weights 4294967295 1.0 else:
    use test.holds "check 1" false
    return ()
  // With strong continuing bias on index 1 and a mid-way query (3.05), prefer staying on 1.
  let mid = make 2.9
  let $Some m_stay = motion_match.search db mid motion_match.default_weights 1 0.5 else:
    use test.holds "check 1" false
    return ()
  let $Some (mean, std) = motion_match.stats db else:
    use test.holds "check 1" false
    return ()
  let z0 = motion_match.standardize mean std db[0]
  let z3 = motion_match.standardize mean std db[3]
  let _v29 = #[2, 1]
  let _v30 = #[m1.index, if m1.changed then 1 else 0]
  use test.eq "check 1" _v29 _v30
  let _v31 = #[1, 0]
  let _v32 = #[m_stay.index, if m_stay.changed then 1 else 0]
  use test.eq "check 2" _v31 _v32
  let _v33 = 0.0005
  let _v34 = #[3.0]
  let _v35 = #[mean.hip_vel.z]
  use test.near_array "check 3" _v33 _v34 _v35
  let _v36 = (z0.hip_vel.z < 0.0 and z3.hip_vel.z > 0.0 and abs (z0.hip_vel.z + z3.hip_vel.z) < 0.001)
  use test.holds "check 4" _v36
  return ()

@[test.suite]
test "morph targets top k and sparse blending":
  let top = morph.top_k #[0.1, (-0.8), 0.5, 0.001, 0.8, 0.3] 3 0.05
  // Ties by lower index: index 1 (-0.8) precedes index 4 (0.8), then index 2 (0.5).
  let base_p = #[math.vec3 0.0 0.0 0.0, math.vec3 1.0 0.0 0.0]
  let base_n = #[math.up, math.up]
  let targets = #[$morph.Target { start: 0, count: 1 }, $morph.Target { start: 1, count: 1 }]
  let deltas = #[
    $morph.Delta { vertex: 0, position: math.vec3 0.0 2.0 0.0, normal: math.vec3 1.0 0.0 0.0 },
    $morph.Delta { vertex: 1, position: math.vec3 0.0 0.0 4.0, normal: math.vec3 0.0 (-1.0) 0.0 },
  ]
  let $Some (pos, nrm) = morph.apply base_p base_n targets deltas #[0.5, 1.0] else:
    use test.holds "check 1" false
    return ()
  // Vertex 1 normal cancels to zero -> falls back to base_n[1] (0, 1, 0).
  let blended = morph.blend_weights #[0.0, 1.0] #[1.0, 0.0, 0.5] 0.5
  let _v37 = #[3, 1, 4, 2]
  let _v38 = #[top.length, top[0].target, top[1].target, top[2].target]
  use test.eq "check 1" _v37 _v38
  let _v39 = 0.0002
  let _v40 = #[0.0, 1.0, 0.0, 1.0, 0.0, 4.0]
  let _v41 = #[pos[0].x, pos[0].y, pos[0].z, pos[1].x, pos[1].y, pos[1].z]
  use test.near_array "check 2" _v39 _v40 _v41
  let _v42 = 0.0002
  let _v43 = #[0.0, 1.0, 0.0]
  let _v44 = #[nrm[1].x, nrm[1].y, nrm[1].z]
  use test.near_array "check 3" _v42 _v43 _v44
  let _v45 = 0.0001
  let _v46 = #[1.0]
  let _v47 = #[vector.Vec3.length nrm[0]]
  use test.near_array "check 4" _v45 _v46 _v47
  let _v48 = 0.0001
  let _v49 = #[0.5, 0.5, 0.25]
  use test.near_array "check 5" _v48 _v49 blended
  return ()
