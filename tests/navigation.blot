import * as navigation from "ink/navigation"
import * as array from "std/array"

entry func path (input: Array F32) : Array F32 => return do:
  let width = F32.to_u32 input[0]
  let height = F32.to_u32 input[1]
  let costs = @array.generate (input.length - 5) (func (i: U32) => return input[i + 5])
  let $Some g = navigation.grid width height (costs.view 0 costs.length) else:
    return #[-2.0]
  let cells: ResizeArray U32 = #[]
  let $Some p = navigation.astar_into cells g (F32.to_u32 input[2]) (F32.to_u32 input[3]) (F32.to_u32 input[4]) else:
    return #[-1.0]
  return array.concat #[p.cost, U32.to_f32 p.expanded] (@array.generate p.cells.length (func (i: U32) => return U32.to_f32 p.cells[i]))

entry func field (input: Array F32) : Array F32 => return do:
  let costs = @array.generate (input.length - 3) (func (i: U32) => return input[i + 3])
  let $Some g = navigation.grid (F32.to_u32 input[0]) (F32.to_u32 input[1]) (costs.view 0 costs.length) else:
    return #[]
  let out_costs: ResizeArray F32 = #[]
  let out_next: ResizeArray U32 = #[]
  let result = navigation.flow_into out_costs out_next g (F32.to_u32 input[2])
  return array.concat (array.generate result.costs.length (func i => return result.costs[i])) (@array.generate result.next.length (func (i: U32) => return U32.to_f32 result.next[i]))

entry func large (size: U32) : Array F32 => return do:
  let costs = @array.fill (size * size) 1.0
  let $Some g = navigation.grid size size (costs.view 0 costs.length) else:
    return #[]
  let cells: ResizeArray U32 = #[]
  let $Some path = navigation.astar_into cells g 0 (size * size - 1) (size * size) else:
    return #[]
  return #[path.cost, U32.to_f32 path.expanded, U32.to_f32 path.cells.length]
entry func large_flow (size: U32) : F32 => return do:
  let costs = @array.fill (size * size) 1.0
  let $Some g = navigation.grid size size (costs.view 0 costs.length) else:
    return 0.0
  let out_costs: ResizeArray F32 = #[]
  let out_next: ResizeArray U32 = #[]
  let result = navigation.flow_into out_costs out_next g (size * size - 1)
  return result.costs[0]

entry func heap_flow (size: U32) : F32 => return do:
  let costs = @array.fill (size * size) 1.0
  let $Some g = navigation.grid size size (costs.view 0 costs.length) else:
    return 0.0
  return navigation.with_search g (size * size - 1) (size * size - 1) true (size * size) (func (result: navigation.Field) -> slots => return result.costs[0])
