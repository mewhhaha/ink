import * as navigation from "ink/navigation"
import * as array from "std/array"

entry const path = fn (input: Array F32) -> Array F32 => do:
  let width = F32.to_u32 input[0]
  let height = F32.to_u32 input[1]
  let costs = @array.generate (input.length - 5) (fn (i: U32) => input[i + 5])
  let #Some g = navigation.grid width height costs else:
    return #[-2.0]
  let #Some p = navigation.astar g (F32.to_u32 input[2]) (F32.to_u32 input[3]) (F32.to_u32 input[4]) else:
    return #[-1.0]
  return array.concat #[p.cost, U32.to_f32 p.expanded] (@array.generate p.cells.length (fn (i: U32) => U32.to_f32 p.cells[i]))

entry const field = fn (input: Array F32) -> Array F32 => do:
  let costs = @array.generate (input.length - 3) (fn (i: U32) => input[i + 3])
  let #Some g = navigation.grid (F32.to_u32 input[0]) (F32.to_u32 input[1]) costs else:
    return #[]
  let result = navigation.flow g (F32.to_u32 input[2])
  return array.concat result.costs (@array.generate result.next.length (fn (i: U32) => U32.to_f32 result.next[i]))

entry const large = fn (size: U32) -> Array F32 => do:
  let costs = @array.fill (size * size) 1.0
  let #Some g = navigation.grid size size costs else:
    return #[]
  let #Some path = navigation.astar g 0 (size * size - 1) (size * size) else:
    return #[]
  return #[path.cost, U32.to_f32 path.expanded, U32.to_f32 path.cells.length]
entry const large_flow = fn (size: U32) -> F32 => do:
  let #Some g = navigation.grid size size (@array.fill (size * size) 1.0) else:
    return 0.0
  let result = navigation.flow g (size * size - 1)
  return result.costs[0]
