import * as simd from "std/simd"
import * as test from "std/test"
import * as text from "std/text"

// Exact IEEE-754 bit pattern of an F32 scalar.
func word (value: F32): U32 =>
  let (bits, _, _, _) = simd.f32_bits (value, 0.0, 0.0, 0.0)
  return bits

// Pure boolean bit-for-bit equality for F32 arrays.
func bits_equal (expected: #[F32]) -> (actual: #[F32]): Bool =>
  if expected.length != actual.length:
    return false
  for i in 0 .. expected.length:
    let (eb, ab, _, _) = simd.f32_bits (expected[i], actual[i], 0.0, 0.0)
    if eb != ab:
      return false
  return true

// Pure boolean tolerance equality for F32 arrays.
func near_equal (tolerance: F32) -> (expected: #[F32]) -> (actual: #[F32]): Bool =>
  if expected.length != actual.length:
    return false
  for i in 0 .. expected.length:
    let exact = expected[i] == actual[i]
    if not (exact or abs (expected[i] - actual[i]) <= tolerance):
      return false
  return true

// Assert two F32 arrays match bit-for-bit (distinguishing -0.0, NaNs, and ULP).
func bits_array (label: Text) -> (expected: #[F32]) -> (actual: #[F32]): Unit ! { test.Test } =>
  let elen = expected.length
  let alen = actual.length
  if elen != alen:
    use test.eq label elen alen
    return ()
  for i in 0 .. elen:
    let (eb, ab, _, _) = simd.f32_bits (expected[i], actual[i], 0.0, 0.0)
    if eb != ab:
      use test.bits_eq (text.concat label (text.concat " #" (text.from_u32 i))) expected[i] actual[i]
      return ()
  use test.holds label true
  return ()
