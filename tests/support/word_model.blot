// Static fixture schema. Every payload column has a separate named owner.
import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as words from "ink/persist/words"
import * as persist from "ink/persist"
import * as codec from "ink/codec"
import * as m from "../fixtures/derived/model_derived"
type Counter is data = $Counter U32
func counter_encode (counter:Counter) => return do:
  let $Counter value=counter
  return #[value]
func counter_decode (values:Array U32) => return if values.length==1 then $Some ($Counter values[0]) else $Nothing
func migrate_counter (version:U32) -> (values:Array U32) => return if version==0 then $Some #[values[0]+100] else $Nothing
const counter_codec=codec.saved 4294967293 4294967295 counter_encode counter_decode migrate_counter
const site_codec=m.site_words codec.no_migration
const delivery_codec=m.delivery_words codec.no_migration
const town_codec=m.town_words codec.no_migration
const empty_town= $m.Town {sites_start:0,sites_count:0,deliveries_start:0,deliveries_count:0}
func site (id:U32) => return $m.Site {ring:4294967295,sector:16777217,kind:id,age:-0.0,work:100,impact:0.375,delivered:4}
func with_model consume => return do:
  let alive:ecs.Entities=ecs.entities ()
  let alive_meta=ecs.metadata 1
  let current:ecs.Pool m.Site=ecs.pool ()
  let current_meta=ecs.metadata 1
  let previous:ecs.Pool m.Site=ecs.pool ()
  let previous_meta=ecs.metadata 1
  let deliveries:ecs.Pool m.Delivery=ecs.pool ()
  let deliveries_meta=ecs.metadata 1
  let counter=#[$Counter 7]
  let counter_previous=#[$Counter 7]
  let town=#[empty_town]
  let site_payload:ResizeArray m.Site=#[]
  let delivery_payload:ResizeArray m.Delivery=#[]
  let outcomes:ResizeArray persist.Outcome=#[]
  return consume {alive,alive_meta,current,current_meta,previous,previous_meta,deliveries,deliveries_meta,counter,counter_previous,town,site_payload,delivery_payload,outcomes}
func initialize access -> (count:U32) => return do:
  access.site_payload.push (site 4294967295)
  access.delivery_payload.push ($m.To {home:4294967295,amount:$m.Positive 7})
  access.town[0] = $m.Town {sites_start:0,sites_count:1,deliveries_start:0,deliveries_count:1}
  for id in 0 .. count:
    let entity=ecs.spawn access.alive access.alive_meta
    ecs.insert access.alive access.current access.current_meta entity (site id)
  ecs.checkpoint identity access.previous access.current
  access.counter_previous[0] = access.counter[0]
  access.counter[0] = $Counter 9
  for id in 0 .. count:
    ecs.write access.current access.current_meta id (site (id+10))
  if count>0:
    ecs.insert access.alive access.deliveries access.deliveries_meta 0 ($m.To {home:4294967295,amount:$m.Positive 9})
func encode_rows (encode:a -> Array U32) -> rows => return do:
  let output:GrowArray U32=#[rows.length]
  for row in rows:
    let encoded=encode row
    output.push encoded.length
    array.append_into output encoded
  return @storage.freeze output
func decode_rows_into (decode:Array U32 -> Maybe a) -> (encoded:Array U32) -> (rows:ResizeArray a) => return do:
  if encoded.length==0 or encoded[0]>encoded.length-1:
    @panic "invalid model payload column"
  let decoded:GrowArray a=#[]
  let at=1
  for 0 .. encoded[0]:
    if at>=encoded.length:
      @panic "invalid model payload row"
    let count=encoded[at]
    at := at+1
    if count>encoded.length-at:
      @panic "invalid model payload row length"
    let $Some value=decode (array.slice at count encoded) else:
      @panic "invalid model payload value"
    decoded.push value
    at := at+count
  if at!=encoded.length:
    @panic "trailing model payload words"
  rows.truncate 0
  for row in decoded:
    rows.push row
func valid_span start -> count -> length => return start<=length and count<=length-start
func validate access => return do:
  let town=access.town[0]
  if Bool.not (valid_span town.sites_start town.sites_count access.site_payload.length and valid_span town.deliveries_start town.deliveries_count access.delivery_payload.length):
    @panic "model town span is outside payload"
  for delivery in access.delivery_payload:
    if let $m.Batch {sites_start,sites_count}=delivery:
      if Bool.not (valid_span sites_start sites_count access.site_payload.length):
        @panic "model delivery span is outside payload"
  for row in access.deliveries:
    if let $Some ($m.Batch {sites_start,sites_count})=row:
      if Bool.not (valid_span sites_start sites_count access.site_payload.length):
        @panic "model component span is outside payload"
func write_schema counter_type -> access -> sections -> payload => return do:
  words.write_alive access.alive sections payload
  words.write_snapshotted_resource counter_type access.counter[0] access.counter_previous[0] sections payload
  words.write_resource town_codec access.town[0] sections payload
  words.write_snapshotted_component site_codec access.current access.previous sections payload
  words.write_component delivery_codec access.deliveries sections payload
  words.append_section 103 1 (encode_rows site_codec.encode access.site_payload) sections payload
  words.append_section 104 1 (encode_rows delivery_codec.encode access.delivery_payload) sections payload
func encode_state_using counter_type -> access => return do:
  let sections:ResizeArray words.Section=#[]
  let payload:ResizeArray U32=#[]
  let output:ResizeArray U32=#[]
  write_schema counter_type access sections payload
  words.frame words.magic 4294967295 sections payload output
  return @storage.freeze output
const encode_state=encode_state_using counter_codec
func read_payload (key:U32) -> (decode:Array U32 -> Maybe a) -> (destination:ResizeArray a) -> (sections:ResizeArray words.Section) -> (values:Array U32) -> (outcomes:ResizeArray persist.Outcome) => return do:
  let $Some section=words.find key sections else:
    destination.truncate 0
    outcomes.push ($persist.Outcome {key,fate:$persist.Missing,saved:0,version:1})
    return ()
  if section.version!=1:
    destination.truncate 0
    outcomes.push ($persist.Outcome {key,fate:$persist.Reset,saved:section.version,version:1})
    return ()
  decode_rows_into decode (words.section_words section values) destination
  outcomes.push ($persist.Outcome {key,fate:$persist.Kept,saved:1,version:1})
func read_schema access -> sections -> values => return do:
  access.outcomes.truncate 0
  words.restore_alive sections values access.alive access.alive_meta access.outcomes
  words.restore_snapshotted_resource counter_codec ($Counter 7) access.counter access.counter_previous sections values access.outcomes
  words.restore_resource town_codec empty_town access.town sections values access.outcomes
  words.restore_snapshotted_component site_codec access.alive access.current access.current_meta access.previous access.previous_meta sections values access.outcomes
  words.restore_component delivery_codec access.alive access.deliveries access.deliveries_meta sections values access.outcomes
  read_payload 103 site_codec.decode access.site_payload sections values access.outcomes
  read_payload 104 delivery_codec.decode access.delivery_payload sections values access.outcomes
  validate access
  persist.dropped sections access.outcomes
func decode_state access -> (saved:Array U32) => return do:
  let sections:ResizeArray words.Section=#[]
  words.split words.magic 4294967295 saved sections
  read_schema access sections saved
func encode_scene access => return do:
  let sections:ResizeArray words.Section=#[]
  let payload:ResizeArray U32=#[]
  let output:ResizeArray U32=#[]
  words.write_alive access.alive sections payload
  words.write_component site_codec access.current sections payload
  words.write_component delivery_codec access.deliveries sections payload
  words.append_section 103 1 (encode_rows site_codec.encode access.site_payload) sections payload
  words.frame words.scene_magic 4294967295 sections payload output
  return @storage.freeze output
// Scene payloads append into the current arena, preserving resource spans.
func decode_scene access -> (saved:Array U32) => return do:
  let sections:ResizeArray words.Section=#[]
  words.split words.scene_magic 4294967295 saved sections
  access.outcomes.truncate 0
  words.restore_alive sections saved access.alive access.alive_meta access.outcomes
  words.restore_component site_codec access.alive access.current access.current_meta sections saved access.outcomes
  ecs.checkpoint identity access.previous access.current
  words.restore_component delivery_codec access.alive access.deliveries access.deliveries_meta sections saved access.outcomes
  let decoded:ResizeArray m.Site=#[]
  read_payload 103 site_codec.decode decoded sections saved access.outcomes
  let base=access.site_payload.length
  for row in decoded:
    access.site_payload.push row
  for id in 0 .. access.deliveries.length:
    if let $Some ($m.Batch {sites_start,sites_count})=access.deliveries[id]:
      if Bool.not (valid_span sites_start sites_count decoded.length):
        @panic "scene model span is outside payload"
      access.deliveries[id] = $Some ($m.Batch {sites_start:base+sites_start,sites_count})
  validate access
const counter_bridge=codec.bridge 1 1 0 counter_encode counter_decode codec.no_migration
const site_bridge=m.site_codec codec.no_migration
const delivery_bridge=codec.bridge 101 2 32 delivery_codec.encode delivery_codec.decode codec.no_migration
const town_bridge=m.town_codec codec.no_migration
func encode_bridge_state access => return do:
  let sections:ResizeArray persist.Section=#[]
  let payload:ResizeArray F32=#[]
  let output:ResizeArray F32=#[]
  persist.write_alive access.alive sections payload
  persist.write_snapshotted_resource counter_bridge access.counter[0] access.counter_previous[0] sections payload
  persist.write_resource town_bridge access.town[0] sections payload
  persist.write_snapshotted_component site_bridge 66 access.alive access.current access.previous sections payload
  persist.write_component delivery_bridge 66 access.deliveries sections payload
  persist.append_section 103 1 0 (codec.pack 0 (encode_rows site_codec.encode access.site_payload)) sections payload
  persist.append_section 104 1 0 (codec.pack 0 (encode_rows delivery_codec.encode access.delivery_payload)) sections payload
  persist.frame_sections persist.magic 1 sections payload output
  return @storage.freeze output
func read_bridge_payload (key:U32) -> (decode:Array U32 -> Maybe a) -> (destination:ResizeArray a) -> (sections:ResizeArray persist.Section) -> (values:Array F32) -> (outcomes:ResizeArray persist.Outcome) => return do:
  let $Some section=persist.find key sections else:
    destination.truncate 0
    return ()
  let $Some encoded=codec.unpack 0 (persist.section_values section values) else:
    @panic "invalid bridged model payload"
  decode_rows_into decode encoded destination
  outcomes.push ($persist.Outcome {key,fate:$persist.Kept,saved:section.version,version:1})
func decode_bridge_state access -> (saved:Array F32) => return do:
  let sections:ResizeArray persist.Section=#[]
  persist.parse_sections persist.magic 1 saved sections
  access.outcomes.truncate 0
  persist.restore_alive sections saved access.alive access.alive_meta access.outcomes
  persist.restore_snapshotted_resource counter_bridge ($Counter 7) access.counter access.counter_previous sections saved access.outcomes
  persist.restore_resource town_bridge empty_town access.town sections saved access.outcomes
  persist.restore_snapshotted_component site_bridge 66 identity access.alive access.current access.current_meta access.previous access.previous_meta sections saved access.outcomes
  persist.restore_component delivery_bridge 66 access.alive access.deliveries access.deliveries_meta sections saved access.outcomes
  read_bridge_payload 103 site_codec.decode access.site_payload sections saved access.outcomes
  read_bridge_payload 104 delivery_codec.decode access.delivery_payload sections saved access.outcomes
  validate access
