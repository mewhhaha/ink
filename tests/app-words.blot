import * as test from "std/test"
import * as app from "ink/app"
import * as array from "std/array"
import * as clock from "ink/clock"
import * as keyed from "ink/derived/keyed"
import * as codec from "ink/codec"
import * as ecs from "ink/ecs"
import * as input from "ink/input"
import * as words from "ink/persist/words"
import * as persist from "ink/persist"
type Identity is data = $Identity U32
type Item is data = $Item U32
const identity_codec = codec.saved 0xFFFFFFFF 1 (func (value: Identity) =>
  let $Identity value = value
  return #[value]) (func (values: #[U32]) => if values.length == 1 then $Some ($Identity values[0]) else $Nothing) codec.no_migration
const item_codec = codec.saved 0x80000000 1 (func (value: Item) =>
  let $Item value = value
  return #[value]) (func (values: #[U32]) => if values.length == 1 then $Some ($Item values[0]) else $Nothing) codec.no_migration
func checkpoint (own access) =>
  access.previous_identity[0] := access.identity[0]
  access.previous_items := ecs.checkpoint identity self access.items
  return access
func update (own access) -> (seconds:F32) =>
  let $Identity value=access.identity[0]
  access.identity[0] := $Identity (value-1)
  return access
const application=app.stages app.no_action app.no_action app.no_action checkpoint app.route_event
  app.no_event app.no_event update app.no_render app.no_action
const policy= $clock.Policy {step_seconds:0.01,max_elapsed:0.1,max_steps:10}
func with_columns consume =>
  let alive:ecs.Entities=ecs.entities ()
  let meta=ecs.metadata 1
  let value=#[$Identity 0xFFFFFFFF]
  let previous_identity=#[$Identity 0xFFFFFFFF]
  let items:ecs.Pool Item=ecs.pool ()
  let item_meta=ecs.metadata 1
  let previous_items:ecs.Pool Item=ecs.pool ()
  let previous_meta=ecs.metadata 1
  let current=#[clock.clock]
  let control=app.control ()
  let wall=app.wall ()
  let access={alive,meta,identity:value,previous_identity,items,item_meta,previous_items,previous_meta,clock:current,control,wall}
  return consume (own access)
func encode_state access =>
  let w = words.writer ()
  w := words.write_alive access.alive self
  w := words.write_snapshotted_resource identity_codec access.identity[0] access.previous_identity[0] self
  w := words.write_snapshotted_component item_codec access.items access.previous_items self
  return words.frame words.magic 19 w #[]
func decode_state (own access) -> saved =>
  let sections = words.split words.magic 19 saved #[]
  let (alive, meta, _) = words.restore_alive sections saved access.alive access.meta
  access.alive := alive
  access.meta := meta
  let (current, previous, _) = words.restore_snapshotted_resource identity_codec ($Identity 0xFFFFFFFF) access.identity access.previous_identity sections saved
  access.identity := current
  access.previous_identity := previous
  let (items, item_meta, previous_items, previous_meta, _) = words.restore_snapshotted_component item_codec access.alive access.items access.item_meta access.previous_items access.previous_meta sections saved
  access.items := items
  access.item_meta := item_meta
  access.previous_items := previous_items
  access.previous_meta := previous_meta
  return access
#entry func roundtrip (count: U32) => with_columns (func (own access) =>
  access := app.start application access
  let (ids, alive, meta) = ecs.spawn_many access.alive access.meta count
  access.alive := alive
  access.meta := meta
  let (items, item_meta) = ecs.insert_selected access.alive access.items access.item_meta ids (array.generate count (func i => $Item (0x80000000+i)))
  access.items := items
  access.item_meta := item_meta
  let (step, moved) = app.advance application access policy 0.01 #[] 960.0 640.0
  access := moved
  let saved=encode_state access
  return with_columns (func restored =>
    restored := decode_state restored saved
    let again=encode_state restored
    let $Identity id=restored.identity[0]
    let $Identity old=restored.previous_identity[0]
    let sum=0
    let present=ecs.indices restored.alive restored.items
    for entity in present:
      let $Some ($Item item)=ecs.read restored.items entity else:
        panic "restored item membership changed"
      sum := sum+(item-0x80000000)
    return #[id,old,present.length,sum,saved[0],if keyed.same_u32 saved again then 1 else 0]))
@[test.suite]
test "word application saves":
  for count in #[0,1,70,1024]:
    use test.eq "check 1" #[4294967294,4294967295,count,count*(count-1)/2,1229867863,1] (roundtrip count)
  return ()
