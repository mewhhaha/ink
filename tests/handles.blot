import * as check from "./check"
import * as handles from "ink/handles"
import * as array from "std/array"

type Item is data = $Item
func flag value => if value then 1 else 0
func encode (value: U32) => #[value]
func decode (words: #[U32]) => if words.length == 1 then $Some words[0] else $Nothing
entry func test_generation_and_dense_removal () =>
  let values: handles.Store [Item, U32] = handles.empty $Item 3 7 8
  let (first_found, values) = handles.insert $Item 10 values
  let $Some first = first_found else:
    return check.report #[check.words #[1] #[0]]
  let (second_found, values) = handles.insert $Item 20 values
  let $Some second = second_found else:
    return check.report #[check.words #[1] #[0]]
  let (removed, values) = handles.remove first values
  let (replacement_found, values) = handles.insert $Item 30 values
  let $Some replacement = replacement_found else:
    return check.report #[check.words #[1] #[0]]
  return check.report #[check.words #[1, 0, 20, 30, 1] #[flag removed,
    flag (Maybe.is_some (handles.get first values)),
    Maybe.unwrap_or 0 (handles.get second values),
    Maybe.unwrap_or 0 (handles.get replacement values), (handles.encode_handle replacement)[3]]]
entry func test_version_one_save_round_trip () =>
  let values: handles.Store [Item, U32] = handles.empty $Item 3 7 8
  let (_, values) = handles.insert $Item 10 values
  let saved = handles.encode encode values
  let copied: handles.Store [Item, U32] = handles.empty $Item 0 0 0
  let (accepted, copied) = handles.decode $Item decode saved copied
  let (rejected, copied) = handles.decode $Item decode #[2, 3] copied
  return check.report #[check.words #[1, 1, 0, 10, 3, 7] #[saved[0], flag accepted,
    flag rejected, copied.values[0], copied.meta[0], copied.meta[1]]]
entry func test_named_handle_pool () =>
  let values: handles.Store [Item, U32] = handles.empty $Item 3 7 3
  let ids: #[~handles.Handle Item] = handles.handle_pool $Item
  for value in #[10,20,30]:
    let (found, next_values) = handles.insert $Item value values
    values := next_values
    let $Some id = found else:
      return check.report #[check.holds false]
    ids.push id
  let (removed, values) = handles.remove ids[0] values
  let (replacement_found, values) = handles.insert $Item 99 values
  let $Some replacement = replacement_found else:
    return check.report #[check.holds false]
  return check.report #[check.words #[3,1,0,20,30,99] #[ids.length, flag removed,
    flag (Maybe.is_some (handles.get ids[0] values)),
    Maybe.unwrap_or 0 (handles.get ids[1] values),
    Maybe.unwrap_or 0 (handles.get ids[2] values),
    Maybe.unwrap_or 0 (handles.get replacement values)]]

func with_items (count: U32) -> consume =>
  let values: handles.Store [Item, U32] = handles.empty $Item 5 6 count
  let ids = handles.handle_pool $Item
  for i in 0 .. count:
    let (found, next_values) = handles.insert $Item i values
    values := next_values
    let $Some id = found else:
      return panic "handle workload requires every item"
    ids.push id
  return consume (own values) ids

entry func workload (count: U32) : #[U32] => with_items count (func (values: own handles.Store [Item, U32]) -> (ids: #[~handles.Handle Item]) =>
  let before_rows: #[~U32] = copy values.values
  let before_owners: #[~U32] = copy values.owners
  let before_slots: #[~handles.Slot] = copy values.slots
  let before_free: #[~U32] = copy values.free
  let before_meta = values.meta.copy
  let before = handles.store $Item before_rows before_owners before_slots before_free before_meta
  for i in 0 .. count:
    if i % 2 == 1:
      let (removed, next_values) = handles.remove ids[i] values
      values := next_values
      if not removed:
        return panic "workload handle vanished before removal"
  let total = 0
  let old = 0
  for id in ids:
    let $Some previous = handles.get id before else:
      return panic "workload snapshot lost a handle"
    old := self + previous
    if let $Some current = handles.get id values:
      total := self + current
  return #[handles.count values, total, old])

entry func lookups (count: U32) : #[U32] => with_items count (func (values: handles.Store [Item, U32]) -> ids =>
  let total = 0
  for id in ids:
    let $Some item = handles.get id values else:
      return panic "workload handle vanished before lookup"
    total := self + item
  return #[total, handles.count values])

entry func iteration (count: U32) : #[U32] => with_items count (func (values: handles.Store [Item, U32]) -> ids =>
  let total = 0
  for item in handles.values values:
    total := self + item
  return #[total, handles.count values])

entry func dense (count: U32) : #[U32] =>
  let values = array.generate count identity
  let total = 0
  for item in values:
    total := self + item
  return #[total, values.length]

// The dense-index reference scans every saved index after each swap removal.
entry func dense_churn (count: U32) : #[U32] =>
  let before = array.generate count identity
  let values = before.copy
  let references = array.generate count identity
  for removed in 0 .. count:
    if removed % 2 == 1:
      let at = references[removed]
      let last = values.length - 1
      values[at] := values[last]
      values := array.slice 0 last self
      for i in 0 .. references.length:
        if references[i] == at:
          references[i] := 0xFFFFFFFF
        else:
          if references[i] == last:
            references[i] := at
  let total = 0
  let old = 0
  for i in 0 .. count:
    old := self + before[i]
    if references[i] != 0xFFFFFFFF:
      total := self + values[references[i]]
  return #[values.length, total, old]
