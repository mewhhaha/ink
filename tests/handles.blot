import * as check from "./check"
import * as handles from "ink/handles"

type Item is data = $Item
const flag = func value => return if value then 1 else 0
const encode = func (value: U32) => return #[value]
const decode = func (words: Array U32) => return if words.length == 1 then $Some words[0] else $Nothing
entry const test_generation_and_dense_removal = func () => return do:
  let values: handles.Store [Item, U32] = handles.empty ()
  let owners: ResizeArray U32 = #[]
  let slots: ResizeArray handles.Slot = #[]
  let free: ResizeArray U32 = #[]
  let meta = handles.metadata 3 7 8
  let $Some first = handles.insert $Item 10 values owners slots free meta else:
    return check.report #[check.words #[1] #[0]]
  let $Some second = handles.insert $Item 20 values owners slots free meta else:
    return check.report #[check.words #[1] #[0]]
  let removed = handles.remove first values owners slots free meta
  let $Some replacement = handles.insert $Item 30 values owners slots free meta else:
    return check.report #[check.words #[1] #[0]]
  return check.report #[check.words #[1, 0, 20, 30, 1] #[flag removed,
    flag (Maybe.is_some (handles.get first values slots meta)),
    Maybe.unwrap_or 0 (handles.get second values slots meta),
    Maybe.unwrap_or 0 (handles.get replacement values slots meta), (handles.encode_handle replacement)[3]]]
entry const test_version_one_save_round_trip = func () => return do:
  let values: handles.Store [Item, U32] = handles.empty ()
  let owners: ResizeArray U32 = #[]
  let slots: ResizeArray handles.Slot = #[]
  let free: ResizeArray U32 = #[]
  let meta = handles.metadata 3 7 8
  let unused = handles.insert $Item 10 values owners slots free meta
  let saved = handles.encode encode values owners slots free meta
  let copied: handles.Store [Item, U32] = handles.empty ()
  let copied_owners: ResizeArray U32 = #[]
  let copied_slots: ResizeArray handles.Slot = #[]
  let copied_free: ResizeArray U32 = #[]
  let copied_meta = handles.metadata 0 0 0
  let accepted = handles.decode $Item decode saved copied copied_owners copied_slots copied_free copied_meta
  let rejected = handles.decode $Item decode #[2, 3] copied copied_owners copied_slots copied_free copied_meta
  return check.report #[check.words #[1, 1, 0, 10, 3, 7] #[saved[0], flag accepted,
    flag rejected, copied[0], copied_meta[0], copied_meta[1]]]
