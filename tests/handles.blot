import * as h from "ink/handles"
import * as array from "std/array"

type Building is data = #Building
type Pile is data = #Pile
const encode_value = fn (v: U32) => #[v]
const decode_value = fn (v: Array U32) => if v.length == 1 then #Some v[0] else #Nothing
const value = fn handle => fn store => case h.get handle store of
  #Some v => v
  #Nothing => 999

entry const lifecycle = fn () => do:
  let (before, ids) = h.from_dense #Building 41 100 #[10, 20, 30]
  let #Some removed = h.remove ids[1] before else:
    return #[]
  let #Some (after, added) = h.insert 40 removed else:
    return #[]
  let #Some restored = h.decode #Building decode_value (h.encode encode_value after) else:
    return #[]
  let #Some (branch, other) = h.insert 50 (h.fork 101 removed) else:
    return #[]
  let foreign = h.make #Building 42 100 4
  let #Some (foreign, _) = h.insert 77 foreign else:
    return #[]
  return #[value ids[0] after, value ids[1] after, value ids[2] after, value ids[1] before,
    value added after, value added branch, value other after, value other branch,
    value ids[0] foreign, value added restored, (h.values after)[0], (h.values after)[1], (h.values after)[2]]

entry const exhaustion = fn () => do:
  let (store, _) = h.from_dense #Pile 7 8 #[10]
  let saved = h.encode encode_value store
  saved[3] := 1
  saved[9] := 4294967295
  let #Some loaded = h.decode #Pile decode_value saved else:
    return 0
  let #Some id = h.handle_at 0 loaded else:
    return 0
  let #Some removed = h.remove id loaded else:
    return 0
  return if Maybe.is_some (h.insert 20 removed) then 0 else 1

entry const decode_saved = fn (words: Array U32) => if Maybe.is_some (h.decode #Building decode_value words) then 1 else 0

entry const saved = fn () => do:
  let (store, ids) = h.from_dense #Building 41 100 #[10, 20, 30]
  let #Some removed = h.remove ids[1] store else:
    return #[]
  return h.encode encode_value removed

entry const workload = fn (count: U32) => do:
  let values = array.generate count identity
  let (before, ids) = h.from_dense #Building 5 6 values
  let store = before
  for i in 0 .. count:
    if i % 2 == 1:
      let #Some next = h.remove ids[i] store else:
        return #[0, 0, 0]
      store := next
  let sum = 0
  let old = 0
  for i in 0 .. count:
    old := self + value ids[i] before
    if let #Some v = h.get ids[i] store:
      sum := self + v
  return #[h.count store, sum, old]

entry const lookups = fn (count: U32) => do:
  let (store, ids) = h.from_dense #Building 1 1 (array.generate count identity)
  let sum = 0
  for id in ids:
    sum := self + value id store
  return #[sum, h.count store]
entry const iteration = fn (count: U32) => do:
  let (store, _) = h.from_dense #Building 1 1 (array.generate count identity)
  let sum = 0
  for v in (h.values store):
    sum := self + v
  return #[sum, h.count store]
entry const dense = fn (count: U32) => do:
  let values = array.generate count identity
  let sum = 0
  for i in 0 .. count:
    sum := self + values[i]
  return #[sum, values.length]

// Dense-index baseline must visit every saved reference after a swap removal.
entry const dense_churn = fn (count: U32) => do:
  let before = array.generate count identity
  let values = before
  let references = array.generate count identity
  for removed in 0 .. count:
    if removed % 2 == 1:
      let at = references[removed]
      let last = values.length - 1
      values[at] := values[last]
      values := array.slice 0 last self
      for i in 0 .. references.length:
        let ref = references[i]
        references[i] := if ref == at then 4294967295 else if ref == last then at else ref
  let sum = 0
  let old = 0
  for i in 0 .. count:
    old := self + before[i]
    if references[i] != 4294967295:
      sum := self + values[references[i]]
  return #[values.length, sum, old]
