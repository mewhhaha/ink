import * as check from "./check"
import * as array from "std/array"
import * as motion from "ink/motion"

const scalar_step = func acceleration -> dt -> (positions: Array F32) -> (velocities: Array F32) -> (p: Array F32) -> (v: Array F32) => return do:
  if positions.length != velocities.length or p.length != positions.length or v.length != positions.length:
    @panic "motion columns must have equal lengths"
  for i in 0 .. positions.length:
    let next = velocities[i] + acceleration * dt
    p[i] := positions[i] + next * dt
    v[i] := next
const workload = func step -> count => return do:
  let before_p = array.generate count (func i => return (from (i%37)-18.0)*0.125)
  let before_v = array.generate count (func i => return (from (i%19)-9.0)*0.25)
  let p = @storage.copy before_p
  let v = @storage.copy before_v
  let next_p = array.fill count 0.0
  let next_v = array.fill count 0.0
  for 0 .. 32:
    step (-9.81) 0.016 p v next_p next_v
    for index in 0 .. count:
      p[index] := next_p[index]
      v[index] := next_v[index]
  let output: GrowArray F32 = #[]
  array.append_into output p
  array.append_into output v
  array.append_into output before_p
  array.append_into output before_v
  return @storage.freeze output
entry const original = func (count:U32) => return workload scalar_step count
entry const vector = func (count:U32) => return workload motion.integrate_columns_into count

entry const varied = func (input: Array F32) => return do:
  let count = (input.length-2)/2
  let p = array.slice 2 count input
  let v = array.slice (2+count) count input
  let next_p = array.fill count 0.0
  let next_v = array.fill count 0.0
  motion.integrate_columns_into input[0] input[1] p v next_p next_v
  let expected = array.generate count (func i => return motion.integrate input[0] input[1] p[i] v[i])
  let p_check = array.map (func pair => return do:
    let (a,b)=pair
    return a) expected
  let v_check = array.map (func pair => return do:
    let (a,b)=pair
    return b) expected
  let output: GrowArray F32 = #[]
  array.append_into output next_p
  array.append_into output next_v
  array.append_into output p_check
  array.append_into output v_check
  array.append_into output p
  array.append_into output v
  return @storage.freeze output
entry const lanes = func (input: Array F32) => return do:
  let ((a,b,c,d),(e,f,g,h)) = motion.integrate4 input[0] input[1]
    (input[2],input[3],input[4],input[5]) (input[6],input[7],input[8],input[9])
  return #[a,b,c,d,e,f,g,h]
entry const mismatched = func (n: U32) => return do:
  let positions = array.fill n 1.0
  let p = array.fill n 0.0
  let v = array.fill n 0.0
  motion.integrate_columns_into 1.0 0.5 positions #[] p v
  return array.concat p v

entry const test_scalar_vector_motion_bits = func () => return check.report #[
  check.bits (original count) (vector count) | count <- #[0,1,3,4,5,7,8,31,32,33,256,2048]]
entry const test_motion_extreme_rounding_and_snapshots = func () => return do:
  let values = #[0.0,-0.0,1.0,-1.0,1e-30,-1e-30,1e20,-1e20,0.125]
  let checks: GrowArray check.Check = #[]
  for count in #[0,1,3,4,5,8,9]:
    for acceleration in #[-9.81,0.0,-0.0,1e-15]:
      for dt in #[0.0,-0.0,0.016,-0.5]:
        let p = array.generate count (func i => return values[i])
        let v = array.generate count (func i => return values[count - i - 1])
        let input = array.concat #[acceleration,dt] (array.concat p v)
        let velocities = array.map (func value => return value + acceleration * dt) v
        let positions = array.generate count (func i => return p[i] + velocities[i] * dt)
        let updated = array.concat positions velocities
        let expected = array.concat updated (array.concat updated (array.concat p v))
        checks.push (check.bits expected (varied input))
        if count == 4:
          checks.push (check.bits (array.slice 0 8 expected) (lanes input))
  return check.report (@storage.freeze checks)
entry const trap_mismatched_motion_columns = func () => return mismatched 1
