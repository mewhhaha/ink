import * as array from "std/array"
import * as motion from "ink/motion"

const scalar_step = fn acceleration dt (positions: Array F32) (velocities: Array F32) => do:
  let p = array.fill positions.length 0.0
  let v = array.fill positions.length 0.0
  for i in 0 .. positions.length:
    let next = velocities[i] + acceleration * dt
    p[i] := positions[i] + next * dt
    v[i] := next
  return (p, v)
const input = fn count => (
  array.generate count (fn i => (U32.to_f32 (i % 37) - 18.0) * 0.125),
  array.generate count (fn i => (U32.to_f32 (i % 19) - 9.0) * 0.25))
const workload = fn step count => do:
  let (before_p, before_v) = input count
  let p = before_p
  let v = before_v
  for 0 .. 32:
    let (next_p, next_v) = step (-9.81) 0.016 p v
    p := next_p
    v := next_v
  return array.flatten #[p, v, before_p, before_v]
entry const original = workload scalar_step
entry const vector = workload motion.integrate_columns

entry const varied = fn (input: Array F32) => do:
  let count = (input.length - 2) / 2
  let p = array.slice 2 count input
  let v = array.slice (2 + count) count input
  let (next_p, next_v) = motion.integrate_columns input[0] input[1] p v
  let expected = array.generate count (fn i => motion.integrate input[0] input[1] p[i] v[i])
  let p_check = array.map (fn (pair: (F32, F32)) => do:
    let (a, b) = pair
    return a) expected
  let v_check = array.map (fn (pair: (F32, F32)) => do:
    let (a, b) = pair
    return b) expected
  return array.flatten #[next_p, next_v, p_check, v_check, p, v]
entry const lanes = fn (input: Array F32) => do:
  let ((a,b,c,d),(e,f,g,h)) = motion.integrate4 input[0] input[1]
    (input[2],input[3],input[4],input[5]) (input[6],input[7],input[8],input[9])
  return #[a,b,c,d,e,f,g,h]
entry const mismatched = fn (n: U32) => do:
  let (p,v) = motion.integrate_columns 1.0 0.5 (array.fill n 1.0) #[]
  return array.concat p v
