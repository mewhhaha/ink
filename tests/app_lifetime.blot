import * as app from "ink/app"
import * as clock from "ink/clock"
import * as history from "ink/editor/history"
import * as test from "std/test"
func checkpoint (own access) =>
  access.previous[0] := access.current[0]
  return access
func normalize (own access) =>
  access.normalized[0] := access.normalized[0] + 1
  return access
func update (own access) -> seconds =>
  access.current[0] := access.current[0] + 1
  return access
const stages = app.stages app.no_action app.no_action normalize checkpoint app.route_event
  app.no_event app.no_event update app.no_render app.no_action
const policy = $clock.Policy {step_seconds: 0.125, max_elapsed: 1.0, max_steps: 4}
@[test.suite]
test "fixed checkpoints hold and normalize once":
  let current = #[0]
  let previous = #[0]
  let normalized = #[0]
  let access = {current, previous, normalized, clock: #[clock.clock], control: app.control (), wall: app.wall ()}
  let (first, moved) = app.advance stages access policy 0.3125 #[] 100.0 100.0
  access := moved
  access.control := app.hold_frame self
  let (held, moved) = app.advance stages access policy 0.25 #[] 100.0 100.0
  access := moved
  let (next, moved) = app.advance stages access policy 0.0625 #[] 100.0 100.0
  access := moved
  use test.eq "check 1" #[2, 0, 1, 3, 2, 3, 1] #[first.steps, held.steps, next.steps, access.current[0], access.previous[0], access.clock[0].tick, access.normalized[0]]
  return ()
func encode_scene state -> (output: own #[F32]) : #[F32] =>
  @storage.truncate output 0
  @storage.push output state[0]
  return output
func decode_scene (own state) -> payload =>
  state[0] := payload.at 0
  return state
// Undo or redo: decode the step into the state and make it current.
func travel (own state) -> entries -> payload -> (metadata: own #[U32]) -> forward =>
  let $Some (to, lanes) = history.step_to entries payload metadata forward else:
    return (false, state, metadata)
  return (true, decode_scene state lanes, history.moved metadata to)
@[test.suite]
test "local encoded history undo redo and fork":
  let state = #[1.0]
  let entries: #[history.Entry] = #[]
  let payload: #[F32] = #[]
  let scratch: #[F32] = #[]
  let metadata = history.metadata 3 3
  let (first, entries, payload, metadata, scratch) = history.checkpoint encode_scene state entries payload metadata scratch
  state[0] := 2.0
  let (second, entries, payload, metadata, scratch) = history.checkpoint encode_scene state entries payload metadata scratch
  let (undo, state, metadata) = travel state entries payload metadata false
  let before = state[0]
  let (redo, state, metadata) = travel state entries payload metadata true
  let after = state[0]
  let (undo_again, state, metadata) = travel state entries payload metadata false
  state[0] := 3.0
  let (branch, entries, payload, metadata, scratch) = history.checkpoint encode_scene state entries payload metadata scratch
  let (unavailable, state, metadata) = travel state entries payload metadata true
  use test.near_array "check 1" 0.0 #[1.0, 2.0, 3.0] #[before, after, state[0]]
  use test.holds "check 2" (first and second and undo and redo and undo_again and branch and not unavailable)
  return ()

#entry func history_workload (count: U32) : #[U32] =>
  let state = #[0.0]
  let entries: #[history.Entry] = #[]
  let payload: #[F32] = #[]
  let scratch: #[F32] = #[]
  let metadata = history.metadata 32 32
  for i in 0 .. count:
    state[0] := U32.to_f32 i
    let (saved, next_entries, next_payload, next_metadata, next_scratch) = history.checkpoint encode_scene state entries payload metadata scratch
    entries := next_entries
    payload := next_payload
    metadata := next_metadata
    scratch := next_scratch
    if not saved:
      return panic "history workload checkpoint was rejected"
  let steps = 0
  let total = 0
  for 0 .. entries.length:
    let $Some (to, lanes) = history.step_to entries payload metadata false else:
      break
    metadata := history.moved metadata to
    steps := self + 1
    total := self + F32.to_u32 lanes[0]
  return #[count, entries.length, payload.length, steps, total]
