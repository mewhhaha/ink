import * as owned from "./physics_support"
import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as math from "ink/math"
import * as physics from "ink/physics"
import * as scene from "ink/scene"
import * as shapes from "ink/shapes"
import * as rigid from "ink/rigid"
import * as character from "ink/character"

// This fixture's ABI contains only source poses, colliders, rigid bodies,
// walkers and six brush planes. Everything else is the library itself.
const header: U32 = 14
const stride: U32 = 75
func vec (a: #[F32]) => func (o: U32) => $Vec3 { x: a[o], y: a[o + 1], z: a[o + 2] }

func read_planes (a: #[F32]) => @array.generate (F32.to_u32 a[13] * 6) (func (i: U32) =>
  let n = header + (i / 6) * stride + 49 + (i % 6) * 4
  return $math.Vec4 {x: a[n], y: a[n + 1], z: a[n + 2], w: a[n + 3]})

func read_sources (a: #[F32]) -> (plane_rows: #[math.Vec4]) => @array.generate (F32.to_u32 a[13]) (func (i: U32) =>
  let o = header + i * stride
  let shape = case F32.to_u32 a[o + 11] of
    0 => $scene.Box
    1 => $scene.Sphere
    2 => $scene.Capsule
    _ => $scene.Brush
  let collider = $scene.Collider {
    shape, size: vec a (o + 8), radius: a[o + 12], height: a[o + 13],
    offset: vec a (o + 14), friction: a[o + 17], restitution: a[o + 18],
    trigger: a[o + 19] > 0.0, layer: F32.to_u32 a[o + 73], mask: F32.to_u32 a[o + 74],
  }
  let body = do:
    if a[o + 20] == 0.0:
      break $Nothing
    let kind = if a[o + 20] == 1.0 then $scene.Dynamic else $scene.Kinematic
    break $Some ($scene.Rigid {
      kind, mass: a[o + 21], gravity_scale: a[o + 22],
      linear_damping: a[o + 23], angular_damping: a[o + 24],
      can_sleep: a[o + 25] > 0.0, continuous: a[o + 26] > 0.0,
      linear_velocity: vec a (o + 27), angular_velocity: vec a (o + 30),
      sleeping: a[o + 33] > 0.0, sleep_time: a[o + 34],
    })
  let walker = do:
    if a[o + 35] == 0.0:
      break $Nothing
    break $Some ($scene.Walker {
      max_slope: a[o + 36], step_height: a[o + 37], snap_distance: a[o + 38], push: a[o + 39],
      velocity: vec a (o + 40), grounded: a[o + 43] > 0.0, ground: F32.to_u32 a[o + 44],
      ground_normal: vec a (o + 45),
    })
  let planes = &plane_rows[i * 6..i * 6 + F32.to_u32 a[o + 48]]
  return $scene.Source {
    index: i, id: F32.to_u32 a[o], position: vec a (o + 1), rotation: rigid.quat a (o + 4),
    scale: math.one3, collider: $Some collider, rigid: body, walker, planes,
  })

const config = $physics.Config {
  gravity: $Vec3 { x: 0.0, y: (-9.81), z: 0.0 }, substeps: 4,
  sleep_time: 0.5, linear_sleep: 0.05, angular_sleep: 0.05,
}

entry func step (a: #[F32]) =>
  let dt = a[0]
  let plane_rows = read_planes a
  let sources = read_sources a plane_rows
  for i in 0..sources.length:
    sources[i] := do:
      let s = self
      if let $Some w = s.walker:
        w.velocity.x := a[2]
        w.velocity.z := a[4]
        w.velocity.y := if w.grounded then (if a[1] > 0.0 then 7.0 else (-1.0)) else self - 20.0 * dt
        s.walker := $Some w
      if a[12] > 0.0:
        if let $Some b = s.rigid:
          if let $scene.Kinematic = b.kind:
            s.position := self + b.linear_velocity * dt
      break s
  let cache_start = header + sources.length * stride
  // This fixture uses small ids in F32 lanes; the library cache uses exact U32.
  let contacts_seed = @array.generate ((a.length - cache_start) / 12) (func (r: U32) =>
    let o = cache_start + r * 12
    return $physics.CachedContact {
      a: F32.to_u32 a[o], b: F32.to_u32 a[o + 1],
      point: vec a (o + 2), normal: vec a (o + 5),
      normal_impulse: a[o + 8], tangent_impulse: vec a (o + 9),
    })

  return scene.with_built sources (func built => owned.with_step sources contacts_seed (func (own owned_step) =>
    owned_step := physics.simulate_into config dt owned_step built
    let results = owned_step.results
    let contacts = physics.read_cache owned_step.cache
    let out = @array.fill (cache_start + contacts.contacts.length * 12) 0.0
    for i in 0..cache_start:
      out[i] := a[i]
    for r in 0..contacts.contacts.length:
      let c = contacts.contacts[r]
      let o = cache_start + r * 12
      out[o] := U32.to_f32 c.a
      out[o + 1] := U32.to_f32 c.b
      out[o + 2] := c.point.x
      out[o + 3] := c.point.y
      out[o + 4] := c.point.z
      out[o + 5] := c.normal.x
      out[o + 6] := c.normal.y
      out[o + 7] := c.normal.z
      out[o + 8] := c.normal_impulse
      out[o + 9] := c.tangent_impulse.x
      out[o + 10] := c.tangent_impulse.y
      out[o + 11] := c.tangent_impulse.z

    for i in 0..sources.length:
      let p = sources[i].position
      let o = header + i * stride
      out[o + 1] := p.x
      out[o + 2] := p.y
      out[o + 3] := p.z
    for r in results:
      let o = header + r.source * stride
      out[o + 1] := r.position.x
      out[o + 2] := r.position.y
      out[o + 3] := r.position.z
      out[o + 4] := r.rotation.x
      out[o + 5] := r.rotation.y
      out[o + 6] := r.rotation.z
      out[o + 7] := r.rotation.w
      if let $Some b = r.rigid:
        out[o + 27] := b.linear_velocity.x
        out[o + 28] := b.linear_velocity.y
        out[o + 29] := b.linear_velocity.z
        out[o + 30] := b.angular_velocity.x
        out[o + 31] := b.angular_velocity.y
        out[o + 32] := b.angular_velocity.z
        out[o + 33] := if b.sleeping then 1.0 else 0.0
        out[o + 34] := b.sleep_time
      if let $Some w = r.walker:
        out[o + 40] := w.velocity.x
        out[o + 41] := w.velocity.y
        out[o + 42] := w.velocity.z
        out[o + 43] := if w.grounded then 1.0 else 0.0
        out[o + 44] := U32.to_f32 w.ground
        out[o + 45] := w.ground_normal.x
        out[o + 46] := w.ground_normal.y
        out[o + 47] := w.ground_normal.z
    return out
  ))
func answer (h: Maybe scene.Hit) => case h of
  $Some h => #[1.0, U32.to_f32 h.id, h.distance, h.normal.x, h.normal.y, h.normal.z, h.point.x, h.point.y, h.point.z]
  $Nothing => #[0.0]

entry func query (a: #[F32]) =>
  let plane_rows = read_planes a
  let sources = read_sources a plane_rows
  return scene.with_built sources (func sc =>
    let origin = vec a 8
    let direction = vec a 2
    let mask = F32.to_u32 a[11]
    let skip = F32.to_u32 a[7]
    if a[1] == 1.0:
      return answer (physics.ray sc origin direction a[5] mask skip)
    if a[1] == 2.0:
      return answer (physics.sweep_sphere sc origin a[6] (direction.normalized * a[5]) mask skip)
    if a[1] == 3.0:
      let filter = $scene.Filter { mask, skip, triggers: false, walkers: true, dynamics: true }
      return answer (scene.cast sc origin (origin + math.up) a[6] (direction.normalized * a[5]) filter)
    if a[1] == 4.0:
      let ids = physics.overlap_sphere sc origin a[6] mask
      return #[U32.to_f32 ids.length, ...array.map U32.to_f32 ids]
    return #[if physics.point_solid sc origin mask then 1.0 else 0.0])

  // Separate public primitives: no generated glue or reconstructed solver.

entry func primitives (a: #[F32]) =>
  let half = vec a 0
  let inertia = shapes.box_inertia half
  return shapes.with_geometry (func geometry =>
    let poly = shapes.box_poly geometry math.zero3 math.identity_quat half
    let (low, high) = shapes.bounds ($shapes.Hull poly)
    let clipped = character.clip (vec a 3) math.up
    let iw = rigid.world_inertia math.identity_quat inertia
    return #[low.x, low.y, low.z, high.x, high.y, high.z, ...iw, clipped.x, clipped.y, clipped.z])
