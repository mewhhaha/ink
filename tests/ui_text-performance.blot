import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as text from "ink/text"
import * as tree from "ink/ui/tree"
import * as ui from "ink/ui"

const engine = ecs.build (ecs.insert_resource tree.empty (ecs.insert_resource tree.unfocused (ecs.new ())))
const flag = fn (value: Bool) => do:
  if value:
    return 1
  return 0
const packed = fn (parts: Array (Array U32)) => array.flatten #[array.concat #[part.length] part | part <- parts]
entry const words = fn (input: Array U32) => packed (text.words input)
entry const lines = fn (input: Array U32) => packed (text.lines input)
entry const text_snapshots = fn (input: Array U32) => do:
  let joined = text.joined #[32] #[input, input]
  let words = text.words input
  let lines = text.lines input
  let changed = input
  for index in 0 .. changed.length:
    changed[index] := 0
  return packed #[joined, text.joined #[32] words, text.joined #[10] lines, changed]
entry const joined = fn (input: Array U32) => do:
  let separator = array.slice 1 input[0] input
  let parts: List (Array U32) = []
  let at = input[0] + 1
  for 0 .. input.length:
    if at < input.length:
      let length = input[at]
      let part = array.slice (at + 1) length input
      parts := [...self, part]
      at := self + length + 1
  return text.joined separator (Array.from_list parts)

// Packed nodes: id, parent, focusable, hidden, disabled, modal, selected, role.
entry const focus = fn (input: Array U32) => do:
  let nodes = array.generate ((input.length - 1) / 8) (fn index => do:
    let at = 1 + index * 8
    let node = ui.button_node input[at] input[at + 1] #[] ui.nowhere
    node.focusable := input[at + 2] != 0
    node.hidden := input[at + 3] != 0
    node.disabled := input[at + 4] != 0
    node.modal := input[at + 5] != 0
    node.selected := input[at + 6]
    node.role := input[at + 7]
    return node)
  let (before, _) = ecs.create engine (fn () => do:
    use ecs.set #tree.Tree { nodes }
    let held = tree.unfocused
    held.node := input[0]
    return ecs.set held)
  let (_, result) = ecs.run engine before (fn () => do:
    use tree.settle ()
    use held <- ecs.get #tree.Focus
    use current <- ecs.get #tree.Tree
    return array.flatten #[#[held.node, held.modal], packed #[held.order, held.reached],
      #[flag node.hidden | node <- current.nodes],
      #[flag node.focused | node <- current.nodes]])
  let (_, original) = ecs.run engine before (fn () => do:
    use current <- ecs.get #tree.Tree
    return #[flag node.hidden | node <- current.nodes])
  return array.concat result original

entry const text_join_many = fn (count: U32) => do:
  let parts = array.generate count (fn index => #[128578, 97 + index % 26])
  let joined = text.joined #[10, 66615] parts
  let sum = 0
  for code in joined:
    sum := self + code
  return #[count, joined.length, sum]

const split_input = fn (count: U32) => fn (delimiter: U32) => array.generate (count * 3) (fn index => do:
  if index % 3 == 0:
    return 128578
  if index % 3 == 1:
    return 97 + index / 3 % 26
  return delimiter)
const split_witness = fn (count: U32) => fn (parts: Array (Array U32)) => do:
  let sum = 0
  let points = 0
  for part in parts:
    points := self + part.length
    for code in part:
      sum := self + code
  return #[count, parts.length, points, sum]
entry const text_words_long = fn (count: U32) => split_witness count (text.words (split_input count 32))
entry const text_lines_long = fn (count: U32) => split_witness count (text.lines (split_input count 10))

// 32-deep groups with full-width descending ids and an open modal at each root.
entry const ui_deep_tree = fn (count: U32) => do:
  let nodes = array.generate count (fn index => do:
    let parent = 0
    if index % 32 != 0:
      parent := 0xffffffff - index + 1
    let node = ui.button_node (0xffffffff - index) parent #[] ui.nowhere
    node.modal := index % 32 == 0
    return node)
  let (_, result) = ecs.create engine (fn () => do:
    use ecs.set #tree.Tree { nodes }
    use tree.settle ()
    use held <- ecs.get #tree.Focus
    use current <- ecs.get #tree.Tree
    let hidden = 0
    for node in current.nodes:
      if node.hidden:
        hidden := self + 1
    return #[count, held.order.length, held.reached.length, held.node, held.modal, hidden])
  return result
