import * as mix from "ink/audio/mix"
import * as gestures from "ink/input/gestures"
import * as math from "ink/math"
import * as interest from "ink/net/interest"
import * as ribbons from "ink/particles/ribbons"
import * as streaming from "ink/render/streaming"

const white = $math.Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }

entry func compressor_eval (a: #[F32]) : #[F32] =>
  let cfg = $mix.Compressor { threshold: a[0], ratio: a[1], attack: a[2], release: a[3], floor_gain: a[4] }
  let e1 = mix.step_compressor cfg a[5] a[6] mix.open_envelope
  let e2 = mix.step_compressor cfg a[7] a[8] e1
  return #[e1.level, e1.gain, e2.level, e2.gain]

entry func reverb_eval (a: #[F32]) : #[F32] =>
  let listener = math.vec3 a[0] a[1] a[2]
  let zones = #[
    $mix.ReverbZone { center: math.vec3 a[3] a[4] a[5], inner_radius: a[6], outer_radius: a[7], priority: a[8], wetness: a[9] },
    $mix.ReverbZone { center: math.vec3 a[10] a[11] a[12], inner_radius: a[13], outer_radius: a[14], priority: a[15], wetness: a[16] },
  ]
  let (w, wet) = mix.reverb_weights listener zones
  return #[w[0], w[1], wet]

entry func stick_haptic_eval (a: #[F32]) : #[F32] =>
  let s = gestures.stick_curve (math.vec2 a[0] a[1]) a[2] a[3] a[4]
  let h = $gestures.Haptic { low_peak: a[5], high_peak: a[6], attack: a[7], sustain: a[8], release: a[9] }
  let (lo, hi) = gestures.sample_haptic h a[10]
  return #[s.x, s.y, lo, hi]

entry func rewind_ray_eval (a: #[F32]) : #[F32] =>
  let hist = #[
    $interest.HitboxSample { time: a[0], center: math.vec3 a[1] 0.0 0.0, radius: a[2] },
    $interest.HitboxSample { time: a[3], center: math.vec3 a[4] 0.0 0.0, radius: a[5] },
  ]
  let $Some (c, r) = interest.rewind_sphere hist a[6] else:
    return #[0.0, 0.0, 0.0, 0.0]
  let hit = interest.ray_hit_sphere (math.vec3 a[7] a[8] a[9]) (math.vec3 a[10] a[11] a[12]) a[13] c r
  return case hit of
    $Some t => #[c.x, r, 1.0, t]
    $Nothing => #[c.x, r, 0.0, 0.0]

entry func ribbon_eval (a: #[F32]) : #[F32] =>
  let pts = #[
    $ribbons.Point { position: math.vec3 a[0] a[1] a[2], width: a[3], color: white },
    $ribbons.Point { position: math.vec3 a[4] a[5] a[6], width: a[7], color: white },
    $ribbons.Point { position: math.vec3 a[8] a[9] a[10], width: a[11], color: white },
  ]
  let vs = ribbons.build pts (math.vec3 a[12] a[13] a[14])
  let v0 = vs[0]
  let v1 = vs[1]
  let v2 = vs[2]
  let vlast = vs[vs.length - 1]
  return #[U32.to_f32 vs.length, v0.position.x, v0.position.y, v0.position.z, v1.position.x, v1.position.y, v1.position.z, v2.u, vlast.u]

entry func crossfade_eval (a: #[F32]) : #[F32] =>
  let cf = streaming.lod_crossfade #[a[0], a[1], a[2]] a[3] a[4]
  return #[U32.to_f32 cf.primary, U32.to_f32 cf.secondary, cf.fade]
