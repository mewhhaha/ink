import * as test from "std/test"
import * as preferences from "ink/preferences"

const quality = $preferences.Quality { msaa: 1, fxaa: true, scale: 0.75, filtering: 1, shadows: 1024, occlusion: false, sky: true, fog: 0.5, effects: true, bloom: false, reflections: 1, volumetrics: 2 }
const volumes = $preferences.Volumes { master: 0.25, effects: 0.5, music: 1.0 }
const controls = $preferences.Controls { left_handed: true }
const initial = preferences.make quality volumes controls

@[test.suite]
test "initial preferences are caller policy and round trip":
  use restored <- preferences.decode (preferences.encode_saved initial)
  use test.near_array "check 1" 0.0 #[1.0, 1.0, 0.75, 1.0, 1024.0, 0.0, 1.0, 0.5, 1.0, 0.25, 0.5, 1.0, 0.0, 1.0, 1.0, 2.0] (preferences.encode initial)
  use test.near_array "check 2" 0.0 (preferences.encode_saved initial) (preferences.encode_saved restored)
  use test.near_array "check 3" 0.0 #[1.0, 2.0] #[U32.to_f32 restored.quality.reflections, U32.to_f32 restored.quality.volumetrics]
  return ()

// The fog's lighting tier is its own lane, after reflections and before the
// saved flag: off, low and high round trip beside the other tiers.
@[test.suite]
test "the volumetrics lane round trips beside reflections":
  let low = preferences.apply initial 15 1.0
  let off = preferences.apply initial 15 0.0
  use restored <- preferences.decode (preferences.encode_saved low)
  use test.near_array "check 1" 0.0 #[1.0, 1.0] #[U32.to_f32 low.quality.volumetrics, U32.to_f32 restored.quality.volumetrics]
  use test.near_array "check 2" 0.0 #[0.0, 1.0] #[U32.to_f32 off.quality.volumetrics, U32.to_f32 low.quality.reflections]
  use test.near_array "check 3" 0.0 #[17.0, 16.0] #[U32.to_f32 (preferences.encode_saved initial).length, U32.to_f32 preferences.lanes_count]
  return ()

// The saved lanes of `initial` with lane `lane` set to `value`, decoded and
// saved again; a lane that does not decode traps.
io resaved (a: #[F32]) : #[F32] =>
  let lanes = preferences.encode_saved initial
  lanes[F32.to_u32 a[0]] := a[1]
  use restored <- preferences.decode lanes
  return preferences.encode_saved restored

@[test.suite]
test "changes clamp ranges and reject unknown enumerations":
  let updated = preferences.apply initial 2 7.0
  updated := preferences.apply self 9 (-0.5)
  updated := preferences.apply self 0 2.0
  updated := preferences.apply self 3 3.0
  let reflected = preferences.apply initial 14 2.0
  let rejected = preferences.apply initial 14 3.0
  let toned = preferences.apply initial 15 1.0
  let toned_over = preferences.apply initial 15 3.0
  use test.near_array "check 1" 0.0 #[2.0, 0.0, 1.0, 1.0] #[updated.quality.scale, updated.volumes.master, U32.to_f32 updated.quality.msaa, U32.to_f32 updated.quality.filtering]
  use test.near_array "check 2" 0.0 #[2.0, 1.0] #[U32.to_f32 reflected.quality.reflections, U32.to_f32 rejected.quality.reflections]
  use test.near_array "check 3" 0.0 #[1.0, 2.0] #[U32.to_f32 toned.quality.volumetrics, U32.to_f32 toned_over.quality.volumetrics]
  use test.near_array "check 4" 0.0 (preferences.encode initial) (preferences.encode (preferences.apply initial 999 7.0))
  use test.near_array "check 5" 0.0 (preferences.encode initial) (preferences.encode (preferences.apply initial 0 1.5))
  return ()
