import * as check from "./check"
import * as math from "ink/math"
import * as seq from "ink/sequencer"

#entry func test_sequencer_curves_slerp_and_looping_triggers () =>
  let scalar_keys: #[seq.ScalarKey] = #[
    $seq.ScalarKey { time: 0.0, value: 60.0, interp: seq.interp_hermite, out_tangent: 0.0, next_in_tangent: 0.0 },
    $seq.ScalarKey { time: 2.0, value: 30.0, interp: seq.interp_step, out_tangent: 0.0, next_in_tangent: 0.0 },
    $seq.ScalarKey { time: 3.0, value: 90.0, interp: seq.interp_linear, out_tangent: 0.0, next_in_tangent: 0.0 },
  ]
  let fov_mid = seq.sample_scalar (&scalar_keys[0..3]) 1.0
  let fov_step = seq.sample_scalar (&scalar_keys[0..3]) 2.5
  let pos_keys: #[seq.Vec3Key] = #[
    $seq.Vec3Key { time: 0.0, value: math.vec3 0.0 0.0 0.0, interp: seq.interp_linear },
    $seq.Vec3Key { time: 2.0, value: math.vec3 10.0 4.0 (-6.0), interp: seq.interp_linear },
  ]
  let pos_mid = seq.sample_vec3 (&pos_keys[0..2]) 1.0
  let rot_keys: #[seq.QuatKey] = #[
    $seq.QuatKey { time: 0.0, value: math.identity_quat, interp: seq.interp_linear },
    $seq.QuatKey { time: 2.0, value: math.Quat.yaw 1.5707963, interp: seq.interp_linear },
  ]
  let rot_mid = seq.sample_quat (&rot_keys[0..2]) 1.0
  let expected_rot = math.Quat.yaw 0.7853982
  let triggers: #[seq.TriggerKey] = #[
    $seq.TriggerKey { time: 0.1, tag: 101, payload: 1.0 },
    $seq.TriggerKey { time: 1.8, tag: 202, payload: 2.0 },
  ]
  let p0 = seq.scrub (seq.make_player 2.0 true) 1.5
  let st = seq.advance p0 0.7
  let fired = seq.fired_triggers (&triggers[0..2]) st
  return check.report #[
    check.near 0.02 #[45.0, 30.0] #[fov_mid, fov_step],
    check.near 0.01 #[5.0, 2.0, (-3.0)] #[pos_mid.x, pos_mid.y, pos_mid.z],
    check.near 0.02 #[expected_rot.y, expected_rot.w] #[rot_mid.y, rot_mid.w],
    check.holds st.wrapped,
    check.holds (fired.length == 2),
    check.holds (fired[0].tag == 101 and fired[1].tag == 202),
  ]
