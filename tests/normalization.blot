import * as check from "./check"
import * as app from "ink/app"
import * as ecs from "ink/ecs"
import * as lanes from "ink/lanes"
import * as clock from "ink/clock"
import * as persist from "ink/persist"
import * as array from "std/array"

type Value is data = $Value F32
type Repairs is data = $Repairs U32
type Access = {value: Array Value, repairs: Array U32, clock: Array clock.Clock,
  control: app.Control, wall: Array app.Wall, shown: Array F32}
func encode current => return do:
  let $Value value = current
  return #[value]
func decode values => return do:
  use lanes.exact values 1
  return $Value values[0]
const codec = $lanes.Codec { key: 500, version: 1, encode, decode, migrate: lanes.no_migration }
func repair (access: Access) => return do:
  let $Value value=access.value[0]
  access.value[0] = $Value (max 0.0 value)
  access.repairs[0] = access.repairs[0]+1
func shown (access: Access) -> (presentation:app.Presentation) => return do:
  let $Value value=access.value[0]
  access.shown[0] = value
  access.shown[1] = U32.to_f32 access.repairs[0]
const policy= $clock.Policy {step_seconds:0.05,max_elapsed:0.25,max_steps:5}
const application=app.stages app.no_action app.no_action (app.lent repair) app.no_action app.route_event
  app.no_event app.no_event app.no_update (app.lent_with shown) app.no_action
func with_access consume => return do:
  let value= #[$Value (-1.0)]
  let repairs= #[0]
  let current= #[clock.clock]
  let control=app.control ()
  let wall=app.wall ()
  let displayed= #[0.0,0.0]
  let access: Access={value,repairs,clock:current,control,wall,shown:displayed}
  return consume (own access)
func draw (access: own Access) => return do:
  access := app.render application access 0.0 1.0 1.0
  return (@storage.copy access.shown, access)
func save (access: Access) : Array F32 => return do:
  let sections:ResizeArray persist.Section= #[]
  let payload:ResizeArray F32= #[]
  let output:ResizeArray F32= #[]
  persist.write_resource codec access.value[0] sections payload
  persist.frame_sections persist.magic 1 sections payload output
  return @storage.freeze output
func restore (access: own Access) -> (saved: Array F32) => return do:
  let sections:ResizeArray persist.Section= #[]
  let outcomes:ResizeArray persist.Outcome= #[]
  persist.parse_sections persist.magic 1 saved sections
  access.value := persist.restore_resource codec ($Value (-1.0)) access.value sections saved outcomes
  app.invalidate access.control
  return access
entry func boundaries () => return with_access (func access => return do:
  access := app.start application access
  let (first, access)=draw access
  access.value[0] := $Value (-5.0)
  let saved=save access
  let after=with_access (func restored => return do:
    restored := restore restored saved
    let (frame, drawn)=draw restored
    return frame)
  let normalized=with_access (func raw => return do:
    raw := restore raw saved
    let (step, moved) = app.advance application raw policy 0.0 #[] 1.0 1.0
    raw := moved
    let (frame, raw)=draw raw
    let (second, raw)=draw raw
    raw.value[0] := $Value (-9.0)
    app.pause raw.control true
    app.invalidate raw.control
    let (step, moved) = app.advance application raw policy 0.0 #[] 1.0 1.0
    raw := moved
    let (third, raw)=draw raw
    return array.concat frame (array.concat second third))
  return array.concat first (array.concat after normalized))
entry func test_normalization_boundaries () => return check.report #[check.equal #[0.0,1.0,0.0,1.0,0.0,1.0,0.0,1.0,0.0,2.0] (boundaries ())]
