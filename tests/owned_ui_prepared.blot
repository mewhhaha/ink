import * as array from "std/array"
import * as check from "./check"
import * as tree from "ink/ui/tree"
import * as ui from "ink/ui"
const words = #[65]
const changed = #[66, 67]
entry func test_dirty_preparation_reuses_topology_and_propagates_modal_visibility () => return do:
  let state = #[tree.unfocused]
  let returns: ResizeArray tree.Return = #[]
  let focus_stops: ResizeArray tree.Stop = #[]
  let focus_order: ResizeArray U32 = #[]
  let focus_reached: ResizeArray U32 = #[]
  let held = $tree.Focus {state, returns, nodes: focus_stops, order: focus_order, reached: focus_reached}
  let meta = #[0, 0]
  let keys: ResizeArray U32 = #[]
  let key_order: ResizeArray U32 = #[]
  let parents: ResizeArray U32 = #[]
  let depth: ResizeArray U32 = #[]
  let traversal: ResizeArray U32 = #[]
  let child_starts: ResizeArray U32 = #[]
  let child_targets: ResizeArray U32 = #[]
  let topology = $tree.Topology {meta, keys, key_order, parents, depth, order: traversal, child_starts, child_targets}
  let authored: ResizeArray tree.Authored = #[]
  let hidden: ResizeArray Bool = #[]
  let available: ResizeArray Bool = #[]
  let inside: ResizeArray Bool = #[]
  let stops: ResizeArray tree.Stop = #[]
  let order: ResizeArray U32 = #[]
  let reached: ResizeArray U32 = #[]
  let prepared = $tree.Prepared {topology, authored, hidden, available, inside, stops, order, reached}
  let marked: ResizeArray tree.Node = #[]
  let nodes = #[ui.group_node 1 0 (&words[0..1]) ui.nowhere,
    ui.button_node 2 1 (&words[0..1]) ui.nowhere,
    ui.button_node 3 0 (&words[0..1]) ui.nowhere]
  tree.prepare 1 (&nodes[0..nodes.length]) prepared
  nodes[1].value_text = &changed[0..changed.length]
  tree.update_prepared 1 (&nodes[0..nodes.length]) #[1] prepared
  let text_only = meta[0] == 1 and parents[1] == 0 and depth[1] == 2 and child_targets[0] == 1 and stops[1].id == 2
  nodes[0].hidden = true
  tree.update_prepared 1 (&nodes[0..nodes.length]) #[0] prepared
  tree.resolve_prepared prepared (&nodes[0..nodes.length]) held marked
  let inherited = hidden[0] and hidden[1] and Bool.not available[1] and available[2] and marked[1].hidden and focus_order.length == 1 and focus_order[0] == 3
  nodes[0].hidden = false
  nodes[0].modal = true
  tree.update_prepared 1 (&nodes[0..nodes.length]) #[0] prepared
  tree.resolve_prepared prepared (&nodes[0..nodes.length]) held marked
  let modal = state[0].node == 2 and state[0].modal == 1 and marked[2].hidden
  tree.enter 1 2 held
  tree.focus 3 held
  tree.resolve_prepared prepared (&nodes[0..nodes.length]) held marked
  let constrained = state[0].node == 2
  let remaining = #[nodes[2]]
  tree.prepare 2 (&remaining[0..remaining.length]) prepared
  tree.resolve_prepared prepared (&remaining[0..remaining.length]) held marked
  let retired = returns.length == 0 and state[0].modal == 0
  let encoded = tree.encode held
  tree.focus 0 held
  tree.decode_into encoded held
  return check.report #[check.holds text_only, check.holds inherited, check.holds modal, check.holds constrained,
    check.holds retired, check.equal encoded (tree.encode held)]
