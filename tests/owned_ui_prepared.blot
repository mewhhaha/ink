import * as array from "std/array"
import * as check from "./check"
import * as tree from "ink/ui/tree"
import * as ui from "ink/ui"
const words = #[65]
const changed = #[66, 67]
entry func test_dirty_preparation_reuses_topology_and_propagates_modal_visibility () =>
  let state = #[tree.unfocused]
  let returns: #[tree.Return] = #[]
  let focus_stops: #[tree.Stop] = #[]
  let focus_order: #[U32] = #[]
  let focus_reached: #[U32] = #[]
  let held = $tree.Focus {state, returns, nodes: focus_stops, order: focus_order, reached: focus_reached}
  let prepared = tree.empty_prepared ()
  let labels: #[U32] = #[]
  let nodes: #[tree.StoredNode] = #[]
  let marked: #[tree.StoredNode] = #[]
  let (labels, nodes) = ui.declare_owned (ui.group_node 1 0 (&words[0..1]) ui.nowhere) labels nodes
  let (labels, nodes) = ui.declare_owned (ui.button_node 2 1 (&words[0..1]) ui.nowhere) labels nodes
  let (labels, nodes) = ui.declare_owned (ui.button_node 3 0 (&words[0..1]) ui.nowhere) labels nodes
  prepared := tree.prepare 1 (&nodes[0..nodes.length]) prepared
  let (changed_span, labels) = tree.store_text changed labels
  nodes[1].value_text := changed_span
  prepared := tree.update_prepared 1 (&nodes[0..nodes.length]) #[1] prepared
  let text_only = prepared.topology.revision == 1 and prepared.topology.parents[1] == 0 and prepared.topology.depth[1] == 2 and prepared.topology.child_targets[0] == 1 and prepared.stops[1].id == 2
  nodes[0].hidden := true
  prepared := tree.update_prepared 1 (&nodes[0..nodes.length]) #[0] prepared
  let (held, marked) = tree.resolve_prepared prepared (&nodes[0..nodes.length]) held marked
  let inherited = prepared.hidden[0] and prepared.hidden[1] and not prepared.available[1] and prepared.available[2] and marked[1].hidden and held.order.length == 1 and held.order[0] == 3
  nodes[0].hidden := false
  nodes[0].modal := true
  prepared := tree.update_prepared 1 (&nodes[0..nodes.length]) #[0] prepared
  let (held, marked) = tree.resolve_prepared prepared (&nodes[0..nodes.length]) held marked
  let modal = held.state[0].node == 2 and held.state[0].modal == 1 and marked[2].hidden
  held := tree.enter 1 2 held
  held := tree.focus 3 held
  let (held, marked) = tree.resolve_prepared prepared (&nodes[0..nodes.length]) held marked
  let constrained = held.state[0].node == 2
  let remaining = #[nodes[2]]
  prepared := tree.prepare 2 (&remaining[0..remaining.length]) prepared
  let (held, marked) = tree.resolve_prepared prepared (&remaining[0..remaining.length]) held marked
  let retired = held.returns.length == 0 and held.state[0].modal == 0
  let encoded = tree.encode held
  held := tree.focus 0 held
  held := tree.decode_into encoded held
  return check.report #[check.holds text_only, check.holds inherited, check.holds modal, check.holds constrained,
    check.holds retired, check.equal encoded (tree.encode held)]
