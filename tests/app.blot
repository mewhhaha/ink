import * as clock from "ink/clock"
import * as app from "ink/app"
import * as array from "std/array"
import * as check from "./check"
import * as ecs from "ink/ecs"
import * as input from "ink/input"
import * as lanes from "ink/lanes"
import * as persist from "ink/persist"
import * as events from "ink/events"
import * as fixture from "./fixtures/lifecycle_app"
// A persistent app world (packages/app.blot): transient resources, its own
// and those a gated plugin adds, start each frame afresh, whether or not the
// frame runs a fixed update, while saved resources (the input) carry on; and
// a world restored from its lanes starts its transients afresh too.

entry func test_a_new_world_starts_with_its_transients () => fixture.with_access (func access => check.report #[check.equal #[7.0,10.0,0.0,0.0] (fixture.observe access)])
entry func test_explicit_preview_copy_discards_state_and_outbox_without_advancing_the_live_world () => fixture.with_access (func live =>
  let before=fixture.observe live
  let result=fixture.with_copy live (func preview =>
    preview := fixture.update preview 0.5
    return #[U32.to_f32 preview.scratch[0],if persist.has preview.requests $persist.Save then 1.0 else 0.0])
  let repeated=fixture.with_copy live (func preview =>
    preview := fixture.update preview 0.5
    return #[U32.to_f32 preview.scratch[0]])
  let unchanged=fixture.observe live
  live := fixture.frame live (1.0/60.0) #[]
  return check.report #[check.equal #[8.0,1.0] result,check.equal before unchanged,
    check.equal #[8.0] repeated,check.equal #[8.0,12.0,1.0,1.0] (fixture.observe live)])
entry func test_a_frame_runs_its_fixed_update_on_fresh_transients () => fixture.with_access (func access =>
  access := fixture.setup access 1
  return check.report #[check.equal #[8.0,12.0,1.0,1.0] (fixture.observe access)])
entry func test_a_frame_without_an_update_still_resets_the_transients () => fixture.with_access (func access =>
  access := fixture.setup access 2
  return check.report #[check.equal #[7.0,10.0,1.0,0.0] (fixture.observe access)])
entry func test_transients_reset_once_a_frame_not_once_an_update () => fixture.with_access (func access =>
  access := fixture.setup access 3
  return check.report #[check.equal #[9.0,14.0,3.0,1.0] (fixture.observe access)])
entry func test_a_restored_world_keeps_saved_resources_and_starts_transients_afresh () => fixture.with_access (func access =>
  access := fixture.setup access 3
  let saved=input.encode (input.read access.input_pointer access.input_held access.input_fresh access.input_buttons)
  return fixture.with_access (func restored =>
    restored.input_pointer := input.decode_into saved self restored.input_held restored.input_fresh restored.input_buttons
    return check.report #[check.equal #[7.0,10.0,3.0,0.0] (fixture.observe restored)]))
entry func test_contact_holds_the_entire_frame_without_pausing_or_catching_up () => fixture.with_access (func access =>
  access.clock[0] := $clock.Clock {tick:12,remainder:0.007}
  access := fixture.frame access 0.25 #[$events.KeyDown 42]
  let held=fixture.timing access
  let held_values=fixture.observe access
  access := fixture.frame access 0.016666667 #[]
  return check.report #[check.equal #[12.0,0.007,0.0] held,
    check.near 0.000001 #[13.0,0.007,0.0] (fixture.timing access),
    check.equal #[7.0,10.0,0.0,0.0] held_values,check.equal #[8.0,12.0,1.0,1.0] (fixture.observe access)])
entry func test_contact_on_a_frame_without_a_fixed_step_is_consumed () => fixture.with_access (func access =>
  access := fixture.frame access 0.0 #[$events.KeyDown 42]
  let (result, moved) = app.advance fixture.application access fixture.policy 0.016666667 #[] 960.0 640.0
  access := moved
  return check.report #[check.equal #[1.0,0.0,0.0] (fixture.timing access)])
