import * as clock from "ink/clock"
// A persistent app world (packages/app.blot): transient resources, its own
// and those a gated plugin adds, start each frame afresh, whether or not the
// frame runs a fixed update, while saved resources (the input) carry on; and
// a world restored from its lanes starts its transients afresh too.
import * as app from "ink/app"
import * as array from "std/array"
import * as check from "./check"
import * as ecs from "ink/ecs"
import * as input from "ink/input"
import * as lanes from "ink/lanes"
import * as persist from "ink/persist"

type Scratch is data = #Scratch (Array U32)
type Tally is data = #Tally U32

// Each fixed update bumps the scratch, the tally and the input, and asks for a
// save.
const update = fn (seconds: F32) => do:
  use scratch <- ecs.get #Scratch
  let #Scratch values = scratch
  values[0] := self + 1
  use ecs.set (#Scratch values)
  use tally <- ecs.get #Tally
  let #Tally total = tally
  use ecs.set (#Tally (total + 2))
  use controls <- ecs.get #input.Input
  controls.x := self + 1.0
  use ecs.set controls
  return persist.request #persist.Save

const application = do:
  let builder = app.new #clock.Policy { step_seconds: 0.016666667, max_elapsed: 0.25, max_steps: 5 }
  builder := app.insert_transient_resource (#Scratch #[7]) self
  builder := app.add_plugin input.plugin self
  builder := app.run_if (fn () => #True) (app.insert_transient_resource (#Tally 10)) self
  builder := app.add_system #app.Update update self
  return app.build builder

// The scratch, the tally, the input's x, and whether a save is asked for.
const observe = fn world => do:
  let (_, values) = app.run application world (fn () => do:
    use scratch <- ecs.get #Scratch
    use tally <- ecs.get #Tally
    use controls <- ecs.get #input.Input
    use requests <- ecs.get #persist.Requests
    let #Scratch values = scratch
    let #Tally total = tally
    return #[U32.to_f32 values[0], U32.to_f32 total, controls.x, lanes.bit (requests.has #persist.Save)])
  return values

// A frame as a persistent world runs one: reset the transients, then advance.
const frame = fn world => fn seconds => do:
  let (next, _) = app.run application world (fn () => do:
    use app.reset_scoped application ()
    return app.advance_scoped application seconds #[] 960.0 640.0)
  return next

const initial = fn () => app.create_world application ()
const first = fn () => frame (initial ()) (1.0 / 60.0)
const idle = fn () => frame (first ()) 0.0
const second = fn () => frame (idle ()) (2.0 / 60.0)

entry const test_a_new_world_starts_with_its_transients = fn () => check.report #[
  check.equal #[7.0, 10.0, 0.0, 0.0] (observe (initial ())),
]

// One fixed update bumps them all and asks for a save.
entry const test_a_frame_runs_its_fixed_update_on_fresh_transients = fn () => check.report #[
  check.equal #[8.0, 12.0, 1.0, 1.0] (observe (first ())),
]

// A frame with no fixed update leaves the transients fresh, the request
// dropped, and the input as it was.
entry const test_a_frame_without_an_update_still_resets_the_transients = fn () => check.report #[
  check.equal #[7.0, 10.0, 1.0, 0.0] (observe (idle ())),
]

// Two fixed updates in a frame bump fresh transients twice.
entry const test_transients_reset_once_a_frame_not_once_an_update = fn () => check.report #[
  check.equal #[9.0, 14.0, 3.0, 1.0] (observe (second ())),
]

// The input is saved and the transients are not.
entry const test_a_restored_world_keeps_saved_resources_and_starts_transients_afresh = fn () => check.report #[
  check.equal #[7.0, 10.0, 3.0, 0.0] (observe (app.restore application 1 (app.encode application 1 (second ())))),
]
