import * as test from "std/test"
import * as input from "ink/input"
import * as keys from "ink/input/keys"
import * as events from "ink/events"

@[test.suite]
test "repeat focus and pointer claims are event local":
  let state = #[input.initial]
  let held: #[U32] = #[]
  let fresh: #[U32] = #[]
  let buttons: #[U32] = #[]
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.KeyDown keys.a)
  let first = input.just_pressed (input.read state held fresh buttons) keys.a
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.KeyDown keys.a)
  let repeated = not (input.just_pressed (input.read state held fresh buttons) keys.a)
  let down = input.pressed (input.read state held fresh buttons) keys.a
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.PointerMove {x: 30.0, y: 10.0})
  state := input.claim state
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.PointerDown {button: 0, x: 33.0, y: 8.0})
  let clicked = state[0]
  let button = input.button_held (input.read state held fresh buttons) input.primary
  let (state, held, fresh, buttons) = input.receive state held fresh buttons $events.FocusLost
  use test.holds "check 1" first
  use test.holds "check 2" repeated
  use test.holds "check 3" down
  use test.holds "check 4" button
  use test.holds "check 5" (not clicked.claimed)
  use test.near_array "check 6" 0.0 #[3.0, -2.0, 33.0, 8.0, 0.0, 0.0] #[clicked.dx, clicked.dy, state[0].x, state[0].y, from held.length, from buttons.length]
  return ()
@[test.suite]
test "axes balance and codec round trips":
  let state = #[input.initial]
  let held: #[U32] = #[]
  let fresh: #[U32] = #[]
  let buttons: #[U32] = #[]
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.KeyDown keys.left)
  let left = input.axis (input.read state held fresh buttons) keys.left keys.right
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.KeyDown keys.right)
  let balanced = input.axis (input.read state held fresh buttons) keys.left keys.right
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.PointerDown {button: 2, x: 5.0, y: 8.0})
  let encoded = input.encode (input.read state held fresh buttons)
  let (state, held, fresh, buttons) = input.receive state held fresh buttons $events.FocusLost
  let (state, held, fresh, buttons) = input.decode_into encoded state held fresh buttons
  let restored = input.read state held fresh buttons
  use test.near_array "check 1" 0.0 #[-1.0, 0.0] #[left, balanced]
  use test.holds "check 2" (input.pressed restored keys.left)
  use test.holds "check 3" (input.pressed restored keys.right)
  use test.holds "check 4" (input.button_held restored input.secondary)
  use test.near_array "check 5" 0.0 encoded (input.encode restored)
  return ()
@[test.suite]
test "new sessions release saved keys and buttons":
  let state = #[input.initial]
  let held: #[U32] = #[]
  let fresh: #[U32] = #[]
  let buttons: #[U32] = #[]
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.KeyDown keys.w)
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.PointerDown {button: input.primary, x: 33.0, y: 8.0})
  state := input.claim state
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.SessionStarted {restored: true})
  use test.near_array "check 1" 0.0 #[0.0, 0.0, 0.0, 33.0, 8.0] #[from held.length, from buttons.length, from fresh.length, state[0].x, state[0].y]
  use test.holds "check 2" (not state[0].claimed)
  return ()
io input_workload (count: U32) =>
  let state = #[input.initial]
  let held: #[U32] = #[]
  let fresh: #[U32] = #[]
  let buttons: #[U32] = #[]
  let checksum = 0.0
  for index in 0 .. count:
    let (s1, h1, f1, b1) = input.receive state held fresh buttons ($events.PointerMove {x: from index, y: 10.0})
    let (s2, h2, f2, b2) = input.receive s1 h1 f1 b1 ($events.KeyDown keys.a)
    checksum := self + input.axis (input.read s2 h2 f2 b2) keys.left keys.a
    let (s3, h3, f3, b3) = input.receive s2 h2 f2 b2 ($events.KeyUp keys.a)
    state := s3
    held := h3
    fresh := f3
    buttons := b3
  return checksum + state[0].x
@[test.suite]
test "wheel uses its current pointer without creating drag motion":
  let state = #[input.initial]
  let held: #[U32] = #[]
  let fresh: #[U32] = #[]
  let buttons: #[U32] = #[]
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.PointerDown {button: 2, x: 10.0, y: 20.0})
  let (state, held, fresh, buttons) = input.receive state held fresh buttons ($events.Wheel {delta: 1.0, x: 30.0, y: 40.0})
  use test.near_array "check 1" 0.0 #[30.0, 40.0, 0.0, 0.0] #[state[0].x, state[0].y, state[0].dx, state[0].dy]
  use test.holds "check 2" (input.button_held (input.read state held fresh buttons) input.secondary and not state[0].claimed)
  return ()
