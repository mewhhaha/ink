import { Vec3 } from "std/vector"
import * as compound from "ink/physics/compound"
import * as soft from "ink/physics/soft"
import * as vehicle from "ink/physics/vehicle"
import * as math from "ink/math"

func vec_at (a: #[F32]) -> (i: U32) : Vec3 => math.vec3 a[i] a[i + 1] a[i + 2]
func quat_at (a: #[F32]) -> (i: U32) : math.Quat => $math.Quat { x: a[i], y: a[i + 1], z: a[i + 2], w: a[i + 3] }

// Input: [box_half(3), box_pos(3), box_rot(4), box_mass, sph_r, sph_pos(3), sph_mass] = 16 floats.
// Output: [ok, mass, com(3), xx, yy, zz, xy, xz, yz, radius] = 12 floats.
entry func compound_two (a: #[F32]) : #[F32] =>
  let parts = #[
    $compound.Part { shape: $compound.Box { half: vec_at a 0 }, position: vec_at a 3, rotation: quat_at a 6, mass: a[10] },
    $compound.Part { shape: $compound.Sphere { radius: a[11] }, position: vec_at a 12, rotation: math.identity_quat, mass: a[15] },
  ]
  let $Some s = compound.combine parts else:
    return #[0.0]
  return #[1.0, s.mass, s.center_of_mass.x, s.center_of_mass.y, s.center_of_mass.z, s.inertia.xx, s.inertia.yy, s.inertia.zz, s.inertia.xy, s.inertia.xz, s.inertia.yz, s.radius]

// Input: [wheelbase, track, steer, slip, b, c, d, e] = 8 floats.
// Output: [left, right, pacejka] = 3 floats.
entry func vehicle_curves (a: #[F32]) : #[F32] =>
  let (l, r) = vehicle.ackermann a[0] a[1] a[2]
  let p = vehicle.pacejka a[3] a[4] a[5] a[6] a[7]
  return #[l, r, p]

// Input: [y, radius, water_height, volume, density, gravity, vy, lin_drag, quad_drag] = 9 floats.
// Output: [ok, frac, force_y] = 3 floats.
entry func buoyancy_single (a: #[F32]) : #[F32] =>
  let pontoons = #[$soft.Pontoon { offset: math.zero3, radius: a[1], volume: a[3] }]
  let $Some res = soft.buoyancy (math.vec3 0.0 a[0] 0.0) math.identity_quat (math.vec3 0.0 a[6] 0.0) math.zero3 pontoons a[2] a[4] a[5] a[7] a[8] else:
    return #[0.0, 0.0, 0.0]
  return #[1.0, res.submerged_fraction, res.force.y]
