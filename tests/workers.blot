import * as array from "std/array"
import * as workers from "ink/pen/workers"
entry const roundtrip = fn () => array.flatten (workers.decode 3 (workers.encode #[#[1.0, 2.0], #[], #[3.0]]))
entry const encode = fn () => workers.encode #[#[1.0, 2.0], #[], #[3.0]]
entry const decode = fn packet => array.flatten (workers.decode 1 packet)
// Packet cost only; actual CPU workers are measured in Pen's native host.
entry const packets = fn (count: U32) => do:
  let jobs = array.generate count (fn job => array.generate 64 (fn lane => U32.to_f32 (job * 64 + lane)))
  let restored = workers.decode count (workers.encode jobs)
  let values = array.flatten restored
  return #[from values.length, array.fold_left (fn sum value => sum + value) 0.0 values]
