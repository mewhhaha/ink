import * as check from "./check"
import * as array from "std/array"
import * as workers from "ink/pen/workers"
const jobs = #[$workers.Span {start:0,count:2},$workers.Span {start:2,count:0},$workers.Span {start:2,count:1}]
const payload: Array F32 = #[1.0,2.0,3.0]
entry const encode = func () => return do:
  let packet: ResizeArray F32 = #[]
  workers.encode jobs payload packet
  return @storage.freeze packet
const decoded = func (count:U32) -> (packet:Array F32) : Array F32 => return do:
  let rows: ResizeArray workers.Span = #[]
  let values: ResizeArray F32 = #[]
  workers.decode count packet rows values
  return array.flatten rows values
entry const roundtrip = func () => return decoded 3 (encode ())
entry const decode = func packet => return decoded 1 packet
// Packet cost only; actual CPU workers are measured in Pen's native host.
entry const packets = func (count: U32) => return do:
  let rows = array.generate count (func job => return $workers.Span {start:job*64,count:64})
  let input = array.generate (count*64) U32.to_f32
  let packet: ResizeArray F32 = #[]
  workers.encode rows input packet
  let wire=@storage.freeze packet
  let values = decoded count wire
  return #[from values.length,array.fold_left (func sum -> value => return sum+value) 0.0 values]

entry const test_worker_wire_encoding = func () => return check.report #[check.equal #[-4670545.0,3.0,2.0,1.0,2.0,0.0,1.0,3.0] (encode ())]

entry const trap_worker_decode_0 = func () => return #[U32.to_f32 (decode #[]).length]

entry const trap_worker_decode_1 = func () => return #[U32.to_f32 (decode #[-4670545.0,0.0]).length]

entry const trap_worker_decode_2 = func () => return #[U32.to_f32 (decode #[-4670545.0,1.0,-1.0]).length]

entry const trap_worker_decode_3 = func () => return #[U32.to_f32 (decode #[-4670545.0,1.0,2.0,0.0]).length]

entry const trap_worker_decode_4 = func () => return #[U32.to_f32 (decode #[-4670545.0,1.0,16385.0]).length]

entry const trap_worker_decode_5 = func () => return #[U32.to_f32 (decode #[-4670545.0,1.0,0.0,3.0]).length]
