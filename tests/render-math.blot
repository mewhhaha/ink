import * as color from "ink/color"
import * as lighting from "ink/lighting"
import * as environment from "ink/environment"
import * as shadow from "ink/shadow"
import * as support from "./shadow_support"
import * as math from "ink/math"
import * as array from "std/array"
func vec (a: #[F32]) => func (i: U32) => math.vec3 a[i] a[i + 1] a[i + 2]
func rgb (a: #[F32]) => func (i: U32) => math.rgb a[i] a[i + 1] a[i + 2]
entry func channels (a: #[F32]) : #[F32] =>
  let c = math.rgba a[0] a[1] a[2] a[3]
  let linear = color.linear c
  let encoded = color.srgb linear
  let tone = color.tone c
  let display = color.display a[4] c
  return #[linear.r,linear.g,linear.b,linear.a,encoded.r,encoded.g,encoded.b,encoded.a,tone.r,tone.g,tone.b,display.r,display.g,display.b,color.luminance c,color.power a[5] a[6],color.exp2 a[7],color.log2 a[5]]
entry func brdf (a: #[F32]) : #[F32] =>
  let material = $lighting.Material { base: rgb a 0,metallic: a[3],roughness: a[4],emission: math.rgb 0.0 0.0 0.0,ior: 1.5,specular: 1.0,specular_color: math.rgb 1.0 1.0 1.0 }
  let value = lighting.brdf material (vec a 5) (vec a 8) (vec a 11)
  return #[value.r,value.g,value.b]
entry func light (a: #[F32]) : #[F32] =>
  let point = lighting.sample ($lighting.Point { position: vec a 0,intensity: rgb a 3,range: a[6] }) (vec a 7)
  let spot = lighting.sample ($lighting.Spot { position: vec a 0,direction: vec a 10,intensity: rgb a 3,range: a[6],inner_cos: a[13],outer_cos: a[14] }) (vec a 7)
  return #[point.direction.x,point.direction.y,point.direction.z,point.radiance.r,point.radiance.g,point.radiance.b,spot.radiance.r,spot.radiance.g,spot.radiance.b]
entry func energy (a: #[F32]) : #[F32] =>
  let material = $lighting.Material { base: rgb a 0,metallic: a[3],roughness: a[4],emission: math.rgb 0.0 0.0 0.0,ior: 1.5,specular: 1.0,specular_color: math.rgb 1.0 1.0 1.0 }
  let result = math.zero3
  let n = 64
  for y in 0..n:
    for x in 0..n:
      let cosine = (U32.to_f32 y + 0.5) / U32.to_f32 n
      let radial = sqrt (1.0 - cosine * cosine)
      let (s,c) = sin_cos ((U32.to_f32 x + 0.5) * 6.2831853 / U32.to_f32 n)
      let value = lighting.brdf material math.up (vec a 5) (math.vec3 (c * radial) cosine (s * radial))
      result := self + math.vec3 value.r value.g value.b
  return #[result.x * 6.2831853 / U32.to_f32 (n * n),result.y * 6.2831853 / U32.to_f32 (n * n),result.z * 6.2831853 / U32.to_f32 (n * n)]
entry func sh (a: #[F32]) : #[F32] =>
  let count = a.length / 7
  let samples = @array.generate count (func (i: U32) => $environment.Sample { direction: vec a (i * 7),radiance: rgb a (i * 7 + 3),solid_angle: a[i * 7 + 6] })
  let irradiance = environment.integrate samples
  let coefficients = @array.generate 27 (func (i: U32) =>
    let value = irradiance.coefficients[i / 3]
    if (i % 3) == 0:
      return value.r
    if (i % 3) == 1:
      return value.g
    return value.b)
  let up = environment.evaluate irradiance math.up
  let right = environment.evaluate irradiance math.right
  let forward = environment.evaluate irradiance math.forward
  return array.concat coefficients #[up.r,up.g,up.b,right.r,right.g,right.b,forward.r,forward.g,forward.b]
entry func sky (a: #[F32]) : #[F32] =>
  let settings = $environment.Sky { zenith: math.rgb 0.1 0.2 0.4,horizon: math.rgb 0.3 0.4 0.5,ground: math.rgb 0.01 0.02 0.03,sun_direction: math.up,sun: math.rgb 10.0 8.0 6.0,sun_cos_radius: 0.99 }
  let value = environment.sky settings (vec a 0)
  return #[value.r,value.g,value.b]
entry func splits (a: #[F32]) : #[F32] => shadow.splits a[0] a[1] (F32.to_u32 a[2]) a[3]
// A shadow fit of the 18 lanes `shadow_support.case_rig` reads: the light's view
// (16 lanes), then each cascade's projection (16), texel and far.
entry func cascades (a: #[F32]) : #[F32] =>
  let $Some fit = support.case_fit a else:
    return #[]
  let out: #[F32] = #[]
  for lane in math.Mat4.lanes fit.view:
    @storage.push out lane
  for cascade in fit.cascades:
    for lane in math.Mat4.lanes cascade.projection:
      @storage.push out lane
    @storage.push out cascade.texel
    @storage.push out cascade.far
  return out
// The worst NDC overshoot of any slice corner of a fit, then its cascade count.
entry func cascade_reach (a: #[F32]) : #[F32] =>
  let $Some fit = support.case_fit a else:
    return #[]
  return #[support.outside (support.case_rig a) fit, U32.to_f32 fit.cascades.length]

// Settings a: zenith 0-2, horizon 3-5, ground 6-8, ambient 9-11, then the
// grid's rows and columns. Returns tint (3), nine SH colours (27), then the
// ambient light facing up, right and down.
entry func ambient (a: #[F32]) : #[F32] =>
  let settings = $environment.Sky { zenith: rgb a 0, horizon: rgb a 3, ground: rgb a 6, sun_direction: math.up, sun: math.rgb 10.0 8.0 6.0, sun_cos_radius: 0.99 }
  let irradiance = environment.project settings (F32.to_u32 a[12]) (F32.to_u32 a[13])
  let light = environment.diffuse irradiance (rgb a 9)
  let shaded = $environment.Irradiance { coefficients: light.coefficients }
  let coefficients = @array.generate 27 (func (i: U32) =>
    let value = light.coefficients[i / 3]
    if (i % 3) == 0:
      return value.r
    if (i % 3) == 1:
      return value.g
    return value.b)
  let up = environment.evaluate shaded math.up
  let right = environment.evaluate shaded math.right
  let down = environment.evaluate shaded (math.vec3 0.0 (-1.0) 0.0)
  return array.concat (array.concat #[light.tint.r,light.tint.g,light.tint.b] coefficients) #[up.r,up.g,up.b,right.r,right.g,right.b,down.r,down.g,down.b]
