import * as check from "./check"
import * as array from "std/array"
import * as brush from "ink/brush"
import * as math from "ink/math"
import * as render from "ink/render"
import { Vec3 } from "std/vector"

func same (a: Vec3) -> (b: Vec3) => a.x == b.x and a.y == b.y and a.z == b.z
func corner (point: Vec3) => return
  (point.x == 0.0 or point.x == 1.0) and (point.y == 0.0 or point.y == 1.0) and (point.z == 0.0 or point.z == 1.0)
func corner_index (point: Vec3) => return
  (if point.x == 1.0 then 1 else 0) + (if point.y == 1.0 then 2 else 0) + (if point.z == 1.0 then 4 else 0)

#entry func test_box_edges_are_unique_unit_segments_and_independent_outputs () =>
  let box = brush.box math.zero3 math.one3 2
  let edges = brush.edges box
  let separate = brush.edges box
  let degrees: #[U32] = array.fill 8 0
  let valid = true
  for index in 0 .. edges.length:
    let (a, b) = edges[index]
    valid := self and corner a and corner b and abs ((a - b).length - 1.0) < 0.00001
    degrees[corner_index a] := self + 1
    degrees[corner_index b] := self + 1
    for previous in 0 .. index:
      let (c, d) = edges[previous]
      if (same a c and same b d) or (same a d and same b c):
        valid := false
  for degree in degrees:
    valid := self and degree == 3
  let (a, _) = edges[0]
  edges[0] := (a, a)
  let (c, d) = separate[0]
  return check.report #[check.holds (edges.length == 12 and separate.length == 12),
    check.holds valid, check.holds (abs ((c - d).length - 1.0) < 0.00001), check.holds (box.faces.length == 6)]
