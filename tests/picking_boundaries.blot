import * as math from "ink/math"
import * as picking from "ink/picking"
import * as transform from "ink/transform"

const pose = #transform.Pose3 { position: math.zero3, rotation: math.identity_quat, scale: math.one3 }
const ray = #math.Ray { origin: math.vec3 0.0 0.0 3.0, direction: math.forward }
const index = fn (selected: Maybe U32) => case selected of
  #Some value => value
  #Nothing => 0xFFFFFFFF

entry const aligned = fn () -> Array U32 => #[
  index (picking.nearest #[#Some pose, #Some pose] #[] ray),
  index (picking.nearest #[#Some pose, #Some pose] #[#Nothing, #Some #picking.Pickable] ray),
  index (picking.nearest #[#Some pose, #Some pose] #[#Some #picking.Pickable] ray),
  index (picking.nearest #[#Some pose, #Some pose] #[#Some #picking.Pickable, #Some #picking.Pickable] ray),
]
