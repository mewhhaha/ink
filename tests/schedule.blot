import * as check from "./check"
import * as array from "std/array"
import * as schedule from "ink/schedule"
const pure = fn reads writes after => #schedule.Node { access: schedule.access reads writes, mode: #schedule.Pure, after }
const waves = fn nodes => case schedule.plan 4 nodes of
  #Nothing => #[999]
  #Some plan => array.flatten #[array.concat #[wave.length] wave | wave <- plan.waves]
entry const dependencies = fn () => waves #[
  pure #[1] #[2] #[], pure #[1] #[3] #[], pure #[2, 3] #[4] #[], pure #[5] #[6] #[],
  #schedule.Node { access: schedule.access #[] #[], mode: #schedule.Unknown, after: #[] },
  pure #[4] #[7] #[], pure #[5] #[8] #[]]
entry const rejected = fn () => #[
  if Maybe.is_some (schedule.plan 0 #[]) then 0 else 1,
  if Maybe.is_some (schedule.plan 4 #[pure #[] #[] #[0]]) then 0 else 1,
  if Maybe.is_some (schedule.plan 4 #[pure #[] #[] #[1], pure #[] #[] #[0]]) then 0 else 1,
  if Maybe.is_some (schedule.plan 4 #[pure #[] #[] #[2]]) then 0 else 1]
// Compare parallel-wave deltas with authored serial updates over many hazards.
entry const equivalence = fn (seed: U32) => do:
  let nodes = array.generate 20 (fn index => pure #[(index * 3 + seed) % 7] #[(index * 5 + seed) % 7] #[])
  let #Some plan = schedule.plan 4 nodes else:
    return 0
  let serial = array.generate 7 (fn index => index + 1)
  for node in nodes:
    serial[node.access.writes[0]] := serial[node.access.reads[0]] + 1
  let original = array.generate 7 (fn index => index + 1)
  let executed = schedule.execute plan original
    (fn index (snapshot: Array U32) => snapshot[nodes[index].access.reads[0]] + 1)
    (fn (state: Array U32) index value => do:
      state[nodes[index].access.writes[0]] := value
      return state)
  let #Some parallel = executed else:
    return 0
  for index in 0 .. 7:
    if serial[index] != parallel[index]:
      return 0
    if original[index] != index + 1:
      return 0
  return 1
entry const invalid_execution = fn () => do:
  let check = fn candidate => Bool.not (Maybe.is_some (schedule.execute candidate 0 (fn (_: U32) (n: U32) => n + 1) (fn n _ value => n + value)))
  return #[if check value then 1 else 0 | value <- #[
    #schedule.Plan { dependencies: #[#[], #[0]], waves: #[#[1], #[0]] },
    #schedule.Plan { dependencies: #[#[], #[]], waves: #[#[0, 0]] },
    #schedule.Plan { dependencies: #[#[]], waves: #[#[1]] },
    #schedule.Plan { dependencies: #[#[], #[]], waves: #[#[0]] },
    #schedule.Plan { dependencies: #[#[]], waves: #[#[]] }]]

entry const test_hazards_dependencies_and_barriers = fn () => check.report (array.concat
  #[check.words #[3,0,1,3,1,2,1,4,2,5,6] (dependencies ()),
    check.words #[1,1,1,1] (rejected ()),
    check.words #[1,1,1,1,1] (invalid_execution ())]
  #[check.words #[1] #[equivalence seed] | seed <- array.generate 100 identity])
