import * as check from "./check"
import * as array from "std/array"
import * as schedule from "ink/schedule"
import * as graph from "ink/graph"
func words view : Array U32 => return array.generate view.length (func i => return view.at i)
func pure read_start -> read_count -> write_start -> after_start -> after_count => return
  $schedule.Node {access: schedule.access (schedule.span read_start read_count) (schedule.span write_start 1), mode: $schedule.Pure, after: schedule.span after_start after_count}
entry func test_hazards_dependencies_and_barriers () => return do:
  let channels = #[1, 2, 1, 3, 2, 3, 4, 5, 6, 4, 7, 5, 8]
  let nodes = #[pure 0 1 1 0 0, pure 2 1 3 0 0, pure 4 2 6 0 0, pure 7 1 8 0 0,
    $schedule.Node {access: schedule.access (schedule.span 0 0) (schedule.span 0 0), mode: $schedule.Unknown, after: schedule.span 0 0},
    pure 9 1 10 0 0, pure 11 1 12 0 0]
  let dependency_starts: ResizeArray U32 = #[]
  let dependency_targets: ResizeArray U32 = #[]
  let wave_starts: ResizeArray U32 = #[]
  let wave_nodes: ResizeArray U32 = #[]
  let $Some plan = schedule.plan 4 nodes channels dependency_starts dependency_targets wave_starts wave_nodes else:
    return check.report #[check.words #[1] #[0]]
  return check.report #[check.words #[0, 3, 4, 5, 7] (words plan.waves.starts),
    check.words #[0, 1, 3, 2, 4, 5, 6] (words plan.waves.nodes)]
entry func test_serial_wave_equivalence () => return do:
  let witnesses = array.fill 16 0
  for seed in 0 .. 16:
    let channels = array.generate 40 (func i => return if i % 2 == 0 then ((i / 2) * 3 + seed) % 7 else ((i / 2) * 5 + seed) % 7)
    let nodes = array.generate 20 (func i => return pure (i * 2) 1 (i * 2 + 1) 0 0)
    let dependency_starts: ResizeArray U32 = #[]
    let dependency_targets: ResizeArray U32 = #[]
    let wave_starts: ResizeArray U32 = #[]
    let wave_nodes: ResizeArray U32 = #[]
    let $Some plan = schedule.plan 4 nodes channels dependency_starts dependency_targets wave_starts wave_nodes else:
      return check.report #[check.words #[1] #[0]]
    let serial = array.generate 7 (func i => return i + 1)
    for node in nodes:
      serial[channels[node.access.writes.start]] = serial[channels[node.access.reads.start]] + 1
    let current = array.generate 7 (func i => return i + 1)
    let ran = schedule.execute plan current
      (func state -> selected => return array.generate selected.length (func i => return state[channels[nodes[selected.at i].access.reads.start]] + 1))
      (func state -> index -> value => return do:
        state[channels[nodes[index].access.writes.start]] = value)
    let equal = ran
    for i in 0 .. 7:
      equal := self and current[i] == serial[i]
    witnesses[seed] = if equal then 1 else 0
  return check.report #[check.words (array.fill 16 1) witnesses]
entry func test_invalid_plan_does_not_dispatch () => return do:
  let dependencies_starts: ResizeArray U32 = #[0, 0, 1]
  let dependencies_targets: ResizeArray U32 = #[0]
  let $Some dependencies = graph.bind dependencies_starts dependencies_targets else:
    return check.report #[check.words #[1] #[0]]
  let starts = #[0, 1, 2]
  let nodes = #[1, 0]
  let invalid = $schedule.Plan {dependencies, waves: $graph.Waves {starts: &starts[0..starts.length], nodes: &nodes[0..nodes.length]}}
  let calls = #[0]
  let ran = schedule.execute invalid calls
    (func state -> selected => return do:
      state[0] = state[0] + 1
      return array.fill selected.length 0)
    (func state -> index -> value => return do:
      state[0] = state[0] + 1)
  return check.report #[check.words #[0, 0] #[if ran then 1 else 0, calls[0]]]
