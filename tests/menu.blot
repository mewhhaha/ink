import * as check from "./check"
import * as array from "std/array"
import * as fixture from "./ui_font"
import * as math from "ink/math"
import * as menu from "ink/menu"
import * as ui from "ink/ui"
import * as events from "ink/events"

const style = menu.plain fixture.face 3
const words = #menu.Words { on: #[89], off: #[78], percent: #[37] }
const shape = menu.column 1 20.0 400.0 40.0 18.0 1.0 400.0
const choice = #ui.Choice { label: #[65], options: #[#[65], #[66], #[67]], chosen: 1 }
const highlighted = fn (control: ui.Control) => fn (x: F32) => fn (y: F32) => do:
  let sprites = menu.sprites style words menu.unfocused shape #[control] 0.0 0.0 1.0 (math.vec2 x y)
  return #[sprite.x | sprite <- sprites, sprite.material == style.fill, sprite.width < shape.rows[0].width]

entry const test_hover_marks_only_the_left_or_right_arrow = fn () => check.report #[
  check.equal #[shape.values] (highlighted choice (shape.values + 10.0) 40.0),
  check.equal #[shape.right - 32.0] (highlighted choice (shape.right - 10.0) 40.0),
  check.equal #[] (highlighted choice 5.0 40.0),
  check.equal #[] (highlighted choice (shape.values + 10.0) 70.0),
  check.equal #[] (highlighted (#ui.Choice { label: #[65], options: #[#[65]], chosen: 0 }) (shape.values + 10.0) 40.0),
]

entry const test_highlighted_arrow_steps_in_the_same_direction = fn () => do:
  let checks = #[]
  for x in #[shape.values + 10.0, shape.right - 10.0]:
    let (_, result) = menu.receive menu.unfocused shape #[choice] (#events.PointerDown { button: 0, x, y: 40.0 })
    let chosen = case result of
      #ui.Changed { control: #ui.Choice { chosen } } => chosen
      _ => 99
    let expected = 0
    if x > (shape.values + shape.right) * 0.5:
      expected := 2
    checks := array.push (check.equal #[U32.to_f32 expected] #[U32.to_f32 chosen]) self
  return check.report checks
