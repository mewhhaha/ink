import * as check from "./check"
import * as array from "std/array"
import * as fixture from "./ui_font"
import * as math from "ink/math"
import * as menu from "ink/menu"
import * as ui from "ink/ui"
import * as events from "ink/events"
import * as render from "ink/render"

const style = menu.plain fixture.face 3
func with_menu consume => return do:
  let yes = #[89]
  let no = #[78]
  let percent = #[37]
  let label = #[65]
  let b = #[66]
  let c = #[67]
  let options = #[&label[0..label.length], &b[0..b.length], &c[0..c.length]]
  let words = $menu.Words {on: &yes[0..yes.length], off: &no[0..no.length], percent: &percent[0..percent.length]}
  let rectangles: ResizeArray ui.Rect = #[]
  let shape = menu.column_into rectangles 1 20.0 400.0 40.0 18.0 1.0 400.0
  let choice = $ui.Choice {label: &label[0..label.length], options: &options[0..options.length], chosen: 1}
  return consume shape choice words
func highlighted (shape: menu.Layout) -> words -> (control: ui.Control) -> (x: F32) -> (y: F32) => return do:
  let sprites: ResizeArray render.Sprite = #[]
  menu.sprites style words menu.unfocused shape #[control] 0.0 0.0 1.0 (math.vec2 x y) sprites
  return #[sprite.x | sprite <- sprites, sprite.material == style.fill, sprite.width < shape.rows[0].width]
entry func test_hover_marks_only_the_left_or_right_arrow () => return with_menu (func shape -> choice -> words => return do:
  let label = #[65]
  let one = #[&label[0..label.length]]
  return check.report #[
    check.equal #[shape.values] (highlighted shape words choice (shape.values + 10.0) 40.0),
    check.equal #[shape.right - 32.0] (highlighted shape words choice (shape.right - 10.0) 40.0),
    check.equal #[] (highlighted shape words choice 5.0 40.0),
    check.equal #[] (highlighted shape words choice (shape.values + 10.0) 70.0),
    check.equal #[] (highlighted shape words ($ui.Choice {label: &label[0..label.length], options: &one[0..one.length], chosen: 0}) (shape.values + 10.0) 40.0),
  ])
entry func test_highlighted_arrow_steps_in_the_same_direction () => return with_menu (func shape -> choice -> words => return do:
  let checks: GrowArray check.Check = #[]
  for x in #[shape.values + 10.0, shape.right - 10.0]:
    let (_, result) = menu.receive menu.unfocused shape #[choice] ($events.PointerDown {button: 0, x, y: 40.0})
    let chosen = case result of
      $ui.Changed {control: $ui.Choice {chosen}} => chosen
      _ => 99
    let expected = 0
    if x > (shape.values + shape.right) * 0.5:
      expected := 2
    @storage.push checks (check.equal #[U32.to_f32 expected] #[U32.to_f32 chosen])
  return check.report (@storage.freeze checks))

entry func test_choice_keeps_value_then_arrow_highlights_and_glyphs_in_order () => return with_menu (func shape -> choice -> words => return do:
  let $ui.Choice {options, chosen} = choice else:
    return check.report #[check.holds false]
  let row = shape.rows.at 0
  let left = menu.choice_sprites style shape row options chosen style.value (math.vec2 (shape.values + 10.0) 40.0) 0.0 1.0
  let right = menu.choice_sprites style shape row options chosen style.value (math.vec2 (shape.right - 10.0) 40.0) 0.0 1.0
  return check.report #[
    check.words #[fixture.face.material, style.fill, fixture.face.material, fixture.face.material] #[sprite.material | sprite <- left],
    check.words #[fixture.face.material, fixture.face.material, style.fill, fixture.face.material] #[sprite.material | sprite <- right],
  ])
