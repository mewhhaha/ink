import * as check from "./check"
import * as array from "std/array"
import * as fixture from "./ui_font"
import * as math from "ink/math"
import * as menu from "ink/menu"
import * as ui from "ink/ui"
import * as tree from "ink/ui/tree"
import * as events from "ink/events"
import * as render from "ink/render"

const style = menu.plain fixture.face 3
func with_menu consume =>
  let yes = #[89]
  let no = #[78]
  let percent = #[37]
  let labels: #[U32] = #[]
  let options_pool: #[tree.Span] = #[]
  let (label_span, labels) = tree.store_text #[65] labels
  let (b_span, labels) = tree.store_text #[66] labels
  let (c_span, labels) = tree.store_text #[67] labels
  let opt_start = options_pool.length
  @storage.push options_pool label_span
  @storage.push options_pool b_span
  @storage.push options_pool c_span
  let opts = $tree.Span {start: opt_start, count: 3}
  let one_start = options_pool.length
  @storage.push options_pool label_span
  let one_opts = $tree.Span {start: one_start, count: 1}
  let words = $menu.Words {on: &yes[0..yes.length], off: &no[0..no.length], percent: &percent[0..percent.length]}
  let rectangles: #[ui.Rect] = #[]
  let shape = menu.column_into rectangles 1 20.0 400.0 40.0 18.0 1.0 400.0
  let choice = $ui.Choice {label: label_span, options: opts, chosen: 1}
  let single = $ui.Choice {label: label_span, options: one_opts, chosen: 0}
  return consume (&labels[0..labels.length]) (&options_pool[0..options_pool.length]) shape choice single words
func highlighted (labels: &[U32]) -> (options_pool: &[tree.Span]) -> (shape: menu.Layout) -> words -> (control: ui.Control) -> (x: F32) -> (y: F32) =>
  let sprites: #[render.Sprite] = #[]
  sprites := menu.sprites labels options_pool style words menu.unfocused shape #[control] 0.0 0.0 1.0 (math.vec2 x y) self
  return #[sprite.x | sprite <- sprites, sprite.material == style.fill, sprite.width < shape.rows[0].width]
#entry func test_hover_marks_only_the_left_or_right_arrow () => with_menu (func labels -> options_pool -> shape -> choice -> single -> words =>
  return check.report #[
    check.equal #[shape.values] (highlighted labels options_pool shape words choice (shape.values + 10.0) 40.0),
    check.equal #[shape.right - 32.0] (highlighted labels options_pool shape words choice (shape.right - 10.0) 40.0),
    check.equal #[] (highlighted labels options_pool shape words choice 5.0 40.0),
    check.equal #[] (highlighted labels options_pool shape words choice (shape.values + 10.0) 70.0),
    check.equal #[] (highlighted labels options_pool shape words single (shape.values + 10.0) 40.0),
  ])
#entry func test_highlighted_arrow_steps_in_the_same_direction () => with_menu (func labels -> options_pool -> shape -> choice -> single -> words =>
  let checks: #[check.Check] = #[]
  for x in #[shape.values + 10.0, shape.right - 10.0]:
    let (_, result) = menu.receive menu.unfocused shape #[choice] ($events.PointerDown {button: 0, x, y: 40.0})
    let chosen = case result of
      $ui.Changed {control: $ui.Choice {chosen}} => chosen
      _ => 99
    let expected = 0
    if x > (shape.values + shape.right) * 0.5:
      expected := 2
    @storage.push checks (check.equal #[U32.to_f32 expected] #[U32.to_f32 chosen])
  return check.report checks)

#entry func test_choice_keeps_value_then_arrow_highlights_and_glyphs_in_order () => with_menu (func labels -> options_pool -> shape -> choice -> single -> words =>
  let $ui.Choice {options, chosen} = choice else:
    return check.report #[check.holds false]
  let row = shape.rows.at 0
  let left = menu.choice_sprites labels options_pool style shape row options chosen style.value (math.vec2 (shape.values + 10.0) 40.0) 0.0 1.0
  let right = menu.choice_sprites labels options_pool style shape row options chosen style.value (math.vec2 (shape.right - 10.0) 40.0) 0.0 1.0
  return check.report #[
    check.words #[fixture.face.material, style.fill, fixture.face.material, fixture.face.material] #[sprite.material | sprite <- left],
    check.words #[fixture.face.material, fixture.face.material, style.fill, fixture.face.material] #[sprite.material | sprite <- right],
  ])
