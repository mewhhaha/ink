import * as check from "./check"
import { Vec2 } from "std/vector"
import * as triggers from "ink/physics/triggers"
import * as shapes from "ink/physics/d2/shapes"
import * as broadphase from "ink/physics/d2/broadphase"
import * as narrowphase from "ink/physics/d2/narrowphase"
import * as joints from "ink/physics/d2/joints"
import * as queries from "ink/physics/d2/queries"
import * as character from "ink/physics/d2/character"
import * as world from "ink/physics/d2/world"

#entry func test_d2_shapes_inertia_filters_and_broadphase () =>
  let c = shapes.dynamic_circle ($Vec2 { x: 0.0, y: 0.0 }) 2.0 3.0 0.5 0.3
  let b = shapes.dynamic_box ($Vec2 { x: 0.0, y: 0.0 }) 1.0 2.0 6.0 0.2 0.4
  let cap = shapes.dynamic_capsule ($Vec2 { x: 0.0, y: 0.0 }) 1.0 0.5 2.0 0.1 0.5
  let tri = shapes.dynamic_polygon ($Vec2 { x: 0.0, y: 0.0 }) #[
    $Vec2 { x: 0.0, y: 0.0 },
    $Vec2 { x: 0.0, y: 2.0 },
    $Vec2 { x: 2.0, y: 0.0 },
  ] 4.0 0.0 0.5
  // Circle I = 0.5 * 3 * 4 = 6.0 -> inv_i = 1/6; Box I = 6 * (4 + 16) / 12 = 10.0 -> inv_i = 0.1.
  let f_player = $shapes.Filter2D { layer: 1, mask: 2 }
  let f_enemy = $shapes.Filter2D { layer: 2, mask: 1 }
  let f_debris = $shapes.Filter2D { layer: 4, mask: 4 }
  // Broadphase on 30 bodies + wide floor must match brute-force AABB overlap pairs deterministically.
  let bodies: #[shapes.Body2D] = #[shapes.static_box ($Vec2 { x: 0.0, y: (-1.0) }) 50.0 0.5 0.0 0.5]
  for i in 0 .. 24:
    let x = U32.to_f32 (i % 6) * 0.9
    let y = U32.to_f32 (i / 6) * 0.9
    @storage.push bodies (shapes.dynamic_box ($Vec2 { x, y }) 0.5 0.5 1.0 0.0 0.4)
  let bp = broadphase.broadphase_pairs 1.5 0.0 bodies
  // Count brute-force eligible overlapping pairs.
  let brute = 0
  for i in 0 .. bodies.length:
    for j in (i + 1) .. bodies.length:
      let ba = bodies[i]
      let bb = bodies[j]
      let active = ba.inv_mass > 0.0 or bb.inv_mass > 0.0 or ba.trigger or bb.trigger
      if active and shapes.filter_collides ba.filter bb.filter and shapes.aabb_overlaps (shapes.body_aabb ba) (shapes.body_aabb bb):
        brute := self + 1
  return check.report #[
    check.near 0.001 #[1.0 / 6.0, 0.1] #[c.inv_inertia, b.inv_inertia],
    check.holds (cap.inv_inertia > 0.0 and tri.inv_inertia > 0.0),
    check.holds (shapes.filter_collides f_player f_enemy and not (shapes.filter_collides f_player f_debris)),
    check.words #[brute] #[bp.length],
  ]

#entry func test_d2_two_point_manifolds_and_ghost_edge_seam () =>
  // Flat box resting on flat floor must yield a 2-point clipped manifold with distinct U32 keys.
  let floor_b = shapes.static_box ($Vec2 { x: 0.0, y: 0.0 }) 10.0 0.5 0.0 0.5
  let box_b = shapes.dynamic_box ($Vec2 { x: 0.0, y: 0.98 }) 0.5 0.5 1.0 0.0 0.5
  let bb_ok = case narrowphase.collide_bodies 0 box_b 1 floor_b of
    $Some m => m.count == 2 and m.p0.key != m.p1.key and abs (m.p0.point.x + m.p1.point.x) < 0.01
    $Nothing => false
  // Horizontal capsule resting on flat floor must yield a 2-point manifold.
  let flat_cap = shapes.body_with_pose ($Vec2 { x: 0.0, y: 0.98 }) (3.14159265 / 2.0) (shapes.dynamic_capsule ($Vec2 { x: 0.0, y: 0.98 }) 0.6 0.5 1.0 0.0 0.5)
  let cap_ok = case narrowphase.collide_bodies 0 flat_cap 1 floor_b of
    $Some m => m.count == 2
    $Nothing => false
  // Sliding circle across two connected horizontal ghost edges must NEVER snag backward at the seam x=0!
  let e0 = shapes.static_edge_ghost ($Vec2 { x: (-10.0), y: 0.0 }) ($Vec2 { x: (-5.0), y: 0.0 }) ($Vec2 { x: 0.0, y: 0.0 }) ($Vec2 { x: 5.0, y: 0.0 }) false true 0.0
  let e1 = shapes.static_edge_ghost ($Vec2 { x: (-5.0), y: 0.0 }) ($Vec2 { x: 0.0, y: 0.0 }) ($Vec2 { x: 5.0, y: 0.0 }) ($Vec2 { x: 10.0, y: 0.0 }) true false 0.0
  let ball = shapes.set_velocity ($Vec2 { x: 6.0, y: 0.0 }) 0.0 (shapes.dynamic_circle ($Vec2 { x: (-2.0), y: 0.49 }) 0.5 1.0 0.0 0.0)
  let bodies = #[ball, e0, e1]
  let cfg = world.default_config ($Vec2 { x: 0.0, y: (-9.81) })
  let cache: #[world.CachedImpulse2D] = #[]
  let prev: #[triggers.Pair] = #[]
  let min_vx = 6.0
  for _ in 0 .. 45:
    let (nb, _, nc, np, _) = world.step cfg (1.0 / 60.0) bodies #[] cache prev
    bodies := nb
    cache := nc
    prev := np
    if bodies[0].vel.x < min_vx:
      min_vx := bodies[0].vel.x
  return check.report #[
    check.holds bb_ok,
    check.holds cap_ok,
    check.holds (bodies[0].pos.x > 2.0 and min_vx > 5.5),
  ]

#entry func test_d2_warm_started_box_stack_and_sleep () =>
  let floor_b = shapes.static_box ($Vec2 { x: 0.0, y: (-0.5) }) 12.0 0.5 0.0 0.6
  let bodies: #[shapes.Body2D] = #[floor_b]
  for i in 0 .. 5:
    let y = 0.5 + U32.to_f32 i * 1.0
    @storage.push bodies (shapes.dynamic_box ($Vec2 { x: 0.0, y }) 0.5 0.5 1.0 0.0 0.6)
  let cfg0 = world.default_config ($Vec2 { x: 0.0, y: (-9.81) })
  let cfg = $world.WorldConfig2D {
    gravity: cfg0.gravity,
    iterations: 10,
    pos_iterations: 4,
    cell_size: 2.0,
    baumgarte: 0.25,
    slop: 0.005,
    enable_sleep: true,
    sleep_lin_eps: 0.05,
    sleep_ang_eps: 0.05,
    sleep_time: 0.35,
    enable_ccd: false,
    warm_start_scale: 1.0,
  }
  let cache: #[world.CachedImpulse2D] = #[]
  let prev: #[triggers.Pair] = #[]
  for _ in 0 .. 120:
    let (nb, _, nc, np, _) = world.step cfg (1.0 / 60.0) bodies #[] cache prev
    bodies := nb
    cache := nc
    prev := np
  let top = bodies[5]
  // All 5 boxes must stay vertically aligned (no wobble/collapse) and go to sleep cleanly!
  let all_asleep = true
  for i in 1 .. 6:
    if not bodies[i].asleep:
      all_asleep := false
  return check.report #[
    check.holds (abs top.pos.x < 0.05 and top.pos.y > 4.35 and top.pos.y < 4.65),
    check.holds (abs top.angle < 0.05 and all_asleep and cache.length >= 8),
  ]

#entry func test_d2_joints_distance_spring_revolute_prismatic_weld_wheel () =>
  let cfg0 = world.default_config ($Vec2 { x: 0.0, y: (-9.81) })
  let cfg = $world.WorldConfig2D {
    gravity: cfg0.gravity,
    iterations: 12,
    pos_iterations: 4,
    cell_size: 4.0,
    baumgarte: 0.25,
    slop: 0.005,
    enable_sleep: false,
    sleep_lin_eps: 0.04,
    sleep_ang_eps: 0.04,
    sleep_time: 0.5,
    enable_ccd: false,
    warm_start_scale: 1.0,
  }
  // 1. Distance pendulum: bob swings without stretching past rest_length = 2.0.
  let anchor = shapes.static_circle ($Vec2 { x: 0.0, y: 0.0 }) 0.1 0.0
  let bob = shapes.dynamic_circle ($Vec2 { x: 2.0, y: 0.0 }) 0.25 1.0 0.0 0.0
  let dj = joints.distance_joint 0 1 shapes.zero2 shapes.zero2 2.0
  let b_dist = #[anchor, bob]
  let c1: #[world.CachedImpulse2D] = #[]
  let p1: #[triggers.Pair] = #[]
  for _ in 0 .. 60:
    let (nb, _, nc, np, _) = world.step cfg (1.0 / 60.0) b_dist #[dj] c1 p1
    b_dist := nb
    c1 := nc
    p1 := np
  let pend_len = shapes.len2 (shapes.sub2 b_dist[1].pos b_dist[0].pos)
  // 2. Revolute motor spins dynamic arm around pivot; Weld keeps welded child locked; Prismatic slides on X rail.
  let pivot = shapes.static_box ($Vec2 { x: 10.0, y: 0.0 }) 0.2 0.2 0.0 0.0
  let arm = shapes.dynamic_box ($Vec2 { x: 11.0, y: 0.0 }) 1.0 0.2 1.0 0.0 0.0
  let rev = $joints.Joint2D {
    a: 0,
    b: 1,
    anchor_a: shapes.zero2,
    anchor_b: $Vec2 { x: (-1.0), y: 0.0 },
    collide_connected: false,
    kind: $joints.Revolute {
      enable_limit: false,
      lower_angle: 0.0,
      upper_angle: 0.0,
      enable_motor: true,
      motor_speed: 4.0,
      max_motor_torque: 50.0,
      ref_angle: 0.0,
    },
  }
  let b_rev = #[pivot, arm]
  let c2: #[world.CachedImpulse2D] = #[]
  let p2: #[triggers.Pair] = #[]
  let zero_cfg = $world.WorldConfig2D {
    gravity: shapes.zero2,
    iterations: 12,
    pos_iterations: 4,
    cell_size: 4.0,
    baumgarte: 0.25,
    slop: 0.005,
    enable_sleep: false,
    sleep_lin_eps: 0.04,
    sleep_ang_eps: 0.04,
    sleep_time: 0.5,
    enable_ccd: false,
    warm_start_scale: 1.0,
  }
  for _ in 0 .. 30:
    let (nb, _, nc, np, _) = world.step zero_cfg (1.0 / 60.0) b_rev #[rev] c2 p2
    b_rev := nb
    c2 := nc
    p2 := np
  // 3. Prismatic rail along X with limit [-1, 1] and motor pushing +X.
  let rail = shapes.static_box ($Vec2 { x: 0.0, y: 0.0 }) 0.2 0.2 0.0 0.0
  let slider = shapes.dynamic_box ($Vec2 { x: 0.0, y: 0.0 }) 0.3 0.3 1.0 0.0 0.0
  let pris = $joints.Joint2D {
    a: 0,
    b: 1,
    anchor_a: shapes.zero2,
    anchor_b: shapes.zero2,
    collide_connected: false,
    kind: $joints.Prismatic {
      local_axis_a: $Vec2 { x: 1.0, y: 0.0 },
      enable_limit: true,
      lower_translation: (-1.0),
      upper_translation: 1.0,
      enable_motor: true,
      motor_speed: 6.0,
      max_motor_force: 40.0,
      ref_angle: 0.0,
    },
  }
  let b_pr = #[rail, slider]
  let c3: #[world.CachedImpulse2D] = #[]
  let p3: #[triggers.Pair] = #[]
  for _ in 0 .. 45:
    let (nb, _, nc, np, _) = world.step zero_cfg (1.0 / 60.0) b_pr #[pris] c3 p3
    b_pr := nb
    c3 := nc
    p3 := np
  // 4. Spring + Wheel + Weld sanity under gravity.
  let chassis = shapes.dynamic_box ($Vec2 { x: 0.0, y: 1.5 }) 1.0 0.3 2.0 0.0 0.3
  let turret = shapes.dynamic_box ($Vec2 { x: 0.0, y: 2.0 }) 0.3 0.2 0.5 0.0 0.3
  let wheel = shapes.dynamic_circle ($Vec2 { x: 0.7, y: 0.8 }) 0.35 0.5 0.0 0.8
  let floor_b = shapes.static_box ($Vec2 { x: 0.0, y: 0.0 }) 20.0 0.5 0.0 0.8
  let wj = joints.weld_joint 0 1 ($Vec2 { x: 0.0, y: 0.5 }) shapes.zero2 0.0
  let whj = $joints.Joint2D {
    a: 0,
    b: 2,
    anchor_a: $Vec2 { x: 0.7, y: (-0.7) },
    anchor_b: shapes.zero2,
    collide_connected: false,
    kind: $joints.Wheel {
      local_axis_a: $Vec2 { x: 0.0, y: 1.0 },
      stiffness: 80.0,
      damping: 8.0,
      enable_motor: true,
      motor_speed: (-4.0),
      max_motor_torque: 15.0,
    },
  }
  let b_car = #[chassis, turret, wheel, floor_b]
  let c4: #[world.CachedImpulse2D] = #[]
  let p4: #[triggers.Pair] = #[]
  for _ in 0 .. 40:
    let (nb, _, nc, np, _) = world.step cfg (1.0 / 60.0) b_car #[wj, whj] c4 p4
    b_car := nb
    c4 := nc
    p4 := np
  let weld_sep = shapes.len2 (shapes.sub2 b_car[1].pos (shapes.to_world b_car[0] ($Vec2 { x: 0.0, y: 0.5 })))
  return check.report #[
    check.near 0.06 #[2.0] #[pend_len],
    check.holds (b_dist[1].pos.y < (-0.5)),
    check.holds (b_rev[1].ang_vel > 2.5 and shapes.len2 (shapes.sub2 (shapes.to_world b_rev[1] ($Vec2 { x: (-1.0), y: 0.0 })) b_rev[0].pos) < 0.05),
    check.holds (b_pr[1].pos.x > 0.85 and b_pr[1].pos.x < 1.1 and abs b_pr[1].pos.y < 0.05),
    check.holds (weld_sep < 0.08 and b_car[0].pos.y > 0.7),
  ]

#entry func test_d2_queries_ccd_one_way_and_triggers () =>
  // Spatial queries: raycast, raycast_all, overlap_point, overlap_aabb, shapecast.
  let c0 = shapes.static_circle ($Vec2 { x: 3.0, y: 0.0 }) 1.0 0.5
  let b1 = shapes.static_box ($Vec2 { x: 7.0, y: 0.0 }) 1.0 1.0 0.0 0.5
  let cap2 = shapes.static_capsule ($Vec2 { x: 11.0, y: 0.0 }) 0.5 0.5 0.0 0.5
  let ed3 = shapes.static_edge ($Vec2 { x: 14.0, y: (-2.0) }) ($Vec2 { x: 14.0, y: 2.0 }) 0.5
  let q_bodies = #[c0, b1, cap2, ed3]
  let hits = queries.raycast_all ($Vec2 { x: 0.0, y: 0.0 }) ($Vec2 { x: 1.0, y: 0.0 }) 20.0 shapes.default_filter false q_bodies
  let closest_ok = case queries.raycast ($Vec2 { x: 0.0, y: 0.0 }) ($Vec2 { x: 1.0, y: 0.0 }) 20.0 shapes.default_filter false q_bodies of
    $Some h => h.body == 0 and abs (h.t - 2.0) < 0.005 and h.normal.x < (-0.99)
    $Nothing => false
  let ov_pt = queries.overlap_point ($Vec2 { x: 7.2, y: 0.2 }) shapes.default_filter false q_bodies
  let ov_ab = queries.overlap_aabb ($shapes.Aabb2 { min: $Vec2 { x: 5.5, y: (-1.0) }, max: $Vec2 { x: 12.0, y: 1.0 } }) shapes.default_filter false q_bodies
  // CCD anti-tunneling: 600 m/s bullet (10m per frame) MUST bounce off a thin 0.2m wall!
  let wall = shapes.static_box ($Vec2 { x: 4.0, y: 0.0 }) 0.1 5.0 0.0 0.2
  let bullet = shapes.set_bullet true (shapes.set_velocity ($Vec2 { x: 600.0, y: 0.0 }) 0.0 (shapes.dynamic_circle ($Vec2 { x: 0.0, y: 0.0 }) 0.25 1.0 0.8 0.0))
  let cfg = world.default_config shapes.zero2
  let cc: #[world.CachedImpulse2D] = #[]
  let pp: #[triggers.Pair] = #[]
  let (ccd_out, _, _, _, _) = world.step cfg (1.0 / 60.0) #[bullet, wall] #[] cc pp
  let ccd_ok = ccd_out[0].pos.x < 4.0 and ccd_out[0].vel.x < (-100.0)
  // Trigger Enter -> Stay -> Exit lifecycle across frames.
  let sensor = shapes.trigger_box ($Vec2 { x: 2.0, y: 0.0 }) 1.0 1.0 0.0
  let mover = shapes.set_velocity ($Vec2 { x: 4.0, y: 0.0 }) 0.0 (shapes.dynamic_circle ($Vec2 { x: 0.0, y: 0.0 }) 0.4 1.0 0.0 0.0)
  let t_bodies = #[mover, sensor]
  let tc: #[world.CachedImpulse2D] = #[]
  let tp: #[triggers.Pair] = #[]
  let enters = 0
  let stays = 0
  let exits = 0
  for _ in 0 .. 75:
    let (nb, evs, nc, np, _) = world.step cfg (1.0 / 60.0) t_bodies #[] tc tp
    t_bodies := nb
    tc := nc
    tp := np
    for e in evs:
      let phase_id = case e.phase of
        $triggers.Enter => 0
        $triggers.Stay => 1
        $triggers.Exit => 2
      if phase_id == 0:
        enters := self + 1
      else:
        if phase_id == 1:
          stays := self + 1
        else:
          exits := self + 1
  // One-way semi-solid platform: rising ball passes through from below, then lands on top!
  let ow_plat = shapes.one_way_platform ($Vec2 { x: 0.0, y: 2.0 }) 5.0 0.1 0.3
  let jumper = shapes.set_velocity ($Vec2 { x: 0.0, y: 9.0 }) 0.0 (shapes.dynamic_circle ($Vec2 { x: 0.0, y: 0.5 }) 0.4 1.0 0.0 0.3)
  let ow_bodies = #[jumper, ow_plat]
  let oc: #[world.CachedImpulse2D] = #[]
  let op: #[triggers.Pair] = #[]
  let ow_cfg = world.default_config ($Vec2 { x: 0.0, y: (-9.81) })
  let peak_y = 0.0
  for _ in 0 .. 110:
    let (nb, _, nc, np, _) = world.step ow_cfg (1.0 / 60.0) ow_bodies #[] oc op
    ow_bodies := nb
    oc := nc
    op := np
    if ow_bodies[0].pos.y > peak_y:
      peak_y := ow_bodies[0].pos.y
  return check.report #[
    check.holds (closest_ok and hits.length == 4 and hits[0].body == 0 and hits[1].body == 1 and hits[2].body == 2 and hits[3].body == 3),
    check.words #[1, 1, 2] #[ov_pt.length, ov_pt[0], ov_ab.length],
    check.holds ccd_ok,
    check.holds (enters == 1 and stays >= 5 and exits == 1),
    check.holds (peak_y > 3.5 and ow_bodies[0].pos.y >= 2.4),
  ]

#entry func test_d2_character_controller_slopes_one_way_and_moving_platform () =>
  // Floor + 26-deg walkable ramp + upper ledge + steep wall + one-way platform + moving elevator.
  let floor_b = shapes.static_box ($Vec2 { x: 0.0, y: (-0.5) }) 10.0 0.5 0.0 0.5
  let ramp = shapes.static_edge ($Vec2 { x: 2.0, y: 0.0 }) ($Vec2 { x: 6.0, y: 2.0 }) 0.5
  let upper = shapes.static_edge ($Vec2 { x: 6.0, y: 2.0 }) ($Vec2 { x: 8.0, y: 2.0 }) 0.5
  let wall = shapes.static_box ($Vec2 { x: 7.0, y: 3.5 }) 0.25 2.0 0.0 0.5
  let ow = shapes.one_way_platform ($Vec2 { x: 0.0, y: 3.0 }) 3.0 0.1 0.5
  let elevator = shapes.set_velocity ($Vec2 { x: 3.0, y: 0.0 }) 0.0 (shapes.static_box ($Vec2 { x: (-6.0), y: 0.0 }) 1.5 0.2 0.0 0.5)
  let bodies = #[floor_b, ramp, upper, wall, ow, elevator]
  // 1. Climb walkable ramp onto upper ledge and stop cleanly at steep wall.
  let ch = character.character_capsule ($Vec2 { x: 1.0, y: 1.0 }) 0.35 0.45 45.0
  let hit_wall = false
  for _ in 0 .. 110:
    let res = character.move_character (1.0 / 60.0) ($Vec2 { x: 5.0, y: (-1.5) }) false ch bodies
    ch := res.character
    if res.on_wall:
      hit_wall := true
  let climbed_ok = ch.pos.y > 2.4 and ch.pos.x < 6.8 and hit_wall
  // 2. Pass upward through one-way platform, land on it, then drop through.
  let c2 = character.character_box ($Vec2 { x: 0.0, y: 1.5 }) 0.35 0.5 45.0
  for _ in 0 .. 20:
    let r = character.move_character (1.0 / 60.0) ($Vec2 { x: 0.0, y: 8.0 }) false c2 bodies
    c2 := r.character
  let above_ow = c2.pos.y > 3.5
  for _ in 0 .. 25:
    let r = character.move_character (1.0 / 60.0) ($Vec2 { x: 0.0, y: (-4.0) }) false c2 bodies
    c2 := r.character
  let landed_ow = c2.grounded and c2.pos.y >= 3.5
  for _ in 0 .. 20:
    let r = character.move_character (1.0 / 60.0) ($Vec2 { x: 0.0, y: (-4.0) }) true c2 bodies
    c2 := r.character
  let dropped_ow = c2.pos.y < 2.8
  // 3. Moving platform carry: standing on elevator at x=-6 moving +3 m/s carries character right!
  let c3 = character.character_box ($Vec2 { x: (-6.0), y: 0.72 }) 0.35 0.5 45.0
  let r0 = character.move_character (1.0 / 60.0) ($Vec2 { x: 0.0, y: (-2.0) }) false c3 bodies
  c3 := r0.character
  let start_x = c3.pos.x
  let r1 = character.move_character (1.0 / 60.0) ($Vec2 { x: 0.0, y: (-2.0) }) false c3 bodies
  let carried = r1.character.pos.x > start_x + 0.04
  return check.report #[
    check.holds climbed_ok,
    check.holds (above_ow and landed_ow and dropped_ow),
    check.holds carried,
  ]
