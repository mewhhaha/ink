import * as test from "std/test"
import * as map from "ink/map"
import * as frozen from "ink/map/frozen"
import * as array from "std/array"

func value found => Maybe.unwrap_or 0 found
// Deliberate collisions exercise probe chains, tombstones and rehashing.
const collisions = map.key (func (key: U32) => 7) (func (a: U32) -> (b: U32) => a == b)
@[test.suite]
test "collisions and growth":
  let rows: map.Map [U32, U32] = map.empty ()
  for i in 0 .. 80:
    rows := map.set collisions i (i + 1) rows
  rows := map.remove collisions 0 rows
  rows := map.remove collisions 40 rows
  rows := map.set collisions 79 123 rows
  rows := map.set collisions 80 81 rows
  let _v1 = #[79, 0, 40, 0, 123, 81]
  let _v2 = #[map.count rows,
    value (map.get collisions 0 rows), value (map.get collisions 39 rows),
    value (map.get collisions 40 rows), value (map.get collisions 79 rows),
    value (map.get collisions 80 rows)]
  use test.eq "check 1" _v1 _v2
  return ()
@[test.suite]
test "independent copy":
  let rows: map.Map [U32, U32] = map.set map.u32 5 8 (map.empty ())
  let copied: map.Map [U32, U32] = map.copy_into map.u32 identity identity (map.empty ()) rows
  rows := map.set map.u32 5 13 rows
  let _v3 = #[13, 8]
  let _v4 = #[value (map.get map.u32 5 rows), value (map.get map.u32 5 copied)]
  use test.eq "check 1" _v3 _v4
  return ()
@[test.suite]
test "ordered reinsert and frozen":
  let rows: map.Map [U32, U32] = map.from map.u32 #[(3, 1), (5, 2), (3, 4)] (map.empty ())
  rows := map.remove map.u32 3 rows
  rows := map.set map.u32 3 8 rows
  let saved = frozen.from map.u32 (map.entries rows)
  rows := map.set map.u32 3 13 rows
  // Exercise duplicate-key collapse, collision probing, order preservation, and missing-key lookup on frozen.Map.
  let dup = frozen.from collisions #[(10, 1), (20, 2), (10, 9), (30, 3), (20, 7)]
  let empty_f: frozen.Map [U32, U32] = frozen.from map.u32 #[]
  let _v5 = #[5, 3, 8]
  let _v6 = (array.concat (map.keys rows) #[value (frozen.get map.u32 3 saved)])
  use test.eq "check 1" _v5 _v6
  let _v7 = #[3, 9, 7, 3, 0, 0]
  let _v8 = #[
      frozen.count dup,
      value (frozen.get collisions 10 dup),
      value (frozen.get collisions 20 dup),
      value (frozen.get collisions 30 dup),
      value (frozen.get collisions 99 dup),
      value (frozen.get map.u32 1 empty_f),
    ]
  use test.eq "check 2" _v7 _v8
  let _v9 = #[10, 20, 30]
  let _v10 = (frozen.keys dup)
  use test.eq "check 3" _v9 _v10
  let _v11 = #[9, 7, 3]
  let _v12 = (frozen.values dup)
  use test.eq "check 4" _v11 _v12
  return ()

@[test.suite]
test "tombstone churn compacts and rehashes":
  let rows: map.Map [U32, U32] = map.empty ()
  // Keep live count <= 4 while churning 400 distinct keys to force tombstone cleanup.
  for i in 0 .. 400:
    rows := map.set map.u32 i (i * 3 + 1) rows
    if i >= 4:
      rows := map.remove map.u32 (i - 4) rows
  let ok = map.count rows == 4 and rows.rows.length <= 32 and rows.buckets.length == 18
  for i in 396 .. 400:
    ok := self and value (map.get map.u32 i rows) == i * 3 + 1
  ok := self and not (map.contains map.u32 0 rows) and not (map.contains map.u32 395 rows)
  use test.holds "check 1" ok
  let _v13 = #[396, 397, 398, 399]
  let _v14 = (map.keys rows)
  use test.eq "check 2" _v13 _v14
  let _v15 = #[1189, 1192, 1195, 1198]
  let _v16 = (map.values rows)
  use test.eq "check 3" _v15 _v16
  return ()
