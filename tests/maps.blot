import * as check from "./check"
import * as map from "ink/map"
import * as frozen from "ink/map/frozen"
import * as array from "std/array"

func value found => Maybe.unwrap_or 0 found
// Deliberate collisions exercise probe chains, tombstones and rehashing.
const collisions = map.key (func (key: U32) => 7) (func (a: U32) -> (b: U32) => a == b)
entry func test_collisions_and_growth () =>
  let rows: map.Map [U32, U32] = map.empty ()
  let slots = map.buckets ()
  for i in 0 .. 80:
    map.set collisions i (i + 1) rows slots
  map.remove collisions 0 rows slots
  map.remove collisions 40 rows slots
  map.set collisions 79 123 rows slots
  map.set collisions 80 81 rows slots
  return check.report #[check.words #[79, 0, 40, 0, 123, 81] #[map.count slots,
    value (map.get collisions 0 rows slots), value (map.get collisions 39 rows slots),
    value (map.get collisions 40 rows slots), value (map.get collisions 79 rows slots),
    value (map.get collisions 80 rows slots)]]
entry func test_independent_copy () =>
  let rows: map.Map [U32, U32] = map.empty ()
  let slots = map.buckets ()
  let copied: map.Map [U32, U32] = map.empty ()
  let copied_slots = map.buckets ()
  map.set map.u32 5 8 rows slots
  map.copy_into map.u32 identity identity copied copied_slots rows
  map.set map.u32 5 13 rows slots
  return check.report #[check.words #[13, 8] #[value (map.get map.u32 5 rows slots), value (map.get map.u32 5 copied copied_slots)]]
entry func test_ordered_reinsert_and_frozen () =>
  let rows: map.Map [U32, U32] = map.empty ()
  let slots = map.buckets ()
  map.from map.u32 #[(3, 1), (5, 2), (3, 4)] rows slots
  map.remove map.u32 3 rows slots
  map.set map.u32 3 8 rows slots
  let saved = frozen.from map.u32 (map.entries rows)
  map.set map.u32 3 13 rows slots
  return check.report #[check.words #[5, 3, 8] (array.concat (map.keys rows) #[value (frozen.get map.u32 3 saved)])]

entry func test_tombstone_churn_compacts_and_rehashes () =>
  let rows: map.Map [U32, U32] = map.empty ()
  let slots = map.buckets ()
  // Keep live count <= 4 while churning 400 distinct keys to force tombstone cleanup.
  for i in 0 .. 400:
    map.set map.u32 i (i * 3 + 1) rows slots
    if i >= 4:
      map.remove map.u32 (i - 4) rows slots
  let ok = map.count slots == 4 and rows.length <= 32 and slots.length == 18
  for i in 396 .. 400:
    ok := self and value (map.get map.u32 i rows slots) == i * 3 + 1
  ok := self and not (map.contains map.u32 0 rows slots) and not (map.contains map.u32 395 rows slots)
  return check.report #[check.holds ok, check.words #[396, 397, 398, 399] (map.keys rows),
    check.words #[1189, 1192, 1195, 1198] (map.values rows)]
