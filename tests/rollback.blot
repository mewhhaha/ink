import * as array from "std/array"
import * as test from "std/test"
import * as game from "./support/rollback_game"
import * as hash from "ink/hash"
import * as random from "ink/random"
import * as rollback from "ink/net/rollback"

// In-process peers exchange real packets through a seeded channel that loses,
// delays, jitters, reorders and duplicates them. Rows are fixed records spanning
// into one word pool; delivered rows are marked and skipped.
type Packet is data = $Packet {to: U32, due: U32, start: U32, count: U32, done: Bool}
type Net is data = $Net {rows: #[Packet], words: #[U32], head: U32, seed: U32}
type Peer is data = $Peer {s: rollback.Rollback, state: #[U32], ring: #[U32]}
type Weather is data = $Weather {latency: U32, jitter: U32, loss: U32, duplicate: U32, skip: U32}

func roll (net: own Net) -> (bound: U32) : (Net, U32) =>
  net.seed := random.next net.seed
  let value = (net.seed >> 4) % bound
  return (net, value)

func peer (config: rollback.Config) -> (seed: U32) : Peer =>
  let width = 2 + config.players * 4
  let ring: #[U32] = array.fill (rollback.snapshots config * width) 0
  return $Peer {s: rollback.make config, state: game.initial config.players seed, ring}

func enqueue (to: U32) -> (due: U32) -> (packet: #[U32]) -> (net: own Net) : Net =>
  let start = net.words.length
  for word in packet:
    @storage.push net.words word
  @storage.push net.rows ($Packet {to, due, start, count: packet.length, done: false})
  return net

func send (weather: Weather) -> (t: U32) -> (to: U32) -> (packet: #[U32]) -> (net: own Net) : Net =>
  let (a, lost) = roll net 100
  net := a
  if lost < weather.loss:
    return net
  let (b, jitter) = roll net (weather.jitter + 1)
  net := b
  net := enqueue to (t + weather.latency + jitter) packet net
  let (c, again) = roll net 100
  net := c
  if again < weather.duplicate:
    let (d, extra) = roll net (weather.jitter + 3)
    net := d
    net := enqueue to (t + weather.latency + extra) packet net
  return net

func deliver (id: U32) -> (t: U32) -> (net: own Net) -> (s: own rollback.Rollback) : (Net, rollback.Rollback) =>
  for i in net.head .. net.rows.length:
    let row = net.rows[i]
    if row.to == id and row.due <= t and not row.done:
      let (next, ok) = rollback.receive (&net.words[row.start..row.start + row.count]) s
      s := next
      net.rows[i] := $Packet {to: row.to, due: row.due, start: row.start, count: row.count, done: true}
  for i in net.head .. net.rows.length:
    if net.rows[i].done and i == net.head:
      net.head := net.head + 1
  return (net, s)

// One peer's unit of time: receive, simulate (unless it skips this unit or has
// finished its frames), then send to every other player.
func turn (step: own #[U32] -> #[U32] -> #[U32]) -> (id: U32) -> (t: U32) -> (frames: U32) -> (seed: U32) -> (weather: Weather) -> (s: own rollback.Rollback) -> (state: own #[U32]) -> (ring: own #[U32]) -> (net: own Net) : (Peer, Net) =>
  let width = state.length
  let (n1, s1) = deliver id t net s
  net := n1
  s := s1
  let (n2, skipped) = roll net 100
  net := n2
  let config = s.config
  if s.current < frames and skipped >= weather.skip:
    let input = game.sample_words seed id (rollback.local_frame s - config.delay)
    let (s2, st2, rg2, outcome) = rollback.advance rollback.repeat_last step (game.save width) (game.load width) (game.checksum width) (&input[0..2]) s state ring
    s := s2
    state := st2
    ring := rg2
  else:
    let (s2, st2, rg2) = rollback.resolve rollback.repeat_last step (game.save width) (game.load width) (game.checksum width) s state ring
    s := s2
    state := st2
    ring := rg2
  for to in 0 .. config.players:
    if to != id:
      net := send weather t to (rollback.encode s to weather.latency) net
  return ($Peer {s, state, ring}, net)

// Returns, per peer: matches lockstep, deepest rollback, rollbacks, stalls,
// desync frame (none when clean), settled; then the number of units used.
func simulate (players: U32) -> (frames: U32) -> (seed: U32) -> (window: U32) -> (delay: U32) -> (weather: Weather) -> (perturb: Bool) : #[U32] =>
  let config = (func local => $rollback.Config {players, lanes: 2, window, delay, local, interval: 4, redundancy: 6})
  let a = peer (config 0) seed
  let b = peer (config 1) seed
  let c = peer (config (players - 1)) seed
  let rows: #[Packet] = #[]
  let pool: #[U32] = #[]
  let net = $Net {rows, words: pool, head: 0, seed: seed ^ 0x5EED}
  let units = 0
  let limit = frames * 30 + 600
  let done = false
  for t in 0 .. limit:
    if not done:
      let (pa, na) = turn game.game_step 0 t frames seed weather a.s a.state a.ring net
      a := pa
      let (pb, nb) = if perturb then turn game.bad_step 1 t frames seed weather b.s b.state b.ring na else turn game.game_step 1 t frames seed weather b.s b.state b.ring na
      b := pb
      if players > 2:
        let (pc, nc) = turn game.game_step 2 t frames seed weather c.s c.state c.ring nb
        c := pc
        net := nc
      else:
        net := nb
      units := t + 1
      done := a.s.current == frames and b.s.current == frames and rollback.settled a.s and rollback.settled b.s
      if players > 2:
        done := done and c.s.current == frames and rollback.settled c.s
  let reference = game.lockstep players frames delay seed
  let report: #[U32] = #[]
  let ok_a = if game.words_checksum a.state == game.words_checksum reference then 1 else 0
  @storage.push report ok_a
  @storage.push report a.s.deepest
  @storage.push report a.s.rollbacks
  @storage.push report a.s.stalls
  @storage.push report a.s.desync
  @storage.push report (if rollback.settled a.s then 1 else 0)
  let ok_b = if game.words_checksum b.state == game.words_checksum reference then 1 else 0
  @storage.push report ok_b
  @storage.push report b.s.deepest
  @storage.push report b.s.rollbacks
  @storage.push report b.s.stalls
  @storage.push report b.s.desync
  @storage.push report (if rollback.settled b.s then 1 else 0)
  if players > 2:
    let ok_c = if game.words_checksum c.state == game.words_checksum reference then 1 else 0
    @storage.push report ok_c
    @storage.push report c.s.deepest
    @storage.push report c.s.rollbacks
    @storage.push report c.s.stalls
    @storage.push report c.s.desync
    @storage.push report (if rollback.settled c.s then 1 else 0)
  @storage.push report units
  return report

// Result layout per peer: matches, deepest, rollbacks, stalls, desync, settled.
func stride () : U32 => 6

func clean (players: U32) -> (frames: U32) -> (seed: U32) -> (window: U32) -> (delay: U32) -> (weather: Weather) : Bool =>
  let r = simulate players frames seed window delay weather false
  let good = true
  for peer in 0 .. players:
    let at = peer * stride ()
    if r[at] != 1 or r[at + 1] > window or r[at + 4] != 0xFFFFFFFF or r[at + 5] != 1:
      good := false
  return good

func weathers () : #[Weather] => #[
  $Weather {latency: 0, jitter: 0, loss: 0, duplicate: 0, skip: 0},
  $Weather {latency: 4, jitter: 3, loss: 0, duplicate: 0, skip: 0},
  $Weather {latency: 2, jitter: 4, loss: 25, duplicate: 20, skip: 15},
  $Weather {latency: 6, jitter: 6, loss: 40, duplicate: 30, skip: 30},
  $Weather {latency: 1, jitter: 8, loss: 10, duplicate: 50, skip: 5}]

@[test.suite]
test "two peers match the lockstep reference across seeds and latency":
  let results: #[Bool] = #[]
  for weather in weathers ():
    for seed in 1 .. 7:
      for delay in #[0, 2]:
        @storage.push results (clean 2 90 seed 8 delay weather)
  let failed = 0
  for ok in results:
    if not ok:
      failed := failed + 1
  let _v1 = #[0]
  let _v2 = #[failed]
  use test.eq "check 1" _v1 _v2
  let _v3 = #[60]
  let _v4 = #[results.length]
  use test.eq "check 2" _v3 _v4
  return ()

@[test.suite]
test "three peers match the lockstep reference across seeds and latency":
  let results: #[Bool] = #[]
  for weather in weathers ():
    for seed in 1 .. 5:
      for delay in #[1, 3]:
        @storage.push results (clean 3 70 seed 8 delay weather)
  let failed = 0
  for ok in results:
    if not ok:
      failed := failed + 1
  let _v5 = #[0]
  let _v6 = #[failed]
  use test.eq "check 1" _v5 _v6
  let _v7 = #[40]
  let _v8 = #[results.length]
  use test.eq "check 2" _v7 _v8
  return ()

// A small window under heavy latency must stall rather than roll back further.
@[test.suite]
test "rollback depth never exceeds the window and stalls instead":
  let deepest = 0
  let stalls = 0
  let rollbacks = 0
  let all_clean = true
  for window in #[1, 2, 3, 5]:
    for seed in 1 .. 6:
      let r = simulate 2 80 seed window 1 ($Weather {latency: 5, jitter: 4, loss: 20, duplicate: 10, skip: 10}) false
      for peer in 0 .. 2:
        let at = peer * stride ()
        deepest := max self (r[at + 1] - window)
        if r[at + 1] > window or r[at] != 1 or r[at + 5] != 1:
          all_clean := false
        stalls := self + r[at + 3]
        rollbacks := self + r[at + 2]
  use test.holds "check 1" all_clean
  let _v9 = #[0]
  let _v10 = #[deepest]
  use test.eq "check 2" _v9 _v10
  let _v11 = (stalls > 100)
  use test.holds "check 3" _v11
  let _v12 = (rollbacks > 50)
  use test.holds "check 4" _v12
  return ()

@[test.suite]
test "a perturbed step triggers desync detection on every peer":
  let two = simulate 2 60 9 8 2 ($Weather {latency: 2, jitter: 2, loss: 10, duplicate: 10, skip: 10}) true
  let three = simulate 3 60 4 8 2 ($Weather {latency: 3, jitter: 2, loss: 10, duplicate: 10, skip: 10}) true
  // The deviating peer (1) no longer matches the lockstep run; the others do.
  let _v13 = #[1, 0]
  let _v14 = #[two[0], two[6]]
  use test.eq "check 1" _v13 _v14
  let _v15 = #[16, 16]
  let _v16 = #[two[4], two[10]]
  use test.eq "check 2" _v15 _v16
  let _v17 = #[1, 0, 1]
  let _v18 = #[three[0], three[6], three[12]]
  use test.eq "check 3" _v17 _v18
  let _v19 = #[16, 16, 16]
  let _v20 = #[three[4], three[10], three[16]]
  use test.eq "check 4" _v19 _v20
  return ()

// ---- Direct, hand-built scenarios ------------------------------------------------

func config_for (local: U32) -> (window: U32) -> (delay: U32) : rollback.Config =>
  $rollback.Config {players: 2, lanes: 2, window, delay, local, interval: 4, redundancy: 6}

// A session that has simulated `frames` ticks with no remote input at all.
func played (config: rollback.Config) -> (frames: U32) -> (seed: U32) : rollback.Rollback =>
  let width = 2 + config.players * 4
  let s = rollback.make config
  let state = game.initial config.players seed
  let ring: #[U32] = array.fill (rollback.snapshots config * width) 0
  for 0 .. frames:
    let input = game.sample_words seed config.local (rollback.local_frame s - config.delay)
    let (s2, st2, rg2, outcome) = rollback.advance rollback.repeat_last game.game_step (game.save width) (game.load width) (game.checksum width) (&input[0..2]) s state ring
    s := s2
    state := st2
    ring := rg2
  return s

func digest (s: rollback.Rollback) : U32 =>
  let state: U32 = 0x811C9DC5
  for word in #[s.current, s.first_wrong, s.desync, s.checked, s.report_frame, s.report_sum, s.rollbacks, s.resimulated, s.deepest, s.stalls]:
    state := hash.combine self word
  for pool in #[s.inputs, s.frames, s.kinds, s.last, s.next, s.peer_next, s.peer_frame, s.peer_seen, s.peer_advantage, s.scratch, s.mine_frames, s.mine_sums, s.theirs_frames, s.theirs_sums]:
    state := hash.combine self (game.words_checksum pool)
  return state

func seal (words: #[U32]) : #[U32] =>
  let state: U32 = 0x9E3779B9
  for word in words:
    state := hash.combine self word
  return array.concat words #[state]

// An independent packet writer: header words, per-player acks, input lanes, hash.
func forge (config: rollback.Config) -> (sender: U32) -> (current: U32) -> (start: U32) -> (acks: #[U32]) -> (inputs: #[U32]) : #[U32] =>
  let count = inputs.length / config.lanes
  let header = #[0x52424B31, 1, config.players, config.lanes, sender, current, 0x80000000, 0xFFFFFFFF, 0, start, count]
  return seal (array.concat (array.concat header acks) inputs)

// Player 1's input for frame f in the hand-built scenarios.
func given (frame: U32) -> (lane: U32) : U32 => if lane == 0 then (frame * 7 + 1) & 31 else frame * 7 + 2
func given_words (first: U32) -> (count: U32) : #[U32] =>
  array.generate (count * 2) (func i => given (first + i / 2) (i % 2))

func accepted (packet: #[U32]) -> (s: own rollback.Rollback) : (rollback.Rollback, Bool) => rollback.receive (&packet[0..packet.length]) s

@[test.suite]
test "out of order and duplicate packets mark the earliest misprediction":
  let config = config_for 0 8 1
  let s = played config 5 3
  let before = digest s
  let a = forge config 1 5 4 #[1, 1] (given_words 4 2)
  let b = forge config 1 5 2 #[1, 1] (given_words 2 2)
  let c = forge config 1 5 1 #[1, 1] (given_words 1 1)
  let (s1, ok1) = accepted a s
  let wrong1 = s1.first_wrong
  let next1 = s1.next[1]
  let (s2, ok2) = accepted b s1
  let wrong2 = s2.first_wrong
  let next2 = s2.next[1]
  let held = digest s2
  let (s3, ok3) = accepted b s2
  let duplicate_unchanged = digest s3 == held
  let (s4, ok4) = accepted c s3
  let next4 = s4.next[1]
  let low = rollback.frontier s4
  let (s5, ok5) = accepted a s4
  let after_dup = digest s5
  let _v21 = (ok1 and ok2 and ok3 and ok4 and ok5)
  use test.holds "check 1" _v21
  let _v22 = (before != held)
  use test.holds "check 2" _v22
  let _v23 = #[4, 2]
  let _v24 = #[wrong1, wrong2]
  use test.eq "check 3" _v23 _v24
  let _v25 = #[1, 1]
  let _v26 = #[next1, next2]
  use test.eq "check 4" _v25 _v26
  use test.holds "check 5" duplicate_unchanged
  let _v27 = #[6]
  let _v28 = #[next4]
  use test.eq "check 6" _v27 _v28
  let _v29 = #[6]
  let _v30 = #[low]
  use test.eq "check 7" _v29 _v30
  let _v31 = #[1]
  let _v32 = #[s5.first_wrong]
  use test.eq "check 8" _v31 _v32
  let _v33 = (after_dup == digest s5)
  use test.holds "check 9" _v33
  return ()

@[test.suite]
test "rollback resimulates to the lockstep state for the confirmed inputs":
  let config = config_for 0 8 1
  let width = 2 + config.players * 4
  let s = rollback.make config
  let state = game.initial 2 3
  let ring: #[U32] = array.fill (rollback.snapshots config * width) 0
  for 0 .. 5:
    let input = game.sample_words 3 0 (rollback.local_frame s - config.delay)
    let (s2, st2, rg2, outcome) = rollback.advance rollback.repeat_last game.game_step (game.save width) (game.load width) (game.checksum width) (&input[0..2]) s state ring
    s := s2
    state := st2
    ring := rg2
  let speculative = game.words_checksum state
  let (s1, ok) = accepted (forge config 1 5 1 #[1, 1] (given_words 1 5)) s
  let wrong = s1.first_wrong
  let (s2, st2, rg2) = rollback.resolve rollback.repeat_last game.game_step (game.save width) (game.load width) (game.checksum width) s1 state ring
  let reference = game.initial 2 3
  for frame in 0 .. 5:
    let inputs: #[U32] = array.fill 4 0
    if frame >= 1:
      inputs[0] := game.sample 3 0 (frame - 1) 0
      inputs[1] := game.sample 3 0 (frame - 1) 1
      inputs[2] := given frame 0
      inputs[3] := given frame 1
    reference := game.game_step reference inputs
  use test.holds "check 1" ok
  let _v34 = #[1]
  let _v35 = #[wrong]
  use test.eq "check 2" _v34 _v35
  let _v36 = (speculative != game.words_checksum reference)
  use test.holds "check 3" _v36
  use test.eq "check 4" reference st2
  let _v37 = #[4]
  let _v38 = #[s2.deepest]
  use test.eq "check 5" _v37 _v38
  let _v39 = #[1]
  let _v40 = #[s2.rollbacks]
  use test.eq "check 6" _v39 _v40
  let _v41 = (rollback.settled s2)
  use test.holds "check 7" _v41
  let _v42 = #[0xFFFFFFFF]
  let _v43 = #[s2.first_wrong]
  use test.eq "check 8" _v42 _v43
  return ()

func is_advanced (outcome: rollback.Outcome) : Bool => case outcome of
  $rollback.Advanced => true
  _ => false
func is_window (outcome: rollback.Outcome) : Bool => case outcome of
  $rollback.Window => true
  _ => false

@[test.suite]
test "a full window stalls without consuming input until confirmation arrives":
  let config = config_for 0 4 1
  let width = 2 + config.players * 4
  let s = rollback.make config
  let state = game.initial 2 5
  let ring: #[U32] = array.fill (rollback.snapshots config * width) 0
  let advanced = 0
  let stalled = 0
  for 0 .. 9:
    let input = game.sample_words 5 0 (rollback.local_frame s - config.delay)
    let (s2, st2, rg2, outcome) = rollback.advance rollback.repeat_last game.game_step (game.save width) (game.load width) (game.checksum width) (&input[0..2]) s state ring
    s := s2
    state := st2
    ring := rg2
    if is_advanced outcome:
      advanced := self + 1
    if is_window outcome:
      stalled := self + 1
  let frozen = s.current
  let local = rollback.local_frame s
  let (s1, ok) = accepted (forge config 1 4 1 #[1, 1] (given_words 1 4)) s
  s := s1
  let input = game.sample_words 5 0 (rollback.local_frame s - config.delay)
  let (s3, st3, rg3, outcome) = rollback.advance rollback.repeat_last game.game_step (game.save width) (game.load width) (game.checksum width) (&input[0..2]) s state ring
  let _v44 = #[5, 4]
  let _v45 = #[advanced, stalled]
  use test.eq "check 1" _v44 _v45
  let _v46 = #[5]
  let _v47 = #[frozen]
  use test.eq "check 2" _v46 _v47
  let _v48 = #[6]
  let _v49 = #[local]
  use test.eq "check 3" _v48 _v49
  let _v50 = #[4]
  let _v51 = #[s3.stalls]
  use test.eq "check 4" _v50 _v51
  use test.holds "check 5" ok
  let _v52 = (is_advanced outcome)
  use test.holds "check 6" _v52
  let _v53 = #[6]
  let _v54 = #[s3.current]
  use test.eq "check 7" _v53 _v54
  let _v55 = (s3.deepest <= 4)
  use test.holds "check 8" _v55
  return ()

@[test.suite]
test "malformed truncated and corrupted packets change nothing":
  let config = config_for 0 8 1
  let s = played config 4 2
  let held = digest s
  let good = forge config 1 6 1 #[3, 1] (given_words 1 3)
  let rejected_all = true
  for cut in 0 .. good.length:
    let prefix = array.generate cut (func i => good[i])
    let (after, ok) = accepted prefix s
    if ok or digest after != held:
      rejected_all := false
    s := after
  for at in 0 .. good.length:
    let broken = @storage.copy good
    broken[at] := good[at] ^ (1 << (at % 32))
    let (after, ok) = accepted broken s
    if ok or digest after != held:
      rejected_all := false
    s := after
  // Structurally invalid despite a correct hash.
  let valid_acks = #[1, 1]
  let words = given_words 1 3
  let variants = #[
    seal (array.concat (array.concat #[0x52424B31, 1, 2, 2, 0, 6, 0x80000000, 0xFFFFFFFF, 0, 1, 3] valid_acks) words),
    seal (array.concat (array.concat #[0x52424B31, 1, 3, 2, 1, 6, 0x80000000, 0xFFFFFFFF, 0, 1, 3] valid_acks) words),
    seal (array.concat (array.concat #[0x52424B31, 1, 2, 3, 1, 6, 0x80000000, 0xFFFFFFFF, 0, 1, 3] valid_acks) words),
    seal (array.concat (array.concat #[0x52424B31, 2, 2, 2, 1, 6, 0x80000000, 0xFFFFFFFF, 0, 1, 3] valid_acks) words),
    seal (array.concat (array.concat #[0x52424B31, 1, 2, 2, 2, 6, 0x80000000, 0xFFFFFFFF, 0, 1, 3] valid_acks) words),
    seal (array.concat (array.concat #[0x52424B31, 1, 2, 2, 1, 6, 0x80000000, 3, 0, 1, 3] valid_acks) words),
    seal (array.concat (array.concat #[0x52424B31, 1, 2, 2, 1, 6, 0x80000000, 0xFFFFFFFF, 0, 1, 4] valid_acks) words),
    seal (array.concat (array.concat #[0x52424B31, 1, 2, 2, 1, 6, 0x80000000, 0xFFFFFFFF, 0, 1, 2] valid_acks) words),
    seal (array.concat (array.concat #[0x52424B31, 1, 2, 2, 1, 6, 0x80000000, 0xFFFFFFFF, 0, 0xFFFFFFFF, 7] valid_acks) (given_words 1 7)),
    array.concat good #[0]]
  let variants_rejected = 0
  for variant in variants:
    let (after, ok) = accepted variant s
    if not ok and digest after == held:
      variants_rejected := self + 1
    s := after
  let (final, ok) = accepted good s
  use test.holds "check 1" rejected_all
  let _v56 = #[10]
  let _v57 = #[variants_rejected]
  use test.eq "check 2" _v56 _v57
  use test.holds "check 3" ok
  let _v58 = (digest final != held)
  use test.holds "check 4" _v58
  return ()

@[test.suite]
test "inputs beyond the ring are ignored and acks cannot overrun":
  let config = config_for 0 8 1
  let s = played config 3 2
  let far = forge config 1 9 500 #[1, 1] (given_words 500 1)
  let bogus_ack = forge config 1 9 1 #[900, 1] (given_words 1 1)
  let (s1, ok) = accepted far s
  let (s2, ok2) = accepted bogus_ack s1
  use test.holds "check 1" ok
  let _v59 = (Maybe.is_some (rollback.input_at s2 1 500 0) == false)
  use test.holds "check 2" _v59
  let _v60 = #[2]
  let _v61 = #[s2.next[1]]
  use test.eq "check 3" _v60 _v61
  let _v62 = #[s2.next[0]]
  let _v63 = #[s2.peer_next[1]]
  use test.eq "check 4" _v62 _v63
  return ()

func heard (peer_frame: U32) -> (advantage: U32) : rollback.Rollback =>
  let config = config_for 0 16 1
  let s = played config 10 2
  let packet = seal (array.concat (array.concat #[0x52424B31, 1, 2, 2, 1, peer_frame, advantage, 0xFFFFFFFF, 0, 1, 1] #[1, 1]) (given_words 1 1))
  let (heard, ok) = accepted packet s
  return heard

@[test.suite]
test "time sync recommends stalls for the peer that runs ahead":
  let behind = heard 2 0x80000000
  let ahead = heard 20 0x80000000
  let agreed = heard 2 (0x80000000 - 7)
  let silent = played (config_for 0 16 1) 10 2
  let _v64 = 0.0
  let _v65 = #[7.0]
  let _v66 = #[rollback.advantage behind 1 1]
  use test.near_array "check 1" _v64 _v65 _v66
  let _v67 = #[3]
  let _v68 = #[rollback.recommend behind 1]
  use test.eq "check 2" _v67 _v68
  let _v69 = #[0]
  let _v70 = #[rollback.recommend ahead 1]
  use test.eq "check 3" _v69 _v70
  let _v71 = 0.0
  let _v72 = #[0.0 - 11.0]
  let _v73 = #[rollback.advantage ahead 1 1]
  use test.near_array "check 4" _v71 _v72 _v73
  let _v74 = #[7]
  let _v75 = #[rollback.recommend agreed 1]
  use test.eq "check 5" _v74 _v75
  let _v76 = #[0]
  let _v77 = #[rollback.recommend silent 1]
  use test.eq "check 6" _v76 _v77
  return ()

func tagged (player: U32) -> (frame: U32) -> (lane: U32) -> (last: U32) : U32 => if lane == 0 then 0xAAAA else last

@[test.suite]
test "prediction defaults to the last confirmed input and callers may override":
  let config = config_for 0 8 1
  let width = 2 + config.players * 4
  let s = rollback.make config
  let (s1, _) = accepted (forge config 1 1 1 #[1, 1] (given_words 1 1)) s
  let state = game.initial 2 1
  let ring: #[U32] = array.fill (rollback.snapshots config * width) 0
  let input = #[0, 0]
  let (s2, st2, rg2, _) = rollback.advance rollback.repeat_last game.game_step (game.save width) (game.load width) (game.checksum width) (&input[0..2]) s1 state ring
  let copy_state = game.initial 2 1
  let copy_ring: #[U32] = array.fill (rollback.snapshots config * width) 0
  let (t1, ct1, cr1, _) = rollback.advance tagged game.game_step (game.save width) (game.load width) (game.checksum width) (&input[0..2]) (rollback.make config) copy_state copy_ring
  let (s3, _, _, _) = rollback.advance tagged game.game_step (game.save width) (game.load width) (game.checksum width) (&input[0..2]) t1 ct1 cr1
  let zero_a = Maybe.unwrap_or 9 (rollback.input_at s2 1 0 0)
  let zero_b = Maybe.unwrap_or 9 (rollback.input_at s2 1 0 1)
  let (s4, st4, rg4, _) = rollback.advance rollback.repeat_last game.game_step (game.save width) (game.load width) (game.checksum width) (&input[0..2]) s2 st2 rg2
  let _v78 = #[0, 0]
  let _v79 = #[zero_a, zero_b]
  use test.eq "check 1" _v78 _v79
  let _v80 = #[given 1 0, given 1 1]
  let _v81 = #[Maybe.unwrap_or 9 (rollback.input_at s4 1 1 0), Maybe.unwrap_or 9 (rollback.input_at s4 1 1 1)]
  use test.eq "check 2" _v80 _v81
  let _v82 = #[0xAAAA, 0]
  let _v83 = #[Maybe.unwrap_or 9 (rollback.input_at s3 1 1 0), Maybe.unwrap_or 9 (rollback.input_at s3 1 1 1)]
  use test.eq "check 3" _v82 _v83
  return ()

@[test.suite]
test "encoded packets carry redundant inputs from the acknowledgement":
  let config = $rollback.Config {players: 2, lanes: 2, window: 8, delay: 1, local: 0, interval: 4, redundancy: 3}
  let s = played config 6 1
  let peer = $rollback.Config {players: 2, lanes: 2, window: 8, delay: 1, local: 1, interval: 4, redundancy: 3}
  let packet = rollback.encode s 1 0
  let header = rollback.decode_header peer (&packet[0..packet.length])
  let $Some h = header else:
    use test.holds "check 1" false
    return ()
  let local_next = rollback.local_frame s
  let (s2, ok) = accepted (forge peer 1 0 1 #[1, 1] #[]) s
  let _v84 = #[0, 6, 1, 3]
  let _v85 = #[h.sender, h.current, h.start, h.count]
  use test.eq "check 1" _v84 _v85
  let _v86 = #[7]
  let _v87 = #[local_next]
  use test.eq "check 2" _v86 _v87
  let _v88 = #[11 + 2 + 6 + 1]
  let _v89 = #[packet.length]
  use test.eq "check 3" _v88 _v89
  let _v90 = (not (Maybe.is_some (rollback.decode_header config (&packet[0..packet.length]))))
  use test.holds "check 4" _v90
  return ()

// Digests of the Rust lockstep reference (tools/native/src/netcode.rs). The peers
// above are compared with the in-Blot lockstep run, which these pin to Rust.
@[test.suite]
test "the lockstep reference matches the independent rust game":
  let _v91 = #[0x83caa72b]
  let _v92 = #[game.words_checksum (game.lockstep 2 90 2 7)]
  use test.eq "check 1" _v91 _v92
  let _v93 = #[0xcc65bc07]
  let _v94 = #[game.words_checksum (game.lockstep 2 90 0 3)]
  use test.eq "check 2" _v93 _v94
  let _v95 = #[0xf3f4acfd]
  let _v96 = #[game.words_checksum (game.lockstep 3 70 1 4)]
  use test.eq "check 3" _v95 _v96
  let _v97 = #[0x4261b363]
  let _v98 = #[game.words_checksum (game.lockstep 3 70 3 9)]
  use test.eq "check 4" _v97 _v98
  let _v99 = #[0x7ff81315]
  let _v100 = #[game.words_checksum (game.lockstep 2 1 0 1)]
  use test.eq "check 5" _v99 _v100
  return ()
