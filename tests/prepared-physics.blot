import * as test from "std/test"
import * as array from "std/array"
import * as math from "ink/math"
import * as physics from "ink/physics"
import * as prepared from "ink/physics/prepared"
import * as scene from "ink/physics/scene"
import * as codec from "ink/codec"
import * as joints from "ink/physics/joints"
import * as terrain from "ink/terrain"
import * as shapes from "ink/physics/shapes"
import * as owned from "./physics_support"
func fixed (count: U32) =>
  let sources: #[scene.Source] = #[]
  for i in 0 .. count:
    @storage.push sources (scene.box (4294967295 - i) (math.vec3 (U32.to_f32 i * 4.0) (-0.5) 0.0) (math.vec3 2.0 1.0 2.0))
  return sources
func moving () => array.generate 8 (func i => scene.dynamic (scene.sphere (100000 + i) (math.vec3 (U32.to_f32 i * 4.0) 0.4 0.0) 0.5))
func batch (fast: Bool) => func (mode: U32) => func (count: U32) =>
  let fixed = fixed count
  let moving = moving ()
  let moving = if mode == 1 then array.concat moving #[scene.character 200000 (math.vec3 40.0 0.0 0.0)] else moving
  let links = if mode == 2 then #[joints.distance 0 moving.length math.zero3 math.zero3 1.0] else #[]
  let all = if fast then #[] else do:
    let sources: #[scene.Source] = #[]
    for source in moving:
      @storage.push sources source
    for source in fixed:
      @storage.push sources source
    break sources
  let (sum, contacts) = owned.with_prepared {lineage: 0, revision: 0} (if fast then fixed else #[]) (func destination => owned.with_step (if fast then moving else all) #[] (func (own step) =>
    let world = prepared.read destination
    let sum = 0.0
    let contacts = 0
    for tick in 0 .. 16:
      if fast:
        step := prepared.simulate_joints_into world links physics.default_config (1.0 / 60.0) step
      else:
        step := physics.simulate_rebuilt_into links physics.default_config (1.0 / 60.0) step
      let cache = physics.read_cache step.cache
      contacts := self + cache.contacts.length
      for value in step.results:
        sum := self + value.position.y
    return (sum, contacts)))
  return #[sum, U32.to_f32 contacts]
io workload count => batch true 0 count
io reference count => batch false 0 count
io walker_workload count => batch true 1 count
io walker_reference count => batch false 1 count
io joint_workload count => batch true 2 count
io joint_reference count => batch false 2 count

func append_packed (step: physics.StepAccess) -> (values: own #[U32]) : #[U32] =>
  for item in step.results:
    @storage.push values item.source
    for value in #[item.position.x, item.position.y, item.position.z, item.rotation.x, item.rotation.y, item.rotation.z, item.rotation.w]:
      @storage.push values (codec.float_word value)
  for item in step.results:
    if let $Some body = item.rigid:
      @storage.push values (if body.sleeping then 1 else 0)
      for value in #[body.linear_velocity.x, body.linear_velocity.y, body.linear_velocity.z, body.angular_velocity.x, body.angular_velocity.y, body.angular_velocity.z, body.sleep_time]:
        @storage.push values (codec.float_word value)
  for item in step.results:
    if let $Some walker = item.walker:
      @storage.push values walker.ground
      @storage.push values (if walker.grounded then 1 else 0)
      for value in #[walker.velocity.x, walker.velocity.y, walker.velocity.z, walker.ground_normal.x, walker.ground_normal.y, walker.ground_normal.z]:
        @storage.push values (codec.float_word value)
  let cache = physics.read_cache step.cache
  for item in cache.contacts:
    @storage.push values item.a
    @storage.push values item.b
    for value in #[item.point.x, item.point.y, item.point.z, item.normal.x, item.normal.y, item.normal.z, item.normal_impulse, item.tangent_impulse.x, item.tangent_impulse.y, item.tangent_impulse.z]:
      @storage.push values (codec.float_word value)
  return values
func scenario (fast: Bool) => func (mode: U32) =>
  let fixed = fixed 128
  if mode == 4:
    fixed := array.concat self #[scene.ground 4000000000 (terrain.make math.zero3 64.0 1 (&owned_terrain_samples[0..owned_terrain_samples.length]) 0.0 1.0 0 0)]
  if mode >= 40:
    fixed := array.concat self #[scene.source 3900000000 (math.vec3 0.0 3.0 0.0)]
    if mode % 3 == 0:
      fixed[0] := scene.box 4294967295 (math.vec3 0.0 0.0 0.0) (math.vec3 3.0 5.0 3.0)
  let bodies = moving ()
  if mode == 1:
    bodies := array.generate 8 (func i =>
      let source = scene.dynamic (scene.sphere (100000 + i) (math.vec3 (U32.to_f32 i * 4.0) 3.0 0.0) 0.5)
      let body = scene.default_rigid
      body.linear_velocity := math.vec3 0.0 (-200.0) 0.0
      body.continuous := true
      source.rigid := $Some body
      return source)
  if mode == 2:
    bodies := #[scene.character 100000 (math.vec3 0.0 0.0 0.0)]
  if mode >= 5:
    bodies := array.generate 8 (func i =>
      let source = scene.dynamic (scene.sphere (16777217 + i) (math.vec3 (U32.to_f32 ((mode * 13 + i * 17) % 128) * 4.0) (0.4 + U32.to_f32 (mode % 7) * 0.1) 0.0) 0.5)
      let body = scene.default_rigid
      body.linear_velocity := math.vec3 (U32.to_f32 (mode % 5) - 2.0) (-1.0) 0.0
      body.sleeping := mode % 3 == 0 and i % 2 == 0
      body.continuous := mode % 2 == 0
      source.rigid := $Some body
      return source)
  if mode >= 40:
    let platform = scene.box 200000 (math.vec3 0.0 0.0 0.0) (math.vec3 4.0 0.4 4.0)
    let rigid = scene.default_rigid
    rigid.kind := $scene.Kinematic
    rigid.linear_velocity := math.vec3 1.0 0.0 0.0
    rigid.angular_velocity := math.vec3 0.0 0.4 0.0
    platform.rigid := $Some rigid
    let actor = scene.character 300000 (math.vec3 0.0 (if mode % 3 == 0 then 0.0 else 0.2) 0.0)
    let walker = scene.default_walker
    walker.velocity := math.vec3 (U32.to_f32 (mode - 39) * 4.0) (-1.0) 0.0
    walker.grounded := true
    walker.ground := 200000
    walker.step_height := 0.6
    walker.snap_distance := 0.8
    walker.push := 2.0
    actor.walker := $Some walker
    bodies := array.concat #[platform, actor] (moving ())
  let links = if mode == 3 then #[joints.distance 0 8 math.zero3 math.zero3 1.0] else #[]
  if mode >= 40:
    links := #[joints.distance 2 (bodies.length + 128) math.zero3 math.zero3 1.0, joints.distance 3 4294967295 math.zero3 math.zero3 1.0]
  return owned.with_prepared {lineage: 0, revision: 0} fixed (func destination => owned.with_step (if fast then bodies else array.concat bodies fixed) #[] (func (own step) =>
    let world = prepared.read destination
    let output: #[U32] = #[]
    for tick in 0 .. 5:
      if fast:
        step := prepared.simulate_joints_into world links physics.default_config (1.0 / 60.0) step
      else:
        step := physics.simulate_rebuilt_into links physics.default_config (1.0 / 60.0) step
      output := append_packed step self
      step := physics.apply_into step
    return output))
io actual mode => scenario true mode
io expected mode => scenario false mode

io invalid_static () =>
  let dynamic = prepared.admissible (moving ())
  let walker = prepared.admissible #[scene.character 1 math.zero3]
  return #[if dynamic then 1 else 0, if walker then 1 else 0]

io query_composition () =>
  let first_sources = #[scene.sphere 20 math.zero3 1.0]
  return scene.with_built first_sources (func first =>
    let second_sources = #[scene.sphere 10 math.zero3 1.0, scene.sphere 30 (math.vec3 5.0 0.0 0.0) 1.0]
    return scene.with_built second_sources (func second =>
      let combined = scene.together (scene.queries first) (scene.queries second)
      let $Some hit = scene.query_ray combined (math.vec3 (-4.0) 0.0 0.0) (math.vec3 1.0 0.0 0.0) 10.0 65535 0 else:
        return #[]
      let $Some other = scene.query_ray combined (math.vec3 3.0 0.0 0.0) (math.vec3 1.0 0.0 0.0) 10.0 65535 0 else:
        return #[]
      return array.concat #[hit.id, hit.proxy, other.id, other.proxy, if scene.query_point_solid combined math.zero3 65535 then 1 else 0]
        (scene.query_overlap_sphere combined math.zero3 2.0 65535)))

@[test.suite]
test "prepared worlds match full rebuilds":
  let _v1 = #[20,0,30,2,1,20,10]
  let _v2 = (query_composition ())
  use test.eq "check 1" _v1 _v2
  let _v3 = #[0,0]
  let _v4 = (invalid_static ())
  use test.eq "check 2" _v3 _v4
  for mode in 0 .. 56:
    let _v5 = (expected mode)
    let _v6 = (actual mode)
    use test.eq "check 1" _v5 _v6
  for count in #[0,8,256,2048]:
    let _v7 = 0.0
    let _v8 = (reference count)
    let _v9 = (workload count)
    use test.near_array "check 2" _v7 _v8 _v9
    let _v10 = 0.0
    let _v11 = (walker_reference count)
    let _v12 = (walker_workload count)
    use test.near_array "check 3" _v10 _v11 _v12
    let _v13 = 0.0
    let _v14 = (joint_reference count)
    let _v15 = (joint_workload count)
    use test.near_array "check 4" _v13 _v14 _v15
  return ()

const owned_terrain_samples: #[F32] = #[0.0, 0.2, 0.0, 0.2]


@[test.suite]
test "prepared geometry and lineage invalidation":
  let sources = fixed 2
  let first_key: prepared.Key = { lineage: 1, revision: 7 }
  return owned.with_prepared first_key sources (func (own destination) =>
    let changed_key: prepared.Key = { lineage: 1, revision: 8 }
    let restored_key: prepared.Key = { lineage: 2, revision: 7 }
    let (first_valid, changed_invalid, restored_invalid) = do:
      let first = prepared.read destination
      break (prepared.valid first_key first,
        not (prepared.valid changed_key first),
        not (prepared.valid restored_key first))
    let point_count = destination.scene.geometry.points.length
    let plane_count = destination.scene.geometry.planes.length
    destination := prepared.refresh_into changed_key sources destination
    let changed = prepared.read destination
    use test.holds "check 1" first_valid
    use test.holds "check 2" changed_invalid
    use test.holds "check 3" restored_invalid
    let _v16 = (prepared.valid changed_key changed)
    use test.holds "check 4" _v16
    let _v17 = #[point_count, plane_count]
    let _v18 = #[destination.scene.geometry.points.length, destination.scene.geometry.planes.length]
    use test.eq "check 5" _v17 _v18
    return ())
