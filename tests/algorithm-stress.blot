import * as owned from "./physics_support"
import * as arrays from "ink/arrays"
import * as sort from "ink/sort"
import * as spatial from "ink/spatial"
import * as math from "ink/math"
import * as shapes from "ink/shapes"
import * as contact from "ink/contact"
import * as scene from "ink/scene"
import * as physics from "ink/physics"
import * as rigid from "ink/rigid"
import * as joints from "ink/joints"
import * as character from "ink/character"
import * as navigation from "ink/navigation"
import * as placement from "ink/placement"
import * as terrain from "ink/terrain"
import * as tiles from "ink/tiles"
import * as debug from "ink/debug"
import * as array from "std/array"

func vec (a: Array F32) => return func (i: U32) => return math.vec3 a[i] a[i + 1] a[i + 2]
entry func order (keys: Array F32) : Array U32 => return sort.order keys
entry func order_u32 (keys: Array U32) : Array U32 => return sort.order_u32 keys
entry func copied (input: Array F32) : Array F32 => return do:
  let out = arrays.copy input
  for i in 0..out.length:
    out[i] = self + 1.0
  return array.concat input out
entry func copied_u32 (input: Array U32) : Array U32 => return do:
  let out = arrays.copy_u32 input
  for i in 0..out.length:
    out[i] = self ^ 4294967295
  return array.concat input out

func packed (values: Array U32) => return array.concat #[values.length] values
entry func spatial_probe (a: Array F32) : Array U32 => return do:
  let n = F32.to_u32 a[0]
  let changed_count = F32.to_u32 a[1]
  let low = vec a 2
  let high = vec a 5
  let items = @array.generate n (func (i: U32) => return $spatial.Bounds { low: vec a (8 + i * 6), high: vec a (11 + i * 6) })
  let changed = @array.generate changed_count (func (i: U32) => return F32.to_u32 a[8 + n * 6 + i * 7])
  let replacements = @array.generate changed_count (func (i: U32) => return $spatial.Bounds { low: vec a (9 + n * 6 + i * 7), high: vec a (12 + n * 6 + i * 7) })
  let final = @array.generate n (func (i: U32) => return items[i])
  for i in 0..changed.length:
    final[changed[i]] := replacements[i]
  return spatial.with_index items (func original => return
    spatial.with_index items (func current => return do:
      let before = spatial.query original low high
      let updated = spatial.refit current changed replacements
      let result = array.concat (packed before) (packed (spatial.query updated low high))
      return spatial.with_index final (func rebuilt => return do:
        let result = array.concat result (packed (spatial.query rebuilt low high))
        return array.concat result (packed (spatial.query original low high)))))

// Coincident leaves force the index and query output to visit every source.
// The update moves half across the original leaf partition.
entry func scene_dense (ids: Array U32) : Array U32 => return do:
  let sources = @array.generate ids.length (func (i: U32) => return scene.sphere ids[i] math.zero3 1.0)
  let changed = @array.generate ids.length (func (i: U32) => return i)
  let next = @array.generate ids.length (func (i: U32) => return do:
    let s = sources[i]
    if i % 2 == 0:
      s.position := math.vec3 100.0 0.0 0.0
    return s)
  return scene.with_built sources (func before => return
    scene.with_built sources (func current => return do:
      let updated = scene.update next current changed
      let result = packed (scene.overlap_sphere before math.zero3 0.1 65535)
      let result = array.concat result (packed (scene.overlap_capsule updated math.zero3 math.up 0.1 65535))
      return scene.with_built next (func rebuilt => return do:
        let result = array.concat result (packed (scene.overlap_sphere rebuilt math.zero3 0.1 65535))
        return array.concat result (packed (scene.overlap_sphere before math.zero3 0.1 65535)))))

entry func path (a: Array F32) : Array F32 => return do:
  let costs = @array.generate (a.length - 5) (func (i: U32) => return a[i + 5])
  let $Some g = navigation.grid (F32.to_u32 a[0]) (F32.to_u32 a[1]) (&costs[0..costs.length]) else:
    return #[-2.0]
  let path_rows: ResizeArray U32 = #[]
  let $Some p = navigation.astar_into path_rows g (F32.to_u32 a[2]) (F32.to_u32 a[3]) (F32.to_u32 a[4]) else:
    return #[-1.0]
  return array.concat #[p.cost, U32.to_f32 p.expanded] (@array.generate p.cells.length (func (i: U32) => return U32.to_f32 p.cells[i]))
entry func flow (a: Array F32) : Array F32 => return do:
  let costs = @array.generate (a.length - 3) (func (i: U32) => return a[i + 3])
  let $Some g = navigation.grid (F32.to_u32 a[0]) (F32.to_u32 a[1]) (&costs[0..costs.length]) else:
    return #[]
  let costs_out: ResizeArray F32 = #[]
  let next_out: ResizeArray U32 = #[]
  navigation.flow_into costs_out next_out g (F32.to_u32 a[2])
  return array.concat (@array.generate costs_out.length (func (i: U32) => return costs_out.at i)) (@array.generate next_out.length (func (i: U32) => return U32.to_f32 (next_out.at i)))
entry func placed (a: Array F32) : Array F32 => return do:
  let points = placement.chunk (F32.to_u32 a[0] | (F32.to_u32 a[1] << 16)) a[2] a[3] a[4] a[5] (F32.to_u32 a[6]) (F32.to_u32 a[7])
  return @array.generate (points.length * 2) (func (i: U32) => return do:
    let p = points[i / 2].position
    if i % 2 == 0:
      return p.x
    return p.z)

entry func terrain_probe (a: Array F32) : Array F32 => return do:
  let cells = F32.to_u32 a[0]
  let grid = @array.generate (a.length - 3) (func (i: U32) => return a[i + 3])
  let t = terrain.make (math.vec3 3.0 2.0 (-5.0)) 8.0 cells (&grid[0..grid.length]) 0.0 1.0 0 0
  let n = terrain.normal t a[1] a[2]
  let (low, high) = terrain.range t (-100.0) (-100.0) 100.0 100.0
  return #[terrain.height t a[1] a[2], n.x, n.y, n.z, low, high]
entry func tile_walk (ticks: U32) : Array F32 => return do:
  let grid = tiles.grid 64 2 (math.vec2 1.0 1.0) math.zero2 (@array.generate 128 (func (i: U32) => return do:
    if i < 64:
      return 1
    return 0)) #[0, tiles.solid]
  let position = math.vec2 1.0 1.4
  let grounded = 0.0
  for 0..ticks:
    let moved = tiles.slide grid (math.vec2 0.3 0.4) false position (math.vec2 0.25 (-0.1)) (1.0 / 60.0)
    position := moved.pos
    grounded := 0.0
    if moved.grounded:
      grounded := 1.0
  return #[position.x, position.y, grounded]

entry func segment (a: Array F32) : Array F32 => return do:
  let (_, _, p, q) = shapes.segment_segment (vec a 0) (vec a 3) (vec a 6) (vec a 9)
  return #[p.x, p.y, p.z, q.x, q.y, q.z]
entry func spheres (a: Array F32) : Array F32 => return do:
  let first = contact.sphere (vec a 2) a[0]
  let second = contact.sphere (vec a 5) a[1]
  let values = contact.between first second 0.02
  let out = @array.fill (1 + values.length * 7) 0.0
  out[0] := U32.to_f32 values.length
  for i in 0..values.length:
    let c = values[i]
    let o = 1 + i * 7
    out[o] := c.point.x
    out[o + 1] := c.point.y
    out[o + 2] := c.point.z
    out[o + 3] := c.normal.x
    out[o + 4] := c.normal.y
    out[o + 5] := c.normal.z
    out[o + 6] := c.sep
  return out

// One tick per ABI call keeps the native guest's allocation arena bounded.
// Mode 0: contacting free body; mode 1: distance joint at a colliderless anchor.
entry func body_tick (a: Array F32) : Array F32 => return do:
  let source = scene.dynamic (scene.sphere 16777217 (vec a 1) 0.5)
  source.rotation := rigid.quat a 4
  let body = scene.default_rigid
  body.can_sleep := false
  body.linear_velocity := vec a 8
  body.angular_velocity := vec a 11
  source.rigid := $Some body
  let anchor = scene.box 4294967295 (math.vec3 0.0 (-0.5) 0.0) (math.vec3 100.0 1.0 100.0)
  let config = physics.default_config
  let links: Array joints.Joint = #[]
  if a[0] == 1.0:
    anchor := scene.source 4294967295 math.zero3
    links := #[joints.distance 0 1 math.zero3 math.zero3 1.0]
    config.substeps := 8
  let contacts = @array.generate ((a.length - 14) / 10) (func (i: U32) => return do:
    let o = 14 + i * 10
    return $physics.CachedContact { a: 16777217, b: 4294967295, point: vec a o, normal: vec a (o + 3), normal_impulse: a[o + 6], tangent_impulse: vec a (o + 7) })
  return owned.with_step #[anchor, source] contacts (func (own owned_step) => return do:
    owned_step := physics.step_joints_into links config (1.0 / 60.0) owned_step
    let next = owned_step.sources
    let cache = physics.read_cache owned_step.cache
    let s = next[1]
    let $Some b = s.rigid else:
      return #[]
    let state = #[a[0], s.position.x, s.position.y, s.position.z, s.rotation.x, s.rotation.y, s.rotation.z, s.rotation.w, b.linear_velocity.x, b.linear_velocity.y, b.linear_velocity.z, b.angular_velocity.x, b.angular_velocity.y, b.angular_velocity.z]
    let out = @array.fill (cache.contacts.length * 10) 0.0
    for i in 0..cache.contacts.length:
      let c = cache.contacts[i]
      let o = i * 10
      out[o] := c.point.x
      out[o + 1] := c.point.y
      out[o + 2] := c.point.z
      out[o + 3] := c.normal.x
      out[o + 4] := c.normal.y
      out[o + 5] := c.normal.z
      out[o + 6] := c.normal_impulse
      out[o + 7] := c.tangent_impulse.x
      out[o + 8] := c.tangent_impulse.y
      out[o + 9] := c.tangent_impulse.z
    return array.concat state out
  )
entry func walk_tick (a: Array F32) : Array F32 => return do:
  let sources = #[scene.box 4294967295 (math.vec3 0.0 (-0.5) 0.0) (math.vec3 100.0 1.0 100.0), scene.box 16777217 (math.vec3 3.0 2.0 0.0) (math.vec3 1.0 4.0 10.0)]
  return scene.with_built sources (func sc => return do:
    let walker = scene.default_walker
    walker.velocity := math.vec3 2.0 (-0.1) 0.0
    walker.grounded := a[3] > 0.0
    let motion_hits: GrowArray scene.Hit = #[]
    let moved = character.move motion_hits sc ($character.Body { low: math.vec3 0.0 0.4 0.0, high: math.vec3 0.0 1.4 0.0, radius: 0.4 }) (scene.solid_filter 65535) (vec a 0) walker math.zero3 (1.0 / 60.0)
    let grounded = 0.0
    if moved.walker.grounded:
      grounded := 1.0
    return #[moved.position.x, moved.position.y, moved.position.z, grounded])

entry func debug_capsule (segments: U32) : Array F32 => return debug.vertices (debug.collider ($shapes.Capsule { a: math.zero3, b: math.zero3, radius: 0.0 }) segments (math.rgba 0.25 0.5 0.75 1.0))

// Duplicate clipping planes increase triple intersections while retaining one
// authored cube. Its geometric surface must be independent of redundancy.
entry func redundant_hull (copies: U32) : Array F32 => return do:
  let base = #[shapes.plane math.right 1.0, shapes.plane (math.right * (-1.0)) 1.0, shapes.plane math.up 1.0, shapes.plane (math.up * (-1.0)) 1.0, shapes.plane math.forward 1.0, shapes.plane (math.forward * (-1.0)) 1.0]
  let planes = @array.generate (copies * 6) (func (i: U32) => return base[i % 6])
  return shapes.with_geometry (func geometry => return do:
    let $Some poly = shapes.hull_poly geometry (&planes[0..planes.length]) else:
      return #[]
    let (low, high) = shapes.bounds ($shapes.Hull poly)
    let gap = shapes.segment_gap ($shapes.Hull poly) (math.vec3 2.0 0.0 0.0) (math.vec3 2.0 0.0 0.0)
    let contacts = contact.between ($shapes.Hull poly) (contact.sphere (math.vec3 1.4 0.0 0.0) 0.5) 0.02
    return #[U32.to_f32 poly.verts.length, low.x, low.y, low.z, high.x, high.y, high.z, gap.dist, gap.normal.x, U32.to_f32 contacts.length, contacts[0].sep])

entry func terrain_segment (a: Array F32) : Array F32 => return do:
  let cells = F32.to_u32 a[0]
  let heights = @array.fill ((cells + 1) * (cells + 1)) 0.0
  let t = terrain.make math.zero3 16.0 cells (&heights[0..heights.length]) 0.0 1.0 0 0
  let gap = shapes.segment_gap ($shapes.Heightfield t) (math.vec3 (F32.neg a[1]) 2.0 0.0) (math.vec3 a[1] 2.0 0.0)
  return #[gap.dist, gap.normal.x, gap.normal.y, gap.normal.z]
entry func physics_dense (count: U32) : Array U32 => return do:
  let source = scene.dynamic (scene.sphere 16777217 math.zero3 1.0)
  let others = @array.generate count (func (i: U32) => return scene.sphere (4294967295 - i) (math.vec3 1.5 0.0 0.0) 1.0)
  let sources = array.concat #[source] others
  let config = physics.default_config
  config.gravity := math.zero3
  return owned.with_step sources #[] (func (own owned_step) => return do:
    owned_step := physics.step_into config (1.0 / 60.0) owned_step
    let cache = physics.read_cache owned_step.cache
    let ids: GrowArray U32 = #[physics.contact_count cache]
    for c in cache.contacts:
      ids.push c.a
      ids.push c.b
    return @storage.freeze ids
  )
func broad_pairs_with indexed -> (a: Array F32) : Array U32 => return do:
  let count = a.length / 9
  let sources = @array.generate count (func (i: U32) => return do:
    let o = i * 9
    let s = scene.sphere (i + 1) (vec a o) a[o + 3]
    let body = scene.default_rigid
    body.kind := $scene.Static
    if a[o + 4] == 1.0:
      body.kind := $scene.Kinematic
    if a[o + 4] == 2.0:
      body.kind := $scene.Dynamic
    s.rigid := $Some body
    let $Some collider = s.collider else:
      return s
    collider.layer := F32.to_u32 a[o + 6]
    collider.mask := F32.to_u32 a[o + 7]
    collider.trigger := a[o + 8] > 0.0
    s.collider := $Some collider
    return s)
  return scene.with_built sources (func sc => return do:
    let movers = physics.mover_ids (scene.proxies sc)
    let pairs = if indexed then physics.broad_phase_indexed sc.index (scene.proxies sc) movers (@array.fill movers.length 0.04) (@array.generate count (func (i: U32) => return a[i * 9 + 5]))
      else physics.broad_phase (scene.proxies sc) movers (@array.fill movers.length 0.04) (@array.generate count (func (i: U32) => return a[i * 9 + 5]))
    return physics.canonical_pairs (scene.proxies sc) (@array.generate count (func (i: U32) => return i)) pairs)

entry const broad_pairs = broad_pairs_with false
entry const broad_pairs_indexed = broad_pairs_with true
entry func dense_bodies (count: U32) : Array F32 => return do:
  let sources = @array.generate count (func (i: U32) => return scene.dynamic (scene.sphere (i + 1) (math.vec3 (U32.to_f32 (i % 8) * 0.05) 10.0 (U32.to_f32 (i / 8) * 0.05)) 0.5))
  return owned.with_step sources #[] (func (own owned_step) => return do:
    owned_step := physics.step_into physics.default_config (1.0 / 60.0) owned_step
    let next = owned_step.sources
    let cache = physics.read_cache owned_step.cache
    let state = @array.generate (count * 13) (func (i: U32) => return do:
      let s = next[i / 13]
      let $Some b = s.rigid else:
        return 0.0
      let lanes = #[s.position.x,s.position.y,s.position.z,s.rotation.x,s.rotation.y,s.rotation.z,s.rotation.w,b.linear_velocity.x,b.linear_velocity.y,b.linear_velocity.z,b.angular_velocity.x,b.angular_velocity.y,b.angular_velocity.z]
      return lanes[i % 13])
    let pairs = @array.generate (cache.contacts.length * 2) (func (i: U32) => return do:
      let c = cache.contacts[i / 2]
      if i % 2 == 0:
        return U32.to_f32 c.a
      return U32.to_f32 c.b)
    return array.concat #[U32.to_f32 count, U32.to_f32 cache.contacts.length] (array.concat state pairs)
  )
entry func spatial_dense_refit (count: U32) : Array U32 => return do:
  let items = @array.fill count ($spatial.Bounds { low: math.zero3, high: math.one3 })
  let changed = @array.generate count (func (i: U32) => return i)
  let replacements = @array.generate count (func (i: U32) => return do:
    let low = math.zero3
    if i % 2 == 0:
      low := math.vec3 100.0 0.0 0.0
    return $spatial.Bounds { low, high: low + math.one3 })
  return spatial.with_index items (func old => return
    spatial.with_index items (func current => return do:
      let before = spatial.query old math.zero3 math.one3
      let updated = spatial.refit current changed replacements
      let result = array.concat (packed before) (packed (spatial.query updated math.zero3 math.one3))
      return spatial.with_index replacements (func rebuilt => return do:
        let result = array.concat result (packed (spatial.query rebuilt math.zero3 math.one3))
        return array.concat result (packed (spatial.query old math.zero3 math.one3)))))
