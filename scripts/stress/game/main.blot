import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as s from "./schema.gen"
import * as math from "ink/math"

// Gravity, a bounce on the floor, reflection at the walls and a spin.
const move = fn (input: s.Input) => fn (entity: s.Entity) => do:
  let #Some body = entity.body else:
    return entity
  let #Some transform = entity.transform else:
    return entity
  let dt = input.dt
  let p = transform.position
  let v = body.velocity
  let vy = v.y - 9.8 * dt
  let y = p.y + vy * dt
  let bounced = y < 0.0
  let vx = if F32.abs p.x > 50.0 then 0.0 - v.x else v.x
  let vz = if F32.abs p.z > 50.0 then 0.0 - v.z else v.z
  body.velocity := #Vec3 { x: vx, y: if bounced then F32.abs vy * body.bounce else vy, z: vz }
  transform.position := #Vec3 { x: p.x + vx * dt, y: if bounced then 0.0 else y, z: p.z + vz * dt }
  transform.rotation := self * math.axis_angle math.up (body.spin * dt)
  entity.transform := #Some transform
  entity.body := #Some body
  return entity

const update = fn (input: s.Input) => fn (world: s.World) => do:
  world.entities := array.map (move input) self
  return world

entry const step = fn (lanes: Array F32) -> Array F32 => s.run update lanes
