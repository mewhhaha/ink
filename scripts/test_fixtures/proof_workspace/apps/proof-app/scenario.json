{
  "version": 2,
  "role": "editor_game",
  "editor": "@ink/proof-editor",
  "commands": {
    "headless": "proof-headless",
    "browser": "proof-browser"
  },
  "edit": "change the proof fixture",
  "expected_outcome": "the proof fixture changes",
  "proofs": [
    {
      "package": "@ink/proof-core",
      "exports": [
        "./reachable.ts"
      ],
      "assertions": [
        "headless:behavior",
        "browser:behavior"
      ]
    },
    {
      "package": "@ink/proof-core",
      "exports": [
        "./behavior.ts"
      ],
      "assertions": [
        "headless:behavior",
        "browser:behavior"
      ]
    },
    {
      "package": "@ink/proof-core",
      "exports": [
        "./headless.ts",
        "./guest.blot"
      ],
      "assertions": [
        "headless:behavior",
        "browser:behavior"
      ]
    }
  ]
}
