{
  "name": "@ink/isometric-city-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:game": "deno run --config ../../deno.json --allow-read --allow-write --allow-run=deno build.ts",
    "check": "deno check --config ../../deno.json build.ts development.ts vite.config.ts src/*.ts src/*.tsx headless/*.ts",
    "dev": "vite",
    "headless": "pnpm build:game && deno run --config ../../deno.json --allow-read headless/main.ts",
    "test": "pnpm build:game && deno test --config ../../deno.json --allow-read headless/*_test.ts"
  },
  "dependencies": {
    "@ink/blot": "workspace:*",
    "@ink/development": "workspace:*",
    "@ink/engine": "workspace:*",
    "@mewhhaha/typeclasses": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
