open {} = (@import "../prelude.blot") ();
open {} = (@import "../../../../packages/blot/scene.blot") ();

const tile_x = fn index => (@int.rem index 3 - index / 3) * 1620000;
const tile_y = fn index => (@int.rem index 3 + index / 3) * 810000 - 1620000;
const tile_z = fn index => (@int.rem index 3 + index / 3) * 18000;

const add_ground_tile = fn (Object, index) => do
  <Object
    .id={index}
    .mesh=0
    .material={material (color (620000, 660000, 240000), 0)}
    .parent={root}
    .transform={transform (
      vec3 (tile_x index, tile_y index, tile_z index),
      vec3 (0, 0, 0),
      vec3 (1800000, 1800000, 1800000)
    )}
    .visible=True
  />;
  in ()
end;

return { .add_ground_tile = add_ground_tile; };
