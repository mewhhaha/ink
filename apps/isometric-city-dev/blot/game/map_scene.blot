module scene;

open {} = (@import "../prelude.blot") ();

let IsometricTilemap = scene.IsometricTilemap;

const columns = 32;
const rows = 32;
const tile_count = columns * rows;
const district_columns = 4;
const district_rows = 4;
const district_count = district_columns * district_rows;
const district_tile_size = 8;
const terrain_seed = @include "./map.tiles" (fn source => source.text);

const district_column_of = fn index => @int.rem index district_columns;
const district_row_of = fn index => index / district_columns;
const district_tile = fn index =>
  (district_row_of index * district_tile_size + 3) * columns
  + district_column_of index * district_tile_size + 3;

const tile_column = fn index => @int.rem index columns;
const tile_row = fn index => index / columns;
const valid_column = fn column =>
  if column > -1 then column < columns else False end;
const valid_row = fn row =>
  if row > -1 then row < rows else False end;
const tile_at = fn (column, row) =>
  if valid_column column
  then if valid_row row then row * columns + column else -1 end
    else -1
  end;
const absolute = fn value => if value < 0 then -value else value end;
const greater = fn (left, right) => if left > right then left else right end;
const tile_distance = fn (left, right) => do
  let column_distance = absolute (tile_column left - tile_column right);
  let row_distance = absolute (tile_row left - tile_row right);
  in greater (column_distance, row_distance)
end;
const tile_world_x = fn tile =>
  (tile_column tile - tile_row tile) * 720000;
const tile_world_y = fn tile =>
  -11160000 + (tile_column tile + tile_row tile) * 360000;

let render_map = fn terrain => do
  _ <- <IsometricTilemap
    .blend={terrain.blend}
    .columns={columns}
    .detail={terrain.detail}
    .detail_scale=1000000
    .first_object_id=0
    .ground_mesh=0
    .origin_y={-11160000}
    .path={terrain.path}
    .road_texture=2
    .rows={rows}
    .secondary_texture=1
    .terrain={terrain.terrain}
    .tile_half_height=360000
    .tile_half_width=720000
    .tile_scale=800000
    .texture_scale_x=350000
    .texture_scale_y=350000
    .variation_seed=137
  />;
end;

return {
  .columns = columns;
  .rows = rows;
  .tile_count = tile_count;
  .district_count = district_count;
  .district_column_of = district_column_of;
  .district_row_of = district_row_of;
  .district_tile = district_tile;
  .terrain_seed = terrain_seed;
  .tile_at = tile_at;
  .tile_column = tile_column;
  .tile_distance = tile_distance;
  .tile_world_x = tile_world_x;
  .tile_world_y = tile_world_y;
  .render_map = render_map;
  .tile_row = tile_row;
};
