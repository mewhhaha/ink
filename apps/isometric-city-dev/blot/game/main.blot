open {} = (@import "../prelude.blot") ();
const append_text = Text.append;

open {} = (@import "../../../../packages/blot/engine.blot") ();
open {} = (@import "../../../../packages/blot/html_canvas.blot") ();
const Scene = (@import "../../../../packages/blot/scene.blot") ();
open {} = Scene;
const Ecs = (@import "../../../../packages/blot/ecs.blot") ();

const MapScene = (@import "./map_scene.blot") Scene;

const unit_capacity = 2;
const path_tool = 1;
const plot_tool = 2;
const well_tool = 4;
const marshal_post_tool = 6;
const tent_residence = 3;
const house_residence = 5;
const simulation_tick_us = 500000;
const movement_scale = 1000000;
const off_path_cost = 350;
const distance_cost = 100;
const unreachable_cost = 1000000;
const ignition_risk = 8;
const select_tool_event = 10;
const paint_tile_event = 11;

const Terrain = Ecs.component {
  .texture = Int;
  .blend_edges = Int;
  .path_connections = Int;
  .detail_texture = Int;
};
const Construction = Ecs.component { .kind = Int; };
const Residence = Ecs.component {
  .level = Int;
  .fire_risk = Int;
  .burning = Bool;
};
const UnitMovement = Ecs.component {
  .tile = Int;
  .destination = Int;
  .next_tile = Int;
  .previous_tile = Int;
  .progress = Int;
};
const UnitActivity = Ecs.component { .active = Bool; };
const EditorState = Ecs.resource { .selected_tool = path_tool; };
const SimulationClock = Ecs.resource { .accumulated_us = 0; };
const SimulationCursors = Ecs.resource { .construction = 0; .residence = 0; };
const CityStats = Ecs.resource { .population = 0; .burning_count = 0; };
const CityInfrastructure = Ecs.resource { .marshal_post = -1; };

const Game = Ecs.system ("game", {
  .Terrain = Ecs.read Terrain;
  .Construction = Construction;
  .Residence = Residence;
  .UnitMovement = UnitMovement;
  .UnitActivity = UnitActivity;
  .EditorState = EditorState;
  .SimulationClock = SimulationClock;
  .SimulationCursors = SimulationCursors;
  .CityStats = CityStats;
  .CityInfrastructure = CityInfrastructure;
});

const Initialization = Ecs.system ("initialization", {
  .Terrain = Terrain;
  .Construction = Construction;
  .UnitMovement = UnitMovement;
  .UnitActivity = UnitActivity;
});

const Description = Ecs.system ("description", {
  .EditorState = Ecs.read EditorState;
  .CityStats = Ecs.read CityStats;
});

const Rendering = Ecs.system ("rendering", {
  .Terrain = Ecs.read Terrain;
  .Construction = Ecs.read Construction;
  .Residence = Ecs.read Residence;
  .UnitMovement = Ecs.read UnitMovement;
  .UnitActivity = Ecs.read UnitActivity;
});

const City = Ecs.world (Ecs.entities.fixed (
  MapScene.tile_count + unit_capacity
))
  |> Ecs.add_system Game
  |> Ecs.add_system Initialization
  |> Ecs.add_system Description
  |> Ecs.add_system Rendering
  |> Ecs.build;
open {} = City.game;
const Setup = City.initialization;
const DescriptionView = City.description;
const RenderView = City.rendering;

const immigrant_entity = MapScene.tile_count;
const marshal_entity = immigrant_entity + 1;
const entrance_tile = MapScene.tile_at (0, MapScene.rows / 2);

const remove_residence = fn tile => do
  present <- Residence.has tile;
  if present then do
    burning <- Residence.burning.get_or (tile, False);
    population <- CityStats.population.get ();
    burning_count <- CityStats.burning_count.get ();
    if population > 0 then do
      population := population - 1;
    end;
    if burning && burning_count > 0 then do
      burning_count := burning_count - 1;
    end;
    _ <- CityStats.population.set population;
    _ <- CityStats.burning_count.set burning_count;
    _ <- Residence.remove tile;
  end;
end;

const remove_construction_effects = fn tile => do
  marshal_post <- CityInfrastructure.marshal_post.get ();
  if marshal_post == tile then do
    _ <- UnitActivity.active.set (marshal_entity, False);
    _ <- CityInfrastructure.marshal_post.set (-1);
  end;
end;

const prepare_construction = fn tile => do
  _ <- remove_residence tile;
  _ <- remove_construction_effects tile;
end;

const place_path = fn tile => do
  _ <- prepare_construction tile;
  _ <- Construction.insert (tile, { .kind = path_tool; });
end;

const place_plot = fn tile => do
  _ <- prepare_construction tile;
  _ <- Construction.insert (tile, { .kind = plot_tool; });
end;

const place_well = fn tile => do
  _ <- prepare_construction tile;
  _ <- Construction.insert (tile, { .kind = well_tool; });
end;

const place_marshal_post = fn tile => do
  previous_post <- CityInfrastructure.marshal_post.get ();
  if previous_post > -1 then do
    _ <- Construction.remove previous_post;
  end;
  _ <- prepare_construction tile;
  _ <- Construction.insert (tile, { .kind = marshal_post_tool; });
  _ <- UnitMovement.insert (marshal_entity, {
    .tile = tile;
    .destination = tile;
    .next_tile = tile;
    .previous_tile = tile;
    .progress = 0;
  });
  _ <- UnitActivity.insert (marshal_entity, { .active = True; });
  _ <- CityInfrastructure.marshal_post.set tile;
end;

const route_score = fn (candidate, destination) => do
  construction <- Construction.kind.get_or (candidate, 0);
  let surface_cost = if construction == path_tool then 0 else off_path_cost end;
  in if candidate == destination
    then 0
    else MapScene.tile_distance (candidate, destination) * distance_cost
      + surface_cost
  end
end;

const different = fn (left, right) =>
  if left == right then False else True end;

const valid_route_tile = fn (candidate, current) =>
  if candidate < 0 then False else different (candidate, current) end;

const avoids_previous_tile = fn (candidate, previous, destination) =>
  if candidate == destination
    then True
    else different (candidate, previous)
  end;

const route_allowed = fn (candidate, current, previous, destination) =>
  if valid_route_tile (candidate, current)
    then avoids_previous_tile (candidate, previous, destination)
    else False
  end;

const consider_route = fn (
  current,
  destination,
  previous,
  best_tile,
  column_offset,
  row_offset
) => do
  let candidate = MapScene.tile_at (
    MapScene.tile_column current + column_offset,
    MapScene.tile_row current + row_offset
  );
  let allowed = route_allowed (candidate, current, previous, destination);
  choice <- if allowed then do
    candidate_score <- route_score (candidate, destination);
    best_score <- if best_tile == current
      then unreachable_cost
      else route_score (best_tile, destination)
    end;
    in if candidate_score < best_score then candidate else best_tile end
  end else best_tile end;
  in choice
end;

const choose_route = fn (current, destination, previous) => do
  let consider = fn (best_tile, column_offset, row_offset) => do
    selected <- consider_route (
      current,
      destination,
      previous,
      best_tile,
      column_offset,
      row_offset
    );
    in selected
  end;
  let best_tile = current;
  best_tile <- consider (best_tile, 1, 0);
  best_tile <- consider (best_tile, -1, 0);
  best_tile <- consider (best_tile, 0, 1);
  best_tile <- consider (best_tile, 0, -1);
  best_tile <- consider (best_tile, 1, 1);
  best_tile <- consider (best_tile, 1, -1);
  best_tile <- consider (best_tile, -1, 1);
  best_tile <- consider (best_tile, -1, -1);
  in best_tile
end;

const assign_immigrant_plot = fn tile => do
  construction <- Construction.kind.get_or (tile, 0);
  active <- UnitActivity.active.get_or (immigrant_entity, False);
  residence <- Residence.has tile;
  if construction == plot_tool && not active && not residence then do
    _ <- UnitMovement.tile.set (immigrant_entity, entrance_tile);
    _ <- UnitMovement.destination.set (immigrant_entity, tile);
    _ <- UnitMovement.next_tile.set (immigrant_entity, entrance_tile);
    _ <- UnitMovement.previous_tile.set (immigrant_entity, entrance_tile);
    _ <- UnitMovement.progress.set (immigrant_entity, 0);
    _ <- UnitActivity.active.set (immigrant_entity, True);
  end;
end;

const seek_immigrant_plot = fn () => do
  const candidates = Construction.query ();
  active <- UnitActivity.active.get_or (immigrant_entity, False);
  if not active then do
    span <- candidates.candidate_span ();
    cursor <- SimulationCursors.construction.get ();
    if span > 0 then do
      let position = @int.rem cursor span;
      _ <- candidates.visit_at (position, assign_immigrant_plot);
      _ <- SimulationCursors.construction.set (position + 1);
    end;
  end;
end;

const settle_immigrant = fn destination => do
  construction <- Construction.kind.get_or (destination, 0);
  if construction == plot_tool then do
    _ <- Construction.insert (destination, { .kind = tent_residence; });
    _ <- Residence.insert (destination, {
      .level = tent_residence;
      .fire_risk = 0;
      .burning = False;
    });
    population <- CityStats.population.get ();
    _ <- CityStats.population.set (population + 1);
  end;
  _ <- UnitActivity.active.set (immigrant_entity, False);
end;

const ensure_unit_route = fn (entity, tile, destination) => do
  next_tile <- UnitMovement.next_tile.get_or (entity, tile);
  previous_tile <- UnitMovement.previous_tile.get_or (entity, tile);
  route <- if next_tile == tile
    then choose_route (tile, destination, previous_tile)
    else next_tile
  end;
  _ <- UnitMovement.next_tile.set (entity, route);
  in route
end;

const complete_unit_step = fn (entity, tile, next_tile, progress) => do
  _ <- UnitMovement.previous_tile.set (entity, tile);
  _ <- UnitMovement.tile.set (entity, next_tile);
  _ <- UnitMovement.next_tile.set (entity, next_tile);
  _ <- UnitMovement.progress.set (entity, progress - movement_scale);
end;

const apply_unit_progress = fn (entity, tile, next_tile, progress) => do
  if progress > movement_scale - 1 then do
    _ <- complete_unit_step (entity, tile, next_tile, progress);
  else do
    _ <- UnitMovement.progress.set (entity, progress);
  end;
end;

const move_travelling_unit = fn (entity, tile, destination, delta_us) => do
  next_tile <- ensure_unit_route (entity, tile, destination);
  progress <- UnitMovement.progress.get_or (entity, 0);
  _ <- apply_unit_progress (entity, tile, next_tile, progress + delta_us);
end;

const advance_unit_motion = fn (entity, delta_us) => do
  tile <- UnitMovement.tile.get_or (entity, entrance_tile);
  destination <- UnitMovement.destination.get_or (entity, tile);
  if different (tile, destination) then do
    _ <- move_travelling_unit (entity, tile, destination, delta_us);
  end;
end;

const update_immigrant = fn delta_us => do
  active <- UnitActivity.active.get_or (immigrant_entity, False);
  if active then do
    _ <- advance_unit_motion (immigrant_entity, delta_us);
    tile <- UnitMovement.tile.get_or (immigrant_entity, entrance_tile);
    destination <- UnitMovement.destination.get_or (
      immigrant_entity,
      entrance_tile
    );
    if tile == destination then do
      _ <- settle_immigrant destination;
    end;
  end;
end;

const has_water = fn tile => do
  let column = MapScene.tile_column tile;
  let row = MapScene.tile_row tile;
  let inspect = fn (found, column_offset, row_offset) => do
    next <- if found then True else do
      let candidate = MapScene.tile_at (
        column + column_offset,
        row + row_offset
      );
      kind <- if candidate > -1
        then Construction.kind.get_or (candidate, 0)
        else 0
      end;
      in kind == well_tool
    end end;
    in next
  end;
  let found = False;
  found <- inspect (found, -1, -1);
  found <- inspect (found, 0, -1);
  found <- inspect (found, 1, -1);
  found <- inspect (found, -1, 0);
  found <- inspect (found, 0, 0);
  found <- inspect (found, 1, 0);
  found <- inspect (found, -1, 1);
  found <- inspect (found, 0, 1);
  found <- inspect (found, 1, 1);
  in found
end;

const upgrade_residence = fn tile => do
  level <- Residence.level.get_or (tile, tent_residence);
  water <- has_water tile;
  if level == tent_residence && water then do
    _ <- Residence.level.set (tile, house_residence);
    _ <- Construction.kind.set (tile, house_residence);
  end;
end;

const increase_fire_risk = fn tile => do
  risk <- Residence.fire_risk.get_or (tile, 0);
  _ <- Residence.fire_risk.set (tile, risk + 1);
  if risk == ignition_risk - 1 then do
    _ <- Residence.burning.set (tile, True);
    burning_count <- CityStats.burning_count.get ();
    _ <- CityStats.burning_count.set (burning_count + 1);
  end;
end;

const update_residence = fn tile => do
  _ <- upgrade_residence tile;
  _ <- increase_fire_risk tile;
end;

const update_one_residence = fn () => do
  const candidates = Residence.query ();
  span <- candidates.candidate_span ();
  cursor <- SimulationCursors.residence.get ();
  if span > 0 then do
    let position = @int.rem cursor span;
    _ <- candidates.visit_at (position, update_residence);
    _ <- SimulationCursors.residence.set (position + 1);
  end;
end;

const assign_marshal_destination = fn tile => do
  _ <- UnitMovement.destination.set (marshal_entity, tile);
end;

const service_residence = fn tile => do
  present <- Residence.has tile;
  if present then do
    risk <- Residence.fire_risk.get_or (tile, 0);
    burning <- Residence.burning.get_or (tile, False);
    _ <- Residence.fire_risk.set (tile, if risk > 3 then risk - 4 else 0 end);
    _ <- Residence.burning.set (tile, False);
    if burning then do
      burning_count <- CityStats.burning_count.get ();
      _ <- CityStats.burning_count.set (if burning_count > 0
        then burning_count - 1
        else 0
      end);
    end;
  end;
end;

const choose_marshal_destination = fn () => do
  const candidates = Residence.query ();
  span <- candidates.candidate_span ();
  cursor <- SimulationCursors.residence.get ();
  if span > 0 then do
    let position = @int.rem cursor span;
    _ <- candidates.visit_at (position, assign_marshal_destination);
  end;
end;

const service_if_arrived = fn (tile, destination) => do
  if tile == destination then do
    _ <- service_residence tile;
    _ <- choose_marshal_destination ();
  end;
end;

const update_marshal = fn () => do
  active <- UnitActivity.active.get_or (marshal_entity, False);
  if active then do
    tile <- UnitMovement.tile.get_or (marshal_entity, entrance_tile);
    destination <- UnitMovement.destination.get_or (marshal_entity, tile);
    _ <- service_if_arrived (tile, destination);
  end;
end;

const simulate = fn () => do
  _ <- seek_immigrant_plot ();
  _ <- update_one_residence ();
  _ <- update_marshal ();
end;

const advance_simulation = fn delta_us => do
  accumulated <- SimulationClock.accumulated_us.get ();
  let next = accumulated + delta_us;
  if next > simulation_tick_us - 1 then do
    _ <- SimulationClock.accumulated_us.set (next - simulation_tick_us);
    _ <- simulate ();
  else do
    _ <- SimulationClock.accumulated_us.set next;
  end;
end;

const advance_marshal_motion = fn delta_us => do
  active <- UnitActivity.active.get_or (marshal_entity, False);
  if active then do
    _ <- advance_unit_motion (marshal_entity, delta_us);
  end;
end;

const select_tool = fn target => do
  if target == path_tool || target == plot_tool || target == well_tool
    || target == marshal_post_tool then do
    _ <- EditorState.selected_tool.set target;
  end;
end;

const paint_tile = fn target => do
  const paintable_tiles = Terrain.query ();
  selected_tool <- EditorState.selected_tool.get ();
  if selected_tool == path_tool then do
    _ <- paintable_tiles.visit (target, place_path);
  end;
  if selected_tool == plot_tool then do
    _ <- paintable_tiles.visit (target, place_plot);
  end;
  if selected_tool == well_tool then do
    _ <- paintable_tiles.visit (target, place_well);
  end;
  if selected_tool == marshal_post_tool then do
    _ <- paintable_tiles.visit (target, place_marshal_post);
  end;
end;

let update = fn () => do
  event <- Events.next ();
  delta_us <- Time.delta_us ();
  if event.kind == select_tool_event then do
    _ <- select_tool event.target;
  end;
  if event.kind == paint_tile_event then do
    _ <- paint_tile event.target;
  end;
  _ <- advance_simulation delta_us;
  _ <- update_immigrant delta_us;
  _ <- advance_marshal_motion delta_us;
end;

const district_label = fn index => do
  let row = MapScene.district_row_of index + 1;
  let column = MapScene.district_column_of index + 1;
  in append_text
    (append_text
      (append_text "District " (@text.of_int row))
      ","
    )
    (@text.of_int column)
end;

let describe_district = fn (Text, index) => do
  let label = district_label index;
  _ <- <Text
    .attachment={attachment (
      MapScene.district_tile index,
      vec3 (0, 0, 180000),
      element_size (11520000, 5760000)
    )}
    .description={append_text
      (append_text "Accessible eight by eight terrain " label)
      ". Use camera zoom to inspect its tiles."
    }
    .element_size={element_size (128, 64)}
    .id={append_text "city-district-" (@text.of_int index)}
    .label={label}
    .order={index + 1}
    .style={style ("transparent", "transparent", 0, 0, "transparent", 1, 400)}
  />;
end;

let describe_district_row = fn (Text, first) => do
  _ <- describe_district (Text, first);
  _ <- describe_district (Text, first + 1);
  _ <- describe_district (Text, first + 2);
  _ <- describe_district (Text, first + 3);
end;

let describe = fn Text => do
  tool <- DescriptionView.EditorState.selected_tool.get ();
  population <- DescriptionView.CityStats.population.get ();
  burning <- DescriptionView.CityStats.burning_count.get ();
  _ <- <Text
    .attachment={attachment (
      495,
      vec3 (0, 0, 10000),
      element_size (57600000, 28800000)
    )}
    .description="An accessible thirty-two by thirty-two isometric terrain map"
    .element_size={element_size (1, 1)}
    .id="city-ground"
    .label="Isometric terrain"
    .order=0
    .style={style ("transparent", "transparent", 0, 0, "transparent", 1, 400)}
  />;
  _ <- describe_district_row (Text, 0);
  _ <- describe_district_row (Text, 4);
  _ <- describe_district_row (Text, 8);
  _ <- describe_district_row (Text, 12);
  _ <- <Text
    .attachment={attachment (
      entrance_tile,
      vec3 (0, 0, 180000),
      element_size (1440000, 720000)
    )}
    .description="Immigrants enter the city from this western map opening"
    .element_size={element_size (96, 48)}
    .id="city-immigration-entrance"
    .label="Immigration entrance"
    .order=17
    .style={style ("transparent", "transparent", 0, 0, "transparent", 1, 400)}
  />;
  _ <- <Action
    .id="city-tool-path"
    .kind={select_tool_event}
    .label="Path"
    .target={path_tool}
    .value={if tool == path_tool then 1 else 0 end}
  />;
  _ <- <Action
    .id="city-tool-plot"
    .kind={select_tool_event}
    .label="Housing plot"
    .target={plot_tool}
    .value={if tool == plot_tool then 1 else 0 end}
  />;
  _ <- <Action
    .id="city-tool-well"
    .kind={select_tool_event}
    .label="Well"
    .target={well_tool}
    .value={if tool == well_tool then 1 else 0 end}
  />;
  _ <- <Action
    .id="city-tool-marshal"
    .kind={select_tool_event}
    .label="Fire marshal post"
    .target={marshal_post_tool}
    .value={if tool == marshal_post_tool then 1 else 0 end}
  />;
  _ <- <Action
    .id="city-paint-tile"
    .kind={paint_tile_event}
    .label="Place the selected building on a map tile"
    .target=0
    .value=0
  />;
  _ <- <Status
    .done=False
    .label="Map"
    .value={append_text
      (append_text
        (append_text "Population " (@text.of_int population))
        "; active fires "
      )
      (@text.of_int burning)
    }
  />;
end;

const render_ground_layer = fn (
  first_object_id,
  match_value,
  component,
  field,
  connection_mode,
  color_red,
  color_green,
  color_blue,
  scale,
  z
) => do
  _ <- Render.isometric_component_layer {
  .blend_edges = 0;
  .color_blue = color_blue;
  .color_green = color_green;
  .color_red = color_red;
  .columns = MapScene.columns;
  .component = component;
  .connection_mode = connection_mode;
  .emissive = 0;
  .field = field;
  .first_object_id = first_object_id;
  .match_value = match_value;
  .mesh = 1;
  .origin_y = -11160000;
  .rows = MapScene.rows;
  .scale_x = scale;
  .scale_y = scale;
  .scale_z = 800000;
  .secondary_texture = no_texture;
  .surface_mode = connected_path;
  .texture = 2;
  .texture_scale_x = 700000;
  .texture_scale_y = 700000;
  .tile_half_height = 360000;
  .tile_half_width = 720000;
  .variation_seed = 0;
    .z = z;
  };
end;

const render_decal_layer = fn (
  first_object_id,
  match_value,
  component,
  field,
  texture,
  color_red,
  color_green,
  color_blue,
  scale_x,
  scale_y,
  scale_z,
  z,
  emissive
) => do
  _ <- Render.isometric_component_layer {
  .blend_edges = 0;
  .color_blue = color_blue;
  .color_green = color_green;
  .color_red = color_red;
  .columns = MapScene.columns;
  .component = component;
  .connection_mode = no_connections;
  .emissive = emissive;
  .field = field;
  .first_object_id = first_object_id;
  .match_value = match_value;
  .mesh = 2;
  .origin_y = -11160000;
  .rows = MapScene.rows;
  .scale_x = scale_x;
  .scale_y = scale_y;
  .scale_z = scale_z;
  .secondary_texture = no_texture;
  .surface_mode = upright_decal;
  .texture = texture;
  .texture_scale_x = 1000000;
  .texture_scale_y = 1000000;
  .tile_half_height = 360000;
  .tile_half_width = 720000;
  .variation_seed = 0;
    .z = z;
  };
end;

const interpolate = fn (start, finish, amount) =>
  start + (finish - start) * amount / movement_scale;

const render_unit = fn (
  entity,
  object_id,
  color_red,
  color_green,
  color_blue,
  scale_x,
  scale_y
) => do
  tile <- RenderView.UnitMovement.tile.get_or (entity, entrance_tile);
  next_tile <- RenderView.UnitMovement.next_tile.get_or (entity, tile);
  progress <- RenderView.UnitMovement.progress.get_or (entity, 0);
  active <- RenderView.UnitActivity.active.get_or (entity, False);
  let x = interpolate (
    MapScene.tile_world_x tile,
    MapScene.tile_world_x next_tile,
    progress
  );
  let y = interpolate (
    MapScene.tile_world_y tile,
    MapScene.tile_world_y next_tile,
    progress
  );
  _ <- Render.material {
    .blend_edges = 0;
    .color_blue = color_blue;
    .color_green = color_green;
    .color_red = color_red;
    .id = object_id;
    .secondary_texture = no_texture;
    .surface_mode = upright_decal;
    .texture = 8;
    .texture_scale_x = 1000000;
    .texture_scale_y = 1000000;
    .path_connections = 0;
    .variation_seed = 0;
  };
  _ <- Render.mesh { .id = object_id; .mesh = 2; };
  _ <- Render.object {
    .emissive = 0;
    .id = object_id;
    .parent = root;
    .rotation_x_microradians = 0;
    .rotation_y_microradians = 0;
    .rotation_z_microradians = 0;
    .scale_x = scale_x;
    .scale_y = scale_y;
    .scale_z = 500000;
    .visible = active;
    .x = x;
    .y = y;
    .z = 180000;
  };
end;

let render = fn () => do
  _ <- Render.projection orthographic;
  _ <- Render.zoom 250000;
  _ <- Resource.mesh { .id = 0; .url = "/assets/terrain.obj"; };
  _ <- Resource.mesh { .id = 1; .url = "/assets/path-tile.obj"; };
  _ <- Resource.mesh { .id = 2; .url = "/assets/terrain-detail.obj"; };
  _ <- Resource.texture { .id = 0; .url = "/assets/terrain-grass.webp"; };
  _ <- Resource.texture { .id = 1; .url = "/assets/terrain-sand.webp"; };
  _ <- Resource.texture { .id = 2; .url = "/assets/terrain-road.webp"; };
  _ <- Resource.texture { .id = 3; .url = "/assets/terrain-detail-bushes.png"; };
  _ <- Resource.texture { .id = 4; .url = "/assets/terrain-detail-rocks.png"; };
  _ <- Resource.texture { .id = 5; .url = "/assets/terrain-detail-meadow-v2.png"; };
  _ <- Resource.texture { .id = 6; .url = "/assets/terrain-detail-shrub-v2.png"; };
  _ <- Resource.texture { .id = 7; .url = "/assets/terrain-detail-grove-v2.png"; };
  _ <- Resource.texture { .id = 8; .url = "/assets/tent-placeholder.png"; };
  _ <- Render.directional_light {
    .color_blue = 780000;
    .color_green = 950000;
    .color_red = 1000000;
    .direction_x = -300000;
    .direction_y = -500000;
    .direction_z = -1000000;
    .intensity = 900000;
  };
  _ <- MapScene.render_map {
    .blend = RenderView.Terrain.blend_edges.column;
    .detail = RenderView.Terrain.detail_texture.column;
    .path = RenderView.Terrain.path_connections.column;
    .terrain = RenderView.Terrain.texture.column;
  };
  _ <- render_ground_layer (
    4000,
    path_tool,
    RenderView.Construction.kind.column.component,
    RenderView.Construction.kind.column.field,
    cardinal_connections,
    920000,
    900000,
    850000,
    800000,
    0
  );
  _ <- render_ground_layer (
    5024,
    plot_tool,
    RenderView.Construction.kind.column.component,
    RenderView.Construction.kind.column.field,
    no_connections,
    760000,
    700000,
    650000,
    950000,
    20000
  );
  _ <- render_decal_layer (
    6048, tent_residence, RenderView.Construction.kind.column.component,
    RenderView.Construction.kind.column.field, 8, 1000000, 1000000, 1000000,
    1400000, 1400000, 800000, 120000, 0
  );
  _ <- render_decal_layer (
    7072, well_tool, RenderView.Construction.kind.column.component,
    RenderView.Construction.kind.column.field, 4, 700000, 850000, 1000000,
    900000, 900000, 700000, 90000, 0
  );
  _ <- render_decal_layer (
    8096, house_residence, RenderView.Construction.kind.column.component,
    RenderView.Construction.kind.column.field, 8, 1000000, 950000, 850000,
    1900000, 1900000, 1000000, 160000, 0
  );
  _ <- render_decal_layer (
    9120, marshal_post_tool, RenderView.Construction.kind.column.component,
    RenderView.Construction.kind.column.field, 8, 1000000, 700000, 650000,
    1700000, 1700000, 900000, 140000, 0
  );
  _ <- render_decal_layer (
    10144, 1, RenderView.Residence.burning.column.component,
    RenderView.Residence.burning.column.field, 6, 1000000, 300000, 150000,
    1300000, 1800000, 1000000, 300000, 1000000
  );
  _ <- render_unit (
    immigrant_entity, 11168, 450000, 850000, 1000000, 500000, 650000
  );
  _ <- render_unit (
    marshal_entity, 12192, 1000000, 900000, 900000, 550000, 700000
  );
end;

phase <- Phase.current ();
_ <- case phase of
  #(schema_phase) => do
    _ <- City.register ();
    _ <- Setup.Terrain.seed_source MapScene.terrain_seed ();
  end,
  #(start_phase) => do
    _ <- Setup.UnitMovement.insert (immigrant_entity, {
      .tile = entrance_tile;
      .destination = entrance_tile;
      .next_tile = entrance_tile;
      .previous_tile = entrance_tile;
      .progress = 0;
    });
    _ <- Setup.UnitActivity.insert (immigrant_entity, { .active = False; });
    _ <- Setup.UnitMovement.insert (marshal_entity, {
      .tile = entrance_tile;
      .destination = entrance_tile;
      .next_tile = entrance_tile;
      .previous_tile = entrance_tile;
      .progress = 0;
    });
    _ <- Setup.UnitActivity.insert (marshal_entity, { .active = False; });
    _ <- Setup.Construction.insert (entrance_tile, { .kind = path_tool; });
    _ <- State.commit 0;
  end,
  #(frame_phase) => do
    _ <- update ();
    _ <- State.commit 0;
  end,
  #(describe_phase) => describe Text,
  #(render_phase) => render (),
  _ => ()
end;

return ();
