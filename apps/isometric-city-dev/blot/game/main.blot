open {} = (@import "../prelude.blot") ();
const append_text = Text.append;

open {} = (@import "../../../../packages/blot/engine.blot") ();
open {} = (@import "../../../../packages/blot/html_canvas.blot") ();
open {} = (@import "../../../../packages/blot/scene.blot") ();

const MapScene = (@import "./map_scene.blot") ();

const update = fn state => do
  _ <- Events.next ();
  in state
end;

const tile_label = fn index => do
  let row = index / 3 + 1;
  let column = @int.rem index 3 + 1;
  in append_text
    (append_text
      (append_text (@text.of_int row) ",")
      (@text.of_int column)
    )
    " terrain tile"
end;

const describe_tile = fn (Text, index) => do
  let label = tile_label index;
  <Text
    .attachment={attachment (
      index,
      vec3 (0, 0, 180000),
      element_size (1800000, 900000)
    )}
    .description={append_text "Map region " label}
    .element_size={element_size (128, 64)}
    .id={append_text "city-tile-" (@text.of_int index)}
    .label={label}
    .order={index + 1}
    .style={style ("transparent", "transparent", 0, 0, "transparent", 1, 400)}
  />;
end;

const describe = fn () => do
  <Text
    .attachment={attachment (
      4,
      vec3 (0, 0, 10000),
      element_size (5400000, 2700000)
    )}
    .description="A seamless grid of nine isometric terrain tiles"
    .element_size={element_size (384, 192)}
    .id="city-ground"
    .label="Isometric terrain"
    .order=0
    .style={style ("#6b7129", "transparent", 0, 0, "transparent", 1, 400)}
  />;
  _ <- describe_tile (Text, 0);
  _ <- describe_tile (Text, 1);
  _ <- describe_tile (Text, 2);
  _ <- describe_tile (Text, 3);
  _ <- describe_tile (Text, 4);
  _ <- describe_tile (Text, 5);
  _ <- describe_tile (Text, 6);
  _ <- describe_tile (Text, 7);
  _ <- describe_tile (Text, 8);
  <Status
    .done=False
    .label="Map"
    .value="Nine terrain tiles"
  />;
  in ()
end;

const render = fn () => do
  <Camera .projection={orthographic}>
    _ <- MapScene.add_ground_tile (Object, 0);
    _ <- MapScene.add_ground_tile (Object, 1);
    _ <- MapScene.add_ground_tile (Object, 2);
    _ <- MapScene.add_ground_tile (Object, 3);
    _ <- MapScene.add_ground_tile (Object, 4);
    _ <- MapScene.add_ground_tile (Object, 5);
    _ <- MapScene.add_ground_tile (Object, 6);
    _ <- MapScene.add_ground_tile (Object, 7);
    _ <- MapScene.add_ground_tile (Object, 8);
  </Camera>;
  in ()
end;

let step = fn () => do
  phase <- Phase.current ();
  state <- State.current ();
  _ <- case phase of
    #(start_phase) => State.commit 0,
    #(frame_phase) => do
      next_state <- update state;
      _ <- State.commit next_state;
      in ()
    end,
    #(describe_phase) => describe (),
    #(render_phase) => render (),
    _ => ()
  end;
  in ()
end;

return { .step = step; };
