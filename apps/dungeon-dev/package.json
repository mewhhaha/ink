{
  "name": "@ink/dungeon-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config ink.ts",
    "build:game": "deno run --config ../../deno.json --allow-read --allow-write --allow-run=deno ink.ts",
    "check": "deno check --config ../../deno.json ink.ts src/headless/*.ts src/editor/*.ts src/editor/*.tsx src/browser/*.ts src/browser/*.tsx",
    "dev": "vite --config ink.ts",
    "headless": "pnpm build:game && deno run --config ../../deno.json --allow-read src/headless/main.ts",
    "test": "pnpm build:game && deno test --config ../../deno.json --allow-env --allow-read --allow-write src/headless/*_test.ts src/editor/*_test.ts src/browser/*_test.ts src/browser/*_test.tsx"
  },
  "dependencies": {
    "@comp0/react": "catalog:",
    "@heroicons/react": "catalog:",
    "@ink/assets": "workspace:*",
    "@ink/audio": "workspace:*",
    "@ink/adventure-editor": "workspace:*",
    "@ink/blot": "workspace:*",
    "@ink/development": "workspace:*",
    "@ink/editor-ui": "workspace:*",
    "@ink/input": "workspace:*",
    "@ink/observability": "workspace:*",
    "@ink/rendering": "workspace:*",
    "@ink/runtime": "workspace:*",
    "@ink/vite": "workspace:*",
    "@mewhhaha/typeclasses": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "vite": "catalog:"
  },
  "ink": {
    "kind": "application"
  }
}
