open import "../prelude.blot"
open import "@ink/blot/data.blot"
open import "@ink/blot/engine.blot"

const M = import "@ink/blot/math.blot"
const ProjectProvider = import "../generated/project.blot"
const Abi = import "@ink/blot/abi.blot"
const Render = Abi.Render
const Ui = Abi.Ui
const Scene = import "@ink/blot/scene.blot"
const Html = import "@ink/blot/html_canvas.blot"

const level_asset = 0
const player_x_cell = 0
const player_y_cell = 1
const velocity_x_cell = 2
const velocity_y_cell = 3
const left_cell = 4
const right_cell = 5
const grounded_cell = 6
const jumping_cell = 7
const completed_cell = 8
const left_start_event = 10
const left_stop_event = 11
const right_start_event = 12
const right_stop_event = 13
const jump_event = 14
const restart_event = 15
const unit = 1000000
const maximum_delta_us = 50000
const player_half_width = 400000
const player_height = 1500000
const player_half_height = 750000

use phase <- Phase.current ()
use state <- State.current ()
let Project = ProjectProvider.project state
use player_x <- Cells.get player_x_cell
use player_y <- Cells.get player_y_cell
use velocity_x <- Cells.get velocity_x_cell
use velocity_y <- Cells.get velocity_y_cell
use moving_left <- Cells.get left_cell
use moving_right <- Cells.get right_cell
use grounded <- Cells.get grounded_cell
use jumping <- Cells.get jumping_cell
use completed <- Cells.get completed_cell

let reset_player = fn () => do:
  use Cells.put { .index = player_x_cell; .value = Project.spawn_x; }
  use Cells.put { .index = player_y_cell; .value = Project.spawn_y; }
  use Cells.put { .index = velocity_x_cell; .value = 0; }
  use Cells.put { .index = velocity_y_cell; .value = 0; }
  use Cells.put { .index = left_cell; .value = 0; }
  use Cells.put { .index = right_cell; .value = 0; }
  use Cells.put { .index = grounded_cell; .value = 1; }
  use Cells.put { .index = jumping_cell; .value = 0; }
  use Cells.put { .index = completed_cell; .value = 0; }
  return ()

let apply_input = fn event => do:
  let input_kind = case event.kind == activate_event of
    #True => event.target
    #False => event.kind
  if input_kind == left_start_event:
    use Cells.put { .index = left_cell; .value = 1; }

  if input_kind == left_stop_event:
    use Cells.put { .index = left_cell; .value = 0; }

  if input_kind == right_start_event:
    use Cells.put { .index = right_cell; .value = 1; }

  if input_kind == right_stop_event:
    use Cells.put { .index = right_cell; .value = 0; }

  if input_kind == jump_event && grounded == 1 && completed == 0:
    use Cells.put { .index = velocity_y_cell; .value = Project.jump_speed; }
    use Cells.put { .index = grounded_cell; .value = 0; }
    use Cells.put { .index = jumping_cell; .value = 1; }

  if input_kind == restart_event:
    use reset_player ()

  return ()

let describe_status = fn (message, context) => do:
  use Html.Text {
    .attachment = Html.viewport_attachment (
      Html.top_left,
      Html.element_size (24, 24)
    );
    .description = context;
    .element_size = Html.element_size (560, 34);
    .id = "platformer.status";
    .label = message;
    .order = 1;
  } []
  return ()

let describe_button =
  fn (id, label, description, order, offset_x, target) => do:
    use Html.Button {
      .attachment = Html.viewport_attachment (
        Html.bottom_left,
        Html.element_size (offset_x, 24)
      );
      .description = description;
      .element_size = Html.element_size (136, 44);
      .id = id;
      .label = label;
      .order = order;
      .pressed = False;
      .selected = False;
      .target = target;
    } []
    return ()

let simulate_player = fn () => do:
  use raw_delta_us <- Time.delta_us ()
  let delta_us = M.minimum (raw_delta_us, maximum_delta_us)
  let desired_velocity_x =
    (moving_right - moving_left) * Project.maximum_run_speed
  let acceleration = case grounded == 1 of
    #True => Project.ground_acceleration
    #False => Project.air_acceleration
  let acceleration_step = acceleration * delta_us / unit
  let next_velocity_x = case velocity_x < desired_velocity_x of
    #True => M.minimum (velocity_x + acceleration_step, desired_velocity_x)
    #False => M.maximum (velocity_x - acceleration_step, desired_velocity_x)
  let next_x = player_x + next_velocity_x * delta_us / unit
  let predicted_y = player_y + velocity_y * delta_us / unit
  let gravity_step = Project.gravity * delta_us / unit
  let next_velocity_y =
    M.maximum (
      velocity_y - gravity_step,
      -Project.terminal_fall_speed
    )
  use Cells.put { .index = player_x_cell; .value = next_x; }
  use Cells.put { .index = player_y_cell; .value = predicted_y; }
  use Cells.put { .index = velocity_x_cell; .value = next_velocity_x; }
  use Cells.put { .index = velocity_y_cell; .value = next_velocity_y; }
  use Cells.put { .index = grounded_cell; .value = 0; }

  for platform in Iter.range (0, Project.platform_count):
    use minimum_x <- DataAsset.get {
      .asset = level_asset;
      .field = 0;
      .index = platform;
    }
    use minimum_y <- DataAsset.get {
      .asset = level_asset;
      .field = 1;
      .index = platform;
    }
    use maximum_x <- DataAsset.get {
      .asset = level_asset;
      .field = 2;
      .index = platform;
    }
    use maximum_y <- DataAsset.get {
      .asset = level_asset;
      .field = 3;
      .index = platform;
    }
    use surface <- DataAsset.get {
      .asset = level_asset;
      .field = 4;
      .index = platform;
    }
    let overlaps_left = next_x + player_half_width > minimum_x
    let overlaps_right = next_x - player_half_width < maximum_x
    let moves_down = velocity_y <= 0
    let starts_above = player_y >= maximum_y
    let crosses_top = predicted_y <= maximum_y
    if overlaps_left && overlaps_right && moves_down && starts_above && crosses_top:
      use Cells.put { .index = player_y_cell; .value = maximum_y; }
      use Cells.put { .index = velocity_y_cell; .value = 0; }
      use Cells.put { .index = grounded_cell; .value = 1; }
      use Cells.put { .index = jumping_cell; .value = 0; }

    let moves_up = velocity_y > 0
    let starts_below = player_y + player_height <= minimum_y
    let crosses_bottom = predicted_y + player_height >= minimum_y
    if surface == 0 && overlaps_left && overlaps_right && moves_up && starts_below && crosses_bottom:
      use Cells.put {
        .index = player_y_cell;
        .value = minimum_y - player_height;
      }
      use Cells.put { .index = velocity_y_cell; .value = 0; }

  let reaches_exit_left = next_x + player_half_width >= Project.exit_min_x
  let reaches_exit_right = next_x - player_half_width <= Project.exit_max_x
  let reaches_exit_bottom = predicted_y + player_height >= Project.exit_min_y
  let reaches_exit_top = predicted_y <= Project.exit_max_y
  if reaches_exit_left && reaches_exit_right && reaches_exit_bottom && reaches_exit_top:
    use Cells.put { .index = completed_cell; .value = 1; }
    use Cells.put { .index = left_cell; .value = 0; }
    use Cells.put { .index = right_cell; .value = 0; }
    use Cells.put { .index = velocity_x_cell; .value = 0; }

  if predicted_y < Project.kill_plane_y:
    use reset_player ()

  return ()

if phase == start_phase:
  use reset_player ()
  use State.commit 0

if phase == update_phase:
  use event <- Events.next ()
  use apply_input event
  if event.kind == elapsed_event && completed == 0:
    use simulate_player ()

  use State.commit (state + 1)

if phase == describe_phase:
  if completed == 1:
    use Ui.status {
      .done = True;
      .label = Project.project_name;
      .value = "Moved exit reached";
    }
    use describe_status ("Moved exit reached", Project.project_name)

  if completed == 0 && jumping == 1:
    use Ui.status {
      .done = False;
      .label = Project.level_name;
      .value = "Jumping to the exit";
    }
    use describe_status ("Jumping to the exit", Project.level_name)

  if completed == 0 && jumping == 0:
    use Ui.status {
      .done = False;
      .label = Project.level_name;
      .value = "Run and jump to the exit";
    }
    use describe_status ("Run and jump to the exit", Project.level_name)

  use describe_button (
    "platformer.move-left",
    "Move left",
    "Start moving the player left",
    10,
    24,
    left_start_event
  )
  use describe_button (
    "platformer.stop-left",
    "Stop left",
    "Stop moving the player left",
    11,
    172,
    left_stop_event
  )
  use describe_button (
    "platformer.move-right",
    "Move right",
    "Start moving the player right",
    12,
    320,
    right_start_event
  )
  use describe_button (
    "platformer.stop-right",
    "Stop right",
    "Stop moving the player right",
    13,
    468,
    right_stop_event
  )
  use describe_button (
    "platformer.jump",
    "Jump",
    "Jump toward the authored exit",
    14,
    616,
    jump_event
  )
  use Html.Button {
    .attachment = Html.viewport_attachment (
      Html.bottom_right,
      Html.element_size (24, 80)
    );
    .description = "Restart the authored level";
    .element_size = Html.element_size (136, 44);
    .id = "platformer.restart";
    .label = "Restart";
    .order = 15;
    .pressed = False;
    .selected = False;
    .target = restart_event;
  } []
  use Ui.action { .id = "left-start"; .kind = left_start_event; .label = "Move left"; .target = 0; .value = 0; }
  use Ui.action { .id = "left-stop"; .kind = left_stop_event; .label = "Stop moving left"; .target = 0; .value = 0; }
  use Ui.action { .id = "right-start"; .kind = right_start_event; .label = "Move right"; .target = 0; .value = 0; }
  use Ui.action { .id = "right-stop"; .kind = right_stop_event; .label = "Stop moving right"; .target = 0; .value = 0; }
  use Ui.action { .id = "jump"; .kind = jump_event; .label = "Jump"; .target = 0; .value = 0; }
  use Ui.action { .id = "restart"; .kind = restart_event; .label = "Restart"; .target = 0; .value = 0; }

if phase == render_phase:
  use Scene.OrthographicCamera {
    .clear_color = Scene.color (12000, 18000, 38000);
    .position = Scene.vec3 (
      player_x,
      player_y + player_half_height,
      20000000
    );
    .target = Scene.vec3 (player_x, player_y + player_half_height, 0);
    .vertical_size = 12000000;
  } []
  use Scene.Environment {
    .ambient_light = Scene.color (180000, 220000, 300000);
    .bloom_intensity = 220000;
    .exposure_ev100 = 650000;
    .fog_color = Scene.color (12000, 18000, 38000);
    .fog_density = 4000;
  } []
  use Render.directional_light {
    .color_blue = 1000000;
    .color_green = 940000;
    .color_red = 860000;
    .direction_x = -300000;
    .direction_y = -900000;
    .direction_z = -200000;
    .intensity = 1100000;
  }
  for platform in Iter.range (0, Project.platform_count):
    use minimum_x <- DataAsset.get {
      .asset = level_asset;
      .field = 0;
      .index = platform;
    }
    use minimum_y <- DataAsset.get {
      .asset = level_asset;
      .field = 1;
      .index = platform;
    }
    use maximum_x <- DataAsset.get {
      .asset = level_asset;
      .field = 2;
      .index = platform;
    }
    use maximum_y <- DataAsset.get {
      .asset = level_asset;
      .field = 3;
      .index = platform;
    }
    let object_id = 100 + platform
    use Render.material {
      .blend_edges = 0;
      .color_blue = 340000;
      .color_green = 310000;
      .color_red = 260000;
      .id = object_id;
      .secondary_texture = -1;
      .surface_mode = 0;
      .texture = -1;
      .texture_offset_x = 0;
      .texture_offset_y = 0;
      .texture_scale_x = unit;
      .texture_scale_y = unit;
      .path_connections = 0;
      .variation_seed = platform;
    }
    use Render.mesh { .id = object_id; .mesh = 0; }
    use Render.object {
      .emissive = 0;
      .id = object_id;
      .parent = -1;
      .rotation_x_microradians = 0;
      .rotation_y_microradians = 0;
      .rotation_z_microradians = 0;
      .scale_x = maximum_x - minimum_x;
      .scale_y = maximum_y - minimum_y;
      .scale_z = 300000;
      .visible = True;
      .x = (minimum_x + maximum_x) / 2;
      .y = (minimum_y + maximum_y) / 2;
      .z = 0;
    }

  use Render.material {
    .blend_edges = 0;
    .color_blue = 220000;
    .color_green = 940000;
    .color_red = 180000;
    .id = 11;
    .secondary_texture = -1;
    .surface_mode = 0;
    .texture = -1;
    .texture_offset_x = 0;
    .texture_offset_y = 0;
    .texture_scale_x = unit;
    .texture_scale_y = unit;
    .path_connections = 0;
    .variation_seed = 11;
  }
  use Render.mesh { .id = 11; .mesh = 0; }
  use Render.object {
    .emissive = 900000;
    .id = 11;
    .parent = -1;
    .rotation_x_microradians = 0;
    .rotation_y_microradians = 0;
    .rotation_z_microradians = 0;
    .scale_x = Project.exit_max_x - Project.exit_min_x;
    .scale_y = Project.exit_max_y - Project.exit_min_y;
    .scale_z = 250000;
    .visible = completed == 0;
    .x = (Project.exit_min_x + Project.exit_max_x) / 2;
    .y = (Project.exit_min_y + Project.exit_max_y) / 2;
    .z = 100000;
  }
  use Render.material {
    .blend_edges = 0;
    .color_blue = 1000000;
    .color_green = 680000;
    .color_red = 180000;
    .id = 10;
    .secondary_texture = -1;
    .surface_mode = 0;
    .texture = -1;
    .texture_offset_x = 0;
    .texture_offset_y = 0;
    .texture_scale_x = unit;
    .texture_scale_y = unit;
    .path_connections = 0;
    .variation_seed = 10;
  }
  use Render.mesh { .id = 10; .mesh = 0; }
  use Render.object {
    .emissive = 180000;
    .id = 10;
    .parent = -1;
    .rotation_x_microradians = 0;
    .rotation_y_microradians = 0;
    .rotation_z_microradians = 0;
    .scale_x = player_half_width * 2;
    .scale_y = player_height;
    .scale_z = 400000;
    .visible = True;
    .x = player_x;
    .y = player_y + player_half_height;
    .z = 200000;
  }

return ()
