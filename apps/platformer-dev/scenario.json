{
  "version": 2,
  "role": "editor_game",
  "editor": "@ink/platformer-editor",
  "commands": {
    "headless": "pnpm --filter @ink/platformer-dev scenario:headless",
    "browser": "pnpm --filter @ink/platformer-dev scenario:browser"
  },
  "edit": "move the authored level exit one unit to the right and rebuild the Blot guest",
  "expected_outcome": "jump into the moved exit with matching host collision, replay checksum, and presentation",
  "proofs": [
    {
      "package": "@ink/animation",
      "exports": ["./clip.ts", "./pose.ts", "./skeleton.ts"],
      "assertions": [
        "headless:player-animation-follows-blot-jump-state",
        "browser:player-animation-changes-rendered-transform"
      ]
    },
    {
      "package": "@ink/assets",
      "exports": [
        "./bundle.ts",
        "./cache.ts",
        "./identity.ts",
        "./manifest.ts"
      ],
      "assertions": [
        "browser:level-loads-verified-digest-artifact"
      ]
    },
    {
      "package": "@ink/blot",
      "exports": [
        "./abi.blot",
        "./adapter.ts",
        "./build.ts",
        "./data_asset.ts",
        "./data.blot",
        "./engine.blot",
        "./html_canvas.blot",
        "./math.blot",
        "./protocol.ts"
      ],
      "assertions": [
        "headless:moved-exit-jump-replay-and-collision-parity",
        "browser:edited-exit-rebuilds-and-reloads",
        "browser:moved-exit-ui-matches-headless-replay",
        "browser:blot-ui-adapter-restarts-level"
      ]
    },
    {
      "package": "@ink/development",
      "exports": ["./debugger.ts"],
      "assertions": [
        "headless:moved-exit-jump-replay-and-collision-parity",
        "browser:moved-exit-ui-matches-headless-replay"
      ]
    },
    {
      "package": "@ink/geometry",
      "exports": [
        "./dynamic_tree.ts",
        "./queries.ts",
        "./shapes.ts"
      ],
      "assertions": [
        "headless:moved-exit-jump-replay-and-collision-parity"
      ]
    },
    {
      "package": "@ink/input",
      "exports": [
        "./actions.ts",
        "./browser.ts",
        "./model.ts",
        "./recording.ts",
        "./synthetic.ts"
      ],
      "assertions": [
        "headless:recorded-input-drives-moved-exit",
        "browser:recorded-and-browser-input-frames-match"
      ]
    },
    {
      "package": "@ink/math",
      "exports": ["./quaternion.ts", "./scalar.ts", "./vector.ts"],
      "assertions": [
        "headless:moved-exit-jump-replay-and-collision-parity"
      ]
    },
    {
      "package": "@ink/observability",
      "exports": ["./observer.ts", "./redaction.ts", "./sink.ts"],
      "assertions": [
        "headless:moved-exit-jump-replay-and-collision-parity",
        "browser:moved-exit-ui-matches-headless-replay"
      ]
    },
    {
      "package": "@ink/physics",
      "exports": [
        "./collision.ts",
        "./identity.ts",
        "./shapes.ts",
        "./world.ts",
        "./world_2d.ts"
      ],
      "assertions": [
        "headless:moved-exit-jump-replay-and-collision-parity"
      ]
    },
    {
      "package": "@ink/platformer-editor",
      "exports": ["./serialization.ts"],
      "assertions": [
        "headless:moved-exit-jump-replay-and-collision-parity",
        "browser:edited-exit-rebuilds-and-reloads"
      ]
    },
    {
      "package": "@ink/rendering",
      "exports": ["./renderer.ts"],
      "assertions": [
        "browser:completed-level-renders-canonical-pixels"
      ]
    },
    {
      "package": "@ink/runtime",
      "exports": [
        "./artifact.ts",
        "./digest.ts",
        "./frame.ts",
        "./identity.ts",
        "./session.ts"
      ],
      "assertions": [
        "headless:moved-exit-jump-replay-and-collision-parity",
        "headless:recorded-input-drives-moved-exit",
        "browser:moved-exit-ui-matches-headless-replay"
      ]
    },
    {
      "package": "@ink/ui",
      "exports": ["./browser.ts", "./layout.ts"],
      "assertions": [
        "browser:blot-ui-adapter-restarts-level"
      ]
    },
    {
      "package": "@ink/vite",
      "exports": ["."],
      "assertions": [
        "browser:edited-exit-rebuilds-and-reloads"
      ]
    }
  ]
}
