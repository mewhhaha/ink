{
  "name": "@ink/platformer-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config ink.ts",
    "build:game": "deno run --config ../../deno.json --allow-env=INK_PLATFORMER_PROJECT_FILE --allow-read --allow-write --allow-run=deno ink.ts",
    "check": "deno check --config ../../deno.json ink.ts src/*.ts src/headless/*.ts src/editor/*.ts src/browser/*.ts src/browser/*.tsx && node --check src/browser/scenario_test.mjs",
    "dev": "vite --config ink.ts",
    "headless": "pnpm build:game && deno run --config ../../deno.json --allow-read src/headless/main.ts",
    "test": "pnpm build:game && deno test --config ../../deno.json --allow-env --allow-read --allow-write --allow-run=deno src/*_test.ts src/headless/*_test.ts src/editor/*_test.ts src/browser/input_test.ts src/browser/platformer_shader_test.ts src/browser/scene_asset_test.ts src/browser/*_test.tsx",
    "test:browser": "node --test --test-concurrency=1 src/browser/scenario_test.mjs"
  },
  "dependencies": {
    "@ink/animation": "workspace:*",
    "@ink/assets": "workspace:*",
    "@ink/blot": "workspace:*",
    "@ink/development": "workspace:*",
    "@ink/geometry": "workspace:*",
    "@ink/input": "workspace:*",
    "@ink/math": "workspace:*",
    "@ink/observability": "workspace:*",
    "@ink/physics": "workspace:*",
    "@ink/platformer-editor": "workspace:*",
    "@ink/rendering": "workspace:*",
    "@ink/runtime": "workspace:*",
    "@ink/visibility": "workspace:*",
    "@ink/vite": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "playwright": "1.61.1",
    "vite": "catalog:"
  },
  "ink": {
    "kind": "application"
  }
}
