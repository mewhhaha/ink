open import "../prelude.blot"
open import "@ink/blot/engine.blot"

const Project = import "../generated/project.blot"
const Scene = import "@ink/blot/scene.blot"

const Semantic =
  @effect.host {
    .action = {
      .id = Text;
      .kind = Int;
      .label = Text;
      .target = Int;
      .value = Int;
    } -> Unit;
    .status = { .done = Bool; .label = Text; .value = Text; } -> Unit;
  }

const choose_first_event = 10
const choose_second_event = 11
const restart_event = 12
const scene_cell = 1000

use phase <- Phase.current ()
use state <- State.current ()
use scene <- Cells.get scene_cell

let reset_story = fn () => do:
  use Cells.put { .index = scene_cell; .value = 0; }
  use State.commit 0
  return ()

if phase == start_phase:
  use reset_story ()

if phase == frame_phase:
  use event <- Events.next ()
  if event.kind == choose_first_event && scene == 0:
    use Cells.put { .index = scene_cell; .value = 1; }
    use State.commit Project.first_checksum

  if event.kind == choose_second_event && scene == 0:
    use Cells.put { .index = scene_cell; .value = 2; }
    use State.commit Project.second_checksum

  if event.kind == restart_event:
    use reset_story ()

  if event.kind != choose_first_event && event.kind != choose_second_event && event.kind != restart_event:
    use State.commit state

if phase == describe_phase:
  if scene == 0:
    use Semantic.status {
      .done = False;
      .label = Project.initial_title;
      .value = Project.intro_status;
    }
    use Semantic.action {
      .id = Project.first_choice_id;
      .kind = choose_first_event;
      .label = Project.first_choice_label;
      .target = 0;
      .value = 0;
    }
    use Semantic.action {
      .id = Project.second_choice_id;
      .kind = choose_second_event;
      .label = Project.second_choice_label;
      .target = 0;
      .value = 0;
    }

  if scene == 1:
    use Semantic.status {
      .done = True;
      .label = Project.first_ending_label;
      .value = Project.first_outcome;
    }

  if scene == 2:
    use Semantic.status {
      .done = True;
      .label = Project.second_ending_label;
      .value = Project.second_outcome;
    }

  use Semantic.action {
    .id = "restart";
    .kind = restart_event;
    .label = "Restart story";
    .target = 0;
    .value = 0;
  }

if phase == render_phase:
  use Scene.Render.projection Scene.orthographic
  use Scene.Render.zoom 1000000
  use Scene.Render.directional_light {
    .color_blue = 1000000;
    .color_green = 1000000;
    .color_red = 1000000;
    .direction_x = 0;
    .direction_y = 0;
    .direction_z = -1000000;
    .intensity = 0;
  }

return ()
