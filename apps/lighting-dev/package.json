{
  "name": "@ink/lighting-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config ink.ts",
    "check": "deno check --config ../../deno.json ink.ts src/*.ts src/*.tsx",
    "dev": "vite --config ink.ts",
    "test": "deno test --config ../../deno.json --allow-read=assets src/*_test.ts"
  },
  "dependencies": {
    "@comp0/react": "catalog:",
    "@ink/assets": "workspace:*",
    "@ink/input": "workspace:*",
    "@ink/rendering": "workspace:*",
    "@ink/runtime": "workspace:*",
    "@ink/vite": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:"
  },
  "ink": {
    "kind": "application"
  }
}
