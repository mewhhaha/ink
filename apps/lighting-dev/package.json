{
  "name": "@ink/lighting-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm prepare:assets && vite build --config ink.ts",
    "check": "deno check --config ../../deno.json ink.ts src/*.ts src/*.tsx && node --check src/browser/*_test.mjs",
    "dev": "pnpm prepare:assets && vite --config ink.ts",
    "prepare:assets": "deno run --config ../../deno.json --allow-read=assets,generated --allow-write=generated ../../scripts/build_lighting_assets.ts",
    "scenario:browser": "deno run --config ../../deno.json --allow-env=INK_SCENARIO_REPORT --allow-read --allow-run=pnpm --allow-write ../../scripts/run_capability_scenario_command.ts -- pnpm test:browser",
    "scenario:headless": "deno run --config ../../deno.json --allow-env=INK_SCENARIO_REPORT --allow-read --allow-run=pnpm --allow-write ../../scripts/run_capability_scenario_command.ts -- pnpm test",
    "test": "pnpm prepare:assets && deno test --config ../../deno.json --allow-read=assets,generated src/*_test.ts",
    "test:browser": "pnpm prepare:assets && node --test --test-concurrency=1 src/browser/*_test.mjs"
  },
  "dependencies": {
    "@comp0/react": "catalog:",
    "@ink/assets": "workspace:*",
    "@ink/input": "workspace:*",
    "@ink/lighting": "workspace:*",
    "@ink/math": "workspace:*",
    "@ink/rendering": "workspace:*",
    "@ink/runtime": "workspace:*",
    "@ink/visibility": "workspace:*",
    "@ink/vite": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "playwright": "1.61.1",
    "vite": "catalog:"
  },
  "ink": {
    "kind": "application"
  }
}
