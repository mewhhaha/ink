open import "blot:prelude"
open import "@ink/blot/engine.blot"

const Color = { .red = Int; .green = Int; .blue = Int; }
const Abi = import "@ink/blot/abi.blot"
const Recipe = import "./recipe.blot"
const Render = Abi.Render
const Ui = Abi.Ui

const VOXEL = 240000

let emit = fn (x, y, z, color) => do:
  let coordinate = ((x + 64) * 128 + y + 64) * 128 + z + 64
  let id = coordinate * 256 + color.red
  use Render.material {
    .blend_edges = 0;
    .color_blue = color.blue * 1000000 / 255;
    .color_green = color.green * 1000000 / 255;
    .color_red = color.red * 1000000 / 255;
    .id = id;
    .secondary_texture = -1;
    .surface_mode = 0;
    .texture = -1;
    .texture_offset_x = 0;
    .texture_offset_y = 0;
    .texture_scale_x = 1000000;
    .texture_scale_y = 1000000;
    .path_connections = 0;
    .variation_seed = id;
  }
  use Render.mesh { .id = id; .mesh = 0; }
  use Render.object {
    .emissive = 0;
    .id = id;
    .parent = -1;
    .rotation_x_microradians = 0;
    .rotation_y_microradians = 0;
    .rotation_z_microradians = 0;
    .scale_x = VOXEL;
    .scale_y = VOXEL;
    .scale_z = VOXEL;
    .visible = True;
    .x = x * VOXEL;
    .y = y * VOXEL + VOXEL / 2;
    .z = z * VOXEL;
  }

let oak = fn (origin_x, origin_z, seed) => do:
  let bark = { .red = 88; .green = 57; .blue = 38; }
  let leaf_shadow = { .red = 37; .green = 92; .blue = 48; }
  let leaf_green = { .red = 55; .green = 129; .blue = 62; }
  let leaf_sun = { .red = 92; .green = 164; .blue = 71; }
  for y in Iter.range (0, 12):
    use emit (origin_x, y, origin_z, bark)
    if y > 6:
      use emit (origin_x + (y - 5) / 2, y, origin_z, bark)
      use emit (origin_x - (y - 5) / 3, y, origin_z + (y - 5) / 2, bark)

  for x in Iter.range (-6, 7):
    for y in Iter.range (8, 17):
      for z in Iter.range (-6, 7):
        let dy = y - 12
        let inside = x * x * 2 + dy * dy * 3 + z * z * 2 <= 76
        let edge = Int.abs (x * 19 + y * 31 + z * 43 + seed) % 11
        if inside && edge > 1:
          let color = case edge < 5, edge > 8 of
            #True, _ => leaf_shadow
            #False, #True => leaf_sun
            #False, #False => leaf_green
          use emit (origin_x + x, y, origin_z + z, color)

let fir = fn (origin_x, origin_z, seed) => do:
  let trunk = { .red = 91; .green = 61; .blue = 42; }
  let pine_shadow = { .red = 26; .green = 76; .blue = 54; }
  let pine_green = { .red = 39; .green = 111; .blue = 70; }
  let pine_tip = { .red = 78; .green = 145; .blue = 82; }
  for y in Iter.range (0, 17):
    use emit (origin_x, y, origin_z, trunk)
    if y >= 3:
      let radius = 7 - y / 3
      for offset in Iter.range (-7, 8):
        let sparse = Int.abs (offset * 23 + y * 37 + seed) % 5
        if Int.abs offset <= radius && offset != 0 && sparse > 0:
          let color = case y % 3 of
            0 => pine_shadow
            1 => pine_green
            _ => pine_tip
          use emit (origin_x + offset, y, origin_z, color)
          use emit (origin_x, y, origin_z + offset, color)

let flowers = fn (origin_x, origin_z) => do:
  let stem = { .red = 49; .green = 119; .blue = 61; }
  let centre = { .red = 255; .green = 188; .blue = 74; }
  let petals = { .red = 244; .green = 113; .blue = 111; }
  for index in Iter.range (0, 8):
    let x = origin_x + index % 4 * 4 - 6
    let z = origin_z + index / 4 * 5 - 2
    for y in Iter.range (0, 4):
      use emit (x, y, z, stem)

    use emit (x, 4, z, centre)
    use emit (x - 1, 4, z, petals)
    use emit (x + 1, 4, z, petals)
    use emit (x, 4, z - 1, petals)
    use emit (x, 4, z + 1, petals)

let rocks = fn (origin_x, origin_z, seed) => do:
  let granite = { .red = 111; .green = 119; .blue = 124; }
  let warm = { .red = 139; .green = 124; .blue = 105; }
  for x in Iter.range (-5, 6):
    for y in Iter.range (0, 5):
      for z in Iter.range (-4, 5):
        let inside = x * x * 2 + y * y * 5 + z * z * 3 <= 58
        let chipped = Int.abs (x * 17 + y * 29 + z * 41 + seed) % 13
        if inside && chipped > 1:
          let color = case x < 0 of
            #True => granite
            #False => warm
          use emit (origin_x + x, y, origin_z + z, color)

const selection_cell = 0
const seed_cell = 1
const select_event = 10
const regenerate_event = 11

use phase <- Phase.current ()
use state <- State.current ()
use selection <- Cells.get selection_cell
use seed <- Cells.get seed_cell

let recipe =
  Recipe.revise {
    .selection = selection;
    .values = [selection];
  }
let recipe_values = freeze recipe.values
let selected_name = case selection, Array.length recipe_values of
  2, 2 => "oak"
  2, 3 => "edited oak"
  2, _ => "recovered oak"
  3, 2 => "fir"
  3, 3 => "edited fir"
  3, _ => "recovered fir"
  4, 2 => "flower patch"
  4, 3 => "edited flower patch"
  4, _ => "recovered flower patch"
  5, 2 => "rock cluster"
  5, 3 => "edited rock cluster"
  5, _ => "recovered rock cluster"
  _, 2 => "mixed shrubbery"
  _, 3 => "edited mixed shrubbery"
  _, _ => "recovered mixed shrubbery"

if phase == start_phase:
  use Cells.put { .index = selection_cell; .value = 1; }
  use Cells.put { .index = seed_cell; .value = 424242; }
  use State.commit 424243

if phase == update_phase:
  use event <- Events.next ()
  if event.kind == select_event && event.value >= 1 && event.value <= 5:
    use Cells.put { .index = selection_cell; .value = event.value; }

  if event.kind == regenerate_event:
    use Cells.put { .index = seed_cell; .value = seed + 97; }

  use State.commit (state + 1)

if phase == describe_phase:
  use Ui.status {
    .done = False;
    .label = selected_name;
    .value = "Blot generated 3D shrubbery";
  }
  use Ui.action { .id = "mixed"; .kind = select_event; .label = "mixed shrubbery"; .target = 0; .value = 1; }
  use Ui.action { .id = "oak"; .kind = select_event; .label = "oak"; .target = 0; .value = 2; }
  use Ui.action { .id = "fir"; .kind = select_event; .label = "fir"; .target = 0; .value = 3; }
  use Ui.action { .id = "flowers"; .kind = select_event; .label = "flower patch"; .target = 0; .value = 4; }
  use Ui.action { .id = "rocks"; .kind = select_event; .label = "rock cluster"; .target = 0; .value = 5; }
  use Ui.action { .id = "regenerate"; .kind = regenerate_event; .label = "New seed"; .target = 0; .value = 0; }

if phase == render_phase:
  use Render.perspective_camera {
    .clear_blue = 45000;
    .clear_green = 25000;
    .clear_red = 16000;
    .position_x = 0;
    .position_y = 9000000;
    .position_z = 16000000;
    .target_x = 0;
    .target_y = 2100000;
    .target_z = 0;
    .vertical_fov_microradians = 850000;
  }
  use Render.environment {
    .ambient_blue = 160000;
    .ambient_green = 110000;
    .ambient_red = 80000;
    .bloom_intensity = 80000;
    .exposure_ev100 = -250000;
    .fog_blue = 75000;
    .fog_density = 13000;
    .fog_green = 55000;
    .fog_red = 30000;
  }
  use Render.directional_light {
    .color_blue = 650000;
    .color_green = 860000;
    .color_red = 1000000;
    .direction_x = -500000;
    .direction_y = -1000000;
    .direction_z = -320000;
    .intensity = 2200000;
  }
  use case selection of
    2 => oak (0, 0, seed)
    3 => fir (0, 0, seed)
    4 => flowers (0, 0)
    5 => rocks (0, 0, seed)
    _ => do:
      use oak (-9, -4, seed)
      use fir (10, 2, seed + 17)
      use flowers (-2, 10)
      use rocks (5, -10, seed + 31)

return ()
