{
  "name": "@ink/shrubbery-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config ink.ts",
    "build:game": "deno run --config ../../deno.json --allow-read --allow-write --allow-run=deno ink.ts",
    "check": "deno check --config ../../deno.json ink.ts src/*.ts",
    "dev": "vite --config ink.ts",
    "scenario:browser": "deno run --config ../../deno.json --allow-env=INK_SCENARIO_REPORT --allow-read --allow-run=pnpm --allow-write ../../scripts/run_capability_scenario_command.ts -- pnpm test:browser",
    "scenario:headless": "deno run --config ../../deno.json --allow-env=INK_SCENARIO_REPORT --allow-read --allow-run=pnpm --allow-write ../../scripts/run_capability_scenario_command.ts -- pnpm test",
    "test": "pnpm build:game && deno test --config ../../deno.json --allow-read src/*_test.ts",
    "test:browser": "node --test --test-concurrency=1 src/development_test.mjs"
  },
  "dependencies": {
    "@ink/blot": "workspace:*",
    "@ink/observability": "workspace:*",
    "@ink/rendering": "workspace:*",
    "@ink/runtime": "workspace:*",
    "@ink/ui": "workspace:*",
    "@ink/vite": "workspace:*"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "vite": "catalog:"
  },
  "ink": {
    "kind": "application"
  }
}
