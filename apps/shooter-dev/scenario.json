{
  "version": 2,
  "role": "editor_game",
  "editor": "@ink/shooter-editor",
  "commands": {
    "headless": "pnpm --filter @ink/shooter-dev scenario:headless",
    "browser": "pnpm --filter @ink/shooter-dev scenario:browser"
  },
  "edit": "add an enemy reinforcement to the authored arena encounter and rebuild the Blot guest",
  "expected_outcome": "expend authored sidearm ammunition, defeat the guard and reinforcement, and clear the arena with replay checksum and presentation parity",
  "proofs": [
    {
      "package": "@ink/assets",
      "exports": ["./identity.ts"],
      "assertions": ["browser:authored-audio-effects-reach-host"]
    },
    {
      "package": "@ink/audio",
      "exports": [
        "./device.ts",
        "./graph.ts",
        "./mixer.ts",
        "./model.ts"
      ],
      "assertions": ["browser:authored-audio-effects-reach-host"]
    },
    {
      "package": "@ink/authoring",
      "exports": ["./catalog.ts", "./identity.ts"],
      "assertions": [
        "headless:edited-reinforcement-arena-replay-and-presentation-parity"
      ]
    },
    {
      "package": "@ink/blot",
      "exports": [
        "./abi.blot",
        "./adapter.ts",
        "./build.ts",
        "./ecs.blot",
        "./engine.blot",
        "./html_canvas.blot",
        "./protocol.ts",
        "./scene.blot"
      ],
      "assertions": [
        "headless:edited-reinforcement-arena-replay-and-presentation-parity",
        "browser:edited-reinforcement-rebuilds-and-reloads",
        "browser:authored-ammunition-clears-two-enemy-arena",
        "browser:two-enemy-arena-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/development",
      "exports": ["./debugger.ts"],
      "assertions": [
        "headless:edited-reinforcement-arena-replay-and-presentation-parity",
        "browser:two-enemy-arena-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/ecs",
      "exports": ["./blot.ts"],
      "assertions": [
        "headless:edited-reinforcement-arena-replay-and-presentation-parity"
      ]
    },
    {
      "package": "@ink/math",
      "exports": ["./vector.ts"],
      "assertions": [
        "browser:two-enemy-arena-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/observability",
      "exports": ["./observer.ts", "./redaction.ts", "./sink.ts"],
      "assertions": [
        "headless:edited-reinforcement-arena-replay-and-presentation-parity",
        "browser:two-enemy-arena-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/rendering",
      "exports": ["./renderer.ts"],
      "assertions": [
        "browser:two-enemy-arena-matches-headless-presentation",
        "browser:final-arena-renders-non-clear-pixels"
      ]
    },
    {
      "package": "@ink/runtime",
      "exports": ["./session.ts"],
      "assertions": [
        "headless:edited-reinforcement-arena-replay-and-presentation-parity",
        "browser:two-enemy-arena-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/shooter-editor",
      "exports": [
        "./commands.ts",
        "./identity.ts",
        "./serialization.ts"
      ],
      "assertions": [
        "headless:edited-reinforcement-arena-replay-and-presentation-parity",
        "browser:edited-reinforcement-rebuilds-and-reloads"
      ]
    },
    {
      "package": "@ink/ui",
      "exports": ["./browser.ts", "./layout.ts"],
      "assertions": [
        "browser:two-enemy-arena-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/visibility",
      "exports": ["./model.ts", "./pipeline.ts"],
      "assertions": [
        "browser:authored-arena-visibility-selects-submitted-objects"
      ]
    },
    {
      "package": "@ink/vite",
      "exports": ["."],
      "assertions": [
        "browser:edited-reinforcement-rebuilds-and-reloads"
      ]
    }
  ]
}
