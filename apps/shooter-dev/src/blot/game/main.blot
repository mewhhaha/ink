open import "../prelude.blot"
open import "@ink/blot/engine.blot"

const ProjectProvider = import "../generated/project.blot"
const Abi = import "@ink/blot/abi.blot"
const HostEffect = Abi.HostEffect
const Html = import "@ink/blot/html_canvas.blot"
const Scene = import "@ink/blot/scene.blot"
const Ecs = import "@ink/blot/ecs.blot"

use state <- State.current ()
let Project = ProjectProvider.project state

const fire_target = 10
let enemy_maximum_health = Project.weapon_damage * Project.rounds_per_enemy

const CombatState =
  Ecs.component_4 {
    .fields = {
      .ammunition = Int;
      .enemy_health = Int;
      .defeated_enemies = Int;
      .completed = Int;
    };
    .name = "ShooterCombatState";
  }

const CombatWorld =
  Ecs.indexed_world {
    .base = 0;
    .capacity = 1;
    .components = [CombatState];
  }

const CombatStates = Ecs.store (CombatWorld, CombatState)
const Ammunition = CombatStates.field 0
const EnemyHealth = CombatStates.field 1
const DefeatedEnemies = CombatStates.field 2
const Completed = CombatStates.field 3
const combat_entity = 0
const register_combat_world = CombatWorld.register
let seed_combat_state = CombatStates.seed [(
  Project.magazine_capacity,
  enemy_maximum_health,
  0,
  0
)]

let active_enemy_id = fn defeated_enemies => do:
  if defeated_enemies == 0:
    return Project.first_enemy_id
  return Project.second_enemy_id

let describe_text = fn (id, label, description, order, offset_y) => do:
  use Html.Text {
    .attachment = Html.viewport_attachment (
      Html.top_left,
      Html.element_size (24, offset_y)
    );
    .description = description;
    .element_size = Html.element_size (620, 28);
    .id = id;
    .label = label;
    .order = order;
  } []
  return ()

let describe_fire_button = fn () => do:
  use Html.Button {
    .attachment = Html.viewport_attachment (
      Html.bottom_left,
      Html.element_size (24, 24)
    );
    .description = Text.append "Fire authored weapon " Project.weapon_id;
    .element_size = Html.element_size (260, 44);
    .id = "shooter.fire";
    .label = Text.append "Fire " Project.weapon_id;
    .order = 10;
    .pressed = False;
    .selected = False;
    .target = fire_target;
  } []
  return ()

let render_arena = fn (defeated_enemies, completed) => do:
  use Scene.PerspectiveCamera {
    .clear_color = Scene.color (6000, 8000, 14000);
    .position = Scene.vec3 (0, 4000000, 8000000);
    .target = Scene.vec3 (0, 1000000, 0);
    .vertical_fov_microradians = 720000;
  } []
  use Scene.Environment {
    .ambient_light = Scene.color (25000, 35000, 60000);
    .bloom_intensity = 280000;
    .exposure_ev100 = -100000;
    .fog_color = Scene.color (8000, 12000, 24000);
    .fog_density = 12000;
  } []
  use Scene.DirectionalLight {
    .color = Scene.color (1000000, 780000, 560000);
    .direction = Scene.vec3 (-350000, -1000000, -220000);
    .intensity = 1300000;
  } []
  use Scene.Object {
    .id = 1;
    .material = Scene.material {
      .color = Scene.color (130000, 145000, 170000);
    };
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (0, -300000, 0),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (12000000, 600000, 7000000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 10;
    .material = Scene.material {
      .color = Scene.color (180000, 620000, 1000000);
      .emissive = 100000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (0, 900000, 600000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (900000, 1800000, 900000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 11;
    .material = Scene.material {
      .color = Scene.color (400000, 340000, 260000);
    };
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (-2400000, 550000, 300000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (1800000, 1100000, 800000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 12;
    .material = Scene.material {
      .color = Scene.color (950000, 180000, 110000);
      .emissive = 140000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (1900000, 1050000, -600000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (1100000, 2100000, 1100000)
    );
    .visible = defeated_enemies == 0;
  } []
  use Scene.Object {
    .id = 13;
    .material = Scene.material {
      .color = Scene.color (980000, 540000, 100000);
      .emissive = 200000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (-1900000, 1050000, -600000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (1100000, 2100000, 1100000)
    );
    .visible = Project.enemy_count == 2 && defeated_enemies == 1;
  } []
  use Scene.Object {
    .id = 14;
    .material = Scene.material {
      .color = Scene.color (260000, 1000000, 440000);
      .emissive = 3800000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (0, 1900000, -1400000),
      Scene.vec3 (0, 0, 0),
      Scene.uniform_scale 500000
    );
    .visible = completed == 1;
  } []
  return ()

use phase <- Phase.current ()
use ammunition <- Ammunition.get_or (combat_entity, Project.magazine_capacity)
use enemy_health <- EnemyHealth.get_or (combat_entity, enemy_maximum_health)
use defeated_enemies <- DefeatedEnemies.get_or (combat_entity, 0)
use completed <- Completed.get_or (combat_entity, 0)

if phase == schema_phase:
  use register_combat_world ()
  use seed_combat_state ()

if phase == start_phase:
  use State.commit 0

if phase == update_phase:
  use event <- Events.next ()
  if event.kind == activate_event && event.target == fire_target && completed == 0 && ammunition > 0:
    let next_ammunition = ammunition - 1
    let next_enemy_health = enemy_health - Project.weapon_damage
    use Ammunition.set (combat_entity, next_ammunition)
    if next_enemy_health > 0:
      use EnemyHealth.set (combat_entity, next_enemy_health)
      use HostEffect.play_audio {
        .cue = Text.append "shooter.fire." Project.weapon_id;
        .id = "shooter.fire";
      }
    if next_enemy_health <= 0:
      let next_defeated_enemies = defeated_enemies + 1
      use DefeatedEnemies.set (combat_entity, next_defeated_enemies)
      if next_defeated_enemies < Project.enemy_count:
        use EnemyHealth.set (combat_entity, enemy_maximum_health)
        use HostEffect.play_audio {
          .cue = Text.append "shooter.reinforcement." Project.second_enemy_id;
          .id = "shooter.reinforcement-arrived";
        }
      if next_defeated_enemies == Project.enemy_count:
        use EnemyHealth.set (combat_entity, 0)
        use Completed.set (combat_entity, 1)
        use HostEffect.play_audio {
          .cue = Text.append "shooter.complete." Project.objective_id;
          .id = "shooter.arena-cleared";
        }
  use State.commit (state + 1)

if phase == describe_phase:
  use describe_text (
    "shooter.objective",
    Project.objective_id,
    Text.append "Clear encounter " Project.encounter_id,
    1,
    24
  )
  if completed == 0:
    let enemy_id = active_enemy_id defeated_enemies
    use Html.Status {
      .done = False;
      .label = Project.arena_label;
      .value = Text.append
        (Text.append
          (Text.append enemy_id " health ")
          (Text.of_int enemy_health))
        (Text.append " · rounds " (Text.of_int ammunition));
    } []
    use Html.Progress {
      .attachment = Html.viewport_attachment (
        Html.top_left,
        Html.element_size (24, 68)
      );
      .description = Text.append enemy_id " combat health";
      .element_size = Html.element_size (360, 12);
      .id = "shooter.enemy-health";
      .label = enemy_id;
      .maximum = enemy_maximum_health;
      .order = 2;
      .value = enemy_health;
    } []
    use Html.Progress {
      .attachment = Html.viewport_attachment (
        Html.top_left,
        Html.element_size (24, 94)
      );
      .description = Text.append Project.weapon_id " authored ammunition";
      .element_size = Html.element_size (360, 12);
      .id = "shooter.ammunition";
      .label = Project.weapon_id;
      .maximum = Project.magazine_capacity;
      .order = 3;
      .value = ammunition;
    } []
    use describe_fire_button ()
  if completed == 1:
    use Html.Status {
      .done = True;
      .label = Project.project_name;
      .value = Text.append
        (Text.append "Arena cleared · rounds remaining " (Text.of_int ammunition))
        (Text.append " · enemies defeated " (Text.of_int defeated_enemies));
    } []
    use describe_text (
      "shooter.outcome",
      "Arena clear",
      Text.append Project.objective_id " completed",
      20,
      68
    )

if phase == render_phase:
  use render_arena (defeated_enemies, completed)

return ()
