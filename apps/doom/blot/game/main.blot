open {} = (@import "../prelude.blot") ();
open {} = (@import "../../../../packages/blot/engine.blot") ();
const Html = (@import "../../../../packages/blot/html_canvas.blot") ();
const Scene = (@import "../../../../packages/blot/scene.blot") ();
open {} = Scene;
const CanvasButton = Html.Button;
const CanvasText = Html.Text;
const CanvasAction = Html.Action;
const CanvasStatus = Html.Status;
const element_size = Html.element_size;
const viewport_attachment = Html.viewport_attachment;
const center = Html.center;
const style = Html.style;

const menu_up_event = 10;
const menu_down_event = 11;
const menu_activate_event = 12;
const first_item = 0;
const last_item = 2;

let update = fn selected => do
  event <- Events.next ();
  in case event.kind of
    #(focus_event) => event.target,
    #(activate_event) => event.target,
    #(menu_up_event) => if selected == first_item then last_item else selected - 1 end,
    #(menu_down_event) => if selected == last_item then first_item else selected + 1 end,
    #(menu_activate_event) => selected,
    _ => selected
  end
end;

const item_style = fn selected => style (
  "transparent",
  "transparent",
  0,
  0,
  if selected then "#f0c77b" else "#c79a5d" end,
  if selected then 24 else 22 end,
  900
);

let describe = fn selected => do
  _ <- CanvasText {
    .attachment = viewport_attachment (center, element_size (-180, -64));
    .description = "Selected menu item cursor";
    .element_size = element_size (36, 48);
    .id = "menu-cursor";
    .label = ">";
    .order = 9;
    .style = style ("transparent", "transparent", 0, 0, "#b52b1f", 32, 900);
  } (fn () => ());
  _ <- CanvasButton {
    .attachment = viewport_attachment (center, element_size (0, -64));
    .description = "Start a new game";
    .element_size = element_size (300, 48);
    .id = "new-mission";
    .label = "NEW GAME";
    .order = 10;
    .pressed = selected == 0;
    .selected = selected == 0;
    .style = item_style (selected == 0);
    .target = 0;
  } (fn () => ());
  _ <- CanvasButton {
    .attachment = viewport_attachment (center, element_size (0, 0));
    .description = "Open options";
    .element_size = element_size (300, 48);
    .id = "options";
    .label = "OPTIONS";
    .order = 11;
    .pressed = selected == 1;
    .selected = selected == 1;
    .style = item_style (selected == 1);
    .target = 1;
  } (fn () => ());
  _ <- CanvasButton {
    .attachment = viewport_attachment (center, element_size (0, 64));
    .description = "Exit the menu";
    .element_size = element_size (300, 48);
    .id = "quit";
    .label = "QUIT GAME";
    .order = 12;
    .pressed = selected == 2;
    .selected = selected == 2;
    .style = item_style (selected == 2);
    .target = 2;
  } (fn () => ());
  _ <- CanvasAction {
    .id = "doom-menu-up";
    .kind = menu_up_event;
    .label = "Select previous menu item";
    .target = 0;
    .value = 0;
  } (fn () => ());
  _ <- CanvasAction {
    .id = "doom-menu-down";
    .kind = menu_down_event;
    .label = "Select next menu item";
    .target = 0;
    .value = 0;
  } (fn () => ());
  _ <- CanvasAction {
    .id = "doom-menu-activate";
    .kind = menu_activate_event;
    .label = "Activate selected menu item";
    .target = 0;
    .value = 0;
  } (fn () => ());
  _ <- CanvasStatus {
    .done = False;
    .label = "";
    .value = "";
  } (fn () => ());
  in ()
end;

let render = fn _state => do
  _ <- Render.projection orthographic;
  _ <- Render.zoom 1000000;
  _ <- Render.directional_light {
    .color_blue = 1000000;
    .color_green = 1000000;
    .color_red = 1000000;
    .direction_x = 0;
    .direction_y = 0;
    .direction_z = -1000000;
    .intensity = 0;
  };
  in ()
end;

phase <- Phase.current ();
state <- State.current ();
_ <- case phase of
  #(start_phase) => State.commit 0,
  #(frame_phase) => State.commit (update state),
  #(describe_phase) => describe state,
  #(render_phase) => render state,
  _ => ()
end;

return ();