{
  "name": "@ink/doom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "deno run --config ../../deno.json --allow-read --allow-write --allow-run build.ts && node ./node_modules/vite/bin/vite.js build",
    "build:game": "deno run --config ../../deno.json --allow-read --allow-write --allow-run build.ts",
    "check": "deno check --config ../../deno.json build.ts development.ts vite.config.ts src/*.ts src/*.tsx",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "test": "deno run --config ../../deno.json --allow-read --allow-write --allow-run build.ts && deno test --config ../../deno.json --allow-read src/*_test.ts"
  },
  "dependencies": {
    "@ink/blot": "workspace:*",
    "@ink/development": "workspace:*",
    "@ink/engine": "workspace:*",
    "@mewhhaha/typeclasses": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
