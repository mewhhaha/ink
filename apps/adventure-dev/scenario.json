{
  "version": 2,
  "role": "editor_game",
  "editor": "@ink/adventure-editor",
  "commands": {
    "headless": "pnpm --filter @ink/adventure-dev scenario:headless",
    "browser": "pnpm --filter @ink/adventure-dev scenario:browser"
  },
  "edit": "bind the authored oak gate to the unlock-exit interaction and rebuild",
  "expected_outcome": "take the brass key, unlock the oak gate, and enter the exit room with matching replay state",
  "proofs": [
    {
      "package": "@ink/animation",
      "exports": ["./clip.ts", "./pose.ts", "./skeleton.ts"],
      "assertions": [
        "headless:oak-gate-animation-follows-blot-state",
        "browser:oak-gate-animation-changes-rendered-transform"
      ]
    },
    {
      "package": "@ink/audio",
      "exports": [
        "./device.ts",
        "./graph.ts",
        "./mixer.ts",
        "./model.ts",
        "./spatial.ts"
      ],
      "assertions": [
        "headless:spatial-audio-follows-blot-presentation",
        "browser:spatial-audio-submits-authored-cues"
      ]
    },
    {
      "package": "@ink/adventure-editor",
      "exports": ["./document.ts", "./layout.ts"],
      "assertions": [
        "headless:gate-unlocks-and-replay-matches",
        "browser:edited-oak-gate-blocks-and-opens-route"
      ]
    },
    {
      "package": "@ink/assets",
      "exports": [
        "./build.ts",
        "./bundle.ts",
        "./cache.ts",
        "./digest.ts",
        "./identity.ts",
        "./load.ts",
        "./manifest.ts",
        "./mesh.ts",
        "./prepared_scene.ts"
      ],
      "assertions": ["browser:prepared-assets-eight-verified-digests"]
    },
    {
      "package": "@ink/blot",
      "exports": [
        "./abi.blot",
        "./adapter.ts",
        "./build.ts",
        "./data.blot",
        "./data_asset.ts",
        "./engine.blot",
        "./math.blot",
        "./protocol.ts",
        "./runtime.ts"
      ],
      "assertions": ["headless:gate-unlocks-and-replay-matches"]
    },
    {
      "package": "@ink/camera",
      "exports": ["./model.ts", "./view.ts"],
      "assertions": ["browser:gate-room-raster-path-parity"]
    },
    {
      "package": "@ink/development",
      "exports": ["./browser_routes.ts"],
      "assertions": ["browser:gate-room-raster-path-parity"]
    },
    {
      "package": "@ink/editor-ui",
      "exports": ["./controls.tsx", "./layout.tsx", "./styles.css"],
      "assertions": ["browser:editor-controls-keyboard-and-layout"]
    },
    {
      "package": "@ink/geometry",
      "exports": [
        "./frustum.ts",
        "./mesh.ts",
        "./shapes.ts",
        "./static_bvh.ts"
      ],
      "assertions": ["browser:gate-room-raster-path-parity"]
    },
    {
      "package": "@ink/lighting",
      "exports": ["./identity.ts", "./light.ts"],
      "assertions": ["browser:gate-room-raster-path-parity"]
    },
    {
      "package": "@ink/math",
      "exports": [
        "./matrix.ts",
        "./projection.ts",
        "./quaternion.ts",
        "./scalar.ts",
        "./transform.ts",
        "./vector.ts"
      ],
      "assertions": ["browser:gate-room-raster-path-parity"]
    },
    {
      "package": "@ink/materials",
      "exports": [
        "./canonical.ts",
        "./color.ts",
        "./identity.ts",
        "./texture.ts"
      ],
      "assertions": ["browser:gate-room-raster-path-parity"]
    },
    {
      "package": "@ink/navigation",
      "exports": [
        "./identity.ts",
        "./navmesh.ts",
        "./profile.ts",
        "./query.ts",
        "./tile.ts"
      ],
      "assertions": [
        "headless:canonical-route-blocks-before-gate-opens",
        "browser:canonical-route-opens-after-gate",
        "browser:edited-oak-gate-blocks-and-opens-route"
      ]
    },
    {
      "package": "@ink/physics",
      "exports": [
        "./collision.ts",
        "./identity.ts",
        "./shapes.ts",
        "./world.ts"
      ],
      "assertions": [
        "headless:canonical-route-blocks-before-gate-opens",
        "browser:canonical-route-opens-after-gate",
        "browser:edited-oak-gate-blocks-and-opens-route"
      ]
    },
    {
      "package": "@ink/ray-tracing",
      "exports": [
        "./accumulation.ts",
        "./identity.ts",
        "./scene.ts",
        "./trace.ts",
        "./wgsl.ts"
      ],
      "assertions": ["browser:gate-room-raster-path-parity"]
    },
    {
      "package": "@ink/rendering",
      "exports": ["./renderer.ts"],
      "assertions": ["browser:gate-room-raster-path-parity"]
    },
    {
      "package": "@ink/runtime",
      "exports": ["./jsonl.ts", "./session.ts"],
      "assertions": [
        "headless:gate-unlocks-and-replay-matches",
        "headless:jsonl-executable-observes-and-closes"
      ]
    },
    {
      "package": "@ink/scene",
      "exports": ["./hierarchy.ts", "./identity.ts"],
      "assertions": ["browser:gate-room-raster-path-parity"]
    },
    {
      "package": "@ink/shaders",
      "exports": [
        "./compose.ts",
        "./diagnostics.ts",
        "./identity.ts",
        "./module.ts",
        "./pbr.ts"
      ],
      "assertions": ["browser:gate-room-raster-path-parity"]
    }
  ]
}
