{
  "name": "@ink/adventure-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config ink.ts",
    "build:game": "deno run --config ../../deno.json --allow-env=INK_ADVENTURE_PROJECT_FILE --allow-read --allow-write --allow-run=deno ink.ts",
    "check": "deno check --config ../../deno.json ink.ts src/*.ts src/headless/*.ts src/editor/*.ts src/editor/*.tsx src/browser/*.ts src/browser/*.tsx && node --check src/browser/development_test.mjs && node --check src/browser/gate_room_test.mjs",
    "dev": "vite --config ink.ts",
    "headless": "pnpm build:game && deno run --config ../../deno.json --allow-read src/headless/main.ts",
    "scenario:browser": "pnpm test:browser",
    "scenario:headless": "pnpm build:game && deno test --config ../../deno.json --allow-env=INK_SCENARIO_REPORT --allow-read --allow-write --allow-run=deno src/headless/session_test.ts --filter 'the authored key unlocks the oak gate and replay reaches the same exit state'",
    "test": "pnpm build:game && deno test --config ../../deno.json --allow-env --allow-read --allow-write --allow-run=deno src/*_test.ts src/headless/*_test.ts src/editor/*_test.ts src/browser/*_test.ts src/browser/*_test.tsx",
    "test:browser": "pnpm build:game && node --test --test-concurrency=1 src/browser/development_test.mjs src/browser/gate_room_test.mjs"
  },
  "dependencies": {
    "@comp0/react": "catalog:",
    "@heroicons/react": "catalog:",
    "@ink/assets": "workspace:*",
    "@ink/audio": "workspace:*",
    "@ink/adventure-editor": "workspace:*",
    "@ink/animation": "workspace:*",
    "@ink/blot": "workspace:*",
    "@ink/development": "workspace:*",
    "@ink/editor-ui": "workspace:*",
    "@ink/input": "workspace:*",
    "@ink/math": "workspace:*",
    "@ink/navigation": "workspace:*",
    "@ink/observability": "workspace:*",
    "@ink/physics": "workspace:*",
    "@ink/rendering": "workspace:*",
    "@ink/runtime": "workspace:*",
    "@ink/ui": "workspace:*",
    "@ink/vite": "workspace:*",
    "@mewhhaha/typeclasses": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "playwright": "1.61.1",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  },
  "ink": {
    "kind": "application"
  }
}
