open import "../prelude.blot"
open import "@ink/blot/data.blot"
open import "@ink/blot/engine.blot"

const M = import "@ink/blot/math.blot"
const ProjectProvider = import "../generated/project.blot"
const Abi = import "@ink/blot/abi.blot"
const HostEffect = Abi.HostEffect
const Render = Abi.Render
const Resource = Abi.Resource
const SceneTree = Abi.SceneTree
const Ui = Abi.Ui
const Scene = import "@ink/blot/scene.blot"

const level_asset = 0
const maximum_brushes = 48
const brush_field_count = 9
const player_start_cell = maximum_brushes * brush_field_count
const player_x_cell = player_start_cell + 2
const player_z_cell = player_start_cell + 3
const forward_cell = player_start_cell + 4
const backward_cell = player_start_cell + 5
const left_cell = player_start_cell + 6
const right_cell = player_start_cell + 7
const orbit_cell = player_start_cell + 8
const has_key_cell = player_start_cell + 9
const gate_unlocked_cell = player_start_cell + 10
const escaped_cell = player_start_cell + 11
const level_edit_event = 40
const forward_start_event = 10
const forward_stop_event = 11
const backward_start_event = 12
const backward_stop_event = 13
const left_start_event = 14
const left_stop_event = 15
const right_start_event = 16
const right_stop_event = 17
const orbit_left_event = 18
const orbit_right_event = 19
const restart_event = 20
const take_key_event = 30
const unlock_gate_event = 31
const enter_exit_event = 32
const unit = 1000000
const half_unit = 500000
const quarter_turn = 1570796
const movement_speed = 2800000
const maximum_delta_us = 50000
const root = 1

use phase <- Phase.current ()
use state <- State.current ()
let Project = ProjectProvider.project state
use saved_start_x2 <- DataAsset.get {
  .asset = level_asset;
  .field = brush_field_count;
  .index = 0;
}
use saved_start_z2 <- DataAsset.get {
  .asset = level_asset;
  .field = brush_field_count;
  .index = 1;
}
use player_x <- Cells.get player_x_cell
use player_z <- Cells.get player_z_cell
use moving_forward <- Cells.get forward_cell
use moving_backward <- Cells.get backward_cell
use moving_left <- Cells.get left_cell
use moving_right <- Cells.get right_cell
use orbit <- Cells.get orbit_cell
use has_key <- Cells.get has_key_cell
use gate_unlocked <- Cells.get gate_unlocked_cell
use escaped <- Cells.get escaped_cell

let reset_player = fn () => do:
  use Cells.put { .index = player_x_cell; .value = saved_start_x2 * half_unit; }
  use Cells.put { .index = player_z_cell; .value = saved_start_z2 * half_unit; }
  use Cells.put { .index = forward_cell; .value = 0; }
  use Cells.put { .index = backward_cell; .value = 0; }
  use Cells.put { .index = left_cell; .value = 0; }
  use Cells.put { .index = right_cell; .value = 0; }
  return ()

let reset_orbit = fn () => do:
  use Cells.put { .index = orbit_cell; .value = -320000; }
  return ()

let reset_adventure = fn () => do:
  use Cells.put { .index = has_key_cell; .value = 0; }
  use Cells.put { .index = gate_unlocked_cell; .value = 0; }
  use Cells.put { .index = escaped_cell; .value = 0; }
  return ()

let apply_input = fn event => do:
  if event.kind == forward_start_event:
    use Cells.put { .index = forward_cell; .value = 1; }
  if event.kind == forward_stop_event:
    use Cells.put { .index = forward_cell; .value = 0; }
  if event.kind == backward_start_event:
    use Cells.put { .index = backward_cell; .value = 1; }
  if event.kind == backward_stop_event:
    use Cells.put { .index = backward_cell; .value = 0; }
  if event.kind == left_start_event:
    use Cells.put { .index = left_cell; .value = 1; }
  if event.kind == left_stop_event:
    use Cells.put { .index = left_cell; .value = 0; }
  if event.kind == right_start_event:
    use Cells.put { .index = right_cell; .value = 1; }
  if event.kind == right_stop_event:
    use Cells.put { .index = right_cell; .value = 0; }
  if event.kind == orbit_left_event:
    use Cells.put { .index = orbit_cell; .value = orbit - 180000; }
  if event.kind == orbit_right_event:
    use Cells.put { .index = orbit_cell; .value = orbit + 180000; }
  if event.kind == restart_event:
    use reset_player ()
    use reset_orbit ()
    use reset_adventure ()
  if event.kind == take_key_event:
    use Cells.put { .index = has_key_cell; .value = 1; }
  if event.kind == unlock_gate_event:
    if has_key == 1 && Project.closed_gate_blocks_route == 1:
      use Cells.put { .index = gate_unlocked_cell; .value = 1; }
  if event.kind == enter_exit_event:
    if gate_unlocked == 1 && Project.open_gate_route_available == 1:
      use Cells.put { .index = player_x_cell; .value = Project.route_goal_x; }
      use Cells.put { .index = player_z_cell; .value = Project.route_goal_z; }
      use Cells.put { .index = escaped_cell; .value = 1; }
  return ()

let simulate_player = fn () => do:
  use raw_delta_us <- Time.delta_us ()
  let delta_us = M.minimum (raw_delta_us, maximum_delta_us)
  let x_direction = moving_right - moving_left
  let z_direction = moving_backward - moving_forward
  let distance = movement_speed * delta_us / unit
  let maximum_player_z = case gate_unlocked == 1 of
    #True => Project.route_goal_z
    #False => Project.closed_gate_stop_z
  use Cells.put {
    .index = player_x_cell;
    .value = M.clamp (player_x + x_direction * distance, -5500000, 5500000);
  }
  use Cells.put {
    .index = player_z_cell;
    .value = M.clamp (player_z + z_direction * distance, -3500000, maximum_player_z);
  }
  return ()

if phase == start_phase:
  for field in Iter.range (0, brush_field_count + 1):
    use DataAsset.copy_to_cells {
      .asset = level_asset;
      .field = field;
      .first_cell = field * maximum_brushes;
    }
  use reset_player ()
  use reset_orbit ()
  use reset_adventure ()
  use State.commit 0

if phase == update_phase:
  use event <- Events.next ()
  if event.kind == level_edit_event:
    if event.target >= 0 && event.target < player_start_cell + 2:
      use Cells.put { .index = event.target; .value = event.value - 128; }
    if event.target == player_start_cell:
      use Cells.put {
        .index = player_x_cell;
        .value = (event.value - 128) * half_unit;
      }
    if event.target == player_start_cell + 1:
      use Cells.put {
        .index = player_z_cell;
        .value = (event.value - 128) * half_unit;
      }
  if event.kind == take_key_event && has_key == 0:
    use HostEffect.play_audio {
      .cue = "adventure.key";
      .id = "adventure.key-acquired";
    }
  if event.kind == unlock_gate_event && has_key == 1 && gate_unlocked == 0 && Project.closed_gate_blocks_route == 1:
    use HostEffect.play_audio {
      .cue = "adventure.gate";
      .id = "adventure.gate-unlocked";
    }
  if event.kind == enter_exit_event && gate_unlocked == 1 && escaped == 0 && Project.open_gate_route_available == 1:
    use HostEffect.play_audio {
      .cue = "adventure.exit";
      .id = "adventure.exit-reached";
    }
  use apply_input event
  if event.kind == elapsed_event:
    use simulate_player ()
  use State.commit state

if phase == describe_phase:
  if has_key == 0:
    use Ui.status {
      .done = False;
      .label = Project.level_name;
      .value = Project.take_key_label;
    }
    use Ui.action { .id = "take-brass-key"; .kind = take_key_event; .label = Project.take_key_label; .target = 0; .value = 0; }
  if has_key == 1 && gate_unlocked == 0:
    use Ui.status {
      .done = False;
      .label = "Brass key acquired";
      .value = Project.unlock_gate_label;
    }
    use Ui.action { .id = "unlock-oak-gate"; .kind = unlock_gate_event; .label = Project.unlock_gate_label; .target = 0; .value = 0; }
  if gate_unlocked == 1 && escaped == 0 && Project.open_gate_route_available == 1:
    use Ui.status {
      .done = False;
      .label = "Oak gate unlocked";
      .value = "Enter the exit room";
    }
    use Ui.action { .id = "enter-exit-room"; .kind = enter_exit_event; .label = "Enter the exit room"; .target = 0; .value = 0; }
  if escaped == 1:
    use Ui.status {
      .done = True;
      .label = Project.project_title;
      .value = "Exit room reached";
    }
  use Ui.action { .id = "forward-start"; .kind = forward_start_event; .label = "Move forward"; .target = 0; .value = 0; }
  use Ui.action { .id = "forward-stop"; .kind = forward_stop_event; .label = "Stop moving forward"; .target = 0; .value = 0; }
  use Ui.action { .id = "backward-start"; .kind = backward_start_event; .label = "Move backward"; .target = 0; .value = 0; }
  use Ui.action { .id = "backward-stop"; .kind = backward_stop_event; .label = "Stop moving backward"; .target = 0; .value = 0; }
  use Ui.action { .id = "left-start"; .kind = left_start_event; .label = "Move left"; .target = 0; .value = 0; }
  use Ui.action { .id = "left-stop"; .kind = left_stop_event; .label = "Stop moving left"; .target = 0; .value = 0; }
  use Ui.action { .id = "right-start"; .kind = right_start_event; .label = "Move right"; .target = 0; .value = 0; }
  use Ui.action { .id = "right-stop"; .kind = right_stop_event; .label = "Stop moving right"; .target = 0; .value = 0; }
  use Ui.action { .id = "orbit-left"; .kind = orbit_left_event; .label = "Orbit left"; .target = 0; .value = 0; }
  use Ui.action { .id = "orbit-right"; .kind = orbit_right_event; .label = "Orbit right"; .target = 0; .value = 0; }
  use Ui.action { .id = "restart"; .kind = restart_event; .label = "Restart"; .target = 0; .value = 0; }

if phase == render_phase:
  use Scene.PerspectiveCamera {
    .clear_color = Scene.color (12000, 18000, 32000);
    .position = Scene.vec3 (0, -195878, 6986532);
    .target = Scene.vec3 (-800000, -103599, 4103568);
    .vertical_fov_microradians = 1240499;
  } []
  use Scene.Environment {
    .ambient_light = Scene.color (280000, 240000, 200000);
    .bloom_intensity = 80000;
    .exposure_ev100 = 750000;
    .fog_color = Scene.color (12000, 18000, 32000);
    .fog_density = 3000;
  } []
  use Render.directional_light {
    .color_blue = 620000;
    .color_green = 820000;
    .color_red = 1000000;
    .direction_x = -420000;
    .direction_y = -860000;
    .direction_z = -280000;
    .intensity = 1350000;
  }
  use Resource.mesh { .asset = "adventure/mesh/cube"; .id = 0; }
  use Resource.mesh { .asset = "adventure/mesh/oak-gate"; .id = 1; }
  use Resource.mesh { .asset = "adventure/mesh/stone-stairs"; .id = 2; }
  use Resource.texture { .asset = "adventure/texture/flagstone-floor"; .id = 0; }
  use Resource.texture { .asset = "adventure/texture/limestone-wall"; .id = 1; }
  use Resource.texture { .asset = "adventure/texture/oak-door"; .id = 2; }
  use root_parent <- SceneTree.enter root
  use Render.node {
    .id = root;
    .parent = root_parent;
    .rotation_x_microradians = 0;
    .rotation_y_microradians = orbit;
    .rotation_z_microradians = 0;
    .scale_x = 560000;
    .scale_y = 560000;
    .scale_z = 560000;
    .visible = True;
    .x = 0;
    .y = 0;
    .z = 0;
  }
  for slot in Iter.range (0, maximum_brushes):
    use kind <- Cells.get slot
    if kind >= 0:
      use center_x2 <- Cells.get (maximum_brushes + slot)
      use elevation <- Cells.get (maximum_brushes * 2 + slot)
      use center_z2 <- Cells.get (maximum_brushes * 3 + slot)
      use width <- Cells.get (maximum_brushes * 4 + slot)
      use height <- Cells.get (maximum_brushes * 5 + slot)
      use depth <- Cells.get (maximum_brushes * 6 + slot)
      use yaw_quarters <- Cells.get (maximum_brushes * 7 + slot)
      use material <- Cells.get (maximum_brushes * 8 + slot)
      let object_id = 100 + slot
      let gate_projection = kind == 1
      let visible = case slot == Project.gate_slot of
        #True => gate_unlocked == 0
        #False => True
      let texture_scale = case gate_projection of
        #True => 227273
        #False => 700000
      let texture_offset_x = case gate_projection of
        #True => 386364
        #False => 0
      let texture_offset_y = case gate_projection of
        #True => 886364
        #False => 0
      let surface_mode = case gate_projection of
        #True => 2
        #False => 0
      use Render.material {
        .blend_edges = 0;
        .color_blue = 1000000;
        .color_green = 1000000;
        .color_red = 1000000;
        .id = object_id;
        .secondary_texture = -1;
        .surface_mode = surface_mode;
        .texture = material;
        .texture_offset_x = texture_offset_x;
        .texture_offset_y = texture_offset_y;
        .texture_scale_x = texture_scale;
        .texture_scale_y = texture_scale;
        .path_connections = 0;
        .variation_seed = slot * 7919;
      }
      if kind == 0:
        use Render.mesh { .id = object_id; .mesh = 0; }
        use Render.object {
          .emissive = 0;
          .id = object_id;
          .parent = root;
          .rotation_x_microradians = 0;
          .rotation_y_microradians = yaw_quarters * quarter_turn;
          .rotation_z_microradians = 0;
          .scale_x = width * unit;
          .scale_y = height * unit;
          .scale_z = depth * unit;
          .visible = visible;
          .x = center_x2 * half_unit;
          .y = elevation * unit + height * half_unit;
          .z = center_z2 * half_unit;
        }
      if kind == 1:
        use Render.mesh { .id = object_id; .mesh = 1; }
        use Render.object {
          .emissive = 0;
          .id = object_id;
          .parent = root;
          .rotation_x_microradians = 0;
          .rotation_y_microradians = yaw_quarters * quarter_turn;
          .rotation_z_microradians = 0;
          .scale_x = width * 227273;
          .scale_y = height * 227273;
          .scale_z = depth * 714286;
          .visible = visible;
          .x = center_x2 * half_unit;
          .y = elevation * unit;
          .z = center_z2 * half_unit;
        }
      if kind == 2:
        use Render.mesh { .id = object_id; .mesh = 2; }
        use Render.object {
          .emissive = 0;
          .id = object_id;
          .parent = root;
          .rotation_x_microradians = 0;
          .rotation_y_microradians = yaw_quarters * quarter_turn;
          .rotation_z_microradians = 0;
          .scale_x = width * 227273;
          .scale_y = height * 116959;
          .scale_z = depth * 119048;
          .visible = visible;
          .x = center_x2 * half_unit;
          .y = elevation * unit;
          .z = center_z2 * half_unit;
        }
  use Render.material {
    .blend_edges = 0;
    .color_blue = 120000;
    .color_green = 720000;
    .color_red = 980000;
    .id = 11;
    .secondary_texture = -1;
    .surface_mode = 0;
    .texture = -1;
    .texture_offset_x = 0;
    .texture_offset_y = 0;
    .texture_scale_x = unit;
    .texture_scale_y = unit;
    .path_connections = 0;
    .variation_seed = 0;
  }
  use Render.mesh { .id = 11; .mesh = 0; }
  use Render.object {
    .emissive = 260000;
    .id = 11;
    .parent = root;
    .rotation_x_microradians = 0;
    .rotation_y_microradians = 0;
    .rotation_z_microradians = 0;
    .scale_x = 180000;
    .scale_y = 80000;
    .scale_z = 420000;
    .visible = has_key == 0;
    .x = Project.key_x;
    .y = 1150000;
    .z = Project.key_z;
  }
  use Render.material {
    .blend_edges = 0;
    .color_blue = 980000;
    .color_green = 760000;
    .color_red = 180000;
    .id = 10;
    .secondary_texture = -1;
    .surface_mode = 0;
    .texture = -1;
    .texture_offset_x = 0;
    .texture_offset_y = 0;
    .texture_scale_x = unit;
    .texture_scale_y = unit;
    .path_connections = 0;
    .variation_seed = 0;
  }
  use Render.mesh { .id = 10; .mesh = 0; }
  use Render.object {
    .emissive = 180000;
    .id = 10;
    .parent = root;
    .rotation_x_microradians = 0;
    .rotation_y_microradians = 0;
    .rotation_z_microradians = 0;
    .scale_x = 550000;
    .scale_y = 1000000;
    .scale_z = 550000;
    .visible = True;
    .x = player_x;
    .y = 500000;
    .z = player_z;
  }
  use SceneTree.leave root

return ()
