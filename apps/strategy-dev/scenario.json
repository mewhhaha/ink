{
  "version": 2,
  "role": "editor_game",
  "editor": "@ink/strategy-editor",
  "commands": {
    "headless": "pnpm --filter @ink/strategy-dev scenario:headless",
    "browser": "pnpm --filter @ink/strategy-dev scenario:browser"
  },
  "edit": "add a player scout barracks and an ordered four-point route, then rebuild the generated terrain, vegetation, scatter, and Blot provider",
  "expected_outcome": "reject an early attack, train three scouts, traverse every authored route point in order, and destroy the opposing headquarters with replay and browser presentation parity",
  "proofs": [
    {
      "package": "@ink/assets",
      "exports": ["./identity.ts"],
      "assertions": ["browser:authored-audio-cues-reach-host"]
    },
    {
      "package": "@ink/audio",
      "exports": ["./device.ts", "./graph.ts", "./mixer.ts", "./model.ts"],
      "assertions": ["browser:authored-audio-cues-reach-host"]
    },
    {
      "package": "@ink/authoring",
      "exports": ["./catalog.ts", "./diagnostics.ts", "./identity.ts"],
      "assertions": [
        "headless:edited-barracks-route-drives-ordered-victory-and-replay"
      ]
    },
    {
      "package": "@ink/blot",
      "exports": [
        "./abi.blot",
        "./adapter.ts",
        "./build.ts",
        "./engine.blot",
        "./html_canvas.blot",
        "./protocol.ts",
        "./scene.blot"
      ],
      "assertions": [
        "headless:edited-barracks-route-drives-ordered-victory-and-replay",
        "browser:editor-barracks-route-retained-activation-and-rollback",
        "browser:early-attack-rejected",
        "browser:trained-scouts-traverse-route-and-destroy-headquarters",
        "browser:headless-replay-presentation-parity"
      ]
    },
    {
      "package": "@ink/development",
      "exports": ["./debugger.ts"],
      "assertions": [
        "headless:edited-barracks-route-drives-ordered-victory-and-replay",
        "browser:nonfallback-webgpu-pixels-pick-and-redaction"
      ]
    },
    {
      "package": "@ink/math",
      "exports": ["./vector.ts"],
      "assertions": [
        "headless:edited-barracks-route-drives-ordered-victory-and-replay",
        "browser:nonfallback-webgpu-pixels-pick-and-redaction"
      ]
    },
    {
      "package": "@ink/noise",
      "exports": ["./domain.ts", "./hash.ts", "./value.ts"],
      "assertions": [
        "headless:edited-barracks-route-drives-ordered-victory-and-replay",
        "browser:trained-scouts-traverse-route-and-destroy-headquarters"
      ]
    },
    {
      "package": "@ink/observability",
      "exports": ["./observer.ts"],
      "assertions": [
        "headless:edited-barracks-route-drives-ordered-victory-and-replay",
        "browser:nonfallback-webgpu-pixels-pick-and-redaction"
      ]
    },
    {
      "package": "@ink/procedural",
      "exports": ["./identity.ts", "./recipe.ts", "./scatter.ts"],
      "assertions": [
        "headless:edited-barracks-route-drives-ordered-victory-and-replay",
        "browser:trained-scouts-traverse-route-and-destroy-headquarters"
      ]
    },
    {
      "package": "@ink/rendering",
      "exports": ["./renderer.ts"],
      "assertions": [
        "browser:nonfallback-webgpu-pixels-pick-and-redaction",
        "browser:headless-replay-presentation-parity"
      ]
    },
    {
      "package": "@ink/runtime",
      "exports": ["./session.ts"],
      "assertions": [
        "headless:edited-barracks-route-drives-ordered-victory-and-replay",
        "browser:headless-replay-presentation-parity"
      ]
    },
    {
      "package": "@ink/strategy-editor",
      "exports": [
        "./commands.ts",
        "./identity.ts",
        "./serialization.ts"
      ],
      "assertions": [
        "headless:edited-barracks-route-drives-ordered-victory-and-replay",
        "browser:editor-barracks-route-retained-activation-and-rollback"
      ]
    },
    {
      "package": "@ink/ui",
      "exports": ["./browser.ts", "./layout.ts"],
      "assertions": [
        "browser:trained-scouts-traverse-route-and-destroy-headquarters",
        "browser:headless-replay-presentation-parity"
      ]
    },
    {
      "package": "@ink/vite",
      "exports": [".", "./browser-module.ts", "./client.ts"],
      "assertions": [
        "browser:editor-barracks-route-retained-activation-and-rollback"
      ]
    },
    {
      "package": "@ink/world",
      "exports": ["./identity.ts", "./terrain.ts", "./vegetation.ts"],
      "assertions": [
        "headless:edited-barracks-route-drives-ordered-victory-and-replay",
        "browser:trained-scouts-traverse-route-and-destroy-headquarters"
      ]
    }
  ]
}
