open import "../prelude.blot"
open import "@ink/blot/engine.blot"

const ProjectProvider = import "../generated/project.blot"
const Abi = import "@ink/blot/abi.blot"
const HostEffect = Abi.HostEffect
const Html = import "@ink/blot/html_canvas.blot"
const Scene = import "@ink/blot/scene.blot"

const trained_cell = 0
const route_progress_cell = 1
const travel_seconds_cell = 2
const enemy_health_cell = 3
const completed_cell = 4
const result_cell = 5
const scout_x_cell = 6
const scout_z_cell = 7

const train_target = 10
const attack_target = 11
const restart_target = 12
const route_target_base = 100
const required_scouts = 3

const Project = ProjectProvider.project

let reset_game = fn runtime_state => do:
  use Cells.put { .index = trained_cell; .value = 0; }
  use Cells.put { .index = route_progress_cell; .value = 0; }
  use Cells.put { .index = travel_seconds_cell; .value = 0; }
  use Cells.put { .index = enemy_health_cell; .value = (Project runtime_state).enemy_health; }
  use Cells.put { .index = completed_cell; .value = 0; }
  use Cells.put { .index = result_cell; .value = 0; }
  use Cells.put { .index = scout_x_cell; .value = (Project runtime_state).barracks_x; }
  use Cells.put { .index = scout_z_cell; .value = (Project runtime_state).barracks_z; }
  return ()

let play_audio = fn (id, cue) => do:
  use HostEffect.play_audio { .id = id; .cue = cue; }
  return ()

let describe_text = fn (id, label, description, order, offset_y) => do:
  use Html.Text {
    .attachment = Html.viewport_attachment (
      Html.top_left,
      Html.element_size (24, offset_y)
    );
    .description = description;
    .element_size = Html.element_size (700, 30);
    .id = id;
    .label = label;
    .order = order;
  } []
  return ()

let describe_button = fn (id, label, description, order, offset_x, target) => do:
  use Html.Button {
    .attachment = Html.viewport_attachment (
      Html.bottom_left,
      Html.element_size (offset_x, 24)
    );
    .description = description;
    .element_size = Html.element_size (190, 46);
    .id = id;
    .label = label;
    .order = order;
    .pressed = False;
    .selected = False;
    .target = target;
  } []
  return ()

let solid_material = fn (color, emissive) => {
  .blend_edges = 0;
  .color = color;
  .emissive = emissive;
  .path_connections = Scene.no_connections;
  .secondary_texture = Scene.no_texture;
  .surface_mode = Scene.world_surface;
  .texture = Scene.no_texture;
  .texture_offset = Scene.vec3 (0, 0, 0);
  .texture_scale = Scene.vec3 (1000000, 1000000, 0);
  .variation_seed = 0;
}

let render_terrain = fn tile => do:
  let red = case tile.surface of
    1 => 260000
    _ => 190000
  let green = case tile.surface of
    1 => 410000
    _ => 320000
  let blue = case tile.surface of
    1 => 230000
    _ => 170000
  use Scene.Object {
    .id = tile.id;
    .material = solid_material (Scene.color (red, green, blue), 0);
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (tile.x, tile.y - 250000, tile.z),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (4000000, 500000, 4000000)
    );
    .visible = True;
  } []
  return ()

let render_vegetation = fn instance => do:
  use Scene.Object {
    .id = instance.id;
    .material = solid_material (Scene.color (160000, 560000, 240000), 0);
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (instance.x, instance.y + instance.scale, instance.z),
      Scene.vec3 (0, instance.id * 1000, 0),
      Scene.vec3 (
        instance.scale * 700000 / 1000000,
        instance.scale * 2000000 / 1000000,
        instance.scale * 700000 / 1000000
      )
    );
    .visible = True;
  } []
  return ()

let render_scatter = fn instance => do:
  use Scene.Object {
    .id = instance.id;
    .material = solid_material (Scene.color (480000, 430000, 350000), 0);
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (instance.x, instance.y + 350000, instance.z),
      Scene.vec3 (0, instance.id * 700, 0),
      Scene.uniform_scale (instance.scale * 700000 / 1000000)
    );
    .visible = True;
  } []
  return ()

let render_strategy = fn battle => do:
  use Scene.PerspectiveCamera {
    .clear_color = Scene.color (8000, 16000, 12000);
    .position = Scene.vec3 (12000000, 31000000, 37000000);
    .target = Scene.vec3 (12000000, 0, 8000000);
    .vertical_fov_microradians = 720000;
  } []
  use Scene.Environment {
    .ambient_light = Scene.color (25000, 55000, 35000);
    .bloom_intensity = 280000;
    .exposure_ev100 = 150000;
    .fog_color = Scene.color (20000, 45000, 32000);
    .fog_density = 4000;
  } []
  use Scene.DirectionalLight {
    .color = Scene.color (1000000, 860000, 680000);
    .direction = Scene.vec3 (-420000, -1000000, -280000);
    .intensity = 1450000;
  } []

  for tile in Iter.items (Project battle.runtime_state).terrain:
    use render_terrain tile
  for instance in Iter.items (Project battle.runtime_state).vegetation:
    use render_vegetation instance
  for instance in Iter.items (Project battle.runtime_state).scatter:
    use render_scatter instance

  use Scene.Object {
    .id = 10;
    .material = solid_material (Scene.color (160000, 420000, 980000), 120000);
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 ((Project battle.runtime_state).player_hq_x, 1100000, (Project battle.runtime_state).player_hq_z),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (2200000, 2200000, 2200000)
    );
    .visible = True;
  } []
  let headquarters_emissive = case battle.completed == 1 of
    #True => 0
    #False => 180000
  use Scene.Object {
    .id = 11;
    .material = solid_material (
      Scene.color (920000, battle.enemy_health * 90000, 100000),
      headquarters_emissive
    );
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 ((Project battle.runtime_state).opponent_hq_x, 1400000, (Project battle.runtime_state).opponent_hq_z),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (2600000, 2800000, 2600000)
    );
    .visible = battle.completed == 0;
  } []
  use Scene.Object {
    .id = 12;
    .material = solid_material (Scene.color (180000, 720000, 1000000), 80000);
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 ((Project battle.runtime_state).barracks_x, 700000, (Project battle.runtime_state).barracks_z),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (2600000, 1400000, 1800000)
    );
    .visible = (Project battle.runtime_state).has_barracks == 1;
  } []

  for point in Iter.items (Project battle.runtime_state).route:
    let route_emissive = case point.order <= battle.route_progress of
      #True => 650000
      #False => 90000
    use Scene.Object {
      .id = route_target_base + point.order;
      .material = solid_material (
        Scene.color (980000, 760000, 160000),
        route_emissive
      );
      .mesh = 1;
      .parent = Scene.root;
      .transform = Scene.transform (
        Scene.vec3 (point.x, 360000, point.z),
        Scene.vec3 (0, 0, 0),
        Scene.uniform_scale 420000
      );
      .visible = (Project battle.runtime_state).has_barracks == 1;
    } []

  use Scene.Object {
    .id = 20;
    .material = solid_material (Scene.color (160000, 860000, 1000000), 220000);
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (battle.scout_x, 850000, battle.scout_z),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (
        500000 + battle.trained * 180000,
        700000,
        500000 + battle.trained * 180000
      )
    );
    .visible = battle.trained > 0 && battle.completed == 0;
  } []
  use Scene.Object {
    .id = 30;
    .material = solid_material (Scene.color (240000, 1000000, 420000), 3800000);
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 ((Project battle.runtime_state).opponent_hq_x, 1800000, (Project battle.runtime_state).opponent_hq_z),
      Scene.vec3 (0, 0, 0),
      Scene.uniform_scale 900000
    );
    .visible = battle.completed == 1;
  } []

  return ()

use phase <- Phase.current ()
use state <- State.current ()
use trained <- Cells.get trained_cell
use route_progress <- Cells.get route_progress_cell
use travel_seconds <- Cells.get travel_seconds_cell
use enemy_health <- Cells.get enemy_health_cell
use completed <- Cells.get completed_cell
use last_result <- Cells.get result_cell
use scout_x <- Cells.get scout_x_cell
use scout_z <- Cells.get scout_z_cell

if phase == start_phase:
  use reset_game state
  use State.commit ((Project state).seed + (Project state).runtime_token - state)

if phase == update_phase:
  use event <- Events.next ()
  if event.kind == activate_event && event.target == restart_target:
    use reset_game state

  if event.kind == activate_event && event.target == train_target && completed == 0:
    if (Project state).has_barracks == 0:
      use Cells.put { .index = result_cell; .value = 7; }
    if (Project state).has_barracks == 1 && trained < required_scouts:
      use Cells.put { .index = trained_cell; .value = trained + 1; }
      use Cells.put { .index = result_cell; .value = 2; }
      use play_audio ("strategy.train", "strategy.train.scout")

  if event.kind == activate_event && event.target > route_target_base && completed == 0:
    let requested_point = event.target - route_target_base
    let expected_point = route_progress + 1
    if trained != required_scouts || requested_point != expected_point:
      use Cells.put { .index = result_cell; .value = 6; }
      use play_audio ("strategy.route-rejected", "strategy.route.rejected")
    if trained == required_scouts && requested_point == expected_point:
      for point in Iter.items (Project state).route:
        if point.order == requested_point:
          use Cells.put { .index = route_progress_cell; .value = point.order; }
          use Cells.put {
            .index = travel_seconds_cell;
            .value = travel_seconds + point.travel_seconds;
          }
          use Cells.put { .index = scout_x_cell; .value = point.x; }
          use Cells.put { .index = scout_z_cell; .value = point.z; }
          use Cells.put { .index = result_cell; .value = 3; }
          use play_audio (
            "strategy.route",
            Text.append "strategy.route." point.id
          )

  if event.kind == activate_event && event.target == attack_target && completed == 0:
    if trained != required_scouts || route_progress != Array.length (Project state).route:
      use Cells.put { .index = result_cell; .value = 1; }
      use play_audio ("strategy.attack-rejected", "strategy.attack.rejected")
    if trained == required_scouts && route_progress == Array.length (Project state).route:
      if enemy_health > 1:
        use Cells.put { .index = enemy_health_cell; .value = enemy_health - 1; }
        use Cells.put { .index = result_cell; .value = 4; }
        use play_audio ("strategy.attack", "strategy.attack.headquarters")
      if enemy_health == 1:
        use Cells.put { .index = enemy_health_cell; .value = 0; }
        use Cells.put { .index = completed_cell; .value = 1; }
        use Cells.put { .index = result_cell; .value = 5; }
        use play_audio (
          "strategy.headquarters-destroyed",
          "strategy.complete.destroy-headquarters"
        )
  use State.commit ((Project state).runtime_token + 1)

if phase == describe_phase:
  use describe_text (
    "strategy.objective",
    (Project state).objective_text,
    Text.append "Generated world " (Project state).world_id,
    1,
    24
  )
  use describe_text (
    "strategy.travel",
    Text.append "Route travel " (Text.append (Text.of_int travel_seconds) " seconds"),
    Text.append "Authored route points " (Text.of_int (Array.length (Project state).route)),
    2,
    58
  )

  if completed == 1:
    use Html.Status {
      .done = True;
      .label = (Project state).project_name;
      .value = Text.append
        "Opposing headquarters destroyed · travel seconds "
        (Text.of_int travel_seconds);
    } []

  if completed == 0 && (Project state).has_barracks == 0:
    use Html.Status {
      .done = False;
      .label = (Project state).project_name;
      .value = "Author a scout barracks and route";
    } []

  if completed == 0 && (Project state).has_barracks == 1:
    let battle_status = case last_result of
      1 => "Attack rejected · train 3 scouts and finish the route"
      2 => Text.append "Scout trained · force size " (Text.of_int trained)
      3 => Text.append
        (Text.append "Waypoint reached " (Text.of_int route_progress))
        (Text.append " of " (Text.of_int (Array.length (Project state).route)))
      4 => Text.append "Headquarters health " (Text.of_int enemy_health)
      6 => "Route order rejected"
      7 => "Scout barracks required"
      _ => "Train 3 scouts, follow every waypoint, then attack"
    use Html.Status {
      .done = False;
      .label = (Project state).project_name;
      .value = battle_status;
    } []

  if completed == 0:
    if (Project state).has_barracks == 1 && trained < required_scouts:
      use describe_button (
        "strategy.train-scout",
        "Train scout",
        Text.append "Train at authored barracks " (Project state).barracks_id,
        10,
        24,
        train_target
      )
    if trained == required_scouts:
      for point in Iter.items (Project state).route:
        if point.order == route_progress + 1:
          use describe_button (
            "strategy.advance-route",
            Text.append "March to waypoint " (Text.of_int point.order),
            Text.append
              point.id
              (Text.append " travel seconds " (Text.of_int point.travel_seconds)),
            11,
            224,
            route_target_base + point.order
          )
    use describe_button (
      "strategy.attack-headquarters",
      "Attack headquarters",
      "Attack only after training and ordered route traversal",
      12,
      424,
      attack_target
    )
  use Html.Button {
    .attachment = Html.viewport_attachment (
      Html.bottom_right,
      Html.element_size (24, 84)
    );
    .description = "Restart the deterministic authored battle";
    .element_size = Html.element_size (160, 42);
    .id = "strategy.restart";
    .label = "Restart";
    .order = 13;
    .pressed = False;
    .selected = False;
    .target = restart_target;
  } []

if phase == render_phase:
  use render_strategy {
    .completed = completed;
    .enemy_health = enemy_health;
    .route_progress = route_progress;
    .runtime_state = state;
    .scout_x = scout_x;
    .scout_z = scout_z;
    .trained = trained;
  }

return ()
