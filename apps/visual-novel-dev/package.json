{
  "name": "@ink/visual-novel-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config ink.ts",
    "build:game": "deno run --config ../../deno.json --allow-env=INK_NARRATIVE_PROJECT_FILE --allow-read --allow-write --allow-run=deno ink.ts",
    "check": "deno check --config ../../deno.json ink.ts src/*.ts src/*.tsx src/headless/*.ts src/editor/*.ts && node --check src/browser/scenario_test.mjs",
    "dev": "vite --config ink.ts",
    "headless": "pnpm build:game && deno run --config ../../deno.json --allow-read src/headless/main.ts",
    "scenario:browser": "pnpm test:browser",
    "scenario:headless": "pnpm build:game && deno test --config ../../deno.json --allow-env=INK_SCENARIO_REPORT --allow-read --allow-write src/headless/session_test.ts --filter 'both choices reach distinct endings with evidence and replay parity'",
    "test": "pnpm build:game && deno test --config ../../deno.json --allow-env --allow-read --allow-write --allow-run=deno src/*_test.ts src/headless/*_test.ts src/editor/*_test.ts",
    "test:browser": "pnpm build:game && node --test --test-concurrency=1 src/browser/scenario_test.mjs"
  },
  "dependencies": {
    "@ink/assets": "workspace:*",
    "@ink/audio": "workspace:*",
    "@ink/authoring": "workspace:*",
    "@ink/blot": "workspace:*",
    "@ink/development": "workspace:*",
    "@ink/editor-ui": "workspace:*",
    "@ink/localization": "workspace:*",
    "@ink/math": "workspace:*",
    "@ink/narrative-editor": "workspace:*",
    "@ink/observability": "workspace:*",
    "@ink/rendering": "workspace:*",
    "@ink/runtime": "workspace:*",
    "@ink/text": "workspace:*",
    "@ink/timeline": "workspace:*",
    "@ink/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@ink/vite": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "playwright": "1.61.1",
    "vite": "catalog:"
  },
  "ink": {
    "kind": "application"
  }
}
