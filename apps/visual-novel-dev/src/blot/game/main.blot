open import "../prelude.blot"
open import "@ink/blot/engine.blot"

const ProjectProvider = import "../generated/project.blot"
const Abi = import "@ink/blot/abi.blot"
const HostEffect = Abi.HostEffect
const Html = import "@ink/blot/html_canvas.blot"
const Scene = import "@ink/blot/scene.blot"

use state <- State.current ()
const Project = ProjectProvider.project

const scene_cell = 1000
const timeline_cell = 1001

let reset_story = fn () => do:
  use Cells.put { .index = scene_cell; .value = 0; }
  use Cells.put {
    .index = timeline_cell;
    .value = (Project state).first_beat_start_us;
  }
  return ()

let describe_dialogue = fn (dialogue, title, done) => do:
  use Html.Text {
    .attachment = Html.viewport_attachment (
      Html.bottom_left,
      Html.element_size (24, 168)
    );
    .description = title;
    .element_size = Html.element_size (560, 24);
    .id = "narrative.speaker";
    .label = dialogue.speaker;
    .order = 9;
  } []
  use Html.Text {
    .attachment = Html.viewport_attachment (
      Html.bottom_left,
      Html.element_size (24, 112)
    );
    .description = dialogue.speaker;
    .element_size = Html.element_size (dialogue.width, dialogue.height);
    .id = "narrative.dialogue";
    .label = dialogue.text;
    .order = 10;
  } []
  use Html.Status {
    .done = done;
    .label = title;
    .value = dialogue.text;
  } []
  return ()

let describe_timeline = fn playhead_us => do:
  use Html.Progress {
    .attachment = Html.viewport_attachment (
      Html.bottom_left,
      Html.element_size (24, 72)
    );
    .description = "Authored dialogue timeline";
    .element_size = Html.element_size (560, 8);
    .id = "narrative.timeline";
    .label = "Dialogue progress";
    .maximum = (Project state).timeline_duration_us;
    .order = 5;
    .value = playhead_us;
  } []
  return ()

let describe_choice = fn choice => do:
  use Html.Button {
    .attachment = Html.viewport_attachment (
      Html.bottom_left,
      Html.element_size (24, 24 + choice.destination_state * 48)
    );
    .description = choice.ending_title;
    .element_size = Html.element_size (220, 40);
    .id = Text.append "narrative.choice." choice.id;
    .label = choice.label;
    .order = 20 + choice.destination_state;
    .pressed = False;
    .selected = False;
    .target = choice.destination_state;
  } []
  return ()

let describe_restart = fn () => do:
  use Html.Button {
    .attachment = Html.viewport_attachment (
      Html.bottom_right,
      Html.element_size (24, 24)
    );
    .description = "Restart the authored story";
    .element_size = Html.element_size (180, 40);
    .id = "narrative.restart";
    .label = "Restart story";
    .order = 30;
    .pressed = False;
    .selected = False;
    .target = 0;
  } []
  return ()

let scene_light = fn active_scene => do:
  if active_scene == 1:
    return {
      .color = Scene.color (420000, 680000, 1000000);
      .direction = Scene.vec3 (-350000, -1000000, -220000);
      .intensity = 1350000;
    }
  if active_scene == 2:
    return {
      .color = Scene.color (1000000, 760000, 420000);
      .direction = Scene.vec3 (250000, -1000000, -120000);
      .intensity = 1200000;
    }
  return {
    .color = Scene.color (560000, 680000, 1000000);
    .direction = Scene.vec3 (-350000, -1000000, -220000);
    .intensity = 1000000;
  }

let signal_material = fn active_scene => do:
  if active_scene == 1:
    return Scene.material {
      .color = Scene.color (70000, 1000000, 260000);
      .emissive = 7000000;
    }
  if active_scene == 2:
    return Scene.material {
      .color = Scene.color (1000000, 680000, 200000);
      .emissive = 6000000;
    }
  return Scene.material {
    .color = Scene.color (1000000, 50000, 30000);
    .emissive = 7000000;
  }

let render_stage = fn active_scene => do:
  let light = scene_light active_scene
  use Scene.PerspectiveCamera {
    .clear_color = Scene.color (6000, 9000, 18000);
    .position = Scene.vec3 (200000, 3150000, 8800000);
    .target = Scene.vec3 (0, 1350000, 0);
    .vertical_fov_microradians = 720000;
  } []
  use Scene.Environment {
    .ambient_light = Scene.color (90000, 105000, 160000);
    .bloom_intensity = 300000;
    .exposure_ev100 = 350000;
    .fog_color = Scene.color (18000, 25000, 55000);
    .fog_density = 16000;
  } []
  use Scene.DirectionalLight light []
  use Scene.Object {
    .id = 1;
    .material = Scene.material {
      .color = Scene.color (120000, 140000, 180000);
    };
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (0, -350000, 0),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (16000000, 700000, 5000000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 2;
    .material = Scene.material {
      .color = Scene.color (340000, 90000, 80000);
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (-1150000, 1100000, 400000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (1100000, 2200000, 850000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 3;
    .material = Scene.material {
      .color = Scene.color (60000, 150000, 300000);
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (1100000, 1100000, 150000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (1100000, 2200000, 850000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 4;
    .material = signal_material active_scene;
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (5500000, 2800000, -1000000),
      Scene.vec3 (0, 0, 0),
      Scene.uniform_scale 250000
    );
    .visible = True;
  } []
  return ()

use phase <- Phase.current ()
use active_scene <- Cells.get scene_cell
use playhead_us <- Cells.get timeline_cell

if phase == start_phase:
  use reset_story ()
  use State.commit 0

if phase == update_phase:
  use event <- Events.next ()
  use elapsed_us <- Time.delta_us ()
  if active_scene == 0 && playhead_us < (Project state).timeline_duration_us:
    let advanced = playhead_us + elapsed_us
    if advanced < (Project state).timeline_duration_us:
      use Cells.put { .index = timeline_cell; .value = advanced; }
    else:
      use Cells.put {
        .index = timeline_cell;
        .value = (Project state).timeline_duration_us;
      }
  if event.kind == activate_event:
    if event.target == 0:
      use reset_story ()
    if active_scene == 0 && playhead_us >= (Project state).timeline_duration_us:
      for choice in Iter.items (Project state).choices:
        if event.target == choice.destination_state:
          use HostEffect.play_audio {
            .cue = choice.audio_cue;
            .id = Text.append "narrative.choice." choice.id;
          }
          use Cells.put {
            .index = scene_cell;
            .value = choice.destination_state;
          }
  use State.commit state

if phase == describe_phase:
  if active_scene == 0:
    for beat in Iter.items (Project state).initial_beats:
      if playhead_us >= beat.starts_at_us && (
        playhead_us < beat.ends_at_us || (
          playhead_us >= (Project state).timeline_duration_us &&
          beat.order + 1 == Array.length (Project state).initial_beats
        )
      ):
        use describe_dialogue (beat, (Project state).initial_title, False)
    use describe_timeline playhead_us
    if playhead_us >= (Project state).timeline_duration_us:
      for choice in Iter.items (Project state).choices:
        use describe_choice choice

  for choice in Iter.items (Project state).choices:
    if active_scene == choice.destination_state:
      use describe_dialogue (
        choice.ending_dialogue,
        choice.ending_label,
        True
      )
      use Html.Text {
        .attachment = Html.viewport_attachment (
          Html.bottom_left,
          Html.element_size (24, 72)
        );
        .description = choice.ending_title;
        .element_size = Html.element_size (560, 24);
        .id = "narrative.evidence";
        .label = choice.evidence;
        .order = 15;
      } []

  use describe_restart ()

if phase == render_phase:
  use render_stage active_scene

return ()
