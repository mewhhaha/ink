{
  "version": 2,
  "role": "editor_game",
  "editor": "@ink/narrative-editor",
  "commands": {
    "headless": "pnpm --filter @ink/visual-novel-dev scenario:headless",
    "browser": "pnpm --filter @ink/visual-novel-dev scenario:browser"
  },
  "edit": "add a dialogue beat, save the project, and rebuild the Blot guest",
  "expected_outcome": "play both choices to distinct endings with the authored beat and matching evidence state",
  "proofs": [
    {
      "package": "@ink/assets",
      "exports": ["./identity.ts"],
      "assertions": ["browser:authored-audio-cues-play"]
    },
    {
      "package": "@ink/audio",
      "exports": [
        "./device.ts",
        "./graph.ts",
        "./mixer.ts",
        "./model.ts"
      ],
      "assertions": ["browser:authored-audio-cues-play"]
    },
    {
      "package": "@ink/authoring",
      "exports": ["./catalog.ts", "./diagnostics.ts", "./identity.ts"],
      "assertions": [
        "browser:beat-save-hot-reloads-without-navigation",
        "browser:editor-catalog-defines-narrative-workflow"
      ]
    },
    {
      "package": "@ink/blot",
      "exports": [
        "./abi.blot",
        "./adapter.ts",
        "./build.ts",
        "./engine.blot",
        "./html_canvas.blot",
        "./protocol.ts",
        "./runtime.ts",
        "./scene.blot"
      ],
      "assertions": [
        "headless:both-endings-have-replay-parity",
        "browser:beat-save-hot-reloads-without-navigation"
      ]
    },
    {
      "package": "@ink/development",
      "exports": ["./controller.ts"],
      "assertions": ["browser:both-endings-match-headless-replay"]
    },
    {
      "package": "@ink/development",
      "exports": ["./debugger_window.tsx"],
      "assertions": [
        "browser:debugger-window-opens-and-closes-from-keyboard"
      ]
    },
    {
      "package": "@ink/editor-ui",
      "exports": ["./collections.tsx", "./styles.css"],
      "assertions": ["browser:editor-outliner-keyboard-focus"]
    },
    {
      "package": "@ink/localization",
      "exports": ["./catalog.ts", "./localizer.ts"],
      "assertions": ["browser:beat-save-hot-reloads-without-navigation"]
    },
    {
      "package": "@ink/math",
      "exports": ["./vector.ts"],
      "assertions": ["browser:beat-save-hot-reloads-without-navigation"]
    },
    {
      "package": "@ink/narrative-editor",
      "exports": [
        "./catalog.ts",
        "./commands.ts",
        "./identity.ts",
        "./serialization.ts",
        "./validation.ts",
        "./workspace.tsx"
      ],
      "assertions": [
        "browser:beat-save-hot-reloads-without-navigation",
        "browser:editor-catalog-defines-narrative-workflow"
      ]
    },
    {
      "package": "@ink/rendering",
      "exports": ["./renderer.ts"],
      "assertions": ["browser:canonical-renderer-draws-3d-stage"]
    },
    {
      "package": "@ink/runtime",
      "exports": ["./session.ts"],
      "assertions": [
        "headless:both-endings-have-replay-parity",
        "browser:both-endings-match-headless-replay"
      ]
    },
    {
      "package": "@ink/text",
      "exports": ["./font.ts", "./layout.ts"],
      "assertions": [
        "browser:authored-localized-dialogue-layout-changes-visible-lines"
      ]
    },
    {
      "package": "@ink/timeline",
      "exports": ["./timeline.ts"],
      "assertions": ["browser:beat-save-hot-reloads-without-navigation"]
    },
    {
      "package": "@ink/ui",
      "exports": [
        "./browser.ts",
        "./layout.ts",
        "./localization.ts",
        "./semantic.ts"
      ],
      "assertions": [
        "browser:beat-save-hot-reloads-without-navigation",
        "browser:both-endings-match-headless-replay"
      ]
    },
    {
      "package": "@ink/ui",
      "exports": ["./controller.ts", "./headless.ts"],
      "assertions": ["headless:both-endings-have-replay-parity"]
    },
    {
      "package": "@ink/vite",
      "exports": [".", "./client.ts"],
      "assertions": ["browser:beat-save-hot-reloads-without-navigation"]
    }
  ]
}
