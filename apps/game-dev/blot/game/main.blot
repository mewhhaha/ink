open {} = (@import "../prelude.blot") ();
open {} = (@import "../../../../packages/blot/engine.blot") ();
open {} = (@import "../../../../packages/blot/html_canvas.blot") ();
open {} = (@import "../../../../packages/blot/scene.blot") ();

let update = fn state => do
  event <- Events.next ();
  in if event.kind == activate_event
    then if state == 0 then 1 else 0 end
    else state
  end
end;

let describe = fn state => do
  _ <- <Button
    .attachment={attachment (
      0,
      vec3 (900000, 0, 560000),
      element_size (1200000, 500000)
    )}
    .description={if state == 1 then "active" else "inactive" end}
    .element_size={element_size (144, 56)}
    .id="toggle-object"
    .label="Toggle object"
    .order=0
    .pressed={state == 1}
    .selected=False
    .style={style (
      if state == 1 then "#f59e0b" else "#07090f" end,
      "#f59e0b",
      10,
      1,
      if state == 1 then "#05070a" else "#f59e0b" end,
      14,
      600
    )}
    .target=0
  />;
  _ <- <Status
    .done={state == 1}
    .label="Object state"
    .value={if state == 1 then "active" else "inactive" end}
  />;
  in ()
end;

let render = fn state => do
  _ <- <Camera .projection={perspective} .zoom=1000000>
    _ <- <MeshResource .id=0 .url="/assets/cube.obj" />;
    _ <- <DirectionalLight
      .color={color (1000000, 940000, 820000)}
      .direction={vec3 (-350000, -800000, -550000)}
      .intensity=850000
    />;
    _ <- <Object
      .id=0
      .mesh=0
      .material={material (
        if state == 1
          then color (1000000, 420000, 50000)
          else color (360000, 400000, 500000)
        end,
        if state == 1 then 280000 else 0 end
      )}
      .parent={root}
      .transform={transform (
        vec3 (0, 0, 0),
        vec3 (-200000, 0, 0),
        uniform_scale 1100000
      )}
      .visible=True
    />;
  </Camera>;
  in ()
end;

phase <- Phase.current ();
state <- State.current ();
_ <- case phase of
  #(start_phase) => State.commit 0,
  #(frame_phase) => do
    next_state <- update state;
    _ <- State.commit next_state;
    in ()
  end,
  #(describe_phase) => describe state,
  #(render_phase) => render state,
  _ => ()
end;

return ();
