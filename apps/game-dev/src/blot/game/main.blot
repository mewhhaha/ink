open @import "../prelude.blot" ()
open @import "../../../../../packages/blot/data.blot" ()
open @import "../../../../../packages/blot/engine.blot" ()

const M = @import "../../../../../packages/blot/math.blot" ()

const Resource = @effect.host {
  .mesh = { .id = Int; .url = Str; } -> Unit;
  .texture = { .id = Int; .url = Str; } -> Unit;
}

const Render = @effect.host {
  .directional_light = {
    .color_blue = Int;
    .color_green = Int;
    .color_red = Int;
    .direction_x = Int;
    .direction_y = Int;
    .direction_z = Int;
    .intensity = Int;
  } -> Unit;
  .material = {
    .blend_edges = Int;
    .color_blue = Int;
    .color_green = Int;
    .color_red = Int;
    .id = Int;
    .secondary_texture = Int;
    .surface_mode = Int;
    .texture = Int;
    .texture_offset_x = Int;
    .texture_offset_y = Int;
    .texture_scale_x = Int;
    .texture_scale_y = Int;
    .path_connections = Int;
    .variation_seed = Int;
  } -> Unit;
  .mesh = { .id = Int; .mesh = Int; } -> Unit;
  .object = {
    .emissive = Int;
    .id = Int;
    .parent = Int;
    .rotation_x_microradians = Int;
    .rotation_y_microradians = Int;
    .rotation_z_microradians = Int;
    .scale_x = Int;
    .scale_y = Int;
    .scale_z = Int;
    .visible = Bool;
    .x = Int;
    .y = Int;
    .z = Int;
  } -> Unit;
  .orthogonal_tilemap = {
    .atlas_columns = Int;
    .cell_offset = Int;
    .columns = Int;
    .first_object_id = Int;
    .mesh = Int;
    .origin_x = Int;
    .origin_y = Int;
    .rows = Int;
    .texture = Int;
    .tile_size = Int;
    .z = Int;
  } -> Unit;
  .projection = Int -> Unit;
  .zoom = Int -> Unit;
}

const Semantic = @effect.host {
  .action = {
    .id = Str;
    .kind = Int;
    .label = Str;
    .target = Int;
    .value = Int;
  } -> Unit;
  .status = { .done = Bool; .label = Str; .value = Str; } -> Unit;
}

const level_asset = 0
const columns_field = 0
const rows_field = 1
const terrain_field = 2
const decoration_field = 3
const player_start_field = 4
const tile_edit_event = 40
const move_left_start_event = 10
const move_left_stop_event = 11
const move_right_start_event = 12
const move_right_stop_event = 13
const jump_event = 14
const restart_event = 15
const atlas_columns = 16
const tile_size = 1000000
const camera_zoom = 650000
const maximum_delta_us = 50000
const microseconds_per_second = 1000000
const move_speed = 4500000
const gravity = 22000000
const jump_velocity = 8500000
const maximum_fall_speed = 12000000
const player_half_width = 350000
const player_half_height = 500000
const collision_inset = 10000

phase <- Phase.current ()
state <- State.current ()
columns <- DataAsset.get {
  .asset = level_asset;
  .field = columns_field;
  .index = 0;
}
rows <- DataAsset.get {
  .asset = level_asset;
  .field = rows_field;
  .index = 0;
}
saved_player_start <- DataAsset.get {
  .asset = level_asset;
  .field = player_start_field;
  .index = 0;
}
let tile_count = columns * rows
let origin_x = (0 - (columns - 1)) * tile_size / 2
let origin_y = (rows - 1) * tile_size / 2
let player_start_cell = tile_count * 2
let player_x_cell = player_start_cell + 1
let player_y_cell = player_start_cell + 2
let player_velocity_y_cell = player_start_cell + 3
let player_direction_cell = player_start_cell + 4
let player_grounded_cell = player_start_cell + 5
player_start <- Cells.get player_start_cell
let player_column = @int.rem player_start columns
let player_row = player_start / columns
let saved_player_column = @int.rem saved_player_start columns
let saved_player_row = saved_player_start / columns
player_x <- Cells.get player_x_cell
player_y <- Cells.get player_y_cell
player_velocity_y <- Cells.get player_velocity_y_cell
player_direction <- Cells.get player_direction_cell
player_grounded <- Cells.get player_grounded_cell
let spawn_x = origin_x + player_column * tile_size
let spawn_y = origin_y - player_row * tile_size
let saved_spawn_x = origin_x + saved_player_column * tile_size
let saved_spawn_y = origin_y - saved_player_row * tile_size

let tile_column_at = fn world_x =>
  return (world_x - origin_x + tile_size / 2) / tile_size

let tile_row_at = fn world_y =>
  return (origin_y + tile_size / 2 - world_y) / tile_size

let terrain_is_solid = fn (column, row) =>
  if column < 0 || column >= columns || row < 0 || row >= rows:
    return False

  tile <- Cells.get (row * columns + column)
  return tile >= 0

let apply_tile_edit = fn event =>
  if event.target >= 0 && event.target < player_start_cell:
    <- Cells.put { .index = event.target; .value = event.value; }

  if (
    event.target == player_start_cell
    && event.value >= 0
    && event.value < tile_count
  ):
    <- Cells.put { .index = event.target; .value = event.value; }
    <- Cells.put {
      .index = player_x_cell;
      .value = origin_x + @int.rem event.value columns * tile_size;
    }
    <- Cells.put {
      .index = player_y_cell;
      .value = origin_y - (event.value / columns) * tile_size;
    }
    <- Cells.put { .index = player_velocity_y_cell; .value = 0; }
    <- Cells.put { .index = player_grounded_cell; .value = 1; }

  return ()

let apply_player_input = fn event =>
  if event.kind == move_left_start_event:
    <- Cells.put { .index = player_direction_cell; .value = -1; }

  if event.kind == move_left_stop_event && player_direction < 0:
    <- Cells.put { .index = player_direction_cell; .value = 0; }

  if event.kind == move_right_start_event:
    <- Cells.put { .index = player_direction_cell; .value = 1; }

  if event.kind == move_right_stop_event && player_direction > 0:
    <- Cells.put { .index = player_direction_cell; .value = 0; }

  if event.kind == jump_event && player_grounded > 0:
    <- Cells.put {
      .index = player_velocity_y_cell;
      .value = jump_velocity;
    }
    <- Cells.put { .index = player_grounded_cell; .value = 0; }

  if event.kind == restart_event:
    <- Cells.put { .index = player_x_cell; .value = spawn_x; }
    <- Cells.put { .index = player_y_cell; .value = spawn_y; }
    <- Cells.put { .index = player_velocity_y_cell; .value = 0; }
    <- Cells.put { .index = player_direction_cell; .value = 0; }
    <- Cells.put { .index = player_grounded_cell; .value = 1; }

  return ()

let simulate_player = fn () =>
  raw_delta_us <- Time.delta_us ()
  let delta_us = M.minimum (raw_delta_us, maximum_delta_us)
  let minimum_x = origin_x + player_half_width
  let maximum_x = origin_x
    + (columns - 1) * tile_size - player_half_width
  let requested_x = player_x
    + player_direction * move_speed * delta_us / microseconds_per_second
  let bounded_x = M.clamp (requested_x, minimum_x, maximum_x)
  let horizontal_probe_x = bounded_x
    + player_direction * player_half_width
  let horizontal_column = tile_column_at horizontal_probe_x
  let body_row = tile_row_at player_y
  horizontal_blocked <- terrain_is_solid (horizontal_column, body_row)

  let next_x =
    if horizontal_blocked:
      return player_x
    else:
      return bounded_x
  let falling_velocity = M.maximum (
    player_velocity_y - gravity * delta_us / microseconds_per_second,
    0 - maximum_fall_speed
  )
  let requested_y = player_y
    + falling_velocity * delta_us / microseconds_per_second
  let left_floor_column = tile_column_at (
    next_x - player_half_width + collision_inset
  )
  let right_floor_column = tile_column_at (
    next_x + player_half_width - collision_inset
  )
  let requested_bottom = requested_y - player_half_height
  let floor_row = tile_row_at requested_bottom
  left_floor_solid <- terrain_is_solid (left_floor_column, floor_row)
  right_floor_solid <- terrain_is_solid (right_floor_column, floor_row)
  landed <-
    if falling_velocity <= 0:
      return left_floor_solid || right_floor_solid
    else:
      return False
  let next_y =
    if landed:
      return origin_y - floor_row * tile_size
        + tile_size / 2 + player_half_height
    else:
      return requested_y
  let next_velocity_y =
    if landed:
      return 0
    else:
      return falling_velocity
  let grounded =
    if landed:
      return 1
    else:
      return 0

  if next_y < origin_y - rows * tile_size - tile_size * 2:
    <- Cells.put { .index = player_x_cell; .value = spawn_x; }
    <- Cells.put { .index = player_y_cell; .value = spawn_y; }
    <- Cells.put { .index = player_velocity_y_cell; .value = 0; }
    <- Cells.put { .index = player_grounded_cell; .value = 1; }
  else:
    <- Cells.put { .index = player_x_cell; .value = next_x; }
    <- Cells.put { .index = player_y_cell; .value = next_y; }
    <- Cells.put {
      .index = player_velocity_y_cell;
      .value = next_velocity_y;
    }
    <- Cells.put { .index = player_grounded_cell; .value = grounded; }

  return ()

if phase == start_phase:
  <- DataAsset.copy_to_cells {
    .asset = level_asset;
    .field = terrain_field;
    .first_cell = 0;
  }
  <- DataAsset.copy_to_cells {
    .asset = level_asset;
    .field = decoration_field;
    .first_cell = tile_count;
  }
  <- DataAsset.copy_to_cells {
    .asset = level_asset;
    .field = player_start_field;
    .first_cell = player_start_cell;
  }
  <- Cells.put { .index = player_x_cell; .value = saved_spawn_x; }
  <- Cells.put { .index = player_y_cell; .value = saved_spawn_y; }
  <- Cells.put { .index = player_velocity_y_cell; .value = 0; }
  <- Cells.put { .index = player_direction_cell; .value = 0; }
  <- Cells.put { .index = player_grounded_cell; .value = 1; }
  <- State.commit 0

if phase == frame_phase:
  event <- Events.next ()
  if event.kind == tile_edit_event:
    <- apply_tile_edit event

  <- apply_player_input event

  if event.kind == frame_event:
    <- simulate_player ()

  <- State.commit state

if phase == describe_phase:
  <- Render.projection 1
  <- Render.zoom camera_zoom
  <- Semantic.status {
    .done = False;
    .label = "Starter Meadow";
    .value = "24 × 14";
  }
  <- Semantic.action {
    .id = "move-left-start";
    .kind = move_left_start_event;
    .label = "Move left";
    .target = 0;
    .value = 0;
  }
  <- Semantic.action {
    .id = "move-left-stop";
    .kind = move_left_stop_event;
    .label = "Stop moving left";
    .target = 0;
    .value = 0;
  }
  <- Semantic.action {
    .id = "move-right-start";
    .kind = move_right_start_event;
    .label = "Move right";
    .target = 0;
    .value = 0;
  }
  <- Semantic.action {
    .id = "move-right-stop";
    .kind = move_right_stop_event;
    .label = "Stop moving right";
    .target = 0;
    .value = 0;
  }
  <- Semantic.action {
    .id = "jump";
    .kind = jump_event;
    .label = "Jump";
    .target = 0;
    .value = 0;
  }
  <- Semantic.action {
    .id = "restart";
    .kind = restart_event;
    .label = "Restart";
    .target = 0;
    .value = 0;
  }

if phase == render_phase:
  <- Render.projection 1
  <- Render.zoom camera_zoom
  <- Render.directional_light {
    .color_blue = 1000000;
    .color_green = 1000000;
    .color_red = 1000000;
    .direction_x = 0;
    .direction_y = 0;
    .direction_z = -1000000;
    .intensity = 0;
  }
  <- Resource.mesh { .id = 0; .url = "/assets/cube.obj"; }
  <- Resource.texture {
    .id = 0;
    .url = "/assets/brackeys/world_tileset.png";
  }
  <- Resource.texture { .id = 1; .url = "/assets/brackeys/knight.png"; }
  <- Render.material {
    .blend_edges = 0;
    .color_blue = 820000;
    .color_green = 720000;
    .color_red = 440000;
    .id = 10;
    .secondary_texture = -1;
    .surface_mode = 0;
    .texture = -1;
    .texture_offset_x = 0;
    .texture_offset_y = 0;
    .texture_scale_x = 1000000;
    .texture_scale_y = 1000000;
    .path_connections = 0;
    .variation_seed = 0;
  }
  <- Render.mesh { .id = 10; .mesh = 0; }
  <- Render.object {
    .emissive = 1000000;
    .id = 10;
    .parent = -1;
    .rotation_x_microradians = 0;
    .rotation_y_microradians = 0;
    .rotation_z_microradians = 0;
    .scale_x = columns * tile_size;
    .scale_y = rows * tile_size;
    .scale_z = 100000;
    .visible = True;
    .x = 0;
    .y = 0;
    .z = -1000000;
  }
  <- Render.material {
    .blend_edges = 0;
    .color_blue = 1000000;
    .color_green = 1000000;
    .color_red = 1000000;
    .id = 20;
    .secondary_texture = -1;
    .surface_mode = 4;
    .texture = 1;
    .texture_offset_x = 0;
    .texture_offset_y = 0;
    .texture_scale_x = 125000;
    .texture_scale_y = 125000;
    .path_connections = 0;
    .variation_seed = 0;
  }
  <- Render.mesh { .id = 20; .mesh = 0; }
  <- Render.object {
    .emissive = 1000000;
    .id = 20;
    .parent = -1;
    .rotation_x_microradians = 0;
    .rotation_y_microradians = 0;
    .rotation_z_microradians = 0;
    .scale_x = tile_size * 2;
    .scale_y = tile_size * 2;
    .scale_z = 100000;
    .visible = True;
    .x = player_x;
    .y = player_y;
    .z = 200000;
  }
  <- Render.orthogonal_tilemap {
    .atlas_columns = atlas_columns;
    .cell_offset = 0;
    .columns = columns;
    .first_object_id = 1000;
    .mesh = 0;
    .origin_x = origin_x;
    .origin_y = origin_y;
    .rows = rows;
    .texture = 0;
    .tile_size = tile_size;
    .z = 0;
  }
  <- Render.orthogonal_tilemap {
    .atlas_columns = atlas_columns;
    .cell_offset = tile_count;
    .columns = columns;
    .first_object_id = 2000;
    .mesh = 0;
    .origin_x = origin_x;
    .origin_y = origin_y;
    .rows = rows;
    .texture = 0;
    .tile_size = tile_size;
    .z = 100000;
  }

return ()
