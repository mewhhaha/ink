open @import "../prelude.blot" ()
open @import "../../../../../packages/blot/engine.blot" ()
open @import "../../../../../packages/blot/html_canvas.blot" ()
open @import "../../../../../packages/blot/scene.blot" ()

let update = fn state =>
  event <- Events.next ()
  if event.kind == activate_event:
    if state == 0:
      return 1
    else:
      return 0
  else:
    return state

let describe = fn state =>
  _ <- <Button
    .attachment={attachment (
    0,
    vec3 (900000, 0, 560000),
    element_size (1200000, 500000)
    )}
    .description={if state == 1:
      return "active"
    else:
      return "inactive"
    }
    .element_size={element_size (144, 56)}
    .id="toggle-object"
    .label="Toggle object"
    .order=0
    .pressed={state == 1}
    .selected=False
    .style={style (
    if state == 1:
      return "#f59e0b"
    else:
      return "#07090f"
    ,
    "#f59e0b",
    10,
    1,
    if state == 1:
      return "#05070a"
    else:
      return "#f59e0b"
    ,
    14,
    600
    )}
    .target=0
  />
  _ <- <Status
    .done={state == 1}
    .label="Object state"
    .value={if state == 1:
      return "active"
    else:
      return "inactive"
    }
  />
  return ()

let render = fn state =>
  _ <- <Camera .projection={perspective} .zoom=1000000>
    _ <- <MeshResource .id=0 .url="/assets/cube.obj" />
    _ <- <DirectionalLight
      .color={color (1000000, 940000, 820000)}
      .direction={vec3 (-350000, -800000, -550000)}
      .intensity=850000
    />
    _ <- <Object
      .id=0
      .mesh=0
      .material={material (
      if state == 1:
        return color (1000000, 420000, 50000)
      else:
        return color (360000, 400000, 500000)
      ,
      if state == 1:
        return 280000
      else:
        return 0

      )}
      .parent={root}
      .transform={transform (
      vec3 (0, 0, 0),
      vec3 (-200000, 0, 0),
      uniform_scale 1100000
      )}
      .visible=True
    />
  </Camera>
  return ()

phase <- Phase.current ()
state <- State.current ()
if phase == start_phase:
  _ <- State.commit 0
if phase == frame_phase:
  next_state <- update state
  _ <- State.commit next_state
if phase == describe_phase:
  _ <- describe state
if phase == render_phase:
  _ <- render state

return ()
