{
  "name": "@ink/game-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config ink.ts",
    "build:game": "deno run --config ../../deno.json --allow-read --allow-write --allow-run=deno ink.ts",
    "check": "deno check --config ../../deno.json ink.ts src/headless/*.ts src/editor/*.ts src/editor/*.tsx",
    "dev": "vite --config ink.ts",
    "headless": "pnpm build:game && deno run --config ../../deno.json --allow-read src/headless/main.ts",
    "test": "pnpm build:game && deno test --config ../../deno.json --allow-read --allow-write src/headless/*_test.ts src/editor/*_test.ts"
  },
  "dependencies": {
    "@comp0/react": "catalog:",
    "@heroicons/react": "catalog:",
    "@ink/blot": "workspace:*",
    "@ink/development": "workspace:*",
    "@ink/runtime": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@ink/vite": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vite": "catalog:"
  }
}
