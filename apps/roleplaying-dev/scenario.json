{
  "version": 2,
  "role": "editor_game",
  "editor": "@ink/roleplaying-editor",
  "commands": {
    "headless": "pnpm --filter @ink/roleplaying-dev scenario:headless",
    "browser": "pnpm --filter @ink/roleplaying-dev scenario:browser"
  },
  "edit": "add the moonstone relic to the guarded ruins cache and rebuild the Blot guest",
  "expected_outcome": "reject out-of-order and early authored timeline actions, then talk to the keeper, travel to the ruins, defeat the sentinel, collect the edited loot, and reach the shrine with replay parity, six accepted audio cues, and a non-clear final screenshot",
  "proofs": [
    {
      "package": "@ink/audio",
      "exports": ["./device.ts", "./graph.ts", "./mixer.ts", "./model.ts"],
      "assertions": [
        "browser:canonical-audio-host-accepts-authored-cues"
      ]
    },
    {
      "package": "@ink/blot",
      "exports": [
        "./abi.blot",
        "./adapter.ts",
        "./build.ts",
        "./engine.blot",
        "./html_canvas.blot",
        "./protocol.ts",
        "./scene.blot"
      ],
      "assertions": [
        "headless:edited-ruins-pilgrimage-replay-and-presentation-parity",
        "browser:edited-ruins-loot-rebuilds-and-reloads",
        "browser:ruins-pilgrimage-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/development",
      "exports": ["./debugger.ts"],
      "assertions": [
        "headless:edited-ruins-pilgrimage-replay-and-presentation-parity",
        "browser:ruins-pilgrimage-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/math",
      "exports": ["./vector.ts"],
      "assertions": [
        "browser:ruins-pilgrimage-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/observability",
      "exports": ["./observer.ts", "./redaction.ts", "./sink.ts"],
      "assertions": [
        "headless:edited-ruins-pilgrimage-replay-and-presentation-parity",
        "browser:ruins-pilgrimage-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/rendering",
      "exports": ["./renderer.ts"],
      "assertions": [
        "browser:ruins-pilgrimage-matches-headless-presentation",
        "browser:final-shrine-renders-non-clear-pixels"
      ]
    },
    {
      "package": "@ink/roleplaying-editor",
      "exports": [
        "./commands.ts",
        "./identity.ts",
        "./serialization.ts"
      ],
      "assertions": [
        "headless:edited-ruins-pilgrimage-replay-and-presentation-parity",
        "browser:edited-ruins-loot-rebuilds-and-reloads"
      ]
    },
    {
      "package": "@ink/runtime",
      "exports": ["./session.ts"],
      "assertions": [
        "headless:edited-ruins-pilgrimage-replay-and-presentation-parity",
        "browser:ruins-pilgrimage-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/timeline",
      "exports": ["./timeline.ts"],
      "assertions": [
        "headless:authored-timeline-rejects-out-of-order-and-early-actions",
        "browser:authored-timeline-rejects-out-of-order-and-early-actions"
      ]
    },
    {
      "package": "@ink/ui",
      "exports": ["./browser.ts", "./layout.ts"],
      "assertions": [
        "browser:ruins-pilgrimage-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/vite",
      "exports": ["."],
      "assertions": [
        "browser:edited-ruins-loot-rebuilds-and-reloads"
      ]
    }
  ]
}
