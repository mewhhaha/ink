{
  "name": "@ink/roleplaying-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config ink.ts",
    "build:game": "deno run --config ../../deno.json --allow-read --allow-write --allow-run=deno ink.ts",
    "check": "deno check --config ../../deno.json ink.ts src/*.ts src/*.tsx src/headless/*.ts",
    "dev": "vite --config ink.ts",
    "headless": "pnpm build:game && deno run --config ../../deno.json --allow-read src/headless/main.ts",
    "test": "pnpm build:game && deno test --config ../../deno.json --allow-read src/*_test.ts src/headless/*_test.ts",
    "test:browser": "deno test --config ../../deno.json --allow-env --allow-net --allow-read --allow-run src/browser/*_test.ts"
  },
  "dependencies": {
    "@ink/assets": "workspace:*",
    "@ink/authoring": "workspace:*",
    "@ink/blot": "workspace:*",
    "@ink/development": "workspace:*",
    "@ink/ecs": "workspace:*",
    "@ink/editor-ui": "workspace:*",
    "@ink/geometry": "workspace:*",
    "@ink/localization": "workspace:*",
    "@ink/math": "workspace:*",
    "@ink/navigation": "workspace:*",
    "@ink/observability": "workspace:*",
    "@ink/roleplaying-editor": "workspace:*",
    "@ink/runtime": "workspace:*",
    "@ink/timeline": "workspace:*",
    "@ink/ui": "workspace:*",
    "@ink/world": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@ink/vite": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vite": "catalog:"
  },
  "ink": {
    "kind": "application"
  }
}
