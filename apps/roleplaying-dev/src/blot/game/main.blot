open import "../prelude.blot"
open import "@ink/blot/engine.blot"

const ProjectProvider = import "../generated/project.blot"
const Abi = import "@ink/blot/abi.blot"
const HostEffect = Abi.HostEffect
const Html = import "@ink/blot/html_canvas.blot"
const Scene = import "@ink/blot/scene.blot"

use state <- State.current ()
let Project = ProjectProvider.project state

const region_cell = 0
const talked_cell = 1
const player_health_cell = 2
const sentinel_health_cell = 3
const sentinel_defeated_cell = 4
const loot_collected_cell = 5
const completed_cell = 6
const current_beat_cell = 7
const timeline_elapsed_cell = 8

let village_region = Project.initial_region
let ruins_region = Project.ruins_region
let shrine_region = Project.shrine_region
const talk_target = 10
const ruins_travel_target = 20
const attack_target = 30
const collect_target = 40
const shrine_travel_target = 50

let reset_pilgrimage = fn () => do:
  use Cells.put { .index = region_cell; .value = Project.player_region; }
  use Cells.put { .index = talked_cell; .value = 0; }
  use Cells.put {
    .index = player_health_cell;
    .value = Project.player_maximum_health;
  }
  use Cells.put {
    .index = sentinel_health_cell;
    .value = Project.sentinel_maximum_health;
  }
  use Cells.put { .index = sentinel_defeated_cell; .value = 0; }
  use Cells.put { .index = loot_collected_cell; .value = 0; }
  use Cells.put { .index = completed_cell; .value = 0; }
  use Cells.put { .index = current_beat_cell; .value = 0; }
  use Cells.put { .index = timeline_elapsed_cell; .value = 0; }
  return ()

let describe_text = fn (id, label, description, order, offset_y) => do:
  use Html.Text {
    .attachment = Html.viewport_attachment (
      Html.top_left,
      Html.element_size (24, offset_y)
    );
    .description = description;
    .element_size = Html.element_size (620, 28);
    .id = id;
    .label = label;
    .order = order;
  } []
  return ()

let describe_button = fn (id, label, description, target, order, offset_y) => do:
  use Html.Button {
    .attachment = Html.viewport_attachment (
      Html.bottom_left,
      Html.element_size (24, offset_y)
    );
    .description = description;
    .element_size = Html.element_size (260, 44);
    .id = id;
    .label = label;
    .order = order;
    .pressed = False;
    .selected = False;
    .target = target;
  } []
  return ()

let hero_position = fn region => do:
  if region == village_region:
    return Scene.vec3 (-1800000, 900000, 600000)
  if region == ruins_region:
    return Scene.vec3 (-1400000, 900000, 600000)
  return Scene.vec3 (0, 900000, 1000000)

let scene_light = fn region => do:
  if region == ruins_region:
    return {
      .color = Scene.color (820000, 620000, 420000);
      .direction = Scene.vec3 (-300000, -1000000, -180000);
      .intensity = 1150000;
    }
  if region == shrine_region:
    return {
      .color = Scene.color (420000, 700000, 1000000);
      .direction = Scene.vec3 (250000, -1000000, -150000);
      .intensity = 1400000;
    }
  return {
    .color = Scene.color (1000000, 880000, 620000);
    .direction = Scene.vec3 (-250000, -1000000, -250000);
    .intensity = 1000000;
  }

let render_dungeon = fn (region, sentinel_defeated, loot_collected) => do:
  let light = scene_light region
  use Scene.PerspectiveCamera {
    .clear_color = Scene.color (8000, 10000, 18000);
    .position = Scene.vec3 (0, 4000000, 8000000);
    .target = Scene.vec3 (0, 1000000, 0);
    .vertical_fov_microradians = 720000;
  } []
  use Scene.Environment {
    .ambient_light = Scene.color (35000, 40000, 65000);
    .bloom_intensity = 240000;
    .exposure_ev100 = -250000;
    .fog_color = Scene.color (12000, 16000, 30000);
    .fog_density = 18000;
  } []
  use Scene.DirectionalLight light []
  use Scene.Object {
    .id = 1;
    .material = Scene.material {
      .color = Scene.color (180000, 170000, 150000);
    };
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (0, -300000, 0),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (12000000, 600000, 7000000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 10;
    .material = Scene.material {
      .color = Scene.color (220000, 700000, 1000000);
      .emissive = 120000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      hero_position region,
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (900000, 1800000, 900000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 11;
    .material = Scene.material {
      .color = Scene.color (920000, 720000, 360000);
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (1800000, 900000, -400000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (900000, 1800000, 900000)
    );
    .visible = region == village_region;
  } []
  use Scene.Object {
    .id = 12;
    .material = Scene.material {
      .color = Scene.color (850000, 180000, 120000);
      .emissive = 200000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (1800000, 1150000, -600000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (1200000, 2300000, 1200000)
    );
    .visible = region == Project.sentinel_region && sentinel_defeated == 0;
  } []
  use Scene.Object {
    .id = 13;
    .material = Scene.material {
      .color = Scene.color (300000, 780000, 1000000);
      .emissive = 3500000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (2000000, 300000, -500000),
      Scene.vec3 (0, 0, 0),
      Scene.uniform_scale 350000
    );
    .visible = region == ruins_region && sentinel_defeated == 1 && loot_collected == 0;
  } []
  use Scene.Object {
    .id = 14;
    .material = Scene.material {
      .color = Scene.color (420000, 760000, 1000000);
      .emissive = 4500000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (0, 1900000, -1200000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (3000000, 3800000, 900000)
    );
    .visible = region == shrine_region;
  } []
  return ()

use phase <- Phase.current ()
use region <- Cells.get region_cell
use talked <- Cells.get talked_cell
use player_health <- Cells.get player_health_cell
use sentinel_health <- Cells.get sentinel_health_cell
use sentinel_defeated <- Cells.get sentinel_defeated_cell
use loot_collected <- Cells.get loot_collected_cell
use completed <- Cells.get completed_cell
use current_beat <- Cells.get current_beat_cell
use timeline_elapsed <- Cells.get timeline_elapsed_cell

if phase == start_phase:
  use reset_pilgrimage ()
  use State.commit 0

if phase == update_phase:
  use event <- Events.next ()
  use elapsed_us <- Time.delta_us ()
  let advanced_elapsed = Int.min
    Project.timeline_duration_us
    (timeline_elapsed + elapsed_us)
  use Cells.put {
    .index = timeline_elapsed_cell;
    .value = advanced_elapsed;
  }
  if event.kind == activate_event:
    if event.target == talk_target &&
      current_beat == Project.dialogue_beat_order &&
      advanced_elapsed >= Project.dialogue_beat_time_us &&
      talked == 0:
      use Cells.put { .index = talked_cell; .value = 1; }
      use Cells.put {
        .index = current_beat_cell;
        .value = Project.dialogue_beat_order + 1;
      }
      use HostEffect.play_audio {
        .cue = Text.append "roleplaying." Project.dialogue_id;
        .id = "roleplaying.talk";
      }
    if event.target == ruins_travel_target &&
      current_beat == Project.ruins_travel_beat_order &&
      advanced_elapsed >= Project.ruins_travel_beat_time_us &&
      talked == 1:
      use Cells.put { .index = region_cell; .value = ruins_region; }
      use Cells.put {
        .index = current_beat_cell;
        .value = Project.ruins_travel_beat_order + 1;
      }
      use HostEffect.play_audio {
        .cue = "roleplaying.travel-ruins";
        .id = "roleplaying.travel-ruins";
      }
    if event.target == attack_target &&
      current_beat == Project.encounter_beat_order &&
      advanced_elapsed >= Project.encounter_beat_time_us &&
      sentinel_health > 0:
      let next_sentinel_health = sentinel_health - Project.player_attack_damage
      let next_player_health = player_health - Project.sentinel_attack_damage
      use Cells.put {
        .index = player_health_cell;
        .value = Int.max 1 next_player_health;
      }
      if next_sentinel_health > 0:
        use Cells.put {
          .index = sentinel_health_cell;
          .value = next_sentinel_health;
        }
        use HostEffect.play_audio {
          .cue = "roleplaying.strike";
          .id = "roleplaying.strike";
        }
      if next_sentinel_health <= 0:
        use Cells.put { .index = sentinel_health_cell; .value = 0; }
        use Cells.put { .index = sentinel_defeated_cell; .value = 1; }
        use Cells.put {
          .index = current_beat_cell;
          .value = Project.encounter_beat_order + 1;
        }
        use HostEffect.play_audio {
          .cue = Text.append "roleplaying." Project.encounter_id;
          .id = "roleplaying.sentinel-defeated";
        }
    if event.target == collect_target &&
      current_beat == Project.loot_beat_order &&
      advanced_elapsed >= Project.loot_beat_time_us &&
      sentinel_defeated == 1 && loot_collected == 0:
      use Cells.put { .index = loot_collected_cell; .value = 1; }
      use Cells.put {
        .index = current_beat_cell;
        .value = Project.loot_beat_order + 1;
      }
      use HostEffect.play_audio {
        .cue = Text.append "roleplaying." Project.loot_id;
        .id = "roleplaying.loot-collected";
      }
    if event.target == shrine_travel_target &&
      current_beat == Project.shrine_travel_beat_order &&
      Project.quest_beat_order == Project.shrine_travel_beat_order + 1 &&
      advanced_elapsed >= Project.shrine_travel_beat_time_us &&
      advanced_elapsed >= Project.quest_beat_time_us &&
      loot_collected == 1:
      use Cells.put { .index = region_cell; .value = shrine_region; }
      use Cells.put { .index = completed_cell; .value = 1; }
      use Cells.put {
        .index = current_beat_cell;
        .value = Project.quest_beat_order + 1;
      }
      use HostEffect.play_audio {
        .cue = Text.append "roleplaying." Project.quest_id;
        .id = "roleplaying.shrine-reached";
      }
  use State.commit (state + 1)

if phase == describe_phase:
  use describe_text (
    "roleplaying.quest",
    Project.quest_objective,
    Project.project_name,
    1,
    24
  )
  if talked == 0 && current_beat == Project.dialogue_beat_order:
    use Html.Status {
      .done = False;
      .label = Project.initial_region_label;
      .value = Text.append Project.speaker_label " waits by the ruins road";
    } []
    use describe_button (
      "roleplaying.talk",
      Text.append "Talk to " Project.speaker_label,
      Text.append "Begin dialogue with " Project.speaker_label,
      talk_target,
      10,
      24
    )
  if talked == 1 && current_beat == Project.ruins_travel_beat_order:
    use Html.Status {
      .done = False;
      .label = Project.initial_region_label;
      .value = Text.append "Travel to " Project.ruins_region_label;
    } []
    use describe_text (
      "roleplaying.dialogue",
      Project.dialogue_text,
      Project.speaker_label,
      2,
      68
    )
    use describe_button (
      "roleplaying.travel-ruins",
      Text.append "Travel to " Project.ruins_region_label,
      Project.dialogue_text,
      ruins_travel_target,
      10,
      24
    )
  if sentinel_defeated == 0 && current_beat == Project.encounter_beat_order:
    use Html.Status {
      .done = False;
      .label = Project.sentinel_region_label;
      .value = Text.append
        (Text.append Project.sentinel_label " health ")
        (Text.of_int sentinel_health);
    } []
    use Html.Progress {
      .attachment = Html.viewport_attachment (
        Html.top_left,
        Html.element_size (24, 68)
      );
      .description = Text.append Project.sentinel_label " combat health";
      .element_size = Html.element_size (360, 12);
      .id = "roleplaying.sentinel-health";
      .label = Project.sentinel_label;
      .maximum = Project.sentinel_maximum_health;
      .order = 3;
      .value = sentinel_health;
    } []
    use describe_button (
      "roleplaying.attack",
      Text.append "Attack " Project.sentinel_label,
      Text.append Project.player_label " attacks the ruins guardian",
      attack_target,
      10,
      24
    )
  if sentinel_defeated == 1 && loot_collected == 0 &&
    current_beat == Project.loot_beat_order:
    use Html.Status {
      .done = False;
      .label = "Sentinel defeated";
      .value = Text.append "Collect " Project.loot_entry;
    } []
    use describe_button (
      "roleplaying.collect-loot",
      Text.append "Collect " Project.loot_entry,
      Text.append "Edited loot from " Project.loot_id,
      collect_target,
      10,
      24
    )
  if loot_collected == 1 && current_beat == Project.shrine_travel_beat_order:
    use Html.Status {
      .done = False;
      .label = Project.ruins_region_label;
      .value = Text.append
        (Text.append Project.loot_entry " secured for ")
        Project.shrine_region_label;
    } []
    use describe_button (
      "roleplaying.travel-shrine",
      Text.append "Travel to " Project.shrine_region_label,
      Text.append "Carry " Project.loot_entry,
      shrine_travel_target,
      10,
      24
    )
  if completed == 1:
    use Html.Status {
      .done = True;
      .label = Project.project_name;
      .value = Text.append
        (Text.append Project.loot_entry " offered at ")
        Project.shrine_region_label;
    } []
    use describe_text (
      "roleplaying.outcome",
      Text.append
        (Text.append Project.loot_entry " offered at ")
        Project.shrine_region_label,
      Project.quest_objective,
      20,
      68
    )

if phase == render_phase:
  use render_dungeon (region, sentinel_defeated, loot_collected)

return ()
