open import "../prelude.blot"
open import "@ink/blot/engine.blot"

const Ecs = import "@ink/blot/ecs.blot"
const Scene = import "@ink/blot/scene.blot"
const Project = import "../generated/project.blot"

const Semantic =
  @effect.host {
    .action = { .id = Text; .kind = Int; .label = Text; .target = Int; .value = Int; } -> Unit;
    .status = { .done = Bool; .label = Text; .value = Text; } -> Unit;
  }

const Progress = Ecs.component_1 { .fields = { .stage = Int; }; .name = "Progress"; }
const World = Ecs.indexed_world { .base = 0; .capacity = 1; .components = [Progress]; }
const ProgressStore = Ecs.store (World, Progress)
const Stage = ProgressStore.field 0
const talk_event = 10
const travel_event = 11
const defeat_event = 12
const collect_event = 13
const shrine_event = 14
const restart_event = 15

use phase <- Phase.current ()
use state <- State.current ()
use stage <- Stage.get_or (0, 0)

let reset_progress = fn () => do:
  use ProgressStore.set (0, 0)
  use State.commit 0
  return ()

if phase == schema_phase:
  use World.register ()
  use ProgressStore.seed_source Project.progress_seed

if phase == start_phase:
  use reset_progress ()

if phase == frame_phase:
  use event <- Events.next ()
  if event.kind == talk_event && stage == 0:
    use ProgressStore.set (0, 1)
    use State.commit 1
  if event.kind == travel_event && stage == 1:
    use ProgressStore.set (0, 2)
    use State.commit 2
  if event.kind == defeat_event && stage == 2:
    use ProgressStore.set (0, 3)
    use State.commit 3
  if event.kind == collect_event && stage == 3:
    use ProgressStore.set (0, 4)
    use State.commit 4
  if event.kind == shrine_event && stage == 4:
    use ProgressStore.set (0, 5)
    use State.commit 5
  if event.kind == restart_event:
    use reset_progress ()
  if event.kind < talk_event || event.kind > restart_event:
    use State.commit state

if phase == describe_phase:
  if stage == 0:
    use Semantic.status { .done = False; .label = Project.initial_region; .value = "Talk to the keeper"; }
    use Semantic.action { .id = "talk-keeper"; .kind = talk_event; .label = "Talk to the keeper"; .target = 0; .value = 0; }
  if stage == 1:
    use Semantic.status { .done = False; .label = "Keeper"; .value = Project.keeper_line; }
    use Semantic.action { .id = "travel-ruins"; .kind = travel_event; .label = Project.travel_label; .target = 0; .value = 0; }
  if stage == 2:
    use Semantic.status { .done = False; .label = "Old Ruins"; .value = "The sentinel blocks the cache"; }
    use Semantic.action { .id = "defeat-sentinel"; .kind = defeat_event; .label = "Defeat the sentinel"; .target = 0; .value = 0; }
  if stage == 3:
    use Semantic.status { .done = False; .label = "Ruins cache"; .value = Project.loot_text; }
    use Semantic.action { .id = "collect-loot"; .kind = collect_event; .label = "Collect authored loot"; .target = 0; .value = 0; }
  if stage == 4:
    use Semantic.status { .done = False; .label = "Inventory"; .value = Project.loot_text; }
    use Semantic.action { .id = "reach-shrine"; .kind = shrine_event; .label = "Reach the shrine"; .target = 0; .value = 0; }
  if stage == 5:
    use Semantic.status { .done = True; .label = Project.shrine_label; .value = Project.completed_text; }
  use Semantic.action { .id = "restart"; .kind = restart_event; .label = "Restart pilgrimage"; .target = 0; .value = 0; }

if phase == render_phase:
  use Scene.Render.projection Scene.orthographic
  use Scene.Render.zoom 1000000
  use Scene.Render.directional_light {
    .color_blue = 1000000; .color_green = 1000000; .color_red = 1000000;
    .direction_x = 0; .direction_y = 0; .direction_z = -1000000; .intensity = 0;
  }

return ()
