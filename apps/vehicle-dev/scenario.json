{
  "version": 2,
  "role": "editor_game",
  "editor": "@ink/vehicle-editor",
  "commands": {
    "headless": "pnpm --filter @ink/vehicle-dev scenario:headless",
    "browser": "pnpm --filter @ink/vehicle-dev scenario:browser"
  },
  "edit": "append the finish-line waypoint and checkpoint to the authored course and rebuild the Blot guest",
  "expected_outcome": "reject an out-of-order finish at the canonical collision barrier, visit every checkpoint in authored order, and complete the course with replay checksum and presentation parity",
  "proofs": [
    {
      "package": "@ink/assets",
      "exports": ["./identity.ts"],
      "assertions": ["browser:authored-course-audio-reaches-host"]
    },
    {
      "package": "@ink/audio",
      "exports": ["./device.ts", "./graph.ts", "./mixer.ts", "./model.ts"],
      "assertions": ["browser:authored-course-audio-reaches-host"]
    },
    {
      "package": "@ink/authoring",
      "exports": ["./catalog.ts", "./diagnostics.ts", "./identity.ts"],
      "assertions": ["headless:edited-course-rejects-early-finish-and-replays"]
    },
    {
      "package": "@ink/blot",
      "exports": [
        "./abi.blot",
        "./adapter.ts",
        "./build.ts",
        "./ecs.blot",
        "./engine.blot",
        "./html_canvas.blot",
        "./protocol.ts",
        "./scene.blot"
      ],
      "assertions": [
        "headless:edited-course-rejects-early-finish-and-replays",
        "browser:edited-finish-checkpoint-rebuilds-and-reloads",
        "browser:out-of-order-finish-is-rejected",
        "browser:ordered-course-completes",
        "browser:course-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/development",
      "exports": ["./debugger.ts"],
      "assertions": [
        "headless:edited-course-rejects-early-finish-and-replays",
        "browser:course-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/ecs",
      "exports": ["./blot.ts"],
      "assertions": ["headless:edited-course-rejects-early-finish-and-replays"]
    },
    {
      "package": "@ink/math",
      "exports": ["./vector.ts"],
      "assertions": ["browser:course-matches-headless-presentation"]
    },
    {
      "package": "@ink/observability",
      "exports": ["./observer.ts", "./redaction.ts", "./sink.ts"],
      "assertions": [
        "headless:edited-course-rejects-early-finish-and-replays",
        "browser:course-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/physics",
      "exports": [
        "./collision.ts",
        "./identity.ts",
        "./shapes.ts",
        "./world.ts"
      ],
      "assertions": [
        "headless:physics-blocks-finish-shortcut",
        "browser:physics-blocks-finish-shortcut"
      ]
    },
    {
      "package": "@ink/rendering",
      "exports": ["./renderer.ts"],
      "assertions": [
        "browser:course-matches-headless-presentation",
        "browser:completed-course-renders-non-clear-pixels"
      ]
    },
    {
      "package": "@ink/runtime",
      "exports": ["./session.ts"],
      "assertions": [
        "headless:edited-course-rejects-early-finish-and-replays",
        "browser:course-matches-headless-presentation"
      ]
    },
    {
      "package": "@ink/ui",
      "exports": ["./browser.ts", "./layout.ts"],
      "assertions": ["browser:course-matches-headless-presentation"]
    },
    {
      "package": "@ink/vehicle-editor",
      "exports": [
        "./commands.ts",
        "./identity.ts",
        "./serialization.ts"
      ],
      "assertions": [
        "headless:edited-course-rejects-early-finish-and-replays",
        "browser:edited-finish-checkpoint-rebuilds-and-reloads"
      ]
    },
    {
      "package": "@ink/vite",
      "exports": ["."],
      "assertions": ["browser:edited-finish-checkpoint-rebuilds-and-reloads"]
    }
  ]
}
