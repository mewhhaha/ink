open import "../prelude.blot"
open import "@ink/blot/engine.blot"

const ProjectProvider = import "../generated/project.blot"
const Abi = import "@ink/blot/abi.blot"
const HostEffect = Abi.HostEffect
const Html = import "@ink/blot/html_canvas.blot"
const Scene = import "@ink/blot/scene.blot"
const Ecs = import "@ink/blot/ecs.blot"

use state <- State.current ()
let Project = ProjectProvider.project state

const first_checkpoint_target = 10

const CourseState =
  Ecs.component_3 {
    .fields = {
      .next_checkpoint = Int;
      .rejected_finishes = Int;
      .completed = Int;
    };
    .name = "VehicleCourseState";
  }

const CourseWorld =
  Ecs.indexed_world {
    .base = 0;
    .capacity = 1;
    .components = [CourseState];
  }

const CourseStates = Ecs.store (CourseWorld, CourseState)
const NextCheckpoint = CourseStates.field 0
const RejectedFinishes = CourseStates.field 1
const Completed = CourseStates.field 2
const course_entity = 0
const register_course_world = CourseWorld.register
const seed_course_state = CourseStates.seed [(0, 0, 0)]

let checkpoint_id = fn index => do:
  if index == 0:
    return Project.first_checkpoint_id
  if index == 1:
    return Project.second_checkpoint_id
  if index == 2:
    return Project.third_checkpoint_id
  return Project.fourth_checkpoint_id

let waypoint_id = fn index => do:
  if index == 0:
    return Project.first_waypoint_id
  if index == 1:
    return Project.second_waypoint_id
  if index == 2:
    return Project.third_waypoint_id
  return Project.fourth_waypoint_id

let speed_limit = fn index => do:
  if index == 0:
    return Project.first_speed_limit
  if index == 1:
    return Project.second_speed_limit
  if index == 2:
    return Project.third_speed_limit
  return Project.fourth_speed_limit

let vehicle_x = fn progress => do:
  if progress == 0:
    return Project.first_x - 8000000
  if progress == 1:
    return Project.first_x
  if progress == 2:
    return Project.second_x
  if progress == 3:
    return Project.third_x
  return Project.fourth_x

let vehicle_y = fn progress => do:
  if progress == 0:
    return Project.first_y + 900000
  if progress == 1:
    return Project.first_y + 900000
  if progress == 2:
    return Project.second_y + 900000
  if progress == 3:
    return Project.third_y + 900000
  return Project.fourth_y + 900000

let vehicle_z = fn progress => do:
  if progress == 0:
    return Project.first_z + 4000000
  if progress == 1:
    return Project.first_z
  if progress == 2:
    return Project.second_z
  if progress == 3:
    return Project.third_z
  return Project.fourth_z

let checkpoint_button = fn (index, offset_x) => do:
  let waypoint = waypoint_id index
  let label = Text.append "Drive through " waypoint
  use Html.Button {
    .attachment = Html.viewport_attachment (
      Html.bottom_left,
      Html.element_size (offset_x, 24)
    );
    .description = Text.append
      (Text.append "Checkpoint " (checkpoint_id index))
      (Text.append " · speed limit " (Text.of_int (speed_limit index)));
    .element_size = Html.element_size (210, 44);
    .id = Text.append "vehicle.checkpoint." waypoint;
    .label = label;
    .order = 10 + index;
    .pressed = False;
    .selected = False;
    .target = first_checkpoint_target + index;
  } []
  return ()

let render_course = fn (progress, completed) => do:
  use Scene.PerspectiveCamera {
    .clear_color = Scene.color (6000, 12000, 25000);
    .position = Scene.vec3 (8000000, 48000000, 66000000);
    .target = Scene.vec3 (8000000, 0, 2000000);
    .vertical_fov_microradians = 780000;
  } []
  use Scene.Environment {
    .ambient_light = Scene.color (25000, 45000, 85000);
    .bloom_intensity = 340000;
    .exposure_ev100 = 200000;
    .fog_color = Scene.color (15000, 30000, 75000);
    .fog_density = 6000;
  } []
  use Scene.DirectionalLight {
    .color = Scene.color (720000, 840000, 1000000);
    .direction = Scene.vec3 (-420000, -1000000, -280000);
    .intensity = 1450000;
  } []
  use Scene.Object {
    .id = 1;
    .material = Scene.material {
      .color = Scene.color (70000, 95000, 120000);
    };
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (7000000, -900000, 2000000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (90000000, 1200000, 60000000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 2;
    .material = Scene.material {
      .color = Scene.color (220000, 235000, 250000);
    };
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (7000000, -200000, 2000000),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (82000000, 350000, 9000000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 10;
    .material = Scene.material {
      .color = Scene.color (90000, 540000, 1000000);
      .emissive = 220000;
    };
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (vehicle_x progress, vehicle_y progress, vehicle_z progress),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (3000000, 1400000, 1800000)
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 20;
    .material = Scene.material {
      .color = Scene.color (120000, 920000, 1000000);
      .emissive = 700000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (Project.first_x, Project.first_y + 1500000, Project.first_z),
      Scene.vec3 (0, 0, 0),
      Scene.uniform_scale 900000
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 21;
    .material = Scene.material {
      .color = Scene.color (990000, 560000, 120000);
      .emissive = 650000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (Project.second_x, Project.second_y + 1500000, Project.second_z),
      Scene.vec3 (0, 0, 0),
      Scene.uniform_scale 900000
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 22;
    .material = Scene.material {
      .color = Scene.color (760000, 230000, 1000000);
      .emissive = 650000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (Project.third_x, Project.third_y + 1500000, Project.third_z),
      Scene.vec3 (0, 0, 0),
      Scene.uniform_scale 900000
    );
    .visible = True;
  } []
  use Scene.Object {
    .id = 23;
    .material = Scene.material {
      .color = Scene.color (180000, 1000000, 390000);
      .emissive = 1100000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (Project.fourth_x, Project.fourth_y + 1800000, Project.fourth_z),
      Scene.vec3 (0, 0, 0),
      Scene.uniform_scale 1200000
    );
    .visible = Project.checkpoint_count == 4;
  } []
  use Scene.Object {
    .id = 30;
    .material = Scene.material {
      .color = Scene.color (240000, 1000000, 460000);
      .emissive = 4000000;
    };
    .mesh = 1;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (Project.fourth_x, Project.fourth_y + 5000000, Project.fourth_z),
      Scene.vec3 (0, 0, 0),
      Scene.uniform_scale 1600000
    );
    .visible = completed == 1;
  } []
  use Scene.Object {
    .id = 31;
    .material = Scene.material {
      .color = Scene.color (880000, 180000, 90000);
      .emissive = 180000;
    };
    .mesh = 0;
    .parent = Scene.root;
    .transform = Scene.transform (
      Scene.vec3 (
        Project.shortcut_barrier_x,
        Project.shortcut_barrier_y,
        Project.shortcut_barrier_z
      ),
      Scene.vec3 (0, 0, 0),
      Scene.vec3 (
        Project.shortcut_barrier_width,
        Project.shortcut_barrier_height,
        Project.shortcut_barrier_depth
      )
    );
    .visible = True;
  } []
  return ()

use phase <- Phase.current ()
use next_checkpoint <- NextCheckpoint.get_or (course_entity, 0)
use rejected_finishes <- RejectedFinishes.get_or (course_entity, 0)
use completed <- Completed.get_or (course_entity, 0)

if phase == schema_phase:
  use register_course_world ()
  use seed_course_state ()

if phase == start_phase:
  use State.commit 0

if phase == update_phase:
  use event <- Events.next ()
  let expected_target = first_checkpoint_target + next_checkpoint
  let finish_target = first_checkpoint_target + Project.checkpoint_count - 1
  if event.kind == activate_event && completed == 0:
    if event.target == expected_target:
      let next_progress = next_checkpoint + 1
      use NextCheckpoint.set (course_entity, next_progress)
      if next_progress < Project.checkpoint_count:
        use HostEffect.play_audio {
          .cue = Text.append "vehicle.checkpoint." (waypoint_id next_checkpoint);
          .id = "vehicle.checkpoint-accepted";
        }
      if next_progress == Project.checkpoint_count:
        use Completed.set (course_entity, 1)
        use HostEffect.play_audio {
          .cue = Text.append "vehicle.complete." Project.project_id;
          .id = "vehicle.course-completed";
        }
    if event.target == finish_target && event.target != expected_target &&
      Project.shortcut_barrier_contacts > 0:
      use RejectedFinishes.set (course_entity, rejected_finishes + 1)
      use HostEffect.play_audio {
        .cue = Text.append "vehicle.rejected." (waypoint_id (Project.checkpoint_count - 1));
        .id = "vehicle.finish-rejected";
      }
  use State.commit (state + 1)

if phase == describe_phase:
  use Html.Text {
    .attachment = Html.viewport_attachment (
      Html.top_left,
      Html.element_size (24, 24)
    );
    .description = "Authored ordered checkpoint course";
    .element_size = Html.element_size (620, 28);
    .id = "vehicle.objective";
    .label = Text.append "One-lap course · " Project.vehicle_id;
    .order = 1;
  } []
  if completed == 0:
    use Html.Status {
      .done = False;
      .label = Project.project_name;
      .value = Text.append
        (Text.append "Next " (checkpoint_id next_checkpoint))
        (Text.append " · rejected finishes " (Text.of_int rejected_finishes));
    } []
    use Html.Progress {
      .attachment = Html.viewport_attachment (
        Html.top_left,
        Html.element_size (24, 66)
      );
      .description = "Ordered checkpoint progress";
      .element_size = Html.element_size (420, 12);
      .id = "vehicle.course-progress";
      .label = "Checkpoints";
      .maximum = Project.checkpoint_count;
      .order = 2;
      .value = next_checkpoint;
    } []
    use checkpoint_button (0, 24)
    use checkpoint_button (1, 246)
    use checkpoint_button (2, 468)
    if Project.checkpoint_count == 4:
      use checkpoint_button (3, 690)
  if rejected_finishes > 0:
    use Html.Text {
      .attachment = Html.viewport_attachment (
        Html.top_left,
        Html.element_size (24, 104)
      );
      .description = Text.append
        (Text.append
          "Canonical collision contacts "
          (Text.of_int Project.shortcut_barrier_contacts))
        (Text.append
          " · stopped at x "
          (Text.of_int Project.shortcut_barrier_stop_x));
      .element_size = Html.element_size (620, 28);
      .id = "vehicle.shortcut-collision";
      .label = "Shortcut barrier blocked direct finish";
      .order = 19;
    } []
  if completed == 1:
    use Html.Status {
      .done = True;
      .label = Project.project_name;
      .value = Text.append
        (Text.append "Course complete · checkpoints " (Text.of_int next_checkpoint))
        (Text.append " · rejected finishes " (Text.of_int rejected_finishes));
    } []
    use Html.Text {
      .attachment = Html.viewport_attachment (
        Html.top_left,
        Html.element_size (24, 66)
      );
      .description = Text.append Project.project_id " completed in authored order";
      .element_size = Html.element_size (620, 28);
      .id = "vehicle.outcome";
      .label = "Finish accepted";
      .order = 20;
    } []

if phase == render_phase:
  use render_course (next_checkpoint, completed)

return ()
