{
  "name": "ink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --filter './apps/**' --if-present build",
    "check": "pnpm check:tools && pnpm check:bevy-scene && pnpm check:examples && pnpm check:workspace-manifests && pnpm check:workspace && pnpm check:blot-toolchain && pnpm check:blot-syntax && pnpm -r --if-present check",
    "check:blot-syntax": "deno run --config deno.json --allow-read scripts/toolchains/migrate_blot_syntax.ts --check",
    "check:blot-toolchain": "deno run --config deno.json --allow-read --allow-run=git,deno scripts/toolchains/check_blot_toolchain.ts",
    "check:bevy-scene": "deno run --config deno.json --allow-read scripts/sync_bevy_reference_scene.ts --check",
    "check:examples": "deno run --config deno.json --allow-read scripts/check_examples.ts",
    "check:tools": "deno check --config deno.json scripts/*.ts scripts/toolchains/*.ts scripts/workspace/*.ts",
    "check:workspace": "deno run --config deno.json --allow-read scripts/check_workspace.ts",
    "check:workspace-manifests": "deno run --config deno.json --allow-read scripts/workspace/sync_workspace_manifests.ts --check",
    "dev:dungeon": "pnpm --filter @ink/dungeon-dev dev",
    "dev:lighting": "pnpm --filter @ink/lighting-dev dev",
    "dev:shrubbery": "pnpm --filter @ink/shrubbery-dev dev",
    "dev:visual-novel": "pnpm --filter @ink/visual-novel-dev dev",
    "headless:dungeon": "pnpm --filter @ink/dungeon-dev headless",
    "headless:visual-novel": "pnpm --filter @ink/visual-novel-dev headless",
    "test": "pnpm test:tools && pnpm -r --workspace-concurrency=1 --if-present test",
    "sync:bevy-scene": "deno run --config deno.json --allow-read --allow-write --allow-net=raw.githubusercontent.com scripts/sync_bevy_reference_scene.ts",
    "test:browser:visual-novel": "pnpm --filter @ink/visual-novel-dev test:browser",
    "test:tools": "deno test --config deno.json scripts/*_test.ts scripts/toolchains/*_test.ts scripts/workspace/*_test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
