{
  "name": "ink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --filter './apps/**' --if-present build",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:tools && pnpm check:bevy-scene && pnpm check:workspace-manifests && pnpm check:proof-report && pnpm check:blot-toolchain && pnpm check:workspace && pnpm -r --if-present check",
    "check:blot-toolchain": "deno run --config deno.json --allow-read --allow-run=git,deno,just,pnpm scripts/toolchains/check_blot_toolchain.ts",
    "check:bevy-scene": "deno run --config deno.json --allow-read scripts/sync_bevy_reference_scene.ts --check",
    "check:format": "deno fmt --check",
    "check:lint": "deno lint",
    "check:proof-report": "deno run --config deno.json --allow-read scripts/generate_proof_report.ts --check",
    "check:tools": "deno check --config deno.json scripts/*.ts scripts/toolchains/*.ts scripts/workspace/*.ts",
    "check:workspace": "deno run --config deno.json --allow-read --allow-write --allow-run=/bin/sh scripts/check_workspace.ts",
    "check:workspace-manifests": "deno run --config deno.json --allow-read scripts/workspace/sync_workspace_manifests.ts --check",
    "dev:adventure": "pnpm prepare:blot-development && pnpm --filter @ink/adventure-dev dev",
    "dev:lighting": "pnpm --filter @ink/lighting-dev dev",
    "dev:platformer": "pnpm prepare:blot-development && pnpm --filter @ink/platformer-dev dev",
    "dev:roleplaying": "pnpm prepare:blot-development && pnpm --filter @ink/roleplaying-dev dev",
    "dev:shooter": "pnpm prepare:blot-development && pnpm --filter @ink/shooter-dev dev",
    "dev:shrubbery": "pnpm prepare:blot-development && pnpm --filter @ink/shrubbery-dev dev",
    "dev:strategy": "pnpm prepare:blot-development && pnpm --filter @ink/strategy-dev dev",
    "dev:vehicle": "pnpm prepare:blot-development && pnpm --filter @ink/vehicle-dev dev",
    "dev:visual-novel": "pnpm prepare:blot-development && pnpm --filter @ink/visual-novel-dev dev",
    "generate:proof-report": "deno run --config deno.json --allow-read --allow-write scripts/generate_proof_report.ts",
    "headless:adventure": "pnpm --filter @ink/adventure-dev headless",
    "headless:platformer": "pnpm --filter @ink/platformer-dev headless",
    "headless:roleplaying": "pnpm --filter @ink/roleplaying-dev headless",
    "headless:shooter": "pnpm --filter @ink/shooter-dev headless",
    "headless:strategy": "pnpm --filter @ink/strategy-dev headless",
    "headless:vehicle": "pnpm --filter @ink/vehicle-dev headless",
    "headless:visual-novel": "pnpm --filter @ink/visual-novel-dev headless",
    "test": "pnpm test:tools && pnpm -r --workspace-concurrency=1 --if-present test",
    "sync:bevy-scene": "deno run --config deno.json --allow-read --allow-write --allow-net=raw.githubusercontent.com scripts/sync_bevy_reference_scene.ts",
    "sync:lighting-scenes": "deno run --config deno.json --allow-read --allow-write --allow-net=developer.nvidia.com,developer.download.nvidia.com,github.com --allow-run=blender,git,unzip,usdchecker scripts/sync_lighting_reference_scenes.ts",
    "prepare:blot-development": "pnpm --dir ../blot compiler:build-development-profile && pnpm --dir ../blot package:build",
    "test:browser": "pnpm prepare:blot-development && pnpm -r --workspace-concurrency=1 --filter './apps/**' --if-present test:browser",
    "test:browser:visual-novel": "pnpm prepare:blot-development && pnpm --filter @ink/visual-novel-dev test:browser",
    "test:tools": "deno test --config deno.json --allow-read scripts/*_test.ts scripts/toolchains/*_test.ts scripts/workspace/*_test.ts",
    "verify": "deno run --config deno.json --allow-read --allow-write --allow-run=git,pnpm scripts/verify_workspace.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
