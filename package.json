{
  "name": "ink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm --filter @ink/game-dev build && pnpm --filter @ink/isometric-city-dev build",
    "check": "pnpm -r --if-present check",
    "dev": "pnpm --filter @ink/game-dev dev",
    "dev:city": "pnpm --filter @ink/isometric-city-dev dev",
    "headless": "pnpm --filter @ink/game-dev headless",
    "headless:city": "pnpm --filter @ink/isometric-city-dev headless",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test"
  },
  "workspaces": ["apps/*", "packages/*"],
  "catalog": {
    "@comp0/react": "0.1.0-next.0",
    "@heroicons/react": "2.2.0",
    "@mewhhaha/typeclasses": "npm:@jsr/mewhhaha__typeclasses@0.8.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.12.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "vite": "8.2.0"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
