import { Vec2, Vec3 } from "std/vector"
import * as math from "./math"
import * as random from "./random"

// A particle's position (x, y, z) and velocity (vx, vy, vz), its age and
// lifetime in seconds, full size, rotation in radians and seed. A flat record
// of scalars, so an array of particles stores their fields in place, with no
// object per particle or per vector.
type Particle = { x: F32, y: F32, z: F32, vx: F32, vy: F32, vz: F32, age: F32, lifetime: F32, size: F32, rotation: F32, seed: U32 }
type Emitter is data = $Emitter { position: Vec3, velocity: Vec3, spread: Vec3, lifetime: F32, lifetime_spread: F32, size: F32 }
type Emission is data = $Emission { seed: U32, particles: #[Particle] }

func position (p: Particle) => math.vec3 p.x p.y p.z

func velocity (p: Particle) => math.vec3 p.vx p.vy p.vz

const max_emit_count: U32 = 65536

private func wrap_angle (angle: F32) : F32 =>
  if not (is_finite angle):
    return 0.0
  if abs angle <= 8192.0:
    return angle
  if abs angle > 1.0e30:
    return 0.0
  return wrap tau angle

// Uniform velocity jitter per axis; no hidden random stream.
func emit (seed: U32) => func (count: U32) => func (e: Emitter) =>
  if count > max_emit_count:
    return $Emission { seed, particles: #[] }
  let state = seed
  let at = e.position
  let base = e.velocity
  let spread = e.spread
  let blank: Particle = { x: at.x, y: at.y, z: at.z, vx: base.x, vy: base.y, vz: base.z, age: 0.0, lifetime: e.lifetime, size: e.size, rotation: 0.0, seed }
  let result = @array.fill count blank
  for i in 0..count:
    state := random.next self
    let x = random.unit state * 2.0 - 1.0
    state := random.next self
    let y = random.unit state * 2.0 - 1.0
    state := random.next self
    let z = random.unit state * 2.0 - 1.0
    state := random.next self
    let lifetime = max 0.0 (e.lifetime + (random.unit state * 2.0 - 1.0) * e.lifetime_spread)
    state := random.next self
    let rotation = random.unit state * 6.2831853
    let particle: Particle = { x: at.x, y: at.y, z: at.z, vx: base.x + x * spread.x, vy: base.y + y * spread.y, vz: base.z + z * spread.z, age: 0.0, lifetime, size: e.size, rotation, seed: state }
    result[i] := particle
  return $Emission { seed: state, particles: result }
// Exact constant-acceleration step. Dead particles are removed in stable order:
// one pass counts the survivors, a second fills an array of exactly that size.
func update (particles: #[Particle]) => func (acceleration: Vec3) => func (dt: F32) =>
  if dt <= 0.0 or not (is_finite dt):
    return particles.copy
  let count = 0
  for p in particles:
    if p.age + dt < p.lifetime:
      count := self + 1
  if count == 0:
    let none: #[Particle] = #[]
    return none
  // The step's drift and velocity change are the same for every particle.
  let half = 0.5 * dt * dt
  let drift_x = acceleration.x * half
  let drift_y = acceleration.y * half
  let drift_z = acceleration.z * half
  let gain_x = acceleration.x * dt
  let gain_y = acceleration.y * dt
  let gain_z = acceleration.z * dt
  let alive = @array.fill count particles[0]
  let index = 0
  for p in particles:
    let age = p.age + dt
    if age < p.lifetime:
      let next: Particle = {
        x: p.x + p.vx * dt + drift_x, y: p.y + p.vy * dt + drift_y, z: p.z + p.vz * dt + drift_z,
        vx: p.vx + gain_x, vy: p.vy + gain_y, vz: p.vz + gain_z,
        age, lifetime: p.lifetime, size: p.size, rotation: p.rotation, seed: p.seed,
      }
      alive[index] := next
      index := self + 1
  return alive
// Sprite animation, seeded initial phase; count=0 returns 0. Time in seconds.
func frame (seed: U32) => func (age: F32) => func (fps: F32) => func (count: U32) => func (looping: Bool) =>
  if count == 0:
    return 0
  let raw = age * fps
  if not (is_finite raw) or raw <= 0.0:
    return if looping then seed % count else 0
  let step = floor raw
  if looping:
    let phase = U32.to_f32 (seed % count)
    let wrapped = F32.wrap (U32.to_f32 count) (step + phase)
    if not (is_finite wrapped) or wrapped < 0.0:
      return seed % count
    if wrapped >= 4294967040.0:
      return count - 1
    return min (count - 1) (F32.to_u32 wrapped)
  let top = U32.to_f32 (count - 1)
  if step >= top or step >= 4294967040.0:
    return count - 1
  return min (count - 1) (F32.to_u32 step)

// Four corners, bottom-left/right then top-right/left. Orientation supplies
// camera right/up; rotation is radians in that plane. Size is full width/height.
func billboard (position: Vec3) => func (orientation: math.Quat) => func (size: Vec2) => func (rotation: F32) =>
  if not (math.finite3 position and math.finite_quat orientation and is_finite size.x and is_finite size.y and is_finite rotation):
    return #[]
  let q = math.Quat.normalized orientation
  let right = math.Quat.rotate q math.right
  let up = math.Quat.rotate q math.up
  let (s, c) = sin_cos (wrap_angle rotation)
  let x = (right * c + up * s) * (size.x * 0.5)
  let y = (up * c - right * s) * (size.y * 0.5)
  return #[position - x - y, position + x - y, position + x + y, position - x + y]

func atlas_count (columns: U32) => func (rows: U32) =>
  if columns == 0 or rows == 0:
    return 0
  if rows > 4294967295 / columns:
    return 0
  return columns * rows
// Row-major frames and top-left texture origin, matching billboard corner order.
// Frame wraps around the atlas; invalid/overflowing grids return an empty array.
func atlas_uv (frame: U32) => func (columns: U32) => func (rows: U32) =>
  let count = atlas_count columns rows
  if count == 0:
    return #[]
  let index = frame % count
  let x = U32.to_f32 (index % columns)
  let y = U32.to_f32 (index / columns)
  let width = U32.to_f32 columns
  let height = U32.to_f32 rows
  let u0 = x / width
  let u1 = (x + 1.0) / width
  let v0 = y / height
  let v1 = (y + 1.0) / height
  return #[math.vec2 u0 v1, math.vec2 u1 v1, math.vec2 u1 v0, math.vec2 u0 v0]

// Triangle-list xyz uv rgba, six vertices per particle, nine floats per vertex.
// Front winding faces camera-local +Z. Caller controls tint/alpha and sorting.
// Particle.size is full square width; atlas frames use explicit seconds/fps.
func vertices (particles: #[Particle]) => func (orientation: math.Quat) => func (columns: U32) => func (rows: U32) => func (fps: F32) => func (looping: Bool) => func (tint: math.Color) =>
  let count = atlas_count columns rows
  if count == 0 or particles.length > 4294967295 / 54 or not (math.finite_quat orientation):
    return #[]
  for p in particles:
    if not (is_finite p.rotation):
      return #[]
  let q = math.Quat.normalized orientation
  let right = math.Quat.rotate q math.right
  let up = math.Quat.rotate q math.up
  let width = U32.to_f32 columns
  let height = U32.to_f32 rows
  let result = @array.fill (particles.length * 54) 0.0
  for i in 0..particles.length:
    let p = particles[i]
    let (s, c) = sin_cos (wrap_angle p.rotation)
    let x = (right * c + up * s) * (p.size * 0.5)
    let y = (up * c - right * s) * (p.size * 0.5)
    let index = frame p.seed p.age fps count looping
    let column = U32.to_f32 (index % columns)
    let row = U32.to_f32 (index / columns)
    let u0 = column / width
    let u1 = (column + 1.0) / width
    let v0 = row / height
    let v1 = (row + 1.0) / height
    for vertex in 0..6:
      let xs = (-1.0)
      let ys = (-1.0)
      let u = u0
      let v = v1
      if vertex == 1 or vertex == 2 or vertex == 4:
        xs := 1.0
        u := u1
      if vertex == 2 or vertex == 4 or vertex == 5:
        ys := 1.0
        v := v0
      let offset = i * 54 + vertex * 9
      result[offset] := p.x + x.x * xs + y.x * ys
      result[offset + 1] := p.y + x.y * xs + y.y * ys
      result[offset + 2] := p.z + x.z * xs + y.z * ys
      result[offset + 3] := u
      result[offset + 4] := v
      result[offset + 5] := tint.r
      result[offset + 6] := tint.g
      result[offset + 7] := tint.b
      result[offset + 8] := tint.a
  return result
