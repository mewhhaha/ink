import * as array from "std/array"
import * as app from "./app"
import * as ecs from "./ecs"
import * as lanes from "./lanes"
import * as sort from "./sort"
import * as window from "./events"

// `held` lists keys and `buttons` pointer buttons that are down (0 primary,
// 1 middle, 2 secondary). `just_pressed` lists the keys the event being
// delivered pressed, so event systems see each press once even if the host
// repeats KeyDown, and `dx`/`dy` is that event's pointer motion. `claimed`
// says an earlier system took the event being delivered (`claim`), so later
// ones leave it alone, so a claimed click reaches only its owning tool.
type Input is data = #Input { held: Array U32, just_pressed: Array U32, buttons: Array U32, x: F32, y: F32, dx: F32, dy: F32, claimed: Bool }

const max_held = 512
const primary = 0
const middle = 1
const secondary = 2

const empty = #Input { held: #[], just_pressed: #[], buttons: #[], x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, claimed: #False }

const contains = fn (values: Array U32) => fn (wanted: U32) => do:
  for value in values:
    if value == wanted:
      return #True
  return #False

// `values` without `unwanted`, counted then filled; unchanged when absent.
const without = fn (values: Array U32) => fn (unwanted: U32) => do:
  let count = 0
  for value in values:
    if value != unwanted:
      count := self + 1
  if count == values.length:
    return values
  let kept = array.fill count 0
  let at = 0
  for value in values:
    if value != unwanted:
      kept[at] := value
      at := self + 1
  return kept

const pressed = fn (controls: Input) => fn key => contains controls.held key
const just_pressed = fn (controls: Input) => fn key => contains controls.just_pressed key
const button_held = fn (controls: Input) => fn button => contains controls.buttons button

// 1 when only `positive` is held, -1 when only `negative` is, otherwise 0.
const axis = fn controls => fn negative => fn positive => do:
  let low = 0.0
  let high = 0.0
  if pressed controls negative:
    low := 1.0
  if pressed controls positive:
    high := 1.0
  return high - low

// Each event builds the next Input once: a chain of field updates would
// rebuild the whole record at every step.
const apply = fn (controls: Input) => fn event => do:
  let #Input { held, buttons, x, y } = controls
  let none: Array U32 = #[]
  return case event of
    #window.KeyDown key => do:
      if contains held key:
        return #Input { held, just_pressed: none, buttons, x, y, dx: 0.0, dy: 0.0, claimed: #False }
      return #Input { held: array.push key held, just_pressed: #[key], buttons, x, y, dx: 0.0, dy: 0.0, claimed: #False }
    #window.KeyUp key => #Input { held: without held key, just_pressed: none, buttons, x, y, dx: 0.0, dy: 0.0, claimed: #False }
    #window.PointerMove { x: to_x, y: to_y } =>
      #Input { held, just_pressed: none, buttons, x: to_x, y: to_y, dx: to_x - x, dy: to_y - y, claimed: #False }
    #window.PointerDown { button, x: to_x, y: to_y } => do:
      let down = buttons
      if Bool.not (contains buttons button):
        down := array.push button self
      return #Input { held, just_pressed: none, buttons: down, x: to_x, y: to_y, dx: to_x - x, dy: to_y - y, claimed: #False }
    #window.PointerUp { button, x: to_x, y: to_y } =>
      #Input { held, just_pressed: none, buttons: without buttons button, x: to_x, y: to_y, dx: to_x - x, dy: to_y - y, claimed: #False }
    // Every key and button lets go, but the pointer is where it was, e.g. when
    // the host's console takes the keys.
    #window.FocusLost => #Input { held: none, just_pressed: none, buttons: none, x, y, dx: 0.0, dy: 0.0, claimed: #False }
    #window.SessionStarted {} => #Input { held: none, just_pressed: none, buttons: none, x, y, dx: 0.0, dy: 0.0, claimed: #False }
    _ => #Input { held, just_pressed: none, buttons, x, y, dx: 0.0, dy: 0.0, claimed: #False }

const receive = fn (context: app.EventContext) => do:
  use controls <- ecs.get #Input
  return ecs.set (apply controls context.event)

// Paused, Event systems wait, but a menu and a cursor drawn for the pointer
// still need the keys and the pointer: Input follows the events the game waits
// through, before the Interface systems of plugins added after this one.
const follow = fn (context: app.EventContext) => do:
  // A saved key/button is not physically held in the new session. Clear it
  // before a startup interface can pause the world and skip Event systems.
  if let #window.SessionStarted {} = context.event:
    return receive context
  use waiting <- app.paused ()
  if Bool.not waiting:
    return ()
  return receive context

// Takes the event being delivered, so later systems leave it alone.
const claim = fn () => do:
  use controls <- ecs.get #Input
  controls.claimed := #True
  return ecs.set controls

// Whether an earlier system took the event being delivered.
const claimed = fn () => do:
  use controls <- ecs.get #Input
  return controls.claimed

// Lanes: x, y, the last event's motion (dx, dy) and claim, the keys it
// pressed (count, then keys), the keys held (count, then keys), then the
// buttons. What the last event left lasts until the next event: Update
// systems read the motion, and Interface systems the claim before this
// plugin's own systems take the next event.
const encode = fn (controls: Input) => do:
  let fresh = controls.just_pressed
  let held = controls.held
  let buttons = controls.buttons
  let held_at = 6 + fresh.length
  let buttons_at = held_at + 1 + held.length
  let written = array.fill (buttons_at + buttons.length) 0.0
  written[0] := controls.x
  written[1] := controls.y
  written[2] := controls.dx
  written[3] := controls.dy
  written[4] := lanes.bit controls.claimed
  written[5] := U32.to_f32 fresh.length
  for index in 0 .. fresh.length:
    written[6 + index] := U32.to_f32 fresh[index]
  written[held_at] := U32.to_f32 held.length
  for index in 0 .. held.length:
    written[held_at + 1 + index] := U32.to_f32 held[index]
  for index in 0 .. buttons.length:
    written[buttons_at + index] := U32.to_f32 buttons[index]
  return written

const unique = fn (values: Array U32) => do:
  // Small sets and early duplicates need no sorting. Order indices only so
  // decoded keys retain their authored order.
  for index in 0 .. min values.length 16:
    for previous in 0 .. index:
      use lanes.require (values[previous] != values[index])
  if values.length > 16:
    let ordered = sort.order_u32 values
    for index in 1 .. ordered.length:
      use lanes.require (values[ordered[index - 1]] != values[ordered[index]])

const key_of = fn (value: F32) => lanes.integer value lanes.max_integer

const decode = fn (values: Array F32) => do:
  use lanes.require (values.length >= 7 && values.length <= 7 + max_held * 2 + 8)
  use lanes.finite values
  let pressed_count = lanes.integer values[5] max_held
  let held_at = 6 + pressed_count
  use lanes.require (held_at < values.length)
  let count = lanes.integer values[held_at] max_held
  use lanes.require (held_at + 1 + count <= values.length)
  use lanes.require (values.length - held_at - 1 - count <= 8)
  let fresh = array.generate pressed_count (fn index => key_of values[6 + index])
  let keys = array.generate count (fn index => key_of values[held_at + 1 + index])
  let buttons_at = held_at + 1 + count
  let buttons = array.generate (values.length - buttons_at) (fn index => lanes.integer values[buttons_at + index] 7)
  use unique keys
  use unique buttons
  return #Input {
    held: keys, just_pressed: fresh, buttons, x: values[0], y: values[1], dx: values[2], dy: values[3],
    claimed: lanes.flag values[4],
  }

// Version 1 kept no motion, claim or pressed keys: none.
const migrate = fn (version: U32) => case version of
  1 => #Some (lanes.insert 2 #[0.0, 0.0, 0.0, 0.0])
  _ => #Nothing

const codec = #lanes.Codec { key: 3, version: 2, encode, decode, migrate }

const plugin = fn builder => do:
  builder := app.insert_resource codec empty self
  builder := app.add_system #app.Interface follow self
  builder := app.add_system #app.Event receive self
  return builder
