import * as array from "std/array"
import * as lanes from "./lanes"
import * as window from "./events"

// State and key/button owners are separately named by the application. Input
// is a borrowed event snapshot, consumed before the next receive or restore.
type Pointer is data = $Pointer {x: F32, y: F32, dx: F32, dy: F32, claimed: Bool}
type Input is data = $Input {held: &[U32], just_pressed: &[U32], buttons: &[U32], x: F32, y: F32, dx: F32, dy: F32, claimed: Bool}
const max_held = 512
const primary = 0
const middle = 1
const secondary = 2
const initial = $Pointer {x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, claimed: false}
func contains values -> wanted =>
  for value in values:
    if value == wanted:
      return true
  return false
func pressed (controls: Input) -> key => contains controls.held key
func just_pressed (controls: Input) -> key => contains controls.just_pressed key
func button_held (controls: Input) -> button => contains controls.buttons button
func axis controls -> negative -> positive => return
  (if pressed controls positive then 1.0 else 0.0) - (if pressed controls negative then 1.0 else 0.0)
func read (state: #[Pointer]) -> (held: #[~U32]) -> (fresh: #[~U32]) -> (buttons: #[~U32]) =>
  let pointer = state[0]
  return $Input {held: &held[0..held.length], just_pressed: &fresh[0..fresh.length], buttons: &buttons[0..buttons.length],
    x: pointer.x, y: pointer.y, dx: pointer.dx, dy: pointer.dy, claimed: pointer.claimed}
func remove (values: #[~U32]) -> unwanted =>
  let count = values.length
  let kept = 0
  for index in 0 .. count:
    if values[index] != unwanted:
      values[kept] = values[index]
      kept := self + 1
  @storage.truncate values kept
  return ()
func claim (state: #[Pointer]) =>
  state[0].claimed = true
  return ()
func claimed (state: #[Pointer]) => state[0].claimed
// Exact event order is explicit. Repeated KeyDown does not emit a fresh press.
func receive (state: #[Pointer]) -> (held: #[~U32]) -> (fresh: #[~U32]) -> (buttons: #[~U32]) -> event =>
  @storage.truncate fresh 0
  let pointer = state[0]
  pointer.dx := 0.0
  pointer.dy := 0.0
  pointer.claimed := false
  case event of
    $window.KeyDown key => do:
      if not (contains held key):
        if held.length >= max_held:
          return panic "input held-key budget exhausted"
        @storage.push held key
        @storage.push fresh key
    $window.KeyUp key => remove held key
    $window.PointerMove {x, y} => do:
      pointer.dx := x - pointer.x
      pointer.dy := y - pointer.y
      pointer.x := x
      pointer.y := y
    $window.PointerDown {button, x, y} => do:
      if not (contains buttons button):
        @storage.push buttons button
      pointer.dx := x - pointer.x
      pointer.dy := y - pointer.y
      pointer.x := x
      pointer.y := y
    $window.PointerUp {button, x, y} => do:
      remove buttons button
      pointer.dx := x - pointer.x
      pointer.dy := y - pointer.y
      pointer.x := x
      pointer.y := y
    $window.Wheel {x, y} => do:
      pointer.x := x
      pointer.y := y
    $window.FocusLost | $window.SessionStarted {} => do:
      @storage.truncate held 0
      @storage.truncate buttons 0
    _ => ()
  state[0] = pointer
  return ()

// Lanes: x, y, the last event's motion (dx, dy) and claim, the keys it
// pressed (count, then keys), the keys held (count, then keys), then the
// buttons. State lasts until the next event; Interface and Event systems
// read the same motion and claim.
func encode (controls: Input) =>
  let fresh = controls.just_pressed
  let held = controls.held
  let buttons = controls.buttons
  let held_at = 6 + fresh.length
  let buttons_at = held_at + 1 + held.length
  let written = array.fill (buttons_at + buttons.length) 0.0
  written[0] := controls.x
  written[1] := controls.y
  written[2] := controls.dx
  written[3] := controls.dy
  written[4] := lanes.bit controls.claimed
  written[5] := U32.to_f32 fresh.length
  for index in 0 .. fresh.length:
    written[6 + index] := U32.to_f32 fresh[index]
  written[held_at] := U32.to_f32 held.length
  for index in 0 .. held.length:
    written[held_at + 1 + index] := U32.to_f32 held[index]
  for index in 0 .. buttons.length:
    written[buttons_at + index] := U32.to_f32 buttons[index]
  return written

// Decode validates all lanes before touching live owners. Restore resets this
// event's transient presses/claim only when the caller selects that policy.
func decode_into (values: #[F32]) -> (state: #[Pointer]) -> (held: #[~U32]) -> (fresh: #[~U32]) -> (buttons: #[~U32]) =>
  lanes.require (values.length >= 7 and values.length <= 7 + max_held * 2 + 8)
  lanes.finite values
  let fresh_count = lanes.integer values[5] max_held
  let held_at = 6 + fresh_count
  lanes.require (held_at < values.length)
  let held_count = lanes.integer values[held_at] max_held
  let buttons_at = held_at + 1 + held_count
  lanes.require (buttons_at <= values.length and values.length - buttons_at <= 8)
  let fresh_values = array.generate fresh_count (func i => lanes.integer values[6 + i] lanes.max_integer)
  let held_values = array.generate held_count (func i => lanes.integer values[held_at + 1 + i] lanes.max_integer)
  let button_values = array.generate (values.length - buttons_at) (func i => lanes.integer values[buttons_at + i] 7)
  for index in 0 .. held_values.length:
    for before in 0 .. index:
      lanes.require (held_values[index] != held_values[before])
  for index in 0 .. button_values.length:
    for before in 0 .. index:
      lanes.require (button_values[index] != button_values[before])
  let pointer = $Pointer {x: values[0], y: values[1], dx: values[2], dy: values[3], claimed: lanes.flag values[4]}
  @storage.truncate held 0
  @storage.truncate fresh 0
  @storage.truncate buttons 0
  for value in held_values:
    @storage.push held value
  for value in fresh_values:
    @storage.push fresh value
  for value in button_values:
    @storage.push buttons value
  state[0] = pointer
  return ()
