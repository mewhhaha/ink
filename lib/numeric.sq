//! Zero-abstraction consumer-controlled NaN / non-finite handling for Squid & Ink.
//!
//! Combines four zero-overhead layers so callers choose exact cost and recovery:
//!   1. Unboxed opaque validated scalars (`Finite`, `NonZeroFinite`, `UnitF32`)
//!      which lower directly to raw Wasm `f32` registers (`Kind.floating32`).
//!   2. Zero-sized compile-time `NanPolicy` traits (`FastIeee`, `Fallback`,
//!      `StrictTrap`, or caller-defined policies) — static monomorphization,
//!      zero vtables, usable inside pure `spark` SIMD loops and `#kernel`.
//!   3. Scoped `Numeric` algebraic effect (`with Numeric = { non_finite: ... }:`)
//!      whose happy path never touches the effect runtime; consumers choose
//!      dev traps, playtest telemetry logging, or release recovery per scope.
//!   4. Compile-time `#for field in #fields t:` record validators/sanitizers that
//!      name the exact offending `field.name` with zero runtime reflection.
//!
//! Key items: [`NanPolicy`], [`FiniteField`], [`Numeric`], [`Finite`], [`min_finite`].
//!
//! ```squid
//! import * as numeric from "ink/numeric"
//! let dt = numeric.Finite.from_or numeric.Finite.zero 2.0
//! let mass = numeric.NonZeroFinite.from_or numeric.NonZeroFinite.one 4.0
//! let safe = numeric.div_with numeric.fallback 0.0 1.0 0.0
//! let recovered = numeric.run_fallback (func () => numeric.div (-1.0) 1.0 0.0)
//! #[numeric.Finite.div_by dt mass, safe, recovered] // => #[0.5, 0.0, -1.0]
//! ```

import { Vec2, Vec3 } from "std/vector"
import * as codec from "./codec"
import * as color from "./color"
import * as math from "./math"

// --- Fault site tags (callers may use custom tags >= 1000) ---

const site_generic: U32 = 0
const site_div: U32 = 1
const site_sqrt: U32 = 2
const site_trig: U32 = 3
const site_normalize: U32 = 4
const site_unlerp: U32 = 5
const site_acos: U32 = 6
const site_asin: U32 = 7
const site_atan2: U32 = 8
const site_log: U32 = 9
const site_pow: U32 = 10
const site_boundary: U32 = 11
const site_record: U32 = 100

// --- Layer 1: Unboxed zero-cost validated scalar types (opaque = F32) ---

// Guaranteed finite F32 (never NaN, never +/-Inf). Unboxed raw Wasm `f32`.
type Finite is opaque = F32

// Guaranteed finite and non-zero F32 (`abs x > 0.0`). Unboxed raw Wasm `f32`.
type NonZeroFinite is opaque = F32

// Guaranteed finite F32 in `[0.0, 1.0]`. Unboxed raw Wasm `f32`.
type UnitF32 is opaque = F32

const Finite.zero: Finite = $Finite 0.0
const Finite.one: Finite = $Finite 1.0

func Finite.value (x: Finite): F32 =>
  let $Finite v = x
  return v

func Finite.try_from (x: F32): Maybe Finite =>
  if is_finite x:
    return $Some ($Finite x)
  return $Nothing

func Finite.from_or (fallback: Finite) -> (x: F32): Finite =>
  if is_finite x:
    return $Finite x
  return fallback

func Finite.expect (x: F32): Finite =>
  if is_finite x:
    return $Finite x
  return panic "numeric: expected finite F32"

// Closed operations on `Finite` that can never produce NaN or Inf.
func Finite.neg (x: Finite): Finite =>
  let $Finite v = x
  return $Finite (F32.neg v)

func Finite.abs (x: Finite): Finite =>
  let $Finite v = x
  return $Finite (F32.abs v)

func Finite.min (a: Finite) -> (b: Finite): Finite =>
  let $Finite va = a
  let $Finite vb = b
  return $Finite (if va < vb then va else vb)

func Finite.max (a: Finite) -> (b: Finite): Finite =>
  let $Finite va = a
  let $Finite vb = b
  return $Finite (if va > vb then va else vb)

func Finite.clamp (low: Finite) -> (high: Finite) -> (x: Finite): Finite =>
  let $Finite lo = low
  let $Finite hi = high
  let $Finite v = x
  let a = if lo < hi then lo else hi
  let b = if lo < hi then hi else lo
  return $Finite (clamp a b v)

func Finite.add_or (fallback: Finite) -> (a: Finite) -> (b: Finite): Finite =>
  let $Finite va = a
  let $Finite vb = b
  return Finite.from_or fallback (va + vb)

func Finite.sub_or (fallback: Finite) -> (a: Finite) -> (b: Finite): Finite =>
  let $Finite va = a
  let $Finite vb = b
  return Finite.from_or fallback (va - vb)

func Finite.mul_or (fallback: Finite) -> (a: Finite) -> (b: Finite): Finite =>
  let $Finite va = a
  let $Finite vb = b
  return Finite.from_or fallback (va * vb)

func Finite.div_or (fallback: Finite) -> (a: Finite) -> (b: Finite): Finite =>
  let $Finite va = a
  let $Finite vb = b
  return Finite.from_or fallback (va / vb)

func Finite.div_by (a: Finite) -> (b: NonZeroFinite): F32 =>
  let $Finite va = a
  let $NonZeroFinite vb = b
  return va / vb

func Finite.sqrt_or (fallback: Finite) -> (x: Finite): Finite =>
  let $Finite v = x
  if v < 0.0:
    return fallback
  return $Finite (sqrt v)

const NonZeroFinite.one: NonZeroFinite = $NonZeroFinite 1.0

func NonZeroFinite.value (x: NonZeroFinite): F32 =>
  let $NonZeroFinite v = x
  return v

func NonZeroFinite.as_finite (x: NonZeroFinite): Finite =>
  let $NonZeroFinite v = x
  return $Finite v

func NonZeroFinite.try_from (x: F32): Maybe NonZeroFinite =>
  if is_finite x and x != 0.0:
    return $Some ($NonZeroFinite x)
  return $Nothing

func NonZeroFinite.from_or (fallback: NonZeroFinite) -> (x: F32): NonZeroFinite =>
  if is_finite x and x != 0.0:
    return $NonZeroFinite x
  return fallback

func NonZeroFinite.expect (x: F32): NonZeroFinite =>
  if is_finite x and x != 0.0:
    return $NonZeroFinite x
  return panic "numeric: expected finite non-zero F32"

const UnitF32.zero: UnitF32 = $UnitF32 0.0
const UnitF32.one: UnitF32 = $UnitF32 1.0

func UnitF32.value (x: UnitF32): F32 =>
  let $UnitF32 v = x
  return v

func UnitF32.as_finite (x: UnitF32): Finite =>
  let $UnitF32 v = x
  return $Finite v

func UnitF32.try_from (x: F32): Maybe UnitF32 =>
  if is_finite x and x >= 0.0 and x <= 1.0:
    return $Some ($UnitF32 x)
  return $Nothing

func UnitF32.clamp_or (fallback: UnitF32) -> (x: F32): UnitF32 =>
  if is_finite x:
    return $UnitF32 (clamp 0.0 1.0 x)
  return fallback

func UnitF32.invert (x: UnitF32): UnitF32 =>
  let $UnitF32 v = x
  return $UnitF32 (1.0 - v)

func UnitF32.lerp (a: Finite) -> (b: Finite) -> (t: UnitF32): F32 =>
  let $Finite va = a
  let $Finite vb = b
  let $UnitF32 wt = t
  return F32.lerp va vb wt

// Ink codec & lane instances for validated opaque scalars.
private func decode_finite_lanes (values: #[F32]) -> (at: U32): Maybe (Finite, U32) =>
  let $Some (v, next) = codec.read_lane_f32 values at else:
    return $Nothing
  return $Some ($Finite v, next)

private func decode_nonzero_words (words: #[U32]): Maybe NonZeroFinite =>
  let $Some v = codec.float_decode words else:
    return $Nothing
  return NonZeroFinite.try_from v

private func decode_nonzero_lanes (values: #[F32]) -> (at: U32): Maybe (NonZeroFinite, U32) =>
  let $Some (v, next) = codec.read_lane_f32 values at else:
    return $Nothing
  let $Some nz = NonZeroFinite.try_from v else:
    return $Nothing
  return $Some (nz, next)

private func decode_unit_words (words: #[U32]): Maybe UnitF32 =>
  let $Some v = codec.float_decode words else:
    return $Nothing
  return UnitF32.try_from v

private func decode_unit_lanes (values: #[F32]) -> (at: U32): Maybe (UnitF32, U32) =>
  let $Some (v, next) = codec.read_lane_f32 values at else:
    return $Nothing
  let $Some u = UnitF32.try_from v else:
    return $Nothing
  return $Some (u, next)

const Finite.Codec: codec.Codec Finite = {
  encode: func x => codec.float_encode (Finite.value x),
  decode: func words => Maybe.map (func v => $Finite v) (codec.float_decode words),
}

const Finite.LaneEncode: codec.LaneEncode Finite = {
  to_lanes: func x => #[Finite.value x],
}

const Finite.LaneDecode: codec.LaneDecode Finite = {
  lane_width: func _ => 1,
  from_lanes: decode_finite_lanes,
}

const NonZeroFinite.Codec: codec.Codec NonZeroFinite = {
  encode: func x => codec.float_encode (NonZeroFinite.value x),
  decode: decode_nonzero_words,
}

const NonZeroFinite.LaneEncode: codec.LaneEncode NonZeroFinite = {
  to_lanes: func x => #[NonZeroFinite.value x],
}

const NonZeroFinite.LaneDecode: codec.LaneDecode NonZeroFinite = {
  lane_width: func _ => 1,
  from_lanes: decode_nonzero_lanes,
}

const UnitF32.Codec: codec.Codec UnitF32 = {
  encode: func x => codec.float_encode (UnitF32.value x),
  decode: decode_unit_words,
}

const UnitF32.LaneEncode: codec.LaneEncode UnitF32 = {
  to_lanes: func x => #[UnitF32.value x],
}

const UnitF32.LaneDecode: codec.LaneDecode UnitF32 = {
  lane_width: func _ => 1,
  from_lanes: decode_unit_lanes,
}

// --- NaN-symmetric helpers & geometry finite predicates ---

// Unlike prelude `min`/`max` (which select the right operand on NaN), these
// always prefer the finite operand or return `fallback` if neither is finite.
func min_finite (fallback: F32) -> (a: F32) -> (b: F32): F32 =>
  let fa = is_finite a
  let fb = is_finite b
  if fa and fb:
    return if a < b then a else b
  if fa:
    return a
  if fb:
    return b
  return fallback

func max_finite (fallback: F32) -> (a: F32) -> (b: F32): F32 =>
  let fa = is_finite a
  let fb = is_finite b
  if fa and fb:
    return if a > b then a else b
  if fa:
    return a
  if fb:
    return b
  return fallback

func clamp_finite (fallback: F32) -> (low: F32) -> (high: F32) -> (x: F32): F32 =>
  if not (is_finite x and is_finite low and is_finite high):
    return fallback
  let lo = if low < high then low else high
  let hi = if low < high then high else low
  return clamp lo hi x

func finite2 (v: Vec2): Bool => is_finite v.x and is_finite v.y
func finite3 (v: Vec3): Bool => math.finite3 v
func finite4 (v: math.Vec4): Bool => is_finite v.x and is_finite v.y and is_finite v.z and is_finite v.w
func finite_quat (q: math.Quat): Bool => math.finite_quat q
func finite_color (c: math.Color): Bool => is_finite c.r and is_finite c.g and is_finite c.b and is_finite c.a
func finite_ray (r: math.Ray): Bool => math.finite3 r.origin and math.finite3 r.direction
func finite_mat4 (m: math.Mat4): Bool =>
  return is_finite m.xx and is_finite m.xy and is_finite m.xz and is_finite m.xw
    and is_finite m.yx and is_finite m.yy and is_finite m.yz and is_finite m.yw
    and is_finite m.zx and is_finite m.zy and is_finite m.zz and is_finite m.zw
    and is_finite m.wx and is_finite m.wy and is_finite m.wz and is_finite m.ww

func sanitize_f32 (fallback: F32) -> (x: F32): F32 =>
  if is_finite x:
    return x
  return fallback

func sanitize_vec2 (fallback: Vec2) -> (v: Vec2): Vec2 =>
  if finite2 v:
    return v
  return $Vec2 { x: sanitize_f32 fallback.x v.x, y: sanitize_f32 fallback.y v.y }

func sanitize_vec3 (fallback: Vec3) -> (v: Vec3): Vec3 =>
  if math.finite3 v:
    return v
  return $Vec3 {
    x: sanitize_f32 fallback.x v.x,
    y: sanitize_f32 fallback.y v.y,
    z: sanitize_f32 fallback.z v.z,
  }

func sanitize_vec4 (fallback: math.Vec4) -> (v: math.Vec4): math.Vec4 =>
  if finite4 v:
    return v
  return $math.Vec4 {
    x: sanitize_f32 fallback.x v.x,
    y: sanitize_f32 fallback.y v.y,
    z: sanitize_f32 fallback.z v.z,
    w: sanitize_f32 fallback.w v.w,
  }

func sanitize_quat (fallback: math.Quat) -> (q: math.Quat): math.Quat =>
  if math.finite_quat q:
    return q
  return fallback

func sanitize_mat4 (fallback: math.Mat4) -> (m: math.Mat4): math.Mat4 =>
  if finite_mat4 m:
    return m
  return fallback

// --- Layer 2: Zero-cost compile-time NanPolicy trait (pure, SIMD/kernel-safe) ---

// Implement this 1-method trait on any zero-sized opaque policy marker or
// caller config struct. Static monomorphization eliminates all indirection.
type NanPolicy p is trait = {
  resolve: p -> U32 -> F32 -> F32 -> F32,
}

// Zero-cost passthrough: removes `is_finite` guards completely at compile time.
type FastIeee is opaque = Unit
const fast_ieee: FastIeee = $FastIeee ()
const FastIeee.NanPolicy: NanPolicy FastIeee = {
  resolve: func _ -> _ -> _ -> x => x,
}

// Pure inlined recovery: substitutes caller's fallback whenever `x` is non-finite.
type Fallback is opaque = Unit
const fallback: Fallback = $Fallback ()
const Fallback.NanPolicy: NanPolicy Fallback = {
  resolve: func _ -> _ -> fb -> x => if is_finite x then x else fb,
}

// Strict dev/CI mode: traps immediately at the exact site that produced NaN/Inf.
type StrictTrap is opaque = Unit
const strict_trap: StrictTrap = $StrictTrap ()
const StrictTrap.NanPolicy: NanPolicy StrictTrap = {
  resolve: func _ -> _ -> _ -> x => if is_finite x then x else panic "numeric: non-finite F32",
}

// Internal helpers for range-safe trig and overflow-safe vector norms.
private const trig_limit: F32 = 8192.0
private const trig_wrap_limit: F32 = 1.0e7

private func reduce_angle (radians: F32): F32 =>
  let mag = abs radians
  if mag <= trig_limit:
    return radians
  if is_finite radians and mag <= trig_wrap_limit:
    return wrap tau radians
  return 0.0 / 0.0

private func scaled_norm2 (v: Vec2): (F32, F32, Bool) =>
  let sq = v.x * v.x + v.y * v.y
  if sq >= 1.17549435e-38 and is_finite sq:
    let len = sqrt sq
    return (v.x / len, v.y / len, true)
  if not (finite2 v):
    return (0.0, 0.0, false)
  let scale = max (abs v.x) (abs v.y)
  if scale == 0.0:
    return (0.0, 0.0, false)
  let sx = v.x / scale
  let sy = v.y / scale
  let len = sqrt (sx * sx + sy * sy)
  return (sx / len, sy / len, true)

private func scaled_norm3 (v: Vec3): (F32, F32, F32, Bool) =>
  let sq = v.x * v.x + v.y * v.y + v.z * v.z
  if sq >= 1.17549435e-38 and is_finite sq:
    let len = sqrt sq
    return (v.x / len, v.y / len, v.z / len, true)
  if not (math.finite3 v):
    return (0.0, 0.0, 0.0, false)
  let scale = max (max (abs v.x) (abs v.y)) (abs v.z)
  if scale == 0.0:
    return (0.0, 0.0, 0.0, false)
  let sx = v.x / scale
  let sy = v.y / scale
  let sz = v.z / scale
  let len = sqrt (sx * sx + sy * sy + sz * sz)
  return (sx / len, sy / len, sz / len, true)

private func scaled_norm_quat (q: math.Quat): (F32, F32, F32, F32, Bool) =>
  let sq = q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w
  if sq >= 1.17549435e-38 and is_finite sq:
    let len = sqrt sq
    return (q.x / len, q.y / len, q.z / len, q.w / len, true)
  if not (math.finite_quat q):
    return (0.0, 0.0, 0.0, 1.0, false)
  let scale = max (max (abs q.x) (abs q.y)) (max (abs q.z) (abs q.w))
  if scale == 0.0:
    return (0.0, 0.0, 0.0, 1.0, false)
  let sx = q.x / scale
  let sy = q.y / scale
  let sz = q.z / scale
  let sw = q.w / scale
  let len = sqrt (sx * sx + sy * sy + sz * sz + sw * sw)
  return (sx / len, sy / len, sz / len, sw / len, true)

// Policy-parameterized math primitives. Under `fast_ieee`, `NanPolicy.resolve`
// compiles to the identity with zero runtime overhead.
func guard_with (policy: p) -> (site: U32) -> (fb: F32) -> (x: F32): F32 where { NanPolicy p } =>
  NanPolicy.resolve policy site fb x

func div_with (policy: p) -> (fb: F32) -> (a: F32) -> (b: F32): F32 where { NanPolicy p } =>
  NanPolicy.resolve policy site_div fb (a / b)

func sqrt_with (policy: p) -> (fb: F32) -> (x: F32): F32 where { NanPolicy p } =>
  NanPolicy.resolve policy site_sqrt fb (sqrt x)

func unlerp_with (policy: p) -> (fb: F32) -> (low: F32) -> (high: F32) -> (value: F32): F32 where { NanPolicy p } =>
  NanPolicy.resolve policy site_unlerp fb ((value - low) / (high - low))

func sin_with (policy: p) -> (fb: F32) -> (radians: F32): F32 where { NanPolicy p } =>
  NanPolicy.resolve policy site_trig fb (sin (reduce_angle radians))

func cos_with (policy: p) -> (fb: F32) -> (radians: F32): F32 where { NanPolicy p } =>
  NanPolicy.resolve policy site_trig fb (cos (reduce_angle radians))

func tan_with (policy: p) -> (fb: F32) -> (radians: F32): F32 where { NanPolicy p } =>
  NanPolicy.resolve policy site_trig fb (tan (reduce_angle radians))

func atan2_with (policy: p) -> (fb: F32) -> (y: F32) -> (x: F32): F32 where { NanPolicy p } =>
  NanPolicy.resolve policy site_atan2 fb (math.atan2 y x)

func acos_with (policy: p) -> (fb: F32) -> (x: F32): F32 where { NanPolicy p } =>
  let raw = if is_finite x and x >= -1.0 and x <= 1.0
    then math.atan2 (sqrt (max 0.0 (1.0 - x * x))) x
    else 0.0 / 0.0
  return NanPolicy.resolve policy site_acos fb raw

func acos_clamped_with (policy: p) -> (fb: F32) -> (x: F32): F32 where { NanPolicy p } =>
  if is_finite x:
    let c = clamp (-1.0) 1.0 x
    let raw = math.atan2 (sqrt (max 0.0 (1.0 - c * c))) c
    return NanPolicy.resolve policy site_acos fb raw
  return NanPolicy.resolve policy site_acos fb (0.0 / 0.0)

func asin_with (policy: p) -> (fb: F32) -> (x: F32): F32 where { NanPolicy p } =>
  if is_finite x and x >= -1.0 and x <= 1.0:
    let raw = math.atan2 x (sqrt (max 0.0 (1.0 - x * x)))
    return NanPolicy.resolve policy site_asin fb raw
  return NanPolicy.resolve policy site_asin fb (0.0 / 0.0)

func asin_clamped_with (policy: p) -> (fb: F32) -> (x: F32): F32 where { NanPolicy p } =>
  if is_finite x:
    let c = clamp (-1.0) 1.0 x
    let raw = math.atan2 c (sqrt (max 0.0 (1.0 - c * c)))
    return NanPolicy.resolve policy site_asin fb raw
  return NanPolicy.resolve policy site_asin fb (0.0 / 0.0)

func log2_with (policy: p) -> (fb: F32) -> (x: F32): F32 where { NanPolicy p } =>
  let raw = if is_finite x and x > 0.0 then color.log2 x else 0.0 / 0.0
  return NanPolicy.resolve policy site_log fb raw

func pow_with (policy: p) -> (fb: F32) -> (base: F32) -> (exponent: F32): F32 where { NanPolicy p } =>
  if is_finite base and is_finite exponent and base > 0.0:
    return NanPolicy.resolve policy site_pow fb (color.exp2 (color.log2 base * exponent))
  if base == 0.0 and is_finite exponent and exponent > 0.0:
    return NanPolicy.resolve policy site_pow fb 0.0
  if base == 0.0 and exponent == 0.0:
    return NanPolicy.resolve policy site_pow fb 1.0
  return NanPolicy.resolve policy site_pow fb (0.0 / 0.0)

func normalize2_with (policy: p) -> (fb: Vec2) -> (v: Vec2): Vec2 where { NanPolicy p } =>
  let (nx, ny, ok) = scaled_norm2 v
  if ok:
    return $Vec2 { x: nx, y: ny }
  let bad = 0.0 / 0.0
  return $Vec2 {
    x: NanPolicy.resolve policy site_normalize fb.x bad,
    y: NanPolicy.resolve policy site_normalize fb.y bad,
  }

func normalize3_with (policy: p) -> (fb: Vec3) -> (v: Vec3): Vec3 where { NanPolicy p } =>
  let (nx, ny, nz, ok) = scaled_norm3 v
  if ok:
    return $Vec3 { x: nx, y: ny, z: nz }
  let bad = 0.0 / 0.0
  return $Vec3 {
    x: NanPolicy.resolve policy site_normalize fb.x bad,
    y: NanPolicy.resolve policy site_normalize fb.y bad,
    z: NanPolicy.resolve policy site_normalize fb.z bad,
  }

func normalize_quat_with (policy: p) -> (fb: math.Quat) -> (q: math.Quat): math.Quat where { NanPolicy p } =>
  let (nx, ny, nz, nw, ok) = scaled_norm_quat q
  if ok:
    return $math.Quat { x: nx, y: ny, z: nz, w: nw }
  let bad = 0.0 / 0.0
  return $math.Quat {
    x: NanPolicy.resolve policy site_normalize fb.x bad,
    y: NanPolicy.resolve policy site_normalize fb.y bad,
    z: NanPolicy.resolve policy site_normalize fb.z bad,
    w: NanPolicy.resolve policy site_normalize fb.w bad,
  }

// --- Layer 3: Scoped Numeric effect (zero handler dispatch on happy path) ---

type Fault is data = $Fault { site: U32, fallback: F32 }

type Numeric is effect = {
  non_finite: Fault -> F32,
}

// Pre-built effect records usable directly with `@handle numeric.quiet_fallback`.
const quiet_fallback: Numeric = {
  non_finite: func fault => fault.fallback,
}

const strict_trap_handler: Numeric = {
  non_finite: func _ => panic "numeric: non-finite F32",
}

// Guard a scalar: finite values return immediately without touching the effect
// runtime; non-finite values delegate to the caller's enclosing `Numeric` handler.
func guard (site: U32) -> (fb: F32) -> (x: F32): F32 ! { Numeric } =>
  if is_finite x:
    return x
  return use Numeric.non_finite ($Fault { site, fallback: fb })

func div (fb: F32) -> (a: F32) -> (b: F32): F32 ! { Numeric } =>
  let r = a / b
  if is_finite r:
    return r
  return use Numeric.non_finite ($Fault { site: site_div, fallback: fb })

func safe_sqrt (fb: F32) -> (x: F32): F32 ! { Numeric } =>
  let r = sqrt x
  if is_finite r:
    return r
  return use Numeric.non_finite ($Fault { site: site_sqrt, fallback: fb })

func unlerp (fb: F32) -> (low: F32) -> (high: F32) -> (value: F32): F32 ! { Numeric } =>
  let r = (value - low) / (high - low)
  if is_finite r:
    return r
  return use Numeric.non_finite ($Fault { site: site_unlerp, fallback: fb })

func safe_sin (fb: F32) -> (radians: F32): F32 ! { Numeric } =>
  let r = sin (reduce_angle radians)
  if is_finite r:
    return r
  return use Numeric.non_finite ($Fault { site: site_trig, fallback: fb })

func safe_cos (fb: F32) -> (radians: F32): F32 ! { Numeric } =>
  let r = cos (reduce_angle radians)
  if is_finite r:
    return r
  return use Numeric.non_finite ($Fault { site: site_trig, fallback: fb })

func safe_tan (fb: F32) -> (radians: F32): F32 ! { Numeric } =>
  let r = tan (reduce_angle radians)
  if is_finite r:
    return r
  return use Numeric.non_finite ($Fault { site: site_trig, fallback: fb })

func safe_atan2 (fb: F32) -> (y: F32) -> (x: F32): F32 ! { Numeric } =>
  let r = math.atan2 y x
  if is_finite r:
    return r
  return use Numeric.non_finite ($Fault { site: site_atan2, fallback: fb })

func safe_acos (fb: F32) -> (x: F32): F32 ! { Numeric } =>
  if is_finite x and x >= -1.0 and x <= 1.0:
    return math.atan2 (sqrt (max 0.0 (1.0 - x * x))) x
  return use Numeric.non_finite ($Fault { site: site_acos, fallback: fb })

func safe_asin (fb: F32) -> (x: F32): F32 ! { Numeric } =>
  if is_finite x and x >= -1.0 and x <= 1.0:
    return math.atan2 x (sqrt (max 0.0 (1.0 - x * x)))
  return use Numeric.non_finite ($Fault { site: site_asin, fallback: fb })

func safe_log2 (fb: F32) -> (x: F32): F32 ! { Numeric } =>
  if is_finite x and x > 0.0:
    return color.log2 x
  return use Numeric.non_finite ($Fault { site: site_log, fallback: fb })

func normalize2 (fb: Vec2) -> (v: Vec2): Vec2 ! { Numeric } =>
  let (nx, ny, ok) = scaled_norm2 v
  if ok:
    return $Vec2 { x: nx, y: ny }
  use _ <- Numeric.non_finite ($Fault { site: site_normalize, fallback: 0.0 })
  return fb

func normalize3 (fb: Vec3) -> (v: Vec3): Vec3 ! { Numeric } =>
  let (nx, ny, nz, ok) = scaled_norm3 v
  if ok:
    return $Vec3 { x: nx, y: ny, z: nz }
  use _ <- Numeric.non_finite ($Fault { site: site_normalize, fallback: 0.0 })
  return fb

func normalize_quat (fb: math.Quat) -> (q: math.Quat): math.Quat ! { Numeric } =>
  let (nx, ny, nz, nw, ok) = scaled_norm_quat q
  if ok:
    return $math.Quat { x: nx, y: ny, z: nz, w: nw }
  use _ <- Numeric.non_finite ($Fault { site: site_normalize, fallback: 0.0 })
  return fb

// Ready-made scoped runners for consumers.
func run_fallback (body: Unit -> a ! { Numeric }): a =>
  @handle quiet_fallback body

func run_strict (body: Unit -> a ! { Numeric }): a =>
  @handle strict_trap_handler body

private func push_site (log: own #[U32]) -> (site: U32): #[U32] =>
  @storage.push log site
  return log

func run_collecting (log: own #[U32]) -> (body: Unit -> a ! { Numeric }): (a, #[U32]) =>
  let recorded = log
  handler collect: Numeric =>
    non_finite fault =>
      recorded := push_site self fault.site
      return fault.fallback
  let final = @handle collect body
  return (final, recorded)

// --- Layer 4: Compile-time `#for #fields` record boundary validation/repair ---

type FiniteField a is trait = {
  all_finite: a -> Bool,
  repair: F32 -> a -> a,
}

const F32.FiniteField: FiniteField F32 = {
  all_finite: func x => is_finite x,
  repair: func fb -> x => if is_finite x then x else fb,
}

const U32.FiniteField: FiniteField U32 = {
  all_finite: func _ => true,
  repair: func _ -> x => x,
}

const Bool.FiniteField: FiniteField Bool = {
  all_finite: func _ => true,
  repair: func _ -> x => x,
}

const Unit.FiniteField: FiniteField Unit = {
  all_finite: func _ => true,
  repair: func _ -> x => x,
}

// Validated opaque scalars are guaranteed finite by construction: zero work!
const Finite.FiniteField: FiniteField Finite = {
  all_finite: func _ => true,
  repair: func _ -> x => x,
}

const NonZeroFinite.FiniteField: FiniteField NonZeroFinite = {
  all_finite: func _ => true,
  repair: func _ -> x => x,
}

const UnitF32.FiniteField: FiniteField UnitF32 = {
  all_finite: func _ => true,
  repair: func _ -> x => x,
}

const Vec2.FiniteField: FiniteField Vec2 = {
  all_finite: finite2,
  repair: func fb -> v => sanitize_vec2 ($Vec2 { x: fb, y: fb }) v,
}

const Vec3.FiniteField: FiniteField Vec3 = {
  all_finite: finite3,
  repair: func fb -> v => sanitize_vec3 ($Vec3 { x: fb, y: fb, z: fb }) v,
}

const Vec4.FiniteField: FiniteField math.Vec4 = {
  all_finite: finite4,
  repair: func fb -> v => sanitize_vec4 ($math.Vec4 { x: fb, y: fb, z: fb, w: fb }) v,
}

const Quat.FiniteField: FiniteField math.Quat = {
  all_finite: finite_quat,
  repair: func _ -> q => sanitize_quat math.identity_quat q,
}

private func repair_color (fb: F32) -> (c: math.Color): math.Color =>
  if finite_color c:
    return c
  return $math.Color {
    r: sanitize_f32 fb c.r,
    g: sanitize_f32 fb c.g,
    b: sanitize_f32 fb c.b,
    a: sanitize_f32 1.0 c.a,
  }

private func repair_ray (fb: F32) -> (r: math.Ray): math.Ray =>
  if finite_ray r:
    return r
  return $math.Ray {
    origin: sanitize_vec3 ($Vec3 { x: fb, y: fb, z: fb }) r.origin,
    direction: sanitize_vec3 math.forward r.direction,
  }

const Color.FiniteField: FiniteField math.Color = {
  all_finite: finite_color,
  repair: repair_color,
}

const Ray.FiniteField: FiniteField math.Ray = {
  all_finite: finite_ray,
  repair: repair_ray,
}

const Mat4.FiniteField: FiniteField math.Mat4 = {
  all_finite: finite_mat4,
  repair: func _ -> m => sanitize_mat4 math.Mat4.identity m,
}

private func array_all_finite (values: #[a]): Bool where { FiniteField a } =>
  for item in values:
    if not (FiniteField.all_finite item):
      return false
  return true

private func array_repair (fb: F32) -> (values: #[a]): #[a] where { FiniteField a } =>
  if array_all_finite values:
    return @storage.copy values
  let out: #[a] = #[]
  for item in values:
    @storage.push out (FiniteField.repair fb item)
  return out

const Array.FiniteField: FiniteField #[a] where { FiniteField a } = {
  all_finite: array_all_finite,
  repair: array_repair,
}

private func copy_text (src: Text): Text => @storage.copy src

// Zero-reflection compile-time check across every field of any single-constructor record.
func record_finite (value: t): Bool =>
  #for field in #fields t:
    if not (FiniteField.all_finite value.(field)):
      return false
  return true

// Names the exact first field containing a non-finite value (`$Some "vel"`), or `$Nothing`.
func first_non_finite_field (value: t): Maybe Text =>
  #for field in #fields t:
    if not (FiniteField.all_finite value.(field)):
      return $Some (copy_text field.name)
  return $Nothing

// Unrolls at compile time to sanitize every non-finite field in any record.
func sanitize_record (fb: F32) -> (value: t): t =>
  let built: t = #for field in #fields t:
    break FiniteField.repair fb value.(field)
  return built

// Effectful record boundary check: happy path never fires `Numeric`; bad fields
// report `site_base + field_ordinal` to the consumer's `with Numeric` handler.
func check_record (site_base: U32) -> (fb: F32) -> (value: t): t ! { Numeric } =>
  let out = value
  let ordinal: U32 = 0
  #for field in #fields t:
    let slot = ordinal
    ordinal := self + 1
    let current = out.(field)
    if not (FiniteField.all_finite current):
      use replacement <- Numeric.non_finite ($Fault { site: site_base + slot, fallback: fb })
      out.(field) := FiniteField.repair replacement current
  return out
