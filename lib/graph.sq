//! Compressed adjacency borrows two separately named caller-owned buffers.
//! No graph/wave row contains an owning array. End all views before rebuilding
//! either owner; growth is address-safe but does not extend captured lengths.
//!
//! Key items: [`Graph`], [`Waves`], [`valid`], [`borrow`], [`bind`].
//!
//! ```squid
//! let starts: #[U32] = #[]
//! let targets: #[U32] = #[]
//! let (ok, starts, targets) = from_edges 4 #[0, 1, 2] #[1, 2, 3] starts targets
//! let g = borrow starts targets
//! let seen = reachable g #[0] #[true, true, true, true]
//! ok and seen[3] // => true
//! ```

import * as array from "std/array"

type Graph is data = $Graph { starts: &[U32], targets: &[U32] }
type Waves is data = $Waves { starts: #[U32], nodes: #[U32] }
func valid (graph: Graph) =>
  if graph.starts.length == 0 or graph.starts[0] != 0 or graph.starts[graph.starts.length - 1] != graph.targets.length:
    return false
  let count = graph.starts.length - 1
  for i in 0 .. count:
    if graph.starts[i] > graph.starts[i + 1]:
      return false
  for target in graph.targets:
    if target >= count:
      return false
  return true
// Reads adjacency after its owners were built or validated.
func borrow (starts: #[U32]) -> (targets: #[U32]) : Graph => return
  $Graph {starts: &starts[0..starts.length], targets: &targets[0..targets.length]}
func bind (starts: #[U32]) -> (targets: #[U32]) =>
  if starts.length == 0 or starts[0] != 0 or starts[starts.length - 1] != targets.length:
    return $Nothing
  let count = starts.length - 1
  for i in 0 .. count:
    if starts[i] > starts[i + 1]:
      return $Nothing
  for target in targets:
    if target >= count:
      return $Nothing
  return $Some (borrow starts targets)
// Input and output buffers must be distinct. Returns the owners and whether
// their new contents were built. Invalid endpoints leave the owners intact.
// Source edge order and duplicates are preserved.
func from_edges (count: U32) -> sources -> targets -> (out_starts: own #[U32]) -> (out_targets: own #[U32]) : (Bool, #[U32], #[U32]) =>
  if count == 0xFFFFFFFF or sources.length != targets.length:
    return (false, out_starts, out_targets)
  for i in 0 .. sources.length:
    if (sources.at i) >= count or (targets.at i) >= count:
      return (false, out_starts, out_targets)
  let sizes = array.fill count 0
  for i in 0 .. sources.length:
    let source = sources.at i
    sizes[source] := sizes[source] + 1
  @storage.truncate out_starts 0
  @storage.truncate out_targets 0
  @storage.push out_starts 0
  let cursor = array.fill count 0
  for i in 0 .. count:
    let start = out_starts[i]
    cursor[i] := start
    @storage.push out_starts (start + sizes[i])
  for 0 .. targets.length:
    @storage.push out_targets 0
  for i in 0 .. sources.length:
    let source = (sources.at i)
    out_targets[cursor[source]] := targets.at i
    cursor[source] := cursor[source] + 1
  return (true, out_starts, out_targets)
func reverse (graph: Graph) -> (out_starts: own #[U32]) -> (out_targets: own #[U32]) : (#[U32], #[U32]) =>
  if not (valid graph):
    return panic "graph adjacency invariant"
  let count = graph.starts.length - 1
  let sources = array.fill graph.targets.length 0
  for source in 0 .. count:
    for i in graph.starts[source] .. graph.starts[source + 1]:
      sources[i] := source
  let (built, out_starts, out_targets) = from_edges count graph.targets sources out_starts out_targets
  if not built:
    return panic "graph adjacency invariant"
  return (out_starts, out_targets)
// A list entry is a borrowed view into an independently owned input pool.
// Prefer from_edges/bind when the source already uses flat adjacency.
func from_lists (lists: #[&[U32]]) -> (out_starts: own #[U32]) -> (out_targets: own #[U32]) : (#[U32], #[U32]) =>
  let total = 0
  for list in lists:
    if list.length > 0xFFFFFFFF - total:
      return panic "graph edge count overflows"
    total := total + list.length
    for target in list:
      if target >= lists.length:
        return panic "graph target outside graph"
  @storage.truncate out_starts 0
  @storage.truncate out_targets 0
  @storage.push out_starts 0
  for list in lists:
    for target in list:
      @storage.push out_targets target
    @storage.push out_starts out_targets.length
  return (out_starts, out_targets)
// Seeds are always included. Only allowed target nodes may be discovered.
func reachable (graph: Graph) -> roots -> allowed =>
  if not (valid graph):
    return panic "graph adjacency invariant"
  let count = graph.starts.length - 1
  if allowed.length != count:
    return panic "graph allowed mask length mismatch"
  let seen = array.fill count false
  let queue = array.fill count 0
  let used = 0
  for root in roots:
    if root >= count:
      return panic "graph root outside graph"
    if not seen[root]:
      seen[root] := true
      queue[used] := root
      used := used + 1
  for head in 0 .. count:
    if head >= used:
      break
    let source = queue[head]
    for i in graph.starts[source] .. graph.starts[source + 1]:
      let target = graph.targets[i]
      if allowed[target] and not seen[target]:
        seen[target] := true
        queue[used] := target
        used := used + 1
  return seen
// Stable Kahn waves, O(nodes log nodes + edges). Ready source index breaks ties;
// newly ready nodes cannot enter the wave being committed. Failed construction
// leaves scratch outputs unpublished; no borrowed result is returned on a cycle.
func waves (width: U32) -> (dependencies: Graph) -> (out_starts: own #[U32]) -> (out_nodes: own #[U32]) : Maybe Waves =>
  if width == 0 or not (valid dependencies):
    return $Nothing
  let count = dependencies.starts.length - 1
  let reverse_starts: #[U32] = #[]
  let reverse_targets: #[U32] = #[]
  let (reverse_starts, reverse_targets) = reverse dependencies reverse_starts reverse_targets
  let dependents = borrow reverse_starts reverse_targets
  let remaining = array.generate count (func i => dependencies.starts[i + 1] - dependencies.starts[i])
  let heap = array.fill count 0
  let used = 0
  for i in 0 .. count:
    if remaining[i] == 0:
      heap[used] := i
      used := used + 1
  @storage.truncate out_starts 0
  @storage.truncate out_nodes 0
  @storage.push out_starts 0
  for 0 .. count:
    if used == 0:
      break
    let size = min width used
    let start = out_nodes.length
    for 0 .. size:
      @storage.push out_nodes heap[0]
      used := used - 1
      let moved = heap[used]
      let at = 0
      for 0 .. 32:
        let left = at * 2 + 1
        if left >= used:
          break
        let child = if left + 1 < used and heap[left + 1] < heap[left] then left + 1 else left
        if moved <= heap[child]:
          break
        heap[at] := heap[child]
        at := child
      heap[at] := moved
    for selected in start .. out_nodes.length:
      let source = out_nodes[selected]
      for i in dependents.starts[source] .. dependents.starts[source + 1]:
        let target = dependents.targets[i]
        remaining[target] := remaining[target] - 1
        if remaining[target] == 0:
          let at = used
          used := used + 1
          for 0 .. 32:
            if at == 0:
              break
            let parent = (at - 1) / 2
            if heap[parent] <= target:
              break
            heap[at] := heap[parent]
            at := parent
          heap[at] := target
    @storage.push out_starts out_nodes.length
  if out_nodes.length != count:
    return $Nothing
  return $Some ($Waves {starts: out_starts, nodes: out_nodes})
