//! Procedural gradient skies, atmospheric samples, and spherical-harmonics diffuse irradiance.
//!
//! Key items: [`Sky`], [`Sample`], [`Irradiance`], [`Diffuse`], [`sky`].

import { Vec3 } from "std/vector"
import * as math from "./math"
import * as lighting from "./render/lighting"

type Sky is data = $Sky { zenith: math.Color, horizon: math.Color, ground: math.Color, sun_direction: Vec3, sun: math.Color, sun_cos_radius: F32 }
type Sample is data = $Sample { direction: Vec3, radiance: math.Color, solid_angle: F32 }
type Irradiance is data = $Irradiance { coefficients: #[math.Color] }
const default_sky = $Sky { zenith: math.rgb 0.08 0.2 0.5, horizon: math.rgb 0.5 0.6 0.8, ground: math.rgb 0.04 0.03 0.02, sun_direction: math.vec3 0.0 1.0 0.0, sun: math.rgb 12.0 10.0 7.0, sun_cos_radius: 0.999 }
private func safe_norm_xyz (x: F32) -> (y: F32) -> (z: F32) : (F32, F32, F32) =>
  if not (is_finite x and is_finite y and is_finite z):
    return (0.0, 0.0, 0.0)
  let length = sqrt (x * x + y * y + z * z)
  if is_finite length and length > 0.0:
    return (x / length, y / length, z / length)
  let m = max (abs x) (max (abs y) (abs z))
  if not (is_finite m) or m == 0.0:
    return (0.0, 0.0, 0.0)
  let sx = x / m
  let sy = y / m
  let sz = z / m
  let sl = sqrt (sx * sx + sy * sy + sz * sz)
  if not (is_finite sl) or sl == 0.0:
    return (0.0, 0.0, 0.0)
  return (sx / sl, sy / sl, sz / sl)

// Directions normalize as Vec3.normalized does, a zero vector staying zero.
func sky (settings: Sky) => func (direction: Vec3) =>
  let (x, y, z) = safe_norm_xyz direction.x direction.y direction.z
  let result = math.Color.lerp settings.horizon settings.zenith (sqrt (max 0.0 y))
  if y < 0.0:
    result := math.Color.lerp settings.horizon settings.ground (sqrt (F32.neg y))
  let (sx, sy, sz) = safe_norm_xyz settings.sun_direction.x settings.sun_direction.y settings.sun_direction.z
  if x * sx + y * sy + z * sz >= settings.sun_cos_radius:
    result := lighting.add result settings.sun
  return result

// Real SH basis, bands 0..2. Sample solid angles should sum to 4*pi.
func basis (direction: Vec3) =>
  let d = direction.normalized
  return #[0.2820947918, 0.4886025119 * d.y, 0.4886025119 * d.z, 0.4886025119 * d.x,
    1.0925484306 * d.x * d.y, 1.0925484306 * d.y * d.z, 0.3153915653 * (3.0 * d.z * d.z - 1.0),
    1.0925484306 * d.x * d.z, 0.5462742153 * (d.x * d.x - d.y * d.y)]
// Sums accumulate per channel in one numeric array, updated in place, and
// become colours once at the end; each term is basis's, without allocating.
func integrate (samples: #[Sample]) =>
  let sums = @array.fill 27 0.0
  for sample_index in 0 .. samples.length:
    let $Sample { direction, radiance, solid_angle } = samples[sample_index]
    let $Vec3 { x, y, z } = direction
    let length = sqrt (x * x + y * y + z * z)
    if length != 0.0:
      x := self / length
      y := self / length
      z := self / length
    let $math.Color { r, g, b } = radiance
    let w0 = 0.2820947918 * solid_angle * 3.1415926536
    let w1 = 0.4886025119 * y * solid_angle * 2.0943951024
    let w2 = 0.4886025119 * z * solid_angle * 2.0943951024
    let w3 = 0.4886025119 * x * solid_angle * 2.0943951024
    let w4 = 1.0925484306 * x * y * solid_angle * 0.7853981634
    let w5 = 1.0925484306 * y * z * solid_angle * 0.7853981634
    let w6 = 0.3153915653 * (3.0 * z * z - 1.0) * solid_angle * 0.7853981634
    let w7 = 1.0925484306 * x * z * solid_angle * 0.7853981634
    let w8 = 0.5462742153 * (x * x - y * y) * solid_angle * 0.7853981634
    sums[0] := self + r * w0
    sums[1] := self + g * w0
    sums[2] := self + b * w0
    sums[3] := self + r * w1
    sums[4] := self + g * w1
    sums[5] := self + b * w1
    sums[6] := self + r * w2
    sums[7] := self + g * w2
    sums[8] := self + b * w2
    sums[9] := self + r * w3
    sums[10] := self + g * w3
    sums[11] := self + b * w3
    sums[12] := self + r * w4
    sums[13] := self + g * w4
    sums[14] := self + b * w4
    sums[15] := self + r * w5
    sums[16] := self + g * w5
    sums[17] := self + b * w5
    sums[18] := self + r * w6
    sums[19] := self + g * w6
    sums[20] := self + b * w6
    sums[21] := self + r * w7
    sums[22] := self + g * w7
    sums[23] := self + b * w7
    sums[24] := self + r * w8
    sums[25] := self + g * w8
    sums[26] := self + b * w8
  let coefficients = @array.generate 9 (func (i: U32) => math.rgb sums[i * 3] sums[i * 3 + 1] sums[i * 3 + 2])
  return $Irradiance { coefficients }
func evaluate (irradiance: Irradiance) => func (normal: Vec3) =>
  let c = irradiance.coefficients
  let len = c.length
  if len == 0:
    return math.rgb 0.0 0.0 0.0
  let d = normal.normalized
  let dx = d.x
  let dy = d.y
  let dz = d.z
  let t0 = 0.2820947918
  let r = c[0].r * t0
  let g = c[0].g * t0
  let b = c[0].b * t0
  if len > 1:
    let t1 = 0.4886025119 * dy
    r := self + c[1].r * t1
    g := self + c[1].g * t1
    b := self + c[1].b * t1
  if len > 2:
    let t2 = 0.4886025119 * dz
    r := self + c[2].r * t2
    g := self + c[2].g * t2
    b := self + c[2].b * t2
  if len > 3:
    let t3 = 0.4886025119 * dx
    r := self + c[3].r * t3
    g := self + c[3].g * t3
    b := self + c[3].b * t3
  if len > 4:
    let t4 = 1.0925484306 * dx * dy
    r := self + c[4].r * t4
    g := self + c[4].g * t4
    b := self + c[4].b * t4
  if len > 5:
    let t5 = 1.0925484306 * dy * dz
    r := self + c[5].r * t5
    g := self + c[5].g * t5
    b := self + c[5].b * t5
  if len > 6:
    let t6 = 0.3153915653 * (3.0 * dz * dz - 1.0)
    r := self + c[6].r * t6
    g := self + c[6].g * t6
    b := self + c[6].b * t6
  if len > 7:
    let t7 = 1.0925484306 * dx * dz
    r := self + c[7].r * t7
    g := self + c[7].g * t7
    b := self + c[7].b * t7
  if len > 8:
    let t8 = 0.5462742153 * (dx * dx - dy * dy)
    r := self + c[8].r * t8
    g := self + c[8].g * t8
    b := self + c[8].b * t8
  return math.rgb (max 0.0 r) (max 0.0 g) (max 0.0 b)

// The sky's diffuse light, ready for a host to shade with: `coefficients` are
// nine RGB SH terms (as `basis` orders them) whose `evaluate` gives what a
// white surface facing a normal shows, its cosine lobe already applied and
// divided by pi, so that albedo multiplies it directly; `tint` is the
// per-channel scale from the sky's own colors to that light, which a host
// reuses for glossy reflections of the same sky.
type Diffuse is data = $Diffuse { tint: math.Color, coefficients: #[math.Color] }
// The sky's light from every direction, its sun left out, on an equal-area
// grid of rows x columns midpoints (y steps evenly, azimuth too): a smooth sky
// needs about 16 x 32. The sun belongs to the scene's directional light.
func project (settings: Sky) => func (rows: U32) => func (columns: U32) =>
  if rows == 0 or columns == 0 or rows > 65536 / columns:
    return $Irradiance { coefficients: @array.fill 9 (math.rgb 0.0 0.0 0.0) }
  let $Sky { zenith, horizon, ground } = settings
  let count = rows * columns
  let weight = 12.5663706144 / U32.to_f32 count
  let cols_f = U32.to_f32 columns
  let rows_f = U32.to_f32 rows
  let step_az = 6.2831853072 / cols_f
  let sum_c = 0.0
  let sum_s = 0.0
  let sum_cc = 0.0
  let sum_ss = 0.0
  let sum_cs = 0.0
  for column in 0 .. columns:
    let (s, c) = sin_cos ((U32.to_f32 column + 0.5) * step_az)
    sum_c := self + c
    sum_s := self + s
    sum_cc := self + c * c
    sum_ss := self + s * s
    sum_cs := self + c * s
  let sums = @array.fill 27 0.0
  let k0 = 0.2820947918 * weight * 3.1415926536
  let k1 = 0.4886025119 * weight * 2.0943951024
  let k2 = 1.0925484306 * weight * 0.7853981634
  let k6 = 0.3153915653 * weight * 0.7853981634
  let k8 = 0.5462742153 * weight * 0.7853981634
  for row in 0 .. rows:
    let y = 1.0 - 2.0 * (U32.to_f32 row + 0.5) / rows_f
    let ring2 = max 0.0 (1.0 - y * y)
    let ring = sqrt ring2
    let col = if y < 0.0
      then math.Color.lerp horizon ground (sqrt (F32.neg y))
      else math.Color.lerp horizon zenith (sqrt (max 0.0 y))
    let $math.Color { r, g, b } = col
    let w0 = k0 * cols_f
    let w1 = k1 * (cols_f * y)
    let w2 = k1 * (ring * sum_s)
    let w3 = k1 * (ring * sum_c)
    let w4 = k2 * (ring * y * sum_c)
    let w5 = k2 * (ring * y * sum_s)
    let w6 = k6 * (3.0 * ring2 * sum_ss - cols_f)
    let w7 = k2 * (ring2 * sum_cs)
    let w8 = k8 * (ring2 * sum_cc - cols_f * y * y)
    sums[0] := self + r * w0
    sums[1] := self + g * w0
    sums[2] := self + b * w0
    sums[3] := self + r * w1
    sums[4] := self + g * w1
    sums[5] := self + b * w1
    sums[6] := self + r * w2
    sums[7] := self + g * w2
    sums[8] := self + b * w2
    sums[9] := self + r * w3
    sums[10] := self + g * w3
    sums[11] := self + b * w3
    sums[12] := self + r * w4
    sums[13] := self + g * w4
    sums[14] := self + b * w4
    sums[15] := self + r * w5
    sums[16] := self + g * w5
    sums[17] := self + b * w5
    sums[18] := self + r * w6
    sums[19] := self + g * w6
    sums[20] := self + b * w6
    sums[21] := self + r * w7
    sums[22] := self + g * w7
    sums[23] := self + b * w7
    sums[24] := self + r * w8
    sums[25] := self + g * w8
    sums[26] := self + b * w8
  let coefficients = @array.generate 9 (func (i: U32) => math.rgb sums[i * 3] sums[i * 3 + 1] sums[i * 3 + 2])
  return $Irradiance { coefficients }
// `irradiance` (a `project`ion) turned into the light of a sky whose
// average over all directions is `ambient`, as a flat ambient light is: a
// uniform sky comes back as exactly `ambient`, a brighter zenith lights
// upward normals more. A channel with no light stays dark.
func diffuse (irradiance: Irradiance) => func (ambient: math.Color) =>
  let black = math.rgb 0.0 0.0 0.0
  let mean = if irradiance.coefficients.length > 0 then irradiance.coefficients[0] else black
  let scale = func (light: F32) => func (term: F32) =>
    if not (is_finite light and is_finite term) or term <= 0.0 or light <= 0.0:
      return 0.0
    return light * 3.1415926536 / (0.2820947918 * term)
  let tint = math.rgb (scale ambient.r mean.r) (scale ambient.g mean.g) (scale ambient.b mean.b)
  let coefficients = @array.generate 9 (func (i: U32) =>
    let term = if i < irradiance.coefficients.length then irradiance.coefficients[i] else black
    return math.rgb (term.r * tint.r / 3.1415926536) (term.g * tint.g / 3.1415926536) (term.b * tint.b / 3.1415926536))
  return $Diffuse { tint, coefficients }
