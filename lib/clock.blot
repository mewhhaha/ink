import * as ecs from "./ecs"
import * as lanes from "./lanes"
import * as time from "./time"

// Callers choose timestep and catch-up work; no global clock policy.
type Policy is data = #Policy { step_seconds: F32, max_elapsed: F32, max_steps: U32 }
type Clock is data = #Clock { tick: U32, remainder: F32 }

const clock = #Clock { tick: 0, remainder: 0.0 }

const validate = fn (policy: Policy) => do:
  use lanes.require (is_finite policy.step_seconds && policy.step_seconds > 0.0)
  return lanes.require (is_finite policy.max_elapsed && policy.max_elapsed >= 0.0)

const seconds = fn (policy: Policy) => fn (current: Clock) => fn (alpha: F32) => (U32.to_f32 current.tick + alpha) * policy.step_seconds

const every = fn (steps: U32) => fn (current: Clock) => do:
  if steps == 0:
    return #False
  return current.tick % steps == 0

const encode_clock = fn (current: Clock) =>
  #[U32.to_f32 (current.tick & 0xFFFF), U32.to_f32 (current.tick >> 16), current.remainder]

const decode_clock = fn (policy: Policy) => fn (values: Array F32) => do:
  use validate policy
  use lanes.exact values 3
  use lanes.finite values
  let remainder = values[2]
  use lanes.require (remainder >= 0.0 && remainder < policy.step_seconds)
  return #Clock { tick: lanes.whole values 0, remainder }

const codec = fn (policy: Policy) => #lanes.Codec { key: 1, version: 1, encode: encode_clock, decode: decode_clock policy, migrate: lanes.no_migration }

// Checkpoint before every update. Excess whole steps are dropped and reported
// by time.Step; the fractional remainder is retained. Tick wraps as U32.
const advance = fn (policy: Policy) => fn checkpoint => fn update => fn (elapsed: F32) => do:
  use validate policy
  use lanes.require (is_finite elapsed && elapsed >= 0.0)
  use current <- ecs.get #Clock
  use lanes.require (current.remainder >= 0.0 && current.remainder < policy.step_seconds)
  let #Some planned = time.fixed policy.step_seconds policy.max_steps current.remainder (min policy.max_elapsed elapsed) else:
    return @panic "invalid clock step"
  planned.dropped := self + max 0.0 (elapsed - policy.max_elapsed)
  for 0 .. planned.steps:
    use checkpoint ()
    use update policy.step_seconds
    current.tick := self + 1
    use ecs.set current
  current.remainder := planned.remainder
  use ecs.set current
  return planned
