//! Saved framing is unchanged: marker,schema,count; key,version,width,length,
//! payload per section. Section rows are flat spans into a separate lane owner.
//!
//! Key items: [`Section`], [`Writer`], [`Fate`], [`Outcome`], [`writer`].

import * as array from "std/array"
import * as ecs from "./ecs"
import * as lanes from "./lanes"

const magic: F32 = 5678.0
const scene_magic: F32 = 5679.0
const report_magic: F32 = 5680.0
type Section is data = $Section {key: U32, version: U32, width: U32, start: U32, count: U32}
type Writer is data = $Writer {sections: #[Section], payload: #[F32]}
type Fate is data = $Kept | $Migrated | $Reset | $Missing | $Dropped
type Outcome is data = $Outcome {key: U32, fate: Fate, saved: U32, version: U32}
type Request is data = $Save | $Load | $SaveScene | $LoadScene | $Checkpoint | $Undo | $Redo | $StashScene | $RestoreScene | $Exit
type Requests = #[U32]
func writer () : Writer => $Writer {sections: #[], payload: #[]}
func requests () : Requests => #[0]
func request_bit wanted => case wanted of
  $Save => 1
  $Load => 2
  $SaveScene => 4
  $LoadScene => 8
  $Checkpoint => 16
  $Undo => 32
  $Redo => 64
  $StashScene => 128
  $RestoreScene => 256
  $Exit => 512
func has (requests: Requests) -> wanted => requests[0] & request_bit wanted != 0
func request (requests: own Requests) -> wanted: Requests =>
  requests[0] := self | request_bit wanted
  return requests
func clear_requests (requests: own Requests): Requests =>
  requests[0] := 0
  return requests
func append values -> (destination: own #[F32]) : #[F32] =>
  let count = values.length
  for i in 0 .. count:
    @storage.push destination (values.at (i))
  return destination
func find (key: U32) -> sections : Maybe Section =>
  let count: U32 = sections.length
  let read: U32 -> Section = sections.at
  for index in 0 .. count:
    let section = read index
    if section.key == key:
      return $Some section
  return $Nothing
func section_start key -> version -> width -> count -> sections -> payload =>
  lanes.require (key <= lanes.max_integer and version <= lanes.max_integer and width <= lanes.max_integer and count <= lanes.max_integer)
  lanes.require (not (Maybe.is_some (find key sections)))
  return payload.length
func append_checked values -> (payload: own #[F32]) : #[F32] =>
  for value in values:
    lanes.require (is_finite value)
    @storage.push payload value
  return payload
func append_section key -> version -> width -> values -> (w: own Writer) : Writer =>
  let count = values.length
  let start = section_start key version width count w.sections w.payload
  w.payload := append_checked values self
  @storage.push w.sections ($Section {key, version, width, start, count})
  return w
func frame_sections (marker: F32) -> (schema: U32) -> (w: Writer) -> (destination: own #[F32]) : #[F32] =>
  let sections = w.sections
  let payload = w.payload
  let section_count: U32 = sections.length
  let payload_count: U32 = payload.length
  lanes.require (schema <= lanes.max_integer and section_count <= lanes.max_integer)
  @storage.truncate destination 0
  destination := append #[marker, U32.to_f32 schema, U32.to_f32 section_count] self
  for index in 0 .. section_count:
    let section = sections[index]
    lanes.require (section.start <= payload_count and section.count <= payload_count - section.start)
    destination := append #[U32.to_f32 section.key, U32.to_f32 section.version, U32.to_f32 section.width, U32.to_f32 section.count] self
    for i in 0 .. section.count:
      @storage.push destination payload[section.start + i]
  return destination
// Rows refer to the input packet by offset. The complete outer framing and
// duplicate keys are checked before invoking any application decoder.
func parse_sections marker -> schema -> values -> (sections: own #[Section]) : #[Section] =>
  let value_count: U32 = values.length
  let read: U32 -> F32 = values.at
  lanes.require (value_count >= 3 and (read (0)) == marker)
  lanes.require (lanes.integer (read (1)) lanes.max_integer == schema)
  let count = lanes.integer (read (2)) lanes.max_integer
  lanes.require (count <= (value_count - 3) / 4)
  @storage.truncate sections 0
  let offset = 3
  for 0 .. count:
    lanes.require (offset <= value_count and value_count - offset >= 4)
    let key = lanes.integer (read (offset)) lanes.max_integer
    let version = lanes.integer (read (offset + 1)) lanes.max_integer
    let width = lanes.integer (read (offset + 2)) lanes.max_integer
    let count = lanes.integer (read (offset + 3)) lanes.max_integer
    let start = offset + 4
    lanes.require (count <= value_count - start)
    lanes.require (not (Maybe.is_some (find key sections)))
    for i in 0 .. count:
      lanes.require (is_finite (read (start + i)))
    @storage.push sections ($Section {key, version, width, start, count})
    offset := start + count
  lanes.require (offset == value_count)
  return sections
func section_values (section: Section) -> values => array.generate section.count (func i => (values.at (section.start + i)))
func fate_code fate : F32 => case fate of
  $Kept => 0.0
  $Migrated => 1.0
  $Reset => 2.0
  $Missing => 3.0
  $Dropped => 4.0
func encode_report outcomes -> (destination: own #[F32]) : #[F32] =>
  @storage.truncate destination 0
  destination := append #[report_magic, U32.to_f32 outcomes.length] self
  for outcome in outcomes:
    destination := append #[U32.to_f32 outcome.key, fate_code outcome.fate, U32.to_f32 outcome.saved, U32.to_f32 outcome.version] self
  return destination
func write_alive (alive: ecs.Entities) -> (w: own Writer) : Writer => return
  append_section 0 1 0 (array.generate alive.length (func i => lanes.bit (alive.at (i)))) w
func restore_alive sections -> values -> (alive: own ecs.Entities) -> (meta: own ecs.Metadata) : (ecs.Entities, ecs.Metadata, Outcome) =>
  let $Some section = find 0 sections else:
    return panic "missing saved entities"
  lanes.require (section.version == 1 and section.width == 0)
  @storage.truncate alive 0
  for i in 0 .. section.count:
    @storage.push alive (lanes.flag (values.at (section.start + i)))
  meta[1] := 0
  meta[2] := 0
  return (alive, meta, $Outcome {key: 0, fate: $Kept, saved: 1, version: 1})
func write_resource codec -> value -> (w: own Writer) : Writer => append_section codec.key codec.version 0 (codec.encode value) w
func write_snapshotted_resource codec -> current -> previous -> (w: own Writer) : Writer =>
  let current_lanes = codec.encode current
  let previous_lanes = codec.encode previous
  let values: #[F32] = #[]
  @storage.push values (U32.to_f32 current_lanes.length)
  values := append current_lanes self
  values := append previous_lanes self
  return append_section codec.key codec.version 0 values w
func converted codec -> (section: Section) -> values =>
  let payload = section_values section values
  if section.version == codec.version:
    return $Some payload
  return codec.migrate section.version payload
func restore_resource codec -> initial -> (owner: own #[a]) -> sections -> values : (#[a], Outcome) =>
  let found = find codec.key sections
  let $Some section = found else:
    owner[0] := initial
    return (owner, $Outcome {key: codec.key, fate: $Missing, saved: 0, version: codec.version})
  lanes.require (section.width == 0)
  let fate = if section.version == codec.version then $Kept else $Migrated
  if let $Some payload = converted codec section values:
    owner[0] := codec.decode payload
  else:
    owner[0] := initial
    fate := $Reset
  return (owner, $Outcome {key: codec.key, fate, saved: section.version, version: codec.version})
// Pool codecs write fixed record widths, retaining the existing flag+padding
// format. Only flat component rows enter a pool; nested data uses span policies.
func append_pool codec -> (width: U32) -> (count: U32) -> pool -> (destination: own #[F32]) : #[F32] =>
  let read: U32 -> Maybe a = pool.at
  let length: U32 = pool.length
  let encode: a -> #[F32] = codec.encode
  for id in 0 .. count:
    let value = if id < length then read id else $Nothing
    if let $Some value = value:
      let encoded = encode value
      lanes.require (encoded.length == width)
      @storage.push destination 1.0
      destination := append_checked encoded self
    else:
      @storage.push destination 0.0
      for 0 .. width:
        @storage.push destination 0.0
  return destination
func pool_lane_count count -> width =>
  let lanes_count = lanes.product count width
  lanes.require (count <= lanes.max_integer - lanes_count)
  return count + lanes_count
func write_component codec -> (width: U32) -> pool -> (w: own Writer) : Writer =>
  let count: U32 = pool.length
  for 0 .. pool.length:
    if count == 0 or ecs.contains pool (count - 1):
      break
    count := count - 1
  let lane_count = pool_lane_count count width
  let start = section_start codec.key codec.version width lane_count w.sections w.payload
  w.payload := append_pool codec width count pool self
  @storage.push w.sections ($Section {key: codec.key, version: codec.version, width, start, count: lane_count})
  return w
func write_snapshotted_scene_component codec -> (width: U32) -> alive -> current -> (w: own Writer) : Writer =>
  let alive_count: U32 = alive.length
  let lane_count = pool_lane_count alive_count width
  let start = section_start codec.key codec.version width lane_count w.sections w.payload
  w.payload := append_pool codec width alive_count current self
  @storage.push w.sections ($Section {key: codec.key, version: codec.version, width, start, count: lane_count})
  return w
func write_snapshotted_component codec -> (width: U32) -> alive -> current -> previous -> (w: own Writer) : Writer =>
  let alive_count: U32 = alive.length
  let count = pool_lane_count alive_count width * 2
  let start = section_start codec.key codec.version width count w.sections w.payload
  w.payload := append_pool codec width alive_count current self
  w.payload := append_pool codec width alive_count previous self
  @storage.push w.sections ($Section {key: codec.key, version: codec.version, width, start, count})
  return w
func step_restore_row (decode: #[F32] -> own s -> (a, s)) -> (migrate: U32 -> #[F32] -> Maybe (#[F32])) -> (alive_at: U32 -> Bool) -> (value_at: U32 -> F32) -> (section: Section) -> (version: U32) -> (width: U32) -> (stride: U32) -> (id: U32) -> (acc: own (s, ecs.Pool a, #[Fate])) : (s, ecs.Pool a, #[Fate]) =>
  let (cur_state, cur_decoded, cur_fate) = acc
  if let $Reset = cur_fate[0]:
    return (cur_state, cur_decoded, cur_fate)
  let start: U32 = section.start + id * stride
  let present = lanes.flag (value_at start)
  if present:
    lanes.require (alive_at id)
    let old: #[F32] = array.generate section.width (func (i: U32) => value_at (start + i + 1))
    let converted: Maybe (#[F32]) = if section.version == version then $Some old else migrate section.version old
    if let $Some row = converted:
      lanes.require (row.length == width)
      let (item, next_state) = decode row cur_state
      @storage.push cur_decoded ($Some item)
      return (next_state, cur_decoded, cur_fate)
    cur_fate[0] := $Reset
    return (cur_state, cur_decoded, cur_fate)
  for i in 0 .. section.width:
    lanes.require (value_at (start + i + 1) == 0.0)
  @storage.push cur_decoded $Nothing
  return (cur_state, cur_decoded, cur_fate)
func restore_component_with codec -> (width: U32) -> (decode: #[F32] -> own s -> (a, s)) -> (state: own s) -> alive -> (pool: own ecs.Pool a) -> (meta: own ecs.Metadata) -> sections -> values : (ecs.Pool a, ecs.Metadata, s, Outcome) =>
  let key: U32 = codec.key
  let version: U32 = codec.version
  let alive_count: U32 = alive.length
  let alive_at: U32 -> Bool = alive.at
  let value_at: U32 -> F32 = values.at
  let migrate: U32 -> #[F32] -> Maybe (#[F32]) = codec.migrate
  let found: Maybe Section = find key sections
  let $Some section = found else:
    @storage.truncate pool 0
    meta[1] := 0
    meta[2] := 0
    return (pool, meta, state, $Outcome {key: key, fate: $Missing, saved: 0, version: version})
  let saved: U32 = section.version
  let init_fate: #[Fate] = #[if section.version == version then $Kept else $Migrated]
  lanes.require (section.width < lanes.max_integer)
  let stride: U32 = section.width + 1
  lanes.require (section.count % stride == 0 and section.count / stride <= alive_count)
  if section.version == version:
    lanes.require (section.width == width)
  let decoded: ecs.Pool a = ecs.pool ()
  let loop_acc = (state, decoded, init_fate)
  for id in 0 .. section.count / stride:
    loop_acc := step_restore_row decode migrate alive_at value_at section version width stride id self
  let (final_state, final_decoded, final_fate_arr) = loop_acc
  let fate: Fate = final_fate_arr[0]
  @storage.truncate pool 0
  if let $Reset = fate:
    ()
  else:
    for value in final_decoded:
      @storage.push pool value
  meta[1] := 0
  meta[2] := 0
  return (pool, meta, final_state, $Outcome {key: key, fate, saved, version: version})
func decode_component_rows codec -> (width: U32) -> alive -> sections -> values =>
  let key: U32 = codec.key
  let version: U32 = codec.version
  let alive_count: U32 = alive.length
  let alive_at: U32 -> Bool = alive.at
  let value_at: U32 -> F32 = values.at
  let decode: #[F32] -> a = codec.decode
  let migrate: U32 -> #[F32] -> Maybe (#[F32]) = codec.migrate
  let found: Maybe Section = find key sections
  let decoded: ecs.Pool a = ecs.pool ()
  let fate: Fate = $Missing
  let saved: U32 = 0
  if let $Some section = found:
    saved := section.version
    fate := if section.version == version then $Kept else $Migrated
    lanes.require (section.width < lanes.max_integer)
    let stride: U32 = section.width + 1
    lanes.require (section.count % stride == 0 and section.count / stride <= alive_count)
    if section.version == version:
      lanes.require (section.width == width)
    for id in 0 .. section.count / stride:
      let start: U32 = section.start + id * stride
      let present = lanes.flag (value_at start)
      if present:
        lanes.require (alive_at id)
        let old: #[F32] = array.generate section.width (func (i: U32) => value_at (start + i + 1))
        let converted: Maybe (#[F32]) = if section.version == version then $Some old else migrate section.version old
        if let $Some row = converted:
          lanes.require (row.length == width)
          @storage.push decoded ($Some (decode row))
        else:
          fate := $Reset
          break
      else:
        for i in 0 .. section.width:
          lanes.require (value_at (start + i + 1) == 0.0)
        @storage.push decoded $Nothing
  return (decoded, $Outcome {key: key, fate, saved, version: version})
func commit_component_rows (decoded: &[Maybe a]) -> (fate: Fate) -> (pool: own ecs.Pool a) -> (meta: own ecs.Metadata) : (ecs.Pool a, ecs.Metadata) =>
  @storage.truncate pool 0
  if let $Reset = fate:
    ()
  else:
    for value in decoded:
      @storage.push pool value
  meta[1] := 0
  meta[2] := 0
  return (pool, meta)
func restore_component codec -> (width: U32) -> alive -> (pool: own ecs.Pool a) -> (meta: own ecs.Metadata) -> sections -> values : (ecs.Pool a, ecs.Metadata, Outcome) =>
  let (decoded, outcome) = decode_component_rows codec width alive sections values
  let (pool, meta) = commit_component_rows (&decoded[0..decoded.length]) outcome.fate pool meta
  return (pool, meta, outcome)
// Static schema functions directly call the helpers above for named owners.
// No dynamic registry, function arrays, State effects or saved closure chain.
func encode_state schema -> (encode_schema: a -> own Writer -> Writer) -> access -> (destination: own #[F32]) : #[F32] =>
  let w = encode_schema access (writer ())
  return frame_sections magic schema w destination
func encode_scene schema -> (encode_schema: a -> own Writer -> Writer) -> access -> (destination: own #[F32]) : #[F32] =>
  let w = encode_schema access (writer ())
  return frame_sections scene_magic schema w destination
// Decoding takes the world over: `decode_schema (own access) sections values
// (own outcomes)` restores each section into it and returns `(access, outcomes)`.
func decoded (marker: F32) -> schema -> values -> decode_schema -> (own access) =>
  let sections: #[Section] = #[]
  sections := parse_sections marker schema values self
  let outcomes: #[Outcome] = #[]
  let (next_access, next_outcomes) = decode_schema (own access) sections values (own outcomes)
  let final_outcomes = dropped sections next_outcomes
  let report: #[F32] = #[]
  report := encode_report final_outcomes self
  return (report, next_access)
func decode_state schema -> values -> decode_schema -> (own access) => decoded magic schema values decode_schema access
func decode_scene schema -> values -> decode_schema -> (own access) => decoded scene_magic schema values decode_schema access

// Snapshot resources retain the existing current-count/current/previous layout.
func restore_snapshotted_resource codec -> initial -> (own current) -> (own previous) -> sections -> values =>
  let $Some section = find codec.key sections else:
    current[0] := initial
    previous[0] := initial
    return (current, previous, $Outcome {key: codec.key, fate: $Missing, saved: 0, version: codec.version})
  lanes.require (section.width == 0 and section.count >= 1)
  let count = lanes.integer (values.at (section.start)) lanes.max_integer
  lanes.require (count <= section.count - 1)
  let first = array.generate count (func i => (values.at (section.start + 1 + i)))
  let second = array.generate (section.count - 1 - count) (func i => (values.at (section.start + 1 + count + i)))
  let now = if section.version == codec.version then $Some first else codec.migrate section.version first
  let before = if section.version == codec.version then $Some second else codec.migrate section.version second
  let fate = if section.version == codec.version then $Kept else $Migrated
  if let $Some encoded = now:
    if let $Some encoded_before = before:
      current[0] := codec.decode encoded
      previous[0] := codec.decode encoded_before
    else:
      current[0] := initial
      previous[0] := initial
      fate := $Reset
  else:
    current[0] := initial
    previous[0] := initial
    fate := $Reset
  return (current, previous, $Outcome {key: codec.key, fate, saved: section.version, version: codec.version})
private func is_reset (fate: Fate) : Bool => case fate of
  $Reset => true
  _ => false
func restore_snapshotted_component codec -> (width: U32) -> copy_value -> alive -> (current: own ecs.Pool a) -> (current_meta: own ecs.Metadata) -> (previous: own ecs.Pool a) -> (previous_meta: own ecs.Metadata) -> sections -> values =>
  let alive_count: U32 = alive.length
  let $Some section = find codec.key sections else:
    let (current, current_meta, outcome) = restore_component codec width alive current current_meta sections values
    let (previous, previous_meta, _) = restore_component codec width alive previous previous_meta sections values
    return (current, current_meta, previous, previous_meta, outcome)
  lanes.require (section.width < lanes.max_integer)
  let block = lanes.product alive_count (section.width + 1)
  if section.version != codec.version and section.count <= block:
    let (restored, restored_meta, outcome) = restore_component codec width alive current current_meta #[section] values
    previous := ecs.copy_into copy_value self restored
    previous_meta[1] := 0
    previous_meta[2] := 0
    return (restored, restored_meta, previous, previous_meta, outcome)
  lanes.require (block <= lanes.max_integer / 2 and section.count == block * 2)
  let first = $Section {key: section.key, version: section.version, width: section.width, start: section.start, count: block}
  let second = $Section {key: section.key, version: section.version, width: section.width, start: section.start + block, count: block}
  let (curr_rows, outcome) = decode_component_rows codec width alive #[first] values
  let (prev_rows, prev_outcome) = decode_component_rows codec width alive #[second] values
  if is_reset outcome.fate or is_reset prev_outcome.fate:
    @storage.truncate current 0
    @storage.truncate previous 0
    current_meta[1] := 0
    current_meta[2] := 0
    previous_meta[1] := 0
    previous_meta[2] := 0
    return (current, current_meta, previous, previous_meta, $Outcome {key: codec.key, fate: $Reset, saved: section.version, version: codec.version})
  let (current, current_meta) = commit_component_rows (&curr_rows[0..curr_rows.length]) outcome.fate current current_meta
  let (previous, previous_meta) = commit_component_rows (&prev_rows[0..prev_rows.length]) prev_outcome.fate previous previous_meta
  return (current, current_meta, previous, previous_meta, outcome)
func dropped sections -> (outcomes: own #[Outcome]) : #[Outcome] =>
  for section in sections:
    let known = false
    for outcome in outcomes:
      known := known or outcome.key == section.key
    if not known:
      @storage.push outcomes ($Outcome {key: section.key, fate: $Dropped, saved: section.version, version: 0})
  return outcomes

// `decode_into payload (own access)` and `reset (own access)` take the
// world over and return it.
func restore_into codec -> decode_into -> reset -> (own access) -> sections -> values =>
  let found = find codec.key sections
  let fate = $Missing
  let saved = 0
  if let $Some section = found:
    saved := section.version
    lanes.require (section.width == 0)
    if let $Some payload = converted codec section values:
      access := decode_into payload (own access)
      fate := if section.version == codec.version then $Kept else $Migrated
    else:
      access := reset (own access)
      fate := $Reset
  else:
    access := reset (own access)
  return (access, $Outcome {key: codec.key, fate, saved, version: codec.version})
