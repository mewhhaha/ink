import * as array from "std/array"
import * as ecs from "./ecs"
import * as lanes from "./lanes"

// Saved framing is unchanged: marker,schema,count; key,version,width,length,
// payload per section. Section rows are flat spans into a separate lane owner.
const magic: F32 = 5678.0
const scene_magic: F32 = 5679.0
const report_magic: F32 = 5680.0
type Section is data = $Section {key: U32, version: U32, width: U32, start: U32, count: U32}
type Fate is data = $Kept | $Migrated | $Reset | $Missing | $Dropped
type Outcome is data = $Outcome {key: U32, fate: Fate, saved: U32, version: U32}
type Request is data = $Save | $Load | $SaveScene | $LoadScene | $Checkpoint | $Undo | $Redo | $StashScene | $RestoreScene | $Exit
type Requests = Array U32
func requests () : Requests => return #[0]
func request_bit wanted => return case wanted of
  $Save => 1
  $Load => 2
  $SaveScene => 4
  $LoadScene => 8
  $Checkpoint => 16
  $Undo => 32
  $Redo => 64
  $StashScene => 128
  $RestoreScene => 256
  $Exit => 512
func has (requests: Requests) -> wanted => return requests[0] & request_bit wanted != 0
func request (requests: Requests) -> wanted => return do:
  requests[0] = requests[0] | request_bit wanted
func clear_requests (requests: Requests) => return do:
  requests[0] = 0
func append values -> (destination: ResizeArray F32) => return do:
  let count = values.length
  for i in 0 .. count:
    destination.push (values.at (i))
func find (key: U32) -> sections : Maybe Section => return do:
  let count: U32 = sections.length
  let read: U32 -> Section = sections.at
  for index in 0 .. count:
    let section = read index
    if section.key == key:
      return $Some section
  return $Nothing
func append_section key -> version -> width -> values -> (sections: ResizeArray Section) -> (payload: ResizeArray F32) => return do:
  lanes.require (key <= lanes.max_integer and version <= lanes.max_integer and width <= lanes.max_integer and values.length <= lanes.max_integer)
  lanes.require (Bool.not (Maybe.is_some (find key sections)))
  let start = payload.length
  for value in values:
    lanes.require (is_finite value)
    payload.push value
  sections.push ($Section {key, version, width, start, count: values.length})
func frame_sections (marker: F32) -> (schema: U32) -> sections -> payload -> (destination: ResizeArray F32) => return do:
  let section_count: U32 = sections.length
  let section_at: U32 -> Section = sections.at
  let payload_count: U32 = payload.length
  let payload_at: U32 -> F32 = payload.at
  lanes.require (schema <= lanes.max_integer and section_count <= lanes.max_integer)
  destination.truncate 0
  append #[marker, U32.to_f32 schema, U32.to_f32 section_count] destination
  for index in 0 .. section_count:
    let section = section_at index
    lanes.require (section.start <= payload_count and section.count <= payload_count - section.start)
    append #[U32.to_f32 section.key, U32.to_f32 section.version, U32.to_f32 section.width, U32.to_f32 section.count] destination
    for i in 0 .. section.count:
      destination.push (payload_at (section.start + i))
// Rows refer to the input packet by offset. The complete outer framing and
// duplicate keys are checked before invoking any application decoder.
func parse_sections marker -> schema -> values -> (sections: ResizeArray Section) => return do:
  let value_count: U32 = values.length
  let read: U32 -> F32 = values.at
  lanes.require (value_count >= 3 and (read (0)) == marker)
  lanes.require (lanes.integer (read (1)) lanes.max_integer == schema)
  let count = lanes.integer (read (2)) lanes.max_integer
  lanes.require (count <= (value_count - 3) / 4)
  sections.truncate 0
  let offset = 3
  for 0 .. count:
    lanes.require (offset <= value_count and value_count - offset >= 4)
    let key = lanes.integer (read (offset)) lanes.max_integer
    let version = lanes.integer (read (offset + 1)) lanes.max_integer
    let width = lanes.integer (read (offset + 2)) lanes.max_integer
    let count = lanes.integer (read (offset + 3)) lanes.max_integer
    let start = offset + 4
    lanes.require (count <= value_count - start)
    lanes.require (Bool.not (Maybe.is_some (find key sections)))
    for i in 0 .. count:
      lanes.require (is_finite (read (start + i)))
    sections.push ($Section {key, version, width, start, count})
    offset := start + count
  lanes.require (offset == value_count)
func section_values (section: Section) -> values => return array.generate section.count (func i => return (values.at (section.start + i)))
func fate_code fate : F32 => return case fate of
  $Kept => 0.0
  $Migrated => 1.0
  $Reset => 2.0
  $Missing => 3.0
  $Dropped => 4.0
func encode_report outcomes -> (destination: ResizeArray F32) => return do:
  destination.truncate 0
  append #[report_magic, U32.to_f32 outcomes.length] destination
  for outcome in outcomes:
    append #[U32.to_f32 outcome.key, fate_code outcome.fate, U32.to_f32 outcome.saved, U32.to_f32 outcome.version] destination
func write_alive (alive: ecs.Entities) -> sections -> payload => return
  append_section 0 1 0 (array.generate alive.length (func i => return lanes.bit (alive.at (i)))) sections payload
func restore_alive sections -> values -> (alive: ecs.Entities) -> meta -> outcomes => return do:
  let $Some section = find 0 sections else:
    return @panic "missing saved entities"
  lanes.require (section.version == 1 and section.width == 0)
  alive.truncate 0
  for i in 0 .. section.count:
    alive.push (lanes.flag (values.at (section.start + i)))
  meta[1] = 0
  meta[2] = 0
  outcomes.push ($Outcome {key: 0, fate: $Kept, saved: 1, version: 1})
func write_resource codec -> value -> sections -> payload => return append_section codec.key codec.version 0 (codec.encode value) sections payload
func write_snapshotted_resource codec -> current -> previous -> sections -> payload => return do:
  let current_lanes = codec.encode current
  let previous_lanes = codec.encode previous
  let values: ResizeArray F32 = #[]
  values.push (U32.to_f32 current_lanes.length)
  append current_lanes values
  append previous_lanes values
  append_section codec.key codec.version 0 values sections payload
lent func converted codec -> (section: Section) -> values => return do:
  let payload = section_values section values
  if section.version == codec.version:
    return $Some payload
  return codec.migrate section.version payload
func restore_resource codec -> initial -> (owner: Array a) -> sections -> values -> outcomes => return do:
  let found = find codec.key sections
  let $Some section = found else:
    owner[0] = initial
    outcomes.push ($Outcome {key: codec.key, fate: $Missing, saved: 0, version: codec.version})
    return ()
  lanes.require (section.width == 0)
  let decoded = converted codec section values
  let fate = if section.version == codec.version then $Kept else $Migrated
  if let $Some payload = decoded:
    owner[0] = codec.decode payload
  else:
    owner[0] = initial
    fate := $Reset
  outcomes.push ($Outcome {key: codec.key, fate, saved: section.version, version: codec.version})
// Pool codecs write fixed record widths, retaining the existing flag+padding
// format. Only flat component rows enter a pool; nested data uses span policies.
func append_pool codec -> (width: U32) -> (count: U32) -> pool -> (destination: ResizeArray F32) => return do:
  let read: U32 -> Maybe a = pool.at
  let length: U32 = pool.length
  let encode: a -> Array F32 = codec.encode
  for id in 0 .. count:
    let value = if id < length then read id else $Nothing
    if let $Some value = value:
      let encoded = encode value
      lanes.require (encoded.length == width)
      destination.push 1.0
      append encoded destination
    else:
      destination.push 0.0
      for 0 .. width:
        destination.push 0.0
func write_component codec -> (width: U32) -> pool -> sections -> payload => return do:
  let count: U32 = pool.length
  for 0 .. pool.length:
    if count == 0 or ecs.contains pool (count - 1):
      break
    count := count - 1
  let values: ResizeArray F32 = #[]
  append_pool codec width count pool values
  append_section codec.key codec.version width values sections payload
func write_snapshotted_component codec -> (width: U32) -> alive -> current -> previous -> sections -> payload => return do:
  let alive_count: U32 = alive.length
  let values: ResizeArray F32 = #[]
  append_pool codec width alive_count current values
  append_pool codec width alive_count previous values
  append_section codec.key codec.version width values sections payload
func restore_component codec -> (width: U32) -> alive -> (pool: ecs.Pool a) -> (meta: ecs.Metadata) -> sections -> values -> (outcomes: ResizeArray Outcome) => return do:
  let key: U32 = codec.key
  let version: U32 = codec.version
  let alive_count: U32 = alive.length
  let alive_at: U32 -> Bool = alive.at
  let value_at: U32 -> F32 = values.at
  let decode: Array F32 -> a = codec.decode
  let migrate: U32 -> Array F32 -> Maybe (Array F32) = codec.migrate
  let found: Maybe Section = find key sections
  let decoded: ecs.Pool a = ecs.pool ()
  let fate: Fate = $Missing
  let saved: U32 = 0
  if let $Some section = found:
    saved := section.version
    fate := if section.version == version then $Kept else $Migrated
    lanes.require (section.width < lanes.max_integer)
    let stride: U32 = section.width + 1
    lanes.require (section.count % stride == 0 and section.count / stride <= alive_count)
    if section.version == version:
      lanes.require (section.width == width)
    for id in 0 .. section.count / stride:
      let start: U32 = section.start + id * stride
      let present = lanes.flag (value_at start)
      if present:
        lanes.require (alive_at id)
        let old: Array F32 = array.generate section.width (func (i: U32) => return value_at (start + i + 1))
        let converted: Maybe (Array F32) = if section.version == version then $Some old else migrate section.version old
        if let $Some row = converted:
          lanes.require (row.length == width)
          decoded.push ($Some (decode row))
        else:
          fate := $Reset
          break
      else:
        for i in 0 .. section.width:
          lanes.require (value_at (start + i + 1) == 0.0)
        decoded.push $Nothing
  pool.truncate 0
  if let $Reset = fate:
    ()
  else:
    for value in decoded:
      pool.push value
  meta[1] = 0
  meta[2] = 0
  outcomes.push ($Outcome {key: key, fate, saved, version: version})
// Static schema functions directly call the helpers above for named owners.
// No dynamic registry, function arrays, State effects or saved closure chain.
func encode_state schema -> (sections: ResizeArray Section) -> (payload: ResizeArray F32) -> encode_schema -> access -> destination => return do:
  sections.truncate 0
  payload.truncate 0
  encode_schema access sections payload
  frame_sections magic schema sections payload destination
func encode_scene schema -> (sections: ResizeArray Section) -> (payload: ResizeArray F32) -> encode_schema -> access -> destination => return do:
  sections.truncate 0
  payload.truncate 0
  encode_schema access sections payload
  frame_sections scene_magic schema sections payload destination
func decode_state schema -> values -> sections -> decode_schema -> access -> outcomes -> destination => return do:
  parse_sections magic schema values sections
  outcomes.truncate 0
  decode_schema access sections values outcomes
  dropped sections outcomes
  encode_report outcomes destination
func decode_scene schema -> values -> sections -> decode_schema -> access -> outcomes -> destination => return do:
  parse_sections scene_magic schema values sections
  outcomes.truncate 0
  decode_schema access sections values outcomes
  dropped sections outcomes
  encode_report outcomes destination

// Snapshot resources retain the existing current-count/current/previous layout.
func restore_snapshotted_resource codec -> initial -> current -> previous -> sections -> values -> outcomes => return do:
  let $Some section = find codec.key sections else:
    current[0] = initial
    previous[0] = initial
    outcomes.push ($Outcome {key: codec.key, fate: $Missing, saved: 0, version: codec.version})
    return ()
  lanes.require (section.width == 0 and section.count >= 1)
  let count = lanes.integer (values.at (section.start)) lanes.max_integer
  lanes.require (count <= section.count - 1)
  let first = array.generate count (func i => return (values.at (section.start + 1 + i)))
  let second = array.generate (section.count - 1 - count) (func i => return (values.at (section.start + 1 + count + i)))
  let now = if section.version == codec.version then $Some first else codec.migrate section.version first
  let before = if section.version == codec.version then $Some second else codec.migrate section.version second
  let fate = if section.version == codec.version then $Kept else $Migrated
  if let $Some encoded = now:
    if let $Some encoded_before = before:
      current[0] = codec.decode encoded
      previous[0] = codec.decode encoded_before
    else:
      current[0] = initial
      previous[0] = initial
      fate := $Reset
  else:
    current[0] = initial
    previous[0] = initial
    fate := $Reset
  outcomes.push ($Outcome {key: codec.key, fate, saved: section.version, version: codec.version})
func restore_snapshotted_component codec -> (width: U32) -> copy_value -> alive -> (current: ecs.Pool a) -> (current_meta: ecs.Metadata) -> (previous: ecs.Pool a) -> (previous_meta: ecs.Metadata) -> sections -> values -> (outcomes: ResizeArray Outcome) => return do:
  let alive_count: U32 = alive.length
  let temporary: ResizeArray Outcome = #[]
  let $Some section = find codec.key sections else:
    restore_component codec width alive current current_meta sections values temporary
    restore_component codec width alive previous previous_meta sections values temporary
    outcomes.push temporary[0]
    return ()
  lanes.require (section.width < lanes.max_integer)
  let block = lanes.product alive_count (section.width + 1)
  if section.version != codec.version and section.count <= block:
    restore_component codec width alive current current_meta #[section] values temporary
    ecs.copy_into copy_value previous current
    previous_meta[1] = 0
    previous_meta[2] = 0
  else:
    lanes.require (block <= lanes.max_integer / 2 and section.count == block * 2)
    let first = $Section {key: section.key, version: section.version, width: section.width, start: section.start, count: block}
    let second = $Section {key: section.key, version: section.version, width: section.width, start: section.start + block, count: block}
    restore_component codec width alive current current_meta #[first] values temporary
    restore_component codec width alive previous previous_meta #[second] values temporary
  outcomes.push temporary[0]
func dropped sections -> outcomes => return do:
  for section in sections:
    let known = false
    for outcome in outcomes:
      known := known or outcome.key == section.key
    if Bool.not known:
      outcomes.push ($Outcome {key: section.key, fate: $Dropped, saved: section.version, version: 0})

// Known decode/reset policies write into named destination owners. Complex
// resource payloads never escape as freshly owning aggregate decode results.
func restore_into codec -> decode_into -> reset -> access -> sections -> values -> outcomes => return do:
  let found = find codec.key sections
  let fate = $Missing
  let saved = 0
  if let $Some section = found:
    saved := section.version
    lanes.require (section.width == 0)
    if let $Some payload = converted codec section values:
      decode_into payload access
      fate := if section.version == codec.version then $Kept else $Migrated
    else:
      reset access
      fate := $Reset
  else:
    reset access
  outcomes.push ($Outcome {key: codec.key, fate, saved, version: codec.version})
  return ()
