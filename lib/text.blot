import * as array from "std/array"
import * as ui from "./ui"

// Text as the dev tools read and write it, in code points: comparing it,
// cutting it into words and lines, reading numbers out of it as the
// browser's console does (JavaScript's Number) and writing numbers into it.

// Text partitions are scalar spans into the separately owned source text.
// Materialize with part when an independent retained copy is required.
type Span is data = $Span {start: U32, count: U32}
const space = 32
const newline = 10
const slash = 47
const dot = 46
const minus = 45

// Whether `left` and `right` are the same text.
func same left => func right : Bool =>
  let left_length: U32 = left.length
  let right_length: U32 = right.length
  let read_left: U32 -> U32 = left.at
  let read_right: U32 -> U32 = right.at
  if left_length != right_length:
    return false
  for index in 0 .. left_length:
    if read_left index != read_right index:
      return false
  return true

// Whether `text` starts with `prefix`.
func starts prefix => func text : Bool =>
  let prefix_length: U32 = prefix.length
  let text_length: U32 = text.length
  let read_prefix: U32 -> U32 = prefix.at
  let read_text: U32 -> U32 = text.at
  if prefix_length > text_length:
    return false
  for index in 0 .. prefix_length:
    if read_prefix index != read_text index:
      return false
  return true

// Whether `left` sorts before `right`, code point by code point.
func before left => func right : Bool =>
  let left_length: U32 = left.length
  let right_length: U32 = right.length
  let read_left: U32 -> U32 = left.at
  let read_right: U32 -> U32 = right.at
  for index in 0 .. min left_length right_length:
    let a: U32 = read_left index
    let b: U32 = read_right index
    if a != b:
      return a < b
  return left_length < right_length

// Where the first `code` in `text` is, if it has one.
func find (code: U32) => func text : Maybe U32 =>
  let text_length: U32 = text.length
  for index in 0 .. text_length:
    if (array.at (index) text) == code:
      return $Some index
  return $Nothing

// The `count` code points of `text` from `start`.
func part (start: U32) => func (count: U32) => func text : #[U32] => array.slice start count text

// `text` from `start` on.
func rest (start: U32) => func text : #[U32] =>
  let text_length: U32 = text.length
  let at = min start text_length
  return array.slice at (text_length - at) text

// `text` without the spaces at either end.
func trimmed text : #[U32] =>
  let text_length: U32 = text.length
  let start = 0
  for index in 0 .. text_length:
    if (array.at (index) text) == space and start == index:
      start := index + 1
  let end = text_length
  for back in 0 .. text_length - start:
    if (array.at (text_length - 1 - back) text) == space and end == text_length - back:
      end := text_length - 1 - back
  return part start (end - start) text

// The words of `text`, between its spaces. Count them, then cut each into
// scalar spans; the source text owns the code points throughout their use.
func words text : #[Span] =>
  let text_length: U32 = text.length
  let count = 0
  let start = 0
  for index in 0 .. text_length:
    if (array.at (index) text) == space:
      if index > start:
        count := self + 1
      start := index + 1
  if text_length > start:
    count := self + 1
  let none = $Span {start: 0, count: 0}
  let found = array.fill count none
  let at = 0
  start := 0
  for index in 0 .. text_length:
    if (array.at (index) text) == space:
      if index > start:
        found[at] := $Span {start, count: index - start}
        at := self + 1
      start := index + 1
  if text_length > start:
    found[at] := $Span {start, count: text_length - start}
  return found

// The lines of `text`, between its newlines.
func lines text : #[Span] =>
  let text_length: U32 = text.length
  let count = 1
  for code in text:
    if code == newline:
      count := self + 1
  let none = $Span {start: 0, count: 0}
  let found = array.fill count none
  let at = 0
  let start = 0
  for index in 0 .. text_length:
    if (array.at (index) text) == newline:
      found[at] := $Span {start, count: index - start}
      at := self + 1
      start := index + 1
  found[at] := $Span {start, count: text_length - start}
  return found

// `parts` with `separator` between them.
func joined (separator: #[U32]) => func (parts: #[&[U32]]) =>
  let count = 0
  for index in 0 .. parts.length:
    let size = parts[index].length
    if index > 0:
      let next = count + separator.length
      if next < count:
        return panic "joined text length overflow"
      count := next
    let next = count + size
    if next < count:
      return panic "joined text length overflow"
    count := next
  let out: #[U32] = array.fill count 0
  let at = 0
  for index in 0 .. parts.length:
    if index > 0:
      for code in separator:
        out[at] := code
        at := self + 1
    for code in parts[index]:
      out[at] := code
      at := self + 1
  return out

func digit (code: U32) => code >= 48 and code <= 57

// A whole number in decimal digits and nothing else, below a billion.
func count text : Maybe U32 =>
  let text_length: U32 = text.length
  if text_length == 0 or text_length > 9:
    return $Nothing
  let value = 0
  for code in text:
    if not (digit code):
      return $Nothing
    value := self * 10 + (code - 48)
  return $Some value

// Ten to the power of `exponent`, with at most 39 multiplications. Exponents
// from 39 onward overflow F32 to positive infinity.
func power (exponent: U32) =>
  let value = 1.0
  for 0 .. min exponent 39:
    value := self * 10.0
  return value

// A finite number as JavaScript's Number reads one (2.5, -3, .5, 4., 1e3),
// to within a float's precision: its first nine digits count.
func number text : Maybe F32 =>
  let text_length: U32 = text.length
  let at = 0
  let negative = false
  if text_length > 0 and ((array.at (0) text) == minus or (array.at (0) text) == 43):
    negative := (array.at (0) text) == minus
    at := 1
  // The digits kept, how many, those of them after the point, the whole
  // digits dropped, and where an exponent starts.
  let mantissa = 0
  let kept = 0
  let decimals = 0
  let dropped = 0
  let seen = false
  let fraction = false
  let exponent_at = text_length
  for index in at .. text_length:
    let code = (array.at (index) text)
    if index < exponent_at:
      if digit code:
        seen := true
        if kept < 9:
          mantissa := self * 10 + (code - 48)
          kept := self + 1
          if fraction:
            decimals := self + 1
        else:
          if not fraction:
            dropped := self + 1
      else:
        if code == dot and not fraction:
          fraction := true
        else:
          exponent_at := index
  if not seen:
    return $Nothing
  let shift = 0.0
  if exponent_at < text_length:
    let marker = (array.at (exponent_at) text)
    if marker != 101 and marker != 69:
      return $Nothing
    let sign_at = exponent_at + 1
    let below = sign_at < text_length and (array.at (sign_at) text) == minus
    let signed = sign_at < text_length and ((array.at (sign_at) text) == minus or (array.at (sign_at) text) == 43)
    let digits_at = sign_at
    if signed:
      digits_at := self + 1
    let $Some written = count (rest digits_at text) else:
      return $Nothing
    shift := U32.to_f32 written
    if below:
      shift := 0.0 - self
  let decimal = shift + U32.to_f32 dropped - U32.to_f32 decimals
  let magnitude = U32.to_f32 mantissa
  let value = magnitude
  if decimal >= 0.0:
    value := self * power (F32.to_u32 (min decimal 40.0))
  else:
    value := self / power (F32.to_u32 (min (0.0 - decimal) 50.0))
  if not (is_finite value):
    return $Nothing
  if negative:
    value := 0.0 - self
  return $Some value

// The shortest decimal within six places; large magnitudes use scientific
// notation. Nonfinite values use the same labels as ui.decimal.
func shown (value: F32) =>
  if not (is_finite value):
    return ui.decimal value 0
  let (size, _) = ui.decimal_magnitude (abs value)
  for places in 0 .. 7:
    let scale = power places
    if floor (size * scale + 0.5) / scale == size:
      return ui.decimal value places
  return ui.decimal value 6

// `value` with exactly min(places, 6) decimals, using the same bounded
// scientific/nonfinite formatting as ui.decimal.
func fixed (value: F32) => func (places: U32) => ui.formatted value places true
