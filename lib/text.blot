import * as array from "std/array"
import * as ui from "./ui"

// Text as the dev tools read and write it, in code points: comparing it,
// cutting it into words and lines, reading numbers out of it as the
// browser's console does (JavaScript's Number) and writing numbers into it.

// Text partitions are scalar spans into the separately owned source text.
// Materialize with part when an independent retained copy is required.
type Span is data = $Span {start: U32, count: U32}
const space = 32
const newline = 10
const slash = 47
const dot = 46
const minus = 45

// Whether `left` and `right` are the same text.
const same = func (left: Array U32) => return func (right: Array U32) => return do:
  if left.length != right.length:
    return false
  for index in 0 .. left.length:
    if left[index] != right[index]:
      return false
  return true

// Whether `text` starts with `prefix`.
const starts = func (prefix: Array U32) => return func (text: Array U32) => return do:
  if prefix.length > text.length:
    return false
  for index in 0 .. prefix.length:
    if prefix[index] != text[index]:
      return false
  return true

// Whether `left` sorts before `right`, code point by code point.
const before = func (left: Array U32) => return func (right: Array U32) => return do:
  for index in 0 .. min left.length right.length:
    if left[index] != right[index]:
      return left[index] < right[index]
  return left.length < right.length

// Where the first `code` in `text` is, if it has one.
const find = func (code: U32) => return func (text: Array U32) => return do:
  for index in 0 .. text.length:
    if text[index] == code:
      return $Some index
  return $Nothing

// The `count` code points of `text` from `start`.
const part = func (start: U32) => return func (count: U32) => return func (text: Array U32) => return array.slice start count text

// `text` from `start` on.
const rest = func (start: U32) => return func (text: Array U32) => return do:
  let at = min start text.length
  return array.slice at (text.length - at) text

// `text` without the spaces at either end.
const trimmed = func (text: Array U32) => return do:
  let start = 0
  for index in 0 .. text.length:
    if text[index] == space and start == index:
      start := index + 1
  let end = text.length
  for back in 0 .. text.length - start:
    if text[text.length - 1 - back] == space and end == text.length - back:
      end := text.length - 1 - back
  return part start (end - start) text

// The words of `text`, between its spaces. Count them, then cut each into
// scalar spans; the source text owns the code points throughout their use.
const words = func (text: Array U32) => return do:
  let count = 0
  let start = 0
  for index in 0 .. text.length:
    if text[index] == space:
      if index > start:
        count := self + 1
      start := index + 1
  if text.length > start:
    count := self + 1
  let none = $Span {start: 0, count: 0}
  let found = array.fill count none
  let at = 0
  start := 0
  for index in 0 .. text.length:
    if text[index] == space:
      if index > start:
        found[at] := $Span {start, count: index - start}
        at := self + 1
      start := index + 1
  if text.length > start:
    found[at] := $Span {start, count: text.length - start}
  return found

// The lines of `text`, between its newlines.
const lines = func (text: Array U32) => return do:
  let count = 1
  for code in text:
    if code == newline:
      count := self + 1
  let none = $Span {start: 0, count: 0}
  let found = array.fill count none
  let at = 0
  let start = 0
  for index in 0 .. text.length:
    if text[index] == newline:
      found[at] := $Span {start, count: index - start}
      at := self + 1
      start := index + 1
  found[at] := $Span {start, count: text.length - start}
  return found

// `parts` with `separator` between them.
const joined = func (separator: Array U32) => return func (parts: Array (&[U32])) => return do:
  let count = 0
  for index in 0 .. parts.length:
    let size = parts[index].length
    if index > 0:
      let next = count + separator.length
      if next < count:
        return @panic "joined text length overflow"
      count := next
    let next = count + size
    if next < count:
      return @panic "joined text length overflow"
    count := next
  let out: Array U32 = array.fill count 0
  let at = 0
  for index in 0 .. parts.length:
    if index > 0:
      for code in separator:
        out[at] := code
        at := self + 1
    for code in parts[index]:
      out[at] := code
      at := self + 1
  return out

const digit = func (code: U32) => return code >= 48 and code <= 57

// A whole number in decimal digits and nothing else, below a billion.
const count = func (text: Array U32) => return do:
  if text.length == 0 or text.length > 9:
    return $Nothing
  let value = 0
  for code in text:
    if Bool.not (digit code):
      return $Nothing
    value := self * 10 + (code - 48)
  return $Some value

// Ten to the power of `exponent`, with at most 39 multiplications. Exponents
// from 39 onward overflow F32 to positive infinity.
const power = func (exponent: U32) => return do:
  let value = 1.0
  for 0 .. min exponent 39:
    value := self * 10.0
  return value

// A finite number as JavaScript's Number reads one (2.5, -3, .5, 4., 1e3),
// to within a float's precision: its first nine digits count.
const number = func (text: Array U32) => return do:
  let at = 0
  let negative = false
  if text.length > 0 and (text[0] == minus or text[0] == 43):
    negative := text[0] == minus
    at := 1
  // The digits kept, how many, those of them after the point, the whole
  // digits dropped, and where an exponent starts.
  let mantissa = 0
  let kept = 0
  let decimals = 0
  let dropped = 0
  let seen = false
  let fraction = false
  let exponent_at = text.length
  for index in at .. text.length:
    let code = text[index]
    if index < exponent_at:
      if digit code:
        seen := true
        if kept < 9:
          mantissa := self * 10 + (code - 48)
          kept := self + 1
          if fraction:
            decimals := self + 1
        else:
          if Bool.not fraction:
            dropped := self + 1
      else:
        if code == dot and Bool.not fraction:
          fraction := true
        else:
          exponent_at := index
  if Bool.not seen:
    return $Nothing
  let shift = 0.0
  if exponent_at < text.length:
    let marker = text[exponent_at]
    if marker != 101 and marker != 69:
      return $Nothing
    let sign_at = exponent_at + 1
    let below = sign_at < text.length and text[sign_at] == minus
    let signed = sign_at < text.length and (text[sign_at] == minus or text[sign_at] == 43)
    let digits_at = sign_at
    if signed:
      digits_at := self + 1
    let $Some written = count (rest digits_at text) else:
      return $Nothing
    shift := U32.to_f32 written
    if below:
      shift := 0.0 - self
  let decimal = shift + U32.to_f32 dropped - U32.to_f32 decimals
  let magnitude = U32.to_f32 mantissa
  let value = magnitude
  if decimal >= 0.0:
    value := self * power (F32.to_u32 (min decimal 40.0))
  else:
    value := self / power (F32.to_u32 (min (0.0 - decimal) 50.0))
  if Bool.not (is_finite value):
    return $Nothing
  if negative:
    value := 0.0 - self
  return $Some value

// The shortest decimal within six places; large magnitudes use scientific
// notation. Nonfinite values use the same labels as ui.decimal.
const shown = func (value: F32) => return do:
  if Bool.not (is_finite value):
    return ui.decimal value 0
  let (size, _) = ui.decimal_magnitude (abs value)
  for places in 0 .. 7:
    let scale = power places
    if floor (size * scale + 0.5) / scale == size:
      return ui.decimal value places
  return ui.decimal value 6

// `value` with exactly min(places, 6) decimals, using the same bounded
// scientific/nonfinite formatting as ui.decimal.
const fixed = func (value: F32) => return func (places: U32) => return ui.formatted value places true
