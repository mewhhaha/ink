import { Vec3 } from "std/vector"
import * as math from "./math"

// Scalar ballistic kernels. Gravity is positive, rise is nonnegative, and all
// inputs/results must be finite. flight_time clips a destination above the apex
// to the apex; prepare rejects that unreachable destination instead.
const launch_speed = fn (gravity: F32) (rise: F32) => sqrt (2.0 * gravity * rise)
const flight_time = fn (gravity: F32) (from_y: F32) (to_y: F32) (rise: F32) =>
  (sqrt (2.0 * gravity * rise) + sqrt (2.0 * gravity * max 0.0 (from_y + rise - to_y))) / gravity
const rise_for_time = fn (gravity: F32) (from_y: F32) (to_y: F32) (seconds: F32) => do:
  let rising = (gravity * seconds - 2.0 * (from_y - to_y) / seconds) * 0.5
  return if rising > 0.0 then rising * rising / (2.0 * gravity) else 0.0
const height = fn (gravity: F32) (up: F32) (start: F32) (seconds: F32) =>
  start + up * seconds - 0.5 * gravity * seconds * seconds

type Ballistic is data = #Ballistic { from: Vec3, to: Vec3, gravity: F32, up: F32, duration: F32 }
const prepare = fn (gravity: F32) (from: Vec3) (to: Vec3) (rise: F32) => do:
  if Bool.not (is_finite gravity && gravity > 0.0 && is_finite rise && rise >= 0.0 && math.finite3 from && math.finite3 to):
    return #Nothing
  if Bool.not (is_finite (from.y + rise)) || to.y > from.y + rise:
    return #Nothing
  let up = launch_speed gravity rise
  let duration = flight_time gravity from.y to.y rise
  if Bool.not (is_finite up && is_finite duration) || duration <= 0.0:
    return #Nothing
  return #Some #Ballistic { from, to, gravity, up, duration }

// Unclamped time: callers choose whether to extrapolate, hold or remove a path.
const position_using = fn (from: Vec3) (to: Vec3) (gravity: F32) (up: F32) (duration: F32) (seconds: F32) => do:
  let fraction = seconds / duration
  return math.vec3 (lerp from.x to.x fraction) (from.y + up * seconds - 0.5 * gravity * seconds * seconds) (lerp from.z to.z fraction)
const position = fn (arc: Ballistic) (seconds: F32) => position_using arc.from arc.to arc.gravity arc.up arc.duration seconds
// An authored parabola above a straight chord, independent of physical gravity.
const arch = fn (from: Vec3) (to: Vec3) (rise: F32) (fraction: F32) =>
  from.lerp to fraction + math.up * (4.0 * rise * fraction * (1.0 - fraction))

// Visit consecutive chords in traversal order, stopping at the first result.
// The caller selects segment count, collision tolerance and initial-overlap
// behavior. This is a chord approximation, not an exact curved collision test.
const traverse = fn (sample: F32 -> Vec3) (start: F32) (finish: F32) (segments: U32) contact => do:
  if segments == 0:
    return @panic "trajectory traversal needs a segment"
  let before = sample start
  for index in 0 .. segments:
    let at = sample (start + (finish - start) * U32.to_f32 (index + 1) / U32.to_f32 segments)
    if let #Some result = contact before at:
      return #Some result
    before := at
  return #Nothing
