import * as array from "std/array"
import * as ecs from "../ecs"
import * as sort from "../sort"

// One named command owner. Applications define the command ADT and a static
// interpreter; structural edits occur only at an explicit flush boundary.
// Element payloads are fixed-layout rows; variable data uses caller-owned
// pools plus spans/borrowed views/links, never owning array fields.
type Commands command = ResizeArray command
type Edit component is data = $Put { entity: U32, value: component } | $Remove U32
func empty () : Commands c => return #[]
func push command -> (queue: Commands c) => return @storage.push queue command
func append (commands: Array c) -> (queue: Commands c) => return do:
  let count = commands.length
  for i in 0 .. count:
    @storage.push queue commands[i]
func values (queue: Commands c) => return &queue[0..queue.length]
func count (queue: Commands c) => return queue.length
func flush (queue: Commands c) -> interpret => return do:
  let count = queue.length
  for i in 0 .. count:
    interpret queue[i]
  // An interpreter must not append to the queue being flushed. Use a separately
  // named next queue when an operation schedules follow-up work.
  @storage.truncate queue 0
const flush_commands = flush
// Later edits win; final changed entity IDs commit in ascending order. No
// observers or game reads run between edits in this coalesced component batch.
func apply alive -> pool -> meta -> (edits: Array (Edit a)) => return do:
  let keys = array.map (func edit => return case edit of
    $Put {entity} => entity
    $Remove entity => entity) edits
  let order = sort.order_u32 keys
  let at = 0
  for unused in 0 .. order.length:
    if at >= order.length:
      break
    let latest = order[at]
    let id = keys[latest]
    at := self + 1
    for unused in at .. order.length:
      if keys[order[at]] != id:
        break
      latest := max latest order[at]
      at := self + 1
    if ecs.live alive id:
      case edits[latest] of
        $Put {value} => ecs.insert alive pool meta id value
        $Remove _ => ecs.remove pool meta id
