import * as array from "std/array"
import * as ecs from "../ecs"
import * as sort from "../sort"

// One named command owner. Applications define the command ADT and a static
// interpreter; structural edits occur only at an explicit flush boundary.
// Element payloads are fixed-layout rows; variable data uses caller-owned
// pools plus spans/borrowed views/links, never owning array fields.
type Commands command = #[command]
type Edit component is data = $Put { entity: U32, value: component } | $Remove U32
func empty () : Commands c => #[]
func push command -> (queue: own Commands c) : Commands c =>
  @storage.push queue command
  return queue
func append (commands: #[c]) -> (queue: own Commands c) : Commands c =>
  let count = commands.length
  for i in 0 .. count:
    @storage.push queue commands[i]
  return queue
func values (queue: Commands c) => &queue[0..queue.length]
func count (queue: Commands c) => queue.length
func flush (queue: own Commands c) -> interpret : Commands c =>
  let count = queue.length
  for i in 0 .. count:
    interpret queue[i]
  @storage.truncate queue 0
  return queue
func flush_on (queue: own Commands c) -> (own state) -> interpret =>
  let count = queue.length
  for i in 0 .. count:
    state := interpret (own self) queue[i]
  @storage.truncate queue 0
  return (queue, state)
const flush_commands = flush
// Later edits win; final changed entity IDs commit in ascending order. No
// observers or game reads run between edits in this coalesced component batch.
func apply alive -> (pool: own ecs.Pool a) -> (meta: own ecs.Metadata) -> (edits: #[Edit a]) : (ecs.Pool a, ecs.Metadata) =>
  let keys = array.map (func edit => case edit of
    $Put {entity} => entity
    $Remove entity => entity) edits
  let order = sort.order_u32 keys
  let at = 0
  for unused in 0 .. order.length:
    if at >= order.length:
      break
    let latest = order[at]
    let id = keys[latest]
    at := self + 1
    for unused in at .. order.length:
      if keys[order[at]] != id:
        break
      latest := max latest order[at]
      at := self + 1
    if ecs.live alive id:
      let present = ecs.contains pool id
      if let $Put {value} = edits[latest]:
        pool := ecs.put_row alive self id value
        meta := ecs.bump_insert present self
      else:
        pool := ecs.remove_row self id
        meta := ecs.bump_remove present self
  return (pool, meta)
