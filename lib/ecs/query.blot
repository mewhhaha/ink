import * as array from "std/array"
import * as ecs from "../ecs"

// Flat postfix filters avoid recursive runtime ADTs. Operands name component
// keys; All/Any consume the preceding count terms. Zero All is true, zero Any
// false. Sources capture explicit membership copies, not mutable column views.
type Term is data = $With U32 | $Without U32 | $Optional U32 | $All U32 | $Any U32
type Filter = Array Term
type Source is data = $Source { key: U32, epoch: U32, structure: U32, present: &[Bool] }
// Cache storage is three independently named caller owners: key words,
// selected entity IDs, and one metadata word (the build count). Reset all three
// explicitly on a lineage change. A prepared query is never an owning row.
// Caller owns membership separately. Do not refill it while a returned source
// view is live; use another named membership owner for another captured source.
func source (key: U32) -> (pool: ecs.Pool a) -> (meta: ecs.Metadata) -> (membership: ResizeArray Bool) => return do:
  @storage.truncate membership 0
  for id in 0 .. pool.length:
    @storage.push membership (ecs.contains pool id)
  return $Source {key, epoch: ecs.epoch meta, structure: ecs.membership_revision meta,
    present: &membership[0..membership.length]}
func locate (key: U32) -> (sources: Array Source) => return do:
  for i in 0 .. sources.length:
    if sources[i].key == key:
      return i
  return @panic "query references an unbound component key"
func has (source: Source) -> (id: U32) => return id < source.present.length and source.present[id]
func matches (filter: Filter) -> (sources: Array Source) -> (id: U32) => return do:
  let stack = array.fill filter.length false
  let count = 0
  for term in filter:
    case term of
      $With key => do:
        stack[count] = has sources[locate key sources] id
        count := self + 1
      $Without key => do:
        stack[count] = Bool.not (has sources[locate key sources] id)
        count := self + 1
      $Optional key => do:
        let unused = locate key sources
        stack[count] = true
        count := self + 1
      $All take => do:
        if take > count:
          return @panic "query filter stack underflow"
        let value = true
        for i in count - take .. count:
          value := self and stack[i]
        count := self - take
        stack[count] = value
        count := self + 1
      $Any take => do:
        if take > count:
          return @panic "query filter stack underflow"
        let value = false
        for i in count - take .. count:
          value := self or stack[i]
        count := self - take
        stack[count] = value
        count := self + 1
  if count != 1:
    return @panic "query filter must produce one result"
  return stack[0]
func same a -> b => return do:
  if a.length != b.length:
    return false
  for i in 0 .. a.length:
    if a.at i != b.at i:
      return false
  return true
func append_identity (filter: Filter) -> (words: ResizeArray U32) => return do:
  for term in filter:
    let (tag, value) = case term of
      $With key => (0, key)
      $Without key => (1, key)
      $Optional key => (2, key)
      $All count => (3, count)
      $Any count => (4, count)
    @storage.push words tag
    @storage.push words value
func prepare (alive: ecs.Entities) -> (entity_meta: ecs.Metadata) -> (filter: Filter) -> (sources: Array Source) -> (key: ResizeArray U32) -> (indices: ResizeArray U32) -> (meta: Array U32) => return do:
  for i in 0 .. sources.length:
    for j in 0 .. i:
      if sources[i].key == sources[j].key:
        return @panic "duplicate query component key"
  let words: ResizeArray U32 = #[]
  @storage.push words (ecs.epoch entity_meta)
  @storage.push words (ecs.membership_revision entity_meta)
  append_identity filter words
  // Optional terms deliberately do not constrain membership or its revisions.
  for term in filter:
    let selected = case term of
      $With key => $Some (locate key sources)
      $Without key => $Some (locate key sources)
      _ => $Nothing
    if let $Some index = selected:
      @storage.push words sources[index].key
      @storage.push words sources[index].epoch
      @storage.push words sources[index].structure
  if meta[0] != 0 and same words key:
    return ()
  let builds = ecs.bumped_revision meta[0]
  @storage.truncate indices 0
  for id in 0 .. alive.length:
    if ecs.live alive id and matches filter sources id:
      @storage.push indices id
  @storage.truncate key 0
  for word in words:
    @storage.push key word
  meta[0] = builds
const select = prepare
func each indices -> action => return do:
  for i in 0 .. indices.length:
    action (indices.at i)
