import * as array from "std/array"
import * as messages from "./messages"
import * as changes from "./changes"
import * as sort from "./sort"

type Change is data = $Added U32 | $Updated U32 | $Removed U32 | $Replaced
type Journal = messages.Messages Change
type Read is data = $Delta { changes: changes.Changes [#[U32], #[U32]], cursor: messages.Reader } | $Reset messages.Reader
func empty () : Journal => messages.empty ()
const metadata = messages.metadata
const cursor = messages.cursor
func record_many entries -> (journal: own Journal) -> (meta: own messages.Metadata) => messages.write_many entries journal meta
func record entry -> (journal: own Journal) -> (meta: own messages.Metadata) => messages.write entry journal meta
func restart epoch -> (journal: own Journal) -> (meta: own messages.Metadata) => messages.restart epoch journal meta
// Coalesce in log order: later writes/removals win. Replacements or gaps ask
// the consumer to rebuild from the current collection, never a partial delta.
func read_into (reader: messages.Reader) -> (journal: Journal) -> (meta: messages.Metadata) -> (scratch: own #[Change]) -> (updated: own #[U32]) -> (removed: own #[U32]) : Read => case messages.read reader journal meta scratch of
  $messages.Reset cursor => $Reset cursor
  $messages.Items { values, cursor } => do:
    for entry in values:
      if let $Replaced = entry:
        return $Reset cursor
    let keys = array.generate values.length (func i => case values[i] of
      $Added key => key
      $Updated key => key
      $Removed key => key
      $Replaced => 0)
    let order = sort.order_u32 keys
    @storage.truncate updated 0
    @storage.truncate removed 0
    let at = 0
    for unused in 0 .. order.length:
      if at >= order.length:
        break
      let latest = order[at]
      let key = keys[latest]
      at := self + 1
      for unused in at .. order.length:
        if keys[order[at]] != key:
          break
        latest := max latest order[at]
        at := self + 1
      if let $Removed _ = values[latest]:
        @storage.push removed key
      else:
        @storage.push updated key
    return $Delta { changes: $changes.Changes { reset: false, updated, removed }, cursor }
