import * as array from "std/array"

// Payload, dense-owner index, slot metadata and free stack are independently
// named owners. This keeps existing handle/save identity without owning a
// movable multi-tail Store or retaining immutable allocation branches.
type Handle kind is opaque = { kind: kind, region: U32, origin: U32, slot: U32, generation: U32 }
type Slot = { dense: U32, origin: U32, generation: U32, live: Bool }
// Element payloads are fixed-layout rows; variable data uses caller-owned
// pools plus spans/borrowed views/links, never owning array fields.
type Store [kind, value] is data = $Store {kind: kind, values: #[~value]}
type Metadata = #[U32]
// The producer knows the opaque handle's inline layout. Callers still own this
// independent pool by name and never gain access to the private representation.
func handle_pool (kind: kind) : #[~Handle kind] => #[]
// This is an access descriptor over the caller's separately named owner.
// The nominal kind remains attached to that actual payload pool at every call.
func store (kind: kind) -> (values: #[~value]) : Store [kind, value] => $Store {kind, values}
func metadata region -> origin -> capacity : Metadata => #[region, origin, capacity]
func index (handle: Handle kind) -> (store: Store [kind, value]) -> (slots: #[~Slot]) -> (meta: Metadata) : Maybe U32 =>
  if handle.region != meta[0] or handle.slot >= slots.length:
    return $Nothing
  let slot = slots[handle.slot]
  if not slot.live or slot.origin != handle.origin or slot.generation != handle.generation:
    return $Nothing
  return $Some slot.dense
func get (handle: Handle kind) -> (store: Store [kind, value]) -> (slots: #[~Slot]) -> (meta: Metadata) => case index handle store slots meta of
  $Some at => $Some store.values[at]
  $Nothing => $Nothing
func handle_at (dense: U32) -> (store: Store [kind, value]) -> owners -> slots -> meta =>
  if dense >= owners.length:
    return $Nothing
  let slot = owners[dense]
  let row = slots[slot]
  return $Some ($Handle {kind: store.kind, region: meta[0], origin: row.origin, slot, generation: row.generation})
func insert (kind: kind) -> (value: value) -> (store: Store [kind, value]) -> (owners: #[~U32]) -> (slots: #[~Slot]) -> (free: #[~U32]) -> meta =>
  let values: #[~value] = store.values
  let slot = slots.length
  let generation = 0
  if free.length > 0:
    slot := free[free.length - 1]
    generation := slots[slot].generation
  else:
    if slot >= meta[2]:
      return $Nothing
  let row = {dense: values.length, origin: meta[1], generation, live: true}
  if free.length > 0:
    @storage.truncate free (free.length - 1)
  if slot == slots.length:
    @storage.push slots row
  else:
    slots[slot] = row
  @storage.push owners slot
  @storage.push values value
  return $Some ($Handle {kind, region: meta[0], origin: meta[1], slot, generation})
func set (handle: Handle kind) -> (value: value) -> (store: Store [kind, value]) -> (slots: #[~Slot]) -> (meta: Metadata) =>
  let values: #[~value] = store.values
  if let $Some at = index handle store slots meta:
    values[at] = value
    return true
  return false
func remove (handle: Handle kind) -> (store: Store [kind, value]) -> (owners: #[~U32]) -> (slots: #[~Slot]) -> (free: #[~U32]) -> (meta: Metadata) : Bool =>
  let values: #[~value] = store.values
  let $Some at = index handle store slots meta else:
    return false
  let last = values.length - 1
  let owner = owners[last]
  slots[owner].dense = at
  values[at] = values[last]
  owners[at] = owner
  @storage.truncate values last
  @storage.truncate owners last
  slots[handle.slot].live = false
  if slots[handle.slot].generation < 0xFFFFFFFF:
    slots[handle.slot].generation = slots[handle.slot].generation + 1
    if slots[handle.slot].generation < 0xFFFFFFFF:
      @storage.push free handle.slot
  return true
func values (store: Store [kind, value]) => &store.values[0..store.values.length]
func count (store: Store [kind, value]) => store.values.length
// The existing version-1 wire format and all region/origin/generation fields
// below remain unchanged; only live storage ownership and API parameters change.
func encode_handle (handle: Handle kind) => #[handle.region, handle.origin, handle.slot, handle.generation]
func decode_handle kind => func (words: #[U32]) =>
  if words.length != 4:
    return $Nothing
  return $Some ($Handle { kind, region: words[0], origin: words[1], slot: words[2], generation: words[3] })

// Version 1: header, slot metadata, dense owners, free stack, framed values.
// Serializing slots and the free stack preserves future allocation order.
func append_words (words: #[U32]) -> (destination: #[~U32]) =>
  for word in words:
    @storage.push destination word
  return ()
func encode encode_value -> (store: Store [kind, value]) -> (owners: #[~U32]) -> (slots: #[~Slot]) -> (free: #[~U32]) -> (meta: Metadata) =>
  let values: #[~value] = store.values
  let out: #[~U32] = #[]
  append_words #[1, meta[0], meta[1], meta[2], slots.length, values.length, free.length] out
  for slot in slots:
    append_words #[slot.dense, slot.origin, slot.generation, if slot.live then 1 else 0] out
  for owner in owners:
    @storage.push out owner
  for available in free:
    @storage.push out available
  // Encode once per payload without constructing an array of owning arrays.
  for value in values:
    let words = encode_value value
    @storage.push out words.length
    append_words words out
  return seal out

func decode (kind: kind) => func (decode_value: #[U32] -> Maybe value) => func (words: #[U32]) -> (destination: Store [kind, value]) -> (destination_owners: #[~U32]) -> (destination_slots: #[~Slot]) -> (destination_free: #[~U32]) -> (meta: Metadata) =>
  let destination_values: #[~value] = destination.values
  if words.length < 7 or words[0] != 1:
    return false
  let count = words[4]
  let live = words[5]
  let free = words[6]
  if count > words[3] or count > (words.length - 7) / 4 or live > count or free > count - live:
    return false
  let cursor = 7 + count * 4
  if live > words.length - cursor:
    return false
  let owners = array.slice cursor live words
  cursor := self + live
  if free > words.length - cursor:
    return false
  let available = array.slice cursor free words
  cursor := self + free
  let slots = array.generate count (func i => { dense: words[7 + i * 4], origin: words[8 + i * 4], generation: words[9 + i * 4], live: words[10 + i * 4] == 1 })
  let seen = array.fill count false
  for i in 0 .. live:
    let slot = owners[i]
    if slot >= count:
      return false
    if seen[slot] or not slots[slot].live or slots[slot].dense != i:
      return false
    seen[slot] := true
  for slot in available:
    if slot >= count:
      return false
    if seen[slot] or slots[slot].live or slots[slot].generation == 4294967295:
      return false
    seen[slot] := true
  for i in 0 .. count:
    if words[10 + i * 4] > 1:
      return false
    if not seen[i] and (slots[i].live or slots[i].generation != 4294967295):
      return false
  let values: #[~value] = #[]
  for i in 0 .. live:
    if cursor >= words.length:
      return false
    let width = words[cursor]
    cursor := self + 1
    if width > words.length - cursor:
      return false
    let $Some value = decode_value (array.slice cursor width words) else:
      return false
    @storage.push values value
    cursor := self + width
  if cursor != words.length:
    return false
  // Publish only after validating the complete existing version-1 image.
  @storage.truncate destination_values 0
  @storage.truncate destination_owners 0
  @storage.truncate destination_slots 0
  @storage.truncate destination_free 0
  for value in values:
    @storage.push destination_values value
  for value in owners:
    @storage.push destination_owners value
  for value in slots:
    @storage.push destination_slots value
  for value in available:
    @storage.push destination_free value
  for i in 0 .. 3:
    meta[i] = words[i + 1]
  return true
