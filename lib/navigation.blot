import * as hash from "./hash"
// Four-neighbour grids. Zero costs are walls; moving into a cell pays its cost.
// Grid coordinates are row-major, with caller-chosen world placement.
type Grid is data = $Grid { width: U32, height: U32, costs: &[F32], minimum: F32, units: Bool }
type Path is data = $Path { cells: &[U32], cost: F32, expanded: U32 }
type Field is data = $Field { goal: U32, costs: &[F32], next: &[U32], expanded: U32 }
const unreachable = 3e38

func grid (width: U32) => func (height: U32) => func (costs: &[F32]) : Maybe Grid =>
  if width == 0 or height == 0 or height > 4294967295 / width or costs.length != width * height:
    return $Nothing
  // Costs must lie in [0, unreachable), which also refuses NaN and
  // infinities. Returning #Nothing from inside the loop would slow every
  // iteration, so it breaks.
  let units = costs.length < 16777216
  let minimum = unreachable
  let valid = true
  for cost in costs:
    if cost != 0.0 and cost != 1.0:
      units := false
    if cost >= 0.0 and cost < unreachable:
      if cost > 0.0:
        minimum := min self cost
    else:
      valid := false
      break
  if not valid:
    return $Nothing
  return $Some ($Grid { width, height, costs, minimum, units })

// An indexed binary heap bounds storage to one entry per cell. Each heap slot
// keeps its cell's score beside it (`ranks`), so sifting reads neighbouring
// words; equal scores prefer progress from the start, then caller cell order.
// A cell's slot is n while unqueued and n + 1 once expanded. Compound
// comparisons see only scalar locals.
func with_search (g: Grid) -> (start: U32) -> (goal: U32) -> (reverse: Bool) -> (limit: U32) -> consume =>
  let n = g.costs.length
  let closed = n + 1
  let width = g.width
  let weights = g.costs
  let goal_x = U32.to_f32 (goal % width)
  let goal_y = U32.to_f32 (goal / width)
  let costs = @array.fill n unreachable
  let next = @array.fill n n
  let heap = @array.fill n 0
  let ranks = @array.fill n unreachable
  let slots = @array.fill n n
  let count = 0
  let expanded = 0
  if start < n and goal < n and weights[start] > 0.0 and weights[goal] > 0.0:
    costs[start] := 0.0
    heap[0] := start
    ranks[0] := 0.0
    slots[start] := 0
    count := 1
  for 0..(min n limit):
    if count == 0:
      break
    let cell = heap[0]
    count := self - 1
    slots[cell] := closed
    expanded := self + 1
    if count > 0:
      let moved = heap[count]
      let moved_key = ranks[count]
      let moved_distance = costs[moved]
      let k = 0
      for 0..32:
        let left = k * 2 + 1
        if left >= count:
          break
        let child = left
        let other_key = ranks[left]
        if left + 1 < count:
          let right_key = ranks[left + 1]
          let right_first = right_key < other_key
          if right_key == other_key:
            let a = heap[left]
            let b = heap[left + 1]
            if reverse:
              right_first := b < a
            else:
              let cost_a = costs[a]
              let cost_b = costs[b]
              right_first := cost_b > cost_a or (cost_b == cost_a and b < a)
          if right_first:
            child := left + 1
            other_key := right_key
        let other = heap[child]
        let stays = moved_key < other_key
        if moved_key == other_key:
          if reverse:
            stays := moved < other
          else:
            let other_distance = costs[other]
            stays := moved_distance > other_distance or (moved_distance == other_distance and moved < other)
        if stays:
          break
        heap[k] := other
        ranks[k] := other_key
        slots[other] := k
        k := child
      heap[k] := moved
      ranks[k] := moved_key
      slots[moved] := k
    if not reverse and cell == goal:
      count := 0
    let x = cell % width
    let y = cell / width
    for direction in 0..4:
      let valid = false
      let neighbour = cell
      let nx = x
      let ny = y
      if direction == 0 and x > 0:
        valid := true
        neighbour := cell - 1
        nx := x - 1
      if direction == 1 and x + 1 < width:
        valid := true
        neighbour := cell + 1
        nx := x + 1
      if direction == 2 and y > 0:
        valid := true
        neighbour := cell - width
        ny := y - 1
      if direction == 3 and y + 1 < g.height:
        valid := true
        neighbour := cell + width
        ny := y + 1
      let slot = slots[neighbour]
      let entering = weights[neighbour]
      if valid and (reverse or cell != goal) and slot != closed and entering > 0.0:
        let edge = entering
        if reverse:
          edge := weights[cell]
        let cost = costs[cell] + edge
        if cost < costs[neighbour] and cost < unreachable:
          costs[neighbour] := cost
          next[neighbour] := cell
          let heuristic = 0.0
          if not reverse:
            let dx = abs (U32.to_f32 nx - goal_x)
            let dy = abs (U32.to_f32 ny - goal_y)
            heuristic := (dx + dy) * g.minimum
          let neighbour_key = cost + heuristic
          let k = slot
          if k == n:
            k := count
            count := self + 1
          for 0..32:
            if k == 0:
              break
            let parent = (k - 1) / 2
            let other_key = ranks[parent]
            let other = heap[parent]
            let first = other_key < neighbour_key
            if other_key == neighbour_key:
              if reverse:
                first := other < neighbour
              else:
                let other_distance = costs[other]
                first := other_distance > cost or (other_distance == cost and other < neighbour)
            if first:
              break
            heap[k] := other
            ranks[k] := other_key
            slots[other] := k
            k := parent
          heap[k] := neighbour
          ranks[k] := neighbour_key
          slots[neighbour] := k
  return consume ($Field {goal, costs: &costs[0..costs.length], next: &next[0..next.length], expanded}) (&slots[0..slots.length])

// Small expansion budgets use an indexed frontier bounded by discovered cells,
// independent of total grid area. Numeric buffers stay private to this call.
func search_sparse_into (out: #[~U32]) -> (g: Grid) -> (start: U32) -> (goal: U32) -> (limit: U32) : Maybe Path =>
  if limit == 0 or start >= g.costs.length or goal >= g.costs.length:
    return $Nothing
  if g.costs[start] == 0.0 or g.costs[goal] == 0.0:
    return $Nothing
  let reverse = false
  let n = min g.costs.length (1 + limit * 4)
  let closed = n + 1
  let width = g.width
  let weights = g.costs
  let goal_x = U32.to_f32 (goal % width)
  let goal_y = U32.to_f32 (goal / width)
  let costs = @array.fill n unreachable
  let next = @array.fill n n
  let heap = @array.fill n 0
  let ranks = @array.fill n unreachable
  let slots = @array.fill n n
  let ids = @array.fill n 0
  let capacity = 1
  for 0 .. 31:
    if capacity >= n * 2:
      break
    capacity := self * 2
  let mask = capacity - 1
  let table = @array.fill capacity n
  table[hash.u32 start & mask] := 0
  ids[0] := start
  let count = 0
  let expanded = 0
  let seen = 1
  let solved = n
  costs[0] := 0.0
  heap[0] := 0
  ranks[0] := 0.0
  slots[0] := 0
  count := 1
  for 0..(min n limit):
    if count == 0:
      break
    let node = heap[0]
    let cell = ids[node]
    count := self - 1
    slots[node] := closed
    expanded := self + 1
    if count > 0:
      let moved = heap[count]
      let moved_key = ranks[count]
      let moved_distance = costs[moved]
      let k = 0
      for 0..32:
        let left = k * 2 + 1
        if left >= count:
          break
        let child = left
        let other_key = ranks[left]
        if left + 1 < count:
          let right_key = ranks[left + 1]
          let right_first = right_key < other_key
          if right_key == other_key:
            let a = heap[left]
            let b = heap[left + 1]
            if reverse:
              right_first := ids[b] < ids[a]
            else:
              let cost_a = costs[a]
              let cost_b = costs[b]
              right_first := cost_b > cost_a or (cost_b == cost_a and ids[b] < ids[a])
          if right_first:
            child := left + 1
            other_key := right_key
        let other = heap[child]
        let stays = moved_key < other_key
        if moved_key == other_key:
          if reverse:
            stays := ids[moved] < ids[other]
          else:
            let other_distance = costs[other]
            stays := moved_distance > other_distance or (moved_distance == other_distance and ids[moved] < ids[other])
        if stays:
          break
        heap[k] := other
        ranks[k] := other_key
        slots[other] := k
        k := child
      heap[k] := moved
      ranks[k] := moved_key
      slots[moved] := k
    if not reverse and cell == goal:
      count := 0
      solved := node
    let x = cell % width
    let y = cell / width
    for direction in 0..4:
      let valid = false
      let neighbour = cell
      let nx = x
      let ny = y
      if direction == 0 and x > 0:
        valid := true
        neighbour := cell - 1
        nx := x - 1
      if direction == 1 and x + 1 < width:
        valid := true
        neighbour := cell + 1
        nx := x + 1
      if direction == 2 and y > 0:
        valid := true
        neighbour := cell - width
        ny := y - 1
      if direction == 3 and y + 1 < g.height:
        valid := true
        neighbour := cell + width
        ny := y + 1
      let entering = weights[neighbour]
      if valid and cell != goal and entering > 0.0:
        let key = neighbour
        let bucket = hash.u32 key & mask
        for 0 .. table.length:
          let found = table[bucket]
          if found == n or ids[found] == key:
            break
          bucket := (self + 1) & mask
        let dense = table[bucket]
        if dense == n:
          dense := seen
          seen := self + 1
          table[bucket] := dense
          ids[dense] := key
        neighbour := dense
        let slot = slots[neighbour]
        if slot == closed:
          continue
        let edge = entering
        if reverse:
          edge := weights[cell]
        let cost = costs[node] + edge
        if cost < costs[neighbour] and cost < unreachable:
          costs[neighbour] := cost
          next[neighbour] := node
          let heuristic = 0.0
          if not reverse:
            let dx = abs (U32.to_f32 nx - goal_x)
            let dy = abs (U32.to_f32 ny - goal_y)
            heuristic := (dx + dy) * g.minimum
          let neighbour_key = cost + heuristic
          let k = slot
          if k == n:
            k := count
            count := self + 1
          for 0..32:
            if k == 0:
              break
            let parent = (k - 1) / 2
            let other_key = ranks[parent]
            let other = heap[parent]
            let first = other_key < neighbour_key
            if other_key == neighbour_key:
              if reverse:
                first := ids[other] < ids[neighbour]
              else:
                let other_distance = costs[other]
                first := other_distance > cost or (other_distance == cost and ids[other] < ids[neighbour])
            if first:
              break
            heap[k] := other
            ranks[k] := other_key
            slots[other] := k
            k := parent
          heap[k] := neighbour
          ranks[k] := neighbour_key
          slots[neighbour] := k
  if solved == n:
    return $Nothing
  let node = solved
  let length = 1
  for 0 .. n:
    if node == 0:
      break
    node := next[node]
    length := self + 1
  let cells = @array.fill length 0
  node := solved
  for i in 0 .. length:
    cells[length - i - 1] := ids[node]
    if node != 0:
      node := next[node]
  @storage.truncate out 0
  for cell in cells:
    @storage.push out cell
  return $Some ($Path {cells: &out[0..out.length], cost: costs[solved], expanded})

// Nothing also means that the caller's expansion budget was exhausted.
func astar_into (out: #[~U32]) -> (g: Grid) -> (start: U32) -> (goal: U32) -> (limit: U32) : Maybe Path =>
  if limit < g.costs.length / 8 and limit <= 0x0FFFFFFF:
    return search_sparse_into out g start goal limit
  return with_search g start goal false limit (func (field: Field) -> (slots: &[U32]) =>
    let n = g.costs.length
    if goal >= n:
      return $Nothing
    if slots[goal] != n + 1:
      return $Nothing
    let cell = goal
    let length = 1
    for 0..n:
      if cell == start:
        break
      cell := field.next[cell]
      length := self + 1
    let cells = @array.fill length 0
    cell := goal
    for i in 0..length:
      cells[length - i - 1] := cell
      if cell != start:
        cell := field.next[cell]
    @storage.truncate out 0
    for cell in cells:
      @storage.push out cell
    return $Some ($Path {cells: &out[0..out.length], cost: field.costs[goal], expanded: field.expanded}))

// Reverse Dijkstra computes the exact weighted cost to the goal. next follows
// the least-cost route, which need not follow the raw cost gradient when the
// traversal cost varies. Unreachable cells have next == cell count.
// Unit costs need only a FIFO. Equal-distance routes still select the lowest
// predecessor index, matching the weighted heap independently of queue order.
func with_flow_units (g: Grid) -> (goal: U32) -> consume =>
  let n = g.costs.length
  let width = g.width
  let weights = g.costs
  let costs = @array.fill n unreachable
  let next = @array.fill n n
  let queue = @array.fill n 0
  let tail = 0
  if goal < n:
    if weights[goal] > 0.0:
      costs[goal] := 0.0
      queue[0] := goal
      tail := 1
  let expanded = 0
  for head in 0 .. n:
    if head >= tail:
      break
    let cell = queue[head]
    expanded := self + 1
    let distance = costs[cell] + 1.0
    let x = cell % width
    for direction in 0 .. 4:
      let valid = false
      let neighbour = cell
      if direction == 0 and x > 0:
        valid := true
        neighbour := cell - 1
      if direction == 1 and x + 1 < width:
        valid := true
        neighbour := cell + 1
      if direction == 2 and cell >= width:
        valid := true
        neighbour := cell - width
      if direction == 3 and cell + width < n:
        valid := true
        neighbour := cell + width
      if valid and weights[neighbour] > 0.0:
        let old = costs[neighbour]
        if old == unreachable:
          costs[neighbour] := distance
          queue[tail] := neighbour
          tail := self + 1
        let previous = next[neighbour]
        if old == unreachable or (old == distance and cell < previous):
          next[neighbour] := cell
  return consume ($Field {goal, costs: &costs[0..costs.length], next: &next[0..next.length], expanded})

func copy_field (out_costs: #[~F32]) -> (out_next: #[~U32]) -> (field: Field) =>
  @storage.truncate out_costs 0
  @storage.truncate out_next 0
  for cost in field.costs:
    @storage.push out_costs cost
  for next in field.next:
    @storage.push out_next next
  return $Field {goal: field.goal, costs: &out_costs[0..out_costs.length], next: &out_next[0..out_next.length], expanded: field.expanded}
func flow_into (out_costs: #[~F32]) -> (out_next: #[~U32]) -> (g: Grid) -> (goal: U32) =>
  if g.units:
    return with_flow_units g goal (func (field: Field) => copy_field out_costs out_next field)
  return with_search g goal goal true g.costs.length (func (field: Field) -> slots => copy_field out_costs out_next field)
