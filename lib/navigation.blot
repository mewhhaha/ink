//! Four-neighbour grids. Zero costs are walls; moving into a cell pays its cost.
//! Grid coordinates are row-major, with caller-chosen world placement.
//!
//! Key items: [`Grid`], [`Path`], [`Field`], [`grid`], [`run_search`].
//!
//! ```blot
//! let costs = #[1.0, 1.0, 1.0, 1.0]
//! let $Some g = grid 2 2 (&costs[0..costs.length]) else:
//!   return 0
//! let $Some p = astar g 0 3 64 else:
//!   return 0
//! p.cells.length // => 3
//! ```

import * as hash from "./hash"
import * as simd from "std/simd"

type Grid is data = $Grid { width: U32, height: U32, costs: &[F32], minimum: F32, units: Bool }
type Path is data = $Path { cells: #[U32], cost: F32, expanded: U32 }
type Field is data = $Field { goal: U32, costs: #[F32], next: #[U32], expanded: U32 }
const unreachable = 3e38

func grid (width: U32) => func (height: U32) => func (costs: &[F32]) : Maybe Grid =>
  if width == 0 or height == 0 or height > 4294967295 / width or costs.length != width * height:
    return $Nothing
  // Costs must lie in [0, unreachable), which also refuses NaN and
  // infinities. Returning #Nothing from inside the loop would slow every
  // iteration, so it breaks.
  let units = costs.length < 16777216
  let minimum = unreachable
  let valid = true
  for cost in costs:
    if cost != 0.0 and cost != 1.0:
      units := false
    if cost >= 0.0 and cost < unreachable:
      if cost > 0.0:
        minimum := min self cost
    else:
      valid := false
      break
  if not valid:
    return $Nothing
  return $Some ($Grid { width, height, costs, minimum, units })

// An indexed binary heap bounds storage to one entry per cell. Each heap slot
// keeps its cell's score beside it (`ranks`), so sifting reads neighbouring
// words; equal scores prefer progress from the start, then caller cell order.
// A cell's slot is n while unqueued and n + 1 once expanded. Compound
// comparisons see only scalar locals.
private func run_search_binary (g: Grid) -> (start: U32) -> (goal: U32) -> (reverse: Bool) -> (limit: U32) : (Field, #[U32]) =>
  let n = g.costs.length
  let closed = n + 1
  let width = g.width
  let mask = width - 1
  let power_of_two = (width & mask) == 0
  let minimum = g.minimum
  let weights = g.costs
  let goal_x = U32.to_f32 (goal % width)
  let goal_y = U32.to_f32 (goal / width)
  let costs = @array.fill n unreachable
  let next = @array.fill n n
  let heap = @array.fill n 0
  let ranks = @array.fill n unreachable
  let slots = @array.fill n n
  let count = 0
  let expanded = 0
  if start < n and goal < n and weights[start] > 0.0 and weights[goal] > 0.0:
    costs[start] := 0.0
    heap[0] := start
    ranks[0] := 0.0
    slots[start] := 0
    count := 1
  for 0..(min n limit):
    if count == 0:
      break
    let cell = heap[0]
    count := self - 1
    slots[cell] := closed
    expanded := self + 1
    if count > 0:
      let moved = heap[count]
      let moved_key = ranks[count]
      let moved_distance = costs[moved]
      let k = 0
      for 0..32:
        let left = k * 2 + 1
        if left >= count:
          break
        let child = left
        let other_key = ranks[left]
        if left + 1 < count:
          let right_key = ranks[left + 1]
          let right_first = right_key < other_key
          if right_key == other_key:
            let a = heap[left]
            let b = heap[left + 1]
            if reverse:
              right_first := b < a
            else:
              let cost_a = costs[a]
              let cost_b = costs[b]
              right_first := cost_b > cost_a or (cost_b == cost_a and b < a)
          if right_first:
            child := left + 1
            other_key := right_key
        let other = heap[child]
        let stays = moved_key < other_key
        if moved_key == other_key:
          if reverse:
            stays := moved < other
          else:
            let other_distance = costs[other]
            stays := moved_distance > other_distance or (moved_distance == other_distance and moved < other)
        if stays:
          break
        heap[k] := other
        ranks[k] := other_key
        slots[other] := k
        k := child
      heap[k] := moved
      ranks[k] := moved_key
      slots[moved] := k
    if not reverse and cell == goal:
      break
    let x = if power_of_two then cell & mask else cell % width
    let y = if reverse then 0 else cell / width
    let base_cost = costs[cell]
    let rev_weight = if reverse then weights[cell] else 0.0
    let left = x > 0
    let right = x + 1 < width
    let up = cell >= width
    let down = cell < n - width
    for direction in 0 .. 4:
      let valid = if direction == 0 then left else if direction == 1 then right else if direction == 2 then up else down
      if not valid:
        continue
      let neighbour = if direction == 0 then cell - 1 else if direction == 1 then cell + 1 else if direction == 2 then cell - width else cell + width
      let slot = slots[neighbour]
      if slot == closed:
        continue
      let entering = weights[neighbour]
      if entering <= 0.0:
        continue
      let edge = if reverse then rev_weight else entering
      let cost = base_cost + edge
      if cost < costs[neighbour] and cost < unreachable:
        costs[neighbour] := cost
        next[neighbour] := cell
        let neighbour_key = cost
        if not reverse:
          let nx = if direction == 0 then x - 1 else if direction == 1 then x + 1 else x
          let ny = if direction == 2 then y - 1 else if direction == 3 then y + 1 else y
          let dx = abs (U32.to_f32 nx - goal_x)
          let dy = abs (U32.to_f32 ny - goal_y)
          neighbour_key := cost + (dx + dy) * minimum
        let k = slot
        if k == n:
          k := count
          count := self + 1
        for 0..32:
          if k == 0:
            break
          let parent = (k - 1) / 2
          let other_key = ranks[parent]
          let other = heap[parent]
          let first = other_key < neighbour_key
          if other_key == neighbour_key:
            if reverse:
              first := other < neighbour
            else:
              let other_distance = costs[other]
              first := other_distance > cost or (other_distance == cost and other < neighbour)
          if first:
            break
          heap[k] := other
          ranks[k] := other_key
          slots[other] := k
          k := parent
        heap[k] := neighbour
        ranks[k] := neighbour_key
        slots[neighbour] := k
  return ($Field {goal, costs, next, expanded}, slots)

// Full reverse searches finish with every live slot closed. Bounded searches
// retain the binary frontier's observable slot numbering.
func run_search (g: Grid) -> (start: U32) -> (goal: U32) -> (reverse: Bool) -> (limit: U32) : (Field, #[U32]) =>
  let n = g.costs.length
  if reverse and limit >= n and start < n and goal < n and g.width > 0 and g.height == n / g.width and n % g.width == 0 and g.costs[start] > 0.0 and g.costs[goal] > 0.0:
    if g.units and n < 16777216:
      if open_units g:
        let $Field { costs, next } = flow_open g start
        return ($Field {goal, costs, next, expanded: n}, @array.fill n (n + 1))
      if unit_weights g.costs:
        let $Field { costs, next, expanded } = flow_units_walled g start
        let slots = spark #[if costs[i] < unreachable then n + 1 else n | i <- 0 .. n]
        return ($Field {goal, costs, next, expanded}, slots)
    return reverse_heap g start goal
  return run_search_binary g start goal reverse limit

// Small expansion budgets use an indexed frontier bounded by discovered cells,
// independent of total grid area. Numeric buffers stay private to this call.
func search_sparse (g: Grid) -> (start: U32) -> (goal: U32) -> (limit: U32) : Maybe Path =>
  if limit == 0 or start >= g.costs.length or goal >= g.costs.length:
    return $Nothing
  if g.costs[start] == 0.0 or g.costs[goal] == 0.0:
    return $Nothing
  let reverse = false
  let cap_limit = if limit >= 1073741823 then g.costs.length else 1 + limit * 4
  let n = min g.costs.length cap_limit
  let closed = n + 1
  let width = g.width
  let weights = g.costs
  let goal_x = U32.to_f32 (goal % width)
  let goal_y = U32.to_f32 (goal / width)
  let costs = @array.fill n unreachable
  let next = @array.fill n n
  let heap = @array.fill n 0
  let ranks = @array.fill n unreachable
  let slots = @array.fill n n
  let ids = @array.fill n 0
  let capacity = 1
  let target_cap = if n >= 1073741824 then 2147483648 else n * 2
  for 0 .. 31:
    if capacity >= target_cap:
      break
    capacity := self * 2
  let mask = capacity - 1
  let table = @array.fill capacity n
  table[hash.u32 start & mask] := 0
  ids[0] := start
  let count = 0
  let expanded = 0
  let seen = 1
  let solved = n
  costs[0] := 0.0
  heap[0] := 0
  ranks[0] := 0.0
  slots[0] := 0
  count := 1
  for 0..(min n limit):
    if count == 0:
      break
    let node = heap[0]
    let cell = ids[node]
    count := self - 1
    slots[node] := closed
    expanded := self + 1
    if count > 0:
      let moved = heap[count]
      let moved_key = ranks[count]
      let moved_distance = costs[moved]
      let k = 0
      for 0..32:
        let left = k * 2 + 1
        if left >= count:
          break
        let child = left
        let other_key = ranks[left]
        if left + 1 < count:
          let right_key = ranks[left + 1]
          let right_first = right_key < other_key
          if right_key == other_key:
            let a = heap[left]
            let b = heap[left + 1]
            if reverse:
              right_first := ids[b] < ids[a]
            else:
              let cost_a = costs[a]
              let cost_b = costs[b]
              right_first := cost_b > cost_a or (cost_b == cost_a and ids[b] < ids[a])
          if right_first:
            child := left + 1
            other_key := right_key
        let other = heap[child]
        let stays = moved_key < other_key
        if moved_key == other_key:
          if reverse:
            stays := ids[moved] < ids[other]
          else:
            let other_distance = costs[other]
            stays := moved_distance > other_distance or (moved_distance == other_distance and ids[moved] < ids[other])
        if stays:
          break
        heap[k] := other
        ranks[k] := other_key
        slots[other] := k
        k := child
      heap[k] := moved
      ranks[k] := moved_key
      slots[moved] := k
    if not reverse and cell == goal:
      solved := node
      break
    let x = cell % width
    let y = cell / width
    for direction in 0..4:
      let valid = false
      let neighbour = cell
      let nx = x
      let ny = y
      if direction == 0 and x > 0:
        valid := true
        neighbour := cell - 1
        nx := x - 1
      if direction == 1 and x + 1 < width:
        valid := true
        neighbour := cell + 1
        nx := x + 1
      if direction == 2 and y > 0:
        valid := true
        neighbour := cell - width
        ny := y - 1
      if direction == 3 and y + 1 < g.height:
        valid := true
        neighbour := cell + width
        ny := y + 1
      let entering = weights[neighbour]
      if valid and cell != goal and entering > 0.0:
        let key = neighbour
        let bucket = hash.u32 key & mask
        for 0 .. table.length:
          let found = table[bucket]
          if found == n or ids[found] == key:
            break
          bucket := (self + 1) & mask
        let dense = table[bucket]
        if dense == n:
          dense := seen
          seen := self + 1
          table[bucket] := dense
          ids[dense] := key
        neighbour := dense
        let slot = slots[neighbour]
        if slot == closed:
          continue
        let edge = entering
        if reverse:
          edge := weights[cell]
        let cost = costs[node] + edge
        if cost < costs[neighbour] and cost < unreachable:
          costs[neighbour] := cost
          next[neighbour] := node
          let heuristic = 0.0
          if not reverse:
            let dx = abs (U32.to_f32 nx - goal_x)
            let dy = abs (U32.to_f32 ny - goal_y)
            heuristic := (dx + dy) * g.minimum
          let neighbour_key = cost + heuristic
          let k = slot
          if k == n:
            k := count
            count := self + 1
          for 0..32:
            if k == 0:
              break
            let parent = (k - 1) / 2
            let other_key = ranks[parent]
            let other = heap[parent]
            let first = other_key < neighbour_key
            if other_key == neighbour_key:
              if reverse:
                first := ids[other] < ids[neighbour]
              else:
                let other_distance = costs[other]
                first := other_distance > cost or (other_distance == cost and ids[other] < ids[neighbour])
            if first:
              break
            heap[k] := other
            ranks[k] := other_key
            slots[other] := k
            k := parent
          heap[k] := neighbour
          ranks[k] := neighbour_key
          slots[neighbour] := k
  if solved == n:
    return $Nothing
  let node = solved
  let length = 1
  for 0 .. n:
    if node == 0:
      break
    node := next[node]
    length := self + 1
  let cells = @array.fill length 0
  node := solved
  for i in 0 .. length:
    cells[length - i - 1] := ids[node]
    if node != 0:
      node := next[node]
  return $Some ($Path {cells, cost: costs[solved], expanded})

// Grid's public constructor and borrowed cost representation stay intact.
private func unit_weights (costs: &[F32]) : Bool =>
  let valid = true
  for cost in costs:
    if cost != 0.0 and cost != 1.0:
      valid := false
      break
  return valid

private func open_units (g: Grid) : Bool =>
  if not g.units:
    return false
  let costs = g.costs
  let groups = costs.length / 4
  let one = simd.u32_splat 0x3F800000
  let open = true
  for i in 0 .. groups:
    let (a, b, c, d) = simd.u32_eq (simd.f32_bits (simd.load (i * 4) costs)) one
    if (a & b & c & d) == 0:
      open := false
      break
  if not open:
    return false
  for i in groups * 4 .. costs.length:
    if costs[i] != 1.0:
      return false
  return true

private func toward_index (cell: U32) -> (x: U32) -> (y: U32) -> (gx: U32) -> (gy: U32) -> (width: U32) -> (n: U32) : U32 =>
  let horizontal = if x < gx then cell + 1 else if x > gx then cell - 1 else n
  let vertical = if y < gy then cell + width else if y > gy then cell - width else n
  return min horizontal vertical

private func abs_delta (a: U32) -> (b: U32) : U32 =>
  return if a < b then b - a else a - b

// A solid row or column between the endpoints separates four-connected paths.
// Bound the extra interior reads when many almost-solid stripes have gaps.
private func separates (costs: &[F32]) -> (low: U32) -> (high: U32) -> (line_stride: U32) -> (cell_stride: U32) -> (length: U32) : Bool =>
  let left = length * 2
  for line in low + 1 .. high:
    if left == 0:
      break
    let first = line * line_stride
    let last = first + (length - 1) * cell_stride
    if costs[first] != 0.0 or costs[last] != 0.0:
      continue
    let wall = true
    for i in 1 .. length - 1:
      if left == 0:
        return false
      left := self - 1
      if costs[first + i * cell_stride] != 0.0:
        wall := false
        break
    if wall:
      return true
  return false

// Nothing also means that the caller's expansion budget was exhausted.
func astar (g: Grid) -> (start: U32) -> (goal: U32) -> (limit: U32) : Maybe Path =>
  let n = g.costs.length
  let width = g.width
  if start >= n or goal >= n or width == 0 or g.costs[start] <= 0.0 or g.costs[goal] <= 0.0:
    return $Nothing
  let sx = start % width
  let sy = start / width
  let gx = goal % width
  let gy = goal / width
  let dx = abs_delta sx gx
  let dy = abs_delta sy gy
  if limit <= dx or limit - dx <= dy:
    return $Nothing
  let distance = dx + dy
  // Short unit searches can use the existing sparse path without a grid scan.
  if g.units and distance > 1 and limit >= n / 8 and open_units g:
    let cells = @array.fill (distance + 1) start
    let cell = start
    let x = sx
    let y = sy
    for i in 1 .. distance + 1:
      let next = toward_index cell x y gx gy width n
      if x > 0 and next == cell - 1:
        x := self - 1
      else:
        if x + 1 < width and next == cell + 1:
          x := self + 1
        else:
          y := if y < gy then self + 1 else self - 1
      cell := next
      cells[i] := cell
    return $Some ($Path {cells, cost: U32.to_f32 distance, expanded: distance + 1})
  if g.units and n >= 4096 and distance >= 16 and limit >= n / 8 and g.height == n / width and n % width == 0:
    let columns_blocked = separates g.costs (min sx gx) (max sx gx) 1 width g.height
    if columns_blocked or separates g.costs (min sy gy) (max sy gy) width 1 width:
      return $Nothing
  if limit < g.costs.length / 8 and limit <= 0x0FFFFFFF:
    return search_sparse g start goal limit
  let (field, slots) = run_search g start goal false limit
  if goal >= n:
    return $Nothing
  if slots[goal] != n + 1:
    return $Nothing
  let cell = goal
  let length = 1
  for 0..n:
    if cell == start:
      break
    cell := field.next[cell]
    length := self + 1
  let cells = @array.fill length 0
  cell := goal
  for i in 0..length:
    cells[length - i - 1] := cell
    if cell != start:
      cell := field.next[cell]
  return $Some ($Path {cells, cost: field.costs[goal], expanded: field.expanded})

// Reverse Dijkstra computes the exact weighted cost to the goal. next follows
// the least-cost route, which need not follow the raw cost gradient when the
// traversal cost varies. Unreachable cells have next == cell count.
// Unit costs need only a FIFO. Equal-distance routes still select the lowest
// predecessor index, matching the weighted heap independently of queue order.
private func flow_open (g: Grid) -> (goal: U32) : Field =>
  let width = g.width
  let n = g.costs.length
  let gx = goal % width
  let gy = goal / width
  let costs = @array.fill n 0.0
  let next = @array.fill n n
  for y in 0 .. g.height:
    let row = y * width
    let dy = abs_delta y gy
    for x in 0 .. width:
      let cell = row + x
      costs[cell] := U32.to_f32 (abs_delta x gx + dy)
      next[cell] := toward_index cell x y gx gy width n
  return $Field {goal, costs, next, expanded: n}

func flow_units (g: Grid) -> (goal: U32) : Field =>
  let n = g.costs.length
  if goal < n and open_units g:
    return flow_open g goal
  return flow_units_walled g goal

private func flow_units_walled (g: Grid) -> (goal: U32) : Field =>
  let n = g.costs.length
  let width = g.width
  let weights = g.costs
  let column_mask = width - 1
  let power_of_two = (width & column_mask) == 0
  let costs = @array.fill n unreachable
  let next = @array.fill n n
  let queue: #[U32] = #[]
  let head: U32 = 0
  if goal < n:
    if weights[goal] > 0.0:
      costs[goal] := 0.0
      @storage.push queue goal
  let expanded = 0
  for 0 .. n:
    if head == queue.length:
      break
    let cell = queue[head]
    head := self + 1
    expanded := self + 1
    let distance = costs[cell] + 1.0
    let x = if power_of_two then cell & column_mask else cell % width
    if x > 0:
      let neighbour = cell - 1
      if weights[neighbour] > 0.0:
        let old = costs[neighbour]
        if old == unreachable:
          costs[neighbour] := distance
          @storage.push queue neighbour
          next[neighbour] := cell
        else:
          if old == distance and cell < next[neighbour]:
            next[neighbour] := cell
    if x + 1 < width:
      let neighbour = cell + 1
      if weights[neighbour] > 0.0:
        let old = costs[neighbour]
        if old == unreachable:
          costs[neighbour] := distance
          @storage.push queue neighbour
          next[neighbour] := cell
        else:
          if old == distance and cell < next[neighbour]:
            next[neighbour] := cell
    if cell >= width:
      let neighbour = cell - width
      if weights[neighbour] > 0.0:
        let old = costs[neighbour]
        if old == unreachable:
          costs[neighbour] := distance
          @storage.push queue neighbour
          next[neighbour] := cell
        else:
          if old == distance and cell < next[neighbour]:
            next[neighbour] := cell
    if cell < n - width:
      let neighbour = cell + width
      if weights[neighbour] > 0.0:
        let old = costs[neighbour]
        if old == unreachable:
          costs[neighbour] := distance
          @storage.push queue neighbour
          next[neighbour] := cell
        else:
          if old == distance and cell < next[neighbour]:
            next[neighbour] := cell
    let queued = queue.length
    if head >= 256 and head >= queued - head:
      let live = queued - head
      for i in 0 .. live:
        queue[i] := queue[head + i]
      @storage.truncate queue live
      head := 0
  return $Field {goal, costs, next, expanded}

// Full reverse searches only publish final slot markers. Stale entries
// can be discarded without maintaining an index table during each sift.
private func reverse_heap (g: Grid) -> (start: U32) -> (goal: U32) : (Field, #[U32]) =>
  let n = g.costs.length
  let closed = n + 1
  let width = g.width
  let col_mask = width - 1
  let power_of_two = (width & col_mask) == 0
  let weights = g.costs
  let costs = @array.fill n unreachable
  let next = @array.fill n n
  let heap_keys: #[F32] = #[]
  let heap_cells: #[U32] = #[]
  let count: U32 = 0
  let expanded: U32 = 0
  if start < n and weights[start] > 0.0:
    costs[start] := 0.0
    @storage.push heap_keys 0.0
    @storage.push heap_cells start
    count := 1
  for 0 .. 4294967295:
    if count == 0:
      break
    let cell = heap_cells[0]
    let priority = heap_keys[0]
    count := self - 1
    if count > 0:
      let moved = heap_cells[count]
      let moved_key = heap_keys[count]
      let at: U32 = 0
      for 0 .. 16:
        if count < 2 or at > (count - 2) / 4:
          break
        let first = at * 4 + 1
        let child = first
        let best = heap_keys[first]
        let other = heap_cells[first]
        if first + 1 < count:
          let ck = heap_keys[first + 1]
          let ci = heap_cells[first + 1]
          if ck < best or (ck == best and ci < other):
            child := first + 1
            best := ck
            other := ci
        if first + 2 < count:
          let ck = heap_keys[first + 2]
          let ci = heap_cells[first + 2]
          if ck < best or (ck == best and ci < other):
            child := first + 2
            best := ck
            other := ci
        if first + 3 < count:
          let ck = heap_keys[first + 3]
          let ci = heap_cells[first + 3]
          if ck < best or (ck == best and ci < other):
            child := first + 3
            best := ck
            other := ci
        if moved_key < best or (moved_key == best and moved <= other):
          break
        heap_keys[at] := best
        heap_cells[at] := other
        at := child
      heap_keys[at] := moved_key
      heap_cells[at] := moved
    if priority > costs[cell]:
      continue
    expanded := self + 1
    let key = priority + weights[cell]
    if key >= unreachable:
      continue
    let x = if power_of_two then cell & col_mask else cell % width
    let added = count
    if x > 0:
      let neighbour = cell - 1
      if key < costs[neighbour] and weights[neighbour] > 0.0:
        costs[neighbour] := key
        next[neighbour] := cell
        if count == heap_cells.length:
          @storage.push heap_cells neighbour
          @storage.push heap_keys key
        else:
          heap_cells[count] := neighbour
          heap_keys[count] := key
        count := self + 1
    if x + 1 < width:
      let neighbour = cell + 1
      if key < costs[neighbour] and weights[neighbour] > 0.0:
        costs[neighbour] := key
        next[neighbour] := cell
        if count == heap_cells.length:
          @storage.push heap_cells neighbour
          @storage.push heap_keys key
        else:
          heap_cells[count] := neighbour
          heap_keys[count] := key
        count := self + 1
    if cell >= width:
      let neighbour = cell - width
      if key < costs[neighbour] and weights[neighbour] > 0.0:
        costs[neighbour] := key
        next[neighbour] := cell
        if count == heap_cells.length:
          @storage.push heap_cells neighbour
          @storage.push heap_keys key
        else:
          heap_cells[count] := neighbour
          heap_keys[count] := key
        count := self + 1
    if cell < n - width:
      let neighbour = cell + width
      if key < costs[neighbour] and weights[neighbour] > 0.0:
        costs[neighbour] := key
        next[neighbour] := cell
        if count == heap_cells.length:
          @storage.push heap_cells neighbour
          @storage.push heap_keys key
        else:
          heap_cells[count] := neighbour
          heap_keys[count] := key
        count := self + 1
    for i in added .. count:
      let at = i
      let target = heap_cells[at]
      let candidate = heap_keys[at]
      for 0 .. 16:
        if at == 0:
          break
        let parent = (at - 1) / 4
        let pk = heap_keys[parent]
        let pi = heap_cells[parent]
        if pk < candidate or (pk == candidate and pi <= target):
          break
        heap_keys[at] := pk
        heap_cells[at] := pi
        at := parent
      heap_keys[at] := candidate
      heap_cells[at] := target
  let slots = spark #[if costs[i] < unreachable then closed else n | i <- 0 .. n]
  return ($Field {goal, costs, next, expanded}, slots)

private func dial_limit (weights: &[F32]) : U32 =>
  let most: U32 = 1
  if weights.length > 16777216:
    return 0
  for weight in weights:
    if not (weight >= 0.0 and weight <= 16.0) or weight != floor weight:
      return 0
    most := max self (F32.to_u32 weight)
  return if weights.length - 1 <= 16777215 / most then most else 0

private func flow_dial (g: Grid) -> (goal: U32) -> (most: U32) : Field =>
  let weights = g.costs
  let n = weights.length
  let width = g.width
  let col_mask = width - 1
  let power_of_two = (width & col_mask) == 0
  let span = most + 1
  let costs = @array.fill n unreachable
  let next = @array.fill n n
  let heads = @array.fill span n
  let previous = @array.fill n n
  let following = @array.fill n n
  let count: U32 = 0
  let expanded: U32 = 0
  let distance: U32 = 0
  let bucket: U32 = 0
  if goal < n and weights[goal] > 0.0:
    costs[goal] := 0.0
    heads[0] := goal
    count := 1
  let neighbours: #[4; U32] = #[n, n, n, n]
  for 0 .. n:
    if count == 0:
      break
    for 0 .. span:
      if heads[bucket] != n:
        break
      distance := self + 1
      bucket := if self == most then 0 else self + 1
    let cell = heads[bucket]
    let after = following[cell]
    heads[bucket] := after
    if after != n:
      previous[after] := n
    count := self - 1
    expanded := self + 1
    let entering = F32.to_u32 weights[cell]
    let key = U32.to_f32 (distance + entering)
    let target_bucket = if bucket + entering >= span then bucket + entering - span else bucket + entering
    let x = if power_of_two then cell & col_mask else cell % width
    neighbours[0] := if x > 0 then cell - 1 else n
    neighbours[1] := if x + 1 < width then cell + 1 else n
    neighbours[2] := if cell >= width then cell - width else n
    neighbours[3] := if cell < n - width then cell + width else n
    for neighbour in neighbours:
      if neighbour == n or weights[neighbour] <= 0.0:
        continue
      let old = costs[neighbour]
      if key == old:
        let parent = next[neighbour]
        let base = U32.to_f32 distance
        if parent != n and (base < costs[parent] or (base == costs[parent] and cell < parent)):
          next[neighbour] := cell
      if key < old:
        if old < unreachable:
          let before = previous[neighbour]
          let after = following[neighbour]
          if before == n:
            heads[F32.to_u32 old % span] := after
          else:
            following[before] := after
          if after != n:
            previous[after] := before
        else:
          count := self + 1
        costs[neighbour] := key
        next[neighbour] := cell
        let first = heads[target_bucket]
        previous[neighbour] := n
        following[neighbour] := first
        if first != n:
          previous[first] := neighbour
        heads[target_bucket] := neighbour
  return $Field {goal, costs, next, expanded}

private func flow_weighted (g: Grid) -> (goal: U32) : Field =>
  let most = dial_limit g.costs
  if most > 0:
    return flow_dial g goal most
  let (field, _) = reverse_heap g goal goal
  return field

func flow (g: Grid) -> (goal: U32) : Field =>
  if g.units:
    return flow_units g goal
  return flow_weighted g goal
