// Four-neighbour grids. Zero costs are walls; moving into a cell pays its cost.
// Grid coordinates are row-major, with caller-chosen world placement.
type Grid is data = #Grid { width: U32, height: U32, costs: Array F32, minimum: F32 }
type Path is data = #Path { cells: Array U32, cost: F32, expanded: U32 }
type Field is data = #Field { goal: U32, costs: Array F32, next: Array U32, expanded: U32 }
const unreachable = 3e38

const grid = fn (width: U32) => fn (height: U32) => fn (costs: Array F32) -> Maybe Grid => do:
  if width == 0 || height == 0 || height > 4294967295 / width || costs.length != width * height:
    return #Nothing
  let minimum = unreachable
  for cost in costs:
    if cost < 0.0 || Bool.not (is_finite cost) || cost >= unreachable:
      return #Nothing
    if cost > 0.0:
      minimum := min self cost
  return #Some (#Grid { width, height, costs, minimum })

// Equal A* scores prefer progress from the start, then caller cell order.
// All arguments are scalar bindings, avoiding captured mutable array lookups.
const precedes = fn (key_a: F32) => fn (key_b: F32) => fn (distance_a: F32) => fn (distance_b: F32) => fn (a: U32) => fn (b: U32) =>
  key_a < key_b || (key_a == key_b && (distance_a > distance_b || (distance_a == distance_b && a < b)))

// An indexed binary heap bounds storage to one entry per cell. Mutable arrays
// never cross a helper boundary inside the search loop (Blot copy-on-write).
const search = fn (g: Grid) => fn (start: U32) => fn (goal: U32) => fn (reverse: Bool) => fn (limit: U32) => do:
  let n = g.costs.length
  let costs = @array.fill n unreachable
  let next = @array.fill n n
  let keys = @array.fill n unreachable
  let heap = @array.fill n 0
  let slots = @array.fill n n
  let closed = @array.fill n #False
  let count = 0
  let expanded = 0
  if start < n && goal < n && g.costs[start] > 0.0 && g.costs[goal] > 0.0:
    costs[start] := 0.0
    keys[start] := 0.0
    heap[0] := start
    slots[start] := 0
    count := 1
  for 0..(min n limit):
    if count > 0:
      let cell = heap[0]
      count := self - 1
      slots[cell] := n
      closed[cell] := #True
      expanded := self + 1
      if count > 0:
        let moved = heap[count]
        let moved_key = keys[moved]
        let moved_distance = costs[moved]
        let k = 0
        let sinking = #True
        for 0..32:
          if sinking:
            let left = k * 2 + 1
            if left >= count:
              sinking := #False
            else:
              let child = left
              if left + 1 < count:
                let a = heap[left]
                let b = heap[left + 1]
                let key_a = keys[a]
                let key_b = keys[b]
                let cost_a = costs[a]
                let cost_b = costs[b]
                if precedes key_b key_a cost_b cost_a b a:
                  child := left + 1
              let other = heap[child]
              let other_key = keys[other]
              let other_distance = costs[other]
              if precedes moved_key other_key moved_distance other_distance moved other:
                sinking := #False
              else:
                heap[k] := other
                slots[other] := k
                k := child
        heap[k] := moved
        slots[moved] := k
      if Bool.not reverse && cell == goal:
        count := 0
      let x = cell % g.width
      let y = cell / g.width
      for direction in 0..4:
        let valid = #False
        let neighbour = cell
        if direction == 0 && x > 0:
          valid := #True
          neighbour := cell - 1
        if direction == 1 && x + 1 < g.width:
          valid := #True
          neighbour := cell + 1
        if direction == 2 && y > 0:
          valid := #True
          neighbour := cell - g.width
        if direction == 3 && y + 1 < g.height:
          valid := #True
          neighbour := cell + g.width
        let was_closed = closed[neighbour]
        if valid && (reverse || cell != goal) && Bool.not was_closed && g.costs[neighbour] > 0.0:
          let edge = g.costs[neighbour]
          if reverse:
            edge := g.costs[cell]
          let cost = costs[cell] + edge
          if cost < costs[neighbour] && cost < unreachable:
            costs[neighbour] := cost
            next[neighbour] := cell
            let heuristic = 0.0
            if Bool.not reverse:
              let dx = abs (U32.to_f32 (neighbour % g.width) - U32.to_f32 (goal % g.width))
              let dy = abs (U32.to_f32 (neighbour / g.width) - U32.to_f32 (goal / g.width))
              heuristic := (dx + dy) * g.minimum
            let neighbour_key = cost + heuristic
            keys[neighbour] := neighbour_key
            let k = slots[neighbour]
            if k == n:
              k := count
              count := self + 1
            let rising = #True
            for 0..32:
              if rising:
                if k == 0:
                  rising := #False
                else:
                  let parent = (k - 1) / 2
                  let other = heap[parent]
                  let other_key = keys[other]
                  let other_distance = costs[other]
                  if precedes other_key neighbour_key other_distance cost other neighbour:
                    rising := #False
                  else:
                    heap[k] := other
                    slots[other] := k
                    k := parent
            heap[k] := neighbour
            slots[neighbour] := k
  return (#Field { goal, costs, next, expanded }, closed)

// Nothing also means that the caller's expansion budget was exhausted.
const astar = fn (g: Grid) => fn (start: U32) => fn (goal: U32) => fn (limit: U32) -> Maybe Path => do:
  let (field, closed) = search g start goal #False limit
  let n = g.costs.length
  if goal >= n:
    return #Nothing
  if Bool.not closed[goal]:
    return #Nothing
  let cell = goal
  let length = 1
  for 0..n:
    if cell == start:
      break
    cell := field.next[cell]
    length := self + 1
  let cells = @array.fill length 0
  cell := goal
  for i in 0..length:
    cells[length - i - 1] := cell
    if cell != start:
      cell := field.next[cell]
  return #Some (#Path { cells, cost: field.costs[goal], expanded: field.expanded })

// Reverse Dijkstra computes the exact weighted cost to the goal. next follows
// the least-cost route, which need not follow the raw cost gradient when the
// traversal cost varies. Unreachable cells have next == cell count.
const flow = fn (g: Grid) => fn (goal: U32) => do:
  let (field, _) = search g goal goal #True g.costs.length
  return field
