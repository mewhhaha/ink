// Four-neighbour grids. Zero costs are walls; moving into a cell pays its cost.
// Grid coordinates are row-major, with caller-chosen world placement.
type Grid is data = #Grid { width: U32, height: U32, costs: Array F32, minimum: F32 }
type Path is data = #Path { cells: Array U32, cost: F32, expanded: U32 }
type Field is data = #Field { goal: U32, costs: Array F32, next: Array U32, expanded: U32 }
const unreachable = 3e38

const grid = fn (width: U32) => fn (height: U32) => fn (costs: Array F32) -> Maybe Grid => do:
  if width == 0 || height == 0 || height > 4294967295 / width || costs.length != width * height:
    return #Nothing
  let minimum = unreachable
  for cost in costs:
    if cost < 0.0 || Bool.not (is_finite cost) || cost >= unreachable:
      return #Nothing
    if cost > 0.0:
      minimum := min self cost
  return #Some (#Grid { width, height, costs, minimum })

// An indexed binary heap bounds storage to one entry per cell. Each heap slot
// keeps its cell's score beside it (`ranks`), so sifting reads neighbouring
// words; equal scores prefer progress from the start, then caller cell order.
// A cell's slot is n while unqueued and n + 1 once expanded. Mutable arrays
// never cross a helper boundary inside the search loop (Blot copy-on-write),
// and compound comparisons see only scalar locals.
const search = fn (g: Grid) => fn (start: U32) => fn (goal: U32) => fn (reverse: Bool) => fn (limit: U32) => do:
  let n = g.costs.length
  let closed = n + 1
  let width = g.width
  let weights = g.costs
  let goal_x = U32.to_f32 (goal % width)
  let goal_y = U32.to_f32 (goal / width)
  let costs = @array.fill n unreachable
  let next = @array.fill n n
  let heap = @array.fill n 0
  let ranks = @array.fill n unreachable
  let slots = @array.fill n n
  let count = 0
  let expanded = 0
  if start < n && goal < n && weights[start] > 0.0 && weights[goal] > 0.0:
    costs[start] := 0.0
    heap[0] := start
    ranks[0] := 0.0
    slots[start] := 0
    count := 1
  for 0..(min n limit):
    if count == 0:
      break
    let cell = heap[0]
    count := self - 1
    slots[cell] := closed
    expanded := self + 1
    if count > 0:
      let moved = heap[count]
      let moved_key = ranks[count]
      let moved_distance = costs[moved]
      let k = 0
      for 0..32:
        let left = k * 2 + 1
        if left >= count:
          break
        let child = left
        let other_key = ranks[left]
        if left + 1 < count:
          let right_key = ranks[left + 1]
          let right_first = right_key < other_key
          if right_key == other_key:
            let a = heap[left]
            let b = heap[left + 1]
            let cost_a = costs[a]
            let cost_b = costs[b]
            right_first := cost_b > cost_a || (cost_b == cost_a && b < a)
          if right_first:
            child := left + 1
            other_key := right_key
        let other = heap[child]
        let stays = moved_key < other_key
        if moved_key == other_key:
          let other_distance = costs[other]
          stays := moved_distance > other_distance || (moved_distance == other_distance && moved < other)
        if stays:
          break
        heap[k] := other
        ranks[k] := other_key
        slots[other] := k
        k := child
      heap[k] := moved
      ranks[k] := moved_key
      slots[moved] := k
    if Bool.not reverse && cell == goal:
      count := 0
    let x = cell % width
    let y = cell / width
    for direction in 0..4:
      let valid = #False
      let neighbour = cell
      let nx = x
      let ny = y
      if direction == 0 && x > 0:
        valid := #True
        neighbour := cell - 1
        nx := x - 1
      if direction == 1 && x + 1 < width:
        valid := #True
        neighbour := cell + 1
        nx := x + 1
      if direction == 2 && y > 0:
        valid := #True
        neighbour := cell - width
        ny := y - 1
      if direction == 3 && y + 1 < g.height:
        valid := #True
        neighbour := cell + width
        ny := y + 1
      let slot = slots[neighbour]
      let entering = weights[neighbour]
      if valid && (reverse || cell != goal) && slot != closed && entering > 0.0:
        let edge = entering
        if reverse:
          edge := weights[cell]
        let cost = costs[cell] + edge
        if cost < costs[neighbour] && cost < unreachable:
          costs[neighbour] := cost
          next[neighbour] := cell
          let heuristic = 0.0
          if Bool.not reverse:
            let dx = abs (U32.to_f32 nx - goal_x)
            let dy = abs (U32.to_f32 ny - goal_y)
            heuristic := (dx + dy) * g.minimum
          let neighbour_key = cost + heuristic
          let k = slot
          if k == n:
            k := count
            count := self + 1
          for 0..32:
            if k == 0:
              break
            let parent = (k - 1) / 2
            let other_key = ranks[parent]
            let other = heap[parent]
            let first = other_key < neighbour_key
            if other_key == neighbour_key:
              let other_distance = costs[other]
              first := other_distance > cost || (other_distance == cost && other < neighbour)
            if first:
              break
            heap[k] := other
            ranks[k] := other_key
            slots[other] := k
            k := parent
          heap[k] := neighbour
          ranks[k] := neighbour_key
          slots[neighbour] := k
  return (#Field { goal, costs, next, expanded }, slots)

// Nothing also means that the caller's expansion budget was exhausted.
const astar = fn (g: Grid) => fn (start: U32) => fn (goal: U32) => fn (limit: U32) -> Maybe Path => do:
  let (field, slots) = search g start goal #False limit
  let n = g.costs.length
  if goal >= n:
    return #Nothing
  if slots[goal] != n + 1:
    return #Nothing
  let cell = goal
  let length = 1
  for 0..n:
    if cell == start:
      break
    cell := field.next[cell]
    length := self + 1
  let cells = @array.fill length 0
  cell := goal
  for i in 0..length:
    cells[length - i - 1] := cell
    if cell != start:
      cell := field.next[cell]
  return #Some (#Path { cells, cost: field.costs[goal], expanded: field.expanded })

// Reverse Dijkstra computes the exact weighted cost to the goal. next follows
// the least-cost route, which need not follow the raw cost gradient when the
// traversal cost varies. Unreachable cells have next == cell count.
const flow = fn (g: Grid) => fn (goal: U32) => do:
  let (field, _) = search g goal goal #True g.costs.length
  return field
