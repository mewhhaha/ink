import { Vec2, Vec3 } from "std/vector"
import * as vector from "std/vector"
import * as math from "./math"
import * as lanes from "./lanes"

// Poses are convenient inputs/interpolation values. Affine basis columns keep
// composition exact when rotated nonuniform scales introduce shear.
type Pose2 is data = $Pose2 { position: Vec2, angle: F32, scale: Vec2 }
type Pose3 is data = $Pose3 { position: Vec3, rotation: math.Quat, scale: Vec3 }
type Affine2 is data = $Affine2 { position: Vec2, x: Vec2, y: Vec2 }
type Affine3 is data = $Affine3 { position: Vec3, x: Vec3, y: Vec3, z: Vec3 }

const identity2 = $Affine2 { position: math.zero2, x: math.vec2 1.0 0.0, y: math.vec2 0.0 1.0 }
const identity3 = $Affine3 { position: math.zero3, x: math.right, y: math.up, z: math.vec3 0.0 0.0 1.0 }

// Angles are radians; 3D uses Ink's right-handed quaternion convention.
//
// The kernels below destructure their records first: each field then costs
// one node of the compiler's 64-node inlining budget, so they inline into
// callers' loops and their intermediate records become locals. Sums keep the
// order of the vector expressions they replace, such as
// `value.x * v.x + value.y * v.y + value.z * v.z`.
func affine2 (pose: Pose2) => return do:
  let $Pose2 { position, angle, scale } = pose
  let $Vec2 { x: sx, y: sy } = scale
  let s = sin angle
  let c = cos angle
  return $Affine2 { position, x: $Vec2 { x: c * sx, y: s * sx }, y: $Vec2 { x: (F32.neg s) * sy, y: c * sy } }

// One basis column: unit axis (vx, vy, vz) turned by q, then scaled. Not
// math.rotate_parts: through it, affine3 in a loop ran 1.8 times slower.
func column3 (qx: F32) => return func (qy: F32) => return func (qz: F32) => return func (qw: F32) => return func (vx: F32) => return func (vy: F32) => return func (vz: F32) => return func (scale: F32) => return do:
  let tx = (qy * vz - qz * vy) * 2.0
  let ty = (qz * vx - qx * vz) * 2.0
  let tz = (qx * vy - qy * vx) * 2.0
  return $Vec3 {
    x: (vx + tx * qw + (qy * tz - qz * ty)) * scale,
    y: (vy + ty * qw + (qz * tx - qx * tz)) * scale,
    z: (vz + tz * qw + (qx * ty - qy * tx)) * scale,
  }

func affine3 (pose: Pose3) => return do:
  let $Pose3 { position, rotation, scale } = pose
  let $math.Quat { x, y, z, w } = math.Quat.normalized rotation
  let $Vec3 { x: sx, y: sy, z: sz } = scale
  return $Affine3 {
    position,
    x: column3 x y z w 1.0 0.0 0.0 sx,
    y: column3 x y z w 0.0 1.0 0.0 sy,
    z: column3 x y z w 0.0 0.0 1.0 sz,
  }

func vector2 (value: Affine2) => return func (v: Vec2) => return do:
  let $Affine2 { x: a, y: b } = value
  let $Vec2 { x: ax, y: ay } = a
  let $Vec2 { x: bx, y: by } = b
  let $Vec2 { x, y } = v
  return $Vec2 { x: ax * x + bx * y, y: ay * x + by * y }
func vector3 (value: Affine3) => return func (v: Vec3) => return do:
  let $Affine3 { x: a, y: b, z: c } = value
  let $Vec3 { x: ax, y: ay, z: az } = a
  let $Vec3 { x: bx, y: by, z: bz } = b
  let $Vec3 { x: cx, y: cy, z: cz } = c
  let $Vec3 { x, y, z } = v
  return $Vec3 { x: ax * x + bx * y + cx * z, y: ay * x + by * y + cy * z, z: az * x + bz * y + cz * z }
func point2 (value: Affine2) => return func (p: Vec2) => return do:
  let $Vec2 { x: ox, y: oy } = value.position
  let $Vec2 { x, y } = vector2 value p
  return $Vec2 { x: ox + x, y: oy + y }
func point3 (value: Affine3) => return func (p: Vec3) => return do:
  let $Vec3 { x: ox, y: oy, z: oz } = value.position
  let $Vec3 { x, y, z } = vector3 value p
  return $Vec3 { x: ox + x, y: oy + y, z: oz + z }

// Parent after child: point (compose parent child) p == point parent (point child p).
func compose2 (parent: Affine2) => return func (child: Affine2) => return $Affine2 {
  position: point2 parent child.position,
  x: vector2 parent child.x,
  y: vector2 parent child.y,
}
func compose3 (parent: Affine3) => return func (child: Affine3) => return $Affine3 {
  position: point3 parent child.position,
  x: vector3 parent child.x,
  y: vector3 parent child.y,
  z: vector3 parent child.z,
}

private func finite_parts (x: F32) => return func (y: F32) => return func (z: F32) => return is_finite x and is_finite y and is_finite z

// Singular or non-finite inverses return Nothing. Tiny invertible bases are
// accepted when their inverse remains representable in F32. The kernels take
// position and basis parts, so callers never box a basis they hold in locals.
private func invert2 (px: F32) => return func (py: F32) => return func (ax: F32) => return func (ay: F32) => return func (bx: F32) => return func (by: F32) : Maybe Affine2 => return do:
  let det = ax * by - bx * ay
  if det == 0.0 or Bool.not (is_finite det):
    return $Nothing
  let xx = by / det
  let xy = (F32.neg ay) / det
  let yx = (F32.neg bx) / det
  let yy = ax / det
  let nx = px * (-1.0)
  let ny = py * (-1.0)
  let ox = xx * nx + yx * ny
  let oy = xy * nx + yy * ny
  if Bool.not (finite_parts ox oy xx and finite_parts xy yx yy):
    return $Nothing
  return $Some ($Affine2 { position: $Vec2 { x: ox, y: oy }, x: $Vec2 { x: xx, y: xy }, y: $Vec2 { x: yx, y: yy } })
func inverse2 (value: Affine2) : Maybe Affine2 => return do:
  let $Affine2 { position: p, x: a, y: b } = value
  return invert2 p.x p.y a.x a.y b.x b.y

// The inverse basis has rows y × z, z × x and x × y over the determinant.
private func invert3 (px: F32) => return func (py: F32) => return func (pz: F32) => return func (ax: F32) => return func (ay: F32) => return func (az: F32) => return func (bx: F32) => return func (by: F32) => return func (bz: F32) => return func (cx: F32) => return func (cy: F32) => return func (cz: F32) : Maybe Affine3 => return do:
  let rxx = by * cz - bz * cy
  let rxy = bz * cx - bx * cz
  let rxz = bx * cy - by * cx
  let det = ax * rxx + ay * rxy + az * rxz
  if det == 0.0 or Bool.not (is_finite det):
    return $Nothing
  let xx = rxx / det
  let xy = (cy * az - cz * ay) / det
  let xz = (ay * bz - az * by) / det
  let yx = rxy / det
  let yy = (cz * ax - cx * az) / det
  let yz = (az * bx - ax * bz) / det
  let zx = rxz / det
  let zy = (cx * ay - cy * ax) / det
  let zz = (ax * by - ay * bx) / det
  let nx = px * (-1.0)
  let ny = py * (-1.0)
  let nz = pz * (-1.0)
  let ox = xx * nx + yx * ny + zx * nz
  let oy = xy * nx + yy * ny + zy * nz
  let oz = xz * nx + yz * ny + zz * nz
  if Bool.not (finite_parts ox oy oz and finite_parts xx xy xz and finite_parts yx yy yz and finite_parts zx zy zz):
    return $Nothing
  return $Some ($Affine3 { position: $Vec3 { x: ox, y: oy, z: oz }, x: $Vec3 { x: xx, y: xy, z: xz }, y: $Vec3 { x: yx, y: yy, z: yz }, z: $Vec3 { x: zx, y: zy, z: zz } })
func inverse3 (value: Affine3) : Maybe Affine3 => return do:
  let $Affine3 { position: p, x: a, y: b, z: c } = value
  return invert3 p.x p.y p.z a.x a.y a.z b.x b.y b.z c.x c.y c.z

// Interpolate poses before constructing a basis. Angles/quaternions take the
// shorter arc; position and scale are linear. Weight is not clamped.
func lerp2 (a: Pose2) => return func (b: Pose2) => return func (weight: F32) => return $Pose2 {
  position: vector.Vec2.lerp a.position b.position weight,
  angle: F32.lerp_angle a.angle b.angle weight,
  scale: vector.Vec2.lerp a.scale b.scale weight,
}
func lerp3 (a: Pose3) => return func (b: Pose3) => return func (weight: F32) => return do:
  let $math.Quat { x: ax, y: ay, z: az, w: aw } = math.Quat.normalized a.rotation
  let $math.Quat { x: bx, y: by, z: bz, w: bw } = math.Quat.normalized b.rotation
  return $Pose3 {
    position: vector.Vec3.lerp a.position b.position weight,
    rotation: math.nlerp_parts ax ay az aw bx by bz bw weight,
    scale: vector.Vec3.lerp a.scale b.scale weight,
  }

const identity = $Pose3 { position: math.zero3, rotation: math.Quat.identity, scale: math.one3 }

func from_position position => return $Pose3 { position, rotation: math.Quat.identity, scale: math.one3 }
func from_xyz x => return func y => return func z => return from_position (math.vec3 x y z)

func with_scale scale => return func (pose: Pose3) => return do:
  pose.scale := scale
  return pose

func with_rotation rotation => return func (pose: Pose3) => return do:
  pose.rotation := rotation
  return pose

func translate offset => return func (pose: Pose3) => return do:
  pose.position := self + offset
  return pose

// Applies `rotation` in local space after the current rotation.
func rotate rotation => return func (pose: Pose3) => return do:
  pose.rotation := (self * rotation).normalized
  return pose

func rotate_y angle => return rotate (math.Quat.from_axis_angle math.up angle)

func scale_by factor => return func (pose: Pose3) => return do:
  pose.scale := self * factor
  return pose

// Model matrix: scale, then rotation, then translation.
func matrix (pose: Pose3) => return math.Mat4.compose pose.position pose.rotation pose.scale

// Interpolates position, rotation and scale.
const interpolate = lerp3

// Lanes: position3, rotation4, scale3. Scale must be positive.
func encode (pose: Pose3) => return do:
  let $Pose3 { position: p, rotation: r, scale: s } = pose
  return #[p.x, p.y, p.z, r.x, r.y, r.z, r.w, s.x, s.y, s.z]

func decode (values: Array F32) => return do:
  use lanes.exact values 10
  return $Pose3 { position: lanes.vec3 values 0, rotation: lanes.quaternion values 3, scale: lanes.positive_vec3 values 7 }

const codec = $lanes.Codec { key: 4, version: 1, encode, decode, migrate: lanes.no_migration }

// Copy current poses into separately owned previous-state storage immediately
// before a fixed step. Scalar pose fields copy by value; descriptors may not
// alias, otherwise this would not be an interpolation checkpoint.
func checkpoint (current: Array (Maybe Pose3)) -> (previous: Array (Maybe Pose3)) => return do:
  if current.length != previous.length:
    return @panic "transform checkpoint length mismatch"
  for i in 0 .. current.length:
    previous[i] = current[i]
