// xorshift32 with explicit caller-owned state. Zero would stay zero; it
// restarts from a fixed odd seed instead.
const next = func (state: U32) : U32 => return do:
  let x = state
  if x == 0:
    x := 2654435769
  x := self ^ (self << 13)
  x := self ^ (self >> 17)
  x := self ^ (self << 5)
  return x

// A number in [0, 1) from the state's high 24 bits.
const unit = func (state: U32) => return U32.to_f32 (state >> 8) / 16777216.0

const between = func (low: F32) => return func (high: F32) => return func (seed: U32) => return low + (high - low) * unit seed
const angle = func (seed: U32) => return unit seed * tau
const chance = func (probability: F32) => return func (seed: U32) => return unit seed < probability
const below = func (count: U32) => return func (seed: U32) => return do:
  if count == 0:
    return 0
  return seed % count
const branch = func (seed: U32) => return func (index: U32) => return next (seed ^ (index * 2654435769))
