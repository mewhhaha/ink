// xorshift32 with explicit caller-owned state. Zero would stay zero; it
// restarts from a fixed odd seed instead.
func next (state: U32) : U32 => return do:
  let x = state
  if x == 0:
    x := 2654435769
  x := self ^ (self << 13)
  x := self ^ (self >> 17)
  x := self ^ (self << 5)
  return x

// A number in [0, 1) from the state's high 24 bits.
func unit (state: U32) => return U32.to_f32 (state >> 8) / 16777216.0

func between (low: F32) => return func (high: F32) => return func (seed: U32) => return low + (high - low) * unit seed
func angle (seed: U32) => return unit seed * tau
func chance (probability: F32) => return func (seed: U32) => return unit seed < probability
func below (count: U32) => return func (seed: U32) => return do:
  if count == 0:
    return 0
  return seed % count
func branch (seed: U32) => return func (index: U32) => return next (seed ^ (index * 2654435769))
