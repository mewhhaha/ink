// xorshift32 with explicit caller-owned state. Zero would stay zero; it
// restarts from a fixed odd seed instead.
const next = fn (state: U32) -> U32 => do:
  let x = state
  if x == 0:
    x := 2654435769
  x := self ^ (self << 13)
  x := self ^ (self >> 17)
  x := self ^ (self << 5)
  return x

// A number in [0, 1) from the state's high 24 bits.
const unit = fn (state: U32) => U32.to_f32 (state >> 8) / 16777216.0

const between = fn (low: F32) => fn (high: F32) => fn (seed: U32) => low + (high - low) * unit seed
const angle = fn (seed: U32) => unit seed * tau
const chance = fn (probability: F32) => fn (seed: U32) => unit seed < probability
const below = fn (count: U32) => fn (seed: U32) => do:
  if count == 0:
    return 0
  return seed % count
const branch = fn (seed: U32) => fn (index: U32) => next (seed ^ (index * 2654435769))
