// Events the host delivers each frame. Key codes are listed in input/keys.
type Event is data =
  | #KeyDown U32
  | #KeyUp U32
  | #PointerDown { button: U32, x: F32, y: F32 }
  | #PointerUp { button: U32, x: F32, y: F32 }
  | #PointerMove { x: F32, y: F32 }
  | #Wheel { delta: F32, x: F32, y: F32 }
  | #FocusLost
  | #AssetChanged
  // A command from the host's console for the game: which, and its argument.
  | #Console { command: U32, argument: U32 }
  // A stored preference the host plays back at startup (see preferences.blot).
  | #Preference { index: U32, value: F32 }
  // A live-tunable constant the host sets: which, and its value.
  | #Tune { index: U32, value: F32 }
  // An action on node `node` of the interface (ui): from assistive
  // technology through the host, or from the keys while the node has the
  // keyboard focus (ui/tree.blot's `route`). `action` is one of
  // ui/vocabulary.action_*, `value` what set_value sets.
  | #UiAction { node: U32, action: U32, value: F32 }
  // The answer to a service request (services.blot): the request's id, how it
  // went (a caller-defined status), a number, and how many values follow
  // in ServiceData events, three to an event.
  | #ServiceAnswer { request: U32, status: U32, value: F32, length: U32 }
  | #ServiceData { request: U32, a: F32, b: F32, c: F32 }

// Current framebuffer dimensions, refreshed before event and update systems.
type Viewport is data = #Viewport { width: F32, height: F32 }
