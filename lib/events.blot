// Events the host delivers each frame. Key codes are listed in input/keys.
type Event is data =
  // Once after a host starts a session, after loading its initial world.
  // Restores within that session (reload, quickload, rewind) do not send it.
  | $SessionStarted { restored: Bool }
  | $KeyDown U32
  | $KeyUp U32
  | $PointerDown { button: U32, x: F32, y: F32 }
  | $PointerUp { button: U32, x: F32, y: F32 }
  | $PointerMove { x: F32, y: F32 }
  | $Wheel { delta: F32, x: F32, y: F32 }
  | $FocusLost
  | $AssetChanged
  // The initial scene and its GPU assets are ready; a loading UI may finish.
  | $RendererReady
  // A command from the host's console for the game: which, and its argument.
  | $Console { command: U32, argument: U32 }
  // A stored preference the host plays back at startup (see preferences.blot).
  | $Preference { index: U32, value: F32 }
  // A live-tunable constant the host sets: which, and its value.
  | $Tune { index: U32, value: F32 }
  // An action on node `node` of the interface (ui): from assistive
  // technology through the host, or from the keys while the node has the
  // keyboard focus (ui/tree.blot's `route`). `action` is one of
  // ui/vocabulary.action_*, `value` what set_value sets.
  | $UiAction { node: U32, action: U32, value: F32 }
  // The answer to a service request (services.blot): the request's id, how it
  // went (a caller-defined status), a number, and how many values follow
  // in ServiceData events, three to an event.
  | $ServiceAnswer { request: U32, status: U32, value: F32, length: U32 }
  | $ServiceData { request: U32, a: F32, b: F32, c: F32 }
  // A gamepad came or went (pads are numbered from 0; `standard` is 1 when
  // its buttons and axes follow the standard layout, pen/protocol's
  // gamepad_button_* and gamepad_axis_*), a button changed (its value 0 to 1,
  // `pressed` 1 at half or more) or a stick axis moved (-1 to 1, right and
  // down positive, 0 inside its dead zone).
  | $GamepadConnected { pad: U32, standard: U32 }
  | $GamepadDisconnected { pad: U32 }
  | $GamepadButton { button: U32, pad: U32, value: F32, pressed: U32 }
  | $GamepadAxis { axis: U32, pad: U32, value: F32 }
  // An action the game declared through the input service changed: its
  // value (a button's 1 or 0, an axis -1 to 1) and the device that moved it.
  | $Action { action: U32, value: F32, device: U32 }
  // Text: a character typed or committed, or with `composing` 1 one of an
  // input method's composition, whose Composition (its length and caret)
  // comes first; a Composition of length 0 ends it.
  | $TextInput { character: U32, composing: U32 }
  | $Composition { length: U32, cursor: U32 }
  // How far the mouse moved while the pointer is locked.
  | $MouseMotion { dx: F32, dy: F32 }
  // A touch (numbered from 0) and its phase (start, move, end, cancel), and
  // the gestures two or more touches make: dragged together, and pinched
  // (`scale` the factor their distance grew by).
  | $Touch { id: U32, x: F32, y: F32, phase: U32 }
  | $Pan { touches: U32, dx: F32, dy: F32 }
  | $Pinch { x: F32, y: F32, scale: F32 }
  // In a net session, the events after it (up to the next Player) are
  // player `index`'s; every frame lists each player in order. Outside one
  // there are none, and every event is player 0's.
  | $Player { index: U32 }

// Current framebuffer dimensions, refreshed before event and update systems.
type Viewport is data = $Viewport { width: F32, height: F32 }
