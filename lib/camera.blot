import { Vec3 } from "std/vector"
import * as math from "./math"
import * as spatial from "./spatial"

type Projection is data =
  | $Perspective { fov_y: F32, aspect: F32, near: F32, far: F32, reversed: Bool }
  | $Orthographic { height: F32, aspect: F32, near: F32, far: F32, reversed: Bool }
type Camera is data = $Camera { position: Vec3, rotation: math.Quat, projection: Projection }
// Column-major, suitable for a GPU mat4. WebGPU NDC depth is [0,1].
type Lens is data = $Lens { x: F32, y: F32, a: F32, b: F32, perspective: Bool }
type Plane is data = $Plane { normal: Vec3, distance: F32 }
type Frustum is data = $Frustum { planes: #[Plane] }

func valid (p: Projection) => case p of
  $Perspective { fov_y, aspect, near, far } => is_finite fov_y and fov_y > 0.0 and fov_y < 3.14159265 and is_finite aspect and aspect > 0.0 and is_finite near and near > 0.0 and is_finite far and far > near
  $Orthographic { height, aspect, near, far } => is_finite height and height > 0.0 and is_finite aspect and aspect > 0.0 and is_finite near and near >= 0.0 and is_finite far and far > near

func valid_camera (c: Camera) => valid c.projection and math.finite3 c.position and math.finite_quat c.rotation and (c.rotation.x != 0.0 or c.rotation.y != 0.0 or c.rotation.z != 0.0 or c.rotation.w != 0.0)
// Unchecked matrix/frustum helpers require valid_camera. Quaternions normalize.
func lens (p: Projection) => case p of
  $Perspective { fov_y, aspect, near, far, reversed } => do:
    let (s, c) = sin_cos (fov_y * 0.5)
    let y = c / s
    let a = far / (near - far)
    let b = near * a
    if reversed:
      a := near / (far - near)
      b := near * far / (far - near)
    break $Lens { x: y / aspect, y, a, b, perspective: true }
  $Orthographic { height, aspect, near, far, reversed } => do:
    let a = 1.0 / (near - far)
    let b = near * a
    if reversed:
      a := 1.0 / (far - near)
      b := far * a
    break $Lens { x: 2.0 / (height * aspect), y: 2.0 / height, a, b, perspective: false }

func view (c: Camera) => func (p: Vec3) => math.Quat.rotate (math.Quat.conjugate (math.Quat.normalized c.rotation)) (p - c.position)
func clip (l: Lens) => func (p: Vec3) =>
  let w = 1.0
  if l.perspective:
    w := F32.neg p.z
  return math.vec4 (p.x * l.x) (p.y * l.y) (p.z * l.a + l.b) w
// project, unproject and pick_ray compute what view and clip do, on scalars.
func project (c: Camera) => func (p: Vec3) : Maybe Vec3 =>
  if not (valid_camera c and math.finite3 p):
    return $Nothing
  let l = lens c.projection
  let q = math.Quat.normalized c.rotation
  let (vx, vy, vz) = math.rotate_parts (F32.neg q.x) (F32.neg q.y) (F32.neg q.z) q.w (p.x - c.position.x) (p.y - c.position.y) (p.z - c.position.z)
  let w = if l.perspective then F32.neg vz else 1.0
  if w == 0.0:
    return $Nothing
  let x = vx * l.x / w
  let y = vy * l.y / w
  let z = (vz * l.a + l.b) / w
  if not (is_finite x and is_finite y and is_finite z):
    return $Nothing
  return $Some (math.vec3 x y z)
func unproject (c: Camera) => func (ndc: Vec3) : Maybe Vec3 =>
  if not (valid_camera c and math.finite3 ndc):
    return $Nothing
  let l = lens c.projection
  let z = (ndc.z - l.b) / l.a
  let w = 1.0
  if l.perspective:
    if ndc.z + l.a == 0.0:
      return $Nothing
    z := (F32.neg l.b) / (ndc.z + l.a)
    w := F32.neg z
  let q = math.Quat.normalized c.rotation
  let (rx, ry, rz) = math.rotate_parts q.x q.y q.z q.w (ndc.x * w / l.x) (ndc.y * w / l.y) z
  let x = c.position.x + rx
  let y = c.position.y + ry
  let zw = c.position.z + rz
  if not (is_finite x and is_finite y and is_finite zw):
    return $Nothing
  return $Some (math.vec3 x y zw)

// Screen coordinates are NDC, +Y up. Orthographic rays start on the near plane.
func pick_ray (c: Camera) => func (x: F32) => func (y: F32) : Maybe math.Ray =>
  if not (valid_camera c and is_finite x and is_finite y):
    return $Nothing
  let l = lens c.projection
  let q = math.Quat.normalized c.rotation
  if l.perspective:
    if let $Some d = math.normalize3 (math.vec3 (x / l.x) (y / l.y) (-1.0)):
      let (dx, dy, dz) = math.rotate_parts q.x q.y q.z q.w d.x d.y d.z
      return $Some ($math.Ray { origin: c.position, direction: math.vec3 dx dy dz })
    return $Nothing
  let near = case c.projection of
    $Perspective { near } => near
    $Orthographic { near } => near
  let (ox, oy, oz) = math.rotate_parts q.x q.y q.z q.w (x / l.x) (y / l.y) (F32.neg near)
  let origin = math.vec3 (c.position.x + ox) (c.position.y + oy) (c.position.z + oz)
  if not (math.finite3 origin):
    return $Nothing
  let ahead = math.forward
  let (fx, fy, fz) = math.rotate_parts q.x q.y q.z q.w ahead.x ahead.y ahead.z
  return $Some ($math.Ray { origin, direction: math.vec3 fx fy fz })

func matrix (c: Camera) =>
  let l = lens c.projection
  let q = math.Quat.conjugate (math.Quat.normalized c.rotation)
  let column = func (p: Vec3) =>
    let v = math.Quat.rotate q p
    let w = 0.0
    if l.perspective:
      w := F32.neg v.z
    return math.vec4 (v.x * l.x) (v.y * l.y) (v.z * l.a) w
  return (math.Mat4.from_columns (column math.right) (column math.up) (column (math.vec3 0.0 0.0 1.0)) (clip l (view c math.zero3)))
func plane (c: Camera) => func (normal: Vec3) => func (distance: F32) =>
  let n = math.Quat.rotate (math.Quat.normalized c.rotation) normal
  let length = n.length
  return $Plane { normal: n / length, distance: (distance - n.dot c.position) / length }
func frustum (c: Camera) =>
  let l = lens c.projection
  let near = case c.projection of
    $Perspective { near } => near
    $Orthographic { near } => near
  let far = case c.projection of
    $Perspective { far } => far
    $Orthographic { far } => far
  let side_z = 0.0
  let side_d = 1.0
  if l.perspective:
    side_z := (-1.0)
    side_d := 0.0
  return $Frustum { planes: #[
    plane c (math.vec3 l.x 0.0 side_z) side_d,
    plane c (math.vec3 (F32.neg l.x) 0.0 side_z) side_d,
    plane c (math.vec3 0.0 l.y side_z) side_d,
    plane c (math.vec3 0.0 (F32.neg l.y) side_z) side_d,
    plane c math.forward (F32.neg near),
    plane c (math.vec3 0.0 0.0 1.0) far,
  ] }
func sphere_visible (f: Frustum) => func (center: Vec3) => func (radius: F32) =>
  for p in f.planes:
    if p.normal.dot center + p.distance < F32.neg radius:
      return false
  return true
// Conservative AABB/plane test: intersecting boxes are retained. Centre and
// half extent stay scalar: Vec3 temporaries each cost a heap allocation.
func bounds_visible (f: Frustum) => func (b: spatial.Bounds) =>
  let cx = (b.low.x + b.high.x) * 0.5
  let cy = (b.low.y + b.high.y) * 0.5
  let cz = (b.low.z + b.high.z) * 0.5
  let hx = (b.high.x - b.low.x) * 0.5
  let hy = (b.high.y - b.low.y) * 0.5
  let hz = (b.high.z - b.low.z) * 0.5
  for p in f.planes:
    let n = p.normal
    let radius = abs n.x * hx + abs n.y * hy + abs n.z * hz
    if n.x * cx + n.y * cy + n.z * cz + p.distance < F32.neg radius:
      return false
  return true
// The planes as scalars (normal and distance), read once for every box.
func cull (f: Frustum) -> (bounds: #[spatial.Bounds]) : #[U32] =>
  let count = f.planes.length
  let planes = @array.generate (count * 4) (func (i: U32) =>
    let p = f.planes[i / 4]
    let lane = i % 4
    if lane == 0:
      return p.normal.x
    if lane == 1:
      return p.normal.y
    if lane == 2:
      return p.normal.z
    return p.distance)
  let found: #[U32] = #[]
  for i in 0..bounds.length:
    let b = bounds[i]
    let cx = (b.low.x + b.high.x) * 0.5
    let cy = (b.low.y + b.high.y) * 0.5
    let cz = (b.low.z + b.high.z) * 0.5
    let hx = (b.high.x - b.low.x) * 0.5
    let hy = (b.high.y - b.low.y) * 0.5
    let hz = (b.high.z - b.low.z) * 0.5
    let visible = true
    for k in 0..count:
      if visible:
        let o = k * 4
        let nx = planes[o]
        let ny = planes[o + 1]
        let nz = planes[o + 2]
        let radius = abs nx * hx + abs ny * hy + abs nz * hz
        if nx * cx + ny * cy + nz * cz + planes[o + 3] < F32.neg radius:
          visible := false
    if visible:
      @storage.push found i
  return found

// ---------------------------------------------------------------- camera-relative precision, planar reflection and split-screen

// Camera-relative world offset: subtract the camera origin before building GPU
// model matrices so large coordinates stay within F32 mantissa precision.
func camera_relative_offset (origin: Vec3) -> (world: Vec3) : Vec3 => world - origin

func camera_relative_matrix (origin: Vec3) -> (model: math.Mat4) : math.Mat4 => $math.Mat4 {
  xx: model.xx, xy: model.xy, xz: model.xz, xw: model.xw,
  yx: model.yx, yy: model.yy, yz: model.yz, yw: model.yw,
  zx: model.zx, zy: model.zy, zz: model.zz, zw: model.zw,
  wx: model.wx - origin.x, wy: model.wy - origin.y, wz: model.wz - origin.z, ww: model.ww,
}

func mat4_mul (a: math.Mat4) -> (b: math.Mat4) : math.Mat4 => $math.Mat4 {
  xx: a.xx * b.xx + a.yx * b.xy + a.zx * b.xz + a.wx * b.xw,
  xy: a.xy * b.xx + a.yy * b.xy + a.zy * b.xz + a.wy * b.xw,
  xz: a.xz * b.xx + a.yz * b.xy + a.zz * b.xz + a.wz * b.xw,
  xw: a.xw * b.xx + a.yw * b.xy + a.zw * b.xz + a.ww * b.xw,
  yx: a.xx * b.yx + a.yx * b.yy + a.zx * b.yz + a.wx * b.yw,
  yy: a.xy * b.yx + a.yy * b.yy + a.zy * b.yz + a.wy * b.yw,
  yz: a.xz * b.yx + a.yz * b.yy + a.zz * b.yz + a.wz * b.yw,
  yw: a.xw * b.yx + a.yw * b.yy + a.zw * b.yz + a.ww * b.yw,
  zx: a.xx * b.zx + a.yx * b.zy + a.zx * b.zz + a.wx * b.zw,
  zy: a.xy * b.zx + a.yy * b.zy + a.zy * b.zz + a.wy * b.zw,
  zz: a.xz * b.zx + a.yz * b.zy + a.zz * b.zz + a.wz * b.zw,
  zw: a.xw * b.zx + a.yw * b.zy + a.zw * b.zz + a.ww * b.zw,
  wx: a.xx * b.wx + a.yx * b.wy + a.zx * b.wz + a.wx * b.ww,
  wy: a.xy * b.wx + a.yy * b.wy + a.zy * b.wz + a.wy * b.ww,
  wz: a.xz * b.wx + a.yz * b.wy + a.zz * b.wz + a.wz * b.ww,
  ww: a.xw * b.wx + a.yw * b.wy + a.zw * b.wz + a.ww * b.ww,
}

private func finite_mat4 (m: math.Mat4) : Bool => return
  is_finite m.xx and is_finite m.xy and is_finite m.xz and is_finite m.xw and
  is_finite m.yx and is_finite m.yy and is_finite m.yz and is_finite m.yw and
  is_finite m.zx and is_finite m.zy and is_finite m.zz and is_finite m.zw and
  is_finite m.wx and is_finite m.wy and is_finite m.wz and is_finite m.ww

// Analytical 4x4 cofactor inverse; returns Nothing for singular or non-finite matrices.
func mat4_inverse (m: math.Mat4) : Maybe math.Mat4 =>
  if not (finite_mat4 m):
    return $Nothing
  let m00 = m.xx
  let m01 = m.yx
  let m02 = m.zx
  let m03 = m.wx
  let m10 = m.xy
  let m11 = m.yy
  let m12 = m.zy
  let m13 = m.wy
  let m20 = m.xz
  let m21 = m.yz
  let m22 = m.zz
  let m23 = m.wz
  let m30 = m.xw
  let m31 = m.yw
  let m32 = m.zw
  let m33 = m.ww
  let s0 = m00 * m11 - m10 * m01
  let s1 = m00 * m12 - m10 * m02
  let s2 = m00 * m13 - m10 * m03
  let s3 = m01 * m12 - m11 * m02
  let s4 = m01 * m13 - m11 * m03
  let s5 = m02 * m13 - m12 * m03
  let c5 = m22 * m33 - m32 * m23
  let c4 = m21 * m33 - m31 * m23
  let c3 = m21 * m32 - m31 * m22
  let c2 = m20 * m33 - m30 * m23
  let c1 = m20 * m32 - m30 * m22
  let c0 = m20 * m31 - m30 * m21
  let det = s0 * c5 - s1 * c4 + s2 * c3 + s3 * c2 - s4 * c1 + s5 * c0
  if not (is_finite det) or abs det <= 1.0e-12:
    return $Nothing
  let inv = 1.0 / det
  let out = $math.Mat4 {
    xx: (m11 * c5 - m12 * c4 + m13 * c3) * inv,
    xy: ((0.0 - m10) * c5 + m12 * c2 - m13 * c1) * inv,
    xz: (m10 * c4 - m11 * c2 + m13 * c0) * inv,
    xw: ((0.0 - m10) * c3 + m11 * c1 - m12 * c0) * inv,
    yx: ((0.0 - m01) * c5 + m02 * c4 - m03 * c3) * inv,
    yy: (m00 * c5 - m02 * c2 + m03 * c1) * inv,
    yz: ((0.0 - m00) * c4 + m01 * c2 - m03 * c0) * inv,
    yw: (m00 * c3 - m01 * c1 + m02 * c0) * inv,
    zx: (m31 * s5 - m32 * s4 + m33 * s3) * inv,
    zy: ((0.0 - m30) * s5 + m32 * s2 - m33 * s1) * inv,
    zz: (m30 * s4 - m31 * s2 + m33 * s0) * inv,
    zw: ((0.0 - m30) * s3 + m31 * s1 - m32 * s0) * inv,
    wx: ((0.0 - m21) * s5 + m22 * s4 - m23 * s3) * inv,
    wy: (m20 * s5 - m22 * s2 + m23 * s1) * inv,
    wz: ((0.0 - m20) * s4 + m21 * s2 - m23 * s0) * inv,
    ww: (m20 * s3 - m21 * s1 + m22 * s0) * inv,
  }
  if not (finite_mat4 out):
    return $Nothing
  return $Some out

// Householder-reflected view matrix across `(plane_point, plane_normal)` (det = -1).
func planar_reflection_view (view_mat: math.Mat4) -> (plane_point: Vec3) -> (plane_normal: Vec3) : Maybe math.Mat4 =>
  if not (finite_mat4 view_mat and math.finite3 plane_point):
    return $Nothing
  let $Some n = math.normalize3 plane_normal else:
    return $Nothing
  let nx = n.x
  let ny = n.y
  let nz = n.z
  let d = 0.0 - (nx * plane_point.x + ny * plane_point.y + nz * plane_point.z)
  let refl = $math.Mat4 {
    xx: 1.0 - 2.0 * nx * nx, xy: (0.0 - 2.0) * ny * nx, xz: (0.0 - 2.0) * nz * nx, xw: 0.0,
    yx: (0.0 - 2.0) * nx * ny, yy: 1.0 - 2.0 * ny * ny, yz: (0.0 - 2.0) * nz * ny, yw: 0.0,
    zx: (0.0 - 2.0) * nx * nz, zy: (0.0 - 2.0) * ny * nz, zz: 1.0 - 2.0 * nz * nz, zw: 0.0,
    wx: (0.0 - 2.0) * d * nx, wy: (0.0 - 2.0) * d * ny, wz: (0.0 - 2.0) * d * nz, ww: 1.0,
  }
  return $Some (mat4_mul view_mat refl)

// Lengyel oblique near-plane clipping projection (WebGPU [0, 1] clip Z, supporting
// both standard-Z and reversed-Z). Keeps the half-space `dot(plane_normal, p - plane_point) >= 0`.
func oblique_clip_projection (projection: math.Mat4) -> (view_mat: math.Mat4) -> (plane_point: Vec3) -> (plane_normal: Vec3) -> (reversed: Bool) : Maybe math.Mat4 =>
  if not (finite_mat4 projection and finite_mat4 view_mat and math.finite3 plane_point):
    return $Nothing
  let $Some n = math.normalize3 plane_normal else:
    return $Nothing
  let $Some inv_v = mat4_inverse view_mat else:
    return $Nothing
  let $Some inv_p = mat4_inverse projection else:
    return $Nothing
  let d_world = 0.0 - (n.x * plane_point.x + n.y * plane_point.y + n.z * plane_point.z)
  // Transform plane via inverse-transpose: row k of V^{-T} is column k of V^{-1}.
  let cx = inv_v.xx * n.x + inv_v.xy * n.y + inv_v.xz * n.z + inv_v.xw * d_world
  let cy = inv_v.yx * n.x + inv_v.yy * n.y + inv_v.yz * n.z + inv_v.yw * d_world
  let cz = inv_v.zx * n.x + inv_v.zy * n.y + inv_v.zz * n.z + inv_v.zw * d_world
  let cw = inv_v.wx * n.x + inv_v.wy * n.y + inv_v.wz * n.z + inv_v.ww * d_world
  let clen = sqrt (cx * cx + cy * cy + cz * cz)
  if not (is_finite clen) or clen <= 1.0e-7:
    return $Nothing
  let c0 = cx / clen
  let c1 = cy / clen
  let c2 = cz / clen
  let c3 = cw / clen
  let far_z = if reversed then 0.0 else 1.0
  let best_dot = -1.0e30
  let bqx = 0.0
  let bqy = 0.0
  let bqz = 0.0
  let bqw = 0.0
  for i in 0 .. 4:
    let sx = if (i & 1) == 0 then -1.0 else 1.0
    let sy = if (i & 2) == 0 then -1.0 else 1.0
    let qx = inv_p.xx * sx + inv_p.yx * sy + inv_p.zx * far_z + inv_p.wx
    let qy = inv_p.xy * sx + inv_p.yy * sy + inv_p.zy * far_z + inv_p.wy
    let qz = inv_p.xz * sx + inv_p.yz * sy + inv_p.zz * far_z + inv_p.wz
    let qw = inv_p.xw * sx + inv_p.yw * sy + inv_p.zw * far_z + inv_p.ww
    let d_val = c0 * qx + c1 * qy + c2 * qz + c3 * qw
    if d_val > best_dot:
      best_dot := d_val
      bqx := qx
      bqy := qy
      bqz := qz
      bqw := qw
  if not (is_finite best_dot) or best_dot <= 1.0e-6:
    return $Nothing
  let row3_dot_q = projection.xw * bqx + projection.yw * bqy + projection.zw * bqz + projection.ww * bqw
  if not (is_finite row3_dot_q) or row3_dot_q <= 1.0e-6:
    return $Nothing
  let scale = row3_dot_q / best_dot
  let out = projection
  if reversed:
    out.xz := projection.xw - c0 * scale
    out.yz := projection.yw - c1 * scale
    out.zz := projection.zw - c2 * scale
    out.wz := projection.ww - c3 * scale
  else:
    out.xz := c0 * scale
    out.yz := c1 * scale
    out.zz := c2 * scale
    out.wz := c3 * scale
  return $Some out

// Right-handed (det = +1) planar reflection camera pair `(view, oblique_projection)`
// preserving CCW back-face culling (horizontally mirrored `u' = 1 - u` on mirror sample).
func planar_reflection_camera (view_mat: math.Mat4) -> (projection: math.Mat4) -> (plane_point: Vec3) -> (plane_normal: Vec3) -> (reversed: Bool) : Maybe (math.Mat4, math.Mat4) =>
  let $Some raw = planar_reflection_view view_mat plane_point plane_normal else:
    return $Nothing
  let proper = $math.Mat4 {
    xx: F32.neg raw.xx, xy: raw.xy, xz: raw.xz, xw: raw.xw,
    yx: F32.neg raw.yx, yy: raw.yy, yz: raw.yz, yw: raw.yw,
    zx: F32.neg raw.zx, zy: raw.zy, zz: raw.zz, zw: raw.zw,
    wx: F32.neg raw.wx, wy: raw.wy, wz: raw.wz, ww: raw.ww,
  }
  let $Some obl = oblique_clip_projection projection proper plane_point plane_normal reversed else:
    return $Nothing
  return $Some (proper, obl)

// Viewport partitioning for multi-camera split-screen layouts.
type ViewportRect is data = $ViewportRect { x: F32, y: F32, width: F32, height: F32 }

const split_single: U32 = 0
const split_horizontal_2p: U32 = 1
const split_vertical_2p: U32 = 2
const split_quad_4p: U32 = 3

func viewport_aspect (rect: ViewportRect) : F32 =>
  if not (is_finite rect.width and is_finite rect.height):
    return 1.0
  return max 1.0 rect.width / max 1.0 rect.height

func viewport_normalized (width: F32) -> (height: F32) -> (rect: ViewportRect) : ViewportRect =>
  let w = if is_finite width then max 1.0 width else 1.0
  let h = if is_finite height then max 1.0 height else 1.0
  let inv_w = 1.0 / w
  let inv_h = 1.0 / h
  let rx = if is_finite rect.x then rect.x else 0.0
  let ry = if is_finite rect.y then rect.y else 0.0
  let rw = if is_finite rect.width then rect.width else 0.0
  let rh = if is_finite rect.height then rect.height else 0.0
  return $ViewportRect { x: rx * inv_w, y: ry * inv_h, width: rw * inv_w, height: rh * inv_h }

func split_screen_rects (layout: U32) -> (width: F32) -> (height: F32) -> (divider: F32) : #[ViewportRect] =>
  let w = if is_finite width then max 4.0 width else 4.0
  let h = if is_finite height then max 4.0 height else 4.0
  let div = clamp 0.0 (min w h * 0.49) (if is_finite divider then divider else 0.0)
  if layout == split_horizontal_2p:
    let top_h = floor ((h - div) * 0.5)
    let bot_y = top_h + div
    return #[
      $ViewportRect { x: 0.0, y: 0.0, width: w, height: top_h },
      $ViewportRect { x: 0.0, y: bot_y, width: w, height: h - bot_y },
    ]
  if layout == split_vertical_2p:
    let left_w = floor ((w - div) * 0.5)
    let right_x = left_w + div
    return #[
      $ViewportRect { x: 0.0, y: 0.0, width: left_w, height: h },
      $ViewportRect { x: right_x, y: 0.0, width: w - right_x, height: h },
    ]
  if layout == split_quad_4p:
    let lw = floor ((w - div) * 0.5)
    let rx = lw + div
    let rw = w - rx
    let th = floor ((h - div) * 0.5)
    let by = th + div
    let bh = h - by
    return #[
      $ViewportRect { x: 0.0, y: 0.0, width: lw, height: th },
      $ViewportRect { x: rx, y: 0.0, width: rw, height: th },
      $ViewportRect { x: 0.0, y: by, width: lw, height: bh },
      $ViewportRect { x: rx, y: by, width: rw, height: bh },
    ]
  return #[$ViewportRect { x: 0.0, y: 0.0, width: w, height: h }]
