import { Vec3 } from "std/vector"
import * as app from "./app"
import * as math from "./math"
import * as render from "./render"
import * as time from "./clock"

// A sun and a moon going round, lighting the world through the day: warm
// low sun at dawn and dusk, white at noon, a dim blue moon at night, the sky
// and the shade with them. A `Day` takes `ticks` fixed steps, and the clock's
// first step falls `start` of the way through it, where 0 is sunrise, 0.25
// noon, 0.5 sunset and 0.75 midnight.
type Day is data = $Day { ticks: U32, start: F32, daylight: F32 }

// Authored linear colours; day/twilight values are additions to night.
type Palette is data = $Palette { sun: Vec3, sunset: Vec3, moon: Vec3, ambient_night: Vec3, ambient_day: Vec3, ambient_twilight: Vec3, clear_night: Vec3, clear_day: Vec3, clear_twilight: Vec3 }
const default_palette = $Palette {
  sun: math.vec3 1.15 1.08 0.92,
  sunset: math.vec3 1.15 0.55 0.22,
  moon: math.vec3 0.12 0.19 0.34,
  ambient_night: math.vec3 0.055 0.075 0.13,
  ambient_day: math.vec3 0.24 0.25 0.26,
  ambient_twilight: math.vec3 0.08 0.015 0.0,
  clear_night: math.vec3 0.006 0.012 0.03,
  clear_day: math.vec3 0.19 0.34 0.55,
  clear_twilight: math.vec3 0.2 0.035 (-0.12),
}

// How far through `day` it is at fixed step `tick`, `alpha` of the way to
// the next, 0 to 1.
func phase (day: Day) => func (tick: U32) => func (alpha: F32) =>
  if day.ticks == 0 or not (is_finite day.start and is_finite day.daylight and is_finite alpha):
    return 0.0
  // U32 remainder retains full tick identity before conversion to F32.
  let ticks = U32.to_f32 (U32.rem tick day.ticks)
  let light = clamp 0.001 0.999 day.daylight
  let start = day.start * 2.0 * light
  if day.start >= 0.5:
    start := light + (day.start - 0.5) * 2.0 * (1.0 - light)
  let elapsed = wrap 1.0 ((ticks + alpha) / U32.to_f32 day.ticks + start)
  if elapsed < light:
    return elapsed / light * 0.5
  return 0.5 + (elapsed - light) / (1.0 - light) * 0.5

// The light `phase` of the way through a day. The palette's vectors are
// combined in scalars, in the order of the vector sums they stand for.
func lighting (palette: Palette) => func (phase: F32) =>
  let angle = phase * tau
  let height = sin angle
  let across = cos angle
  let day = smoothstep (-0.18) 0.25 height
  let twilight = 1.0 - smoothstep 0.0 0.3 (abs height)
  let warm = 1.0 - smoothstep 0.0 0.55 height
  let strength = smoothstep 0.0 0.3 (abs height)
  let $Palette { sun, sunset, moon, ambient_night: an, ambient_day: ad, ambient_twilight: at, clear_night: cn, clear_day: cd, clear_twilight: ct } = palette
  // The uniform stores the direction rays travel. At night the moon is on
  // the opposite side of the orbit; both lights fade out at the horizon.
  let direction = $Vec3 { x: across, y: height, z: 0.35 }
  let color = $Vec3 { x: moon.x * strength, y: moon.y * strength, z: moon.z * strength }
  if height >= 0.0:
    direction := $Vec3 { x: -across, y: -height, z: -0.35 }
    color := $Vec3 {
      x: F32.lerp sun.x sunset.x warm * strength,
      y: F32.lerp sun.y sunset.y warm * strength,
      z: F32.lerp sun.z sunset.z warm * strength,
    }
  return $render.Lighting {
    direction, color,
    ambient: $Vec3 { x: an.x + ad.x * day + at.x * twilight, y: an.y + ad.y * day + at.y * twilight, z: an.z + ad.z * day + at.z * twilight },
    clear: math.vec4 (cn.x + cd.x * day + ct.x * twilight) (cn.y + cd.y * day + ct.y * twilight) (cn.z + cd.z * day + ct.z * twilight * day) 1.0,
  }

// Clock and output access are supplied by the statically composed frame stage.
func draw (day: Day) -> (palette: Palette) -> (clock: time.Clock) -> (presentation: app.Presentation) -> (frame: own render.FrameAccess): render.FrameAccess => return
  render.prepare_lighting (lighting palette (phase day clock.tick presentation.alpha)) frame
