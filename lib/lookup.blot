import * as array from "std/array"
import * as sort from "./sort"

// A sorted indirection table: source order and full-width IDs are preserved.
// Duplicate keys select the first source, just like a linear search.
type Keys is data = #Keys { values: Array U32, order: Array U32 }
const build = fn (values: Array U32) => #Keys { values, order: sort.order_u32 values }
const find = fn (keys: Keys) (key: U32) => do:
  let low = 0
  let high = keys.order.length
  for _ in 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if keys.values[keys.order[middle]] < key:
      low := middle + 1
    else:
      high := middle
  if low < keys.order.length:
    let index = keys.order[low]
    if keys.values[index] == key:
      return #Some index
  return #Nothing
