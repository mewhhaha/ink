import * as array from "std/array"
import * as sort from "./sort"

// A sorted indirection table: source order and full-width IDs are preserved.
// Duplicate keys select the first source, just like a linear search.
type Keys [values, order] is data = $Keys { values: values, order: order }
// Both destination owners are independent declarations supplied by the caller.
// Snapshot before replacement permits input to borrow either existing pool.
func build_into values -> (out_values: ResizeArray U32) -> (out_order: ResizeArray U32) => return do:
  let copied: Array U32 = array.map identity values
  let order = sort.order_u32 copied
  @storage.truncate out_values 0
  @storage.truncate out_order 0
  for value in copied:
    @storage.push out_values value
  for index in order:
    @storage.push out_order index
  return $Keys {values: &out_values[0..out_values.length], order: &out_order[0..out_order.length]}
func find (keys: Keys [values, order]) -> (key: U32) : Maybe U32 => return do:
  let low = 0
  let high = keys.order.length
  for _ in 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if keys.values.at (keys.order.at middle) < key:
      low := middle + 1
    else:
      high := middle
  if low < keys.order.length:
    let index = keys.order.at low
    if keys.values.at index == key:
      return $Some index
  return $Nothing
