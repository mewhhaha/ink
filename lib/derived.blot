// A discardable value and the complete dependency key that produced it.
// Callers own revisions, equality, storage and rebuilding. Restores start cold.
type Cache [key, value] is data = #Cold | #Cached { key: key, value: value }
const read = fn equal => fn key => fn cached => case cached of
  #Cached { key: before, value } if equal key before => #Some value
  _ => #Nothing
const keep = fn key => fn value => #Cached { key, value }
const resolve = fn equal => fn build => fn key => fn cached => case read equal key cached of
  #Some value => (cached, value)
  #Nothing => do:
    let value = build key
    return (keep key value, value)
// Revisions are keys only: callers bump them at the operation that owns a change.
// An epoch distinguishes a replacement from an old retained snapshot.
type Revision is data = #Revision { epoch: U32, change: U32 }
const initial = #Revision { epoch: 0, change: 0 }
const bump = fn (revision: Revision) =>
  if revision.change == 0xFFFFFFFF then #Revision { epoch: revision.epoch + 1, change: 0 }
  else #Revision { epoch: revision.epoch, change: revision.change + 1 }
const same_revision = fn (a: Revision) => fn (b: Revision) => a.epoch == b.epoch && a.change == b.change
const same_u32 = fn (a: Array U32) => fn (b: Array U32) => do:
  if a.length != b.length:
    return #False
  for index in 0 .. a.length:
    if a[index] != b[index]:
      return #False
  return #True
