import * as map from "./map"
import * as array from "std/array"

type Set k = map.Map [k, Unit]
type Buckets = map.Buckets
const key = map.key
const u32 = map.u32
const text = map.text
func empty () : Set k => return map.empty ()
const buckets = map.buckets
const count = map.count
const is_empty = map.is_empty
const contains = map.contains
func insert policy -> key -> rows -> slots => return map.set policy key () rows slots
const remove = map.remove
const values = map.keys
func fold reduce -> initial -> rows => return map.fold (func state -> key -> value => return reduce state key) initial rows
func from policy -> values -> rows -> slots => return do:
  if values.length == 0:
    return ()
  insert policy values[0] rows slots
  for index in 1 .. values.length:
    insert policy values[index] rows slots
func union policy -> left -> left_slots -> right => return from policy (values right) left left_slots
func difference policy -> left -> left_slots -> right => return map.remove_many policy (values right) left left_slots
func intersection policy -> left -> left_slots -> right -> right_slots => return do:
  let removed = array.filter (func value => return Bool.not (contains policy value right right_slots)) (values left)
  map.remove_many policy removed left left_slots
func is_subset policy -> left -> right -> right_slots => return fold (func result -> key => return result and contains policy key right right_slots) true left
func equal policy -> left -> left_slots -> right -> right_slots => return count left_slots == count right_slots and is_subset policy left right right_slots
