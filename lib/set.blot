import * as map from "./map"

type Set k is data = #Set { members: map.Map [k, Unit] }
const key = map.key
const u32 = map.u32
const text = map.text
const empty = fn () => #Set { members: map.empty () }
const count = fn (values: Set k) => map.count values.members
const is_empty = fn (values: Set k) => map.is_empty values.members
const contains = fn keys key (values: Set k) => map.contains keys key values.members
const insert = fn keys key (values: Set k) => do:
  if contains keys key values:
    return values
  return #Set { members: map.set keys key () values.members }
const remove = fn keys key (values: Set k) => #Set { members: map.remove keys key values.members }
const fold = fn reduce initial (values: Set k) => map.fold (fn state key value => reduce state key) initial values.members
const values = fn (stored: Set k) => map.keys stored.members
const from = fn keys (values: Array k) => do:
  let result = empty ()
  for key in values:
    result := insert keys key self
  return result
const union = fn keys left right => fold (fn result key => insert keys key result) left right
const intersection = fn keys left right => fold (fn result key =>
  if contains keys key right then insert keys key result else result) (empty ()) left
const difference = fn keys left right => fold (fn result key => remove keys key result) left right
const is_subset = fn keys left right => fold (fn result key => result && contains keys key right) #True left
const equal = fn keys left right => count left == count right && is_subset keys left right
