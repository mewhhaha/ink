//! Caller-owned hash sets backed by [`ink/map/Map`] with explicit key policies.
//!
//! ```blot
//! let s = empty ()
//! s := insert u32 3 self
//! s := insert u32 5 self
//! s := insert u32 3 self
//! count s // => 2
//! ```

import * as map from "./map"
import * as array from "std/array"

type Set k = map.Map [k, Unit]
const key = map.key
const u32 = map.u32
const text = map.text
func empty () : Set k => map.empty ()
const count = map.count
const is_empty = map.is_empty
const contains = map.contains
func insert policy -> key -> (table: own Set k) : Set k => map.set policy key () table
const remove = map.remove
const values = map.keys
func fold reduce -> initial -> (table: Set k) => map.fold (func state -> key -> value => reduce state key) initial table
func from policy -> values -> (table: own Set k) : Set k =>
  if values.length == 0:
    return table
  table := map.reserve_batch values.length table
  table := insert policy values[0] table
  for index in 1 .. values.length:
    table := insert policy values[index] table
  return table
func union policy -> (left: own Set k) -> (right: Set k) : Set k =>
  let rows = right.rows
  for row in rows:
    if let $Some (k, _) = row.item:
      left := insert policy k left
  return left
func difference policy -> (left: own Set k) -> (right: Set k) : Set k =>
  let rows = right.rows
  for row in rows:
    if let $Some (k, _) = row.item:
      left := remove policy k left
  return left
func intersection policy -> (left: own Set k) -> (right: Set k) : Set k =>
  let removed = false
  for i in 0 .. left.rows.length:
    if let $Some (k, _) = left.rows[i].item:
      if not (contains policy k right):
        left.rows[i].item := $Nothing
        removed := true
  if removed:
    return map.rehash (left.buckets.length - 2) left
  return left
func is_subset policy -> (left: Set k) -> (right: Set k) =>
  if count left > count right:
    return false
  for row in left.rows:
    if let $Some (key, _) = row.item:
      if not (contains policy key right):
        return false
  return true
func equal policy -> (left: Set k) -> (right: Set k) => count left == count right and is_subset policy left right
