import * as ui from "../ui"
import * as events from "../events"
import * as keys from "../input/keys"

// Behavior is separate from appearance and simulation. A modal owns input;
// a dialog/popover light-dismisses on an outside primary press. Applications
// may still allow selected background controls or camera gestures explicitly.
type Policy is data = #Policy { modal: Bool, outside: Bool, escape: Bool, secondary: Bool }
const dialog = #Policy { modal: #False, outside: #True, escape: #True, secondary: #True }
const popover = dialog
const modal = #Policy { modal: #True, outside: #False, escape: #True, secondary: #False }
type Response is data = #Pass | #Handle | #Dismiss
const dismisses = fn (response: Response) => case response of
  #Dismiss => #True
  _ => #False
const contains = fn (rect: ui.Rect) (x: F32) (y: F32) =>
  rect.width > 0.0 && rect.height > 0.0 && x >= rect.x && y >= rect.y && x < rect.x + rect.width && y < rect.y + rect.height
const camera_gesture = fn (secondary_held: Bool) (event: events.Event) => case event of
  #events.PointerDown { button } => button == 2
  #events.PointerUp { button } => button == 2
  #events.PointerMove {} => secondary_held
  #events.MouseMotion {} => secondary_held
  _ => #False
const respond = fn (policy: Policy) (rect: ui.Rect) (secondary_held: Bool) (event: events.Event) => do:
  if policy.secondary && camera_gesture secondary_held event:
    return #Pass
  return case event of
    #events.KeyDown code if code == keys.escape && policy.escape => #Dismiss
    #events.PointerDown { button, x, y } =>
      if policy.outside && button == 0 && Bool.not (contains rect x y) then #Dismiss else #Handle
    #events.PointerUp {} => #Handle
    #events.PointerMove { x, y } => if policy.modal || contains rect x y then #Handle else #Pass
    #events.Wheel { x, y } => if policy.modal || contains rect x y then #Handle else #Pass
    #events.KeyDown _ => if policy.modal then #Handle else #Pass
    #events.KeyUp _ => if policy.modal then #Handle else #Pass
    #events.TextInput {} => if policy.modal then #Handle else #Pass
    #events.Composition {} => if policy.modal then #Handle else #Pass
    #events.UiAction {} => if policy.modal then #Handle else #Pass
    #events.MouseMotion {} => if policy.modal then #Handle else #Pass
    #events.GamepadButton {} => if policy.modal then #Handle else #Pass
    #events.GamepadAxis {} => if policy.modal then #Handle else #Pass
    #events.Action {} => if policy.modal then #Handle else #Pass
    #events.Touch {} => if policy.modal then #Handle else #Pass
    #events.Pan {} => if policy.modal then #Handle else #Pass
    #events.Pinch {} => if policy.modal then #Handle else #Pass
    _ => #Pass

// Use the same bounds as drawing when deciding whether a foreground panel
// occludes a background pointer action. Semantic actions keep their own target.
const pointer_inside = fn (rect: ui.Rect) (event: events.Event) => case event of
  #events.PointerDown { x, y } => contains rect x y
  #events.PointerUp { x, y } => contains rect x y
  #events.PointerMove { x, y } => contains rect x y
  #events.Wheel { x, y } => contains rect x y
  _ => #False
