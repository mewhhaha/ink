import { Vec2, Vec3 } from "std/vector"
import * as math from "../math"

// A camera-facing plane in caller units, +X right and +Y down. The caller
// chooses its world origin, camera rotation and world units per logical pixel.
type Plane is data = #Plane { origin: Vec3, rotation: math.Quat, unit: F32 }
type Curve is data = #Curve { a: Vec2, b: Vec2, c: Vec2, d: Vec2 }

const point = fn (plane: Plane) => fn (x: F32) => fn (y: F32) =>
  plane.origin + math.Quat.rotate plane.rotation (math.vec3 x (F32.neg y) 0.0) * plane.unit

const coordinates = fn (plane: Plane) => fn (world: Vec3) => do:
  let delta = world - plane.origin
  let right = math.Quat.rotate plane.rotation math.right
  let up = math.Quat.rotate plane.rotation math.up
  return math.vec2 (delta.dot right / plane.unit) ((F32.neg (delta.dot up)) / plane.unit)

// Geometry uses the plane's +Y down convention too; UVs remain unmodified.
const matrix = fn (plane: Plane) => fn (x: F32) => fn (y: F32) => fn (radius: F32) =>
  math.Mat4.compose (point plane x y) plane.rotation (math.vec3 (radius * plane.unit) (F32.neg (radius * plane.unit)) plane.unit)

const at = fn (curve: Curve) => fn (t: F32) => do:
  let u = 1.0 - t
  return curve.a * (u*u*u) + curve.b * (3.0*u*u*t) + curve.c * (3.0*u*t*t) + curve.d * (t*t*t)

// Four shader vectors, with xy in plane coordinates. Retain the curve and
// replace its controls as nodes move; no sampled segment storage is needed.
const controls = fn (curve: Curve) => #[
  math.vec4 curve.a.x curve.a.y 0.0 0.0,
  math.vec4 curve.b.x curve.b.y 0.0 0.0,
  math.vec4 curve.c.x curve.c.y 0.0 0.0,
  math.vec4 curve.d.x curve.d.y 0.0 0.0,
]
