import { Vec2, Vec3 } from "std/vector"
import * as math from "../math"

// A camera-facing plane in caller units, +X right and +Y down. The caller
// chooses its world origin, camera rotation and world units per logical pixel.
type Plane is data = $Plane { origin: Vec3, rotation: math.Quat, unit: F32 }
type Curve is data = $Curve { a: Vec2, b: Vec2, c: Vec2, d: Vec2 }

func point (plane: Plane) => return func (x: F32) => return func (y: F32) => return do:
  let q = plane.rotation
  let (tx, ty, tz) = math.rotate_parts q.x q.y q.z q.w x (F32.neg y) 0.0
  let unit = plane.unit
  return $Vec3 { x: plane.origin.x + tx * unit, y: plane.origin.y + ty * unit, z: plane.origin.z + tz * unit }

func coordinates (plane: Plane) => return func (world: Vec3) => return do:
  let dx = world.x - plane.origin.x
  let dy = world.y - plane.origin.y
  let dz = world.z - plane.origin.z
  let q = plane.rotation
  let (rx, ry, rz) = math.rotate_parts q.x q.y q.z q.w 1.0 0.0 0.0
  let (ux, uy, uz) = math.rotate_parts q.x q.y q.z q.w 0.0 1.0 0.0
  let across = dx * rx + dy * ry + dz * rz
  let down = dx * ux + dy * uy + dz * uz
  return $Vec2 { x: across / plane.unit, y: (F32.neg down) / plane.unit }

// Geometry uses the plane's +Y down convention too; UVs remain unmodified.
func matrix (plane: Plane) => return func (x: F32) => return func (y: F32) => return func (radius: F32) => return
  math.Mat4.compose (point plane x y) plane.rotation (math.vec3 (radius * plane.unit) (F32.neg (radius * plane.unit)) plane.unit)

func at (curve: Curve) => return func (t: F32) => return do:
  let u = 1.0 - t
  return curve.a * (u*u*u) + curve.b * (3.0*u*u*t) + curve.c * (3.0*u*t*t) + curve.d * (t*t*t)

// Four shader vectors, with xy in plane coordinates. Retain the curve and
// replace its controls as nodes move; no sampled segment storage is needed.
func controls (curve: Curve) => return #[
  math.vec4 curve.a.x curve.a.y 0.0 0.0,
  math.vec4 curve.b.x curve.b.y 0.0 0.0,
  math.vec4 curve.c.x curve.c.y 0.0 0.0,
  math.vec4 curve.d.x curve.d.y 0.0 0.0,
]
