import * as array from "std/array"
import * as text from "../text"

// Headless history and completion. The application supplies vocabulary,
// tokenization, command execution, key bindings, limits and presentation.
type Choice is data = #Choice { value: Array U32, about: Array U32 }
type Entry is data = #Entry { name: Array U32, about: Array U32, options: Array Choice, argument: Bool }
type Suggestion is data = #Suggestion { text: Array U32, label: Array U32, matched: U32, about: Array U32, ready: Bool }
const sorted = fn (entries: Array Entry) => do:
  let out: Array Entry = #[]
  for entry in entries:
    let at = out.length
    for i in 0 .. out.length:
      if at == out.length && text.before entry.name out[i].name:
        at := i
    out := array.flatten #[array.slice 0 at self, #[entry], array.slice at (self.length - at) self]
  return out
// Prefix and separator are explicit (for example '/', ' ', or an empty prefix
// for a command palette). The caller explicitly marks commands needing an
// argument, including free-form arguments with no enumerated choices.
const named = fn (prefix: Array U32) (separator: Array U32) (entries: Array Entry) (typed: Array U32) => #[
  #Suggestion { text: array.flatten #[prefix, entry.name, if entry.argument then separator else #[]],
    label: array.concat prefix entry.name, matched: prefix.length + typed.length,
    about: entry.about, ready: Bool.not entry.argument }
  | entry <- entries, text.starts typed entry.name
]
const valued = fn (prefix: Array U32) (separator: Array U32) (entries: Array Entry) (name: Array U32) (typed: Array U32) => do:
  for entry in entries:
    if text.same entry.name name:
      return #[#Suggestion { text: array.flatten #[prefix, name, separator, choice.value], label: choice.value,
        matched: typed.length, about: choice.about, ready: #True }
        | choice <- entry.options, text.starts typed choice.value]
  return #[]

type Browse is data = #Browse { place: U32, draft: Array U32 }
const fresh = #Browse { place: 0, draft: #[] }
const recall = fn (back: Bool) (current: Array U32) (lines: Array (Array U32)) (browse: Browse) => do:
  let count = lines.length
  let place = min browse.place count
  let draft = if place == 0 then current else browse.draft
  let next = if place == 0 then if back then count else 0
    else if back then max 1 (place - 1)
    else if place < count then place + 1 else 0
  return (#Browse { place: next, draft }, if next == 0 then draft else lines[next - 1])
// Persistence can keep an ordinary chronological array; no library codec or
// resource ID is imposed. Adjacent duplicate commands are omitted.
const remember = fn (limit: U32) (max_length: U32) (line: Array U32) (lines: Array (Array U32)) => do:
  if limit == 0:
    return #[]
  let line = array.slice 0 (min line.length max_length) line
  if lines.length > 0 && text.same lines[lines.length - 1] line:
    return array.slice (lines.length - min limit lines.length) (min limit lines.length) lines
  let kept = array.push line lines
  return array.slice (kept.length - min limit kept.length) (min limit kept.length) kept
