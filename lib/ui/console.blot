import * as array from "std/array"

// Invocation-only catalog views. Persist catalog/history text as scalar spans
// into separately owned codepoint pools, then bind views when calling this API.
type Choice is data = $Choice {value: &[U32], about: &[U32]}
type Entry is data = $Entry {name: &[U32], about: &[U32], options: &[Choice], argument: Bool}
type Span is data = $Span {start: U32, count: U32}
type Suggestion is data = $Suggestion {text: Span, label: Span, about: Span, matched: U32, ready: Bool}
func starts prefix -> value : Bool =>
  let prefix_length: U32 = prefix.length
  let value_length: U32 = value.length
  if prefix_length > value_length:
    return false
  for index in 0 .. prefix_length:
    let expected: U32 = array.at index prefix
    let actual: U32 = array.at index value
    if expected != actual:
      return false
  return true
func same_text left -> right => left.length == right.length and starts left right
func before left -> right : Bool =>
  let left_length: U32 = left.length
  let right_length: U32 = right.length
  for index in 0 .. min left_length right_length:
    let first: U32 = array.at index left
    let second: U32 = array.at index right
    if first != second:
      return first < second
  return left_length < right_length
func sorted (entries: &[Entry]) : #[Entry] =>
  let order: #[U32] = array.generate entries.length identity
  for index in 1 .. order.length:
    let saved = order[index]
    let at = index
    for _ in 0 .. index:
      if at == 0 or not (before entries[saved].name entries[order[at - 1]].name):
        break
      order[at] := order[at - 1]
      at := self - 1
    order[at] := saved
  return array.generate order.length (func index : Entry => entries[order[index]])
func append values -> (payload: #[~U32]) =>
  let start = payload.length
  for index in 0 .. values.length:
    @storage.push payload (array.at index values)
  return $Span {start, count: values.length}
func range (payload: #[~U32]) -> (span: Span) =>
  if span.start > payload.length or span.count > payload.length - span.start:
    return panic "console text span is outside its pool"
  return &payload[span.start..span.start + span.count]
// The application clears output/payload only after encoding the suggestions.
func named prefix -> separator -> (entries: &[Entry]) -> typed -> (payload: #[~U32]) -> (output: #[~Suggestion]) =>
  for entry in entries:
    if starts typed entry.name:
      let start = payload.length
      append prefix payload
      append entry.name payload
      let label = $Span {start, count: payload.length - start}
      if entry.argument:
        append separator payload
      let text = $Span {start, count: payload.length - start}
      let about = append entry.about payload
      @storage.push output $Suggestion {text, label, about, matched: prefix.length + typed.length, ready: not entry.argument}
  return ()
func valued prefix -> separator -> (entries: &[Entry]) -> name -> typed -> (payload: #[~U32]) -> (output: #[~Suggestion]) =>
  for entry in entries:
    if same_text entry.name name:
      for choice in entry.options:
        if starts typed choice.value:
          let start = payload.length
          append prefix payload
          append name payload
          append separator payload
          let label = append choice.value payload
          let text = $Span {start, count: payload.length - start}
          let about = append choice.about payload
          @storage.push output $Suggestion {text, label, about, matched: typed.length, ready: true}
      return ()
  return ()
// Persistent history and browse state contain only scalar spans. The payload
// pool is separate; descriptors do not preserve old history or draft snapshots.
type Browse is data = $Browse {place: U32, draft: Span}
const fresh = $Browse {place: 0, draft: $Span {start: 0, count: 0}}
func recall (back: Bool) -> current -> (lines: #[~Span]) -> (payload: #[~U32]) -> (state: own #[Browse]) =>
  let browse = state[0]
  let count = lines.length
  let place = min browse.place count
  let draft = if place == 0 then append current payload else browse.draft
  let next = if place == 0 then if back then count else 0
    else if back then max 1 (place - 1)
    else if place < count then place + 1 else 0
  state[0] := $Browse {place: next, draft}
  return (range payload (if next == 0 then draft else lines[next - 1]), state)
func remember (limit: U32) -> (max_length: U32) -> line -> (lines: #[~Span]) -> (payload: #[~U32]) =>
  if limit == 0:
    @storage.truncate lines 0
    return ()
  let count = min line.length max_length
  let duplicate = false
  if lines.length > 0:
    let previous = range payload lines[lines.length - 1]
    duplicate := previous.length == count
    for index in 0 .. min previous.length count:
      duplicate := self and previous[index] == array.at index line
  if not duplicate:
    let start = payload.length
    for index in 0 .. count:
      @storage.push payload (array.at index line)
    @storage.push lines $Span {start, count}
  let keep = min limit lines.length
  let first = lines.length - keep
  if first > 0:
    let kept: #[Span] = array.generate keep (func index => lines[first + index])
    @storage.truncate lines 0
    for span in kept:
      @storage.push lines span
  return ()
// Explicit payload compaction after all borrowed history/draft views end.
func compact (lines: #[~Span]) -> (payload: #[~U32]) -> (state: own #[Browse]) : #[Browse] =>
  let source = copy payload
  for span in lines:
    if span.start > source.length or span.count > source.length - span.start:
      return panic "console history span is outside its pool"
  let draft = state[0].draft
  if draft.start > source.length or draft.count > source.length - draft.start:
    return panic "console draft span is outside its pool"
  @storage.truncate payload 0
  let compacted: #[+Span] = #[]
  for index in 0 .. lines.length:
    let span = lines[index]
    let start = payload.length
    for i in 0 .. span.count:
      @storage.push payload source[span.start + i]
    @storage.push compacted ($Span {start, count: span.count})
  @storage.truncate lines 0
  for span in compacted:
    @storage.push lines span
  let start = payload.length
  for i in 0 .. draft.count:
    @storage.push payload source[draft.start + i]
  state[0].draft := $Span {start, count: draft.count}
  return state
