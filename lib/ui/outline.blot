import { Vec2 } from "std/vector"
import * as math from "../math"
import { Rect } from "../ui"

// Clockwise rounded rectangle, starting at the top-left horizontal tangent.
// A zero radius is a square corner. Zero width and height give a single point.
type Rounded is data = #Rounded { box: Rect, radius: F32 }
const rounded = fn (box: Rect) (radius: F32) => do:
  if Bool.not (is_finite box.x && is_finite box.y && is_finite box.width && is_finite box.height && is_finite radius) || box.width < 0.0 || box.height < 0.0:
    return @panic "outline requires a finite nonnegative rectangle"
  return #Rounded { box, radius: clamp 0.0 (min box.width box.height * 0.5) radius }
const length = fn (outline: Rounded) =>
  2.0 * (outline.box.width + outline.box.height - 4.0 * outline.radius) + tau * outline.radius
// Input lies on the outline. The two representations of its seam may return
// 0 or length; wrap the result for a canonical distance.
const distance = fn (outline: Rounded) (at: Vec2) => do:
  let box = outline.box
  let r = outline.radius
  let x = at.x - box.x
  let y = at.y - box.y
  let h = box.width - 2.0 * r
  let v = box.height - 2.0 * r
  let q = r * pi * 0.5
  if y <= r:
    if x < r:
      return 2.0 * h + 2.0 * v + 3.0 * q + math.atan2 (r - y) (r - x) * r
    if x > box.width - r:
      return h + math.atan2 (x - box.width + r) (r - y) * r
    return x - r
  if y >= box.height - r:
    if x > box.width - r:
      return h + v + q + math.atan2 (y - box.height + r) (x - box.width + r) * r
    if x < r:
      return 2.0 * h + v + 2.0 * q + math.atan2 (r - x) (y - box.height + r) * r
    return h + v + 2.0 * q + box.width - r - x
  if x > box.width * 0.5:
    return h + q + y - r
  return 2.0 * h + v + 3.0 * q + box.height - r - y
const point = fn (outline: Rounded) (distance: F32) => do:
  if Bool.not (is_finite distance):
    return @panic "outline distance must be finite"
  let box = outline.box
  let r = outline.radius
  let h = box.width - 2.0 * r
  let v = box.height - 2.0 * r
  let q = r * pi * 0.5
  let total = length outline
  if total == 0.0:
    return math.vec2 box.x box.y
  let t = wrap total distance
  let placed = fn (x: F32) (y: F32) => math.vec2 (box.x + x) (box.y + y)
  if t < h:
    return placed (r + t) 0.0
  if t < h + q:
    let a = (t - h) / r
    return placed (box.width - r + sin a * r) (r - cos a * r)
  if t < h + q + v:
    return placed box.width (r + t - h - q)
  if t < h + 2.0 * q + v:
    let a = (t - h - q - v) / r
    return placed (box.width - r + cos a * r) (box.height - r + sin a * r)
  if t < 2.0 * h + 2.0 * q + v:
    return placed (box.width - r - (t - h - 2.0 * q - v)) box.height
  if t < 2.0 * h + 3.0 * q + v:
    let a = (t - 2.0 * h - 2.0 * q - v) / r
    return placed (r - sin a * r) (box.height - r + cos a * r)
  if t < 2.0 * h + 3.0 * q + 2.0 * v:
    return placed 0.0 (box.height - r - (t - 2.0 * h - 3.0 * q - v))
  let a = (t - 2.0 * h - 3.0 * q - 2.0 * v) / r
  return placed (r - cos a * r) (r - sin a * r)
