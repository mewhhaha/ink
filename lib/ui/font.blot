// Caller-owned glyph atlas and metrics. Distances are ems, measured from the
// baseline; top is negative above it. Atlas coordinates are normalized.
type Glyph is data = #Glyph { u0: F32, v0: F32, u1: F32, v1: F32, left: F32, top: F32, width: F32, height: F32, advance: F32 }
type Font is data = #Font { material: U32, glyph: U32 -> Glyph, ascent: F32, descent: F32, spread: F32 }
