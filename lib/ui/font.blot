// Caller-owned sorted glyph table; fonts contain data and borrowed atlas rows.
// Compile-known generators build this table before publication, never callbacks
// stored in a Font or an array of styles.
type Glyph is data = $Glyph { u0: F32, v0: F32, u1: F32, v1: F32, left: F32, top: F32, width: F32, height: F32, advance: F32 }
type Entry is data = $Entry { code: U32, glyph: Glyph }
type Font is data = $Font { material: U32, glyphs: &[Entry], fallback: Glyph, ascent: F32, descent: F32, spread: F32 }
const glyph = func (face: Font) -> (code: U32) => return do:
  let low = 0
  let high = face.glyphs.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if face.glyphs[middle].code < code:
      low := middle + 1
    else:
      high := middle
  return if low < face.glyphs.length and face.glyphs[low].code == code then face.glyphs[low].glyph else face.fallback
