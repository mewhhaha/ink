//! Headless accessible atomic and grouped controls with zero rendering coupling:
//! - Tri-state Checkbox (unchecked / checked / mixed + select-all aggregator)
//! - Switch and ToggleButton
//! - RadioGroup (roving arrow/Home/End navigation, skips disabled items, RTL-aware)
//! - Spinbutton (step, large PageUp/PageDown step, Home/End clamping)
//! - Progressbar (determinate and indeterminate)
//!
//! Key items: [`Checkbox`], [`Switch`], [`ToggleButton`], [`RadioItem`], [`make_checkbox`].

import * as keys from "../../input/keys"
import * as window from "../../events"
import * as ui from "../../ui"
import * as tree from "../tree"
import * as vocabulary from "../vocabulary"

const check_unchecked: U32 = vocabulary.state_false
const check_checked: U32 = vocabulary.state_true
const check_mixed: U32 = vocabulary.state_mixed

// ── Tri-State Checkbox ───────────────────────────────────────────────────────

type Checkbox is data = $Checkbox {
  id: U32,
  parent: U32,
  label: tree.Span,
  state: U32,
  disabled: Bool,
}

func make_checkbox (id: U32) -> (parent: U32) -> (label: tree.Span) -> (state: U32) -> (disabled: Bool) : Checkbox =>
  return $Checkbox { id, parent, label, state, disabled }

func checkbox_toggle (box: Checkbox) : Checkbox =>
  if box.disabled:
    return box
  let next = if box.state == check_checked then check_unchecked else check_checked
  return $Checkbox { id: box.id, parent: box.parent, label: box.label, state: next, disabled: box.disabled }

func checkbox_set (state: U32) -> (box: Checkbox) : Checkbox =>
  return $Checkbox { id: box.id, parent: box.parent, label: box.label, state, disabled: box.disabled }

// Derive a parent select-all checkbox state from a flat array of child checkboxes.
func checkbox_aggregate (children: &[Checkbox]) : U32 =>
  if children.length == 0:
    return check_unchecked
  let any_checked = false
  let any_unchecked = false
  for i in 0 .. children.length:
    let st = children[i].state
    if st == check_mixed:
      return check_mixed
    if st == check_checked:
      any_checked := true
    else:
      any_unchecked := true
  if any_checked and any_unchecked:
    return check_mixed
  if any_checked:
    return check_checked
  return check_unchecked

func checkbox_handle (box: Checkbox) -> (rect: ui.Rect) -> (focused: Bool) -> (event: window.Event) : (Checkbox, Bool) =>
  if box.disabled:
    return (box, false)
  return case event of
    $window.UiAction { node, action } if node == box.id and action == vocabulary.action_activate =>
      (checkbox_toggle box, true)
    $window.KeyDown code if focused and (code == keys.space or code == keys.enter) =>
      (checkbox_toggle box, true)
    $window.PointerDown { button: 0, x, y } if ui.inside rect x y =>
      (checkbox_toggle box, true)
    _ => (box, false)

func checkbox_declare (box: Checkbox) -> (rect: ui.Rect) -> (source_labels: &[U32]) -> (labels: own #[U32]) -> (nodes: own #[tree.StoredNode]) : (#[U32], #[tree.StoredNode]) =>
  let name = tree.text source_labels box.label
  let made = ui.built vocabulary.role_checkbox box.id box.parent name rect true ui.pressable
  made.checked := box.state
  made.disabled := box.disabled
  return tree.declare_owned made labels nodes

// ── Switch & ToggleButton ────────────────────────────────────────────────────

type Switch is data = $Switch {
  id: U32,
  parent: U32,
  label: tree.Span,
  on: Bool,
  disabled: Bool,
}

func switch_toggle (sw: Switch) : Switch =>
  if sw.disabled:
    return sw
  return $Switch { id: sw.id, parent: sw.parent, label: sw.label, on: not sw.on, disabled: sw.disabled }

func switch_handle (sw: Switch) -> (rect: ui.Rect) -> (focused: Bool) -> (event: window.Event) : (Switch, Bool) =>
  if sw.disabled:
    return (sw, false)
  return case event of
    $window.UiAction { node, action } if node == sw.id and action == vocabulary.action_activate =>
      (switch_toggle sw, true)
    $window.KeyDown code if focused and (code == keys.space or code == keys.enter) =>
      (switch_toggle sw, true)
    $window.PointerDown { button: 0, x, y } if ui.inside rect x y =>
      (switch_toggle sw, true)
    _ => (sw, false)

func switch_declare (sw: Switch) -> (rect: ui.Rect) -> (source_labels: &[U32]) -> (labels: own #[U32]) -> (nodes: own #[tree.StoredNode]) : (#[U32], #[tree.StoredNode]) =>
  let name = tree.text source_labels sw.label
  let made = ui.disabled_when sw.disabled (ui.switch_node sw.id sw.parent name sw.on rect)
  return tree.declare_owned made labels nodes

type ToggleButton is data = $ToggleButton {
  id: U32,
  parent: U32,
  label: tree.Span,
  pressed: Bool,
  disabled: Bool,
}

func toggle_flip (tb: ToggleButton) : ToggleButton =>
  if tb.disabled:
    return tb
  return $ToggleButton { id: tb.id, parent: tb.parent, label: tb.label, pressed: not tb.pressed, disabled: tb.disabled }

func toggle_handle (tb: ToggleButton) -> (rect: ui.Rect) -> (focused: Bool) -> (event: window.Event) : (ToggleButton, Bool) =>
  if tb.disabled:
    return (tb, false)
  return case event of
    $window.UiAction { node, action } if node == tb.id and action == vocabulary.action_activate =>
      (toggle_flip tb, true)
    $window.KeyDown code if focused and (code == keys.space or code == keys.enter) =>
      (toggle_flip tb, true)
    $window.PointerDown { button: 0, x, y } if ui.inside rect x y =>
      (toggle_flip tb, true)
    _ => (tb, false)

func toggle_declare (tb: ToggleButton) -> (rect: ui.Rect) -> (source_labels: &[U32]) -> (labels: own #[U32]) -> (nodes: own #[tree.StoredNode]) : (#[U32], #[tree.StoredNode]) =>
  let name = tree.text source_labels tb.label
  let made = ui.disabled_when tb.disabled (ui.toggle_node tb.id tb.parent name tb.pressed rect)
  return tree.declare_owned made labels nodes

// ── RadioGroup ───────────────────────────────────────────────────────────────

type RadioItem is data = $RadioItem {
  id: U32,
  label: tree.Span,
  disabled: Bool,
}

type RadioGroup is data = $RadioGroup {
  id: U32,
  parent: U32,
  label: tree.Span,
  selected: U32,
  horizontal: Bool,
  rtl: Bool,
}

func radio_select (items: &[RadioItem]) -> (group: RadioGroup) -> (index: U32) : (RadioGroup, Bool) =>
  if index >= items.length or items[index].disabled or index == group.selected:
    return (group, false)
  return ($RadioGroup {
    id: group.id, parent: group.parent, label: group.label,
    selected: index, horizontal: group.horizontal, rtl: group.rtl,
  }, true)

func radio_move (items: &[RadioItem]) -> (group: RadioGroup) -> (forward: Bool) : (RadioGroup, Bool) =>
  let count = items.length
  if count == 0:
    return (group, false)
  let current = min group.selected (count - 1)
  for step in 1 .. (count + 1):
    let idx = if forward then (current + step) % count else (current + count - (step % count)) % count
    if not items[idx].disabled:
      return radio_select items group idx
  return (group, false)

func radio_edge (items: &[RadioItem]) -> (group: RadioGroup) -> (last: Bool) : (RadioGroup, Bool) =>
  let count = items.length
  if count == 0:
    return (group, false)
  for offset in 0 .. count:
    let idx = if last then count - 1 - offset else offset
    if not items[idx].disabled:
      return radio_select items group idx
  return (group, false)

func radio_handle (items: &[RadioItem]) -> (rects: &[ui.Rect]) -> (group: RadioGroup) -> (focused: Bool) -> (event: window.Event) : (RadioGroup, Bool) =>
  let count = items.length
  if count == 0:
    return (group, false)
  return case event of
    $window.UiAction { node, action } if action == vocabulary.action_activate or action == vocabulary.action_focus => do:
      for i in 0 .. count:
        if items[i].id == node:
          return radio_select items group i
      break (group, false)
    $window.PointerDown { button: 0, x, y } => do:
      let limit = min count rects.length
      for i in 0 .. limit:
        if ui.inside rects[i] x y:
          return radio_select items group i
      break (group, false)
    $window.KeyDown code if focused => do:
      if code == keys.home:
        return radio_edge items group false
      if code == keys.end:
        return radio_edge items group true
      if code == keys.down:
        return radio_move items group true
      if code == keys.up:
        return radio_move items group false
      if group.horizontal and code == keys.right:
        return radio_move items group (not group.rtl)
      if group.horizontal and code == keys.left:
        return radio_move items group group.rtl
      break (group, false)
    _ => (group, false)

func radio_declare (items: &[RadioItem]) -> (rects: &[ui.Rect]) -> (group_rect: ui.Rect) -> (group: RadioGroup) -> (source_labels: &[U32]) -> (labels: own #[U32]) -> (nodes: own #[tree.StoredNode]) : (#[U32], #[tree.StoredNode]) =>
  let g_name = tree.text source_labels group.label
  let g_node = tree.keyboard_vertical (not group.horizontal) (tree.keyboard_rtl group.rtl (ui.node vocabulary.role_radiogroup group.id group.parent g_name group_rect))
  let (labels, nodes) = tree.declare_owned g_node labels nodes
  let count = min items.length rects.length
  for i in 0 .. count:
    let item = items[i]
    let r_name = tree.text source_labels item.label
    let r_node = ui.built vocabulary.role_radio item.id group.id r_name rects[i] (not item.disabled) ui.pressable
    r_node.checked := ui.state (i == group.selected)
    r_node.disabled := item.disabled
    let (next_labels, next_nodes) = tree.declare_owned r_node labels nodes
    labels := next_labels
    nodes := next_nodes
  return (labels, nodes)

// ── Spinbutton ───────────────────────────────────────────────────────────────

type Spinbutton is data = $Spinbutton {
  id: U32,
  parent: U32,
  label: tree.Span,
  value: F32,
  minimum: F32,
  maximum: F32,
  step: F32,
  page_step: F32,
  disabled: Bool,
}

func spin_clamp (spin: Spinbutton) -> (raw: F32) : F32 =>
  if not (is_finite spin.minimum and is_finite spin.maximum) or spin.maximum < spin.minimum:
    return spin.value
  if not (is_finite raw):
    return clamp spin.minimum spin.maximum spin.value
  let bounded = clamp spin.minimum spin.maximum raw
  if bounded == spin.minimum or bounded == spin.maximum:
    return bounded
  if is_finite spin.step and spin.step > 0.0:
    let units = (bounded - spin.minimum) / spin.step
    if is_finite units:
      return clamp spin.minimum spin.maximum (spin.minimum + floor (units + 0.5) * spin.step)
  return bounded

func spin_set (val: F32) -> (spin: Spinbutton) : (Spinbutton, Bool) =>
  if spin.disabled or not (is_finite val):
    return (spin, false)
  let next = spin_clamp spin val
  if next == spin.value:
    return (spin, false)
  return ($Spinbutton {
    id: spin.id, parent: spin.parent, label: spin.label,
    value: next, minimum: spin.minimum, maximum: spin.maximum,
    step: spin.step, page_step: spin.page_step, disabled: spin.disabled,
  }, true)

func spin_handle (spin: Spinbutton) -> (focused: Bool) -> (event: window.Event) : (Spinbutton, Bool) =>
  if spin.disabled:
    return (spin, false)
  let small = if is_finite spin.step and spin.step > 0.0 then spin.step else 1.0
  let large = if is_finite spin.page_step and spin.page_step > 0.0 then spin.page_step else small * 10.0
  return case event of
    $window.UiAction { node, action, value } if node == spin.id => do:
      if action == vocabulary.action_increment:
        return spin_set (spin.value + small) spin
      if action == vocabulary.action_decrement:
        return spin_set (spin.value - small) spin
      if action == vocabulary.action_set_value:
        return spin_set value spin
      break (spin, false)
    $window.KeyDown code if focused => do:
      if code == keys.up or code == keys.right:
        return spin_set (spin.value + small) spin
      if code == keys.down or code == keys.left:
        return spin_set (spin.value - small) spin
      if code == keys.page_up:
        return spin_set (spin.value + large) spin
      if code == keys.page_down:
        return spin_set (spin.value - large) spin
      if code == keys.home:
        return spin_set spin.minimum spin
      if code == keys.end:
        return spin_set spin.maximum spin
      break (spin, false)
    _ => (spin, false)

func spin_declare (spin: Spinbutton) -> (value_text: &[U32]) -> (rect: ui.Rect) -> (source_labels: &[U32]) -> (labels: own #[U32]) -> (nodes: own #[tree.StoredNode]) : (#[U32], #[tree.StoredNode]) =>
  let name = tree.text source_labels spin.label
  let made = ui.disabled_when spin.disabled (ui.spin_node spin.id spin.parent name spin.value spin.minimum spin.maximum spin.step value_text rect)
  return tree.declare_owned made labels nodes

// ── Progressbar ──────────────────────────────────────────────────────────────

type Progressbar is data = $Progressbar {
  id: U32,
  parent: U32,
  label: tree.Span,
  value: F32,
  minimum: F32,
  maximum: F32,
  indeterminate: Bool,
}

func progress_fraction (bar: Progressbar) : F32 =>
  if bar.indeterminate or not (is_finite bar.value and is_finite bar.minimum and is_finite bar.maximum) or bar.maximum <= bar.minimum:
    return 0.0
  return clamp 0.0 1.0 ((bar.value - bar.minimum) / (bar.maximum - bar.minimum))

func progress_declare (bar: Progressbar) -> (value_text: &[U32]) -> (rect: ui.Rect) -> (source_labels: &[U32]) -> (labels: own #[U32]) -> (nodes: own #[tree.StoredNode]) : (#[U32], #[tree.StoredNode]) =>
  let name = tree.text source_labels bar.label
  let made = ui.node vocabulary.role_progressbar bar.id bar.parent name rect
  made.value_text := value_text
  if not bar.indeterminate:
    made.value := bar.value
    made.minimum := bar.minimum
    made.maximum := bar.maximum
  return tree.declare_owned made labels nodes
