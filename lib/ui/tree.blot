import * as array from "std/array"
import * as sort from "../sort"
import * as changes from "../changes"
import * as graph from "../graph"
import * as lookup from "../lookup"
import * as keys from "../input/keys"
import * as lanes from "../lanes"
import * as logic from "../logic"
import * as vocabulary from "./vocabulary"
import * as window from "../events"

// The interface as assistive technology and the keyboard see it: the nodes
// the game declares as it draws each frame (ui builds and declares them),
// and the keyboard focus that moves through them. Callers present nodes
// to their accessibility host through an adapter.
//
// The game drives the focus, in every host alike: while a node has it, Tab
// and Shift+Tab move it through the focusable nodes (of a tab list's tabs,
// only to the chosen one), Up and Down between the rows of a list, menu,
// dialog or page, Left and Right between the tabs or tools of a bar or step
// a slider, and Enter and Space activate the focused node (or step it up). Those keys reach the game as UiAction events on
// the node, the same events assistive technology sends through the host, so
// a system that handles a node's actions handles both. F10 moves the focus
// into the interface and back out; Escape and a click leave it. While a modal
// dialog is open the focus stays in it. A focused text box takes every key
// as it is, for its system to type with, and leaves the focus as that
// system does.

// A node as the game declares it: `id` from a stable key (`key`), `parent`
// its parent's id or 0 at the top, `role` (vocabulary.role_*), its text in
// code points, where it lies on the screen (an empty rectangle for one not
// drawn), its states (`checked`, `expanded` and `selected` in
// vocabulary.state_*, `live` in vocabulary.live_*), a range's value and
// bounds, and the actions it takes (`bit` of each vocabulary.action_*).
// `focused` is the focus's to set (`settle`).
type Node is data = $Node {
  id: U32, parent: U32, role: U32,
  name: &[U32], description: &[U32], value_text: &[U32],
  x: F32, y: F32, width: F32, height: F32,
  focusable: Bool, focused: Bool, disabled: Bool, hidden: Bool, modal: Bool,
  checked: U32, expanded: U32, selected: U32, live: U32,
  value: F32, minimum: F32, maximum: F32, step: F32,
  actions: U32,
}

// This frame's nodes, in the order declared: parents before their children.
// Callers register it as a transient resource and Focus through its codec.
type Tree is data = $Tree {nodes: &[Node]}
func from_nodes (nodes: Array Node) => return $Tree {nodes: &nodes[0..nodes.length]}
const no_text: Array U32 = #[]

// What the keys move through of a node the last frame declared: its id,
// its parent's, its role and the actions it takes. A flat structural record,
// so an array of them packs into consecutive words instead of boxing each.
type Stop = { id: U32, parent: U32, role: U32, actions: U32 }

// The keyboard focus: the focused node's id, or 0 while the game's world has
// the keys; whether Shift is held; the open modal dialog's id (0 for none);
// and the last frame's nodes, those Tab stops at in order, and all the nodes
// the focus can reach. It is saved with the state (not with scenes), the last
// frame's nodes included: a restored moment's keys move through what its
// last frame declared, as they did the first time.
type Return = { scope: U32, node: U32 }
type FocusState is data = $FocusState {node: U32, shift: Bool, modal: U32}
// Access aliases separately named owners. Only FocusState/Stop/Return are stored.
type Focus is data = $Focus {state: Array FocusState, returns: ResizeArray Return,
  nodes: ResizeArray Stop, order: ResizeArray U32, reached: ResizeArray U32}
const unfocused = $FocusState {node: 0, shift: false, modal: 0}
func replace values -> target => return do:
  target.truncate 0
  for index in 0 .. values.length:
    target.push (array.at index values)

// Lanes: the focused node, Shift, the modal dialog, then the last frame's
// nodes (their count, then each one's id, parent, role and actions), those
// Tab stops at (count, then ids) and those the focus reaches (count, ids),
// then return scopes (count and scope/opener pairs), in one exactly sized array.
func encode (held: Focus) => return do:
  let count = held.nodes.length
  let order_at = 4 + count * 4
  let reached_at = order_at + 1 + held.order.length
  let returns_at = reached_at + 1 + held.reached.length
  let written = array.fill (returns_at + 1 + held.returns.length * 2) 0.0
  written[0] = U32.to_f32 held.state[0].node
  written[1] = lanes.bit held.state[0].shift
  written[2] = U32.to_f32 held.state[0].modal
  written[3] = U32.to_f32 count
  for index in 0 .. count:
    let stop = held.nodes[index]
    let at = 4 + index * 4
    written[at] = U32.to_f32 stop.id
    written[at + 1] = U32.to_f32 stop.parent
    written[at + 2] = U32.to_f32 stop.role
    written[at + 3] = U32.to_f32 stop.actions
  written[order_at] = U32.to_f32 held.order.length
  for index in 0 .. held.order.length:
    written[order_at + 1 + index] = U32.to_f32 held.order[index]
  written[reached_at] = U32.to_f32 held.reached.length
  for index in 0 .. held.reached.length:
    written[reached_at + 1 + index] = U32.to_f32 held.reached[index]
  written[returns_at] = from held.returns.length
  for index in 0 .. held.returns.length:
    written[returns_at + 1 + index * 2] = from held.returns[index].scope
    written[returns_at + 2 + index * 2] = from held.returns[index].node
  return written

func whole (value: F32) => return lanes.integer value lanes.max_integer

func decode_into (values: Array F32) -> (held: Focus) => return do:
  use lanes.require (values.length >= 4)
  let count = whole values[3]
  let order_at = 4 + count * 4
  use lanes.require (order_at < values.length)
  let order_count = lanes.integer values[order_at] count
  let reached_at = order_at + 1 + order_count
  use lanes.require (reached_at < values.length)
  let reached_count = lanes.integer values[reached_at] count
  let returns_at = reached_at + 1 + reached_count
  use lanes.require (returns_at < values.length)
  let returns_count = lanes.integer values[returns_at] 32
  use lanes.exact values (returns_at + 1 + returns_count * 2)
  let returns = array.generate returns_count $ func index => return do:
    let scope = whole values[returns_at + 1 + index * 2]
    use lanes.require (scope != 0)
    for before in 0 .. index:
      use lanes.require (scope != whole values[returns_at + 1 + before * 2])
    return { scope, node: whole values[returns_at + 2 + index * 2] }
  let nodes = array.generate count (func index => return do:
    let start = 4 + index * 4
    return { id: whole values[start], parent: whole values[start + 1], role: whole values[start + 2], actions: whole values[start + 3] })
  let order = array.map whole (lanes.record values (order_at + 1) order_count)
  let reached = array.map whole (lanes.record values (reached_at + 1) reached_count)
  let state = $FocusState {node: whole values[0], shift: lanes.flag values[1], modal: whole values[2]}
  replace returns held.returns
  replace nodes held.nodes
  replace order held.order
  replace reached held.reached
  held.state[0] = state

func migrate (version: U32) -> (values: Array F32) : Maybe (Array F32) => return
  if version == 1 then $Some (array.concat values #[0.0]) else $Nothing
const schema_key = 15
const schema_version = 2

// A node's id from a stable key: a `scope` (1 to 255, one for each system
// that declares nodes) and a `local` key within it (below 65536), such as a
// row's place in a fixed menu or an entity's index; never the order nodes
// happen to be drawn in.
func key (scope: U32) => return func (local: U32) => return (scope % 256) * 65536 + local % 65536

// The bit of `action` in a node's `actions`.
func bit (action: U32) => return do:
  if action >= 32:
    return 0
  return 1 << action

func takes (node: Stop) => return func (action: U32) => return (node.actions & bit action) != 0

// Adds `node` to this frame's interface.
func declare (node: Node) -> (nodes: ResizeArray Node) => return nodes.push node
func declare_many values -> (nodes: ResizeArray Node) => return do:
  for node in values:
    nodes.push node

// Moves the keyboard focus to node `id`, or with 0 out of the interface: a
// system whose own focus moved (a menu's row followed the pointer) keeps the
// interface's with it.
func focus (id: U32) -> (held: Focus) => return do:
  if held.state[0].node == id:
    return ()
  held.state[0].node = id
  return ()

// Dialog lifetimes remember their opener. Re-entering a scope does not
// overwrite it; closing an outer scope also retires its nested scopes.
func enter (scope: U32) -> (first: U32) -> (held: Focus) => return do:
  for item in held.returns:
    if item.scope == scope:
      return ()
  use lanes.require (scope != 0 and held.returns.length < 32)
  held.returns.push {scope, node: held.state[0].node}
  held.state[0].node = first
  return ()
func leave (scope: U32) -> (held: Focus) => return do:
  for index in 0 .. held.returns.length:
    if held.returns[index].scope == scope:
      held.state[0].node = held.returns[index].node
      held.returns.truncate index
      return ()
  return ()

// Whether node `id` has the keyboard focus.
func focused (id: U32) -> (held: Focus) => return do:
  return id != 0 and held.state[0].node == id

func place nodes => return func (id: U32) => return do:
  for index in 0 .. nodes.length:
    if (array.at index nodes).id == id:
      return $Some index
  return $Nothing

func declared (nodes: &[Node]) => return func (id: U32) => return do:
  for index in 0 .. nodes.length:
    if nodes[index].id == id:
      return $Some index
  return $Nothing

// Whether `node` is `scope` or inside it.
func within (nodes: &[Node]) => return func (scope: U32) => return func (node: Node) => return do:
  let at = node
  for 0 .. 64:
    if at.id == scope:
      return true
    let $Some above = declared nodes at.parent else:
      return false
    at := nodes[above]
  return false

// Visibility and availability are inherited from ancestors.
func available (nodes: &[Node]) => return func (node: Node) => return do:
  let at = node
  for 0 .. 64:
    if at.hidden or at.disabled:
      return false
    if at.parent == 0:
      return true
    let $Some above = declared nodes at.parent else:
      return false
    at := nodes[above]
  return false

// Resolve each parent once. Stable ordering retains the first declaration
// when ids repeat, including id 0; `within` may follow that node.
func parents_of (nodes: &[Node]) => return do:
  // Avoid sorting overhead for small interfaces; the scan is bounded here.
  if nodes.length <= 16:
    return array.generate nodes.length (func index => return case declared nodes nodes[index].parent of
      $Some above => above
      $Nothing => nodes.length)
  let keys = array.map (func (node: Node) => return node.id) nodes
  let ordered = sort.order_u32 keys
  return array.generate nodes.length (func index => return do:
    let id = nodes[index].parent
    let low = 0
    let high = ordered.length
    for 0 .. 32:
      if low >= high:
        break
      let middle = low + (high - low) / 2
      if keys[ordered[middle]] < id:
        low := middle + 1
      else:
        high := middle
    if low < ordered.length and keys[ordered[low]] == id:
      return ordered[low]
    return nodes.length)

func available_at (nodes: &[Node]) => return func parents => return func (index: U32) => return do:
  let at = index
  for 0 .. 64:
    let node = nodes[at]
    if node.hidden or node.disabled:
      return false
    if node.parent == 0:
      return true
    let above = (array.at at parents)
    if above == nodes.length:
      return false
    at := above
  return false

func hidden_at (nodes: &[Node]) -> parents -> (index: U32) => return do:
  let at = index
  for 0 .. 64:
    if nodes[at].hidden:
      return true
    if nodes[at].parent == 0:
      return false
    at := (array.at at parents)
    if at == nodes.length:
      return true
  return true

func within_at (nodes: &[Node]) => return func parents => return func (scope: U32) => return func (index: U32) => return do:
  let at = index
  for 0 .. 64:
    if nodes[at].id == scope:
      return true
    let above = (array.at at parents)
    if above == nodes.length:
      return false
    at := above
  return false

// Whether Tab stops at `node`: of a tab list's tabs, only at the chosen one;
// the arrows move between them.
func stop (node: Node) => return node.role != vocabulary.role_tab or node.selected != vocabulary.state_false

func same (a: Bool) => return func (b: Bool) => return if a then b else Bool.not b

// `entry` with its focus and hidden marks, built at once.
func mark (entry: Node) => return func (focused: Bool) => return func (hidden: Bool) => return do:
  let $Node { id, parent, role, name, description, value_text, x, y, width, height, focusable, disabled, modal, checked, expanded, selected, live, value, minimum, maximum, step, actions } = entry
  return $Node {
    id, parent, role, name, description, value_text, x, y, width, height,
    focusable, focused, disabled, hidden, modal, checked, expanded, selected, live,
    value, minimum, maximum, step, actions,
  }

// The frame's interface is complete: what the keys will move through next
// frame is kept, a focus on a node that is gone leaves the interface (or,
// with a modal dialog open, goes to its first focusable node), the focused
// node is marked, and with a modal dialog open the rest is hidden from
// assistive technology. Runs after the frame's Render systems (app).
func settle (nodes: &[Node]) -> (held: Focus) -> (output: ResizeArray Node) => return do:
  // Only retire absent top scopes: a modal may intentionally stop rendering
  // the dialog underneath it. Restore missing openers through the stack.
  for 0 .. held.returns.length:
    let last = held.returns[held.returns.length - 1]
    if Maybe.is_some (declared nodes last.scope):
      break
    held.state[0].node = last.node
    held.returns.truncate (held.returns.length - 1)
  let parents = parents_of nodes
  let modal = 0
  for index in 0 .. nodes.length:
    if nodes[index].modal and available_at nodes parents index:
      modal := nodes[index].id
  let inside = array.generate nodes.length (func index => return modal == 0 or within_at nodes parents modal index)
  let reachable = array.generate nodes.length (func index => return do:
    let node = nodes[index]
    return node.id != 0 and node.focusable and inside[index] and available_at nodes parents index)
  // Count, then fill exactly sized id lists.
  let reached_count = 0
  let order_count = 0
  for index in 0 .. nodes.length:
    if reachable[index]:
      reached_count := self + 1
      if stop nodes[index]:
        order_count := self + 1
  let reached = array.fill reached_count 0
  let order = array.fill order_count 0
  let present = false
  let at = 0
  let stop_at = 0
  for index in 0 .. nodes.length:
    if reachable[index]:
      let id = nodes[index].id
      reached[at] = id
      at := self + 1
      if id == held.state[0].node:
        present := true
      if stop nodes[index]:
        order[stop_at] = id
        stop_at := self + 1
  let node = 0
  if present:
    node := held.state[0].node
  else:
    if modal != 0 and order.length > 0:
      node := order[0]
  // Rebuild only the nodes whose marks change.
  let marked = array.generate nodes.length (func index => return do:
    let entry = nodes[index]
    let focused = node != 0 and entry.id == node
    let hidden = hidden_at nodes parents index or Bool.not inside[index]
    if same entry.focused focused and same entry.hidden hidden:
      return entry
    return mark entry focused hidden)
  let stops = array.generate nodes.length (func index => return do:
    let entry = nodes[index]
    return { id: entry.id, parent: entry.parent, role: entry.role, actions: entry.actions })
  replace stops held.nodes
  replace order held.order
  replace reached held.reached
  held.state[0].node = node
  held.state[0].modal = modal
  replace marked output

// The node `step` places along `ids` from `id`, wrapping round; the first
// (or with a negative step, the last) when `id` is not among them.
func along ids => return func (id: U32) => return func (forward: Bool) => return do:
  let count = ids.length
  if count == 0:
    return id
  for index in 0 .. count:
    if (array.at index ids) == id:
      if forward:
        return (array.at ((index + 1) % count) ids)
      return (array.at ((index + count - 1) % count) ids)
  if forward:
    return (array.at 0 ids)
  return (array.at (count - 1) ids)

// The nodes the focus reaches beside `node` in its parent, it among them.
func siblings (held: Focus) => return func (node: Stop) => return
  #[entry.id | entry <- held.nodes, (entry.parent == node.parent and array.any (func id => return id == entry.id) held.reached)]

func horizontal (role: U32) => return
  role == vocabulary.role_tablist or role == vocabulary.role_toolbar or role == vocabulary.role_radiogroup

func vertical (role: U32) => return
  role == vocabulary.role_list or role == vocabulary.role_menu or role == vocabulary.role_dialog or role == vocabulary.role_tabpanel

func act (node: U32) => return func (action: U32) => return $window.UiAction { node, action, value: 0.0 }

// The focus moved to `id` by key.
func moved (held: Focus) => return func (id: U32) => return do:
  held.state[0].node = id
  return act id vocabulary.action_focus

// The focus left the interface by key.
func left (held: Focus) => return do:
  let was = held.state[0].node
  held.state[0].node = 0
  return act was vocabulary.action_blur

// What key `code` does with the focus on `node`: the event the game gets.
func navigate (held: Focus) => return func (node: Stop) => return func (code: U32) => return func (event: window.Event) => return do:
  if node.role == vocabulary.role_textbox:
    return event
  let parent = case place held.nodes node.parent of
    $Some index => held.nodes[index].role
    $Nothing => vocabulary.role_group
  if code == keys.tab:
    return moved held (along held.order node.id (Bool.not held.state[0].shift))
  if code == keys.enter or code == keys.space:
    if takes node vocabulary.action_activate:
      return act node.id vocabulary.action_activate
    if takes node vocabulary.action_increment:
      return act node.id vocabulary.action_increment
    return event
  if code == keys.left or code == keys.right:
    let forward = code == keys.right
    let action = vocabulary.action_decrement
    if forward:
      action := vocabulary.action_increment
    if takes node action:
      return act node.id action
    if horizontal parent:
      return moved held (along (siblings held node) node.id forward)
    return event
  if code == keys.up or code == keys.down:
    if vertical parent:
      return moved held (along (siblings held node) node.id (code == keys.down))
    return event
  if code == keys.escape or code == keys.f10:
    if held.state[0].modal != 0:
      return event
    if code == keys.escape:
      if held.returns.length > 0:
        return event
      let at = node
      for 0 .. 64:
        if at.role == vocabulary.role_dialog:
          return event
        let $Some index = place held.nodes at.parent else:
          break
        at := held.nodes[index]
    return left held
  return event

// `event` as the game gets it: while a node has the focus, the keys that
// move it or act on the node become UiAction events on it (see above); F10
// brings the focus into the interface; a click outside a modal dialog takes
// it back to the world. Assistive technology's focus and blur move it too.
// Runs before the systems see each event (app).
func route (event: window.Event) -> (held: Focus) => return do:
  if let $window.UiAction { node, action } = event:
    if held.nodes.length > 0:
      let allowed = array.any (func id => return id == node) held.reached
      let offered = case place held.nodes node of
        $Some index => takes held.nodes[index] action or action == vocabulary.action_blur
        $Nothing => false
      if Bool.not allowed or Bool.not offered:
        return $window.UiAction { node: 0, action: 0, value: 0.0 }
  return case event of
    $window.KeyDown code if code == keys.shift => do:
      held.state[0].shift = true
      break event
    $window.KeyUp code if code == keys.shift => do:
      held.state[0].shift = false
      break event
    $window.FocusLost => do:
      held.state[0].shift = false
      break event
    $window.UiAction { node, action } if action == vocabulary.action_focus => do:
      if Bool.not (array.any (func id => return id == node) held.reached):
        break event
      held.state[0].node = node
      break event
    $window.UiAction { node, action } if action == vocabulary.action_blur => do:
      if held.state[0].node == node and held.state[0].modal == 0:
        held.state[0].node = 0
      break event
    $window.PointerDown _ if held.state[0].modal == 0 and held.state[0].node != 0 => do:
      held.state[0].node = 0
      break event
    $window.KeyDown code => do:
      if held.order.length == 0:
        break event
      let $Some index = place held.nodes held.state[0].node else:
        if code == keys.f10 and held.state[0].modal == 0:
          break moved held held.order[0]
        break event
      break navigate held held.nodes[index] code event
    _ => event

// Named flat topology pools and cached properties. Text belongs to the current
// frame only; a preparation never retains Node views or an owning scene tree.
type Authored is data = $Authored {id: U32, parent: U32, role: U32, actions: U32,
  focusable: Bool, hidden: Bool, disabled: Bool, modal: Bool, selected: U32}
type Topology is data = $Topology {meta: Array U32,
  keys: ResizeArray U32, key_order: ResizeArray U32, parents: ResizeArray U32,
  depth: ResizeArray U32, order: ResizeArray U32,
  child_starts: ResizeArray U32, child_targets: ResizeArray U32}
type Prepared is data = $Prepared {topology: Topology, authored: ResizeArray Authored,
  hidden: ResizeArray Bool, available: ResizeArray Bool, inside: ResizeArray Bool,
  stops: ResizeArray Stop, order: ResizeArray U32, reached: ResizeArray U32}
func properties (node: Node) => return $Authored {id: node.id, parent: node.parent,
  role: node.role, actions: node.actions, focusable: node.focusable, hidden: node.hidden,
  disabled: node.disabled, modal: node.modal, selected: node.selected}
func topology (revision: U32) -> (nodes: &[Node]) -> (stored: Topology) => return do:
  let key_values: ResizeArray U32 = #[]
  let key_order: ResizeArray U32 = #[]
  let keys = lookup.build_into (array.map (func (n: Node) => return n.id) nodes) key_values key_order
  let parents = array.map (func (n: Node) => return Maybe.unwrap_or nodes.length (lookup.find keys n.parent)) nodes
  let depth = array.generate nodes.length (func i => return do:
    let at = i
    for step in 0 .. 64:
      if nodes[at].parent == 0:
        return step + 1
      at := (array.at at parents)
      if at == nodes.length:
        return 0
    return 0)
  let edges = array.filter (func i => return nodes[i].parent != 0 and parents[i] < nodes.length) (array.generate nodes.length identity)
  let $Some children = graph.from_edges nodes.length (array.map (func i => return parents[i]) edges) edges stored.child_starts stored.child_targets else:
    return @panic "UI topology edge invariant"
  replace keys.values stored.keys
  replace keys.order stored.key_order
  replace parents stored.parents
  replace depth stored.depth
  replace (sort.order_u32 depth) stored.order
  stored.meta[0] = revision
func topology_find (stored: Topology) -> (key: U32) => return do:
  let low = 0
  let high = stored.key_order.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if stored.keys[stored.key_order[middle]] < key:
      low := middle + 1
    else:
      high := middle
  if low < stored.key_order.length:
    let index = stored.key_order[low]
    if stored.keys[index] == key:
      return $Some index
  return $Nothing
// Dirty roots propagate only through their descendants, in retained depth
// order. Existing hidden/available buffers are mutated, never copied wholesale.
func inherited (topology: Topology) -> (nodes: &[Node]) -> roots -> (hidden: ResizeArray Bool) -> (available: ResizeArray Bool) => return do:
  if roots.length == 0:
    return ()
  let $Some children = graph.bind topology.child_starts topology.child_targets else:
    return @panic "UI child adjacency invariant"
  let affected = graph.reachable children roots (array.fill nodes.length true)
  for i in topology.order:
    if affected[i]:
      let hide = true
      let ready = false
      if topology.depth[i] != 0:
        let n = nodes[i]
        let parent = topology.parents[i]
        hide := n.hidden or (n.parent != 0 and hidden[parent])
        ready := Bool.not (n.hidden or n.disabled) and (n.parent == 0 or available[parent])
      hidden[i] = hide
      available[i] = ready
func selection (prepared: Prepared) -> (nodes: &[Node]) -> fresh => return do:
  let modal = 0
  for i in 0 .. nodes.length:
    if nodes[i].modal and prepared.available[i]:
      modal := nodes[i].id
  if fresh or modal != prepared.topology.meta[1]:
    let inside = array.generate nodes.length (func i => return modal == 0 or within_at nodes prepared.topology.parents modal i)
    replace inside prepared.inside
  let reached = array.filter (func i => return nodes[i].id != 0 and nodes[i].focusable and prepared.inside[i] and prepared.available[i]) (array.generate nodes.length identity)
  let order = array.map (func i => return nodes[i].id) (array.filter (func i => return stop nodes[i]) reached)
  replace order prepared.order
  replace (array.map (func i => return nodes[i].id) reached) prepared.reached
  prepared.topology.meta[1] = modal
func prepared_stops (nodes: &[Node]) => return array.map (func (n: Node) : Stop => return
  {id: n.id, parent: n.parent, role: n.role, actions: n.actions}) nodes
func prepare (revision: U32) -> (nodes: &[Node]) -> (prepared: Prepared) => return do:
  topology revision nodes prepared.topology
  replace (array.map properties nodes) prepared.authored
  replace (array.fill nodes.length true) prepared.hidden
  replace (array.fill nodes.length false) prepared.available
  inherited prepared.topology nodes (array.generate nodes.length identity) prepared.hidden prepared.available
  selection prepared nodes true
  replace (prepared_stops nodes) prepared.stops
// Revision/length changes rebuild topology; ordinary dirty text/value updates
// keep adjacency, ancestry, inherited masks and stop lists in their named pools.
func update_prepared (revision: U32) -> (nodes: &[Node]) -> (dirty: Array U32) -> (prepared: Prepared) => return do:
  if revision != prepared.topology.meta[0] or nodes.length != prepared.authored.length:
    return prepare revision nodes prepared
  let selected = array.filter (func i => return i < nodes.length) (changes.unique dirty)
  let changed_properties = false
  let stops_changed = false
  for i in selected:
    let n = nodes[i]
    let old = prepared.authored[i]
    if n.id != old.id or n.parent != old.parent:
      return @panic "UI topology changed without a new revision"
    changed_properties := self or Bool.not (same n.focusable old.focusable and same n.modal old.modal) or n.selected != old.selected or n.role != old.role
    stops_changed := self or n.role != old.role or n.actions != old.actions
  let roots = array.filter (func i => return Bool.not (same nodes[i].hidden prepared.authored[i].hidden and same nodes[i].disabled prepared.authored[i].disabled)) selected
  inherited prepared.topology nodes roots prepared.hidden prepared.available
  if changed_properties or roots.length != 0:
    selection prepared nodes false
  if stops_changed:
    for i in selected:
      let n = nodes[i]
      prepared.stops[i] = {id: n.id, parent: n.parent, role: n.role, actions: n.actions}
  for i in selected:
    prepared.authored[i] = properties nodes[i]
// Current frame text is read only while marking/encoding this frame. Focus
// stop/order/reached snapshots are explicit row copies into their own owners.
func resolve_prepared (prepared: Prepared) -> (nodes: &[Node]) -> (held: Focus) -> (output: ResizeArray Node) => return do:
  if nodes.length != prepared.authored.length:
    return @panic "UI preparation length is stale"
  for 0 .. held.returns.length:
    let last = held.returns[held.returns.length - 1]
    if Maybe.is_some (topology_find prepared.topology last.scope):
      break
    held.state[0].node = last.node
    held.returns.truncate (held.returns.length - 1)
  let present = array.any (func id => return id == held.state[0].node) prepared.reached
  let modal = prepared.topology.meta[1]
  let node = if present then held.state[0].node else if modal != 0 and prepared.order.length > 0 then prepared.order[0] else 0
  let marked = array.generate nodes.length (func i => return do:
    let entry = nodes[i]
    if entry.id != prepared.authored[i].id or entry.parent != prepared.authored[i].parent:
      return @panic "UI topology changed without a new revision"
    let focused = node != 0 and entry.id == node
    let hidden = prepared.hidden[i] or Bool.not prepared.inside[i]
    return if same entry.focused focused and same entry.hidden hidden then entry else mark entry focused hidden)
  replace marked output
  replace prepared.stops held.nodes
  replace prepared.order held.order
  replace prepared.reached held.reached
  held.state[0].node = node
  held.state[0].modal = modal

// Stage-local labels are copied before a Node reaches an older frame owner.
// Declare the label pool outside stage callbacks and keep it through encoding.
func store_text codes -> (labels: ResizeArray U32) => return do:
  let start = labels.length
  for index in 0 .. codes.length:
    labels.push (array.at index codes)
  return &labels[start..labels.length]
func store_node (node: Node) -> (labels: ResizeArray U32) => return do:
  let name = store_text node.name labels
  let description = store_text node.description labels
  let value_text = store_text node.value_text labels
  node.name := name
  node.description := description
  node.value_text := value_text
  return node
func declare_owned (node: Node) -> labels -> (nodes: ResizeArray Node) => return
  nodes.push (store_node node labels)
