import * as array from "std/array"
import * as sort from "../sort"
import * as changes from "../changes"
import * as graph from "../graph"
import * as lookup from "../lookup"
import * as keys from "../input/keys"
import * as lanes from "../lanes"
import * as logic from "../logic"
import * as vocabulary from "./vocabulary"
import * as window from "../events"

// The interface as assistive technology and the keyboard see it: the nodes
// the game declares as it draws each frame (ui builds and declares them),
// and the keyboard focus that moves through them. Callers present nodes
// to their accessibility host through an adapter.
//
// The game drives the focus, in every host alike: while a node has it, Tab
// and Shift+Tab move it through the focusable nodes (of a tab list's tabs,
// only to the chosen one), Up and Down between the rows of a list, menu,
// dialog or page, Left and Right between the tabs or tools of a bar or step
// a slider, and Enter and Space activate the focused node (or step it up). Those keys reach the game as UiAction events on
// the node, the same events assistive technology sends through the host, so
// a system that handles a node's actions handles both. F10 moves the focus
// into the interface and back out; Escape and a click leave it. While a modal
// dialog is open the focus stays in it. A focused text box takes every key
// as it is, for its system to type with, and leaves the focus as that
// system does.

// A node as the game declares it: `id` from a stable key (`key`), `parent`
// its parent's id or 0 at the top, `role` (vocabulary.role_*), its text in
// code points, where it lies on the screen (an empty rectangle for one not
// drawn), its states (`checked`, `expanded` and `selected` in
// vocabulary.state_*, `live` in vocabulary.live_*), a range's value and
// bounds, and the actions it takes (`bit` of each vocabulary.action_*).
// `focused` is the focus's to set (`settle`).
// Flat range into a caller-owned codepoint label pool.
type Span is data = $Span { start: U32, count: U32 }
const no_span = $Span { start: 0, count: 0 }

// A transient node builder carrying borrowed codepoint views; `declare_owned`
// copies its text into `labels` as flat Spans to produce a `StoredNode`.
type Node is data = $Node {
  id: U32, parent: U32, role: U32,
  name: &[U32], description: &[U32], value_text: &[U32],
  x: F32, y: F32, width: F32, height: F32,
  focusable: Bool, focused: Bool, disabled: Bool, hidden: Bool, modal: Bool,
  checked: U32, expanded: U32, selected: U32, live: U32,
  value: F32, minimum: F32, maximum: F32, step: F32,
  actions: U32,
}

// Flat frame-stored node whose text fields are spans into `ui_labels`.
type StoredNode is data = $StoredNode {
  id: U32, parent: U32, role: U32,
  name: Span, description: Span, value_text: Span,
  x: F32, y: F32, width: F32, height: F32,
  focusable: Bool, focused: Bool, disabled: Bool, hidden: Bool, modal: Bool,
  checked: U32, expanded: U32, selected: U32, live: U32,
  value: F32, minimum: F32, maximum: F32, step: F32,
  actions: U32,
}

// This frame's nodes, in the order declared: parents before their children.
type Tree is data = $Tree {nodes: &[StoredNode]}
func from_nodes (nodes: #[StoredNode]) => $Tree {nodes: &nodes[0..nodes.length]}
const no_text: #[U32] = #[]

func text (labels: &[U32]) -> (span: Span) : &[U32] =>
  if span.start > labels.length or span.count > labels.length - span.start:
    return panic "UI label span is outside its pool"
  return &labels[span.start..span.start + span.count]

// What the keys move through of a node the last frame declared: its id,
// its parent's, its role and the actions it takes. A flat structural record,
// so an array of them packs into consecutive words instead of boxing each.
type Stop = { id: U32, parent: U32, role: U32, actions: U32 }

// The keyboard focus: the focused node's id, or 0 while the game's world has
// the keys; whether Shift is held; the open modal dialog's id (0 for none);
// and the last frame's nodes, those Tab stops at in order, and all the nodes
// the focus can reach. It is saved with the state (not with scenes), the last
// frame's nodes included: a restored moment's keys move through what its
// last frame declared, as they did the first time.
type Return = { scope: U32, node: U32 }
type FocusState is data = $FocusState {node: U32, shift: Bool, modal: U32}
// Access aliases separately named owners. Only FocusState/Stop/Return are stored.
type Focus is data = $Focus {state: #[FocusState], returns: #[Return],
  nodes: #[Stop], order: #[U32], reached: #[U32]}
const unfocused = $FocusState {node: 0, shift: false, modal: 0}
func replace values -> (target: own #[a]) : #[a] =>
  @storage.truncate target 0
  for index in 0 .. values.length:
    @storage.push target (array.at index values)
  return target

// Lanes: the focused node, Shift, the modal dialog, then the last frame's
// nodes (their count, then each one's id, parent, role and actions), those
// Tab stops at (count, then ids) and those the focus reaches (count, ids),
// then return scopes (count and scope/opener pairs), in one exactly sized array.
func encode (held: Focus) =>
  let count = held.nodes.length
  let order_at = 4 + count * 4
  let reached_at = order_at + 1 + held.order.length
  let returns_at = reached_at + 1 + held.reached.length
  let written = array.fill (returns_at + 1 + held.returns.length * 2) 0.0
  written[0] := U32.to_f32 held.state[0].node
  written[1] := lanes.bit held.state[0].shift
  written[2] := U32.to_f32 held.state[0].modal
  written[3] := U32.to_f32 count
  for index in 0 .. count:
    let stop = held.nodes[index]
    let at = 4 + index * 4
    written[at] := U32.to_f32 stop.id
    written[at + 1] := U32.to_f32 stop.parent
    written[at + 2] := U32.to_f32 stop.role
    written[at + 3] := U32.to_f32 stop.actions
  written[order_at] := U32.to_f32 held.order.length
  for index in 0 .. held.order.length:
    written[order_at + 1 + index] := U32.to_f32 held.order[index]
  written[reached_at] := U32.to_f32 held.reached.length
  for index in 0 .. held.reached.length:
    written[reached_at + 1 + index] := U32.to_f32 held.reached[index]
  written[returns_at] := from held.returns.length
  for index in 0 .. held.returns.length:
    written[returns_at + 1 + index * 2] := from held.returns[index].scope
    written[returns_at + 2 + index * 2] := from held.returns[index].node
  return written

func whole (value: F32) => lanes.integer value lanes.max_integer

func decode_into (values: #[F32]) -> (held: own Focus) : Focus =>
  use lanes.require (values.length >= 4)
  let count = whole values[3]
  let order_at = 4 + count * 4
  use lanes.require (order_at < values.length)
  let order_count = lanes.integer values[order_at] count
  let reached_at = order_at + 1 + order_count
  use lanes.require (reached_at < values.length)
  let reached_count = lanes.integer values[reached_at] count
  let returns_at = reached_at + 1 + reached_count
  use lanes.require (returns_at < values.length)
  let returns_count = lanes.integer values[returns_at] 32
  use lanes.exact values (returns_at + 1 + returns_count * 2)
  let returns = array.generate returns_count $ func index =>
    let scope = whole values[returns_at + 1 + index * 2]
    use lanes.require (scope != 0)
    for before in 0 .. index:
      use lanes.require (scope != whole values[returns_at + 1 + before * 2])
    return { scope, node: whole values[returns_at + 2 + index * 2] }
  let nodes = array.generate count (func index =>
    let start = 4 + index * 4
    return { id: whole values[start], parent: whole values[start + 1], role: whole values[start + 2], actions: whole values[start + 3] })
  let order = array.map whole (lanes.record values (order_at + 1) order_count)
  let reached = array.map whole (lanes.record values (reached_at + 1) reached_count)
  let state = $FocusState {node: whole values[0], shift: lanes.flag values[1], modal: whole values[2]}
  held.returns := replace returns self
  held.nodes := replace nodes self
  held.order := replace order self
  held.reached := replace reached self
  held.state[0] := state
  return held

func migrate (version: U32) -> (values: #[F32]) : Maybe (#[F32]) => return
  if version == 1 then $Some (array.concat values #[0.0]) else $Nothing
const schema_key = 15
const schema_version = 2

// A node's id from a stable key: a `scope` (1 to 255, one for each system
// that declares nodes) and a `local` key within it (below 65536), such as a
// row's place in a fixed menu or an entity's index; never the order nodes
// happen to be drawn in.
func key (scope: U32) => func (local: U32) => (scope % 256) * 65536 + local % 65536

// The bit of `action` in a node's `actions`.
func bit (action: U32) =>
  if action >= 32:
    return 0
  return 1 << action

func takes (node: Stop) => func (action: U32) => (node.actions & bit action) != 0

// Adds `node` to this frame's interface.
func declare (node: StoredNode) -> (nodes: own #[StoredNode]) : #[StoredNode] =>
  @storage.push nodes node
  return nodes
func declare_many values -> (nodes: own #[StoredNode]) : #[StoredNode] =>
  for node in values:
    @storage.push nodes node
  return nodes

// Moves the keyboard focus to node `id`, or with 0 out of the interface: a
// system whose own focus moved (a menu's row followed the pointer) keeps the
// interface's with it.
func focus (id: U32) -> (held: own Focus): Focus =>
  if held.state[0].node == id:
    return held
  held.state[0].node := id
  return held

// Dialog lifetimes remember their opener. Re-entering a scope does not
// overwrite it; closing an outer scope also retires its nested scopes.
func enter (scope: U32) -> (first: U32) -> (held: own Focus): Focus =>
  for index in 0 .. held.returns.length:
    if held.returns[index].scope == scope:
      return held
  use lanes.require (scope != 0 and held.returns.length < 32)
  @storage.push held.returns {scope, node: held.state[0].node}
  held.state[0].node := first
  return held
func leave (scope: U32) -> (held: own Focus): Focus =>
  for index in 0 .. held.returns.length:
    if held.returns[index].scope == scope:
      held.state[0].node := held.returns[index].node
      @storage.truncate held.returns index
      return held
  return held

// Whether node `id` has the keyboard focus.
func focused (id: U32) -> (held: Focus) =>
  return id != 0 and held.state[0].node == id

func place nodes => func (id: U32) =>
  for index in 0 .. nodes.length:
    if (array.at index nodes).id == id:
      return $Some index
  return $Nothing

func declared (nodes: &[StoredNode]) => func (id: U32) =>
  for index in 0 .. nodes.length:
    if nodes[index].id == id:
      return $Some index
  return $Nothing

// Whether `node` is `scope` or inside it.
func within (nodes: &[StoredNode]) => func (scope: U32) => func (node: StoredNode) =>
  let at = node
  for 0 .. 64:
    if at.id == scope:
      return true
    let $Some above = declared nodes at.parent else:
      return false
    at := nodes[above]
  return false

// Visibility and availability are inherited from ancestors.
func available (nodes: &[StoredNode]) => func (node: StoredNode) =>
  let at = node
  for 0 .. 64:
    if at.hidden or at.disabled:
      return false
    if at.parent == 0:
      return true
    let $Some above = declared nodes at.parent else:
      return false
    at := nodes[above]
  return false

// Resolve each parent once into `out`. Stable ordering retains the first
// declaration when ids repeat, including id 0; `within` may follow that node.
func parents_into (nodes: &[StoredNode]) -> (out: own #[U32]): #[U32] =>
  @storage.truncate out 0
  let count = nodes.length
  if count <= 16:
    for index in 0 .. count:
      let above = case declared nodes nodes[index].parent of
        $Some found => found
        $Nothing => count
      @storage.push out above
    return out
  let keys = array.map (func (node: StoredNode) => node.id) nodes
  let ordered = sort.order_u32 keys
  for index in 0 .. count:
    let id = nodes[index].parent
    let low = 0
    let high = ordered.length
    for 0 .. 32:
      if low >= high:
        break
      let middle = low + (high - low) / 2
      if keys[ordered[middle]] < id:
        low := middle + 1
      else:
        high := middle
    if low < ordered.length and keys[ordered[low]] == id:
      @storage.push out ordered[low]
    else:
      @storage.push out count
  return out

func parents_of (nodes: &[StoredNode]) : #[U32] =>
  let out: #[U32] = #[]
  return parents_into nodes out

func available_at (nodes: &[StoredNode]) => func parents => func (index: U32) =>
  let at = index
  for 0 .. 64:
    let node = nodes[at]
    if node.hidden or node.disabled:
      return false
    if node.parent == 0:
      return true
    let above = (array.at at parents)
    if above == nodes.length:
      return false
    at := above
  return false

func hidden_at (nodes: &[StoredNode]) -> parents -> (index: U32) =>
  let at = index
  for 0 .. 64:
    if nodes[at].hidden:
      return true
    if nodes[at].parent == 0:
      return false
    at := (array.at at parents)
    if at == nodes.length:
      return true
  return true

func within_at (nodes: &[StoredNode]) => func parents => func (scope: U32) => func (index: U32) =>
  let at = index
  for 0 .. 64:
    if nodes[at].id == scope:
      return true
    let above = (array.at at parents)
    if above == nodes.length:
      return false
    at := above
  return false

// Whether Tab stops at `node`: of a tab list's tabs, only at the chosen one;
// the arrows move between them.
func stop (node: StoredNode) => node.role != vocabulary.role_tab or node.selected != vocabulary.state_false

func same (a: Bool) => func (b: Bool) => if a then b else not b

// `entry` with its focus and hidden marks, built at once.
func mark (entry: StoredNode) => func (focused: Bool) => func (hidden: Bool) =>
  let $StoredNode { id, parent, role, name, description, value_text, x, y, width, height, focusable, disabled, modal, checked, expanded, selected, live, value, minimum, maximum, step, actions } = entry
  return $StoredNode {
    id, parent, role, name, description, value_text, x, y, width, height,
    focusable, focused, disabled, hidden, modal, checked, expanded, selected, live,
    value, minimum, maximum, step, actions,
  }

// The frame's interface is complete: what the keys will move through next
// frame is kept, a focus on a node that is gone leaves the interface (or,
// with a modal dialog open, goes to its first focusable node), the focused
// node is marked, and with a modal dialog open the rest is hidden from
// assistive technology. Runs after the frame's Render systems (app).
func settle (nodes: &[StoredNode]) -> (held: own Focus) -> (output: own #[StoredNode]) : (Focus, #[StoredNode]) =>
  // Only retire absent top scopes: a modal may intentionally stop rendering
  // the dialog underneath it. Restore missing openers through the stack.
  for 0 .. held.returns.length:
    let last = held.returns[held.returns.length - 1]
    if Maybe.is_some (declared nodes last.scope):
      break
    held.state[0].node := last.node
    @storage.truncate held.returns (held.returns.length - 1)
  let count = nodes.length
  let parents = parents_of nodes
  let avail = array.fill count false
  let hid = array.fill count true
  let depths = array.fill count 64
  let modal = 0
  for index in 0 .. count:
    let entry = nodes[index]
    let p = parents[index]
    if entry.parent == 0:
      depths[index] := 0
      avail[index] := not entry.hidden and not entry.disabled
      hid[index] := entry.hidden
    else:
      if p < index and depths[p] < 63:
        depths[index] := depths[p] + 1
        avail[index] := not entry.hidden and not entry.disabled and avail[p]
        hid[index] := entry.hidden or hid[p]
      else:
        avail[index] := available_at nodes parents index
        hid[index] := hidden_at nodes parents index
    if entry.modal and avail[index]:
      modal := entry.id
  let inside = array.fill count true
  if modal != 0:
    let within_depth = array.fill count 64
    for index in 0 .. count:
      let entry = nodes[index]
      let p = parents[index]
      if entry.id == modal:
        inside[index] := true
        within_depth[index] := 0
      else:
        if p < index and within_depth[p] < 63:
          inside[index] := inside[p]
          within_depth[index] := within_depth[p] + 1
        else:
          if p == count:
            inside[index] := false
            within_depth[index] := 0
          else:
            inside[index] := within_at nodes parents modal index
  @storage.truncate held.nodes 0
  @storage.truncate held.order 0
  @storage.truncate held.reached 0
  let previous = held.state[0].node
  let present = false
  for index in 0 .. count:
    let entry = nodes[index]
    @storage.push held.nodes {id: entry.id, parent: entry.parent, role: entry.role, actions: entry.actions}
    if entry.id != 0 and entry.focusable and inside[index] and avail[index]:
      @storage.push held.reached entry.id
      if entry.id == previous:
        present := true
      if stop entry:
        @storage.push held.order entry.id
  let node = 0
  if present:
    node := previous
  else:
    if modal != 0 and held.order.length > 0:
      node := held.order[0]
  @storage.truncate output 0
  for index in 0 .. count:
    let entry = nodes[index]
    let focused = node != 0 and entry.id == node
    let hidden = hid[index] or not inside[index]
    if same entry.focused focused and same entry.hidden hidden:
      @storage.push output entry
    else:
      @storage.push output (mark entry focused hidden)
  held.state[0].node := node
  held.state[0].modal := modal
  return (held, output)

// The node `step` places along `ids` from `id`, wrapping round; the first
// (or with a negative step, the last) when `id` is not among them.
func along ids => func (id: U32) => func (forward: Bool) =>
  let count = ids.length
  if count == 0:
    return id
  for index in 0 .. count:
    if (array.at index ids) == id:
      if forward:
        return (array.at ((index + 1) % count) ids)
      return (array.at ((index + count - 1) % count) ids)
  if forward:
    return (array.at 0 ids)
  return (array.at (count - 1) ids)

// The nodes the focus reaches beside `node` in its parent, it among them.
func siblings (held: Focus) => func (node: Stop) => return
  #[entry.id | entry <- held.nodes, (entry.parent == node.parent and array.any (func id => id == entry.id) held.reached)]

func horizontal (role: U32) => return
  role == vocabulary.role_tablist or role == vocabulary.role_toolbar or role == vocabulary.role_radiogroup

func vertical (role: U32) => return
  role == vocabulary.role_list or role == vocabulary.role_menu or role == vocabulary.role_dialog or role == vocabulary.role_tabpanel

func act (node: U32) => func (action: U32) => $window.UiAction { node, action, value: 0.0 }

// The focus moved to `id` by key.
func moved (state: FocusState) => func (id: U32): (window.Event, FocusState) =>
  state.node := id
  return (act id vocabulary.action_focus, state)

// The focus left the interface by key.
func left (state: FocusState): (window.Event, FocusState) =>
  let was = state.node
  state.node := 0
  return (act was vocabulary.action_blur, state)

// What key `code` does with the focus on `node`: the event the game gets.
func navigate (held: Focus) => func (state: FocusState) => func (node: Stop) => func (code: U32) => func (event: window.Event): (window.Event, FocusState) =>
  if node.role == vocabulary.role_textbox:
    return (event, state)
  let parent = case place held.nodes node.parent of
    $Some index => held.nodes[index].role
    $Nothing => vocabulary.role_group
  if code == keys.tab:
    return moved state (along held.order node.id (not state.shift))
  if code == keys.enter or code == keys.space:
    if takes node vocabulary.action_activate:
      return (act node.id vocabulary.action_activate, state)
    if takes node vocabulary.action_increment:
      return (act node.id vocabulary.action_increment, state)
    return (event, state)
  if code == keys.left or code == keys.right:
    let forward = code == keys.right
    let action = vocabulary.action_decrement
    if forward:
      action := vocabulary.action_increment
    if takes node action:
      return (act node.id action, state)
    if horizontal parent:
      return moved state (along (siblings held node) node.id forward)
    return (event, state)
  if code == keys.up or code == keys.down:
    if vertical parent:
      return moved state (along (siblings held node) node.id (code == keys.down))
    return (event, state)
  if code == keys.escape or code == keys.f10:
    if state.modal != 0:
      return (event, state)
    if code == keys.escape:
      if held.returns.length > 0:
        return (event, state)
      let at = node
      for 0 .. 64:
        if at.role == vocabulary.role_dialog:
          return (event, state)
        let $Some index = place held.nodes at.parent else:
          break
        at := held.nodes[index]
    return left state
  return (event, state)

// `event` as the game gets it: while a node has the focus, the keys that
// move it or act on the node become UiAction events on it (see above); F10
// brings the focus into the interface; a click outside a modal dialog takes
// it back to the world. Assistive technology's focus and blur move it too.
// Runs before the systems see each event (app).
func route (event: window.Event) -> (held: Focus): (window.Event, FocusState) =>
  let state = held.state[0]
  if let $window.UiAction { node, action } = event:
    if held.nodes.length > 0:
      let allowed = array.any (func id => id == node) held.reached
      let offered = case place held.nodes node of
        $Some index => takes held.nodes[index] action or action == vocabulary.action_blur
        $Nothing => false
      if not allowed or not offered:
        return ($window.UiAction { node: 0, action: 0, value: 0.0 }, state)
  return case event of
    $window.KeyDown code if code == keys.shift => do:
      state.shift := true
      break (event, state)
    $window.KeyUp code if code == keys.shift => do:
      state.shift := false
      break (event, state)
    $window.FocusLost => do:
      state.shift := false
      break (event, state)
    $window.UiAction { node, action } if action == vocabulary.action_focus => do:
      if not (array.any (func id => id == node) held.reached):
        break (event, state)
      state.node := node
      break (event, state)
    $window.UiAction { node, action } if action == vocabulary.action_blur => do:
      if state.node == node and state.modal == 0:
        state.node := 0
      break (event, state)
    $window.PointerDown _ if state.modal == 0 and state.node != 0 => do:
      state.node := 0
      break (event, state)
    $window.KeyDown code => do:
      if held.order.length == 0:
        break (event, state)
      let $Some index = place held.nodes state.node else:
        if code == keys.f10 and state.modal == 0:
          break moved state held.order[0]
        break (event, state)
      break navigate held state held.nodes[index] code event
    _ => (event, state)

// Named flat topology pools and cached properties. Text belongs to the current
// frame only; a preparation never retains Node views or an owning scene tree.
type Authored is data = $Authored {id: U32, parent: U32, role: U32, actions: U32,
  focusable: Bool, hidden: Bool, disabled: Bool, modal: Bool, selected: U32}
type Topology is data = $Topology {revision: U32, modal: U32,
  keys: #[U32], key_order: #[U32], parents: #[U32],
  depth: #[U32], order: #[U32],
  child_starts: #[U32], child_targets: #[U32]}
type Prepared is data = $Prepared {topology: Topology, authored: #[Authored],
  hidden: #[Bool], available: #[Bool], inside: #[Bool],
  stops: #[Stop], order: #[U32], reached: #[U32]}
func empty_prepared () : Prepared =>
  let keys: #[U32] = #[]
  let key_order: #[U32] = #[]
  let parents: #[U32] = #[]
  let depth: #[U32] = #[]
  let traversal: #[U32] = #[]
  let child_starts: #[U32] = #[]
  let child_targets: #[U32] = #[]
  let topology = $Topology {revision: 0, modal: 0, keys, key_order, parents, depth, order: traversal, child_starts, child_targets}
  let authored: #[Authored] = #[]
  let hidden: #[Bool] = #[]
  let available: #[Bool] = #[]
  let inside: #[Bool] = #[]
  let stops: #[Stop] = #[]
  let order: #[U32] = #[]
  let reached: #[U32] = #[]
  return $Prepared {topology, authored, hidden, available, inside, stops, order, reached}
func properties (node: StoredNode) => $Authored {id: node.id, parent: node.parent,
  role: node.role, actions: node.actions, focusable: node.focusable, hidden: node.hidden,
  disabled: node.disabled, modal: node.modal, selected: node.selected}
func topology (revision: U32) -> (nodes: &[StoredNode]) -> (stored: own Topology) : Topology =>
  let table = lookup.build_into (array.map (func (n: StoredNode) => n.id) nodes) stored.keys stored.key_order
  let parents = array.map (func (n: StoredNode) => Maybe.unwrap_or nodes.length (lookup.find table n.parent)) nodes
  let $lookup.Keys { values: next_keys, order: next_order } = table
  stored.keys := next_keys
  stored.key_order := next_order
  let depth = array.generate nodes.length (func i =>
    let at = i
    for step in 0 .. 64:
      if nodes[at].parent == 0:
        return step + 1
      at := (array.at at parents)
      if at == nodes.length:
        return 0
    return 0)
  let edges = array.filter (func i => nodes[i].parent != 0 and parents[i] < nodes.length) (array.generate nodes.length identity)
  let (built, child_starts, child_targets) = graph.from_edges nodes.length (array.map (func i => parents[i]) edges) edges stored.child_starts stored.child_targets
  if not built:
    return panic "UI topology edge invariant"
  stored.child_starts := child_starts
  stored.child_targets := child_targets
  stored.parents := replace parents self
  stored.depth := replace depth self
  stored.order := replace (sort.order_u32 depth) self
  stored.revision := revision
  return stored
func topology_find (stored: Topology) -> (key: U32) =>
  let low = 0
  let high = stored.key_order.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if stored.keys[stored.key_order[middle]] < key:
      low := middle + 1
    else:
      high := middle
  if low < stored.key_order.length:
    let index = stored.key_order[low]
    if stored.keys[index] == key:
      return $Some index
  return $Nothing
// Dirty roots propagate only through their descendants, in retained depth
// order. Existing hidden/available buffers are mutated, never copied wholesale.
func inherited (topology: Topology) -> (nodes: &[StoredNode]) -> roots -> (hidden: own #[Bool]) -> (available: own #[Bool]) : (#[Bool], #[Bool]) =>
  if roots.length == 0:
    return (hidden, available)
  let children = graph.borrow topology.child_starts topology.child_targets
  let affected = graph.reachable children roots (array.fill nodes.length true)
  for i in topology.order:
    if affected[i]:
      let hide = true
      let ready = false
      if topology.depth[i] != 0:
        let n = nodes[i]
        let parent = topology.parents[i]
        hide := n.hidden or (n.parent != 0 and hidden[parent])
        ready := not (n.hidden or n.disabled) and (n.parent == 0 or available[parent])
      hidden[i] := hide
      available[i] := ready
  return (hidden, available)
func selection (prepared: own Prepared) -> (nodes: &[StoredNode]) -> (fresh: Bool) : Prepared =>
  let modal = 0
  for i in 0 .. nodes.length:
    if nodes[i].modal and prepared.available[i]:
      modal := nodes[i].id
  if fresh or modal != prepared.topology.modal:
    @storage.truncate prepared.inside 0
    for i in 0 .. nodes.length:
      @storage.push prepared.inside (modal == 0 or within_at nodes prepared.topology.parents modal i)
  @storage.truncate prepared.order 0
  @storage.truncate prepared.reached 0
  for i in 0 .. nodes.length:
    let node = nodes[i]
    if node.id != 0 and node.focusable and prepared.inside[i] and prepared.available[i]:
      @storage.push prepared.reached node.id
      if stop node:
        @storage.push prepared.order node.id
  prepared.topology.modal := modal
  return prepared
func prepare (revision: U32) -> (nodes: &[StoredNode]) -> (prepared: own Prepared) : Prepared =>
  prepared.topology := topology revision nodes self
  @storage.truncate prepared.authored 0
  @storage.truncate prepared.hidden 0
  @storage.truncate prepared.available 0
  @storage.truncate prepared.stops 0
  for node in nodes:
    @storage.push prepared.authored (properties node)
    @storage.push prepared.hidden true
    @storage.push prepared.available false
    @storage.push prepared.stops {id: node.id, parent: node.parent, role: node.role, actions: node.actions}
  let (hidden, available) = inherited prepared.topology nodes (array.generate nodes.length identity) prepared.hidden prepared.available
  prepared.hidden := hidden
  prepared.available := available
  return selection prepared nodes true
// Revision/length changes rebuild topology; ordinary dirty text/value updates
// keep adjacency, ancestry, inherited masks and stop lists in their named pools.
func update_prepared (revision: U32) -> (nodes: &[StoredNode]) -> (dirty: #[U32]) -> (prepared: own Prepared) : Prepared =>
  if revision != prepared.topology.revision or nodes.length != prepared.authored.length:
    return prepare revision nodes prepared
  let selected = array.filter (func i => i < nodes.length) (changes.unique dirty)
  let dirty_roots: #[U32] = #[]
  let changed_properties = false
  let stops_changed = false
  for i in selected:
    let n = nodes[i]
    let old = prepared.authored[i]
    if n.id != old.id or n.parent != old.parent:
      return panic "UI topology changed without a new revision"
    if not (same n.hidden old.hidden and same n.disabled old.disabled):
      @storage.push dirty_roots i
    changed_properties := self or not (same n.focusable old.focusable and same n.modal old.modal) or n.selected != old.selected or n.role != old.role
    stops_changed := self or n.role != old.role or n.actions != old.actions
  let (hidden, available) = inherited prepared.topology nodes dirty_roots prepared.hidden prepared.available
  prepared.hidden := hidden
  prepared.available := available
  if changed_properties or dirty_roots.length != 0:
    prepared := selection prepared nodes false
  if stops_changed:
    for i in selected:
      let n = nodes[i]
      prepared.stops[i] := {id: n.id, parent: n.parent, role: n.role, actions: n.actions}
  for i in selected:
    prepared.authored[i] := properties nodes[i]
  return prepared
// Current frame text is read only while marking/encoding this frame. Focus
// stop/order/reached snapshots are explicit row copies into their own owners.
func resolve_prepared (prepared: Prepared) -> (nodes: &[StoredNode]) -> (held: own Focus) -> (output: own #[StoredNode]) : (Focus, #[StoredNode]) =>
  if nodes.length != prepared.authored.length:
    return panic "UI preparation length is stale"
  for 0 .. held.returns.length:
    let last = held.returns[held.returns.length - 1]
    if Maybe.is_some (topology_find prepared.topology last.scope):
      break
    held.state[0].node := last.node
    @storage.truncate held.returns (held.returns.length - 1)
  let previous = held.state[0].node
  let present = array.any (func id => id == previous) prepared.reached
  let modal = prepared.topology.modal
  let node = 0
  if present:
    node := previous
  else:
    if modal != 0 and prepared.order.length > 0:
      node := prepared.order[0]
  for i in 0 .. nodes.length:
    let entry = nodes[i]
    if entry.id != prepared.authored[i].id or entry.parent != prepared.authored[i].parent:
      return panic "UI topology changed without a new revision"
  @storage.truncate output 0
  for i in 0 .. nodes.length:
    let entry = nodes[i]
    let focused = node != 0 and entry.id == node
    let hidden = prepared.hidden[i] or not prepared.inside[i]
    if same entry.focused focused and same entry.hidden hidden:
      @storage.push output entry
    else:
      @storage.push output (mark entry focused hidden)
  held.nodes := replace prepared.stops self
  held.order := replace prepared.order self
  held.reached := replace prepared.reached self
  held.state[0].node := node
  held.state[0].modal := modal
  return (held, output)

// Stage-local labels are copied into `labels` as flat Spans before a StoredNode
// reaches an older frame owner (so growing `labels` never dangles a view).
func store_text codes -> (labels: own #[U32]) : (Span, #[U32]) =>
  let start = labels.length
  let count = codes.length
  for index in 0 .. count:
    @storage.push labels (array.at index codes)
  return ($Span { start, count }, labels)
func store_node (node: Node) -> (labels: own #[U32]) : (StoredNode, #[U32]) =>
  let (name, labels) = store_text node.name labels
  let (description, labels) = store_text node.description labels
  let (value_text, labels) = store_text node.value_text labels
  return ($StoredNode {
    id: node.id, parent: node.parent, role: node.role,
    name, description, value_text,
    x: node.x, y: node.y, width: node.width, height: node.height,
    focusable: node.focusable, focused: node.focused, disabled: node.disabled, hidden: node.hidden, modal: node.modal,
    checked: node.checked, expanded: node.expanded, selected: node.selected, live: node.live,
    value: node.value, minimum: node.minimum, maximum: node.maximum, step: node.step,
    actions: node.actions,
  }, labels)
func declare_owned (node: Node) -> (labels: own #[U32]) -> (nodes: own #[StoredNode]) : (#[U32], #[StoredNode]) =>
  let (stored, labels) = store_node node labels
  @storage.push nodes stored
  return (labels, nodes)
