// A single mechanical split-flap cell, using a caller's font and fill material.
// Phase 0..1 folds the old upper half down, then unfolds the new lower half.
import * as array from "std/array"
import * as math from "../math"
import * as render from "../render"
import * as ui from "../ui"
import * as font from "./font"

const clipped = func (sprite: render.Sprite) => return func (rect: ui.Rect) => return do:
  let left = max sprite.x rect.x
  let top = max sprite.y rect.y
  let right = min (sprite.x + sprite.width) (rect.x + rect.width)
  let bottom = min (sprite.y + sprite.height) (rect.y + rect.height)
  if right <= left or bottom <= top:
    return $Nothing
  let u = sprite.u1 - sprite.u0
  let v = sprite.v1 - sprite.v0
  return $Some $render.Sprite { x: left, y: top, width: right - left, height: bottom - top,
    u0: sprite.u0 + u * (left - sprite.x) / sprite.width,
    u1: sprite.u0 + u * (right - sprite.x) / sprite.width,
    v0: sprite.v0 + v * (top - sprite.y) / sprite.height,
    v1: sprite.v0 + v * (bottom - sprite.y) / sprite.height,
    material: sprite.material, color: sprite.color, parameters: sprite.parameters }

const half = func (face: font.Font) => return func (fill: U32) => return func (code: U32) => return func (cell: ui.Rect) => return func (size: F32) => return func (lower: Bool) => return func (fold: F32) => return func (shade: F32) => return do:
  let hinge = cell.y + cell.height * 0.5
  let region = $ui.Rect { x: cell.x, y: if lower then hinge + 0.5 else cell.y,
    width: cell.width, height: max 0.0 (cell.height * 0.5 - 0.5) }
  let ink = math.vec4 shade shade (shade * 0.96) 1.0
  let panel = if lower then 0.067 else 0.085
  let pieces: GrowArray render.Sprite = #[ui.image fill region 0.0 0.0 1.0 1.0 (math.vec4 (panel * shade) (panel * shade) (panel * shade) 1.0)]
  let glyph = font.glyph face code
  let baseline = hinge + size * 0.35
  let codes = #[code]
  for sprite in ui.text face (&codes[0..codes.length]) (cell.x + (cell.width - glyph.advance * size) * 0.5) baseline size ink:
    if let $Some part = clipped sprite region:
      @storage.push pieces part
  return array.map (func (sprite: render.Sprite) => return do:
    sprite.y := hinge + (self - hinge) * fold
    sprite.height := self * fold
    return sprite) (@storage.freeze pieces)

const cell = func (face: font.Font) => return func (fill: U32) => return func (before: U32) => return func (after: U32) => return func (rect: ui.Rect) => return func (size: F32) => return func (phase: F32) => return do:
  let upper = half face fill after rect size false 1.0 0.92
  if before == after or phase >= 1.0:
    return array.concat upper (half face fill after rect size true 1.0 0.92)
  let pieces = array.concat upper (half face fill before rect size true 1.0 0.92)
  let lower = phase >= 0.5
  let turn = if lower then (1.0 - phase) * 2.0 else phase * 2.0
  let fold = max 0.001 (cos (turn * pi * 0.5))
  let moving = half face fill (if lower then after else before) rect size lower fold (0.35 + fold * 0.57)
  return array.concat pieces moving
