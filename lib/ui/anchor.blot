import { Vec2 } from "std/vector"
import { Rect } from "../ui"

// Pure layout in caller units. All coordinates must be finite and rectangle
// sizes nonnegative. Fonts, screen scale, safe areas and preferences are inputs.
type Side is data = $Above | $Below | $Left | $Right
func attach (side: Side) -> (alignment: F32) -> (gap: F32) -> (size: Vec2) -> (anchor: Vec2) => return do:
  let a = clamp 0.0 1.0 alignment
  let (x, y) = case side of
    $Above => (anchor.x - size.x * a, anchor.y - size.y - gap)
    $Below => (anchor.x - size.x * a, anchor.y + gap)
    $Left => (anchor.x - size.x - gap, anchor.y - size.y * a)
    $Right => (anchor.x + gap, anchor.y - size.y * a)
  return $Rect { x, y, width: size.x, height: size.y }
// Oversized panels retain their size and align to the low edge. The caller
// can then scroll/clip them; layout never silently shrinks content.
func fit (bounds: Rect) -> (panel: Rect) => return $Rect {
  x: clamp bounds.x (bounds.x + max 0.0 (bounds.width - panel.width)) panel.x,
  y: clamp bounds.y (bounds.y + max 0.0 (bounds.height - panel.height)) panel.y,
  width: panel.width, height: panel.height,
}
func overflow (bounds: Rect) -> (panel: Rect) => return
  max 0.0 (bounds.x - panel.x) + max 0.0 (bounds.y - panel.y) +
  max 0.0 (panel.x + panel.width - bounds.x - bounds.width) +
  max 0.0 (panel.y + panel.height - bounds.y - bounds.height)
// Caller-ordered candidates: first fit wins, otherwise least overflow then
// input order. An empty candidate list has no placement.
func place (bounds: Rect) -> (candidates: Array Rect) => return do:
  if candidates.length == 0:
    return $Nothing
  let best = candidates[0]
  let amount = overflow bounds best
  for i in 1 .. candidates.length:
    if amount == 0.0:
      break
    let next = overflow bounds candidates[i]
    if next < amount:
      best := candidates[i]
      amount := next
  return $Some (fit bounds best)
