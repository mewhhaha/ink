//! Pure layout in caller units. All coordinates must be finite and rectangle
//! sizes nonnegative. Fonts, screen scale, safe areas and preferences are inputs.
//!
//! Key items: [`Side`], [`attach`], [`fit`], [`overflow`], [`place`].
//!
//! ```blot
//! import * as math from "ink/math"
//! import * as anchor from "ink/ui/anchor"
//! let r = anchor.attach $anchor.Below 0.0 4.0 (math.vec2 80.0 30.0) (math.vec2 100.0 20.0)
//! #[r.y, r.height] // => #[24.0, 30.0]
//! ```

import { Vec2 } from "std/vector"
import { Rect } from "../ui"

type Side is data = $Above | $Below | $Left | $Right
func attach (side: Side) -> (alignment: F32) -> (gap: F32) -> (size: Vec2) -> (anchor: Vec2) =>
  let a = if is_finite alignment then clamp 0.0 1.0 alignment else 0.0
  let g = if is_finite gap then gap else 0.0
  let w = if is_finite size.x then max 0.0 size.x else 0.0
  let h = if is_finite size.y then max 0.0 size.y else 0.0
  let ax = if is_finite anchor.x then anchor.x else 0.0
  let ay = if is_finite anchor.y then anchor.y else 0.0
  let (rx, ry) = case side of
    $Above => (ax - w * a, ay - h - g)
    $Below => (ax - w * a, ay + g)
    $Left => (ax - w - g, ay - h * a)
    $Right => (ax + g, ay - h * a)
  let x = if is_finite rx then rx else ax
  let y = if is_finite ry then ry else ay
  return $Rect { x, y, width: w, height: h }
// Oversized panels retain their size and align to the low edge. The caller
// can then scroll/clip them; layout never silently shrinks content.
func fit (bounds: Rect) -> (panel: Rect) =>
  let bx = if is_finite bounds.x then bounds.x else 0.0
  let by = if is_finite bounds.y then bounds.y else 0.0
  let bw = if is_finite bounds.width then max 0.0 bounds.width else 0.0
  let bh = if is_finite bounds.height then max 0.0 bounds.height else 0.0
  let px = if is_finite panel.x then panel.x else bx
  let py = if is_finite panel.y then panel.y else by
  let pw = if is_finite panel.width then max 0.0 panel.width else 0.0
  let ph = if is_finite panel.height then max 0.0 panel.height else 0.0
  let span_x = max 0.0 (bw - pw)
  let span_y = max 0.0 (bh - ph)
  let max_x = bx + span_x
  let max_y = by + span_y
  let fx = if is_finite max_x then clamp bx max_x px else max bx px
  let fy = if is_finite max_y then clamp by max_y py else max by py
  return $Rect { x: fx, y: fy, width: pw, height: ph }
func overflow (bounds: Rect) -> (panel: Rect) => return
  max 0.0 (bounds.x - panel.x) + max 0.0 (bounds.y - panel.y) +
  max 0.0 (panel.x + panel.width - bounds.x - bounds.width) +
  max 0.0 (panel.y + panel.height - bounds.y - bounds.height)
// Caller-ordered candidates: first fit wins, otherwise least overflow then
// input order. An empty candidate list has no placement.
func place (bounds: Rect) -> (candidates: #[Rect]) =>
  if candidates.length == 0:
    return $Nothing
  let found = false
  let best = candidates[0]
  let amount = 0.0
  for i in 0 .. candidates.length:
    let next = overflow bounds candidates[i]
    if is_finite next:
      if not found or next < amount:
        best := candidates[i]
        amount := next
        found := true
      if amount == 0.0:
        break
  return if found then $Some (fit bounds best) else $Nothing
