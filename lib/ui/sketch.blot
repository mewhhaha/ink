// Flat persistent state carried by the caller across frames (no nested arrays).
type State is data = $State {
  pointer: Vec2,
  pointer_down: Bool,
  just_pressed: Bool,
  just_released: Bool,
  hot_id: U32,
  active_id: U32,
  focused_id: U32,
  first_focusable: U32,
  last_focusable: U32,
  next_focusable: U32,
  prev_focusable: U32,
  pending_tab: U32,
  shift_down: Bool,
  key_left: Bool,
  key_right: Bool,
  key_up: Bool,
  key_down: Bool,
  key_enter: Bool,
  key_backspace: Bool,
  key_escape: Bool,
  action_node: U32,
  action_kind: U32,
  action_value: F32,
  typed_char: U32,
  scroll_delta: F32,
  frame_count: U32,
}

func init_state () : State =>
  return $State {
    pointer: math.vec2 (-1000.0) (-1000.0),
    pointer_down: false,
    just_pressed: false,
    just_released: false,
    hot_id: 0,
    active_id: 0,
    focused_id: 0,
    first_focusable: 0,
    last_focusable: 0,
    next_focusable: 0,
    prev_focusable: 0,
    pending_tab: 0,
    shift_down: false,
    key_left: false,
    key_right: false,
    key_up: false,
    key_down: false,
    key_enter: false,
    key_backspace: false,
    key_escape: false,
    action_node: 0,
    action_kind: 0,
    action_value: 0.0,
    typed_char: 0,
    scroll_delta: 0.0,
    frame_count: 0,
  }

func feed_event (ev: events.Event) -> (state: State) : State =>
  let s = state
  case ev of
    $events.PointerMove { x, y } => do:
      s.pointer := math.vec2 x y
      break ()
    $events.PointerDown { button, x, y } => do:
      s.pointer := math.vec2 x y
      if button == 0:
        s.pointer_down := true
        s.just_pressed := true
      break ()
    $events.PointerUp { button, x, y } => do:
      s.pointer := math.vec2 x y
      if button == 0:
        s.pointer_down := false
        s.just_released := true
      break ()
    $events.Wheel { delta, x, y } => do:
      s.pointer := math.vec2 x y
      s.scroll_delta := s.scroll_delta + delta
      break ()
    $events.KeyDown code => do:
      if code == keys.shift:
        s.shift_down := true
      if code == keys.tab:
        if s.first_focusable == 0 or s.pending_tab == 3:
          s.pending_tab := if s.shift_down then 2 else 1
        else:
          if s.shift_down:
            s.focused_id := if s.focused_id == 0 then s.last_focusable else s.prev_focusable
          else:
            s.focused_id := if s.focused_id == 0 then s.first_focusable else s.next_focusable
          s.pending_tab := 3
      if code == keys.f10:
        if s.focused_id != 0:
          s.focused_id := 0
        else:
          if s.first_focusable != 0:
            s.focused_id := s.first_focusable
          else:
            s.pending_tab := 1
      if code == keys.left:
        s.key_left := true
      if code == keys.right:
        s.key_right := true
      if code == keys.up:
        s.key_up := true
      if code == keys.down:
        s.key_down := true
      if code == keys.enter or code == keys.space:
        s.key_enter := true
      if code == keys.backspace:
        s.key_backspace := true
      if code == keys.escape:
        s.key_escape := true
        s.focused_id := 0
      break ()
    $events.KeyUp code => do:
      if code == keys.shift:
        s.shift_down := false
      break ()
    $events.UiAction { node, action, value } => do:
      if action == vocabulary.action_focus:
        s.focused_id := node
      else:
        if action == vocabulary.action_blur:
          if s.focused_id == node:
            s.focused_id := 0
        else:
          s.focused_id := node
          s.action_node := node
          s.action_kind := action
          s.action_value := value
      break ()
    $events.TextInput { character, composing } => do:
      if composing == 0 and character >= 32 and character <= 126:
        s.typed_char := character
      break ()
    $events.FocusLost => do:
      s.pointer_down := false
      s.active_id := 0
      s.shift_down := false
      break ()
    _ => ()
  return s

func feed_events (evs: &[events.Event]) -> (state: State) : State =>
  let s = state
  for ev in evs:
    s := feed_event ev self
  return s

// Per-frame immediate-mode UI builder carrying layout cursor + GPU draw lists + a11y nodes.
type Ui is data = $Ui {
  state: State,
  theme: Theme,
  viewport: Vec2,
  time: F32,
  boil: U32,
  next_id: U32,
  cursor: Vec2,
  panel_rect: math.Vec4,
  panel_id: U32,
  content_x: F32,
  content_w: F32,
  row_active: Bool,
  row_cols: U32,
  row_col: U32,
  row_x: F32,
  row_y: F32,
  row_w: F32,
  row_max_h: F32,
  shapes: #[d2.SdfShape],
  segments: #[lines.Segment],
  nodes: #[tree.StoredNode],
  labels: #[U32],
}

private func compute_boil (time: F32) -> (fps: F32) : U32 =>
  if fps <= 0.0 or time <= 0.0:
    return 0
  return F32.to_u32 (floor (time * fps))

func begin (state: State) -> (viewport: Vec2) -> (time: F32) -> (theme: Theme) : Ui =>
  let s = state
  s.hot_id := 0
  let boil = compute_boil time theme.boil_fps
  return $Ui {
    state: s,
    theme,
    viewport,
    time,
    boil,
    next_id: 1,
    cursor: math.vec2 theme.padding_px theme.padding_px,
    panel_rect: math.vec4 0.0 0.0 viewport.x viewport.y,
    panel_id: 0,
    content_x: theme.padding_px,
    content_w: max 40.0 (viewport.x - theme.padding_px * 2.0),
    row_active: false,
    row_cols: 1,
    row_col: 0,
    row_x: theme.padding_px,
    row_y: theme.padding_px,
    row_w: max 40.0 (viewport.x - theme.padding_px * 2.0),
    row_max_h: 0.0,
    shapes: #[],
    segments: #[],
    nodes: #[],
    labels: #[],
  }

// Reuse existing GPU/accessibility arrays across frames without reallocating.
func reuse_into (ui: own Ui) -> (state: State) -> (viewport: Vec2) -> (time: F32) -> (theme: Theme) : Ui =>
  let s = state
  s.hot_id := 0
  @storage.truncate ui.shapes 0
  @storage.truncate ui.segments 0
  @storage.truncate ui.nodes 0
  @storage.truncate ui.labels 0
  ui.state := s
  ui.theme := theme
  ui.viewport := viewport
  ui.time := time
  ui.boil := compute_boil time theme.boil_fps
  ui.next_id := 1
  ui.cursor := math.vec2 theme.padding_px theme.padding_px
  ui.panel_rect := math.vec4 0.0 0.0 viewport.x viewport.y
  ui.panel_id := 0
  ui.content_x := theme.padding_px
  ui.content_w := max 40.0 (viewport.x - theme.padding_px * 2.0)
  ui.row_active := false
  ui.row_cols := 1
  ui.row_col := 0
  ui.row_x := theme.padding_px
  ui.row_y := theme.padding_px
  ui.row_w := ui.content_w
  ui.row_max_h := 0.0
  return ui

// --- Deterministic hand-drawn wobble hash & sketchy primitive builders ---

private func mix_u32 (x: U32) : U32 =>
  let h = (x ^ (x >> 16)) * 0x7feb352d
  let h2 = (h ^ (h >> 15)) * 0x846ca68b
  return h2 ^ (h2 >> 16)

// Deterministic float in [-1.0, 1.0].
private func jitter (seed: U32) -> (boil: U32) -> (idx: U32) : F32 =>
  let h = mix_u32 (seed * 2654435761 ^ (boil * 2246822519) ^ (idx * 3266489917))
  let unit = U32.to_f32 (h & 65535) / 32767.5
  return unit - 1.0

private func marker_style (width: F32) : lines.LineStyle =>
  return $lines.LineStyle {
    width_px: width,
    dash_len_px: 0.0,
    gap_len_px: 0.0,
    feather_px: 0.85,
    layer: $lines.OnTop,
  }

private func dashed_style (width: F32) -> (dash: F32) -> (gap: F32) : lines.LineStyle =>
  return $lines.LineStyle {
    width_px: width,
    dash_len_px: dash,
    gap_len_px: gap,
    feather_px: 0.85,
    layer: $lines.OnTop,
  }

// Hand-drawn wobbly line with subtle felt-tip corner overshoots and midpoint bow.
private func push_sketch_line (p0: Vec2) -> (p1: Vec2) -> (color: math.Vec4) -> (width: F32) -> (wobble: F32) -> (overshoot: F32) -> (seed: U32) -> (boil: U32) -> (segments: own #[lines.Segment]) : #[lines.Segment] =>
  let dx = p1.x - p0.x
  let dy = p1.y - p0.y
  let len = sqrt (dx * dx + dy * dy)
  if len < 0.25:
    return segments
  let inv_len = 1.0 / len
  let ux = dx * inv_len
  let uy = dy * inv_len
  let nx = -uy
  let ny = ux
  let ov0 = overshoot * (0.55 + 0.45 * jitter seed boil 1)
  let ov1 = overshoot * (0.55 + 0.45 * jitter seed boil 2)
  let sx = p0.x - ux * ov0
  let sy = p0.y - uy * ov0
  let ex = p1.x + ux * ov1
  let ey = p1.y + uy * ov1
  let span_x = ex - sx
  let span_y = ey - sy
  let steps = max 2 (min 14 (F32.to_u32 (ceil (len / 26.0))))
  let inv_steps = 1.0 / U32.to_f32 steps
  let style = marker_style width
  let prev = math.vec2 0.0 0.0
  for i in 0 .. (steps + 1):
    let t = U32.to_f32 i * inv_steps
    let bx = sx + span_x * t
    let by = sy + span_y * t
    let end_fade = if i == 0 or i == steps then 0.55 else 1.0
    let jn = jitter seed boil (10 + i * 2) * wobble * end_fade
    let jt = jitter seed boil (11 + i * 2) * wobble * 0.25
    let pt = math.vec2 (bx + nx * jn + ux * jt) (by + ny * jn + uy * jt)
    if i > 0:
      segments := lines.push_line_2d prev pt (i > 1) color style self
    prev := pt
  return segments

// Four independent hand-ruled strokes with crooked joints + corner overshoots.
private func push_sketch_rect (r: math.Vec4) -> (color: math.Vec4) -> (width: F32) -> (wobble: F32) -> (overshoot: F32) -> (seed: U32) -> (boil: U32) -> (double_ink: Bool) -> (segments: own #[lines.Segment]) : #[lines.Segment] =>
  let x0 = r.x
  let y0 = r.y
  let x1 = r.x + r.z
  let y1 = r.y + r.w
  let tl = math.vec2 x0 y0
  let tr = math.vec2 x1 y0
  let br = math.vec2 x1 y1
  let bl = math.vec2 x0 y1
  segments := push_sketch_line tl tr color width wobble overshoot (seed * 17 + 1) boil self
  segments := push_sketch_line tr br color width wobble overshoot (seed * 17 + 2) boil self
  segments := push_sketch_line br bl color width wobble overshoot (seed * 17 + 3) boil self
  segments := push_sketch_line bl tl color width wobble overshoot (seed * 17 + 4) boil self
  if double_ink:
    let thin = max 1.1 (width * 0.62)
    let j = 1.2
    let tl2 = math.vec2 (x0 + j) (y0 - j * 0.6)
    let tr2 = math.vec2 (x1 - j * 0.5) (y0 + j * 0.7)
    let br2 = math.vec2 (x1 + j * 0.6) (y1 + j * 0.5)
    let bl2 = math.vec2 (x0 - j * 0.6) (y1 - j * 0.5)
    segments := push_sketch_line tl2 tr2 color thin (wobble * 1.15) (overshoot * 1.2) (seed * 31 + 5) boil self
    segments := push_sketch_line tr2 br2 color thin (wobble * 1.15) (overshoot * 1.2) (seed * 31 + 6) boil self
    segments := push_sketch_line br2 bl2 color thin (wobble * 1.15) (overshoot * 1.2) (seed * 31 + 7) boil self
    segments := push_sketch_line bl2 tl2 color thin (wobble * 1.15) (overshoot * 1.2) (seed * 31 + 8) boil self
  return segments

// Quick diagonal Drawful crayon/marker hatching across a rectangle.
private func push_sketch_hatch (r: math.Vec4) -> (color: math.Vec4) -> (spacing: F32) -> (width: F32) -> (wobble: F32) -> (seed: U32) -> (boil: U32) -> (segments: own #[lines.Segment]) : #[lines.Segment] =>
  let w = r.z
  let h = r.w
  if w < 3.0 or h < 3.0 or spacing < 2.0:
    return segments
  let total = w + h
  let count = min 64 (F32.to_u32 (total / spacing))
  let inset = 2.0
  for i in 1 .. count:
    let d = U32.to_f32 i * spacing
    let ax = r.x + max inset (d - h + inset)
    let ay = r.y + min (h - inset) (d - inset)
    let bx = r.x + min (w - inset) (d - inset)
    let by = r.y + max inset (d - w + inset)
    if bx > ax + 1.0 and ay > by + 1.0:
      segments := push_sketch_line (math.vec2 ax ay) (math.vec2 bx by) color width (wobble * 0.7) 0.5 (seed * 53 + i) boil self
  return segments

private const circle_cos: #[F32] = #[
  0.9838437, 0.8087345, 0.4734456, 0.0443849, -0.3934667, -0.7533875, -0.9640906, -0.9838437,
  -0.8087345, -0.4734456, -0.0443849, 0.3934667, 0.7533875, 0.9640906, 0.9838437, 0.8087345,
]
private const circle_sin: #[F32] = #[
  0.1790296, 0.5881739, 0.8808231, 0.9990145, 0.9193389, 0.6575769, 0.2655737, -0.1790296,
  -0.5881738, -0.8808231, -0.9990145, -0.9193389, -0.6575769, -0.2655737, 0.1790296, 0.5881738,
]

// Crooked hand-drawn marker loop with slight closure overlap.
private func push_sketch_circle (center: Vec2) -> (radius: F32) -> (color: math.Vec4) -> (width: F32) -> (wobble: F32) -> (seed: U32) -> (boil: U32) -> (segments: own #[lines.Segment]) : #[lines.Segment] =>
  if radius < 1.0:
    return segments
  let style = marker_style width
  let j_scale = min (wobble * 0.75) (radius * 0.18)
  let prev = math.vec2 0.0 0.0
  for i in 0 .. 16:
    let rj = radius + jitter seed boil (i * 3 + 1) * j_scale
    let pt = math.vec2 (center.x + circle_cos[i] * rj) (center.y + circle_sin[i] * rj)
    if i > 0:
      segments := lines.push_line_2d prev pt (i > 1) color style self
    prev := pt
  return segments

// Offset flat paper/crayon fill (SDF overlay, slightly misregistered for hand-colored charm).
private func push_paper_fill (r: math.Vec4) -> (radius: F32) -> (color: math.Vec4) -> (shapes: own #[d2.SdfShape]) : #[d2.SdfShape] =>
  if r.z <= 0.5 or r.w <= 0.5 or color.w <= 0.001:
    return shapes
  let s = d2.rounded_rect r (math.vec4 radius radius radius radius) color
  s.overlay := true
  @storage.push shapes s
  return shapes

private func push_circle_fill (center: Vec2) -> (radius: F32) -> (color: math.Vec4) -> (shapes: own #[d2.SdfShape]) : #[d2.SdfShape] =>
  if radius <= 0.5 or color.w <= 0.001:
    return shapes
  let s = d2.circle center radius color
  s.overlay := true
  @storage.push shapes s
  return shapes

// --- Asset-free rudimentary Drawful marker stroke font (printable ASCII 33..126) ---
// Each byte encodes (X << 4) | Y on an 8x10 cap-height grid (Y=13 descender); 0xFF = pen up.
// Flattened into two static const arrays for O(1) direct indexing and zero per-glyph allocations.

private const glyph_starts: #[U32] = #[
  0, 5, 10, 21, 36, 50, 62, 64, 69, 74, 82, 87, 89, 91, 96, 98,
  110, 116, 123, 134, 138, 147, 157, 160, 176, 186, 191, 196, 199, 204, 207, 217,
  231, 237, 250, 258, 265, 272, 278, 288, 296, 304, 312, 318, 321, 326, 330, 339,
  346, 358, 368, 379, 384, 390, 393, 398, 403, 409, 413, 417, 419, 423, 426, 428,
  430, 441, 452, 460, 471, 480, 487, 500, 508, 513, 520, 526, 530, 542, 550, 559,
  570, 581, 587, 597, 604, 611, 614, 619, 624, 630, 634, 641, 643, 650, 654,
]

private const glyph_data: #[U32] = #[
  0x40, 0x46, 0xFF, 0x49, 0x4A, 0x20, 0x23, 0xFF, 0x60, 0x63, 0x21, 0x19, 0xFF, 0x61, 0x59, 0xFF,
  0x03, 0x83, 0xFF, 0x07, 0x87, 0x72, 0x51, 0x21, 0x12, 0x14, 0x35, 0x66, 0x77, 0x79, 0x5A, 0x2A,
  0x19, 0xFF, 0x40, 0x4B, 0x1A, 0x70, 0xFF, 0x11, 0x31, 0x33, 0x13, 0x11, 0xFF, 0x57, 0x77, 0x79,
  0x59, 0x57, 0x8A, 0x24, 0x12, 0x30, 0x50, 0x62, 0x54, 0x16, 0x19, 0x3A, 0x5A, 0x86, 0x40, 0x33,
  0x60, 0x32, 0x25, 0x38, 0x6A, 0x20, 0x52, 0x65, 0x58, 0x2A, 0x41, 0x47, 0xFF, 0x12, 0x76, 0xFF,
  0x72, 0x16, 0x42, 0x48, 0xFF, 0x15, 0x75, 0x49, 0x3B, 0x15, 0x75, 0x39, 0x49, 0x4A, 0x3A, 0x39,
  0x1A, 0x70, 0x20, 0x60, 0x72, 0x78, 0x6A, 0x2A, 0x18, 0x12, 0x20, 0xFF, 0x28, 0x62, 0x22, 0x40,
  0x4A, 0xFF, 0x2A, 0x6A, 0x12, 0x20, 0x60, 0x72, 0x74, 0x1A, 0x8A, 0x11, 0x30, 0x60, 0x72, 0x64,
  0x35, 0x66, 0x78, 0x6A, 0x3A, 0x19, 0x6A, 0x60, 0x16, 0x86, 0x70, 0x10, 0x14, 0x54, 0x76, 0x78,
