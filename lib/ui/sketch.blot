//! Rudimentary, Drawful-inspired immediate-mode ("egui-style") UI built purely
//! on Ink's SDF overlay (65008) and 2D antialiased polyline (65006) extensions.
//! Zero font atlases, textures, or external assets required.
//!
//! Key items: [`Theme`], [`State`], [`Ui`], [`init_state`], [`feed_event`].
//!
//! ```blot
//! import * as math from "ink/math"
//! import * as render from "ink/render"
//! let ui = begin (init_state ()) (math.vec2 640.0 480.0) 0.5 paper_theme
//! ui := panel "SKETCH" (math.vec4 16.0 16.0 240.0 200.0) self
//! let (_, ui) = button "PLAY!" ui
//! ui := end_panel self
//! let (_, frame) = finish_into ui (render.empty_frame ())
//! frame.extensions.length // => 2
//! ```

import { Vec2 } from "std/vector"
import * as math from "../math"
import * as events from "../events"
import * as keys from "../input/keys"
import * as render from "../render"
import * as d2 from "../render/d2"
import * as lines from "../render/lines"
import * as tree from "./tree"
import * as vocabulary from "./vocabulary"

type Theme is data = $Theme {
  paper: math.Vec4,
  panel_header: math.Vec4,
  ink: math.Vec4,
  muted_ink: math.Vec4,
  accent: math.Vec4,
  highlight: math.Vec4,
  secondary: math.Vec4,
  shadow: math.Vec4,
  widget_fill: math.Vec4,
  wobble_px: F32,
  overshoot_px: F32,
  stroke_px: F32,
  boil_fps: F32,
  font_px: F32,
  padding_px: F32,
  spacing_px: F32,
}

