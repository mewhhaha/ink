import { Vec2 } from "std/vector"
import * as math from "../math"
import * as events from "../events"
import * as keys from "../input/keys"
import * as render from "../render"
import * as d2 from "../render/d2"
import * as lines from "../render/lines"
import * as tree from "./tree"
import * as vocabulary from "./vocabulary"

// Rudimentary, Drawful-inspired immediate-mode ("egui-style") UI built purely
// on Ink's SDF overlay (65008) and 2D antialiased polyline (65006) extensions.
// Zero font atlases, textures, or external assets required.
//
// Typical per-frame usage:
//   let state = sketch.feed_events (&evs[0..evs.length]) state
//   let ui = sketch.begin state viewport time sketch.paper_theme
//   ui := sketch.panel "SKETCH PAD" (math.vec4 24.0 24.0 300.0 380.0) self
//   ui := sketch.heading "DRAWFUL UI" self
//   let (clicked, ui) = sketch.button "PLAY!" ui
//   let (checked, ui) = sketch.checkbox "SOUND FX" sound ui
//   let (vol, ui) = sketch.slider "VOLUME" vol 0.0 1.0 ui
//   let (next_state, frame) = sketch.finish_into ui frame

type Theme is data = $Theme {
  paper: math.Vec4,
  panel_header: math.Vec4,
  ink: math.Vec4,
  muted_ink: math.Vec4,
  accent: math.Vec4,
  highlight: math.Vec4,
  secondary: math.Vec4,
  shadow: math.Vec4,
  widget_fill: math.Vec4,
  wobble_px: F32,
  overshoot_px: F32,
  stroke_px: F32,
  boil_fps: F32,
  font_px: F32,
  padding_px: F32,
  spacing_px: F32,
}

