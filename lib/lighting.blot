import { Vec3 } from "std/vector"
import * as math from "./math"

type Material is data = #Material { base: math.Color, metallic: F32, roughness: F32, emission: math.Color }
type Light is data =
  | #Directional { direction: Vec3, radiance: math.Color }
  | #Point { position: Vec3, intensity: math.Color, range: F32 }
  | #Spot { position: Vec3, direction: Vec3, intensity: math.Color, range: F32, inner_cos: F32, outer_cos: F32 }
type Sample is data = #Sample { direction: Vec3, radiance: math.Color }
const default_material = #Material { base: math.rgb 1.0 1.0 1.0, metallic: 0.0, roughness: 0.5, emission: math.rgb 0.0 0.0 0.0 }

const product = fn (a: math.Color) => fn (b: math.Color) => math.rgb (a.r * b.r) (a.g * b.g) (a.b * b.b)
const add = fn (a: math.Color) => fn (b: math.Color) => math.rgb (a.r + b.r) (a.g + b.g) (a.b + b.b)
const attenuation = fn (distance: F32) => fn (range: F32) => do:
  if range <= 0.0 || distance >= range:
    return 0.0
  let ratio = distance / range
  let fade = saturate (1.0 - ratio * ratio * ratio * ratio)
  return fade * fade / max 0.0001 (distance * distance)

// Directions normalize as Vec3.normalized does, a zero vector staying zero,
// written out in scalars so that only the sample is allocated.
private const sample_at = fn (light: Light) => fn (px: F32) => fn (py: F32) => fn (pz: F32) => case light of
  #Directional { direction, radiance } => do:
    let #Vec3 { x, y, z } = direction
    let length = sqrt (x * x + y * y + z * z)
    if length != 0.0:
      x := self / length
      y := self / length
      z := self / length
    return #Sample { direction: #Vec3 { x: x * (-1.0), y: y * (-1.0), z: z * (-1.0) }, radiance }
  #Point { position, intensity, range } => do:
    let x = position.x - px
    let y = position.y - py
    let z = position.z - pz
    let distance = sqrt (x * x + y * y + z * z)
    let fade = attenuation distance range
    if distance != 0.0:
      x := self / distance
      y := self / distance
      z := self / distance
    let #math.Color { r, g, b, a } = intensity
    return #Sample { direction: #Vec3 { x, y, z }, radiance: #math.Color { r: r * fade, g: g * fade, b: b * fade, a } }
  #Spot { position, direction, intensity, range, inner_cos, outer_cos } => do:
    let x = position.x - px
    let y = position.y - py
    let z = position.z - pz
    let distance = sqrt (x * x + y * y + z * z)
    if distance != 0.0:
      x := self / distance
      y := self / distance
      z := self / distance
    let #Vec3 { x: dx, y: dy, z: dz } = direction
    let length = sqrt (dx * dx + dy * dy + dz * dz)
    if length != 0.0:
      dx := self / length
      dy := self / length
      dz := self / length
    let facing = dx * (x * (-1.0)) + dy * (y * (-1.0)) + dz * (z * (-1.0))
    let cone = saturate ((facing - outer_cos) / max 0.00001 (inner_cos - outer_cos))
    let fade = attenuation distance range * cone * cone
    let #math.Color { r, g, b, a } = intensity
    return #Sample { direction: #Vec3 { x, y, z }, radiance: #math.Color { r: r * fade, g: g * fade, b: b * fade, a } }
const sample = fn (light: Light) => fn (point: Vec3) => sample_at light point.x point.y point.z

// GGX normal distribution, height-correlated Smith visibility and Schlick
// Fresnel, with an energy-conserving Lambert diffuse lobe. V and L point out
// of the surface. The response includes NoL and is scaled by radiance (rr,
// rg, rb). It runs on scalar parts, normalizing as Vec3.normalized does, and
// allocates only its result.
private const reflected = fn (material: Material) => fn (nx: F32) => fn (ny: F32) => fn (nz: F32) => fn (vx: F32) => fn (vy: F32) => fn (vz: F32) => fn (lx: F32) => fn (ly: F32) => fn (lz: F32) => fn (rr: F32) => fn (rg: F32) => fn (rb: F32) => do:
  let nn = sqrt (nx * nx + ny * ny + nz * nz)
  if nn != 0.0:
    nx := self / nn
    ny := self / nn
    nz := self / nn
  let vn = sqrt (vx * vx + vy * vy + vz * vz)
  if vn != 0.0:
    vx := self / vn
    vy := self / vn
    vz := self / vn
  let ln = sqrt (lx * lx + ly * ly + lz * lz)
  if ln != 0.0:
    lx := self / ln
    ly := self / ln
    lz := self / ln
  let nl = saturate (nx * lx + ny * ly + nz * lz)
  let facing = nx * vx + ny * vy + nz * vz
  let nv = max 0.00001 facing
  if nl <= 0.0 || facing <= 0.0:
    return #math.Color { r: 0.0 * rr, g: 0.0 * rg, b: 0.0 * rb, a: 1.0 }
  let hx = vx + lx
  let hy = vy + ly
  let hz = vz + lz
  let hn = sqrt (hx * hx + hy * hy + hz * hz)
  if hn != 0.0:
    hx := self / hn
    hy := self / hn
    hz := self / hn
  let nh = saturate (nx * hx + ny * hy + nz * hz)
  let vh = saturate (vx * hx + vy * hy + vz * hz)
  let rough = clamp 0.04 1.0 material.roughness
  let a = rough * rough
  let a2 = a * a
  let denominator = nh * nh * (a2 - 1.0) + 1.0
  let distribution = a2 / (3.14159265359 * denominator * denominator)
  let visibility = 0.5 / max 0.000001 (nl * sqrt (nv * nv * (1.0 - a2) + a2) + nv * sqrt (nl * nl * (1.0 - a2) + a2))
  let metallic = saturate material.metallic
  let #math.Color { r: br, g: bg, b: bb } = material.base
  let t = 1.0 - vh
  let schlick = t * t * t * t * t
  // Fresnel runs from f0, the base colour's lerp from 0.04 by metallic, to 1.
  let fr = F32.lerp (F32.lerp 0.04 br metallic) 1.0 schlick
  let fg = F32.lerp (F32.lerp 0.04 bg metallic) 1.0 schlick
  let fb = F32.lerp (F32.lerp 0.04 bb metallic) 1.0 schlick
  let diffuse = (1.0 - metallic) / 3.14159265359
  let specular = distribution * visibility
  return #math.Color {
    r: (br * (1.0 - fr) * diffuse + fr * specular) * nl * rr,
    g: (bg * (1.0 - fg) * diffuse + fg * specular) * nl * rg,
    b: (bb * (1.0 - fb) * diffuse + fb * specular) * nl * rb,
    a: 1.0,
  }
// Scaling by one radiance is exact, so brdf is the same response.
const brdf = fn (material: Material) => fn (normal: Vec3) => fn (view: Vec3) => fn (light: Vec3) =>
  reflected material normal.x normal.y normal.z view.x view.y view.z light.x light.y light.z 1.0 1.0 1.0
const shade = fn (material: Material) => fn (normal: Vec3) => fn (view: Vec3) => fn (sample: Sample) => do:
  let #Sample { direction: l, radiance: c } = sample
  return reflected material normal.x normal.y normal.z view.x view.y view.z l.x l.y l.z c.r c.g c.b
