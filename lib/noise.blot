//! Procedural noise for games: value and gradient (Perlin) noise in 1D, 2D
//! and 3D, and fractal sums. Deterministic for a seed. Results are roughly
//! in [-1, 1].
//! Use it for terrain heights, wind, wobble, camera shake, spawn variation.
//!
//! Key items: [`hash3`], [`unit`], [`cell`], [`fade`], [`gradient`].
//!
//! ```blot
//! import * as math from "ink/math"
//! let a = perlin2 7 (math.vec2 1.25 2.5)
//! let b = perlin2 7 (math.vec2 1.25 2.5)
//! a == b and a >= -1.0 and a <= 1.0 // => true
//! ```

import * as simd from "std/simd"
import { Vec2, Vec3 } from "std/vector"

// A 32-bit hash of lattice coordinates (U32 wraps): their products with odd
// constants combined, then mixed.
private func mixed (h: U32) : U32 =>
  h := self ^ (self >> 15)
  h := self * 2246822507
  h := self ^ (self >> 13)
  h := self * 3266489909
  return h ^ (h >> 16)
func hash3 (x: U32) => func (y: U32) => func (z: U32) => func (seed: U32) : U32 => return
  mixed (x * 2747636419 ^ y * 2654435769 ^ z * 2246822519 ^ seed * 3266489917)

func unit (h: U32): F32 => U32.to_f32 (h >> 8) / 16777216.0

// Lattice coordinate of a float: floor, as a wrapping U32.
private func cell_floor (f: F32) : U32 =>
  if f >= 0.0:
    if f < 4294967296.0:
      return F32.to_u32 f
    let w = f - floor (f / 4294967296.0) * 4294967296.0
    return if is_finite w and w >= 0.0 and w < 4294967296.0 then F32.to_u32 w else 0
  let mag = 0.0 - f
  if mag < 4294967296.0:
    return 0 - F32.to_u32 mag
  let w = mag - floor (mag / 4294967296.0) * 4294967296.0
  return if is_finite w and w >= 0.0 and w < 4294967296.0 then 0 - F32.to_u32 w else 0

func cell (v: F32) : U32 =>
  if not (is_finite v):
    return 0
  return cell_floor (floor v)

func fade (t: F32): F32 => t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

// k is below 12, so the classic table's k == 12 or 14 case for v never arises.
func gradient (h: U32) => func (x: F32) => func (y: F32) => func (z: F32): F32 =>
  let k = h % 12
  let u = if k < 8 then x else y
  let v = if k < 4 then y else z
  let a = if (k & 1) == 0 then u else 0.0 - u
  let b = if (k & 2) == 0 then v else 0.0 - v
  return a + b

// The top two bits of (h >> 2) times the inverse of 3 encode the
// three gradient bands as 0, 2, 1. The low bits of h still select signs.
private func corner_gradient (h: U32) -> (x: F32) -> (y: F32) -> (z: F32) : F32 =>
  let band = ((h >> 2) * 0xAAAAAAAB) >> 30
  let u = if band != 1 then x else y
  let v = if band == 0 then y else z
  let a = if (h & 1) == 0 then u else 0.0 - u
  let b = if (h & 2) == 0 then v else 0.0 - v
  return a + b

// Keep SIMD corner values local to each kernel. Passing these tuples through
// ordinary calls materializes their lanes in guest memory.
// Gradient noise in 3D. The eight corners are written out: a closure over the
// corner offsets made this five times slower (about 1 us for three octaves).
// The kernel takes coordinates, so callers never box a point to call it.
private func perlin3_mixed (s: U32) => func (x: F32) => func (y: F32) => func (z: F32): F32 =>
  let signed_cells = abs x < 2147483648.0 and abs y < 2147483648.0 and abs z < 2147483648.0
  if not signed_cells and not (is_finite x and is_finite y and is_finite z):
    return 0.0
  let fx = floor x
  let fy = floor y
  let fz = floor z
  let (xi, yi, zi, _) = simd.to_u32_signed (fx, fy, fz, 0.0)
  if not signed_cells:
    xi := cell_floor fx
    yi := cell_floor fy
    zi := cell_floor fz
  let xf = x - fx
  let yf = y - fy
  let zf = z - fz
  let xg = xf - 1.0
  let yg = yf - 1.0
  let zg = zf - 1.0
  let u = xf * xf * xf * (xf * (xf * 6.0 - 15.0) + 10.0)
  let v = yf * yf * yf * (yf * (yf * 6.0 - 15.0) + 10.0)
  let w = zf * zf * zf * (zf * (zf * 6.0 - 15.0) + 10.0)
  // Corner hashes share hash3's lattice products. Each blend is F32.lerp,
  // a + (b - a) t, written out.
  let xa = xi * 2747636419
  let xb = xa + 2747636419
  let ya = yi * 2654435769
  let yb = ya + 2654435769
  let za = zi * 2246822519
  let zb = za + 2246822519
  // The eight corner hashes, four lanes at a time: `mixed` written out on
  // the corners at xi, then on those at xi + 1, in the same lane order.
  let yz = (ya ^ za ^ s, yb ^ za ^ s, ya ^ zb ^ s, yb ^ zb ^ s)
  let near = simd.u32_xor (simd.u32_splat xa) yz
  let far = simd.u32_xor (simd.u32_splat xb) yz
  near := simd.u32_xor self (simd.u32_shr 15 self)
  far := simd.u32_xor self (simd.u32_shr 15 self)
  near := simd.u32_mul self (simd.u32_splat 2246822507)
  far := simd.u32_mul self (simd.u32_splat 2246822507)
  near := simd.u32_xor self (simd.u32_shr 13 self)
  far := simd.u32_xor self (simd.u32_shr 13 self)
  near := simd.u32_mul self (simd.u32_splat 3266489909)
  far := simd.u32_mul self (simd.u32_splat 3266489909)
  near := simd.u32_xor self (simd.u32_shr 16 self)
  far := simd.u32_xor self (simd.u32_shr 16 self)
  let (h000, h010, h001, h011) = near
  let (h100, h110, h101, h111) = far
  let a = corner_gradient h000 xf yf zf
  let b = corner_gradient h100 xg yf zf
  let x00 = a + (b - a) * u
  let a = corner_gradient h010 xf yg zf
  let b = corner_gradient h110 xg yg zf
  let x10 = a + (b - a) * u
  let a = corner_gradient h001 xf yf zg
  let b = corner_gradient h101 xg yf zg
  let x01 = a + (b - a) * u
  let a = corner_gradient h011 xf yg zg
  let b = corner_gradient h111 xg yg zg
  let x11 = a + (b - a) * u
  let y0 = x00 + (x10 - x00) * v
  let y1 = x01 + (x11 - x01) * v
  return y0 + (y1 - y0) * w
private func perlin2_mixed (s: U32) => func (x: F32) => func (y: F32): F32 =>
  let signed_cells = abs x < 2147483648.0 and abs y < 2147483648.0
  if not signed_cells and not (is_finite x and is_finite y):
    return 0.0
  let fx = floor x
  let fy = floor y
  let (xi, yi, _, _) = simd.to_u32_signed (fx, fy, 0.0, 0.0)
  if not signed_cells:
    xi := cell_floor fx
    yi := cell_floor fy
  let xf = x - fx
  let yf = y - fy
  let xg = xf - 1.0
  let yg = yf - 1.0
  let u = xf * xf * xf * (xf * (xf * 6.0 - 15.0) + 10.0)
  let v = yf * yf * yf * (yf * (yf * 6.0 - 15.0) + 10.0)
  let xa = xi * 2747636419
  let xb = xa + 2747636419
  let ya = yi * 2654435769
  let yb = ya + 2654435769
  let yz = (ya ^ s, yb ^ s, ya ^ 2246822519 ^ s, yb ^ 2246822519 ^ s)
  let near = simd.u32_xor (simd.u32_splat xa) yz
  let far = simd.u32_xor (simd.u32_splat xb) yz
  near := simd.u32_xor self (simd.u32_shr 15 self)
  far := simd.u32_xor self (simd.u32_shr 15 self)
  near := simd.u32_mul self (simd.u32_splat 2246822507)
  far := simd.u32_mul self (simd.u32_splat 2246822507)
  near := simd.u32_xor self (simd.u32_shr 13 self)
  far := simd.u32_xor self (simd.u32_shr 13 self)
  near := simd.u32_mul self (simd.u32_splat 3266489909)
  far := simd.u32_mul self (simd.u32_splat 3266489909)
  near := simd.u32_xor self (simd.u32_shr 16 self)
  far := simd.u32_xor self (simd.u32_shr 16 self)
  let (h000, h010, h001, h011) = near
  let (h100, h110, h101, h111) = far
  let a = corner_gradient h000 xf yf 0.5
  let b = corner_gradient h100 xg yf 0.5
  let x00 = a + (b - a) * u
  let a = corner_gradient h010 xf yg 0.5
  let b = corner_gradient h110 xg yg 0.5
  let x10 = a + (b - a) * u
  let a = corner_gradient h001 xf yf (-0.5)
  let b = corner_gradient h101 xg yf (-0.5)
  let x01 = a + (b - a) * u
  let a = corner_gradient h011 xf yg (-0.5)
  let b = corner_gradient h111 xg yg (-0.5)
  let x11 = a + (b - a) * u
  let y0 = x00 + (x10 - x00) * v
  let y1 = x01 + (x11 - x01) * v
  return y0 + (y1 - y0) * 0.5
func perlin3 (seed: U32) => func (p: Vec3) => perlin3_mixed (seed * 3266489917) p.x p.y p.z

// Gradient noise in 2D (a slice of the 3D noise).
func perlin2 (seed: U32) => func (p: Vec2) => perlin2_mixed (seed * 3266489917) p.x p.y

// Smooth 1D noise over time: wobble, flicker, shake.
func perlin1 (seed: U32) -> (t: F32) : F32 =>
  if not (is_finite t):
    return 0.0
  let ft = floor t
  let xi = cell_floor ft
  let xf = t - ft
  let s = seed * 3266489917
  let xa = xi * 2747636419
  let xb = xa + 2747636419
  let xg = xf - 1.0
  let u = fade xf
  let yz = (s, 2654435769 ^ s, 2246822519 ^ s, 2654435769 ^ 2246822519 ^ s)
  let near = simd.u32_xor (simd.u32_splat xa) yz
  let far = simd.u32_xor (simd.u32_splat xb) yz
  near := simd.u32_xor self (simd.u32_shr 15 self)
  far := simd.u32_xor self (simd.u32_shr 15 self)
  near := simd.u32_mul self (simd.u32_splat 2246822507)
  far := simd.u32_mul self (simd.u32_splat 2246822507)
  near := simd.u32_xor self (simd.u32_shr 13 self)
  far := simd.u32_xor self (simd.u32_shr 13 self)
  near := simd.u32_mul self (simd.u32_splat 3266489909)
  far := simd.u32_mul self (simd.u32_splat 3266489909)
  near := simd.u32_xor self (simd.u32_shr 16 self)
  far := simd.u32_xor self (simd.u32_shr 16 self)
  let (h000, h010, h001, h011) = near
  let (h100, h110, h101, h111) = far
  let a = corner_gradient h000 xf 0.5 0.5
  let b = corner_gradient h100 xg 0.5 0.5
  let x00 = a + (b - a) * u
  let a = corner_gradient h010 xf (-0.5) 0.5
  let b = corner_gradient h110 xg (-0.5) 0.5
  let x10 = a + (b - a) * u
  let a = corner_gradient h001 xf 0.5 (-0.5)
  let b = corner_gradient h101 xg 0.5 (-0.5)
  let x01 = a + (b - a) * u
  let a = corner_gradient h011 xf (-0.5) (-0.5)
  let b = corner_gradient h111 xg (-0.5) (-0.5)
  let x11 = a + (b - a) * u
  let y0 = x00 + (x10 - x00) * 0.5
  let y1 = x01 + (x11 - x01) * 0.5
  return y0 + (y1 - y0) * 0.5

// Value noise in 2D: blockier, cheaper.
func value2 (seed: U32) -> (p: Vec2) : F32 =>
  if not (is_finite p.x and is_finite p.y):
    return 0.0
  let fx = floor p.x
  let fy = floor p.y
  let xi = cell_floor fx
  let yi = cell_floor fy
  let s = seed * 3266489917
  let xa = xi * 2747636419
  let xb = xa + 2747636419
  let ya = yi * 2654435769
  let yb = ya + 2654435769
  let a = U32.to_f32 (mixed (xa ^ ya ^ s) >> 8) * (1.0 / 8388608.0) - 1.0
  let b = U32.to_f32 (mixed (xb ^ ya ^ s) >> 8) * (1.0 / 8388608.0) - 1.0
  let c = U32.to_f32 (mixed (xa ^ yb ^ s) >> 8) * (1.0 / 8388608.0) - 1.0
  let d = U32.to_f32 (mixed (xb ^ yb ^ s) >> 8) * (1.0 / 8388608.0) - 1.0
  let u = fade (p.x - fx)
  let v = fade (p.y - fy)
  return lerp (lerp a b u) (lerp c d u) v

// Value noise in 3D: the 2D noise's lattice, hashed with the z cell too, and
// blended trilinearly, x then y then z, by `fade` of the fractions. Shaders
// that draw the same noise (Pen's froxel fog) mirror this hash, cell and blend.
private func value3_mixed (s: U32) => func (x: F32) => func (y: F32) => func (z: F32) : F32 =>
  if not (is_finite x and is_finite y and is_finite z):
    return 0.0
  let fx = floor x
  let fy = floor y
  let fz = floor z
  let xi = cell_floor fx
  let yi = cell_floor fy
  let zi = cell_floor fz
  let xf = x - fx
  let yf = y - fy
  let zf = z - fz
  let u = xf * xf * xf * (xf * (xf * 6.0 - 15.0) + 10.0)
  let v = yf * yf * yf * (yf * (yf * 6.0 - 15.0) + 10.0)
  let w = zf * zf * zf * (zf * (zf * 6.0 - 15.0) + 10.0)
  let xa = xi * 2747636419
  let xb = xa + 2747636419
  let ya = yi * 2654435769
  let yb = ya + 2654435769
  let za = zi * 2246822519
  let zb = za + 2246822519
  let yz = (ya ^ za ^ s, yb ^ za ^ s, ya ^ zb ^ s, yb ^ zb ^ s)
  let near = simd.u32_xor (simd.u32_splat xa) yz
  let far = simd.u32_xor (simd.u32_splat xb) yz
  near := simd.u32_xor self (simd.u32_shr 15 self)
  far := simd.u32_xor self (simd.u32_shr 15 self)
  near := simd.u32_mul self (simd.u32_splat 2246822507)
  far := simd.u32_mul self (simd.u32_splat 2246822507)
  near := simd.u32_xor self (simd.u32_shr 13 self)
  far := simd.u32_xor self (simd.u32_shr 13 self)
  near := simd.u32_mul self (simd.u32_splat 3266489909)
  far := simd.u32_mul self (simd.u32_splat 3266489909)
  near := simd.u32_xor self (simd.u32_shr 16 self)
  far := simd.u32_xor self (simd.u32_shr 16 self)
  let scale = simd.f32_splat (1.0 / 16777216.0)
  let two = simd.f32_splat 2.0
  let one = simd.f32_splat 1.0
  let a = simd.f32_sub (simd.f32_mul (simd.f32_mul (simd.to_f32 (simd.u32_shr 8 near)) scale) two) one
  let b = simd.f32_sub (simd.f32_mul (simd.f32_mul (simd.to_f32 (simd.u32_shr 8 far)) scale) two) one
  let (x00, x10, x01, x11) = simd.f32_add a (simd.f32_mul (simd.f32_sub b a) (simd.f32_splat u))
  let y0 = x00 + (x10 - x00) * v
  let y1 = x01 + (x11 - x01) * v
  return y0 + (y1 - y0) * w
func value3 (seed: U32) => func (p: Vec3) => value3_mixed (seed * 3266489917) p.x p.y p.z

const seed_step: U32 = 101 * 3266489917

// Fractal sum of 3D value noise: octave i uses seed `seed + i * 101`, is
// 2^i times as fine and 0.5^i as strong, and the sum is divided by the
// amplitudes' sum, so it stays in [-1, 1]. Zero octaves give zero.
func fbm_value3 (seed: U32) => func (octaves: U32) => func (p: Vec3) =>
  let $Vec3 { x, y, z } = p
  if not (is_finite x and is_finite y and is_finite z):
    return 0.0
  let count = min octaves 32
  let sum = 0.0
  let total = 0.0
  let amplitude = 1.0
  let frequency = 1.0
  let word = seed * 3266489917
  for 0..count:
    sum := self + amplitude * value3_mixed word (x * frequency) (y * frequency) (z * frequency)
    word := self + seed_step
    total := self + amplitude
    amplitude := self * 0.5
    frequency := self * 2.0
  if total == 0.0:
    return 0.0
  return sum / total

// Fractal sum of 2D gradient noise: `octaves` layers, each twice as fine
// and half as strong.
func fbm2_at (seed: U32) => func (octaves: U32) => func (x: F32) => func (y: F32) =>
  if not (is_finite x and is_finite y):
    return 0.0
  let count = min octaves 32
  let sum = 0.0
  let total = 0.0
  let amplitude = 1.0
  let frequency = 1.0
  let word = seed * 3266489917
  for 0..count:
    sum := self + amplitude * perlin2_mixed word (x * frequency) (y * frequency)
    word := self + seed_step
    total := self + amplitude
    amplitude := self * 0.5
    frequency := self * 2.0
  if total == 0.0:
    return 0.0
  return sum / total

// Four positions share one octave loop. All vector operations stay in
// this body so only the public call crosses the SIMD tuple boundary.
func fbm2_at4 (seed: U32) -> (octaves: U32) -> (xs: simd.F32x4) -> (ys: simd.F32x4) : simd.F32x4 =>
  let count = min octaves 32
  if count == 0:
    return simd.f32_splat 0.0
  let sum = simd.f32_splat 0.0
  let total = 0.0
  let amplitude = 1.0
  let frequency = 1.0
  let word = seed * 3266489917
  let zero = simd.f32_splat 0.0
  let one = simd.f32_splat 1.0
  let half = simd.f32_splat 0.5
  let lower = simd.f32_splat (-0.5)
  let six = simd.f32_splat 6.0
  let fifteen = simd.f32_splat 15.0
  let ten = simd.f32_splat 10.0
  let exp = simd.u32_splat 0x7F800000
  let uzero = simd.u32_splat 0
  let uone = simd.u32_splat 1
  let inverse_three = simd.u32_splat 0xAAAAAAAB
  let sign = simd.u32_splat 0x80000000
  let xscale = simd.u32_splat 2747636419
  let yscale = simd.u32_splat 2654435769
  let zscale = simd.u32_splat 2246822519
  // The octave scale is a power of two. Classify once if every scaled
  // coordinate stays inside the signed lattice conversion range.
  let bound = simd.f32_splat (2147483648.0 / U32.to_f32 (1 << (count - 1)))
  let ordinary = simd.all_true (simd.f32_lt (simd.f32_abs xs) bound) and simd.all_true (simd.f32_lt (simd.f32_abs ys) bound)
  for 0 .. count:
    let f = simd.f32_splat frequency
    let x = simd.f32_mul xs f
    let y = simd.f32_mul ys f
    let valid = simd.u32_splat 0xFFFFFFFF
    if not ordinary:
      let finite_x = simd.u32_ne (simd.u32_and (simd.f32_bits x) exp) exp
      let finite_y = simd.u32_ne (simd.u32_and (simd.f32_bits y) exp) exp
      valid := simd.u32_and finite_x finite_y
      x := simd.f32_select valid self zero
      y := simd.f32_select valid self zero
    let fx = simd.f32_floor x
    let fy = simd.f32_floor y
    let xf = simd.f32_sub x fx
    let yf = simd.f32_sub y fy
    let xg = simd.f32_sub xf one
    let yg = simd.f32_sub yf one
    let u = simd.f32_mul (simd.f32_mul (simd.f32_mul xf xf) xf) (simd.f32_add (simd.f32_mul xf (simd.f32_sub (simd.f32_mul xf six) fifteen)) ten)
    let v = simd.f32_mul (simd.f32_mul (simd.f32_mul yf yf) yf) (simd.f32_add (simd.f32_mul yf (simd.f32_sub (simd.f32_mul yf six) fifteen)) ten)
    let xi = simd.to_u32_signed fx
    let yi = simd.to_u32_signed fy
    if not ordinary:
      let limit = simd.f32_splat 2147483648.0
      let big = simd.u32_or (simd.f32_ge (simd.f32_abs fx) limit) (simd.f32_ge (simd.f32_abs fy) limit)
      if simd.any_true big:
        let (x0, x1, x2, x3) = fx
        let (y0, y1, y2, y3) = fy
        xi := (cell_floor x0, cell_floor x1, cell_floor x2, cell_floor x3)
        yi := (cell_floor y0, cell_floor y1, cell_floor y2, cell_floor y3)
    let xa = simd.u32_mul xi xscale
    let xb = simd.u32_add xa xscale
    let yi = simd.u32_mul yi yscale
    let yj = simd.u32_add yi yscale
    let ya = simd.u32_xor yi (simd.u32_splat word)
    let yb = simd.u32_xor yj (simd.u32_splat word)
    let yc = simd.u32_xor ya zscale
    let yd = simd.u32_xor yb zscale

    // If h >> 2 is 3q + r, multiplication by the inverse of 3 modulo
    // 2^32 gives q + r * inverse_three. Its top two bits are 0, 2, 1
    // for r = 0, 1, 2 respectively. The low bits of h still select signs.
    // Fractions and their offsets never start at negative zero. Clear the
    // zero sign after addition to match gradient's 0.0 - axis operation.
    let h = simd.u32_xor xa ya
    h := simd.u32_xor self (simd.u32_shr 15 self)
    h := simd.u32_mul self (simd.u32_splat 2246822507)
    h := simd.u32_xor self (simd.u32_shr 13 self)
    h := simd.u32_mul self (simd.u32_splat 3266489909)
    h := simd.u32_xor self (simd.u32_shr 16 self)
    let residue = simd.u32_shr 30 (simd.u32_mul (simd.u32_shr 2 h) inverse_three)
    let u_axis = simd.f32_select (simd.u32_ne residue uone) xf yf
    let v_axis = simd.f32_select (simd.u32_eq residue uzero) yf half
    let signed_u = simd.f32_from_bits (simd.u32_xor (simd.f32_bits u_axis) (simd.u32_shl 31 h))
    let signed_v = simd.f32_from_bits (simd.u32_xor (simd.f32_bits v_axis) (simd.u32_and (simd.u32_shl 30 h) sign))
    let a = simd.f32_add (simd.f32_add signed_u signed_v) zero
    let h = simd.u32_xor xb ya
    h := simd.u32_xor self (simd.u32_shr 15 self)
    h := simd.u32_mul self (simd.u32_splat 2246822507)
    h := simd.u32_xor self (simd.u32_shr 13 self)
    h := simd.u32_mul self (simd.u32_splat 3266489909)
    h := simd.u32_xor self (simd.u32_shr 16 self)
    let residue = simd.u32_shr 30 (simd.u32_mul (simd.u32_shr 2 h) inverse_three)
    let u_axis = simd.f32_select (simd.u32_ne residue uone) xg yf
    let v_axis = simd.f32_select (simd.u32_eq residue uzero) yf half
    let signed_u = simd.f32_from_bits (simd.u32_xor (simd.f32_bits u_axis) (simd.u32_shl 31 h))
    let signed_v = simd.f32_from_bits (simd.u32_xor (simd.f32_bits v_axis) (simd.u32_and (simd.u32_shl 30 h) sign))
    let b = simd.f32_add (simd.f32_add signed_u signed_v) zero
    let x0 = simd.f32_add a (simd.f32_mul (simd.f32_sub b a) u)

    let h = simd.u32_xor xa yb
    h := simd.u32_xor self (simd.u32_shr 15 self)
    h := simd.u32_mul self (simd.u32_splat 2246822507)
    h := simd.u32_xor self (simd.u32_shr 13 self)
    h := simd.u32_mul self (simd.u32_splat 3266489909)
    h := simd.u32_xor self (simd.u32_shr 16 self)
    let residue = simd.u32_shr 30 (simd.u32_mul (simd.u32_shr 2 h) inverse_three)
    let u_axis = simd.f32_select (simd.u32_ne residue uone) xf yg
    let v_axis = simd.f32_select (simd.u32_eq residue uzero) yg half
    let signed_u = simd.f32_from_bits (simd.u32_xor (simd.f32_bits u_axis) (simd.u32_shl 31 h))
    let signed_v = simd.f32_from_bits (simd.u32_xor (simd.f32_bits v_axis) (simd.u32_and (simd.u32_shl 30 h) sign))
    let a = simd.f32_add (simd.f32_add signed_u signed_v) zero
    let h = simd.u32_xor xb yb
    h := simd.u32_xor self (simd.u32_shr 15 self)
    h := simd.u32_mul self (simd.u32_splat 2246822507)
    h := simd.u32_xor self (simd.u32_shr 13 self)
    h := simd.u32_mul self (simd.u32_splat 3266489909)
    h := simd.u32_xor self (simd.u32_shr 16 self)
    let residue = simd.u32_shr 30 (simd.u32_mul (simd.u32_shr 2 h) inverse_three)
    let u_axis = simd.f32_select (simd.u32_ne residue uone) xg yg
    let v_axis = simd.f32_select (simd.u32_eq residue uzero) yg half
    let signed_u = simd.f32_from_bits (simd.u32_xor (simd.f32_bits u_axis) (simd.u32_shl 31 h))
    let signed_v = simd.f32_from_bits (simd.u32_xor (simd.f32_bits v_axis) (simd.u32_and (simd.u32_shl 30 h) sign))
    let b = simd.f32_add (simd.f32_add signed_u signed_v) zero
    let x1 = simd.f32_add a (simd.f32_mul (simd.f32_sub b a) u)

    let h = simd.u32_xor xa yc
    h := simd.u32_xor self (simd.u32_shr 15 self)
    h := simd.u32_mul self (simd.u32_splat 2246822507)
    h := simd.u32_xor self (simd.u32_shr 13 self)
    h := simd.u32_mul self (simd.u32_splat 3266489909)
    h := simd.u32_xor self (simd.u32_shr 16 self)
    let residue = simd.u32_shr 30 (simd.u32_mul (simd.u32_shr 2 h) inverse_three)
    let u_axis = simd.f32_select (simd.u32_ne residue uone) xf yf
    let v_axis = simd.f32_select (simd.u32_eq residue uzero) yf lower
    let signed_u = simd.f32_from_bits (simd.u32_xor (simd.f32_bits u_axis) (simd.u32_shl 31 h))
    let signed_v = simd.f32_from_bits (simd.u32_xor (simd.f32_bits v_axis) (simd.u32_and (simd.u32_shl 30 h) sign))
    let a = simd.f32_add (simd.f32_add signed_u signed_v) zero
    let h = simd.u32_xor xb yc
    h := simd.u32_xor self (simd.u32_shr 15 self)
    h := simd.u32_mul self (simd.u32_splat 2246822507)
    h := simd.u32_xor self (simd.u32_shr 13 self)
    h := simd.u32_mul self (simd.u32_splat 3266489909)
    h := simd.u32_xor self (simd.u32_shr 16 self)
    let residue = simd.u32_shr 30 (simd.u32_mul (simd.u32_shr 2 h) inverse_three)
    let u_axis = simd.f32_select (simd.u32_ne residue uone) xg yf
    let v_axis = simd.f32_select (simd.u32_eq residue uzero) yf lower
    let signed_u = simd.f32_from_bits (simd.u32_xor (simd.f32_bits u_axis) (simd.u32_shl 31 h))
    let signed_v = simd.f32_from_bits (simd.u32_xor (simd.f32_bits v_axis) (simd.u32_and (simd.u32_shl 30 h) sign))
    let b = simd.f32_add (simd.f32_add signed_u signed_v) zero
    let x2 = simd.f32_add a (simd.f32_mul (simd.f32_sub b a) u)

    let h = simd.u32_xor xa yd
    h := simd.u32_xor self (simd.u32_shr 15 self)
    h := simd.u32_mul self (simd.u32_splat 2246822507)
    h := simd.u32_xor self (simd.u32_shr 13 self)
    h := simd.u32_mul self (simd.u32_splat 3266489909)
    h := simd.u32_xor self (simd.u32_shr 16 self)
    let residue = simd.u32_shr 30 (simd.u32_mul (simd.u32_shr 2 h) inverse_three)
    let u_axis = simd.f32_select (simd.u32_ne residue uone) xf yg
    let v_axis = simd.f32_select (simd.u32_eq residue uzero) yg lower
    let signed_u = simd.f32_from_bits (simd.u32_xor (simd.f32_bits u_axis) (simd.u32_shl 31 h))
    let signed_v = simd.f32_from_bits (simd.u32_xor (simd.f32_bits v_axis) (simd.u32_and (simd.u32_shl 30 h) sign))
    let a = simd.f32_add (simd.f32_add signed_u signed_v) zero
    let h = simd.u32_xor xb yd
    h := simd.u32_xor self (simd.u32_shr 15 self)
    h := simd.u32_mul self (simd.u32_splat 2246822507)
    h := simd.u32_xor self (simd.u32_shr 13 self)
    h := simd.u32_mul self (simd.u32_splat 3266489909)
    h := simd.u32_xor self (simd.u32_shr 16 self)
    let residue = simd.u32_shr 30 (simd.u32_mul (simd.u32_shr 2 h) inverse_three)
    let u_axis = simd.f32_select (simd.u32_ne residue uone) xg yg
    let v_axis = simd.f32_select (simd.u32_eq residue uzero) yg lower
    let signed_u = simd.f32_from_bits (simd.u32_xor (simd.f32_bits u_axis) (simd.u32_shl 31 h))
    let signed_v = simd.f32_from_bits (simd.u32_xor (simd.f32_bits v_axis) (simd.u32_and (simd.u32_shl 30 h) sign))
    let b = simd.f32_add (simd.f32_add signed_u signed_v) zero
    let x3 = simd.f32_add a (simd.f32_mul (simd.f32_sub b a) u)

    let y0 = simd.f32_add x0 (simd.f32_mul (simd.f32_sub x1 x0) v)
    let y1 = simd.f32_add x2 (simd.f32_mul (simd.f32_sub x3 x2) v)
    let value = simd.f32_add y0 (simd.f32_mul (simd.f32_sub y1 y0) half)
    if not ordinary:
      value := simd.f32_select valid self zero
    sum := simd.f32_add self (simd.f32_mul (simd.f32_splat amplitude) value)
    word := self + seed_step
    total := self + amplitude
    amplitude := self * 0.5
    frequency := self * 2.0
  return simd.f32_div sum (simd.f32_splat total)

func fbm2 (seed: U32) => func (octaves: U32) => func (p: Vec2) =>
  let $Vec2 { x, y } = p
  return fbm2_at seed octaves x y

func fbm3 (seed: U32) => func (octaves: U32) => func (p: Vec3) =>
  let $Vec3 { x, y, z } = p
  if not (is_finite x and is_finite y and is_finite z):
    return 0.0
  let count = min octaves 32
  let sum = 0.0
  let total = 0.0
  let amplitude = 1.0
  let frequency = 1.0
  let word = seed * 3266489917
  for 0..count:
    sum := self + amplitude * perlin3_mixed word (x * frequency) (y * frequency) (z * frequency)
    word := self + seed_step
    total := self + amplitude
    amplitude := self * 0.5
    frequency := self * 2.0
  if total == 0.0:
    return 0.0
  return sum / total

// A random number in [0, 1) for a lattice point: stable per position.
func at (seed: U32) => func (x: U32) => func (y: U32) => unit (hash3 x y 0 seed)

// Floating hash shared with authored shaders. Callers supply the shader's
// scale and offset; keep the arithmetic order identical on CPU and GPU.
func authored_hash2 (scale: F32) => func (offset: F32) => func (x: F32) => func (y: F32) =>
  let px = x * scale - floor (x * scale)
  let py = y * scale - floor (y * scale)
  let pz = px
  let mixed = px * (py + offset) + py * (pz + offset) + pz * (px + offset)
  let value = (px + mixed + py + mixed) * (pz + mixed)
  return value - floor value

// Cubic-smoothed value noise in [-0.5, 0.5], using authored_hash2.
func authored_value2 (scale: F32) => func (offset: F32) => func (x: F32) => func (y: F32) =>
  let ix = floor x
  let iy = floor y
  let fx = x - ix
  let fy = y - iy
  let ux = fx * fx * (3.0 - 2.0 * fx)
  let uy = fy * fy * (3.0 - 2.0 * fy)
  let a = authored_hash2 scale offset ix iy
  let b = authored_hash2 scale offset (ix + 1.0) iy
  let c = authored_hash2 scale offset ix (iy + 1.0)
  let d = authored_hash2 scale offset (ix + 1.0) (iy + 1.0)
  let low = a * (1.0 - ux) + b * ux
  let high = c * (1.0 - ux) + d * ux
  return low * (1.0 - uy) + high * uy - 0.5

// Four uniform cubic B-spline sample weights for a fractional coordinate.
func bspline_weights4 (f: F32): (F32, F32, F32, F32) =>
  let g = 1.0 - f
  return (g * g * g / 6.0, ((3.0 * f - 6.0) * f * f + 4.0) / 6.0, ((((3.0 - 3.0 * f) * f) + 3.0) * f + 1.0) / 6.0, f * f * f / 6.0)

func bspline_weights (f: F32) =>
  let (w0, w1, w2, w3) = bspline_weights4 f
  return #[w0, w1, w2, w3]
