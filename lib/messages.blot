import * as array from "std/array"

// Separate named owners: rows plus metadata [epoch, capacity, next, oldest].
// A reader is ordinary data; no callback registry or retained continuation.
type Messages a = ResizeArray a
type Metadata = Array U32
type Reader is data = $Reader { epoch: U32, next: U32 }
type Delivery a is data = $Items { values: &[a], cursor: Reader } | $Reset Reader
func empty () : Messages a => return #[]
func metadata (epoch: U32) -> (capacity: U32) : Metadata => return #[epoch, capacity, 0, 0]
func cursor (meta: Metadata) => return $Reader { epoch: meta[0], next: meta[2] }
func beginning (meta: Metadata) => return $Reader { epoch: meta[0], next: meta[3] }
func restart (epoch: U32) -> (log: Messages a) -> (meta: Metadata) => return do:
  if epoch == meta[0]:
    return @panic "message restart requires a fresh epoch"
  @storage.truncate log 0
  meta[0] = epoch
  meta[2] = 0
  meta[3] = 0
func write value -> (log: Messages a) -> (meta: Metadata) => return do:
  if meta[2] == 0xFFFFFFFF:
    return @panic "message sequence exhausted"
  let next = meta[2] + 1
  let capacity = meta[1]
  if capacity > 0:
    if log.length < capacity:
      @storage.push log value
    else:
      log[meta[2] % capacity] = value
  meta[2] = next
  meta[3] = max meta[3] (next - min next capacity)
func write_many (values: Array a) -> (log: Messages a) -> (meta: Metadata) => return do:
  if values.length > 0xFFFFFFFF - meta[2]:
    return @panic "message sequence exhausted"
  let count = values.length
  for i in 0 .. count:
    write values[i] log meta
// Read into a separately named caller-owned destination. The returned ADT is
// flat and borrows that destination; it cannot extend its lifetime or own a
// nested array inside a log/queue element. Payload rows must themselves be flat.
func read (reader: Reader) -> (log: Messages a) -> (meta: Metadata) -> (destination: ResizeArray a) : Delivery a => return do:
  let after = cursor meta
  if reader.epoch != meta[0] or reader.next < meta[3] or reader.next > meta[2]:
    return $Reset after
  @storage.truncate destination 0
  for i in 0 .. meta[2] - reader.next:
    @storage.push destination log[(reader.next + i) % meta[1]]
  return $Items {values: &destination[0..destination.length], cursor: after}
