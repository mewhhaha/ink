//! Deterministic sorting. Equal keys keep their original order (the sort is
//! stable), so a result never depends on anything but the input.
//!
//! Key items: [`identity`], [`order`], [`order_u32`].

func identity (n: U32) : #[U32] =>
  let out = @array.fill n 0
  for i in 0 .. n:
    out[i] := i
  return out

private func f32_le (a: F32) -> (b: F32) : Bool => a <= b or b != b

// The indices 0..n ordered by ascending `keys`, with stable bottom-up merging.
// Keys stay readonly. Already ordered inputs cost one pass. NaNs sort stably to the end.
func order (keys: #[F32]) : #[U32] =>
  let n = keys.length
  let in_order = true
  for i in 1..n:
    if not (f32_le keys[i - 1] keys[i]):
      in_order := false
      break
  if in_order:
    return identity n
  let ids: #[U32] = identity n
  if n <= 24:
    for i in 1..n:
      let cur = ids[i]
      let kv = keys[cur]
      let j = i
      for 0..24:
        if j == 0:
          break
        let prev = ids[j - 1]
        if f32_le keys[prev] kv:
          break
        ids[j] := prev
        j := self - 1
      ids[j] := cur
    return ids
  let run_size: U32 = 16
  for base in 0..((n + run_size - 1) / run_size):
    let low = base * run_size
    let high = min (low + run_size) n
    for i in (low + 1)..high:
      let cur = ids[i]
      let kv = keys[cur]
      let j = i
      for 0..16:
        if j == low:
          break
        let prev = ids[j - 1]
        if f32_le keys[prev] kv:
          break
        ids[j] := prev
        j := self - 1
      ids[j] := cur
  let next: #[U32] = @array.fill n 0
  let width = run_size
  let in_next = false
  for 0..32:
    if width >= n:
      break
    for run in 0..((n + width * 2 - 1) / (width * 2)):
      let low = run * width * 2
      let middle = min (low + width) n
      let high = min (low + width * 2) n
      let i = low
      let j = middle
      if not in_next:
        for k in low..high:
          let take_left = if i >= middle then false else if j >= high then true else f32_le keys[ids[i]] keys[ids[j]]
          if take_left:
            next[k] := ids[i]
            i := self + 1
          else:
            next[k] := ids[j]
            j := self + 1
      else:
        for k in low..high:
          let take_left = if i >= middle then false else if j >= high then true else f32_le keys[next[i]] keys[next[j]]
          if take_left:
            ids[k] := next[i]
            i := self + 1
          else:
            ids[k] := next[j]
            j := self + 1
    in_next := not self
    width := self * 2
  return if in_next then next else ids

// Stable radix ordering with exact full-width unsigned keys.
func order_u32 (keys: #[U32]) : #[U32] =>
  let n = keys.length
  let sorted = true
  for i in 1..n:
    if keys[i - 1] > keys[i]:
      sorted := false
      break
  let ids = identity n
  if sorted:
    return ids
  if n <= 32:
    for i in 1..n:
      let cur = ids[i]
      let kv = keys[cur]
      let j = i
      for 0..32:
        if j == 0:
          break
        let prev = ids[j - 1]
        if keys[prev] <= kv:
          break
        ids[j] := prev
        j := self - 1
      ids[j] := cur
    return ids
  let next = @array.fill n 0
  // Build all four byte histograms in one pass over keys.
  let counts = @array.fill 1024 0
  for i in 0..n:
    let value = keys[i]
    let b0 = value & 255
    let b1 = 256 + ((value >> 8) & 255)
    let b2 = 512 + ((value >> 16) & 255)
    let b3 = 768 + ((value >> 24) & 255)
    counts[b0] := self + 1
    counts[b1] := self + 1
    counts[b2] := self + 1
    counts[b3] := self + 1
  let in_next = false
  let first = keys[0]
  for pass in 0..4:
    let shift = pass * 8
    let base = pass * 256
    // A digit every key shares leaves the order as it is.
    if counts[base + ((first >> shift) & 255)] != n:
      let start = 0
      for bucket in 0..256:
        let count = counts[base + bucket]
        counts[base + bucket] := start
        start := self + count
      if not in_next:
        for i in 0..n:
          let id = ids[i]
          let slot = base + ((keys[id] >> shift) & 255)
          let at = counts[slot]
          next[at] := id
          counts[slot] := at + 1
      else:
        for i in 0..n:
          let id = next[i]
          let slot = base + ((keys[id] >> shift) & 255)
          let at = counts[slot]
          ids[at] := id
          counts[slot] := at + 1
      in_next := not self
  return if in_next then next else ids
