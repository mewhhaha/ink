import * as lanes from "./lanes"
import * as time from "./clock"
import * as window from "./events"

// Application composition is static. A known stage-policy record contains
// direct helpers, never a runtime array of functions or a world/scope closure.
// Resource/component owners are named independently by the application; access
// only aliases those owners during a call.
type EventContext is data = $EventContext { event: window.Event, width: F32, height: F32 }
type Presentation is data = $Presentation { alpha: F32, width: F32, height: F32 }
type Pause is data = $Pause { on: Bool }
type Wall is data = $Wall { seconds: F32 }
// Control owner: normalization pending, pause enabled, hold next simulation frame.
type Control = Array U32
const control = func () : Control => return #[1, 0, 0]
const wall = func () : Array Wall => return #[$Wall {seconds: 0.0}]
const encode_pause = func (held: Pause) => return #[lanes.bit held.on]
const decode_pause = func (values: Array F32) => return do:
  lanes.exact values 1
  return $Pause {on: lanes.flag values[0]}
const pause_codec = $lanes.Codec {key: 13, version: 1, encode: encode_pause, decode: decode_pause, migrate: lanes.no_migration}
const no_action = func access => return ()
const no_event = func access -> context => return ()
const no_update = func access -> seconds => return ()
const no_render = func access -> presentation => return ()
const route_event = func access -> context => return context
const stages = func reset -> start -> normalize -> checkpoint -> route -> interface -> event -> update -> render -> settle => return
  {reset, start, normalize, checkpoint, route, interface, event, update, render, settle}
const paused = func (control: Control) => return control[1] != 0
const pause = func (control: Control) -> (on: Bool) => return do:
  control[1] := if on then 1 else 0
const hold_frame = func (control: Control) => return do:
  control[2] := 1
const invalidate = func (control: Control) => return do:
  control[0] := 1
const ensure_normalized = func stages -> access -> (control: Control) => return do:
  if control[0] != 0:
    stages.normalize access
    stages.checkpoint access
    control[0] := 0
const start = func stages -> access -> control => return do:
  stages.start access
  invalidate control
  ensure_normalized stages access control
// Begin only after the previous output's borrowed ranges have been encoded.
const begin_frame = func stages -> access => return stages.reset access
const run_event = func stages -> access -> control -> event -> width -> height => return do:
  let original = $EventContext {event, width, height}
  use context <- stages.route access original
  use was_paused <- paused control
  stages.interface access context
  if Bool.not was_paused and Bool.not (paused control):
    stages.event access context
const advance = func stages -> access -> (policy: time.Policy) -> (clock: Array time.Clock) -> (control: Control) -> (wall: Array Wall) -> (elapsed: F32) -> events -> width -> height => return do:
  lanes.require (clock.length == 1 and control.length == 3 and wall.length == 1)
  lanes.require (is_finite elapsed and elapsed >= 0.0)
  ensure_normalized stages access control
  wall[0] := $Wall {seconds: min policy.max_elapsed elapsed}
  for event in events:
    run_event stages access control event width height
  let held = control[2] != 0
  control[2] := 0
  let delta = if paused control or held then 0.0 else elapsed
  return time.advance policy clock access stages.checkpoint stages.update delta
const render = func stages -> access -> control -> alpha -> width -> height => return do:
  ensure_normalized stages access control
  stages.render access ($Presentation {alpha, width, height})
  stages.settle access
// Creation/restore/reset are explicit static schema operations. Restoring a
// checkpoint clears derived caches/journal epochs in the application's decoder,
// then calls invalidate. There is no general preview or discarded world fork.
