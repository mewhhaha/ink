import * as lanes from "./lanes"
import * as time from "./clock"
import * as window from "./events"

// Application composition is static. A known stage-policy record contains
// direct helpers, never a runtime array of functions or a world/scope closure.
// Resource/component owners are named independently by the application; access
// only aliases those owners during a call.
type EventContext is data = $EventContext { event: window.Event, width: F32, height: F32 }
type Presentation is data = $Presentation { alpha: F32, width: F32, height: F32 }
type Pause is data = $Pause { on: Bool }
type Wall is data = $Wall { seconds: F32 }
// Control owner: normalization pending, pause enabled, hold next simulation frame.
type Control = Array U32
func control () : Control => return #[1, 0, 0]
func wall () : Array Wall => return #[$Wall {seconds: 0.0}]
func encode_pause (held: Pause) => return #[lanes.bit held.on]
func decode_pause (values: Array F32) => return do:
  lanes.exact values 1
  return $Pause {on: lanes.flag values[0]}
const pause_codec = $lanes.Codec {key: 13, version: 1, encode: encode_pause, decode: decode_pause, migrate: lanes.no_migration}
func no_action (own access) => return access
func no_event (own access) -> context => return access
func no_update (own access) -> seconds => return access
func no_render (own access) -> presentation => return access
func route_event access -> context => return context
// For a hook that is lent the world and has nothing to do with it.
func no_keep (own access) => return access
// A stage out of a function that writes through the world it is lent.
func lent step => return func (own access) => return do:
  step access
  return access
func lent_with step => return func (own access) -> argument => return do:
  step access argument
  return access
// A stage takes the world and hands it back; `route` only reads it, and
// the event it makes of an event is what `interface` and `event` are given.
// Every stage is a stage of the same world.
func stages (reset: own a -> a ! {| e}) -> (start: own a -> a ! {| e}) -> (normalize: own a -> a ! {| e})
  -> (checkpoint: own a -> a ! {| e}) -> (route: a -> EventContext -> EventContext ! {| e})
  -> (interface: own a -> EventContext -> a ! {| e}) -> (event: own a -> EventContext -> a ! {| e})
  -> (update: own a -> F32 -> a ! {| e}) -> (render: own a -> Presentation -> a ! {| e})
  -> (settle: own a -> a ! {| e}) => return
  {reset, start, normalize, checkpoint, route, interface, event, update, render, settle}
func paused (control: Control) => return control[1] != 0
func pause (control: Control) -> (on: Bool) => return do:
  control[1] = if on then 1 else 0
func hold_frame (control: Control) => return do:
  control[2] = 1
func invalidate (control: Control) => return do:
  control[0] = 1
func stale (control: Control) => return control[0] != 0
func held (control: Control) => return control[2] != 0
func ensure_normalized stages -> (own access) => return do:
  if stale access.control:
    access := stages.normalize (own access)
    access := stages.checkpoint (own access)
    access.control[0] := 0
  return access
func start stages -> (own access) => return do:
  access := stages.start (own access)
  access.control[0] := 1
  return ensure_normalized stages access
// Begin only after the previous output's borrowed ranges have been encoded.
func begin_frame stages -> (own access) => return stages.reset (own access)
func run_event stages -> (own access) -> event -> width -> height => return do:
  let original = $EventContext {event, width, height}
  let context: EventContext = stages.route access original
  let was_paused = paused access.control
  access := stages.interface (own access) context
  if Bool.not was_paused and Bool.not (paused access.control):
    access := stages.event (own access) context
  return access
// The world after the frame's events and fixed steps, with the plan of
// those steps. The clock, the control cell and the wall are its own.
func advance stages -> (own access) -> (policy: time.Policy) -> (elapsed: F32) -> events -> width -> height => return do:
  let clock: Array time.Clock = access.clock
  let control: Control = access.control
  let wall: Array Wall = access.wall
  lanes.require (clock.length == 1 and control.length == 3 and wall.length == 1)
  lanes.require (is_finite elapsed and elapsed >= 0.0)
  access := ensure_normalized stages access
  access.wall[0] := $Wall {seconds: min policy.max_elapsed elapsed}
  for event in events:
    access := run_event stages access event width height
  let frame_held = held access.control
  access.control[2] := 0
  let delta = if paused access.control or frame_held then 0.0 else elapsed
  return time.advance policy access stages.checkpoint stages.update delta
// `advance` for a caller that has no use for the plan.
func advanced stages -> (own access) -> (policy: time.Policy) -> (elapsed: F32) -> events -> width -> height => return do:
  let (plan, next) = advance stages access policy elapsed events width height
  return next
func render stages -> (own access) -> alpha -> width -> height => return do:
  access := ensure_normalized stages access
  access := stages.render (own access) ($Presentation {alpha, width, height})
  return stages.settle (own access)
// Creation/restore/reset are explicit static schema operations. Restoring a
// checkpoint clears derived caches/journal epochs in the application's decoder,
// then calls invalidate. There is no general preview or discarded world fork.
