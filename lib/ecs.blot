//! Each declaration is a separately named instance owner. Access parameters
//! alias these owners; there is no owning World record or dynamic registry.
//! Metadata is a separate fixed owner: epoch, payload revision, membership revision.
//! Entities pack live bits 64 per U64 word; component pools stay direct-indexed
//! with zero side-allocation when dense and hole-free, add a U32 presence bitset
//! on removals, and promote to a compact sparse set on gaps.
//!
//! Key items: [`Pool`], [`PoolRead`], [`Metadata`], [`Entities`], [`pool`], [`entities`].
//!
//! ```blot
//! let alive = entities ()
//! let values: Pool U32 = pool ()
//! alive := spawn_entity self
//! values := put_row alive self 0 77
//! Maybe.unwrap_or 0 (read values 0) // => 77
//! ```

import * as journal from "./journal"
import * as sort from "./sort"

// De Bruijn tables for 64-bit and 32-bit count-trailing-zeros.
private const debruijn64: #[U32] = #[
  0, 1, 48, 2, 57, 49, 28, 3,
  61, 58, 50, 42, 38, 29, 17, 4,
  62, 55, 59, 36, 53, 51, 43, 22,
  45, 39, 33, 30, 24, 18, 12, 5,
  63, 47, 56, 27, 60, 41, 37, 16,
  54, 35, 52, 21, 44, 32, 23, 11,
  46, 26, 40, 15, 34, 20, 31, 10,
  25, 14, 19, 9, 13, 8, 7, 6,
]
private const debruijn64_mul: U64 = 0x03f79d71b4cb0a89u64
private const debruijn32: #[U32] = #[
  0, 1, 28, 2, 29, 14, 24, 3,
  30, 22, 20, 15, 25, 17, 4, 8,
  31, 27, 13, 23, 21, 19, 16, 7,
  26, 12, 18, 6, 11, 5, 10, 9,
]
private const debruijn32_mul: U32 = 0x077CB531
private const zero64: U64 = 0u64
private const one64: U64 = 1u64
private const all64: U64 = 0xFFFFFFFFFFFFFFFFu64
private const all32: U32 = 0xFFFFFFFF
private const tombstone: U32 = 0xFFFFFFFF
const no_entity: U32 = 4294967295

// Lowest set bit index in a nonzero U64 word.
func ctz64 (word: U64) : U32 =>
  let low_bit = U64.bit_and word (U64.sub zero64 word)
  return debruijn64[U64.to_u32 (U64.shr (U64.mul low_bit debruijn64_mul) 58u64)]

// Lowest set bit index in a nonzero U32 word.
func ctz32 (word: U32) : U32 =>
  let low_bit = word & (0 - word)
  return debruijn32[(low_bit * debruijn32_mul) >> 27]

type Metadata = #[U32]
type Entities is data = $Entities { count: U32, words: #[U64] }

// 6-word flat Pool (PoolRead is 10 flat words):
// - flags == 0: dense, hole-free (`extent == values.length`, `meta` empty)
// - flags == 2: dense with holes (`extent == values.length`, `meta[0]` = live_count, `meta[1..]` = U32 presence words)
// - flags == 1 (sparse sorted) or 3 (sparse unsorted):
//   `meta[0]` = live_count, `meta[1]` = cap, `meta[2]` = used,
//   `meta[3 .. 3 + cap]` = open-addressing buckets, `meta[3 + cap .. 3 + cap + live_count]` = entity IDs.
type Pool a is data = $Pool { extent: U32, flags: U32, meta: #[U32], values: #[a] }
type PoolRead a is data = $PoolRead { extent: U32, flags: U32, meta: &[U32], values: &[a] }

func Entities.length (alive: Entities) : U32 => alive.count
func Entities.at (alive: Entities) -> (id: U32) : Bool => live alive id
func Pool.length (pool: Pool a) : U32 => pool.extent
func Pool.at (pool: Pool a) -> (id: U32) : Maybe a => read pool id
func PoolRead.length (pool: PoolRead a) : U32 => pool.extent
func PoolRead.at (pool: PoolRead a) -> (id: U32) : Maybe a => read pool id

func pool () : Pool a =>
  let meta: #[U32] = #[]
  let values: #[a] = #[]
  return $Pool { extent: 0, flags: 0, meta, values }

func entities () : Entities =>
  let words: #[U64] = #[]
  return $Entities { count: 0, words }

func clear_entities (alive: own Entities) : Entities =>
  let $Entities { count: _, words } = alive
  @storage.truncate words 0
  return $Entities { count: 0, words }

func push_entity (alive: own Entities) -> (is_live: Bool) : Entities =>
  let $Entities { count, words } = alive
  if count == no_entity:
    return panic "entity identity exhausted"
  let bit_idx = count & 63
  let bit = if is_live then U64.shl one64 (U32.to_u64 bit_idx) else zero64
  if bit_idx == 0:
    @storage.push words bit
  else:
    if is_live:
      words[count >> 6] := U64.bit_or self bit
  return $Entities { count: count + 1, words }

func entities_from (flags: #[Bool]) : Entities =>
  let n = flags.length
  let word_count = (n + 63) >> 6
  let words: #[U64] = @storage.with_capacity word_count
  let full = n >> 6
  for wi in 0 .. full:
    let base = wi << 6
    let w = zero64
    for b in 0 .. 64:
      if flags[base + b]:
        w := U64.bit_or self (U64.shl one64 (U32.to_u64 b))
    @storage.push words w
  let rem = n & 63
  if rem > 0:
    let base = full << 6
    let w = zero64
    for b in 0 .. rem:
      if flags[base + b]:
        w := U64.bit_or self (U64.shl one64 (U32.to_u64 b))
    @storage.push words w
  return $Entities { count: n, words }

func metadata (epoch: U32) : Metadata => #[epoch, 0, 0]
func bumped_revision (before: U32) =>
  if before == 0xFFFFFFFF:
    return panic "ECS revision exhausted"
  return before + 1
func epoch (meta: Metadata) => meta[0]
func component_revision (meta: Metadata) => meta[1]
func membership_revision (meta: Metadata) => meta[2]

func live (alive: Entities) -> (id: U32) : Bool =>
  return id < alive.count and U64.ne (U64.bit_and (U64.shr alive.words[id >> 6] (U32.to_u64 (id & 63))) one64) zero64

private func hash_id (id: U32) : U32 => (id * 2654435761) ^ (id >> 16)

private func next_bucket_cap (wanted: U32) : U32 =>
  let cap: U32 = 8
  for 0 .. 28:
    if cap >= wanted:
      break
    cap := self * 2
  return cap

// Polymorphic over #[U32] and &[U32] so `contains` and `read` stay tiny and
// inline their dense fast path without any loop in the caller.
func sparse_find meta -> (id: U32) : U32 =>
  let cap = meta.at 1
  let mask = cap - 1
  let id_base = 3 + cap
  let slot = ((id * 2654435761) ^ (id >> 16)) & mask
  for 0 .. cap:
    let entry = meta.at (3 + slot)
    if entry == 0:
      return tombstone
    if entry != tombstone:
      let idx = entry - 1
      if meta.at (id_base + idx) == id:
        return idx
    slot := (self + 1) & mask
  return tombstone

private func sparse_probe (meta: #[U32]) -> (id: U32) : (U32, U32) =>
  let cap = meta[1]
  let mask = cap - 1
  let id_base = 3 + cap
  let slot = hash_id id & mask
  let first_tomb = tombstone
  for 0 .. cap:
    let entry = meta[3 + slot]
    if entry == 0:
      return (tombstone, if first_tomb != tombstone then first_tomb else slot)
    if entry == tombstone:
      if first_tomb == tombstone:
        first_tomb := slot
    else:
      let idx = entry - 1
      if meta[id_base + idx] == id:
        return (idx, slot)
    slot := (self + 1) & mask
  return (tombstone, first_tomb)

private func build_sparse_meta (meta: own #[U32]) -> (ids: #[U32]) -> (cap: U32) : #[U32] =>
  let n = ids.length
  let total = 3 + cap + n
  @storage.truncate meta 0
  @storage.reserve meta total
  @storage.push meta n
  @storage.push meta cap
  @storage.push meta n
  for 0 .. cap:
    @storage.push meta 0
  @storage.extend meta (&ids[0..n])
  let mask = cap - 1
  for k in 0 .. n:
    let slot = hash_id ids[k] & mask
    for 0 .. cap:
      if meta[3 + slot] == 0:
        meta[3 + slot] := k + 1
        break
      slot := (self + 1) & mask
  return meta

private func rehash_sparse_meta (meta: own #[U32]) -> (next_cap: U32) : #[U32] =>
  let n = meta[0]
  let old_cap = meta[1]
  let old_base = 3 + old_cap
  let saved_ids: #[U32] = @storage.with_capacity n
  @storage.extend saved_ids (&meta[old_base..old_base + n])
  return build_sparse_meta meta saved_ids next_cap

private func promote_sparse (pool: own Pool a) : Pool a =>
  let $Pool { extent, flags, meta, values } = pool
  if (flags & 1) != 0:
    return $Pool { extent, flags, meta, values }
  let live_count = if flags == 0 then extent else meta[0]
  let kept_ids: #[U32] = @storage.with_capacity live_count
  if flags == 0:
    for i in 0 .. extent:
      @storage.push kept_ids i
  else:
    let write: U32 = 0
    let full = extent >> 5
    for wi in 0 .. full:
      let w = meta[1 + wi]
      let base = wi << 5
      for 0 .. 32:
        if w == 0:
          break
        let id = base + ctz32 w
        @storage.push kept_ids id
        if write != id:
          values[write] := values[id]
        write := self + 1
        w := self & (self - 1)
    let rem = extent & 31
    if rem > 0:
      let w = meta[1 + full] & ((1 << rem) - 1)
      let base = full << 5
      for 0 .. 32:
        if w == 0:
          break
        let id = base + ctz32 w
        @storage.push kept_ids id
        if write != id:
          values[write] := values[id]
        write := self + 1
        w := self & (self - 1)
    @storage.truncate values write
  let cap = next_bucket_cap (max 8 ((kept_ids.length + 1) * 2))
  let next_meta = build_sparse_meta meta kept_ids cap
  return $Pool { extent, flags: 1, meta: next_meta, values }

func contains pool -> (id: U32) : Bool =>
  if id >= pool.extent:
    return false
  if pool.flags == 0:
    return true
  if pool.flags == 2:
    return ((pool.meta.at (1 + (id >> 5)) >> (id & 31)) & 1) != 0
  return sparse_find pool.meta id != tombstone

// Borrowed zero-copy view of a component pool; supports `.length`, `.at` and `ecs.read`.
func rows (pool: Pool a) : PoolRead a => $PoolRead {
  extent: pool.extent,
  flags: pool.flags,
  meta: pool.meta.view 0 pool.meta.length,
  values: pool.values.view 0 pool.values.length,
}

// Scalar/inline row copy. Descriptor fields still alias their explicit owner.
func read pool -> (id: U32) : Maybe a =>
  if id >= pool.extent:
    return $Nothing
  if pool.flags == 0:
    return $Some (pool.values.at id)
  if pool.flags == 2:
    if ((pool.meta.at (1 + (id >> 5)) >> (id & 31)) & 1) != 0:
      return $Some (pool.values.at id)
    return $Nothing
  let idx = sparse_find pool.meta id
  if idx == tombstone:
    return $Nothing
  return $Some (pool.values.at idx)

// Single-owner primitives allow direct `field := ... self ...` updates inside loops.
func spawn_entity (alive: own Entities) : Entities =>
  let $Entities { count, words } = alive
  if count == no_entity:
    return panic "entity identity exhausted"
  let bit_idx = count & 63
  if bit_idx == 0:
    @storage.push words one64
  else:
    words[count >> 6] := U64.bit_or self (U64.shl one64 (U32.to_u64 bit_idx))
  return $Entities { count: count + 1, words }

func despawn_entity (alive: own Entities) -> (id: U32) : Entities =>
  if id < alive.count:
    alive.words[id >> 6] := U64.bit_and self (U64.bit_xor all64 (U64.shl one64 (U32.to_u64 (id & 63))))
  return alive

func bump_membership (meta: own Metadata) : Metadata =>
  meta[2] := bumped_revision self
  return meta
func bump_payload (meta: own Metadata) : Metadata =>
  meta[1] := bumped_revision self
  return meta
func bump_insert (was_present: Bool) -> (meta: own Metadata) : Metadata =>
  if was_present:
    meta[1] := bumped_revision self
  else:
    let revision = bumped_revision meta[1]
    let structure = bumped_revision meta[2]
    meta[1] := revision
    meta[2] := structure
  return meta
func bump_remove (was_present: Bool) -> (meta: own Metadata) : Metadata =>
  if was_present:
    let revision = bumped_revision meta[1]
    let structure = bumped_revision meta[2]
    meta[1] := revision
    meta[2] := structure
  return meta

func clear_pool (pool: own Pool a) : Pool a =>
  let $Pool { extent: _, flags: _, meta, values } = pool
  @storage.truncate meta 0
  @storage.truncate values 0
  return $Pool { extent: 0, flags: 0, meta, values }

private func write_sparse_row (pool: own Pool a) -> (id: U32) -> (value: a) : Pool a =>
  let (existing, _) = sparse_probe pool.meta id
  if existing == tombstone:
    return panic "write requires an existing component"
  pool.values[existing] := value
  return pool

func write_row (pool: own Pool a) -> (id: U32) -> (value: a) : Pool a =>
  if id >= pool.extent:
    return panic "write requires an existing component"
  if pool.flags == 0:
    pool.values[id] := value
    return pool
  if pool.flags == 2:
    if ((pool.meta[1 + (id >> 5)] >> (id & 31)) & 1) == 0:
      return panic "write requires an existing component"
    pool.values[id] := value
    return pool
  return write_sparse_row pool id value

private func put_sparse_row (pool: own Pool a) -> (id: U32) -> (value: a) : Pool a =>
  let $Pool { extent, flags, meta, values } = pool
  let cap = meta[1]
  // Monotonic fresh-ID fast path when no tombstones exist: skips key comparison.
  if id >= extent and meta[0] == meta[2]:
    if (meta[2] + 1) * 10 >= cap * 7:
      let next_cap = cap * 2
      meta := rehash_sparse_meta self next_cap
      cap := next_cap
    let mask = cap - 1
    let slot = hash_id id & mask
    for 0 .. cap:
      if meta[3 + slot] == 0:
        break
      slot := (self + 1) & mask
    let idx = values.length
    @storage.push meta id
    @storage.push values value
    meta[3 + slot] := idx + 1
    meta[0] := idx + 1
    meta[2] := idx + 1
    return $Pool { extent: id + 1, flags, meta, values }
  let (existing, slot) = sparse_probe meta id
  if existing != tombstone:
    values[existing] := value
    return $Pool { extent, flags, meta, values }
  if (meta[2] + 1) * 10 >= cap * 7:
    let next_cap = if (meta[0] + 1) * 4 <= cap then cap else cap * 2
    meta := rehash_sparse_meta self next_cap
    cap := next_cap
    let (_, fresh_slot) = sparse_probe meta id
    slot := fresh_slot
  let idx = values.length
  let id_base = 3 + cap
  let next_flags = if flags == 1 and idx > 0 and id <= meta[id_base + idx - 1] then 3 else flags
  @storage.push meta id
  @storage.push values value
  let was_empty = meta[3 + slot] == 0
  meta[3 + slot] := idx + 1
  meta[0] := meta[0] + 1
  if was_empty:
    meta[2] := meta[2] + 1
  let next_extent = if id + 1 > extent then id + 1 else extent
  return $Pool { extent: next_extent, flags: next_flags, meta, values }

private func put_raw_slow (pool: own Pool a) -> (id: U32) -> (value: a) : Pool a =>
  let $Pool { extent, flags, meta, values } = pool
  if flags == 0:
    if id < extent:
      values[id] := value
      return $Pool { extent, flags: 0, meta, values }
    if id == extent:
      @storage.push values value
      return $Pool { extent: extent + 1, flags: 0, meta, values }
    if extent == 0:
      let cap: U32 = 8
      @storage.reserve meta (3 + cap + 1)
      @storage.push meta 1
      @storage.push meta cap
      @storage.push meta 1
      for 0 .. cap:
        @storage.push meta 0
      @storage.push meta id
      meta[3 + (hash_id id & (cap - 1))] := 1
      @storage.push values value
      return $Pool { extent: id + 1, flags: 1, meta, values }
    let promoted = promote_sparse ($Pool { extent, flags: 0, meta, values })
    return put_sparse_row promoted id value
  if flags == 2:
    if id < extent:
      let w = 1 + (id >> 5)
      let bit = 1 << (id & 31)
      let was = (meta[w] & bit) != 0
      values[id] := value
      if not was:
        meta[w] := self | bit
        let next_live = meta[0] + 1
        meta[0] := next_live
        if next_live == extent:
          @storage.truncate meta 0
          return $Pool { extent, flags: 0, meta, values }
      return $Pool { extent, flags: 2, meta, values }
    if id == extent:
      @storage.push values value
      let bit_idx = id & 31
      if bit_idx == 0:
        @storage.push meta 1
      else:
        meta[1 + (id >> 5)] := self | (1 << bit_idx)
      meta[0] := meta[0] + 1
      return $Pool { extent: extent + 1, flags: 2, meta, values }
    let promoted = promote_sparse ($Pool { extent, flags: 2, meta, values })
    return put_sparse_row promoted id value
  return put_sparse_row ($Pool { extent, flags, meta, values }) id value

// Internal/persistence insert that skips the live-entity check (historical
// snapshots may restore despawned rows within the saved entity extent).
func put_raw_row (pool: own Pool a) -> (id: U32) -> (value: a) : Pool a =>
  if pool.flags == 0 and id < pool.extent:
    pool.values[id] := value
    return pool
  return put_raw_slow pool id value

func put_row (alive: Entities) -> (pool: own Pool a) -> (id: U32) -> (value: a) : Pool a =>
  if not (live alive id):
    return panic "insert requires a live entity"
  if pool.flags == 0 and id < pool.extent:
    pool.values[id] := value
    return pool
  return put_raw_slow pool id value

func set_extent (pool: own Pool a) -> (target: U32) : Pool a =>
  let $Pool { extent, flags, meta, values } = pool
  if target <= extent:
    return $Pool { extent, flags, meta, values }
  if (flags & 1) == 0:
    if extent == 0:
      let cap: U32 = 8
      @storage.reserve meta (3 + cap)
      @storage.push meta 0
      @storage.push meta cap
      @storage.push meta 0
      for 0 .. cap:
        @storage.push meta 0
      return $Pool { extent: target, flags: 1, meta, values }
    let promoted = promote_sparse ($Pool { extent, flags, meta, values })
    let $Pool { extent: _, flags: p_flags, meta: p_meta, values: p_vals } = promoted
    return $Pool { extent: target, flags: p_flags, meta: p_meta, values: p_vals }
  return $Pool { extent: target, flags, meta, values }

func load_maybe_rows (decoded: &[Maybe a]) -> (pool: own Pool a) : Pool a =>
  let n = decoded.length
  if n == 0:
    return clear_pool pool
  let dense = true
  for i in 0 .. n:
    if let $Nothing = decoded[i]:
      dense := false
      break
  if dense:
    let $Pool { extent: _, flags: _, meta, values } = pool
    @storage.truncate meta 0
    @storage.truncate values 0
    @storage.reserve values n
    for i in 0 .. n:
      if let $Some v = decoded[i]:
        @storage.push values v
    return $Pool { extent: n, flags: 0, meta, values }
  let out = clear_pool pool
  for i in 0 .. n:
    if let $Some v = decoded[i]:
      out := put_raw_row self i v
  return set_extent out n

func pool_from (rows: #[Maybe a]) : Pool a =>
  return load_maybe_rows (&rows[0..rows.length]) (pool ())

private func remove_sparse_row (pool: own Pool a) -> (id: U32) : Pool a =>
  let $Pool { extent, flags, meta, values } = pool
  let (existing, b_slot) = sparse_probe meta id
  if existing == tombstone:
    return $Pool { extent, flags, meta, values }
  let cap = meta[1]
  let id_base = 3 + cap
  let last = values.length - 1
  meta[3 + b_slot] := tombstone
  meta[0] := meta[0] - 1
  let next_flags = flags
  if existing != last:
    let moved_id = meta[id_base + last]
    meta[id_base + existing] := moved_id
    values[existing] := values[last]
    let mask = cap - 1
    let scan = hash_id moved_id & mask
    let want = last + 1
    for 0 .. cap:
      if meta[3 + scan] == want:
        meta[3 + scan] := existing + 1
        break
      scan := (self + 1) & mask
    next_flags := 3
  @storage.truncate meta (id_base + last)
  @storage.truncate values last
  return $Pool { extent, flags: next_flags, meta, values }

func remove_row (pool: own Pool a) -> (id: U32) : Pool a =>
  if id >= pool.extent:
    return pool
  if pool.flags == 2:
    let w = 1 + (id >> 5)
    let bit = 1 << (id & 31)
    if (pool.meta[w] & bit) != 0:
      pool.meta[w] := self & (all32 ^ bit)
      pool.meta[0] := pool.meta[0] - 1
    return pool
  if pool.flags == 0:
    let $Pool { extent, flags: _, meta, values } = pool
    let full = extent >> 5
    let rem = extent & 31
    let words_needed = full + (if rem > 0 then 1 else 0)
    @storage.reserve meta (1 + words_needed)
    @storage.push meta (extent - 1)
    for 0 .. full:
      @storage.push meta all32
    if rem > 0:
      @storage.push meta ((1 << rem) - 1)
    meta[1 + (id >> 5)] := self & (all32 ^ (1 << (id & 31)))
    return $Pool { extent, flags: 2, meta, values }
  return remove_sparse_row pool id

// IDs are monotonic within an epoch. A despawn never silently recycles one.
func spawn (alive: own Entities) -> (meta: own Metadata) : (U32, Entities, Metadata) =>
  let id = alive.count
  let alive = spawn_entity alive
  let meta = bump_membership meta
  return (id, alive, meta)

// Application static schema calls remove on every registered pool first.
func despawn (alive: own Entities) -> (meta: own Metadata) -> (id: U32) : (Entities, Metadata) =>
  let was_live = live alive id
  let alive = despawn_entity alive id
  let meta = if was_live then bump_membership meta else meta
  return (alive, meta)

// Batch IDs remain monotonic and ordered exactly like individual spawns.
func spawn_many (alive: own Entities) -> (meta: own Metadata) -> (count: U32) : (#[U32], Entities, Metadata) =>
  let $Entities { count: first, words } = alive
  if count > no_entity - first:
    return panic "entity identity exhausted"
  if count > 0xFFFFFFFF - meta[2]:
    return panic "ECS revision exhausted"
  let ids = @array.generate count (func i => first + i)
  meta[2] := meta[2] + count
  let end = first + count
  if count > 0:
    let total_words = (end + 63) >> 6
    if total_words > words.length:
      @storage.reserve words (total_words - words.length)
      for words.length .. total_words:
        @storage.push words zero64
    let start_w = first >> 6
    let start_b = first & 63
    let end_w = (end - 1) >> 6
    let end_b = (end - 1) & 63
    let head_mask = U64.shl all64 (U32.to_u64 start_b)
    let tail_mask = if end_b == 63 then all64 else U64.sub (U64.shl one64 (U32.to_u64 (end_b + 1))) one64
    if start_w == end_w:
      words[start_w] := U64.bit_or self (U64.bit_and head_mask tail_mask)
    else:
      words[start_w] := U64.bit_or self head_mask
      for wi in start_w + 1 .. end_w:
        words[wi] := all64
      words[end_w] := U64.bit_or self tail_mask
  return (ids, $Entities { count: end, words }, meta)

func write (pool: own Pool a) -> (meta: own Metadata) -> (id: U32) -> (value: a) : (Pool a, Metadata) =>
  let pool = write_row pool id value
  let meta = bump_payload meta
  return (pool, meta)
func insert (alive: Entities) -> (pool: own Pool a) -> (meta: own Metadata) -> (id: U32) -> (value: a) : (Pool a, Metadata) =>
  let present = contains pool id
  let pool = put_row alive pool id value
  let meta = bump_insert present meta
  return (pool, meta)
func remove (pool: own Pool a) -> (meta: own Metadata) -> (id: U32) : (Pool a, Metadata) =>
  let present = contains pool id
  let pool = remove_row pool id
  let meta = bump_remove present meta
  return (pool, meta)

// Ordered writes preserve the per-row revision contract. Both inputs are read
// in their given order; repeated IDs deliberately keep the last value.
func insert_selected (alive: Entities) -> (pool: own Pool a) -> (meta: own Metadata) -> (ids: #[U32]) -> (values: #[a]) : (Pool a, Metadata) =>
  let n = ids.length
  if n != values.length:
    return panic "component batch lengths differ"
  if n == 0:
    return (pool, meta)
  let first = pool.extent
  let append = pool.flags == 0
  for i in 0 .. n:
    let id = ids[i]
    if not (live alive id):
      return panic "insert requires a live entity"
    if id < first or id - first != i:
      append := false
  if append:
    if n > 0xFFFFFFFF - meta[1] or n > 0xFFFFFFFF - meta[2]:
      return panic "ECS revision exhausted"
    let $Pool { extent: _, flags: _, meta: p_meta, values: p_vals } = pool
    @storage.reserve p_vals n
    for i in 0 .. n:
      @storage.push p_vals values[i]
    meta[1] := meta[1] + n
    meta[2] := meta[2] + n
    return ($Pool { extent: first + n, flags: 0, meta: p_meta, values: p_vals }, meta)
  let struct_bumps: U32 = 0
  for i in 0 .. n:
    let id = ids[i]
    if not (contains pool id):
      struct_bumps := self + 1
    pool := put_raw_row self id values[i]
  if n > 0xFFFFFFFF - meta[1] or struct_bumps > 0xFFFFFFFF - meta[2]:
    return panic "ECS revision exhausted"
  meta[1] := meta[1] + n
  meta[2] := meta[2] + struct_bumps
  return (pool, meta)

const insert_many = insert_selected

// Replace membership explicitly, retaining neither an implicit old column nor
// dead-entity payloads. Live present rows count as ordinary payload writes.
func replace_components (alive: Entities) -> (pool: own Pool a) -> (meta: own Metadata) -> (values: #[Maybe a]) : (Pool a, Metadata) =>
  let v_len = values.length
  let alive_len = alive.count
  let p_extent = pool.extent
  let payload_bumps: U32 = 0
  let struct_bumps: U32 = 0
  let common_live = min v_len alive_len
  for id in 0 .. common_live:
    let present = contains pool id
    if live alive id:
      if let $Some _ = values[id]:
        payload_bumps := self + 1
        if not present:
          struct_bumps := self + 1
      else:
        if present:
          payload_bumps := self + 1
          struct_bumps := self + 1
    else:
      if present:
        payload_bumps := self + 1
        struct_bumps := self + 1
  if p_extent > common_live:
    let flags = pool.flags
    if flags == 0:
      let tail = p_extent - common_live
      payload_bumps := self + tail
      struct_bumps := self + tail
    else:
      if flags == 2:
        for id in common_live .. p_extent:
          if ((pool.meta[1 + (id >> 5)] >> (id & 31)) & 1) != 0:
            payload_bumps := self + 1
            struct_bumps := self + 1
      else:
        let id_base = 3 + pool.meta[1]
        let live_n = pool.meta[0]
        for k in 0 .. live_n:
          if pool.meta[id_base + k] >= common_live:
            payload_bumps := self + 1
            struct_bumps := self + 1
  if payload_bumps > 0xFFFFFFFF - meta[1] or struct_bumps > 0xFFFFFFFF - meta[2]:
    return panic "ECS revision exhausted"
  meta[1] := meta[1] + payload_bumps
  meta[2] := meta[2] + struct_bumps
  let last_live: U32 = 0
  let has_live = false
  let all_dense = true
  for id in 0 .. common_live:
    if live alive id:
      if let $Some _ = values[id]:
        last_live := id
        has_live := true
      else:
        all_dense := false
    else:
      all_dense := false
  if not has_live:
    return (clear_pool pool, meta)
  if all_dense and last_live + 1 == common_live:
    return (load_maybe_rows (&values[0..common_live]) pool, meta)
  let pool = clear_pool pool
  for id in 0 .. common_live:
    if live alive id:
      if let $Some value = values[id]:
        pool := put_raw_row self id value
  return (pool, meta)

// Supply identity only for flat payloads. Owning nested payloads require an
// explicit copy policy; pool descriptors never imply an independent snapshot.
func copy_into copy_value -> (destination: own Pool a) -> (source: Pool a) : Pool a =>
  if source.extent == 0:
    return clear_pool destination
  let $Pool { extent: _, flags: _, meta: d_meta, values: d_vals } = destination
  let flags = source.flags
  if flags == 0 or (flags & 1) != 0:
    let n = source.values.length
    let common = min n d_vals.length
    for i in 0 .. common:
      d_vals[i] := copy_value source.values[i]
    if n > common:
      @storage.reserve d_vals (n - common)
      for i in common .. n:
        @storage.push d_vals (copy_value source.values[i])
    if d_vals.length > n:
      @storage.truncate d_vals n
    @storage.truncate d_meta 0
    if source.meta.length > 0:
      @storage.extend d_meta (&source.meta[0..source.meta.length])
    return $Pool { extent: source.extent, flags, meta: d_meta, values: d_vals }
  // Dense with holes: compact into sparse destination so copy_value never touches dead rows.
  let extent = source.extent
  let live_count = source.meta[0]
  let kept_ids: #[U32] = @storage.with_capacity live_count
  @storage.truncate d_vals 0
  @storage.reserve d_vals live_count
  let full = extent >> 5
  for wi in 0 .. full:
    let w = source.meta[1 + wi]
    let base = wi << 5
    for 0 .. 32:
      if w == 0:
        break
      let id = base + ctz32 w
      @storage.push kept_ids id
      @storage.push d_vals (copy_value source.values[id])
      w := self & (self - 1)
  let rem = extent & 31
  if rem > 0:
    let w = source.meta[1 + full] & ((1 << rem) - 1)
    let base = full << 5
    for 0 .. 32:
      if w == 0:
        break
      let id = base + ctz32 w
      @storage.push kept_ids id
      @storage.push d_vals (copy_value source.values[id])
      w := self & (self - 1)
  let cap = next_bucket_cap (max 8 ((kept_ids.length + 1) * 2))
  let next_meta = build_sparse_meta d_meta kept_ids cap
  return $Pool { extent, flags: 1, meta: next_meta, values: d_vals }

const checkpoint = copy_into

func indices (alive: Entities) -> pool : #[U32] =>
  let limit = min alive.count pool.extent
  if limit == 0:
    let empty: #[U32] = #[]
    return empty
  let a_words = alive.words
  let flags = pool.flags
  if flags == 0:
    let selected: #[U32] = @storage.with_capacity limit
    let full = limit >> 6
    for wi in 0 .. full:
      let w = a_words[wi]
      if w == zero64:
        continue
      let base = wi << 6
      if U64.eq w all64:
        for b in 0 .. 64:
          @storage.push selected (base + b)
      else:
        for 0 .. 64:
          if U64.eq w zero64:
            break
          @storage.push selected (base + ctz64 w)
          w := U64.bit_and self (U64.sub self one64)
    let rem = limit & 63
    if rem > 0:
      let mask = U64.sub (U64.shl one64 (U32.to_u64 rem)) one64
      let w = U64.bit_and a_words[full] mask
      let base = full << 6
      for 0 .. 64:
        if U64.eq w zero64:
          break
        @storage.push selected (base + ctz64 w)
        w := U64.bit_and self (U64.sub self one64)
    return selected
  let p_live = pool.meta.at 0
  if p_live == 0:
    let empty: #[U32] = #[]
    return empty
  if flags == 2:
    let selected: #[U32] = @storage.with_capacity (min limit p_live)
    let full = limit >> 5
    for wi in 0 .. full:
      let aw64 = a_words[wi >> 1]
      let aw32 = U64.to_u32 (if (wi & 1) == 0 then aw64 else U64.shr aw64 32u64)
      let w = aw32 & pool.meta.at (1 + wi)
      if w == 0:
        continue
      let base = wi << 5
      if w == all32:
        for b in 0 .. 32:
          @storage.push selected (base + b)
      else:
        for 0 .. 32:
          if w == 0:
            break
          @storage.push selected (base + ctz32 w)
          w := self & (self - 1)
    let rem = limit & 31
    if rem > 0:
      let aw64 = a_words[full >> 1]
      let aw32 = U64.to_u32 (if (full & 1) == 0 then aw64 else U64.shr aw64 32u64)
      let w = aw32 & pool.meta.at (1 + full) & ((1 << rem) - 1)
      let base = full << 5
      for 0 .. 32:
        if w == 0:
          break
        @storage.push selected (base + ctz32 w)
        w := self & (self - 1)
    return selected
  let cap = pool.meta.at 1
  let id_base = 3 + cap
  let selected: #[U32] = @storage.with_capacity p_live
  let a_count = alive.count
  for k in 0 .. p_live:
    let id = pool.meta.at (id_base + k)
    if id < a_count and U64.ne (U64.bit_and (U64.shr a_words[id >> 6] (U32.to_u64 (id & 63))) one64) zero64:
      @storage.push selected id
  if flags == 1 or selected.length <= 1:
    return selected
  let order = sort.order_u32 selected
  let out: #[U32] = @storage.with_capacity selected.length
  for i in 0 .. order.length:
    @storage.push out selected[order[i]]
  return out

func reset (fresh_epoch: U32) -> (pool: own Pool a) -> (meta: own Metadata) : (Pool a, Metadata) =>
  if fresh_epoch == meta[0]:
    return panic "reset requires a fresh world epoch"
  let pool = clear_pool pool
  meta[0] := fresh_epoch
  meta[1] := 0
  meta[2] := 0
  return (pool, meta)

// Journal owners are separate from component owners. No synchronous observers.
func insert_tracked alive -> (pool: own Pool a) -> (meta: own Metadata) -> (own log) -> (own log_meta) -> id -> value =>
  let present = contains pool id
  let (pool, meta) = insert alive pool meta id value
  let (log, log_meta) = journal.record (if present then $journal.Updated id else $journal.Added id) log log_meta
  return (pool, meta, log, log_meta)
func write_tracked (pool: own Pool a) -> (meta: own Metadata) -> (own log) -> (own log_meta) -> id -> value =>
  let (pool, meta) = write pool meta id value
  let (log, log_meta) = journal.record ($journal.Updated id) log log_meta
  return (pool, meta, log, log_meta)
func remove_tracked (pool: own Pool a) -> (meta: own Metadata) -> (own log) -> (own log_meta) -> id =>
  if contains pool id:
    let (pool, meta) = remove pool meta id
    let (log, log_meta) = journal.record ($journal.Removed id) log log_meta
    return (pool, meta, log, log_meta)
  return (pool, meta, log, log_meta)
