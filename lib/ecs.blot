import * as array from "std/array"

type Builder [world, scope, checkpoint, schema] is data = #Builder { initial: world, scope: world -> scope, checkpoint: checkpoint, schema: schema }
type Simulation [world, scope, checkpoint] is data = #Simulation { initial: world, scope: world -> scope, checkpoint: checkpoint }
type End is data = #End
type Entry { head, tail } is data = #Entry { head, tail }
// A column keeps its entities' components in leaves of 32 slots, gathered 16
// leaves to a block. A scoped `set` or `remove` copies one leaf, its block and
// the list of blocks. The arrays they still share are small: releasing a
// shared array queues it for the cycle collector, which then revisits it.
type Column component is data = #Column (Array (Array (Array (Maybe component))))
type Snapshot value is data = #Snapshot value
// An immutable column snapshot. Reads allocate no whole entity-sized array.
type ReadView component is data = #ReadView { count: U32, bits: Array U32, values: Array (Array (Array (Maybe component))) }
// How many entities there have been, and a bit per entity, 32 to a word,
// set while it is alive. Bits past the count are clear.
type Entities is data = #Entities { count: U32, bits: Array U32 }
// The scoped entity, or `no_entity` outside any scope: a plain U32 needs no
// Maybe of its own each time a scope is entered.
type Entity is data = #Entity U32

type State a is effect = {
  get: Unit -> a
  set: a -> Unit
}

const End.contains = fn (end: End) => fn witness => #False

const Entry.contains = fn entry => fn witness => do:
  let #Entry { head, tail } = entry
  if :head == :witness:
    return #True
  return tail.contains(witness)

const get = fn (witness: p -> a) -> a => State.get ()
const set = fn value => State.set value

// Builders are rebuilt field by field: a path update such as
// `builder.initial := (value, self)` changes the builder's type, and blotc
// crashes when such a generic helper is applied twice.
const empty = fn () => do:
  let scope = fn world => fn action => do:
    use result <- action ()
    return (world, result)
  return #Builder { initial: (), scope, checkpoint: fn () => (), schema: #End }

const insert_cell = fn (initial: cell) => fn (builder: Builder [previous, scope, checkpoint, schema]) => do:
  let #Builder { initial: previous_initial, scope: previous_scope, checkpoint, schema } = builder
  let scope = fn (world: (cell, previous)) => fn action => do:
    let (current, previous) = world
    use outcome <- @effect.run State.get State.set current (fn () => previous_scope previous action)
    let (next, (previous_next, result)) = outcome
    return ((next, previous_next), result)
  return #Builder { initial: (initial, previous_initial), scope, checkpoint, schema }

const insert_snapshotted = fn initial => fn builder => do:
  let #Builder { checkpoint: previous_checkpoint } = builder
  builder := insert_cell initial self
  builder := insert_cell (#Snapshot initial) self
  let #Builder { initial: initial_world, scope, schema } = builder
  let checkpoint = fn () => do:
    use previous_checkpoint ()
    use current <- get (fn () => initial)
    use set (#Snapshot current)
  return #Builder { initial: initial_world, scope, checkpoint, schema }

const insert_resource = fn value => fn builder => do:
  let #Builder { schema } = builder
  if schema.contains(value):
    return @panic "resource type already initialized"
  let #Builder { initial, scope, checkpoint } = insert_cell value builder
  return #Builder { initial, scope, checkpoint, schema: #Entry { head: value, tail: schema } }

// Snapshotted resources and components also keep their value from the last
// checkpoint, readable through `previous` and `previous_components`.
const insert_snapshotted_resource = fn value => fn builder => do:
  let #Builder { schema } = builder
  if schema.contains(value):
    return @panic "resource type already initialized"
  let #Builder { initial, scope, checkpoint } = insert_snapshotted value builder
  return #Builder { initial, scope, checkpoint, schema: #Entry { head: value, tail: schema } }

// Spawning stops before this count, so no entity has it.
const no_entity = 4294967295

const new = fn () => do:
  let builder = empty ()
  builder := insert_cell #Entities { count: 0, bits: #[] } self
  builder := insert_cell (#Entity no_entity) self
  return builder

// The 32-bit words holding `count` bits.
const words = fn (count: U32) => do:
  let full = count >> 5
  if count & 31 != 0:
    return full + 1
  return full

const live = fn (bits: Array U32) => fn (selected: U32) => (bits[selected >> 5] >> (selected & 31)) & 1 != 0

// The low `count` bits of a word set, for count up to 32.
const low_bits = fn (count: U32) => do:
  if count >= 32:
    return 0xFFFFFFFF
  return (1 << count) - 1

// Every entity's alive flag, indexed by entity.
const entities = fn () => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  return array.generate count (fn selected => live bits selected)

const replace_entities = fn (alive: Array Bool) => do:
  let count = alive.length
  return set #Entities { count, bits: array.generate (words count) (fn word => do:
    let start = word << 5
    let packed = 0
    for offset in 0 .. 32:
      let selected = start + offset
      if selected < count:
        if alive[selected]:
          packed := self | (1 << offset)
    return packed) }

// Entity `selected`, checked to be alive.
const existing = fn (selected: U32) => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  if selected >= count:
    return @panic "entity is outside the world"
  if Bool.not (live bits selected):
    return @panic "entity has been removed"
  return selected

// The scoped entity lives in the world rather than in a provider: component
// readers run in their own scope, outside any provider a system installs.
const entity = fn () => do:
  use current_entity <- get #Entity
  let #Entity selected = current_entity
  if selected == no_entity:
    return @panic "component access requires an entity scope"
  return existing selected

const leaf_bits = 5
const leaf_size = 32
const leaf_mask = 31
const branch_bits = 4
const branch_mask = 15
const block_leaves = 16
const block_bits = 9
const block_slots = 512

// How many units of `1 << bits` cover `count`.
const units = fn (count: U32) => fn (bits: U32) => do:
  let whole = count >> bits
  if count & ((1 << bits) - 1) != 0:
    return whole + 1
  return whole

// Bounds-checked indexing rather than `values.get`, through which each read
// made cycle-collector work grow with the column (see docs/blot.md).
const component_at = fn blocks => fn selected => do:
  let block = selected >> block_bits
  if block < blocks.length:
    let leaves = blocks[block]
    let leaf = (selected >> leaf_bits) & branch_mask
    if leaf < leaves.length:
      let slots = leaves[leaf]
      let slot = selected & leaf_mask
      if slot < slots.length:
        return slots[slot]
  return #Nothing

// A column of `count` slots, `slot_at` giving each; the last leaf pads with
// Nothing and the last block holds only the leaves it needs.
const chunked = fn (count: U32) => fn slot_at => do:
  let leaves = units count leaf_bits
  return array.generate (units leaves branch_bits) (fn block => do:
    let first_leaf = block << branch_bits
    return array.generate (min block_leaves (leaves - first_leaf)) (fn leaf => do:
      let start = (first_leaf + leaf) << leaf_bits
      return array.generate leaf_size (fn slot => do:
        let selected = start + slot
        if selected < count:
          return slot_at selected
        return #Nothing)))

// `values` as a column: whole leaves are sliced out, the last one padded.
const chunks_of = fn (values: Array (Maybe a)) => do:
  let count = values.length
  let leaves = units count leaf_bits
  return array.generate (units leaves branch_bits) (fn block => do:
    let first_leaf = block << branch_bits
    return array.generate (min block_leaves (leaves - first_leaf)) (fn leaf => do:
      let start = (first_leaf + leaf) << leaf_bits
      if count - start >= leaf_size:
        return array.slice start leaf_size values
      return array.generate leaf_size (fn slot => do:
        let selected = start + slot
        if selected < count:
          return values[selected]
        return #Nothing)))

// `leaves` grown to reach leaf `leaf`, whose slot `slot` holds `entry`.
const grown_block = fn leaves => fn (leaf: U32) => fn (slot: U32) => fn entry =>
  array.generate (leaf + 1) (fn index => do:
    if index < leaves.length:
      return leaves[index]
    return array.generate leaf_size (fn at => do:
      if index == leaf && at == slot:
        return entry
      return #Nothing))

// `blocks` with slot `selected` holding `entry`: one leaf, its block and the
// list of blocks are copied, growing to reach the slot.
const placed = fn blocks => fn (selected: U32) => fn entry => do:
  let block = selected >> block_bits
  let leaf = (selected >> leaf_bits) & branch_mask
  let slot = selected & leaf_mask
  if block < blocks.length:
    let leaves = blocks[block]
    if leaf < leaves.length:
      let slots = leaves[leaf]
      slots[slot] := entry
      leaves[leaf] := slots
      blocks[block] := leaves
      return blocks
    blocks[block] := grown_block leaves leaf slot entry
    return blocks
  let none = array.generate 0 (fn index => array.fill leaf_size entry)
  return array.generate (block + 1) (fn index => do:
    if index < blocks.length:
      return blocks[index]
    if index == block:
      return grown_block none leaf slot entry
    return none)

const read_component = fn exemplar => fn () => do:
  use selected <- entity ()
  use column <- get (fn () => #Column #[#[#[#Some exemplar]]])
  let #Column values = column
  let #Some value = component_at values selected else:
    return @panic "entity does not have the requested component"
  return value

const write_component = fn value => do:
  use selected <- entity ()
  use column <- get (fn () => #Column #[#[#[#Some value]]])
  let #Column chunks = column
  return set (#Column (placed chunks selected (#Some value)))

const read_previous_component = fn exemplar => fn () => do:
  use selected <- entity ()
  use stored <- get (fn () => #Snapshot (#Column #[#[#[#Some exemplar]]]))
  let #Snapshot (#Column previous) = stored
  if let #Some value = component_at previous selected:
    return #Snapshot value
  use current <- read_component exemplar ()
  return #Snapshot current

const register_component = fn exemplar => fn builder => do:
  let #Builder { schema } = builder
  if schema.contains(exemplar):
    return @panic "component type already registered"
  let initial_column = #Column (array.generate 0 (fn index => #[#[#Some exemplar]]))
  let #Builder { initial, scope, checkpoint } = insert_cell initial_column builder
  let next_scope = fn world => fn action => scope world (fn () =>
    @effect.reader State.get exemplar (read_component exemplar) (fn () =>
      @effect.writer State.set exemplar write_component action))
  return #Builder { initial, scope: next_scope, checkpoint, schema: #Entry { head: exemplar, tail: schema } }

const register_snapshotted_component = fn exemplar => fn builder => do:
  let #Builder { schema } = builder
  if schema.contains(exemplar):
    return @panic "component type already registered"
  let initial_column = #Column (array.generate 0 (fn index => #[#[#Some exemplar]]))
  let #Builder { initial, scope, checkpoint } = insert_snapshotted initial_column builder
  let next_scope = fn world => fn action => scope world (fn () =>
    @effect.reader State.get (#Snapshot exemplar) (read_previous_component exemplar) (fn () =>
      @effect.reader State.get exemplar (read_component exemplar) (fn () =>
        @effect.writer State.set exemplar write_component action)))
  return #Builder { initial, scope: next_scope, checkpoint, schema: #Entry { head: exemplar, tail: schema } }

const add_plugin = fn plugin => fn builder => plugin builder

const build = fn builder => do:
  let #Builder { initial, scope, checkpoint } = builder
  return #Simulation { initial, scope, checkpoint }

const run = fn simulation => fn world => fn action => do:
  let #Simulation { scope } = simulation
  return scope world action

const create = fn simulation => fn action => do:
  let #Simulation { initial } = simulation
  return run simulation initial action

const checkpoint = fn simulation => do:
  let #Simulation { checkpoint } = simulation
  return checkpoint ()

const replace_previous = fn value => set (#Snapshot value)

const previous = fn constructor => do:
  use stored <- get (fn payload => #Snapshot (constructor payload))
  let #Snapshot value = stored
  return value

// Runs `action` scoped to entity `selected`, so component `get` and `set`
// address it. Scopes nest; the outer one is restored afterwards.
const at = fn selected => fn action => do:
  use existing selected
  use previous <- get #Entity
  use set (#Entity selected)
  use result <- action ()
  use set previous
  return result

// `bits` with `count` more live entities after the first `existing`.
const grown = fn (bits: Array U32) => fn (existing: U32) => fn (count: U32) => do:
  let total = existing + count
  return array.generate (words total) (fn word => do:
    let start = word << 5
    let kept = if word < bits.length then bits[word] else 0
    let low = if existing > start then existing - start else 0
    let high = if total > start then total - start else 0
    return kept | (low_bits high & (0xFFFFFFFF ^ low_bits low)))

const spawn = fn action => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  if count == 4294967295:
    return @panic "entity count overflow"
  use set #Entities { count: count + 1, bits: grown bits count 1 }
  use at count action
  return count

// Adds `count` live entities at once, without components, and returns the
// first one. Give them components with `insert_many`.
const spawn_many = fn (count: U32) => do:
  use current <- get #Entities
  let #Entities { count: first, bits } = current
  if count > 4294967295 - first:
    return @panic "entity count overflow"
  use set #Entities { count: first + count, bits: grown bits first count }
  return first

// Gives entity `first + index` the component `values[index]`, writing the
// column once rather than once per entity.
const insert_many = fn (constructor: p -> a) => fn (first: U32) => fn (values: Array a) => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  if first > count || values.length > count - first:
    return @panic "component range is outside the world"
  for selected in first .. first + values.length:
    if Bool.not (live bits selected):
      return @panic "component range contains a removed entity"
  use column <- get (fn payload => #Column #[#[#[#Some (constructor payload)]]])
  let #Column stored = column
  let end = first + values.length
  let leaves = units end leaf_bits
  // Blocks and leaves outside the range are kept as they are.
  return set (#Column (array.generate (max stored.length (units leaves branch_bits)) (fn block => do:
    let start = block << block_bits
    if block < stored.length && (start >= end || (first > start && first - start >= block_slots)):
      return stored[block]
    let kept = if block < stored.length then stored[block] else array.generate 0 (fn index => array.generate leaf_size (fn slot => component_at stored slot))
    let first_leaf = block << branch_bits
    let needed = if leaves > first_leaf then min block_leaves (leaves - first_leaf) else 0
    return array.generate (max kept.length needed) (fn leaf => do:
      let leaf_start = start + (leaf << leaf_bits)
      if leaf < kept.length && (leaf_start >= end || (first > leaf_start && first - leaf_start >= leaf_size)):
        return kept[leaf]
      return array.generate leaf_size (fn slot => do:
        let index = leaf_start + slot
        if index >= first && index < end:
          return #Some values[index - first]
        return component_at stored index)))))

const despawn = fn selected => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  if selected >= count:
    return @panic "entity is outside the world"
  let word = selected >> 5
  bits[word] := self & (0xFFFFFFFF ^ (1 << (selected & 31)))
  use set #Entities { count, bits }

const alive = fn selected => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  if selected < count:
    return live bits selected
  return #False

const remove = fn (constructor: p -> a) => do:
  use selected <- entity ()
  use column <- get (fn payload => #Column #[#[#[#Some (constructor payload)]]])
  let #Column blocks = column
  if Maybe.is_some (component_at blocks selected):
    use set (#Column (placed blocks selected #Nothing))

// Every live entity's component, or Nothing, indexed by entity.
const components = fn constructor => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use column <- get (fn payload => #Column #[#[#[#Some (constructor payload)]]])
  let #Column values = column
  return array.generate count (fn selected => do:
    if live bits selected:
      return component_at values selected
    return #Nothing)

// The values of the entries that have one, counted and then copied into an
// array of that length.
const somes = fn (entries: Array (Maybe a)) => do:
  let found = 0
  let seed = #Nothing
  for entry in entries:
    if Maybe.is_some entry:
      if found == 0:
        seed := entry
      found := self + 1
  let #Some first = seed else:
    return #[]
  let values = array.fill found first
  let at = 0
  for entry in entries:
    if let #Some value = entry:
      values[at] := value
      at := self + 1
  return values

// A view remains a snapshot when the world is subsequently edited.
const view = fn constructor => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use column <- get (fn payload => #Column #[#[#[#Some (constructor payload)]]])
  let #Column values = column
  return #ReadView { count, bits, values }
const previous_view = fn constructor => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use stored <- get (fn payload => #Snapshot (#Column #[#[#[#Some (constructor payload)]]]))
  let #Snapshot (#Column values) = stored
  return #ReadView { count, bits, values }
const read = fn (view: ReadView a) => fn (selected: U32) => do:
  if selected < view.count:
    if live view.bits selected:
      return component_at view.values selected
  return #Nothing

// Count and copy present components directly from the column. Do not first
// build every entity's optional slot, especially for sparse columns.
const present = fn constructor => do:
  use source <- view constructor
  let found = 0
  let seed = #Nothing
  for index in 0 .. source.count:
    if let #Some value = read source index:
      if found == 0:
        seed := #Some value
      found := self + 1
  let #Some first = seed else:
    return #[]
  let values = array.fill found first
  let at = 0
  for index in 0 .. source.count:
    if let #Some value = read source index:
      values[at] := value
      at := self + 1
  return values

const replace_components = fn (constructor: p -> a) => fn (values: Array (Maybe a)) =>
  set (#Column (chunks_of values))

// Entity `selected`'s component, if it is alive and has one: one cell, where
// `components` builds the whole column.
const component_of = fn constructor => fn (selected: U32) => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use column <- get (fn payload => #Column #[#[#[#Some (constructor payload)]]])
  let #Column values = column
  if selected >= count:
    return #Nothing
  if live bits selected:
    return component_at values selected
  return #Nothing

// Its snapshotted component's value from the previous fixed step, if any.
const previous_component_of = fn constructor => fn (selected: U32) => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use stored <- get (fn payload => #Snapshot (#Column #[#[#[#Some (constructor payload)]]]))
  let #Snapshot (#Column previous) = stored
  if selected >= count:
    return #Nothing
  if live bits selected:
    return component_at previous selected
  return #Nothing

const previous_components = fn constructor => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use stored <- get (fn payload => #Snapshot (#Column #[#[#[#Some (constructor payload)]]]))
  let #Snapshot (#Column previous) = stored
  return array.generate count (fn selected => do:
    if live bits selected:
      return component_at previous selected
    return #Nothing)

const replace_previous_components = fn (constructor: p -> a) => fn (values: Array (Maybe a)) =>
  set (#Snapshot (#Column (chunks_of values)))

// Column-wise systems. Each replaces the components of every live entity that
// has all the named ones with what pure `step` returns, and writes each column
// once. Entities missing one keep theirs. Use these for work across many
// entities: a scoped `set`, as in `query`, copies a leaf and a block.
const update = fn (constructor: p -> a) => fn step => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use column <- get (fn payload => #Column #[#[#[#Some (constructor payload)]]])
  let #Column chunks = column
  return set (#Column (chunked count (fn selected => do:
    if live bits selected:
      return Maybe.map step (component_at chunks selected)
    return #Nothing)))

const stepped_pair = fn step => fn first => fn second => case first, second of
  #Some a, #Some b => do:
    let (next_a, next_b) = step a b
    return (#Some next_a, #Some next_b)
  a, b => (a, b)

const update_pair = fn (left: p -> a) => fn (right: q -> b) => fn step => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use left_column <- get (fn payload => #Column #[#[#[#Some (left payload)]]])
  use right_column <- get (fn payload => #Column #[#[#[#Some (right payload)]]])
  let #Column lefts = left_column
  let #Column rights = right_column
  let pairs = array.generate count (fn index => do:
    if live bits index:
      return stepped_pair step (component_at lefts index) (component_at rights index)
    return (#Nothing, #Nothing))
  use set (#Column (chunked pairs.length (fn index => do:
    let (next, _) = pairs[index]
    return next)))
  return set (#Column (chunked pairs.length (fn index => do:
    let (_, next) = pairs[index]
    return next)))

const update_triple = fn (first: p -> a) => fn (second: q -> b) => fn (third: r -> c) => fn step =>
  update_triple_indexed first second third (fn index => step)

const stepped_triple = fn step => fn index => fn first => fn second => fn third => case first, second, third of
  #Some a, #Some b, #Some c => do:
    let (next_a, next_b, next_c) = step index a b c
    return (#Some next_a, #Some next_b, #Some next_c)
  a, b, c => (a, b, c)

// `update_triple` whose step also receives the entity.
const update_triple_indexed = fn (first: p -> a) => fn (second: q -> b) => fn (third: r -> c) => fn step => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use first_column <- get (fn payload => #Column #[#[#[#Some (first payload)]]])
  use second_column <- get (fn payload => #Column #[#[#[#Some (second payload)]]])
  use third_column <- get (fn payload => #Column #[#[#[#Some (third payload)]]])
  let #Column firsts = first_column
  let #Column seconds = second_column
  let #Column thirds = third_column
  let leaves = units count leaf_bits
  let results = array.generate leaves (fn leaf => do:
    let start = leaf << leaf_bits
    let present = fn source => fn slot => do:
      let index = start + slot
      if index < count:
        if live bits index:
          return component_at source index
      return #Nothing
    let next_first = array.generate leaf_size (present firsts)
    let next_second = array.generate leaf_size (present seconds)
    let next_third = array.generate leaf_size (present thirds)
    for slot in 0 .. min leaf_size (count - start):
      if let #Some a = next_first[slot]:
        if let #Some b = next_second[slot]:
          if let #Some c = next_third[slot]:
            let (next_a, next_b, next_c) = step (start + slot) a b c
            next_first[slot] := #Some next_a
            next_second[slot] := #Some next_b
            next_third[slot] := #Some next_c
    return (next_first, next_second, next_third))
  let grouped = fn selected => array.generate (units leaves branch_bits) (fn block => do:
    let first_leaf = block << branch_bits
    return array.generate (min block_leaves (leaves - first_leaf)) (fn leaf => selected results[first_leaf + leaf]))
  use set (#Column (grouped (fn triple => do:
    let (next, _, _) = triple
    return next)))
  use set (#Column (grouped (fn triple => do:
    let (_, next, _) = triple
    return next)))
  return set (#Column (grouped (fn triple => do:
    let (_, _, next) = triple
    return next)))

// Effectful per-entity visits, scoped with `at`. Suited to a few entities.
// They visit the components as they were when the query began.
const query = fn constructor => fn action => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use column <- get (fn payload => #Column #[#[#[#Some (constructor payload)]]])
  let #Column chunks = column
  for selected in 0 .. count:
    if live bits selected:
      use case component_at chunks selected of
        #Nothing => ()
        #Some value => at selected (fn () => action value)

const query_pair = fn left => fn right => fn action => do:
  use current <- get #Entities
  let #Entities { count, bits } = current
  use left_column <- get (fn payload => #Column #[#[#[#Some (left payload)]]])
  use right_column <- get (fn payload => #Column #[#[#[#Some (right payload)]]])
  let #Column lefts = left_column
  let #Column rights = right_column
  for selected in 0 .. count:
    if live bits selected:
      use case component_at lefts selected, component_at rights selected of
        #Some left_value, #Some right_value => at selected (fn () => action left_value right_value)
        _, _ => ()
