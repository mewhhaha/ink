import { Vec3 } from "std/vector"
import * as math from "./math"
import * as random from "./random"

type Candidate is data = $Candidate { position: Vec3, priority: U32, x: F32, z: F32 }
// Integer world-cell coordinates encoded modulo 2^32 without float-to-unsigned
// conversion of negatives. Cell coordinates must be exactly representable F32.
func word (value: F32) =>
  if value < 0.0:
    return 0 - F32.to_u32 (F32.neg value)
  return F32.to_u32 value
func hash (seed: U32) => func (x: F32) => func (z: F32) =>
  let state = random.next ((word x * 374761393) ^ (word z * 668265263) ^ seed ^ 2246822519)
  return random.next (state * 3266489917)
// One independently seeded candidate per global cell. No iteration-owned RNG.
func candidate (seed: U32) => func (cell: F32) => func (x: F32) => func (z: F32) =>
  let priority = hash seed x z
  let a = random.next priority
  let b = random.next a
  return $Candidate { position: math.vec3 ((x + random.unit a) * cell) 0.0 ((z + random.unit b) * cell), priority, x, z }
// Matérn type-II thinning: a candidate survives if no closer candidate has
// lower priority. Lexicographic cell ties retain exact determinism. Neighbor
// checks use global cells even outside the requested chunk; no seam artifacts.
func accepted (seed: U32) => func (cell: F32) => func (spacing: F32) => func (c: Candidate) =>
  if cell <= 0.0 or not (is_finite cell) or not (is_finite spacing):
    return false
  if spacing <= 0.0:
    return true
  let reach = ceil (spacing / cell) + 1.0
  if not (is_finite reach) or reach > 4096.0:
    return false
  let width = F32.to_u32 (reach * 2.0 + 1.0)
  for zi in 0..width:
    for xi in 0..width:
      let x = c.x + U32.to_f32 xi - reach
      let z = c.z + U32.to_f32 zi - reach
      if x != c.x or z != c.z:
        let other = candidate seed cell x z
        let earlier = other.priority < c.priority
        if other.priority == c.priority:
          earlier := z < c.z or (z == c.z and x < c.x)
        if earlier and (other.position - c.position).length_squared < spacing * spacing:
          return false
  return true
// Whether the candidate at table slot (column, row) survives, reading the
// candidates around it from tables `columns` wide whose first slot is cell
// (x0, z0). Matches `accepted`, which computes each neighbour afresh.
func accepted_in (priorities: #[U32]) => func (xs: #[F32]) => func (zs: #[F32]) => func (columns: U32) => func (spacing: F32) => func (reach: F32) => func (column: U32) => func (row: U32) => func (cx: F32) => func (cz: F32) =>
  if not (is_finite reach and is_finite spacing) or reach < 0.0 or reach > 4096.0 or columns == 0:
    return false
  let r = F32.to_u32 reach
  if column < r or row < r or row > 4294967295 - r or column > 4294967295 - r or row + r > 4294967295 / columns:
    return false
  let max_row = (row + r) * columns
  if column + r > 4294967295 - max_row:
    return false
  let width = r * 2 + 1
  let spot = row * columns + column
  let max_slot = max_row + column + r
  if max_slot >= priorities.length or max_slot >= xs.length or max_slot >= zs.length:
    return false
  let priority = priorities[spot]
  let px = xs[spot]
  let pz = zs[spot]
  let limit = spacing * spacing
  for zi in 0..width:
    for xi in 0..width:
      let x = cx + U32.to_f32 xi - reach
      let z = cz + U32.to_f32 zi - reach
      if x != cx or z != cz:
        let other = (row - r + zi) * columns + (column - r + xi)
        let earlier = priorities[other] < priority
        if priorities[other] == priority:
          earlier := z < cz or (z == cz and x < cx)
        if earlier:
          let dx = xs[other] - px
          let dy = 0.0 - 0.0
          let dz = zs[other] - pz
          if dx * dx + dy * dy + dz * dz < limit:
            return false
  return true

// Half-open global cell rectangle. Joining adjacent chunks matches one query.
// Integer cells within F32's exact range compute each candidate once into a
// table covering the chunk and its neighbourhood; other inputs evaluate every
// neighbour directly.
func chunk (seed: U32) => func (cell: F32) => func (spacing: F32) => func (x: F32) => func (z: F32) => func (width: U32) => func (depth: U32) =>
  if cell <= 0.0 or not (is_finite cell and is_finite spacing and is_finite x and is_finite z):
    return #[]
  let reach = if spacing > 0.0 then ceil (spacing / cell) + 1.0 else 0.0
  if spacing > 0.0 and (not (is_finite reach) or reach > 4096.0):
    return #[]
  let exact = is_finite spacing and spacing > 0.0 and reach <= 4096.0 and floor x == x and floor z == z and abs x + U32.to_f32 width + reach < 16000000.0 and abs z + U32.to_f32 depth + reach < 16000000.0
  let r = if exact then F32.to_u32 reach else 0
  let columns = width + r * 2
  let rows = depth + r * 2
  if exact and U32.to_f32 columns * U32.to_f32 rows <= 1048576.0:
    let x0 = x - reach
    let z0 = z - reach
    let count = columns * rows
    let priorities = @array.fill count 0
    let xs = @array.fill count 0.0
    let zs = @array.fill count 0.0
    for row in 0..rows:
      let gz = z0 + U32.to_f32 row
      for column in 0..columns:
        let gx = x0 + U32.to_f32 column
        let k = row * columns + column
        let priority = hash seed gx gz
        let a = random.next priority
        let b = random.next a
        priorities[k] := priority
        xs[k] := (gx + random.unit a) * cell
        zs[k] := (gz + random.unit b) * cell
    let kept = @array.fill (width * depth) 0
    let total = 0
    for zi in 0..depth:
      for xi in 0..width:
        if accepted_in priorities xs zs columns spacing reach (xi + r) (zi + r) (x + U32.to_f32 xi) (z + U32.to_f32 zi):
          kept[total] := (zi + r) * columns + xi + r
          total := self + 1
    return @array.generate total (func (i: U32) =>
      let k = kept[i]
      let cx = x0 + U32.to_f32 (k % columns)
      let cz = z0 + U32.to_f32 (k / columns)
      return $Candidate { position: math.vec3 xs[k] 0.0 zs[k], priority: priorities[k], x: cx, z: cz })
  let found: #[Candidate] = #[]
  for zi in 0..depth:
    for xi in 0..width:
      let c = candidate seed cell (x + U32.to_f32 xi) (z + U32.to_f32 zi)
      if accepted seed cell spacing c:
        @storage.push found c
  return found

type Choice is data = $Choice { index: U32, seed: U32 }
// One explicit random-state advance. Zero weights are ignored; negative,
// non-finite, empty or all-zero weights return Nothing. Normalize before
// summing so large finite weights cannot overflow the probability interval.
func choose (weights: #[F32]) => func (seed: U32) : Maybe Choice =>
  let largest = 0.0
  for weight in weights:
    if weight < 0.0 or not (is_finite weight):
      return $Nothing
    largest := max self weight
  if largest == 0.0:
    return $Nothing
  let total = 0.0
  for weight in weights:
    total := self + weight / largest
  let state = random.next seed
  let target = random.unit state * total
  let cumulative = 0.0
  let last = 0
  for i in 0..weights.length:
    let weight = weights[i]
    if weight > 0.0:
      last := i
      cumulative := self + weight / largest
      if target < cumulative:
        return $Some ($Choice { index: i,seed: state })
  // F32 rounding can land on the upper endpoint; retain the last positive bin.
  return $Some ($Choice { index: last,seed: state })
