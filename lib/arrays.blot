// Copies are independent owners. Ordinary descriptors and borrowed views alias.
func copy (values: #[a]) : #[a] => @storage.copy values
func copy_u32 (values: #[U32]) : #[U32] => @storage.copy values
// The known callback owns the policy for any nested payloads.
func copy_using copy_value -> (values: #[a]) => return
  @array.generate values.length (func i => copy_value values[i])
