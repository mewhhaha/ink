// Copies are independent owners. Ordinary descriptors and borrowed views alias.
const copy = func (values: Array a) : Array a => return @storage.copy values
const copy_u32 = func (values: Array U32) : Array U32 => return @storage.copy values
// The known callback owns the policy for any nested payloads.
const copy_using = func copy_value -> (values: Array a) => return
  @array.generate values.length (func i => return copy_value values[i])
