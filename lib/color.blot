import * as math from "./math"

// Positive real powers without hidden platform intrinsics. Range reduction
// keeps the polynomial error bounded; unchecked helpers require finite values.
// logarithm is the checked positive-input boundary.
// Scaling by powers of two is exact for these normal values, so halving or
// doubling by 64, 32, ..., 1 binary orders reaches the same mantissa in
// [1, 2) and integer exponent as single steps would, in seven tests.
const log2 = fn (value: F32) => do:
  if Bool.not (is_finite value):
    return 0.0
  let x = max 1.17549435e-38 value
  let exponent = 0.0
  if x >= 2.0:
    if x >= 18446744073709551616.0:
      x := self * 5.421010862427522e-20
      exponent := self + 64.0
    if x >= 4294967296.0:
      x := self * 2.3283064365386963e-10
      exponent := self + 32.0
    if x >= 65536.0:
      x := self * 1.52587890625e-05
      exponent := self + 16.0
    if x >= 256.0:
      x := self * 0.00390625
      exponent := self + 8.0
    if x >= 16.0:
      x := self * 0.0625
      exponent := self + 4.0
    if x >= 4.0:
      x := self * 0.25
      exponent := self + 2.0
    if x >= 2.0:
      x := self * 0.5
      exponent := self + 1.0
  if x < 1.0:
    if x < 1.0842021724855044e-19:
      x := self * 18446744073709551616.0
      exponent := self - 64.0
    if x < 4.656612873077393e-10:
      x := self * 4294967296.0
      exponent := self - 32.0
    if x < 3.0517578125e-05:
      x := self * 65536.0
      exponent := self - 16.0
    if x < 0.0078125:
      x := self * 256.0
      exponent := self - 8.0
    if x < 0.125:
      x := self * 16.0
      exponent := self - 4.0
    if x < 0.5:
      x := self * 4.0
      exponent := self - 2.0
    if x < 1.0:
      x := self * 2.0
      exponent := self - 1.0
  let y = (x - 1.0) / (x + 1.0)
  let y2 = y * y
  let series = 1.0 + y2 * (0.3333333333 + y2 * (0.2 + y2 * (0.1428571429 + y2 * (0.1111111111 + y2 * 0.0909090909))))
  return exponent + 2.8853900818 * y * series

const logarithm = fn (value: F32) -> Maybe F32 => do:
  if Bool.not (is_finite value) || value <= 0.0:
    return #Nothing
  return #Some (log2 value)

const exp2 = fn (value: F32) => do:
  let x = clamp (-126.0) 126.0 value
  let exponent = floor x
  let y = (x - exponent) * 0.69314718056
  let result = 1.0 + y * (1.0 + y * (0.5 + y * (0.1666666667 + y * (0.0416666667 + y * (0.0083333333 + y * (0.0013888889 + y * 0.0001984127))))))
  // Multiply by 2^exponent through its binary digits; every product stays a
  // normal F32, so each is exact, as repeated doubling or halving would be.
  let count = F32.to_u32 (abs exponent)
  if exponent < 0.0:
    if count >= 64:
      result := self * 5.421010862427522e-20
      count := self - 64
    if count >= 32:
      result := self * 2.3283064365386963e-10
      count := self - 32
    if count >= 16:
      result := self * 1.52587890625e-05
      count := self - 16
    if count >= 8:
      result := self * 0.00390625
      count := self - 8
    if count >= 4:
      result := self * 0.0625
      count := self - 4
    if count >= 2:
      result := self * 0.25
      count := self - 2
    if count >= 1:
      result := self * 0.5
    return result
  if count >= 64:
    result := self * 18446744073709551616.0
    count := self - 64
  if count >= 32:
    result := self * 4294967296.0
    count := self - 32
  if count >= 16:
    result := self * 65536.0
    count := self - 16
  if count >= 8:
    result := self * 256.0
    count := self - 8
  if count >= 4:
    result := self * 16.0
    count := self - 4
  if count >= 2:
    result := self * 4.0
    count := self - 2
  if count >= 1:
    result := self * 2.0
  return result

const power = fn (value: F32) => fn (exponent: F32) => do:
  if value <= 0.0:
    return 0.0
  return exp2 (log2 value * exponent)

// Transfer functions preserve alpha, and do not clamp HDR values to one.
const linear_channel = fn (value: F32) => do:
  if value <= 0.04045:
    return value / 12.92
  return power ((value + 0.055) / 1.055) 2.4
const srgb_channel = fn (value: F32) => do:
  if value <= 0.0031308:
    return value * 12.92
  return 1.055 * power value (1.0 / 2.4) - 0.055
const linear = fn (c: math.Color) => math.rgba (linear_channel c.r) (linear_channel c.g) (linear_channel c.b) c.a
const srgb = fn (c: math.Color) => math.rgba (srgb_channel c.r) (srgb_channel c.g) (srgb_channel c.b) c.a
const expose = fn (stops: F32) => fn (c: math.Color) => math.Color.mul c (exp2 stops)
const luminance = fn (c: math.Color) => c.r * 0.2126 + c.g * 0.7152 + c.b * 0.0722

// ACES-inspired fitted display curve, not the full ACES colour pipeline.
const tone_channel = fn (value: F32) => do:
  let x = max 0.0 value
  if x > 1.0:
    return saturate ((2.51 + 0.03 / x) / (2.43 + 0.59 / x + 0.14 / x / x))
  return saturate ((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14))
const tone = fn (c: math.Color) => math.rgba (tone_channel c.r) (tone_channel c.g) (tone_channel c.b) c.a
const display = fn (stops: F32) => fn (c: math.Color) => srgb (tone (expose stops c))
