import * as array from "std/array"

// Bounded local encoded-scene history. Each frame owns no immutable world
// branch: completed edits explicitly copy scene lanes into these named owners.
type Entry is data = $Entry {start: U32, count: U32}
const no_step: U32 = 0xFFFFFFFF
// metadata: current entry or no_step, maximum entries, maximum numeric lanes.
func metadata entries -> lanes : #[U32] => #[no_step, entries, lanes]
func clear (entries: #[~Entry]) -> (payload: #[~F32]) -> metadata =>
  @storage.truncate entries 0
  @storage.truncate payload 0
  metadata[0] = no_step
  return ()
func discard_first (entries: #[~Entry]) -> (payload: #[~F32]) =>
  let count = entries[0].count
  for i in count .. payload.length:
    payload[i - count] = payload[i]
  @storage.truncate payload (payload.length - count)
  for i in 1 .. entries.length:
    let entry = entries[i]
    entry.start := entry.start - count
    entries[i - 1] = entry
  @storage.truncate entries (entries.length - 1)
  return ()
// End any existing history views before capturing another edit. Scratch must
// be distinct from history payload; encode_scene access scratch writes a scene.
func checkpoint encode_scene -> access -> (entries: #[~Entry]) -> (payload: #[~F32]) -> metadata -> (scratch: #[~F32]) =>
  encode_scene access scratch
  if metadata[1] == 0 or scratch.length > metadata[2]:
    return false
  if metadata[0] != no_step:
    let kept = metadata[0] + 1
    if kept < entries.length:
      @storage.truncate entries kept
      let last = entries[kept - 1]
      @storage.truncate payload (last.start + last.count)
  for 0 .. entries.length:
    if entries.length < metadata[1] and scratch.length <= metadata[2] - payload.length:
      break
    discard_first entries payload
  let start = payload.length
  for value in scratch:
    @storage.push payload value
  @storage.push entries ($Entry {start, count: scratch.length})
  metadata[0] = entries.length - 1
  return true
// The entry `forward` or back of the current one, as its index and the lanes
// to decode (copied out of the history, which may be part of the world the
// decoder takes over), or nothing at either end. `moved` makes it current.
func step_to (entries: #[~Entry]) -> (payload: #[~F32]) -> (metadata: #[U32]) -> (forward: Bool) : Maybe (U32, #[F32]) =>
  if metadata[0] == no_step:
    return $Nothing
  let to = metadata[0]
  if forward:
    if to + 1 >= entries.length:
      return $Nothing
    to := to + 1
  else:
    if to == 0:
      return $Nothing
    to := to - 1
  let entry = entries[to]
  return $Some (to, array.slice entry.start entry.count (seal (copy payload)))
func moved (metadata: own #[U32]) -> (to: U32) : #[U32] =>
  metadata[0] := to
  return metadata
// The stashed scene's lanes to decode, copied out of the stash, or nothing
// when none is stashed.
func stashed (stash: #[~F32]) : Maybe (#[F32]) => return
  if stash.length == 0 then $Nothing else $Some (seal (copy stash))
