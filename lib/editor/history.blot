//! Bounded local encoded-scene history. Each frame owns no immutable world
//! branch: completed edits explicitly copy scene lanes into these named owners.
//!
//! Key items: [`Entry`], [`metadata`], [`clear`], [`discard_first`], [`checkpoint_lanes`].

import * as array from "std/array"

type Entry is data = $Entry {start: U32, count: U32}
const no_step: U32 = 0xFFFFFFFF
// metadata: current entry or no_step, maximum entries, maximum numeric lanes.
func metadata entries -> lanes : #[U32] => #[no_step, entries, lanes]
func clear (entries: own #[Entry]) -> (payload: own #[F32]) -> (metadata: own #[U32]) =>
  @storage.truncate entries 0
  @storage.truncate payload 0
  metadata[0] := no_step
  return (entries, payload, metadata)
func discard_first (entries: own #[Entry]) -> (payload: own #[F32]) =>
  if entries.length == 0:
    return (entries, payload)
  let payload_len = payload.length
  let count = min entries[0].count payload_len
  for i in count .. payload_len:
    payload[i - count] := payload[i]
  @storage.truncate payload (payload_len - count)
  let entry_len = entries.length
  for i in 1 .. entry_len:
    let entry = entries[i]
    entry.start := if entry.start >= count then entry.start - count else 0
    entries[i - 1] := entry
  @storage.truncate entries (entry_len - 1)
  return (entries, payload)
// End any existing history views before capturing another edit. Scratch must
// be distinct from history payload.
func checkpoint_lanes (scratch: &[F32]) -> (entries: own #[Entry]) -> (payload: own #[F32]) -> (metadata: own #[U32]) =>
  if metadata.length < 3 or metadata[1] == 0 or scratch.length > metadata[2]:
    return (false, entries, payload, metadata)
  if metadata[0] != no_step and metadata[0] < entries.length:
    let kept = metadata[0] + 1
    if kept < entries.length:
      @storage.truncate entries kept
      let last = entries[kept - 1]
      if last.start <= payload.length and last.count <= payload.length - last.start:
        @storage.truncate payload (last.start + last.count)
  let limit = entries.length
  for 0 .. limit:
    if entries.length < metadata[1] and payload.length <= metadata[2] and scratch.length <= metadata[2] - payload.length:
      break
    let (next_entries, next_payload) = discard_first entries payload
    entries := next_entries
    payload := next_payload
  let start = payload.length
  for value in scratch:
    @storage.push payload value
  @storage.push entries ($Entry {start, count: scratch.length})
  metadata[0] := entries.length - 1
  return (true, entries, payload, metadata)
// Scratch must be distinct from history payload; encode_scene access (own scratch) writes a scene.
func checkpoint (encode_scene: a -> own #[F32] -> #[F32]) -> (access: a) -> (entries: own #[Entry]) -> (payload: own #[F32]) -> (metadata: own #[U32]) -> (scratch: own #[F32]) =>
  scratch := encode_scene access self
  let (saved, entries, payload, metadata) = checkpoint_lanes (&scratch[0..scratch.length]) entries payload metadata
  return (saved, entries, payload, metadata, scratch)
// The entry `forward` or back of the current one, as its index and the lanes
// to decode (copied out of the history, which may be part of the world the
// decoder takes over), or nothing at either end. `moved` makes it current.
func step_to (entries: #[Entry]) -> (payload: #[F32]) -> (metadata: #[U32]) -> (forward: Bool) : Maybe (U32, #[F32]) =>
  if metadata.length == 0 or entries.length == 0 or metadata[0] == no_step or metadata[0] >= entries.length:
    return $Nothing
  let to = metadata[0]
  if forward:
    if to + 1 >= entries.length:
      return $Nothing
    to := to + 1
  else:
    if to == 0:
      return $Nothing
    to := to - 1
  let entry = entries[to]
  if entry.start > payload.length or entry.count > payload.length - entry.start:
    return $Nothing
  return $Some (to, array.slice entry.start entry.count (copy payload))
func moved (metadata: own #[U32]) -> (to: U32) : #[U32] =>
  metadata[0] := to
  return metadata
// The stashed scene's lanes to decode, copied out of the stash, or nothing
// when none is stashed.
func stashed (stash: #[F32]) : Maybe (#[F32]) => return
  if stash.length == 0 then $Nothing else $Some (copy stash)
