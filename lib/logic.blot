// Eager Bool combinators for cheap arithmetic predicates. Both arguments are
// evaluated. Use `and` and `or` for short-circuiting guarded indexing, scans
// or expensive work.
const both = func (left: Bool) => return func (right: Bool) => return case left, right of
  true, true => true
  _, _ => false

const either = func (left: Bool) => return func (right: Bool) => return case left, right of
  false, false => false
  _, _ => true
