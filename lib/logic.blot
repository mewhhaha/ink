// Eager Bool combinators for per-entity and per-plane loops. The prelude's `&&`
// and `||` defer their right operand through a demand parameter, which costs a
// closure and an indirect call each time; these take both operands evaluated.
// Use `&&` and `||` elsewhere, and when the right operand is expensive.
const both = fn (left: Bool) => fn (right: Bool) => case left, right of
  #True, #True => #True
  _, _ => #False

const either = fn (left: Bool) => fn (right: Bool) => case left, right of
  #False, #False => #False
  _, _ => #True
