// Eager Bool combinators for cheap arithmetic predicates. Both arguments are
// evaluated. Use && and || for guarded indexing, scans or expensive work;
// their demand parameters skip the right side when it cannot affect the result.
// Whether a demand allocates depends on the compiler's specialization proof.
const both = fn (left: Bool) => fn (right: Bool) => case left, right of
  #True, #True => #True
  _, _ => #False

const either = fn (left: Bool) => fn (right: Bool) => case left, right of
  #False, #False => #False
  _, _ => #True
