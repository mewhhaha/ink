// Eager Bool combinators for cheap arithmetic predicates. Both arguments are
// evaluated. Use `and` and `or` for short-circuiting guarded indexing, scans
// or expensive work.
func both (left: Bool) => func (right: Bool) => case left, right of
  true, true => true
  _, _ => false

func either (left: Bool) => func (right: Bool) => case left, right of
  false, false => false
  _, _ => true
