import { Vec3 } from "std/vector"
import * as vector from "std/vector"
import * as math from "../math"

// Server-side Area-Of-Interest (AOI) relevance filtering for bandwidth budgets
// and ring-buffered hitbox history rewind for lag-compensated hit detection.

type Entity is data = $Entity {
  id: U32,
  position: Vec3,
  priority: F32,
  mask: U32,
}

type Observer is data = $Observer {
  position: Vec3,
  radius: F32,
  mask: U32,
}

private func scaled_dist3 (a: Vec3) -> (b: Vec3) : F32 =>
  let hx = abs (a.x * 0.5 - b.x * 0.5)
  let hy = abs (a.y * 0.5 - b.y * 0.5)
  let hz = abs (a.z * 0.5 - b.z * 0.5)
  let m = max hx (max hy hz)
  if not (is_finite m):
    return 1.0 / 0.0
  if m == 0.0:
    return 0.0
  let sx = hx / m
  let sy = hy / m
  let sz = hz / m
  return 2.0 * m * sqrt (sx * sx + sy * sy + sz * sz)

// Select up to `budget` entities relevant to `observer` (matching `mask` bits
// and within `radius`), ordered by descending `priority / (1 + dist * 0.1)`.
func select_relevant (observer: Observer) -> (entities: #[Entity]) -> (budget: U32) : #[U32] =>
  let n = entities.length
  if n == 0 or budget == 0 or not (math.finite3 observer.position and is_finite observer.radius) or observer.radius <= 0.0:
    return #[]
  let r2 = observer.radius * observer.radius
  let r2_ok = is_finite r2
  let ox = observer.position.x
  let oy = observer.position.y
  let oz = observer.position.z
  let cand_scores: #[F32] = #[]
  let cand_ids: #[U32] = #[]
  for i in 0 .. n:
    let e = entities[i]
    if (e.mask & observer.mask) != 0 and is_finite e.priority and e.priority > 0.0 and math.finite3 e.position:
      let dx = e.position.x - ox
      let dy = e.position.y - oy
      let dz = e.position.z - oz
      let d2 = dx * dx + dy * dy + dz * dz
      let dist = if r2_ok and is_finite d2 then (if d2 <= r2 then sqrt d2 else (-1.0)) else (do:
        let sd = scaled_dist3 e.position observer.position
        break if is_finite sd and sd <= observer.radius then sd else (-1.0))
      if dist >= 0.0:
        let score = e.priority / (1.0 + dist * 0.1)
        if is_finite score and score > 0.0:
          @storage.push cand_scores score
          @storage.push cand_ids e.id
  let m = cand_scores.length
  let cap = min m budget
  if cap == 0:
    return #[]
  let picked = @array.fill m false
  let out = @array.fill cap 0
  for k in 0 .. cap:
    let best = 4294967295
    let best_s: F32 = -1.0
    let best_id: U32 = 4294967295
    for i in 0 .. m:
      if not picked[i]:
        let sc = cand_scores[i]
        let id = cand_ids[i]
        if best == 4294967295 or sc > best_s or (sc == best_s and id < best_id):
          best := i
          best_s := sc
          best_id := id
    picked[best] := true
    out[k] := best_id
  return out

// One timestamped spherical hitbox sample for lag-compensation rewind.
type HitboxSample is data = $HitboxSample {
  time: F32,
  center: Vec3,
  radius: F32,
}

private func safe_lerp (a: F32) -> (b: F32) -> (t: F32) : F32 =>
  let d = b - a
  if is_finite d:
    let v = a + d * t
    if is_finite v:
      return v
  return a * (1.0 - t) + b * t

// Interpolate a sorted history of hitbox samples at `target_time` (clamped to
// `[oldest, newest]` when `target_time` lies within the retained window, or
// Nothing if history is empty / nonfinite).
func rewind_sphere (history: #[HitboxSample]) -> (target_time: F32) : Maybe (Vec3, F32) =>
  let n = history.length
  if n == 0 or not (is_finite target_time):
    return $Nothing
  for s in history:
    if not (is_finite s.time and math.finite3 s.center and is_finite s.radius) or s.radius < 0.0:
      return $Nothing
  if n == 1 or target_time <= history[0].time:
    return $Some (history[0].center, history[0].radius)
  if target_time >= history[n - 1].time:
    return $Some (history[n - 1].center, history[n - 1].radius)
  let lo: U32 = 0
  let hi: U32 = n - 1
  for 0 .. 32:
    if lo + 1 >= hi:
      break
    let mid = lo + (hi - lo) / 2
    if history[mid].time <= target_time:
      lo := mid
    else:
      hi := mid
  let idx = lo
  let a = history[idx]
  let b = history[idx + 1]
  let span = b.time - a.time
  let t = 0.0
  if is_finite span:
    if span > 0.000001:
      let raw_t = (target_time - a.time) / span
      if is_finite raw_t:
        t := clamp 0.0 1.0 raw_t
  else:
    let hspan = b.time * 0.5 - a.time * 0.5
    if is_finite hspan and hspan > 0.0:
      let raw_t = (target_time * 0.5 - a.time * 0.5) / hspan
      if is_finite raw_t:
        t := clamp 0.0 1.0 raw_t
  let center = $Vec3 {
    x: safe_lerp a.center.x b.center.x t,
    y: safe_lerp a.center.y b.center.y t,
    z: safe_lerp a.center.z b.center.z t,
  }
  let radius = safe_lerp a.radius b.radius t
  if not (math.finite3 center and is_finite radius) or radius < 0.0:
    return $Nothing
  return $Some (center, radius)

// Ray-sphere intersection test against a rewound hitbox `(center, radius)`.
// Returns hit distance `t >= 0` along unit/non-zero ray `dir` if hit.
func ray_hit_sphere (origin: Vec3) -> (dir: Vec3) -> (max_dist: F32) -> (center: Vec3) -> (radius: F32) : Maybe F32 =>
  if not (math.finite3 origin and math.finite3 dir and math.finite3 center and is_finite max_dist and is_finite radius) or radius < 0.0 or max_dist < 0.0:
    return $Nothing
  let $Some u = math.normalize3 dir else:
    return $Nothing
  let oc = origin - center
  let b = vector.Vec3.dot oc u
  let c = vector.Vec3.length_squared oc - radius * radius
  let disc = b * b - c
  if is_finite b and is_finite disc:
    if disc < 0.0:
      return $Nothing
    let root = sqrt disc
    let t0 = F32.neg b - root
    let t1 = F32.neg b + root
    let hit_t = if t0 >= 0.0 then t0 else t1
    if not (is_finite hit_t) or hit_t < 0.0 or hit_t > max_dist:
      return $Nothing
    return $Some hit_t
  // Scaled fallback when squared distances or dot products overflow F32.
  let hoc = $Vec3 {
    x: origin.x * 0.5 - center.x * 0.5,
    y: origin.y * 0.5 - center.y * 0.5,
    z: origin.z * 0.5 - center.z * 0.5,
  }
  let hr = radius * 0.5
  let m = max hr (max (abs hoc.x) (max (abs hoc.y) (abs hoc.z)))
  if not (is_finite m):
    return $Nothing
  if m == 0.0:
    return $Some 0.0
  let soc = $Vec3 { x: hoc.x / m, y: hoc.y / m, z: hoc.z / m }
  let sr = hr / m
  let sb = vector.Vec3.dot soc u
  let sc = vector.Vec3.length_squared soc - sr * sr
  let sdisc = sb * sb - sc
  if not (is_finite sb and is_finite sdisc) or sdisc < 0.0:
    return $Nothing
  let sroot = sqrt sdisc
  let st0 = F32.neg sb - sroot
  let st1 = F32.neg sb + sroot
  let st = if st0 >= 0.0 then st0 else st1
  if not (is_finite st) or st < 0.0:
    return $Nothing
  let prod = m * st
  let hit_t = if is_finite prod then prod * 2.0 else (2.0 * m) * st
  if not (is_finite hit_t) or hit_t < 0.0 or hit_t > max_dist:
    return $Nothing
  return $Some hit_t
