import * as array from "std/array"
import * as map from "./map"

// Forward lookup uses separate owned rows+buckets, expected O(1). Incoming
// enumeration is currently O(rows ever inserted): explicit and deterministic,
// not an implicit persistent inverse trie. Add a separately named inverse index
// for high-volume callers rather than hiding independently growing owners here.
type Relations [source, target] = map.Map [source, target]
type Buckets = map.Buckets
const empty = func () : Relations [s, t] => return map.empty ()
const buckets = map.buckets
const target = func policy -> source -> edges -> slots => return map.get policy source edges slots
const link = func policy -> source -> target -> edges -> slots => return map.set policy source target edges slots
const unlink = func policy -> source -> edges -> slots => return map.remove policy source edges slots
const sources = func equal_target -> target -> (edges: Relations [s, t]) => return do:
  let found: ResizeArray s = #[]
  for edge in edges:
    if let $Some (source, selected) = edge.item:
      if equal_target target selected:
        @storage.push found source
  return @storage.freeze (@storage.copy found)
const fold_sources = func equal_target -> reduce -> initial -> target -> (edges: Relations [s, t]) => return do:
  let result = initial
  for edge in edges:
    if let $Some (source, selected) = edge.item:
      if equal_target target selected:
        result := reduce self source
  return result
const remove_target = func source_policy -> equal_target -> target -> edges -> slots => return do:
  let removed = sources equal_target target edges
  map.remove_many source_policy removed edges slots
const link_acyclic = func policy -> source -> target -> (edges: Relations [k, k]) -> slots => return do:
  let at = target
  for 0 .. edges.length + 1:
    if policy.equal source at:
      return false
    let $Some next = map.get policy at edges slots else:
      map.set policy source target edges slots
      return true
    at := next
  return false
const copy_into = map.copy_into
