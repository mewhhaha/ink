import * as array from "std/array"
import * as map from "./map"

// Forward lookup uses one caller-owned map, expected O(1). Incoming
// enumeration is currently O(rows ever inserted): explicit and deterministic,
// not an implicit persistent inverse trie. Add a separately named inverse index
// for high-volume callers rather than hiding independently growing owners here.
type Relations [source, target] = map.Map [source, target]
func empty () : Relations [s, t] => map.empty ()
func target policy -> source -> (edges: Relations [s, t]) => map.get policy source edges
func link policy -> source -> target -> (edges: own Relations [s, t]) : Relations [s, t] => map.set policy source target edges
func unlink policy -> source -> (edges: own Relations [s, t]) : Relations [s, t] => map.remove policy source edges
func sources (equal_target: t -> t -> Bool) -> (target: t) -> (edges: Relations [s, t]) : #[s] =>
  let found: #[s] = #[]
  let eq = equal_target target
  let rows = edges.rows
  for edge in rows:
    if let $Some (source, selected) = edge.item:
      if eq selected:
        @storage.push found source
  return found
func fold_sources equal_target -> reduce -> initial -> target -> (edges: Relations [s, t]) =>
  let result = initial
  let eq = equal_target target
  let rows = edges.rows
  for edge in rows:
    if let $Some (source, selected) = edge.item:
      if eq selected:
        result := reduce self source
  return result
func remove_target source_policy -> equal_target -> target -> (edges: own Relations [s, t]) : Relations [s, t] =>
  let eq = equal_target target
  let removed = false
  for i in 0 .. edges.rows.length:
    if let $Some (_, selected) = edges.rows[i].item:
      if eq selected:
        edges.rows[i].item := $Nothing
        removed := true
  if removed:
    return map.rehash (edges.buckets.length - 2) edges
  return edges
func is_acyclic policy -> source -> target -> (edges: Relations [k, k]) : Bool =>
  let at = target
  for 0 .. edges.rows.length + 1:
    if policy.equal source at:
      return false
    let $Some next = map.get policy at edges else:
      return true
    at := next
  return false
func link_acyclic policy -> source -> target -> (edges: own Relations [k, k]) : (Bool, Relations [k, k]) =>
  if not (is_acyclic policy source target edges):
    return (false, edges)
  return (true, map.set policy source target edges)
const copy_into = map.copy_into
