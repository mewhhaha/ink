//! Forward lookup uses one caller-owned map, expected O(1). Incoming scans
//! visit forward rows in insertion order. For repeated folds over bounded U32
//! targets, prepare separate offset and source owners once per relation snapshot.
//!
//! Key items: [`Relations`], [`empty`], [`target`], [`link`], [`unlink`].
//!
//! ```blot
//! import * as map from "ink/map"
//! let rels: Relations [U32, U32] = empty ()
//! rels := link map.u32 2 1 self
//! rels := link map.u32 3 1 self
//! (sources map.u32.equal 1 rels).length // => 2
//! ```

import * as array from "std/array"
import * as map from "./map"

// The forward rows and buckets remain readable by map.count/entries/values.
// While all rows are live, targets is a compact parallel column. An unlink
// drops that column until row compaction makes the forward rows dense again.
type Relations [s, t] is data = $Relations {rows: #[map.Entry [s, t]], buckets: #[U32], targets: #[t]}
func empty () : Relations [s, t] =>
  let forward: map.Map [s, t] = map.empty ()
  let targets: #[t] = #[]
  return $Relations {rows: forward.rows, buckets: forward.buckets, targets}
func target policy -> source -> (edges: Relations [s, t]) =>
  return map.get policy source ($map.Map {rows: edges.rows, buckets: edges.buckets})

func link policy -> source -> target -> (edges: own Relations [s, t]) : Relations [s, t] =>
  let $Relations {rows, buckets, targets} = edges
  let before = rows.length
  let forward = $map.Map {rows, buckets}
  let hashed = policy.hash source
  let (existing, tomb, slot) = map.probe_set_raw policy source hashed forward
  if existing != map.tombstone:
    forward.rows[existing].item := map.replace_value target self
    if targets.length == before:
      targets[existing] := target
  else:
    forward := map.insert_absent source target hashed tomb slot forward
    if targets.length == before:
      @storage.push targets target
    else:
      if forward.rows.length == forward.buckets[0]:
        for row in forward.rows:
          if let $Some (_, value) = row.item:
            @storage.push targets value
  return $Relations {rows: forward.rows, buckets: forward.buckets, targets}

func unlink policy -> source -> (edges: own Relations [s, t]) : Relations [s, t] =>
  let $Relations {rows, buckets, targets} = edges
  let before = buckets[0]
  let forward = map.remove policy source ($map.Map {rows, buckets})
  if forward.buckets[0] != before:
    @storage.truncate targets 0
  return $Relations {rows: forward.rows, buckets: forward.buckets, targets}

func sources (equal_target: t -> t -> Bool) -> (target: t) -> (edges: Relations [s, t]) : #[s] =>
  let found: #[s] = #[]
  let equal = equal_target target
  let rows = edges.rows
  let targets = edges.targets
  if targets.length == rows.length:
    let i: U32 = 0
    for selected in targets:
      if equal selected:
        if let $Some (source, _) = rows[i].item:
          @storage.push found source
      i := self + 1
  else:
    for row in rows:
      if let $Some (source, selected) = row.item:
        if equal selected:
          @storage.push found source
  return found

// Group dense rows to amortize Wasm loop bookkeeping. Each match is reduced
// before the next predicate runs, including when callbacks have effects.
private func fold_at equal -> reduce -> state -> (at: U32) -> (targets: #[t]) -> (rows: #[map.Entry [s, t]]) =>
  if equal targets[at]:
    if let $Some (source, _) = rows[at].item:
      return reduce state source
  return state

func fold_sources equal_target -> reduce -> initial -> target -> (edges: Relations [s, t]) =>
  let result = initial
  let equal = equal_target target
  let rows = edges.rows
  let targets = edges.targets
  if targets.length == rows.length:
    let n = targets.length
    let limit = n - n % 8
    let i: U32 = 0
    for 0 .. n / 8:
      result := fold_at equal reduce self i targets rows
      result := fold_at equal reduce self (i + 1) targets rows
      result := fold_at equal reduce self (i + 2) targets rows
      result := fold_at equal reduce self (i + 3) targets rows
      result := fold_at equal reduce self (i + 4) targets rows
      result := fold_at equal reduce self (i + 5) targets rows
      result := fold_at equal reduce self (i + 6) targets rows
      result := fold_at equal reduce self (i + 7) targets rows
      i := self + 8
    for at in limit .. n:
      result := fold_at equal reduce self at targets rows
  else:
    for row in rows:
      if let $Some (source, selected) = row.item:
        if equal selected:
          result := reduce self source
  return result

// Snapshot incoming source IDs in forward insertion order. Prepare again after edits.
func prepare_incoming (count: U32) -> (edges: Relations [s, U32]) -> (starts: own #[U32]) -> (members: own #[s]) : (#[U32], #[s]) =>
  if count == 0xFFFFFFFF:
    return panic "incoming target count overflows"
  @storage.truncate members 0
  let cursor = @array.fill count 0
  let rows = edges.rows
  @storage.reserve members rows.length
  for row in rows:
    if let $Some (source, target) = row.item:
      if target >= count:
        return panic "incoming target outside domain"
      cursor[target] := self + 1
      @storage.push members source
  @storage.truncate starts 0
  @storage.reserve starts (count + 1)
  @storage.push starts 0
  let total: U32 = 0
  for i in 0 .. count:
    let size = cursor[i]
    cursor[i] := total
    total := self + size
    @storage.push starts total
  for row in rows:
    if let $Some (source, target) = row.item:
      members[cursor[target]] := source
      cursor[target] := self + 1
  return (starts, members)
func fold_incoming reduce -> initial -> (target: U32) -> starts -> members =>
  let result = initial
  if starts.length == 0 or target >= starts.length - 1:
    return result
  for i in starts.at target .. starts.at (target + 1):
    result := reduce self (members.at i)
  return result
func remove_target source_policy -> equal_target -> target -> (edges: own Relations [s, t]) : Relations [s, t] =>
  let $Relations {rows, buckets, targets} = edges
  let eq = equal_target target
  let removed: U32 = 0
  for i in 0 .. rows.length:
    if let $Some (_, selected) = rows[i].item:
      if eq selected:
        rows[i].item := $Nothing
        removed := self + 1
  if removed == 0:
    return $Relations {rows, buckets, targets}
  let kept = buckets[0] - removed
  let capacity: U32 = buckets.length - 2
  for 0 .. 28:
    if capacity <= 16 or kept > capacity / 4:
      break
    capacity := self >> 1
  let forward = map.rehash capacity ($map.Map {rows, buckets})
  @storage.truncate targets 0
  @storage.reserve targets forward.rows.length
  for row in forward.rows:
    if let $Some (_, value) = row.item:
      @storage.push targets value
  return $Relations {rows: forward.rows, buckets: forward.buckets, targets}
func is_acyclic policy -> source -> target -> (edges: Relations [k, k]) : Bool =>
  let at = target
  for 0 .. edges.rows.length + 1:
    if policy.equal source at:
      return false
    let $Some next = map.get policy at ($map.Map {rows: edges.rows, buckets: edges.buckets}) else:
      return true
    at := next
  return false
func link_acyclic policy -> source -> target -> (edges: own Relations [k, k]) : (Bool, Relations [k, k]) =>
  if not (is_acyclic policy source target edges):
    return (false, edges)
  return (true, link policy source target edges)
func copy_into policy -> copy_key -> copy_value -> (destination: own Relations [s, t]) -> (source: Relations [k, v]) : Relations [s, t] =>
  let $Relations {rows, buckets, targets} = destination
  let forward = map.copy_into policy copy_key copy_value ($map.Map {rows, buckets}) ($map.Map {rows: source.rows, buckets: source.buckets})
  @storage.truncate targets 0
  @storage.reserve targets forward.rows.length
  for row in forward.rows:
    if let $Some (_, value) = row.item:
      @storage.push targets value
  return $Relations {rows: forward.rows, buckets: forward.buckets, targets}
