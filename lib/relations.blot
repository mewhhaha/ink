import * as array from "std/array"
import * as map from "./map"

// Forward lookup uses separate owned rows+buckets, expected O(1). Incoming
// enumeration is currently O(rows ever inserted): explicit and deterministic,
// not an implicit persistent inverse trie. Add a separately named inverse index
// for high-volume callers rather than hiding independently growing owners here.
type Relations [source, target] = map.Map [source, target]
type Buckets = map.Buckets
func empty () : Relations [s, t] => map.empty ()
const buckets = map.buckets
func target policy -> source -> edges -> slots => map.get policy source edges slots
func link policy -> source -> target -> edges -> slots => map.set policy source target edges slots
func unlink policy -> source -> edges -> slots => map.remove policy source edges slots
func sources (equal_target: t -> t -> Bool) -> (target: t) -> (edges: Relations [s, t]) : #[s] =>
  let found: #[~s] = #[]
  for index in 0 .. edges.length:
    let edge: map.Entry [s, t] = edges[index]
    if let $Some (source, selected) = edge.item:
      if equal_target target selected:
        @storage.push found source
  return seal (copy found)
func fold_sources equal_target -> reduce -> initial -> target -> (edges: Relations [s, t]) =>
  let result = initial
  for edge in edges:
    if let $Some (source, selected) = edge.item:
      if equal_target target selected:
        result := reduce self source
  return result
func remove_target source_policy -> equal_target -> target -> edges -> slots =>
  let removed = sources equal_target target edges
  map.remove_many source_policy removed edges slots
  return ()
func link_acyclic policy -> source -> target -> (edges: Relations [k, k]) -> slots =>
  let at = target
  for 0 .. edges.length + 1:
    if policy.equal source at:
      return false
    let $Some next = map.get policy at edges slots else:
      map.set policy source target edges slots
      return true
    at := next
  return false
const copy_into = map.copy_into
