// Deterministic U32 hashes. These mix keys for collections, not cryptography.
func u32 (value: U32) =>
  let x = value
  x := (self ^ (self >> 16)) * 0x7FEB352D
  x := (self ^ (self >> 15)) * 0x846CA68B
  return x ^ (x >> 16)

// Ordered composition for caller-defined compound keys.
func combine (left: U32) -> (right: U32) => u32 (left ^ (u32 right + 0x9E3779B9))

// Text equality is exact Unicode scalar equality, without normalization.
func text (value: Text) =>
  let state: U32 = 2166136261
  for scalar in value:
    state := (self ^ scalar) * 16777619
  return u32 state
