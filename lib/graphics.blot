import { Vec3 } from "std/vector"
import * as environment from "./environment"
import * as math from "./math"
import * as render from "./render"
import * as shadows from "./render/shadow"

// What the host needs to draw a frame's sky and shadows, worked out from the
// frame and the player's shadow quality.

// The sky: overhead a little deeper than the clear color, a horizon paled
// toward grey by the ambient light and warmed by the sun, haze below it, the
// way toward the sun (or the moon), and how dark the night is, for stars.
type Sky is data = $Sky { zenith: Vec3, horizon: Vec3, ground: Vec3, sun: Vec3, night: F32 }

func sky (lighting: render.Lighting) =>
  let c = lighting.clear
  let a = lighting.ambient
  let l = lighting.color
  let lit = math.vec3 (c.x * 1.2 + a.x * 0.55 + l.x * 0.1) (c.y * 1.2 + a.y * 0.55 + l.y * 0.1) (c.z * 1.2 + a.z * 0.55 + l.z * 0.1)
  let grey = 0.299 * lit.x + 0.587 * lit.y + 0.114 * lit.z
  let pale = func (value: F32) => min 1.0 (value + (grey - value) * 0.4)
  let horizon = math.vec3 (pale lit.x) (pale lit.y) (pale lit.z)
  return $Sky {
    zenith: math.vec3 (c.x * 0.8) (c.y * 0.8) (c.z * 0.8),
    horizon,
    ground: horizon * 0.85,
    sun: (lighting.direction * -1.0).normalized,
    night: 1.0 - smoothstep 0.03 0.16 (0.299 * c.x + 0.587 * c.y + 0.114 * c.z),
  }

// The sky's diffuse light for the host to shade with: the nine SH terms of
// the sky above (no sun, which the directional light brings), scaled so its
// average over all directions is the lighting's flat `ambient`, and the tint
// that scaling is, which glossy reflections of the same sky reuse. White
// albedo facing a normal shows `environment.evaluate` of the coefficients.
func ambient_from_sky (heaven: Sky) -> (ambient_light: Vec3) =>
  let settings = $environment.Sky {
    zenith: math.rgb heaven.zenith.x heaven.zenith.y heaven.zenith.z,
    horizon: math.rgb heaven.horizon.x heaven.horizon.y heaven.horizon.z,
    ground: math.rgb heaven.ground.x heaven.ground.y heaven.ground.z,
    sun_direction: heaven.sun, sun: math.rgb 0.0 0.0 0.0, sun_cos_radius: 1.0,
  }
  return environment.diffuse (environment.project settings 16 32) (math.rgb ambient_light.x ambient_light.y ambient_light.z)

func ambient (lighting: render.Lighting) =>
  return ambient_from_sky (sky lighting) lighting.ambient

// What a shadow quality tier buys. `texels` is the size of each sun cascade's
// map (0 for no shadows at all) and `cascades` how many there are, nearest
// first. `filter` is how the host softens a shadow's edge (0 hard, 1 percentage
// closer, 2 percentage-closer soft shadows with a penumbra that widens with the
// distance to the caster), `contact` the steps of its fine march toward the
// sun for contact shadows (0 for none), and `local` how many point and spot
// lights may cast shadows, each into a map of `local_texels` by `local_texels`.
type Tier is data = $Tier { texels: U32, cascades: U32, filter: U32, contact: U32, local: U32, local_texels: U32 }

// The shadow policy for the player's `quality.shadows` choice, which is the
// size of the sun's maps: 0 off, 1024 low, 2048 medium, 4096 high; a size
// between falls into the tier above it.
//
//   texels  cascades  filter  contact  local casters (map size)
//   0       0         hard    0        0
//   1024    2         PCF     0        0
//   2048    3         PCSS    12       2 (512)
//   4096    4         PCSS    20       4 (1024)
func tier (texels: U32) : Tier =>
  if texels == 0:
    return $Tier { texels: 0, cascades: 0, filter: 0, contact: 0, local: 0, local_texels: 0 }
  if texels <= 1024:
    return $Tier { texels, cascades: 2, filter: 1, contact: 0, local: 0, local_texels: 0 }
  if texels <= 2048:
    return $Tier { texels, cascades: 3, filter: 2, contact: 12, local: 2, local_texels: 512 }
  return $Tier { texels, cascades: 4, filter: 2, contact: 20, local: 4, local_texels: 1024 }

// The weight of the logarithmic split scheme against the linear one.
const split_blend = 0.75

// The frame's shadows: the sun's cascades fitted to the frame's camera and
// light (`shadow.fit`), one light view they all share, and the quality `tier`
// of `texels` with the frame's `shadow` settings. Empty (`texels` 0, no
// cascades, no local casters) when the tier is off or the camera or light
// cannot be fitted, such as a frame that sets no view or projection.
// Cascades are nearest first and cover the camera's near plane out to the
// shadow distance; each window moves in whole texels of its own `texel`.
type Shadow is data = $Shadow {
  view: math.Mat4, texels: U32, filter: U32, softness: F32, contact: U32, contact_length: F32,
  local: U32, local_texels: U32, cascades: #[shadows.Cascade],
}

func shadow frame => func (texels: U32) : Shadow =>
  let view: math.Mat4 = frame.view
  let projection: math.Mat4 = frame.projection
  let lighting: render.Lighting = frame.lighting
  let settings: render.ShadowSettings = frame.shadow
  let chosen = tier texels
  let $Some fit = shadows.fit view projection lighting.direction chosen.cascades chosen.texels settings.distance split_blend else:
    let cascades: #[shadows.Cascade] = #[]
    return $Shadow {
      view: math.Mat4.identity, texels: 0, filter: 0, softness: 0.0, contact: 0, contact_length: 0.0,
      local: 0, local_texels: 0, cascades,
    }
  return $Shadow {
    view: fit.view, texels: chosen.texels, filter: chosen.filter, softness: settings.softness,
    contact: chosen.contact, contact_length: settings.contact_length,
    local: chosen.local, local_texels: chosen.local_texels, cascades: fit.cascades,
  }
