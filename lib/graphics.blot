import { Vec3 } from "std/vector"
import * as math from "./math"
import * as render from "./render"

// What the host needs to draw a frame's sky and shadows, worked out from the
// frame and caller-selected shadow resolution.

// The sky: overhead a little deeper than the clear color, a horizon paled
// toward grey by the ambient light and warmed by the sun, haze below it, the
// way toward the sun (or the moon), and how dark the night is, for stars.
type Sky is data = #Sky { zenith: Vec3, horizon: Vec3, ground: Vec3, sun: Vec3, night: F32 }

const sky = fn (lighting: render.Lighting) => do:
  let c = lighting.clear
  let a = lighting.ambient
  let l = lighting.color
  let lit = math.vec3 (c.x * 1.2 + a.x * 0.55 + l.x * 0.1) (c.y * 1.2 + a.y * 0.55 + l.y * 0.1) (c.z * 1.2 + a.z * 0.55 + l.z * 0.1)
  let grey = 0.299 * lit.x + 0.587 * lit.y + 0.114 * lit.z
  let pale = fn (value: F32) => min 1.0 (value + (grey - value) * 0.4)
  let horizon = math.vec3 (pale lit.x) (pale lit.y) (pale lit.z)
  return #Sky {
    zenith: math.vec3 (c.x * 0.8) (c.y * 0.8) (c.z * 0.8),
    horizon,
    ground: horizon * 0.85,
    sun: (lighting.direction * -1.0).normalized,
    night: 1.0 - smoothstep 0.03 0.16 (0.299 * c.x + 0.587 * c.y + 0.114 * c.z),
  }

// The shadow map's view: orthographic along the light, centred on the floor
// where the camera looks and wide enough for what it sees there; `texel` is a
// map texel's width in world units, and `texels` the map's size, 0 for none.
// The view is anchored to the world and its window moves in whole texels, so
// shadows hold still as the camera moves.
type Shadow is data = #Shadow { view: math.Mat4, projection: math.Mat4, texel: F32, texels: U32 }

// How far beyond the window's radius casters and receivers may lie along the
// light, and how far away the light's eye is anchored.
const depth_margin = 60.0
const anchor = 1000.0

const none = #Shadow { view: math.Mat4.identity, projection: math.Mat4.identity, texel: 0.0, texels: 0 }

const nearest = fn (value: F32) => floor (value + 0.5)

const shadow = fn (frame: render.RenderFrame) => fn (texels: U32) => do:
  if texels == 0:
    return none
  // The camera, from its (rigid) view matrix.
  let #math.Mat4 { x: cx, y: cy, z: cz, w: cw } = frame.view
  let eye = math.vec3 (-(cx.x * cw.x + cx.y * cw.y + cx.z * cw.z)) (-(cy.x * cw.x + cy.y * cw.y + cy.z * cw.z)) (-(cz.x * cw.x + cz.y * cw.y + cz.z * cw.z))
  let forward = (math.vec3 (-cx.z) (-cy.z) (-cz.z)).normalized
  // Where the camera looks on the floor, or ahead of it at the horizon.
  let along = 40.0
  if forward.y < -0.02:
    along := clamp 4.0 120.0 (-eye.y / forward.y)
  let focus = math.vec3 (eye.x + forward.x * along) 0.0 (eye.z + forward.z * along)
  let radius = clamp 18.0 100.0 (along * 0.75 + 12.0)
  let #Some ray = math.normalize3 frame.lighting.direction else:
    return none
  let across = math.up
  if abs ray.y > 0.99:
    across := math.back
  let right = (ray.cross across).normalized
  let up = right.cross ray
  let origin = ray * -anchor
  let texel = radius * 2.0 / U32.to_f32 texels
  let centre_x = nearest ((right.dot focus - right.dot origin) / texel) * texel
  let centre_y = nearest ((up.dot focus - up.dot origin) / texel) * texel
  let distance = ray.dot focus - ray.dot origin
  let near = distance - radius - depth_margin
  let far = distance + radius + depth_margin
  return #Shadow {
    view: #math.Mat4 {
      x: math.vec4 right.x up.x (-ray.x) 0.0,
      y: math.vec4 right.y up.y (-ray.y) 0.0,
      z: math.vec4 right.z up.z (-ray.z) 0.0,
      w: math.vec4 (-(right.dot origin)) (-(up.dot origin)) (ray.dot origin) 1.0,
    },
    projection: #math.Mat4 {
      x: math.vec4 (1.0 / radius) 0.0 0.0 0.0,
      y: math.vec4 0.0 (1.0 / radius) 0.0 0.0,
      z: math.vec4 0.0 0.0 (-1.0 / (far - near)) 0.0,
      w: math.vec4 (-centre_x / radius) (-centre_y / radius) (-near / (far - near)) 1.0,
    },
    texel,
    texels,
  }
