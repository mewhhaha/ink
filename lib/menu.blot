import * as array from "std/array"
import { Vec2 } from "std/vector"
import * as codec from "./codec"
import * as math from "./math"
import * as font from "./ui/font"
import * as render from "./render"
import * as ui from "./ui"
import * as tree from "./ui/tree"
import * as window from "./events"

// A column of controls on the screen that keys and the pointer work, as a
// game's menus are: where the rows lie, which row has the focus and which
// slider the pointer drags, what an event does to them, and the sprites that
// show them. The game decides what the rows are and what pressing and
// changing them does (ui.Outcome).

// The focused row, and the slider the pointer drags, plus one, or 0.
type Focus is data = $Focus { row: U32, sliding: U32 }
const unfocused = $Focus { row: 0, sliding: 0 }
const Focus.LaneEncode: codec.LaneEncode Focus = {
  to_lanes: codec.encode_lanes,
}

// Where the rows lie, top to bottom; the value column, from `values` to
// `right`; how high their text is; and the screen's scale, its height over
// 720 lines.
type Layout is data = $Layout { rows: #[ui.Rect], values: F32, right: F32, size: F32, scale: F32 }

// `count` rows, each `row` high, in a panel `width` wide centred on a screen
// `screen` wide, from `top` down, their text `size` high; all in pixels at
// `scale`.
func column_into (destination: own #[ui.Rect]) -> (count: U32) => func (top: F32) => func (width: F32) => func (row: F32) => func (size: F32) => func (scale: F32) => func (screen: F32) : Layout =>
  let left = (screen - width) * 0.5
  @storage.truncate destination 0
  for index in 0 .. count:
    @storage.push destination ($ui.Rect { x: left, y: top + U32.to_f32 index * row, width, height: row })
  return $Layout {
    rows: destination,
    values: left + width * 0.55,
    right: left + width - 16.0 * scale,
    size,
    scale,
  }

// A slider's bar in `row`, at the end of the row, before its value.
func bar (shape: Layout) => func (row: ui.Rect) => return
  $ui.Rect { x: shape.right - 220.0 * shape.scale, y: row.y + row.height * 0.5 - 4.0 * shape.scale, width: 150.0 * shape.scale, height: 8.0 * shape.scale }

// Direction-aware slider bar: mirrored onto the inline-end (left) side in RTL.
func bar_rtl (rtl: Bool) -> (shape: Layout) -> (row: ui.Rect) : ui.Rect =>
  if not rtl:
    return bar shape row
  return $ui.Rect {
    x: row.x + 86.0 * shape.scale,
    y: row.y + row.height * 0.5 - 4.0 * shape.scale,
    width: 150.0 * shape.scale,
    height: 8.0 * shape.scale,
  }

// The row at (x, y), if any.
func row_at (shape: Layout) => func (x: F32) => func (y: F32) =>
  for index in 0 .. shape.rows.length:
    if ui.inside shape.rows[index] x y:
      return $Some index
  return $Nothing

// What `event` does to `controls` laid out as `shape`: the focus after it and
// the outcome. Keys work as ui.key has them. The pointer focuses the row it
// is over; a click presses a button, steps a toggle, steps a choice back on
// the left half of its value and on on the right, and sets a slider where it
// falls on its bar, which then follows the pointer until the button is let go.
func receive (focus: Focus) => func (shape: Layout) => func (controls: #[ui.Control]) => func (event: window.Event) =>
  if controls.length == 0 or shape.rows.length < controls.length:
    return ($Focus { row: 0, sliding: 0 }, $ui.Ignored)
  if focus.sliding > controls.length:
    focus.sliding := 0
  return receive_valid focus shape controls event

func receive_valid (focus: Focus) => func (shape: Layout) => func (controls: #[ui.Control]) => func (event: window.Event) => case event of
  $window.KeyDown code => (focus, ui.key controls focus.row code)
  $window.PointerMove { x, y } => do:
    if focus.sliding > 0:
      let index = focus.sliding - 1
      if index >= controls.length or index >= shape.rows.length:
        break ($Focus { row: focus.row, sliding: 0 }, $ui.Ignored)
      let along = bar shape shape.rows[index]
      let frac = if is_finite x and is_finite along.x and is_finite along.width and abs along.width > 0.000001 then (x - along.x) / along.width else 0.0
      break (focus, $ui.Changed { index, control: ui.slide controls[index] frac })
    let $Some index = row_at shape x y else:
      break (focus, $ui.Ignored)
    if index >= controls.length or index == focus.row:
      break (focus, $ui.Ignored)
    break (focus, $ui.Moved index)
  $window.PointerDown { button: 0, x, y } => do:
    let $Some index = row_at shape x y else:
      break (focus, $ui.Ignored)
    if index >= controls.length:
      break (focus, $ui.Ignored)
    let control = controls[index]
    break case control of
      $ui.Button _ => (focus, $ui.Pressed index)
      $ui.Slider _ => do:
        let along = bar shape shape.rows[index]
        let frac = if is_finite x and is_finite along.x and is_finite along.width and abs along.width > 0.000001 then (x - along.x) / along.width else 0.0
        break ($Focus { row: index, sliding: index + 1 }, $ui.Changed { index, control: ui.slide control frac })
      $ui.Choice _ => do:
        let direction = 1.0
        if x < (shape.values + shape.right) * 0.5:
          direction := -1.0
        break (focus, $ui.Changed { index, control: ui.step control direction })
      $ui.Toggle _ => (focus, $ui.Changed { index, control: ui.step control 1.0 })
  $window.FocusLost => ($Focus { row: focus.row, sliding: 0 }, $ui.Ignored)
  $window.PointerUp _ => ($Focus { row: focus.row, sliding: 0 }, $ui.Ignored)
  _ => (focus, $ui.Ignored)

// Direction-aware input handling: in RTL, Left steps forward (+1) and Right
// steps back (-1), slider tracks fill right-to-left, and choice halves mirror.
func receive_rtl (rtl: Bool) -> (focus: Focus) -> (shape: Layout) -> (controls: #[ui.Control]) -> (event: window.Event) =>
  if not rtl:
    return receive focus shape controls event
  if controls.length == 0 or shape.rows.length < controls.length:
    return ($Focus { row: 0, sliding: 0 }, $ui.Ignored)
  if focus.sliding > controls.length:
    focus.sliding := 0
  return case event of
    $window.KeyDown code => do:
      if code == 0x110100:
        break (focus, ui.key controls focus.row 0x110101)
      if code == 0x110101:
        break (focus, ui.key controls focus.row 0x110100)
      break (focus, ui.key controls focus.row code)
    $window.PointerMove { x, y } => do:
      if focus.sliding > 0:
        let index = focus.sliding - 1
        if index >= controls.length or index >= shape.rows.length:
          break ($Focus { row: focus.row, sliding: 0 }, $ui.Ignored)
        let along = bar_rtl true shape shape.rows[index]
        let raw = if is_finite x and is_finite along.x and is_finite along.width and abs along.width > 0.000001 then (x - along.x) / along.width else 0.0
        let frac = 1.0 - raw
        break (focus, $ui.Changed { index, control: ui.slide controls[index] frac })
      let $Some index = row_at shape x y else:
        break (focus, $ui.Ignored)
      if index >= controls.length or index == focus.row:
        break (focus, $ui.Ignored)
      break (focus, $ui.Moved index)
    $window.PointerDown { button: 0, x, y } => do:
      let $Some index = row_at shape x y else:
        break (focus, $ui.Ignored)
      if index >= controls.length:
        break (focus, $ui.Ignored)
      let control = controls[index]
      let row = shape.rows[index]
      let val_left = row.x + 16.0 * shape.scale
      let val_right = row.x + row.width * 0.45
      break case control of
        $ui.Button _ => (focus, $ui.Pressed index)
        $ui.Slider _ => do:
          let along = bar_rtl true shape row
          let raw = if is_finite x and is_finite along.x and is_finite along.width and abs along.width > 0.000001 then (x - along.x) / along.width else 0.0
          let frac = 1.0 - raw
          break ($Focus { row: index, sliding: index + 1 }, $ui.Changed { index, control: ui.slide control frac })
        $ui.Choice _ => do:
          let direction = -1.0
          if x < (val_left + val_right) * 0.5:
            direction := 1.0
          break (focus, $ui.Changed { index, control: ui.step control direction })
        $ui.Toggle _ => (focus, $ui.Changed { index, control: ui.step control 1.0 })
    $window.FocusLost => ($Focus { row: focus.row, sliding: 0 }, $ui.Ignored)
    $window.PointerUp _ => ($Focus { row: focus.row, sliding: 0 }, $ui.Ignored)
    _ => (focus, $ui.Ignored)

// The words a menu shows for values: a toggle's two, and the sign after a
// slider's percentage.
type Words is data = $Words { on: &[U32], off: &[U32], percent: &[U32] }

// How a menu looks: its font's material and a plain fill's, and the colors
// of a row's label and value, focused and not, its highlight and a slider's
// empty track.
type Style is data = $Style {
  font: font.Font, fill: U32,
  label: math.Vec4, focused_label: math.Vec4, value: math.Vec4, focused_value: math.Vec4,
  highlight: math.Vec4, track: math.Vec4,
}

// The look of the game's menus so far: pale labels, warm when focused.
func plain (font: font.Font) => func (fill: U32) => $Style {
  font, fill,
  label: math.vec4 0.8 0.84 0.89 1.0, focused_label: math.vec4 1.0 0.84 0.42 1.0,
  value: math.vec4 0.56 0.63 0.71 1.0, focused_value: math.vec4 1.0 0.91 0.65 1.0,
  highlight: math.vec4 1.0 1.0 1.0 0.05, track: math.vec4 1.0 1.0 1.0 0.13,
}

func percent_of (words: Words) => func (value: F32) =>
  let rounded = if is_finite value then clamp 0.0 4294967040.0 (floor (value * 100.0 + 0.5)) else 0.0
  return array.concat (ui.digits (F32.to_u32 rounded)) (array.map identity words.percent)

// What a control shows as its value: on or off; the chosen option between
// arrows (a choice of one, a fact, without them); a slider's place in its
// range as a percentage, or off at its foot; nothing for a button.
func value_of (labels: &[U32]) -> (options_pool: &[tree.Span]) -> (words: Words) -> (control: ui.Control) => case control of
  $ui.Toggle { on } => do:
    if on:
      break array.map identity words.on
    break array.map identity words.off
  $ui.Choice { options, chosen } => do:
    if options.count == 0 or options.start >= options_pool.length:
      break #[]
    if options.count == 1:
      break array.map identity (tree.text labels options_pool[options.start])
    let offset = min chosen (options.count - 1)
    if offset >= options_pool.length - options.start:
      break #[]
    let selected = tree.text labels options_pool[options.start + offset]
    break array.concat (array.concat #[8249, 32] (array.map identity selected)) #[32, 8250]
  $ui.Slider _ => do:
    let at = ui.fraction control
    if at < 0.025:
      break array.map identity words.off
    break percent_of words at
  $ui.Button _ => #[]

func faded (color: math.Vec4) => func (alpha: F32) => math.vec4 color.x color.y color.z (color.w * alpha)

// Choice arrows bracket the value column. Its hovered half is the same half
// that a click steps, with a small highlight around that arrow alone.
func choice_sprites (labels: &[U32]) -> (options_pool: &[tree.Span]) -> (style: Style) -> (shape: Layout) -> (row: ui.Rect) -> (options: tree.Span) -> (chosen: U32) -> (color: math.Vec4) -> (pointer: Vec2) -> (lift: F32) -> (alpha: F32) =>
  if options.count == 0 or options.start >= options_pool.length:
    let none: #[render.Sprite] = #[]
    return none
  let offset = min chosen (options.count - 1)
  if offset >= options_pool.length - options.start:
    let none: #[render.Sprite] = #[]
    return none
  let width = min (32.0 * shape.scale) ((shape.right - shape.values) * 0.25)
  let middle = (shape.values + shape.right) * 0.5
  let hovered = 0
  if ui.inside row pointer.x pointer.y and pointer.x >= shape.values:
    hovered := 2
    if pointer.x < middle:
      hovered := 1
  let baseline = row.y + lift + row.height * 0.5 + shape.size * 0.34
  let value = tree.text labels options_pool[options.start + offset]
  let room = max 1.0 (shape.right - shape.values - width * 2.0 - 8.0 * shape.scale)
  let size = min shape.size (room / max 1.0 (ui.measure style.font value 1.0))
  let drawn: #[render.Sprite] = #[]
  for sprite in ui.centred style.font value middle baseline size color:
    @storage.push drawn sprite
  for side in 1 .. 3:
    let left = shape.values
    let arrow = #[8249]
    if side == 2:
      left := shape.right - width
      arrow := #[8250]
    let ink = faded style.value alpha
    if hovered == side:
      ink := faded style.focused_value alpha
      let tint = style.focused_value
      @storage.push drawn (ui.image style.fill $ui.Rect { x: left, y: row.y + lift, width, height: row.height }
        0.0 0.0 1.0 1.0 (math.vec4 tint.x tint.y tint.z (0.2 * alpha)))
    for sprite in ui.centred style.font (&arrow[0..arrow.length]) (left + width * 0.5) baseline shape.size ink:
      @storage.push drawn sprite
  return drawn

// The sprites of row `index`, `lift` pixels below its place and `alpha` of
// the way faded in: a highlight when focused, its label, `indent` in, its
// value at the right, and a slider's bar.
func row_sprites (labels: &[U32]) -> (options_pool: &[tree.Span]) -> (style: Style) -> (words: Words) -> (focus: Focus) -> (shape: Layout) -> (controls: #[ui.Control]) -> (indent: F32) -> (lift: F32) -> (alpha: F32) -> (pointer: Vec2) -> (index: U32) =>
  if index >= controls.length or index >= shape.rows.length:
    let none: #[render.Sprite] = #[]
    return none
  let control = controls[index]
  let row = shape.rows[index]
  let placed = $ui.Rect { x: row.x, y: row.y + lift, width: row.width, height: row.height }
  let focused = index == focus.row
  let label_color = faded style.label alpha
  let value_color = faded style.value alpha
  if focused:
    label_color := faded style.focused_label alpha
    value_color := faded style.focused_value alpha
  let baseline = placed.y + placed.height * 0.5 + shape.size * 0.34
  let fill = func (rect: ui.Rect) => func (color: math.Vec4) => ui.image style.fill rect 0.0 0.0 1.0 1.0 color
  let highlight = #[]
  if focused:
    highlight := #[fill placed (faded style.highlight alpha)]
  let label = ui.text style.font (tree.text labels (ui.label control)) (placed.x + indent) baseline shape.size label_color
  let value = value_of labels options_pool words control
  let value_text = case control of
    $ui.Choice { options, chosen } if options.count > 1 => choice_sprites labels options_pool style shape row options chosen value_color pointer lift alpha
    _ => ui.text style.font (&value[0..value.length]) (shape.right - ui.measure style.font (&value[0..value.length]) shape.size) baseline shape.size value_color
  let slider = case control of
    $ui.Slider _ => do:
      let along = bar shape placed
      break #[
        fill along (faded style.track alpha),
        fill $ui.Rect { x: along.x, y: along.y, width: along.width * ui.fraction control, height: along.height } value_color,
      ]
    _ => #[]
  return array.concat (array.concat highlight label) (array.concat value_text slider)

// All the rows' sprites, each row's generated, then joined once. The pointer
// uses the same screen pixels as receive; outside the column nothing hovers.
func sprites (labels: &[U32]) -> (options_pool: &[tree.Span]) -> (style: Style) -> (words: Words) -> (focus: Focus) -> (shape: Layout) -> controls -> (indent: F32) -> (lift: F32) -> (alpha: F32) -> (pointer: Vec2) -> (output: own #[render.Sprite]) : #[render.Sprite] =>
  let count = min controls.length shape.rows.length
  for index in 0 .. count:
    let row = row_sprites labels options_pool style words focus shape controls indent lift alpha pointer index
    for sprite in row:
      @storage.push output sprite
  return output

// Equal tabs above a column. The game owns the selected tab and its pages.
func tabs (shape: Layout) => func (count: U32) =>
  if count == 0 or shape.rows.length == 0:
    return #[]
  let first = shape.rows[0]
  let width = first.width / U32.to_f32 count
  return array.generate count (func index => $ui.Rect { x: first.x + U32.to_f32 index * width, y: first.y - 54.0 * shape.scale,
    width, height: 38.0 * shape.scale })

// Direction-aware equal tabs above a column: in RTL, tab 0 sits on the right.
func tabs_rtl (rtl: Bool) -> (shape: Layout) -> (count: U32) : #[ui.Rect] =>
  if not rtl:
    return tabs shape count
  if count == 0 or shape.rows.length == 0:
    return #[]
  let first = shape.rows[0]
  let width = first.width / U32.to_f32 count
  return array.generate count (func index => $ui.Rect {
    x: first.x + first.width - U32.to_f32 (index + 1) * width,
    y: first.y - 54.0 * shape.scale,
    width,
    height: 38.0 * shape.scale,
  })

// Direction-aware row sprites: in RTL, labels align to the right edge, values
// sit on the left side, and slider fills grow right-to-left.
func row_sprites_rtl (rtl: Bool) -> (labels: &[U32]) -> (options_pool: &[tree.Span]) -> (style: Style) -> (words: Words) -> (focus: Focus) -> (shape: Layout) -> (controls: #[ui.Control]) -> (indent: F32) -> (lift: F32) -> (alpha: F32) -> (pointer: Vec2) -> (index: U32) : #[render.Sprite] =>
  if not rtl:
    return row_sprites labels options_pool style words focus shape controls indent lift alpha pointer index
  if index >= controls.length or index >= shape.rows.length:
    let none: #[render.Sprite] = #[]
    return none
  let control = controls[index]
  let row = shape.rows[index]
  let placed = $ui.Rect { x: row.x, y: row.y + lift, width: row.width, height: row.height }
  let focused = index == focus.row
  let label_color = faded style.label alpha
  let value_color = faded style.value alpha
  if focused:
    label_color := faded style.focused_label alpha
    value_color := faded style.focused_value alpha
  let baseline = placed.y + placed.height * 0.5 + shape.size * 0.34
  let fill = func (rect: ui.Rect) => func (color: math.Vec4) => ui.image style.fill rect 0.0 0.0 1.0 1.0 color
  let highlight: #[render.Sprite] = #[]
  if focused:
    highlight := #[fill placed (faded style.highlight alpha)]
  let label_codes = tree.text labels (ui.label control)
  let label_w = ui.measure style.font label_codes shape.size
  let label = ui.text style.font label_codes (placed.x + placed.width - indent - label_w) baseline shape.size label_color
  let value = value_of labels options_pool words control
  let val_left = placed.x + 16.0 * shape.scale
  let value_text = ui.text style.font (&value[0..value.length]) val_left baseline shape.size value_color
  let slider: #[render.Sprite] = #[]
  if let $ui.Slider _ = control:
    let along = bar_rtl true shape placed
    let fill_w = along.width * ui.fraction control
    slider := #[
      fill along (faded style.track alpha),
      fill $ui.Rect { x: along.x + along.width - fill_w, y: along.y, width: fill_w, height: along.height } value_color,
    ]
  return array.concat (array.concat highlight label) (array.concat value_text slider)

func sprites_rtl (rtl: Bool) -> (labels: &[U32]) -> (options_pool: &[tree.Span]) -> (style: Style) -> (words: Words) -> (focus: Focus) -> (shape: Layout) -> controls -> (indent: F32) -> (lift: F32) -> (alpha: F32) -> (pointer: Vec2) -> (output: own #[render.Sprite]) : #[render.Sprite] =>
  let count = min controls.length shape.rows.length
  for index in 0 .. count:
    let row = row_sprites_rtl rtl labels options_pool style words focus shape controls indent lift alpha pointer index
    for sprite in row:
      @storage.push output sprite
  return output

func tab_at (tabs: #[ui.Rect]) => func (x: F32) => func (y: F32) =>
  for index in 0 .. tabs.length:
    if ui.inside tabs[index] x y:
      return $Some index
  return $Nothing

func tab_sprites (style: Style) -> (shape: Layout) -> (labels: &[&[U32]]) -> (selected: U32) -> (lift: F32) -> (alpha: F32) -> (output: own #[render.Sprite]) : #[render.Sprite] =>
  let rectangles = tabs shape labels.length
  let count = min labels.length rectangles.length
  for index in 0 .. count:
    let rect = rectangles[index]
    let color = faded style.value alpha
    let line_color = faded style.track alpha
    let thickness = shape.scale
    if index == selected:
      color := faded style.focused_label alpha
      line_color := color
      thickness := 2.0 * shape.scale
    let label = ui.centred style.font labels[index] (rect.x + rect.width * 0.5) (rect.y + lift + 24.0 * shape.scale) (20.0 * shape.scale) color
    let line = $ui.Rect {x: rect.x + 8.0 * shape.scale, y: rect.y + lift + rect.height, width: rect.width - 16.0 * shape.scale, height: thickness}
    for sprite in label:
      @storage.push output sprite
    @storage.push output (ui.image style.fill line 0.0 0.0 1.0 1.0 line_color)
  return output
