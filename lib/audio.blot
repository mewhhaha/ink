import { Vec3 } from "std/vector"
import * as scene from "./scene"

// All positions, velocities, timing and scene snapshots belong to the caller.
type Listener is data = $Listener { position: Vec3, velocity: Vec3, right: Vec3 }
type Emitter is data = $Emitter { position: Vec3, velocity: Vec3, gain: F32 }
type Config is data = $Config { reference: F32, reach: F32, rolloff: F32, speed: F32, blocked_gain: F32, blocked_cutoff: F32 }
type Mix is data = $Mix { gain: F32, pan: F32, rate: F32, cutoff: F32 }
const default_config = $Config { reference: 1.0, reach: 100.0, rolloff: 1.0, speed: 343.0, blocked_gain: 0.25, blocked_cutoff: 1200.0 }

const finite3 = func (v: Vec3) => return is_finite v.x and is_finite v.y and is_finite v.z

// Inverse-distance rolloff with a smooth finite-reach envelope; equal-power pan
// is applied by the playback adapter. Occlusion is caller-supplied or queried below.
// The listener-to-emitter distance after validating every input, or -1 when
// one is invalid. Vectors are taken apart into scalars, so nothing is boxed.
private const distance_to = func (config: Config) => return func (listener: Listener) => return func (emitter: Emitter) : F32 => return do:
  if Bool.not (finite3 listener.position and finite3 listener.velocity and finite3 listener.right and finite3 emitter.position and finite3 emitter.velocity):
    return (-1.0)
  if Bool.not (is_finite config.reference and is_finite config.reach and is_finite config.rolloff and is_finite config.speed and is_finite config.blocked_gain and is_finite config.blocked_cutoff and is_finite emitter.gain):
    return (-1.0)
  if config.reference <= 0.0 or config.reach <= config.reference or config.rolloff < 0.0 or config.speed <= 0.0 or config.blocked_gain < 0.0 or config.blocked_gain > 1.0 or config.blocked_cutoff <= 0.0 or emitter.gain < 0.0:
    return (-1.0)
  let x = emitter.position.x - listener.position.x
  let y = emitter.position.y - listener.position.y
  let z = emitter.position.z - listener.position.z
  let distance = sqrt (x * x + y * y + z * z)
  if Bool.not (is_finite distance):
    return (-1.0)
  return distance

private const mix_at = func (config: Config) => return func (listener: Listener) => return func (emitter: Emitter) => return func (distance: F32) => return func (blocked: Bool) : Maybe Mix => return do:
  let x = emitter.position.x - listener.position.x
  let y = emitter.position.y - listener.position.y
  let z = emitter.position.z - listener.position.z
  if distance > 0.0:
    x := self / distance
    y := self / distance
    z := self / distance
  let envelope = clamp 0.0 1.0 ((config.reach - distance) / (config.reach - config.reference))
  let gain = emitter.gain * envelope * config.reference / (config.reference + config.rolloff * max 0.0 (distance - config.reference))
  let cutoff = 20000.0
  if blocked:
    gain := self * config.blocked_gain
    cutoff := config.blocked_cutoff
  let minimum = config.speed * 0.1
  let $Vec3 { x: lx, y: ly, z: lz } = listener.velocity
  let $Vec3 { x: ex, y: ey, z: ez } = emitter.velocity
  let rate = clamp 0.5 2.0 (max minimum (config.speed + (lx * x + ly * y + lz * z)) / max minimum (config.speed + (ex * x + ey * y + ez * z)))
  if Bool.not (is_finite gain and is_finite rate):
    return $Nothing
  // Pan along the listener's right, normalized as Vec3.normalized does.
  let $Vec3 { x: rx, y: ry, z: rz } = listener.right
  let length = sqrt (rx * rx + ry * ry + rz * rz)
  if length != 0.0:
    rx := self / length
    ry := self / length
    rz := self / length
  return $Some ($Mix { gain, pan: clamp (-1.0) 1.0 (x * rx + y * ry + z * rz), rate, cutoff })

const mix = func (config: Config) => return func (listener: Listener) => return func (emitter: Emitter) => return func (blocked: Bool) : Maybe Mix => return do:
  let distance = distance_to config listener emitter
  if distance < 0.0:
    return $Nothing
  return mix_at config listener emitter distance blocked

// Static and dynamic solid scene geometry can block the listener/source segment.
// `skip` excludes the emitter collider; layers belong to the caller.
const query = func (config: Config) => return func (listener: Listener) => return func (emitter: Emitter) => return func (world: scene.Scene) => return func (mask: U32) => return func (skip: U32) : Maybe Mix => return do:
  let distance = distance_to config listener emitter
  if distance < 0.0:
    return $Nothing
  let blocked = false
  if distance > 0.001:
    let $Vec3 { x, y, z } = emitter.position
    let direction = $Vec3 { x: (x - listener.position.x) / distance, y: (y - listener.position.y) / distance, z: (z - listener.position.z) / distance }
    blocked := case scene.ray world listener.position direction (distance - 0.001) mask skip of
      $Some _ => true
      $Nothing => false
  return mix_at config listener emitter distance blocked

// A finite envelope, independent of clock or playback. Invalid timing is silent.
const fade = func (duration: F32) => return func (elapsed: F32) => return func (start: F32) => return func (finish: F32) => return do:
  if Bool.not (is_finite duration and is_finite elapsed and is_finite start and is_finite finish) or duration < 0.0 or elapsed < 0.0:
    return 0.0
  if duration == 0.0:
    return finish
  return F32.lerp start finish (clamp 0.0 1.0 (elapsed / duration))
