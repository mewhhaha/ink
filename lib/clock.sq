//! Callers choose timestep and catch-up work; no global clock policy.
//!
//! Key items: [`Policy`], [`Clock`], [`validate`], [`seconds`], [`every`].

import * as lanes from "./lanes"
import * as time from "./time"

type Policy is data = $Policy { step_seconds: F32, max_elapsed: F32, max_steps: U32 }
type Clock is data = $Clock { tick: U32, remainder: F32 }

const clock = $Clock { tick: 0, remainder: 0.0 }

func validate (policy: Policy) =>
  use lanes.require (is_finite policy.step_seconds and policy.step_seconds > 0.0)
  return lanes.require (is_finite policy.max_elapsed and policy.max_elapsed >= 0.0)

func seconds (policy: Policy) => func (current: Clock) => func (alpha: F32) =>
  use validate policy
  use lanes.require (is_finite alpha)
  let total = (U32.to_f32 current.tick + alpha) * policy.step_seconds
  use lanes.require (is_finite total)
  return total

func every (steps: U32) => func (current: Clock) =>
  if steps == 0:
    return false
  return current.tick % steps == 0

func encode_clock (current: Clock) => return
  #[U32.to_f32 (current.tick & 0xFFFF), U32.to_f32 (current.tick >> 16), current.remainder]

func decode_clock (policy: Policy) => func (values: #[F32]) =>
  use validate policy
  use lanes.exact values 3
  use lanes.finite values
  let remainder = values[2]
  use lanes.require (remainder >= 0.0 and remainder < policy.step_seconds)
  return $Clock { tick: lanes.whole values 0, remainder }

func codec (policy: Policy) => $lanes.Codec { key: 1, version: 1, encode: encode_clock, decode: decode_clock policy, migrate: lanes.no_migration }

// Checkpoint before every update. Excess whole steps are dropped and reported
// by time.Step; the fractional remainder is retained. Tick wraps as U32.
// The fixed steps a frame's elapsed time holds, each a checkpoint and an
// update of the world, which is taken over and handed back with the plan.
func advance (policy: Policy) -> (own access) -> checkpoint -> update -> (elapsed: F32) =>
  use validate policy
  use lanes.require (is_finite elapsed and elapsed >= 0.0)
  let owned: #[Clock] = access.clock
  use lanes.require (owned.length == 1)
  let current = owned[0]
  use lanes.require (current.remainder >= 0.0 and current.remainder < policy.step_seconds)
  let $Some planned = time.fixed policy.step_seconds policy.max_steps current.remainder (min policy.max_elapsed elapsed) else:
    return panic "invalid clock step"
  planned.dropped := self + max 0.0 (elapsed - policy.max_elapsed)
  for 0 .. planned.steps:
    use checkpointed <- checkpoint (own access)
    use advanced <- update (own checkpointed) policy.step_seconds
    access := advanced
    current.tick := self + 1
    access.clock[0] := current
  current.remainder := planned.remainder
  access.clock[0] := current
  return (planned, access)
