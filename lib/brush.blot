import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as lanes from "./lanes"
import * as logic from "./logic"
import * as math from "./math"
import * as render from "./render"

// A convex brush, as in Quake maps: its shape is the points p with
// dot(face.normal, p) <= face.distance for every face, and `min` and `max`
// bound its corners, kept up to date by every edit. The shape stays where it
// was made; the brush stands turned by `rotation`, then moved by `offset`,
// so turning and moving it never reshape it and can be undone exactly.
type Brush is data = $Brush { faces: &[render.Face], min: Vec3, max: Vec3, offset: Vec3, rotation: math.Quat }
// Persistent ECS rows contain only scalar spans. The owning face pool is named
// separately. Brush values borrow faces; editing writes into caller destinations.
type Stored is data = $Stored {faces_start: U32, faces_count: U32, min: Vec3, max: Vec3, offset: Vec3, rotation: math.Quat}
func pack (brush: Brush) -> (faces: ResizeArray render.Face) => return do:
  let start = faces.length
  for plane in brush.faces:
    faces.push plane
  return $Stored {faces_start: start, faces_count: brush.faces.length, min: brush.min, max: brush.max,
    offset: brush.offset, rotation: brush.rotation}
func unpack (stored: Stored) -> (faces: ResizeArray render.Face) => return do:
  if stored.faces_start > faces.length or stored.faces_count > faces.length - stored.faces_start:
    return @panic "brush face span is outside its pool"
  return $Brush {faces: faces.view stored.faces_start (stored.faces_start + stored.faces_count),
    min: stored.min, max: stored.max, offset: stored.offset, rotation: stored.rotation}


const max_faces: U32 = 20
// One extra plane supports clipping; convex 3D hulls have at most 2F-4 vertices.
const max_input_faces: U32 = max_faces + 1
const max_points: U32 = max_faces * 2 - 4
const epsilon = 0.001
// Lanes of a saved brush; see encode.
const width: U32 = 1 + max_faces * 5 + 6 + 7

func face (normal: Vec3) => return func (distance: F32) => return func (material: U32) => return
  $render.Face { normal, distance, material }

// The axis-aligned box from `min` to `max`.
func box (destination: ResizeArray render.Face) -> (min: Vec3) -> (max: Vec3) -> (material: U32) => return do:
  let start = destination.length
  destination.push (face math.right max.x material)
  destination.push (face (math.vec3 (-1.0) 0.0 0.0) (-min.x) material)
  destination.push (face math.up max.y material)
  destination.push (face (math.vec3 0.0 (-1.0) 0.0) (-min.y) material)
  destination.push (face math.back max.z material)
  destination.push (face (math.vec3 0.0 0.0 (-1.0)) (-min.z) material)
  return $Brush {faces: destination.view start (start + 6), min, max, offset: math.zero3, rotation: math.Quat.identity}

func valid_faces (faces: &[render.Face]) => return do:
  let count: U32 = faces.length
  let read: U32 -> render.Face = faces.at
  if count < 4 or count > max_input_faces:
    return false
  for index in 0 .. count:
    let plane = read index
    let n: Vec3 = plane.normal
    let squared: F32 = n.x * n.x + n.y * n.y + n.z * n.z
    if Bool.not (math.finite3 n and is_finite plane.distance and squared > 0.0 and is_finite squared):
      return false
  return true

// Whether every plane has n . d <= limit (`above` false) or n . d >= limit.
func all_facing (faces: &[render.Face]) => return func (dx: F32) => return func (dy: F32) => return func (dz: F32) => return func (above: Bool) => return func (limit: F32) => return do:
  let count: U32 = faces.length
  let read: U32 -> render.Face = faces.at
  for index in 0 .. count:
    let plane = read index
    let n: Vec3 = plane.normal
    let along: F32 = n.x * dx + n.y * dy + n.z * dz
    if (if above then Bool.not (along >= limit) else Bool.not (along <= limit)):
      return false
  return true

// A bounded solid has no nonzero direction satisfying every homogeneous
// plane inequality. Candidate recession rays lie on pairs of plane normals.
func bounded (faces: &[render.Face]) => return do:
  let count: U32 = faces.length
  let read: U32 -> render.Face = faces.at
  for i in 0 .. count:
    let a = (read i).normal
    let first_j: U32 = i + 1
    for j in first_j .. count:
      let b = (read j).normal
      // math.normalize3 of a x b, on scalars.
      let x = a.y * b.z - a.z * b.y
      let y = a.z * b.x - a.x * b.z
      let z = a.x * b.y - a.y * b.x
      let scale = max (max (abs x) (abs y)) (abs z)
      if is_finite x and is_finite y and is_finite z and scale != 0.0:
        let sx = x / scale
        let sy = y / scale
        let sz = z / scale
        let length = sqrt (sx * sx + sy * sy + sz * sz)
        let dx = sx / length
        let dy = sy / length
        let dz = sz / length
        if all_facing faces dx dy dz false 0.000001:
          return false
        if all_facing faces dx dy dz true (-0.000001):
          return false
  return true

// The point on all three planes, when they meet in one: (found, x, y, z).
func intersect_xyz (a: render.Face) => return func (b: render.Face) => return func (c: render.Face) => return do:
  let an = a.normal
  let bn = b.normal
  let cn = c.normal
  let bcx = bn.y * cn.z - bn.z * cn.y
  let bcy = bn.z * cn.x - bn.x * cn.z
  let bcz = bn.x * cn.y - bn.y * cn.x
  let determinant = an.x * bcx + an.y * bcy + an.z * bcz
  if Bool.not (is_finite determinant) or abs determinant < 0.000001:
    return (false, 0.0, 0.0, 0.0)
  let bd = b.distance
  let cd = c.distance
  let ad = a.distance
  let cax = (cn.y * an.z - cn.z * an.y) * bd
  let cay = (cn.z * an.x - cn.x * an.z) * bd
  let caz = (cn.x * an.y - cn.y * an.x) * bd
  let abx = (an.y * bn.z - an.z * bn.y) * cd
  let aby = (an.z * bn.x - an.x * bn.z) * cd
  let abz = (an.x * bn.y - an.y * bn.x) * cd
  let inverse = 1.0 / determinant
  let x = (bcx * ad + cax + abx) * inverse
  let y = (bcy * ad + cay + aby) * inverse
  let z = (bcz * ad + caz + abz) * inverse
  return (is_finite x and is_finite y and is_finite z, x, y, z)

// Whether (x, y, z) lies within every face, allowing `epsilon`.
func inside_xyz (faces: &[render.Face]) => return func (x: F32) => return func (y: F32) => return func (z: F32) => return do:
  for plane in faces:
    let n = plane.normal
    if Bool.not (n.x * x + n.y * y + n.z * z <= plane.distance + epsilon):
      return false
  return true

// Corners are rounded to this, which keeps float noise from plane
// intersections out of bounds and out of shapes rebuilt from corners.
const precision = 0.000244140625

// The corners of the solid bounded by `faces`, gathered as scalars.
func corners (faces: &[render.Face]) => return do:
  if Bool.not (valid_faces faces):
    return #[]
  let count = faces.length
  let room = count * (count - 1) * (count - 2) / 6
  let found = @array.fill (room * 3) 0.0
  let total = 0
  for i in 0 .. count:
    for j in i + 1 .. count:
      for k in j + 1 .. count:
        let (meet, x, y, z) = intersect_xyz (faces.at (i)) (faces.at (j)) (faces.at (k))
        if meet and inside_xyz faces x y z:
          let near = false
          for known in 0 .. total:
            let dx = found[known * 3] - x
            let dy = found[known * 3 + 1] - y
            let dz = found[known * 3 + 2] - z
            if sqrt (dx * dx + dy * dy + dz * dz) < epsilon * 10.0:
              near := true
          if Bool.not near:
            let sx = snap precision x
            let sy = snap precision y
            let sz = snap precision z
            if is_finite sx and is_finite sy and is_finite sz:
              found[total * 3] := sx
              found[total * 3 + 1] := sy
              found[total * 3 + 2] := sz
              total := self + 1
  return @array.generate total (func (p: U32) => return math.vec3 found[p * 3] found[p * 3 + 1] found[p * 3 + 2])

func on_plane (plane: render.Face) => return func (point: Vec3) => return
  abs (plane.normal.dot point - plane.distance) < epsilon * 10.0

func touching (plane: render.Face) => return func (points: &[Vec3]) : U32 => return do:
  let length: U32 = points.length
  let read: U32 -> Vec3 = points.at
  let n = plane.normal
  let count: U32 = 0
  for index in 0 .. length:
    let point = read index
    if abs (n.x * point.x + n.y * point.y + n.z * point.z - plane.distance) < epsilon * 10.0:
      count := self + 1
  return count

// A brush from `faces`, dropping faces that touch no edge, or Nothing when the
// faces do not enclose a solid.
func make (destination: ResizeArray render.Face) => return func faces => return do:
  let source: &[render.Face] = faces.view 0 faces.length
  if Bool.not (valid_faces source and bounded source):
    return $Nothing
  let points = corners source
  if points.length < 4:
    return $Nothing
  let kept = #[plane | plane <- faces, touching plane (points.view 0 points.length) >= 3]
  if kept.length < 4 or kept.length > max_faces:
    return $Nothing
  let (low, high) = bounds_of (points.view 0 points.length)
  if high.x <= low.x or high.y <= low.y or high.z <= low.z:
    return $Nothing
  let origin = (points.at (0))
  let ox = origin.x
  let oy = origin.y
  let oz = origin.z
  let ax = 0.0
  let ay = 0.0
  let az = 0.0
  let longest = 0.0
  for point in points:
    let dx = point.x - ox
    let dy = point.y - oy
    let dz = point.z - oz
    let squared = dx * dx + dy * dy + dz * dz
    if squared > longest:
      longest := squared
      ax := dx
      ay := dy
      az := dz
  let nx = 0.0
  let ny = 0.0
  let nz = 0.0
  let widest = 0.0
  for point in points:
    let dx = point.x - ox
    let dy = point.y - oy
    let dz = point.z - oz
    let cx = ay * dz - az * dy
    let cy = az * dx - ax * dz
    let cz = ax * dy - ay * dx
    let squared = cx * cx + cy * cy + cz * cz
    if squared > widest:
      widest := squared
      nx := cx
      ny := cy
      nz := cz
  let volume = 0.0
  for point in points:
    volume := max self (abs (nx * (point.x - ox) + ny * (point.y - oy) + nz * (point.z - oz)))
  if Bool.not (is_finite volume) or volume <= 0.000000001:
    return $Nothing
  let start = destination.length
  for plane in kept:
    destination.push plane
  return $Some $Brush {faces: destination.view start (start + kept.length), min: low, max: high, offset: math.zero3, rotation: math.Quat.identity}

// The smallest and largest coordinates of nonempty `points`.
func bounds_of (points: &[Vec3]) => return do:
  let first = (points.at (0))
  let lx = first.x
  let ly = first.y
  let lz = first.z
  let hx = first.x
  let hy = first.y
  let hz = first.z
  for point in points:
    lx := min self point.x
    ly := min self point.y
    lz := min self point.z
    hx := max self point.x
    hy := max self point.y
    hz := max self point.z
  return (math.vec3 lx ly lz, math.vec3 hx hy hz)

func center (brush: Brush) => return (brush.min + brush.max) * 0.5

// Moves the shape itself by `offset`.
func with_faces (destination: ResizeArray render.Face) -> (brush: Brush) -> faces => return do:
  let start = destination.length
  for plane in faces:
    destination.push plane
  brush.faces := destination.view start (start + faces.length)
  return brush
func translate (destination: ResizeArray render.Face) -> (offset: Vec3) -> (brush: Brush) => return do:
  let faces = array.map (func (plane: render.Face) => return do:
    plane.distance := self + plane.normal.dot offset
    return plane) brush.faces
  let moved = with_faces destination brush faces
  moved.min := self + offset
  moved.max := self + offset
  return moved
func keep_placement (brush: Brush) -> (made: Maybe Brush) => return do:
  if let $Some shape = made:
    shape.offset := brush.offset
    shape.rotation := brush.rotation
    return $Some shape
  return $Nothing
func move_face (destination: ResizeArray render.Face) -> (brush: Brush) -> (index: U32) -> (amount: F32) => return do:
  let faces: Array render.Face = array.map identity brush.faces
  if index < faces.length:
    faces[index].distance = self + amount
  return keep_placement brush (make destination faces)

// Where the shape's `point` stands.
func to_world (brush: Brush) => return func (point: Vec3) => return
  brush.rotation.rotate point + brush.offset

// The shape's point standing at `point`.
func to_shape (brush: Brush) => return func (point: Vec3) => return
  brush.rotation.conjugate.rotate (point - brush.offset)

func ray_to_shape (brush: Brush) => return func (ray: math.Ray) => return $math.Ray {
  origin: to_shape brush ray.origin,
  direction: brush.rotation.conjugate.rotate ray.direction,
}

// A plane in the world as a plane of the shape.
func plane_to_shape (brush: Brush) => return func (plane: render.Face) => return $render.Face {
  normal: brush.rotation.conjugate.rotate plane.normal,
  distance: plane.distance - plane.normal.dot brush.offset,
  material: plane.material,
}

// The faces where the brush stands.
func world_faces (brush: Brush) => return do:
  let rotation = brush.rotation
  let offset = brush.offset
  let faces = brush.faces
  return @array.generate faces.length (func (i: U32) => return do:
    let plane = (faces.at (i))
    let n = plane.normal
    let (x, y, z) = math.rotate_parts rotation.x rotation.y rotation.z rotation.w n.x n.y n.z
    return $render.Face { normal: math.vec3 x y z, distance: plane.distance + (x * offset.x + y * offset.y + z * offset.z), material: plane.material })

func turned (brush: Brush) => return abs brush.rotation.w < 0.9999999

// The brush where it stands, as a shape that stays put.
func world_bounds (brush: Brush) => return do:
  if turned brush:
    let faces = world_faces brush
    let points = corners (faces.view 0 faces.length)
    return bounds_of (points.view 0 points.length)
  return (brush.min + brush.offset, brush.max + brush.offset)
func placed (destination: ResizeArray render.Face) -> (brush: Brush) => return do:
  let faces = world_faces brush
  let low = brush.min + brush.offset
  let high = brush.max + brush.offset
  if turned brush:
    let points = corners (faces.view 0 faces.length)
    let (a, b) = bounds_of (points.view 0 points.length)
    low := a
    high := b
  let shape = with_faces destination brush faces
  shape.min := low
  shape.max := high
  shape.offset := math.zero3
  shape.rotation := math.Quat.identity
  return shape

// Moves where the brush stands by `delta`.
func shift (delta: Vec3) => return func (brush: Brush) => return do:
  brush.offset := self + delta
  return brush

// Turns the brush by `by` about the centre of its shape where it stands.
func turn (by: math.Quat) => return func (brush: Brush) => return do:
  let pivot = to_world brush (center brush)
  brush.rotation := (by * self).normalized
  brush.offset := by.rotate (self - pivot) + pivot
  return brush

// Stands the brush back where its shape was made.
func reset (brush: Brush) => return do:
  brush.offset := math.zero3
  brush.rotation := math.Quat.identity
  return brush

func flip (plane: render.Face) => return do:
  plane.normal := self * -1.0
  plane.distance := -self
  return plane

// The plane through three points, facing away from their clockwise side.
func plane_through (a: Vec3) => return func (b: Vec3) => return func (c: Vec3) => return func (material: U32) => return do:
  let normal = (b - a).cross (c - a)
  let length = normal.length
  if Bool.not (is_finite length) or length < 0.000001:
    return $Nothing
  let unit = normal * (1.0 / length)
  return $Some (face unit (unit.dot a) material)

// The material of the old face that faces most like `normal`.
func nearest_material (faces: &[render.Face]) => return func (normal: Vec3) => return do:
  let best = (-2.0, 0)
  for plane in faces:
    let (closest, _) = best
    let facing = plane.normal.dot normal
    if facing > closest:
      best := (facing, plane.material)
  let (_, material) = best
  return material

// The parts of the shape behind and in front of `plane`, when each is a solid,
// standing where `brush` stands. Each cut face takes the material of the face
// it most resembles.
func clip (destination: ResizeArray render.Face) => return func (brush: Brush) => return func (plane: render.Face) => return do:
  let back = face plane.normal plane.distance (nearest_material brush.faces plane.normal)
  let front = flip back
  front.material := nearest_material brush.faces front.normal
  let back_faces = array.push back brush.faces
  let front_faces = array.push front brush.faces
  return (keep_placement brush (make destination back_faces), keep_placement brush (make destination front_faces))

func same_plane (a: render.Face) => return func (b: render.Face) => return
  logic.both (a.normal.dot b.normal > 0.9999) (abs (a.distance - b.distance) < epsilon)

func contains_plane (faces: &[render.Face]) => return func (plane: render.Face) => return
  array.any (func known => return same_plane known plane) faces

// The face through points i, j and k when every point lies behind it.
func hull_face (points: &[Vec3]) => return func (materials: &[render.Face]) => return func (i: U32) => return func (j: U32) => return func (k: U32) => return do:
  let normal = ((points.at (j)) - (points.at (i))).cross ((points.at (k)) - (points.at (i)))
  let length = normal.length
  if Bool.not (is_finite length) or length < 0.000001:
    return $Nothing
  let unit = normal * (1.0 / length)
  let distance = unit.dot (points.at (i))
  if array.all (func (point: Vec3) => return unit.dot point <= distance + epsilon) points:
    return $Some (face unit distance (nearest_material materials unit))
  if array.all (func (point: Vec3) => return unit.dot point >= distance - epsilon) points:
    return $Some (face (unit * -1.0) (-distance) (nearest_material materials (unit * -1.0)))
  return $Nothing

// The convex hull of `points`, with each face's material taken from the
// `previous` face it most resembles. Nothing when the points are flat.
func hull (destination: ResizeArray render.Face) => return func points => return func previous => return do:
  let source: &[Vec3] = points.view 0 points.length
  let materials: &[render.Face] = previous.view 0 previous.length
  if points.length > max_points or Bool.not (array.all math.finite3 points):
    return $Nothing
  let count = points.length
  let faces: GrowArray render.Face = #[]
  for i in 0 .. count:
    for j in i + 1 .. count:
      for k in j + 1 .. count:
        if let $Some plane = hull_face source materials i j k:
          if Bool.not (contains_plane (faces.view 0 faces.length) plane):
            faces.push plane
  return make destination faces

// Distance along `ray` to where it enters the shape, and the face it enters
// through. A ray starting inside reports distance 0 and its exit face.
func hit (ray: math.Ray) => return func (brush: Brush) => return hit_faces ray brush.faces

// `hit` for the solid bounded by `faces`, such as world_faces.
func hit_faces (ray: math.Ray) => return func faces => return do:
  let source: &[render.Face] = faces.view 0 faces.length
  if Bool.not (valid_faces source and math.finite3 ray.origin and math.finite3 ray.direction):
    return $Nothing
  let near = -1e30
  let far = 1e30
  let entry = 0
  let exit = 0
  let missed = false
  let ox = ray.origin.x
  let oy = ray.origin.y
  let oz = ray.origin.z
  let dx = ray.direction.x
  let dy = ray.direction.y
  let dz = ray.direction.z
  for index in 0 .. source.length:
    let plane: render.Face = source.at index
    let n = plane.normal
    let facing = n.x * dx + n.y * dy + n.z * dz
    let outside = n.x * ox + n.y * oy + n.z * oz - plane.distance
    if abs facing < 0.0000001:
      if outside > 0.0:
        missed := true
    else:
      let crossing = -outside / facing
      if facing < 0.0:
        if crossing > near:
          entry := index
        near := max self crossing
      else:
        if crossing < far:
          exit := index
        far := min self crossing
  if missed or far < near or far < 0.0:
    return $Nothing
  if near < 0.0:
    return $Some (0.0, exit)
  return $Some (near, entry)

// Corners of `brush` on both faces a and b: its edges.
func edges (brush: Brush) => return do:
  let points = corners brush.faces
  let count = brush.faces.length
  let found: GrowArray (Vec3, Vec3) = #[]
  for a in 0 .. count:
    for b in a + 1 .. count:
      let shared = #[point | point <- points, on_plane brush.faces[a] point, on_plane brush.faces[b] point]
      if shared.length == 2:
        @storage.push found (shared[0], shared[1])
  return @storage.freeze found

// Whether both ends of `edge` lie on `plane`.
func on_edge (plane: render.Face) => return func (edge: (Vec3, Vec3)) => return do:
  let (a, b) = edge
  return logic.both (on_plane plane a) (on_plane plane b)

// Edges of face `index`.
func face_edges (brush: Brush) => return func index => return
  #[edge | edge <- edges brush, on_edge brush.faces[index] edge]

// Every face in `material`.
func paint (destination: ResizeArray render.Face) -> (material: U32) -> (brush: Brush) => return do:
  let faces = array.map (func (plane: render.Face) => return do:
    plane.material := material
    return plane) brush.faces
  return with_faces destination brush faces
func paint_face (destination: ResizeArray render.Face) -> (index: U32) -> (material: U32) -> (brush: Brush) => return do:
  let faces: Array render.Face = array.map identity brush.faces
  faces[index].material = material
  return with_faces destination brush faces

func snap (grid: F32) => return func (value: F32) => return floor (value / grid + 0.5) * grid

func snap_vec (grid: F32) => return func (point: Vec3) => return
  math.vec3 (snap grid point.x) (snap grid point.y) (snap grid point.z)

// Current stored brushes are borrowed. World-space faces are copied directly
// into one frame-owned payload pool; solids retain only views until encoding.
func draw brushes -> (source: ResizeArray render.Face) -> (faces: ResizeArray render.Face) -> (frame: render.FrameAccess) => return do:
  for row in brushes:
    let stored: Maybe Stored = row
    if let $Some brush = stored:
      if brush.faces_start > source.length or brush.faces_count > source.length - brush.faces_start:
        return @panic "brush face span is outside its pool"
      let start = faces.length
      for index in 0 .. brush.faces_count:
        let plane: render.Face = source[brush.faces_start + index]
        let rotation: math.Quat = brush.rotation
        let offset: Vec3 = brush.offset
        let n: Vec3 = plane.normal
        let rotated: (F32, F32, F32) = math.rotate_parts rotation.x rotation.y rotation.z rotation.w n.x n.y n.z
        let (x, y, z) = rotated
        let dx: F32 = x * offset.x
        let dy: F32 = y * offset.y
        let dz: F32 = z * offset.z
        let distance_x: F32 = plane.distance + dx
        let distance_xy: F32 = distance_x + dy
        let distance: F32 = distance_xy + dz
        faces.push $render.Face {normal: math.vec3 x y z,
          distance, material: plane.material}
      frame.solids.push $render.Solid {faces: &faces[start..faces.length]}

func empty destination => return box destination math.zero3 math.one3 0

// Lanes: face count, then normal3, distance, material for max_faces faces
// (zeros past the count), then min3 and max3, offset3 and rotation4.
func encode (brush: Brush) => return do:
  let $Brush { faces, min, max, offset: t, rotation: r } = brush
  return array.concat (render.encode_faces faces max_faces) #[min.x, min.y, min.z, max.x, max.y, max.z, t.x, t.y, t.z, r.x, r.y, r.z, r.w]

// Decoding writes fixed rows into the caller's face pool; only Stored escapes.
const codec = {key: 7, version: 1, encode, migrate: lanes.no_migration}

// Flat persistence adapters retain the version-1 numerical validation and
// framing. The caller owns the destination face pool; only Stored escapes.
func validated_bounds (faces: Array render.Face): Maybe (Vec3, Vec3) => return do:
  let source: &[render.Face] = faces.view 0 faces.length
  let face_count: U32 = faces.length
  let face_at: U32 -> render.Face = faces.at
  if Bool.not (valid_faces source and bounded source):
    return $Nothing
  let points: Array Vec3 = corners source
  if points.length < 4:
    return $Nothing
  let kept_count: U32 = 0
  for index in 0 .. face_count:
    let plane = face_at index
    if touching plane (points.view 0 points.length) >= 3:
      kept_count := self + 1
  if kept_count < 4 or kept_count > max_faces:
    return $Nothing
  let (low, high) = bounds_of (points.view 0 points.length)
  if high.x <= low.x or high.y <= low.y or high.z <= low.z:
    return $Nothing
  let origin = (points.at (0))
  let ox = origin.x
  let oy = origin.y
  let oz = origin.z
  let ax = 0.0
  let ay = 0.0
  let az = 0.0
  let longest = 0.0
  for point in points:
    let dx = point.x - ox
    let dy = point.y - oy
    let dz = point.z - oz
    let squared = dx * dx + dy * dy + dz * dz
    if squared > longest:
      longest := squared
      ax := dx
      ay := dy
      az := dz
  let nx = 0.0
  let ny = 0.0
  let nz = 0.0
  let widest = 0.0
  for point in points:
    let dx = point.x - ox
    let dy = point.y - oy
    let dz = point.z - oz
    let cx = ay * dz - az * dy
    let cy = az * dx - ax * dz
    let cz = ax * dy - ay * dx
    let squared = cx * cx + cy * cy + cz * cz
    if squared > widest:
      widest := squared
      nx := cx
      ny := cy
      nz := cz
  let volume = 0.0
  for point in points:
    volume := max self (abs (nx * (point.x - ox) + ny * (point.y - oy) + nz * (point.z - oz)))
  if Bool.not (is_finite volume) or volume <= 0.000000001:
    return $Nothing
  return $Some (low, high)

func encode_stored (stored: Stored) -> (faces: ResizeArray render.Face) => return do:
  let first = render.encode_faces (&faces[stored.faces_start..stored.faces_start + stored.faces_count]) max_faces
  let low = stored.min
  let high = stored.max
  let t = stored.offset
  let r = stored.rotation
  return array.concat first #[low.x, low.y, low.z, high.x, high.y, high.z, t.x, t.y, t.z, r.x, r.y, r.z, r.w]
func decode_into (values: Array F32) -> (destination: ResizeArray render.Face) => return do:
  lanes.exact values width
  lanes.finite values
  let count = lanes.integer values[0] max_faces
  lanes.require (count >= 4)
  let faces = array.generate count (func index => return do:
    let start = 1 + index * 5
    let normal = lanes.vec3 values start
    lanes.require (abs (normal.length - 1.0) < 0.01)
    return face normal values[start + 3] (lanes.integer values[start + 4] lanes.max_integer))
  lanes.zeros values (1 + count * 5) ((max_faces - count) * 5)
  let bounds = 1 + max_faces * 5
  let low = lanes.vec3 values bounds
  let high = lanes.vec3 values (bounds + 3)
  let $Some (actual_low, actual_high) = validated_bounds faces else:
    return @panic "saved brush does not enclose a solid"
  lanes.require ((low - actual_low).length <= epsilon * 2.0 and (high - actual_high).length <= epsilon * 2.0)
  let offset = lanes.vec3 values (bounds + 6)
  let rotation = lanes.quaternion values (bounds + 9)
  let start = destination.length
  for plane in faces:
    destination.push plane
  return $Stored {faces_start: start, faces_count: count, min: low, max: high, offset, rotation}
