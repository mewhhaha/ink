//! Game Feel & Camera Rig Polish: trauma-squared camera shake, hitstop freeze
//! timer, critically/underdamped 3D recoil spring, spring-arm camera occlusion
//! distance smoother, and spline dolly rail sampling.
//!
//! Key items: [`Trauma`], [`ShakeSample`], [`Hitstop`], [`Recoil`], [`trauma_new`].
//!
//! ```squid
//! let hs = trigger_hitstop 0.1 0.0 (hitstop_none ())
//! let (dt, _) = step_hitstop 0.016 hs
//! dt // => 0.0
//! ```

import { Vec3 } from "std/vector"
import * as math from "./math"
import * as noise from "./noise"

type Trauma is data = $Trauma {
  level: F32,
  decay: F32,
  time: F32,
  frequency: F32,
  max_offset: Vec3,
  max_angles: Vec3,
  seed: U32,
}

type ShakeSample is data = $ShakeSample {
  offset: Vec3,
  angles: Vec3, // pitch, yaw, roll in radians
}

type Hitstop is data = $Hitstop {
  remaining: F32,
  time_scale: F32,
}

type Recoil is data = $Recoil {
  value: Vec3,
  velocity: Vec3,
  stiffness: F32,
  damping: F32,
}

type SpringArm is data = $SpringArm {
  target_length: F32,
  current_length: F32,
  min_length: F32,
  retract_speed: F32,
  recover_speed: F32,
}

func trauma_new (decay: F32) -> (frequency: F32) -> (max_offset: Vec3) -> (max_angles: Vec3) -> (seed: U32) : Trauma =>
  return $Trauma { level: 0.0, decay, time: 0.0, frequency, max_offset, max_angles, seed }

func add_trauma (amount: F32) -> (t: Trauma) : Trauma =>
  if not (is_finite amount) or amount <= 0.0:
    return t
  let base = if is_finite t.level then t.level else 0.0
  return $Trauma {
    level: clamp 0.0 1.0 (base + amount),
    decay: t.decay, time: t.time, frequency: t.frequency,
    max_offset: t.max_offset, max_angles: t.max_angles, seed: t.seed,
  }

func step_trauma (dt: F32) -> (t: Trauma) : Trauma =>
  if not (is_finite dt) or dt <= 0.0:
    return t
  let base = if is_finite t.level then t.level else 0.0
  let dec = if is_finite t.decay then max 0.0 t.decay else 0.0
  let next_time = if is_finite t.time then t.time + dt else dt
  return $Trauma {
    level: max 0.0 (base - dec * dt),
    decay: t.decay, time: next_time, frequency: t.frequency,
    max_offset: t.max_offset, max_angles: t.max_angles, seed: t.seed,
  }

// Evaluate quadratic trauma shake (`shake = level^2`) driven by deterministic
// Perlin noise channels.
func sample_shake (t: Trauma) : ShakeSample =>
  if not (is_finite t.level and is_finite t.time and is_finite t.frequency and math.finite3 t.max_offset and math.finite3 t.max_angles):
    return $ShakeSample { offset: math.zero3, angles: math.zero3 }
  let s = t.level * t.level
  if s <= 0.000001 or not (is_finite s):
    return $ShakeSample { offset: math.zero3, angles: math.zero3 }
  let u = t.time * t.frequency
  if not (is_finite u):
    return $ShakeSample { offset: math.zero3, angles: math.zero3 }
  let ox = noise.perlin1 (t.seed + 1) u * t.max_offset.x * s
  let oy = noise.perlin1 (t.seed + 2) u * t.max_offset.y * s
  let oz = noise.perlin1 (t.seed + 3) u * t.max_offset.z * s
  let ax = noise.perlin1 (t.seed + 4) u * t.max_angles.x * s
  let ay = noise.perlin1 (t.seed + 5) u * t.max_angles.y * s
  let az = noise.perlin1 (t.seed + 6) u * t.max_angles.z * s
  return $ShakeSample { offset: $Vec3 { x: ox, y: oy, z: oz }, angles: $Vec3 { x: ax, y: ay, z: az } }

// Hitstop / impact freeze controller. Returns `(scaled_dt, next_hitstop)`.
func hitstop_none () : Hitstop => $Hitstop { remaining: 0.0, time_scale: 1.0 }

func trigger_hitstop (duration: F32) -> (time_scale: F32) -> (h: Hitstop) : Hitstop =>
  if not (is_finite duration) or duration <= 0.0:
    return h
  let sc = if is_finite time_scale then clamp 0.0 1.0 time_scale else 1.0
  let cur = if is_finite h.remaining then max 0.0 h.remaining else 0.0
  return $Hitstop { remaining: max cur duration, time_scale: sc }

func step_hitstop (dt: F32) -> (h: Hitstop) : (F32, Hitstop) =>
  if not (is_finite dt) or dt <= 0.0:
    return (0.0, h)
  if not (is_finite h.remaining and is_finite h.time_scale):
    return (dt, hitstop_none ())
  if h.remaining <= 0.0:
    return (dt, $Hitstop { remaining: 0.0, time_scale: 1.0 })
  let frozen = min dt h.remaining
  let free = dt - frozen
  let rem = h.remaining - frozen
  let scaled = frozen * clamp 0.0 1.0 h.time_scale + free
  let next_scale = if rem <= 0.0 then 1.0 else clamp 0.0 1.0 h.time_scale
  return (scaled, $Hitstop { remaining: max 0.0 rem, time_scale: next_scale })

// 3D damped harmonic recoil spring (weapon kick, landing bob, camera punch).
func recoil_new (stiffness: F32) -> (damping: F32) : Recoil =>
  return $Recoil { value: math.zero3, velocity: math.zero3, stiffness, damping }

func kick_recoil (impulse: Vec3) -> (r: Recoil) : Recoil =>
  return $Recoil { value: r.value, velocity: r.velocity + impulse, stiffness: r.stiffness, damping: r.damping }

// Analytic closed-form damped harmonic oscillator step for a single axis,
// unconditionally stable for any positive stiffness `k`, damping `c`, and `dt`.
private func exp_neg (x: F32) : F32 =>
  if not (is_finite x):
    return if x > 0.0 then 0.0 else 1.0
  if x >= 80.0:
    return 0.0
  if x <= 0.0:
    return 1.0
  // Range reduction: e^(-x) = (e^(-x / 2^k))^(2^k) where u = x / 2^k <= 0.25.
  let u = x
  let halvings = 0
  for _ in 0 .. 16:
    if u <= 0.25:
      break
    u := self * 0.5
    halvings := self + 1
  let e = 1.0 - u * (1.0 - u * (0.5 - u * (0.16666667 - u * (0.041666668 - u * 0.008333334))))
  for _ in 0 .. halvings:
    e := self * self
  return clamp 0.0 1.0 e

private func step_spring_axis (x0: F32) -> (v0: F32) -> (k: F32) -> (c: F32) -> (dt: F32) : (F32, F32) =>
  if not (is_finite x0 and is_finite v0 and is_finite k and is_finite c and is_finite dt):
    return (0.0, 0.0)
  if k <= 0.0:
    let next_x = x0 + v0 * dt
    return if is_finite next_x then (next_x, v0) else (0.0, 0.0)
  let wn = sqrt k
  let zeta = max 0.0 c / (2.0 * wn)
  let decay = exp_neg (zeta * wn * dt)
  if zeta < 0.999:
    let wd = wn * sqrt (max 0.0 (1.0 - zeta * zeta))
    let ang = wd * dt
    if not (is_finite wd and is_finite ang) or wd <= 0.0:
      return (0.0, 0.0)
    let wrapped = if abs ang > 4096.0 then (if abs ang > 1.0e7 then 0.0 else wrap tau ang) else ang
    let a = x0
    let b = (v0 + zeta * wn * x0) / wd
    let cs = cos wrapped
    let sn = sin wrapped
    let x = decay * (a * cs + b * sn)
    let v = decay * ((b * wd - a * zeta * wn) * cs - (a * wd + b * zeta * wn) * sn)
    if not (is_finite x and is_finite v):
      return (0.0, 0.0)
    return (x, v)
  if zeta <= 1.001:
    // Critically damped: x(t) = e^(-wn*t) * (x0 + (v0 + wn*x0)*t)
    let b = v0 + wn * x0
    let x = decay * (x0 + b * dt)
    let v = decay * (v0 - wn * b * dt)
    if not (is_finite x and is_finite v):
      return (0.0, 0.0)
    return (x, v)
  // Overdamped: two negative real roots r1, r2.
  let root = wn * sqrt (zeta * zeta - 1.0)
  if not (is_finite root):
    return (0.0, 0.0)
  let r1 = (0.0 - zeta) * wn + root
  let r2 = (0.0 - zeta) * wn - root
  let span = r1 - r2
  if not (is_finite span) or abs span <= 0.000001:
    return (0.0, 0.0)
  let c1 = (v0 - r2 * x0) / span
  let c2 = x0 - c1
  let e1 = exp_neg ((0.0 - r1) * dt)
  let e2 = exp_neg ((0.0 - r2) * dt)
  let x = c1 * e1 + c2 * e2
  let v = c1 * r1 * e1 + c2 * r2 * e2
  if not (is_finite x and is_finite v):
    return (0.0, 0.0)
  return (x, v)

func step_recoil (dt: F32) -> (r: Recoil) : Recoil =>
  if not (is_finite dt) or dt <= 0.0:
    return r
  let k = if is_finite r.stiffness then max 0.0 r.stiffness else 0.0
  let c = if is_finite r.damping then max 0.0 r.damping else 0.0
  let (nx, vx) = step_spring_axis r.value.x r.velocity.x k c dt
  let (ny, vy) = step_spring_axis r.value.y r.velocity.y k c dt
  let (nz, vz) = step_spring_axis r.value.z r.velocity.z k c dt
  return $Recoil {
    value: $Vec3 { x: nx, y: ny, z: nz },
    velocity: $Vec3 { x: vx, y: vy, z: vz },
    stiffness: r.stiffness,
    damping: r.damping,
  }

// Spring-arm camera occlusion smoother: enforces clearance immediately on
// obstruction (`hit_distance < current_length`) so the camera never stays past
// a blocking surface, and recovers smoothly toward `target_length`.
func step_spring_arm (dt: F32) -> (hit_distance: F32) -> (arm: SpringArm) : SpringArm =>
  if not (is_finite arm.target_length and is_finite arm.current_length and is_finite arm.min_length and is_finite arm.recover_speed):
    return arm
  let hit_safe = if is_finite hit_distance then max 0.0 hit_distance else arm.target_length
  let obstructed = hit_safe < arm.target_length
  let goal = if obstructed then min arm.target_length hit_safe else clamp arm.min_length arm.target_length hit_safe
  if not (is_finite dt) or dt <= 0.0:
    return arm
  let cur = arm.current_length
  // Always retract to at most `goal` immediately when obstructed to preserve clearance.
  let next = if goal < cur then goal else min goal (cur + max 0.0 arm.recover_speed * dt)
  return $SpringArm {
    target_length: arm.target_length, current_length: next,
    min_length: arm.min_length, retract_speed: arm.retract_speed, recover_speed: arm.recover_speed,
  }

// Sample a Catmull-Rom dolly rail at normalized parameter `t` in `[0, 1]`,
// returning `(position, forward_tangent)`.
func dolly_sample (waypoints: #[Vec3]) -> (t: F32) : (Vec3, Vec3) =>
  let n = waypoints.length
  if n == 0:
    return (math.zero3, math.forward)
  if n == 1:
    return (waypoints[0], math.forward)
  let tc = if is_finite t then clamp 0.0 1.0 t else 0.0
  let u = tc * U32.to_f32 (n - 1)
  let fu = floor u
  let seg = if fu >= 4294967040.0 then n - 2 else min (n - 2) (F32.to_u32 (max 0.0 fu))
  let s = u - U32.to_f32 seg
  let p0 = waypoints[if seg > 0 then seg - 1 else 0]
  let p1 = waypoints[seg]
  let p2 = waypoints[seg + 1]
  let p3 = waypoints[if seg + 2 < n then seg + 2 else n - 1]
  let s2 = s * s
  let s3 = s2 * s
  let pos = (p1 * 2.0
    + (p2 - p0) * s
    + (p0 * 2.0 - p1 * 5.0 + p2 * 4.0 - p3) * s2
    + (p1 * 3.0 - p0 - p2 * 3.0 + p3) * s3) * 0.5
  let deriv = ((p2 - p0)
    + (p0 * 2.0 - p1 * 5.0 + p2 * 4.0 - p3) * (2.0 * s)
    + (p1 * 3.0 - p0 - p2 * 3.0 + p3) * (3.0 * s2)) * 0.5
  let fwd = case math.normalize3 deriv of
    $Some u => u
    $Nothing => Maybe.unwrap_or math.forward (math.normalize3 (p2 - p1))
  return (pos, fwd)
