//! Host-independent localized text. Requests and spans are fixed rows; the
//! application owns this cache, numeric text payload and RTL flag separately.
//!
//! Key items: [`Text`], [`Slot`], [`Cache`], [`empty`], [`grow`].

import * as array from "std/array"

type Text is data = $Text {drawn: #[U32], spoken: #[U32]}
type Slot is data = $Slot {request: U32, resolved: Bool, drawn_start: U32, drawn_count: U32, spoken_start: U32, spoken_count: U32}
type Cache = #[Slot]
func empty () : Cache => #[]
func grow (count: U32) -> (cache: own Cache) : Cache =>
  for cache.length .. count:
    @storage.push cache $Slot {request: 0, resolved: false, drawn_start: 0, drawn_count: 0, spoken_start: 0, spoken_count: 0}
  return cache
func begin (index: U32) -> (request: U32) -> (cache: own Cache) : Cache =>
  if request == 0 or index >= cache.length:
    return panic "locale request needs a declared slot and nonzero ID"
  cache[index].request := request
  return cache
// Reuse a row's existing extent when possible; larger replies append a new
// bounded extent. Reset/compaction is explicit and requires no live text views.
func store values -> (start: U32) -> (count: U32) -> (payload: own #[U32]) : (U32, #[U32]) =>
  if start > payload.length or count > payload.length - start:
    return panic "locale payload span is outside its pool"
  if values.length <= count:
    for index in 0 .. values.length:
      payload[start + index] := values[index]
    return (start, payload)
  let at = payload.length
  for value in values:
    @storage.push payload value
  return (at, payload)
// Stale replies do nothing. Failure completes the request while retaining prior
// text. Success copies both channels; no invocation view enters a stored row.
func resolve (index: U32) -> (request: U32) -> (answer: Maybe Text) -> (rtl: Bool) -> (cache: own Cache) -> (payload: own #[U32]) -> (direction: own #[Bool]) =>
  if index >= cache.length or request == 0 or cache[index].request != request:
    return (cache, payload, direction)
  if let $Some words = answer:
    let row = cache[index]
    let drawn = array.generate words.drawn.length (func i => words.drawn[i])
    let spoken = array.generate words.spoken.length (func i => words.spoken[i])
    let (drawn_start, drawn_payload) = store drawn row.drawn_start row.drawn_count payload
    let (spoken_start, spoken_payload) = store spoken row.spoken_start row.spoken_count drawn_payload
    payload := spoken_payload
    cache[index] := $Slot {request: 0, resolved: true, drawn_start, drawn_count: words.drawn.length,
      spoken_start, spoken_count: words.spoken.length}
    direction[0] := rtl
  else:
    cache[index].request := 0
  return (cache, payload, direction)
func range (payload: #[U32]) -> (start: U32) -> (count: U32) =>
  if start > payload.length or count > payload.length - start:
    return panic "locale payload span is outside its pool"
  return &payload[start..start + count]
func word (cache: Cache) -> payload -> (index: U32) -> fallback =>
  if index < cache.length and cache[index].resolved:
    return range payload cache[index].drawn_start cache[index].drawn_count
  return fallback
func spoken (cache: Cache) -> payload -> (index: U32) -> fallback =>
  if index < cache.length and cache[index].resolved:
    return range payload cache[index].spoken_start cache[index].spoken_count
  return word cache payload index fallback
func clear (cache: own Cache) -> (payload: own #[U32]) : (Cache, #[U32]) =>
  @storage.truncate cache 0
  @storage.truncate payload 0
  return (cache, payload)

// Explicit cache retention copies scalar slots, codepoint payload and direction.
func copy_into (destination: own Cache) -> (destination_payload: own #[U32]) -> (destination_direction: own #[Bool]) -> (source: Cache) -> (source_payload: #[U32]) -> (source_direction: #[Bool]) : (Cache, #[U32], #[Bool]) =>
  let slots = copy source
  let values = copy source_payload
  let rtl = source_direction[0]
  @storage.truncate destination 0
  @storage.truncate destination_payload 0
  for value in values:
    @storage.push destination_payload value
  for slot in slots:
    @storage.push destination slot
  destination_direction[0] := rtl
  return (destination, destination_payload, destination_direction)
