import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as font from "./ui/font"
import * as keys from "./input/keys"
import * as math from "./math"
import * as vocabulary from "./ui/vocabulary"
import * as render from "./render"
import * as tree from "./ui/tree"
import * as window from "./events"

// Interface building blocks: headless controls that know their values and
// how keys and pointers change them but not how they look, the sprites that
// draw text, rectangles and panels for a game to compose them with, and the
// nodes that tell assistive technology and the keyboard what they are (at
// the end).

// A control and its value. Text is code points.
type Control is data =
  | $Button { label: &[U32] }
  | $Toggle { label: &[U32], on: Bool }
  | $Slider { label: &[U32], value: F32, low: F32, high: F32, step: F32 }
  | $Choice { label: &[U32], options: &[&[U32]], chosen: U32 }

// What a key did to a menu of controls: moved the focus, pressed the focused
// button, changed the focused control, or nothing.
type Outcome is data =
  | $Moved U32
  | $Pressed U32
  | $Changed { index: U32, control: Control }
  | $Ignored

func label (control: Control) => return case control of
  $Button { label } => label
  $Toggle { label } => label
  $Slider { label } => label
  $Choice { label } => label

// `control` stepped once: a toggle flips, a slider moves a step up (direction
// 1) or down (-1) within its range, a choice moves to the next or previous
// option, wrapping round; a button stays as it is.
func slider_value (low: F32) => return func (high: F32) => return func (size: F32) => return func (value: F32) => return do:
  if Bool.not (is_finite low):
    return 0.0
  if Bool.not (is_finite high and is_finite value) or high < low:
    return low
  let bounded = clamp low high value
  if size <= 0.0 or Bool.not (is_finite size):
    return bounded
  let units = (bounded - low) / size
  if Bool.not (is_finite units):
    return bounded
  return clamp low high (low + floor (units + 0.5) * size)

func step (control: Control) => return func (direction: F32) => return case control of
  $Toggle { label, on } => $Toggle { label, on: Bool.not on }
  $Slider { label, value, low, high, step: size } => do:
    let next = slider_value low high size value
    if size > 0.0 and is_finite size and is_finite direction:
      next := slider_value low high size (value + direction * size)
    break $Slider { label, value: next, low, high, step: size }
  $Choice { label, options, chosen } => do:
    let count = options.length
    if count == 0:
      break $Choice { label, options, chosen: 0 }
    let current = chosen % count
    let next = (current + count - 1) % count
    if direction > 0.0:
      next := (current + 1) % count
    break $Choice { label, options, chosen: next }
  $Button _ => control

// Nonpositive slider steps use continuous pointer values and do not step by key.
func slide (control: Control) => return func (at: F32) => return case control of
  $Slider { label, value, low, high, step: size } => do:
    if Bool.not (is_finite at):
      break control
    let next = low + clamp 0.0 1.0 at * (high - low)
    break $Slider { label, value: slider_value low high size next, low, high, step: size }
  _ => control

func fraction (control: Control) => return case control of
  $Slider { value, low, high } => do:
    if high <= low or Bool.not (is_finite low and is_finite high and is_finite value):
      break 0.0
    break clamp 0.0 1.0 ((value - low) / (high - low))
  _ => 0.0

func key (controls: Array Control) => return func (focused: U32) => return func (code: U32) => return do:
  let count = controls.length
  if count == 0 or focused >= count:
    return $Ignored
  if code == keys.up:
    return $Moved ((focused + count - 1) % count)
  if code == keys.down:
    return $Moved ((focused + 1) % count)
  let control = controls[focused]
  let pressing = code == keys.enter or code == keys.space
  let direction = 1.0
  if code == keys.left:
    direction := -1.0
  return case control of
    $Button _ if pressing => $Pressed focused
    $Button _ => $Ignored
    _ if pressing or code == keys.left or code == keys.right => $Changed { index: focused, control: step control direction }
    _ => $Ignored

// A line of text being typed, in code points, and its caret: before the
// code point at `caret`, or at the end. A text box's system types into it
// with the keys its node takes (`textbox_node`).
type Line is data = $Line {text: &[U32], caret: U32}
type StoredLine is data = $StoredLine {start: U32, count: U32, caret: U32}
const blank = $Line {text: &tree.no_text[0..0], caret: 0}

// The line `text` with its caret at the end.
func line_of (text: &[U32]) => return $Line { text, caret: text.length }

// The character key `code` types, a letter in capitals while `shifted`
// (keys arrive with letters in capitals, input/keys), or Nothing for a key
// that types none.
func character (code: U32) => return func (shifted: Bool) => return do:
  if code >= 65 and code <= 90:
    if shifted:
      return $Some code
    return $Some (code + 32)
  if code >= 32 and code < 127 or (code >= 160 and code < 0xD800 or code > 0xDFFF and code < 0x110000):
    return $Some code
  return $Nothing

// `line` with `codes` typed at its caret.
func splice_line (line: Line) -> (start: U32) -> (removed: U32) -> codes -> (output: ResizeArray U32) => return do:
  if start > line.text.length or removed > line.text.length - start:
    return @panic "line edit range is outside its text"
  let first = output.length
  for index in 0 .. start:
    @storage.push output line.text[index]
  for index in 0 .. codes.length:
    @storage.push output (array.at index codes)
  for index in start + removed .. line.text.length:
    @storage.push output line.text[index]
  return $Line {text: &output[first..output.length], caret: start + codes.length}
func typed (line: Line) -> codes -> (output: ResizeArray U32) => return
  splice_line line (min line.caret line.text.length) 0 codes output
func pack_line (line: Line) -> (output: ResizeArray U32) => return do:
  let start = output.length
  for code in line.text:
    @storage.push output code
  return $StoredLine {start, count: line.text.length, caret: min line.caret line.text.length}
func unpack_line (line: StoredLine) -> (payload: ResizeArray U32) => return do:
  if line.start > payload.length or line.count > payload.length - line.start:
    return @panic "line text span is outside its pool"
  return $Line {text: &payload[line.start..line.start + line.count], caret: min line.caret line.count}

// What key `code` does to `line` as a text box's keys do: Backspace and
// Delete take out the code point before and after the caret, Left and Right
// move it by one, Home and End to either end; Nothing for any other key.
func edit (line: Line) -> (code: U32) -> (output: ResizeArray U32) => return do:
  line.caret := min self line.text.length
  let $Line { text, caret } = line
  let count = text.length
  if code == keys.backspace:
    if caret == 0:
      return $Some line
    return $Some (splice_line line (caret - 1) 1 (&tree.no_text[0..0]) output)
  if code == keys.delete:
    if caret >= count:
      return $Some line
    return $Some (splice_line line caret 1 (&tree.no_text[0..0]) output)
  if code == keys.left:
    let next = 0
    if caret > 0:
      next := caret - 1
    return $Some $Line { text, caret: next }
  if code == keys.right:
    return $Some $Line { text, caret: min count (caret + 1) }
  if code == keys.home:
    return $Some $Line { text, caret: 0 }
  if code == keys.end:
    return $Some $Line { text, caret: count }
  return $Nothing

// Rectangles on the screen, in pixels from its top left.
type Rect is data = $Rect { x: F32, y: F32, width: F32, height: F32 }

func inside (rect: Rect) => return func (x: F32) => return func (y: F32) => return
  x >= rect.x and x < rect.x + rect.width and y >= rect.y and y < rect.y + rect.height

// No parameters for a sprite's shader.
const none = math.vec4 0.0 0.0 0.0 0.0

// A rectangle of `material`'s texture between (u0, v0) and (u1, v1).
func image (material: U32) => return func (rect: Rect) => return func (u0: F32) => return func (v0: F32) => return func (u1: F32) => return func (v1: F32) => return func (color: math.Vec4) => return
  $render.Sprite { x: rect.x, y: rect.y, width: rect.width, height: rect.height, u0, v0, u1, v1, color, material, parameters: none }

// Every slot text writes or cuts away starts as this.
const unwritten = image 0 nowhere 0.0 0.0 0.0 0.0 none

// How wide `codes` set at `size` pixels an em is.
func measure (face: font.Font) => return func (codes: &[U32]) => return func (size: F32) => return do:
  let width = 0.0
  for code in codes:
    width := self + (font.glyph face code).advance * size
  return width

// `codes` in `material`, a font's distance field, from the pen at (x,
// baseline), `size` pixels an em; the font's material draws it as text.
// Sprites fill an array as long as the text, cut to the glyphs drawn.
func text (face: font.Font) => return func (codes: &[U32]) => return func (x: F32) => return func (baseline: F32) => return func (size: F32) => return func (color: math.Vec4) => return do:
  if codes.length == 0:
    return #[]
  let sprites = array.fill codes.length unwritten
  let drawn = 0
  let pen = x
  for code in codes:
    let glyph = font.glyph face code
    if glyph.width > 0.0:
      sprites[drawn] := $render.Sprite {
        x: pen + glyph.left * size, y: baseline + glyph.top * size,
        width: glyph.width * size, height: glyph.height * size,
        u0: glyph.u0, v0: glyph.v0, u1: glyph.u1, v1: glyph.v1,
        color, material: face.material, parameters: none,
      }
      drawn := self + 1
    pen := self + glyph.advance * size
  if drawn == codes.length:
    return sprites
  return array.slice 0 drawn sprites

// `codes` centred on `middle`.
func centred (face: font.Font) => return func (codes: &[U32]) => return func (middle: F32) => return func (baseline: F32) => return func (size: F32) => return func (color: math.Vec4) => return
  text face codes (middle - measure face codes size * 0.5) baseline size color

// A panel stretched over `rect` from a nine-slice region of `material`'s
// texture: the square of `side` texels at (u, v) in a texture `texels` wide
// and `rows` tall, whose corners of `corner` texels keep their size,
// `scale` screen pixels a texel.
type Slices is data = $Slices { u: F32, v: F32, side: F32, corner: F32, texels: F32, rows: F32 }

func panel (material: U32) => return func (slices: Slices) => return func (rect: Rect) => return func (scale: F32) => return func (color: math.Vec4) => return do:
  let c = slices.corner
  let s = slices.side
  let edge = c * scale
  let xs = #[rect.x, rect.x + edge, rect.x + rect.width - edge, rect.x + rect.width]
  let ys = #[rect.y, rect.y + edge, rect.y + rect.height - edge, rect.y + rect.height]
  let us = #[slices.u, slices.u + c, slices.u + s - c, slices.u + s]
  let vs = #[slices.v, slices.v + c, slices.v + s - c, slices.v + s]
  return array.generate 9 (func index => return do:
    let row = index / 3
    let column = index % 3
    return image material $Rect { x: xs[column], y: ys[row], width: xs[column + 1] - xs[column], height: ys[row + 1] - ys[row] }
      (us[column] / slices.texels) (vs[row] / slices.rows) (us[column + 1] / slices.texels) (vs[row + 1] / slices.rows) color)

// How many decimal digits `value` has.
func digit_count (value: U32) => return do:
  let count = 1
  let rest = value / 10
  for 0 .. 9:
    if rest > 0:
      count := self + 1
      rest := self / 10
  return count

// The decimal digits of `value`, counted and then written from the end.
func digits (value: U32) => return do:
  let count = digit_count value
  let found = array.fill count 48
  let left = value
  for back in 0 .. count:
    found[count - 1 - back] := 48 + left % 10
    left := self / 10
  return found

// `value` written short: as it is under a thousand, then in thousands and
// millions, with a tenth while under ten of them (776, 4.2k, 12k, 1.3M).
func short (value: U32) => return do:
  if value < 1000:
    return digits value
  let unit = 1000000
  let letter = 77
  if value < 1000000:
    unit := 1000
    letter := 107
  let whole = value / unit
  if whole >= 10:
    return array.push letter (digits whole)
  let tenth = (value % unit) / (unit / 10)
  return array.concat (digits whole) #[46, 48 + tenth, letter]

// Text with a soft shadow under it, down and to the right.
func shadowed (face: font.Font) => return func (codes: &[U32]) => return func (x: F32) => return func (baseline: F32) => return func (size: F32) => return func (color: math.Vec4) => return do:
  let offset = size * 0.06
  return array.concat
    (text face codes (x + offset) (baseline + offset * 1.4) size (math.vec4 0.0 0.0 0.0 (0.55 * color.w)))
    (text face codes x baseline size color)

// A small 3D view of `draws` in `rect`, as icons and previews are: seen from
// `eye`, looking along -z and `pitch` down, through a lens seeing `focal`
// (3 is narrow, without much perspective), lit as a studio would light it.
func icon (rect: Rect) => return func (eye: Vec3) => return func (pitch: F32) => return func (focal: F32) => return func (draws: &[render.Draw]) => return $render.Inset {
  x: rect.x, y: rect.y, width: rect.width, height: rect.height, pixel_size: 0.0, after_sprites: 0,
  view: math.Mat4.view eye (math.axis_angle math.right (-pitch)),
  projection: math.Mat4.perspective focal (rect.width / rect.height) 0.05 20.0,
  light: render.studio,
  draws,
}

// The whole of a `width` by `height` screen.
func screen (width: F32) => return func (height: F32) => return $Rect { x: 0.0, y: 0.0, width, height }

// A tile button in `rect`, as a tool on a bar is: a border lit by its state,
// most when `active`, less when `hovered`, a dark back, and `label` along its
// foot, all at `scale` (the screen's height over 720 lines). Its sprites, and
// the space above the label for a picture of what it does, such as an icon.
func tile (face: font.Font) => return func (fill_material: U32) => return func (rect: Rect) => return func (label: &[U32]) => return func (active: Bool) => return func (hovered: Bool) => return func (scale: F32) => return do:
  let edge = 3.0 * scale
  let border_color = math.vec4 0.6 0.66 0.74 0.35
  if hovered:
    border_color := math.vec4 0.8 0.84 0.9 0.6
  if active:
    border_color := math.vec4 1.0 0.82 0.38 0.95
  let border = image fill_material $Rect { x: rect.x - edge, y: rect.y - edge, width: rect.width + edge * 2.0, height: rect.height + edge * 2.0 } 0.0 0.0 1.0 1.0 border_color
  let back = image fill_material rect 0.0 0.0 1.0 1.0 (math.vec4 0.04 0.05 0.08 0.78)
  let word_color = math.vec4 0.9 0.92 0.95 1.0
  if active:
    word_color := math.vec4 1.0 0.86 0.5 1.0
  let words = centred face label (rect.x + rect.width * 0.5) (rect.y + rect.height - 9.0 * scale) (15.0 * scale)
    word_color
  let picture = $Rect { x: rect.x + 8.0 * scale, y: rect.y + 2.0 * scale, width: rect.width - 16.0 * scale, height: rect.height - 26.0 * scale }
  return (array.concat #[border, back] words, picture)

// Interface nodes: what assistive technology and the keyboard see of what a
// game draws. Each frame, a system declares a node for each thing of its
// interface it draws (`declare`), as it draws it, parents first: a menu's
// dialog, then its rows. A node's id comes from a stable key (`key`), never
// from the order things are drawn in, so hosts keep their own state for it
// (the browser's focus, a screen reader's place) from frame to frame
// (`node_id`). The
// host shows the nodes to assistive technology, and its actions come back as
// `#window.UiAction` events on a node's id, which a system handles by doing
// what clicking the thing does (`acted`, `action_on`). The keys reach a
// focused node as the same events (ui/tree).

// A node's id from a scope, one for each system that declares nodes (1 to
// 255), and a key within it (below 65536).
const node_id = tree.key

// Adds a node to this frame's interface.
const declare = tree.declare

// Moves the keyboard focus to a node, or with 0 out of the interface, and
// whether a node has it.
const focus = tree.focus
const focused = tree.focused
const enter_dialog = tree.enter
const leave_dialog = tree.leave

// Where a node that is not drawn lies: nowhere.
const nowhere = $Rect { x: 0.0, y: 0.0, width: 0.0, height: 0.0 }

// The UiState of a yes or no.
func state (on: Bool) => return do:
  if on:
    return vocabulary.state_true
  return vocabulary.state_false

func bits (actions: Array U32) => return do:
  let all = 0
  for action in actions:
    all := self | tree.bit action
  return all

// What a button takes: the focus, and pressing.
const pressable = bits #[vocabulary.action_focus, vocabulary.action_activate]
// What a slider or spin button takes: the focus, steps and a value.
const adjustable = bits #[vocabulary.action_focus, vocabulary.action_increment, vocabulary.action_decrement, vocabulary.action_set_value]
// What a text box takes: the focus.
const typable = bits #[vocabulary.action_focus]

// A node of `role` (vocabulary.role_*) with id `id` under node `parent` (0
// at the top), named `name`, over `rect` (`nowhere` when it is not drawn),
// in no state and taking no actions: the constructors below start from it.
// They build each node in as few constructions as they can (`built`):
// every field update rebuilds the whole record.
func built (role: U32) => return func (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (rect: Rect) => return func (focusable: Bool) => return func (actions: U32) => return $tree.Node {
  id, parent, role, name, description: &tree.no_text[0..0], value_text: &tree.no_text[0..0],
  x: rect.x, y: rect.y, width: rect.width, height: rect.height,
  focusable, focused: false, disabled: false, hidden: false, modal: false,
  checked: vocabulary.state_none, expanded: vocabulary.state_none, selected: vocabulary.state_none,
  live: vocabulary.live_off,
  value: 0.0, minimum: 0.0, maximum: 0.0, step: 0.0, actions,
}

func node (role: U32) => return func (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (rect: Rect) => return
  built role id parent name rect false 0

// A node the focus reaches, taking `actions`.
func operable (actions: U32) => return func (made: tree.Node) => return do:
  made.focusable := true
  made.actions := actions
  return made

// What holds other nodes: a group, a toolbar, a list.
const group_node = node vocabulary.role_group
const toolbar_node = node vocabulary.role_toolbar
const list_node = node vocabulary.role_list
const item_node = node vocabulary.role_listitem
const tablist_node = node vocabulary.role_tablist
const tabpanel_node = node vocabulary.role_tabpanel
// Words to read: plain text, a heading, a picture's name.
const text_node = node vocabulary.role_text
const heading_node = node vocabulary.role_heading
const image_node = node vocabulary.role_image

// A value assistive technology reads out as it changes, politely: a count
// on the screen, say. Its `value` is the words for its value.
func status_node (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (value: &[U32]) => return func (rect: Rect) => return do:
  let made = node vocabulary.role_status id parent name rect
  made.value_text := value
  made.live := vocabulary.live_polite
  return made

// A text box holding `text`, which takes the keys while it has the focus:
// its system types into it (`Line`, ui/tree).
func textbox_node (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (text: &[U32]) => return func (rect: Rect) => return do:
  let made = built vocabulary.role_textbox id parent name rect true typable
  made.value_text := text
  return made

// A log: messages, its children (text nodes), whose newest assistive
// technology may read out as they come.
func log_node (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (rect: Rect) => return do:
  let made = node vocabulary.role_log id parent name rect
  made.live := vocabulary.live_polite
  return made

// A dialog; a `modal` one keeps the focus while it is open, and assistive
// technology sees nothing else.
func dialog_node (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (modal: Bool) => return func (rect: Rect) => return do:
  let made = node vocabulary.role_dialog id parent name rect
  made.modal := modal
  return made

// Something to press.
func button_node (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (rect: Rect) => return
  built vocabulary.role_button id parent name rect true pressable

// A button that stays pressed while `on`, as a tool on a bar does.
func toggle_node (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (on: Bool) => return func (rect: Rect) => return do:
  let made = button_node id parent name rect
  made.checked := state on
  return made

// A switch, on or off.
func switch_node (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (on: Bool) => return func (rect: Rect) => return do:
  let made = built vocabulary.role_switch id parent name rect true pressable
  made.checked := state on
  return made

// A tab of a tab list, `chosen` when its page shows.
func tab_node (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (chosen: Bool) => return func (rect: Rect) => return do:
  let made = built vocabulary.role_tab id parent name rect true pressable
  made.selected := state chosen
  return made

// A value in a range from `low` to `high` in steps of `size`, which `words`
// say: a slider's (`role` vocabulary.role_slider) or a spin button's.
func ranged (role: U32) => return func (id: U32) => return func (parent: U32) => return func (name: &[U32]) => return func (value: F32) => return func (low: F32) => return func (high: F32) => return func (size: F32) => return func (words: &[U32]) => return func (rect: Rect) => return $tree.Node {
  id, parent, role, name, description: &tree.no_text[0..0], value_text: words,
  x: rect.x, y: rect.y, width: rect.width, height: rect.height,
  focusable: true, focused: false, disabled: false, hidden: false, modal: false,
  checked: vocabulary.state_none, expanded: vocabulary.state_none, selected: vocabulary.state_none,
  live: vocabulary.live_off,
  value, minimum: low, maximum: high, step: size, actions: adjustable,
}

const slider_node = ranged vocabulary.role_slider
const spin_node = ranged vocabulary.role_spinbutton

// `made` with a description: more about it, read after its name.
func described (description: &[U32]) => return func (made: tree.Node) => return do:
  made.description := description
  return made

// `made` with the words for its value.
func valued (words: &[U32]) => return func (made: tree.Node) => return do:
  made.value_text := words
  return made

// `made`, which opens and closes, open or not.
func expandable (open: Bool) => return func (made: tree.Node) => return do:
  made.expanded := state open
  made.actions := self | tree.bit vocabulary.action_expand | tree.bit vocabulary.action_collapse
  return made

// Inert semantic subtrees remain drawn by the caller, but are unavailable to
// keyboard and assistive technology. Their pointer handlers must use the same
// dialog policy; drawing itself never grants permission to interact.
func inert_when (inert: Bool) -> (made: tree.Node) => return do:
  made.hidden := inert
  return made

// `made`, unusable while `off`.
func disabled_when (off: Bool) => return func (made: tree.Node) => return do:
  made.disabled := off
  return made

// `made`, read out as it changes.
func live (made: tree.Node) => return do:
  made.live := vocabulary.live_polite
  return made

// A menu's `control` as a node: a button, a switch for a toggle, a slider,
// or a spin button through a choice's options, its value in `words` (what
// the row shows).
func control_node (id: U32) => return func (parent: U32) => return func (control: Control) => return func (words: &[U32]) => return func (rect: Rect) => return case control of
  $Button { label } => button_node id parent label rect
  $Toggle { label, on } => switch_node id parent label on rect
  $Slider { label, value, low, high, step: size } => slider_node id parent label value low high size words rect
  $Choice { label, options, chosen } => do:
    if options.length == 0:
      break disabled_when true (spin_node id parent label 0.0 0.0 0.0 1.0 (&tree.no_text[0..0]) rect)
    let current = min chosen (options.length - 1)
    break spin_node id parent label (U32.to_f32 current) 0.0 (U32.to_f32 options.length - 1.0) 1.0 options[current] rect

func set (control: Control) => return func (value: F32) => return do:
  if Bool.not (is_finite value):
    return control
  return case control of
    $Toggle { label } => $Toggle { label, on: value >= 0.5 }
    $Slider { label, low, high, step: size } =>
      $Slider { label, value: slider_value low high size value, low, high, step: size }
    $Choice { label, options } => do:
      if options.length == 0:
        break $Choice { label, options, chosen: 0 }
      break $Choice { label, options, chosen: F32.to_u32 (clamp 0.0 (U32.to_f32 options.length - 1.0) (floor (value + 0.5))) }
    $Button _ => control

// What UiAction `action` (with `value`) on control `index` of `controls`
// does, as `key` has the keys do: focus moves to it, activate presses a
// button and steps anything else, increment and decrement step it, and
// set_value sets it.
func acted (controls: Array Control) => return func (index: U32) => return func (action: U32) => return func (value: F32) => return do:
  if index >= controls.length:
    return $Ignored
  let control = controls[index]
  if action == vocabulary.action_focus:
    return $Moved index
  if action == vocabulary.action_activate:
    return case control of
      $Button _ => $Pressed index
      _ => $Changed { index, control: step control 1.0 }
  let stepping = action == vocabulary.action_increment or action == vocabulary.action_decrement
  let direction = -1.0
  if action == vocabulary.action_increment:
    direction := 1.0
  return case control of
    $Button _ => $Ignored
    _ if stepping => $Changed { index, control: step control direction }
    _ if action == vocabulary.action_set_value => $Changed { index, control: set control value }
    _ => $Ignored

// The action, and its value, UiAction `event` takes on node `id`, if it is
// one.
func action_on (id: U32) => return func (event: window.Event) => return case event of
  $window.UiAction { node: target, action, value } if target == id => $Some (action, value)
  _ => $Nothing

// The smallest rectangle round `a` and `b`.
func union (a: Rect) => return func (b: Rect) => return do:
  let left = min a.x b.x
  let top = min a.y b.y
  return $Rect { x: left, y: top, width: max (a.x + a.width) (b.x + b.width) - left, height: max (a.y + a.height) (b.y + b.height) - top }

// Normalize a finite nonnegative magnitude for safe U32 digit conversion.
// Magnitudes at least four billion use a mantissa and decimal exponent.
func decimal_magnitude (value: F32) => return do:
  let size = value
  let exponent = 0
  if size >= 4000000000.0:
    for 0 .. 39:
      if size >= 10.0:
        size := self / 10.0
        exponent := self + 1
  return (size, exponent)

// Shared trimmed/padded decimal rendering. Work and fractional output are
// bounded by six places; split the whole part before scaling the fraction.
// Every part is measured first and written into one exactly sized array.
func formatted (value: F32) => return func (places: U32) => return func (padded: Bool) => return do:
  if Bool.not (is_finite value):
    if value != value:
      return #[78, 97, 78]
    if value < 0.0:
      return #[45, 73, 110, 102, 105, 110, 105, 116, 121]
    return #[73, 110, 102, 105, 110, 105, 116, 121]
  let count = min places 6
  let (size, written_exponent) = decimal_magnitude (abs value)
  let exponent = written_exponent
  let scale = 1.0
  for 0 .. count:
    scale := self * 10.0
  let integral = floor size
  let whole = F32.to_u32 integral
  let unit = F32.to_u32 scale
  let fraction = F32.to_u32 (floor ((size - integral) * scale + 0.5))
  if fraction >= unit:
    whole := self + 1
    fraction := 0
    if exponent > 0 and whole == 10:
      whole := 1
      exponent := self + 1
  // The sign, the whole digits, the fraction as `count` digits (trailing
  // zeros trimmed unless padded) and the exponent.
  let sign = 0
  if value < 0.0 and (whole > 0 or fraction > 0):
    sign := 1
  let whole_count = digit_count whole
  let shown = 0
  let kept = fraction
  if count > 0 and (padded or fraction > 0):
    shown := count
    if Bool.not padded:
      let trimming = true
      for 0 .. count:
        if trimming and kept % 10 == 0:
          kept := self / 10
          shown := self - 1
        else:
          trimming := false
  let point_at = sign + whole_count
  let exponent_at = point_at
  if shown > 0:
    exponent_at := self + 1 + shown
  let exponent_count = 0
  if exponent > 0:
    exponent_count := digit_count exponent
  let length = exponent_at
  if exponent > 0:
    length := self + 1 + exponent_count
  let out = array.fill length 45
  let left = whole
  for back in 0 .. whole_count:
    out[point_at - 1 - back] := 48 + left % 10
    left := self / 10
  if shown > 0:
    out[point_at] := 46
    let decimals = kept
    for back in 0 .. shown:
      out[exponent_at - 1 - back] := 48 + decimals % 10
      decimals := self / 10
  if exponent > 0:
    out[exponent_at] := 101
    let power = exponent
    for back in 0 .. exponent_count:
      out[length - 1 - back] := 48 + power % 10
      power := self / 10
  return out

// `value` with at most min(places, 6) decimals. Large values use scientific
// notation; nonfinite values are NaN, Infinity or -Infinity.
func decimal (value: F32) => return func (places: U32) => return formatted value places false

const store_text = tree.store_text
const declare_owned = tree.declare_owned
