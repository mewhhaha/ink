import { Vec2 } from "std/vector"

// Tile maps for 2D games: tile lookup by position and a box that slides
// through them, so a platformer's movement is a few lines.
//
// A map is its tile ids row by row from the bottom, plus caller-defined flags
// for each tile id. Cell (0, 0) is the bottom left cell of the map, whose
// corner sits at `origin`.

const solid: U32 = 1
const oneway: U32 = 2
const ladder: U32 = 4
const hazard: U32 = 8

type Grid is data = $Grid { width: U32, height: U32, cell: Vec2, origin: Vec2, tiles: #[U32], flags: #[U32] }

func grid (width: U32) -> (height: U32) -> (cell: Vec2) -> (origin: Vec2) -> (tiles: own #[U32]) -> (flags: own #[U32]) : Grid => return
  $Grid { width, height, cell, origin, tiles, flags }

// The tile id in a cell (given as whole-number floats); 0 outside the map.
func tile_at (g: Grid) => func (cx: F32) => func (cy: F32) =>
  let $Grid { width, height, tiles } = g
  if cx < 0.0 or cy < 0.0 or cx >= U32.to_f32 width or cy >= U32.to_f32 height:
    return 0
  let index = F32.to_u32 cy * width + F32.to_u32 cx
  if index >= tiles.length:
    return 0
  return tiles[index]

func flags_of (g: Grid) => func (id: U32) =>
  let $Grid { flags } = g
  if id >= flags.length:
    return 0
  return flags[id]

// The flags of the tile in a cell.
func flags_at (g: Grid) => func (cx: F32) => func (cy: F32) => flags_of g (tile_at g cx cy)

// The cell containing a world position, as whole-number floats.
func cell_of (g: Grid) => func (p: Vec2) =>
  let $Grid { cell, origin } = g
  return $Vec2 { x: floor ((p.x - origin.x) / cell.x), y: floor ((p.y - origin.y) / cell.y) }

// The centre of a cell in world space.
func centre_of (g: Grid) => func (cx: F32) => func (cy: F32) =>
  let $Grid { cell, origin } = g
  return $Vec2 { x: origin.x + (cx + 0.5) * cell.x, y: origin.y + (cy + 0.5) * cell.y }

// Whether any tile with one of `mask`'s flags overlaps the box from (lx, ly)
// to (hx, hy). Callers pass scalars, so no corner records are built.
func covers (g: Grid) => func (mask: U32) => func (lx: F32) => func (ly: F32) => func (hx: F32) => func (hy: F32) =>
  let $Grid { width, height, cell, origin } = g
  let x1 = floor ((hx - origin.x) / cell.x)
  let y1 = floor ((hy - origin.y) / cell.y)
  if x1 < 0.0 or y1 < 0.0:
    return false
  let x0 = F32.to_u32 (max 0.0 (floor ((lx - origin.x) / cell.x)))
  let y0 = F32.to_u32 (max 0.0 (floor ((ly - origin.y) / cell.y)))
  let last_x = min (width - 1) (F32.to_u32 x1)
  let last_y = min (height - 1) (F32.to_u32 y1)
  for cy in y0..(last_y + 1):
    for cx in x0..(last_x + 1):
      let found = (flags_at g (U32.to_f32 cx) (U32.to_f32 cy) & mask) != 0
      if found:
        return true
  return false

// Whether any tile with one of `mask`'s flags overlaps the box from `low` to `high`.
func any_flag (g: Grid) => func (mask: U32) => func (low: Vec2) => func (high: Vec2) => return
  covers g mask low.x low.y high.x high.y

// Whether the point is inside a tile with one of `mask`'s flags.
func point_has (g: Grid) => func (mask: U32) => func (p: Vec2) =>
  let c = cell_of g p
  return (flags_at g c.x c.y & mask) != 0

// Whether a box centred at `centre` with half size `half` touches such a tile.
func touches (g: Grid) => func (mask: U32) => func (centre: Vec2) => func (half: Vec2) => return
  covers g mask (centre.x - half.x) (centre.y - half.y) (centre.x + half.x) (centre.y + half.y)

// What happened to a box: where it ended up, its velocity with motion into
// tiles removed, whether it stands on something, and which way it hit a wall
// (-1, 0, 1) or its head.
type Slide is data = $Slide { pos: Vec2, vel: Vec2, grounded: Bool, wall: F32, head: Bool }

// Move a box (centre `pos`, half size `half`) by `vel * dt` through the map:
// solid tiles stop it on both axes; one-way tiles hold it up only when it
// falls onto them from above (unless `drop` is set). Steps should stay
// shorter than a tile, which holds for any sane speed at game tick rates.
func slide (g: Grid) => func (half: Vec2) => func (drop: Bool) => func (pos: Vec2) => func (vel: Vec2) => func (dt: F32) =>
  let $Grid { cell, origin } = g
  let gap = 0.001
  let at = pos
  let v = vel
  let wall = 0.0
  // Horizontal: stop at the first solid column.
  at.x := pos.x + vel.x * dt
  if vel.x != 0.0:
    if covers g solid (at.x - half.x) (pos.y - half.y + gap) (at.x + half.x) (pos.y + half.y - gap):
      if vel.x > 0.0:
        let column = floor ((at.x + half.x - origin.x) / cell.x)
        at.x := origin.x + column * cell.x - half.x - gap
        wall := 1.0
      else:
        let column = floor ((at.x - half.x - origin.x) / cell.x)
        at.x := origin.x + (column + 1.0) * cell.x + half.x + gap
        wall := (-1.0)
      v.x := 0.0
  // Vertical: land on tops, bump heads on undersides.
  at.y := pos.y + vel.y * dt
  let grounded = false
  let head = false
  let left = at.x - half.x + gap
  let right = at.x + half.x - gap
  if vel.y <= 0.0:
    let feet = at.y - half.y
    let row = floor ((feet - origin.y) / cell.y)
    let top = origin.y + (row + 1.0) * cell.y
    let was = pos.y - half.y
    let on_solid = covers g solid left feet right (pos.y + half.y - gap)
    let on_oneway = not drop and was >= top - 0.02 and covers g oneway left (top - gap) right (top - gap)
    if on_solid or on_oneway:
      at.y := top + half.y
      v.y := 0.0
      grounded := true
  else:
    let ceiling = at.y + half.y
    if covers g solid left (pos.y - half.y + gap) right ceiling:
      let row = floor ((ceiling - origin.y) / cell.y)
      at.y := origin.y + row * cell.y - half.y - gap
      v.y := 0.0
      head := true
  return $Slide { pos: at, vel: v, grounded, wall, head }
