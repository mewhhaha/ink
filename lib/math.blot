import { Vec2, Vec3 } from "std/vector"

// Ink's small geometry vocabulary. Vec2 and Vec3 come from std/vector with
// their operators; Vec4, Quat, Color and Ray are Ink's. Quaternions are
// [x, y, z, w] with w the scalar part.
type Vec4 is data = #Vec4 { x: F32, y: F32, z: F32, w: F32 }
type Quat is data = #Quat { x: F32, y: F32, z: F32, w: F32 }
type Color is data = #Color { r: F32, g: F32, b: F32, a: F32 }
type Ray is data = #Ray { origin: Vec3, direction: Vec3 }

const vec2 = fn (x: F32) => fn (y: F32) => #Vec2 { x, y }
const vec3 = fn (x: F32) => fn (y: F32) => fn (z: F32) => #Vec3 { x, y, z }
const vec4 = fn (x: F32) => fn (y: F32) => fn (z: F32) => fn (w: F32) => #Vec4 { x, y, z, w }
const rgba = fn (r: F32) => fn (g: F32) => fn (b: F32) => fn (a: F32) => #Color { r, g, b, a }
const rgb = fn (r: F32) => fn (g: F32) => fn (b: F32) => #Color { r, g, b, a: 1.0 }

const zero2 = #Vec2 { x: 0.0, y: 0.0 }
const zero3 = #Vec3 { x: 0.0, y: 0.0, z: 0.0 }
const one3 = #Vec3 { x: 1.0, y: 1.0, z: 1.0 }
const right = #Vec3 { x: 1.0, y: 0.0, z: 0.0 }
const up = #Vec3 { x: 0.0, y: 1.0, z: 0.0 }
// Forward is -Z in a right-handed coordinate system.
const forward = #Vec3 { x: 0.0, y: 0.0, z: (-1.0) }
const identity_quat = #Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }

const Vec4.add: Vec4 -> Vec4 -> Vec4 = fn a => fn b =>
  #Vec4 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z, w: a.w + b.w }
const Vec4.sub: Vec4 -> Vec4 -> Vec4 = fn a => fn b =>
  #Vec4 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z, w: a.w - b.w }
const Vec4.mul: Vec4 -> F32 -> Vec4 = fn value => fn scale =>
  #Vec4 { x: value.x * scale, y: value.y * scale, z: value.z * scale, w: value.w * scale }
const Vec4.dot: Vec4 -> Vec4 -> F32 = fn a => fn b =>
  a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w

const Color.mul: Color -> F32 -> Color = fn value => fn scale =>
  #Color { r: value.r * scale, g: value.g * scale, b: value.b * scale, a: value.a }
const Color.lerp: Color -> Color -> F32 -> Color = fn a => fn b => fn t => #Color {
  r: F32.lerp a.r b.r t,
  g: F32.lerp a.g b.g t,
  b: F32.lerp a.b b.b t,
  a: F32.lerp a.a b.a t,
}

// Hamilton product: `a * b` rotates by b, then by a.
//
// Kernels here take scalar parts: a record built in a function body is boxed
// whenever it is passed to, or returned from, a call that is not inlined.
// Inside loops, bodies of up to 64 nodes with aggregate results inline; the
// small kernels destructure their inputs, avoid `&&`/`||` and build fresh
// results on every path so that they qualify. Each formula keeps the
// operation order of the vector expression it replaces, so results match.
private const hamilton = fn (ax: F32) => fn (ay: F32) => fn (az: F32) => fn (aw: F32) => fn (bx: F32) => fn (by: F32) => fn (bz: F32) => fn (bw: F32) => #Quat {
  x: aw * bx + ax * bw + ay * bz - az * by,
  y: aw * by - ax * bz + ay * bw + az * bx,
  z: aw * bz + ax * by - ay * bx + az * bw,
  w: aw * bw - ax * bx - ay * by - az * bz,
}
const Quat.mul: Quat -> Quat -> Quat = fn a => fn b => hamilton a.x a.y a.z a.w b.x b.y b.z b.w
const Quat.dot: Quat -> Quat -> F32 = fn a => fn b =>
  a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
const Quat.conjugate = fn (q: Quat) => #Quat { x: F32.neg q.x, y: F32.neg q.y, z: F32.neg q.z, w: q.w }
const finite3 = fn (v: Vec3) => is_finite v.x && is_finite v.y && is_finite v.z
const finite_quat = fn (q: Quat) => is_finite q.x && is_finite q.y && is_finite q.z && is_finite q.w
private const unit_quat_scaled = fn (x: F32) => fn (y: F32) => fn (z: F32) => fn (w: F32) => do:
  let scale = max (max (abs x) (abs y)) (max (abs z) (abs w))
  if scale == 0.0:
    return #Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
  let sx = x / scale
  let sy = y / scale
  let sz = z / scale
  let sw = w / scale
  let length = sqrt (sx * sx + sy * sy + sz * sz + sw * sw)
  return #Quat { x: sx / length, y: sy / length, z: sz / length, w: sw / length }
// Finite-only normalization of quaternion parts. Zero is the identity;
// scaling avoids overflow. The common case is small enough to inline.
const unit_quat = fn (x: F32) => fn (y: F32) => fn (z: F32) => fn (w: F32) => do:
  let squared = x * x + y * y + z * z + w * w
  // A subnormal squared magnitude has too few significant bits for a unit
  // result. Scale it first, just as for underflow and overflow.
  if squared >= 1.17549435e-38:
    if is_finite squared:
      let ordinary = sqrt squared
      return #Quat { x: x / ordinary, y: y / ordinary, z: z / ordinary, w: w / ordinary }
  // Rebuilt so that both paths give a fresh record.
  let #Quat { x: a, y: b, z: c, w: d } = unit_quat_scaled x y z w
  return #Quat { x: a, y: b, z: c, w: d }
const Quat.normalized = fn (q: Quat) => unit_quat q.x q.y q.z q.w
// The largest coordinate magnitude of a finite vector, the divisor that keeps
// its normalization from overflowing; zero for zero or nonfinite vectors.
private const unit_scale = fn (x: F32) => fn (y: F32) => fn (z: F32) => do:
  if Bool.not (is_finite x && is_finite y && is_finite z):
    return 0.0
  return max (max (abs x) (abs y)) (abs z)
// Checked vector normalization rejects zero and nonfinite inputs.
const normalize3 = fn (v: Vec3) -> Maybe Vec3 => do:
  let #Vec3 { x, y, z } = v
  let scale = unit_scale x y z
  if scale == 0.0:
    return #Nothing
  let sx = x / scale
  let sy = y / scale
  let sz = z / scale
  let length = sqrt (sx * sx + sy * sy + sz * sz)
  return #Some (#Vec3 { x: sx / length, y: sy / length, z: sz / length })
const normalize_quat = fn (q: Quat) -> Maybe Quat => do:
  if Bool.not (finite_quat q) || q.x == 0.0 && q.y == 0.0 && q.z == 0.0 && q.w == 0.0:
    return #Nothing
  return #Some (Quat.normalized q)

private const cross_parts = fn (ux: F32) => fn (uy: F32) => fn (uz: F32) => fn (vx: F32) => fn (vy: F32) => fn (vz: F32) =>
  (uy * vz - uz * vy, uz * vx - ux * vz, ux * vy - uy * vx)
// Rotate a vector: q v q*, as v + t w + u × t with u = q.xyz and t = 2 (u × v).
const rotate_parts = fn (qx: F32) => fn (qy: F32) => fn (qz: F32) => fn (qw: F32) => fn (vx: F32) => fn (vy: F32) => fn (vz: F32) => do:
  let (cx, cy, cz) = cross_parts qx qy qz vx vy vz
  let tx = cx * 2.0
  let ty = cy * 2.0
  let tz = cz * 2.0
  let (ex, ey, ez) = cross_parts qx qy qz tx ty tz
  return #Vec3 { x: vx + tx * qw + ex, y: vy + ty * qw + ey, z: vz + tz * qw + ez }
const Quat.rotate = fn (q: Quat) => fn (v: Vec3) => rotate_parts q.x q.y q.z q.w v.x v.y v.z

// Normalized linear interpolation along the shorter arc, of quaternion parts.
const nlerp_parts = fn (ax: F32) => fn (ay: F32) => fn (az: F32) => fn (aw: F32) => fn (bx: F32) => fn (by: F32) => fn (bz: F32) => fn (bw: F32) => fn (t: F32) => do:
  let sign = 1.0
  if ax * bx + ay * by + az * bz + aw * bw < 0.0:
    sign := (-1.0)
  return unit_quat (F32.lerp ax (bx * sign) t) (F32.lerp ay (by * sign) t) (F32.lerp az (bz * sign) t) (F32.lerp aw (bw * sign) t)
const Quat.nlerp = fn (a: Quat) => fn (b: Quat) => fn (t: F32) => nlerp_parts a.x a.y a.z a.w b.x b.y b.z b.w t

// Constant angular speed along the shorter arc. Nearly equal rotations, where
// the arc's sine loses precision, fall back to nlerp.
const Quat.slerp = fn (a: Quat) => fn (b: Quat) => fn (t: F32) => do:
  let d = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
  let sign = 1.0
  if d < 0.0:
    sign := (-1.0)
    d := 0.0 - d
  if d > 0.9995:
    return Quat.nlerp a b t
  let angle = atan2 (sqrt (max 0.0 (1.0 - d * d))) d
  let s = sin angle
  let wa = sin ((1.0 - t) * angle) / s
  let wb = sin (t * angle) / s * sign
  return unit_quat (a.x * wa + b.x * wb) (a.y * wa + b.y * wb) (a.z * wa + b.z * wb) (a.w * wa + b.w * wb)

// Rotations tween by slerp; see tween.blot.
const Quat.lerp = fn (a: Quat) => fn (b: Quat) => fn (t: F32) => Quat.slerp a b t

// Normalizes the axis exactly as normalize3 does.
const axis_angle = fn (axis: Vec3) => fn (angle: F32) => do:
  let #Vec3 { x, y, z } = axis
  let scale = unit_scale x y z
  if scale == 0.0:
    return #Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
  let sx = x / scale
  let sy = y / scale
  let sz = z / scale
  let length = sqrt (sx * sx + sy * sy + sz * sz)
  let half = angle * 0.5
  let s = sin half
  return #Quat { x: sx / length * s, y: sy / length * s, z: sz / length * s, w: cos half }

// Yaw about +Y, then pitch about the yawed +X: a first-person look. This is
// axis_angle up yaw * axis_angle right pitch with the unit axes written in.
const yaw_pitch = fn (yaw: F32) => fn (pitch: F32) => do:
  let ys = sin (yaw * 0.5)
  let ps = sin (pitch * 0.5)
  return hamilton (0.0 * ys) (1.0 * ys) (0.0 * ys) (cos (yaw * 0.5)) (1.0 * ps) (0.0 * ps) (0.0 * ps) (cos (pitch * 0.5))

const Quat.forward = fn (q: Quat) => rotate_parts q.x q.y q.z q.w 0.0 0.0 (-1.0)
const Quat.right = fn (q: Quat) => rotate_parts q.x q.y q.z q.w 1.0 0.0 0.0
const Quat.up = fn (q: Quat) => rotate_parts q.x q.y q.z q.w 0.0 1.0 0.0

// The point a ray reaches after `distance`.
const Ray.at = fn (ray: Ray) => fn (distance: F32) => do:
  let #Ray { origin: o, direction: d } = ray
  return #Vec3 { x: o.x + d.x * distance, y: o.y + d.y * distance, z: o.z + d.z * distance }

// Distance along the ray to the plane with `normal` through `point`, if the
// ray hits its front within reach.
const Ray.plane = fn (ray: Ray) => fn (normal: Vec3) => fn (point: Vec3) => do:
  let #Ray { origin: o, direction: d } = ray
  if Bool.not (finite3 o && finite3 d && finite3 normal && finite3 point):
    return #Nothing
  let #Vec3 { x: nx, y: ny, z: nz } = normal
  let facing = nx * d.x + ny * d.y + nz * d.z
  if abs facing < 0.000001 || Bool.not (is_finite facing):
    return #Nothing
  let distance = (nx * (point.x - o.x) + ny * (point.y - o.y) + nz * (point.z - o.z)) / facing
  if distance >= 0.0 && is_finite distance:
    return #Some distance
  return #Nothing

const approach = fn (target: F32) => fn (rate: F32) => fn (value: F32) => do:
  if value < target:
    return min target (value + rate)
  return max target (value - rate)

// The rotation of something at `eye` looking along `forward` (cameras look
// down their local -Z), keeping `up` up. From the rotation matrix whose
// columns are right, up and back, by Shepperd's method. Both directions are
// normalized as normalize3 does; a rejected hint counts as zero.
const look_rotation = fn (forward: Vec3) => fn (up_hint: Vec3) => do:
  let fscale = unit_scale forward.x forward.y forward.z
  if fscale == 0.0:
    return identity_quat
  let fx = forward.x / fscale
  let fy = forward.y / fscale
  let fz = forward.z / fscale
  let flength = sqrt (fx * fx + fy * fy + fz * fz)
  fx := self / flength
  fy := self / flength
  fz := self / flength
  let hx = 0.0
  let hy = 0.0
  let hz = 0.0
  let hscale = unit_scale up_hint.x up_hint.y up_hint.z
  if hscale != 0.0:
    let sx = up_hint.x / hscale
    let sy = up_hint.y / hscale
    let sz = up_hint.z / hscale
    let hlength = sqrt (sx * sx + sy * sy + sz * sz)
    hx := sx / hlength
    hy := sy / hlength
    hz := sz / hlength
  // r0 = f × hint
  let rx = fy * hz - fz * hy
  let ry = fz * hx - fx * hz
  let rz = fx * hy - fy * hx
  if rx * rx + ry * ry + rz * rz < 0.000001:
    hx := 0.0
    hy := 1.0
    hz := 0.0
    if abs fy > 0.9:
      hx := 1.0
      hy := 0.0
    rx := fy * hz - fz * hy
    ry := fz * hx - fx * hz
    rz := fx * hy - fy * hx
  // r = r0.normalized, which keeps a zero vector
  let rlength = sqrt (rx * rx + ry * ry + rz * rz)
  if rlength != 0.0:
    rx := self / rlength
    ry := self / rlength
    rz := self / rlength
  // u = r × f, b = -f
  let ux = ry * fz - rz * fy
  let uy = rz * fx - rx * fz
  let uz = rx * fy - ry * fx
  let bx = fx * (-1.0)
  let by = fy * (-1.0)
  let bz = fz * (-1.0)
  let trace = rx + uy + bz
  if trace > 0.0:
    let s = sqrt (trace + 1.0) * 2.0
    return #Quat { x: (uz - by) / s, y: (bx - rz) / s, z: (ry - ux) / s, w: 0.25 * s }
  if rx > uy && rx > bz:
    let s = sqrt (1.0 + rx - uy - bz) * 2.0
    return #Quat { x: 0.25 * s, y: (ux + ry) / s, z: (bx + rz) / s, w: (uz - by) / s }
  if uy > bz:
    let s = sqrt (1.0 + uy - rx - bz) * 2.0
    return #Quat { x: (ux + ry) / s, y: 0.25 * s, z: (by + uz) / s, w: (bx - rz) / s }
  let s = sqrt (1.0 + bz - rx - uy) * 2.0
  return #Quat { x: (bx + rz) / s, y: (by + uz) / s, z: 0.25 * s, w: (ry - ux) / s }

// A rotation about +Y that turns -Z toward `direction` on the ground plane.
const facing = fn (direction: Vec3) => look_rotation (#Vec3 { x: direction.x, y: 0.0, z: direction.z }) up

// Keep only the horizontal part of a vector.
const flat = fn (v: Vec3) => #Vec3 { x: v.x, y: 0.0, z: v.z }

// Column-major matrices, axes and ray geometry.
type Basis is data = #Basis { x: Vec3, y: Vec3, z: Vec3 }
// Column-major, matching the renderer's WGSL uniforms: `x`..`w` are columns.
type Mat4 is data = #Mat4 { x: Vec4, y: Vec4, z: Vec4, w: Vec4 }
type Axis is data = #X | #Y | #Z

const back = vec3 0.0 0.0 1.0
const half_pi = pi * 0.5
const Quat.identity = identity_quat
const Quat.from_axis_angle = axis_angle

const unlerp = fn (low: F32) => fn (high: F32) => fn (value: F32) => (value - low) / (high - low)

const Axis.unit = fn (axis: Axis) => case axis of
  #X => right
  #Y => up
  #Z => back

// The coordinate of `vector` along `axis`.
const Axis.coordinate = fn (axis: Axis) => fn (vector: Vec3) => case axis of
  #X => vector.x
  #Y => vector.y
  #Z => vector.z

// `vector` with its coordinate along `axis` replaced by `value`.
const Axis.with = fn (axis: Axis) => fn (vector: Vec3) => fn (value: F32) => case axis of
  #X => vec3 value vector.y vector.z
  #Y => vec3 vector.x value vector.z
  #Z => vec3 vector.x vector.y value

// The axis `vector` points along most.
const Axis.dominant = fn (vector: Vec3) => do:
  let ax = abs vector.x
  let ay = abs vector.y
  let az = abs vector.z
  if ax >= ay:
    if ax >= az:
      return #X
    return #Z
  if ay >= az:
    return #Y
  return #Z

const Axis.index = fn (axis: Axis) => case axis of
  #X => 0
  #Y => 1
  #Z => 2

const Axis.from_index = fn (index: U32) => case index of
  0 => #X
  1 => #Y
  _ => #Z

// Shortest rotation taking unit vector `source` onto unit vector `target`.
const Quat.from_to = fn (source: Vec3) => fn (target: Vec3) => do:
  let #Vec3 { x: sx, y: sy, z: sz } = source
  let #Vec3 { x: tx, y: ty, z: tz } = target
  let d = sx * tx + sy * ty + sz * tz
  if d < -0.999999:
    // (source × fallback).normalized, falling back on up or right.
    let fx = 0.0
    let fy = 1.0
    let fz = 0.0
    if abs sx < 0.9:
      fx := 1.0
      fy := 0.0
    let cx = sy * fz - sz * fy
    let cy = sz * fx - sx * fz
    let cz = sx * fy - sy * fx
    let length = sqrt (cx * cx + cy * cy + cz * cz)
    if length == 0.0:
      return #Quat { x: cx, y: cy, z: cz, w: 0.0 }
    return #Quat { x: cx / length, y: cy / length, z: cz / length, w: 0.0 }
  return unit_quat (sy * tz - sz * ty) (sz * tx - sx * tz) (sx * ty - sy * tx) (1.0 + d)

// Rotation about unit `axis` taking unit `source` onto unit `target`, both
// perpendicular to it; opposite vectors turn half a revolution about `axis`.
const Quat.about = fn (axis: Vec3) => fn (source: Vec3) => fn (target: Vec3) => do:
  let #Vec3 { x: sx, y: sy, z: sz } = source
  let #Vec3 { x: tx, y: ty, z: tz } = target
  let cosine = sx * tx + sy * ty + sz * tz
  if cosine < -0.999999:
    let #Vec3 { x, y, z } = axis
    return #Quat { x, y, z, w: 0.0 }
  return unit_quat (sy * tz - sz * ty) (sz * tx - sx * tz) (sx * ty - sy * tx) (1.0 + cosine)

// A turn of `angle` about the vertical. A quarter turn takes +x to -z, and
// so a model's +z front to +x.
const Quat.yaw = fn (angle: F32) => axis_angle up angle

// The turn about the vertical that faces -z the way `rotation` faces, level:
// what is left of it with its pitch and roll taken off.
const Quat.heading = fn (rotation: Quat) => do:
  let forward = Quat.forward rotation
  return atan2 (-forward.x) (-forward.z)

const Quat.basis = fn (rotation: Quat) => do:
  let #Quat { x, y, z, w } = Quat.normalized rotation
  let x2 = x + x
  let y2 = y + y
  let z2 = z + z
  let xx = x * x2
  let xy = x * y2
  let xz = x * z2
  let yy = y * y2
  let yz = y * z2
  let zz = z * z2
  let wx = w * x2
  let wy = w * y2
  let wz = w * z2
  return #Basis {
    x: #Vec3 { x: 1.0 - yy - zz, y: xy + wz, z: xz - wy },
    y: #Vec3 { x: xy - wz, y: 1.0 - xx - zz, z: yz + wx },
    z: #Vec3 { x: xz + wy, y: yz - wx, z: 1.0 - xx - yy },
  }

const Mat4.identity = #Mat4 {
  x: #Vec4 { x: 1.0, y: 0.0, z: 0.0, w: 0.0 },
  y: #Vec4 { x: 0.0, y: 1.0, z: 0.0, w: 0.0 },
  z: #Vec4 { x: 0.0, y: 0.0, z: 1.0, w: 0.0 },
  w: #Vec4 { x: 0.0, y: 0.0, z: 0.0, w: 1.0 },
}

// Model matrix: scale, then rotation, then translation. Composed directly,
// since it runs per rendered entity.
const Mat4.compose = fn (position: Vec3) => fn (rotation: Quat) => fn (scale: Vec3) => do:
  let #Quat { x, y, z, w } = Quat.normalized rotation
  let x2 = x + x
  let y2 = y + y
  let z2 = z + z
  let xx = x * x2
  let xy = x * y2
  let xz = x * z2
  let yy = y * y2
  let yz = y * z2
  let zz = z * z2
  let wx = w * x2
  let wy = w * y2
  let wz = w * z2
  return #Mat4 {
    x: #Vec4 { x: (1.0 - yy - zz) * scale.x, y: (xy + wz) * scale.x, z: (xz - wy) * scale.x, w: 0.0 },
    y: #Vec4 { x: (xy - wz) * scale.y, y: (1.0 - xx - zz) * scale.y, z: (yz + wx) * scale.y, w: 0.0 },
    z: #Vec4 { x: (xz + wy) * scale.z, y: (yz - wx) * scale.z, z: (1.0 - xx - yy) * scale.z, w: 0.0 },
    w: #Vec4 { x: position.x, y: position.y, z: position.z, w: 1.0 },
  }

// The view matrix of a camera at `position` turned by `rotation`.
const Mat4.view = fn (position: Vec3) => fn (rotation: Quat) => do:
  let #Basis { x: right, y: up, z: back } = rotation.basis
  return #Mat4 {
    x: #Vec4 { x: right.x, y: up.x, z: back.x, w: 0.0 },
    y: #Vec4 { x: right.y, y: up.y, z: back.y, w: 0.0 },
    z: #Vec4 { x: right.z, y: up.z, z: back.z, w: 0.0 },
    w: #Vec4 {
      x: -(right.x * position.x + right.y * position.y + right.z * position.z),
      y: -(up.x * position.x + up.y * position.y + up.z * position.z),
      z: -(back.x * position.x + back.y * position.y + back.z * position.z),
      w: 1.0,
    },
  }

// A perspective projection seeing `focal` (1 over the tangent of half the
// vertical field of view) and `aspect` (width over height), from `near` to
// `far`, into WebGPU's depth of 0 to 1.
const Mat4.perspective = fn (focal: F32) => fn (aspect: F32) => fn (near: F32) => fn (far: F32) => #Mat4 {
  x: #Vec4 { x: focal / aspect, y: 0.0, z: 0.0, w: 0.0 },
  y: #Vec4 { x: 0.0, y: focal, z: 0.0, w: 0.0 },
  z: #Vec4 { x: 0.0, y: 0.0, z: -far / (far - near), w: -1.0 },
  w: #Vec4 { x: 0.0, y: 0.0, z: -(near * far) / (far - near), w: 0.0 },
}

// The sixteen lanes, column by column.
const Mat4.lanes = fn (matrix: Mat4) => do:
  let #Mat4 { x, y, z, w } = matrix
  return #[x.x, x.y, x.z, x.w, y.x, y.y, y.z, y.w, z.x, z.y, z.z, z.w, w.x, w.y, w.z, w.w]

// Distance along the ray from `origin` along unit `direction` to the sphere,
// or to where it leaves when it starts inside.
const ray_sphere = fn (origin: Vec3) => fn (direction: Vec3) => fn (center: Vec3) => fn (radius: F32) => do:
  let ox = center.x - origin.x
  let oy = center.y - origin.y
  let oz = center.z - origin.z
  let distance = ox * direction.x + oy * direction.y + oz * direction.z
  let half_squared = radius * radius - (ox * ox + oy * oy + oz * oz - distance * distance)
  if half_squared < 0.0:
    return #Nothing
  let half = sqrt half_squared
  let near = distance - half
  if near >= 0.0:
    return #Some near
  let far = distance + half
  if far >= 0.0:
    return #Some far
  return #Nothing

// Where the ray from `origin` along `direction` meets the plane y = `height`;
// Nothing when it runs parallel to it.
const ray_plane_y = fn (origin: Vec3) => fn (direction: Vec3) => fn (height: F32) => do:
  if abs direction.y < 0.000001:
    return #Nothing
  let t = (height - origin.y) / direction.y
  return #Some (#Vec3 { x: origin.x + direction.x * t, y: origin.y + direction.y * t, z: origin.z + direction.z * t })

// Parameters `(along_ray, along_line)` of the closest approach between a ray and
// the line through `point` along unit `axis`; Nothing when they are parallel.
const ray_line = fn (ray: Ray) => fn (point: Vec3) => fn (axis: Vec3) => do:
  let #Ray { origin: o, direction: r } = ray
  let ox = o.x - point.x
  let oy = o.y - point.y
  let oz = o.z - point.z
  let cosine = r.x * axis.x + r.y * axis.y + r.z * axis.z
  let d = r.x * ox + r.y * oy + r.z * oz
  let e = axis.x * ox + axis.y * oy + axis.z * oz
  let denominator = 1.0 - cosine * cosine
  if denominator < 0.000001:
    return #Nothing
  return #Some ((cosine * e - d) / denominator, (e - cosine * d) / denominator)

// Where a ray meets the plane through `point` with unit `normal`, if ahead of it.
const ray_plane = fn (ray: Ray) => fn (point: Vec3) => fn (normal: Vec3) => case Ray.plane ray normal point of
  #Some distance => #Some (Ray.at ray distance)
  #Nothing => #Nothing

// Entry and exit distances of one ray coordinate through the slab -1..1.
const slab = fn (origin: F32) => fn (direction: F32) => do:
  if abs direction < 0.0000001:
    if abs origin <= 1.0:
      return (-1e30, 1e30)
    return (1e30, -1e30)
  let near = (-1.0 - origin) / direction
  let far = (1.0 - origin) / direction
  return (min near far, max near far)

// Distance along `ray` to the box spanning -1..1 in the frame of `position`,
// unit `rotation` and `scale`. A ray that starts inside the box reports where
// it leaves.
const ray_box = fn (ray: Ray) => fn (position: Vec3) => fn (rotation: Quat) => fn (scale: Vec3) => do:
  if Bool.not (finite3 position && finite3 scale && finite3 ray.origin && finite3 ray.direction && finite_quat rotation):
    return #Nothing
  if scale.x == 0.0 || scale.y == 0.0 || scale.z == 0.0:
    return #Nothing
  // Into the box's frame by the conjugate rotation.
  let #Quat { x: qx, y: qy, z: qz, w: qw } = rotation
  let #Ray { origin: o, direction: d } = ray
  let origin = rotate_parts (F32.neg qx) (F32.neg qy) (F32.neg qz) qw (o.x - position.x) (o.y - position.y) (o.z - position.z)
  let direction = rotate_parts (F32.neg qx) (F32.neg qy) (F32.neg qz) qw d.x d.y d.z
  let (x_near, x_far) = slab (origin.x / scale.x) (direction.x / scale.x)
  let (y_near, y_far) = slab (origin.y / scale.y) (direction.y / scale.y)
  let (z_near, z_far) = slab (origin.z / scale.z) (direction.z / scale.z)
  let near = max x_near (max y_near z_near)
  let far = min x_far (min y_far z_far)
  if far < near:
    return #Nothing
  if far < 0.0:
    return #Nothing
  if near >= 0.0:
    return #Some near
  return #Some far

// atan(value) for |value| <= 1, within 1e-5.
const atan_unit = fn (value: F32) => do:
  let square = value * value
  return value * (0.99997726 + square * (-0.33262347 + square * (0.19354346 + square * (-0.11643287 + square * (0.05265332 + square * -0.0117212)))))

// The angle of (x, y) from the +x axis, in -pi..pi.
const atan2 = fn (y: F32) => fn (x: F32) => do:
  let ax = abs x
  let ay = abs y
  let high = max ax ay
  if high < 0.0000001:
    return 0.0
  let angle = atan_unit (min ax ay / high)
  if ay > ax:
    angle := half_pi - self
  if x < 0.0:
    angle := pi - self
  if y < 0.0:
    angle := -self
  return angle
