import { Vec2, Vec3 } from "std/vector"

// Ink's small geometry vocabulary. Vec2 and Vec3 come from std/vector with
// their operators; Vec4, Quat, Color and Ray are Ink's. Quaternions are
// [x, y, z, w] with w the scalar part.
type Vec4 is data = $Vec4 { x: F32, y: F32, z: F32, w: F32 }
type Quat is data = $Quat { x: F32, y: F32, z: F32, w: F32 }
type Color is data = $Color { r: F32, g: F32, b: F32, a: F32 }
type Ray is data = $Ray { origin: Vec3, direction: Vec3 }

func vec2 (x: F32) => func (y: F32) => $Vec2 { x, y }
func vec3 (x: F32) => func (y: F32) => func (z: F32) => $Vec3 { x, y, z }
func vec4 (x: F32) => func (y: F32) => func (z: F32) => func (w: F32) => $Vec4 { x, y, z, w }
func rgba (r: F32) => func (g: F32) => func (b: F32) => func (a: F32) => $Color { r, g, b, a }
func rgb (r: F32) => func (g: F32) => func (b: F32) => $Color { r, g, b, a: 1.0 }

const zero2 = $Vec2 { x: 0.0, y: 0.0 }
const zero3 = $Vec3 { x: 0.0, y: 0.0, z: 0.0 }
const one3 = $Vec3 { x: 1.0, y: 1.0, z: 1.0 }
const right = $Vec3 { x: 1.0, y: 0.0, z: 0.0 }
const up = $Vec3 { x: 0.0, y: 1.0, z: 0.0 }
// Forward is -Z in a right-handed coordinate system.
const forward = $Vec3 { x: 0.0, y: 0.0, z: (-1.0) }
const identity_quat = $Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }

func Vec4.add (a: Vec4) -> (b: Vec4): Vec4 => return
  $Vec4 { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z, w: a.w + b.w }
func Vec4.sub (a: Vec4) -> (b: Vec4): Vec4 => return
  $Vec4 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z, w: a.w - b.w }
func Vec4.mul (value: Vec4) -> (scale: F32): Vec4 => return
  $Vec4 { x: value.x * scale, y: value.y * scale, z: value.z * scale, w: value.w * scale }
func Vec4.dot (a: Vec4) -> (b: Vec4): F32 => return
  a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w

func Color.mul (value: Color) -> (scale: F32): Color => return
  $Color { r: value.r * scale, g: value.g * scale, b: value.b * scale, a: value.a }
func Color.lerp (a: Color) -> (b: Color) -> (t: F32): Color => $Color {
  r: F32.lerp a.r b.r t,
  g: F32.lerp a.g b.g t,
  b: F32.lerp a.b b.b t,
  a: F32.lerp a.a b.a t,
}

// Hamilton product: `a * b` rotates by b, then by a.
//
// Keep the arithmetic order of these scalar kernels stable; numerical
// witnesses compare their results with the corresponding vector formulas.
private func hamilton (ax: F32) => func (ay: F32) => func (az: F32) => func (aw: F32) => func (bx: F32) => func (by: F32) => func (bz: F32) => func (bw: F32) => $Quat {
  x: aw * bx + ax * bw + ay * bz - az * by,
  y: aw * by - ax * bz + ay * bw + az * bx,
  z: aw * bz + ax * by - ay * bx + az * bw,
  w: aw * bw - ax * bx - ay * by - az * bz,
}
func Quat.mul (a: Quat) -> (b: Quat): Quat => hamilton a.x a.y a.z a.w b.x b.y b.z b.w
func Quat.dot (a: Quat) -> (b: Quat): F32 => return
  a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
func Quat.conjugate (q: Quat) => $Quat { x: F32.neg q.x, y: F32.neg q.y, z: F32.neg q.z, w: q.w }
func finite3 (v: Vec3) => is_finite v.x and is_finite v.y and is_finite v.z
func finite_quat (q: Quat) => is_finite q.x and is_finite q.y and is_finite q.z and is_finite q.w
private func unit_quat_scaled (x: F32) => func (y: F32) => func (z: F32) => func (w: F32) =>
  let scale = max (max (abs x) (abs y)) (max (abs z) (abs w))
  if scale == 0.0:
    return $Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
  let sx = x / scale
  let sy = y / scale
  let sz = z / scale
  let sw = w / scale
  let length = sqrt (sx * sx + sy * sy + sz * sz + sw * sw)
  return $Quat { x: sx / length, y: sy / length, z: sz / length, w: sw / length }
// Finite-only normalization of quaternion parts. Zero is the identity;
// scaling avoids overflow. The common case is small enough to inline.
func unit_quat (x: F32) => func (y: F32) => func (z: F32) => func (w: F32) =>
  let squared = x * x + y * y + z * z + w * w
  // A subnormal squared magnitude has too few significant bits for a unit
  // result. Scale it first, just as for underflow and overflow.
  if squared >= 1.17549435e-38:
    if is_finite squared:
      let ordinary = sqrt squared
      return $Quat { x: x / ordinary, y: y / ordinary, z: z / ordinary, w: w / ordinary }
  // Rebuilt so that both paths give a fresh record.
  let $Quat { x: a, y: b, z: c, w: d } = unit_quat_scaled x y z w
  return $Quat { x: a, y: b, z: c, w: d }
func Quat.normalized (q: Quat) => unit_quat q.x q.y q.z q.w
// The largest coordinate magnitude of a finite vector, the divisor that keeps
// its normalization from overflowing; zero for zero or nonfinite vectors.
private func unit_scale (x: F32) => func (y: F32) => func (z: F32) =>
  if not (is_finite x and is_finite y and is_finite z):
    return 0.0
  return max (max (abs x) (abs y)) (abs z)
// A finite nonzero vector's unit parts and true, scaled first so that the
// squares cannot overflow; false for zero or nonfinite vectors.
private func unit_parts (x: F32) => func (y: F32) => func (z: F32) =>
  let scale = unit_scale x y z
  if scale == 0.0:
    return (0.0, 0.0, 0.0, false)
  let sx = x / scale
  let sy = y / scale
  let sz = z / scale
  let length = sqrt (sx * sx + sy * sy + sz * sz)
  return (sx / length, sy / length, sz / length, true)
// Checked vector normalization rejects zero and nonfinite inputs.
func normalize3 (v: Vec3) : Maybe Vec3 =>
  let (x, y, z, unit) = unit_parts v.x v.y v.z
  if not unit:
    return $Nothing
  return $Some ($Vec3 { x, y, z })
func normalize_quat (q: Quat) : Maybe Quat =>
  if not (finite_quat q) or q.x == 0.0 and q.y == 0.0 and q.z == 0.0 and q.w == 0.0:
    return $Nothing
  return $Some (Quat.normalized q)

// Rotate a vector: q v q*, as v + t w + u × t with u = q.xyz and t = 2 (u × v).
// rotate_parts is one body: never inlined, it allocates only its tuple result
// (a Vec3 result would cost two allocations), so loop-free kernels use it.
// turn splits off the cross products so that loops inline it whole, but
// outside loops each of its helpers allocates; the Quat members use it. Both
// give the same bits.
func rotate_parts (qx: F32) => func (qy: F32) => func (qz: F32) => func (qw: F32) => func (vx: F32) => func (vy: F32) => func (vz: F32) =>
  let tx = (qy * vz - qz * vy) * 2.0
  let ty = (qz * vx - qx * vz) * 2.0
  let tz = (qx * vy - qy * vx) * 2.0
  return (vx + tx * qw + (qy * tz - qz * ty), vy + ty * qw + (qz * tx - qx * tz), vz + tz * qw + (qx * ty - qy * tx))
private func cross_parts (ux: F32) => func (uy: F32) => func (uz: F32) => func (vx: F32) => func (vy: F32) => func (vz: F32) => return
  (uy * vz - uz * vy, uz * vx - ux * vz, ux * vy - uy * vx)
private func turn (qx: F32) => func (qy: F32) => func (qz: F32) => func (qw: F32) => func (vx: F32) => func (vy: F32) => func (vz: F32) =>
  let (cx, cy, cz) = cross_parts qx qy qz vx vy vz
  let tx = cx * 2.0
  let ty = cy * 2.0
  let tz = cz * 2.0
  let (ex, ey, ez) = cross_parts qx qy qz tx ty tz
  return $Vec3 { x: vx + tx * qw + ex, y: vy + ty * qw + ey, z: vz + tz * qw + ez }
func Quat.rotate (q: Quat) => func (v: Vec3) => turn q.x q.y q.z q.w v.x v.y v.z

// Normalized linear interpolation along the shorter arc, of quaternion parts.
func nlerp_parts (ax: F32) => func (ay: F32) => func (az: F32) => func (aw: F32) => func (bx: F32) => func (by: F32) => func (bz: F32) => func (bw: F32) => func (t: F32) =>
  let sign = 1.0
  if ax * bx + ay * by + az * bz + aw * bw < 0.0:
    sign := (-1.0)
  return unit_quat (F32.lerp ax (bx * sign) t) (F32.lerp ay (by * sign) t) (F32.lerp az (bz * sign) t) (F32.lerp aw (bw * sign) t)
func Quat.nlerp (a: Quat) => func (b: Quat) => func (t: F32) => nlerp_parts a.x a.y a.z a.w b.x b.y b.z b.w t

// Constant angular speed along the shorter arc. Nearly equal rotations, where
// the arc's sine loses precision, fall back to nlerp.
func Quat.slerp (a: Quat) => func (b: Quat) => func (t: F32) =>
  let d = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
  let sign = 1.0
  if d < 0.0:
    sign := (-1.0)
    d := 0.0 - d
  if d > 0.9995:
    return Quat.nlerp a b t
  let angle = atan2 (sqrt (max 0.0 (1.0 - d * d))) d
  let s = sin angle
  let wa = sin ((1.0 - t) * angle) / s
  let wb = sin (t * angle) / s * sign
  return unit_quat (a.x * wa + b.x * wb) (a.y * wa + b.y * wb) (a.z * wa + b.z * wb) (a.w * wa + b.w * wb)

// Rotations tween by slerp; see tween.blot.
func Quat.lerp (a: Quat) => func (b: Quat) => func (t: F32) => Quat.slerp a b t

// Normalizes the axis exactly as normalize3 does.
func axis_angle (axis: Vec3) => func (angle: F32) =>
  let (x, y, z, unit) = unit_parts axis.x axis.y axis.z
  if not unit:
    return $Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
  let half = angle * 0.5
  let s = sin half
  return $Quat { x: x * s, y: y * s, z: z * s, w: cos half }

// Yaw about +Y, then pitch about the yawed +X: a first-person look. This is
// axis_angle up yaw * axis_angle right pitch with the unit axes written in.
func yaw_pitch (yaw: F32) => func (pitch: F32) =>
  let ys = sin (yaw * 0.5)
  let ps = sin (pitch * 0.5)
  return hamilton (0.0 * ys) (1.0 * ys) (0.0 * ys) (cos (yaw * 0.5)) (1.0 * ps) (0.0 * ps) (0.0 * ps) (cos (pitch * 0.5))

func Quat.forward (q: Quat) => turn q.x q.y q.z q.w 0.0 0.0 (-1.0)
func Quat.right (q: Quat) => turn q.x q.y q.z q.w 1.0 0.0 0.0
func Quat.up (q: Quat) => turn q.x q.y q.z q.w 0.0 1.0 0.0

// The point a ray reaches after `distance`.
func Ray.at (ray: Ray) => func (distance: F32) =>
  let $Ray { origin: o, direction: d } = ray
  return $Vec3 { x: o.x + d.x * distance, y: o.y + d.y * distance, z: o.z + d.z * distance }

private func facing_usable (facing: F32) => abs facing >= 0.000001 and is_finite facing
private func ahead (distance: F32) => distance >= 0.0 and is_finite distance
// Distance along the ray to the plane with `normal` through `point`, if the
// ray hits its front within reach.
//
// A nonfinite coordinate needs no check of its own: times a zero it is NaN,
// otherwise infinite, so it makes `facing` or the distance nonfinite, and
// both are refused. With its checks in scalar helpers, the body stays small
// enough to inline into loops.
func Ray.plane (ray: Ray) => func (normal: Vec3) => func (point: Vec3) =>
  let $Ray { origin: o, direction: d } = ray
  let $Vec3 { x: nx, y: ny, z: nz } = normal
  let facing = nx * d.x + ny * d.y + nz * d.z
  if facing_usable facing:
    let distance = (nx * (point.x - o.x) + ny * (point.y - o.y) + nz * (point.z - o.z)) / facing
    if ahead distance:
      return $Some distance
  return $Nothing

func approach (target: F32) => func (rate: F32) => func (value: F32) =>
  if value < target:
    return min target (value + rate)
  return max target (value - rate)

// The rotation of something at `eye` looking along `forward` (cameras look
// down their local -Z), keeping `up` up. From the rotation matrix whose
// columns are right, up and back, by Shepperd's method. Both directions are
// normalized as normalize3 does; a rejected hint counts as zero.
func look_rotation (forward: Vec3) => func (up_hint: Vec3) =>
  let fscale = unit_scale forward.x forward.y forward.z
  if fscale == 0.0:
    return identity_quat
  let fx = forward.x / fscale
  let fy = forward.y / fscale
  let fz = forward.z / fscale
  let flength = sqrt (fx * fx + fy * fy + fz * fz)
  fx := self / flength
  fy := self / flength
  fz := self / flength
  let hx = 0.0
  let hy = 0.0
  let hz = 0.0
  let hscale = unit_scale up_hint.x up_hint.y up_hint.z
  if hscale != 0.0:
    let sx = up_hint.x / hscale
    let sy = up_hint.y / hscale
    let sz = up_hint.z / hscale
    let hlength = sqrt (sx * sx + sy * sy + sz * sz)
    hx := sx / hlength
    hy := sy / hlength
    hz := sz / hlength
  // r0 = f × hint
  let rx = fy * hz - fz * hy
  let ry = fz * hx - fx * hz
  let rz = fx * hy - fy * hx
  if rx * rx + ry * ry + rz * rz < 0.000001:
    hx := 0.0
    hy := 1.0
    hz := 0.0
    if abs fy > 0.9:
      hx := 1.0
      hy := 0.0
    rx := fy * hz - fz * hy
    ry := fz * hx - fx * hz
    rz := fx * hy - fy * hx
  // r = r0.normalized, which keeps a zero vector
  let rlength = sqrt (rx * rx + ry * ry + rz * rz)
  if rlength != 0.0:
    rx := self / rlength
    ry := self / rlength
    rz := self / rlength
  // u = r × f, b = -f
  let ux = ry * fz - rz * fy
  let uy = rz * fx - rx * fz
  let uz = rx * fy - ry * fx
  let bx = fx * (-1.0)
  let by = fy * (-1.0)
  let bz = fz * (-1.0)
  let trace = rx + uy + bz
  if trace > 0.0:
    let s = sqrt (trace + 1.0) * 2.0
    return $Quat { x: (uz - by) / s, y: (bx - rz) / s, z: (ry - ux) / s, w: 0.25 * s }
  if rx > uy and rx > bz:
    let s = sqrt (1.0 + rx - uy - bz) * 2.0
    return $Quat { x: 0.25 * s, y: (ux + ry) / s, z: (bx + rz) / s, w: (uz - by) / s }
  if uy > bz:
    let s = sqrt (1.0 + uy - rx - bz) * 2.0
    return $Quat { x: (ux + ry) / s, y: 0.25 * s, z: (by + uz) / s, w: (bx - rz) / s }
  let s = sqrt (1.0 + bz - rx - uy) * 2.0
  return $Quat { x: (bx + rz) / s, y: (by + uz) / s, z: 0.25 * s, w: (ry - ux) / s }

// A rotation about +Y that turns -Z toward `direction` on the ground plane.
func facing (direction: Vec3) => look_rotation ($Vec3 { x: direction.x, y: 0.0, z: direction.z }) up

// Keep only the horizontal part of a vector.
func flat (v: Vec3) => $Vec3 { x: v.x, y: 0.0, z: v.z }

// Column-major matrices, axes and ray geometry.
type Basis is data = $Basis { x: Vec3, y: Vec3, z: Vec3 }
// Column-major logical matrices. Scalar fields name column then lane;
// column accessors construct vector views. Wire order comes from `lanes`.
type Mat4 is data = $Mat4 { xx: F32, xy: F32, xz: F32, xw: F32, yx: F32, yy: F32, yz: F32, yw: F32, zx: F32, zy: F32, zz: F32, zw: F32, wx: F32, wy: F32, wz: F32, ww: F32 }
type Axis is data = $X | $Y | $Z

const back = vec3 0.0 0.0 1.0
const half_pi = pi * 0.5
const Quat.identity = identity_quat
const Quat.from_axis_angle = axis_angle

func unlerp (low: F32) => func (high: F32) => func (value: F32) => (value - low) / (high - low)

func Axis.unit (axis: Axis) => case axis of
  $X => right
  $Y => up
  $Z => back

// The coordinate of `vector` along `axis`.
func Axis.coordinate (axis: Axis) => func (vector: Vec3) => case axis of
  $X => vector.x
  $Y => vector.y
  $Z => vector.z

// `vector` with its coordinate along `axis` replaced by `value`.
func Axis.set (axis: Axis) => func (vector: Vec3) => func (value: F32) => case axis of
  $X => vec3 value vector.y vector.z
  $Y => vec3 vector.x value vector.z
  $Z => vec3 vector.x vector.y value

// The axis `vector` points along most.
func Axis.dominant (vector: Vec3) =>
  let ax = abs vector.x
  let ay = abs vector.y
  let az = abs vector.z
  if ax >= ay:
    if ax >= az:
      return $X
    return $Z
  if ay >= az:
    return $Y
  return $Z

func Axis.index (axis: Axis) => case axis of
  $X => 0
  $Y => 1
  $Z => 2

func Axis.from_index (index: U32) => case index of
  0 => $X
  1 => $Y
  _ => $Z

// Shortest rotation taking unit vector `source` onto unit vector `target`.
func Quat.from_to (source: Vec3) => func (target: Vec3) =>
  let $Vec3 { x: sx, y: sy, z: sz } = source
  let $Vec3 { x: tx, y: ty, z: tz } = target
  let d = sx * tx + sy * ty + sz * tz
  if d < -0.999999:
    // (source × fallback).normalized, falling back on up or right.
    let fx = 0.0
    let fy = 1.0
    let fz = 0.0
    if abs sx < 0.9:
      fx := 1.0
      fy := 0.0
    let cx = sy * fz - sz * fy
    let cy = sz * fx - sx * fz
    let cz = sx * fy - sy * fx
    let length = sqrt (cx * cx + cy * cy + cz * cz)
    if length == 0.0:
      return $Quat { x: cx, y: cy, z: cz, w: 0.0 }
    return $Quat { x: cx / length, y: cy / length, z: cz / length, w: 0.0 }
  return unit_quat (sy * tz - sz * ty) (sz * tx - sx * tz) (sx * ty - sy * tx) (1.0 + d)

// Rotation about unit `axis` taking unit `source` onto unit `target`, both
// perpendicular to it; opposite vectors turn half a revolution about `axis`.
func Quat.about (axis: Vec3) => func (source: Vec3) => func (target: Vec3) =>
  let $Vec3 { x: sx, y: sy, z: sz } = source
  let $Vec3 { x: tx, y: ty, z: tz } = target
  let cosine = sx * tx + sy * ty + sz * tz
  if cosine < -0.999999:
    let $Vec3 { x, y, z } = axis
    return $Quat { x, y, z, w: 0.0 }
  return unit_quat (sy * tz - sz * ty) (sz * tx - sx * tz) (sx * ty - sy * tx) (1.0 + cosine)

// A turn of `angle` about the vertical. A quarter turn takes +x to -z, and
// so a model's +z front to +x.
func Quat.yaw (angle: F32) => axis_angle up angle

// The turn about the vertical that faces -z the way `rotation` faces, level:
// what is left of it with its pitch and roll taken off.
func Quat.heading (rotation: Quat) =>
  let (fx, _, fz) = rotate_parts rotation.x rotation.y rotation.z rotation.w 0.0 0.0 (-1.0)
  return atan2 (-fx) (-fz)

func Quat.basis (rotation: Quat) =>
  let $Quat { x, y, z, w } = Quat.normalized rotation
  let x2 = x + x
  let y2 = y + y
  let z2 = z + z
  let xx = x * x2
  let xy = x * y2
  let xz = x * z2
  let yy = y * y2
  let yz = y * z2
  let zz = z * z2
  let wx = w * x2
  let wy = w * y2
  let wz = w * z2
  return $Basis {
    x: $Vec3 { x: 1.0 - yy - zz, y: xy + wz, z: xz - wy },
    y: $Vec3 { x: xy - wz, y: 1.0 - xx - zz, z: yz + wx },
    z: $Vec3 { x: xz + wy, y: yz - wx, z: 1.0 - xx - yy },
  }

func Mat4.x (m: Mat4) => vec4 m.xx m.xy m.xz m.xw
func Mat4.y (m: Mat4) => vec4 m.yx m.yy m.yz m.yw
func Mat4.z (m: Mat4) => vec4 m.zx m.zy m.zz m.zw
func Mat4.w (m: Mat4) => vec4 m.wx m.wy m.wz m.ww

func Mat4.from_columns (x: Vec4) => func (y: Vec4) => func (z: Vec4) => func (w: Vec4) => $Mat4 {
  xx: x.x, xy: x.y, xz: x.z, xw: x.w,
  yx: y.x, yy: y.y, yz: y.z, yw: y.w,
  zx: z.x, zy: z.y, zz: z.z, zw: z.w,
  wx: w.x, wy: w.y, wz: w.z, ww: w.w,
}

const Mat4.identity = $Mat4 {
  xx: 1.0, xy: 0.0, xz: 0.0, xw: 0.0,
  yx: 0.0, yy: 1.0, yz: 0.0, yw: 0.0,
  zx: 0.0, zy: 0.0, zz: 1.0, zw: 0.0,
  wx: 0.0, wy: 0.0, wz: 0.0, ww: 1.0,
}

// Model matrix: scale, then rotation, then translation. Composed directly,
// since it runs per rendered entity, from scalar parts so that callers never
// box their pose, with Quat.normalized's common case written in so that only
// the matrix is allocated.
private func compose_parts (px: F32) => func (py: F32) => func (pz: F32) => func (x: F32) => func (y: F32) => func (z: F32) => func (w: F32) => func (sx: F32) => func (sy: F32) => func (sz: F32) =>
  let squared = x * x + y * y + z * z + w * w
  if squared >= 1.17549435e-38 and is_finite squared:
    let ordinary = sqrt squared
    x := self / ordinary
    y := self / ordinary
    z := self / ordinary
    w := self / ordinary
  else:
    let $Quat { x: a, y: b, z: c, w: d } = unit_quat_scaled x y z w
    x := a
    y := b
    z := c
    w := d
  let x2 = x + x
  let y2 = y + y
  let z2 = z + z
  let xx = x * x2
  let xy = x * y2
  let xz = x * z2
  let yy = y * y2
  let yz = y * z2
  let zz = z * z2
  let wx = w * x2
  let wy = w * y2
  let wz = w * z2
  return $Mat4 {
    xx: (1.0 - yy - zz) * sx, xy: (xy + wz) * sx, xz: (xz - wy) * sx, xw: 0.0,
    yx: (xy - wz) * sy, yy: (1.0 - xx - zz) * sy, yz: (yz + wx) * sy, yw: 0.0,
    zx: (xz + wy) * sz, zy: (yz - wx) * sz, zz: (1.0 - xx - yy) * sz, zw: 0.0,
    wx: px, wy: py, wz: pz, ww: 1.0,
  }
func Mat4.compose (position: Vec3) => func (rotation: Quat) => func (scale: Vec3) => return
  compose_parts position.x position.y position.z rotation.x rotation.y rotation.z rotation.w scale.x scale.y scale.z

// The view matrix of a camera at `position` turned by `rotation`.
func Mat4.view (position: Vec3) => func (rotation: Quat) =>
  let $Basis { x: right, y: up, z: back } = rotation.basis
  return $Mat4 {
    xx: right.x, xy: up.x, xz: back.x, xw: 0.0,
    yx: right.y, yy: up.y, yz: back.y, yw: 0.0,
    zx: right.z, zy: up.z, zz: back.z, zw: 0.0,
    wx: -(right.x * position.x + right.y * position.y + right.z * position.z), wy: -(up.x * position.x + up.y * position.y + up.z * position.z), wz: -(back.x * position.x + back.y * position.y + back.z * position.z), ww: 1.0,
  }

// A perspective projection seeing `focal` (1 over the tangent of half the
// vertical field of view) and `aspect` (width over height), from `near` to
// `far`, into WebGPU's depth of 0 to 1.
func Mat4.perspective (focal: F32) => func (aspect: F32) => func (near: F32) => func (far: F32) => $Mat4 {
  xx: focal / aspect, xy: 0.0, xz: 0.0, xw: 0.0,
  yx: 0.0, yy: focal, yz: 0.0, yw: 0.0,
  zx: 0.0, zy: 0.0, zz: -far / (far - near), zw: -1.0,
  wx: 0.0, wy: 0.0, wz: -(near * far) / (far - near), ww: 0.0,
}

// The sixteen lanes, column by column.
func Mat4.lanes (m: Mat4) => return
  #[m.xx, m.xy, m.xz, m.xw, m.yx, m.yy, m.yz, m.yw, m.zx, m.zy, m.zz, m.zw, m.wx, m.wy, m.wz, m.ww]

// Distance along the ray from `origin` along unit `direction` to the sphere,
// or to where it leaves when it starts inside.
func ray_sphere (origin: Vec3) => func (direction: Vec3) => func (center: Vec3) => func (radius: F32) =>
  let ox = center.x - origin.x
  let oy = center.y - origin.y
  let oz = center.z - origin.z
  let distance = ox * direction.x + oy * direction.y + oz * direction.z
  let half_squared = radius * radius - (ox * ox + oy * oy + oz * oz - distance * distance)
  if half_squared < 0.0:
    return $Nothing
  let half = sqrt half_squared
  let near = distance - half
  if near >= 0.0:
    return $Some near
  let far = distance + half
  if far >= 0.0:
    return $Some far
  return $Nothing

// Where the ray from `origin` along `direction` meets the plane y = `height`;
// Nothing when it runs parallel to it.
func ray_plane_y (origin: Vec3) => func (direction: Vec3) => func (height: F32) =>
  if abs direction.y < 0.000001:
    return $Nothing
  let t = (height - origin.y) / direction.y
  return $Some ($Vec3 { x: origin.x + direction.x * t, y: origin.y + direction.y * t, z: origin.z + direction.z * t })

// Parameters `(along_ray, along_line)` of the closest approach between a ray and
// the line through `point` along unit `axis`; Nothing when they are parallel.
func ray_line (ray: Ray) => func (point: Vec3) => func (axis: Vec3) =>
  let $Ray { origin: o, direction: r } = ray
  let ox = o.x - point.x
  let oy = o.y - point.y
  let oz = o.z - point.z
  let cosine = r.x * axis.x + r.y * axis.y + r.z * axis.z
  let d = r.x * ox + r.y * oy + r.z * oz
  let e = axis.x * ox + axis.y * oy + axis.z * oz
  let denominator = 1.0 - cosine * cosine
  if denominator < 0.000001:
    return $Nothing
  return $Some ((cosine * e - d) / denominator, (e - cosine * d) / denominator)

// Where a ray meets the plane through `point` with unit `normal`, if ahead of it.
func ray_plane (ray: Ray) => func (point: Vec3) => func (normal: Vec3) => case Ray.plane ray normal point of
  $Some distance => $Some (Ray.at ray distance)
  $Nothing => $Nothing

// Entry and exit distances of one ray coordinate through the slab -1..1,
// as scalars rather than an allocated pair.
private func slab_near (origin: F32) => func (direction: F32) =>
  if abs direction < 0.0000001:
    return if abs origin <= 1.0 then -1e30 else 1e30
  return min ((-1.0 - origin) / direction) ((1.0 - origin) / direction)
private func slab_far (origin: F32) => func (direction: F32) =>
  if abs direction < 0.0000001:
    return if abs origin <= 1.0 then 1e30 else -1e30
  return max ((-1.0 - origin) / direction) ((1.0 - origin) / direction)

// Distance along `ray` to the box spanning -1..1 in the frame of `position`,
// unit `rotation` and `scale`. A ray that starts inside the box reports where
// it leaves.
func ray_box (ray: Ray) => func (position: Vec3) => func (rotation: Quat) => func (scale: Vec3) =>
  if not (finite3 position and finite3 scale and finite3 ray.origin and finite3 ray.direction and finite_quat rotation):
    return $Nothing
  let $Vec3 { x: sx, y: sy, z: sz } = scale
  if sx == 0.0 or sy == 0.0 or sz == 0.0:
    return $Nothing
  // Into the box's frame by the conjugate rotation.
  let $Quat { x: qx, y: qy, z: qz, w: qw } = rotation
  let $Ray { origin: o, direction: d } = ray
  let (lox, loy, loz) = rotate_parts (F32.neg qx) (F32.neg qy) (F32.neg qz) qw (o.x - position.x) (o.y - position.y) (o.z - position.z)
  let (ldx, ldy, ldz) = rotate_parts (F32.neg qx) (F32.neg qy) (F32.neg qz) qw d.x d.y d.z
  let ox = lox / sx
  let oy = loy / sy
  let oz = loz / sz
  let dx = ldx / sx
  let dy = ldy / sy
  let dz = ldz / sz
  let near = max (slab_near ox dx) (max (slab_near oy dy) (slab_near oz dz))
  let far = min (slab_far ox dx) (min (slab_far oy dy) (slab_far oz dz))
  if far < near:
    return $Nothing
  if far < 0.0:
    return $Nothing
  if near >= 0.0:
    return $Some near
  return $Some far

// atan(value) for |value| <= 1, within 1e-5.
func atan_unit (value: F32) =>
  let square = value * value
  return value * (0.99997726 + square * (-0.33262347 + square * (0.19354346 + square * (-0.11643287 + square * (0.05265332 + square * -0.0117212)))))

// The angle of (x, y) from the +x axis, in -pi..pi.
func atan2 (y: F32) => func (x: F32) =>
  let ax = abs x
  let ay = abs y
  let high = max ax ay
  if high < 0.0000001:
    return 0.0
  let angle = atan_unit (min ax ay / high)
  if ay > ax:
    angle := half_pi - self
  if x < 0.0:
    angle := pi - self
  if y < 0.0:
    angle := -self
  return angle
