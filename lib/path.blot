import { Vec3 } from "std/vector"
import * as math from "./math"

// Paths: polylines through their points, which things travel along by
// distance, e.g. walkers along a road or a cart behind its puller.

// How long `path` is.
const length = fn (path: Array Vec3) => do:
  let total = 0.0
  for index in 1 .. path.length:
    total := self + (path[index] - path[index - 1]).length
  return total

// Where along `path`, `distance` from its start (held to its ends): the
// point, and the way the path heads there as a yaw about the vertical, 0
// facing +z.
const along = fn (path: Array Vec3) => fn (distance: F32) => do:
  if path.length == 0 || Bool.not (is_finite distance):
    return #Nothing
  for point in path:
    if Bool.not (math.finite3 point):
      return #Nothing
  if path.length == 1:
    return #Some (path[0], 0.0)
  let left = max 0.0 distance
  for index in 1 .. path.length:
    let begin = path[index - 1]
    let finish = path[index]
    let leg = (finish - begin).length
    if left < leg:
      let t = left / leg
      let way = finish - begin
      return #Some (begin.lerp finish t, math.atan2 way.x way.z)
    left := self - leg
  let last = path[path.length - 1]
  let way = last - path[max 1 (path.length - 1) - 1]
  return #Some (last, math.atan2 way.x way.z)
