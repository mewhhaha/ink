import { Vec3 } from "std/vector"
import * as math from "./math"

// Paths: polylines through their points, which things travel along by
// distance, e.g. walkers along a road or a cart behind its puller.

// How long `path` is. Legs are measured in scalars, as Vec3.length would.
const length = func (path: Array Vec3) => return do:
  let total = 0.0
  for index in 1 .. path.length:
    let finish = path[index]
    let begin = path[index - 1]
    let x = finish.x - begin.x
    let y = finish.y - begin.y
    let z = finish.z - begin.z
    total := self + sqrt (x * x + y * y + z * z)
  return total

// Where along `path`, `distance` from its start (held to its ends): the
// point, and the way the path heads there as a yaw about the vertical, 0
// facing +z.
const along = func (path: Array Vec3) => return func (distance: F32) => return do:
  if path.length == 0 or Bool.not (is_finite distance):
    return $Nothing
  for point in path:
    if Bool.not (math.finite3 point):
      return $Nothing
  if path.length == 1:
    return $Some (path[0], 0.0)
  let left = max 0.0 distance
  for index in 1 .. path.length:
    let begin = path[index - 1]
    let finish = path[index]
    let x = finish.x - begin.x
    let y = finish.y - begin.y
    let z = finish.z - begin.z
    let leg = sqrt (x * x + y * y + z * z)
    if left < leg:
      let t = left / leg
      let point = $Vec3 { x: F32.lerp begin.x finish.x t, y: F32.lerp begin.y finish.y t, z: F32.lerp begin.z finish.z t }
      return $Some (point, math.atan2 x z)
    left := self - leg
  let last = path[path.length - 1]
  let before = path[max 1 (path.length - 1) - 1]
  return $Some (last, math.atan2 (last.x - before.x) (last.z - before.z))

// Validated polyline with cumulative distances. Preparation owns no cursor;
// any number of callers can sample the immutable path independently.
type Prepared is data = $Prepared { points: &[Vec3], distances: &[F32], yaws: &[F32] }
const prepare_into = func (points: Array Vec3) -> (distances: Array F32) -> (yaws: Array F32) : Maybe Prepared => return do:
  if distances.length != points.length or yaws.length != points.length:
    return @panic "prepared path outputs must match point count"
  if points.length == 0:
    return $Nothing
  let valid = true
  for point in points:
    if Bool.not (math.finite3 point):
      valid := false
  for i in 0 .. points.length:
    distances[i] := 0.0
    yaws[i] := 0.0
  for i in 1 .. points.length:
    let a = points[i - 1]
    let b = points[i]
    let x = b.x - a.x
    let y = b.y - a.y
    let z = b.z - a.z
    let distance = sqrt (x * x + y * y + z * z)
    distances[i] := distances[i - 1] + distance
    yaws[i] := math.atan2 x z
    if Bool.not (is_finite distances[i]):
      valid := false
  return if valid then $Some ($Prepared {points: &points[0..points.length],
    distances: &distances[0..distances.length], yaws: &yaws[0..yaws.length]}) else $Nothing
const sample = func (path: Prepared) -> (distance: F32) => return do:
  if Bool.not (is_finite distance):
    return $Nothing
  let last = path.points.length - 1
  let target = max 0.0 distance
  if target >= path.distances[last]:
    return $Some (path.points[last], path.yaws[last])
  // Upper bound skips zero-length legs, including a leading run of duplicates.
  let low = 1
  let high = path.points.length
  for 0 .. 32:
    if low >= high:
      break
    let mid = low + (high - low) / 2
    if path.distances[mid] <= target:
      low := mid + 1
    else:
      high := mid
  let start = low - 1
  let a = path.points[start]
  let b = path.points[low]
  let t = (target - path.distances[start]) / (path.distances[low] - path.distances[start])
  return $Some ($Vec3 { x: F32.lerp a.x b.x t, y: F32.lerp a.y b.y t, z: F32.lerp a.z b.z t }, path.yaws[low])
