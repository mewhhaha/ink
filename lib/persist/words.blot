import * as array from "std/array"
import * as ecs from "../ecs"
import * as persist from "../persist"

// Existing exact-U32 framing; rows contain offsets into separately owned words.
const magic: U32 = 1229867863
const scene_magic: U32 = 1229867859
type Section is data = $Section {key: U32, version: U32, start: U32, count: U32}
func require valid => return if valid then () else @panic "invalid word-native state"
func append words -> (destination: ResizeArray U32) => return do:
  let count: U32 = words.length
  let read: U32 -> U32 = words.at
  for index in 0 .. count:
    destination.push (read index)
func find (key: U32) -> sections : Maybe Section => return do:
  let count: U32 = sections.length
  let read: U32 -> Section = sections.at
  for index in 0 .. count:
    let section = read index
    if section.key == key:
      return $Some section
  return $Nothing
func append_section (key: U32) -> (version: U32) -> words -> (sections: ResizeArray Section) -> (payload: ResizeArray U32) => return do:
  require (Bool.not (Maybe.is_some (find key sections)))
  let count: U32 = words.length
  let start = payload.length
  append words payload
  sections.push ($Section {key, version, start, count})
func frame (marker: U32) -> (schema: U32) -> sections -> payload -> (destination: ResizeArray U32) => return do:
  let section_count: U32 = sections.length
  let section_at: U32 -> Section = sections.at
  let payload_count: U32 = payload.length
  let payload_at: U32 -> U32 = payload.at
  destination.truncate 0
  append #[marker, schema, section_count] destination
  for index in 0 .. section_count:
    let section = section_at index
    require (section.start <= payload_count and section.count <= payload_count - section.start)
    append #[section.key, section.version, section.count] destination
    for i in 0 .. section.count:
      destination.push (payload_at (section.start + i))
func split (marker: U32) -> (schema: U32) -> words -> (sections: ResizeArray Section) => return do:
  let length: U32 = words.length
  let read: U32 -> U32 = words.at
  require (length >= 3 and read 0 == marker and read 1 == schema)
  let count = read 2
  require (count <= (length - 3) / 3)
  sections.truncate 0
  let at: U32 = 3
  for 0 .. count:
    require (at <= length and length - at >= 3)
    let key = read at
    let version = read (at + 1)
    let count = read (at + 2)
    at := at + 3
    require (count <= length - at and Bool.not (Maybe.is_some (find key sections)))
    sections.push ($Section {key, version, start: at, count})
    at := at + count
  require (at == length)
func section_words (section: Section) -> values : Array U32 => return do:
  let read: U32 -> U32 = values.at
  return array.generate section.count (func (i: U32) => return read (section.start + i))
func decoded codec -> words => return do:
  let $Some value = codec.decode words else:
    return @panic "invalid word-native value"
  return value
func write_alive alive -> sections -> payload => return append_section 0 1 (array.generate alive.length (func i => return if (alive.at (i)) then 1 else 0)) sections payload
func restore_alive sections -> words -> (alive: ecs.Entities) -> meta -> outcomes => return do:
  let $Some section = find 0 sections else:
    return @panic "missing word-native entities"
  require (section.version == 1)
  alive.truncate 0
  for i in 0 .. section.count:
    let flag = (words.at (section.start + i))
    require (flag <= 1)
    alive.push (flag == 1)
  meta[1] = 0
  meta[2] = 0
  outcomes.push ($persist.Outcome {key: 0, fate: $persist.Kept, saved: 1, version: 1})
func write_resource codec -> value -> sections -> payload => return append_section codec.key codec.version (codec.encode value) sections payload
func pair first -> second : Array U32 => return array.generate (1 + first.length + second.length) (func i => return if i == 0 then first.length else if i <= first.length then (first.at (i - 1)) else (second.at (i - 1 - first.length)))
func write_snapshotted_resource codec -> current -> previous -> sections -> payload => return append_section codec.key codec.version (pair (codec.encode current) (codec.encode previous)) sections payload
func restore_resource codec -> initial -> owner -> sections -> words -> outcomes => return do:
  let $Some section = find codec.key sections else:
    owner[0] = initial
    outcomes.push ($persist.Outcome {key: codec.key, fate: $persist.Missing, saved: 0, version: codec.version})
    return ()
  let source = section_words section words
  let converted = if section.version == codec.version then $Some source else codec.migrate section.version source
  let fate = if section.version == codec.version then $persist.Kept else $persist.Migrated
  if let $Some value = converted:
    owner[0] = decoded codec value
  else:
    owner[0] = initial
    fate := $persist.Reset
  outcomes.push ($persist.Outcome {key: codec.key, fate, saved: section.version, version: codec.version})
// Sparse component image: slots,present, then id,length,words per present row.
func column codec -> pool : Array U32 => return do:
  let length: U32 = pool.length
  let read: U32 -> Maybe a = pool.at
  let encode: a -> Array U32 = codec.encode
  let count: U32 = 0
  for index in 0 .. length:
    if let $Some _ = read index:
      count := count + 1
  let output: ResizeArray U32 = #[]
  append #[length, count] output
  for i in 0 .. length:
    if let $Some value = read i:
      let words = encode value
      append #[i, words.length] output
      append words output
  return @storage.freeze output
func write_component codec -> pool -> sections -> payload => return append_section codec.key codec.version (column codec pool) sections payload
func write_snapshotted_component codec -> current -> previous -> sections -> payload => return append_section codec.key codec.version (pair (column codec current) (column codec previous)) sections payload
func read_column (require_live: Bool) -> codec -> (saved_version: U32) -> alive -> words -> (pool: ecs.Pool a) => return do:
  let length: U32 = words.length
  let read: U32 -> U32 = words.at
  let alive_count: U32 = alive.length
  let alive_at: U32 -> Bool = alive.at
  let decode: Array U32 -> Maybe a = codec.decode
  let migrate: U32 -> Array U32 -> Maybe (Array U32) = codec.migrate
  let version: U32 = codec.version
  require (length >= 2 and read 0 <= alive_count and read 1 <= read 0)
  pool.truncate 0
  for 0 .. read 0:
    pool.push $Nothing
  let at: U32 = 2
  let previous: U32 = 0
  for record in 0 .. read 1:
    require (at <= length and length - at >= 2)
    let id = read at
    let count = read (at + 1)
    at := at + 2
    require (id < pool.length and count <= length - at and (Bool.not require_live or alive_at id))
    require (record == 0 or id > previous)
    let value: Array U32 = array.generate count (func (i: U32) => return read (at + i))
    let converted: Maybe (Array U32) = if saved_version == version then $Some value else migrate saved_version value
    let $Some value = converted else:
      pool.truncate 0
      return false
    let $Some row = decode value else:
      return @panic "invalid word-native value"
    pool[id] = $Some row
    previous := id
    at := at + count
  require (at == length)
  return true
func restore_column (require_live: Bool) -> codec -> alive -> (pool: ecs.Pool a) -> (meta: ecs.Metadata) -> sections -> words -> (outcomes: ResizeArray persist.Outcome) => return do:
  let key: U32 = codec.key
  let version: U32 = codec.version
  let $Some section = find key sections else:
    pool.truncate 0
    outcomes.push ($persist.Outcome {key, fate: $persist.Missing, saved: 0, version})
    return ()
  let source = section_words section words
  let fate = if section.version == version then $persist.Kept else $persist.Migrated
  if Bool.not (read_column require_live codec section.version alive source pool):
    fate := $persist.Reset
  meta[1] = 0
  meta[2] = 0
  outcomes.push ($persist.Outcome {key, fate, saved: section.version, version})
const restore_component = restore_column true
// Schema callbacks statically sequence named resources/pools. Reports remain
// persist.Outcome rows, encoded to F32 separately only at the host boundary.
func encode_state schema -> sections -> payload -> encode_schema -> access -> destination => return do:
  sections.truncate 0
  payload.truncate 0
  encode_schema access sections payload
  frame magic schema sections payload destination
func encode_scene schema -> sections -> payload -> encode_schema -> access -> destination => return do:
  sections.truncate 0
  payload.truncate 0
  encode_schema access sections payload
  frame scene_magic schema sections payload destination
func decode_state schema -> words -> sections -> decode_schema -> access -> outcomes => return do:
  split magic schema words sections
  outcomes.truncate 0
  decode_schema access sections words outcomes
  persist.dropped sections outcomes
func decode_scene schema -> words -> sections -> decode_schema -> access -> outcomes => return do:
  split scene_magic schema words sections
  outcomes.truncate 0
  decode_schema access sections words outcomes
  persist.dropped sections outcomes

func restore_snapshotted_resource codec -> initial -> current -> previous -> sections -> words -> outcomes => return do:
  let $Some section = find codec.key sections else:
    current[0] = initial
    previous[0] = initial
    outcomes.push ($persist.Outcome {key: codec.key, fate: $persist.Missing, saved: 0, version: codec.version})
    return ()
  require (section.count >= 1)
  let count = (words.at (section.start))
  require (count <= section.count - 1)
  let first = array.generate count (func i => return (words.at (section.start + 1 + i)))
  let second = array.generate (section.count - 1 - count) (func i => return (words.at (section.start + 1 + count + i)))
  let now = if section.version == codec.version then $Some first else codec.migrate section.version first
  let before = if section.version == codec.version then $Some second else codec.migrate section.version second
  let fate = if section.version == codec.version then $persist.Kept else $persist.Migrated
  if let $Some value = now:
    if let $Some old = before:
      current[0] = decoded codec value
      previous[0] = decoded codec old
    else:
      current[0] = initial
      previous[0] = initial
      fate := $persist.Reset
  else:
    current[0] = initial
    previous[0] = initial
    fate := $persist.Reset
  outcomes.push ($persist.Outcome {key: codec.key, fate, saved: section.version, version: codec.version})
func restore_snapshotted_component codec -> alive -> current -> current_meta -> previous -> previous_meta -> sections -> words -> outcomes => return do:
  let temporary: ResizeArray persist.Outcome = #[]
  let $Some section = find codec.key sections else:
    restore_component codec alive current current_meta sections words temporary
    restore_column false codec alive previous previous_meta sections words temporary
    outcomes.push temporary[0]
    return ()
  require (section.count >= 1)
  let count = (words.at (section.start))
  require (count <= section.count - 1)
  let first = $Section {key: section.key, version: section.version, start: section.start + 1, count}
  let second = $Section {key: section.key, version: section.version, start: section.start + 1 + count, count: section.count - 1 - count}
  restore_component codec alive current current_meta #[first] words temporary
  // Previous rows belong to the checkpoint's historical membership. Despawned
  // IDs remain valid within this epoch's monotonic entity extent; current rows
  // above still require their live bit. All framing/ordering guards are shared.
  restore_column false codec alive previous previous_meta #[second] words temporary
  outcomes.push temporary[0]
