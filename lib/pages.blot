import * as array from "std/array"
import * as changes from "./changes"

// Ranges borrow the current pages. Keep an independent snapshot with copy_using.
// Element payloads are fixed-layout rows; variable data uses caller-owned
// pools plus spans/borrowed views/links, never owning array fields.
type Pages a = #[a]
const size: U32 = 64
func length (count: U32) => (count >> 6) + (if count & 63 == 0 then 0 else 1)
func empty () : Pages a => #[]
func from (values: #[a]) : Pages a =>
  let storage: Pages a = #[]
  for value in values:
    @storage.push storage value
  return storage
func count (stored: Pages a) => stored.length
func get (stored: Pages a) -> (index: U32) => stored[index]
func set (index: U32) -> (value: a) -> (stored: own Pages a) : Pages a =>
  stored[index] := value
  return stored
func push (value: a) -> (stored: own Pages a) : Pages a =>
  @storage.push stored value
  return stored
func page_at (page: U32) -> (stored: Pages a) =>
  if page >= length stored.length:
    return panic "page outside storage"
  let start = page << 6
  return &stored[start..min stored.length (start + size)]
func flatten (stored: Pages a) => (copy stored)
func copy_using copy_value -> (stored: Pages a) => return
  from (array.generate stored.length (func i => copy_value stored[i]))
func truncate (count: U32) -> (stored: own Pages a) : Pages a =>
  @storage.truncate stored count
  return stored
func fold reduce -> initial -> (stored: Pages a) =>
  let state = initial
  let count = stored.length
  for i in 0 .. count:
    state := reduce self stored[i]
  return state
// Explicit replacement is a mutation boundary; old views must have ended.
func replace (values: #[a]) -> (stored: own Pages a) : Pages a =>
  let copied = copy values
  @storage.truncate stored 0
  for value in copied:
    @storage.push stored value

  return stored
// Sparse mutation visits dirty rows and appended rows once. All callback inputs
// are explicit; callbacks must not resize the owner being updated.
func update (count: U32) -> (dirty: #[U32]) -> value -> (stored: own Pages a) : Pages a =>
  let before = stored.length
  let selected = changes.unique dirty
  for index in selected:
    if index < min count before:
      stored[index] := value index
  for index in before .. count:
    @storage.push stored (value index)
  if count < before:
    @storage.truncate stored count
  return stored
// Leaf callbacks receive independent bounded copies; their returned rows are
// written directly. Old whole collections are not automatically preserved.
func update_pages (count: U32) -> (dirty: #[U32]) -> value -> (stored: own Pages a) : Pages a =>
  let before = stored.length
  let selected = changes.unique dirty
  for page in 0 .. length count:
    let start = page << 6
    let take = min size (count - start)
    let old_take = if start < before then min size (before - start) else 0
    if changes.contains selected page or take != old_take:
      let old = array.generate old_take (func i => stored[start + i])
      let next = value page old
      if next.length != take:
        return panic "page callback returned the wrong length"
      for i in 0 .. take:
        if start + i < stored.length:
          stored[start + i] := next[i]
        else:
          @storage.push stored next[i]
  if count < before:
    @storage.truncate stored count
  return stored
