import { Vec3 } from "std/vector"
import * as math from "./math"
import * as sort from "./sort"

// A balanced bounding-volume tree. Leaves keep caller indices; refitting does
// not change their order. All storage is explicit and snapshots remain valid.
type Bounds is data = #Bounds { low: Vec3, high: Vec3 }
type Index is data = #Index { base: U32, bounds: Array F32, order: Array U32, leaves: Array U32 }

const spread = fn (value: U32) => do:
  let v = value & 1023
  v := (self | (self << 16)) & 50331903
  v := (self | (self << 8)) & 50393103
  v := (self | (self << 4)) & 51130563
  return (v | (v << 2)) & 153391689

const quantize = fn (value: F32) => fn (low: F32) => fn (high: F32) => do:
  if high <= low:
    return 0
  return F32.to_u32 (clamp 0.0 1023.0 ((value - low) / (high - low) * 1023.0))

const build = fn (items: Array Bounds) => do:
  let n = items.length
  // Scalar centres: a Vec3 temporary costs a heap allocation per item.
  let low_x = 1000000000.0
  let low_y = 1000000000.0
  let low_z = 1000000000.0
  let high_x = (-1000000000.0)
  let high_y = (-1000000000.0)
  let high_z = (-1000000000.0)
  for b in items:
    let x = (b.low.x + b.high.x) * 0.5
    let y = (b.low.y + b.high.y) * 0.5
    let z = (b.low.z + b.high.z) * 0.5
    low_x := min self x
    low_y := min self y
    low_z := min self z
    high_x := max self x
    high_y := max self y
    high_z := max self z
  let keys = @array.generate n (fn (i: U32) => do:
    let b = items[i]
    let x = (b.low.x + b.high.x) * 0.5
    let y = (b.low.y + b.high.y) * 0.5
    let z = (b.low.z + b.high.z) * 0.5
    return spread (quantize x low_x high_x) | (spread (quantize y low_y high_y) << 1) | (spread (quantize z low_z high_z) << 2))
  let order = sort.order_u32 keys
  let base = 1
  for 0..31:
    if base >= n:
      break
    base := self * 2
  let bounds = @array.fill (base * 12) 0.0
  for node in 0..(base * 2):
    let o = node * 6
    bounds[o] := 1000000000.0
    bounds[o + 1] := 1000000000.0
    bounds[o + 2] := 1000000000.0
    bounds[o + 3] := (-1000000000.0)
    bounds[o + 4] := (-1000000000.0)
    bounds[o + 5] := (-1000000000.0)
  let leaves = @array.fill n 0
  for i in 0..n:
    let node = base + i
    let o = node * 6
    let b = items[order[i]]
    leaves[order[i]] := node
    bounds[o] := b.low.x
    bounds[o + 1] := b.low.y
    bounds[o + 2] := b.low.z
    bounds[o + 3] := b.high.x
    bounds[o + 4] := b.high.y
    bounds[o + 5] := b.high.z
  for k in 1..base:
    let node = base - k
    let o = node * 6
    let a = node * 12
    let b = a + 6
    for axis in 0..3:
      bounds[o + axis] := min bounds[a + axis] bounds[b + axis]
      bounds[o + 3 + axis] := max bounds[a + 3 + axis] bounds[b + 3 + axis]
  return #Index { base, bounds, order, leaves }

// The changed item indices and their replacement bounds are parallel arrays.
const refit = fn (index: Index) => fn (changed: Array U32) => fn (items: Array Bounds) => do:
  if changed.is_empty:
    return index
  let bounds = @array.generate index.bounds.length (fn (i: U32) => index.bounds[i])
  for i in 0..changed.length:
    let item = changed[i]
    if item < index.leaves.length:
      let node = index.leaves[item]
      let o = node * 6
      let b = items[i]
      bounds[o] := b.low.x
      bounds[o + 1] := b.low.y
      bounds[o + 2] := b.low.z
      bounds[o + 3] := b.high.x
      bounds[o + 4] := b.high.y
      bounds[o + 5] := b.high.z
  for i in 0..changed.length:
    let item = changed[i]
    if item < index.leaves.length:
      let node = index.leaves[item] / 2
      for 0..32:
        if node > 0:
          let o = node * 6
          let a = node * 12
          let b = a + 6
          for axis in 0..3:
            let low_a = bounds[a + axis]
            let low_b = bounds[b + axis]
            let high_a = bounds[a + 3 + axis]
            let high_b = bounds[b + 3 + axis]
            bounds[o + axis] := min low_a low_b
            bounds[o + 3 + axis] := max high_a high_b
          node := self / 2
  index.bounds := bounds
  return index

// Candidate item indices in caller order, inclusive of touching bounds.
const query = fn (index: Index) => fn (low: Vec3) => fn (high: Vec3) => do:
  // Private level builders retain ownership without an early-exit traversal.
  // Only intersecting branches expand; empty frontiers cost no node visits.
  let nodes = #[1]
  let found: List U32 = []
  for 0..32:
    if Bool.not nodes.is_empty:
      let next: List U32 = []
      for node in nodes:
        let o = node * 6
        let b = index.bounds
        if low.x <= b[o + 3] && high.x >= b[o] && low.y <= b[o + 4] && high.y >= b[o + 1] && low.z <= b[o + 5] && high.z >= b[o + 2]:
          if node >= index.base:
            let leaf = node - index.base
            if leaf < index.order.length:
              let item = index.order[leaf]
              found := [...self, item]
          else:
            let left = node * 2
            let right = left + 1
            next := [...self, left]
            next := [...self, right]
      nodes := Array.from_list next
  let ids = Array.from_list found
  let order = sort.order_u32 ids
  return @array.generate ids.length (fn (i: U32) => ids[order[i]])

// A uniform grid of square cells over the floor plane (x, z), bucketing
// points so a neighbour query visits the points near it rather than all of
// them. Cell `c` (row-major from `left`, `front`) holds
// items[starts[c] .. starts[c + 1]], point indices ascending. Points with a
// non-finite x or z are left out. The cells span the points' bounds; where
// cells of `size` would number more than four a point (plus 64), they grow
// until they do not, and a size that is not positive and finite makes one
// cell of them all.
type Cells is data = #Cells { left: F32, front: F32, size: F32, columns: U32, rows: U32, starts: Array U32, items: Array U32 }

const cells = fn (size: F32) => fn (points: Array Vec3) => do:
  let n = points.length
  let left = 1000000000.0
  let right = (-1000000000.0)
  let front = 1000000000.0
  let back = (-1000000000.0)
  let finite = 0
  for i in 0..n:
    let x = points[i].x
    let z = points[i].z
    if is_finite x && is_finite z:
      left := min self x
      right := max self x
      front := min self z
      back := max self z
      finite := self + 1
  if finite == 0:
    return #Cells { left: 0.0, front: 0.0, size: 1.0, columns: 1, rows: 1, starts: #[0, 0], items: #[] }
  let width = right - left
  let depth = back - front
  let limit = U32.to_f32 (finite * 4 + 64)
  let side = size
  if Bool.not (is_finite side && side > 0.0):
    side := max 1.0 (max width depth) * 2.0
  for 0..64:
    if (floor (width / side) + 1.0) * (floor (depth / side) + 1.0) > limit:
      side := self * 2.0
  let columns = F32.to_u32 (floor (width / side)) + 1
  let rows = F32.to_u32 (floor (depth / side)) + 1
  let total = columns * rows
  let column_of = fn (x: F32) => F32.to_u32 (clamp 0.0 (U32.to_f32 (columns - 1)) (floor ((x - left) / side)))
  let row_of = fn (z: F32) => F32.to_u32 (clamp 0.0 (U32.to_f32 (rows - 1)) (floor ((z - front) / side)))
  let cell_of = @array.generate n (fn (i: U32) => do:
    let x = points[i].x
    let z = points[i].z
    if is_finite x && is_finite z:
      return row_of z * columns + column_of x
    return total)
  let counts = @array.fill (total + 1) 0
  for i in 0..n:
    let c = cell_of[i]
    counts[c] := self + 1
  let starts = @array.fill (total + 1) 0
  let running = 0
  for c in 0..total:
    starts[c] := running
    running := self + counts[c]
  starts[total] := running
  let cursor = @array.generate total (fn (c: U32) => starts[c])
  let items = @array.fill running 0
  for i in 0..n:
    let c = cell_of[i]
    if c < total:
      let at = cursor[c]
      items[at] := i
      cursor[c] := at + 1
  return #Cells { left, front, size: side, columns, rows, starts, items }

// Whether bounds are finite and ordered over the floor plane.
const flat = fn (b: Bounds) =>
  is_finite b.low.x && is_finite b.high.x && is_finite b.low.z && is_finite b.high.z && b.low.x <= b.high.x && b.low.z <= b.high.z

// Items with extent bucketed like `cells`: item `i` is listed in every cell
// its bounds' x and z overlap, so cell `c` holds the indices of the items
// that may cover it, ascending. Items with non-finite or inverted bounds are
// left out. The cells span the listed bounds. Cells of `size` grow by a
// quarter until they number at most four an item and list at most eight an
// item (each plus 64); a size that is not positive and finite starts from
// half the square root of the bounds' area per item. A point's cell is found
// with `span` and no reach.
const areas = fn (size: F32) => fn (bounds: Array Bounds) => do:
  let n = bounds.length
  let left = 3.402823466e38
  let right = (-3.402823466e38)
  let front = 3.402823466e38
  let back = (-3.402823466e38)
  let finite = 0
  for b in bounds:
    if flat b:
      left := min self b.low.x
      right := max self b.high.x
      front := min self b.low.z
      back := max self b.high.z
      finite := self + 1
  if finite == 0:
    return #Cells { left: 0.0, front: 0.0, size: 1.0, columns: 1, rows: 1, starts: #[0, 0], items: #[] }
  let width = min 3e38 (right - left)
  let depth = min 3e38 (back - front)
  let limit = U32.to_f32 (finite * 4 + 64)
  let side = size
  if Bool.not (is_finite side && side > 0.0):
    side := 0.5 * sqrt (width / U32.to_f32 finite * depth)
  side := max self (max width depth / limit)
  if Bool.not (is_finite side && side > 0.0):
    side := max 1.0 (max width depth)
  let fitted = #False
  for 0..64:
    if Bool.not fitted:
      let wide = floor (width / side) + 1.0
      let deep = floor (depth / side) + 1.0
      let listed = 0.0
      if wide * deep <= limit:
        for b in bounds:
          if flat b:
            let low_x = clamp 0.0 (wide - 1.0) (floor ((b.low.x - left) / side))
            let high_x = clamp 0.0 (wide - 1.0) (floor ((b.high.x - left) / side))
            let low_z = clamp 0.0 (deep - 1.0) (floor ((b.low.z - front) / side))
            let high_z = clamp 0.0 (deep - 1.0) (floor ((b.high.z - front) / side))
            listed := self + (high_x - low_x + 1.0) * (high_z - low_z + 1.0)
        if listed <= limit * 2.0:
          fitted := #True
      if Bool.not fitted:
        side := self * 1.25
  if Bool.not fitted:
    side := max self (max width depth)
  let columns = F32.to_u32 (floor (width / side)) + 1
  let rows = F32.to_u32 (floor (depth / side)) + 1
  let total = columns * rows
  let counts = @array.fill (total + 1) 0
  for b in bounds:
    if flat b:
      let low_x = min (columns - 1) (F32.to_u32 (floor ((b.low.x - left) / side)))
      let high_x = min (columns - 1) (F32.to_u32 (floor ((b.high.x - left) / side)))
      let low_z = min (rows - 1) (F32.to_u32 (floor ((b.low.z - front) / side)))
      let high_z = min (rows - 1) (F32.to_u32 (floor ((b.high.z - front) / side)))
      for row in low_z..(high_z + 1):
        for column in low_x..(high_x + 1):
          let c = row * columns + column
          counts[c] := self + 1
  let starts = @array.fill (total + 1) 0
  let running = 0
  for c in 0..total:
    starts[c] := running
    running := self + counts[c]
  starts[total] := running
  let cursor = @array.generate total (fn (c: U32) => starts[c])
  let items = @array.fill running 0
  for i in 0..n:
    let b = bounds[i]
    if flat b:
      let low_x = min (columns - 1) (F32.to_u32 (floor ((b.low.x - left) / side)))
      let high_x = min (columns - 1) (F32.to_u32 (floor ((b.high.x - left) / side)))
      let low_z = min (rows - 1) (F32.to_u32 (floor ((b.low.z - front) / side)))
      let high_z = min (rows - 1) (F32.to_u32 (floor ((b.high.z - front) / side)))
      for row in low_z..(high_z + 1):
        for column in low_x..(high_x + 1):
          let c = row * columns + column
          let at = cursor[c]
          items[at] := i
          cursor[c] := at + 1
  return #Cells { left, front, size: side, columns, rows, starts, items }

// The cells a square of half-width `reach` about (x, z) overlaps, as
// (first column, last column, first row, last row).
const span = fn (grid: Cells) => fn (x: F32) => fn (z: F32) => fn (reach: F32) => do:
  let last_column = U32.to_f32 (grid.columns - 1)
  let last_row = U32.to_f32 (grid.rows - 1)
  let low_x = clamp 0.0 last_column (floor ((x - reach - grid.left) / grid.size))
  let high_x = clamp 0.0 last_column (floor ((x + reach - grid.left) / grid.size))
  let low_z = clamp 0.0 last_row (floor ((z - reach - grid.front) / grid.size))
  let high_z = clamp 0.0 last_row (floor ((z + reach - grid.front) / grid.size))
  return (F32.to_u32 low_x, F32.to_u32 high_x, F32.to_u32 low_z, F32.to_u32 high_z)

// Indices of the points within `radius` of `at`, ascending. `points` are
// those the cells were made from.
const near = fn (grid: Cells) => fn (points: Array Vec3) => fn (at: Vec3) => fn (radius: F32) => do:
  if Bool.not (math.finite3 at && is_finite radius) || radius < 0.0:
    let none: Array U32 = #[]
    return none
  let (low_x, high_x, low_z, high_z) = span grid at.x at.z radius
  let squared = radius * radius
  let found: List U32 = []
  for row in low_z..(high_z + 1):
    for column in low_x..(high_x + 1):
      let c = row * grid.columns + column
      for slot in grid.starts[c]..grid.starts[c + 1]:
        let item = grid.items[slot]
        let delta = points[item] - at
        if delta.length_squared <= squared:
          found := [...self, item]
  let ids = Array.from_list found
  let order = sort.order_u32 ids
  return @array.generate ids.length (fn (i: U32) => ids[order[i]])
