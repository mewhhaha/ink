import { Vec3 } from "std/vector"
import * as math from "./math"
import * as sort from "./sort"
import * as array from "std/array"
import * as changes from "./changes"

// Caller-owned flat bounding-volume tree. Refit hands the updated index back.
// Callers explicitly copy an index before retaining a snapshot.
type Bounds is data = $Bounds { low: Vec3, high: Vec3 }
type Index is data = $Index { base: U32, bounds: ResizeArray F32, order: ResizeArray U32, leaves: ResizeArray U32 }
func node_page (index: Index) -> node => return &index.bounds[0..index.bounds.length]
func node_offset (index: Index) -> node => return node * 6
func flat_bounds (index: Index) => return &index.bounds[0..index.bounds.length]
// Named persistent destination pools use the same direct descriptor ABI.
func owned (values: Array a) : ResizeArray a => return do:
  let out: ResizeArray a = #[]
  for value in values:
    @storage.push out value
  return out
func replace (destination: ResizeArray a) -> (source: ResizeArray a) => return do:
  let saved = @storage.copy source
  @storage.truncate destination 0
  for value in saved:
    @storage.push destination value
// Inputs are independently named construction arrays, so destination reset
// cannot invalidate them and needs no second snapshot.
func replace_fixed (destination: ResizeArray a) -> (source: Array a) => return do:
  @storage.truncate destination 0
  for value in source:
    @storage.push destination value
  return ()
func copy_into (destination: own Index) -> (source: Index) : Index => return do:
  replace destination.bounds source.bounds
  replace destination.order source.order
  replace destination.leaves source.leaves
  destination.base := source.base
  return destination
func access (base: U32) -> (bounds: own ResizeArray F32) -> (order: own ResizeArray U32) -> (leaves: own ResizeArray U32) : Index => return
  $Index { base, bounds, order, leaves }
func build_into (destination: own Index) -> (items: Array Bounds) : Index => return do:
  let base = with_built items (func base -> bounds -> order -> leaves => return do:
    replace_fixed destination.bounds bounds
    replace_fixed destination.order order
    replace_fixed destination.leaves leaves
    return base)
  destination.base := base
  return destination

func with_index (items: Array Bounds) -> consume => return do:
  let bounds: ResizeArray F32 = #[]
  let order: ResizeArray U32 = #[]
  let leaves: ResizeArray U32 = #[]
  return consume (own (build_into (access 0 bounds order leaves) items))

func spread (value: U32) => return do:
  let v = value & 1023
  v := (self | (self << 16)) & 50331903
  v := (self | (self << 8)) & 50393103
  v := (self | (self << 4)) & 51130563
  return (v | (v << 2)) & 153391689

func quantize (value: F32) => return func (low: F32) => return func (high: F32) => return do:
  if high <= low:
    return 0
  return F32.to_u32 (clamp 0.0 1023.0 ((value - low) / (high - low) * 1023.0))

func with_built (items: Array Bounds) -> consume => return do:
  let n = items.length
  // Scalar centres: a Vec3 temporary costs a heap allocation per item.
  let low_x = 1000000000.0
  let low_y = 1000000000.0
  let low_z = 1000000000.0
  let high_x = (-1000000000.0)
  let high_y = (-1000000000.0)
  let high_z = (-1000000000.0)
  for b in items:
    let x = (b.low.x + b.high.x) * 0.5
    let y = (b.low.y + b.high.y) * 0.5
    let z = (b.low.z + b.high.z) * 0.5
    low_x := min self x
    low_y := min self y
    low_z := min self z
    high_x := max self x
    high_y := max self y
    high_z := max self z
  let keys = @array.generate n (func (i: U32) => return do:
    let b = items[i]
    let x = (b.low.x + b.high.x) * 0.5
    let y = (b.low.y + b.high.y) * 0.5
    let z = (b.low.z + b.high.z) * 0.5
    return spread (quantize x low_x high_x) | (spread (quantize y low_y high_y) << 1) | (spread (quantize z low_z high_z) << 2))
  let order = sort.order_u32 keys
  let base = 1
  for 0..31:
    if base >= n:
      break
    base := self * 2
  let bounds = @array.generate (base * 12) (func i => return
    if i % 6 < 3 then 1000000000.0 else (-1000000000.0))
  let leaves = @array.fill n 0
  for i in 0..n:
    let node = base + i
    let o = node * 6
    let b = items[order[i]]
    leaves[order[i]] := node
    bounds[o] := b.low.x
    bounds[o + 1] := b.low.y
    bounds[o + 2] := b.low.z
    bounds[o + 3] := b.high.x
    bounds[o + 4] := b.high.y
    bounds[o + 5] := b.high.z
  for k in 1..base:
    let node = base - k
    let o = node * 6
    let a = node * 12
    let b = a + 6
    for axis in 0..3:
      bounds[o + axis] := min bounds[a + axis] bounds[b + axis]
      bounds[o + 3 + axis] := max bounds[a + 3 + axis] bounds[b + 3 + axis]
  // Construction and read-only queries keep contiguous storage. Convert once
  // on the first sparse update, so static and dense workloads pay no paging.
  return consume base bounds order leaves

// The changed item indices and their replacement bounds are parallel arrays.
func refit_dense (index: own Index) -> (changed: Array U32) -> (items: Array Bounds) : Index => return do:
  if changed.length != items.length:
    return @panic "spatial refit length mismatch"
  if changed.is_empty:
    return index
  for i in 0..changed.length:
    let item = changed[i]
    if item < index.leaves.length:
      let node = index.leaves[item]
      let o = node * 6
      let b = items[i]
      index.bounds[o] := b.low.x
      index.bounds[o + 1] := b.low.y
      index.bounds[o + 2] := b.low.z
      index.bounds[o + 3] := b.high.x
      index.bounds[o + 4] := b.high.y
      index.bounds[o + 5] := b.high.z
  // Every branch holds its children's union, so recomputing all of them,
  // children first, gives the same bounds as walking each changed leaf's path.
  // Many changes recompute every branch once rather than shared paths often.
  let base = index.base
  let depth = 1
  for 0..32:
    if (1 << depth) < base:
      depth := self + 1
  let dense = changed.length >= base / depth
  let branches = if dense then base else 1
  let walks = if dense then 0 else changed.length
  for k in 1..branches:
    let node = base - k
    let o = node * 6
    let a = node * 12
    let b = a + 6
    for axis in 0..3:
      index.bounds[o + axis] := min index.bounds[a + axis] index.bounds[b + axis]
      index.bounds[o + 3 + axis] := max index.bounds[a + 3 + axis] index.bounds[b + 3 + axis]
  for i in 0..walks:
    let item = changed[i]
    if item < index.leaves.length:
      let node = index.leaves[item] / 2
      for 0..32:
        if node > 0:
          let o = node * 6
          let a = node * 12
          let b = a + 6
          for axis in 0..3:
            index.bounds[o + axis] := min index.bounds[a + axis] index.bounds[b + axis]
            index.bounds[o + 3 + axis] := max index.bounds[a + 3 + axis] index.bounds[b + 3 + axis]
          node := self / 2
  return index

// Dirty rows mutate the flat cache directly. Duplicate edits keep the final
// input value; the dense/ancestor choice changes work only, never ownership.
func refit (index: own Index) -> (changed: Array U32) -> (items: Array Bounds) : Index => return
  refit_dense index changed items

// Candidate item indices in caller order, inclusive of touching bounds.
func query (index: Index) => return func (low: Vec3) => return func (high: Vec3) => return do:
  // Depth-first with a private stack: only intersecting branches expand, and
  // the walk stops when the stack empties. A tree has at most 32 levels, so
  // the stack never holds more than 33 nodes; each node is visited once.
  let lx = low.x
  let ly = low.y
  let lz = low.z
  let hx = high.x
  let hy = high.y
  let hz = high.z
  let base = index.base
  let order = index.order
  let bounds = index.bounds
  let limit = if base >= 2147483648 then 4294967295 else base * 2
  let stack = @array.fill 64 0
  stack[0] := 1
  let top = 1
  let found: GrowArray U32 = #[]
  for 0..limit:
    if top == 0:
      break
    top := self - 1
    let node = stack[top]
    let o = node * 6
    if lx <= bounds[o + 3] and hx >= bounds[o] and ly <= bounds[o + 4] and hy >= bounds[o + 1] and lz <= bounds[o + 5] and hz >= bounds[o + 2]:
      if node >= base:
        let leaf = node - base
        if leaf < order.length:
          let item = order[leaf]
          found.push item
      else:
        stack[top] := node * 2 + 1
        stack[top + 1] := node * 2
        top := self + 2
  let ids = (@storage.freeze found)
  let ascending = true
  for i in 1..ids.length:
    if ids[i - 1] > ids[i]:
      ascending := false
  if ascending:
    return ids
  let ranks = sort.order_u32 ids
  return @array.generate ids.length (func (i: U32) => return ids[ranks[i]])

// A uniform grid of square cells over the floor plane (x, z), bucketing
// points so a neighbour query visits the points near it rather than all of
// them. Cell `c` (row-major from `left`, `front`) holds
// items[starts[c] .. starts[c + 1]], point indices ascending. Points with a
// non-finite x or z are left out. The cells span the points' bounds; where
// cells of `size` would number more than four a point (plus 64), they grow
// until they do not, and a size that is not positive and finite makes one
// cell of them all.
type Cells [starts, items] is data = $Cells { left: F32, front: F32, size: F32, columns: U32, rows: U32, starts: starts, items: items }

func with_cells (size: F32) -> (points: Array Vec3) -> consume => return do:
  let n = points.length
  let left = 1000000000.0
  let right = (-1000000000.0)
  let front = 1000000000.0
  let back = (-1000000000.0)
  let finite = 0
  for i in 0..n:
    let x = points[i].x
    let z = points[i].z
    if is_finite x and is_finite z:
      left := min self x
      right := max self x
      front := min self z
      back := max self z
      finite := self + 1
  if finite == 0:
    let starts: Array U32 = #[0, 0]
    let items: Array U32 = #[]
    return consume ($Cells { left: 0.0, front: 0.0, size: 1.0, columns: 1, rows: 1, starts: &starts[0..2], items: &items[0..0] })
  let width = right - left
  let depth = back - front
  let limit = U32.to_f32 (finite * 4 + 64)
  let side = size
  if Bool.not (is_finite side and side > 0.0):
    side := max 1.0 (max width depth) * 2.0
  for 0..64:
    if (floor (width / side) + 1.0) * (floor (depth / side) + 1.0) > limit:
      side := self * 2.0
  let columns = F32.to_u32 (floor (width / side)) + 1
  let rows = F32.to_u32 (floor (depth / side)) + 1
  let total = columns * rows
  let column_of = func (x: F32) => return F32.to_u32 (clamp 0.0 (U32.to_f32 (columns - 1)) (floor ((x - left) / side)))
  let row_of = func (z: F32) => return F32.to_u32 (clamp 0.0 (U32.to_f32 (rows - 1)) (floor ((z - front) / side)))
  let cell_of = @array.generate n (func (i: U32) => return do:
    let x = points[i].x
    let z = points[i].z
    if is_finite x and is_finite z:
      return row_of z * columns + column_of x
    return total)
  let counts = @array.fill (total + 1) 0
  for i in 0..n:
    let c = cell_of[i]
    counts[c] := self + 1
  let starts = @array.fill (total + 1) 0
  let running = 0
  for c in 0..total:
    starts[c] := running
    running := self + counts[c]
  starts[total] := running
  let cursor = @array.generate total (func (c: U32) => return starts[c])
  let items = @array.fill running 0
  for i in 0..n:
    let c = cell_of[i]
    if c < total:
      let at = cursor[c]
      items[at] := i
      cursor[c] := at + 1
  return consume ($Cells { left, front, size: side, columns, rows, starts: &starts[0..starts.length], items: &items[0..items.length] })

// Whether bounds are finite and ordered over the floor plane.
func flat (b: Bounds) => return
  is_finite b.low.x and is_finite b.high.x and is_finite b.low.z and is_finite b.high.z and b.low.x <= b.high.x and b.low.z <= b.high.z

// Items with extent bucketed like `cells`: item `i` is listed in every cell
// its bounds' x and z overlap, so cell `c` holds the indices of the items
// that may cover it, ascending. Items with non-finite or inverted bounds are
// left out. The cells span the listed bounds. Cells of `size` grow by a
// quarter until they number at most four an item and list at most eight an
// item (each plus 64); a size that is not positive and finite starts from
// half the square root of the bounds' area per item. A point's cell is found
// with `span` and no reach.
func with_areas (size: F32) -> (bounds: Array Bounds) -> consume => return do:
  let n = bounds.length
  let left = 3.402823466e38
  let right = (-3.402823466e38)
  let front = 3.402823466e38
  let back = (-3.402823466e38)
  let finite = 0
  for b in bounds:
    if flat b:
      left := min self b.low.x
      right := max self b.high.x
      front := min self b.low.z
      back := max self b.high.z
      finite := self + 1
  if finite == 0:
    let starts: Array U32 = #[0, 0]
    let items: Array U32 = #[]
    return consume ($Cells { left: 0.0, front: 0.0, size: 1.0, columns: 1, rows: 1, starts: &starts[0..2], items: &items[0..0] })
  let width = min 3e38 (right - left)
  let depth = min 3e38 (back - front)
  let limit = U32.to_f32 (finite * 4 + 64)
  let side = size
  if Bool.not (is_finite side and side > 0.0):
    side := 0.5 * sqrt (width / U32.to_f32 finite * depth)
  side := max self (max width depth / limit)
  if Bool.not (is_finite side and side > 0.0):
    side := max 1.0 (max width depth)
  let fitted = false
  for 0..64:
    if Bool.not fitted:
      let wide = floor (width / side) + 1.0
      let deep = floor (depth / side) + 1.0
      let listed = 0.0
      if wide * deep <= limit:
        for b in bounds:
          if flat b:
            let low_x = clamp 0.0 (wide - 1.0) (floor ((b.low.x - left) / side))
            let high_x = clamp 0.0 (wide - 1.0) (floor ((b.high.x - left) / side))
            let low_z = clamp 0.0 (deep - 1.0) (floor ((b.low.z - front) / side))
            let high_z = clamp 0.0 (deep - 1.0) (floor ((b.high.z - front) / side))
            listed := self + (high_x - low_x + 1.0) * (high_z - low_z + 1.0)
        if listed <= limit * 2.0:
          fitted := true
      if Bool.not fitted:
        side := self * 1.25
  if Bool.not fitted:
    side := max self (max width depth)
  let columns = F32.to_u32 (floor (width / side)) + 1
  let rows = F32.to_u32 (floor (depth / side)) + 1
  let total = columns * rows
  let counts = @array.fill (total + 1) 0
  for b in bounds:
    if flat b:
      let low_x = min (columns - 1) (F32.to_u32 (floor ((b.low.x - left) / side)))
      let high_x = min (columns - 1) (F32.to_u32 (floor ((b.high.x - left) / side)))
      let low_z = min (rows - 1) (F32.to_u32 (floor ((b.low.z - front) / side)))
      let high_z = min (rows - 1) (F32.to_u32 (floor ((b.high.z - front) / side)))
      for row in low_z..(high_z + 1):
        for column in low_x..(high_x + 1):
          let c = row * columns + column
          counts[c] := self + 1
  let starts = @array.fill (total + 1) 0
  let running = 0
  for c in 0..total:
    starts[c] := running
    running := self + counts[c]
  starts[total] := running
  let cursor = @array.generate total (func (c: U32) => return starts[c])
  let items = @array.fill running 0
  for i in 0..n:
    let b = bounds[i]
    if flat b:
      let low_x = min (columns - 1) (F32.to_u32 (floor ((b.low.x - left) / side)))
      let high_x = min (columns - 1) (F32.to_u32 (floor ((b.high.x - left) / side)))
      let low_z = min (rows - 1) (F32.to_u32 (floor ((b.low.z - front) / side)))
      let high_z = min (rows - 1) (F32.to_u32 (floor ((b.high.z - front) / side)))
      for row in low_z..(high_z + 1):
        for column in low_x..(high_x + 1):
          let c = row * columns + column
          let at = cursor[c]
          items[at] := i
          cursor[c] := at + 1
  return consume ($Cells { left, front, size: side, columns, rows, starts: &starts[0..starts.length], items: &items[0..items.length] })

// The cells a square of half-width `reach` about (x, z) overlaps, as
// (first column, last column, first row, last row).
func span (grid: Cells [&[U32], &[U32]]) => return func (x: F32) => return func (z: F32) => return func (reach: F32) => return do:
  let last_column = U32.to_f32 (grid.columns - 1)
  let last_row = U32.to_f32 (grid.rows - 1)
  let low_x = clamp 0.0 last_column (floor ((x - reach - grid.left) / grid.size))
  let high_x = clamp 0.0 last_column (floor ((x + reach - grid.left) / grid.size))
  let low_z = clamp 0.0 last_row (floor ((z - reach - grid.front) / grid.size))
  let high_z = clamp 0.0 last_row (floor ((z + reach - grid.front) / grid.size))
  return (F32.to_u32 low_x, F32.to_u32 high_x, F32.to_u32 low_z, F32.to_u32 high_z)

// Indices of the points within `radius` of `at`, ascending. `points` are
// those the cells were made from.
func near (grid: Cells [&[U32], &[U32]]) => return func (points: Array Vec3) => return func (at: Vec3) => return func (radius: F32) => return do:
  if Bool.not (math.finite3 at and is_finite radius) or radius < 0.0:
    let none: Array U32 = #[]
    return none
  let (low_x, high_x, low_z, high_z) = span grid at.x at.z radius
  let squared = radius * radius
  // The offset's squared length as Vec3 computes it, without a temporary.
  let ax = at.x
  let ay = at.y
  let az = at.z
  let found: GrowArray U32 = #[]
  for row in low_z..(high_z + 1):
    for column in low_x..(high_x + 1):
      let c = row * grid.columns + column
      for slot in grid.starts[c]..grid.starts[c + 1]:
        let item = grid.items[slot]
        let p = points[item]
        let dx = p.x - ax
        let dy = p.y - ay
        let dz = p.z - az
        if dx * dx + dy * dy + dz * dz <= squared:
          found.push item
  let ids = (@storage.freeze found)
  let ascending = true
  for i in 1..ids.length:
    if ids[i - 1] > ids[i]:
      ascending := false
  if ascending:
    return ids
  let order = sort.order_u32 ids
  return @array.generate ids.length (func (i: U32) => return ids[order[i]])

// Existence queries need no candidate array or source-order sort. The pure
// predicate may be called in tree order and is skipped after the first match.
func any (index: Index) -> (low: Vec3) -> (high: Vec3) -> (accept: U32 -> Bool) => return do:
  let stack = array.fill 64 0
  stack[0] := 1
  let top = 1
  for 0 .. index.base * 2:
    if top == 0:
      break
    top := self - 1
    let node = stack[top]
    let bounds = node_page index node
    let o = node_offset index node
    if low.x <= bounds[o + 3] and high.x >= bounds[o] and low.y <= bounds[o + 4] and high.y >= bounds[o + 1] and low.z <= bounds[o + 5] and high.z >= bounds[o + 2]:
      if node >= index.base:
        let leaf = node - index.base
        if leaf < index.order.length and accept index.order[leaf]:
          return true
      else:
        stack[top] := node * 2 + 1
        stack[top + 1] := node * 2
        top := self + 2
  return false

type Nearest value is data = $Nearest { index: U32, time: F32, value: value }
// `lower lanes offset` bounds the score of every descendant (six AABB lanes
// low xyz, high xyz). It must be conservative. Infinity rejects a branch.
// Test/score are pure; smaller source index breaks exact equal-score ties.
func closest (index: Index) -> (lower: &[F32] -> U32 -> F32) -> test -> score -> (limit: F32) => return do:
  let stack = array.fill 64 0
  let times = array.fill 64 0.0
  stack[0] := 1
  times[0] := lower (node_page index 1) (node_offset index 1)
  let top = 1
  let best = $Nothing
  let best_index = 0xFFFFFFFF
  let best_time = limit
  for 0 .. index.base * 2:
    if top == 0:
      break
    top := self - 1
    let node = stack[top]
    if times[top] < (1.0 / 0.0) and times[top] <= best_time:
      if node >= index.base:
        let leaf = node - index.base
        if leaf < index.order.length:
          let id = index.order[leaf]
          if let $Some value = test id:
            let time = score value
            if time <= limit and (time < best_time or (time == best_time and id < best_index)):
              best := $Some value
              best_time := time
              best_index := id
      else:
        let a = node * 2
        let b = a + 1
        let ta = lower (node_page index a) (node_offset index a)
        let tb = lower (node_page index b) (node_offset index b)
        let first = ta <= tb
        stack[top] := if first then b else a
        stack[top + 1] := if first then a else b
        times[top] := if first then tb else ta
        times[top + 1] := if first then ta else tb
        top := self + 2
  return Maybe.map (func value => return $Nearest { index: best_index, time: best_time, value }) best
