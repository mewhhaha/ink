//! Ranges borrow the current pages. Keep an independent snapshot with copy_using.
//! Element payloads are fixed-layout rows; variable data uses caller-owned
//! pools plus spans/borrowed views/links, never owning array fields.
//!
//! Key items: [`Pages`], [`length`], [`empty`], [`from`], [`count`].

import * as array from "std/array"
import * as changes from "./changes"

type Pages a = #[a]
const size: U32 = 64
func length (count: U32) => (count >> 6) + (if count & 63 == 0 then 0 else 1)
func empty () : Pages a => #[]
func from (values: #[a]) : Pages a =>
  return @storage.copy values
func count (stored: Pages a) => stored.length
func get (stored: Pages a) -> (index: U32) => stored[index]
func set (index: U32) -> (value: a) -> (stored: own Pages a) : Pages a =>
  stored[index] := value
  return stored
func push (value: a) -> (stored: own Pages a) : Pages a =>
  @storage.push stored value
  return stored
func page_at (page: U32) -> (stored: Pages a) =>
  if page >= length stored.length:
    return panic "page outside storage"
  let start = page << 6
  return &stored[start..min stored.length (start + size)]
func flatten (stored: Pages a) => (copy stored)
func copy_using copy_value -> (stored: Pages a) => return
  array.generate stored.length (func i => copy_value stored[i])
func truncate (count: U32) -> (stored: own Pages a) : Pages a =>
  @storage.truncate stored count
  return stored
func fold reduce -> initial -> (stored: Pages a) =>
  let state = initial
  let count = stored.length
  for i in 0 .. count:
    state := reduce self stored[i]
  return state
// Explicit replacement is a mutation boundary; old views must have ended.
func replace (values: #[a]) -> (stored: own Pages a) : Pages a =>
  let s_len = values.length
  let d_len = stored.length
  let common = min s_len d_len
  for i in 0 .. common:
    stored[i] := values[i]
  if s_len > common:
    @storage.extend stored (&values[common..s_len])
  if d_len > s_len:
    @storage.truncate stored s_len
  return stored
// Sparse mutation visits dirty rows and appended rows once. All callback inputs
// are explicit; callbacks must not resize the owner being updated.
func update (count: U32) -> (dirty: #[U32]) -> value -> (stored: own Pages a) : Pages a =>
  let n = dirty.length
  if n == 0:
    return resize_rows count stored.length value stored
  let first = dirty[0]
  let last = dirty[n - 1]
  if last != 0xFFFFFFFF and last >= first and last - first == n - 1:
    let expected = first
    let contiguous = true
    for id in dirty:
      if id != expected:
        contiguous := false
        break
      expected := self + 1
    if contiguous:
      return update_range count first (last + 1) value stored
    // With this span, any gap forces a duplicate or reversal elsewhere.
  else:
    let previous = first
    let ordered = true
    for i in 1 .. n:
      let id = dirty[i]
      if id <= previous:
        ordered := false
        break
      previous := id
    if ordered:
      return update_ordered count dirty value stored
  let selected = changes.unique dirty
  return update_ordered count selected value stored

// Dirty IDs must be strictly increasing. Resizing invokes appended rows once.
func update_ordered (count: U32) -> dirty -> value -> (stored: own Pages a) : Pages a =>
  let before = stored.length
  let limit = min count before
  for i in 0 .. dirty.length:
    let index = dirty.at i
    if index >= limit:
      break
    stored[index] := value index
  return resize_rows count before value stored

func update_range (count: U32) -> (first: U32) -> (end: U32) -> value -> (stored: own Pages a) : Pages a =>
  let before = stored.length
  for index in first .. min end (min count before):
    stored[index] := value index
  return resize_rows count before value stored

private func resize_rows (count: U32) -> (before: U32) -> value -> (stored: own Pages a) : Pages a =>
  if count > before:
    @storage.reserve stored (count - before)
    for index in before .. count:
      @storage.push stored (value index)
  if count < before:
    @storage.truncate stored count
  return stored
// Leaf callbacks receive independent bounded copies; their returned rows are
// written directly. Old whole collections are not automatically preserved.
func update_pages (count: U32) -> (dirty: #[U32]) -> value -> (stored: own Pages a) : Pages a =>
  let before = stored.length
  let selected = changes.unique dirty
  let end = length count
  let resized = if count > before then before >> 6 else if count < before and (count & 63) != 0 then count >> 6 else end
  let at: U32 = 0
  for ever:
    let dirty_page = if at < selected.length then min end selected[at] else end
    let page = min dirty_page resized
    if page >= end:
      break
    if page == dirty_page:
      at := self + 1
    if page == resized:
      resized := self + 1
    stored := update_page page count before value stored
  if count < before:
    @storage.truncate stored count
  return stored

// Keep the independent callback input and result local to one invocation.
private func update_page (page: U32) -> (count: U32) -> (before: U32) -> value -> (stored: own Pages a) : Pages a =>
  let start = page << 6
  let take = min size (count - start)
  let old_take = if start < before then min size (before - start) else 0
  let old = array.generate old_take (func i => stored[start + i])
  let next = value page old
  if next.length != take:
    return panic "page callback returned the wrong length"
  for i in 0 .. take:
    if start + i < stored.length:
      stored[start + i] := next[i]
    else:
      @storage.push stored next[i]
  return stored
