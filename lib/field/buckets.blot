import * as array from "std/array"
import * as field from "../field"

// Stable region indices per tile, stored as one prefix table and one index
// array. The three owners remain separately named by the caller. Returned views
// last until those owners are resized; destinations must be distinct.
type Buckets is data = $Buckets { offsets: &[U32], indices: &[U32], occupied: &[U32] }
func build_into (grid: field.Grid) -> regions -> (offsets: ResizeArray U32) -> (indices: ResizeArray U32) -> (occupied: ResizeArray U32) => return do:
  if field.count grid == 0xFFFFFFFF:
    return @panic "field bucket prefix table overflows"
  let counts = array.fill (field.count grid) 0
  for index in 0 .. regions.length:
    let r = field.clipped grid (regions.at index)
    if r.right > r.left and r.bottom > r.top:
      for y in r.top / grid.tile_height .. (r.bottom - 1) / grid.tile_height + 1:
        for x in r.left / grid.tile_width .. (r.right - 1) / grid.tile_width + 1:
          let tile = y * grid.columns + x
          if counts[tile] == 0xFFFFFFFF:
            return @panic "field bucket size overflows"
          counts[tile] := self + 1
  let total = 0
  for tile in 0 .. counts.length:
    if counts[tile] > 0xFFFFFFFF - total:
      return @panic "field bucket storage overflows"
    total := self + counts[tile]
  offsets.truncate 0
  indices.truncate 0
  occupied.truncate 0
  let prefix = 0
  for tile in 0 .. counts.length:
    offsets.push prefix
    prefix := self + counts[tile]
    if counts[tile] != 0:
      occupied.push tile
  offsets.push total
  for index in 0 .. total:
    indices.push 0
  let cursors = array.generate counts.length (func tile => return offsets[tile])
  for index in 0 .. regions.length:
    let r = field.clipped grid (regions.at index)
    if r.right > r.left and r.bottom > r.top:
      for y in r.top / grid.tile_height .. (r.bottom - 1) / grid.tile_height + 1:
        for x in r.left / grid.tile_width .. (r.right - 1) / grid.tile_width + 1:
          let tile = y * grid.columns + x
          let slot = cursors[tile]
          indices[slot] = index
          cursors[tile] := slot + 1
  return $Buckets { offsets: &offsets[0..offsets.length], indices: &indices[0..indices.length], occupied: &occupied[0..occupied.length] }

func region (grid: field.Grid) -> (tile: U32) : field.Region => return do:
  if tile >= field.count grid:
    return @panic "field bucket outside grid"
  let left = tile % grid.columns * grid.tile_width
  let top = tile / grid.columns * grid.tile_height
  return { left, top, right: left + min grid.tile_width (grid.width - left), bottom: top + min grid.tile_height (grid.height - top) }
