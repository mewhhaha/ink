//! 2D Wave Function Collapse (WFC) Solver: up to 32 tiles represented as U32
//! bitmasks, directional adjacency rules (north/east/south/west), weighted
//! Shannon entropy cell selection, AC-3 propagation queue, and deterministic
//! seeded restarts on contradiction.
//!
//! Key items: [`TileRule`], [`Solution`], [`popcount`], [`lowest_bit_index`], [`allowed_for_dir`].

import * as random from "../random"
import * as color from "../color"

type TileRule is data = $TileRule {
  weight: F32,
  north: U32,
  east: U32,
  south: U32,
  west: U32,
}

type Solution is data = $Solution {
  solved: Bool,
  tiles: #[U32],
  attempts: U32,
}

func popcount (mask: U32) : U32 =>
  let b = mask - ((mask >> 1) & 0x55555555)
  b := (self & 0x33333333) + ((self >> 2) & 0x33333333)
  b := (self + (self >> 4)) & 0x0F0F0F0F
  return (b * 0x01010101) >> 24

func lowest_bit_index (mask: U32) : U32 =>
  for i in 0 .. 32:
    if ((mask >> i) & 1) != 0:
      return i
  return 0

func allowed_for_dir (rules: #[TileRule]) -> (source_mask: U32) -> (dir: U32) : U32 =>
  let allowed = 0
  let n = min 32 rules.length
  for t in 0 .. n:
    if ((source_mask >> t) & 1) != 0:
      let r = rules[t]
      let bits = if dir == 0 then r.north else if dir == 1 then r.east else if dir == 2 then r.south else r.west
      allowed := self | bits
  return allowed

private func ln_pos (value: F32) : F32 =>
  return color.log2 (max 1.0e-30 value) * 0.6931471805599453

private func safe_weight (w: F32) : F32 =>
  if is_finite w and w > 0.0 then max 0.0001 w else 0.0001

func cell_entropy (rules: #[TileRule]) -> (mask: U32) : F32 =>
  let n = min 32 rules.length
  let max_w = 0.0
  for t in 0 .. n:
    if ((mask >> t) & 1) != 0:
      max_w := max self (safe_weight rules[t].weight)
  if not (is_finite max_w) or max_w <= 0.0:
    return 0.0
  let sum_w = 0.0
  let sum_w_log_w = 0.0
  for t in 0 .. n:
    if ((mask >> t) & 1) != 0:
      let w = safe_weight rules[t].weight / max_w
      sum_w := self + w
      sum_w_log_w := self + w * ln_pos w
  if sum_w <= 0.0 or not (is_finite sum_w) or not (is_finite sum_w_log_w):
    return 0.0
  let ent = ln_pos sum_w - sum_w_log_w / sum_w
  return if is_finite ent then ent else 0.0

func pick_weighted_tile (rules: #[TileRule]) -> (mask: U32) -> (unit: F32) : U32 =>
  let n = min 32 rules.length
  let max_w = 0.0
  for t in 0 .. n:
    if ((mask >> t) & 1) != 0:
      max_w := max self (safe_weight rules[t].weight)
  let chosen = lowest_bit_index mask
  if not (is_finite max_w) or max_w <= 0.0 or not (is_finite unit):
    return chosen
  let total = 0.0
  for t in 0 .. n:
    if ((mask >> t) & 1) != 0:
      total := self + safe_weight rules[t].weight / max_w
  let target = clamp 0.0 1.0 unit * total
  let acc = 0.0
  for t in 0 .. n:
    if ((mask >> t) & 1) != 0:
      acc := self + safe_weight rules[t].weight / max_w
      chosen := t
      if target < acc:
        break
  return chosen

// Verify that every cell is a valid singleton and every adjacent pair respects `rules`.
private func verify_solution (width: U32) -> (height: U32) -> (rules: #[TileRule]) -> (tiles: #[U32]) : Bool =>
  let total = width * height
  let count = min 32 rules.length
  if tiles.length != total:
    return false
  for cur in 0 .. total:
    let t = tiles[cur]
    if t >= count:
      return false
    let r = rules[t]
    let cx = cur % width
    let cy = cur / width
    if cy > 0:
      let nt = tiles[cur - width]
      if ((r.north >> nt) & 1) == 0:
        return false
    if cx + 1 < width:
      let nt = tiles[cur + 1]
      if ((r.east >> nt) & 1) == 0:
        return false
    if cy + 1 < height:
      let nt = tiles[cur + width]
      if ((r.south >> nt) & 1) == 0:
        return false
    if cx > 0:
      let nt = tiles[cur - 1]
      if ((r.west >> nt) & 1) == 0:
        return false
  return true

// Single attempt at solving a `width x height` WFC grid with optional initial
// `pinned` bitmasks (0 means unconstrained / all tiles allowed).
private func attempt (width: U32) -> (height: U32) -> (rules: #[TileRule]) -> (pinned: #[U32]) -> (seed: U32) : (Bool, #[U32]) =>
  let total = width * height
  let count = min 32 rules.length
  let full_mask = if count == 32 then 4294967295 else (1 << count) - 1
  let wave = spark #[if i < pinned.length and pinned[i] != 0 then (pinned[i] & full_mask) else full_mask | i <- 0 .. total]
  // Precompute tile directional bitmasks and safe weights once per attempt.
  let rn = @array.fill count 0
  let re = @array.fill count 0
  let rs = @array.fill count 0
  let rw = @array.fill count 0
  let tw = @array.fill count 0.0
  let tw_ln = @array.fill count 0.0
  let max_all_w = 0.0
  for t in 0 .. count:
    let r = rules[t]
    rn[t] := r.north
    re[t] := r.east
    rs[t] := r.south
    rw[t] := r.west
    let w = safe_weight r.weight
    tw[t] := w
    max_all_w := max self w
  let inv_max_w = if max_all_w > 0.0 and is_finite max_all_w then 1.0 / max_all_w else 1.0
  for t in 0 .. count:
    let wn = tw[t] * inv_max_w
    tw[t] := wn
    tw_ln[t] := wn * ln_pos wn
  let cell_ent = @array.fill total 0.0
  let cell_cnt = @array.fill total 0
  let cell_dirty = @array.fill total true
  let qcap = total + 1
  let queue = @array.fill qcap 0
  let in_queue = @array.fill total false
  let head = 0
  let tail = 0
  // Seed ALL cells into initial AC-3 queue so even 1-tile or 0-mask rules propagate.
  for i in 0 .. total:
    let m = wave[i]
    if m == 0:
      return (false, @array.fill total 0)
    cell_cnt[i] := popcount m
    queue[tail] := i
    tail := (self + 1) % qcap
    in_queue[i] := true
  let s = seed
  let contradiction = false
  for _ in 0 .. (total + 1):
    // AC-3 propagation loop (at most `count` reductions per cell across all cells).
    let prop_limit = total * (count + 1) + 4
    for _ in 0 .. prop_limit:
      if head == tail or contradiction:
        break
      let cur = queue[head]
      head := (self + 1) % qcap
      in_queue[cur] := false
      let cx = cur % width
      let cy = cur / width
      let cmask = wave[cur]
      let an: U32 = 0
      let ae: U32 = 0
      let as_: U32 = 0
      let aw: U32 = 0
      for t in 0 .. count:
        if ((cmask >> t) & 1) != 0:
          an := self | rn[t]
          ae := self | re[t]
          as_ := self | rs[t]
          aw := self | rw[t]
      if cy > 0:
        let nidx = cur - width
        let prev = wave[nidx]
        let next = prev & an
        if next != prev:
          if next == 0:
            contradiction := true
            break
          wave[nidx] := next
          cell_cnt[nidx] := popcount next
          cell_dirty[nidx] := true
          if not in_queue[nidx]:
            queue[tail] := nidx
            tail := (self + 1) % qcap
            in_queue[nidx] := true
      if cx + 1 < width:
        let nidx = cur + 1
        let prev = wave[nidx]
        let next = prev & ae
        if next != prev:
          if next == 0:
            contradiction := true
            break
          wave[nidx] := next
          cell_cnt[nidx] := popcount next
          cell_dirty[nidx] := true
          if not in_queue[nidx]:
            queue[tail] := nidx
            tail := (self + 1) % qcap
            in_queue[nidx] := true
      if cy + 1 < height:
        let nidx = cur + width
        let prev = wave[nidx]
        let next = prev & as_
        if next != prev:
          if next == 0:
            contradiction := true
            break
          wave[nidx] := next
          cell_cnt[nidx] := popcount next
          cell_dirty[nidx] := true
          if not in_queue[nidx]:
            queue[tail] := nidx
            tail := (self + 1) % qcap
            in_queue[nidx] := true
      if cx > 0:
        let nidx = cur - 1
        let prev = wave[nidx]
        let next = prev & aw
        if next != prev:
          if next == 0:
            contradiction := true
            break
          wave[nidx] := next
          cell_cnt[nidx] := popcount next
          cell_dirty[nidx] := true
          if not in_queue[nidx]:
            queue[tail] := nidx
            tail := (self + 1) % qcap
            in_queue[nidx] := true
    if contradiction or head != tail:
      contradiction := true
      break
    // Choose lowest-entropy uncollapsed cell (recomputing cached entropy only for dirty cells).
    let best_idx = total
    let best_ent = 0.0
    let has_best = false
    for i in 0 .. total:
      let cnt = cell_cnt[i]
      if cnt == 0:
        contradiction := true
        break
      if cnt > 1:
        if cell_dirty[i]:
          let m = wave[i]
          let sw = 0.0
          let swl = 0.0
          for t in 0 .. count:
            if ((m >> t) & 1) != 0:
              sw := self + tw[t]
              swl := self + tw_ln[t]
          let e = 0.0
          if sw > 0.0 and is_finite sw and is_finite swl:
            let raw = ln_pos sw - swl / sw
            if is_finite raw:
              e := raw
          cell_ent[i] := e
          cell_dirty[i] := false
        s := random.next s
        let ent = cell_ent[i] + random.unit s * 0.0001
        if not has_best or ent < best_ent:
          has_best := true
          best_ent := ent
          best_idx := i
    if contradiction or not has_best:
      break
    s := random.next s
    let chosen = pick_weighted_tile rules wave[best_idx] (random.unit s)
    wave[best_idx] := 1 << chosen
    cell_cnt[best_idx] := 1
    cell_dirty[best_idx] := false
    queue[tail] := best_idx
    tail := (self + 1) % qcap
    in_queue[best_idx] := true
  if contradiction:
    return (false, @array.fill total 0)
  for i in 0 .. total:
    if popcount wave[i] != 1:
      return (false, @array.fill total 0)
  let tiles = spark #[lowest_bit_index wave[i] | i <- 0 .. total]
  if not (verify_solution width height rules tiles):
    return (false, @array.fill total 0)
  return (true, tiles)

// Solve `width x height` WFC up to `max_attempts` seeded retries.
// Bounds total cells to 4,096 and caps retry work so quadratic entropy scans stay bounded.
func solve (width: U32) -> (height: U32) -> (rules: #[TileRule]) -> (pinned: #[U32]) -> (seed: U32) -> (max_attempts: U32) : Solution =>
  if width == 0 or height == 0 or width > 4096 / height or rules.length == 0:
    return $Solution { solved: false, tiles: #[], attempts: 0 }
  let total = width * height
  let max_tries = max 1 (min 4096 (4194304 / (total * total)))
  let tries = min max_tries (if max_attempts == 0 then 1 else max_attempts)
  let s = seed
  for a in 0 .. tries:
    let (ok, tiles) = attempt width height rules pinned s
    if ok:
      return $Solution { solved: true, tiles, attempts: a + 1 }
    s := random.next s ^ ((a + 1) * 2654435761)
  return $Solution { solved: false, tiles: @array.fill total 0, attempts: tries }
