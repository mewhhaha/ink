//! Extended Procedural Noise: 2D/3D Simplex, 2D/3D Worley (cellular Voronoi F1,
//! F2, edge distance, cell ID), Ridged Multifractal, and Domain-Warped fBm.
//! Deterministic for fixed seed and coordinates.
//!
//! Key items: [`WorleySample`], [`grad2`], [`hash2i`], [`hash3i`], [`simplex2_xy`].
//!
//! ```blot
//! let v = simplex2_xy 42 1.5 2.5
//! v == simplex2_xy 42 1.5 2.5 and v >= -1.0 and v <= 1.0 // => true
//! ```

import { Vec2, Vec3 } from "std/vector"
import * as base_noise from "../noise"

type WorleySample is data = $WorleySample {
  f1: F32,
  f2: F32,
  edge: F32,
  cell: U32,
}

func grad2 (h: U32) -> (x: F32) -> (y: F32) : F32 =>
  let k = h & 7
  let u = if k < 4 then x else y
  let v = if k < 4 then y else x
  let a = if (k & 1) == 0 then u else 0.0 - u
  let b = if (k & 2) == 0 then 2.0 * v else 0.0 - 2.0 * v
  return a + b

func hash2i (x: F32) -> (y: F32) -> (seed: U32) : U32 =>
  return base_noise.hash3 (base_noise.cell x) (base_noise.cell y) 0 seed

func hash3i (x: F32) -> (y: F32) -> (z: F32) -> (seed: U32) : U32 =>
  return base_noise.hash3 (base_noise.cell x) (base_noise.cell y) (base_noise.cell z) seed

// Scalar 2D Simplex noise kernel taking raw `(px, py)` coordinates so `spark`
// batch evaluators auto-vectorize cleanly to 4-wide Wasm SIMD without boxing `Vec2`.
func simplex2_xy (seed: U32) -> (px: F32) -> (py: F32) : F32 =>
  let f2 = 0.36602540378 // 0.5 * (sqrt(3) - 1)
  let g2 = 0.21132486540 // (3 - sqrt(3)) / 6
  let s = (px + py) * f2
  let i = floor (px + s)
  let j = floor (py + s)
  let t = (i + j) * g2
  let x0 = px - (i - t)
  let y0 = py - (j - t)
  let i1 = if x0 > y0 then 1.0 else 0.0
  let j1 = if x0 > y0 then 0.0 else 1.0
  let x1 = x0 - i1 + g2
  let y1 = y0 - j1 + g2
  let x2 = x0 - 1.0 + 2.0 * g2
  let y2 = y0 - 1.0 + 2.0 * g2
  let t0 = 0.5 - x0 * x0 - y0 * y0
  let n0 = if t0 > 0.0 then (t0 * t0) * (t0 * t0) * grad2 (hash2i i j seed) x0 y0 else 0.0
  let t1 = 0.5 - x1 * x1 - y1 * y1
  let n1 = if t1 > 0.0 then (t1 * t1) * (t1 * t1) * grad2 (hash2i (i + i1) (j + j1) seed) x1 y1 else 0.0
  let t2 = 0.5 - x2 * x2 - y2 * y2
  let n2 = if t2 > 0.0 then (t2 * t2) * (t2 * t2) * grad2 (hash2i (i + 1.0) (j + 1.0) seed) x2 y2 else 0.0
  return 45.23065 * (n0 + n1 + n2)

// 2D Simplex noise in approximately [-1, 1].
func simplex2 (seed: U32) -> (p: Vec2) : F32 =>
  return simplex2_xy seed p.x p.y

// Data-parallel 2D Simplex batch evaluation via `spark` (4-wide Wasm SIMD eligible).
func simplex2_batch (seed: U32) -> (xs: &[F32]) -> (ys: &[F32]) : #[F32] =>
  let n = min xs.length ys.length
  return spark #[simplex2_xy seed xs[i] ys[i] | i <- 0 .. n]

// Data-parallel row-major 2D Simplex grid (`width * height` samples) via `spark`.
func simplex2_grid (seed: U32) -> (origin_x: F32) -> (origin_y: F32) -> (step: F32) -> (width: U32) -> (height: U32) : #[F32] =>
  if width == 0 or height == 0 or height > 4294967295 / width or not (is_finite origin_x and is_finite origin_y and is_finite step):
    return #[]
  let total = width * height
  let xs = spark #[origin_x + U32.to_f32 (i % width) * step | i <- 0 .. total]
  let ys = spark #[origin_y + U32.to_f32 (i / width) * step | i <- 0 .. total]
  return spark #[simplex2_xy seed xs[i] ys[i] | i <- 0 .. total]

// 3D Simplex noise in approximately [-1, 1].
func simplex3 (seed: U32) -> (p: Vec3) : F32 =>
  let f3 = 0.33333333333
  let g3 = 0.16666666667
  let s = (p.x + p.y + p.z) * f3
  let i = floor (p.x + s)
  let j = floor (p.y + s)
  let k = floor (p.z + s)
  let t = (i + j + k) * g3
  let x0 = p.x - (i - t)
  let y0 = p.y - (j - t)
  let z0 = p.z - (k - t)
  let i1 = if x0 >= y0 then (if y0 >= z0 then 1.0 else if x0 >= z0 then 1.0 else 0.0) else 0.0
  let j1 = if x0 >= y0 then 0.0 else (if y0 < z0 then 0.0 else 1.0)
  let k1 = if x0 >= y0 then (if y0 >= z0 then 0.0 else if x0 >= z0 then 0.0 else 1.0) else (if y0 < z0 then 1.0 else 0.0)
  let i2 = if x0 >= y0 then 1.0 else (if y0 < z0 then 0.0 else if x0 < z0 then 0.0 else 1.0)
  let j2 = if x0 >= y0 then (if y0 >= z0 then 1.0 else 0.0) else 1.0
  let k2 = if x0 >= y0 then (if y0 >= z0 then 0.0 else 1.0) else (if y0 < z0 then 1.0 else if x0 < z0 then 1.0 else 0.0)
  let x1 = x0 - i1 + g3
  let y1 = y0 - j1 + g3
  let z1 = z0 - k1 + g3
  let x2 = x0 - i2 + 2.0 * g3
  let y2 = y0 - j2 + 2.0 * g3
  let z2 = z0 - k2 + 2.0 * g3
  let x3 = x0 - 1.0 + 3.0 * g3
  let y3 = y0 - 1.0 + 3.0 * g3
  let z3 = z0 - 1.0 + 3.0 * g3
  // Use 0.5 radial support (radius sqrt(0.5)) so the kernel vanishes cleanly at
  // every simplex face/rank boundary (C^2 continuous with zero seam across x=y).
  let t0 = 0.5 - x0 * x0 - y0 * y0 - z0 * z0
  let n0 = if t0 > 0.0 then (t0 * t0) * (t0 * t0) * base_noise.gradient (hash3i i j k seed) x0 y0 z0 else 0.0
  let t1 = 0.5 - x1 * x1 - y1 * y1 - z1 * z1
  let n1 = if t1 > 0.0 then (t1 * t1) * (t1 * t1) * base_noise.gradient (hash3i (i + i1) (j + j1) (k + k1) seed) x1 y1 z1 else 0.0
  let t2 = 0.5 - x2 * x2 - y2 * y2 - z2 * z2
  let n2 = if t2 > 0.0 then (t2 * t2) * (t2 * t2) * base_noise.gradient (hash3i (i + i2) (j + j2) (k + k2) seed) x2 y2 z2 else 0.0
  let t3 = 0.5 - x3 * x3 - y3 * y3 - z3 * z3
  let n3 = if t3 > 0.0 then (t3 * t3) * (t3 * t3) * base_noise.gradient (hash3i (i + 1.0) (j + 1.0) (k + 1.0) seed) x3 y3 z3 else 0.0
  return 76.0 * (n0 + n1 + n2 + n3)

private func cell_min_dist2_1d (p_frac: F32) -> (d: F32) : F32 =>
  if d > 0.0:
    let gap = d - p_frac
    return if gap > 0.0 then gap * gap else 0.0
  if d < 0.0:
    let gap = p_frac - (d + 1.0)
    return if gap > 0.0 then gap * gap else 0.0
  return 0.0

// 2D Worley (cellular Voronoi) noise returning exact Euclidean F1, F2,
// edge (F2 - F1), and nearest feature point's cell hash. Searches the 5x5
// neighborhood with lower-bound cell pruning so boundary F2 candidates at
// offset +-2 are never missed.
func worley2 (seed: U32) -> (p: Vec2) : WorleySample =>
  if not (is_finite p.x and is_finite p.y):
    return $WorleySample { f1: 0.0, f2: 0.0, edge: 0.0, cell: 0 }
  let ix = floor p.x
  let iy = floor p.y
  let fx_p = p.x - ix
  let fy_p = p.y - iy
  // All five offsets are exact in this range. At larger coordinates the
  // rounded F32 cell positions must still be converted individually.
  let linear_x = abs ix <= 16777214.0
  let linear_y = abs iy <= 16777214.0
  let first_x = base_noise.cell ix - 2
  let first_y = base_noise.cell iy - 2
  let seed_y = seed ^ 2654435761
  let d1 = 1000000.0
  let d2 = 1000000.0
  let best = 0
  for oy in 0 .. 5:
    let dy = U32.to_f32 oy - 2.0
    let min_y2 = cell_min_dist2_1d fy_p dy
    if min_y2 < d2:
      let cy = iy + dy
      let cy_word = if linear_y then first_y + oy else base_noise.cell cy
      for ox in 0 .. 5:
        let dx = U32.to_f32 ox - 2.0
        let min_x2 = cell_min_dist2_1d fx_p dx
        if min_x2 + min_y2 < d2:
          let cx = ix + dx
          let cx_word = if linear_x then first_x + ox else base_noise.cell cx
          let hx = base_noise.hash3 cx_word cy_word 0 seed
          let hy = base_noise.hash3 cx_word cy_word 0 seed_y
          let rx = cx + base_noise.unit hx - p.x
          let ry = cy + base_noise.unit hy - p.y
          let dist2 = rx * rx + ry * ry
          if dist2 < d1:
            d2 := d1
            d1 := dist2
            best := hx
          else:
            if dist2 < d2:
              d2 := dist2
  let f1 = sqrt d1
  let f2 = sqrt d2
  return $WorleySample { f1, f2, edge: f2 - f1, cell: best }

// 3D Worley (cellular Voronoi) noise with exact 5x5x5 lower-bound-pruned
// neighborhood search (guarantees exact Euclidean F1 & F2 everywhere).
func worley3 (seed: U32) -> (p: Vec3) : WorleySample =>
  if not (is_finite p.x and is_finite p.y and is_finite p.z):
    return $WorleySample { f1: 0.0, f2: 0.0, edge: 0.0, cell: 0 }
  let ix = floor p.x
  let iy = floor p.y
  let iz = floor p.z
  let fx_p = p.x - ix
  let fy_p = p.y - iy
  let fz_p = p.z - iz
  let d1 = 1000000.0
  let d2 = 1000000.0
  let best = 0
  for oz in 0 .. 5:
    let dz = U32.to_f32 oz - 2.0
    let min_z2 = cell_min_dist2_1d fz_p dz
    if min_z2 < d2:
      for oy in 0 .. 5:
        let dy = U32.to_f32 oy - 2.0
        let min_yz2 = min_z2 + cell_min_dist2_1d fy_p dy
        if min_yz2 < d2:
          for ox in 0 .. 5:
            let dx = U32.to_f32 ox - 2.0
            if min_yz2 + cell_min_dist2_1d fx_p dx < d2:
              let cx = ix + dx
              let cy = iy + dy
              let cz = iz + dz
              let hx = hash3i cx cy cz seed
              let hy = hash3i cx cy cz (seed ^ 2654435761)
              let hz = hash3i cx cy cz (seed ^ 2246822519)
              let rx = cx + base_noise.unit hx - p.x
              let ry = cy + base_noise.unit hy - p.y
              let rz = cz + base_noise.unit hz - p.z
              let dist2 = rx * rx + ry * ry + rz * rz
              if dist2 < d1:
                d2 := d1
                d1 := dist2
                best := hx
              else:
                if dist2 < d2:
                  d2 := dist2
  let f1 = sqrt d1
  let f2 = sqrt d2
  return $WorleySample { f1, f2, edge: f2 - f1, cell: best }

// Ridged multifractal 2D (normalized to ~[0, 1]).
func ridged2 (seed: U32) -> (octaves: U32) -> (lacunarity: F32) -> (gain: F32) -> (p: Vec2) : F32 =>
  if octaves == 0 or not (is_finite lacunarity and is_finite gain and is_finite p.x and is_finite p.y):
    return 0.0
  let sum = 0.0
  let norm = 0.0
  let amp = 0.5
  let freq = 1.0
  let weight = 1.0
  let count = min octaves 32
  for i in 0 .. count:
    let n = 1.0 - abs (simplex2 (seed + i * 1013) ($Vec2 { x: p.x * freq, y: p.y * freq }))
    let signal = n * n * weight
    weight := clamp 0.0 1.0 (signal * 2.0)
    sum := self + signal * amp
    norm := self + amp
    freq := self * lacunarity
    amp := self * gain
  return if is_finite sum and is_finite norm and norm > 0.0 then sum / norm else 0.0

// Domain-warped 2D Simplex fBm (2-tap coordinate warp).
func warp2 (seed: U32) -> (octaves: U32) -> (strength: F32) -> (p: Vec2) : F32 =>
  if octaves == 0 or not (is_finite strength and is_finite p.x and is_finite p.y):
    return 0.0
  let wx = simplex2 (seed + 17) p
  let wy = simplex2 (seed + 53) ($Vec2 { x: p.x + 5.2, y: p.y + 1.3 })
  let warped = $Vec2 { x: p.x + wx * strength, y: p.y + wy * strength }
  let sum = 0.0
  let norm = 0.0
  let amp = 0.5
  let freq = 1.0
  let count = min octaves 32
  for i in 0 .. count:
    sum := self + amp * simplex2 (seed + 97 + i * 31) ($Vec2 { x: warped.x * freq, y: warped.y * freq })
    norm := self + amp
    freq := self * 2.0
    amp := self * 0.5
  return if is_finite sum and is_finite norm and norm > 0.0 then sum / norm else 0.0
