import { Vec3 } from "std/vector"
import * as math from "./math"
import * as transform from "./transform"

type Key is data = $Key { time: F32, pose: transform.Pose3 }
type Track is data = $Track { start: U32, count: U32 }
// A flat record, so a clip's events are stored in place; `events` reads their
// fields straight from the array rather than binding each row.
type Event = { time: F32, id: U32 }
type Clip is data = $Clip { duration: F32, keys: &[Key], tracks: &[Track], events: &[Event] }
type RootMotion is data = $RootMotion { translation: Vec3, rotation: math.Quat }
const identity = $transform.Pose3 { position: math.zero3, rotation: math.identity_quat, scale: math.one3 }
// Validate authored data once before sampling. Equal-time keys are accepted:
// the later key wins at the boundary. Empty tracks sample identity.
func validate (clip: Clip) : Maybe Clip => return do:
  if Bool.not (is_finite clip.duration) or clip.duration <= 0.0:
    return $Nothing
  for track in clip.tracks:
    if track.start > clip.keys.length or track.count > clip.keys.length - track.start:
      return $Nothing
    let previous = 0.0
    for index in 0 .. track.count:
      let key = clip.keys[track.start + index]
      if Bool.not (is_finite key.time and math.finite3 key.pose.position and math.finite3 key.pose.scale and math.finite_quat key.pose.rotation):
        return $Nothing
      if key.time < previous or key.time > clip.duration:
        return $Nothing
      previous := key.time
  let previous = 0.0
  for event in clip.events:
    if Bool.not (is_finite event.time) or event.time < previous or event.time >= clip.duration:
      return $Nothing
    previous := event.time
  return $Some clip
// A complete parent array, roots=U32 max, all other parents precede children.
func valid_parents (parents: Array U32) => return func (count: U32) => return do:
  if parents.length != count:
    return false
  for i in 0..count:
    let parent = parents[i]
    if parent != 4294967295 and parent >= i:
      return false
  return true
// F32 cycle indices must remain exact; event work also has a fixed budget.
func valid_window (clip: Clip) => return func (previous: F32) => return func (current: F32) => return func (looping: Bool) => return do:
  if Bool.not (is_finite previous and is_finite current and is_finite clip.duration) or clip.duration <= 0.0:
    return false
  if looping:
    let a = previous / clip.duration
    let b = current / clip.duration
    if Bool.not (is_finite a and is_finite b) or abs a > 16777216.0 or abs b > 16777216.0:
      return false
  return true
func phase (time: F32) => return func (duration: F32) => return func (looping: Bool) => return do:
  if duration <= 0.0 or Bool.not (is_finite time and is_finite duration):
    return 0.0
  if looping:
    return F32.wrap duration time
  return clamp 0.0 duration time
// Keys must be sorted; duplicate times choose the later key at that boundary.
func sample_track (pool: &[Key]) -> (track: Track) -> (time: F32) => return do:
  if track.start > pool.length or track.count > pool.length - track.start:
    return @panic "animation track span is outside its key pool"
  let keys = &pool[track.start..track.start + track.count]
  if keys.length == 0:
    return identity
  if time < keys[0].time:
    return keys[0].pose
  // Upper bound retains the later duplicate, including a repeated final key.
  let low = 1
  let high = keys.length
  for 0..32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if time < keys[middle].time:
      high := middle
    else:
      low := middle + 1
  if low == keys.length:
    return keys[low - 1].pose
  let a = keys[low - 1]
  let b = keys[low]
  return transform.lerp3 a.pose b.pose ((time - a.time) / (b.time - a.time))
func sample (clip: Clip) => return func (time: F32) => return func (looping: Bool) => return do:
  let t = phase time clip.duration looping
  return @array.generate clip.tracks.length (func (i: U32) => return sample_track clip.keys clip.tracks[i] t)
// Equal-size bone arrays; per-bone masks may be shorter (missing weight=1).
func blend (a: Array transform.Pose3) => return func (b: Array transform.Pose3) => return func (weight: F32) => return func (mask: Array F32) => return do:
  return @array.generate a.length (func (i: U32) => return do:
    if i >= b.length:
      return a[i]
    let w = weight
    if i < mask.length:
      w := self * mask[i]
    return transform.lerp3 a[i] b[i] (clamp 0.0 1.0 w))
// Parent indices must precede children. U32 max marks roots. Invalid parents
// are roots, allowing independent trees. Affine composition retains shear.
func world (local: Array transform.Pose3) => return func (parents: Array U32) => return do:
  let result = @array.fill local.length transform.identity3
  for i in 0..local.length:
    let basis = transform.affine3 local[i]
    if i < parents.length:
      let parent = parents[i]
      if parent < i:
        // Read the fresh output inline before passing a single record.
        basis := transform.compose3 result[parent] basis
    result[i] := basis
  return result
func rotation_cycles (rotation: math.Quat) => return func (cycles: F32) => return do:
  let q = math.Quat.normalized rotation
  if cycles < 0.0:
    q := math.Quat.conjugate self
  let count = F32.to_u32 (abs cycles)
  let result = math.identity_quat
  for 0..32:
    if (count & 1) != 0:
      result := math.Quat.normalized (self * q)
    count := self >> 1
    if count == 0:
      break
    q := math.Quat.normalized (self * self)
  return result
// Translation is unwrapped in clip coordinates. Rotation includes complete
// cycles, including reverse playback. Integer cycle counts must fit U32.
func root_motion (clip: Clip) => return func (previous: F32) => return func (current: F32) => return func (looping: Bool) => return do:
  if clip.tracks.length == 0 or Bool.not (valid_window clip previous current looping):
    return $RootMotion { translation: math.zero3, rotation: math.identity_quat }
  let track = clip.tracks[0]
  let a = sample_track clip.keys track (phase previous clip.duration looping)
  let b = sample_track clip.keys track (phase current clip.duration looping)
  let delta = b.position - a.position
  let rotation = math.Quat.conjugate a.rotation * b.rotation
  if looping and clip.duration > 0.0:
    let cycles = floor (current / clip.duration) - floor (previous / clip.duration)
    let start = sample_track clip.keys track 0.0
    let end = sample_track clip.keys track clip.duration
    delta := self + (end.position - start.position) * cycles
    let cycle_rotation = math.Quat.conjugate start.rotation * end.rotation
    rotation := math.Quat.conjugate a.rotation * start.rotation * rotation_cycles cycle_rotation cycles * math.Quat.conjugate start.rotation * b.rotation
  return $RootMotion { translation: delta, rotation: math.Quat.normalized rotation }
// Crossings in (previous,current], including every loop and exact boundaries.
// Events must be sorted in [0,duration); returned ids preserve temporal order.
// Reverse playback yields no events; the caller can request a forward window.
func events (clip: Clip) => return func (previous: F32) => return func (current: F32) => return func (looping: Bool) => return do:
  if current <= previous or Bool.not (valid_window clip previous current looping) or clip.events.length == 0:
    return #[]
  let first = 0.0
  let cycles = 1
  if looping:
    first := floor (previous / clip.duration)
    let final = floor (current / clip.duration)
    if final - first >= 4096.0:
      return #[]
    cycles := F32.to_u32 (final - first) + 1
  let count = 0
  // Flatten candidate visits: nested array writes and list prepends caused
  // the compiler to copy growing output across loop iterations.
  if cycles > 4294967295 / clip.events.length:
    return #[]
  let candidates = cycles * clip.events.length
  // The event index and its cycle's start time advance with the candidate
  // rather than by division: offset is (first + cycle) × duration, as each
  // cycle's times were reckoned before.
  let list = clip.events
  let n = list.length
  let duration = clip.duration
  let event = 0
  let cycle = 0
  let offset = (first + U32.to_f32 cycle) * duration
  for 0..candidates:
    let at = list[event].time
    let time = at
    if looping:
      time := offset + at
    if time > previous and time <= current:
      if looping or at <= duration:
        count := self + 1
    event := self + 1
    if event == n:
      event := 0
      cycle := self + 1
      offset := (first + U32.to_f32 cycle) * duration
  let found = @array.fill count 0
  let output = 0
  event := 0
  cycle := 0
  offset := (first + U32.to_f32 cycle) * duration
  for 0..candidates:
    let at = list[event].time
    let time = at
    if looping:
      time := offset + at
    if time > previous and time <= current:
      if looping or at <= duration:
        found[output] := list[event].id
        output := self + 1
    event := self + 1
    if event == n:
      event := 0
      cycle := self + 1
      offset := (first + U32.to_f32 cycle) * duration
  return found
