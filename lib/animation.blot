//! Skeletal animation clips, pose sampling, track blending, and root motion.
//!
//! Key items: [`Key`], [`Track`], [`Event`], [`Clip`], [`validate`].

import { Vec3 } from "std/vector"
import * as math from "./math"
import * as transform from "./transform"

type Key is data = $Key { time: F32, pose: transform.Pose3 }
type Track is data = $Track { start: U32, count: U32 }
// A flat record, so a clip's events are stored in place; `events` reads their
// fields straight from the array rather than binding each row.
type Event = { time: F32, id: U32 }
type Clip is data = $Clip { duration: F32, keys: &[Key], tracks: &[Track], events: &[Event] }
type RootMotion is data = $RootMotion { translation: Vec3, rotation: math.Quat }
const identity = $transform.Pose3 { position: math.zero3, rotation: math.identity_quat, scale: math.one3 }
// Validate authored data once before sampling. Equal-time keys are accepted:
// the later key wins at the boundary. Empty tracks sample identity.
func validate (clip: Clip) : Maybe Clip =>
  if not (is_finite clip.duration) or clip.duration <= 0.0:
    return $Nothing
  for track in clip.tracks:
    if track.start > clip.keys.length or track.count > clip.keys.length - track.start:
      return $Nothing
    let previous = 0.0
    let prev_pos = math.zero3
    let prev_scale = math.one3
    for index in 0 .. track.count:
      let key = clip.keys[track.start + index]
      if not (is_finite key.time and math.finite3 key.pose.position and math.finite3 key.pose.scale and math.finite_quat key.pose.rotation):
        return $Nothing
      if key.time < previous or key.time > clip.duration:
        return $Nothing
      if index > 0 and not (math.finite3 (key.pose.position - prev_pos) and math.finite3 (key.pose.scale - prev_scale)):
        return $Nothing
      previous := key.time
      prev_pos := key.pose.position
      prev_scale := key.pose.scale
  let previous = 0.0
  for event in clip.events:
    if not (is_finite event.time) or event.time < previous or event.time >= clip.duration:
      return $Nothing
    previous := event.time
  return $Some clip
// A complete parent array, roots=U32 max, all other parents precede children.
func valid_parents (parents: #[U32]) => func (count: U32) =>
  if parents.length != count:
    return false
  for i in 0..count:
    let parent = parents[i]
    if parent != 4294967295 and parent >= i:
      return false
  return true
// F32 cycle indices must remain exact; event work also has a fixed budget.
func valid_window (clip: Clip) => func (previous: F32) => func (current: F32) => func (looping: Bool) =>
  if not (is_finite previous and is_finite current and is_finite clip.duration) or clip.duration <= 0.0:
    return false
  if looping:
    let a = previous / clip.duration
    let b = current / clip.duration
    if not (is_finite a and is_finite b) or abs a > 16777216.0 or abs b > 16777216.0:
      return false
  return true
func phase (time: F32) => func (duration: F32) => func (looping: Bool) =>
  if duration <= 0.0 or not (is_finite time and is_finite duration):
    return 0.0
  if looping:
    return F32.wrap duration time
  return clamp 0.0 duration time
// Keys must be sorted; duplicate times choose the later key at that boundary.
func sample_track (pool: &[Key]) -> (track: Track) -> (time: F32) =>
  if track.start > pool.length or track.count > pool.length - track.start:
    return panic "animation track span is outside its key pool"
  let keys = &pool[track.start..track.start + track.count]
  if keys.length == 0:
    return identity
  if time < keys[0].time:
    return keys[0].pose
  // Upper bound retains the later duplicate, including a repeated final key.
  let low = 1
  let high = keys.length
  for 0..32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if time < keys[middle].time:
      high := middle
    else:
      low := middle + 1
  if low == keys.length:
    return keys[low - 1].pose
  let a = keys[low - 1]
  let b = keys[low]
  let span = b.time - a.time
  if not (is_finite span) or span <= 0.0:
    return a.pose
  return transform.lerp3 a.pose b.pose ((time - a.time) / span)
private func blend_bone (a: transform.Pose3) -> (b: &[transform.Pose3]) -> (index: U32) -> (weight: F32) -> (mask: &[F32]) : transform.Pose3 =>
  if index >= b.length:
    return a
  let w = if index < mask.length then weight * mask[index] else weight
  let t = if is_finite w then clamp 0.0 1.0 w else 0.0
  return transform.lerp3 a b[index] t

func sample (clip: Clip) => func (time: F32) => func (looping: Bool) =>
  let t = phase time clip.duration looping
  return spark #[sample_track clip.keys clip.tracks[i] t | i <- 0 .. clip.tracks.length]
// Equal-size bone arrays; per-bone masks may be shorter (missing weight=1).
func blend (a: #[transform.Pose3]) => func (b: #[transform.Pose3]) => func (weight: F32) => func (mask: #[F32]) =>
  let bv = &b[0..b.length]
  let mv = &mask[0..mask.length]
  return spark #[blend_bone a[i] bv i weight mv | i <- 0 .. a.length]
// Parent indices must precede children. U32 max marks roots. Invalid parents
// are roots, allowing independent trees. Affine composition retains shear.
func world (local: #[transform.Pose3]) => func (parents: #[U32]) =>
  let result = @array.fill local.length transform.identity3
  for i in 0..local.length:
    let basis = transform.affine3 local[i]
    if i < parents.length:
      let parent = parents[i]
      if parent < i:
        // Read the fresh output inline before passing a single record.
        basis := transform.compose3 result[parent] basis
    result[i] := basis
  return result
func rotation_cycles (rotation: math.Quat) => func (cycles: F32) =>
  let q = math.Quat.normalized rotation
  if cycles < 0.0:
    q := math.Quat.conjugate self
  let count = F32.to_u32 (abs cycles)
  let result = math.identity_quat
  for 0..32:
    if (count & 1) != 0:
      result := math.Quat.normalized (self * q)
    count := self >> 1
    if count == 0:
      break
    q := math.Quat.normalized (self * self)
  return result
// Translation is unwrapped in clip coordinates. Rotation includes complete
// cycles, including reverse playback. Integer cycle counts must fit U32.
func root_motion (clip: Clip) => func (previous: F32) => func (current: F32) => func (looping: Bool) =>
  if clip.tracks.length == 0 or not (valid_window clip previous current looping):
    return $RootMotion { translation: math.zero3, rotation: math.identity_quat }
  let track = clip.tracks[0]
  let a = sample_track clip.keys track (phase previous clip.duration looping)
  let b = sample_track clip.keys track (phase current clip.duration looping)
  let delta = b.position - a.position
  let rotation = math.Quat.conjugate a.rotation * b.rotation
  if looping and clip.duration > 0.0:
    let cycles = floor (current / clip.duration) - floor (previous / clip.duration)
    let start = sample_track clip.keys track 0.0
    let end = sample_track clip.keys track clip.duration
    delta := self + (end.position - start.position) * cycles
    let cycle_rotation = math.Quat.conjugate start.rotation * end.rotation
    rotation := math.Quat.conjugate a.rotation * start.rotation * rotation_cycles cycle_rotation cycles * math.Quat.conjugate start.rotation * b.rotation
  let norm_rot = math.Quat.normalized rotation
  if not (math.finite3 delta and math.finite_quat norm_rot):
    return $RootMotion { translation: math.zero3, rotation: math.identity_quat }
  return $RootMotion { translation: delta, rotation: norm_rot }
// Crossings in (previous,current], including every loop and exact boundaries.
// Events must be sorted in [0,duration); returned ids preserve temporal order.
// Reverse playback yields no events; the caller can request a forward window.
func events (clip: Clip) => func (previous: F32) => func (current: F32) => func (looping: Bool) =>
  if current <= previous or not (valid_window clip previous current looping) or clip.events.length == 0:
    return #[]
  let first = 0.0
  let cycles = 1
  if looping:
    first := floor (previous / clip.duration)
    let final = floor (current / clip.duration)
    if final - first >= 4096.0:
      return #[]
    cycles := F32.to_u32 (final - first) + 1
  let count = 0
  // Flatten candidate visits: nested array writes and list prepends caused
  // the compiler to copy growing output across loop iterations.
  if cycles > 4294967295 / clip.events.length:
    return #[]
  let candidates = cycles * clip.events.length
  // The event index and its cycle's start time advance with the candidate
  // rather than by division: offset is (first + cycle) × duration, as each
  // cycle's times were reckoned before.
  let list = clip.events
  let n = list.length
  let duration = clip.duration
  let event = 0
  let cycle = 0
  let offset = (first + U32.to_f32 cycle) * duration
  for 0..candidates:
    let at = list[event].time
    let time = at
    if looping:
      time := offset + at
    if time > previous and time <= current:
      if looping or at <= duration:
        count := self + 1
    event := self + 1
    if event == n:
      event := 0
      cycle := self + 1
      offset := (first + U32.to_f32 cycle) * duration
  let found = @array.fill count 0
  let output = 0
  event := 0
  cycle := 0
  offset := (first + U32.to_f32 cycle) * duration
  for 0..candidates:
    let at = list[event].time
    let time = at
    if looping:
      time := offset + at
    if time > previous and time <= current:
      if looping or at <= duration:
        found[output] := list[event].id
        output := self + 1
    event := self + 1
    if event == n:
      event := 0
      cycle := self + 1
      offset := (first + U32.to_f32 cycle) * duration
  return found

// Convert an affine transform to a column-major 4x4 matrix suitable for GPU
// skinning palettes and draw transforms.
func affine_to_mat4 (a: transform.Affine3) : math.Mat4 => return $math.Mat4 {
  xx: a.x.x, xy: a.x.y, xz: a.x.z, xw: 0.0,
  yx: a.y.x, yy: a.y.y, yz: a.y.z, yw: 0.0,
  zx: a.z.x, zy: a.z.y, zz: a.z.z, zw: 0.0,
  wx: a.position.x, wy: a.position.y, wz: a.position.z, ww: 1.0,
}

// Inverse bind transforms for `joints` from a skeleton's local rest pose.
// Rejects invalid parent order, out-of-range joint indices or singular bones.
func bind_inverses (rest: #[transform.Pose3]) -> (parents: #[U32]) -> (joints: #[U32]) : Maybe #[transform.Affine3] =>
  if not (valid_parents parents rest.length):
    return $Nothing
  let rest_world = world rest parents
  let out = @array.fill joints.length transform.identity3
  for i in 0 .. joints.length:
    let node = joints[i]
    if node >= rest_world.length:
      return $Nothing
    let $Some inv = transform.inverse3 rest_world[node] else:
      return $Nothing
    out[i] := inv
  return $Some out

// Skinning matrix palette: `world[joints[i]] * inverse_bind[i]` for each joint.
func skin_matrices (world_pose: #[transform.Affine3]) -> (joints: #[U32]) -> (inverse_bind: #[transform.Affine3]) : Maybe #[math.Mat4] =>
  if joints.length != inverse_bind.length:
    return $Nothing
  let out = @array.fill joints.length math.Mat4.identity
  for i in 0 .. joints.length:
    let node = joints[i]
    if node >= world_pose.length:
      return $Nothing
    out[i] := affine_to_mat4 (transform.compose3 world_pose[node] inverse_bind[i])
  return $Some out

// World transform of a bone socket (attachment point) at `local` relative to `bone`.
func socket (world_pose: #[transform.Affine3]) -> (bone: U32) -> (local: transform.Pose3) : Maybe transform.Affine3 =>
  if bone >= world_pose.length:
    return $Nothing
  if not (math.finite3 local.position and math.finite3 local.scale and math.finite_quat local.rotation):
    return $Nothing
  return $Some (transform.compose3 world_pose[bone] (transform.affine3 local))
