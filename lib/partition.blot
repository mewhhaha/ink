// Balanced disjoint half-open ranges. The arithmetic stays within `count`,
// including U32's maximum. Ranges concatenate in increasing input order.
type Range is data = #Range { start: U32, count: U32 }
const at = fn (count: U32) => fn (parts: U32) => fn (index: U32) => do:
  if parts == 0 || index >= parts:
    return #Nothing
  let width = count / parts
  let extra = count % parts
  return #Some (#Range { start: index * width + min index extra,
    count: width + (if index < extra then 1 else 0) })
const four = fn (count: U32) => fn (index: U32) => do:
  let #Some range = at count 4 index else:
    return @panic "partition index is outside four ranges"
  return range
