import * as changes from "../changes"
import * as render from "../render"
import * as transform from "../transform"
import * as math from "../math"

// One separately named mutable pool. Retaining its descriptor is an alias;
// explicit copy_into is the only checkpoint operation. Restore starts cold.
type Stored is data = $Stored {mesh: U32, material: U32, matrix: math.Mat4, parameters: Maybe math.Vec4, extra_start: U32, extra_count: U32}
type Cache = #[Maybe Stored]
func empty () : Cache => #[]
func count (cached: Cache) => cached.length
func read (cached: Cache) -> index => if index < cached.length then cached[index] else $Nothing
func rows (cached: Cache) => &cached[0..cached.length]
func clear (cached: own Cache) : Cache =>
  @storage.truncate cached 0
  return cached
// Copy policy is explicit: payload rows are copied into the destination pool.
func store (draw: render.Draw) -> (extra: &[math.Vec4]) -> previous -> (payload: own #[math.Vec4]): (Stored, #[math.Vec4]) =>
  let start = payload.length
  if let $Some old = previous:
    if extra.length <= old.extra_count and old.extra_start <= payload.length and extra.length <= payload.length - old.extra_start:
      start := old.extra_start
  if start == payload.length:
    for value in extra:
      @storage.push payload value
  else:
    for index in 0 .. extra.length:
      payload[start + index] := extra[index]
  return ($Stored {mesh: draw.mesh, material: draw.material, matrix: draw.matrix, parameters: draw.parameters,
    extra_start: start, extra_count: extra.length}, payload)
func present (stored: Stored) -> (payload: &[math.Vec4]) -> (frame: own render.FrameAccess) : (render.Draw, render.FrameAccess) =>
  if stored.extra_start > payload.length or stored.extra_count > payload.length - stored.extra_start:
    return panic "cached draw payload span is outside its pool"
  let extra = render.no_span
  if stored.extra_count > 0:
    let (span, next_frame) = render.store_vectors (&payload[stored.extra_start..stored.extra_start + stored.extra_count]) frame
    frame := next_frame
    extra := span
  return ($render.Draw {mesh: stored.mesh, material: stored.material, matrix: stored.matrix, parameters: stored.parameters, extra}, frame)
func copy_into (destination: own Cache) -> (destination_payload: own #[math.Vec4]) -> (source: Cache) -> (source_payload: #[math.Vec4]) : (Cache, #[math.Vec4]) =>
  let s_len = source.length
  let d_len = destination.length
  let common = min s_len d_len
  for i in 0 .. common:
    destination[i] := source[i]
  for i in common .. s_len:
    @storage.push destination source[i]
  if d_len > s_len:
    @storage.truncate destination s_len
  let sp_len = source_payload.length
  let dp_len = destination_payload.length
  let p_common = min sp_len dp_len
  for i in 0 .. p_common:
    destination_payload[i] := source_payload[i]
  for i in p_common .. sp_len:
    @storage.push destination_payload source_payload[i]
  if dp_len > sp_len:
    @storage.truncate destination_payload sp_len
  return (destination, destination_payload)
func update_entry current -> previous -> appearances -> (previous_count: U32) -> (appearance_count: U32) -> (alpha: F32) -> (payload_len: U32) -> (index: U32) -> (cached: own Cache) : Cache =>
  if index < appearance_count:
    if let $Some pose = current.at index:
      if let $Some appearance = appearances.at index:
        let shown = if index < previous_count then (case previous.at index of
          $Some old => transform.interpolate old pose alpha
          $Nothing => pose) else pose
        let matrix = transform.matrix shown
        let start = payload_len
        if let $Some old = cached[index]:
          if old.extra_start <= payload_len:
            start := old.extra_start
        cached[index] := $Some ($Stored {mesh: appearance.mesh, material: appearance.material, matrix, parameters: $Nothing, extra_start: start, extra_count: 0})
        return cached
  cached[index] := $Nothing
  return cached
// Dirty inputs include every interpolating entity when alpha changes. Borrow
// current and previous from distinct owners; views do not preserve old values.
func update_changes current -> previous -> appearances -> (alpha: F32) -> (change: changes.Changes [changed_updated, changed_removed]) -> (cached: own Cache) -> (payload: own #[math.Vec4]): (Cache, #[math.Vec4]) =>
  let before = cached.length
  let current_count: U32 = current.length
  let previous_count: U32 = previous.length
  let appearance_count: U32 = appearances.length
  let payload_len = payload.length
  for before .. current_count:
    @storage.push cached $Nothing
  if change.reset:
    let removed_len: U32 = change.removed.length
    if removed_len == 0:
      for index in 0 .. current_count:
        cached := update_entry current previous appearances previous_count appearance_count alpha payload_len index self
    else:
      let updated: #[U32] = #[]
      let removed: #[U32] = #[]
      let norm = changes.make_into true change.updated change.removed updated removed
      let rem_pos: U32 = 0
      let norm_rem_len = norm.removed.length
      for index in 0 .. current_count:
        for rem_pos .. norm_rem_len:
          if norm.removed[rem_pos] >= index:
            break
          rem_pos := self + 1
        if rem_pos < norm_rem_len and norm.removed[rem_pos] == index:
          cached[index] := $Nothing
        else:
          cached := update_entry current previous appearances previous_count appearance_count alpha payload_len index self
  else:
    let up_len: U32 = change.updated.length
    let rem_len: U32 = change.removed.length
    let existing = min before current_count
    if rem_len == 0:
      let prev_idx: U32 = 0
      let ordered = true
      for i in 0 .. up_len:
        let idx = change.updated.at i
        if i > 0 and idx <= prev_idx:
          ordered := false
          break
        prev_idx := idx
      if ordered:
        for i in 0 .. up_len:
          let index = change.updated.at i
          if index < existing:
            cached := update_entry current previous appearances previous_count appearance_count alpha payload_len index self
      else:
        let norm_up = changes.unique change.updated
        for i in 0 .. norm_up.length:
          let index = norm_up[i]
          if index < existing:
            cached := update_entry current previous appearances previous_count appearance_count alpha payload_len index self
    else:
      let updated: #[U32] = #[]
      let removed: #[U32] = #[]
      let norm = changes.make_into false change.updated change.removed updated removed
      for i in 0 .. norm.updated.length:
        let index = norm.updated[i]
        if index < existing:
          cached := update_entry current previous appearances previous_count appearance_count alpha payload_len index self
      for i in 0 .. norm.removed.length:
        let index = norm.removed[i]
        if index < existing:
          cached[index] := $Nothing
    if before < current_count:
      if rem_len == 0:
        for index in before .. current_count:
          cached := update_entry current previous appearances previous_count appearance_count alpha payload_len index self
      else:
        let norm_rem = changes.unique change.removed
        let rem_pos: U32 = 0
        for index in before .. current_count:
          for rem_pos .. norm_rem.length:
            if norm_rem[rem_pos] >= index:
              break
            rem_pos := self + 1
          if rem_pos < norm_rem.length and norm_rem[rem_pos] == index:
            cached[index] := $Nothing
          else:
            cached := update_entry current previous appearances previous_count appearance_count alpha payload_len index self
  if current_count < cached.length:
    @storage.truncate cached current_count
  return (cached, payload)
func update current -> previous -> appearances -> alpha -> dirty -> (cached: own Cache) -> (payload: own #[math.Vec4]): (Cache, #[math.Vec4]) => return
  update_changes current previous appearances alpha (changes.borrow false dirty #[]) cached payload
// Output belongs to the frame. Traversal remains stable in entity order.
func all (index: U32) -> (draw: render.Draw) => true
func emit_stored (stored: Stored) -> (payload: &[math.Vec4]) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let (draw, next_frame) = present stored payload frame
  return render.push draw next_frame
func emit visible -> (cached: &[Maybe Stored]) -> (payload: &[math.Vec4]) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let count = cached.length
  for index in 0 .. count:
    if let $Some stored = cached[index]:
      let probe = $render.Draw {mesh: stored.mesh, material: stored.material, matrix: stored.matrix, parameters: stored.parameters, extra: render.no_span}
      if visible index probe:
        if stored.extra_count == 0:
          if stored.extra_start > payload.length:
            return panic "cached draw payload span is outside its pool"
          frame := render.push probe self
        else:
          frame := emit_stored stored payload self
  return frame
