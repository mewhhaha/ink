import { Vec3 } from "std/vector"
import * as math from "../math"
import * as render from "../render"

const gpu_particles_ext_tag: U32 = 65005

type Particle is data = $Particle {
  pos: Vec3, age: F32, vel: Vec3, lifetime: F32,
  color: math.Vec4, size: F32, rotation: F32, spin: F32, generation: F32,
}

type Config is data = $Config {
  max_particles: U32, dt: F32, gravity: Vec3, drag: F32,
  curl_strength: F32, curl_frequency: F32, restitution: F32, friction: F32,
  depth_thickness: F32, depth_collide: Bool, sub_emit_on_bounce: Bool,
  sub_emit_on_death: Bool, velocity_align: Bool, reseed_now: Bool,
  sub_emit_count: U32, sub_emit_speed: F32, sub_emit_life: F32, ambient: F32,
}

const default_config: Config = $Config {
  max_particles: 4096, dt: 1.0 / 60.0, gravity: math.vec3 0.0 (-9.81) 0.0,
  drag: 0.15, curl_strength: 1.5, curl_frequency: 0.45,
  restitution: 0.45, friction: 0.2, depth_thickness: 0.35,
  depth_collide: true, sub_emit_on_bounce: true, sub_emit_on_death: false,
  velocity_align: true, reseed_now: false, sub_emit_count: 3,
  sub_emit_speed: 4.0, sub_emit_life: 0.6, ambient: 0.35,
}

func particle (pos: Vec3) -> (vel: Vec3) -> (lifetime: F32) -> (size: F32) -> (color: math.Vec4) : Particle =>
  return $Particle { pos, age: 0.0, vel, lifetime, color, size, rotation: 0.0, spin: 0.0, generation: 0.0 }

func seed_count_fits (count: U32) : Bool =>
  return count <= (1048576 - 16) / 16

private func append_particle_lanes (config: Config) -> (particles: &[Particle]) -> (values: own #[F32]) : #[F32] =>
  let flags = (if config.depth_collide then 1 else 0)
    | (if config.sub_emit_on_bounce then 2 else 0)
    | (if config.sub_emit_on_death then 4 else 0)
    | (if config.velocity_align then 8 else 0)
    | (if config.reseed_now then 16 else 0)
  @storage.push values (U32.to_f32 config.max_particles)
  @storage.push values config.dt
  @storage.push values config.gravity.x
  @storage.push values config.gravity.y
  @storage.push values config.gravity.z
  @storage.push values config.drag
  @storage.push values config.curl_strength
  @storage.push values config.curl_frequency
  @storage.push values config.restitution
  @storage.push values config.friction
  @storage.push values config.depth_thickness
  @storage.push values (U32.to_f32 flags)
  @storage.push values (U32.to_f32 config.sub_emit_count)
  @storage.push values config.sub_emit_speed
  @storage.push values config.sub_emit_life
  @storage.push values config.ambient
  for i in 0 .. particles.length:
    let p = particles[i]
    @storage.push values p.pos.x
    @storage.push values p.pos.y
    @storage.push values p.pos.z
    @storage.push values p.age
    @storage.push values p.vel.x
    @storage.push values p.vel.y
    @storage.push values p.vel.z
    @storage.push values p.lifetime
    @storage.push values p.color.x
    @storage.push values p.color.y
    @storage.push values p.color.z
    @storage.push values p.color.w
    @storage.push values p.size
    @storage.push values p.rotation
    @storage.push values p.spin
    @storage.push values p.generation
  return values

// An oversized seed batch is rejected with an empty packet.
func pack_extension (config: Config) -> (particles: &[Particle]) : #[F32] =>
  if not (seed_count_fits particles.length):
    return #[]
  let values: #[F32] = #[]
  return append_particle_lanes config particles values

func emit_extension (config: Config) -> (particles: &[Particle]) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  if not (seed_count_fits particles.length):
    return frame
  let start = frame.extension_values.length
  frame.extension_values := append_particle_lanes config particles self
  let count = frame.extension_values.length - start
  @storage.push frame.extensions ($render.Extension { tag: gpu_particles_ext_tag, values: $render.Span { start, count } })
  return frame
