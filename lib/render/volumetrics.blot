import * as simd from "std/simd"
import { Vec3 } from "std/vector"
import * as array from "std/array"
import * as color from "../color"
import * as noise from "../noise"
import * as render from "../render"

// Froxel volumetric fog (`render.Fog`, `render.FogVolume`), as the host's
// volume shaders compute it: the CPU reference for the grid's tiers and its
// depth slicing, the medium at a point (the global mist, its noise, the local
// volumes), the height mist's optical depth, the Henyey-Greenstein phase, a
// froxel's light source, the front to back integration of a column and the
// temporal blend. Pen's WGSL (`volume_inject`, `volume_integrate`) is held to
// these formulas and to an independent f64 reference. Nothing here keeps state.

// ---------------------------------------------------------------- numerics

const log2e: F32 = 1.4426950408889634
const ln2: F32 = 0.6931471805599453

// e^x. Whole powers of two are taken out first (the reduced argument stays
// within +-ln2/2), so the series' remainder is far below F32's precision.
func exp (x: F32) : F32 =>
  if not (is_finite x):
    return if x > 0.0 then color.exp2 126.0 else 0.0
  let t = clamp (-126.0) 126.0 (x * log2e)
  let n = floor (t + 0.5)
  let y = (t - n) * ln2
  let series = 1.0 + y * (1.0 + y * (0.5 + y * (0.16666666666666666 + y * (0.041666666666666664 + y * (0.008333333333333333 + y * (0.001388888888888889 + y * (0.0001984126984126984 + y * 0.0000248015873015873)))))))
  let (scale, _, _, _) = simd.f32_from_bits (F32.to_u32 (n + 127.0) << 23, 0, 0, 0)
  return series * scale

// The natural logarithm of a positive finite number (`color.log2` otherwise).
func ln (x: F32) : F32 => color.log2 x * ln2

// ---------------------------------------------------------------- the grid

// The froxel grid a quality tier asks for. `width` x `height` froxels across
// the picture and `slices` deep; `filter` is the sun's shadow filter in the
// volume (0 a single tap, 1 sixteen); `octaves` the global mist's noise octaves.
// Tier 0 is off (all zero); 1 is low and 2 high, as are all above it.
type Grid is data = $Grid { width: U32, height: U32, slices: U32, filter: U32, octaves: U32 }

func grid (tier: U32) : Grid =>
  if tier == 0:
    return $Grid { width: 0, height: 0, slices: 0, filter: 0, octaves: 0 }
  if tier == 1:
    return $Grid { width: 80, height: 45, slices: 32, filter: 0, octaves: 2 }
  return $Grid { width: 160, height: 90, slices: 64, filter: 1, octaves: 3 }

// Whether the frame draws the froxel volume at `tier`: the tier is on and the
// fog reaches `distance` past the camera. Otherwise the mist is analytic.
func froxels (fog: render.Fog) -> (tier: U32) : Bool => tier > 0 and fog.distance > 0.0

// Most local volumes a frame publishes.
const max_volumes: U32 = 32

// ---------------------------------------------------------------- slicing

// The grid is sliced by the depth ahead of the camera along its view (not the
// distance along each ray), exponentially past a knee and almost linearly
// within it: boundary b of N has depth `knee * (exp(b / N * span) - 1)` with
// `knee = distance / 64` and `span = ln(1 + distance / knee) = ln 65`, so the
// last boundary is exactly `distance`. Slice k lies between boundaries k and
// k + 1 and is sampled at boundary coordinate k + 0.5.
const reach_ratio: F32 = 64.0
const span: F32 = 4.174387269895637

func knee (distance: F32) : F32 => distance / reach_ratio

func boundary_depth (distance: F32) -> (slices: U32) -> (boundary: F32) : F32 =>
  if slices == 0 or not (is_finite distance and is_finite boundary):
    return 0.0
  return knee distance * (exp (boundary / U32.to_f32 slices * span) - 1.0)

// Its inverse: the boundary coordinate of a depth.
func boundary_coordinate (distance: F32) -> (slices: U32) -> (depth: F32) : F32 =>
  if slices == 0 or not (is_finite distance and is_finite depth) or distance <= 0.0:
    return 0.0
  return U32.to_f32 slices * ln (1.0 + depth / knee distance) / span

// The depth where slice `k` is sampled.
func slice_centre (distance: F32) -> (slices: U32) -> (k: U32) : F32 =>
  return boundary_depth distance slices (U32.to_f32 k + 0.5)

// How far along the ray `ray` slice `k` runs: `ray` is the view-space ray
// through a froxel with a z of -1, so a step along it is longer than the depth
// it gains by the ray's slant.
func slice_length (distance: F32) -> (slices: U32) -> (ray: Vec3) -> (k: U32) : F32 =>
  let near = boundary_depth distance slices (U32.to_f32 k)
  let far = boundary_depth distance slices (U32.to_f32 k + 1.0)
  return (far - near) * ray.length

// ---------------------------------------------------------------- the medium

// The global mist's noise factor at `p`: `max 0 (1 + noise * fbm q)` with `q`
// the point carried by `drift` in units of `noise_scale`, so it varies the
// density between nothing (noise 1) and twice the mean while the mean stays
// what it was. Noise 0 is a factor of 1. `octaves` is the tier's.
func noise_factor (fog: render.Fog) -> (octaves: U32) -> (p: Vec3) : F32 =>
  if not (is_finite fog.noise and is_finite fog.noise_scale) or fog.noise <= 0.0 or fog.noise_scale <= 0.0:
    return 1.0
  let q = (p + fog.drift) / fog.noise_scale
  return max 0.0 (1.0 + fog.noise * noise.fbm_value3 0 octaves q)

// How much of the global mist's density reaches distance `r` from the vertical
// axis through the origin: 0 inside `radius`, 1 beyond it (smoothly over
// `edge` when that is above 0).
func radial_mask (fog: render.Fog) -> (r: F32) : F32 =>
  if fog.edge > 0.0:
    return smoothstep fog.radius (fog.radius + fog.edge) r
  if r > fog.radius:
    return 1.0
  return 0.0

// The global mist's extinction at `p` per world unit: `density`, falling off
// with height above y = 0 over `height` (a positive number), cleared inside
// `radius` and varied by the noise.
func global_density (fog: render.Fog) -> (octaves: U32) -> (p: Vec3) : F32 =>
  if not (is_finite fog.density and is_finite fog.height) or fog.density <= 0.0 or fog.height <= 0.0:
    return 0.0
  let r = sqrt (p.x * p.x + p.z * p.z)
  let mask = radial_mask fog r
  if mask <= 0.0:
    return 0.0
  let fall = max p.y 0.0 / fog.height
  return fog.density * exp (0.0 - fall) * mask * noise_factor fog octaves p

// A local volume's share of its density at `p`: with d = (p - centre) / extent
// by axis and m the box's largest |d| (shape 0) or the ellipsoid's |d|, the
// density rises over `falloff` of the half size in from the edge (`t` clamps
// (1 - m) / falloff to 0..1; a falloff of 0 is a hard edge, t 1 inside) with a
// smoothstep, `t * t * (3 - 2 t)`. A half size of 0 or less holds nothing.
func local_weight (volume: render.FogVolume) -> (p: Vec3) : F32 =>
  let ex = volume.extent.x
  let ey = volume.extent.y
  let ez = volume.extent.z
  if ex <= 0.0 or ey <= 0.0 or ez <= 0.0:
    return 0.0
  let ox = p.x - volume.centre.x
  let oy = p.y - volume.centre.y
  let oz = p.z - volume.centre.z
  if abs ox >= ex or abs oy >= ey or abs oz >= ez:
    return 0.0
  let dx = ox / ex
  let dy = oy / ey
  let dz = oz / ez
  let m = if volume.shape == 0 then max (abs dx) (max (abs dy) (abs dz)) else sqrt (dx * dx + dy * dy + dz * dz)
  let t = if volume.falloff > 0.0 then clamp 0.0 1.0 ((1.0 - m) / volume.falloff) else (if m < 1.0 then 1.0 else 0.0)
  return t * t * (3.0 - 2.0 * t)

// The medium at a point: its total extinction, the extinction that scatters by
// channel (`scattering`, extinction times albedo) and the light it gives out
// per unit of length (`emitted`, the sum of density times emission).
type Medium is data = $Medium { extinction: F32, scattering: Vec3, emitted: Vec3 }

// The global mist and every local volume at `p`: extinctions add, scattering
// adds sigma * albedo per channel, emission adds sigma * emission.
func medium_at (fog: render.Fog) -> (volumes: &[render.FogVolume]) -> (octaves: U32) -> (p: Vec3) : Medium =>
  let global = global_density fog octaves p
  let extinction = global
  let sr = global * fog.albedo.x
  let sg = global * fog.albedo.y
  let sb = global * fog.albedo.z
  let er = 0.0
  let eg = 0.0
  let eb = 0.0
  for i in 0 .. volumes.length:
    let volume = volumes[i]
    if volume.density != 0.0:
      let sigma = volume.density * local_weight volume p
      if sigma != 0.0:
        extinction := self + sigma
        sr := self + sigma * volume.albedo.x
        sg := self + sigma * volume.albedo.y
        sb := self + sigma * volume.albedo.z
        er := self + sigma * volume.emission.x
        eg := self + sigma * volume.emission.y
        eb := self + sigma * volume.emission.z
  return $Medium {
    extinction,
    scattering: $Vec3 { x: sr, y: sg, z: sb },
    emitted: $Vec3 { x: er, y: eg, z: eb },
  }

// The global mist's optical depth along the straight segment from `a` to `b`,
// as the host's analytic fog integrates it (no radius, noise or local volumes):
// the exact integral of `density * exp (-y / height)` for the heights above 0
// clamped at the ends, `length * density * height * (exp(-ya / height) -
// exp(-yb / height)) / (yb - ya)`, and `length * density * exp(-ya / height)`
// when the heights are within 0.01. A segment crossing y = 0 is approximated.
func height_optical_depth (fog: render.Fog) -> (a: Vec3) -> (b: Vec3) : F32 =>
  if not (is_finite fog.density and is_finite fog.height and is_finite a.x and is_finite a.y and is_finite a.z and is_finite b.x and is_finite b.y and is_finite b.z) or fog.density <= 0.0 or fog.height <= 0.0:
    return 0.0
  let ya = max a.y 0.0
  let yb = max b.y 0.0
  let length = (b - a).length
  if not (is_finite length):
    let hx = abs (b.x * 0.5 - a.x * 0.5)
    let hy = abs (b.y * 0.5 - a.y * 0.5)
    let hz = abs (b.z * 0.5 - a.z * 0.5)
    let m = max hx (max hy hz)
    if not (is_finite m):
      return 0.0
    if m == 0.0:
      length := 0.0
    else:
      let sx = hx / m
      let sy = hy / m
      let sz = hz / m
      length := (2.0 * m) * sqrt (sx * sx + sy * sy + sz * sz)
      if not (is_finite length):
        return 0.0
  let factor = if abs (yb - ya) < 0.01 then fog.density * exp (0.0 - ya / fog.height) else fog.density * (fog.height * (exp (0.0 - ya / fog.height) - exp (0.0 - yb / fog.height)) / (yb - ya))
  if not (is_finite factor) or factor <= 0.0 or length <= 0.0:
    return 0.0
  let od = length * factor
  if is_finite od:
    return max 0.0 od
  return 1.0e30

// ---------------------------------------------------------------- phase and light

// pi times the Henyey-Greenstein phase function, `(1 - g^2) / (4 (1 + g^2 -
// 2 g c)^1.5)`: `g` (clamped to +-0.95) is the asymmetry and `c` the cosine of
// the angle between the direction toward the light and the direction from the
// camera to the point (so g > 0 brightens looking toward the light).
func phase_scaled (g: F32) -> (c: F32) : F32 =>
  let k = clamp (-0.95) 0.95 g
  let d = max 0.0001 (1.0 + k * k - 2.0 * k * c)
  return (1.0 - k * k) / (4.0 * d * sqrt d)

// The Henyey-Greenstein phase function itself, which integrates to 1 over the sphere.
func phase_hg (g: F32) -> (c: F32) : F32 => phase_scaled g c / pi

// The radiance a light of colour `light` gives a unit of scattering toward the
// eye: its colour times the scaled phase times its `visibility` (its shadow,
// 0 to 1, and whatever falloff the caller applies). The medium's `scattering`
// multiplies it, per channel, in `scatter_source`.
func in_scatter (light: Vec3) -> (g: F32) -> (c: F32) -> (visibility: F32) : Vec3 =>
  light * (phase_scaled g c * visibility)

// The sun's term: `in_scatter` with the mist's own anisotropy, scaled by `fog.sun`.
func sun_term (fog: render.Fog) -> (sun: Vec3) -> (c: F32) -> (visibility: F32) : Vec3 =>
  in_scatter sun fog.anisotropy c visibility * fog.sun

// The ambient colour: the mean light all round blended toward the sky's own
// colour in the direction looked by `fog.sky`, scaled by `fog.ambient`.
func ambient_term (fog: render.Fog) -> (mean: Vec3) -> (sky: Vec3) : Vec3 =>
  (mean * (1.0 - fog.sky) + sky * fog.sky) * fog.ambient

// A froxel's source term: the light the medium sends toward the eye per unit of
// length, `scattering * (sun + ambient + lights) + emitted`, by channel.
func scatter_source (medium: Medium) -> (sun: Vec3) -> (ambient: Vec3) -> (lights: Vec3) : Vec3 =>
  let s = medium.scattering
  let e = medium.emitted
  return $Vec3 {
    x: s.x * (sun.x + ambient.x + lights.x) + e.x,
    y: s.y * (sun.y + ambient.y + lights.y) + e.y,
    z: s.z * (sun.z + ambient.z + lights.z) + e.z,
  }

// ---------------------------------------------------------------- integration

// One slice of a column: its `source` term, its `extinction` and `delta`, the
// length of its segment along the ray.
type Slice is data = $Slice { source: Vec3, extinction: F32, delta: F32 }

// What a slice lets through: exp(-extinction * delta).
func slice_keep (slice: Slice) : F32 => exp (0.0 - slice.extinction * slice.delta)

// 1 - exp(-x) for x >= 0, by its series where the subtraction would cancel.
func one_minus_exp (x: F32) : F32 =>
  if x < 0.01:
    return x * (1.0 - x * 0.5 * (1.0 - x * 0.3333333333333333 * (1.0 - x * 0.25 * (1.0 - x * 0.2))))
  return 1.0 - exp (0.0 - x)

// The light a slice adds before its own attenuation: its source over its
// segment against its own transmittance, `source * (1 - T) / extinction`
// (`source * delta` when the extinction is vanishing, 1e-6 or less), exact
// however thick. The host evaluates `1 - T` directly, which loses digits to
// cancellation when `extinction * delta` is under about 1e-3; this does not.
func slice_gain (slice: Slice) : Vec3 =>
  if slice.extinction > 0.000001:
    return slice.source * (one_minus_exp (slice.extinction * slice.delta) / slice.extinction)
  return slice.source * slice.delta

// Lanes of a boundary in an integrated column: the light in-scattered toward
// the eye (r, g, b) and the optical depth.
const column_stride: U32 = 4

// Integrates a column front to back, `light += transmittance * gain` and
// `transmittance *= keep` slice by slice, and gives the cumulative in-scattered
// light and optical depth at every boundary, `column_stride` lanes each, the
// first (boundary 0) all zero and boundary k + 1 the sum through slice k.
func integrate_column (slices: &[Slice]) : #[F32] =>
  let n = slices.length
  if n >= 4294967295 / column_stride:
    return #[]
  let column = array.fill ((n + 1) * column_stride) 0.0
  let r = 0.0
  let g = 0.0
  let b = 0.0
  let transmittance = 1.0
  let depth = 0.0
  for k in 0 .. n:
    let slice = slices[k]
    let tau = slice.extinction * slice.delta
    let keep = exp (0.0 - tau)
    let gain_scale = if slice.extinction > 0.000001
      then (if tau < 0.01 then one_minus_exp tau else 1.0 - keep) / slice.extinction
      else slice.delta
    r := self + transmittance * (slice.source.x * gain_scale)
    g := self + transmittance * (slice.source.y * gain_scale)
    b := self + transmittance * (slice.source.z * gain_scale)
    transmittance := self * keep
    depth := self + tau
    let at = (k + 1) * column_stride
    column[at] := r
    column[at + 1] := g
    column[at + 2] := b
    column[at + 3] := depth
  return column

func column_light (column: #[F32]) -> (boundary: U32) : Vec3 =>
  if boundary > 4294967295 / column_stride or column.length < column_stride or boundary * column_stride > column.length - column_stride:
    return $Vec3 { x: 0.0, y: 0.0, z: 0.0 }
  let at = boundary * column_stride
  return $Vec3 { x: column[at], y: column[at + 1], z: column[at + 2] }
func column_depth (column: #[F32]) -> (boundary: U32) : F32 =>
  if boundary > 4294967295 / column_stride or column.length < column_stride or boundary * column_stride > column.length - column_stride:
    return 0.0
  return column[boundary * column_stride + 3]

// What the eye sees of `scene` through a stretch of volume: the scene's light
// attenuated by exp(-tau) plus the light the volume in-scattered.
func apply (scene: Vec3) -> (inscattered: Vec3) -> (tau: F32) : Vec3 =>
  scene * exp (0.0 - tau) + inscattered

// ---------------------------------------------------------------- history

// How much of last frame's froxel the blend keeps when nothing has changed.
const history_share: F32 = 0.9

// `current` and `history` mixed by `weight` of the history: `current * (1 -
// weight) + history * weight`.
func blend_history (history: F32) -> (current: F32) -> (weight: F32) : F32 =>
  current * (1.0 - weight) + history * weight

func blend_history3 (history: Vec3) -> (current: Vec3) -> (weight: F32) : Vec3 =>
  current * (1.0 - weight) + history * weight

// The share of the history the blend keeps: `weight` less as the extinction
// changed, `weight * (1 - smoothstep 0.25 0.75 (|current - history| / max
// current history 1e-5))` (a medium that thickened or thinned since is not what
// the history saw), and none at all when there is no valid history.
func history_weight (weight: F32) -> (valid: Bool) -> (current: F32) -> (history: F32) : F32 =>
  if not valid:
    return 0.0
  let change = abs (current - history) / max (max current history) 0.00001
  return weight * (1.0 - smoothstep 0.25 0.75 change)
