import { Vec2 } from "std/vector"
import * as math from "../math"
import * as render from "../render"

const render2d_sdf_ext_tag: U32 = 65008
const render2d_world_ext_tag: U32 = 65009

type SdfKind is data = $RoundedRect | $Ellipse | $Capsule
type GradientKind is data = $Solid | $Linear | $Radial

// Rectangles use top-left X/Y and width/height in pixels. Radii are ordered
// top-left, top-right, bottom-right, bottom-left. Colors are straight RGBA.
type SdfShape is data = $SdfShape {
  rect: math.Vec4, corner_radii: math.Vec4,
  fill_color: math.Vec4, fill_color_end: math.Vec4,
  border_color: math.Vec4, shadow_color: math.Vec4,
  kind: SdfKind, border_width_px: F32, gradient_kind: GradientKind, gradient_angle: F32,
  shadow_offset: Vec2, shadow_blur_px: F32, clip_radius_px: F32, clip_rect: math.Vec4,
  overlay: Bool,
}

private const clear = math.vec4 0.0 0.0 0.0 0.0

func rounded_rect (rect: math.Vec4) -> (corner_radii: math.Vec4) -> (color: math.Vec4) : SdfShape =>
  return $SdfShape {
    rect, corner_radii, fill_color: color, fill_color_end: color,
    border_color: clear, shadow_color: clear, kind: $RoundedRect,
    border_width_px: 0.0, gradient_kind: $Solid, gradient_angle: 0.0,
    shadow_offset: math.vec2 0.0 0.0, shadow_blur_px: 0.0, clip_radius_px: 0.0,
    clip_rect: clear, overlay: false,
  }

func circle (center: Vec2) -> (radius: F32) -> (color: math.Vec4) : SdfShape =>
  let shape = rounded_rect (math.vec4 (center.x - radius) (center.y - radius) (2.0 * radius) (2.0 * radius)) clear color
  shape.kind := $Ellipse
  return shape

func capsule (rect: math.Vec4) -> (color: math.Vec4) : SdfShape =>
  let shape = rounded_rect rect clear color
  shape.kind := $Capsule
  return shape

func card (rect: math.Vec4) -> (radius: F32) -> (fill_color: math.Vec4) -> (border_color: math.Vec4) -> (border_width_px: F32) -> (shadow_color: math.Vec4) -> (shadow_offset: Vec2) -> (shadow_blur_px: F32) : SdfShape =>
  let shape = rounded_rect rect (math.vec4 radius radius radius radius) fill_color
  shape.border_color := border_color
  shape.border_width_px := border_width_px
  shape.shadow_color := shadow_color
  shape.shadow_offset := shadow_offset
  shape.shadow_blur_px := shadow_blur_px
  shape.overlay := true
  return shape

private func append_sdf_shape (s: SdfShape) -> (values: own #[F32]) : #[F32] =>
  let kind = case s.kind of
    $RoundedRect => 0.0
    $Ellipse => 1.0
    $Capsule => 2.0
  let gradient = case s.gradient_kind of
    $Solid => 0.0
    $Linear => 1.0
    $Radial => 2.0
  let overlay = if s.overlay then 16.0 else 0.0
  @storage.push values s.rect.x
  @storage.push values s.rect.y
  @storage.push values s.rect.z
  @storage.push values s.rect.w
  @storage.push values s.corner_radii.x
  @storage.push values s.corner_radii.y
  @storage.push values s.corner_radii.z
  @storage.push values s.corner_radii.w
  @storage.push values s.fill_color.x
  @storage.push values s.fill_color.y
  @storage.push values s.fill_color.z
  @storage.push values s.fill_color.w
  @storage.push values s.fill_color_end.x
  @storage.push values s.fill_color_end.y
  @storage.push values s.fill_color_end.z
  @storage.push values s.fill_color_end.w
  @storage.push values s.border_color.x
  @storage.push values s.border_color.y
  @storage.push values s.border_color.z
  @storage.push values s.border_color.w
  @storage.push values s.shadow_color.x
  @storage.push values s.shadow_color.y
  @storage.push values s.shadow_color.z
  @storage.push values s.shadow_color.w
  @storage.push values (kind + overlay)
  @storage.push values s.border_width_px
  @storage.push values gradient
  @storage.push values s.gradient_angle
  @storage.push values s.shadow_offset.x
  @storage.push values s.shadow_offset.y
  @storage.push values s.shadow_blur_px
  @storage.push values s.clip_radius_px
  @storage.push values s.clip_rect.x
  @storage.push values s.clip_rect.y
  @storage.push values s.clip_rect.z
  @storage.push values s.clip_rect.w
  return values

private func write_sdf_shape (s: SdfShape) -> (at: U32) -> (values: own #[F32]) : #[F32] =>
  let kind = case s.kind of
    $RoundedRect => 0.0
    $Ellipse => 1.0
    $Capsule => 2.0
  let gradient = case s.gradient_kind of
    $Solid => 0.0
    $Linear => 1.0
    $Radial => 2.0
  let overlay = if s.overlay then 16.0 else 0.0
  values[at] := s.rect.x
  values[at + 1] := s.rect.y
  values[at + 2] := s.rect.z
  values[at + 3] := s.rect.w
  values[at + 4] := s.corner_radii.x
  values[at + 5] := s.corner_radii.y
  values[at + 6] := s.corner_radii.z
  values[at + 7] := s.corner_radii.w
  values[at + 8] := s.fill_color.x
  values[at + 9] := s.fill_color.y
  values[at + 10] := s.fill_color.z
  values[at + 11] := s.fill_color.w
  values[at + 12] := s.fill_color_end.x
  values[at + 13] := s.fill_color_end.y
  values[at + 14] := s.fill_color_end.z
  values[at + 15] := s.fill_color_end.w
  values[at + 16] := s.border_color.x
  values[at + 17] := s.border_color.y
  values[at + 18] := s.border_color.z
  values[at + 19] := s.border_color.w
  values[at + 20] := s.shadow_color.x
  values[at + 21] := s.shadow_color.y
  values[at + 22] := s.shadow_color.z
  values[at + 23] := s.shadow_color.w
  values[at + 24] := kind + overlay
  values[at + 25] := s.border_width_px
  values[at + 26] := gradient
  values[at + 27] := s.gradient_angle
  values[at + 28] := s.shadow_offset.x
  values[at + 29] := s.shadow_offset.y
  values[at + 30] := s.shadow_blur_px
  values[at + 31] := s.clip_radius_px
  values[at + 32] := s.clip_rect.x
  values[at + 33] := s.clip_rect.y
  values[at + 34] := s.clip_rect.z
  values[at + 35] := s.clip_rect.w
  return values

func pack_sdf_extension (shapes: &[SdfShape]) : #[F32] =>
  let values = @array.fill (shapes.length * 36) 0.0
  for i in 0 .. shapes.length:
    values := write_sdf_shape shapes[i] (i * 36) self
  return values

func emit_sdf_extension (shapes: &[SdfShape]) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let start = frame.extension_values.length
  let count = shapes.length * 36
  for i in 0 .. shapes.length:
    frame.extension_values := append_sdf_shape shapes[i] self
  @storage.push frame.extensions ($render.Extension { tag: render2d_sdf_ext_tag, values: $render.Span { start, count } })
  return frame

type Camera2d is data = $Camera2d { center: Vec2, zoom: F32, rotation: F32 }

type TileCell = U32

// Tile IDs are one-based. Zero is transparent. Mask each field to its wire
// width so the packed cell is always exact in F32.
func tile_cell (tile_id: U32) -> (flip_x: Bool) -> (flip_y: Bool) -> (rot90: Bool) -> (anim_frames: U32) : TileCell =>
  let x = if flip_x then 1 else 0
  let y = if flip_y then 1 else 0
  let rotated = if rot90 then 1 else 0
  return (tile_id & 65535) | (x << 16) | (y << 17) | (rotated << 18) | ((anim_frames & 31) << 19)

type TilemapHeader is data = $TilemapHeader {
  material_idx: F32, origin: Vec2, tile_size: Vec2,
  grid_w: U32, grid_h: U32, atlas_cols: U32, atlas_rows: U32,
  anim_time: F32, anim_fps: F32, tint: math.Vec4,
}

type Sprite2d is data = $Sprite2d {
  material_idx: F32, pos: Vec2, size: Vec2, pivot: Vec2, rotation: F32, z_layer: F32,
  uv_rect: math.Vec4, color: math.Vec4, nine_slice: math.Vec4,
  flip_x: Bool, flip_y: Bool, tex_size: Vec2,
}

// Radiance Cascades rasterizes emitters in screen pixels with +Y down.
type Emitter2d is data =
  | $Circle { center: Vec2, radius: F32, material: math.Vec4 }
  | $Rect { rect: math.Vec4, material: math.Vec4 }

type Rc2dConfig is data = $Rc2dConfig {
  mode: U32, c0_spacing: U32, c0_dirs: U32, cascades: U32,
  ambient: F32, multiply: F32, add: F32,
}

private func tilemap_cell_count (tilemap: Maybe TilemapHeader) -> (available: U32) : U32 =>
  let $Some t = tilemap else:
    return 0
  if t.grid_w < 1 or t.grid_w > 1024 or t.grid_h < 1 or t.grid_h > 1024:
    return 0
  let count = t.grid_w * t.grid_h
  return if count <= available then count else 0

func world_extension_fits (tilemap: Maybe TilemapHeader) -> (available_cells: U32) -> (sprite_count: U32) -> (rc_mode: U32) -> (emitter_count: U32) : Bool =>
  let cells = tilemap_cell_count tilemap available_cells
  let header = 8 + (if (rc_mode & 3) != 0 then 6 else 0) + (if cells > 0 then 15 else 0)
  let remaining = 1048576 - header
  if cells > remaining or sprite_count > (remaining - cells) / 25:
    return false
  return emitter_count <= (remaining - cells - sprite_count * 25) / 9

private func append_world_lanes (camera: Camera2d) -> (y_sort: Bool) -> (tilemap_opt: Maybe TilemapHeader) -> (tilemap_cells: &[TileCell]) -> (sprites: &[Sprite2d]) -> (rc_config: Rc2dConfig) -> (emitters: &[Emitter2d]) -> (values: own #[F32]) : #[F32] =>
  let cells = tilemap_cell_count tilemap_opt tilemap_cells.length
  let mode = rc_config.mode & 3
  let flags = mode | (if y_sort then 4 else 0)
  @storage.push values camera.center.x
  @storage.push values camera.center.y
  @storage.push values camera.zoom
  @storage.push values camera.rotation
  @storage.push values (if cells > 0 then 1.0 else 0.0)
  @storage.push values (U32.to_f32 sprites.length)
  @storage.push values (U32.to_f32 emitters.length)
  @storage.push values (U32.to_f32 flags)
  if mode != 0:
    @storage.push values (U32.to_f32 rc_config.c0_spacing)
    @storage.push values (U32.to_f32 rc_config.c0_dirs)
    @storage.push values (U32.to_f32 rc_config.cascades)
    @storage.push values rc_config.ambient
    @storage.push values rc_config.multiply
    @storage.push values rc_config.add
  case tilemap_opt of
    $Nothing => ()
    $Some t => do:
      if cells > 0:
        @storage.push values t.material_idx
        @storage.push values t.origin.x
        @storage.push values t.origin.y
        @storage.push values t.tile_size.x
        @storage.push values t.tile_size.y
        @storage.push values (U32.to_f32 t.grid_w)
        @storage.push values (U32.to_f32 t.grid_h)
        @storage.push values (U32.to_f32 t.atlas_cols)
        @storage.push values (U32.to_f32 t.atlas_rows)
        @storage.push values t.anim_time
        @storage.push values t.anim_fps
        @storage.push values t.tint.x
        @storage.push values t.tint.y
        @storage.push values t.tint.z
        @storage.push values t.tint.w
        for i in 0 .. cells:
          @storage.push values (U32.to_f32 tilemap_cells[i])
      break ()
  for i in 0 .. sprites.length:
    let s = sprites[i]
    @storage.push values s.material_idx
    @storage.push values s.pos.x
    @storage.push values s.pos.y
    @storage.push values s.size.x
    @storage.push values s.size.y
    @storage.push values s.pivot.x
    @storage.push values s.pivot.y
    @storage.push values s.rotation
    @storage.push values s.z_layer
    @storage.push values s.uv_rect.x
    @storage.push values s.uv_rect.y
    @storage.push values s.uv_rect.z
    @storage.push values s.uv_rect.w
    @storage.push values s.color.x
    @storage.push values s.color.y
    @storage.push values s.color.z
    @storage.push values s.color.w
    @storage.push values s.nine_slice.x
    @storage.push values s.nine_slice.y
    @storage.push values s.nine_slice.z
    @storage.push values s.nine_slice.w
    @storage.push values (if s.flip_x then 1.0 else 0.0)
    @storage.push values (if s.flip_y then 1.0 else 0.0)
    @storage.push values s.tex_size.x
    @storage.push values s.tex_size.y
  for i in 0 .. emitters.length:
    let (kind, geometry, material) = case emitters[i] of
      $Circle { center, radius, material } => (0.0, math.vec4 center.x center.y radius 0.0, material)
      $Rect { rect, material } => (1.0, rect, material)
    @storage.push values kind
    @storage.push values geometry.x
    @storage.push values geometry.y
    @storage.push values geometry.z
    @storage.push values geometry.w
    @storage.push values material.x
    @storage.push values material.y
    @storage.push values material.z
    @storage.push values material.w
  return values

// Invalid or incomplete tilemaps are omitted. A complete payload that exceeds
// Pen's lane budget is rejected with an empty packet.
func pack_world_extension (camera: Camera2d) -> (y_sort: Bool) -> (tilemap_opt: Maybe TilemapHeader) -> (tilemap_cells: &[TileCell]) -> (sprites: &[Sprite2d]) -> (rc_config: Rc2dConfig) -> (emitters: &[Emitter2d]) : #[F32] =>
  if not (world_extension_fits tilemap_opt tilemap_cells.length sprites.length rc_config.mode emitters.length):
    return #[]
  let values: #[F32] = #[]
  return append_world_lanes camera y_sort tilemap_opt tilemap_cells sprites rc_config emitters values

func emit_world_extension (camera: Camera2d) -> (y_sort: Bool) -> (tilemap_opt: Maybe TilemapHeader) -> (tilemap_cells: &[TileCell]) -> (sprites: &[Sprite2d]) -> (rc_config: Rc2dConfig) -> (emitters: &[Emitter2d]) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  if not (world_extension_fits tilemap_opt tilemap_cells.length sprites.length rc_config.mode emitters.length):
    return frame
  let start = frame.extension_values.length
  frame.extension_values := append_world_lanes camera y_sort tilemap_opt tilemap_cells sprites rc_config emitters self
  let count = frame.extension_values.length - start
  @storage.push frame.extensions ($render.Extension { tag: render2d_world_ext_tag, values: $render.Span { start, count } })
  return frame
