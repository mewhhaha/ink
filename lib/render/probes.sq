//! A caller-owned volume of diffuse light probes: an axis-aligned lattice of
//! `nx` x `ny` x `nz` points `spacing` apart from `origin`, probe index
//! (z * ny + y) * nx + x. Each probe holds the light a white surface facing a
//! normal would show there, as nine RGB spherical-harmonic terms in
//! `environment.basis` order, the cosine lobe applied and divided by pi (what
//! `environment.diffuse` gives for the sky), then a validity weight: 1, or 0
//! for a probe inside geometry. Probes live flat, `stride` floats each, in an
//! owner the caller names; nothing here keeps state between calls.
//!
//! Key items: [`Grid`], [`Light`], [`Sampled`], [`count`], [`lattice_position`].

import { Vec3 } from "std/vector"
import * as array from "std/array"
import * as environment from "../environment"
import * as math from "../math"
import * as scene from "../physics/scene"

type Grid is data = $Grid { origin: Vec3, spacing: F32, nx: U32, ny: U32, nz: U32 }
const stride: U32 = 28

private func grid_count (grid: Grid) : Maybe U32 =>
  if grid.nx == 0 or grid.ny == 0 or grid.nz == 0:
    return $Nothing
  if grid.ny > 4294967295 / grid.nx:
    return $Nothing
  let xy = grid.nx * grid.ny
  if grid.nz > 4294967295 / xy:
    return $Nothing
  return $Some (xy * grid.nz)

func count (grid: Grid) : U32 => case grid_count grid of
  $Some n => n
  $Nothing => 0
func lattice_position (grid: Grid) -> (index: U32) : Vec3 =>
  if grid.nx == 0 or grid.ny == 0 or grid.ny > 4294967295 / grid.nx:
    return grid.origin
  let x = index % grid.nx
  let y = (index / grid.nx) % grid.ny
  let z = index / (grid.nx * grid.ny)
  return $Vec3 {
    x: grid.origin.x + U32.to_f32 x * grid.spacing,
    y: grid.origin.y + U32.to_f32 y * grid.spacing,
    z: grid.origin.z + U32.to_f32 z * grid.spacing,
  }

// What a bake lights with. Rays that escape see `sky` (its gradient, no sun)
// times `tint`, as `environment.diffuse` scales it; surfaces they hit reflect
// the sun (`direction` is the way its rays travel, as in `render.Lighting`)
// when no shadow ray reaches it, plus `ambient` (a sky `environment.diffuse`'s
// coefficients) or, from a second bake on, the previous probes' light there.
// `rays` per probe go out along a spherical Fibonacci set up to `reach`
// metres, against the solids on `mask` layers.
type Light is data = $Light {
  sky: environment.Sky, tint: math.Color, ambient: environment.Irradiance,
  direction: Vec3, sun: math.Color, rays: U32, reach: F32, mask: U32,
}

// Where the point (no bias) or its `bias`-lifted lookup lands in the lattice
// is trilinear between eight probes; each corner's weight is its trilinear
// share times its validity times a smooth facing term (probes behind the
// surface weigh little), so a wall does not hand its other side's light
// through. `confidence` is 0 outside the lattice (fading in over one cell
// beyond its edge), and the share of valid corners inside: blend toward the
// sky with it. At a probe's centre the answer is exactly that probe's.
type Sampled is data = $Sampled { light: math.Color, confidence: F32 }
const no_light = $Sampled { light: math.rgb 0.0 0.0 0.0, confidence: 0.0 }

func axis (value: F32) => func (last: U32) =>
  let top = U32.to_f32 last
  return clamp 0.0 top value

func sample (grid: Grid) -> (values: #[F32]) -> (position: Vec3) -> (normal: Vec3) -> (bias: F32) : Sampled =>
  let $Some total_probes = grid_count grid else:
    return no_light
  if total_probes > 4294967295 / stride or values.length < total_probes * stride:
    return no_light
  if not (math.finite3 grid.origin and is_finite grid.spacing and grid.spacing > 0.0 and math.finite3 position and math.finite3 normal and is_finite bias):
    return no_light
  let n = normal.normalized
  let lifted = $Vec3 { x: position.x + n.x * bias, y: position.y + n.y * bias, z: position.z + n.z * bias }
  let gx = (lifted.x - grid.origin.x) / grid.spacing
  let gy = (lifted.y - grid.origin.y) / grid.spacing
  let gz = (lifted.z - grid.origin.z) / grid.spacing
  if not (is_finite gx and is_finite gy and is_finite gz):
    return no_light
  let edge = min (min (min gx (U32.to_f32 (grid.nx - 1) - gx)) (min gy (U32.to_f32 (grid.ny - 1) - gy))) (min gz (U32.to_f32 (grid.nz - 1) - gz))
  let reach = clamp 0.0 1.0 (edge + 1.0)
  if reach <= 0.0 or not (is_finite reach):
    return no_light
  let cx = axis gx (grid.nx - 1)
  let cy = axis gy (grid.ny - 1)
  let cz = axis gz (grid.nz - 1)
  let fx_floor = floor cx
  let fy_floor = floor cy
  let fz_floor = floor cz
  let ix = if grid.nx > 1 and fx_floor >= 0.0 and fx_floor < 4294967040.0 then min (F32.to_u32 fx_floor) (grid.nx - 2) else if grid.nx > 1 and fx_floor >= 4294967040.0 then grid.nx - 2 else 0
  let iy = if grid.ny > 1 and fy_floor >= 0.0 and fy_floor < 4294967040.0 then min (F32.to_u32 fy_floor) (grid.ny - 2) else if grid.ny > 1 and fy_floor >= 4294967040.0 then grid.ny - 2 else 0
  let iz = if grid.nz > 1 and fz_floor >= 0.0 and fz_floor < 4294967040.0 then min (F32.to_u32 fz_floor) (grid.nz - 2) else if grid.nz > 1 and fz_floor >= 4294967040.0 then grid.nz - 2 else 0
  let fx = cx - U32.to_f32 ix
  let fy = cy - U32.to_f32 iy
  let fz = cz - U32.to_f32 iz
  let t0 = 0.2820947918
  let t1 = 0.4886025119 * n.y
  let t2 = 0.4886025119 * n.z
  let t3 = 0.4886025119 * n.x
  let t4 = 1.0925484306 * n.x * n.y
  let t5 = 1.0925484306 * n.y * n.z
  let t6 = 0.3153915653 * (3.0 * n.z * n.z - 1.0)
  let t7 = 1.0925484306 * n.x * n.z
  let t8 = 0.5462742153 * (n.x * n.x - n.y * n.y)
  let r = 0.0
  let g = 0.0
  let b = 0.0
  let weight = 0.0
  let share = 0.0
  let total = 0.0
  let sp = grid.spacing
  let ox = grid.origin.x
  let oy = grid.origin.y
  let oz = grid.origin.z
  // A singleton axis clamps its fraction to zero. The upper corners on
  // trailing singleton axes never contribute to the trilinear sum.
  let corners = if grid.nz > 1 then 8 else if grid.ny > 1 then 4 else if grid.nx > 1 then 2 else 1
  for corner in 0 .. corners:
    let dx = corner & 1
    let dy = (corner >> 1) & 1
    let dz = (corner >> 2) & 1
    let x = min (ix + dx) (grid.nx - 1)
    let y = min (iy + dy) (grid.ny - 1)
    let z = min (iz + dz) (grid.nz - 1)
    let wx = if dx == 1 then fx else 1.0 - fx
    let wy = if dy == 1 then fy else 1.0 - fy
    let wz = if dz == 1 then fz else 1.0 - fz
    let tri = wx * wy * wz
    if tri > 0.0:
      let index = (z * grid.ny + y) * grid.nx + x
      let base = index * stride
      let valid = values[base + 27]
      total := self + tri
      share := self + tri * valid
      if valid > 0.0:
        let tx = ox + U32.to_f32 x * sp - position.x
        let ty = oy + U32.to_f32 y * sp - position.y
        let tz = oz + U32.to_f32 z * sp - position.z
        let length = sqrt (tx * tx + ty * ty + tz * tz)
        let facing = if length < 0.0001 then 1.0 else 0.5 + 0.5 * (tx * n.x + ty * n.y + tz * n.z) / length
        let w = tri * valid * max 0.02 (facing * facing)
        let cr = values[base] * t0 + values[base + 3] * t1 + values[base + 6] * t2 + values[base + 9] * t3 + values[base + 12] * t4 + values[base + 15] * t5 + values[base + 18] * t6 + values[base + 21] * t7 + values[base + 24] * t8
        let cg = values[base + 1] * t0 + values[base + 4] * t1 + values[base + 7] * t2 + values[base + 10] * t3 + values[base + 13] * t4 + values[base + 16] * t5 + values[base + 19] * t6 + values[base + 22] * t7 + values[base + 25] * t8
        let cb = values[base + 2] * t0 + values[base + 5] * t1 + values[base + 8] * t2 + values[base + 11] * t3 + values[base + 14] * t4 + values[base + 17] * t5 + values[base + 20] * t6 + values[base + 23] * t7 + values[base + 26] * t8
        r := self + w * max 0.0 cr
        g := self + w * max 0.0 cg
        b := self + w * max 0.0 cb
        weight := self + w
  if weight <= 0.000001 or total <= 0.0:
    return no_light
  let confidence = reach * reach * (3.0 - 2.0 * reach) * (share / total)
  return $Sampled { light: math.rgb (r / weight) (g / weight) (b / weight), confidence }

// The light of `light`'s sky at a surface facing `normal`, as the bake sees
// it past `previous` (a bake's values; empty for the sky alone): the previous
// probes where they have light to give, the sky's own ambient elsewhere.
func indirect (light: Light) -> (grid: Grid) -> (previous: #[F32]) -> (point: Vec3) -> (normal: Vec3) : math.Color =>
  let sky_light = environment.evaluate light.ambient normal
  if previous.length == 0:
    return sky_light
  let found = sample grid previous point normal (grid.spacing * 0.25)
  return math.Color.lerp sky_light found.light found.confidence

private func reflected_with_sun (scene_read: scene.Scene) -> (light: Light) -> (to_sun: Vec3) -> (to_sun_dir: Vec3) -> (grid: Grid) -> (previous: #[F32]) -> (albedo: math.Color) -> (point: Vec3) -> (normal: Vec3) : math.Color =>
  let facing = max 0.0 (normal.dot to_sun_dir)
  let direct = 0.0
  if facing > 0.0:
    let start = $Vec3 { x: point.x + normal.x * 0.05, y: point.y + normal.y * 0.05, z: point.z + normal.z * 0.05 }
    if not (scene.ray_any scene_read start to_sun light.reach light.mask 0):
      direct := facing
  let bounce = indirect light grid previous point normal
  return math.rgb
    (albedo.r * (light.sun.r * direct + bounce.r))
    (albedo.g * (light.sun.g * direct + bounce.g))
    (albedo.b * (light.sun.b * direct + bounce.b))

// Light leaving a point of a surface of `albedo` toward its viewers.
func reflected (scene_read: scene.Scene) -> (light: Light) -> (grid: Grid) -> (previous: #[F32]) -> (albedo: math.Color) -> (point: Vec3) -> (normal: Vec3) : math.Color =>
  let to_sun = $Vec3 { x: F32.neg light.direction.x, y: F32.neg light.direction.y, z: F32.neg light.direction.z }
  return reflected_with_sun scene_read light to_sun to_sun.normalized grid previous albedo point normal

private func build_ray_table (rays: U32) -> (weight: F32) : #[F32] =>
  let k1 = 0.4886025119 * weight * 2.0943951024
  let k2 = 1.0925484306 * weight * 0.7853981634
  let k6 = 0.3153915653 * weight * 0.7853981634
  let k8 = 0.5462742153 * weight * 0.7853981634
  let inv_rays = 1.0 / U32.to_f32 rays
  let table = @array.fill (rays * 11) 0.0
  for i in 0 .. rays:
    let y = 1.0 - 2.0 * (U32.to_f32 i + 0.5) * inv_rays
    let ring = sqrt (max 0.0 (1.0 - y * y))
    let raw_phase = U32.to_f32 i * 2.3999632297
    let phase = if abs raw_phase > 8192.0 then (if abs raw_phase > 1.0e7 then 0.0 else wrap tau raw_phase) else raw_phase
    let (s, c) = sin_cos phase
    let dx = ring * c
    let dz = ring * s
    let at = i * 11
    table[at] := dx
    table[at + 1] := y
    table[at + 2] := dz
    table[at + 3] := k1 * y
    table[at + 4] := k1 * dz
    table[at + 5] := k1 * dx
    table[at + 6] := k2 * dx * y
    table[at + 7] := k2 * y * dz
    table[at + 8] := k6 * (3.0 * dz * dz - 1.0)
    table[at + 9] := k2 * dx * dz
    table[at + 10] := k8 * (dx * dx - y * y)
  return table

private func bake_probe_prepared (sc: scene.Scene) -> (light: Light) -> (to_sun: Vec3) -> (to_sun_dir: Vec3) -> (grid: Grid) -> (total_probes: U32) -> (rays: U32) -> (w0: F32) -> (table: #[F32]) -> (albedo: U32 -> math.Color) -> (previous: #[F32]) -> (index: U32) -> (values: own #[F32]) : #[F32] =>
  if index >= total_probes or index > 4294967295 / stride or values.length < stride or index * stride > values.length - stride:
    return values
  let origin = lattice_position grid index
  let base = index * stride
  if scene.point_solid sc origin light.mask:
    for k in 0 .. stride:
      values[base + k] := 0.0
    return values
  let inside = 0
  let r1 = (0.0, 0.0, 0.0, 0.0)
  let g1 = (0.0, 0.0, 0.0, 0.0)
  let b1 = (0.0, 0.0, 0.0, 0.0)
  let r5 = (0.0, 0.0, 0.0, 0.0)
  let g5 = (0.0, 0.0, 0.0, 0.0)
  let b5 = (0.0, 0.0, 0.0, 0.0)
  let r0 = 0.0
  let g0 = 0.0
  let b0 = 0.0
  let tint_r = light.tint.r
  let tint_g = light.tint.g
  let tint_b = light.tint.b
  for i in 0 .. rays:
    let at = i * 11
    let dx = table[at]
    let y = table[at + 1]
    let dz = table[at + 2]
    let direction = $Vec3 { x: dx, y, z: dz }
    let rr = 0.0
    let rg = 0.0
    let rb = 0.0
    if let $Some hit = scene.ray sc origin direction light.reach light.mask 0:
      if hit.distance < 0.001:
        inside := self + 1
      else:
        let radiance = reflected_with_sun sc light to_sun to_sun_dir grid previous (albedo hit.id) hit.point hit.normal
        rr := radiance.r
        rg := radiance.g
        rb := radiance.b
    else:
      let heaven = environment.sky light.sky direction
      rr := heaven.r * tint_r
      rg := heaven.g * tint_g
      rb := heaven.b * tint_b
    let first = @simd.load table (at + 3)
    let last = @simd.load table (at + 7)
    let red = (rr, rr, rr, rr)
    let green = (rg, rg, rg, rg)
    let blue = (rb, rb, rb, rb)
    r1 := @simd.f32x4.add self (@simd.f32x4.mul red first)
    g1 := @simd.f32x4.add self (@simd.f32x4.mul green first)
    b1 := @simd.f32x4.add self (@simd.f32x4.mul blue first)
    r5 := @simd.f32x4.add self (@simd.f32x4.mul red last)
    g5 := @simd.f32x4.add self (@simd.f32x4.mul green last)
    b5 := @simd.f32x4.add self (@simd.f32x4.mul blue last)
    r0 := self + rr * w0
    g0 := self + rg * w0
    b0 := self + rb * w0
  if inside * 4 > rays:
    for k in 0 .. stride:
      values[base + k] := 0.0
    return values
  let inv_pi = 1.0 / 3.1415926536
  let scale = (inv_pi, inv_pi, inv_pi, inv_pi)
  let (r_1, r_2, r_3, r_4) = @simd.f32x4.mul r1 scale
  let (g_1, g_2, g_3, g_4) = @simd.f32x4.mul g1 scale
  let (b_1, b_2, b_3, b_4) = @simd.f32x4.mul b1 scale
  let (r_5, r_6, r_7, r_8) = @simd.f32x4.mul r5 scale
  let (g_5, g_6, g_7, g_8) = @simd.f32x4.mul g5 scale
  let (b_5, b_6, b_7, b_8) = @simd.f32x4.mul b5 scale
  @simd.store values (base + 0) (r0 * inv_pi, g0 * inv_pi, b0 * inv_pi, r_1)
  @simd.store values (base + 4) (g_1, b_1, r_2, g_2)
  @simd.store values (base + 8) (b_2, r_3, g_3, b_3)
  @simd.store values (base + 12) (r_4, g_4, b_4, r_5)
  @simd.store values (base + 16) (g_5, b_5, r_6, g_6)
  @simd.store values (base + 20) (b_6, r_7, g_7, b_7)
  values[base + 24] := r_8
  values[base + 25] := g_8
  values[base + 26] := b_8
  values[base + 27] := 1.0
  return values

// Bakes probe `index` into `values` (stride floats from index * stride):
// `light.rays` rays from the lattice point, the radiance each brings
// integrated onto nine SH terms. A probe whose rays mostly start inside a
// solid (or whose point is inside one) is invalid: zeros and validity 0.
// `albedo` says what colour entity `id` reflects. `previous` is an earlier
// bake of the same grid whose light lands in the hits (empty: the sky's
// ambient only), which is how bounces accumulate; it must not be `values`.
func bake_probe (sc: scene.Scene) -> (light: Light) -> (grid: Grid) -> (albedo: U32 -> math.Color) -> (previous: #[F32]) -> (index: U32) -> (values: own #[F32]) : #[F32] =>
  let $Some total_probes = grid_count grid else:
    return values
  if light.rays > 4096:
    return values
  let rays = max 1 light.rays
  let weight = 12.5663706144 / U32.to_f32 rays
  let w0 = 0.2820947918 * weight * 3.1415926536
  let table = build_ray_table rays weight
  let to_sun = $Vec3 { x: F32.neg light.direction.x, y: F32.neg light.direction.y, z: F32.neg light.direction.z }
  return bake_probe_prepared sc light to_sun to_sun.normalized grid total_probes rays w0 table albedo previous index values

// Bakes probes `first` up to `first + budget` (clamped to the grid): a game
// spends a fixed budget a frame and relights the day over many. `resume`
// says where the next call starts, wrapping to 0 after the last probe.
func bake_range (sc: scene.Scene) -> (light: Light) -> (grid: Grid) -> (albedo: U32 -> math.Color) -> (previous: #[F32]) -> (first: U32) -> (budget: U32) -> (values: own #[F32]) : #[F32] =>
  let $Some total = grid_count grid else:
    return values
  let end = if first >= total then total else first + min budget (total - first)
  if first >= end or light.rays > 4096:
    return values
  let rays = max 1 light.rays
  let weight = 12.5663706144 / U32.to_f32 rays
  let w0 = 0.2820947918 * weight * 3.1415926536
  let table = build_ray_table rays weight
  let to_sun = $Vec3 { x: F32.neg light.direction.x, y: F32.neg light.direction.y, z: F32.neg light.direction.z }
  let to_sun_dir = to_sun.normalized
  for index in first .. end:
    values := bake_probe_prepared sc light to_sun to_sun_dir grid total rays w0 table albedo previous index self
  return values
func resume (grid: Grid) -> (first: U32) -> (budget: U32) : U32 =>
  let total = count grid
  if total == 0 or first >= total:
    return 0
  let end = first + min budget (total - first)
  if end >= total:
    return 0
  return end

// The probes whose points lie within `margin` of the box `low` to `high`,
// ascending: what to rebake after solids inside the box changed (a margin of
// `light.reach` is every probe that could see them).
func region (grid: Grid) -> (low: Vec3) -> (high: Vec3) -> (margin: F32) : #[U32] =>
  let found: #[U32] = #[]
  let $Some _ = grid_count grid else:
    return found
  if not (math.finite3 grid.origin and is_finite grid.spacing and grid.spacing > 0.0 and math.finite3 low and math.finite3 high and is_finite margin):
    return found
  let min_x = low.x - margin
  let max_x = high.x + margin
  let min_y = low.y - margin
  let max_y = high.y + margin
  let min_z = low.z - margin
  let max_z = high.z + margin
  if min_x > max_x or min_y > max_y or min_z > max_z:
    return found
  let sp = grid.spacing
  let f_x0 = ceil ((min_x - grid.origin.x) / sp)
  let f_x1 = floor ((max_x - grid.origin.x) / sp)
  let f_y0 = ceil ((min_y - grid.origin.y) / sp)
  let f_y1 = floor ((max_y - grid.origin.y) / sp)
  let f_z0 = ceil ((min_z - grid.origin.z) / sp)
  let f_z1 = floor ((max_z - grid.origin.z) / sp)
  let fx_max = U32.to_f32 (grid.nx - 1)
  let fy_max = U32.to_f32 (grid.ny - 1)
  let fz_max = U32.to_f32 (grid.nz - 1)
  if f_x1 < 0.0 or f_x0 > fx_max or f_y1 < 0.0 or f_y0 > fy_max or f_z1 < 0.0 or f_z0 > fz_max:
    return found
  let ix0 = if f_x0 <= 0.0 then 0 else min (grid.nx - 1) (F32.to_u32 f_x0)
  let ix1 = if f_x1 >= fx_max then grid.nx - 1 else F32.to_u32 f_x1
  let iy0 = if f_y0 <= 0.0 then 0 else min (grid.ny - 1) (F32.to_u32 f_y0)
  let iy1 = if f_y1 >= fy_max then grid.ny - 1 else F32.to_u32 f_y1
  let iz0 = if f_z0 <= 0.0 then 0 else min (grid.nz - 1) (F32.to_u32 f_z0)
  let iz1 = if f_z1 >= fz_max then grid.nz - 1 else F32.to_u32 f_z1
  // Include boundary-adjacent indices in case of F32 rounding of `origin + i * spacing`.
  let sx0 = if ix0 > 0 then ix0 - 1 else 0
  let sx1 = min (grid.nx - 1) (ix1 + 1)
  let sy0 = if iy0 > 0 then iy0 - 1 else 0
  let sy1 = min (grid.ny - 1) (iy1 + 1)
  let sz0 = if iz0 > 0 then iz0 - 1 else 0
  let sz1 = min (grid.nz - 1) (iz1 + 1)
  for z in sz0 .. (sz1 + 1):
    let pz = grid.origin.z + U32.to_f32 z * sp
    if pz >= min_z and pz <= max_z:
      let z_base = z * grid.ny
      for y in sy0 .. (sy1 + 1):
        let py = grid.origin.y + U32.to_f32 y * sp
        if py >= min_y and py <= max_y:
          let y_base = (z_base + y) * grid.nx
          for x in sx0 .. (sx1 + 1):
            let px = grid.origin.x + U32.to_f32 x * sp
            if px >= min_x and px <= max_x:
              @storage.push found (y_base + x)
  return found

// Bakes the listed probes from position `first`, `budget` of them; the next
// position in the list is `min listed.length (first + budget)`.
func bake_listed (sc: scene.Scene) -> (light: Light) -> (grid: Grid) -> (albedo: U32 -> math.Color) -> (previous: #[F32]) -> (listed: #[U32]) -> (first: U32) -> (budget: U32) -> (values: own #[F32]) : #[F32] =>
  let $Some total = grid_count grid else:
    return values
  let end = if first >= listed.length then listed.length else first + min budget (listed.length - first)
  if first >= end or light.rays > 4096:
    return values
  let rays = max 1 light.rays
  let weight = 12.5663706144 / U32.to_f32 rays
  let w0 = 0.2820947918 * weight * 3.1415926536
  let table = build_ray_table rays weight
  let to_sun = $Vec3 { x: F32.neg light.direction.x, y: F32.neg light.direction.y, z: F32.neg light.direction.z }
  let to_sun_dir = to_sun.normalized
  for position in first .. end:
    values := bake_probe_prepared sc light to_sun to_sun_dir grid total rays w0 table albedo previous listed[position] self
  return values

// A fresh owner for every probe of `grid`, all invalid until baked.
func empty_values (grid: Grid) : #[F32] =>
  let $Some total = grid_count grid else:
    return #[]
  if total > 4294967295 / stride:
    return #[]
  return @array.fill (total * stride) 0.0
