import { Vec3 } from "std/vector"
import * as array from "std/array"
import * as render from "../render"

// Local reflection probes (`render.ReflectionProbe`), as the host reads them:
// the CPU reference for which probes a surface blends and with what weights,
// for box-projected lookups, and for which probes the host keeps a cube for.
// Pen's `local_reflection`, `reflection_weight` and `box_projected` are held
// to these (and to an independent f64 reference). Nothing here keeps state.

// How many probes with a weight a surface blends.
const max_blended: U32 = 4

// How much of the probe's box a point is in: 0 outside it; inside, the
// smoothstep of its distance in from the nearest face over the probe's
// `blend` (1 at once for a blend of 0), so a reflection fades in smoothly as
// a surface crosses a face and is whole `blend` metres in.
func influence (probe: render.ReflectionProbe) -> (point: Vec3) : F32 =>
  if not (is_finite point.x and is_finite point.y and is_finite point.z and is_finite probe.centre.x and is_finite probe.centre.y and is_finite probe.centre.z and is_finite probe.extent.x and is_finite probe.extent.y and is_finite probe.extent.z and is_finite probe.blend):
    return 0.0
  let inside_x = probe.extent.x - abs (point.x - probe.centre.x)
  let inside_y = probe.extent.y - abs (point.y - probe.centre.y)
  let inside_z = probe.extent.z - abs (point.z - probe.centre.z)
  let edge = min inside_x (min inside_y inside_z)
  if not (is_finite edge) or edge <= 0.0:
    return 0.0
  if probe.blend <= 0.0:
    return 1.0
  let t = clamp 0.0 1.0 (edge / probe.blend)
  return t * t * (3.0 - 2.0 * t)

// How far `eye` is from the probe's box (0 inside it).
func box_distance (probe: render.ReflectionProbe) -> (eye: Vec3) : F32 =>
  if not (is_finite eye.x and is_finite eye.y and is_finite eye.z and is_finite probe.centre.x and is_finite probe.centre.y and is_finite probe.centre.z and is_finite probe.extent.x and is_finite probe.extent.y and is_finite probe.extent.z):
    return 3.402823e38
  let x = max 0.0 (abs (eye.x - probe.centre.x) - probe.extent.x)
  let y = max 0.0 (abs (eye.y - probe.centre.y) - probe.extent.y)
  let z = max 0.0 (abs (eye.z - probe.centre.z) - probe.extent.z)
  let raw = sqrt (x * x + y * y + z * z)
  if is_finite raw:
    return raw
  let hx = max 0.0 (abs (eye.x * 0.5 - probe.centre.x * 0.5) - max 0.0 probe.extent.x * 0.5)
  let hy = max 0.0 (abs (eye.y * 0.5 - probe.centre.y * 0.5) - max 0.0 probe.extent.y * 0.5)
  let hz = max 0.0 (abs (eye.z * 0.5 - probe.centre.z * 0.5) - max 0.0 probe.extent.z * 0.5)
  let m = max hx (max hy hz)
  if not (is_finite m):
    return 3.402823e38
  if m == 0.0:
    return 0.0
  let sx = hx / m
  let sy = hy / m
  let sz = hz / m
  let d = (2.0 * m) * sqrt (sx * sx + sy * sy + sz * sz)
  return if is_finite d then d else 3.402823e38

// Each probe's share of the reflection at `point`, in the probes' own order:
// the probes with a weight take the surface highest `priority` first, the
// first `max_blended` of them in that order (then lower `id`) and no more.
// Probes of one priority blend by their weights into one light that covers
// `1 - the product of (1 - weight)` of what the higher priorities left, so
// the share of probe i of a priority is `left * covered * w_i / sum w`. The
// shares add up to `coverage`, and the sky has the rest (1 - coverage).
private func probe_before (pa: U32) -> (ia: U32) -> (idx_a: U32) -> (pb: U32) -> (ib: U32) -> (idx_b: U32) : Bool =>
  return pa > pb or (pa == pb and (ia < ib or (ia == ib and idx_a < idx_b)))

func shares (probes: &[render.ReflectionProbe]) -> (point: Vec3) : #[F32] =>
  let n = probes.length
  let out = @array.fill n 0.0
  let top_idx = @array.fill 4 0
  let top_pri = @array.fill 4 0
  let top_id = @array.fill 4 0
  let top_w = @array.fill 4 0.0
  let top_count: U32 = 0
  for i in 0 .. n:
    let p = probes[i]
    let w = influence p point
    if w > 0.0:
      let pri = p.priority
      let id = p.id
      let pos = top_count
      for k in 0 .. top_count:
        if probe_before pri id i top_pri[k] top_id[k] top_idx[k]:
          pos := k
          break
      if pos < max_blended:
        let limit = min top_count (max_blended - 1)
        let j = limit
        for 0 .. 4:
          if j <= pos:
            break
          top_idx[j] := top_idx[j - 1]
          top_pri[j] := top_pri[j - 1]
          top_id[j] := top_id[j - 1]
          top_w[j] := top_w[j - 1]
          j := self - 1
        top_idx[pos] := i
        top_pri[pos] := pri
        top_id[pos] := id
        top_w[pos] := w
        if top_count < max_blended:
          top_count := self + 1
  for a in 0 .. top_count:
    let pa = top_pri[a]
    let missed = 1.0
    let total = 0.0
    let left = 1.0
    for k in 0 .. top_count:
      let pk = top_pri[k]
      let wk = top_w[k]
      if pk == pa:
        missed := self * (1.0 - wk)
        total := self + wk
      else:
        if pk > pa:
          left := self * (1.0 - wk)
    if total > 0.0:
      out[top_idx[a]] := left * (1.0 - missed) * top_w[a] / total
  return out

// How much of the reflection the probes cover at `point`; the sky shows through the rest.
func coverage (probes: &[render.ReflectionProbe]) -> (point: Vec3) : F32 =>
  let all = shares probes point
  let sum = 0.0
  for i in 0 .. all.length:
    sum := self + all[i]
  return sum

// The direction to look the probe's cube up in for a reflected ray from
// `point` along `direction`: from the probe's position to where the ray
// leaves the box of its parallax centre and half size (the walls of its room),
// not unit length. A box with a half size of 0 or less on any axis does not
// project: the direction itself.
func box_projected (probe: render.ReflectionProbe) -> (point: Vec3) -> (direction: Vec3) : Vec3 =>
  let half = probe.parallax_extent
  if half.x <= 0.0 or half.y <= 0.0 or half.z <= 0.0:
    return direction
  let centre = probe.parallax_centre
  let dx = if abs direction.x < 0.00000001 then 0.00000001 else direction.x
  let dy = if abs direction.y < 0.00000001 then 0.00000001 else direction.y
  let dz = if abs direction.z < 0.00000001 then 0.00000001 else direction.z
  let tx = ((if dx > 0.0 then centre.x + half.x else centre.x - half.x) - point.x) / dx
  let ty = ((if dy > 0.0 then centre.y + half.y else centre.y - half.y) - point.y) / dy
  let tz = ((if dz > 0.0 then centre.z + half.z else centre.z - half.z) - point.z) / dz
  let along = max 0.0 (min tx (min ty tz))
  return $Vec3 {
    x: point.x + direction.x * along - probe.position.x,
    y: point.y + direction.y * along - probe.position.y,
    z: point.z + direction.z * along - probe.position.z,
  }

// The probes the host would give cubes to, best first, at most `slots` (the
// host has 8), seen from `eye`: highest priority, then the nearest box, then
// the lowest id (give each probe a distinct id). The host also counts a probe
// that already holds a slot as 20% nearer, so as to keep it; that history is not here.
func choose (probes: &[render.ReflectionProbe]) -> (eye: Vec3) -> (slots: U32) : #[U32] =>
  let n = probes.length
  let kept = min slots n
  if kept == 0:
    return #[]
  let dists = @array.fill n 0.0
  for i in 0 .. n:
    dists[i] := box_distance probes[i] eye
  let chosen = @array.fill kept 0
  let used = @array.fill n false
  for k in 0 .. kept:
    let best: U32 = 0
    let has_best = false
    let best_pri: U32 = 0
    let best_d = 0.0
    let best_id: U32 = 0
    for i in 0 .. n:
      if not used[i]:
        let p = probes[i]
        let pri = p.priority
        let d = dists[i]
        let id = p.id
        let better = not has_best or pri > best_pri or (pri == best_pri and (d < best_d or (d == best_d and (id < best_id or (id == best_id and i < best)))))
        if better:
          has_best := true
          best := i
          best_pri := pri
          best_d := d
          best_id := id
    used[best] := true
    chosen[k] := best
  return chosen
