// Perspective extent in output pixels, using the nearest depth of a bound.
// Positive near/focal, nonnegative extents/padding/output size, finite inputs
// and a representable result are required. Culling is a separate operation.
const projected = fn (pixel_height: F32) (focal_y: F32) (near: F32) (depth: F32) (extent: F32) (padding: F32) =>
  pixel_height * focal_y * extent / (2.0 * max near (depth - padding))

// Ascending pixel thresholds describe levels from coarse to fine. Equality
// belongs to the coarser level. Meshes, quality policy and previous level are
// caller-owned. Construct once and reuse across objects and frames.
type Levels is data = #Levels { thresholds: Array F32 }
const levels = fn (thresholds: Array F32) => do:
  let valid = #True
  for i in 0 .. thresholds.length:
    valid := self && is_finite thresholds[i] && thresholds[i] >= 0.0
    if i > 0:
      valid := self && thresholds[i] > thresholds[i - 1]
  return if valid then #Some #Levels { thresholds } else #Nothing
const select = fn (levels: Levels) (pixels: F32) => do:
  let chosen = 0
  for threshold in levels.thresholds:
    if pixels <= threshold:
      break
    chosen := self + 1
  return chosen
// Absolute hysteresis in pixels. Invalid previous levels select afresh.
// Cross all necessary levels on large changes; zero band equals select.
const stable = fn (levels: Levels) (pixels: F32) (band: F32) (previous: U32) => do:
  if Bool.not (is_finite pixels && is_finite band) || pixels < 0.0 || band < 0.0:
    return @panic "LOD requires nonnegative finite pixels and hysteresis"
  if previous > levels.thresholds.length:
    return select levels pixels
  let chosen = previous
  for previous .. levels.thresholds.length:
    if pixels <= levels.thresholds[chosen] + band:
      break
    chosen := self + 1
  for 0 .. chosen:
    if chosen == 0 || pixels > levels.thresholds[chosen - 1] - band:
      break
    chosen := self - 1
  return chosen
