//! Projected pixel extent, hysteresis LOD level selection, and dither crossfade weights.
//!
//! Key items: [`Levels`], [`projected`], [`levels`], [`select`], [`stable`].
//!
//! ```blot
//! let $Some lv = levels #[16.0, 48.0, 120.0] else:
//!   return #[]
//! #[select lv 8.0, select lv 64.0, select lv 180.0] // => #[0, 2, 3]
//! ```

// Perspective extent in output pixels, using the nearest depth of a bound.
// Positive near/focal, nonnegative extents/padding/output size, finite inputs
// and a representable result are required. Culling is a separate operation.
func projected (pixel_height: F32) -> (focal_y: F32) -> (near: F32) -> (depth: F32) -> (extent: F32) -> (padding: F32) => return
  pixel_height * focal_y * extent / (2.0 * max near (depth - padding))

// Ascending pixel thresholds describe levels from coarse to fine. Equality
// belongs to the coarser level. Meshes, quality policy and previous level are
// caller-owned. Construct once and reuse across objects and frames.
type Levels is data = $Levels { thresholds: #[F32] }
func levels (thresholds: #[F32]) =>
  let valid = true
  for i in 0 .. thresholds.length:
    valid := self and is_finite thresholds[i] and thresholds[i] >= 0.0
    if i > 0:
      valid := self and thresholds[i] > thresholds[i - 1]
  return if valid then $Some $Levels { thresholds: thresholds.copy } else $Nothing
func select (levels: Levels) -> (pixels: F32) =>
  let chosen = 0
  for threshold in levels.thresholds:
    if pixels <= threshold:
      break
    chosen := self + 1
  return chosen
// Absolute hysteresis in pixels. Invalid previous levels select afresh.
// Cross all necessary levels on large changes; zero band equals select.
func stable (levels: Levels) -> (pixels: F32) -> (band: F32) -> (previous: U32) =>
  if not (is_finite pixels and is_finite band) or pixels < 0.0 or band < 0.0:
    return panic "LOD requires nonnegative finite pixels and hysteresis"
  if previous > levels.thresholds.length:
    return select levels pixels
  let chosen = previous
  for previous .. levels.thresholds.length:
    if pixels <= levels.thresholds[chosen] + band:
      break
    chosen := self + 1
  for 0 .. chosen:
    if chosen == 0 or pixels > levels.thresholds[chosen - 1] - band:
      break
    chosen := self - 1
  return chosen
