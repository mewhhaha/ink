import { Vec3 } from "std/vector"
import * as vector from "std/vector"
import * as math from "../math"

// Spatial world-cell streaming planner with byte-budget LRU eviction and
// smooth LOD dither crossfade weight computation.

type Cell is data = $Cell {
  id: U32,
  center: Vec3,
  radius: F32,
  bytes: U32,
  resident: Bool,
  last_used_frame: U32,
}

type Plan is data = $Plan {
  load: #[U32],
  evict: #[U32],
  resident_bytes: U32,
}

private func sort_by_f32 (indices: own #[U32]) -> (keys: #[F32]) : #[U32] =>
  let n = indices.length
  if n <= 1:
    return indices
  let work = @array.fill n 0
  let width: U32 = 1
  for _ in 0 .. 31:
    if width >= n:
      break
    let steps = (n + width * 2 - 1) / (width * 2)
    for b in 0 .. steps:
      let left = b * width * 2
      let mid = min (left + width) n
      let right = min (left + width * 2) n
      let i = left
      let j = mid
      for k in left .. right:
        let take_left = i < mid and (j >= right or keys[indices[i]] <= keys[indices[j]])
        if take_left:
          work[k] := indices[i]
          i := self + 1
        else:
          work[k] := indices[j]
          j := self + 1
      for k in left .. right:
        indices[k] := work[k]
    width := self * 2
  return indices

private func sort_by_u32 (indices: own #[U32]) -> (cells: #[Cell]) : #[U32] =>
  let n = indices.length
  if n <= 1:
    return indices
  let work = @array.fill n 0
  let width: U32 = 1
  for _ in 0 .. 31:
    if width >= n:
      break
    let steps = (n + width * 2 - 1) / (width * 2)
    for b in 0 .. steps:
      let left = b * width * 2
      let mid = min (left + width) n
      let right = min (left + width * 2) n
      let i = left
      let j = mid
      for k in left .. right:
        let take_left = i < mid and (j >= right or cells[indices[i]].last_used_frame <= cells[indices[j]].last_used_frame)
        if take_left:
          work[k] := indices[i]
          i := self + 1
        else:
          work[k] := indices[j]
          j := self + 1
      for k in left .. right:
        indices[k] := work[k]
    width := self * 2
  return indices

// Plan which cells to load (within `load_radius` of `focus`) and which distant
// resident cells (outside `keep_radius`) to evict to stay within `budget_bytes`.
// Loads nearest missing cells first; evicts least-recently-used distant cells.
func plan_cells (focus: Vec3) -> (load_radius: F32) -> (keep_radius: F32) -> (budget_bytes: U32) -> (cells: #[Cell]) : Maybe Plan =>
  if not (math.finite3 focus and is_finite load_radius and is_finite keep_radius) or load_radius < 0.0 or keep_radius < load_radius:
    return $Nothing
  let n = cells.length
  let dists = @array.generate n (func (i: U32) => max 0.0 (vector.Vec3.length (cells[i].center - focus) - max 0.0 cells[i].radius))
  let used_bytes = 0
  let far_evict: #[U32] = #[]
  let mid_evict: #[U32] = #[]
  let load_cands: #[U32] = #[]
  for i in 0 .. n:
    let c = cells[i]
    if c.resident:
      used_bytes := if c.bytes > 4294967295 - self then 4294967295 else self + c.bytes
      if dists[i] > keep_radius:
        @storage.push far_evict i
      else:
        if dists[i] > load_radius:
          @storage.push mid_evict i
    else:
      if dists[i] <= load_radius:
        @storage.push load_cands i
  let far_sorted = sort_by_u32 far_evict cells
  let mid_sorted = sort_by_u32 mid_evict cells
  let load_sorted = sort_by_f32 load_cands dists
  // Evict resident cells outside keep_radius first (LRU order).
  let evict_list: #[U32] = #[]
  for victim in far_sorted:
    used_bytes := if used_bytes >= cells[victim].bytes then self - cells[victim].bytes else 0
    @storage.push evict_list cells[victim].id
  // Load missing cells within load_radius nearest first while budget allows.
  let load_list: #[U32] = #[]
  let mid_cursor: U32 = 0
  for best in load_sorted:
    let need = cells[best].bytes
    let can_fit = used_bytes <= budget_bytes and need <= budget_bytes - used_bytes
    if not can_fit:
      let avail = mid_sorted.length - mid_cursor
      for _ in 0 .. avail:
        if used_bytes <= budget_bytes and need <= budget_bytes - used_bytes:
          break
        let victim = mid_sorted[mid_cursor]
        mid_cursor := self + 1
        used_bytes := if used_bytes >= cells[victim].bytes then self - cells[victim].bytes else 0
        @storage.push evict_list cells[victim].id
    if used_bytes <= budget_bytes and need <= budget_bytes - used_bytes:
      used_bytes := self + need
      @storage.push load_list cells[best].id
  return $Some ($Plan { load: load_list, evict: evict_list, resident_bytes: used_bytes })

// LOD dither crossfade descriptor: primary LOD index, secondary LOD index, and
// blend factor `fade` in [0, 1] (0 = 100% primary, 1 = 100% secondary).
type Crossfade is data = $Crossfade {
  primary: U32,
  secondary: U32,
  fade: F32,
}

// Compute LOD index and smooth crossfade across `band` width around ascending
// switch `distances` (e.g. #[20.0, 50.0, 100.0] for 4 LODs 0..3).
func lod_crossfade (distances: #[F32]) -> (band: F32) -> (distance: F32) : Crossfade =>
  let n = distances.length
  if n == 0 or not (is_finite distance and is_finite band):
    return $Crossfade { primary: 0, secondary: 0, fade: 0.0 }
  let half = max 0.0 band * 0.5
  let lod = n
  for i in 0 .. n:
    if lod == n and distance < distances[i]:
      lod := i
  if lod < n and half > 0.000001 and distance > distances[lod] - half:
    let f = clamp 0.0 1.0 ((distance - (distances[lod] - half)) / (2.0 * half))
    return $Crossfade { primary: lod, secondary: lod + 1, fade: f }
  if lod > 0 and half > 0.000001 and distance < distances[lod - 1] + half:
    let f = clamp 0.0 1.0 ((distance - (distances[lod - 1] - half)) / (2.0 * half))
    return $Crossfade { primary: lod - 1, secondary: lod, fade: f }
  return $Crossfade { primary: lod, secondary: lod, fade: 0.0 }
