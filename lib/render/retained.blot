import * as array from "std/array"
import * as changes from "../changes"
import * as render from "../render"

// Sorted flat groups and a separately named ID pool replace owning ID arrays.
// Ordinary dirty edits binary-search groups and touch only their instance rows.
type Entry is data = $Entry {key: U32, start: U32, count: U32, capacity: U32, active: Bool}
type Store = ResizeArray Entry
type State = Array U32
const empty = func () : Store => return #[]
const state = func () : State => return #[0, 0]
// Publication rejection did not undo simulation. Replay current groups in a
// fresh host stream next frame, rather than retaining an old world snapshot.
const rejected = func (state: State) => return do:
  state[0] := 0
const reset = rejected
const position = func (groups: Store) -> (key: U32) => return do:
  let low = 0
  let high = groups.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if groups[middle].key < key:
      low := middle + 1
    else:
      high := middle
  return low
const insert = func (groups: Store) -> (at: U32) -> (entry: Entry) => return do:
  @storage.push groups entry
  for back in 0 .. groups.length - at - 1:
    let index = groups.length - 1 - back
    groups[index] := groups[index - 1]
  groups[at] := entry
// order/draws are compile-known policies. Every current key must be available
// to draws after a rejection, since a reset republishes the whole live scene.
const update_keyed = func order -> draws -> change -> (state: State) -> (groups: Store) -> (ids: ResizeArray U32) -> (frame: render.FrameAccess) => return do:
  if state.length != 2:
    return @panic "retained state requires started and next"
  let written: ResizeArray U32 = #[]
  let deleted: ResizeArray U32 = #[]
  let change = changes.make_into change.reset change.updated change.removed written deleted
  let reset = change.reset or state[0] == 0
  let updated = if reset and Bool.not change.reset then changes.apply change #[group.key | group <- groups, group.active] else array.map identity change.updated
  if reset:
    for index in 0 .. groups.length:
      groups[index].active := false
    state[1] := 0
  for key in updated:
    let values = draws key
    let at = position groups key
    let exists = at < groups.length and groups[at].key == key
    let old = if exists then groups[at] else $Entry {key, start: 0, count: 0, capacity: 0, active: false}
    if old.count > old.capacity or old.start > ids.length or old.capacity > ids.length - old.start:
      return @panic "retained ID span is outside its pool"
    let kept = if old.active then min old.count values.length else 0
    let added = values.length - kept
    if added > 0xFFFFFFFF - state[1]:
      return @panic "retained instance identities exhausted"
    let start = old.start
    let capacity = old.capacity
    if values.length > capacity:
      start := ids.length
      capacity := values.length
      for slot in 0 .. values.length:
        @storage.push ids (if slot < kept then ids[old.start + slot] else 0)
    for slot in 0 .. values.length:
      let id = if slot < kept then ids[start + slot] else state[1]
      if slot >= kept:
        state[1] := self + 1
        ids[start + slot] := id
      @storage.push frame.updates $render.Instance {id, order: order key slot, draw: values[slot]}
    if old.active:
      for slot in values.length .. old.count:
        @storage.push frame.removed ids[old.start + slot]
    let next = $Entry {key, start, count: values.length, capacity, active: true}
    if exists:
      groups[at] := next
    else:
      insert groups at next
  for key in change.removed:
    let at = position groups key
    if at < groups.length and groups[at].key == key and groups[at].active:
      let group = groups[at]
      for slot in 0 .. group.count:
        @storage.push frame.removed ids[group.start + slot]
      groups[at].active := false
  state[0] := 1
  frame.settings[0].retained_enabled := true
  frame.settings[0].retained_reset := reset
// Non-keyed groups are borrowed views. Growth/truncation is structural even
// when the caller reports no payload dirtiness; unchanged groups stay quiet.
const update = func order -> values -> dirty -> state -> groups -> ids -> frame => return do:
  let selected: ResizeArray U32 = #[]
  for key in 0 .. values.length:
    let at = position groups key
    if state[0] == 0 or at == groups.length or groups[at].key != key or Bool.not groups[at].active or groups[at].count != values[key].length or changes.contains dirty key:
      @storage.push selected key
  let updated = @storage.freeze selected
  let missing = #[group.key | group <- groups, group.active and group.key >= values.length]
  update_keyed order (func key => return values[key]) (changes.borrow false updated missing) state groups ids frame

// Application-requested identity checkpoint copies every scalar row and ID.
// This never implies rolling simulation back after a rejected publication.
const copy_into = func (destination_state: State) -> (destination_groups: Store) -> (destination_ids: ResizeArray U32) -> (source_state: State) -> (source_groups: Store) -> (source_ids: ResizeArray U32) => return do:
  let started = source_state[0]
  let next = source_state[1]
  let groups = @storage.copy source_groups
  let ids = @storage.copy source_ids
  @storage.truncate destination_groups 0
  @storage.truncate destination_ids 0
  for group in groups:
    @storage.push destination_groups group
  for id in ids:
    @storage.push destination_ids id
  destination_state[0] := started
  destination_state[1] := next
