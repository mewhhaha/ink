//! Sorted flat groups and a separately named ID pool replace owning ID arrays.
//! Ordinary dirty edits binary-search groups and touch only their instance rows.
//!
//! Key items: [`Entry`], [`Store`], [`State`], [`empty`], [`state`].

import * as array from "std/array"
import * as changes from "../changes"
import * as render from "../render"

type Entry is data = $Entry {key: U32, start: U32, count: U32, capacity: U32, active: Bool}
type Store = #[Entry]
type State = #[U32]
func empty () : Store => #[]
func state () : State => #[0, 0]
// Publication rejection did not undo simulation. Replay current groups in a
// fresh host stream next frame, rather than retaining an old world snapshot.
func rejected (state: own State) : State =>
  state[0] := 0
  return state
const reset = rejected
func position (groups: Store) -> (key: U32) =>
  let low = 0
  let high = groups.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if groups[middle].key < key:
      low := middle + 1
    else:
      high := middle
  return low
func insert (groups: own Store) -> (at: U32) -> (entry: Entry) : Store =>
  let pos = min at groups.length
  @storage.push groups entry
  for back in 0 .. groups.length - pos - 1:
    let index = groups.length - 1 - back
    groups[index] := groups[index - 1]
  groups[pos] := entry
  return groups
private func compact_ids (groups: own Store) -> (ids: own #[U32]): (Store, #[U32]) =>
  let fresh: #[U32] = #[]
  for index in 0 .. groups.length:
    let entry = groups[index]
    if entry.active:
      let start = fresh.length
      for slot in 0 .. entry.capacity:
        @storage.push fresh (if slot < entry.count then ids[entry.start + slot] else 0)
      entry.start := start
      groups[index] := entry
    else:
      entry.start := 0
      entry.count := 0
      entry.capacity := 0
      groups[index] := entry
  @storage.truncate ids 0
  for value in fresh:
    @storage.push ids value
  return (groups, ids)

private func apply_keyed order -> draws -> (reset: Bool) -> updated -> removed -> (state: own State) -> (groups: own Store) -> (ids: own #[U32]) -> (frame: own render.FrameAccess) =>
  if reset:
    for index in 0 .. groups.length:
      groups[index].active := false
      groups[index].start := 0
      groups[index].count := 0
      groups[index].capacity := 0
    @storage.truncate ids 0
    state[1] := 0
  for key in updated:
    let values = draws key
    let value_count: U32 = values.length
    let at = position groups key
    let exists = at < groups.length and groups[at].key == key
    let old = if exists then groups[at] else $Entry {key, start: 0, count: 0, capacity: 0, active: false}
    if old.count > old.capacity or old.start > ids.length or old.capacity > ids.length - old.start:
      return panic "retained ID span is outside its pool"
    let kept = if old.active then min old.count value_count else 0
    let added = value_count - kept
    if added > 0xFFFFFFFF - state[1]:
      return panic "retained instance identities exhausted"
    let start = old.start
    let capacity = old.capacity
    if value_count > capacity:
      if ids.length >= 256:
        let live_cap: U32 = 0
        for g in 0 .. groups.length:
          if groups[g].active:
            live_cap := if groups[g].capacity > 4294967295 - self then 4294967295 else self + groups[g].capacity
        if live_cap < ids.length / 2:
          let (next_groups, next_ids) = compact_ids groups ids
          groups := next_groups
          ids := next_ids
          if exists:
            old := groups[at]
      start := ids.length
      let doubled = if capacity > 2147483647 then 4294967295 else capacity * 2
      capacity := max value_count (max 4 doubled)
      for slot in 0 .. capacity:
        @storage.push ids (if slot < kept then ids[old.start + slot] else 0)
    for slot in 0 .. value_count:
      let id = if slot < kept then ids[start + slot] else state[1]
      if slot >= kept:
        state[1] := self + 1
        ids[start + slot] := id
      @storage.push frame.updates $render.Instance {id, order: order key slot, draw: values.at slot}
    if old.active:
      for slot in value_count .. old.count:
        @storage.push frame.removed ids[old.start + slot]
    let next = $Entry {key, start, count: value_count, capacity, active: true}
    if exists:
      groups[at] := next
    else:
      groups := insert groups at next
  for key in removed:
    let at = position groups key
    if at < groups.length and groups[at].key == key and groups[at].active:
      let group = groups[at]
      if group.start > ids.length or group.count > ids.length - group.start:
        return panic "retained ID span is outside its pool"
      for slot in 0 .. group.count:
        @storage.push frame.removed ids[group.start + slot]
      groups[at].active := false
  state[0] := 1
  frame.settings[0].retained_enabled := true
  frame.settings[0].retained_reset := reset
  return (state, groups, ids, frame)

// order/draws are compile-known policies. Every current key must be available
// to draws after a rejection, since a reset republishes the whole live scene.
func update_keyed order -> draws -> change -> (state: own State) -> (groups: own Store) -> (ids: own #[U32]) -> (frame: own render.FrameAccess) =>
  if state.length != 2:
    return panic "retained state requires started and next"
  let written: #[U32] = #[]
  let deleted: #[U32] = #[]
  let change = changes.make_into change.reset change.updated change.removed written deleted
  let reset = change.reset or state[0] == 0
  let updated = if reset and not change.reset then changes.apply change #[group.key | group <- groups, group.active] else array.map identity change.updated
  return apply_keyed order draws reset updated change.removed state groups ids frame

// Non-keyed groups are borrowed views. Growth/truncation is structural even
// when the caller reports no payload dirtiness; unchanged groups stay quiet.
func update order -> (values: #[&[render.Draw]]) -> dirty -> (own state) -> (own groups) -> (own ids) -> (own frame) =>
  if state.length != 2:
    return panic "retained state requires started and next"
  let reset = state[0] == 0
  let dirty = changes.unique dirty
  let selected: #[U32] = #[]
  let g_idx: U32 = 0
  let g_len = groups.length
  let d_idx: U32 = 0
  let d_len = dirty.length
  let n_vals = values.length
  for key in 0 .. n_vals:
    for g_idx .. g_len:
      if groups[g_idx].key >= key:
        break
      g_idx := self + 1
    for d_idx .. d_len:
      if dirty[d_idx] >= key:
        break
      d_idx := self + 1
    let is_dirty = d_idx < d_len and dirty[d_idx] == key
    if reset or is_dirty or g_idx == g_len or groups[g_idx].key != key or not groups[g_idx].active or groups[g_idx].count != values[key].length:
      @storage.push selected key
  let missing: #[U32] = #[]
  for i in g_idx .. g_len:
    let g = groups[i]
    if g.active and g.key >= n_vals:
      @storage.push missing g.key
  return apply_keyed order (func key => values[key]) reset selected (&missing[0..missing.length]) state groups ids frame

// Application-requested identity checkpoint copies every scalar row and ID.
// This never implies rolling simulation back after a rejected publication.
func copy_into (destination_state: own State) -> (destination_groups: own Store) -> (destination_ids: own #[U32]) -> (source_state: State) -> (source_groups: Store) -> (source_ids: #[U32]) : (State, Store, #[U32]) =>
  if source_state.length < 2 or destination_state.length < 2:
    return panic "retained state requires started and next"
  let started = source_state[0]
  let next = source_state[1]
  let groups = copy source_groups
  let ids = copy source_ids
  @storage.truncate destination_groups 0
  @storage.truncate destination_ids 0
  for group in groups:
    @storage.push destination_groups group
  for id in ids:
    @storage.push destination_ids id
  destination_state[0] := started
  destination_state[1] := next
  return (destination_state, destination_groups, destination_ids)
