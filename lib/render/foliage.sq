//! Procedural foliage wind displacement (travelling gust waves + length-preserving
//! stem bend) and octahedral impostor atlas coordinate encoding/decoding.
//!
//! Key items: [`Wind`], [`ImpostorFrame`], [`gust_factor`], [`gust_factors_batch`], [`bend_displacement`].

import { Vec2, Vec3 } from "std/vector"
import * as math from "../math"

type Wind is data = $Wind {
  dir_x: F32,
  dir_z: F32,
  strength: F32,
  gust_freq: F32,
  gust_speed: F32,
  turbulence: F32,
}

type ImpostorFrame is data = $ImpostorFrame {
  col: U32,
  row: U32,
  u0: F32,
  v0: F32,
  u1: F32,
  v1: F32,
  oct_u: F32,
  oct_v: F32,
}

private func wrap_phase (a: F32) : F32 =>
  if not (is_finite a):
    return 0.0
  if abs a > 4096.0:
    return if abs a > 1.0e7 then 0.0 else wrap tau a
  return a

private func norm_dir2 (x: F32) -> (z: F32) -> (fx: F32) -> (fz: F32) : (F32, F32, Bool) =>
  if not (is_finite x and is_finite z):
    return (fx, fz, false)
  let len = sqrt (x * x + z * z)
  if is_finite len and len > 0.000001:
    return (x / len, z / len, true)
  let m = max (abs x) (abs z)
  if not (is_finite m) or m <= 0.000001:
    return (fx, fz, false)
  let sx = x / m
  let sz = z / m
  let sl = sqrt (sx * sx + sz * sz)
  if not (is_finite sl) or sl <= 0.0:
    return (fx, fz, false)
  return (sx / sl, sz / sl, true)

// Travelling spatial gust envelope in `[0, 1 + turbulence]` along the wind vector.
func gust_factor (wind: Wind) -> (world_x: F32) -> (world_z: F32) -> (time: F32) : F32 =>
  if not (is_finite wind.dir_x and is_finite wind.dir_z and is_finite wind.gust_freq and is_finite wind.gust_speed and is_finite wind.turbulence and is_finite world_x and is_finite world_z and is_finite time):
    return 0.0
  let (dx, dz, _) = norm_dir2 wind.dir_x wind.dir_z 1.0 0.0
  return gust_direction world_x world_z dx dz wind.gust_freq wind.gust_speed wind.turbulence time

private func gust_direction (world_x: F32) -> (world_z: F32) -> (dx: F32) -> (dz: F32) -> (freq: F32) -> (speed: F32) -> (turbulence: F32) -> (time: F32) : F32 =>
  let along = world_x * dx + world_z * dz
  let across = world_z * dx - world_x * dz
  let primary = 0.5 + 0.5 * sin (wrap_phase (along * freq - time * speed))
  let flutter = sin (wrap_phase (along * freq * 2.7 + across * 1.3 - time * speed * 2.1))
  return max 0.0 (primary + flutter * max 0.0 turbulence * 0.25)

private func gust_one (wx: F32) -> (wz: F32) -> (dx: F32) -> (dz: F32) -> (freq: F32) -> (phase_p: F32) -> (phase_f: F32) -> (turb: F32) : F32 =>
  let along = wx * dx + wz * dz
  let across = wz * dx - wx * dz
  return max 0.0 (0.5 + 0.5 * sin (wrap_phase (along * freq - phase_p)) + sin (wrap_phase (along * freq * 2.7 + across * 1.3 - phase_f)) * turb)

// Data-parallel travelling gust evaluation for foliage instances via `spark`.
func gust_factors_batch (wind: Wind) -> (xs: &[F32]) -> (zs: &[F32]) -> (time: F32) : #[F32] =>
  let n = min xs.length zs.length
  let (dx, dz, _) = norm_dir2 wind.dir_x wind.dir_z 1.0 0.0
  let freq = if is_finite wind.gust_freq then wind.gust_freq else 0.0
  let phase_p = wrap_phase (time * wind.gust_speed)
  let phase_f = wrap_phase (time * wind.gust_speed * 2.1)
  let turb = if is_finite wind.turbulence then max 0.0 wind.turbulence * 0.25 else 0.0
  return spark #[gust_one xs[i] zs[i] dx dz freq phase_p phase_f turb | i <- 0 .. n]

// Quadratic height-weighted foliage bend displacement with length-preserving
// vertical droop so swaying stems and crowns do not visibly stretch.
func bend_displacement (wind: Wind) -> (world_pos: Vec3) -> (height_ratio: F32) -> (stiffness: F32) -> (time: F32) : Vec3 =>
  if not (is_finite wind.dir_x and is_finite wind.dir_z and is_finite wind.strength and is_finite wind.gust_freq and is_finite wind.gust_speed and is_finite wind.turbulence and math.finite3 world_pos and is_finite height_ratio and is_finite stiffness and is_finite time):
    return math.zero3
  let h = clamp 0.0 1.0 height_ratio
  let stiff = max 0.05 stiffness
  let (dx, dz, ok) = norm_dir2 wind.dir_x wind.dir_z 0.0 0.0
  if not ok or wind.strength <= 0.0 or h <= 0.0:
    return math.zero3
  let gust = gust_direction world_pos.x world_pos.z dx dz wind.gust_freq wind.gust_speed wind.turbulence time
  let bend = wind.strength * gust * (h * h) / stiff
  let sway_x = dx * bend
  let sway_z = dz * bend
  let cross_phase = sin (wrap_phase (time * (wind.gust_speed * 1.7 + 1.0) + world_pos.x * 0.7 + world_pos.z * 0.9))
  let cross_amp = bend * max 0.0 wind.turbulence * 0.2
  let ox = sway_x - dz * cross_amp * cross_phase
  let oz = sway_z + dx * cross_amp * cross_phase
  // Approximate arc-length conservation: droop downward as horizontal bend grows.
  let horiz_sq = ox * ox + oz * oz
  let oy = 0.0 - horiz_sq / (2.0 * max 1.0 (1.0 + sqrt horiz_sq))
  if not (is_finite ox and is_finite oy and is_finite oz):
    return math.zero3
  return $Vec3 { x: ox, y: oy, z: oz }

private func sign_not_zero (v: F32) : F32 => return if v >= 0.0 then 1.0 else (-1.0)

// Octahedral encoding mapping a unit direction (`+Y` up) into `[0, 1]^2`.
// When `hemi` is true, encodes the upper hemisphere (`y >= 0`) with full
// atlas resolution (standard for tree/foliage octahedral impostors).
func oct_encode (dir: Vec3) -> (hemi: Bool) : Vec2 =>
  let unit = case math.normalize3 dir of
    $Some u => u
    $Nothing => math.up
  let y = if hemi then max 0.0 unit.y else unit.y
  let l1 = abs unit.x + abs y + abs unit.z
  let inv = if l1 > 0.000001 then 1.0 / l1 else 1.0
  let px = unit.x * inv
  let pz = unit.z * inv
  if hemi:
    // Rotate 45 degrees so the diamond `|px| + |pz| <= 1` fills the unit square `[0, 1]^2`.
    let u = (px + pz) * 0.5 + 0.5
    let v = (px - pz) * 0.5 + 0.5
    return $Vec2 { x: clamp 0.0 1.0 u, y: clamp 0.0 1.0 v }
  let ox = if y < 0.0 then (1.0 - abs pz) * sign_not_zero px else px
  let oz = if y < 0.0 then (1.0 - abs px) * sign_not_zero pz else pz
  return $Vec2 { x: clamp 0.0 1.0 (ox * 0.5 + 0.5), y: clamp 0.0 1.0 (oz * 0.5 + 0.5) }

// Inverse octahedral decoding mapping `[0, 1]^2` back to a unit direction (`+Y` up).
func oct_decode (uv: Vec2) -> (hemi: Bool) : Vec3 =>
  let u = clamp 0.0 1.0 uv.x
  let v = clamp 0.0 1.0 uv.y
  if hemi:
    let a = u * 2.0 - 1.0
    let b = v * 2.0 - 1.0
    let px = (a + b) * 0.5
    let pz = (a - b) * 0.5
    let py = max 0.0 (1.0 - abs px - abs pz)
    return case math.normalize3 ($Vec3 { x: px, y: py, z: pz }) of
      $Some d => d
      $Nothing => math.up
  let ox = u * 2.0 - 1.0
  let oz = v * 2.0 - 1.0
  let py = 1.0 - abs ox - abs oz
  let px = if py < 0.0 then (1.0 - abs oz) * sign_not_zero ox else ox
  let pz = if py < 0.0 then (1.0 - abs ox) * sign_not_zero oz else oz
  return case math.normalize3 ($Vec3 { x: px, y: py, z: pz }) of
    $Some d => d
    $Nothing => math.up

// Selects the discrete octahedral impostor atlas tile `(col, row)` and sub-UV
// rectangle `(u0, v0, u1, v1)` for a `grid_size x grid_size` impostor sheet.
func impostor_frame (view_dir: Vec3) -> (grid_size: U32) -> (hemi: Bool) : ImpostorFrame =>
  let n = max 1 grid_size
  let oct = oct_encode view_dir hemi
  let nf = U32.to_f32 n
  let cx = floor (oct.x * nf)
  let cy = floor (oct.y * nf)
  let col = if cx >= 4294967040.0 then n - 1 else min (n - 1) (F32.to_u32 (max 0.0 cx))
  let row = if cy >= 4294967040.0 then n - 1 else min (n - 1) (F32.to_u32 (max 0.0 cy))
  let inv = 1.0 / nf
  let u0 = U32.to_f32 col * inv
  let v0 = U32.to_f32 row * inv
  return $ImpostorFrame {
    col,
    row,
    u0,
    v0,
    u1: u0 + inv,
    v1: v0 + inv,
    oct_u: oct.x,
    oct_v: oct.y,
  }
