import * as math from "../math"
import * as render from "../render"

const jfa_outline_ext_tag: U32 = 65007

type OutlineStyle is data = $OutlineStyle {
  color: math.Vec4, occluded_color: math.Vec4, width_px: F32, feather_px: F32, fill_alpha: F32,
}

type OutlineTarget is data = $OutlineTarget { draw_index: U32, style_index: U32 }

func style_occluded (color: math.Vec4) -> (occluded_color: math.Vec4) -> (width_px: F32) -> (feather_px: F32) -> (fill_alpha: F32) : OutlineStyle =>
  return $OutlineStyle { color, occluded_color, width_px, feather_px, fill_alpha }

func style (color: math.Vec4) -> (width_px: F32) : OutlineStyle =>
  return style_occluded color (math.vec4 0.0 0.0 0.0 0.0) width_px 1.0 0.0

// Target indices refer to the frame's draw list and to the supplied style array.
func pack_extension (styles: &[OutlineStyle]) -> (targets: &[OutlineTarget]) -> (max_radius_px: F32) -> (depth_bias: F32) : #[F32] =>
  let values: #[F32] = #[U32.to_f32 styles.length, max_radius_px, depth_bias]
  for s in styles:
    for lane in #[
      s.color.x, s.color.y, s.color.z, s.color.w,
      s.occluded_color.x, s.occluded_color.y, s.occluded_color.z, s.occluded_color.w,
      s.width_px, s.feather_px, s.fill_alpha,
    ]:
      @storage.push values lane
  for t in targets:
    @storage.push values (U32.to_f32 t.draw_index)
    @storage.push values (U32.to_f32 t.style_index)
  return values

func emit_extension (styles: &[OutlineStyle]) -> (targets: &[OutlineTarget]) -> (max_radius_px: F32) -> (depth_bias: F32) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let packed = pack_extension styles targets max_radius_px depth_bias
  return render.push_extension jfa_outline_ext_tag (&packed[0..packed.length]) frame
