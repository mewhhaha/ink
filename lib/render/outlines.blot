import * as math from "../math"
import * as render from "../render"

const jfa_outline_ext_tag: U32 = 65007

type OutlineStyle is data = $OutlineStyle {
  color: math.Vec4, occluded_color: math.Vec4, width_px: F32, feather_px: F32, fill_alpha: F32,
}

type OutlineTarget is data = $OutlineTarget { draw_index: U32, style_index: U32 }

func style_occluded (color: math.Vec4) -> (occluded_color: math.Vec4) -> (width_px: F32) -> (feather_px: F32) -> (fill_alpha: F32) : OutlineStyle =>
  return $OutlineStyle { color, occluded_color, width_px, feather_px, fill_alpha }

func style (color: math.Vec4) -> (width_px: F32) : OutlineStyle =>
  return style_occluded color (math.vec4 0.0 0.0 0.0 0.0) width_px 1.0 0.0

private func append_outline_lanes (styles: &[OutlineStyle]) -> (targets: &[OutlineTarget]) -> (max_radius_px: F32) -> (depth_bias: F32) -> (values: own #[F32]) : #[F32] =>
  let count = min styles.length 256
  @storage.push values (U32.to_f32 count)
  @storage.push values max_radius_px
  @storage.push values depth_bias
  for i in 0 .. count:
    let s = styles[i]
    @storage.push values s.color.x
    @storage.push values s.color.y
    @storage.push values s.color.z
    @storage.push values s.color.w
    @storage.push values s.occluded_color.x
    @storage.push values s.occluded_color.y
    @storage.push values s.occluded_color.z
    @storage.push values s.occluded_color.w
    @storage.push values s.width_px
    @storage.push values s.feather_px
    @storage.push values s.fill_alpha
  for i in 0 .. targets.length:
    let t = targets[i]
    if t.style_index < count:
      @storage.push values (U32.to_f32 t.draw_index)
      @storage.push values (U32.to_f32 t.style_index)
  return values

// Keep the first 256 styles and drop targets outside the retained palette.
// Target indices refer to the frame's draw list and the supplied style array.
func pack_extension (styles: &[OutlineStyle]) -> (targets: &[OutlineTarget]) -> (max_radius_px: F32) -> (depth_bias: F32) : #[F32] =>
  let values: #[F32] = #[]
  return append_outline_lanes styles targets max_radius_px depth_bias values

func emit_extension (styles: &[OutlineStyle]) -> (targets: &[OutlineTarget]) -> (max_radius_px: F32) -> (depth_bias: F32) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let start = frame.extension_values.length
  frame.extension_values := append_outline_lanes styles targets max_radius_px depth_bias self
  let count = frame.extension_values.length - start
  @storage.push frame.extensions ($render.Extension { tag: jfa_outline_ext_tag, values: $render.Span { start, count } })
  return frame
