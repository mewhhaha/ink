import { Vec3 } from "std/vector"
import { Quat, Vec4 } from "./math"
import * as math from "./math"
import * as terrain from "./terrain"
import * as mesh from "./mesh"
import * as spatial from "./spatial"
import { Gap } from "./mesh"

// Collision shapes in world space, and the geometry under them.
//
// A shape is a capsule (a segment with a radius; a sphere when the segment
// is a point), a finite heightfield, or a convex polytope (`Poly`): boxes and
// brushes. A Poly keeps its vertices, its outward
// face planes `n . p <= d` (the same convention as Ink's brushes), the vertex
// ring of every face, and its edges, so the narrow phase can clip faces and
// find closest features exactly.
//
// Points and planes use explicit structural scalar rows for their packed
// geometry schema. Geometry aliases independently named resizable owners.

type Point3 = { x: F32, y: F32, z: F32 }
type Plane4 = { x: F32, y: F32, z: F32, w: F32 }

type Ring = { start: U32, length: U32 }
type Poly is data = $Poly {
  center: Vec3,
  verts: &[Point3],
  planes: &[Plane4],
  rings: &[Ring],
  ring_indices: &[U32],
  centers: &[Point3],
  ea: &[U32],
  eb: &[U32],
  dirs: &[Point3],
}

// Independently owned nonmoving geometry pools. Keep this access bundle beside
// any proxy/shape rows borrowing it; never store the bundle inside a row pool.
type Geometry is data = $Geometry {
  points: #[Point3], planes: #[Plane4],
  rings: #[Ring], indices: #[U32], heights: #[F32], source_planes: #[Vec4],
}
type Read is data = $Read {
  points: &[Point3],
  planes: &[Plane4],
  rings: &[Ring],
  indices: &[U32],
  heights: &[F32],
  source_planes: &[Vec4],
}
func read (g: Geometry): Read => $Read {
  points: &g.points[0..g.points.length],
  planes: &g.planes[0..g.planes.length],
  rings: &g.rings[0..g.rings.length],
  indices: &g.indices[0..g.indices.length],
  heights: &g.heights[0..g.heights.length],
  source_planes: &g.source_planes[0..g.source_planes.length],
}
func empty () : Geometry =>
  let points: #[Point3] = #[]
  let planes: #[Plane4] = #[]
  let rings: #[Ring] = #[]
  let indices: #[U32] = #[]
  let heights: #[F32] = #[]
  let source_planes: #[Vec4] = #[]
  return $Geometry {points, planes, rings, indices, heights, source_planes}
// Temporary working geometry remains alive through this known consumer.
func with_geometry consume => consume (own (empty ()))
// A retained geometry rebuild is a structural boundary. All borrowed shapes
// must be consumed before clearing; owner identities/capacities are retained.
func clear (geometry: own Geometry) : Geometry =>
  @storage.truncate geometry.points 0
  @storage.truncate geometry.planes 0
  @storage.truncate geometry.rings 0
  @storage.truncate geometry.indices 0
  @storage.truncate geometry.heights 0
  @storage.truncate geometry.source_planes 0
  return geometry

type Shape is data =
  | $Capsule { a: Vec3, b: Vec3, radius: F32 }
  | $Hull Poly
  | $Heightfield terrain.Terrain
  | $Mesh mesh.Mesh


const zero = $Vec3 { x: 0.0, y: 0.0, z: 0.0 }
const unit_y = $Vec3 { x: 0.0, y: 1.0, z: 0.0 }
const far = 1000000000.0

func plane_normal (p: Vec4) => $Vec3 { x: p.x, y: p.y, z: p.z }
// The outward normal of a polytope face.
func face_normal (p: Plane4) => $Vec3 { x: p.x, y: p.y, z: p.z }
// A polytope point as a vector.
func point_vec (p: Point3) => $Vec3 { x: p.x, y: p.y, z: p.z }
func plane (n: Vec3) => func (d: F32) => $Vec4 { x: n.x, y: n.y, z: n.z, w: d }
func neg (v: Vec3) => $Vec3 { x: F32.neg v.x, y: F32.neg v.y, z: F32.neg v.z }
func mul3 (a: Vec3) => func (b: Vec3) => $Vec3 { x: a.x * b.x, y: a.y * b.y, z: a.z * b.z }
func min3 (a: Vec3) => func (b: Vec3) => $Vec3 { x: min a.x b.x, y: min a.y b.y, z: min a.z b.z }
func max3 (a: Vec3) => func (b: Vec3) => $Vec3 { x: max a.x b.x, y: max a.y b.y, z: max a.z b.z }

// A unit vector perpendicular to (nx, ny, nz), stable for any direction.
func perpendicular_xyz (nx: F32) => func (ny: F32) => func (nz: F32) =>
  let hx = 0.0
  let hy = 0.0
  let hz = 1.0
  if abs nx < 0.57:
    hx := 1.0
    hz := 0.0
  else:
    if abs ny < 0.57:
      hy := 1.0
      hz := 0.0
  let cx = ny * hz - nz * hy
  let cy = nz * hx - nx * hz
  let cz = nx * hy - ny * hx
  let length = sqrt (cx * cx + cy * cy + cz * cz)
  if length == 0.0:
    return (cx, cy, cz)
  return (cx / length, cy / length, cz / length)

// A vector perpendicular to `n`, stable for any direction.
func perpendicular (n: Vec3) =>
  let (x, y, z) = perpendicular_xyz n.x n.y n.z
  return $Vec3 { x, y, z }

// Segments --------------------------------------------------------------------
//
// The hot queries work on scalar coordinates: on the pinned compiler every
// Vec3 operation passed between functions allocates a record. The `_xyz`
// forms return flat tuples; the Vec3 forms wrap them with the same rounding.

// The closest point on segment ab to p: (parameter, point).
func segment_point (a: Vec3) => func (b: Vec3) => func (p: Vec3) =>
  let (t, x, y, z) = mesh.segment_point_xyz a.x a.y a.z b.x b.y b.z p.x p.y p.z
  return (t, $Vec3 { x, y, z })

// The closest points of segments p1q1 and p2q2: (s, t, point1, point2).
func segment_segment (p1: Vec3) => func (q1: Vec3) => func (p2: Vec3) => func (q2: Vec3) =>
  let d1 = q1 - p1
  let d2 = q2 - p2
  let (s, t) = mesh.segment_params p1.x p1.y p1.z d1.x d1.y d1.z p2.x p2.y p2.z d2.x d2.y d2.z
  return (s, t, p1 + d1 * s, p2 + d2 * t)

// Polytopes -------------------------------------------------------------------

// Cube corners are numbered by bits: x = 1, y = 2, z = 4.
const box_rings: #[Ring] = #[{start:0,length:4}, {start:4,length:4}, {start:8,length:4}, {start:12,length:4}, {start:16,length:4}, {start:20,length:4}]
const box_ring_indices: #[U32] = #[1,3,7,5, 0,2,6,4, 2,3,7,6, 0,1,5,4, 4,5,7,6, 0,1,3,2]
func ring_vertex (poly: Poly) -> (ring: Ring) -> (index: U32) =>
  if index >= ring.length:
    return panic "poly ring vertex outside span"
  return poly.ring_indices[ring.start + index]
const box_edge_a: #[U32] = #[0, 2, 4, 6, 0, 1, 4, 5, 0, 1, 2, 3]
const box_edge_b: #[U32] = #[1, 3, 5, 7, 2, 3, 6, 7, 4, 5, 6, 7]

// An oriented box.
func box_poly (geometry: own Geometry) -> (center: Vec3) -> (rotation: Quat) -> (half: Vec3) : (StoredPoly, Geometry) =>
  let $Quat { x: qx, y: qy, z: qz, w: qw } = rotation
  let (axx, axy, axz) = math.rotate_parts qx qy qz qw 1.0 0.0 0.0
  let (ayx, ayy, ayz) = math.rotate_parts qx qy qz qw 0.0 1.0 0.0
  let (azx, azy, azz) = math.rotate_parts qx qy qz qw 0.0 0.0 1.0
  let cx = center.x
  let cy = center.y
  let cz = center.z
  let exx = axx * half.x
  let exy = axy * half.x
  let exz = axz * half.x
  let eyx = ayx * half.y
  let eyy = ayy * half.y
  let eyz = ayz * half.y
  let ezx = azx * half.z
  let ezy = azy * half.z
  let ezz = azz * half.z
  let verts = @array.generate 8 (func (i: U32) =>
    let xs = (i & 1) != 0
    let ys = (i & 2) != 0
    let zs = (i & 4) != 0
    let xx = if xs then exx else F32.neg exx
    let xy = if xs then exy else F32.neg exy
    let xz = if xs then exz else F32.neg exz
    let yx = if ys then eyx else F32.neg eyx
    let yy = if ys then eyy else F32.neg eyy
    let yz = if ys then eyz else F32.neg eyz
    let zx = if zs then ezx else F32.neg ezx
    let zy = if zs then ezy else F32.neg ezy
    let zz = if zs then ezz else F32.neg ezz
    return { x: cx + xx + yx + zx, y: cy + xy + yy + zy, z: cz + xz + yz + zz })
  let dx = axx * cx + axy * cy + axz * cz
  let dy = ayx * cx + ayy * cy + ayz * cz
  let dz = azx * cx + azy * cy + azz * cz
  let planes = #[
    { x: axx, y: axy, z: axz, w: dx + half.x },
    { x: F32.neg axx, y: F32.neg axy, z: F32.neg axz, w: F32.neg dx + half.x },
    { x: ayx, y: ayy, z: ayz, w: dy + half.y },
    { x: F32.neg ayx, y: F32.neg ayy, z: F32.neg ayz, w: F32.neg dy + half.y },
    { x: azx, y: azy, z: azz, w: dz + half.z },
    { x: F32.neg azx, y: F32.neg azy, z: F32.neg azz, w: F32.neg dz + half.z },
  ]
  let centers = #[
    { x: cx + exx, y: cy + exy, z: cz + exz },
    { x: cx - exx, y: cy - exy, z: cz - exz },
    { x: cx + eyx, y: cy + eyy, z: cz + eyz },
    { x: cx - eyx, y: cy - eyy, z: cz - eyz },
    { x: cx + ezx, y: cy + ezy, z: cz + ezz },
    { x: cx - ezx, y: cy - ezy, z: cz - ezz },
  ]
  let dirs = #[{ x: axx, y: axy, z: axz }, { x: ayx, y: ayy, z: ayz }, { x: azx, y: azy, z: azz }]
  let $Geometry { points, planes: g_planes, rings, indices, heights, source_planes } = geometry
  let (verts_span, points) = pack_span points (&verts[0..verts.length])
  let (centers_span, points) = pack_span points (&centers[0..centers.length])
  let (dirs_span, points) = pack_span points (&dirs[0..dirs.length])
  let (planes_span, g_planes) = pack_span g_planes (&planes[0..planes.length])
  let (rings_span, rings) = pack_span rings (&box_rings[0..box_rings.length])
  let (ring_indices_span, indices) = pack_span indices (&box_ring_indices[0..box_ring_indices.length])
  let (ea_span, indices) = pack_span indices (&box_edge_a[0..box_edge_a.length])
  let (eb_span, indices) = pack_span indices (&box_edge_b[0..box_edge_b.length])
  return ($StoredPoly { center,
    verts: verts_span, planes: planes_span, rings: rings_span, ring_indices: ring_indices_span,
    centers: centers_span, ea: ea_span, eb: eb_span, dirs: dirs_span },
    $Geometry { points, planes: g_planes, rings, indices, heights, source_planes })

// Closest point on a polygon (a face ring) to p.
func face_closest_xyz (poly: Poly) => func (face: U32) => func (px: F32) => func (py: F32) => func (pz: F32) =>
  let plane4 = poly.planes[face]
  let nx = plane4.x
  let ny = plane4.y
  let nz = plane4.z
  let ring = poly.rings[face]
  let centroid = poly.centers[face]
  let lift = nx * px + ny * py + nz * pz - plane4.w
  let jx = px - nx * lift
  let jy = py - ny * lift
  let jz = pz - nz * lift
  let count = ring.length
  // The projection lies within the face when it is inside every edge;
  // only otherwise does the nearest edge point matter.
  let inside = true
  for i in 0..count:
    let v0 = poly.verts[ring_vertex poly ring i]
    let v1 = poly.verts[ring_vertex poly ring ((i + 1) % count)]
    let ex = v1.x - v0.x
    let ey = v1.y - v0.y
    let ez = v1.z - v0.z
    let sx = ny * ez - nz * ey
    let sy = nz * ex - nx * ez
    let sz = nx * ey - ny * ex
    let flip = sx * (centroid.x - v0.x) + sy * (centroid.y - v0.y) + sz * (centroid.z - v0.z) < 0.0
    let ix = if flip then F32.neg sx else sx
    let iy = if flip then F32.neg sy else sy
    let iz = if flip then F32.neg sz else sz
    if ix * (jx - v0.x) + iy * (jy - v0.y) + iz * (jz - v0.z) < 0.0:
      inside := false
  if inside:
    return (jx, jy, jz)
  let best = 1.0 / 0.0
  let qx = jx
  let qy = jy
  let qz = jz
  for i in 0..count:
    let v0 = poly.verts[ring_vertex poly ring i]
    let v1 = poly.verts[ring_vertex poly ring ((i + 1) % count)]
    let (_, cx, cy, cz) = mesh.segment_point_xyz v0.x v0.y v0.z v1.x v1.y v1.z px py pz
    let dx = px - cx
    let dy = py - cy
    let dz = pz - cz
    let d2 = dx * dx + dy * dy + dz * dz
    if d2 < best:
      best := d2
      qx := cx
      qy := cy
      qz := cz
  return (qx, qy, qz)

// Closest point on a polygon (a face ring) to p.
func face_closest (poly: Poly) => func (face: U32) => func (p: Vec3) =>
  let (x, y, z) = face_closest_xyz poly face p.x p.y p.z
  return $Vec3 { x, y, z }

// The closest point of the solid polytope to p: (distance, point, normal) as
// (d, px, py, pz, nx, ny, nz). See `poly_point`.
func poly_point_xyz (poly: Poly) => func (px: F32) => func (py: F32) => func (pz: F32) =>
  let faces = poly.planes.length
  if faces == 0:
    return (0.0, px, py, pz, 0.0, 1.0, 0.0)
  let top = (-1.0 / 0.0)
  let top_face = 0
  for f in 0..faces:
    let plane4 = poly.planes[f]
    let s = plane4.x * px + plane4.y * py + plane4.z * pz - plane4.w
    if s > top:
      top := s
      top_face := f
  let face = poly.planes[top_face]
  let nx = face.x
  let ny = face.y
  let nz = face.z
  if top <= 0.0:
    return (top, px - nx * top, py - ny * top, pz - nz * top, nx, ny, nz)
  let best = 1.0 / 0.0
  let qx = px
  let qy = py
  let qz = pz
  for f in 0..faces:
    let plane4 = poly.planes[f]
    let s = plane4.x * px + plane4.y * py + plane4.z * pz - plane4.w
    if s > 0.0:
      let (cx, cy, cz) = face_closest_xyz poly f px py pz
      let dx = px - cx
      let dy = py - cy
      let dz = pz - cz
      let d2 = dx * dx + dy * dy + dz * dz
      if d2 < best:
        best := d2
        qx := cx
        qy := cy
        qz := cz
  let distance = sqrt best
  if is_finite distance and distance > 0.00001:
    return (distance, qx, qy, qz, (px - qx) / distance, (py - qy) / distance, (pz - qz) / distance)
  return (distance, qx, qy, qz, nx, ny, nz)

// The closest point of the solid polytope to p. Returns (distance, point,
// normal): the distance is negative inside, by how far to move along the
// normal (the face normal there) to leave.
func poly_point (poly: Poly) => func (p: Vec3) =>
  let (distance, qx, qy, qz, nx, ny, nz) = poly_point_xyz poly p.x p.y p.z
  return (distance, $Vec3 { x: qx, y: qy, z: qz }, $Vec3 { x: nx, y: ny, z: nz })

// The normal of the most upward face of the polytope through `point`.
func poly_surface (poly: Poly) => func (point: Vec3) => func (fallback: Vec3) =>
  let px = point.x
  let py = point.y
  let pz = point.z
  let chosen = poly.planes.length
  let top = (-2.0)
  for f in 0..poly.planes.length:
    let plane4 = poly.planes[f]
    if abs (plane4.x * px + plane4.y * py + plane4.z * pz - plane4.w) < 0.004 and plane4.y > top:
      top := plane4.y
      chosen := f
  if chosen < poly.planes.length:
    return face_normal poly.planes[chosen]
  return fallback

// Does segment ab touch the polytope? Clips the segment by every plane.
func segment_touches_xyz (poly: Poly) => func (ax: F32) => func (ay: F32) => func (az: F32) => func (bx: F32) => func (by: F32) => func (bz: F32) =>
  if not (is_finite ax and is_finite ay and is_finite az and is_finite bx and is_finite by and is_finite bz):
    return false
  let abx = bx - ax
  let aby = by - ay
  let abz = bz - az
  let enter = 0.0
  let leave = 1.0
  for plane4 in poly.planes:
    let side = plane4.x * ax + plane4.y * ay + plane4.z * az - plane4.w
    let slope = plane4.x * abx + plane4.y * aby + plane4.z * abz
    if not (is_finite side and is_finite slope):
      return false
    if abs slope < 0.0000001:
      if side > 0.0:
        return false
    else:
      let t = F32.neg side / slope
      if not (is_finite t):
        return false
      if slope < 0.0:
        enter := max self t
      else:
        leave := min self t
      if not (enter <= leave):
        return false
  return is_finite enter and is_finite leave and enter <= leave

// Does segment ab touch the polytope? Clips the segment by every plane.
func segment_touches (poly: Poly) => func (a: Vec3) => func (b: Vec3) => segment_touches_xyz poly a.x a.y a.z b.x b.y b.z

// The gap between segment ab and the polytope.
func segment_poly (poly: Poly) => func (a: Vec3) => func (b: Vec3) =>
  let ax = a.x
  let ay = a.y
  let az = a.z
  let bx = b.x
  let by = b.y
  let bz = b.z
  if ax == bx and ay == by and az == bz:
    let (distance, qx, qy, qz, nx, ny, nz) = poly_point_xyz poly ax ay az
    let point = $Vec3 { x: qx, y: qy, z: qz }
    let normal = $Vec3 { x: nx, y: ny, z: nz }
    return $Gap { dist: distance, normal, surface: poly_surface poly point normal, on_shape: point, on_segment: a }
  if segment_touches_xyz poly ax ay az bx by bz:
    // Overlap: leave along the face that needs the least movement.
    let best = far
    let chosen = poly.planes.length
    let from_a = true
    for f in 0..poly.planes.length:
      let plane4 = poly.planes[f]
      let da = plane4.x * ax + plane4.y * ay + plane4.z * az
      let db = plane4.x * bx + plane4.y * by + plane4.z * bz
      let low = min da db
      let move = plane4.w - low
      if move < best:
        best := move
        chosen := f
        from_a := da < db
    let normal = if chosen < poly.planes.length then face_normal poly.planes[chosen] else unit_y
    let on_segment = if chosen < poly.planes.length and not from_a then b else a
    return $Gap { dist: F32.neg best, normal, surface: normal, on_shape: $Vec3 { x: on_segment.x + normal.x * best, y: on_segment.y + normal.y * best, z: on_segment.z + normal.z * best }, on_segment }
  let (da, qax, qay, qaz, nax, nay, naz) = poly_point_xyz poly ax ay az
  let (db, qbx, qby, qbz, nbx, nby, nbz) = poly_point_xyz poly bx by bz
  let nearer_a = da < db
  let best = if nearer_a then da else db
  let shape_x = if nearer_a then qax else qbx
  let shape_y = if nearer_a then qay else qby
  let shape_z = if nearer_a then qaz else qbz
  let segment_x = if nearer_a then ax else bx
  let segment_y = if nearer_a then ay else by
  let segment_z = if nearer_a then az else bz
  let nx = if nearer_a then nax else nbx
  let ny = if nearer_a then nay else nby
  let nz = if nearer_a then naz else nbz
  let d1x = bx - ax
  let d1y = by - ay
  let d1z = bz - az
  let low_x = min ax bx
  let low_y = min ay by
  let low_z = min az bz
  let high_x = max ax bx
  let high_y = max ay by
  let high_z = max az bz
  let size = abs ax + abs ay + abs az + abs bx + abs by + abs bz
  for i in 0..poly.ea.length:
    let e0 = poly.verts[poly.ea[i]]
    let e1 = poly.verts[poly.eb[i]]
    // An edge whose bounds stay farther than `best` from the segment's
    // cannot come closer, whatever the rounding: skip its closest points.
    let apart_x = max 0.0 (max (min e0.x e1.x - high_x) (low_x - max e0.x e1.x))
    let apart_y = max 0.0 (max (min e0.y e1.y - high_y) (low_y - max e0.y e1.y))
    let apart_z = max 0.0 (max (min e0.z e1.z - high_z) (low_z - max e0.z e1.z))
    let slack = (size + abs e0.x + abs e0.y + abs e0.z + abs e1.x + abs e1.y + abs e1.z) * 0.00001
    let reach = best + slack
    if not (best >= 0.0 and apart_x * apart_x + apart_y * apart_y + apart_z * apart_z > reach * reach):
      let d2x = e1.x - e0.x
      let d2y = e1.y - e0.y
      let d2z = e1.z - e0.z
      let (s, t) = mesh.segment_params ax ay az d1x d1y d1z e0.x e0.y e0.z d2x d2y d2z
      let psx = ax + d1x * s
      let psy = ay + d1y * s
      let psz = az + d1z * s
      let pex = e0.x + d2x * t
      let pey = e0.y + d2y * t
      let pez = e0.z + d2z * t
      let gx = psx - pex
      let gy = psy - pey
      let gz = psz - pez
      let d2 = gx * gx + gy * gy + gz * gz
      if d2 < best * best or best < 0.0:
        let distance = sqrt d2
        if distance < best:
          best := distance
          shape_x := pex
          shape_y := pey
          shape_z := pez
          segment_x := psx
          segment_y := psy
          segment_z := psz
          if distance > 0.00001:
            nx := gx / distance
            ny := gy / distance
            nz := gz / distance
  let on_shape = $Vec3 { x: shape_x, y: shape_y, z: shape_z }
  let normal = $Vec3 { x: nx, y: ny, z: nz }
  return $Gap { dist: best, normal, surface: poly_surface poly on_shape normal, on_shape, on_segment: $Vec3 { x: segment_x, y: segment_y, z: segment_z } }

// Heightfields ----------------------------------------------------------------

// Closest surface/segment pair from a seed. A tangent-plane Newton step with
// backtracking follows the continuous bilinear + procedural height function.
func terrain_seed (t: terrain.Terrain) => func (a: Vec3) => func (b: Vec3) => func (seed: Vec3) =>
  let x0 = t.origin.x - t.half
  let x1 = t.origin.x + t.half
  let z0 = t.origin.z - t.half
  let z1 = t.origin.z + t.half
  let ax = a.x
  let ay = a.y
  let az = a.z
  let bx = b.x
  let by = b.y
  let bz = b.z
  let qx = clamp x0 x1 seed.x
  let qz = clamp z0 z1 seed.z
  let qy = terrain.height t qx qz
  let (_, px, py, pz) = mesh.segment_point_xyz ax ay az bx by bz qx qy qz
  // The surface normal at q, reused at the end while q stays put.
  let sx = 0.0
  let sy = 1.0
  let sz = 0.0
  let current = false
  for 0..16:
    let n = terrain.collision_normal t qx qz
    if not (math.finite3 n) or n.y <= 0.000001:
      break
    sx := n.x
    sy := n.y
    sz := n.z
    current := true
    let gx = F32.neg n.x / n.y
    let gz = F32.neg n.z / n.y
    let ex = qx - px
    let ey = qy - py
    let ez = qz - pz
    let rx = ex + gx * ey
    let rz = ez + gz * ey
    let det = 1.0 + gx * gx + gz * gz
    let dx = ((1.0 + gz * gz) * rx - gx * gz * rz) / det
    let dz = ((1.0 + gx * gx) * rz - gx * gz * rx) / det
    if not (is_finite dx and is_finite dz) or dx * dx + dz * dz < 0.00000001:
      break
    let accepted = false
    let fraction = 1.0
    let old = ex * ex + ey * ey + ez * ez
    for 0..8:
      if not accepted:
        let cx = clamp x0 x1 (qx - dx * fraction)
        let cz = clamp z0 z1 (qz - dz * fraction)
        let cy = terrain.height t cx cz
        let (_, tx, ty, tz) = mesh.segment_point_xyz ax ay az bx by bz cx cy cz
        let fx = cx - tx
        let fy = cy - ty
        let fz = cz - tz
        if fx * fx + fy * fy + fz * fz < old:
          qx := cx
          qy := cy
          qz := cz
          px := tx
          py := ty
          pz := tz
          accepted := true
          current := false
        fraction := self * 0.5
    if not accepted:
      break
  let surface = if current then $Vec3 { x: sx, y: sy, z: sz } else terrain.collision_normal t qx qz
  let gx = px - qx
  let gy = py - qy
  let gz = pz - qz
  let distance = sqrt (gx * gx + gy * gy + gz * gz)
  let nx = surface.x
  let ny = surface.y
  let nz = surface.z
  if distance > 0.002:
    nx := gx / distance
    ny := gy / distance
    nz := gz / distance
  let on_shape = $Vec3 { x: qx, y: qy, z: qz }
  let on_segment = $Vec3 { x: px, y: py, z: pz }
  if terrain.inside t px pz and py < terrain.height t px pz:
    if distance > 0.002:
      nx := F32.neg nx
      ny := F32.neg ny
      nz := F32.neg nz
    return $Gap { dist: F32.neg distance, normal: $Vec3 { x: nx, y: ny, z: nz }, surface, on_shape, on_segment }
  return $Gap { dist: distance, normal: $Vec3 { x: nx, y: ny, z: nz }, surface, on_shape, on_segment }

// The finite heightfield is solid below its surface, with vertical boundary
// walls. Points outside its footprint do not collide with the continued
// border heights used by terrain.height.
func terrain_side (t: terrain.Terrain) => func (p: Vec3) =>
  let x0 = t.origin.x - t.half
  let x1 = t.origin.x + t.half
  let z0 = t.origin.z - t.half
  let z1 = t.origin.z + t.half
  let q = $Vec3 { x: clamp x0 x1 p.x, y: p.y, z: clamp z0 z1 p.z }
  let under = terrain.height t q.x q.z
  q.y := min self under
  if terrain.inside t p.x p.z:
    // Inside the footprint the clamp keeps p's coordinates: reuse its height.
    let surface = if q.x == p.x and q.z == p.z then under else terrain.height t p.x p.z
    if p.y > surface:
      return $Gap { dist: far, normal: unit_y, surface: unit_y, on_shape: q, on_segment: p }
    let depth = p.x - x0
    let n = $Vec3 { x: (-1.0), y: 0.0, z: 0.0 }
    q.x := x0
    q.z := p.z
    if x1 - p.x < depth:
      depth := x1 - p.x
      n := $Vec3 { x: 1.0, y: 0.0, z: 0.0 }
      q.x := x1
    if p.z - z0 < depth:
      depth := p.z - z0
      n := $Vec3 { x: 0.0, y: 0.0, z: (-1.0) }
      q.x := p.x
      q.z := z0
    if z1 - p.z < depth:
      depth := z1 - p.z
      n := $Vec3 { x: 0.0, y: 0.0, z: 1.0 }
      q.x := p.x
      q.z := z1
    if p.y <= terrain.height t q.x q.z:
      return $Gap { dist: F32.neg depth, normal: n, surface: n, on_shape: q, on_segment: p }
    return $Gap { dist: far, normal: unit_y, surface: unit_y, on_shape: q, on_segment: p }
  let delta = p - q
  let distance = delta.length
  let normal = unit_y
  if distance > 0.00001:
    normal := delta / distance
  return $Gap { dist: distance, normal, surface: normal, on_shape: q, on_segment: p }

func segment_terrain (t: terrain.Terrain) => func (a: Vec3) => func (b: Vec3) =>
  if not (math.finite3 a and math.finite3 b):
    return $Gap { dist: far, normal: unit_y, surface: unit_y, on_shape: zero, on_segment: zero }
  // Distance to a downward solid cannot increase while moving down a
  // vertical core. Upright capsules therefore only need their lower end.
  if a.x == b.x and a.z == b.z:
    if a.y < b.y:
      b := a
    else:
      a := b
  let point = a.x == b.x and a.y == b.y and a.z == b.z
  let best = terrain_seed t a b a
  if not point:
    let end = terrain_seed t a b b
    if end.dist < best.dist:
      best := end
  let step = terrain.collision_step t
  // Search only features within the current closest distance. Cell height
  // bounds prune distant grid/noise features before the surface refinement.
  let reach = abs best.dist + step
  let x0 = max (t.origin.x - t.half) (min a.x b.x - reach)
  let x1 = min (t.origin.x + t.half) (max a.x b.x + reach)
  let z0 = max (t.origin.z - t.half) (min a.z b.z - reach)
  let z1 = min (t.origin.z + t.half) (max a.z b.z + reach)
  if is_finite x0 and is_finite x1 and is_finite z0 and is_finite z1 and x0 <= x1 and z0 <= z1:
    let span_x = x1 - x0
    let span_z = z1 - z0
    let raw_nx = ceil (span_x / step)
    let raw_nz = ceil (span_z / step)
    let nx: U32 = 1
    let nz: U32 = 1
    if is_finite raw_nx and is_finite raw_nz and raw_nx <= 65536.0 and raw_nz <= 65536.0 and max 1.0 raw_nx * max 1.0 raw_nz <= 65536.0:
      nx := max 1 (F32.to_u32 raw_nx)
      nz := max 1 (F32.to_u32 raw_nz)
    else:
      let eff_step = max step (max span_x span_z / 256.0)
      if is_finite eff_step and eff_step > 0.0:
        let sx = ceil (span_x / eff_step)
        let sz = ceil (span_z / eff_step)
        nx := if is_finite sx then max 1 (min 256 (F32.to_u32 sx)) else 1
        nz := if is_finite sz then max 1 (min 256 (F32.to_u32 sz)) else 1
    for iz in 0..(nz + 1):
      let z = F32.lerp z0 z1 (U32.to_f32 iz / U32.to_f32 nz)
      for ix in 0..(nx + 1):
        let x = F32.lerp x0 x1 (U32.to_f32 ix / U32.to_f32 nx)
        let (low, high) = terrain.range t (x - step) (z - step) (x + step) (z + step)
        let dx = max 0.0 (max (min a.x b.x - x - step) (x - step - max a.x b.x))
        let dz = max 0.0 (max (min a.z b.z - z - step) (z - step - max a.z b.z))
        let dy = max 0.0 (max (min a.y b.y - high) (low - max a.y b.y))
        if best.dist < 0.0 or dx * dx + dy * dy + dz * dz <= best.dist * best.dist:
          let gap = terrain_seed t a b ($Vec3 { x, y: 0.0, z })
          let closer = gap.dist < best.dist
          if point and gap.dist < 0.0 and best.dist < 0.0:
            closer := gap.dist > best.dist
          if closer:
            best := gap
  // A submerged segment must leave the whole solid. The top surface is the
  // useful separating feature; a point can leave through a nearer wall.
  if point:
    let side = terrain_side t a
    if best.dist < 0.0 and side.dist < 0.0:
      if side.dist > best.dist:
        best := side
    else:
      if side.dist >= 0.0 and side.dist < best.dist:
        best := side
  else:
    if best.dist >= 0.0:
      for e in 0..2:
        let p = a
        if e == 1:
          p := b
        let side = terrain_side t p
        if side.dist < best.dist:
          best := side
  return best

// The gap between a segment and any shape.
func segment_gap (shape: Shape) => func (a: Vec3) => func (b: Vec3) => case shape of
  $Capsule { a: c0, b: c1, radius } => do:
    let d1x = b.x - a.x
    let d1y = b.y - a.y
    let d1z = b.z - a.z
    let d2x = c1.x - c0.x
    let d2y = c1.y - c0.y
    let d2z = c1.z - c0.z
    let (s, t) = mesh.segment_params a.x a.y a.z d1x d1y d1z c0.x c0.y c0.z d2x d2y d2z
    let psx = a.x + d1x * s
    let psy = a.y + d1y * s
    let psz = a.z + d1z * s
    let pcx = c0.x + d2x * t
    let pcy = c0.y + d2y * t
    let pcz = c0.z + d2z * t
    let dx = psx - pcx
    let dy = psy - pcy
    let dz = psz - pcz
    let length = sqrt (dx * dx + dy * dy + dz * dz)
    let nx = 0.0
    let ny = 1.0
    let nz = 0.0
    if length > 0.00001:
      nx := dx / length
      ny := dy / length
      nz := dz / length
    let normal = $Vec3 { x: nx, y: ny, z: nz }
    break $Gap { dist: length - radius, normal, surface: normal, on_shape: $Vec3 { x: pcx + nx * radius, y: pcy + ny * radius, z: pcz + nz * radius }, on_segment: $Vec3 { x: psx, y: psy, z: psz } }
  $Hull poly => segment_poly poly a b
  $Heightfield t => segment_terrain t a b
  $Mesh m => mesh.segment_gap m a b

// Hulls from planes ------------------------------------------------------------

func array_normalize (planes: &[Vec4]) => return
  @array.generate planes.length (func (i: U32) =>
    let p = planes[i]
    let length = (plane_normal p).length
    return if length > 0.000001 then $Vec4 { x: p.x / length, y: p.y / length, z: p.z / length, w: p.w / length } else p)

// Reorder `ids` by ascending `keys` (a few elements: insertion sort).
func sort_by (keys: #[F32]) => func (ids: #[U32]) =>
  let result = @array.generate ids.length (func (i: U32) => ids[i])
  let k = @array.generate keys.length (func (i: U32) => keys[i])
  for i in 1..ids.length:
    let j = i
    let active = true
    for 0..i:
      if active and j > 0:
        let previous = k[j - 1]
        let current = k[j]
        if previous > current:
          k[j] := previous
          k[j - 1] := current
          let previous_id = result[j - 1]
          let current_id = result[j]
          result[j] := previous_id
          result[j - 1] := current_id
          j := self - 1
        else:
          active := false
  return result

// Rank of a direction around an axis without trigonometry: increases
// monotonically with the angle, from 0 to 4.
func pseudo_angle (x: F32) => func (y: F32) =>
  let p = y / (abs x + abs y + 0.000000001)
  return if x < 0.0 then 2.0 - p else if y < 0.0 then 4.0 + p else p

const plane_eps = 0.0005

// The first of `planes` that (px, py, pz) lies beyond, or the plane count
// when it is within all of them.
func outside_plane (planes: #[Vec4]) => func (px: F32) => func (py: F32) => func (pz: F32) =>
  for m in 0..planes.length:
    let c = planes[m]
    if not (c.x * px + c.y * py + c.z * pz <= c.w + plane_eps):
      return m
  return planes.length

// The polytope of a brush's planes, or nothing if they bound no volume.
func hull_poly (geometry: own Geometry) -> (planes_in: &[Vec4]) : (Maybe StoredPoly, Geometry) =>
  if planes_in.length < 4:
    return ($Nothing, geometry)
  for p in planes_in:
    if not (is_finite p.x and is_finite p.y and is_finite p.z and is_finite p.w):
      return ($Nothing, geometry)
    let len = (plane_normal p).length
    if not (is_finite len) or len <= 0.000001:
      return ($Nothing, geometry)
  // Normalize so distances are metres.
  let planes = array_normalize planes_in
  let count = planes.length
  // Identical half-spaces add no constraints. Keep authored face order in
  // the output, but intersect and test each distinct normalized plane once.
  let unique: #[Vec4] = #[]
  for p in planes:
    let duplicate = false
    for q in unique:
      if p.x == q.x and p.y == q.y and p.z == q.z and p.w == q.w:
        duplicate := true
    if not duplicate:
      @storage.push unique p
  let clipping = unique
  let clips = clipping.length
  // Corners, three scalars each, filled in place; the buffer doubles when full.
  let found: #[F32] = #[]
  let total = 0
  let rejector = 0
  for i in 0..clips:
    let n1x = clipping[i].x
    let n1y = clipping[i].y
    let n1z = clipping[i].z
    let w1 = clipping[i].w
    for j in (i + 1)..clips:
      let n2x = clipping[j].x
      let n2y = clipping[j].y
      let n2z = clipping[j].z
      let w2 = clipping[j].w
      let c12x = n1y * n2z - n1z * n2y
      let c12y = n1z * n2x - n1x * n2z
      let c12z = n1x * n2y - n1y * n2x
      if c12x * c12x + c12y * c12y + c12z * c12z > 0.0000001:
        for k in (j + 1)..clips:
          let n3x = clipping[k].x
          let n3y = clipping[k].y
          let n3z = clipping[k].z
          let w3 = clipping[k].w
          let c23x = n2y * n3z - n2z * n3y
          let c23y = n2z * n3x - n2x * n3z
          let c23z = n2x * n3y - n2y * n3x
          let det = n1x * c23x + n1y * c23y + n1z * c23z
          if abs det > 0.000001:
            let c31x = n3y * n1z - n3z * n1y
            let c31y = n3z * n1x - n3x * n1z
            let c31z = n3x * n1y - n3y * n1x
            let px = (c23x * w1 + c31x * w2 + c12x * w3) / det
            let py = (c23y * w1 + c31y * w2 + c12y * w3) / det
            let pz = (c23z * w1 + c31z * w2 + c12z * w3) / det
            // Corners along one plane pair are mostly cut off by the same
            // plane: try the last one that rejected a corner first.
            let inside = false
            if is_finite px and is_finite py and is_finite pz:
              let r = clipping[rejector]
              if r.x * px + r.y * py + r.z * pz <= r.w + plane_eps:
                let beyond = outside_plane clipping px py pz
                if beyond < clips:
                  rejector := beyond
                else:
                  inside := true
            if inside:
              let duplicate = false
              for q in 0..total:
                let dx = found[q * 3] - px
                let dy = found[q * 3 + 1] - py
                let dz = found[q * 3 + 2] - pz
                if dx * dx + dy * dy + dz * dz < 0.0000001:
                  duplicate := true
              if not duplicate:
                @storage.push found px
                @storage.push found py
                @storage.push found pz
                total := self + 1
  let verts = @array.generate total (func (v: U32) => { x: found[v * 3], y: found[v * 3 + 1], z: found[v * 3 + 2] })
  if verts.length < 4:
    return ($Nothing, geometry)
  let tx = 0.0
  let ty = 0.0
  let tz = 0.0
  for v in verts:
    tx := self + v.x
    ty := self + v.y
    tz := self + v.z
  let corners = U32.to_f32 verts.length
  let center = $Vec3 { x: tx / corners, y: ty / corners, z: tz / corners }
  // One ring of vertices per plane, ordered around its centre.
  let kept_planes: #[Plane4] = #[]
  let kept_rings: #[Ring] = #[]
  let ring_vertices: #[U32] = #[]
  let kept_centers: #[Point3] = #[]
  for f in 0..count:
    let plane4 = planes[f]
    let nx = plane4.x
    let ny = plane4.y
    let nz = plane4.z
    let nw = plane4.w
    let members: #[U32] = #[]
    let sx = 0.0
    let sy = 0.0
    let sz = 0.0
    for v in 0..verts.length:
      let q = verts[v]
      if abs (nx * q.x + ny * q.y + nz * q.z - nw) < plane_eps:
        @storage.push members v
        sx := self + q.x
        sy := self + q.y
        sz := self + q.z
    let ids = members
    let share = max 1.0 (U32.to_f32 ids.length)
    let mx = sx / share
    let my = sy / share
    let mz = sz / share
    let n = plane_normal plane4
    let u = perpendicular n
    let w = n.cross u
    let ux = u.x
    let uy = u.y
    let uz = u.z
    let wx = w.x
    let wy = w.y
    let wz = w.z
    let keys = @array.generate ids.length (func (i: U32) =>
      let q = verts[ids[i]]
      let ex = q.x - mx
      let ey = q.y - my
      let ez = q.z - mz
      return pseudo_angle (ex * ux + ey * uy + ez * uz) (ex * wx + ey * wy + ez * wz))
    let sorted = sort_by keys ids
    // Store only faces bounding volume; rings use spans into one flat pool.
    if sorted.length >= 3:
      @storage.push kept_planes { x: nx, y: ny, z: nz, w: nw }
      @storage.push kept_rings { start: ring_vertices.length, length: sorted.length }
      for vertex in sorted:
        @storage.push ring_vertices vertex
      @storage.push kept_centers { x: mx, y: my, z: mz }
  let ring_array = kept_rings
  let ring_indices = ring_vertices
  if kept_planes.length < 4:
    return ($Nothing, geometry)
  // Edges: consecutive ring vertices, once each (lower index first).
  let ea: #[U32] = #[]
  let eb: #[U32] = #[]
  // Distinct edge directions, three scalars each, filled in place.
  let sides = 0
  for ring in ring_array:
    sides := self + ring.length
  let found_dirs = @array.fill (sides * 3) 0.0
  let directions = 0
  for ring in ring_array:
    let m = ring.length
    for i in 0..m:
      let a = ring_indices[ring.start + i]
      let b = ring_indices[ring.start + (i + 1) % m]
      if a < b:
        @storage.push ea a
        @storage.push eb b
        let va = verts[a]
        let vb = verts[b]
        let ex = vb.x - va.x
        let ey = vb.y - va.y
        let ez = vb.z - va.z
        let length = sqrt (ex * ex + ey * ey + ez * ez)
        let dx = ex
        let dy = ey
        let dz = ez
        if length != 0.0:
          dx := ex / length
          dy := ey / length
          dz := ez / length
        let known = false
        for d in 0..directions:
          if abs (found_dirs[d * 3] * dx + found_dirs[d * 3 + 1] * dy + found_dirs[d * 3 + 2] * dz) > 0.9999:
            known := true
        if not known:
          found_dirs[directions * 3] := dx
          found_dirs[directions * 3 + 1] := dy
          found_dirs[directions * 3 + 2] := dz
          directions := self + 1
  if ea.length == 0:
    return ($Nothing, geometry)
  let dirs = @array.generate directions (func (d: U32) => { x: found_dirs[d * 3], y: found_dirs[d * 3 + 1], z: found_dirs[d * 3 + 2] })
  let $Geometry { points, planes: g_planes, rings, indices, heights, source_planes } = geometry
  let (verts_span, points) = pack_span points (&verts[0..verts.length])
  let (centers_span, points) = pack_span points (&kept_centers[0..kept_centers.length])
  let (dirs_span, points) = pack_span points (&dirs[0..dirs.length])
  let (planes_span, g_planes) = pack_span g_planes (&kept_planes[0..kept_planes.length])
  let (rings_span, rings) = pack_span rings (&ring_array[0..ring_array.length])
  let (ring_indices_span, indices) = pack_span indices (&ring_indices[0..ring_indices.length])
  let (ea_span, indices) = pack_span indices (&ea[0..ea.length])
  let (eb_span, indices) = pack_span indices (&eb[0..eb.length])
  return ($Some ($StoredPoly {
    center, verts: verts_span, planes: planes_span, rings: rings_span,
    ring_indices: ring_indices_span, centers: centers_span, ea: ea_span, eb: eb_span, dirs: dirs_span,
  }), $Geometry { points, planes: g_planes, rings, indices, heights, source_planes })

// A polytope built in its own space, placed in the world by position,
// rotation and scale.
private func safe_place_quat (rotation: Quat) : Quat =>
  let q2 = rotation.x * rotation.x + rotation.y * rotation.y + rotation.z * rotation.z + rotation.w * rotation.w
  if is_finite q2 and abs (q2 - 1.0) <= 1.0e-5:
    return rotation
  return Maybe.unwrap_or math.identity_quat (math.normalize_quat rotation)

private func safe_unit_or (x: F32) -> (y: F32) -> (z: F32) -> (fx: F32) -> (fy: F32) -> (fz: F32) : (F32, F32, F32) =>
  let length = sqrt (x * x + y * y + z * z)
  if is_finite length and length > 0.0:
    let nx = x / length
    let ny = y / length
    let nz = z / length
    if is_finite nx and is_finite ny and is_finite nz:
      return (nx, ny, nz)
  let m = max (abs x) (max (abs y) (abs z))
  if is_finite m and m > 0.0:
    let sx = x / m
    let sy = y / m
    let sz = z / m
    let sl = sqrt (sx * sx + sy * sy + sz * sz)
    if is_finite sl and sl > 0.0:
      return (sx / sl, sy / sl, sz / sl)
  return (fx, fy, fz)

func poly_place (geometry: own Geometry) -> (poly: Poly) -> (position: Vec3) -> (rotation: Quat) -> (scale: Vec3) : (StoredPoly, Geometry) =>
  let $Quat { x: qx, y: qy, z: qz, w: qw } = safe_place_quat rotation
  let sx = if is_finite scale.x then scale.x else 0.0
  let sy = if is_finite scale.y then scale.y else 0.0
  let sz = if is_finite scale.z then scale.z else 0.0
  let ox = if is_finite position.x then position.x else 0.0
  let oy = if is_finite position.y then position.y else 0.0
  let oz = if is_finite position.z then position.z else 0.0
  let move = func (v: Point3) =>
    let (x, y, z) = math.rotate_parts qx qy qz qw (v.x * sx) (v.y * sy) (v.z * sz)
    let rx = ox + x
    let ry = oy + y
    let rz = oz + z
    return {
      x: if is_finite rx then rx else ox,
      y: if is_finite ry then ry else oy,
      z: if is_finite rz then rz else oz,
    }
  let verts = @array.generate poly.verts.length (func (i: U32) => move poly.verts[i])
  let ix = if abs sx > 1.0e-12 then 1.0 / sx else 0.0
  let iy = if abs sy > 1.0e-12 then 1.0 / sy else 0.0
  let iz = if abs sz > 1.0e-12 then 1.0 / sz else 0.0
  let planes = @array.generate poly.planes.length (func (i: U32) =>
    let p = poly.planes[i]
    let (x, y, z) = math.rotate_parts qx qy qz qw (p.x * ix) (p.y * iy) (p.z * iz)
    let (nx, ny, nz) = safe_unit_or x y z 0.0 0.0 0.0
    let anchor = verts[ring_vertex poly poly.rings[i] 0]
    let w = nx * anchor.x + ny * anchor.y + nz * anchor.z
    return { x: nx, y: ny, z: nz, w: if is_finite w then w else 0.0 })
  let centers = @array.generate poly.centers.length (func (i: U32) => move poly.centers[i])
  let dirs = @array.generate poly.dirs.length (func (i: U32) =>
    let d = poly.dirs[i]
    let (x, y, z) = math.rotate_parts qx qy qz qw (d.x * sx) (d.y * sy) (d.z * sz)
    let (dx, dy, dz) = safe_unit_or x y z 0.0 0.0 0.0
    return { x: dx, y: dy, z: dz })
  let c = poly.center
  let (cx, cy, cz) = math.rotate_parts qx qy qz qw (c.x * sx) (c.y * sy) (c.z * sz)
  let rcx = ox + cx
  let rcy = oy + cy
  let rcz = oz + cz
  let $Geometry { points, planes: g_planes, rings, indices, heights, source_planes } = geometry
  let (verts_span, points) = pack_span points (&verts[0..verts.length])
  let (centers_span, points) = pack_span points (&centers[0..centers.length])
  let (dirs_span, points) = pack_span points (&dirs[0..dirs.length])
  let (planes_span, g_planes) = pack_span g_planes (&planes[0..planes.length])
  let (rings_span, rings) = pack_span rings poly.rings
  let (ring_indices_span, indices) = pack_span indices poly.ring_indices
  let (ea_span, indices) = pack_span indices poly.ea
  let (eb_span, indices) = pack_span indices poly.eb
  return ($StoredPoly { center: $Vec3 {
      x: if is_finite rcx then rcx else ox,
      y: if is_finite rcy then rcy else oy,
      z: if is_finite rcz then rcz else oz,
    },
    verts: verts_span, planes: planes_span, rings: rings_span, ring_indices: ring_indices_span,
    centers: centers_span, ea: ea_span, eb: eb_span, dirs: dirs_span },
    $Geometry { points, planes: g_planes, rings, indices, heights, source_planes })

// Place a StoredPoly that already resides in `geometry`, copying out its views
// before appending the transformed geometry.
func poly_place_stored (geometry: own Geometry) -> (stored: StoredPoly) -> (position: Vec3) -> (rotation: Quat) -> (scale: Vec3) : (StoredPoly, Geometry) =>
  let $Quat { x: qx, y: qy, z: qz, w: qw } = safe_place_quat rotation
  let sx = if is_finite scale.x then scale.x else 0.0
  let sy = if is_finite scale.y then scale.y else 0.0
  let sz = if is_finite scale.z then scale.z else 0.0
  let ox = if is_finite position.x then position.x else 0.0
  let oy = if is_finite position.y then position.y else 0.0
  let oz = if is_finite position.z then position.z else 0.0
  let move = func (v: Point3) =>
    let (x, y, z) = math.rotate_parts qx qy qz qw (v.x * sx) (v.y * sy) (v.z * sz)
    let rx = ox + x
    let ry = oy + y
    let rz = oz + z
    return {
      x: if is_finite rx then rx else ox,
      y: if is_finite ry then ry else oy,
      z: if is_finite rz then rz else oz,
    }
  let verts: #[Point3] = #[]
  for i in 0 .. stored.verts.count:
    @storage.push verts (move geometry.points[stored.verts.start + i])
  let ix = if abs sx > 1.0e-12 then 1.0 / sx else 0.0
  let iy = if abs sy > 1.0e-12 then 1.0 / sy else 0.0
  let iz = if abs sz > 1.0e-12 then 1.0 / sz else 0.0
  let rings_arr: #[Ring] = #[]
  for i in 0 .. stored.rings.count:
    @storage.push rings_arr geometry.rings[stored.rings.start + i]
  let ring_idx_arr: #[U32] = #[]
  for i in 0 .. stored.ring_indices.count:
    @storage.push ring_idx_arr geometry.indices[stored.ring_indices.start + i]
  let planes: #[Plane4] = #[]
  for i in 0 .. stored.planes.count:
    let p = geometry.planes[stored.planes.start + i]
    let (x, y, z) = math.rotate_parts qx qy qz qw (p.x * ix) (p.y * iy) (p.z * iz)
    let (nx, ny, nz) = safe_unit_or x y z 0.0 0.0 0.0
    let anchor = verts[ring_idx_arr[rings_arr[i].start]]
    let w = nx * anchor.x + ny * anchor.y + nz * anchor.z
    @storage.push planes { x: nx, y: ny, z: nz, w: if is_finite w then w else 0.0 }
  let centers: #[Point3] = #[]
  for i in 0 .. stored.centers.count:
    @storage.push centers (move geometry.points[stored.centers.start + i])
  let dirs: #[Point3] = #[]
  for i in 0 .. stored.dirs.count:
    let d = geometry.points[stored.dirs.start + i]
    let (x, y, z) = math.rotate_parts qx qy qz qw (d.x * sx) (d.y * sy) (d.z * sz)
    let (dx, dy, dz) = safe_unit_or x y z 0.0 0.0 0.0
    @storage.push dirs { x: dx, y: dy, z: dz }
  let ea_arr: #[U32] = #[]
  for i in 0 .. stored.ea.count:
    @storage.push ea_arr geometry.indices[stored.ea.start + i]
  let eb_arr: #[U32] = #[]
  for i in 0 .. stored.eb.count:
    @storage.push eb_arr geometry.indices[stored.eb.start + i]
  let c = stored.center
  let (cx, cy, cz) = math.rotate_parts qx qy qz qw (c.x * sx) (c.y * sy) (c.z * sz)
  let $Geometry { points, planes: g_planes, rings, indices, heights, source_planes } = geometry
  let (verts_span, points) = pack_span points (&verts[0..verts.length])
  let (centers_span, points) = pack_span points (&centers[0..centers.length])
  let (dirs_span, points) = pack_span points (&dirs[0..dirs.length])
  let (planes_span, g_planes) = pack_span g_planes (&planes[0..planes.length])
  let (rings_span, rings) = pack_span rings (&rings_arr[0..rings_arr.length])
  let (ring_indices_span, indices) = pack_span indices (&ring_idx_arr[0..ring_idx_arr.length])
  let (ea_span, indices) = pack_span indices (&ea_arr[0..ea_arr.length])
  let (eb_span, indices) = pack_span indices (&eb_arr[0..eb_arr.length])
  return ($StoredPoly { center: $Vec3 { x: ox + cx, y: oy + cy, z: oz + cz },
    verts: verts_span, planes: planes_span, rings: rings_span, ring_indices: ring_indices_span,
    centers: centers_span, ea: ea_span, eb: eb_span, dirs: dirs_span },
    $Geometry { points, planes: g_planes, rings, indices, heights, source_planes })

// Bounds ----------------------------------------------------------------------

// The smallest axis-aligned box around a shape: (minimum, maximum).
func bounds (shape: Shape) => case shape of
  $Capsule { a, b, radius } => do:
    let r = $Vec3 { x: radius, y: radius, z: radius }
    break (min3 a b - r, max3 a b + r)
  $Hull poly => do:
    if poly.verts.length == 0:
      break (zero, zero)
    let first = poly.verts[0]
    let lx = first.x
    let ly = first.y
    let lz = first.z
    let hx = first.x
    let hy = first.y
    let hz = first.z
    for v in poly.verts:
      lx := min self v.x
      ly := min self v.y
      lz := min self v.z
      hx := max self v.x
      hy := max self v.y
      hz := max self v.z
    break ($Vec3 { x: lx, y: ly, z: lz }, $Vec3 { x: hx, y: hy, z: hz })
  $Heightfield t => do:
    let x0 = t.origin.x - t.half
    let x1 = t.origin.x + t.half
    let z0 = t.origin.z - t.half
    let z1 = t.origin.z + t.half
    let (_, high) = terrain.range t x0 z0 x1 z1
    break ($Vec3 { x: x0, y: F32.neg far, z: z0 }, $Vec3 { x: x1, y: high, z: z1 })
  $Mesh m => mesh.bounds m

// Mass properties --------------------------------------------------------------

// Principal moments of inertia per unit mass for a solid shape about its
// centre, in the shape's own frame (capsules point along Y).
func sphere_inertia (radius: F32) => radius * radius * 0.4
func box_inertia (half: Vec3) => $Vec3 {
  x: (half.y * half.y + half.z * half.z) / 3.0,
  y: (half.x * half.x + half.z * half.z) / 3.0,
  z: (half.x * half.x + half.y * half.y) / 3.0,
}
func capsule_inertia (radius: F32) => func (half_segment: F32) =>
  let r2 = radius * radius
  let h = half_segment + radius
  // Approximate as a cylinder of the full height.
  let axis = r2 * 0.5
  let side = (3.0 * r2 + 4.0 * h * h) / 12.0
  return $Vec3 { x: side, y: axis, z: side }


// A cooked static triangle mesh stored in the geometry pools: vertices and
// triangle planes in `points` / `planes`, triangle records and BVH order in
// `indices`, BVH bounds in `heights`. `vertices` and `indices` are the authored
// world-space soup; see `mesh.cook` for what is rejected or dropped.
func cook_mesh (geometry: own Geometry) -> (vertices: &[Point3]) -> (soup: &[U32]) : (Maybe StoredMesh, Geometry) =>
  let $Geometry { points, planes, rings, indices, heights, source_planes } = geometry
  let (cooked, points, planes, indices, heights) = mesh.cook points planes indices heights vertices soup
  let stored = Maybe.map (func (m: mesh.Stored) => $StoredMesh {
    verts: m.verts, tris: m.tris, planes: m.planes, bounds: m.bounds, order: m.order, base: m.base,
  }) cooked
  return (stored, $Geometry { points, planes, rings, indices, heights, source_planes })


// Plain persistent schemas. Spans carry no owner pointer; every access also
// receives the exact Geometry bundle for this world lineage.
type Span = { start: U32, count: U32 }
type StoredPoly is data = $StoredPoly {
  center: Vec3, verts: Span, planes: Span, rings: Span, ring_indices: Span,
  centers: Span, ea: Span, eb: Span, dirs: Span,
}
type StoredMesh is data = $StoredMesh {
  verts: Span, tris: Span, planes: Span, bounds: Span, order: Span, base: U32,
}
type StoredShape is data = $StoredCapsule { a: Vec3, b: Vec3, radius: F32 }
  | $StoredHull StoredPoly | $StoredHeightfield terrain.Stored | $StoredMeshShape StoredMesh
func pack_span (owner: own #[a]) -> (values: &[a]) : (Span, #[a]) =>
  let start = owner.length
  for value in values:
    @storage.push owner value
  return ({ start, count: values.length }, owner)
func span_view owner -> (span: Span) => owner.view span.start (span.start + span.count)
func pack_mesh (geometry: own Geometry) -> (m: mesh.Mesh) : (StoredMesh, Geometry) =>
  let $Geometry { points, planes, rings, indices, heights, source_planes } = geometry
  let (verts, points) = pack_span points m.verts
  let (tris, indices) = pack_span indices m.tris
  let (plane_span, planes) = pack_span planes m.planes
  let (bounds, heights) = pack_span heights m.index.bounds
  let (order, indices) = pack_span indices m.index.order
  return ($StoredMesh {
    verts, tris, planes: plane_span, bounds, order, base: m.index.base,
  }, $Geometry { points, planes, rings, indices, heights, source_planes })
func unpack_poly geometry -> (p: StoredPoly) : Poly => $Poly {
  center: p.center, verts: span_view geometry.points p.verts,
  planes: span_view geometry.planes p.planes, rings: span_view geometry.rings p.rings,
  ring_indices: span_view geometry.indices p.ring_indices, centers: span_view geometry.points p.centers,
  ea: span_view geometry.indices p.ea, eb: span_view geometry.indices p.eb,
  dirs: span_view geometry.points p.dirs,
}
func unpack_mesh geometry -> (value: StoredMesh) : mesh.Mesh => $mesh.Mesh {
  verts: span_view geometry.points value.verts, tris: span_view geometry.indices value.tris,
  planes: span_view geometry.planes value.planes,
  index: $spatial.Read { base: value.base, bounds: span_view geometry.heights value.bounds,
    order: span_view geometry.indices value.order },
}
func pack (geometry: own Geometry) -> (value: Shape) : (StoredShape, Geometry) =>
  if let $Capsule { a, b, radius } = value:
    return ($StoredCapsule { a, b, radius }, geometry)
  if let $Hull p = value:
    let $Geometry { points, planes, rings, indices, heights, source_planes } = geometry
    let (verts, points) = pack_span points p.verts
    let (centers, points) = pack_span points p.centers
    let (dirs, points) = pack_span points p.dirs
    let (plane_span, planes) = pack_span planes p.planes
    let (ring_span, rings) = pack_span rings p.rings
    let (ring_indices, indices) = pack_span indices p.ring_indices
    let (ea, indices) = pack_span indices p.ea
    let (eb, indices) = pack_span indices p.eb
    return ($StoredHull ($StoredPoly {
      center: p.center, verts, planes: plane_span, rings: ring_span,
      ring_indices, centers, ea, eb, dirs,
    }), $Geometry { points, planes, rings, indices, heights, source_planes })
  if let $Heightfield ground = value:
    let $Geometry { points, planes, rings, indices, heights, source_planes } = geometry
    let (stored, heights) = terrain.pack heights ground
    return ($StoredHeightfield stored, $Geometry { points, planes, rings, indices, heights, source_planes })
  let $Mesh m = value else:
    return panic "unreachable shape"
  let (stored, geometry) = pack_mesh geometry m
  return ($StoredMeshShape stored, geometry)
func unpack geometry -> (value: StoredShape) : Shape => case value of
  $StoredCapsule { a, b, radius } => $Capsule { a, b, radius }
  $StoredHull p => $Hull (unpack_poly geometry p)
  $StoredHeightfield ground => $Heightfield (terrain.unpack geometry.heights ground)
  $StoredMeshShape m => $Mesh (unpack_mesh geometry m)


// Reuse fixed spans for ordinary pose/shape edits. A changed payload length
// allocates a new extent; old extents are reclaimed at an explicit world reset.
func replace_span (owner: own #[a]) -> (before: Span) -> (values: &[a]) : (Span, #[a]) =>
  if before.count != values.length:
    return pack_span owner values
  for i in 0 .. before.count:
    owner[before.start + i] := values[i]
  return (before, owner)
func replace (geometry: own Geometry) -> (before: StoredShape) -> (value: Shape) : (StoredShape, Geometry) =>
  if let $StoredMeshShape old = before:
    if let $Mesh m = value:
      if old.verts.count == m.verts.length and old.tris.count == m.tris.length and old.bounds.count == m.index.bounds.length and old.order.count == m.index.order.length:
        let $Geometry {points, planes, rings, indices, heights, source_planes} = geometry
        let (verts, points) = replace_span points old.verts m.verts
        let (tris, indices) = replace_span indices old.tris m.tris
        let (order, indices) = replace_span indices old.order m.index.order
        let (plane_span, planes) = replace_span planes old.planes m.planes
        let (bounds, heights) = replace_span heights old.bounds m.index.bounds
        let shape = $StoredMeshShape ($StoredMesh {verts, tris, planes: plane_span, bounds, order, base: m.index.base})
        return (shape, $Geometry {points, planes, rings, indices, heights, source_planes})
  let $StoredHull old = before else:
    return pack geometry value
  let $Hull p = value else:
    return pack geometry value
  let $Geometry {points, planes, rings, indices, heights, source_planes} = geometry
  let (verts, points) = replace_span points old.verts p.verts
  let (centers, points) = replace_span points old.centers p.centers
  let (dirs, points) = replace_span points old.dirs p.dirs
  let (plane_span, planes) = replace_span planes old.planes p.planes
  let (ring_span, rings) = replace_span rings old.rings p.rings
  let (ring_indices, indices) = replace_span indices old.ring_indices p.ring_indices
  let (ea, indices) = replace_span indices old.ea p.ea
  let (eb, indices) = replace_span indices old.eb p.eb
  let shape = $StoredHull ($StoredPoly {center: p.center, verts, planes: plane_span, rings: ring_span, ring_indices, centers, ea, eb, dirs})
  return (shape, $Geometry {points, planes, rings, indices, heights, source_planes})
