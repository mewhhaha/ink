//! Separate named owners for job rows, metadata and bounded trace history.
//! Cross-frame work is data; continuation is ordinary application-local data.
//!
//! Key items: [`Ticket`], [`Outcome`], [`State`], [`Job`], [`empty`].

import * as array from "std/array"

type Ticket is data = $Ticket { epoch: U32, sequence: U32 }
type Outcome value is data = $Value value | $Failed U32 | $Cancelled U32
type State value is data = $Pending | $Ready { tick: U32, outcome: Outcome value }
type Job [request, value, local] is data = $Job {
  ticket: Ticket, submitted: U32, earliest: U32,
  request: request, continuation: local, state: State value,
}
// Element payloads are fixed-layout rows; variable data uses caller-owned
// pools plus spans/borrowed views/links, never owning array fields.
type Queue [request, value, local] = #[Job [request, value, local]]
// epoch, next ticket, capacity, open, tick, tracing enabled
type Metadata = #[U32]
type Event is data = $Submitted | $Completed | $Published | $Rejected | $Stopped | $Reissued
type Mark is data = $Mark { ticket: Ticket, tick: U32, event: Event }
type Delivery [value, local] is data = $Delivery { ticket: Ticket, continuation: local, outcome: Outcome value }
const history_limit: U32 = 256
func empty () : Queue [request, value, local] => #[]
func metadata epoch -> capacity -> trace : Metadata =>
  if epoch == 0 or capacity > 4096:
    return panic "invalid task queue lifetime or capacity"
  return #[epoch, 1, capacity, 1, 0, if trace then 1 else 0]
func same (a: Ticket) -> (b: Ticket) => a.epoch == b.epoch and a.sequence == b.sequence
func mark ticket -> tick -> event -> (history: own #[Mark]) -> (meta: Metadata) : #[Mark] =>
  if meta[5] != 0:
    if history.length == history_limit:
      for i in 1 .. history.length:
        history[i - 1] := history[i]
      @storage.truncate history (history.length - 1)
    @storage.push history ($Mark {ticket, tick, event})
  return history
func submit_many tick -> earliest -> (requests: #[request]) -> (locals: #[local]) -> (queue: own Queue [request, value, local]) -> (meta: own Metadata) -> (history: own #[Mark]) : (Maybe (#[Ticket]), Queue [request, value, local], Metadata, #[Mark]) =>
  let count = requests.length
  if count != locals.length:
    return ($Nothing, queue, meta, history)
  if count == 0:
    return ($Some #[], queue, meta, history)
  if meta[3] == 0 or meta[1] == 0 or queue.length >= meta[2] or count > meta[2] - queue.length or tick < meta[4] or earliest < tick or count - 1 > 0xFFFFFFFF - meta[1]:
    return ($Nothing, queue, meta, history)
  let tickets: #[Ticket] = array.generate count (func i => $Ticket {epoch: meta[0], sequence: meta[1] + i})
  for i in 0 .. count:
    let job: Job [request, value, local] = $Job {ticket: tickets[i], submitted: tick, earliest, request: requests[i], continuation: locals[i], state: $Pending}
    @storage.push queue job
    history := mark tickets[i] tick $Submitted history meta
  let last = meta[1] + count - 1
  meta[1] := if last == 0xFFFFFFFF then 0 else last + 1
  meta[4] := tick
  return ($Some tickets, queue, meta, history)
func submit tick -> earliest -> request -> continuation -> (queue: own Queue [request, value, local]) -> (meta: own Metadata) -> (history: own #[Mark]) : (Maybe Ticket, Queue [request, value, local], Metadata, #[Mark]) =>
  if meta[3] == 0 or meta[1] == 0 or queue.length >= meta[2] or tick < meta[4] or earliest < tick:
    return ($Nothing, queue, meta, history)
  let seq = meta[1]
  let ticket = $Ticket { epoch: meta[0], sequence: seq }
  @storage.push queue ($Job { ticket, submitted: tick, earliest, request, continuation, state: $Pending })
  history := mark ticket tick $Submitted history meta
  meta[1] := if seq == 0xFFFFFFFF then 0 else seq + 1
  meta[4] := tick
  return ($Some ticket, queue, meta, history)
func locate (ticket: Ticket) -> (queue: Queue [request, value, local]) -> (meta: Metadata) : Maybe U32 =>
  if ticket.epoch != meta[0]:
    return $Nothing
  let low = 0
  let high = queue.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if queue[middle].ticket.sequence < ticket.sequence:
      low := middle + 1
    else:
      high := middle
  if low < queue.length and same ticket queue[low].ticket:
    return $Some low
  return $Nothing
func settle tick -> ticket -> outcome -> (queue: own Queue [request, value, local]) -> (own meta) -> (own history) =>
  if meta[3] != 0 and tick >= meta[4]:
    if let $Some index = locate ticket queue meta:
      if tick >= queue[index].submitted:
        if let $Pending = queue[index].state:
          queue[index].state := $Ready {tick, outcome}
          meta[4] := tick
          history := mark ticket tick $Completed history meta
          return (true, queue, meta, history)
  history := mark ticket tick $Rejected history meta
  return (false, queue, meta, history)
func publish tick -> (queue: own Queue [request, value, local]) -> (own meta) -> (own history) : (#[Delivery [value, local]], Queue [request, value, local], Metadata, #[Mark]) =>
  if tick < meta[4]:
    return panic "task delivery tick moved backwards"
  let count = 0
  for job in queue:
    let $Ready {tick: ready} = job.state else:
      break
    if tick < ready or tick < job.earliest:
      break
    count := self + 1
  let delivered: #[Delivery [value, local]] = #[]
  for i in 0 .. count:
    let $Ready {outcome} = queue[i].state else:
      return panic "ready prefix invariant"
    @storage.push delivered ($Delivery {ticket: queue[i].ticket, continuation: queue[i].continuation, outcome})
  for i in 0 .. count:
    history := mark queue[i].ticket tick $Published history meta
  for i in count .. queue.length:
    queue[i - count] := $Job {ticket: queue[i].ticket, submitted: queue[i].submitted, earliest: queue[i].earliest, request: queue[i].request, continuation: queue[i].continuation, state: queue[i].state}
  @storage.truncate queue (queue.length - count)
  meta[4] := tick
  return (delivered, queue, meta, history)
func cancel tick -> ticket -> reason -> (queue: own Queue [request, value, local]) -> (own meta) -> (own history) =>
  if tick < meta[4]:
    return (false, queue, meta, history)
  if let $Some index = locate ticket queue meta:
    if tick >= queue[index].submitted:
      if let $Ready {outcome: $Cancelled _} = queue[index].state:
        return (false, queue, meta, history)
      queue[index].state := $Ready {tick, outcome: $Cancelled reason}
      queue[index].earliest := min self tick
      meta[4] := tick
      history := mark ticket tick $Stopped history meta
      return (true, queue, meta, history)
  return (false, queue, meta, history)
func close tick -> reason -> (queue: own Queue [request, value, local]) -> (own meta) -> (own history) =>
  if meta[3] == 0:
    return (queue, meta, history)
  if tick < meta[4]:
    return panic "task close tick moved backwards"
  for i in 0 .. queue.length:
    let (unused, cancelled, cancelled_meta, cancelled_history) = cancel tick queue[i].ticket reason queue meta history
    queue := cancelled
    meta := cancelled_meta
    history := cancelled_history
  meta[3] := 0
  meta[4] := tick
  return (queue, meta, history)
func reissue epoch -> (queue: own Queue [request, value, local]) -> (meta: own Metadata) -> (history: own #[Mark]) =>
  if epoch == 0 or epoch == meta[0]:
    return panic "task restore requires a fresh epoch"
  meta[0] := epoch
  @storage.truncate history 0
  for i in 0 .. queue.length:
    queue[i].ticket.epoch := epoch
    if let $Pending = queue[i].state:
      history := mark queue[i].ticket meta[4] $Reissued history meta
  return (queue, meta, history)
func is_pending state => case state of
  $Pending => true
  _ => false
func pending (queue: Queue [request, value, local]) : #[Job [request, value, local]] => return #[job | job <- queue, is_pending job.state]

// Exact U32 framing. Callers validate the request/result/continuation domain
// in their decoders. Trace history is transient; accepted results are saved.
func append_words (words: #[U32]) -> (destination: own #[U32]) : #[U32] =>
  for word in words:
    @storage.push destination word
  return destination
func encode encode_request -> encode_value -> encode_local -> (q: Queue [request, value, local]) -> (meta: Metadata) =>
  let out: #[U32] = #[]
  @storage.push out 1
  @storage.push out meta[0]
  @storage.push out meta[1]
  @storage.push out meta[2]
  @storage.push out meta[3]
  @storage.push out meta[4]
  @storage.push out q.length
  for job in q:
    let request = encode_request job.request
    let local = encode_local job.continuation
    @storage.push out job.ticket.sequence
    @storage.push out job.submitted
    @storage.push out job.earliest
    case job.state of
      $Pending => do:
        @storage.push out 0
        @storage.push out 0
        @storage.push out request.length
        @storage.push out local.length
        @storage.push out 0
        for word in request:
          @storage.push out word
        for word in local:
          @storage.push out word
        break ()
      $Ready {tick: ready_tick, outcome} => case outcome of
        $Value v => do:
          let value = encode_value v
          @storage.push out 1
          @storage.push out ready_tick
          @storage.push out request.length
          @storage.push out local.length
          @storage.push out value.length
          for word in request:
            @storage.push out word
          for word in local:
            @storage.push out word
          for word in value:
            @storage.push out word
          break ()
        $Failed reason => do:
          @storage.push out 2
          @storage.push out ready_tick
          @storage.push out request.length
          @storage.push out local.length
          @storage.push out 1
          for word in request:
            @storage.push out word
          for word in local:
            @storage.push out word
          @storage.push out reason
          break ()
        $Cancelled reason => do:
          @storage.push out 3
          @storage.push out ready_tick
          @storage.push out request.length
          @storage.push out local.length
          @storage.push out 1
          for word in request:
            @storage.push out word
          for word in local:
            @storage.push out word
          @storage.push out reason
          break ()
  return out
func decode (maximum: U32) -> (trace: Bool) -> (decode_request: #[U32] -> Maybe request) -> (decode_value: #[U32] -> Maybe value) -> (decode_local: #[U32] -> Maybe local) -> (words: #[U32]) -> (queue: own Queue [request, value, local]) -> (meta: own Metadata) -> (history: own #[Mark]) : (Bool, Queue [request, value, local], Metadata, #[Mark]) =>
  if words.length < 7 or words[0] != 1 or words[1] == 0 or words[3] > min 4096 maximum or words[4] > 1 or words[6] > words[3]:
    return (false, queue, meta, history)
  let out: #[Maybe (Job [request, value, local])] = array.fill words[6] $Nothing
  let offset = 7
  let previous = 0
  for index in 0 .. words[6]:
    if words.length - offset < 8:
      return (false, queue, meta, history)
    let sequence = words[offset]
    let submitted = words[offset + 1]
    let earliest = words[offset + 2]
    let tag = words[offset + 3]
    let ready = words[offset + 4]
    let requests = words[offset + 5]
    let locals = words[offset + 6]
    let values = words[offset + 7]
    if sequence <= previous or (words[2] != 0 and sequence >= words[2]) or submitted > words[5] or earliest < submitted or tag > 3:
      return (false, queue, meta, history)
    offset := self + 8
    if requests > words.length - offset:
      return (false, queue, meta, history)
    let $Some request = decode_request (array.slice offset requests words) else:
      return (false, queue, meta, history)
    offset := self + requests
    if locals > words.length - offset:
      return (false, queue, meta, history)
    let $Some local = decode_local (array.slice offset locals words) else:
      return (false, queue, meta, history)
    offset := self + locals
    if values > words.length - offset:
      return (false, queue, meta, history)
    let val_offset = offset
    offset := self + values
    let state: State value = $Pending
    if tag == 0:
      if values != 0 or ready != 0 or not (words[4] == 1):
        return (false, queue, meta, history)
    else:
      if ready < submitted or ready > words[5] or (not (words[4] == 1) and tag != 3):
        return (false, queue, meta, history)
      let outcome: Outcome value = $Failed 0
      if tag == 1:
        let $Some value = decode_value (array.slice val_offset values words) else:
          return (false, queue, meta, history)
        outcome := $Value value
      else:
        if values != 1:
          return (false, queue, meta, history)
        outcome := if tag == 2 then $Failed words[val_offset] else $Cancelled words[val_offset]
      state := $Ready { tick: ready, outcome }
    out[index] := $Some ($Job { ticket: $Ticket { epoch: words[1], sequence }, submitted, earliest, request, continuation: local, state })
    previous := sequence
  if offset != words.length:
    return (false, queue, meta, history)
  @storage.truncate queue 0
  @storage.truncate history 0
  for item in out:
    let $Some job = item else:
      return panic "decoder count invariant"
    @storage.push queue job
  for i in 0 .. 5:
    meta[i] := words[i + 1]
  meta[5] := if trace then 1 else 0
  return (true, queue, meta, history)
