import { Vec3 } from "std/vector"
import * as math from "./math"
import * as shapes from "./shapes"
import * as scene from "./scene"
import { Filter, Hit, Scene, Walker } from "./scene"

// A kinematic character controller: an upright capsule that walks on slopes
// up to a maximum angle, steps up small ledges, snaps to the ground going
// down, is carried by the platform it stands on and slides along walls.
//
// The game decides how the character wants to move (`walker.velocity`,
// gravity and jumps included); `move` sweeps the capsule through the scene and
// returns where it ended up, the velocity that remains after collisions and
// whether it stands on something.

// The capsule, relative to the character's origin: segment ends and radius.
type Body is data = $Body { low: Vec3, high: Vec3, radius: F32 }

type Moved is data = $Moved {
  position: Vec3,
  walker: Walker,
  hits: #[Hit],
}

// Gap kept between the capsule and what it touches.
const skin = 0.002
const probe = 0.03

func flat (v: Vec3) => $Vec3 { x: v.x, y: 0.0, z: v.z }
const down = $Vec3 { x: 0.0, y: (-1.0), z: 0.0 }

// Remove the part of v that points into the plane with normal n.
func clip (v: Vec3) => func (n: Vec3) =>
  let into = v.dot n
  return if into < 0.0 then v - n * into else v

type Slid is data = $Slid { position: Vec3, velocity: Vec3, hits: #[Hit] }

// Move the capsule by `delta`, sliding along whatever it hits. `velocity` is
// clipped against the same surfaces.
func slide (hits: own #[Hit]) -> (sc: scene.Queries) => func (body: Body) => func (filter: Filter) => func (floor_cos: F32) => func (walls: Bool) => func (start: Vec3) => func (delta: Vec3) => func (velocity: Vec3) : Slid =>
  let p = start
  let remaining = delta
  let v = velocity
  let normals: #[Vec3] = #[]
  for 0..6:
    let length = remaining.length
    if length > 0.00001:
      let found = scene.query_cast sc (p + body.low) (p + body.high) body.radius remaining filter
      let $Some h = found else:
        p := self + remaining
        remaining := math.zero3
        break
      @storage.push hits h
      if h.depth > 0.0:
        // Already overlapping: push out, keep going.
        p := self + h.normal * (h.depth + skin)
        v := clip v h.normal
      else:
        let travel = max 0.0 (h.time - skin / length)
        p := self + remaining * travel
        let rest = remaining * (1.0 - h.time)
        // With `walls`, surfaces too steep to stand on act as vertical walls,
        // so pushing against them never climbs them.
        let flatter = flat h.normal
        let n = if walls and h.surface.y < floor_cos and h.normal.y > (-0.7) and flatter.length_squared > 0.0001 then flatter.normalized else h.normal
        remaining := clip rest n
        v := clip v n
        // A crease: do not slide back into a surface we already touched.
        for before in normals:
          if remaining.dot before < 0.0:
            let along = before.cross n
            if along.length_squared > 0.000001:
              let axis = along.normalized
              remaining := axis * remaining.dot axis
              v := axis * v.dot axis
            else:
              remaining := math.zero3
        @storage.push normals n
  return $Slid { position: p, velocity: v, hits }

// Push the capsule out of anything it overlaps.
func depenetrate (sc: scene.Queries) => func (body: Body) => func (filter: Filter) => func (start: Vec3) =>
  let p = start
  for 0..4:
    let found = scene.query_cast sc (p + body.low) (p + body.high) body.radius math.zero3 filter
    let $Some h = found else:
      break
    p := self + h.normal * (h.depth + skin * 0.5)
  return p

// Is there ground within `distance` below? (hit, how far)
func find_ground (sc: scene.Queries) => func (body: Body) => func (filter: Filter) => func (p: Vec3) => func (distance: F32) => func (floor_cos: F32) =>
  let found = scene.query_cast sc (p + body.low) (p + body.high) body.radius (down * distance) filter
  let $Some h = found else:
    return $Nothing
  if h.surface.y >= floor_cos:
    return $Some h
  return $Nothing

// Move a character for one step.
//   position   where the character's origin is
//   walker     its tuning and state; `velocity` is what the game wants
//   carry      how far the platform it stands on moved this step
func move_queries (hits: own #[Hit]) -> (sc: scene.Queries) -> (body: Body) -> (filter: Filter) -> (position: Vec3) -> (walker: Walker) -> (carry: Vec3) -> (dt: F32) : Moved =>
  let floor_cos = cos (walker.max_slope * pi / 180.0)
  let v = walker.velocity
  let was_grounded = walker.grounded
  let p = depenetrate sc body filter position
  // Ride the platform underfoot.
  if was_grounded and carry.length_squared > 0.0:
    let carried_hits: #[Hit] = #[]
    let carried = slide carried_hits sc body filter floor_cos false p carry math.zero3
    p := carried.position
    for h in carried.hits:
      @storage.push hits h
  // Horizontal movement, stepping up small ledges.
  let wish = $Vec3 { x: v.x * dt, y: 0.0, z: v.z * dt }
  let across = flat v
  let first_hits: #[Hit] = #[]
  let over_hits: #[Hit] = #[]
  let first = slide first_hits sc body filter floor_cos true p wish across
  let moved = (flat (first.position - p)).length
  let wanted = wish.length
  let after = first
  if was_grounded and wanted > 0.00001 and moved < wanted * 0.95 and walker.step_height > 0.0:
    // Try the same move from a step higher.
    let lift = scene.query_cast sc (p + body.low) (p + body.high) body.radius (math.vec3 0.0 walker.step_height 0.0) filter
    let raise = case lift of
      $Some h => max 0.0 (walker.step_height * h.time - skin)
      $Nothing => walker.step_height
    let high = p + math.vec3 0.0 raise 0.0
    let over = slide over_hits sc body filter floor_cos true high wish across
    let moved2 = (flat (over.position - high)).length
    if moved2 > moved + 0.001:
      let land = find_ground sc body filter over.position (raise + probe) floor_cos
      if let $Some g = land:
        let drop = max 0.0 (g.time * (raise + probe) - skin)
        let landed = over.position - math.vec3 0.0 drop 0.0
        if landed.y - p.y <= walker.step_height + 0.001:
          let $Slid { velocity: over_vel, hits: over_h } = over
          after := $Slid { position: landed, velocity: over_vel, hits: over_h }
  p := after.position
  v.x := after.velocity.x
  v.z := after.velocity.z
  for h in after.hits:
    @storage.push hits h
  // Vertical movement.
  let dy = v.y * dt
  let grounded = false
  let ground = 0
  let ground_normal = math.vec3 0.0 1.0 0.0
  if dy > 0.0:
    let up_hits: #[Hit] = #[]
    let up = slide up_hits sc body filter floor_cos false p (math.vec3 0.0 dy 0.0) (math.vec3 0.0 v.y 0.0)
    p := up.position
    v.y := up.velocity.y
    for h in up.hits:
      @storage.push hits h
  else:
    // Going down: also look a little further so we stay on slopes and steps.
    let reach = F32.neg dy + (if was_grounded then walker.snap_distance else probe)
    let found = scene.query_cast sc (p + body.low) (p + body.high) body.radius (down * reach) filter
    if let $Some h = found:
      @storage.push hits h
      if h.surface.y >= floor_cos:
        let drop = max 0.0 (h.time * reach - skin)
        p := self - math.vec3 0.0 drop 0.0
        v.y := 0.0
        grounded := true
        ground := h.id
        ground_normal := h.surface
      else:
        // Too steep to stand on: slide down it.
        let slid_hits: #[Hit] = #[]
        let slid = slide slid_hits sc body filter floor_cos false p (math.vec3 0.0 dy 0.0) (math.vec3 0.0 v.y 0.0)
        p := slid.position
        v := slid.velocity + flat v
    else:
      p := self + math.vec3 0.0 dy 0.0
  walker.velocity := v
  walker.grounded := grounded
  walker.ground := ground
  walker.ground_normal := ground_normal
  return $Moved { position: p, walker, hits }

func move (hits: own #[Hit]) -> (sc: Scene) -> (body: Body) -> (filter: Filter) -> (position: Vec3) -> (walker: Walker) -> (carry: Vec3) -> (dt: F32) : Moved =>
  return move_queries hits (scene.queries sc) body filter position walker carry dt
