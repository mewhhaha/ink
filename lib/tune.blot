import * as array from "std/array"
import * as app from "./app"
import * as ecs from "./ecs"
import * as lanes from "./lanes"
import * as sort from "./sort"
import * as window from "./events"

// Live-tunable constants: numbers a designer changes while the game runs,
// without a build. A game declares each, with its default and range, in a
// file it imports (asset_parsers.ts reads a `tunables.json` into a `Tunable`
// each) and reads it with `value`. The host sets one with a Tune event, its
// `index` the tunable's id, and the game holds what the host set as game
// state: `Tuned` is saved like any resource, so it survives reloads,
// quicksaves and loads, and Tune events are ordinary input, which recordings
// and replays keep. A tunable the host never set reads its declared default,
// so a new default reaches a game that never tuned it, and one it set keeps
// its value, also when that value becomes the default (a bake): the game
// never jumps.

// A tunable as declared: its id, which Tune events name it by, its default,
// and the least and most it may be.
type Setting is data = #Setting { id: U32, value: F32 }
type Tuned is data = #Tuned (Array Setting)

const untuned = #Tuned #[]

// What the host set the tunable `id` to, else `fallback`.
const find = fn (id: U32) => fn (fallback: F32) => fn (settings: Array Setting) => do:
  let found = fallback
  for setting in settings:
    if setting.id == id:
      found := setting.value
  return found

const with_setting = fn (id: U32) => fn (value: F32) => fn (settings: Array Setting) => do:
  if array.any (fn (setting: Setting) => setting.id == id) settings:
    return array.map (fn (setting: Setting) => do:
      if setting.id == id:
        return #Setting { id, value }
      return setting) settings
  return array.push #Setting { id, value } settings

// `tunable`'s value: as the host set it, else its default, held within its
// range.
const value = fn (tunable: (U32, F32, F32, F32)) => do:
  let (id, initial, low, high) = tunable
  use tuned <- ecs.get #Tuned
  return read tuned tunable

const receive = fn (event: window.Event) => do:
  let #window.Tune { index, value } = event else:
    return ()
  if Bool.not (is_finite value):
    return ()
  use tuned <- ecs.get #Tuned
  let #Tuned settings = tuned
  return ecs.set (#Tuned (with_setting index value settings))

// Pure lookup for callers that keep tunables outside an ECS resource.
const read = fn (tuned: Tuned) => fn (tunable: (U32, F32, F32, F32)) => do:
  let (id, initial, low, high) = tunable
  let #Tuned settings = tuned
  let found = find id initial settings
  if Bool.not (is_finite found && is_finite low && is_finite high) || high < low:
    return initial
  return clamp low high found

// Lanes: `id, value` for each tunable the host set, ids distinct.
const encode = fn (tuned: Tuned) => do:
  let #Tuned settings = tuned
  return #[lane | setting <- settings, lane <- #[from setting.id, setting.value]]

const decode = fn (values: Array F32) => do:
  use lanes.finite values
  let count = values.length / 2
  use lanes.exact values (count * 2)
  let ids = array.generate count (fn index => lanes.integer values[index * 2] lanes.max_integer)
  // Ids in ascending order: equal ones are adjacent.
  let ordered = sort.order_u32 ids
  for index in 1 .. count:
    use lanes.require (ids[ordered[index - 1]] != ids[ordered[index]])
  return #Tuned (array.generate count (fn index => #Setting { id: ids[index], value: values[index * 2 + 1] }))

const codec = #lanes.Codec { key: 11, version: 1, encode, decode, migrate: lanes.no_migration }

// Holds what the host tunes, also while the game is paused.
const plugin = fn builder => do:
  builder := app.insert_resource codec untuned self
  builder := app.add_system #app.Interface (fn (context: app.EventContext) => receive context.event) self
  return builder
