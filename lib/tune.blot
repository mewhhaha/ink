import * as lanes from "./lanes"
import * as window from "./events"

type Setting is data = $Setting {id: U32, value: F32}
type Tuned = ResizeArray Setting
func empty () : Tuned => return #[]
func find id -> fallback -> (settings: Tuned) => return do:
  for setting in settings:
    if setting.id == id:
      return setting.value
  return fallback
func with_setting id -> value -> (settings: Tuned) => return do:
  for i in 0 .. settings.length:
    if settings[i].id == id:
      settings[i].value = value
      return ()
  @storage.push settings ($Setting {id, value})
func read (settings: Tuned) -> (tunable: (U32, F32, F32, F32)) => return do:
  let (id, initial, low, high) = tunable
  let found = find id initial settings
  if Bool.not (is_finite found and is_finite low and is_finite high) or high < low:
    return initial
  return clamp low high found
const value = read
func receive (settings: Tuned) -> (event: window.Event) => return do:
  if let $window.Tune {index, value} = event:
    if is_finite value:
      with_setting index value settings
func encode (settings: Tuned) : Array F32 => return do:
  let values: GrowArray F32 = #[]
  for setting in settings:
    @storage.push values (U32.to_f32 setting.id)
    @storage.push values setting.value
  return @storage.freeze values
func decode (values: Array F32) -> (settings: Tuned) => return do:
  lanes.finite values
  lanes.require (values.length % 2 == 0)
  // Validate uniqueness before mutating the named destination.
  for i in 0 .. values.length / 2:
    let id = lanes.integer values[i * 2] lanes.max_integer
    for j in 0 .. i:
      lanes.require (id != lanes.integer values[j * 2] lanes.max_integer)
  @storage.truncate settings 0
  for i in 0 .. values.length / 2:
    @storage.push settings ($Setting {id: lanes.integer values[i * 2] lanes.max_integer, value: values[i * 2 + 1]})
// Saved lanes and version remain unchanged; static schemas call encode/decode.
const codec = {key: 11, version: 1}
