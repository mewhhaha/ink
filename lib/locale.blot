import * as array from "std/array"

// Host-independent localized text cache. Callers own keys, request issuance,
// retry/language-change policy, plural arguments and persistence.
type Text is data = #Text { drawn: Array U32, spoken: Array U32 }
type Cache is data = #Cache { requests: Array U32, drawn: Array (Array U32), spoken: Array (Array U32), rtl: Bool }
const empty = #Cache { requests: #[], drawn: #[], spoken: #[], rtl: #False }
const grow = fn (count: U32) (cache: Cache) => do:
  if count <= cache.requests.length:
    return cache
  let extra = count - cache.requests.length
  let blank: Array U32 = #[]
  return #Cache { requests: array.concat cache.requests (array.fill extra 0),
    drawn: array.concat cache.drawn (array.fill extra blank),
    spoken: array.concat cache.spoken (array.fill extra blank), rtl: cache.rtl }
const begin = fn (index: U32) (request: U32) (cache: Cache) => do:
  if request == 0 || index >= cache.requests.length:
    return @panic "locale request needs a declared slot and nonzero ID"
  cache.requests[index] := request
  return cache
// A delayed reply cannot replace a newer request. None completes a failed
// request while retaining any previous text. Empty successful text falls back.
const resolve = fn (index: U32) (request: U32) (answer: Maybe Text) (rtl: Bool) (cache: Cache) => do:
  if index >= cache.requests.length || request == 0 || cache.requests[index] != request:
    return cache
  cache.requests[index] := 0
  if let #Some words = answer:
    cache.drawn[index] := words.drawn
    cache.spoken[index] := words.spoken
    cache.rtl := rtl
  return cache
// Column helpers let callers retain an existing saved representation without
// constructing a cache wrapper for every text lookup.
const word_from = fn (drawn: Array (Array U32)) (index: U32) (fallback: Array U32) => do:
  if index < drawn.length && drawn[index].length > 0:
    return drawn[index]
  return fallback
const spoken_from = fn (drawn: Array (Array U32)) (spoken: Array (Array U32)) (index: U32) (fallback: Array U32) => do:
  if index < spoken.length && spoken[index].length > 0:
    return spoken[index]
  return word_from drawn index fallback
const word = fn (cache: Cache) (index: U32) (fallback: Array U32) => word_from cache.drawn index fallback
const spoken = fn (cache: Cache) (index: U32) (fallback: Array U32) => spoken_from cache.drawn cache.spoken index fallback
