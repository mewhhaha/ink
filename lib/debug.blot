import { Vec3 } from "std/vector"
import * as math from "./math"
import * as spatial from "./spatial"
import * as shapes from "./shapes"
import * as terrain from "./terrain"
import * as contact from "./contact"
import * as transform from "./transform"

type Line is data = $Line { a: Vec3, b: Vec3, color: math.Color }
func line (a: Vec3) => return func (b: Vec3) => return func (color: math.Color) => return $Line { a, b, color }
func ray (value: math.Ray) => return func (length: F32) => return func (color: math.Color) => return #[line value.origin (math.Ray.at value length) color]
// Lines fill exactly sized arrays, newest first as each list was once
// prepended: boxed lines appended to a List one at a time are quadratic.
func path (points: Array Vec3) => return func (closed: Bool) => return func (color: math.Color) => return do:
  if points.length < 2:
    let none: Array Line = #[]
    return none
  let n = points.length
  let close = if closed then 1 else 0
  return @array.generate (n - 1 + close) (func (k: U32) => return do:
    if k < close:
      return line points[n - 1] points[0] color
    let s = n - 2 - (k - close)
    return line points[s] points[s + 1] color)
// Edges from corner `from_corner` to `to_corner`, newest first.
const box_from = #[6, 5, 4, 4, 3, 2, 2, 1, 1, 0, 0, 0]
const box_to = #[7, 7, 6, 5, 7, 6, 3, 5, 3, 4, 2, 1]
func bounds (b: spatial.Bounds) => return func (color: math.Color) => return do:
  let corners = @array.generate 8 (func (i: U32) => return do:
    let x = b.low.x
    let y = b.low.y
    let z = b.low.z
    if (i & 1) != 0:
      x := b.high.x
    if (i & 2) != 0:
      y := b.high.y
    if (i & 4) != 0:
      z := b.high.z
    return math.vec3 x y z)
  return @array.generate 12 (func (k: U32) => return line corners[box_from[k]] corners[box_to[k]] color)
func circle (center: Vec3) => return func (x: Vec3) => return func (y: Vec3) => return func (radius: F32) => return func (segments: U32) => return func (color: math.Color) => return do:
  if segments < 3:
    let none: Array Line = #[]
    return none
  return @array.generate segments (func (k: U32) => return do:
    let i = segments - 1 - k
    let (s0, c0) = sin_cos (U32.to_f32 i * 6.2831853 / U32.to_f32 segments)
    let (s1, c1) = sin_cos (U32.to_f32 (i + 1) * 6.2831853 / U32.to_f32 segments)
    // center + (x * c + y * s) * radius, on scalars.
    let a = math.vec3 (center.x + (x.x * c0 + y.x * s0) * radius) (center.y + (x.y * c0 + y.y * s0) * radius) (center.z + (x.z * c0 + y.z * s0) * radius)
    let b = math.vec3 (center.x + (x.x * c1 + y.x * s1) * radius) (center.y + (x.y * c1 + y.y * s1) * radius) (center.z + (x.z * c1 + y.z * s1) * radius)
    return line a b color)
func collider (shape: shapes.Shape) => return func (segments: U32) => return func (color: math.Color) => return case shape of
  $shapes.Hull poly => @array.generate poly.ea.length (func (i: U32) => return line (shapes.point_vec poly.verts[poly.ea[i]]) (shapes.point_vec poly.verts[poly.eb[i]]) color)
  $shapes.Capsule { a, b, radius } => do:
    let axis = (b - a).normalized
    if (b - a).length_squared == 0.0:
      axis := math.up
    let x = shapes.perpendicular axis
    let y = axis.cross x
    let rings = if segments >= 3 then segments else 0
    let total = 2 * rings + 2 * (2 + 2 * rings)
    let result = @array.fill total (line a b color)
    // `at` counts down from the end: the first line made comes last.
    let at = total
    for value in circle a x y radius segments color:
      at := self - 1
      result[at] := value
    for value in circle b x y radius segments color:
      at := self - 1
      result[at] := value
    // Two meridians around the hemispheres, four cylinder generators.
    for side in #[x, y]:
      // The Vec3 expressions below, on scalars.
      let rx = side.x * radius
      let ry = side.y * radius
      let rz = side.z * radius
      at := self - 1
      result[at] := line (math.vec3 (a.x + rx) (a.y + ry) (a.z + rz)) (math.vec3 (b.x + rx) (b.y + ry) (b.z + rz)) color
      at := self - 1
      result[at] := line (math.vec3 (a.x - rx) (a.y - ry) (a.z - rz)) (math.vec3 (b.x - rx) (b.y - ry) (b.z - rz)) color
      for i in 0..rings:
        let t0 = U32.to_f32 i * 3.14159265 / U32.to_f32 segments
        let t1 = U32.to_f32 (i + 1) * 3.14159265 / U32.to_f32 segments
        let (s0, c0) = sin_cos t0
        let (s1, c1) = sin_cos t1
        // a + (side * c - axis * s) * radius and b + (side * c + axis * s) * radius.
        let a0 = math.vec3 (a.x + (side.x * c0 - axis.x * s0) * radius) (a.y + (side.y * c0 - axis.y * s0) * radius) (a.z + (side.z * c0 - axis.z * s0) * radius)
        let a1 = math.vec3 (a.x + (side.x * c1 - axis.x * s1) * radius) (a.y + (side.y * c1 - axis.y * s1) * radius) (a.z + (side.z * c1 - axis.z * s1) * radius)
        at := self - 1
        result[at] := line a0 a1 color
        let b0 = math.vec3 (b.x + (side.x * c0 + axis.x * s0) * radius) (b.y + (side.y * c0 + axis.y * s0) * radius) (b.z + (side.z * c0 + axis.z * s0) * radius)
        let b1 = math.vec3 (b.x + (side.x * c1 + axis.x * s1) * radius) (b.y + (side.y * c1 + axis.y * s1) * radius) (b.z + (side.z * c1 + axis.z * s1) * radius)
        at := self - 1
        result[at] := line b0 b1 color
    break result
  $shapes.Heightfield ground => do:
    let n = max 1 segments
    let total = 2 * (n + 1) * n
    let result = @array.fill total (line ground.origin ground.origin color)
    let at = total
    for row in 0..(n + 1):
      for col in 0..n:
        let x = ground.origin.x - ground.half + (ground.half * 2.0) * U32.to_f32 col / U32.to_f32 n
        let z = ground.origin.z - ground.half + (ground.half * 2.0) * U32.to_f32 row / U32.to_f32 n
        let x2 = ground.origin.x - ground.half + (ground.half * 2.0) * U32.to_f32 row / U32.to_f32 n
        let z2 = ground.origin.z - ground.half + (ground.half * 2.0) * U32.to_f32 col / U32.to_f32 n
        let step = (ground.half * 2.0) / U32.to_f32 n
        at := self - 1
        result[at] := line (terrain.ground ground (math.vec3 x 0.0 z)) (terrain.ground ground (math.vec3 (x + step) 0.0 z)) color
        at := self - 1
        result[at] := line (terrain.ground ground (math.vec3 x2 0.0 z2)) (terrain.ground ground (math.vec3 x2 0.0 (z2 + step))) color
    break result
func contacts (values: Array contact.Contact) => return func (length: F32) => return func (color: math.Color) => return @array.generate values.length (func (i: U32) => return line values[i].point (values[i].point + values[i].normal * length) color)
func skeleton (world: Array transform.Affine3) => return func (parents: Array U32) => return func (color: math.Color) => return do:
  let bones = min world.length parents.length
  let total = 0
  for i in 0..bones:
    if parents[i] < i:
      total := self + 1
  let none: Array Line = #[]
  if total == 0:
    return none
  let result = @array.fill total (line world[0].position world[0].position color)
  let at = total
  for i in 0..bones:
    let parent = parents[i]
    if parent < i:
      at := self - 1
      result[at] := line world[parent].position world[i].position color
  return result
// Position/color stream: two vertices per line, xyz rgba (7 floats/vertex).
func vertices (lines: Array Line) => return do:
  let out = @array.fill (lines.length * 14) 0.0
  for k in 0..lines.length:
    let value = lines[k]
    let o = k * 14
    let c = value.color
    out[o] := value.a.x
    out[o + 1] := value.a.y
    out[o + 2] := value.a.z
    out[o + 3] := c.r
    out[o + 4] := c.g
    out[o + 5] := c.b
    out[o + 6] := c.a
    out[o + 7] := value.b.x
    out[o + 8] := value.b.y
    out[o + 9] := value.b.z
    out[o + 10] := c.r
    out[o + 11] := c.g
    out[o + 12] := c.b
    out[o + 13] := c.a
  return out
