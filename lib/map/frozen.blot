import * as map from "../map"
import * as array from "std/array"

// An independently built fixed snapshot. Construction deduplicates in source
// order; lookup uses a compile-known equality policy, never a stored closure.
type Map [k, v] = Array (k, v)
const u32 = map.u32
const text = map.text
const from = func equal -> (entries: Array (k, v)) : Map [k, v] => return do:
  let building: map.Map [k, v] = map.empty ()
  let slots = map.buckets ()
  map.from equal entries building slots
  return map.entries building
const index = func equal -> key -> (table: Map [k, v]) => return do:
  for i in 0 .. table.length:
    let (stored, _) = table[i]
    if equal.equal key stored:
      return $Some i
  return $Nothing
const get = func equal -> key -> table => return case index equal key table of
  $Some i => do:
    let (_, value) = table[i]
    return $Some value
  $Nothing => $Nothing
const contains = func equal -> key -> table => return Maybe.is_some (index equal key table)
const count = func (table: Map [k, v]) => return table.length
const entries = func (table: Map [k, v]) => return &table[0..table.length]
const keys = func (table: Map [k, v]) => return array.generate table.length (func i => return do:
  let (key, _) = table[i]
  return key)
const values = func (table: Map [k, v]) => return array.generate table.length (func i => return do:
  let (_, value) = table[i]
  return value)
const fold = func reduce -> initial -> (table: Map [k, v]) => return do:
  let result = initial
  for row in table:
    let (key, value) = row
    result := reduce self key value
  return result
