import * as map from "../map"
import * as array from "std/array"

// An independently built fixed snapshot. Construction deduplicates in source
// order; lookup uses a compile-known equality policy, never a stored closure.
type Map [k, v] = #[(k, v)]
const u32 = map.u32
const text = map.text
func from equal -> (entries: #[(k, v)]) : Map [k, v] =>
  let building: map.Map [k, v] = map.empty ()
  let slots = map.buckets ()
  map.from equal entries building slots
  // `map` still shares what it returns; the copy goes when it is converted.
  return (map.entries building).copy
func index equal -> key -> (table: Map [k, v]) =>
  for i in 0 .. table.length:
    let (stored, _) = table[i]
    if equal.equal key stored:
      return $Some i
  return $Nothing
func get equal -> key -> table => case index equal key table of
  $Some i => do:
    let (_, value) = table[i]
    return $Some value
  $Nothing => $Nothing
func contains equal -> key -> table => Maybe.is_some (index equal key table)
func count (table: Map [k, v]) => table.length
func entries (table: Map [k, v]) => &table[0..table.length]
func keys (table: Map [k, v]) => array.generate table.length (func i =>
  let (key, _) = table[i]
  return key)
func values (table: Map [k, v]) => array.generate table.length (func i =>
  let (_, value) = table[i]
  return value)
func fold reduce -> initial -> (table: Map [k, v]) =>
  let result = initial
  for row in table:
    let (key, value) = row
    result := reduce self key value
  return result
