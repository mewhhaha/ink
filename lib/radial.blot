// A row of the union of soft circular stamps. Coordinates and radii are
// world units. Vec4 carries (x, z, radius, softness); overlap takes max.
import * as array from "std/array"
import * as simd from "std/simd"
import * as math from "./math"

type Grid is data = $Grid { cells: U32, origin: F32, spacing: F32 }
// Callers supply a finite grid with cells > 0 and spacing > 0, plus finite
// circles with radius >= 0 and softness > 0. No mutable world or caches escape.
func reach (grid: Grid) -> (middle: F32) -> (radius: F32) => return do:
  let last = U32.to_f32 (grid.cells - 1)
  let low = F32.to_u32 (clamp 0.0 last (floor ((middle - radius - grid.origin) / grid.spacing)))
  let high = F32.to_u32 (clamp 0.0 last (ceil ((middle + radius - grid.origin) / grid.spacing)))
  return (low, high)

func scalar (grid: Grid) -> (patches: Array math.Vec4) -> (z: U32) => return do:
  let row = array.fill grid.cells 0.0
  for place in patches:
    let (low_z, high_z) = reach grid place.y place.z
    if z >= low_z and z <= high_z:
      let (low_x, high_x) = reach grid place.x place.z
      let dz = grid.origin + U32.to_f32 z * grid.spacing - place.y
      for x in low_x .. high_x + 1:
        let dx = grid.origin + U32.to_f32 x * grid.spacing - place.x
        row[x] := max self (clamp 0.0 1.0 ((place.z - sqrt (dx * dx + dz * dz)) / place.w))
  return row

func vectorized (grid: Grid) -> (patches: Array math.Vec4) -> (z: U32) => return do:
  let row = array.fill grid.cells 0.0
  for place in patches:
    let (low_z, high_z) = reach grid place.y place.z
    if z >= low_z and z <= high_z:
      let (low_x, high_x) = reach grid place.x place.z
      let dz = grid.origin + U32.to_f32 z * grid.spacing - place.y
      let stop = low_x + (high_x + 1 - low_x) / 4 * 4
      for block in 0 .. (stop - low_x) / 4:
        let x = low_x + block * 4
        let at = (U32.to_f32 x, U32.to_f32 (x + 1), U32.to_f32 (x + 2), U32.to_f32 (x + 3))
        let dx = simd.f32_sub (simd.f32_add (simd.f32_splat grid.origin)
          (simd.f32_mul at (simd.f32_splat grid.spacing))) (simd.f32_splat place.x)
        let distance = simd.f32_sqrt (simd.f32_add (simd.f32_mul dx dx) (simd.f32_splat (dz * dz)))
        let amount = simd.f32_div (simd.f32_sub (simd.f32_splat place.z) distance) (simd.f32_splat place.w)
        let next = simd.f32_max (simd.load x row) (simd.f32_min (simd.f32_splat 1.0) (simd.f32_max (simd.f32_splat 0.0) amount))
        row := simd.store x next self
      for x in stop .. high_x + 1:
        let dx = grid.origin + U32.to_f32 x * grid.spacing - place.x
        row[x] := max self (clamp 0.0 1.0 ((place.z - sqrt (dx * dx + dz * dz)) / place.w))
  return row

// Small stamp sets keep scalar setup; the measured large stamp workloads
// favor SIMD in both V8 and Wasmtime. This changes no arithmetic or lane order.
func row (grid: Grid) -> (patches: Array math.Vec4) -> (z: U32) => return
  if patches.length < 64 then scalar grid patches z else vectorized grid patches z
