import { Vec3 } from "std/vector"
import * as math from "./math"

// Roughly square sectors in concentric rings on the center's XZ plane.
// Sector zero begins on +X; sectors count toward +Z. The outer edge is open.
type Grid is data = $Grid { center: Vec3, inner: F32, ring_width: F32, rings: U32 }
type Plot is data = $Plot { ring: U32, sector: U32 }

const outer = func (grid: Grid) => return grid.inner + U32.to_f32 grid.rings * grid.ring_width
const valid = func (grid: Grid) => return do:
  if Bool.not (math.finite3 grid.center and is_finite grid.inner and is_finite grid.ring_width) or grid.inner < 0.0 or grid.ring_width <= 0.0 or grid.rings == 0:
    return false
  let radius = outer grid
  return is_finite radius and tau * radius / grid.ring_width < 16777216.0
const make = func (center: Vec3) => return func (inner: F32) => return func (ring_width: F32) => return func (rings: U32) => return do:
  let grid = $Grid { center, inner, ring_width, rings }
  if valid grid:
    return $Some grid
  return $Nothing
const ring_start = func (grid: Grid) => return func (ring: U32) => return grid.inner + U32.to_f32 ring * grid.ring_width
// The sector count of a ring of a valid grid, ring < rings.
const ring_sectors = func (grid: Grid) => return func (ring: U32) => return do:
  let middle = ring_start grid ring + grid.ring_width * 0.5
  return max 6 (F32.to_u32 (floor (tau * middle / grid.ring_width + 0.5)))
const sectors = func (grid: Grid) => return func (ring: U32) => return do:
  if Bool.not (valid grid) or ring >= grid.rings:
    return 0
  return ring_sectors grid ring
const sector_angle = func (grid: Grid) => return func (ring: U32) => return do:
  let count = sectors grid ring
  if count == 0:
    return 0.0
  return tau / U32.to_f32 count
const point = func (grid: Grid) => return func (radius: F32) => return func (angle: F32) => return do:
  let (sine, cosine) = sin_cos angle
  return math.vec3 (grid.center.x + cosine * radius) grid.center.y (grid.center.z + sine * radius)
// Queries validate the grid once, then reuse each ring's count and angle.
const plot_at = func (grid: Grid) => return func (at: Vec3) => return do:
  if Bool.not (valid grid and math.finite3 at):
    return $Nothing
  let dx = at.x - grid.center.x
  let dz = at.z - grid.center.z
  let distance = sqrt (dx * dx + dz * dz)
  if Bool.not (is_finite distance) or distance < grid.inner or distance >= outer grid:
    return $Nothing
  let ring = min (grid.rings - 1) (F32.to_u32 ((distance - grid.inner) / grid.ring_width))
  let count = ring_sectors grid ring
  let angle = wrap tau (math.atan2 dz dx)
  let sector = min (count - 1) (F32.to_u32 (angle / (tau / U32.to_f32 count)))
  return $Some $Plot { ring, sector }
const valid_plot = func (grid: Grid) => return func (plot: Plot) => return plot.ring < grid.rings and plot.sector < sectors grid plot.ring
const plot_center = func (grid: Grid) => return func (plot: Plot) => return do:
  if Bool.not (valid grid) or plot.ring >= grid.rings:
    return grid.center
  let count = ring_sectors grid plot.ring
  if plot.sector >= count:
    return grid.center
  return point grid (ring_start grid plot.ring + grid.ring_width * 0.5) ((U32.to_f32 plot.sector + 0.5) * (tau / U32.to_f32 count))

// Stable ring/sector order; inspect only rings within the query's radius.
const plots_within = func (grid: Grid) => return func (at: Vec3) => return func (radius: F32) => return do:
  if Bool.not (valid grid and math.finite3 at and is_finite radius) or radius < 0.0:
    return #[]
  let dx = at.x - grid.center.x
  let dz = at.z - grid.center.z
  let distance = sqrt (dx * dx + dz * dz)
  if Bool.not (is_finite distance):
    return #[]
  let low = max 0.0 ((distance - radius - grid.inner) / grid.ring_width - 0.5)
  let high = min (U32.to_f32 (grid.rings - 1)) ((distance + radius - grid.inner) / grid.ring_width - 0.5)
  if high < low or low >= U32.to_f32 grid.rings:
    return #[]
  let first = F32.to_u32 (ceil low)
  let end = F32.to_u32 (floor high) + 1
  // Matches go into one buffer of (ring, sector) words, sized for every
  // sector of the rings in range.
  let room = 0
  for ring in first .. end:
    room := self + ring_sectors grid ring
  let matched = @array.fill (room * 2) 0
  let total = 0
  for ring in first .. end:
    let middle = ring_start grid ring + grid.ring_width * 0.5
    if abs (middle - distance) <= radius:
      let count = ring_sectors grid ring
      let angle = tau / U32.to_f32 count
      for sector in 0 .. count:
        let (sine, cosine) = sin_cos ((U32.to_f32 sector + 0.5) * angle)
        let x = grid.center.x + cosine * middle - at.x
        let z = grid.center.z + sine * middle - at.z
        if x * x + z * z <= radius * radius:
          matched[total * 2] := ring
          matched[total * 2 + 1] := sector
          total := self + 1
  return @array.generate total (func (i: U32) => return $Plot { ring: matched[i * 2], sector: matched[i * 2 + 1] })
