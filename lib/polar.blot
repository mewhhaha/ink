import { Vec3 } from "std/vector"
import * as math from "./math"

// Roughly square sectors in concentric rings on the center's XZ plane.
// Sector zero begins on +X; sectors count toward +Z. The outer edge is open.
type Grid is data = $Grid { center: Vec3, inner: F32, ring_width: F32, rings: U32 }
type Plot is data = $Plot { ring: U32, sector: U32 }

func outer (grid: Grid) => grid.inner + U32.to_f32 grid.rings * grid.ring_width
func valid (grid: Grid) =>
  if not (math.finite3 grid.center and is_finite grid.inner and is_finite grid.ring_width) or grid.inner < 0.0 or grid.ring_width <= 0.0 or grid.rings == 0:
    return false
  let radius = outer grid
  return is_finite radius and tau * radius / grid.ring_width < 16777216.0
func make (center: Vec3) => func (inner: F32) => func (ring_width: F32) => func (rings: U32) =>
  let grid = $Grid { center, inner, ring_width, rings }
  if valid grid:
    return $Some grid
  return $Nothing
func ring_start (grid: Grid) => func (ring: U32) => grid.inner + U32.to_f32 ring * grid.ring_width
// The sector count of a ring of a valid grid, ring < rings.
func ring_sectors (grid: Grid) => func (ring: U32) =>
  if not (is_finite grid.inner and is_finite grid.ring_width) or grid.ring_width <= 0.0:
    return 6
  let middle = ring_start grid ring + grid.ring_width * 0.5
  let raw = floor (tau * middle / grid.ring_width + 0.5)
  if not (is_finite raw) or raw <= 6.0:
    return 6
  if raw >= 4294967040.0:
    return 4294967040
  return max 6 (F32.to_u32 raw)
func sectors (grid: Grid) => func (ring: U32) =>
  if not (valid grid) or ring >= grid.rings:
    return 0
  return ring_sectors grid ring
func sector_angle (grid: Grid) => func (ring: U32) =>
  let count = sectors grid ring
  if count == 0:
    return 0.0
  return tau / U32.to_f32 count
func point (grid: Grid) => func (radius: F32) => func (angle: F32) =>
  if not (math.finite3 grid.center and is_finite radius and is_finite angle):
    return if math.finite3 grid.center then grid.center else math.zero3
  let wrapped = if abs angle > 4096.0 then (if abs angle > 1.0e30 then 0.0 else wrap tau angle) else angle
  let (sine, cosine) = sin_cos wrapped
  let px = grid.center.x + cosine * radius
  let pz = grid.center.z + sine * radius
  if not (is_finite px and is_finite pz):
    return grid.center
  return math.vec3 px grid.center.y pz
// Queries validate the grid once, then reuse each ring's count and angle.
func plot_at (grid: Grid) => func (at: Vec3) =>
  if not (valid grid and math.finite3 at):
    return $Nothing
  let dx = at.x - grid.center.x
  let dz = at.z - grid.center.z
  let distance = sqrt (dx * dx + dz * dz)
  if not (is_finite distance) or distance < grid.inner or distance >= outer grid:
    return $Nothing
  let ring = min (grid.rings - 1) (F32.to_u32 ((distance - grid.inner) / grid.ring_width))
  let count = ring_sectors grid ring
  let angle = wrap tau (math.atan2 dz dx)
  let sector = min (count - 1) (F32.to_u32 (angle / (tau / U32.to_f32 count)))
  return $Some $Plot { ring, sector }
func valid_plot (grid: Grid) => func (plot: Plot) => plot.ring < grid.rings and plot.sector < sectors grid plot.ring
func plot_center (grid: Grid) => func (plot: Plot) =>
  if not (valid grid) or plot.ring >= grid.rings:
    return grid.center
  let count = ring_sectors grid plot.ring
  if plot.sector >= count:
    return grid.center
  return point grid (ring_start grid plot.ring + grid.ring_width * 0.5) ((U32.to_f32 plot.sector + 0.5) * (tau / U32.to_f32 count))

// Stable ring/sector order; inspect only rings within the query's radius.
func plots_within (grid: Grid) => func (at: Vec3) => func (radius: F32) =>
  if not (valid grid and math.finite3 at and is_finite radius) or radius < 0.0:
    return #[]
  let dx = at.x - grid.center.x
  let dz = at.z - grid.center.z
  let distance = sqrt (dx * dx + dz * dz)
  if not (is_finite distance):
    return #[]
  let low = max 0.0 ((distance - radius - grid.inner) / grid.ring_width - 0.5)
  let max_ring = min 4294967040.0 (U32.to_f32 (grid.rings - 1))
  let high = min max_ring ((distance + radius - grid.inner) / grid.ring_width - 0.5)
  if not (is_finite low and is_finite high) or high < low or low >= U32.to_f32 grid.rings:
    return #[]
  let first = F32.to_u32 (ceil low)
  let last = min (grid.rings - 1) (F32.to_u32 (floor high))
  if last < first or last == 4294967295:
    return #[]
  let end = last + 1
  // Matches go into one buffer of (ring, sector) words, sized for every
  // sector of the rings in range.
  let room = 0
  for ring in first .. end:
    let sectors_in_ring = ring_sectors grid ring
    if sectors_in_ring > 1048576 - room:
      return #[]
    room := self + sectors_in_ring
  let matched = @array.fill (room * 2) 0
  let total = 0
  for ring in first .. end:
    let middle = ring_start grid ring + grid.ring_width * 0.5
    if abs (middle - distance) <= radius:
      let count = ring_sectors grid ring
      let angle = tau / U32.to_f32 count
      for sector in 0 .. count:
        let (sine, cosine) = sin_cos ((U32.to_f32 sector + 0.5) * angle)
        let x = grid.center.x + cosine * middle - at.x
        let z = grid.center.z + sine * middle - at.z
        if x * x + z * z <= radius * radius:
          matched[total * 2] := ring
          matched[total * 2 + 1] := sector
          total := self + 1
  return @array.generate total (func (i: U32) => $Plot { ring: matched[i * 2], sector: matched[i * 2 + 1] })
