import * as array from "std/array"
import * as hash from "./hash"

// Compile-known policies are specialized away; never store Key in runtime data.
type Key k is data = $Key { hash: k -> U32, equal: k -> k -> Bool }
const key = func hash -> equal => return $Key {hash, equal}
const u32 = key hash.u32 (func (a: U32) -> (b: U32) => return a == b)
// Text keys borrow an independently owned U32 character pool; an owning Array
// key cannot be an inline map row. The pool must outlive every stored key view.
const text_hash = func (value: &[U32]) => return do:
  let state: U32 = 2166136261
  for scalar in value:
    state := (state ^ scalar) * 16777619
  return hash.u32 state
const text_equal = func (left: &[U32]) -> (right: &[U32]) => return do:
  if left.length != right.length:
    return false
  for i in 0 .. left.length:
    if left[i] != right[i]:
      return false
  return true
const text = key text_hash text_equal
// Two separately named owners: stable insertion-ordered rows and hash buckets.
// buckets[0] is live count; subsequent slots hold row+1, zero, or tombstone.
// This is expected O(1) lookup/write/remove, amortized O(1) insertion; explicit
// iteration/copy is O(rows ever inserted). Rehash costs O(rows + capacity).
// Element payloads are fixed-layout rows; variable data uses caller-owned
// pools plus spans/borrowed views/links, never owning array fields.
type Entry [k, v] is data = $Entry { hash: U32, item: Maybe (k, v) }
type Map [k, v] = ResizeArray (Entry [k, v])
type Buckets = ResizeArray U32
const tombstone: U32 = 0xFFFFFFFF
const empty = func () : Map [k, v] => return #[]
const buckets = func () : Buckets => return do:
  let slots: Buckets = #[]
  for 0 .. 17:
    @storage.push slots 0
  return slots
const count = func (slots: Buckets) => return slots[0]
const is_empty = func slots => return count slots == 0
const locate = func policy -> key -> (rows: Map [k, v]) -> (slots: Buckets) => return do:
  let hashed = policy.hash key
  let mask = slots.length - 2
  let at = hashed & mask
  for 0 .. slots.length - 1:
    let selected = slots[at + 1]
    if selected == 0:
      return $Nothing
    if selected != tombstone:
      let row = rows[selected - 1]
      if row.hash == hashed:
        if let $Some (stored, _) = row.item:
          if policy.equal key stored:
            return $Some at
    at := (at + 1) & mask
  return $Nothing
const get = func policy -> key -> rows -> slots => return case locate policy key rows slots of
  $Some at => do:
    let $Some (_, value) = rows[slots[at + 1] - 1].item else:
      return @panic "map bucket points at removed row"
    return $Some value
  $Nothing => $Nothing
const contains = func policy -> key -> rows -> slots => return Maybe.is_some (locate policy key rows slots)
const rehash = func (capacity: U32) -> (rows: Map [k, v]) -> (slots: Buckets) => return do:
  if capacity < 16 or capacity & (capacity - 1) != 0:
    return @panic "map capacity must be a power of two"
  let live = slots[0]
  @storage.truncate slots 0
  @storage.push slots live
  for 0 .. capacity:
    @storage.push slots 0
  for i in 0 .. rows.length:
    if let $Some _ = rows[i].item:
      let at = rows[i].hash & (capacity - 1)
      for 0 .. capacity:
        if slots[at + 1] == 0:
          slots[at + 1] := i + 1
          break
        at := (at + 1) & (capacity - 1)
const set = func policy -> key -> value -> (rows: Map [k, v]) -> (slots: Buckets) => return do:
  if let $Some at = locate policy key rows slots:
    let id = slots[at + 1] - 1
    let $Some (first, _) = rows[id].item else:
      return @panic "map bucket points at removed row"
    rows[id].item := $Some (first, value)
    return ()
  if rows.length >= tombstone - 1:
    return @panic "map row identity exhausted"
  let capacity = slots.length - 1
  if slots[0] >= capacity / 2:
    if capacity > 0x40000000:
      return @panic "map capacity exhausted"
    rehash (capacity * 2) rows slots
  let mask = slots.length - 2
  let hashed = policy.hash key
  let at = hashed & mask
  for 0 .. slots.length - 1:
    if slots[at + 1] == 0 or slots[at + 1] == tombstone:
      @storage.push rows ($Entry {hash: hashed, item: $Some (key, value)})
      slots[at + 1] := rows.length
      slots[0] := slots[0] + 1
      return ()
    at := (at + 1) & mask
  return @panic "map probe invariant"
const remove = func policy -> key -> (rows: Map [k, v]) -> (slots: Buckets) => return do:
  if let $Some at = locate policy key rows slots:
    rows[slots[at + 1] - 1].item := $Nothing
    slots[at + 1] := tombstone
    slots[0] := slots[0] - 1
const set_many = func policy -> (entries: Array (k, v)) -> rows -> slots => return do:
  let count = entries.length
  for i in 0 .. count:
    let (key, value) = entries[i]
    set policy key value rows slots
const remove_many = func policy -> keys -> rows -> slots => return do:
  for key in keys:
    remove policy key rows slots
const from = func policy -> (entries: Array (k, v)) -> rows -> slots => return set_many policy entries rows slots
const entries = func (rows: Map [k, v]) => return do:
  let out: ResizeArray (k, v) = #[]
  for row in rows:
    if let $Some item = row.item:
      @storage.push out item
  return @storage.freeze out
const keys = func rows => return array.map (func pair => return do:
  let (key, _) = pair
  return key) (entries rows)
const values = func rows => return array.map (func pair => return do:
  let (_, value) = pair
  return value) (entries rows)
const fold = func reduce -> initial -> (rows: Map [k, v]) => return do:
  let result = initial
  let count = rows.length
  for i in 0 .. count:
    if let $Some (key, value) = rows[i].item:
      result := reduce self key value
  return result
// Apply a known change policy to one key, mutating the caller's owners.
const alter = func policy -> key -> change -> (rows:Map [k,v]) -> (slots:Buckets) => return case change (get policy key rows slots) of
  $Some value => set policy key value rows slots
  $Nothing => remove policy key rows slots
const edit_many = func policy -> edits -> rows -> slots => return do:
  for (key, value) in edits:
    case value of
      $Some value => set policy key value rows slots
      $Nothing => remove policy key rows slots
const copy_into = func policy -> copy_key -> copy_value -> destination -> destination_slots -> source => return do:
  let values = entries source
  clear destination destination_slots
  for (key, value) in values:
    set policy (copy_key key) (copy_value value) destination destination_slots
const clear = func (rows: Map [k, v]) -> (slots: Buckets) => return do:
  @storage.truncate rows 0
  for i in 0 .. slots.length:
    slots[i] := 0
const popcount = func (word: U32) => return do:
  let bits = word - ((word >> 1) & 0x55555555)
  bits := (self & 0x33333333) + ((self >> 2) & 0x33333333)
  bits := (self + (self >> 4)) & 0x0F0F0F0F
  return (bits * 0x01010101) >> 24
