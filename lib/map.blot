import * as array from "std/array"
import * as hash from "./hash"

// Compile-known policies are specialized away; never store Key in runtime data.
type Key k is data = $Key { hash: k -> U32, equal: k -> k -> Bool }
func key hash -> equal => $Key {hash, equal}
const u32 = key hash.u32 (func (a: U32) -> (b: U32) => a == b)
// Text keys borrow an independently owned U32 character pool; an owning Array
// key cannot be an inline map row. The pool must outlive every stored key view.
func text_hash (value: &[U32]) =>
  let state: U32 = 2166136261
  for scalar in value:
    state := (state ^ scalar) * 16777619
  return hash.u32 state
func text_equal (left: &[U32]) -> (right: &[U32]) =>
  if left.length != right.length:
    return false
  for i in 0 .. left.length:
    if left[i] != right[i]:
      return false
  return true
const text = key text_hash text_equal
// Two separately named owners: stable insertion-ordered rows and hash buckets.
// buckets[0] is live count; buckets[1] is occupied count (live + tombstones);
// subsequent slots hold row+1, zero, or tombstone.
// This is expected O(1) lookup/write/remove, amortized O(1) insertion; rehash
// compacts dead rows and clears tombstones in O(rows + capacity).
// Element payloads are fixed-layout rows; variable data uses caller-owned
// pools plus spans/borrowed views/links, never owning array fields.
type Entry [k, v] is data = $Entry { hash: U32, item: Maybe (k, v) }
type Map [k, v] = #[~Entry [k, v]]
type Buckets = #[~U32]
const tombstone: U32 = 0xFFFFFFFF
const header_slots: U32 = 2
func empty () : Map [k, v] => #[]
func buckets () : Buckets =>
  let slots: Buckets = #[]
  for 0 .. header_slots + 16:
    @storage.push slots 0
  return slots
func count (slots: Buckets) => slots[0]
func is_empty slots => count slots == 0
func locate policy -> key -> (rows: Map [k, v]) -> (slots: Buckets): Maybe U32 =>
  let hashed = policy.hash key
  let capacity = slots.length - header_slots
  let mask = capacity - 1
  let at = hashed & mask
  for 0 .. capacity:
    let selected = slots[at + header_slots]
    if selected == 0:
      return $Nothing
    if selected != tombstone:
      let row = rows[selected - 1]
      if row.hash == hashed:
        if let $Some (stored, _) = row.item:
          if policy.equal key stored:
            return $Some at
    at := (at + 1) & mask
  return $Nothing
func get policy -> key -> rows -> slots => case locate policy key rows slots of
  $Some at => do:
    let $Some (_, value) = rows[slots[at + header_slots] - 1].item else:
      return panic "map bucket points at removed row"
    return $Some value
  $Nothing => $Nothing
func contains policy -> key -> rows -> slots => Maybe.is_some (locate policy key rows slots)
func rehash (capacity: U32) -> (rows: Map [k, v]) -> (slots: Buckets) =>
  if capacity < 16 or capacity & (capacity - 1) != 0:
    return panic "map capacity must be a power of two"
  // Compact removed rows in place while preserving insertion order.
  let kept: U32 = 0
  for i in 0 .. rows.length:
    let entry = rows[i]
    if Maybe.is_some entry.item:
      if kept != i:
        rows[kept] = entry
      kept := self + 1
  @storage.truncate rows kept
  @storage.truncate slots 0
  @storage.push slots kept
  @storage.push slots kept
  for 0 .. capacity:
    @storage.push slots 0
  let mask = capacity - 1
  for i in 0 .. kept:
    let at = rows[i].hash & mask
    for 0 .. capacity:
      if slots[at + header_slots] == 0:
        slots[at + header_slots] = i + 1
        break
      at := (at + 1) & mask
  return ()
func set policy -> key -> value -> (rows: Map [k, v]) -> (slots: Buckets) =>
  let hashed = policy.hash key
  let capacity = slots.length - header_slots
  let mask = capacity - 1
  let at = hashed & mask
  let first_tombstone = tombstone
  let empty_slot = tombstone
  for 0 .. capacity:
    let selected = slots[at + header_slots]
    if selected == 0:
      empty_slot := at
      break
    if selected == tombstone:
      if first_tombstone == tombstone:
        first_tombstone := at
    else:
      let id = selected - 1
      let row = rows[id]
      if row.hash == hashed:
        if let $Some (stored, _) = row.item:
          if policy.equal key stored:
            rows[id].item = $Some (stored, value)
            return ()
    at := (at + 1) & mask
  if rows.length >= tombstone - 1:
    return panic "map row identity exhausted"
  let live = slots[0]
  let occupied = slots[1]
  let needs_grow = live >= capacity / 2
  let needs_clean = first_tombstone == tombstone and occupied + 1 > (capacity / 4) * 3
  if needs_grow or needs_clean:
    let next_capacity = if needs_grow then capacity * 2 else capacity
    if needs_grow and capacity > 0x40000000:
      return panic "map capacity exhausted"
    rehash next_capacity rows slots
    let new_cap = slots.length - header_slots
    let new_mask = new_cap - 1
    let probe = hashed & new_mask
    for 0 .. new_cap:
      if slots[probe + header_slots] == 0:
        @storage.push rows ($Entry {hash: hashed, item: $Some (key, value)})
        slots[probe + header_slots] = rows.length
        slots[0] = slots[0] + 1
        slots[1] = slots[1] + 1
        return ()
      probe := (probe + 1) & new_mask
    return panic "map probe invariant"
  let target = if first_tombstone != tombstone then first_tombstone else empty_slot
  if target == tombstone:
    return panic "map probe invariant"
  @storage.push rows ($Entry {hash: hashed, item: $Some (key, value)})
  slots[target + header_slots] = rows.length
  slots[0] = live + 1
  if first_tombstone == tombstone:
    slots[1] = occupied + 1
  return ()
func remove policy -> key -> (rows: Map [k, v]) -> (slots: Buckets) =>
  if let $Some at = locate policy key rows slots:
    rows[slots[at + header_slots] - 1].item = $Nothing
    slots[at + header_slots] = tombstone
    slots[0] = slots[0] - 1
  return ()
func set_many policy -> (entries: #[(k, v)]) -> rows -> slots =>
  let count = entries.length
  if count == 0:
    return ()
  let (first_key, first_value) = entries[0]
  set policy first_key first_value rows slots
  for i in 1 .. count:
    let (key, value) = entries[i]
    set policy key value rows slots
  return ()
func remove_many policy -> keys -> rows -> slots =>
  if keys.length == 0:
    return ()
  remove policy keys[0] rows slots
  for index in 1 .. keys.length:
    remove policy keys[index] rows slots
  return ()
func from policy -> (entries: #[(k, v)]) -> rows -> slots => set_many policy entries rows slots
func entries (rows: Map [k, v]) =>
  let out: #[~(k, v)] = #[]
  for row in rows:
    if let $Some item = row.item:
      @storage.push out item
  return seal out
func keys (rows: Map [k, v]) =>
  let out: #[~k] = #[]
  for row in rows:
    if let $Some (key, _) = row.item:
      @storage.push out key
  return seal out
func values (rows: Map [k, v]) =>
  let out: #[~v] = #[]
  for row in rows:
    if let $Some (_, value) = row.item:
      @storage.push out value
  return seal out
func fold reduce -> initial -> (rows: Map [k, v]) =>
  let result = initial
  let count = rows.length
  for i in 0 .. count:
    if let $Some (key, value) = rows[i].item:
      result := reduce self key value
  return result
// Apply a known change policy to one key, mutating the caller's owners.
func alter policy -> key -> change -> (rows:Map [k,v]) -> (slots:Buckets) => case change (get policy key rows slots) of
  $Some value => set policy key value rows slots
  $Nothing => remove policy key rows slots
func edit_many policy -> edits -> rows -> slots =>
  for (key, value) in edits:
    case value of
      $Some value => set policy key value rows slots
      $Nothing => remove policy key rows slots
  return ()
func copy_into policy -> copy_key -> copy_value -> destination -> destination_slots -> source =>
  let values = entries source
  clear destination destination_slots
  if values.length == 0:
    return ()
  let (first_key, first_value) = values[0]
  set policy (copy_key first_key) (copy_value first_value) destination destination_slots
  for index in 1 .. values.length:
    let (key, value) = values[index]
    set policy (copy_key key) (copy_value value) destination destination_slots
  return ()
func clear (rows: Map [k, v]) -> (slots: Buckets) =>
  @storage.truncate rows 0
  for i in 0 .. slots.length:
    slots[i] = 0
  return ()
func popcount (word: U32) =>
  let bits = word - ((word >> 1) & 0x55555555)
  bits := (self & 0x33333333) + ((self >> 2) & 0x33333333)
  bits := (self + (self >> 4)) & 0x0F0F0F0F
  return (bits * 0x01010101) >> 24
