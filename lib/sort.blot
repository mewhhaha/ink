// Deterministic sorting. Equal keys keep their original order (the sort is
// stable), so a result never depends on anything but the input.

func identity (n: U32) : Array U32 => return @array.generate n (func (index: U32) => return index)

// The indices 0..n ordered by ascending `keys`, with stable bottom-up merging.
// Keys stay readonly. Already ordered inputs cost one pass.
func order (keys: Array F32) : Array U32 => return do:
  let n = keys.length
  let in_order = true
  for i in 1..n:
    if keys[i - 1] > keys[i]:
      in_order := false
  if in_order:
    return identity n
  let ids: Array U32 = identity n
  let next: Array U32 = @array.fill n 0
  let width = 1
  for 0..32:
    if width >= n:
      break
    for run in 0..((n + width * 2 - 1) / (width * 2)):
      let low = run * width * 2
      let middle = min (low + width) n
      let high = min (low + width * 2) n
      let i = low
      let j = middle
      for k in low..high:
        let take_left = if i >= middle then false else if j >= high then true else keys[ids[i]] <= keys[ids[j]]
        let selected = 0
        if take_left:
          selected := ids[i]
          i := self + 1
        else:
          selected := ids[j]
          j := self + 1
        next[k] := selected
    for i in 0..n:
      ids[i] = next[i]
    width := self * 2
  return ids

// Stable radix ordering with exact full-width unsigned keys.
func order_u32 (keys: Array U32) : Array U32 => return do:
  let n = keys.length
  let sorted = true
  for i in 1..n:
    if keys[i - 1] > keys[i]:
      sorted := false
  let ids = identity n
  if sorted:
    return ids
  if n <= 16:
    for i in 1..n:
      let j = i
      for 0..16:
        if j == 0 or keys[ids[j - 1]] <= keys[ids[j]]:
          break
        let swap = ids[j]
        ids[j] = ids[j - 1]
        ids[j - 1] = swap
        j := self - 1
    return ids
  let next = @array.fill n 0
  for shift in #[0, 8, 16, 24]:
    // Counts do not depend on the order, so they read the keys in place.
    let counts = @array.fill 256 0
    for i in 0..n:
      let bucket = (keys[i] >> shift) & 255
      counts[bucket] := self + 1
    // A digit every key shares leaves the order as it is.
    let shared = counts[(keys[0] >> shift) & 255] == n
    if Bool.not shared:
      let start = 0
      for bucket in 0..256:
        let count = counts[bucket]
        counts[bucket] := start
        start := self + count
      for i in 0..n:
        let id = ids[i]
        let bucket = (keys[id] >> shift) & 255
        next[counts[bucket]] := id
        counts[bucket] := self + 1
      // Copy the completed pass into the separately named result owner.
      // Both owners are reused; assignment would only alias their storage.
      for i in 0..n:
        ids[i] = next[i]
  return ids
