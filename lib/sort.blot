// Deterministic sorting. Equal keys keep their original order (the sort is
// stable), so a result never depends on anything but the input.

const identity = fn (n: U32) -> Array U32 => @array.generate n (fn (index: U32) => index)

// The indices 0..n ordered by ascending `keys`, with stable bottom-up merging.
// Keys stay readonly. Already ordered inputs cost one pass.
const order = fn (keys: Array F32) -> Array U32 => do:
  let n = keys.length
  let in_order = #True
  for i in 1..n:
    if keys[i - 1] > keys[i]:
      in_order := #False
  if in_order:
    return identity n
  let ids: Array U32 = identity n
  let width = 1
  for 0..32:
    if width >= n:
      break
    let next = @array.fill n 0
    for run in 0..((n + width * 2 - 1) / (width * 2)):
      let low = run * width * 2
      let middle = min (low + width) n
      let high = min (low + width * 2) n
      let i = low
      let j = middle
      for k in low..high:
        let take_left = if i >= middle then #False else if j >= high then #True else keys[ids[i]] <= keys[ids[j]]
        let selected = 0
        if take_left:
          selected := ids[i]
          i := self + 1
        else:
          selected := ids[j]
          j := self + 1
        next[k] := selected
    ids := next
    width := self * 2
  return ids

// Stable radix ordering with exact full-width unsigned keys.
const order_u32 = fn (keys: Array U32) -> Array U32 => do:
  let n = keys.length
  let sorted = #True
  for i in 1..n:
    if keys[i - 1] > keys[i]:
      sorted := #False
  let ids = identity n
  if sorted:
    return ids
  if n <= 16:
    for i in 1..n:
      let j = i
      for 0..16:
        if j == 0 || keys[ids[j - 1]] <= keys[ids[j]]:
          break
        let swap = ids[j]
        ids[j] := ids[j - 1]
        ids[j - 1] := swap
        j := self - 1
    return ids
  let next = @array.fill n 0
  for shift in #[0, 8, 16, 24]:
    let counts = @array.fill 256 0
    for i in 0..n:
      let bucket = (keys[ids[i]] >> shift) & 255
      counts[bucket] := self + 1
    let start = 0
    for bucket in 0..256:
      let count = counts[bucket]
      counts[bucket] := start
      start := self + count
    for i in 0..n:
      let id = ids[i]
      let bucket = (keys[id] >> shift) & 255
      next[counts[bucket]] := id
      counts[bucket] := self + 1
    ids := next
    // A swapped array retains an alias and makes later writes copy its storage.
    next := @array.fill n 0
  return ids
