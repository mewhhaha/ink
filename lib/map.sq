//! Caller-owned open-addressing hash maps with explicit compile-known key policies and insertion order.
//!
//! Key items: [`Key`], [`Entry`], [`Map`], [`key`], [`text_hash`].
//!
//! ```squid
//! let m = empty ()
//! m := set u32 7 100 self
//! m := set u32 9 200 self
//! Maybe.unwrap_or 0 (get u32 7 m) + count m // => 102
//! ```

import * as array from "std/array"
import * as hash from "./hash"

// Compile-known policies are specialized away; never store Key in runtime data.
type Key k is data = $Key { hash: k -> U32, equal: k -> k -> Bool }
func key hash -> equal => $Key {hash, equal}
const u32 = key hash.u32 (func (a: U32) -> (b: U32) => a == b)
// Text keys borrow an independently owned U32 character pool; an owning Array
// key cannot be an inline map row. The pool must outlive every stored key view.
func text_hash (value: &[U32]) =>
  let state: U32 = 2166136261
  for scalar in value:
    state := (state ^ scalar) * 16777619
  return hash.u32 state
func text_equal (left: &[U32]) -> (right: &[U32]) =>
  if left.length != right.length:
    return false
  for i in 0 .. left.length:
    if left[i] != right[i]:
      return false
  return true
const text = key text_hash text_equal
// One caller-owned Map holds insertion-ordered rows and hash buckets together.
// buckets[0] is live count; buckets[1] is occupied count (live + tombstones);
// subsequent slots hold row+1, zero, or tombstone.
// This is expected O(1) lookup/write/remove, amortized O(1) insertion; rehash
// compacts dead rows and clears tombstones in O(rows + capacity).
// Element payloads are fixed-layout rows; variable data uses caller-owned
// pools plus spans/borrowed views/links, never owning array fields.
type Entry [k, v] is data = $Entry { hash: U32, item: Maybe (k, v) }
type Map [k, v] is data = $Map { rows: #[Entry [k, v]], buckets: #[U32] }
const tombstone: U32 = 0xFFFFFFFF
const header_slots: U32 = 2
func initial_buckets () : #[U32] => @array.fill (header_slots + 16) 0
func empty () : Map [k, v] =>
  let rows: #[Entry [k, v]] = #[]
  return $Map { rows, buckets: initial_buckets () }
func count table : U32 => table.buckets[0]
func is_empty (table: Map [k, v]) => count table == 0
func locate policy -> key -> (table: Map [k, v]): Maybe U32 =>
  let hashed = policy.hash key
  let buckets = table.buckets
  let rows = table.rows
  let capacity = buckets.length - header_slots
  let mask = capacity - 1
  let at = hashed & mask
  for 0 .. capacity:
    let selected = buckets[at + header_slots]
    if selected == 0:
      return $Nothing
    if selected != tombstone:
      let row = rows[selected - 1]
      if row.hash == hashed:
        if let $Some (stored, _) = row.item:
          if policy.equal key stored:
            return $Some at
    at := (at + 1) & mask
  return $Nothing
func get policy -> key -> (table: Map [k, v]) => case locate policy key table of
  $Some at => do:
    let $Some (_, value) = table.rows[table.buckets[at + header_slots] - 1].item else:
      return panic "map bucket points at removed row"
    return $Some value
  $Nothing => $Nothing
func contains policy -> key -> (table: Map [k, v]) => Maybe.is_some (locate policy key table)
func rehash (capacity: U32) -> (table: own Map [k, v]) : Map [k, v] =>
  if capacity < 16 or capacity & (capacity - 1) != 0:
    return panic "map capacity must be a power of two"
  let $Map {rows, buckets} = table
  let kept: U32 = 0
  for i in 0 .. rows.length:
    let row = rows[i]
    if Maybe.is_some row.item:
      if kept != i:
        rows[kept] := row
      kept := self + 1
  @storage.truncate rows kept
  let slots = index_rows capacity rows
  return $Map {rows, buckets: slots}

private func index_rows (capacity: U32) -> (rows: #[Entry [k, v]]) : #[U32] =>
  let slots = @array.fill (header_slots + capacity) 0
  slots[0] := rows.length
  slots[1] := rows.length
  let mask = capacity - 1
  for i in 0 .. rows.length:
    let at = rows[i].hash & mask
    for 0 .. capacity:
      if slots[at + header_slots] == 0:
        slots[at + header_slots] := i + 1
        break
      at := (at + 1) & mask
  return slots

private func grow_index (capacity: U32) -> (table: own Map [k, v]) : Map [k, v] =>
  let $Map {rows, buckets} = table
  let slots = index_rows capacity rows
  return $Map {rows, buckets: slots}

// A fresh bulk builder can allocate its bucket index once. Bound speculative
// reservation for duplicate-heavy inputs; later growth follows the usual rule.
func reserve_batch (count: U32) -> (table: own Map [k, v]) : Map [k, v] =>
  let $Map { rows, buckets } = table
  let wanted = min count 65536
  if rows.length == 0 and wanted > 0:
    @storage.reserve rows wanted
  if rows.length > 0 or count <= (buckets.length - header_slots) / 2:
    return $Map { rows, buckets }
  let capacity = buckets.length - header_slots
  for 0 .. 32:
    if capacity / 2 >= wanted:
      break
    capacity := self * 2
  return grow_index capacity ($Map { rows, buckets })

func probe_set_raw policy -> key -> (hashed: U32) -> (table: Map [k, v]) : (U32, U32, U32) =>
  let buckets = table.buckets
  let rows = table.rows
  let capacity = buckets.length - header_slots
  let mask = capacity - 1
  let at = hashed & mask
  let first_tombstone = tombstone
  let empty_slot = tombstone
  for 0 .. capacity:
    let selected = buckets[at + header_slots]
    if selected == 0:
      empty_slot := at
      break
    if selected == tombstone:
      if first_tombstone == tombstone:
        first_tombstone := at
    else:
      let id = selected - 1
      let row = rows[id]
      if row.hash == hashed:
        if let $Some (stored, _) = row.item:
          if policy.equal key stored:
            return (id, first_tombstone, empty_slot)
    at := (at + 1) & mask
  return (tombstone, first_tombstone, empty_slot)
func probe_set policy -> key -> (hashed: U32) -> (table: Map [k, v]) : (Maybe U32, U32, U32) =>
  let (existing, first_tombstone, empty_slot) = probe_set_raw policy key hashed table
  return (if existing == tombstone then $Nothing else $Some existing, first_tombstone, empty_slot)
func replace_value (value: v) -> (item: Maybe (k, v)) : Maybe (k, v) => case item of
  $Some (stored, _) => $Some (stored, value)
  $Nothing => $Nothing
func set policy -> key -> value -> (table: own Map [k, v]) : Map [k, v] =>
  let hashed = policy.hash key
  let capacity = table.buckets.length - header_slots
  let primary = hashed & (capacity - 1)
  let live = table.buckets[0]
  let occupied = table.buckets[1]
  if table.buckets[primary + header_slots] == 0 and live < capacity / 2 and occupied < (capacity / 4) * 3:
    if table.rows.length >= tombstone - 1:
      return panic "map row identity exhausted"
    @storage.push table.rows ($Entry {hash: hashed, item: $Some (key, value)})
    table.buckets[primary + header_slots] := table.rows.length
    table.buckets[0] := live + 1
    table.buckets[1] := occupied + 1
    return table
  let (existing, first_tombstone, empty_slot) = probe_set_raw policy key hashed table
  if existing != tombstone:
    table.rows[existing].item := replace_value value self
    return table
  return insert_absent key value hashed first_tombstone empty_slot table

// Complete a failed lookup using its existing probe result.
func insert_absent key -> value -> (hashed: U32) -> (first_tombstone: U32) -> (empty_slot: U32) -> (table: own Map [k, v]) : Map [k, v] =>
  if table.rows.length >= tombstone - 1:
    return panic "map row identity exhausted"
  let capacity = table.buckets.length - header_slots
  let live = table.buckets[0]
  let occupied = table.buckets[1]
  let needs_grow = live >= capacity / 2
  let needs_clean = first_tombstone == tombstone and occupied + 1 > (capacity / 4) * 3
  if needs_grow or needs_clean:
    let next_capacity = if needs_grow then capacity * 2 else capacity
    if needs_grow and capacity > 0x40000000:
      return panic "map capacity exhausted"
    table := if needs_grow and table.rows.length == live then grow_index next_capacity table else rehash next_capacity table
    let new_cap = table.buckets.length - header_slots
    let new_mask = new_cap - 1
    let probe = hashed & new_mask
    for 0 .. new_cap:
      if table.buckets[probe + header_slots] == 0:
        @storage.push table.rows ($Entry {hash: hashed, item: $Some (key, value)})
        table.buckets[probe + header_slots] := table.rows.length
        table.buckets[0] := table.buckets[0] + 1
        table.buckets[1] := table.buckets[1] + 1
        return table
      probe := (probe + 1) & new_mask
    return panic "map probe invariant"
  let target = if first_tombstone != tombstone then first_tombstone else empty_slot
  if target == tombstone:
    return panic "map probe invariant"
  @storage.push table.rows ($Entry {hash: hashed, item: $Some (key, value)})
  table.buckets[target + header_slots] := table.rows.length
  table.buckets[0] := live + 1
  if first_tombstone == tombstone:
    table.buckets[1] := occupied + 1
  return table
func remove policy -> key -> (table: own Map [k, v]) : Map [k, v] =>
  if let $Some at = locate policy key table:
    let row_index = table.buckets[at + header_slots] - 1
    table.rows[row_index].item := $Nothing
    table.buckets[at + header_slots] := tombstone
    table.buckets[0] := table.buckets[0] - 1
  return table
func set_many policy -> (entries: #[(k, v)]) -> (table: own Map [k, v]) : Map [k, v] =>
  let count = entries.length
  if count == 0:
    return table
  table := reserve_batch count table
  let (first_key, first_value) = entries[0]
  table := set policy first_key first_value table
  for i in 1 .. count:
    let (key, value) = entries[i]
    table := set policy key value table
  return table
func remove_many policy -> keys -> (table: own Map [k, v]) : Map [k, v] =>
  if keys.length == 0:
    return table
  table := remove policy keys[0] table
  for index in 1 .. keys.length:
    table := remove policy keys[index] table
  return table
func from policy -> (entries: #[(k, v)]) -> (table: own Map [k, v]) : Map [k, v] => set_many policy entries table
func entries table =>
  let rows: #[Entry [k, v]] = table.rows
  let out: #[(k, v)] = @storage.with_capacity (count table)
  for row in rows:
    if let $Some item = row.item:
      @storage.push out item
  return out
func keys (table: Map [k, v]) =>
  let out: #[k] = @storage.with_capacity (count table)
  for row in table.rows:
    if let $Some (key, _) = row.item:
      @storage.push out key
  return out
func values table =>
  let rows: #[Entry [k, v]] = table.rows
  let out: #[v] = @storage.with_capacity (count table)
  for row in rows:
    if let $Some (_, value) = row.item:
      @storage.push out value
  return out
func fold reduce -> initial -> (table: Map [k, v]) =>
  let result = initial
  let count = table.rows.length
  for i in 0 .. count:
    if let $Some (key, value) = table.rows[i].item:
      result := reduce self key value
  return result
// Apply a known change policy to one key, returning the updated map.
func alter policy -> key -> change -> (table: own Map [k, v]) : Map [k, v] => case change (get policy key table) of
  $Some value => set policy key value table
  $Nothing => remove policy key table
func edit_many policy -> edits -> (table: own Map [k, v]) : Map [k, v] =>
  for (key, value) in edits:
    table := case value of
      $Some value => set policy key value table
      $Nothing => remove policy key table
  return table
func clear (table: own Map [k, v]) : Map [k, v] =>
  @storage.truncate table.rows 0
  for i in 0 .. table.buckets.length:
    table.buckets[i] := 0
  return table
private func copy_capacity (kept: U32) : U32 =>
  let capacity: U32 = 16
  for 0 .. 28:
    if kept <= capacity / 2:
      break
    capacity := self * 2
  return capacity
func copy_into policy -> copy_key -> copy_value -> (destination: own Map [k, v]) -> (source: Map [k, v]) : Map [k, v] =>
  let $Map { rows, buckets } = destination
  let src_rows = source.rows
  let n = src_rows.length
  if n > 0 and rows.length == 0 and buckets.length == header_slots + 16 and n == source.buckets[0]:
    let fresh: #[Entry [k, v]] = @array.generate n (func i =>
      let $Some (key, value) = src_rows[i].item else:
        return panic "dense map contains a removed row"
      let ck = copy_key key
      let cv = copy_value value
      return $Entry {hash: policy.hash ck, item: $Some (ck, cv)})
    let slots = index_rows (copy_capacity n) fresh
    return $Map {rows: fresh, buckets: slots}
  @storage.truncate rows 0
  @storage.reserve rows source.buckets[0]
  for row in src_rows:
    if let $Some (key, value) = row.item:
      let ck = copy_key key
      let cv = copy_value value
      @storage.push rows ($Entry { hash: policy.hash ck, item: $Some (ck, cv) })
  let kept = rows.length
  let capacity = copy_capacity kept
  let needed = header_slots + capacity
  if buckets.length < needed:
    let slots = index_rows capacity rows
    return $Map {rows, buckets: slots}
  if buckets.length > needed:
    @storage.truncate buckets needed
  for i in 0 .. needed:
    buckets[i] := 0
  buckets[0] := kept
  buckets[1] := kept
  let mask = capacity - 1
  for i in 0 .. kept:
    let at = rows[i].hash & mask
    for 0 .. capacity:
      if buckets[at + header_slots] == 0:
        buckets[at + header_slots] := i + 1
        break
      at := (at + 1) & mask
  return $Map { rows, buckets }
func popcount (word: U32) =>
  let bits = word - ((word >> 1) & 0x55555555)
  bits := (self & 0x33333333) + ((self >> 2) & 0x33333333)
  bits := (self + (self >> 4)) & 0x0F0F0F0F
  return (bits * 0x01010101) >> 24
