import * as graph from "./graph"
import * as spatial from "./spatial"
import * as joints from "./joints"
import * as array from "std/array"
import { Vec3 } from "std/vector"
import { Quat } from "./math"
import * as math from "./math"
import * as shapes from "./shapes"
import * as contact from "./contact"
import * as scene from "./scene"
import * as rigid from "./rigid"
import * as character from "./character"
import * as sort from "./sort"
import { Proxy, Rigid, Scene, Source, Walker } from "./scene"

// Characters move first; rigid solving updates the caller-owned contact cache.
// Source order and ascending U32 contact ids keep simulation deterministic.

type Config is data = $Config {
  gravity: Vec3,
  substeps: U32,
  sleep_time: F32,
  linear_sleep: F32,
  angular_sleep: F32,
}

// What a step changed on one source.
type Result is data = $Result {
  source: U32,
  position: Vec3,
  rotation: Quat,
  rigid: Maybe Rigid,
  walker: Maybe Walker,
}

// Caller-owned warm-start state. Entity ids remain U32 throughout simulation.
type CachedContact is data = $CachedContact {
  a: U32,
  b: U32,
  point: Vec3,
  normal: Vec3,
  normal_impulse: F32,
  tangent_impulse: Vec3,
}
// Cache is a read for one operation; no owning aggregate crosses a tick.
type Cache is data = $Cache { contacts: &[CachedContact] }
type CacheAccess is data = $CacheAccess {first_active: Bool, first: ResizeArray CachedContact, second: ResizeArray CachedContact}
type StepAccess is data = $StepAccess {sources: ResizeArray scene.SourceRow, geometry: shapes.Geometry, cache: CacheAccess, results: ResizeArray Result}
func read_cache (cache: CacheAccess) => return
  $Cache {contacts: if cache.first_active then cache.first.view 0 cache.first.length else cache.second.view 0 cache.second.length}
// Explicit snapshots/seed inputs require an independent destination owner.
func copy_cache_into (source: Cache) -> (destination: ResizeArray CachedContact) => return do:
  destination.truncate 0
  for contact in source.contacts:
    destination.push contact
func seed_cache_into (contacts: &[CachedContact]) -> (cache: own CacheAccess) : CacheAccess => return do:
  copy_cache_into ($Cache {contacts}) cache.first
  cache.second.truncate 0
  cache.first_active := true
  return cache
func load_sources_into (values: Array Source) -> (step: own StepAccess) : StepAccess => return do:
  shapes.clear step.geometry
  step.sources.truncate 0
  for value in values:
    step.sources.push (scene.pack_source step.geometry value)
  step.cache.first.truncate 0
  step.cache.second.truncate 0
  step.cache.first_active := true
  step.results.truncate 0
  return step
func source (step: StepAccess) -> (index: U32) => return scene.unpack_source step.geometry step.sources[index]
// The materialized Source array is invocation scratch. All nested views borrow
// the older named geometry owners; the known consumer finishes before it dies.
func with_sources (step: StepAccess) -> consume => return do:
  let values = scene.source_values step.geometry (step.sources.view 0 step.sources.length)
  return consume values
func apply_into (step: own StepAccess) : StepAccess => return do:
  for i in 0 .. step.results.length:
    let result = step.results[i]
    let row = step.sources[result.source]
    row.position := result.position
    row.rotation := result.rotation
    if let $Some body = result.rigid:
      row.rigid := $Some body
    if let $Some walker = result.walker:
      row.walker := $Some walker
    step.sources[result.source] := row
  return step
const default_config = $Config {
  gravity: math.vec3 0.0 (-9.81) 0.0,
  substeps: 4,
  sleep_time: 0.5,
  linear_sleep: 0.05,
  angular_sleep: 0.05,
}

const no_slot = 0.0 - 1.0

func rigid_of (source: Source) => return case source.rigid of
  $Some r => r
  $Nothing => $scene.Rigid {
    kind: $scene.Static,
    mass: 1.0,
    gravity_scale: 1.0,
    linear_damping: 0.0,
    angular_damping: 0.0,
    can_sleep: true,
    continuous: false,
    linear_velocity: math.zero3,
    angular_velocity: math.zero3,
    sleeping: false,
    sleep_time: 0.0,
  }

// The velocity a proxy moves with this step.
func velocity_of (sources: Array Source) => return func (proxy: Proxy) => return do:
  let source = sources[proxy.source]
  if proxy.walker:
    let $Some w = source.walker else:
      return math.zero3
    return w.velocity
  return (rigid_of source).linear_velocity

func is_mover (proxy: Proxy) => return proxy.kind >= scene.kind_kinematic and Bool.not proxy.trigger

// Which proxies are movers: kinematic and dynamic bodies, in order.
func mover_ids (proxies: Array Proxy) => return do:
  let found = @array.fill proxies.length 0
  let count = 0
  for i in 0..proxies.length:
    if is_mover proxies[i]:
      found[count] := i
      count := self + 1
  return @array.generate count (func (k: U32) => return found[k])

// Broad phase ------------------------------------------------------------------------

func layers_meet (a: Proxy) => return func (b: Proxy) => return
  (a.layer & b.mask) != 0 and (b.layer & a.mask) != 0

// Sweep active movers along their widest axis; binary-search static bounds.
func broad_phase proxies -> movers -> grow -> active => return broad_phase_with $Nothing proxies movers grow active
// Reuse the caller's scene index. It must describe the current proxy bounds,
// including controller/CCD shifts. Active sweeps still use both travel margins.
func broad_phase_indexed index -> proxies -> movers -> grow -> active => return broad_phase_with ($Some index) proxies movers grow active
func broad_phase_with (index: Maybe spatial.Index) -> (proxies: Array Proxy) -> (movers: Array U32) -> (grow: Array F32) -> (active: Array F32) => return do:
  let m = movers.length
  let lo = @array.fill (m * 3) 0.0
  let hi = @array.fill (m * 3) 0.0
  let mine: GrowArray U32 = #[]
  for k in 0..m:
    if active[movers[k]] > 0.0:
      mine.push k
      let p = proxies[movers[k]]
      let g = grow[k]
      lo[k * 3] := p.low.x - g
      lo[k * 3 + 1] := p.low.y - g
      lo[k * 3 + 2] := p.low.z - g
      hi[k * 3] := p.high.x + g
      hi[k * 3 + 1] := p.high.y + g
      hi[k * 3 + 2] := p.high.z + g
  let live = (@storage.freeze mine)
  let n = live.length
  if n == 0:
    return #[]
  let found: GrowArray U32 = #[]
  // Sweep along the axis where the active movers spread most.
  let mx = 0.0
  let my = 0.0
  let mz = 0.0
  for t in 0..n:
    let k = live[t]
    mx := self + lo[k * 3] + hi[k * 3]
    my := self + lo[k * 3 + 1] + hi[k * 3 + 1]
    mz := self + lo[k * 3 + 2] + hi[k * 3 + 2]
  let inv = 0.5 / U32.to_f32 n
  let vx = 0.0
  let vy = 0.0
  let vz = 0.0
  for t in 0..n:
    let k = live[t]
    let dx = (lo[k * 3] + hi[k * 3]) * 0.5 - mx * inv
    let dy = (lo[k * 3 + 1] + hi[k * 3 + 1]) * 0.5 - my * inv
    let dz = (lo[k * 3 + 2] + hi[k * 3 + 2]) * 0.5 - mz * inv
    vx := self + dx * dx
    vy := self + dy * dy
    vz := self + dz * dz
  let axis = 2
  if vy >= vz:
    axis := 1
  if vx >= vy and vx >= vz:
    axis := 0
  let keys = @array.generate n (func (t: U32) => return lo[live[t] * 3 + axis])
  let order = sort.order keys
  // Find each sweep interval's end before collecting pairs. Early loop exits
  // make the compiler copy the growing list on every append.
  for oi in 0..n:
    let i = live[order[oi]]
    let reach = hi[i * 3 + axis]
    let first = oi + 1
    let last = n
    for 0..32:
      if first < last:
        let mid = (first + last) / 2
        if lo[live[order[mid]] * 3 + axis] <= reach:
          first := mid + 1
        else:
          last := mid
    for oj in (oi + 1)..first:
      let j = live[order[oj]]
      if lo[i * 3] <= hi[j * 3] and hi[i * 3] >= lo[j * 3] and lo[i * 3 + 1] <= hi[j * 3 + 1] and hi[i * 3 + 1] >= lo[j * 3 + 1] and lo[i * 3 + 2] <= hi[j * 3 + 2] and hi[i * 3 + 2] >= lo[j * 3 + 2]:
        let pi = proxies[movers[i]]
        let pj = proxies[movers[j]]
        if (pi.kind == scene.kind_dynamic or pj.kind == scene.kind_dynamic) and layers_meet pi pj:
          let first = movers[i]
          let second = movers[j]
          found.push first
          found.push second
  // Active movers against everything at rest.
  let nr = 0
  for s in 0..proxies.length:
    if active[s] == 0.0 and Bool.not proxies[s].trigger:
      nr := self + 1
  // Small resting sets amortize no tree traversal. Private solver work scenes
  // may deliberately have no index, so retain the ordinary sweep fallback.
  let indexed = false
  if nr >= 64:
    if let $Some index = index:
      if index.order.length != proxies.length:
        return @panic "physics broad-phase index count mismatch"
      for t in 0 .. n:
        let k = live[t]
        let pm = proxies[movers[k]]
        let low = math.vec3 lo[k * 3] lo[k * 3 + 1] lo[k * 3 + 2]
        let high = math.vec3 hi[k * 3] hi[k * 3 + 1] hi[k * 3 + 2]
        for source in spatial.query index low high:
          let ps = proxies[source]
          if active[source] == 0.0 and Bool.not ps.trigger and (pm.kind == scene.kind_dynamic or ps.kind == scene.kind_dynamic) and layers_meet pm ps and overlap_bounds lo hi k ps:
            found.push movers[k]
            found.push source
      indexed := true
  if nr > 0 and Bool.not indexed:
    let rest_ids: Array U32 = array.fill nr 0
    let rest_count: U32 = 0
    for source in 0 .. proxies.length:
      if active[source] == 0.0 and Bool.not proxies[source].trigger:
        rest_ids[rest_count] := source
        rest_count := self + 1
    let order_r = sort.order (@array.generate nr (func (t: U32) => return proxies[rest_ids[t]].low.x))
    let sorted = @array.generate nr (func (t: U32) => return rest_ids[order_r[t]])
    let low_x = @array.generate nr (func (t: U32) => return proxies[sorted[t]].low.x)
    let reach_x = @array.fill nr 0.0
    let running = (-1000000000.0)
    for t in 0..nr:
      running := max self proxies[sorted[t]].high.x
      reach_x[t] := running
    for t in 0..n:
      let k = live[t]
      let pm = proxies[movers[k]]
      // First resting proxy whose running maximum reaches the mover, and the
      // first whose low x is beyond it.
      let first = 0
      let last = nr
      for 0..32:
        if first < last:
          let mid = (first + last) / 2
          if reach_x[mid] < lo[k * 3]:
            first := mid + 1
          else:
            last := mid
      let begin = first
      first := 0
      last := nr
      for 0..32:
        if first < last:
          let mid = (first + last) / 2
          if low_x[mid] <= hi[k * 3]:
            first := mid + 1
          else:
            last := mid
      for u in begin..first:
        let ps = proxies[sorted[u]]
        if (pm.kind == scene.kind_dynamic or ps.kind == scene.kind_dynamic) and layers_meet pm ps and overlap_bounds lo hi k ps:
          let first_proxy = movers[k]
          let second_proxy = sorted[u]
          found.push first_proxy
          found.push second_proxy
  return (@storage.freeze found)

func overlap_bounds (lo: Array F32) => return func (hi: Array F32) => return func (k: U32) => return func (p: Proxy) => return
  lo[k * 3] <= p.high.x and hi[k * 3] >= p.low.x and lo[k * 3 + 1] <= p.high.y and hi[k * 3 + 1] >= p.low.y and lo[k * 3 + 2] <= p.high.z and hi[k * 3 + 2] >= p.low.z

// The pairs sorted by the smaller entity id, then the larger, and each pair
// ordered the same way. Input and output are flat proxy index lists.
func canonical_pairs (proxies: Array Proxy) => return func (rank: Array U32) => return func (pairs: Array U32) => return do:
  let count = pairs.length / 2
  let np = proxies.length
  let first = @array.generate count (func (p: U32) => return do:
    let a = pairs[p * 2]
    let b = pairs[p * 2 + 1]
    if rank[a] < rank[b]:
      return a
    return b)
  let second = @array.generate count (func (p: U32) => return do:
    let a = pairs[p * 2]
    let b = pairs[p * 2 + 1]
    if rank[a] < rank[b]:
      return b
    return a)
  if np <= 65535:
    let order = sort.order_u32 (@array.generate count (func (p: U32) => return rank[first[p]] * np + rank[second[p]]))
    return @array.generate (count * 2) (func (k: U32) => return do:
      let p = order[k / 2]
      if k % 2 == 0:
        return first[p]
      return second[p])
  let by_second = sort.order_u32 (@array.generate count (func (p: U32) => return proxies[second[p]].id))
  let by_first = sort.order_u32 (@array.generate count (func (p: U32) => return proxies[first[by_second[p]]].id))
  return @array.generate (count * 2) (func (k: U32) => return do:
    let p = by_second[by_first[k / 2]]
    if k % 2 == 0:
      return first[p]
    return second[p])

// Index of the first cache row for the pair (a, b), or the length if absent.
func cache_find (cache: Cache) => return func (a: U32) => return func (b: U32) => return do:
  let low = 0
  let high = cache.contacts.length
  for 0..32:
    if low >= high:
      break
    let mid = (low + high) / 2
    let c = cache.contacts[mid]
    if c.a < a or (c.a == a and c.b < b):
      low := mid + 1
    else:
      high := mid
  return low

// Reuse the nearest cached impulse for this exact entity pair: the normal
// impulse and the tangential impulse's x, y and z.
func cache_match (cache: Cache) => return func (a: U32) => return func (b: U32) => return func (px: F32) => return func (py: F32) => return func (pz: F32) => return do:
  let rows = cache.contacts.length
  let i = cache_find cache a b
  let best = 0.0225
  let jn = 0.0
  let jtx = 0.0
  let jty = 0.0
  let jtz = 0.0
  for 0..rows:
    if i >= rows:
      break
    let c = cache.contacts[i]
    if c.a != a or c.b != b:
      break
    let dx = c.point.x - px
    let dy = c.point.y - py
    let dz = c.point.z - pz
    let d = dx * dx + dy * dy + dz * dz
    if d < best:
      best := d
      jn := c.normal_impulse
      jtx := c.tangent_impulse.x
      jty := c.tangent_impulse.y
      jtz := c.tangent_impulse.z
    i := self + 1
  return (jn, jtx, jty, jtz)

func proxy_with_id (proxies: Array Proxy) => return func (by_id: Array U32) => return func (id: U32) => return do:
  let low = 0
  let high = by_id.length
  for 0..32:
    if low >= high:
      break
    let mid = (low + high) / 2
    if proxies[by_id[mid]].id < id:
      low := mid + 1
    else:
      high := mid
  if low < by_id.length and proxies[by_id[low]].id == id:
    return by_id[low]
  return proxies.length


// The first proxy with entity id `id`, or the proxy count, by binary search
// of `ids` (each proxy's id) in the stable ascending order `by_id`.
func index_of_id (ids: Array U32) => return func (by_id: Array U32) => return func (id: U32) => return do:
  let low = 0
  let high = by_id.length
  for 0..32:
    if low < high:
      let mid = (low + high) / 2
      if ids[by_id[mid]] < id:
        low := mid + 1
      else:
        high := mid
  if low < by_id.length and ids[by_id[low]] == id:
    return by_id[low]
  return ids.length

// Solver -----------------------------------------------------------------------------

type Island is data = $Island { parent: Array U32 }

func root_of (parent: Array U32) => return func (i: U32) => return do:
  let r = i
  for 0..parent.length:
    let p = parent[r]
    if p == r:
      break
    r := p
  return r

// Advance the rigid bodies by dt. `scene` holds the proxies; `sources` the
// matching entity data. Returns results for the bodies that moved and the new
// contact cache.
func contact_substeps (substeps: U32) => return func (row_array: Array F32) => return func (inv_mass: Array F32) => return func (pos: Array F32) => return do:
  // Height-ordered support chains need stiffer contacts above twelve bodies.
  let total = row_array.length / rigid.stride
  let m = inv_mass.length
  let under = @array.fill total 0
  let over = @array.fill total 0
  let heights = @array.fill total 0.0
  let supports = 0
  for c in 0..total:
    let o = c * rigid.stride
    let a = row_array[o]
    let b = row_array[o + 1]
    if a >= 0.0 and b >= 0.0:
      let ka = F32.to_u32 a
      let kb = F32.to_u32 b
      if inv_mass[ka] > 0.0 and inv_mass[kb] > 0.0:
        let ny = row_array[o + 3]
        if ny > 0.7:
          under[supports] := ka
          over[supports] := kb
          heights[supports] := pos[ka * 3 + 1]
          supports := self + 1
        if ny < (-0.7):
          under[supports] := kb
          over[supports] := ka
          heights[supports] := pos[kb * 3 + 1]
          supports := self + 1
  let depth = @array.fill m 1
  let deepest = 1
  if supports >= 11:
    let by_height = sort.order (@array.generate supports (func (i: U32) => return heights[i]))
    for r in 0..supports:
      let row = by_height[r]
      let reached = depth[under[row]] + 1
      if reached > depth[over[row]]:
        depth[over[row]] := reached
        deepest := max self reached
  if deepest >= 30:
    return min 16 (substeps * 4)
  if deepest >= 12:
    return min 16 (substeps * 2)
  return substeps

func prepare_joints (joint_list: Array joints.Joint) => return func (sources: Array Source) => return func (sc: Scene) => return func (slot_of: Array F32) => return do:
  let prepared: GrowArray joints.Link = #[]
  for joint in joint_list:
    if joint.a < sources.length and joint.b < sources.length and joints.valid joint:
      let a = sources[joint.a]
      let b = sources[joint.b]
      let slot_a = no_slot
      let slot_b = no_slot
      let proxy_a = sc.slots[joint.a]
      let proxy_b = sc.slots[joint.b]
      if proxy_a < slot_of.length:
        slot_a := slot_of[proxy_a]
      if proxy_b < slot_of.length:
        slot_b := slot_of[proxy_b]
      let body_a = rigid_of a
      let body_b = rigid_of b
      prepared.push $joints.Link { joint, a: slot_a, b: slot_b, position_a: a.position, position_b: b.position, rotation_a: a.rotation, rotation_b: b.rotation, velocity_a: body_a.linear_velocity, velocity_b: body_b.linear_velocity, angular_a: body_a.angular_velocity, angular_b: body_b.angular_velocity }
  return (@storage.freeze prepared)

func with_sleep_islands (config: Config) => return func (dt: F32) => return func (sources: Array Source) => return func (proxies: Array Proxy) => return func (movers: Array U32) => return func (connected: Array U32) => return func (inv_mass: Array F32) => return func (row_array: Array F32) => return func (new_vel: Array F32) -> consume => return do:
  // Sleeping: islands of touching awake bodies sleep together once all of
  // them have been still for long enough.
  let m = movers.length
  let count = row_array.length / rigid.stride
  let parent = @array.generate m (func (k: U32) => return k)
  let sizes = @array.fill m 1
  for c in 0..count:
    let o = c * rigid.stride
    let a = row_array[o]
    let b = row_array[o + 1]
    if a >= 0.0 and b >= 0.0:
      let ka = F32.to_u32 a
      let kb = F32.to_u32 b
      if inv_mass[ka] > 0.0 and inv_mass[kb] > 0.0:
        // Find both roots inline: handing `parent` to a function would make
        // the union's writes below copy it.
        let ra = ka
        for 0..m:
          let up = parent[ra]
          if up == ra:
            break
          ra := up
        let rb = kb
        for 0..m:
          let up = parent[rb]
          if up == rb:
            break
          rb := up
        if ra != rb:
          // Size weighting bounds root walks even for dense canonical pairs.
          let size_a = sizes[ra]
          let size_b = sizes[rb]
          let smaller = ra
          let larger = rb
          if size_a > size_b or (size_a == size_b and ra < rb):
            smaller := rb
            larger := ra
          parent[smaller] := larger
          sizes[larger] := size_a + size_b
  let still = @array.fill m 0.0
  let island_time = @array.fill m 1000000.0
  for k in 0..m:
    if inv_mass[k] > 0.0:
      let proxy = proxies[movers[k]]
      let body = rigid_of sources[proxy.source]
      let v = k * 6
      let lin = sqrt (new_vel[v] * new_vel[v] + new_vel[v + 1] * new_vel[v + 1] + new_vel[v + 2] * new_vel[v + 2])
      let ang = sqrt (new_vel[v + 3] * new_vel[v + 3] + new_vel[v + 4] * new_vel[v + 4] + new_vel[v + 5] * new_vel[v + 5])
      let quiet = lin < config.linear_sleep and (ang < config.angular_sleep or ang * proxy.inscribed < config.linear_sleep) and body.can_sleep and connected[proxy.source] == 0
      let time = 0.0
      if quiet:
        time := body.sleep_time + dt
      still[k] := time
      let root = root_of parent k
      island_time[root] := min island_time[root] time
  return consume parent still island_time

func with_bodies (sources: Array Source) => return func (proxies: Array Proxy) => return func (movers: Array U32) => return func (origins: Array Vec3) => return func (velocities: Array Vec3) => return func (woke: Array F32) -> consume => return do:
  let np = proxies.length
  let m = movers.length
  let slot_of = @array.fill np no_slot
  for k in 0..m:
    slot_of[movers[k]] := U32.to_f32 k
  let pos = @array.fill (m * 3) 0.0
  let rot = @array.fill (m * 4) 0.0
  let vel = @array.fill (m * 6) 0.0
  let inv_mass = @array.fill m 0.0
  let inv_inertia = @array.fill (m * 3) 0.0
  let gravity_scale = @array.fill m 0.0
  let linear_damping = @array.fill m 0.0
  let angular_damping = @array.fill m 0.0
  for k in 0..m:
    let proxy = proxies[movers[k]]
    let source = sources[proxy.source]
    let body = rigid_of source
    pos[k * 3] := origins[movers[k]].x
    pos[k * 3 + 1] := origins[movers[k]].y
    pos[k * 3 + 2] := origins[movers[k]].z
    rot[k * 4] := source.rotation.x
    rot[k * 4 + 1] := source.rotation.y
    rot[k * 4 + 2] := source.rotation.z
    rot[k * 4 + 3] := source.rotation.w
    let v = velocities[movers[k]]
    vel[k * 6] := v.x
    vel[k * 6 + 1] := v.y
    vel[k * 6 + 2] := v.z
    vel[k * 6 + 3] := body.angular_velocity.x
    vel[k * 6 + 4] := body.angular_velocity.y
    vel[k * 6 + 5] := body.angular_velocity.z
    if proxy.kind == scene.kind_dynamic and woke[movers[k]] > 0.0:
      let mass = max 0.0001 body.mass
      inv_mass[k] := 1.0 / mass
      inv_inertia[k * 3] := 1.0 / (mass * max 0.00001 proxy.inertia.x)
      inv_inertia[k * 3 + 1] := 1.0 / (mass * max 0.00001 proxy.inertia.y)
      inv_inertia[k * 3 + 2] := 1.0 / (mass * max 0.00001 proxy.inertia.z)
      gravity_scale[k] := body.gravity_scale
      linear_damping[k] := body.linear_damping
      angular_damping[k] := body.angular_damping
  let bodies = $rigid.Bodies { pos, rot, vel, inv_mass, inv_inertia, gravity_scale, linear_damping, angular_damping }
  return consume bodies slot_of

func with_contacts (dt: F32) => return func (proxies: Array Proxy) => return func (velocities: Array Vec3) => return func (woke: Array F32) => return func (by_id: Array U32) => return func (candidates: Array U32) => return func (bodies: rigid.Bodies) => return func (slot_of: Array F32) => return func (cache: Cache) -> consume => return do:
  let np = proxies.length
  let rank = @array.fill np 0
  for t in 0..np:
    rank[by_id[t]] := t
  let pairs = canonical_pairs proxies rank candidates
  let iw0 = rigid.inertia_table bodies.rot bodies.inv_inertia
  // Find every pair's contacts first, so the row tables are allocated at
  // their exact size.
  let pair_count = pairs.length / 2
  // How far each pair closes during the step.
  let closing = @array.generate pair_count (func (p: U32) => return do:
    let va = velocities[pairs[p * 2]]
    let vb = velocities[pairs[p * 2 + 1]]
    let dx = va.x - vb.x
    let dy = va.y - vb.y
    let dz = va.z - vb.z
    return sqrt (dx * dx + dy * dy + dz * dz) * dt)
  let contact_starts: Array U32 = @array.fill (pair_count + 1) 0
  let contact_rows: GrowArray contact.Contact = #[]
  for p in 0 .. pair_count:
    let ia = pairs[p * 2]
    let ib = pairs[p * 2 + 1]
    if woke[ia] > 0.0 or woke[ib] > 0.0:
      let found = contact.between proxies[ia].shape proxies[ib].shape (0.02 + closing[p])
      for value in found:
        @storage.push contact_rows value
    contact_starts[p + 1] := contact_rows.length
  let found: Array contact.Contact = @storage.freeze contact_rows
  // Omit contacts that cannot close during this step.
  let reach = @array.generate pair_count (func (p: U32) => return 0.008 + closing[p])
  let used = 0
  for p in 0..pair_count:
    let limit = reach[p]
    for at in contact_starts[p] .. contact_starts[p + 1]:
      let c = found[at]
      if c.sep <= limit:
        used := self + 1
  let row_buf = @array.fill (used * rigid.stride) 0.0
  let imp_buf = @array.fill (used * rigid.impulse_stride) 0.0
  let row_a_ids = @array.fill used 0
  let row_b_ids = @array.fill used 0
  let r = 0
  for p in 0..pair_count:
    let ia = pairs[p * 2]
    let ib = pairs[p * 2 + 1]
    let pa = proxies[ia]
    let pb = proxies[ib]
    let a = slot_of[ia]
    let b = slot_of[ib]
    let friction = sqrt (pa.friction * pb.friction)
    let restitution = max pa.restitution pb.restitution
    let limit = reach[p]
    for at in contact_starts[p] .. contact_starts[p + 1]:
      let c = found[at]
      if c.sep <= limit:
        let point = c.point
        let normal = c.normal
        let row = rigid.prepare_row_xyz bodies iw0 a b normal.x normal.y normal.z point.x point.y point.z c.sep friction restitution
        let (jn, jtx, jty, jtz) = cache_match cache pa.id pb.id point.x point.y point.z
        let ro = r * rigid.stride
        for k in 0..rigid.stride:
          row_buf[ro + k] := row[k]
        row_a_ids[r] := pa.id
        row_b_ids[r] := pb.id
        let io = r * rigid.impulse_stride
        imp_buf[io] := jn
        imp_buf[io + 1] := jtx * row[17] + jty * row[18] + jtz * row[19]
        imp_buf[io + 2] := jtx * row[20] + jty * row[21] + jtz * row[22]
        r := self + 1
  return consume row_buf imp_buf row_a_ids row_b_ids

// Results for the woken dynamic bodies, in mover order, gathered by index
// into an exactly sized array: appending records to a List one at a time
// costs more with every append.
func moved_results (config: Config) => return func (sources: Array Source) => return func (proxies: Array Proxy) => return func (movers: Array U32) => return func (woke: Array F32) => return func (parent: Array U32) => return func (island_time: Array F32) => return func (still: Array F32) => return func (new_pos: Array F32) => return func (new_rot: Array F32) => return func (new_vel: Array F32) => return do:
  let m = movers.length
  let slots = @array.fill m 0
  let count = 0
  for k in 0..m:
    let idx = movers[k]
    if proxies[idx].kind == scene.kind_dynamic and woke[idx] > 0.0:
      slots[count] := k
      count := self + 1
  return @array.generate count (func (r: U32) => return do:
    let k = slots[r]
    let proxy = proxies[movers[k]]
    let body = rigid_of sources[proxy.source]
    let root = root_of parent k
    let sleep_now = island_time[root] >= config.sleep_time
    let v = k * 6
    let lin = if sleep_now then math.zero3 else $Vec3 { x: new_vel[v], y: new_vel[v + 1], z: new_vel[v + 2] }
    let ang = if sleep_now then math.zero3 else $Vec3 { x: new_vel[v + 3], y: new_vel[v + 4], z: new_vel[v + 5] }
    let updated = $scene.Rigid {
      kind: body.kind, mass: body.mass, gravity_scale: body.gravity_scale,
      linear_damping: body.linear_damping, angular_damping: body.angular_damping,
      can_sleep: body.can_sleep, continuous: body.continuous,
      linear_velocity: lin, angular_velocity: ang,
      sleeping: sleep_now, sleep_time: still[k],
    }
    return $Result {
      source: proxy.source,
      position: rigid.vec new_pos (k * 3),
      rotation: rigid.quat new_rot (k * 4),
      rigid: $Some updated,
      walker: $Nothing,
    })

// A controller pass belongs to one scene snapshot, query set and timestep.
// Fixed-only geometry is appended within with_extended_walkers. The consumer
// also receives the working geometry the proxies' shapes live in.
type Walkers is data = $Walkers {
  proxies: Array Proxy, origins: Array Vec3, velocities: Array Vec3,
  ids: Array U32, by_id: Array U32, walked: Array U32, walked_at: Array Vec3,
  walked_state: Array Walker, wake_by_push: Array F32, shifted: GrowArray U32,
}
func capsule_of (shape: shapes.Shape) => return case shape of
  $shapes.Capsule { a, b, radius } => $Some (a, b, radius)
  _ => $Nothing
func with_walkers (queries: scene.Queries) -> (sources: Array Source) -> (sc: Scene) -> (dt: F32) -> consume => return
  shapes.with_geometry (func geometry => return do:
    let np = scene.count sc
    let original = scene.proxies sc
    // Mutable proxy rows must know the working geometry roots before their
    // first read. Copy movable payloads exactly; fixed scenery stays borrowed.
    let proxy_rows: GrowArray Proxy = #[]
    for i in 0 .. np:
      let value = original[i]
      if value.walker or value.kind == scene.kind_dynamic:
        value.shape := shapes.copy geometry value.shape
      proxy_rows.push value
    let proxies: Array Proxy = @storage.freeze proxy_rows
    let origins = @array.fill np math.zero3
    let velocities = @array.fill np math.zero3
    let angulars = @array.fill np math.zero3
    for i in 0..np:
      let p = proxies[i]
      origins[i] := sources[p.source].position
      if p.kind >= scene.kind_kinematic:
        velocities[i] := velocity_of sources p
        if Bool.not p.walker:
          angulars[i] := (rigid_of sources[p.source]).angular_velocity
    let ids = @array.generate np (func (i: U32) => return original[i].id)
    let by_id = sort.order_u32 ids
    // Characters move first, on the world as it stood; they shove dynamic
    // bodies they walk into and leave their motion as a velocity for the solver.
    // Results stay with this step, including pushes and the original walk pose.
    let walked = @array.fill np 0
    let walked_at = @array.fill np math.zero3
    let walked_state = @array.fill np scene.default_walker
    let wake_by_push = @array.fill np 0.0
    let shifted: GrowArray U32 = #[]
    for i in 0..np:
      if proxies[i].walker and Bool.not proxies[i].trigger:
        let source = sources[proxies[i].source]
        if let $Some walker = source.walker:
          if let $Some (a, b, radius) = capsule_of proxies[i].shape:
            let body = $character.Body { low: a - source.position, high: b - source.position, radius }
            let filter = $scene.Filter { mask: proxies[i].mask, skip: proxies[i].id, triggers: false, walkers: false, dynamics: true }
            let under = if walker.ground == 0 then np else index_of_id ids by_id walker.ground
            // How far the platform underfoot moved this step: its translation
            // plus the turn about its own origin, at the character's feet.
            let carry = math.zero3
            if walker.grounded and under < np:
              let platform = proxies[under]
              if platform.kind != scene.kind_static:
                let origin = sources[platform.source].position
                carry := (velocities[under] + angulars[under].cross (source.position - origin)) * dt
            let motion_hits: GrowArray scene.Hit = #[]
            let moved = character.move_queries motion_hits queries body filter source.position walker carry dt
            let shift = moved.position - source.position
            proxies[i] := scene.shifted geometry self shift
            if shift.x != 0.0 or shift.y != 0.0 or shift.z != 0.0:
              shifted.push i
            origins[i] := moved.position
            velocities[i] := shift / dt
            for h in moved.hits:
              if h.proxy < np:
                let other = proxies[h.proxy]
                if other.kind == scene.kind_dynamic and Bool.not other.trigger:
                  let away = shapes.neg h.normal
                  let approach = max 0.0 (away.dot walker.velocity)
                  let current = velocities[h.proxy].dot away
                  let extra = max 0.0 (approach * walker.push - current)
                  velocities[h.proxy] := velocities[h.proxy] + away * extra
                  if extra > 0.0:
                    wake_by_push[h.proxy] := 1.0
            walked[i] := 1
            walked_at[i] := moved.position
            walked_state[i] := moved.walker
    let walk = $Walkers {proxies, origins, velocities, ids, by_id, walked, walked_at, walked_state, wake_by_push, shifted}
    return consume geometry (own walk))


// The prepared-static adapter appends immutable fixed proxies to the moving
// prefix after neighborhood selection. Their controllers and velocities are empty.
func with_extended_walkers (walk: own Walkers) -> (sources: Array Source) -> (sc: Scene) -> consume => return do:
  let original = scene.proxies sc
  let first = walk.proxies.length
  if first > original.length:
    return @panic "walker prefix exceeds scene"
  let extra = original.length - first
  if extra == 0:
    return consume (own walk)
  walk.proxies := array.concat self (array.slice first extra original)
  walk.origins := array.concat self (array.generate extra (func i => return sources[original[first + i].source].position))
  walk.velocities := array.concat self (array.fill extra math.zero3)
  walk.walked := array.concat self (array.fill extra 0)
  walk.walked_at := array.concat self (array.fill extra math.zero3)
  walk.walked_state := array.concat self (array.fill extra scene.default_walker)
  walk.wake_by_push := array.concat self (array.fill extra 0.0)
  walk.ids := array.generate original.length (func i => return original[i].id)
  walk.by_id := sort.order_u32 walk.ids
  return consume (own walk)

// The simulate functions that are lent the step return whether they solved.
// A solve reads one cache bank and leaves the next contacts in the other; the
// step's owner then switches the selector with `swap_cache`.
func simulate_queries_into (queries: scene.Queries) -> (joint_list: Array joints.Joint) -> (config: Config) -> (dt: F32) -> (sources: Array Source) -> (sc: Scene) -> (step: StepAccess) : Bool => return do:
  if Bool.not (dt > 0.0 and dt - dt == 0.0):
    step.results.truncate 0
    return false
  return with_walkers queries sources sc dt (func geometry -> (own walk) => return
    simulate_walked_into queries joint_list config dt sources sc step geometry walk)

// `walk` must be the controller pass for this scene's current proxy prefix,
// with any fixed-only suffix added through with_extended_walkers.
func simulate_walked_into (queries: scene.Queries) -> (joint_list: Array joints.Joint) -> (config: Config) -> (dt: F32) -> (sources: Array Source) -> (sc: Scene) -> (step: StepAccess) -> (geometry: shapes.Geometry) -> (walk: own Walkers) : Bool => return do:
  if Bool.not (dt > 0.0 and dt - dt == 0.0):
    step.results.truncate 0
    return false
  // Select the branch before making a read. A phi view over both banks would
  // retain both roots and would not prove the write destination disjoint.
  if step.cache.first_active:
    let previous = $Cache {contacts: step.cache.first.view 0 step.cache.first.length}
    solve_walked_into queries joint_list config dt sources sc previous geometry walk step.cache.second step.results
  else:
    let previous = $Cache {contacts: step.cache.second.view 0 step.cache.second.length}
    solve_walked_into queries joint_list config dt sources sc previous geometry walk step.cache.first step.results
  return true
func swap_cache (solved: Bool) -> (step: own StepAccess) : StepAccess => return do:
  if solved:
    step.cache.first_active := Bool.not self
  return step
func solve_walked_into (queries: scene.Queries) -> (joint_list: Array joints.Joint) -> (config: Config) -> (dt: F32) -> (sources: Array Source) -> (sc: Scene) -> (cache: Cache) -> (geometry: shapes.Geometry) -> (walk: own Walkers) -> (next_contacts: ResizeArray CachedContact) -> (results: ResizeArray Result) => return do:
  results.truncate 0
  let np = scene.count sc
  if walk.proxies.length != np:
    return @panic "walker pass differs from scene"
  let $Walkers {proxies, origins, velocities, ids, by_id, walked, walked_at, walked_state, wake_by_push, shifted} = walk
  // Explicit joints wake their connected dynamics.
  let connected = @array.fill sources.length 0
  for joint in joint_list:
    if joints.valid joint and joint.a < sources.length and joint.b < sources.length:
      connected[joint.a] := 1
      connected[joint.b] := 1
  let awake = @array.fill np 0.0
  for i in 0..np:
    let p = proxies[i]
    if p.kind == scene.kind_dynamic and Bool.not p.trigger:
      if connected[p.source] > 0 or Bool.not (rigid_of sources[p.source]).sleeping:
        awake[i] := 1.0
  // Sweep each fast body's inscribed sphere against immovable colliders.
  for i in 0..np:
    if proxies[i].kind == scene.kind_dynamic and awake[i] > 0.0 and Bool.not proxies[i].trigger:
      let body = rigid_of sources[proxies[i].source]
      let delta = velocities[i] * dt
      let travel = delta.length
      if body.continuous and travel > proxies[i].inscribed * 0.5 and travel > 0.0001:
        let filter = $scene.Filter { mask: proxies[i].mask, skip: proxies[i].id, triggers: false, walkers: false, dynamics: false }
        if let $Some h = scene.query_cast queries origins[i] origins[i] proxies[i].inscribed delta filter:
          if h.depth == 0.0:
            let shift = delta * max 0.0 (h.time - 0.01 / travel)
            proxies[i] := scene.shifted geometry self shift
            shifted.push i
            origins[i] := origins[i] + shift
  let movers = mover_ids proxies
  let m = movers.length
  let grow = @array.generate m (func (k: U32) => return 0.04 + (velocities[movers[k]]).length * dt)
  // Active: awake or pushed dynamic bodies, moving kinematic bodies.
  let woke = @array.generate np (func (i: U32) => return max awake[i] wake_by_push[i])
  let active0 = @array.fill np 0.0
  let resting = 0
  let active_count = 0
  for i in 0..np:
    if woke[i] > 0.0 or (proxies[i].kind == scene.kind_kinematic and Bool.not proxies[i].trigger and velocities[i].length_squared > 0.0000001):
      active0[i] := 1.0
      active_count := self + 1
    else:
      if Bool.not proxies[i].trigger:
        resting := self + 1
  // Independent refit scratch belongs to this step. The optional index only
  // aliases these named pools; it never carries owners created by a factory.
  let broad_bounds: ResizeArray F32 = #[]
  let broad_order: ResizeArray U32 = #[]
  let broad_leaves: ResizeArray U32 = #[]
  let refitted = spatial.access sc.index.base broad_bounds broad_order broad_leaves
  let broad_index: Maybe spatial.Index = $Nothing
  if resting >= 64 and active_count > 0 and sc.index.order.length == np:
    let dirty = @array.generate shifted.length (func (i: U32) => return shifted[i])
    let bounds = array.map (func (i: U32) => return $spatial.Bounds {low: proxies[i].low, high: proxies[i].high}) dirty
    let copied = spatial.copy_into refitted sc.index
    broad_index := $Some (spatial.refit copied dirty bounds)
  let candidates0 = broad_phase_with broad_index proxies movers grow active0
  // Active contacts wake sleepers and propagate through cached support pairs.
  let pair_count = candidates0.length / 2
  let woken = false
  for p in 0..pair_count:
    let a = candidates0[p * 2]
    let b = candidates0[p * 2 + 1]
    if proxies[a].kind == scene.kind_dynamic and woke[a] == 0.0 and active0[b] > 0.0:
      woke[a] := 1.0
      woken := true
    if proxies[b].kind == scene.kind_dynamic and woke[b] == 0.0 and active0[a] > 0.0:
      woke[b] := 1.0
      woken := true
  let cache_rows = cache.contacts.length
  let row_a = @array.generate cache_rows (func (r: U32) => return proxy_with_id proxies by_id cache.contacts[r].a)
  let row_b = @array.generate cache_rows (func (r: U32) => return proxy_with_id proxies by_id cache.contacts[r].b)
  if woken:
    if cache_rows > 0x7FFFFFFF:
      return @panic "contact wake edge count overflows"
    let endpoints = @array.fill (cache_rows * 2) 0
    let targets = @array.fill (cache_rows * 2) 0
    let used = 0
    for r in 0 .. cache_rows:
      let a = row_a[r]
      let b = row_b[r]
      if a < np and b < np:
        endpoints[used] := a
        targets[used] := b
        endpoints[used + 1] := b
        targets[used + 1] := a
        used := self + 2
    let adjacency_starts: ResizeArray U32 = #[]
    let adjacency_targets: ResizeArray U32 = #[]
    let $Some adjacency = graph.from_edges np (&endpoints[0..used]) (&targets[0..used]) adjacency_starts adjacency_targets else:
      return @panic "contact wake adjacency invariant"
    let root_count: U32 = 0
    for i in 0 .. np:
      if woke[i] > 0.0:
        root_count := self + 1
    let roots: Array U32 = array.fill root_count 0
    let root_at: U32 = 0
    for i in 0 .. np:
      if woke[i] > 0.0:
        roots[root_at] := i
        root_at := self + 1
    let active = graph.reachable adjacency roots (@array.generate np (func i => return proxies[i].kind == scene.kind_dynamic))
    woke := @array.generate np (func i => return if active[i] then 1.0 else 0.0)
  // Bodies that just woke now need their contacts with everything near.
  let active1 = @array.generate np (func (i: U32) => return do:
    if woke[i] > 0.0 or active0[i] > 0.0:
      return 1.0
    return 0.0)
  let candidates = candidates0
  if woken:
    candidates := broad_phase_with broad_index proxies movers grow active1
  with_bodies sources proxies movers origins velocities woke (func bodies -> slot_of => return
    with_contacts dt proxies velocities woke by_id candidates bodies slot_of cache (func row_array -> imp_array -> row_a_ids -> row_b_ids => return do:
      let substeps = contact_substeps config.substeps row_array bodies.inv_mass bodies.pos
      let prepared = prepare_joints joint_list sources sc slot_of
      let new_pos: Array F32 = @array.fill bodies.pos.length 0.0
      let new_rot: Array F32 = @array.fill bodies.rot.length 0.0
      let new_vel: Array F32 = @array.fill bodies.vel.length 0.0
      let solved: Array F32 = @array.fill imp_array.length 0.0
      let (new_pos, new_rot, new_vel, solved) = rigid.solve_joints_into prepared dt substeps config.gravity bodies row_array imp_array new_pos new_rot new_vel solved
      with_sleep_islands config dt sources proxies movers connected bodies.inv_mass row_array new_vel (func parent -> still -> island_time => return do:
        let count = row_array.length / rigid.stride
        // Merge solved and unchanged sleeping contacts in exact U32 id order.
        let fresh = @array.generate count (func (c: U32) => return do:
          let o = c * rigid.stride
          let q = c * rigid.impulse_stride
          let jt1 = solved[q + 1]
          let jt2 = solved[q + 2]
          return $CachedContact {
            a: row_a_ids[c], b: row_b_ids[c],
            point: rigid.vec row_array (o + 24),
            normal: rigid.vec row_array (o + 2),
            normal_impulse: solved[q],
            tangent_impulse: $Vec3 {
              x: row_array[o + 17] * jt1 + row_array[o + 20] * jt2,
              y: row_array[o + 18] * jt1 + row_array[o + 21] * jt2,
              z: row_array[o + 19] * jt1 + row_array[o + 22] * jt2,
            },
          })
        let kept_rows = @array.fill cache_rows 0
        let kept = 0
        for r in 0..cache_rows:
          let ia = row_a[r]
          let ib = row_b[r]
          if ia < np and ib < np and woke[ia] == 0.0 and woke[ib] == 0.0:
            kept_rows[kept] := r
            kept := self + 1
        let carried = @array.generate kept (func (r: U32) => return cache.contacts[kept_rows[r]])
        merge_contacts_into (&fresh[0..fresh.length]) (&carried[0..carried.length]) next_contacts
        let bodies_moved = moved_results config sources proxies movers woke parent island_time still new_pos new_rot new_vel
        let walker_slots = @array.fill np 0
        let walkers = 0
        for i in 0..np:
          if walked[i] > 0:
            walker_slots[walkers] := i
            walkers := self + 1
        let walker_results = @array.generate walkers (func (r: U32) => return do:
          let i = walker_slots[r]
          let source = proxies[i].source
          return $Result { source, position: walked_at[i], rotation: sources[source].rotation, rigid: $Nothing, walker: $Some walked_state[i] })
        for result in walker_results:
          results.push result
        for result in bodies_moved:
          results.push result)))

// Stable lexicographic U32 order, with fresh rows preceding equal carried
// rows exactly as before. Publication writes only the disjoint inactive bank.
func merge_contacts_into (a: &[CachedContact]) -> (b: &[CachedContact]) -> (destination: ResizeArray CachedContact) => return do:
  destination.truncate 0
  let na = a.length
  let nb = b.length
  let i: U32 = 0
  let j: U32 = 0
  for k in 0..(na + nb):
    let take_a = false
    if j >= nb:
      take_a := true
    else:
      if i < na:
        let ca = a[i]
        let cb = b[j]
        take_a := ca.a < cb.a or (ca.a == cb.a and ca.b <= cb.b)
    if take_a:
      destination.push a[i]
      i := self + 1
    else:
      destination.push b[j]
      j := self + 1
func simulate_joints_into (links: Array joints.Joint) -> (config: Config) -> (dt: F32) -> (step: own StepAccess) -> (sc: Scene) : StepAccess => return do:
  let solved = with_sources step (func sources => return simulate_queries_into (scene.queries sc) links config dt sources sc step)
  return swap_cache solved step
func simulate_into (config: Config) -> (dt: F32) -> (step: own StepAccess) -> (sc: Scene) : StepAccess => return
  simulate_joints_into #[] config dt step sc
// Convenience construction stays invocation-local. Persistent sources, cache
// banks and results retain the exact caller-named owners across every tick.
func simulate_rebuilt_into (links: Array joints.Joint) -> (config: Config) -> (dt: F32) -> (step: own StepAccess) : StepAccess => return do:
  let solved = with_sources step (func sources => return scene.with_built sources (func built => return
    simulate_queries_into (scene.queries built) links config dt sources built step))
  return swap_cache solved step
func step_joints_into (links: Array joints.Joint) -> (config: Config) -> (dt: F32) -> (step: own StepAccess) : StepAccess => return
  apply_into (simulate_rebuilt_into links config dt step)
func step_into (config: Config) -> (dt: F32) -> (step: own StepAccess) : StepAccess => return step_joints_into #[] config dt step

// Queries take built scenes and layer masks; only overlaps include triggers.

const all_layers: U32 = 65535

// The first solid hit along a ray of length `reach`, ignoring the entity
// `skip` (0 for none): `physics.ray scene origin direction reach mask skip`.
func ray (sc: Scene) => return func (origin: Vec3) => return func (direction: Vec3) => return func (reach: F32) => return func (mask: U32) => return func (skip: U32) => return scene.ray sc origin direction reach mask skip

// Move a sphere by `delta`; the first thing it touches.
func sweep_sphere (sc: Scene) => return func (center: Vec3) => return func (radius: F32) => return func (delta: Vec3) => return func (mask: U32) => return func (skip: U32) => return
  scene.cast sc center center radius delta ($scene.Filter { mask, skip, triggers: false, walkers: true, dynamics: true })

// Move a capsule (the segment a-b with a radius) by `delta`.
func sweep_capsule (sc: Scene) => return func (a: Vec3) => return func (b: Vec3) => return func (radius: F32) => return func (delta: Vec3) => return func (mask: U32) => return func (skip: U32) => return
  scene.cast sc a b radius delta ($scene.Filter { mask, skip, triggers: false, walkers: true, dynamics: true })

// The entity ids overlapping a sphere or a capsule, triggers included.
func overlap_sphere (sc: Scene) => return func (center: Vec3) => return func (radius: F32) => return func (mask: U32) => return scene.overlap_sphere sc center radius mask
func overlap_capsule (sc: Scene) => return func (a: Vec3) => return func (b: Vec3) => return func (radius: F32) => return func (mask: U32) => return scene.overlap_capsule sc a b radius mask

// Is the point inside anything solid?
func point_solid (sc: Scene) => return func (p: Vec3) => return func (mask: U32) => return scene.point_solid sc p mask

// Did the last step have a contact between these two entities? `contacts` is
// the contact cache returned by `simulate`.
func touching (cache: Cache) => return func (a: U32) => return func (b: U32) => return do:
  let low = min a b
  let high = a
  if a < b:
    high := b
  let i = cache_find cache low high
  return i < cache.contacts.length and cache.contacts[i].a == low and cache.contacts[i].b == high

func contact_count (cache: Cache) => return cache.contacts.length
