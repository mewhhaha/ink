//! Characters move first; rigid solving updates the caller-owned contact cache.
//! Source order and ascending U32 contact ids keep simulation deterministic.
//!
//! Key items: [`Config`], [`Result`], [`CachedContact`], [`Cache`], [`read_cache`].

import * as graph from "./graph"
import * as spatial from "./spatial"
import * as joints from "./physics/joints"
import * as array from "std/array"
import { Vec3 } from "std/vector"
import { Quat } from "./math"
import * as math from "./math"
import * as shapes from "./physics/shapes"
import * as contact from "./physics/contact"
import * as scene from "./physics/scene"
import * as rigid from "./physics/rigid"
import * as character from "./physics/character"
import * as sort from "./sort"
import * as simd from "std/simd"
import { Proxy, Rigid, Scene, Source, Walker } from "./physics/scene"

type Config is data = $Config {
  gravity: Vec3,
  substeps: U32,
  sleep_time: F32,
  linear_sleep: F32,
  angular_sleep: F32,
}

// What a step changed on one source.
type Result is data = $Result {
  source: U32,
  position: Vec3,
  rotation: Quat,
  rigid: Maybe Rigid,
  walker: Maybe Walker,
}

// Caller-owned warm-start state. Entity ids remain U32 throughout simulation.
type CachedContact is data = $CachedContact {
  a: U32,
  b: U32,
  point: Vec3,
  normal: Vec3,
  normal_impulse: F32,
  tangent_impulse: Vec3,
}
// Cache is a read for one operation; no owning aggregate crosses a tick.
type Cache is data = $Cache { contacts: &[CachedContact] }
type CacheAccess is data = $CacheAccess {first_active: Bool, first: #[CachedContact], second: #[CachedContact]}
type StepAccess is data = $StepAccess {sources: #[scene.SourceRow], geometry: shapes.Geometry, cache: CacheAccess, results: #[Result]}
func read_cache (cache: CacheAccess) => return
  $Cache {contacts: if cache.first_active then cache.first.view 0 cache.first.length else cache.second.view 0 cache.second.length}
// Explicit snapshots/seed inputs require an independent destination owner.
func copy_cache_into (source: Cache) -> (destination: own #[CachedContact]) : #[CachedContact] =>
  @storage.truncate destination 0
  for contact in source.contacts:
    @storage.push destination contact
  return destination
func seed_cache_into (contacts: &[CachedContact]) -> (cache: own CacheAccess) : CacheAccess =>
  cache.first := copy_cache_into ($Cache {contacts}) self
  @storage.truncate cache.second 0
  cache.first_active := true
  return cache
func load_sources_into (values: #[Source]) -> (step: own StepAccess) : StepAccess =>
  step.geometry := shapes.clear self
  let (rows, geometry) = scene.pack_sources_into step.geometry step.sources values
  step.geometry := geometry
  step.sources := rows
  @storage.truncate step.cache.first 0
  @storage.truncate step.cache.second 0
  step.cache.first_active := true
  @storage.truncate step.results 0
  return step
func source (step: StepAccess) -> (index: U32) => scene.unpack_source step.geometry step.sources[index]
// The materialized Source array is invocation scratch. All nested views borrow
// the older named geometry owners; the known consumer finishes before it dies.
func with_sources (step: StepAccess) -> consume =>
  let values = scene.source_values step.geometry (step.sources.view 0 step.sources.length)
  return consume values
func apply_into (step: own StepAccess) : StepAccess =>
  for i in 0 .. step.results.length:
    let result = step.results[i]
    let row = step.sources[result.source]
    row.position := result.position
    row.rotation := result.rotation
    if let $Some body = result.rigid:
      row.rigid := $Some body
    if let $Some walker = result.walker:
      row.walker := $Some walker
    step.sources[result.source] := row
  return step
const default_config = $Config {
  gravity: math.vec3 0.0 (-9.81) 0.0,
  substeps: 4,
  sleep_time: 0.5,
  linear_sleep: 0.05,
  angular_sleep: 0.05,
}

const no_slot = 0.0 - 1.0

func rigid_of source => case source.rigid of
  $Some r => r
  $Nothing => $scene.Rigid {
    kind: $scene.Static,
    mass: 1.0,
    gravity_scale: 1.0,
    linear_damping: 0.0,
    angular_damping: 0.0,
    can_sleep: true,
    continuous: false,
    linear_velocity: math.zero3,
    angular_velocity: math.zero3,
    sleeping: false,
    sleep_time: 0.0,
  }

// The velocity a proxy moves with this step.
func velocity_of (sources: #[Source]) => func (proxy: Proxy) =>
  let source = sources[proxy.source]
  if proxy.walker:
    let $Some w = source.walker else:
      return math.zero3
    return w.velocity
  return (rigid_of source).linear_velocity

func is_mover proxy => proxy.kind >= scene.kind_kinematic and not proxy.trigger

// Which proxies are movers: kinematic and dynamic bodies, in order.
func mover_ids proxies =>
  let found: #[U32] = #[]
  for i in 0 .. proxies.length:
    if is_mover proxies[i]:
      @storage.push found i
  return found

// Broad phase ------------------------------------------------------------------------

func layers_meet a => func b => return
  (a.layer & b.mask) != 0 and (b.layer & a.mask) != 0

// Sweep active movers along their widest axis; binary-search static bounds.
func broad_phase proxies -> movers -> grow -> active => broad_phase_with $Nothing proxies movers grow active
// Reuse the caller's scene index. It must describe the current proxy bounds,
// including controller/CCD shifts. Active sweeps still use both travel margins.
func broad_phase_indexed index -> proxies -> movers -> grow -> active => broad_phase_with ($Some index) proxies movers grow active
func broad_phase_with (index: Maybe spatial.Index) -> (proxies: #[Proxy]) -> (movers: #[U32]) -> (grow: #[F32]) -> (active: #[F32]) =>
  return broad_phase_shifted index proxies movers grow active #[]
func broad_phase_rows (index: Maybe spatial.Index) -> (proxies: #[scene.ProxyRow]) -> (movers: #[U32]) -> (grow: #[F32]) -> (active: #[F32]) =>
  return broad_phase_shifted index proxies movers grow active #[]

// The tree holds the pre-controller pose. A shifted resting proxy missed by
// the old tree is tested against its current bounds alongside tree candidates.
private func broad_phase_shifted (index: Maybe spatial.Index) -> proxies -> (movers: #[U32]) -> (grow: #[F32]) -> (active: #[F32]) -> (shifted: #[U32]) : #[U32] =>
  let m = movers.length
  let lo = @array.fill (m * 3) 0.0
  let hi = @array.fill (m * 3) 0.0
  let mine: #[U32] = #[]
  for k in 0..m:
    if active[movers[k]] > 0.0:
      @storage.push mine k
      let p = proxies[movers[k]]
      let g = grow[k]
      lo[k * 3] := p.low.x - g
      lo[k * 3 + 1] := p.low.y - g
      lo[k * 3 + 2] := p.low.z - g
      hi[k * 3] := p.high.x + g
      hi[k * 3 + 1] := p.high.y + g
      hi[k * 3 + 2] := p.high.z + g
  let live = mine
  let n = live.length
  if n == 0:
    return #[]
  let found: #[U32] = #[]
  // Sweep along the axis where the active movers spread most.
  let mx = 0.0
  let my = 0.0
  let mz = 0.0
  for t in 0..n:
    let k = live[t]
    mx := self + lo[k * 3] + hi[k * 3]
    my := self + lo[k * 3 + 1] + hi[k * 3 + 1]
    mz := self + lo[k * 3 + 2] + hi[k * 3 + 2]
  let inv = 0.5 / U32.to_f32 n
  let cx = mx * inv
  let cy = my * inv
  let cz = mz * inv
  let vx = 0.0
  let vy = 0.0
  let vz = 0.0
  for t in 0..n:
    let k = live[t]
    let dx = (lo[k * 3] + hi[k * 3]) * 0.5 - cx
    let dy = (lo[k * 3 + 1] + hi[k * 3 + 1]) * 0.5 - cy
    let dz = (lo[k * 3 + 2] + hi[k * 3 + 2]) * 0.5 - cz
    vx := self + dx * dx
    vy := self + dy * dy
    vz := self + dz * dz
  let axis = 2
  if vy >= vz:
    axis := 1
  if vx >= vy and vx >= vz:
    axis := 0
  let keys = @array.fill n 0.0
  for t in 0..n:
    keys[t] := lo[live[t] * 3 + axis]
  let order = sort.order keys
  // Find each sweep interval's end before collecting pairs. Early loop exits
  // make the compiler copy the growing list on every append.
  for oi in 0..n:
    let i = live[order[oi]]
    let i3 = i * 3
    let lo_ix = lo[i3]
    let lo_iy = lo[i3 + 1]
    let lo_iz = lo[i3 + 2]
    let hi_ix = hi[i3]
    let hi_iy = hi[i3 + 1]
    let hi_iz = hi[i3 + 2]
    let reach = hi[i3 + axis]
    let first = oi + 1
    let last = n
    for 0..32:
      if first < last:
        let mid = (first + last) / 2
        if lo[live[order[mid]] * 3 + axis] <= reach:
          first := mid + 1
        else:
          last := mid
      else:
        break
    let mi = movers[i]
    let pi = proxies[mi]
    for oj in (oi + 1)..first:
      let j = live[order[oj]]
      let j3 = j * 3
      if lo_ix <= hi[j3] and hi_ix >= lo[j3] and lo_iy <= hi[j3 + 1] and hi_iy >= lo[j3 + 1] and lo_iz <= hi[j3 + 2] and hi_iz >= lo[j3 + 2]:
        let mj = movers[j]
        let pj = proxies[mj]
        if (pi.kind == scene.kind_dynamic or pj.kind == scene.kind_dynamic) and layers_meet pi pj:
          @storage.push found mi
          @storage.push found mj
  // Active movers against everything at rest.
  let nr = 0
  let has_index = Maybe.is_some index
  if has_index:
    for i in 0 .. proxies.length:
      if active[i] == 0.0 and not proxies[i].trigger:
        nr := self + 1
        if nr == 64:
          break
  // Small resting sets amortize no tree traversal. Private solver work scenes
  // may deliberately have no index, so retain the ordinary sweep fallback.
  let indexed = false
  if nr >= 64:
    if let $Some index = index:
      if index.order.length != proxies.length:
        return panic "physics broad-phase index count mismatch"
      let scratch: #[U32] = #[]
      let moved_resting: #[U32] = #[]
      for source in shifted:
        if active[source] == 0.0 and not proxies[source].trigger:
          @storage.push moved_resting source
      let dirty_order = sort.order_u32 moved_resting
      let filtered: #[U32] = #[]
      let saved_filter = false
      let saved_kind = 0
      let saved_layer = 0
      let saved_mask = 0
      let have_query = false
      let previous_lo = math.zero3
      let previous_hi = math.zero3
      for t in 0 .. n:
        let k = live[t]
        let k3 = k * 3
        let mk = movers[k]
        let pm = proxies[mk]
        let lx = lo[k3]
        let ly = lo[k3 + 1]
        let lz = lo[k3 + 2]
        let hx = hi[k3]
        let hy = hi[k3 + 1]
        let hz = hi[k3 + 2]
        if not have_query or lx != previous_lo.x or ly != previous_lo.y or lz != previous_lo.z or hx != previous_hi.x or hy != previous_hi.y or hz != previous_hi.z:
          let low = $Vec3 { x: lx, y: ly, z: lz }
          let high = $Vec3 { x: hx, y: hy, z: hz }
          scratch := spatial.query_into index low high self
          previous_lo := low
          previous_hi := high
          have_query := true
          saved_filter := false
        if dirty_order.is_empty:
          if saved_filter and saved_kind == pm.kind and saved_layer == pm.layer and saved_mask == pm.mask:
            for source in filtered:
              @storage.push found mk
              @storage.push found source
          else:
            let save = false
            if scratch.length >= 64 and t + 1 < n:
              let next = live[t + 1]
              let o = next * 3
              let next_proxy = proxies[movers[next]]
              save := lx == lo[o] and ly == lo[o + 1] and lz == lo[o + 2] and hx == hi[o] and hy == hi[o + 1] and hz == hi[o + 2] and pm.kind == next_proxy.kind and pm.layer == next_proxy.layer and pm.mask == next_proxy.mask
            if save:
              @storage.truncate filtered 0
              saved_kind := pm.kind
              saved_layer := pm.layer
              saved_mask := pm.mask
              saved_filter := true
            for source in scratch:
              let ps = proxies[source]
              if active[source] == 0.0 and not ps.trigger and lx <= ps.high.x and hx >= ps.low.x and ly <= ps.high.y and hy >= ps.low.y and lz <= ps.high.z and hz >= ps.low.z and (pm.kind == scene.kind_dynamic or ps.kind == scene.kind_dynamic) and layers_meet pm ps:
                @storage.push found mk
                @storage.push found source
                if save:
                  @storage.push filtered source
        else:
          let next = 0
          for source in scratch:
            // Merge shifted resting proxies into the source-ordered query.
            for j in next .. dirty_order.length:
              let dirty = moved_resting[dirty_order[j]]
              if dirty >= source:
                break
              if j == 0 or dirty != moved_resting[dirty_order[j - 1]]:
                let ps = proxies[dirty]
                if (pm.kind == scene.kind_dynamic or ps.kind == scene.kind_dynamic) and layers_meet pm ps and overlap_bounds lo hi k ps:
                  @storage.push found mk
                  @storage.push found dirty
              next := j + 1
            let ps = proxies[source]
            if active[source] == 0.0 and not ps.trigger and (pm.kind == scene.kind_dynamic or ps.kind == scene.kind_dynamic) and layers_meet pm ps and overlap_bounds lo hi k ps:
              @storage.push found mk
              @storage.push found source
            for j in next .. dirty_order.length:
              if moved_resting[dirty_order[j]] != source:
                break
              next := j + 1
          for j in next .. dirty_order.length:
            let dirty = moved_resting[dirty_order[j]]
            if j == 0 or dirty != moved_resting[dirty_order[j - 1]]:
              let ps = proxies[dirty]
              if (pm.kind == scene.kind_dynamic or ps.kind == scene.kind_dynamic) and layers_meet pm ps and overlap_bounds lo hi k ps:
                @storage.push found mk
                @storage.push found dirty
      indexed := true
  if not indexed and (not has_index or nr > 0):
    // Equal active bounds and filters have the same resting overlaps.
    // Scan them once, preserving the resting sweep's stable low-X order.
    let first = live[0]
    let first_at = first * 3
    let first_proxy = proxies[movers[first]]
    let lx = lo[first_at]
    let ly = lo[first_at + 1]
    let lz = lo[first_at + 2]
    let hx = hi[first_at]
    let hy = hi[first_at + 1]
    let hz = hi[first_at + 2]
    let same_query = true
    for t in 1 .. n:
      let k = live[t]
      let o = k * 3
      let p = proxies[movers[k]]
      if lo[o] != lx or lo[o + 1] != ly or lo[o + 2] != lz or hi[o] != hx or hi[o + 1] != hy or hi[o + 2] != hz or p.kind != first_proxy.kind or p.layer != first_proxy.layer or p.mask != first_proxy.mask:
        same_query := false
        break
    if same_query:
      let hits: #[U32] = #[]
      let ordered = true
      let ordinary = true
      let previous = (-1.0 / 0.0)
      for source in 0 .. proxies.length:
        if active[source] == 0.0:
          let p = proxies[source]
          let x = p.low.x
          ordinary := self and (p.trigger or is_finite p.high.x)
          if not p.trigger and lx <= p.high.x and hx >= x and ly <= p.high.y and hy >= p.low.y and lz <= p.high.z and hz >= p.low.z and (first_proxy.kind == scene.kind_dynamic or p.kind == scene.kind_dynamic) and layers_meet first_proxy p:
            ordered := self and previous <= x
            previous := x
            @storage.push hits source
      if ordinary:
        if ordered:
          for k in live:
            let mover = movers[k]
            for source in hits:
              @storage.push found mover
              @storage.push found source
        else:
          let keys = @array.generate hits.length (func i => proxies[hits[i]].low.x)
          let order = sort.order keys
          for k in live:
            let mover = movers[k]
            for i in order:
              @storage.push found mover
              @storage.push found hits[i]
        return found
    // A single scan rejects rows outside the union of all active bounds
    // before sorting. Exceptional X bounds retain the full prefix sweep.
    let union_lx = 1.0 / 0.0
    let union_ly = 1.0 / 0.0
    let union_lz = 1.0 / 0.0
    let union_hx = (-1.0 / 0.0)
    let union_hy = (-1.0 / 0.0)
    let union_hz = (-1.0 / 0.0)
    for k in live:
      let o = k * 3
      let lx = lo[o]
      if lx == lx:
        union_lx := min self lo[o]
      let ly = lo[o + 1]
      if ly == ly:
        union_ly := min self lo[o + 1]
      let lz = lo[o + 2]
      if lz == lz:
        union_lz := min self lo[o + 2]
      let hx = hi[o]
      if hx == hx:
        union_hx := max self hi[o]
      let hy = hi[o + 1]
      if hy == hy:
        union_hy := max self hi[o + 1]
      let hz = hi[o + 2]
      if hz == hz:
        union_hz := max self hi[o + 2]
    let rest_ids: #[U32] = #[]
    let ordinary = true
    let ordered = true
    let previous = (-1.0 / 0.0)
    for source in 0 .. proxies.length:
      if active[source] == 0.0:
        let p = proxies[source]
        if not p.trigger:
          let x = p.low.x
          if not (is_finite p.high.x):
            ordinary := false
          if union_lx <= p.high.x and union_hx >= x and union_ly <= p.high.y and union_hy >= p.low.y and union_lz <= p.high.z and union_hz >= p.low.z:
            @storage.push rest_ids source
            ordered := self and previous <= x
            previous := x
    if not ordinary:
      @storage.truncate rest_ids 0
      for source in 0 .. proxies.length:
        if active[source] == 0.0 and not proxies[source].trigger:
          @storage.push rest_ids source
      ordered := false
    let rest_count = rest_ids.length
    let sorted = rest_ids
    if not ordered:
      let rest_keys = @array.generate rest_count (func t =>
        let x = proxies[rest_ids[t]].low.x
        let (bits, _, _, _) = simd.f32_bits (if x == 0.0 then 0.0 else x, 0.0, 0.0, 0.0)
        return if x != x then 0xFFFFFFFF else if bits >= 0x80000000 then bits ^ 0xFFFFFFFF else bits ^ 0x80000000)
      let order_r = sort.order_u32 rest_keys
      sorted := @array.generate rest_count (func t => rest_ids[order_r[t]])
    let low_x = @array.fill rest_count 0.0
    let reach_x = @array.fill rest_count 0.0
    let running = (-1000000000.0)
    for t in 0..rest_count:
      let ps = proxies[sorted[t]]
      low_x[t] := ps.low.x
      running := max self ps.high.x
      reach_x[t] := running
    for t in 0..n:
      let k = live[t]
      let k3 = k * 3
      let mk = movers[k]
      let pm = proxies[mk]
      let lx = lo[k3]
      let ly = lo[k3 + 1]
      let lz = lo[k3 + 2]
      let hx = hi[k3]
      let hy = hi[k3 + 1]
      let hz = hi[k3 + 2]
      // First resting proxy whose running maximum reaches the mover, and the
      // first whose low x is beyond it.
      let first = 0
      let last = rest_count
      for 0..32:
        if first < last:
          let mid = (first + last) / 2
          if reach_x[mid] < lx:
            first := mid + 1
          else:
            last := mid
        else:
          break
      let begin = first
      first := 0
      last := rest_count
      for 0..32:
        if first < last:
          let mid = (first + last) / 2
          if low_x[mid] <= hx:
            first := mid + 1
          else:
            last := mid
        else:
          break
      for u in begin..first:
        let su = sorted[u]
        let ps = proxies[su]
        if (pm.kind == scene.kind_dynamic or ps.kind == scene.kind_dynamic) and layers_meet pm ps and lx <= ps.high.x and hx >= ps.low.x and ly <= ps.high.y and hy >= ps.low.y and lz <= ps.high.z and hz >= ps.low.z:
          @storage.push found mk
          @storage.push found su
  return found

func overlap_bounds (lo: #[F32]) => func (hi: #[F32]) => func (k: U32) => func p => return
  lo[k * 3] <= p.high.x and hi[k * 3] >= p.low.x and lo[k * 3 + 1] <= p.high.y and hi[k * 3 + 1] >= p.low.y and lo[k * 3 + 2] <= p.high.z and hi[k * 3 + 2] >= p.low.z

// The pairs sorted by the smaller entity id, then the larger, and each pair
// ordered the same way. Input and output are flat proxy index lists.
func canonical_pairs proxies => func (rank: #[U32]) => func (pairs: #[U32]) =>
  let count = pairs.length / 2
  if count == 0:
    let none: #[U32] = #[]
    return none
  if count == 1:
    let a = pairs[0]
    let b = pairs[1]
    if rank[a] < rank[b]:
      return #[a, b]
    return #[b, a]
  let np = proxies.length
  if np <= 65535 and count <= 16:
    // Keep short contact lists sorted as they are written. Equal keys are
    // inserted after existing keys, matching the stable indirect sort.
    let keys = @array.fill count 0
    let out = @array.fill (count * 2) 0
    for p in 0 .. count:
      let a = pairs[p * 2]
      let b = pairs[p * 2 + 1]
      let ra = rank[a]
      let rb = rank[b]
      let key = min ra rb * np + max ra rb
      let i = p
      for _ in 0 .. p:
        let j = i - 1
        if keys[j] <= key:
          break
        keys[i] := keys[j]
        out[i * 2] := out[j * 2]
        out[i * 2 + 1] := out[j * 2 + 1]
        i := j
      keys[i] := key
      out[i * 2] := if ra < rb then a else b
      out[i * 2 + 1] := if ra < rb then b else a
    return out
  if np <= 65535:
    let keys = @array.fill count 0
    for p in 0 .. count:
      let ra = rank[pairs[p * 2]]
      let rb = rank[pairs[p * 2 + 1]]
      keys[p] := min ra rb * np + max ra rb
    let order = sort.order_u32 keys
    let out = @array.fill (count * 2) 0
    for p in 0 .. count:
      let at = order[p] * 2
      let a = pairs[at]
      let b = pairs[at + 1]
      let forward = rank[a] < rank[b]
      out[p * 2] := if forward then a else b
      out[p * 2 + 1] := if forward then b else a
    return out
  let first = @array.fill count 0
  let second = @array.fill count 0
  for p in 0 .. count:
    let a = pairs[p * 2]
    let b = pairs[p * 2 + 1]
    if rank[a] < rank[b]:
      first[p] := a
      second[p] := b
    else:
      first[p] := b
      second[p] := a
  let out = @array.fill (count * 2) 0
  let second_ids = @array.fill count 0
  for p in 0 .. count:
    second_ids[p] := proxies[second[p]].id
  let by_second = sort.order_u32 second_ids
  let first_ids = @array.fill count 0
  for p in 0 .. count:
    first_ids[p] := proxies[first[by_second[p]]].id
  let by_first = sort.order_u32 first_ids
  for p in 0 .. count:
    let src = by_second[by_first[p]]
    out[p * 2] := first[src]
    out[p * 2 + 1] := second[src]
  return out

private func proxy_rank proxies -> (by_id: #[U32]) -> (proxy: U32) : U32 =>
  let id = proxies[proxy].id
  let low = 0
  let high = by_id.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    let at = by_id[middle]
    let other = proxies[at].id
    if other < id or (other == id and at < proxy):
      low := middle + 1
    else:
      high := middle
  return low

private func canonical_sparse_pairs proxies -> (by_id: #[U32]) -> (pairs: #[U32]) : #[U32] =>
  let n = pairs.length / 2
  let np = proxies.length
  let first = @array.fill n 0
  let second = @array.fill n 0
  let keys = @array.fill n 0
  for p in 0 .. n:
    let a = pairs[p * 2]
    let b = pairs[p * 2 + 1]
    let ra = proxy_rank proxies by_id a
    let rb = proxy_rank proxies by_id b
    first[p] := if ra < rb then a else b
    second[p] := if ra < rb then b else a
    keys[p] := min ra rb * np + max ra rb
  let order = sort.order_u32 keys
  let out = @array.fill (n * 2) 0
  for p in 0 .. n:
    let i = order[p]
    out[p * 2] := first[i]
    out[p * 2 + 1] := second[i]
  return out

// Proxy indices in the mover list are already in ascending order.
private func sparse_mover_slot (movers: #[U32]) -> (proxy: U32) : F32 =>
  let low = 0
  let high = movers.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    let candidate = movers[middle]
    if candidate == proxy:
      return U32.to_f32 middle
    if candidate < proxy:
      low := middle + 1
    else:
      high := middle
  return no_slot

// Index of the first cache row for the pair (a, b), or the length if absent.
func cache_find (cache: Cache) => func (a: U32) => func (b: U32) =>
  let low = 0
  let high = cache.contacts.length
  for 0..32:
    if low >= high:
      break
    let mid = (low + high) / 2
    let c = cache.contacts[mid]
    if c.a < a or (c.a == a and c.b < b):
      low := mid + 1
    else:
      high := mid
  return low

// Reuse the nearest cached impulse for this exact entity pair: the normal
// impulse and the tangential impulse's x, y and z.
func cache_match (cache: Cache) => func (a: U32) => func (b: U32) => func (px: F32) => func (py: F32) => func (pz: F32) =>
  return cache_match_from cache (cache_find cache a b) a b px py pz

private func cache_match_from (cache: Cache) -> (start: U32) -> (a: U32) -> (b: U32) -> (px: F32) -> (py: F32) -> (pz: F32) =>
  let rows = cache.contacts.length
  let i = start
  let best = 0.0225
  let jn = 0.0
  let jtx = 0.0
  let jty = 0.0
  let jtz = 0.0
  for 0..rows:
    if i >= rows:
      break
    let c = cache.contacts[i]
    if c.a != a or c.b != b:
      break
    let dx = c.point.x - px
    let dy = c.point.y - py
    let dz = c.point.z - pz
    let d = dx * dx + dy * dy + dz * dz
    if d < best:
      best := d
      jn := c.normal_impulse
      jtx := c.tangent_impulse.x
      jty := c.tangent_impulse.y
      jtz := c.tangent_impulse.z
    i := self + 1
  return (jn, jtx, jty, jtz)

// Merge an ascending run followed by a strictly descending run directly,
// preserving source-order ties. Other layouts use the radix sorter.
func order_proxy_ids (ids: #[U32]) : #[U32] =>
  let n = ids.length
  let split = n
  for i in 1 .. n:
    if ids[i] < ids[i - 1]:
      split := i
      break
  if split == n:
    return sort.identity n
  for i in (split + 1) .. n:
    if ids[i] >= ids[i - 1]:
      return sort.order_u32 ids
  let out = @array.fill n 0
  let left = 0
  let right = n
  for k in 0 .. n:
    if right <= split or (left < split and ids[left] <= ids[right - 1]):
      out[k] := left
      left := self + 1
    else:
      right := self - 1
      out[k] := right
  return out

func proxy_with_id proxies => func (by_id: #[U32]) => func (id: U32) =>
  let low = 0
  let high = by_id.length
  for 0..32:
    if low >= high:
      break
    let mid = (low + high) / 2
    if proxies[by_id[mid]].id < id:
      low := mid + 1
    else:
      high := mid
  if low < by_id.length and proxies[by_id[low]].id == id:
    return by_id[low]
  return proxies.length


// The first proxy with entity id `id`, or the proxy count, by binary search
// of `ids` (each proxy's id) in the stable ascending order `by_id`.
func index_of_id (ids: #[U32]) => func (by_id: #[U32]) => func (id: U32) =>
  let low = 0
  let high = by_id.length
  for 0..32:
    if low < high:
      let mid = (low + high) / 2
      if ids[by_id[mid]] < id:
        low := mid + 1
      else:
        high := mid
    else:
      break
  if low < by_id.length and ids[by_id[low]] == id:
    return by_id[low]
  return ids.length

// Solver -----------------------------------------------------------------------------

type Island is data = $Island { parent: #[U32] }

func root_of (parent: #[U32]) => func (i: U32) =>
  let r = i
  for 0..parent.length:
    let p = parent[r]
    if p == r:
      break
    r := p
  return r

// Advance the rigid bodies by dt. `scene` holds the proxies; `sources` the
// matching entity data. Returns results for the bodies that moved and the new
// contact cache.
func contact_substeps (substeps: U32) => func (row_array: #[F32]) => func (inv_mass: #[F32]) => func (pos: #[F32]) =>
  return contact_substeps_width substeps row_array rigid.stride inv_mass pos

private func contact_substeps_width (substeps: U32) => func (row_array: #[F32]) => func (row_width: U32) => func (inv_mass: #[F32]) => func (pos: #[F32]) =>
  // Height-ordered support chains need stiffer contacts above twelve bodies.
  let total = row_array.length / row_width
  let m = inv_mass.length
  let under = @array.fill total 0
  let over = @array.fill total 0
  let heights = @array.fill total 0.0
  let supports = 0
  for c in 0..total:
    let o = c * row_width
    let a = row_array[o]
    let b = row_array[o + 1]
    if a >= 0.0 and b >= 0.0:
      let ka = F32.to_u32 a
      let kb = F32.to_u32 b
      if inv_mass[ka] > 0.0 and inv_mass[kb] > 0.0:
        let ny = row_array[o + 3]
        if ny > 0.7:
          under[supports] := ka
          over[supports] := kb
          heights[supports] := pos[ka * 3 + 1]
          supports := self + 1
        if ny < (-0.7):
          under[supports] := kb
          over[supports] := ka
          heights[supports] := pos[kb * 3 + 1]
          supports := self + 1
  let depth = @array.fill m 1
  let deepest = 1
  if supports >= 11:
    let by_height = sort.order (@array.generate supports (func (i: U32) => heights[i]))
    for r in 0..supports:
      let row = by_height[r]
      let reached = depth[under[row]] + 1
      if reached > depth[over[row]]:
        depth[over[row]] := reached
        deepest := max self reached
  let base = max 1 (min 256 substeps)
  if deepest >= 30:
    return min 16 (min 16 base * 4)
  if deepest >= 12:
    return min 16 (min 16 base * 2)
  return base

func prepare_joints (joint_list: #[joints.Joint]) => func (sources: #[Source]) => func (sc: Scene) => func (slot_of: #[F32]) =>
  return prepare_joints_with joint_list sources sc (func (proxy: U32) : F32 =>
    if proxy < slot_of.length then slot_of[proxy] else no_slot)

private func prepare_joints_with (joint_list: #[joints.Joint]) -> sources -> (sc: Scene) -> (slot_at: U32 -> F32) =>
  let prepared: #[joints.Link] = #[]
  for joint in joint_list:
    if joint.a < sources.length and joint.b < sources.length and joints.valid joint:
      let a = (sources.at joint.a)
      let b = (sources.at joint.b)
      let slot_a = slot_at sc.slots[joint.a]
      let slot_b = slot_at sc.slots[joint.b]
      let body_a = rigid_of a
      let body_b = rigid_of b
      @storage.push prepared ($joints.Link { joint, a: slot_a, b: slot_b, position_a: a.position, position_b: b.position, rotation_a: a.rotation, rotation_b: b.rotation, velocity_a: body_a.linear_velocity, velocity_b: body_b.linear_velocity, angular_a: body_a.angular_velocity, angular_b: body_b.angular_velocity })
  return prepared

func with_sleep_islands (config: Config) => func (dt: F32) => func (sources: #[Source]) => func (proxies: #[Proxy]) => func (movers: #[U32]) => func (connected: #[U32]) => func (inv_mass: #[F32]) => func (row_array: #[F32]) => func (new_vel: #[F32]) -> consume =>
  return with_sleep_islands_width config dt sources proxies movers connected inv_mass row_array rigid.stride new_vel consume

private func with_sleep_islands_width (config: Config) => func (dt: F32) => func sources => func proxies => func (movers: #[U32]) => func (connected: #[U32]) => func (inv_mass: #[F32]) => func (row_array: #[F32]) => func (row_width: U32) => func (new_vel: #[F32]) -> consume =>
  // Sleeping: islands of touching awake bodies sleep together once all of
  // them have been still for long enough.
  let m = movers.length
  let count = row_array.length / row_width
  let parent = @array.generate m (func (k: U32) => k)
  let sizes = @array.fill m 1
  for c in 0..count:
    let o = c * row_width
    let a = row_array[o]
    let b = row_array[o + 1]
    if a >= 0.0 and b >= 0.0:
      let ka = F32.to_u32 a
      let kb = F32.to_u32 b
      if inv_mass[ka] > 0.0 and inv_mass[kb] > 0.0:
        // Find both roots inline: handing `parent` to a function would make
        // the union's writes below copy it.
        let ra = ka
        for 0..m:
          let up = parent[ra]
          if up == ra:
            break
          ra := up
        let rb = kb
        for 0..m:
          let up = parent[rb]
          if up == rb:
            break
          rb := up
        if ra != rb:
          // Size weighting bounds root walks even for dense canonical pairs.
          let size_a = sizes[ra]
          let size_b = sizes[rb]
          let smaller = ra
          let larger = rb
          if size_a > size_b or (size_a == size_b and ra < rb):
            smaller := rb
            larger := ra
          parent[smaller] := larger
          sizes[larger] := size_a + size_b
  let still = @array.fill m 0.0
  let island_time = @array.fill m 1000000.0
  let lin_sleep2 = config.linear_sleep * config.linear_sleep
  let ang_sleep2 = config.angular_sleep * config.angular_sleep
  for k in 0..m:
    if inv_mass[k] > 0.0:
      let proxy = proxies[movers[k]]
      let body = rigid_of (sources.at proxy.source)
      let time = 0.0
      if body.can_sleep and (connected.is_empty or connected[proxy.source] == 0):
        let v = k * 6
        let vx = new_vel[v]
        let vy = new_vel[v + 1]
        let vz = new_vel[v + 2]
        let lin2 = vx * vx + vy * vy + vz * vz
        if lin2 < lin_sleep2:
          let wx = new_vel[v + 3]
          let wy = new_vel[v + 4]
          let wz = new_vel[v + 5]
          let ang2 = wx * wx + wy * wy + wz * wz
          let quiet = ang2 < ang_sleep2
          if not quiet:
            let ang = sqrt ang2
            quiet := ang * proxy.inscribed < config.linear_sleep
          if quiet:
            time := body.sleep_time + dt
      still[k] := time
      let root = root_of parent k
      island_time[root] := min island_time[root] time
  return consume parent still island_time

func with_bodies (sources: #[Source]) => func (proxies: #[Proxy]) => func (movers: #[U32]) => func (origins: #[Vec3]) => func (velocities: #[Vec3]) => func (woke: #[F32]) -> consume =>
  let slot_of = @array.fill proxies.length no_slot
  for k in 0 .. movers.length:
    slot_of[movers[k]] := U32.to_f32 k
  return with_body_columns sources proxies movers (func (k: U32) : Vec3 => origins[movers[k]]) velocities woke (func (own bodies) => consume bodies slot_of)

private func with_body_columns sources -> proxies -> (movers: #[U32]) -> (origin_at: U32 -> Vec3) -> (velocities: #[Vec3]) -> (woke: #[F32]) -> consume =>
  let m = movers.length
  let pos = @array.fill (m * 3) 0.0
  let rot = @array.fill (m * 4) 0.0
  let vel = @array.fill (m * 6) 0.0
  let inv_mass = @array.fill m 0.0
  let inv_inertia = @array.fill (m * 3) 0.0
  let gravity_scale = @array.fill m 0.0
  let linear_damping = @array.fill m 0.0
  let angular_damping = @array.fill m 0.0
  for k in 0..m:
    let proxy = proxies[movers[k]]
    let source = (sources.at proxy.source)
    let body = rigid_of source
    let origin = origin_at k
    pos[k * 3] := origin.x
    pos[k * 3 + 1] := origin.y
    pos[k * 3 + 2] := origin.z
    rot[k * 4] := source.rotation.x
    rot[k * 4 + 1] := source.rotation.y
    rot[k * 4 + 2] := source.rotation.z
    rot[k * 4 + 3] := source.rotation.w
    let v = velocities[movers[k]]
    vel[k * 6] := v.x
    vel[k * 6 + 1] := v.y
    vel[k * 6 + 2] := v.z
    vel[k * 6 + 3] := body.angular_velocity.x
    vel[k * 6 + 4] := body.angular_velocity.y
    vel[k * 6 + 5] := body.angular_velocity.z
    if proxy.kind == scene.kind_dynamic and woke[movers[k]] > 0.0 and is_finite body.mass:
      let mass = max 0.0001 body.mass
      let ix = if is_finite proxy.inertia.x then max 0.00001 proxy.inertia.x else 0.00001
      let iy = if is_finite proxy.inertia.y then max 0.00001 proxy.inertia.y else 0.00001
      let iz = if is_finite proxy.inertia.z then max 0.00001 proxy.inertia.z else 0.00001
      inv_mass[k] := 1.0 / mass
      inv_inertia[k * 3] := 1.0 / (mass * ix)
      inv_inertia[k * 3 + 1] := 1.0 / (mass * iy)
      inv_inertia[k * 3 + 2] := 1.0 / (mass * iz)
      gravity_scale[k] := if is_finite body.gravity_scale then body.gravity_scale else 0.0
      linear_damping[k] := if is_finite body.linear_damping then max 0.0 body.linear_damping else 0.0
      angular_damping[k] := if is_finite body.angular_damping then max 0.0 body.angular_damping else 0.0
  let bodies = $rigid.Bodies { pos, rot, vel, inv_mass, inv_inertia, gravity_scale, linear_damping, angular_damping }
  return consume (own bodies)

func with_contacts (dt: F32) => func (proxies: #[Proxy]) => func (velocities: #[Vec3]) => func (woke: #[F32]) => func (by_id: #[U32]) => func (candidates: #[U32]) => func (bodies: rigid.Bodies) => func (slot_of: #[F32]) => func (cache: Cache) -> consume =>
  let (rows, impulses, a_ids, b_ids, _) = with_contact_rows dt proxies (func (i: U32) : shapes.Shape => proxies[i].shape) velocities woke by_id candidates bodies (func (i: U32) : F32 => slot_of[i]) cache rigid.stride
  return consume rows impulses a_ids b_ids

private func with_contact_rows (dt: F32) -> proxies -> (shape_at: U32 -> shapes.Shape) -> (velocities: #[Vec3]) -> (woke: #[F32]) -> (by_id: #[U32]) -> (candidates: #[U32]) -> (bodies: rigid.Bodies) -> (slot_at: U32 -> F32) -> (cache: Cache) -> (row_width: U32) : (#[F32], #[F32], #[U32], #[U32], #[F32]) =>
  let np = proxies.length
  let sparse_ids = row_width == rigid.compact_stride and np <= 65535 and candidates.length < np / 8
  if candidates.is_empty:
    let rows: #[F32] = #[]
    let impulses: #[F32] = #[]
    let a_ids: #[U32] = #[]
    let b_ids: #[U32] = #[]
    let iw = rigid.inertia_table bodies.rot bodies.inv_inertia
    return (rows, impulses, a_ids, b_ids, iw)
  let pairs = do:
    if sparse_ids:
      break canonical_sparse_pairs proxies by_id candidates
    let rank = @array.fill np 0
    for t in 0 .. np:
      rank[by_id[t]] := t
    break canonical_pairs proxies rank candidates
  let iw0 = rigid.inertia_table bodies.rot bodies.inv_inertia
  // Find every pair's contacts first, so the row tables are allocated at
  // their exact size.
  let pair_count = pairs.length / 2
  // How far each pair closes during the step.
  let closing = @array.generate pair_count (func (p: U32) =>
    let va = velocities[pairs[p * 2]]
    let vb = velocities[pairs[p * 2 + 1]]
    let dx = va.x - vb.x
    let dy = va.y - vb.y
    let dz = va.z - vb.z
    return sqrt (dx * dx + dy * dy + dz * dz) * dt)
  let contact_starts: #[U32] = @array.fill (pair_count + 1) 0
  let contact_rows: #[contact.Contact] = #[]
  for p in 0 .. pair_count:
    let ia = pairs[p * 2]
    let ib = pairs[p * 2 + 1]
    if woke[ia] > 0.0 or woke[ib] > 0.0:
      contact_rows := contact.between_into (shape_at ia) (shape_at ib) (0.02 + closing[p]) (0.008 + closing[p]) self
    contact_starts[p + 1] := contact_rows.length
  let found: #[contact.Contact] = contact_rows
  let used = found.length
  let row_buf = @array.fill (used * row_width) 0.0
  let imp_buf = @array.fill (used * rigid.impulse_stride) 0.0
  let row_a_ids = @array.fill used 0
  let row_b_ids = @array.fill used 0
  let r = 0
  let cache_at = 0
  for p in 0..pair_count:
    if contact_starts[p] == contact_starts[p + 1]:
      continue
    let ia = pairs[p * 2]
    let ib = pairs[p * 2 + 1]
    let pa = proxies[ia]
    let pb = proxies[ib]
    let a = slot_at ia
    let b = slot_at ib
    let fa = if is_finite pa.friction then max 0.0 pa.friction else 0.0
    let fb = if is_finite pb.friction then max 0.0 pb.friction else 0.0
    let friction = sqrt (fa * fb)
    let ra = if is_finite pa.restitution then max 0.0 pa.restitution else 0.0
    let rb = if is_finite pb.restitution then max 0.0 pb.restitution else 0.0
    let restitution = max ra rb
    for j in cache_at .. cache.contacts.length:
      let c = cache.contacts[j]
      if c.a > pa.id or (c.a == pa.id and c.b >= pb.id):
        break
      cache_at := j + 1
    for at in contact_starts[p] .. contact_starts[p + 1]:
      let c = found[at]
      let point = c.point
      let normal = c.normal
      let ro = r * row_width
      if row_width == rigid.compact_stride:
        row_buf := rigid.prepare_row_compact_into bodies iw0 a b normal.x normal.y normal.z point.x point.y point.z c.sep friction restitution ro self
      else:
        row_buf := rigid.prepare_row_into bodies iw0 a b normal.x normal.y normal.z point.x point.y point.z c.sep friction restitution ro self
      let (jn, jtx, jty, jtz) = cache_match_from cache cache_at pa.id pb.id point.x point.y point.z
      row_a_ids[r] := pa.id
      row_b_ids[r] := pb.id
      let io = r * rigid.impulse_stride
      imp_buf[io] := jn
      imp_buf[io + 1] := jtx * row_buf[ro + 17] + jty * row_buf[ro + 18] + jtz * row_buf[ro + 19]
      imp_buf[io + 2] := jtx * row_buf[ro + 20] + jty * row_buf[ro + 21] + jtz * row_buf[ro + 22]
      r := self + 1
  return (row_buf, imp_buf, row_a_ids, row_b_ids, iw0)

// Results for the woken dynamic bodies, in mover order, gathered by index
// into an exactly sized array: appending records to a List one at a time
// costs more with every append.
func moved_results (config: Config) => func sources => func proxies => func (movers: #[U32]) => func (woke: #[F32]) => func (parent: #[U32]) => func (island_time: #[F32]) => func (still: #[F32]) => func (new_pos: #[F32]) => func (new_rot: #[F32]) => func (new_vel: #[F32]) =>
  let m = movers.length
  let slots = @array.fill m 0
  let count = 0
  for k in 0..m:
    let idx = movers[k]
    if proxies[idx].kind == scene.kind_dynamic and woke[idx] > 0.0:
      slots[count] := k
      count := self + 1
  return @array.generate count (func (r: U32) =>
    let k = slots[r]
    let proxy = proxies[movers[k]]
    let body = rigid_of (sources.at proxy.source)
    let root = root_of parent k
    let sleep_now = island_time[root] >= config.sleep_time
    let v = k * 6
    let lin = if sleep_now then math.zero3 else $Vec3 { x: new_vel[v], y: new_vel[v + 1], z: new_vel[v + 2] }
    let ang = if sleep_now then math.zero3 else $Vec3 { x: new_vel[v + 3], y: new_vel[v + 4], z: new_vel[v + 5] }
    let updated = $scene.Rigid {
      kind: body.kind, mass: body.mass, gravity_scale: body.gravity_scale,
      linear_damping: body.linear_damping, angular_damping: body.angular_damping,
      can_sleep: body.can_sleep, continuous: body.continuous,
      linear_velocity: lin, angular_velocity: ang,
      sleeping: sleep_now, sleep_time: still[k],
    }
    return $Result {
      source: proxy.source,
      position: rigid.vec new_pos (k * 3),
      rotation: rigid.quat new_rot (k * 4),
      rigid: $Some updated,
      walker: $Nothing,
    })

// A controller pass belongs to one scene snapshot, query set and timestep.
// Movable rows carry spans into the working geometry returned alongside Walkers;
// fixed scenery rows stay in `sc.geometry`.
type Walkers is data = $Walkers {
  proxies: #[scene.ProxyRow], owned: #[Bool], origins: #[Vec3], velocities: #[Vec3],
  ids: #[U32], by_id: #[U32], walked: #[U32], walked_at: #[Vec3],
  walked_state: #[Walker], wake_by_push: #[F32], shifted: #[U32],
}
func stored_capsule_of (shape: shapes.StoredShape) => case shape of
  $shapes.StoredCapsule { a, b, radius } => $Some (a, b, radius)
  _ => $Nothing
func run_walkers (queries: scene.Queries) -> (sources: #[Source]) -> (sc: Scene) -> (dt: F32) : (shapes.Geometry, Walkers) =>
  return run_walkers_with queries sources sc dt false

func run_walkers_with (queries: scene.Queries) -> sources -> (sc: Scene) -> (dt: F32) -> (compact: Bool) : (shapes.Geometry, Walkers) =>
  let geometry = shapes.empty ()
  let np = scene.count sc
  // Copy movable payloads into `geometry`; fixed scenery stays in `sc.geometry`.
  let proxies = @storage.copy sc.proxies
  let owned = @array.fill np false
  let payloads: #[U32] = #[]
  let walkers: #[U32] = #[]
  let movers: #[U32] = #[]
  let velocities = @array.fill np math.zero3
  let ids = @array.fill np 0
  for i in 0 .. np:
    let row = sc.proxies[i]
    ids[i] := row.id
    if row.kind >= scene.kind_kinematic:
      if compact and not row.trigger:
        @storage.push movers i
      if row.walker:
        if let $Some w = (sources.at row.source).walker:
          velocities[i] := w.velocity
      else:
        velocities[i] := (rigid_of (sources.at row.source)).linear_velocity
    if row.walker and not row.trigger:
      @storage.push walkers i
    if row.walker or row.kind == scene.kind_dynamic:
      owned[i] := true
      let inline_shape = case row.shape of
        $shapes.StoredCapsule _ => true
        _ => false
      if not inline_shape:
        @storage.push payloads i
  for i in payloads:
    let row = sc.proxies[i]
    let (packed, next_geom) = scene.pack_proxy geometry (scene.unpack_proxy sc.geometry row)
    geometry := next_geom
    proxies[i] := packed
  let origins = @array.fill (if compact then movers.length else np) math.zero3
  for k in 0 .. origins.length:
    let i = if compact then movers[k] else k
    origins[k] := (sources.at sc.proxies[i].source).position
  let by_id = order_proxy_ids ids
  // Characters move first, on the world as it stood; they shove dynamic
  // bodies they walk into and leave their motion as a velocity for the solver.
  // Results stay with this step, including pushes and the original walk pose.
  let walked = @array.fill (if compact then 0 else np) 0
  let walked_at = @array.fill (if compact then 0 else np) math.zero3
  let walked_state = @array.fill (if compact then 0 else np) scene.default_walker
  let wake_by_push = @array.fill np 0.0
  let shifted: #[U32] = #[]
  for i in walkers:
    let row = proxies[i]
    let source = (sources.at proxies[i].source)
    if let $Some walker = source.walker:
      if let $Some (a, b, radius) = stored_capsule_of proxies[i].shape:
        let body = $character.Body { low: a - source.position, high: b - source.position, radius }
        let filter = $scene.Filter { mask: proxies[i].mask, skip: proxies[i].id, triggers: false, walkers: false, dynamics: true }
        let under = if walker.ground == 0 then np else index_of_id ids by_id walker.ground
        // How far the platform underfoot moved this step: its translation
        // plus the turn about its own origin, at the character's feet.
        let carry = math.zero3
        if walker.grounded and under < np:
          let platform = proxies[under]
          if platform.kind != scene.kind_static:
            let origin = (sources.at platform.source).position
            let angular = if platform.kind >= scene.kind_kinematic and not platform.walker then (rigid_of (sources.at platform.source)).angular_velocity else math.zero3
            carry := (velocities[under] + angular.cross (source.position - origin)) * dt
        let motion_hits: #[scene.Hit] = #[]
        let moved = character.move_queries motion_hits queries body filter source.position walker carry dt
        let shift = moved.position - source.position
        let (moved_row, next_geom) = scene.shifted_row geometry proxies[i] shift
        geometry := next_geom
        proxies[i] := moved_row
        if shift.x != 0.0 or shift.y != 0.0 or shift.z != 0.0:
          @storage.push shifted i
        if not compact or is_mover row:
          let origin_slot = if compact then F32.to_u32 (sparse_mover_slot movers i) else i
          origins[origin_slot] := moved.position
        let walk_vel = if dt > 0.0 then shift / dt else math.zero3
        velocities[i] := if math.finite3 walk_vel then walk_vel else math.zero3
        for h in moved.hits:
          if h.proxy < np:
            let other = proxies[h.proxy]
            if other.kind == scene.kind_dynamic and not other.trigger:
              let away = shapes.neg h.normal
              let approach = max 0.0 (away.dot walker.velocity)
              let current = velocities[h.proxy].dot away
              let extra = max 0.0 (approach * walker.push - current)
              velocities[h.proxy] := velocities[h.proxy] + away * extra
              if extra > 0.0:
                wake_by_push[h.proxy] := 1.0
        if compact:
          @storage.push walked i
          @storage.push walked_at moved.position
          @storage.push walked_state moved.walker
        else:
          walked[i] := 1
          walked_at[i] := moved.position
          walked_state[i] := moved.walker
  return (geometry, $Walkers {proxies, owned, origins, velocities, ids, by_id, walked, walked_at, walked_state, wake_by_push, shifted})


// The prepared-static adapter appends immutable fixed proxies to the moving
// prefix after neighborhood selection. Their controllers and velocities are empty.
func extend_walkers (walk: own Walkers) -> (sources: #[Source]) -> (sc: Scene) : Walkers =>
  return extend_walkers_with walk sources sc false

func extend_walkers_with (walk: own Walkers) -> sources -> (sc: Scene) -> (compact: Bool) : Walkers =>
  let first = walk.proxies.length
  if first > sc.proxies.length:
    return panic "walker prefix exceeds scene"
  let total = sc.proxies.length
  if first == total:
    return walk
  let $Walkers { proxies, owned, origins, velocities, ids, by_id: _, walked, walked_at, walked_state, wake_by_push, shifted } = walk
  for i in first .. total:
    let row = sc.proxies[i]
    @storage.push proxies row
    @storage.push owned false
    @storage.push velocities math.zero3
    if not compact:
      @storage.push origins (sources.at row.source).position
      @storage.push walked 0
      @storage.push walked_at math.zero3
      @storage.push walked_state scene.default_walker
    @storage.push wake_by_push 0.0
    @storage.push ids row.id
  let by_id = order_proxy_ids ids
  return $Walkers { proxies, owned, origins, velocities, ids, by_id, walked, walked_at, walked_state, wake_by_push, shifted }

// A solve reads one cache bank and writes the next contacts into the other;
// the caller swaps `first_active` when solved.
func simulate_queries_into (queries: scene.Queries) -> (joint_list: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> (sources: #[Source]) -> (sc: Scene) -> (cache: own CacheAccess) -> (results: own #[Result]) : (Bool, CacheAccess, #[Result]) =>
  return simulate_queries_with queries joint_list config dt sources sc cache results

private func simulate_queries_with (queries: scene.Queries) -> (joint_list: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> sources -> (sc: Scene) -> (cache: own CacheAccess) -> (results: own #[Result]) : (Bool, CacheAccess, #[Result]) =>
  if not (dt > 0.0 and dt - dt == 0.0):
    @storage.truncate results 0
    return (false, cache, results)
  let (geometry, walk) = run_walkers_with queries sources sc dt true
  return simulate_walked_columns queries joint_list config dt sources sc cache results geometry walk sc.proxies.length (shapes.read sc.geometry) true

// `walk` must be the controller pass for this scene's current proxy prefix,
// with any fixed-only suffix added through extend_walkers.
func simulate_walked_into (queries: scene.Queries) -> (joint_list: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> (sources: #[Source]) -> (sc: Scene) -> (cache: own CacheAccess) -> (results: own #[Result]) -> (geometry: own shapes.Geometry) -> (walk: own Walkers) : (Bool, CacheAccess, #[Result]) =>
  return simulate_walked_with_fixed queries joint_list config dt sources sc cache results geometry walk sc.proxies.length (shapes.read sc.geometry) false

// Prepared worlds keep selected fixed rows pointing into their immutable pools.
func simulate_walked_with_fixed (queries: scene.Queries) -> (joint_list: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> (sources: #[Source]) -> (sc: Scene) -> (cache: own CacheAccess) -> (results: own #[Result]) -> (geometry: own shapes.Geometry) -> (walk: own Walkers) -> (fixed_first: U32) -> (fixed_geometry: shapes.Read) -> (compact: Bool) : (Bool, CacheAccess, #[Result]) =>
  return simulate_walked_columns queries joint_list config dt sources sc cache results geometry walk fixed_first fixed_geometry compact

func simulate_prepared_rows (queries: scene.Queries) -> (joint_list: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> (sources: #[scene.SourceRow]) -> (sc: Scene) -> (cache: own CacheAccess) -> (results: own #[Result]) -> (geometry: own shapes.Geometry) -> (walk: own Walkers) -> (fixed_first: U32) -> (fixed_geometry: shapes.Read) : (Bool, CacheAccess, #[Result]) =>
  return simulate_walked_columns queries joint_list config dt sources sc cache results geometry walk fixed_first fixed_geometry true

private func simulate_walked_columns (queries: scene.Queries) -> (joint_list: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> sources -> (sc: Scene) -> (cache: own CacheAccess) -> (results: own #[Result]) -> (geometry: own shapes.Geometry) -> (walk: own Walkers) -> (fixed_first: U32) -> (fixed_geometry: shapes.Read) -> (compact: Bool) : (Bool, CacheAccess, #[Result]) =>
  if not (dt > 0.0 and dt - dt == 0.0):
    @storage.truncate results 0
    return (false, cache, results)
  let (fresh, carried, next_results) = solve_walked_with_fixed queries joint_list config dt sources sc (read_cache cache) geometry walk results fixed_first fixed_geometry compact
  if cache.first_active:
    cache.second := merge_contacts_into (&fresh[0..fresh.length]) (&carried[0..carried.length]) self
  else:
    cache.first := merge_contacts_into (&fresh[0..fresh.length]) (&carried[0..carried.length]) self
  return (true, cache, next_results)
func swap_cache (solved: Bool) -> (step: own StepAccess) : StepAccess =>
  if solved:
    step.cache.first_active := not self
  return step
func solve_walked_into (queries: scene.Queries) -> (joint_list: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> (sources: #[Source]) -> (sc: Scene) -> (cache: Cache) -> (geometry: own shapes.Geometry) -> (walk: own Walkers) -> (results: own #[Result]) : (#[CachedContact], #[CachedContact], #[Result]) =>
  return solve_walked_with_fixed queries joint_list config dt sources sc cache geometry walk results sc.proxies.length (shapes.read sc.geometry) false

private func solve_walked_with_fixed (queries: scene.Queries) -> (joint_list: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> sources -> (sc: Scene) -> (cache: Cache) -> (geometry: own shapes.Geometry) -> (walk: own Walkers) -> (results: own #[Result]) -> (fixed_first: U32) -> (fixed_geometry: shapes.Read) -> (compact: Bool) : (#[CachedContact], #[CachedContact], #[Result]) =>
  @storage.truncate results 0
  let np = scene.count sc
  if walk.proxies.length != np:
    return panic "walker pass differs from scene"
  let $Walkers {proxies: walk_proxies, owned, origins, velocities, ids, by_id, walked, walked_at, walked_state, wake_by_push, shifted} = walk
  let movers = mover_ids walk_proxies
  let m = movers.length
  // Explicit joints wake their connected dynamics.
  let connected = @array.fill (if joint_list.is_empty then 0 else sources.length) 0
  for joint in joint_list:
    if joints.valid joint and joint.a < sources.length and joint.b < sources.length:
      connected[joint.a] := 1
      connected[joint.b] := 1
  let awake = @array.fill np 0.0
  for i in movers:
    let p = walk_proxies[i]
    if p.kind == scene.kind_dynamic and not p.trigger:
      if (not connected.is_empty and connected[p.source] > 0) or not (rigid_of (sources.at p.source)).sleeping:
        awake[i] := 1.0
  // Sweep each fast body's inscribed sphere against immovable colliders.
  for k in 0 .. m:
    let i = movers[k]
    let origin_slot = if compact then k else i
    if walk_proxies[i].kind == scene.kind_dynamic and awake[i] > 0.0 and not walk_proxies[i].trigger:
      let body = rigid_of (sources.at walk_proxies[i].source)
      if body.continuous:
        let delta = velocities[i] * dt
        let travel = delta.length
        if travel > walk_proxies[i].inscribed * 0.5 and travel > 0.0001:
          let filter = $scene.Filter { mask: walk_proxies[i].mask, skip: walk_proxies[i].id, triggers: false, walkers: false, dynamics: false }
          if let $Some h = scene.query_cast queries origins[origin_slot] origins[origin_slot] walk_proxies[i].inscribed delta filter:
            if h.depth == 0.0:
              let shift = delta * max 0.0 (h.time - 0.01 / travel)
              let (moved_row, next_geom) = scene.shifted_row geometry walk_proxies[i] shift
              geometry := next_geom
              walk_proxies[i] := moved_row
              @storage.push shifted i
              origins[origin_slot] := origins[origin_slot] + shift
  // Broad phase and body setup need only the stored proxy rows. Resolve
  // borrowed geometry only for candidates that reach narrow phase.
  let proxies = walk_proxies
  let shape_at = func (i: U32) : shapes.Shape =>
    let stored = proxies[i].shape
    if owned[i]:
      return shapes.unpack geometry stored
    if i >= fixed_first:
      return shapes.unpack fixed_geometry stored
    return shapes.unpack sc.geometry stored
  let grow = @array.generate m (func (k: U32) => 0.04 + (velocities[movers[k]]).length * dt)
  // Active: awake or pushed dynamic bodies, moving kinematic bodies.
  let woke = awake
  let active0 = @array.fill np 0.0
  let active_slots = if compact then movers.length else np
  for slot in 0 .. active_slots:
    let i = if compact then movers[slot] else slot
    woke[i] := max self wake_by_push[i]
    if woke[i] > 0.0 or (proxies[i].kind == scene.kind_kinematic and not proxies[i].trigger and velocities[i].length_squared > 0.0000001):
      active0[i] := 1.0
  let broad_index = if sc.index.order.length == np then $Some sc.index else $Nothing
  let candidates0 = broad_phase_shifted broad_index proxies movers grow active0 shifted
  // Active contacts wake sleepers and propagate through cached support pairs.
  let pair_count = candidates0.length / 2
  let woken = false
  for p in 0..pair_count:
    let a = candidates0[p * 2]
    let b = candidates0[p * 2 + 1]
    if proxies[a].kind == scene.kind_dynamic and woke[a] == 0.0 and active0[b] > 0.0:
      woke[a] := 1.0
      woken := true
    if proxies[b].kind == scene.kind_dynamic and woke[b] == 0.0 and active0[a] > 0.0:
      woke[b] := 1.0
      woken := true
  let cache_rows = cache.contacts.length
  let row_a = @array.generate cache_rows (func (r: U32) => proxy_with_id proxies by_id cache.contacts[r].a)
  let row_b = @array.generate cache_rows (func (r: U32) => proxy_with_id proxies by_id cache.contacts[r].b)
  if woken:
    if cache_rows > 0x7FFFFFFF:
      return panic "contact wake edge count overflows"
    let endpoints = @array.fill (cache_rows * 2) 0
    let targets = @array.fill (cache_rows * 2) 0
    let used = 0
    for r in 0 .. cache_rows:
      let a = row_a[r]
      let b = row_b[r]
      if a < np and b < np:
        endpoints[used] := a
        targets[used] := b
        endpoints[used + 1] := b
        targets[used + 1] := a
        used := self + 2
    let adjacency_starts: #[U32] = #[]
    let adjacency_targets: #[U32] = #[]
    let (built, adjacency_starts, adjacency_targets) = graph.from_edges np (&endpoints[0..used]) (&targets[0..used]) adjacency_starts adjacency_targets
    if not built:
      return panic "physics contact graph invariant"
    let adjacency = graph.borrow adjacency_starts adjacency_targets
    let root_count: U32 = 0
    for i in 0 .. np:
      if woke[i] > 0.0:
        root_count := self + 1
    let roots: #[U32] = array.fill root_count 0
    let root_at: U32 = 0
    for i in 0 .. np:
      if woke[i] > 0.0:
        roots[root_at] := i
        root_at := self + 1
    let active = graph.reachable adjacency roots (@array.generate np (func i => proxies[i].kind == scene.kind_dynamic))
    woke := @array.generate np (func i => if active[i] then 1.0 else 0.0)
  // Bodies that just woke now need their contacts with everything near.
  let candidates = candidates0
  if woken:
    let active1 = @array.generate np (func (i: U32) =>
      if woke[i] > 0.0 or active0[i] > 0.0:
        return 1.0
      return 0.0)
    candidates := broad_phase_shifted broad_index proxies movers grow active1 shifted
  let dense_slots = @array.fill (if m >= np / 4 and (not candidates.is_empty or not joint_list.is_empty) then np else 0) no_slot
  if not dense_slots.is_empty:
    for k in 0 .. m:
      dense_slots[movers[k]] := U32.to_f32 k
  let slot_at = func (i: U32) : F32 =>
    if i < dense_slots.length then dense_slots[i] else sparse_mover_slot movers i
  let (fresh, carried, walker_results, bodies_moved) = with_body_columns sources proxies movers (func (k: U32) : Vec3 => origins[if compact then k else movers[k]]) velocities woke (func (own bodies) =>
    let (row_array, imp_array, row_a_ids, row_b_ids, iw) = with_contact_rows dt proxies shape_at velocities woke by_id candidates bodies slot_at cache rigid.compact_stride
    let substeps = contact_substeps_width config.substeps row_array rigid.compact_stride bodies.inv_mass bodies.pos
    let prepared = prepare_joints_with joint_list sources sc slot_at
    let $rigid.Bodies {pos, rot, vel, inv_mass, inv_inertia, gravity_scale, linear_damping, angular_damping} = bodies
    let dynamics = $rigid.Dynamics {inv_mass, inv_inertia, gravity_scale, linear_damping, angular_damping}
    let (new_pos, new_rot, new_vel, solved) = rigid.solve_initialized prepared dt substeps config.gravity dynamics row_array rigid.compact_stride pos rot vel imp_array iw
    return with_sleep_islands_width config dt sources proxies movers connected inv_mass row_array rigid.compact_stride new_vel (func parent -> still -> island_time =>
      let count = row_array.length / rigid.compact_stride
      // Merge solved and unchanged sleeping contacts in exact U32 id order.
      let fresh = @array.generate count (func (c: U32) =>
        let o = c * rigid.compact_stride
        let q = c * rigid.impulse_stride
        let jt1 = solved[q + 1]
        let jt2 = solved[q + 2]
        return $CachedContact {
          a: row_a_ids[c], b: row_b_ids[c],
          point: rigid.vec row_array (o + 24),
          normal: rigid.vec row_array (o + 2),
          normal_impulse: solved[q],
          tangent_impulse: $Vec3 {
            x: row_array[o + 17] * jt1 + row_array[o + 20] * jt2,
            y: row_array[o + 18] * jt1 + row_array[o + 21] * jt2,
            z: row_array[o + 19] * jt1 + row_array[o + 22] * jt2,
          },
        })
      let kept_rows = @array.fill cache_rows 0
      let kept = 0
      for r in 0..cache_rows:
        let ia = row_a[r]
        let ib = row_b[r]
        if ia < np and ib < np and woke[ia] == 0.0 and woke[ib] == 0.0:
          kept_rows[kept] := r
          kept := self + 1
      let carried = @array.generate kept (func (r: U32) => cache.contacts[kept_rows[r]])
      let bodies_moved = moved_results config sources proxies movers woke parent island_time still new_pos new_rot new_vel
      let walker_slots: #[U32] = #[]
      if not compact:
        for i in 0 .. np:
          if walked[i] > 0:
            @storage.push walker_slots i
      let walker_results = @array.generate (if compact then walked.length else walker_slots.length) (func (r: U32) =>
        let i = if compact then walked[r] else walker_slots[r]
        let at = if compact then r else i
        let source = proxies[i].source
        return $Result { source, position: walked_at[at], rotation: (sources.at source).rotation, rigid: $Nothing, walker: $Some walked_state[at] })
      return (fresh, carried, walker_results, bodies_moved)))
  for result in walker_results:
    @storage.push results result
  for result in bodies_moved:
    @storage.push results result
  return (fresh, carried, results)

// Stable lexicographic U32 order, with fresh rows preceding equal carried
// rows exactly as before. Publication writes only the disjoint inactive bank.
func merge_contacts_into (a: &[CachedContact]) -> (b: &[CachedContact]) -> (destination: own #[CachedContact]) : #[CachedContact] =>
  @storage.truncate destination 0
  let na = a.length
  let nb = b.length
  let i: U32 = 0
  let j: U32 = 0
  for k in 0..(na + nb):
    let take_a = false
    if j >= nb:
      take_a := true
    else:
      if i < na:
        let ca = a[i]
        let cb = b[j]
        take_a := ca.a < cb.a or (ca.a == cb.a and ca.b <= cb.b)
    if take_a:
      @storage.push destination a[i]
      i := self + 1
    else:
      @storage.push destination b[j]
      j := self + 1
  return destination
func run_step_queries (source_rows: &[scene.SourceRow]) -> (geometry: shapes.Geometry) -> (links: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> (sc: Scene) -> (cache: own CacheAccess) -> (results: own #[Result]) : (Bool, CacheAccess, #[Result]) =>
  return simulate_queries_with (scene.queries sc) links config dt source_rows sc cache results
func run_rebuilt_queries (source_rows: &[scene.SourceRow]) -> (geometry: shapes.Geometry) -> (links: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> (cache: own CacheAccess) -> (results: own #[Result]) : (Bool, CacheAccess, #[Result]) =>
  if not (dt > 0.0 and is_finite dt):
    @storage.truncate results 0
    return (false, cache, results)
  let built = scene.build_source_rows (scene.empty ()) geometry source_rows
  return simulate_queries_with (scene.queries built) links config dt source_rows built cache results
func simulate_joints_into (links: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> (step: own StepAccess) -> (sc: Scene) : StepAccess =>
  let $StepAccess { sources: source_rows, geometry, cache, results } = step
  let (solved, cache, results) = run_step_queries (&source_rows[0..source_rows.length]) geometry links config dt sc cache results
  return swap_cache solved ($StepAccess { sources: source_rows, geometry, cache, results })
func simulate_into (config: Config) -> (dt: F32) -> (step: own StepAccess) -> (sc: Scene) : StepAccess => return
  simulate_joints_into #[] config dt step sc
// Convenience construction stays invocation-local. Persistent sources, cache
// banks and results retain the exact caller-named owners across every tick.
func simulate_rebuilt_into (links: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> (step: own StepAccess) : StepAccess =>
  let $StepAccess { sources: source_rows, geometry, cache, results } = step
  let (solved, cache, results) = run_rebuilt_queries (&source_rows[0..source_rows.length]) geometry links config dt cache results
  return swap_cache solved ($StepAccess { sources: source_rows, geometry, cache, results })
func step_joints_into (links: #[joints.Joint]) -> (config: Config) -> (dt: F32) -> (step: own StepAccess) : StepAccess => return
  apply_into (simulate_rebuilt_into links config dt step)
func step_into (config: Config) -> (dt: F32) -> (step: own StepAccess) : StepAccess => step_joints_into #[] config dt step

// Queries take built scenes and layer masks; only overlaps include triggers.

const all_layers: U32 = 65535

// The first solid hit along a ray of length `reach`, ignoring the entity
// `skip` (0 for none): `physics.ray scene origin direction reach mask skip`.
func ray (sc: Scene) => func (origin: Vec3) => func (direction: Vec3) => func (reach: F32) => func (mask: U32) => func (skip: U32) => scene.ray sc origin direction reach mask skip

// Move a sphere by `delta`; the first thing it touches.
func sweep_sphere (sc: Scene) => func (center: Vec3) => func (radius: F32) => func (delta: Vec3) => func (mask: U32) => func (skip: U32) => return
  scene.cast sc center center radius delta ($scene.Filter { mask, skip, triggers: false, walkers: true, dynamics: true })

// Move a capsule (the segment a-b with a radius) by `delta`.
func sweep_capsule (sc: Scene) => func (a: Vec3) => func (b: Vec3) => func (radius: F32) => func (delta: Vec3) => func (mask: U32) => func (skip: U32) => return
  scene.cast sc a b radius delta ($scene.Filter { mask, skip, triggers: false, walkers: true, dynamics: true })

// The entity ids overlapping a sphere or a capsule, triggers included.
func overlap_sphere (sc: Scene) => func (center: Vec3) => func (radius: F32) => func (mask: U32) => scene.overlap_sphere sc center radius mask
func overlap_capsule (sc: Scene) => func (a: Vec3) => func (b: Vec3) => func (radius: F32) => func (mask: U32) => scene.overlap_capsule sc a b radius mask

// Is the point inside anything solid?
func point_solid (sc: Scene) => func (p: Vec3) => func (mask: U32) => scene.point_solid sc p mask

// Did the last step have a contact between these two entities? `contacts` is
// the contact cache returned by `simulate`.
func touching (cache: Cache) => func (a: U32) => func (b: U32) =>
  let low = min a b
  let high = a
  if a < b:
    high := b
  let i = cache_find cache low high
  return i < cache.contacts.length and cache.contacts[i].a == low and cache.contacts[i].b == high

func contact_count (cache: Cache) => cache.contacts.length
