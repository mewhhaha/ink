import { Vec3 } from "std/vector"
import * as vector from "std/vector"
import * as math from "../math"

// World-space camera-facing ribbon / beam trail mesh generator.
// Takes an ordered polyline of trail points (head to tail) with per-point
// width and color, computes smooth side vectors facing `camera_pos`, and emits
// triangle-list vertices `(position, u, v, color)` suitable for any renderer.

type Point is data = $Point {
  position: Vec3,
  width: F32,
  color: math.Color,
}

type Vertex is data = $Vertex {
  position: Vec3,
  u: F32,
  v: F32,
  color: math.Color,
}

private func unit_or (v: Vec3) -> (fallback: Vec3) : Vec3 =>
  return case math.normalize3 v of
    $Some u => u
    $Nothing => fallback

// Emit `(points.length - 1) * 6` triangle-list vertices for a camera-facing
// ribbon strip connecting `points` in order (`u` runs 0..1 head-to-tail, `v`
// runs 0..1 across width).
func build (points: #[Point]) -> (camera_pos: Vec3) : #[Vertex] =>
  let n = points.length
  if n < 2 or not (math.finite3 camera_pos):
    return #[]
  for i in 0 .. n:
    let pt = points[i]
    if not (math.finite3 pt.position and is_finite pt.width):
      return #[]
  let left = @array.fill n math.zero3
  let right = @array.fill n math.zero3
  let us = @array.fill n 0.0
  let total_len = 0.0
  for i in 1 .. n:
    total_len := self + vector.Vec3.length (points[i].position - points[i - 1].position)
    if not (is_finite total_len):
      return #[]
    us[i] := total_len
  let inv_len = if total_len > 0.000001 then 1.0 / total_len else 0.0
  for i in 0 .. n:
    us[i] := self * inv_len
    let tangent = if i == 0 then points[1].position - points[0].position else if i + 1 == n then points[n - 1].position - points[n - 2].position else points[i + 1].position - points[i - 1].position
    let t_unit = unit_or tangent math.forward
    let to_cam = unit_or (camera_pos - points[i].position) math.up
    let side = unit_or (vector.Vec3.cross t_unit to_cam) math.right
    let half_w = max 0.0 points[i].width * 0.5
    left[i] := points[i].position - side * half_w
    right[i] := points[i].position + side * half_w
  let out: #[Vertex] = #[]
  for i in 0 .. (n - 1):
    let c0 = points[i].color
    let c1 = points[i + 1].color
    let u0 = us[i]
    let u1 = us[i + 1]
    let v00 = $Vertex { position: left[i], u: u0, v: 0.0, color: c0 }
    let v01 = $Vertex { position: right[i], u: u0, v: 1.0, color: c0 }
    let v10 = $Vertex { position: left[i + 1], u: u1, v: 0.0, color: c1 }
    let v11 = $Vertex { position: right[i + 1], u: u1, v: 1.0, color: c1 }
    @storage.push out v00
    @storage.push out v01
    @storage.push out v11
    @storage.push out v00
    @storage.push out v11
    @storage.push out v10
  return out
