import * as array from "std/array"

// Deterministic trigger volume lifecycle tracking (Enter, Stay, Exit) over
// full-width U32 `(trigger, body)` overlap pairs. Callers own the persistent
// previous-overlap pool; `diff` and `step` sort and deduplicate both sets and
// merge them in linear time.

type Pair is data = $Pair { trigger: U32, body: U32 }
type Phase is data = $Enter | $Stay | $Exit
type Event is data = $Event { trigger: U32, body: U32, phase: Phase }

private func less_pair (a: Pair) -> (b: Pair) : Bool =>
  if a.trigger != b.trigger:
    return a.trigger < b.trigger
  return a.body < b.body

private func same_pair (a: Pair) -> (b: Pair) : Bool =>
  return a.trigger == b.trigger and a.body == b.body

// Bottom-up iterative merge sort for Pair arrays, then deduplication.
func canonical (pairs: #[Pair]) : #[Pair] =>
  let n = pairs.length
  if n <= 1:
    return @array.generate n (func (i: U32) => pairs[i])
  let strictly_sorted = true
  for i in 1 .. n:
    if not (less_pair pairs[i - 1] pairs[i]):
      strictly_sorted := false
      break
  if strictly_sorted:
    return @array.generate n (func (i: U32) => pairs[i])
  let src = @array.generate n (func (i: U32) => pairs[i])
  let dst = @array.fill n src[0]
  let width = 1
  let in_dst = false
  for 0 .. 32:
    if width >= n:
      break
    let left = 0
    for 0 .. n:
      if left >= n:
        break
      let mid = min (left + width) n
      let right = min (left + width * 2) n
      let i = left
      let j = mid
      if not in_dst:
        for k in left .. right:
          if i < mid and (j >= right or not (less_pair src[j] src[i])):
            dst[k] := src[i]
            i := self + 1
          else:
            dst[k] := src[j]
            j := self + 1
      else:
        for k in left .. right:
          if i < mid and (j >= right or not (less_pair dst[j] dst[i])):
            src[k] := dst[i]
            i := self + 1
          else:
            src[k] := dst[j]
            j := self + 1
      left := right
    in_dst := not self
    width := self * 2
  let ordered = if in_dst then dst else src
  let unique: #[Pair] = #[]
  @storage.push unique ordered[0]
  for i in 1 .. n:
    if not (same_pair ordered[i] ordered[i - 1]):
      @storage.push unique ordered[i]
  return unique

// Merge two canonical overlap sets into sorted lifecycle events.
func diff_canonical (previous: #[Pair]) -> (current: #[Pair]) : #[Event] =>
  let out: #[Event] = #[]
  let i = 0
  let j = 0
  let pn = previous.length
  let cn = current.length
  for 0 .. (pn + cn):
    if i >= pn and j >= cn:
      break
    if i < pn and j < cn:
      let a = previous[i]
      let b = current[j]
      if same_pair a b:
        @storage.push out ($Event { trigger: a.trigger, body: a.body, phase: $Stay })
        i := self + 1
        j := self + 1
      else:
        if less_pair a b:
          @storage.push out ($Event { trigger: a.trigger, body: a.body, phase: $Exit })
          i := self + 1
        else:
          @storage.push out ($Event { trigger: b.trigger, body: b.body, phase: $Enter })
          j := self + 1
    else:
      if i < pn:
        let a = previous[i]
        @storage.push out ($Event { trigger: a.trigger, body: a.body, phase: $Exit })
        i := self + 1
      else:
        let b = current[j]
        @storage.push out ($Event { trigger: b.trigger, body: b.body, phase: $Enter })
        j := self + 1
  return out

// Diff arbitrary (unsorted, possibly duplicate) overlap lists into lifecycle events.
func diff (previous: #[Pair]) -> (current: #[Pair]) : #[Event] =>
  return diff_canonical (canonical previous) (canonical current)

// Advance caller-owned `previous` overlap storage to `current` and return the
// sorted Enter/Stay/Exit events.
func step (previous: own #[Pair]) -> (current: #[Pair]) : (#[Event], #[Pair]) =>
  let pn = previous.length
  let prev_ready = true
  for i in 1 .. pn:
    if not (less_pair previous[i - 1] previous[i]):
      prev_ready := false
      break
  let curr_canon = canonical current
  let events = if prev_ready then diff_canonical previous curr_canon else diff_canonical (canonical previous) curr_canon
  let cn = curr_canon.length
  let common = min pn cn
  for i in 0 .. common:
    previous[i] := curr_canon[i]
  for i in common .. cn:
    @storage.push previous curr_canon[i]
  if pn > cn:
    @storage.truncate previous cn
  return (events, previous)
