//! XPBD/Verlet cloth and rope solver (pinned masses, structural/shear/bending
//! distance constraints, gravity/wind/drag, sphere/plane collisions) and
//! Archimedes spherical-pontoon water buoyancy with hydrodynamic drag.
//!
//! Key items: [`Particle`], [`Link`], [`Collider`], [`Pontoon`], [`grid_links`].

import { Vec3 } from "std/vector"
import * as vector from "std/vector"
import * as math from "../math"

type Particle is data = $Particle {
  position: Vec3,
  previous: Vec3,
  inv_mass: F32,
  radius: F32,
}

type Link is data = $Link {
  a: U32,
  b: U32,
  rest: F32,
  compliance: F32,
}

type Collider is data =
  | $Sphere { center: Vec3, radius: F32 }
  | $Plane { normal: Vec3, distance: F32 }

type Pontoon is data = $Pontoon {
  offset: Vec3,
  radius: F32,
  volume: F32,
}

type BuoyancyResult is data = $BuoyancyResult {
  force: Vec3,
  torque: Vec3,
  submerged_fraction: F32,
}

private func unit_or (v: Vec3) -> (fallback: Vec3) : Vec3 =>
  return case math.normalize3 v of
    $Some u => u
    $Nothing => fallback

// Build structural, diagonal shear, and 2-hop bending links for a `cols x rows`
// cloth grid with cell `spacing` (capped at 65,536 vertices / ~393k links).
func grid_links (cols: U32) -> (rows: U32) -> (spacing: F32) -> (stretch_compliance: F32) -> (bend_compliance: F32) : #[Link] =>
  if cols < 2 or rows < 2 or rows > 65536 / cols or not (is_finite spacing and is_finite stretch_compliance and is_finite bend_compliance) or spacing <= 0.0 or stretch_compliance < 0.0 or bend_compliance < 0.0:
    return #[]
  let diag = spacing * sqrt 2.0
  let bend = spacing * 2.0
  if not (is_finite diag and is_finite bend):
    return #[]
  let out: #[Link] = #[]
  for r in 0 .. rows:
    for c in 0 .. cols:
      let i = r * cols + c
      if c + 1 < cols:
        @storage.push out ($Link { a: i, b: i + 1, rest: spacing, compliance: stretch_compliance })
      if r + 1 < rows:
        @storage.push out ($Link { a: i, b: i + cols, rest: spacing, compliance: stretch_compliance })
      if c + 1 < cols and r + 1 < rows:
        @storage.push out ($Link { a: i, b: i + cols + 1, rest: diag, compliance: stretch_compliance })
        @storage.push out ($Link { a: i + 1, b: i + cols, rest: diag, compliance: stretch_compliance })
      if c + 2 < cols:
        @storage.push out ($Link { a: i, b: i + 2, rest: bend, compliance: bend_compliance })
      if r + 2 < rows:
        @storage.push out ($Link { a: i, b: i + cols * 2, rest: bend, compliance: bend_compliance })
  return out

private func scaled_delta (a: Vec3) -> (b: Vec3) : (F32, Vec3) =>
  let hx = b.x * 0.5 - a.x * 0.5
  let hy = b.y * 0.5 - a.y * 0.5
  let hz = b.z * 0.5 - a.z * 0.5
  let m = max (abs hx) (max (abs hy) (abs hz))
  if not (is_finite m):
    return (1.0 / 0.0, math.zero3)
  if m == 0.0:
    return (0.0, math.zero3)
  let sx = hx / m
  let sy = hy / m
  let sz = hz / m
  let s_len = sqrt (sx * sx + sy * sy + sz * sz)
  let dist = (2.0 * m) * s_len
  let inv = 1.0 / s_len
  return (dist, $Vec3 { x: sx * inv, y: sy * inv, z: sz * inv })

private func resolve_collider_pre (p: Vec3) -> (r: F32) -> (c: Collider) : Maybe Vec3 =>
  return case c of
    $Sphere { center, radius } => do:
      let min_d = max 0.0 radius + max 0.0 r
      if not (is_finite min_d):
        break $Nothing
      let dx = p.x - center.x
      let dy = p.y - center.y
      let dz = p.z - center.z
      let d2 = dx * dx + dy * dy + dz * dz
      let min_d2 = min_d * min_d
      if is_finite d2 and is_finite min_d2:
        if d2 >= min_d2:
          break $Some p
        let dist = sqrt d2
        let dir = if dist > 0.0 then $Vec3 { x: dx / dist, y: dy / dist, z: dz / dist } else math.up
        let resolved = center + dir * min_d
        break if math.finite3 resolved then $Some resolved else $Nothing
      let (sdist, sdir) = scaled_delta center p
      if not (is_finite sdist) or sdist >= min_d:
        break $Some p
      let dir = if sdist > 0.000001 and math.finite3 sdir then sdir else math.up
      let resolved = center + dir * min_d
      break if math.finite3 resolved then $Some resolved else $Nothing
    $Plane { normal, distance } => do:
      let n = normal
      let min_d = max 0.0 r
      let signed = n.x * p.x + n.y * p.y + n.z * p.z - distance
      if is_finite signed:
        if signed >= min_d:
          break $Some p
        let pen = min_d - signed
        let resolved = $Vec3 { x: p.x + n.x * pen, y: p.y + n.y * pen, z: p.z + n.z * pen }
        break if is_finite pen and math.finite3 resolved then $Some resolved else $Nothing
      let hs = (n.x * (p.x * 0.5) + n.y * (p.y * 0.5) + n.z * (p.z * 0.5)) - distance * 0.5
      if not (is_finite hs):
        break $Nothing
      if hs >= min_d * 0.5:
        break $Some p
      let pen = min_d - 2.0 * hs
      let resolved = $Vec3 { x: p.x + n.x * pen, y: p.y + n.y * pen, z: p.z + n.z * pen }
      break if is_finite pen and math.finite3 resolved then $Some resolved else $Nothing

// Step a cloth or rope particle system with XPBD distance constraints.
// Particles with `inv_mass <= 0.0` are pinned.
func step_cloth (gravity: Vec3) -> (wind: Vec3) -> (drag: F32) -> (dt: F32) -> (iterations: U32) -> (links: #[Link]) -> (colliders: #[Collider]) -> (particles: own #[Particle]) : (Bool, #[Particle]) =>
  let count = particles.length
  if count == 0 or not (math.finite3 gravity and math.finite3 wind and is_finite drag and is_finite dt) or dt < 0.0:
    return (false, particles)
  for pt in particles:
    if not (math.finite3 pt.position and math.finite3 pt.previous and is_finite pt.inv_mass and is_finite pt.radius) or pt.inv_mass < 0.0 or pt.radius < 0.0:
      return (false, particles)
  let pre_colliders: #[Collider] = #[]
  let has_colliders = colliders.length > 0
  if has_colliders:
    for c in colliders:
      let valid = case c of
        $Sphere { center, radius } => do:
          if not (math.finite3 center and is_finite radius):
            break false
          @storage.push pre_colliders c
          break true
        $Plane { normal, distance } => do:
          if not (math.finite3 normal and is_finite distance):
            break false
          @storage.push pre_colliders ($Plane { normal: unit_or normal math.up, distance })
          break true
      if not valid:
        return (false, particles)
  for link in links:
    if link.a >= count or link.b >= count or not (is_finite link.rest and is_finite link.compliance) or link.rest < 0.0 or link.compliance < 0.0:
      return (false, particles)
  let dt2 = dt * dt
  if dt == 0.0 or dt2 <= 0.0 or not (is_finite dt2):
    return (true, particles)
  let damp = clamp 0.0 1.0 (1.0 - clamp 0.0 1.0 drag)
  let accel_x = (gravity.x + wind.x) * dt2
  let accel_y = (gravity.y + wind.y) * dt2
  let accel_z = (gravity.z + wind.z) * dt2
  if not (is_finite accel_x and is_finite accel_y and is_finite accel_z):
    return (false, particles)
  let pos = @array.fill (count * 3) 0.0
  for i in 0 .. count:
    let pt = particles[i]
    let o = i * 3
    if pt.inv_mass > 0.0:
      let vx = (pt.position.x - pt.previous.x) * damp
      let vy = (pt.position.y - pt.previous.y) * damp
      let vz = (pt.position.z - pt.previous.z) * damp
      let nx = pt.position.x + vx + accel_x
      let ny = pt.position.y + vy + accel_y
      let nz = pt.position.z + vz + accel_z
      if not (is_finite vx and is_finite vy and is_finite vz and is_finite nx and is_finite ny and is_finite nz):
        return (false, particles)
      pos[o] := nx
      pos[o + 1] := ny
      pos[o + 2] := nz
    else:
      pos[o] := pt.position.x
      pos[o + 1] := pt.position.y
      pos[o + 2] := pt.position.z
  let iters = min 4096 (max 1 iterations)
  for 0 .. iters:
    for link in links:
      let a = link.a
      let b = link.b
      let wa = max 0.0 particles[a].inv_mass
      let wb = max 0.0 particles[b].inv_mass
      if wa > 0.0 or wb > 0.0:
        let ao = a * 3
        let bo = b * 3
        let ax = pos[ao]
        let ay = pos[ao + 1]
        let az = pos[ao + 2]
        let bx = pos[bo]
        let by = pos[bo + 1]
        let bz = pos[bo + 2]
        let dx = bx - ax
        let dy = by - ay
        let dz = bz - az
        let dist = sqrt (dx * dx + dy * dy + dz * dz)
        let dir_x = 0.0
        let dir_y = 0.0
        let dir_z = 0.0
        if is_finite dist:
          if dist > 0.000001:
            let inv_d = 1.0 / dist
            dir_x := dx * inv_d
            dir_y := dy * inv_d
            dir_z := dz * inv_d
        else:
          let (sdist, sdir) = scaled_delta ($Vec3 { x: ax, y: ay, z: az }) ($Vec3 { x: bx, y: by, z: bz })
          if not (is_finite sdist and math.finite3 sdir):
            return (false, particles)
          dist := sdist
          dir_x := sdir.x
          dir_y := sdir.y
          dir_z := sdir.z
        if dist > 0.000001:
          let alpha = if link.compliance == 0.0 then 0.0 else link.compliance / dt2
          let denom = (wa + wb) + alpha
          let stretch = dist - link.rest
          if not (is_finite stretch):
            return (false, particles)
          if is_finite denom and denom > 0.0:
            let corr = stretch / denom
            if not (is_finite corr and is_finite dir_x and is_finite dir_y and is_finite dir_z):
              return (false, particles)
            if wa > 0.0:
              let move_a = corr * wa
              let nx = ax + dir_x * move_a
              let ny = ay + dir_y * move_a
              let nz = az + dir_z * move_a
              if not (is_finite nx and is_finite ny and is_finite nz):
                return (false, particles)
              pos[ao] := nx
              pos[ao + 1] := ny
              pos[ao + 2] := nz
            if wb > 0.0:
              let move_b = corr * wb
              let nx = bx - dir_x * move_b
              let ny = by - dir_y * move_b
              let nz = bz - dir_z * move_b
              if not (is_finite nx and is_finite ny and is_finite nz):
                return (false, particles)
              pos[bo] := nx
              pos[bo + 1] := ny
              pos[bo + 2] := nz
          else:
            if is_finite alpha:
              let w_scale = max (max wa wb) alpha
              if not (is_finite w_scale) or w_scale <= 0.0:
                return (false, particles)
              let swa = wa / w_scale
              let swb = wb / w_scale
              let sdenom = swa + swb + alpha / w_scale
              if not (is_finite sdenom) or sdenom <= 0.0 or not (is_finite dir_x and is_finite dir_y and is_finite dir_z):
                return (false, particles)
              if wa > 0.0:
                let move_a = stretch * (swa / sdenom)
                let nx = ax + dir_x * move_a
                let ny = ay + dir_y * move_a
                let nz = az + dir_z * move_a
                if not (is_finite move_a and is_finite nx and is_finite ny and is_finite nz):
                  return (false, particles)
                pos[ao] := nx
                pos[ao + 1] := ny
                pos[ao + 2] := nz
              if wb > 0.0:
                let move_b = stretch * (swb / sdenom)
                let nx = bx - dir_x * move_b
                let ny = by - dir_y * move_b
                let nz = bz - dir_z * move_b
                if not (is_finite move_b and is_finite nx and is_finite ny and is_finite nz):
                  return (false, particles)
                pos[bo] := nx
                pos[bo + 1] := ny
                pos[bo + 2] := nz
            else:
              if link.compliance == 0.0:
                return (false, particles)
    if has_colliders:
      for i in 0 .. count:
        let pt = particles[i]
        if pt.inv_mass > 0.0:
          let o = i * 3
          let p = $Vec3 { x: pos[o], y: pos[o + 1], z: pos[o + 2] }
          for c in pre_colliders:
            let $Some next_pos = resolve_collider_pre p pt.radius c else:
              return (false, particles)
            p := next_pos
          pos[o] := p.x
          pos[o + 1] := p.y
          pos[o + 2] := p.z
  for i in 0 .. count:
    let pt = particles[i]
    let o = i * 3
    let prev = if pt.inv_mass > 0.0 then pt.position else pt.previous
    particles[i] := $Particle { position: $Vec3 { x: pos[o], y: pos[o + 1], z: pos[o + 2] }, previous: prev, inv_mass: pt.inv_mass, radius: pt.radius }
  return (true, particles)

// Exact submerged volume fraction of a sphere of radius `r` whose center sits
// at height `y` relative to a water plane at `water_height`.
func sphere_submerged_fraction (y: F32) -> (radius: F32) -> (water_height: F32) : F32 =>
  if not (is_finite y and is_finite radius and is_finite water_height) or radius <= 0.0:
    return 0.0
  let bottom = y - radius
  if water_height <= bottom:
    return 0.0
  if water_height >= y + radius:
    return 1.0
  let raw = (water_height - bottom) / radius
  if not (is_finite raw):
    return if raw > 0.0 then 1.0 else 0.0
  let u = clamp 0.0 2.0 raw
  return clamp 0.0 1.0 (u * u * (3.0 - u) * 0.25)

// Vectorized submerged sphere volume fraction batch via `spark` (4-wide Wasm SIMD).
func submerged_fractions_batch (ys: &[F32]) -> (radii: &[F32]) -> (water_height: F32) : #[F32] =>
  let n = min ys.length radii.length
  if not (is_finite water_height):
    return @array.fill n 0.0
  return spark #[sphere_submerged_fraction ys[i] radii[i] water_height | i <- 0 .. n]

// Archimedes buoyancy + hydrodynamic linear & quadratic drag over body-local
// spherical pontoons against a horizontal water surface at `water_height`.
func buoyancy (body_pos: Vec3) -> (body_rot: math.Quat) -> (lin_vel: Vec3) -> (ang_vel: Vec3) -> (pontoons: #[Pontoon]) -> (water_height: F32) -> (fluid_density: F32) -> (gravity: F32) -> (linear_drag: F32) -> (quad_drag: F32) : Maybe BuoyancyResult =>
  if pontoons.length == 0:
    return $Nothing
  if not (math.finite3 body_pos and math.finite_quat body_rot and math.finite3 lin_vel and math.finite3 ang_vel):
    return $Nothing
  if not (is_finite water_height and is_finite fluid_density and is_finite gravity and is_finite linear_drag and is_finite quad_drag) or fluid_density < 0.0 or gravity < 0.0 or linear_drag < 0.0 or quad_drag < 0.0:
    return $Nothing
  let q = math.Quat.normalized body_rot
  let total_force = math.zero3
  let total_torque = math.zero3
  let total_vol = 0.0
  let sub_vol = 0.0
  for p in pontoons:
    if not (math.finite3 p.offset and is_finite p.radius and p.radius > 0.0 and is_finite p.volume and p.volume > 0.0):
      return $Nothing
    let arm = math.Quat.rotate q p.offset
    let world_p = body_pos + arm
    let frac = sphere_submerged_fraction world_p.y p.radius water_height
    total_vol := self + p.volume
    let v_sub = p.volume * frac
    sub_vol := self + v_sub
    if frac > 0.0:
      let buoy_f = math.up * (fluid_density * gravity * v_sub)
      let v_pt = lin_vel + vector.Vec3.cross ang_vel arm
      let speed = vector.Vec3.length v_pt
      let drag_f = v_pt * (F32.neg (frac * (linear_drag + quad_drag * speed)))
      let f = buoy_f + drag_f
      total_force := self + f
      total_torque := self + vector.Vec3.cross arm f
  let avg_frac = if total_vol > 0.0 then sub_vol / total_vol else 0.0
  if not (math.finite3 total_force and math.finite3 total_torque and is_finite avg_frac):
    return $Nothing
  return $Some ($BuoyancyResult { force: total_force, torque: total_torque, submerged_fraction: avg_frac })
