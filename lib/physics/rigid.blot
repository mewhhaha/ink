import * as simd from "std/simd"
import { Vec3 } from "std/vector"
import { Quat } from "../math"
import * as math from "../math"
import * as shapes from "./shapes"
import * as arrays from "../arrays"
import * as joints from "./joints"

// A sequential-impulse rigid body solver in the "soft step" style: contacts
// are found once per step, then the step is divided into substeps, each
// integrating velocities, applying (warm started) impulses against soft
// constraints, moving the bodies and relaxing the velocities. Many small
// substeps with a single iteration stack more stably than one step with many
// iterations.
//
// All state is flat F32 arrays indexed by body slot, so a step allocates
// nothing per body. Slot -1 in a contact means an immovable world body.

// A contact row holds what is fixed for the step (one row per contact point):
// 0 a, 1 b, 2-4 normal, 5-7 local anchor on a, 8-10 local anchor on b,
// 11 separation, 12 friction, 13 restitution, 14 normal mass,
// 15-16 tangent masses, 17-19 tangent 1, 20-22 tangent 2, 23 approach speed,
// 24-26 contact point, 28-29 entity ids of a and b. The impulses, which the
// solver updates, live apart (four per contact: normal, two tangential and
// the largest normal impulse), because the compiler updates an array in place
// only when it is never handed to another function.
const stride: U32 = 32
const impulse_stride: U32 = 4

type Bodies is data = $Bodies {
  pos: #[F32],
  rot: #[F32],
  vel: #[F32],
  inv_mass: #[F32],
  inv_inertia: #[F32],
  gravity_scale: #[F32],
  linear_damping: #[F32],
  angular_damping: #[F32],
}

const slop = 0.005
// Contact stiffness. Tall stacks buckle if contacts are softer than this.
const contact_hertz = 240.0
// Extra damping on bodies that rest on something and move slowly: rolling
// resistance, and what lets a tall stack settle instead of swaying.
const resting_spin_damping = 1.5
const resting_linear_damping = 1.0
const max_push = 3.0
const restitution_threshold = 1.0

func vec (a: #[F32]) => func (i: U32) => $Vec3 { x: a[i], y: a[i + 1], z: a[i + 2] }
func quat (a: #[F32]) => func (i: U32) => $Quat { x: a[i], y: a[i + 1], z: a[i + 2], w: a[i + 3] }

// R diag(d) R^T as six numbers: xx, yy, zz, xy, xz, yz.
func world_inertia (q: Quat) => func (d: Vec3) =>
  let ex = math.Quat.rotate q ($Vec3 { x: 1.0, y: 0.0, z: 0.0 })
  let ey = math.Quat.rotate q ($Vec3 { x: 0.0, y: 1.0, z: 0.0 })
  let ez = math.Quat.rotate q ($Vec3 { x: 0.0, y: 0.0, z: 1.0 })
  return #[
    ex.x * ex.x * d.x + ey.x * ey.x * d.y + ez.x * ez.x * d.z,
    ex.y * ex.y * d.x + ey.y * ey.y * d.y + ez.y * ez.y * d.z,
    ex.z * ex.z * d.x + ey.z * ey.z * d.y + ez.z * ez.z * d.z,
    ex.x * ex.y * d.x + ey.x * ey.y * d.y + ez.x * ez.y * d.z,
    ex.x * ex.z * d.x + ey.x * ey.z * d.y + ez.x * ez.z * d.z,
    ex.y * ex.z * d.x + ey.y * ey.z * d.y + ez.y * ez.z * d.z,
  ]

func copy_lanes_into (destination: own #[F32]) -> (source: #[F32]) : #[F32] =>
  let n = source.length
  if destination.length != n:
    return panic "numeric destination length differs from source"
  let i: U32 = 0
  let limit = n & 4294967292
  for _ in 0 .. (n >> 2):
    destination := simd.store i (simd.load i source) self
    i := self + 4
  for j in limit .. n:
    destination[j] := source[j]
  return destination

// The world inverse inertia of every body (six numbers each: xx, yy, zz, xy,
// xz, yz of R diag(d) R^T), from each body's rotation and local diagonal.
func inertia_table_into (rot: #[F32]) => func (local: #[F32]) -> (out: own #[F32]) : #[F32] =>
  if local.length % 3 != 0:
    return panic "inertia_table local inertia has wrong length"
  let n = local.length / 3
  if rot.length != n * 4:
    return panic "inertia_table rotations have wrong length"
  if out.length != n * 6:
    return panic "inertia_table destination has wrong length"
  for i in 0..n:
    let base3 = i * 3
    let base6 = i * 6
    let dx = local[base3]
    let dy = local[base3 + 1]
    let dz = local[base3 + 2]
    if dx > 0.0 or dy > 0.0 or dz > 0.0:
      let base4 = i * 4
      let x = rot[base4]
      let y = rot[base4 + 1]
      let z = rot[base4 + 2]
      let w = rot[base4 + 3]
      let xx = x * x
      let yy = y * y
      let zz = z * z
      let xy = x * y
      let xz = x * z
      let yz = y * z
      let wx = w * x
      let wy = w * y
      let wz = w * z
      let exx = 1.0 - 2.0 * (yy + zz)
      let exy = 2.0 * (xy + wz)
      let exz = 2.0 * (xz - wy)
      let eyx = 2.0 * (xy - wz)
      let eyy = 1.0 - 2.0 * (xx + zz)
      let eyz = 2.0 * (yz + wx)
      let ezx = 2.0 * (xz + wy)
      let ezy = 2.0 * (yz - wx)
      let ezz = 1.0 - 2.0 * (xx + yy)
      let exx_dx = exx * dx
      let exy_dx = exy * dx
      let eyx_dy = eyx * dy
      let eyy_dy = eyy * dy
      let ezx_dz = ezx * dz
      let ezy_dz = ezy * dz
      out[base6] := exx_dx * exx + eyx_dy * eyx + ezx_dz * ezx
      out[base6 + 1] := exy_dx * exy + eyy_dy * eyy + ezy_dz * ezy
      out[base6 + 2] := exz * exz * dx + eyz * eyz * dy + ezz * ezz * dz
      out[base6 + 3] := exx_dx * exy + eyx_dy * eyy + ezx_dz * ezy
      out[base6 + 4] := exx_dx * exz + eyx_dy * eyz + ezx_dz * ezz
      out[base6 + 5] := exy_dx * exz + eyy_dy * eyz + ezy_dz * ezz
    else:
      out[base6] := 0.0
      out[base6 + 1] := 0.0
      out[base6 + 2] := 0.0
      out[base6 + 3] := 0.0
      out[base6 + 4] := 0.0
      out[base6 + 5] := 0.0
  return out

func inertia_table (rot: #[F32]) -> (local: #[F32]) : #[F32] => return
  inertia_table_into rot local (@array.fill (local.length / 3 * 6) 0.0)

// ((I (r x d)) x r) . d for the symmetric inverse inertia (i0 .. i5) =
// (xx, yy, zz, xy, xz, yz): how an impulse along d at r turns the body.
func turned_mass (i0: F32) => func (i1: F32) => func (i2: F32) => func (i3: F32) => func (i4: F32) => func (i5: F32) => func (rx: F32) => func (ry: F32) => func (rz: F32) => func (dx: F32) => func (dy: F32) => func (dz: F32) =>
  let nx = ry * dz - rz * dy
  let ny = rz * dx - rx * dz
  let nz = rx * dy - ry * dx
  let ux = i0 * nx + i3 * ny + i4 * nz
  let uy = i3 * nx + i1 * ny + i5 * nz
  let uz = i4 * nx + i5 * ny + i2 * nz
  return (uy * rz - uz * ry) * dx + (uz * rx - ux * rz) * dy + (ux * ry - uy * rx) * dz

// Fill in a row's masses, local anchors and approach speed. `p` is the
// world contact point; velocities are those at the start of the step. The
// vector helpers, `math.rotate_parts` among them, are spelled out: their tuple
// results would be allocated.
func prepare_row_into (bodies: Bodies) => func (iw: #[F32]) => func (a: F32) => func (b: F32) => func (nx: F32) => func (ny: F32) => func (nz: F32) => func (px: F32) => func (py: F32) => func (pz: F32) => func (sep: F32) => func (friction: F32) => func (restitution: F32) -> (ro: U32) -> (out: own #[F32]) : #[F32] =>
  let has_a = a >= 0.0
  let has_b = b >= 0.0
  let ia = if has_a then F32.to_u32 a else 0
  let ib = if has_b then F32.to_u32 b else 0
  let rax = if has_a then px - bodies.pos[ia * 3] else 0.0
  let ray = if has_a then py - bodies.pos[ia * 3 + 1] else 0.0
  let raz = if has_a then pz - bodies.pos[ia * 3 + 2] else 0.0
  let rbx = if has_b then px - bodies.pos[ib * 3] else 0.0
  let rby = if has_b then py - bodies.pos[ib * 3 + 1] else 0.0
  let rbz = if has_b then pz - bodies.pos[ib * 3 + 2] else 0.0
  let hx = 0.0
  let hy = 0.0
  let hz = 1.0
  if abs nx < 0.57:
    hx := 1.0
    hz := 0.0
  else:
    if abs ny < 0.57:
      hy := 1.0
      hz := 0.0
  let cx = ny * hz - nz * hy
  let cy = nz * hx - nx * hz
  let cz = nx * hy - ny * hx
  let length = sqrt (cx * cx + cy * cy + cz * cz)
  let t1x = if length == 0.0 then cx else cx / length
  let t1y = if length == 0.0 then cy else cy / length
  let t1z = if length == 0.0 then cz else cz / length
  let t2x = ny * t1z - nz * t1y
  let t2y = nz * t1x - nx * t1z
  let t2z = nx * t1y - ny * t1x
  let ma = if has_a then bodies.inv_mass[ia] else 0.0
  let mb = if has_b then bodies.inv_mass[ib] else 0.0
  let nm = 0.0
  let m1 = 0.0
  let m2 = 0.0
  let lax = 0.0
  let lay = 0.0
  let laz = 0.0
  let vax = 0.0
  let vay = 0.0
  let vaz = 0.0
  if has_a:
    let ka = ia * 6
    let a0 = iw[ka]
    let a1 = iw[ka + 1]
    let a2 = iw[ka + 2]
    let a3 = iw[ka + 3]
    let a4 = iw[ka + 4]
    let a5 = iw[ka + 5]
    nm := self + ma + turned_mass a0 a1 a2 a3 a4 a5 rax ray raz nx ny nz
    m1 := self + ma + turned_mass a0 a1 a2 a3 a4 a5 rax ray raz t1x t1y t1z
    m2 := self + ma + turned_mass a0 a1 a2 a3 a4 a5 rax ray raz t2x t2y t2z
    let q = ia * 4
    let ux = F32.neg bodies.rot[q]
    let uy = F32.neg bodies.rot[q + 1]
    let uz = F32.neg bodies.rot[q + 2]
    let w = bodies.rot[q + 3]
    let tx = (uy * raz - uz * ray) * 2.0
    let ty = (uz * rax - ux * raz) * 2.0
    let tz = (ux * ray - uy * rax) * 2.0
    lax := rax + tx * w + (uy * tz - uz * ty)
    lay := ray + ty * w + (uz * tx - ux * tz)
    laz := raz + tz * w + (ux * ty - uy * tx)
    let v = ia * 6
    let wx = bodies.vel[v + 3]
    let wy = bodies.vel[v + 4]
    let wz = bodies.vel[v + 5]
    vax := bodies.vel[v] + (wy * raz - wz * ray)
    vay := bodies.vel[v + 1] + (wz * rax - wx * raz)
    vaz := bodies.vel[v + 2] + (wx * ray - wy * rax)
  let lbx = 0.0
  let lby = 0.0
  let lbz = 0.0
  let vbx = 0.0
  let vby = 0.0
  let vbz = 0.0
  if has_b:
    let kb = ib * 6
    let b0 = iw[kb]
    let b1 = iw[kb + 1]
    let b2 = iw[kb + 2]
    let b3 = iw[kb + 3]
    let b4 = iw[kb + 4]
    let b5 = iw[kb + 5]
    nm := self + mb + turned_mass b0 b1 b2 b3 b4 b5 rbx rby rbz nx ny nz
    m1 := self + mb + turned_mass b0 b1 b2 b3 b4 b5 rbx rby rbz t1x t1y t1z
    m2 := self + mb + turned_mass b0 b1 b2 b3 b4 b5 rbx rby rbz t2x t2y t2z
    let q = ib * 4
    let ux = F32.neg bodies.rot[q]
    let uy = F32.neg bodies.rot[q + 1]
    let uz = F32.neg bodies.rot[q + 2]
    let w = bodies.rot[q + 3]
    let tx = (uy * rbz - uz * rby) * 2.0
    let ty = (uz * rbx - ux * rbz) * 2.0
    let tz = (ux * rby - uy * rbx) * 2.0
    lbx := rbx + tx * w + (uy * tz - uz * ty)
    lby := rby + ty * w + (uz * tx - ux * tz)
    lbz := rbz + tz * w + (ux * ty - uy * tx)
    let v = ib * 6
    let wx = bodies.vel[v + 3]
    let wy = bodies.vel[v + 4]
    let wz = bodies.vel[v + 5]
    vbx := bodies.vel[v] + (wy * rbz - wz * rby)
    vby := bodies.vel[v + 1] + (wz * rbx - wx * rbz)
    vbz := bodies.vel[v + 2] + (wx * rby - wy * rbx)
  let approach = (vbx - vax) * nx + (vby - vay) * ny + (vbz - vaz) * nz
  out[ro] := a
  out[ro + 1] := b
  out[ro + 2] := nx
  out[ro + 3] := ny
  out[ro + 4] := nz
  out[ro + 5] := lax
  out[ro + 6] := lay
  out[ro + 7] := laz
  out[ro + 8] := lbx
  out[ro + 9] := lby
  out[ro + 10] := lbz
  out[ro + 11] := sep
  out[ro + 12] := friction
  out[ro + 13] := restitution
  out[ro + 14] := if nm > 0.0 then 1.0 / nm else 0.0
  out[ro + 15] := if m1 > 0.0 then 1.0 / m1 else 0.0
  out[ro + 16] := if m2 > 0.0 then 1.0 / m2 else 0.0
  out[ro + 17] := t1x
  out[ro + 18] := t1y
  out[ro + 19] := t1z
  out[ro + 20] := t2x
  out[ro + 21] := t2y
  out[ro + 22] := t2z
  out[ro + 23] := approach
  out[ro + 24] := px
  out[ro + 25] := py
  out[ro + 26] := pz
  out[ro + 27] := 0.0
  out[ro + 28] := 0.0
  out[ro + 29] := 0.0
  out[ro + 30] := 0.0
  out[ro + 31] := 0.0
  return out

func prepare_row_xyz (bodies: Bodies) => func (iw: #[F32]) => func (a: F32) => func (b: F32) => func (nx: F32) => func (ny: F32) => func (nz: F32) => func (px: F32) => func (py: F32) => func (pz: F32) => func (sep: F32) => func (friction: F32) => func (restitution: F32) => return
  prepare_row_into bodies iw a b nx ny nz px py pz sep friction restitution 0 (@array.fill stride 0.0)

func prepare_row (bodies: Bodies) => func (iw: #[F32]) => func (a: F32) => func (b: F32) => func (n: Vec3) => func (pt: Vec3) => func (sep: F32) => func (friction: F32) => func (restitution: F32) => return
  prepare_row_xyz bodies iw a b n.x n.y n.z pt.x pt.y pt.z sep friction restitution

// (x, y, z, w) normalized, rounded as `math.Quat.normalized`.
func normalized_quat (x: F32) => func (y: F32) => func (z: F32) => func (w: F32) =>
  let squared = x * x + y * y + z * z + w * w
  if squared >= 1.17549435e-38 and is_finite squared:
    let ordinary = sqrt squared
    return (x / ordinary, y / ordinary, z / ordinary, w / ordinary)
  let scale = max (max (abs x) (abs y)) (max (abs z) (abs w))
  if not (is_finite scale) or scale == 0.0:
    return (0.0, 0.0, 0.0, 1.0)
  let sx = x / scale
  let sy = y / scale
  let sz = z / scale
  let sw = w / scale
  let length = sqrt (sx * sx + sy * sy + sz * sz + sw * sw)
  if not (is_finite length) or length == 0.0:
    return (0.0, 0.0, 0.0, 1.0)
  return (sx / length, sy / length, sz / length, sw / length)

type Soft is data = $Soft { bias_rate: F32, mass_scale: F32, impulse_scale: F32, inv_h: F32 }

// The state a pass reads.
type World is data = $World {
  pos: #[F32],
  rot: #[F32],
  iw: #[F32],
  inv_mass: #[F32],
  soft: Soft,
}

// Per contact the solver keeps, for the normal and both tangents d, how the
// bodies' velocities enter the contact's speed along d and how an impulse
// along d changes them. Twelve numbers per direction:
//   rA x d, rB x d, I_A^-1 (rA x d), I_B^-1 (rB x d)
// then (36..41) the anchors rA and rB turned into the world. Zero where the
// body is immovable, so the passes need no branches. Recomputed whenever
// the bodies have turned.
const jac_stride: U32 = 42

// I^-1 (x, y, z) for the symmetric matrix of body i.
func spin_of (iw: #[F32]) => func (i: U32) => func (x: F32) => func (y: F32) => func (z: F32) =>
  let o = i * 6
  return (iw[o] * x + iw[o + 3] * y + iw[o + 4] * z, iw[o + 3] * x + iw[o + 1] * y + iw[o + 5] * z, iw[o + 4] * x + iw[o + 5] * y + iw[o + 2] * z)

// `math.rotate_parts` and `spin_of` are spelled out here: in this loop their
// tuple results would be allocated on every call.
func jacobians_into (w: World) => func (rows: #[F32]) -> (jac: own #[F32]) : #[F32] =>
  let count = rows.length / stride
  if jac.length != count * jac_stride:
    return panic "jacobians destination has wrong length"
  let rot = w.rot
  let iw = w.iw
  for c in 0..count:
    let o = c * stride
    let j = c * jac_stride
    let a = rows[o]
    let b = rows[o + 1]
    let has_a = a >= 0.0
    let has_b = b >= 0.0
    let ia = if has_a then F32.to_u32 a else 0
    let ib = if has_b then F32.to_u32 b else 0
    // The local anchors turned into the world, as `math.rotate_parts`.
    let rax = 0.0
    let ray = 0.0
    let raz = 0.0
    if has_a:
      let q = ia * 4
      let qx = rot[q]
      let qy = rot[q + 1]
      let qz = rot[q + 2]
      let qw = rot[q + 3]
      let x = rows[o + 5]
      let y = rows[o + 6]
      let z = rows[o + 7]
      let tx = 2.0 * (qy * z - qz * y)
      let ty = 2.0 * (qz * x - qx * z)
      let tz = 2.0 * (qx * y - qy * x)
      rax := x + qw * tx + (qy * tz - qz * ty)
      ray := y + qw * ty + (qz * tx - qx * tz)
      raz := z + qw * tz + (qx * ty - qy * tx)
    let rbx = 0.0
    let rby = 0.0
    let rbz = 0.0
    if has_b:
      let q = ib * 4
      let qx = rot[q]
      let qy = rot[q + 1]
      let qz = rot[q + 2]
      let qw = rot[q + 3]
      let x = rows[o + 8]
      let y = rows[o + 9]
      let z = rows[o + 10]
      let tx = 2.0 * (qy * z - qz * y)
      let ty = 2.0 * (qz * x - qx * z)
      let tz = 2.0 * (qx * y - qy * x)
      rbx := x + qw * tx + (qy * tz - qz * ty)
      rby := y + qw * ty + (qz * tx - qx * tz)
      rbz := z + qw * tz + (qx * ty - qy * tx)
    jac[j + 36] := rax
    jac[j + 37] := ray
    jac[j + 38] := raz
    jac[j + 39] := rbx
    jac[j + 40] := rby
    jac[j + 41] := rbz
    // Each body's inverse inertia, as `spin_of`.
    let ka = ia * 6
    let a0 = if has_a then iw[ka] else 0.0
    let a1 = if has_a then iw[ka + 1] else 0.0
    let a2 = if has_a then iw[ka + 2] else 0.0
    let a3 = if has_a then iw[ka + 3] else 0.0
    let a4 = if has_a then iw[ka + 4] else 0.0
    let a5 = if has_a then iw[ka + 5] else 0.0
    let kb = ib * 6
    let b0 = if has_b then iw[kb] else 0.0
    let b1 = if has_b then iw[kb + 1] else 0.0
    let b2 = if has_b then iw[kb + 2] else 0.0
    let b3 = if has_b then iw[kb + 3] else 0.0
    let b4 = if has_b then iw[kb + 4] else 0.0
    let b5 = if has_b then iw[kb + 5] else 0.0
    for block in 0..3:
      let d = if block == 0 then 2 else if block == 1 then 17 else 20
      let dx = rows[o + d]
      let dy = rows[o + d + 1]
      let dz = rows[o + d + 2]
      let k = j + block * 12
      if has_a:
        let cax = ray * dz - raz * dy
        let cay = raz * dx - rax * dz
        let caz = rax * dy - ray * dx
        jac[k] := cax
        jac[k + 1] := cay
        jac[k + 2] := caz
        jac[k + 6] := a0 * cax + a3 * cay + a4 * caz
        jac[k + 7] := a3 * cax + a1 * cay + a5 * caz
        jac[k + 8] := a4 * cax + a5 * cay + a2 * caz
      else:
        jac[k] := 0.0
        jac[k + 1] := 0.0
        jac[k + 2] := 0.0
        jac[k + 6] := 0.0
        jac[k + 7] := 0.0
        jac[k + 8] := 0.0
      if has_b:
        let cbx = rby * dz - rbz * dy
        let cby = rbz * dx - rbx * dz
        let cbz = rbx * dy - rby * dx
        jac[k + 3] := cbx
        jac[k + 4] := cby
        jac[k + 5] := cbz
        jac[k + 9] := b0 * cbx + b3 * cby + b4 * cbz
        jac[k + 10] := b3 * cbx + b1 * cby + b5 * cbz
        jac[k + 11] := b4 * cbx + b5 * cby + b2 * cbz
      else:
        jac[k + 3] := 0.0
        jac[k + 4] := 0.0
        jac[k + 5] := 0.0
        jac[k + 9] := 0.0
        jac[k + 10] := 0.0
        jac[k + 11] := 0.0
  return jac

func jacobians (w: World) -> (rows: #[F32]) : #[F32] => return
  jacobians_into w rows (@array.fill (rows.length / stride * jac_stride) 0.0)

// One sweep over all contacts, on the velocities and impulses it is given.
// `use_bias` is false while relaxing.
func solve_pass_in_place (w: World) => func (rows: #[F32]) => func (jac: #[F32]) => func (use_bias: Bool) -> (vel: own #[F32]) -> (imp: own #[F32]) : (#[F32], #[F32]) =>
  let count = rows.length / stride
  let w_pos = w.pos
  let w_inv_mass = w.inv_mass
  let soft_inv_h = w.soft.inv_h
  let soft_bias_rate = w.soft.bias_rate
  let soft_mass_scale = w.soft.mass_scale
  let soft_impulse_scale = w.soft.impulse_scale
  for c in 0..count:
    let o = c * stride
    let j = c * jac_stride
    let q = c * impulse_stride
    let a = rows[o]
    let b = rows[o + 1]
    let has_a = a >= 0.0
    let has_b = b >= 0.0
    let ia = if has_a then F32.to_u32 a else 0
    let ib = if has_b then F32.to_u32 b else 0
    let va = ia * 6
    let vb = ib * 6
    let ma = if has_a then w_inv_mass[ia] else 0.0
    let mb = if has_b then w_inv_mass[ib] else 0.0
    let vax = if has_a then vel[va] else 0.0
    let vay = if has_a then vel[va + 1] else 0.0
    let vaz = if has_a then vel[va + 2] else 0.0
    let wax = if has_a then vel[va + 3] else 0.0
    let way = if has_a then vel[va + 4] else 0.0
    let waz = if has_a then vel[va + 5] else 0.0
    let vbx = if has_b then vel[vb] else 0.0
    let vby = if has_b then vel[vb + 1] else 0.0
    let vbz = if has_b then vel[vb + 2] else 0.0
    let wbx = if has_b then vel[vb + 3] else 0.0
    let wby = if has_b then vel[vb + 4] else 0.0
    let wbz = if has_b then vel[vb + 5] else 0.0
    let nx = rows[o + 2]
    let ny = rows[o + 3]
    let nz = rows[o + 4]
    let t1x = rows[o + 17]
    let t1y = rows[o + 18]
    let t1z = rows[o + 19]
    let t2x = rows[o + 20]
    let t2y = rows[o + 21]
    let t2z = rows[o + 22]
    // Friction first: the normal constraint matters more.
    let dvx = vbx - vax
    let dvy = vby - vay
    let dvz = vbz - vaz
    let vt1 = t1x * dvx + t1y * dvy + t1z * dvz + jac[j + 15] * wbx + jac[j + 16] * wby + jac[j + 17] * wbz - jac[j + 12] * wax - jac[j + 13] * way - jac[j + 14] * waz
    let vt2 = t2x * dvx + t2y * dvy + t2z * dvz + jac[j + 27] * wbx + jac[j + 28] * wby + jac[j + 29] * wbz - jac[j + 24] * wax - jac[j + 25] * way - jac[j + 26] * waz
    let imp_n = imp[q]
    let imp_1 = imp[q + 1]
    let imp_2 = imp[q + 2]
    let max_friction = rows[o + 12] * imp_n
    let j1 = imp_1 - vt1 * rows[o + 15]
    let j2 = imp_2 - vt2 * rows[o + 16]
    if not (is_finite j1 and is_finite j2):
      j1 := imp_1
      j2 := imp_2
    let len2 = j1 * j1 + j2 * j2
    if not (max_friction >= 0.0 and len2 <= max_friction * max_friction):
      let length = sqrt len2
      if length > max_friction:
        if is_finite length and length > 0.0 and is_finite max_friction and max_friction >= 0.0:
          let scale = max_friction / length
          j1 := self * scale
          j2 := self * scale
        else:
          j1 := 0.0
          j2 := 0.0
    let d1 = j1 - imp_1
    let d2 = j2 - imp_2
    imp[q + 1] := j1
    imp[q + 2] := j2
    let px = t1x * d1 + t2x * d2
    let py = t1y * d1 + t2y * d2
    let pz = t1z * d1 + t2z * d2
    let vax = vax - px * ma
    let vay = vay - py * ma
    let vaz = vaz - pz * ma
    let wax = wax - (jac[j + 18] * d1 + jac[j + 30] * d2)
    let way = way - (jac[j + 19] * d1 + jac[j + 31] * d2)
    let waz = waz - (jac[j + 20] * d1 + jac[j + 32] * d2)
    let vbx = vbx + px * mb
    let vby = vby + py * mb
    let vbz = vbz + pz * mb
    let wbx = wbx + (jac[j + 21] * d1 + jac[j + 33] * d2)
    let wby = wby + (jac[j + 22] * d1 + jac[j + 34] * d2)
    let wbz = wbz + (jac[j + 23] * d1 + jac[j + 35] * d2)
    // Normal.
    let vn = nx * (vbx - vax) + ny * (vby - vay) + nz * (vbz - vaz) + jac[j + 3] * wbx + jac[j + 4] * wby + jac[j + 5] * wbz - jac[j] * wax - jac[j + 1] * way - jac[j + 2] * waz
    let pa = ia * 3
    let pb = ib * 3
    let ax = if has_a then w_pos[pa] + jac[j + 36] else rows[o + 24]
    let ay = if has_a then w_pos[pa + 1] + jac[j + 37] else rows[o + 25]
    let az = if has_a then w_pos[pa + 2] + jac[j + 38] else rows[o + 26]
    let bx = if has_b then w_pos[pb] + jac[j + 39] else rows[o + 24]
    let by = if has_b then w_pos[pb + 1] + jac[j + 40] else rows[o + 25]
    let bz = if has_b then w_pos[pb + 2] + jac[j + 41] else rows[o + 26]
    let s = (bx - ax) * nx + (by - ay) * ny + (bz - az) * nz + rows[o + 11]
    let bias = 0.0
    let mass_scale = 1.0
    let impulse_scale = 0.0
    if s > 0.0:
      bias := s * soft_inv_h
    else:
      if use_bias:
        bias := max (soft_bias_rate * min 0.0 (s + slop)) (F32.neg max_push)
        mass_scale := soft_mass_scale
        impulse_scale := soft_impulse_scale
    let impulse = F32.neg rows[o + 14] * mass_scale * (vn + bias) - impulse_scale * imp_n
    let cand_jn = imp_n + impulse
    let new_jn = if is_finite cand_jn then max 0.0 cand_jn else imp_n
    let dj = new_jn - imp_n
    imp[q] := new_jn
    imp[q + 3] := max imp[q + 3] new_jn
    if has_a:
      vel[va] := vax - nx * dj * ma
      vel[va + 1] := vay - ny * dj * ma
      vel[va + 2] := vaz - nz * dj * ma
      vel[va + 3] := wax - jac[j + 6] * dj
      vel[va + 4] := way - jac[j + 7] * dj
      vel[va + 5] := waz - jac[j + 8] * dj
    if has_b:
      vel[vb] := vbx + nx * dj * mb
      vel[vb + 1] := vby + ny * dj * mb
      vel[vb + 2] := vbz + nz * dj * mb
      vel[vb + 3] := wbx + jac[j + 9] * dj
      vel[vb + 4] := wby + jac[j + 10] * dj
      vel[vb + 5] := wbz + jac[j + 11] * dj
  return (vel, imp)

func solve_pass_into (w: World) => func (rows: #[F32]) => func (jac: #[F32]) => func (use_bias: Bool) => func (vel_in: #[F32]) => func (imp_in: #[F32]) -> (vel: own #[F32]) -> (imp: own #[F32]) : (#[F32], #[F32]) =>
  if vel.length != vel_in.length or imp.length != imp_in.length:
    return panic "solver pass outputs have wrong lengths"
  return solve_pass_in_place w rows jac use_bias (copy_lanes_into vel vel_in) (copy_lanes_into imp imp_in)

// Apply the stored impulses (warm start).
func warm_start_in_place (w: World) => func (rows: #[F32]) => func (jac: #[F32]) => func (imp: #[F32]) -> (vel: own #[F32]) : #[F32] =>
  let count = rows.length / stride
  for c in 0..count:
    let o = c * stride
    let j = c * jac_stride
    let q = c * impulse_stride
    let a = rows[o]
    let b = rows[o + 1]
    let jn = imp[q]
    let j1 = imp[q + 1]
    let j2 = imp[q + 2]
    if jn != 0.0 or j1 != 0.0 or j2 != 0.0:
      let px = rows[o + 2] * jn + rows[o + 17] * j1 + rows[o + 20] * j2
      let py = rows[o + 3] * jn + rows[o + 18] * j1 + rows[o + 21] * j2
      let pz = rows[o + 4] * jn + rows[o + 19] * j1 + rows[o + 22] * j2
      if a >= 0.0:
        let ia = F32.to_u32 a
        let va = ia * 6
        let m = w.inv_mass[ia]
        vel[va] := vel[va] - px * m
        vel[va + 1] := vel[va + 1] - py * m
        vel[va + 2] := vel[va + 2] - pz * m
        vel[va + 3] := vel[va + 3] - (jac[j + 6] * jn + jac[j + 18] * j1 + jac[j + 30] * j2)
        vel[va + 4] := vel[va + 4] - (jac[j + 7] * jn + jac[j + 19] * j1 + jac[j + 31] * j2)
        vel[va + 5] := vel[va + 5] - (jac[j + 8] * jn + jac[j + 20] * j1 + jac[j + 32] * j2)
      if b >= 0.0:
        let ib = F32.to_u32 b
        let vb = ib * 6
        let m = w.inv_mass[ib]
        vel[vb] := vel[vb] + px * m
        vel[vb + 1] := vel[vb + 1] + py * m
        vel[vb + 2] := vel[vb + 2] + pz * m
        vel[vb + 3] := vel[vb + 3] + (jac[j + 9] * jn + jac[j + 21] * j1 + jac[j + 33] * j2)
        vel[vb + 4] := vel[vb + 4] + (jac[j + 10] * jn + jac[j + 22] * j1 + jac[j + 34] * j2)
        vel[vb + 5] := vel[vb + 5] + (jac[j + 11] * jn + jac[j + 23] * j1 + jac[j + 35] * j2)
  return vel

func warm_start_into (w: World) => func (rows: #[F32]) => func (jac: #[F32]) => func (vel_in: #[F32]) => func (imp: #[F32]) -> (vel: own #[F32]) : #[F32] => return
  warm_start_in_place w rows jac imp (copy_lanes_into vel vel_in)

// Bounce: after the solve, give contacts that approached fast enough their
// restitution back.
func restitution_pass_in_place (w: World) => func (rows: #[F32]) => func (jac: #[F32]) -> (vel: own #[F32]) -> (imp: own #[F32]) : (#[F32], #[F32]) =>
  let count = rows.length / stride
  for c in 0..count:
    let o = c * stride
    let j = c * jac_stride
    let q = c * impulse_stride
    let e = rows[o + 13]
    if e > 0.0 and rows[o + 23] < F32.neg restitution_threshold and imp[q + 3] > 0.0:
      let a = rows[o]
      let b = rows[o + 1]
      let has_a = a >= 0.0
      let has_b = b >= 0.0
      let ia = if has_a then F32.to_u32 a else 0
      let ib = if has_b then F32.to_u32 b else 0
      let ma = if has_a then w.inv_mass[ia] else 0.0
      let mb = if has_b then w.inv_mass[ib] else 0.0
      let vax = if has_a then vel[ia * 6] else 0.0
      let vay = if has_a then vel[ia * 6 + 1] else 0.0
      let vaz = if has_a then vel[ia * 6 + 2] else 0.0
      let wax = if has_a then vel[ia * 6 + 3] else 0.0
      let way = if has_a then vel[ia * 6 + 4] else 0.0
      let waz = if has_a then vel[ia * 6 + 5] else 0.0
      let vbx = if has_b then vel[ib * 6] else 0.0
      let vby = if has_b then vel[ib * 6 + 1] else 0.0
      let vbz = if has_b then vel[ib * 6 + 2] else 0.0
      let wbx = if has_b then vel[ib * 6 + 3] else 0.0
      let wby = if has_b then vel[ib * 6 + 4] else 0.0
      let wbz = if has_b then vel[ib * 6 + 5] else 0.0
      let nx = rows[o + 2]
      let ny = rows[o + 3]
      let nz = rows[o + 4]
      let vn = nx * (vbx - vax) + ny * (vby - vay) + nz * (vbz - vaz) + jac[j + 3] * wbx + jac[j + 4] * wby + jac[j + 5] * wbz - jac[j] * wax - jac[j + 1] * way - jac[j + 2] * waz
      let impulse = F32.neg rows[o + 14] * (vn + e * rows[o + 23])
      let cand_jn = imp[q] + impulse
      let new_jn = if is_finite cand_jn then max 0.0 cand_jn else imp[q]
      let dj = new_jn - imp[q]
      imp[q] := new_jn
      if has_a:
        vel[ia * 6] := vax - nx * dj * ma
        vel[ia * 6 + 1] := vay - ny * dj * ma
        vel[ia * 6 + 2] := vaz - nz * dj * ma
        vel[ia * 6 + 3] := wax - jac[j + 6] * dj
        vel[ia * 6 + 4] := way - jac[j + 7] * dj
        vel[ia * 6 + 5] := waz - jac[j + 8] * dj
      if has_b:
        vel[ib * 6] := vbx + nx * dj * mb
        vel[ib * 6 + 1] := vby + ny * dj * mb
        vel[ib * 6 + 2] := vbz + nz * dj * mb
        vel[ib * 6 + 3] := wbx + jac[j + 9] * dj
        vel[ib * 6 + 4] := wby + jac[j + 10] * dj
        vel[ib * 6 + 5] := wbz + jac[j + 11] * dj
  return (vel, imp)

func restitution_pass_into (w: World) => func (rows: #[F32]) => func (jac: #[F32]) => func (vel_in: #[F32]) => func (imp_in: #[F32]) -> (vel: own #[F32]) -> (imp: own #[F32]) : (#[F32], #[F32]) =>
  if vel.length != vel_in.length or imp.length != imp_in.length:
    return panic "solver pass outputs have wrong lengths"
  return restitution_pass_in_place w rows jac (copy_lanes_into vel vel_in) (copy_lanes_into imp imp_in)

// Apply gravity and damping to the velocities for h seconds.
func accelerate_in_place (h: F32) => func (gravity: Vec3) => func (b: Bodies) => func (touching: #[F32]) -> (vel: own #[F32]) : #[F32] =>
  for i in 0..b.inv_mass.length:
    if b.inv_mass[i] > 0.0:
      let gs = b.gravity_scale[i] * h
      let lin2 = vel[i * 6] * vel[i * 6] + vel[i * 6 + 1] * vel[i * 6 + 1] + vel[i * 6 + 2] * vel[i * 6 + 2]
      let slide = if touching[i] > 0.0 and lin2 < 0.25 then resting_linear_damping else 0.0
      let ld = if is_finite b.linear_damping[i] then max 0.0 b.linear_damping[i] else 0.0
      let damp_l = 1.0 / (1.0 + h * (ld + slide))
      let spin2 = vel[i * 6 + 3] * vel[i * 6 + 3] + vel[i * 6 + 4] * vel[i * 6 + 4] + vel[i * 6 + 5] * vel[i * 6 + 5]
      let calm = if touching[i] > 0.0 and spin2 < 4.0 then resting_spin_damping else 0.0
      let ad = if is_finite b.angular_damping[i] then max 0.0 b.angular_damping[i] else 0.0
      let damp_a = 1.0 / (1.0 + h * (ad + calm))
      vel[i * 6] := (vel[i * 6] + gravity.x * gs) * damp_l
      vel[i * 6 + 1] := (vel[i * 6 + 1] + gravity.y * gs) * damp_l
      vel[i * 6 + 2] := (vel[i * 6 + 2] + gravity.z * gs) * damp_l
      vel[i * 6 + 3] := vel[i * 6 + 3] * damp_a
      vel[i * 6 + 4] := vel[i * 6 + 4] * damp_a
      vel[i * 6 + 5] := vel[i * 6 + 5] * damp_a
  return vel

func accelerate_into (h: F32) => func (gravity: Vec3) => func (b: Bodies) => func (touching: #[F32]) => func (vel_in: #[F32]) -> (vel: own #[F32]) : #[F32] => return
  accelerate_in_place h gravity b touching (copy_lanes_into vel vel_in)

func accelerate (h: F32) -> (gravity: Vec3) -> (b: Bodies) -> (touching: #[F32]) -> (vel_in: #[F32]) : #[F32] => return
  accelerate_in_place h gravity b touching (arrays.copy vel_in)

// Move the bodies by their velocities for h seconds.
func advance_in_place (h: F32) => func (inv_mass: #[F32]) => func (vel: #[F32]) -> (pos: own #[F32]) -> (rot: own #[F32]) : (#[F32], #[F32]) =>
  let half_h = h * 0.5
  for i in 0..inv_mass.length:
    if inv_mass[i] > 0.0:
      let p = i * 3
      let v = i * 6
      pos[p] := pos[p] + vel[v] * h
      pos[p + 1] := pos[p + 1] + vel[v + 1] * h
      pos[p + 2] := pos[p + 2] + vel[v + 2] * h
      let wx = vel[v + 3]
      let wy = vel[v + 4]
      let wz = vel[v + 5]
      if wx != 0.0 or wy != 0.0 or wz != 0.0:
        let q = i * 4
        let qx = rot[q]
        let qy = rot[q + 1]
        let qz = rot[q + 2]
        let qw = rot[q + 3]
        let sx = wx * half_h
        let sy = wy * half_h
        let sz = wz * half_h
        let nx = qx + (sx * qw + sy * qz - sz * qy)
        let ny = qy + (sy * qw - sx * qz + sz * qx)
        let nz = qz + (sx * qy - sy * qx + sz * qw)
        let nw = qw - (sx * qx + sy * qy + sz * qz)
        let squared = nx * nx + ny * ny + nz * nz + nw * nw
        if squared >= 1.17549435e-38 and is_finite squared:
          let inv = 1.0 / sqrt squared
          rot[q] := nx * inv
          rot[q + 1] := ny * inv
          rot[q + 2] := nz * inv
          rot[q + 3] := nw * inv
        else:
          let scale = max (max (abs nx) (abs ny)) (max (abs nz) (abs nw))
          if is_finite scale and scale > 0.0:
            let rx = nx / scale
            let ry = ny / scale
            let rz = nz / scale
            let rw = nw / scale
            let length = sqrt (rx * rx + ry * ry + rz * rz + rw * rw)
            if is_finite length and length > 0.0:
              rot[q] := rx / length
              rot[q + 1] := ry / length
              rot[q + 2] := rz / length
              rot[q + 3] := rw / length
            else:
              rot[q] := 0.0
              rot[q + 1] := 0.0
              rot[q + 2] := 0.0
              rot[q + 3] := 1.0
          else:
            rot[q] := 0.0
            rot[q + 1] := 0.0
            rot[q + 2] := 0.0
            rot[q + 3] := 1.0
  return (pos, rot)

func advance_into (h: F32) => func (inv_mass: #[F32]) => func (vel: #[F32]) => func (pos_in: #[F32]) => func (rot_in: #[F32]) -> (pos: own #[F32]) -> (rot: own #[F32]) : (#[F32], #[F32]) =>
  if pos.length != pos_in.length or rot.length != rot_in.length:
    return panic "motion outputs have wrong lengths"
  return advance_in_place h inv_mass vel (copy_lanes_into pos pos_in) (copy_lanes_into rot rot_in)

// Advance into caller-named position, rotation, velocity and impulse owners,
// which come back in that order. Every substep reuses these owners and named
// inertia/Jacobian scratch.
func solve_joints_into (links: #[joints.Link]) -> (dt: F32) -> (substeps: U32) -> (gravity: Vec3) -> (b: Bodies) -> (rows: #[F32]) -> (imp_in: #[F32]) -> (pos: own #[F32]) -> (rot: own #[F32]) -> (vel: own #[F32]) -> (imp: own #[F32]) : (#[F32], #[F32], #[F32], #[F32]) =>
  if pos.length != b.pos.length or rot.length != b.rot.length or vel.length != b.vel.length or imp.length != imp_in.length:
    return panic "solver outputs have wrong lengths"
  pos := copy_lanes_into pos b.pos
  rot := copy_lanes_into rot b.rot
  vel := copy_lanes_into vel b.vel
  imp := copy_lanes_into imp imp_in
  if not (is_finite dt and dt > 0.0) or substeps == 0:
    return (pos, rot, vel, imp)
  let n = b.inv_mass.length
  let h = dt / U32.to_f32 substeps
  let inv_h = 1.0 / h
  if not (is_finite h and h > 0.0 and is_finite inv_h):
    return (pos, rot, vel, imp)
  let hertz = min contact_hertz (0.25 * inv_h)
  let omega = 2.0 * pi * hertz
  let zeta = 10.0
  let a1 = 2.0 * zeta + h * omega
  let a2 = h * omega * a1
  let a3 = 1.0 / (1.0 + a2)
  let soft = $Soft { bias_rate: omega / a1, mass_scale: a2 * a3, impulse_scale: a3, inv_h }
  let iw: #[F32] = inertia_table_into b.rot b.inv_inertia (@array.fill (n * 6) 0.0)
  let touching: #[F32] = @array.fill n 0.0
  for c in 0..(rows.length / stride):
    let o = c * stride
    if rows[o + 11] < 0.01:
      if rows[o] >= 0.0:
        touching[F32.to_u32 rows[o]] := 1.0
      if rows[o + 1] >= 0.0:
        touching[F32.to_u32 rows[o + 1]] := 1.0
  let w = $World { pos, rot, iw, inv_mass: b.inv_mass, soft }
  let jac_last: #[F32] = jacobians_into w rows (@array.fill (rows.length / stride * jac_stride) 0.0)
  for step in 0..substeps:
    vel := accelerate_in_place h gravity b touching vel
    vel := warm_start_in_place w rows jac_last imp vel
    let (biased_vel, biased_imp) = solve_pass_in_place w rows jac_last true vel imp
    vel := biased_vel
    imp := biased_imp
    if not links.is_empty:
      vel := joints.solve_in_place h (U32.to_f32 step * h) w.pos w.rot b.inv_mass w.iw links vel
    let (next_pos, next_rot) = advance_in_place h b.inv_mass vel w.pos w.rot
    w.pos := next_pos
    w.rot := next_rot
    w.iw := inertia_table_into w.rot b.inv_inertia w.iw
    jac_last := jacobians_into w rows jac_last
    let (relaxed_vel, relaxed_imp) = solve_pass_in_place w rows jac_last false vel imp
    vel := relaxed_vel
    imp := relaxed_imp
  let (final_vel, final_imp) = restitution_pass_in_place w rows jac_last vel imp
  return (w.pos, w.rot, final_vel, final_imp)

func solve_into (dt: F32) -> (substeps: U32) -> (gravity: Vec3) -> (b: Bodies) -> (rows: #[F32]) -> (imp_in: #[F32]) -> (pos: own #[F32]) -> (rot: own #[F32]) -> (vel: own #[F32]) -> (imp: own #[F32]) : (#[F32], #[F32], #[F32], #[F32]) => return
  solve_joints_into #[] dt substeps gravity b rows imp_in pos rot vel imp
