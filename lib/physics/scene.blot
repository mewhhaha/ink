//! What physics sees of a world: every entity with a collider, a body, a
//! character or a brush becomes a proxy with a world-space shape and bounds.
//! Callers build `Source` values from their own data. Queries (ray, shape cast,
//! overlap) run against the scene built from those sources.
//!
//! Key items: [`ShapeKind`], [`BodyKind`], [`Collider`], [`Rigid`], [`packed_proxy`].
//!
//! ```blot
//! import * as math from "ink/math"
//! let sources = #[box 1 (math.vec3 0.0 0.0 (-5.0)) (math.vec3 2.0 2.0 2.0)]
//! let world = build_into (empty ()) sources
//! ray_any (read world) math.zero3 math.forward 10.0 65535 0 // => true
//! ```

import * as changes from "../changes"
import * as array from "std/array"
import { Vec3 } from "std/vector"
import { Quat, Vec4 } from "../math"
import * as math from "../math"
import * as shapes from "./shapes"
import * as terrain from "../terrain"
import * as spatial from "../spatial"
import * as mesh from "../mesh"
import { Shape } from "./shapes"

type ShapeKind is data = $Box | $Sphere | $Capsule | $Brush | $Heightfield terrain.Terrain | $Mesh mesh.Mesh
type BodyKind is data = $Dynamic | $Kinematic | $Static

// A collider as authored on an entity.
type Collider is data = $Collider {
  shape: ShapeKind,
  size: Vec3,
  radius: F32,
  height: F32,
  offset: Vec3,
  friction: F32,
  restitution: F32,
  layer: U32,
  mask: U32,
  trigger: Bool,
}

// A rigid body as authored, plus its simulation state.
type Rigid is data = $Rigid {
  kind: BodyKind,
  mass: F32,
  gravity_scale: F32,
  linear_damping: F32,
  angular_damping: F32,
  can_sleep: Bool,
  continuous: Bool,
  linear_velocity: Vec3,
  angular_velocity: Vec3,
  sleeping: Bool,
  sleep_time: F32,
}

// A character controller as authored, plus its state.
type Walker is data = $Walker {
  max_slope: F32,
  step_height: F32,
  snap_distance: F32,
  push: F32,
  velocity: Vec3,
  grounded: Bool,
  ground: U32,
  ground_normal: Vec3,
}

// One entity as physics reads it. Pose is in world space.
type Source is data = $Source {
  index: U32,
  id: U32,
  position: Vec3,
  rotation: Quat,
  scale: Vec3,
  collider: Maybe Collider,
  rigid: Maybe Rigid,
  walker: Maybe Walker,
  planes: &[Vec4],
}

// Proxy kinds.
const kind_static: U32 = 0
const kind_kinematic: U32 = 1
const kind_dynamic: U32 = 2

type Proxy is data = $Proxy {
  source: U32,
  id: U32,
  kind: U32,
  walker: Bool,
  shape: Shape,
  inertia: Vec3,
  inscribed: F32,
  low: Vec3,
  high: Vec3,
  layer: U32,
  mask: U32,
  friction: F32,
  restitution: F32,
  trigger: Bool,
}

// Persistent proxy payloads contain scalar spans, never borrowed descriptors.
type ProxyRow is data = $ProxyRow {
  source: U32,
  id: U32,
  kind: U32,
  walker: Bool,
  shape: shapes.StoredShape,
  inertia: Vec3,
  inscribed: F32,
  low: Vec3,
  high: Vec3,
  layer: U32,
  mask: U32,
  friction: F32,
  restitution: F32,
  trigger: Bool,
}
func packed_proxy (shape: shapes.StoredShape) -> (value: Proxy) => $ProxyRow {
  source: value.source,
  id: value.id,
  kind: value.kind,
  walker: value.walker,
  shape,
  inertia: value.inertia,
  inscribed: value.inscribed,
  low: value.low,
  high: value.high,
  layer: value.layer,
  mask: value.mask,
  friction: value.friction,
  restitution: value.restitution,
  trigger: value.trigger,
}
func pack_proxy (geometry: own shapes.Geometry) -> (value: Proxy) : (ProxyRow, shapes.Geometry) =>
  let (shape, geometry) = shapes.pack geometry value.shape
  return (packed_proxy shape value, geometry)
func unpack_proxy geometry -> (value: ProxyRow) => $Proxy {
  source: value.source,
  id: value.id,
  kind: value.kind,
  walker: value.walker,
  shape: shapes.unpack geometry value.shape,
  inertia: value.inertia,
  inscribed: value.inscribed,
  low: value.low,
  high: value.high,
  layer: value.layer,
  mask: value.mask,
  friction: value.friction,
  restitution: value.restitution,
  trigger: value.trigger,
}

type Scene is data = $Scene { geometry: shapes.Geometry, proxies: #[ProxyRow], index: spatial.Index, slots: #[U32], source_count: U32 }
type Read is data = $Read { geometry: shapes.Read, proxies: &[ProxyRow], index: spatial.Read, slots: &[U32] }
func read (scene: Scene): Read => $Read {geometry: shapes.read scene.geometry,
  proxies: &scene.proxies[0..scene.proxies.length], index: spatial.read scene.index, slots: &scene.slots[0..scene.slots.length]}
func count scene => scene.proxies.length
func proxy scene -> index => unpack_proxy scene.geometry scene.proxies[index]
func proxies (scene: Scene) : #[Proxy] =>
  let rows = scene.proxies
  let geometry = scene.geometry
  return @array.generate rows.length (func (i: U32) : Proxy => unpack_proxy geometry rows[i])

// The stored proxy row moved by `shift` (translation only).
// `row`'s shape must already reside in `geometry` if it is a hull.
func shifted_row (geometry: own shapes.Geometry) -> (row: ProxyRow) -> (shift: Vec3) : (ProxyRow, shapes.Geometry) =>
  if let $shapes.StoredCapsule { a, b, radius } = row.shape:
    row.shape := $shapes.StoredCapsule { a: a + shift, b: b + shift, radius }
  else:
    if let $shapes.StoredHull idx = row.shape:
      let poly = geometry.hulls[idx]
      let (placed, next_geom) = shapes.poly_place_stored geometry poly shift math.identity_quat math.one3
      let (stored, next_geom) = shapes.store_hull next_geom placed
      geometry := next_geom
      row.shape := stored
    else:
      if let $shapes.StoredHeightfield idx = row.shape:
        let t = geometry.heightfields[idx]
        t.origin := self + shift
        let (stored, next_geom) = shapes.store_heightfield geometry t
        geometry := next_geom
        row.shape := stored
  row.low := self + shift
  row.high := self + shift
  return (row, geometry)

// A cast hit: the entity, the fraction of the motion travelled before
// touching, the contact point and normal (from the shape toward the moving
// capsule), and how deep the capsule started inside if it did.
type Hit is data = $Hit { id: U32, proxy: U32, time: F32, distance: F32, point: Vec3, normal: Vec3, surface: Vec3, depth: F32 }

const default_collider = $Collider {
  shape: $Brush,
  size: math.one3,
  radius: 0.5,
  height: 2.0,
  offset: math.zero3,
  friction: 0.6,
  restitution: 0.0,
  layer: 1,
  mask: 65535,
  trigger: false,
}

const default_rigid = $Rigid {
  kind: $Dynamic, mass: 1.0, gravity_scale: 1.0,
  linear_damping: 0.0, angular_damping: 0.05,
  can_sleep: true, continuous: true,
  linear_velocity: math.zero3, angular_velocity: math.zero3,
  sleeping: false, sleep_time: 0.0,
}
const default_walker = $Walker {
  max_slope: 50.0, step_height: 0.4, snap_distance: 0.3, push: 1.0,
  velocity: math.zero3, grounded: false, ground: 0, ground_normal: math.up,
}

const empty_planes: #[Vec4] = #[]
func source (id: U32) => func (position: Vec3) => $Source {
  index: 0, id, position, rotation: math.identity_quat, scale: math.one3,
  collider: $Nothing, rigid: $Nothing, walker: $Nothing, planes: &empty_planes[0..0],
}

// The default collider with a shape and its dimensions, and a source holding
// one, each made at once without re-materializing `default_collider` on every call.
func shaped (shape: ShapeKind) => func (size: Vec3) => func (radius: F32) => func (height: F32) => func (offset: Vec3) =>
  return $Collider { shape, size, radius, height, offset, friction: 0.6, restitution: 0.0, layer: 1, mask: 65535, trigger: false }

func holding (id: U32) => func (position: Vec3) => func (collider: Collider) => func (walker: Maybe Walker) => $Source {
  index: 0, id, position, rotation: math.identity_quat, scale: math.one3,
  collider: $Some collider, rigid: $Nothing, walker, planes: &empty_planes[0..0],
}

func box (id: U32) => func (position: Vec3) => func (size: Vec3) => $Source {
  index: 0, id, position, rotation: math.identity_quat, scale: math.one3,
  collider: $Some ($Collider { shape: $Box, size, radius: 0.5, height: 2.0, offset: math.zero3, friction: 0.6, restitution: 0.0, layer: 1, mask: 65535, trigger: false }),
  rigid: $Nothing, walker: $Nothing, planes: &empty_planes[0..0],
}

func sphere (id: U32) => func (position: Vec3) => func (radius: F32) => $Source {
  index: 0, id, position, rotation: math.identity_quat, scale: math.one3,
  collider: $Some ($Collider { shape: $Sphere, size: math.one3, radius, height: 2.0, offset: math.zero3, friction: 0.6, restitution: 0.0, layer: 1, mask: 65535, trigger: false }),
  rigid: $Nothing, walker: $Nothing, planes: &empty_planes[0..0],
}

func capsule (id: U32) => func (position: Vec3) => func (radius: F32) => func (height: F32) => $Source {
  index: 0, id, position, rotation: math.identity_quat, scale: math.one3,
  collider: $Some ($Collider { shape: $Capsule, size: math.one3, radius, height, offset: math.zero3, friction: 0.6, restitution: 0.0, layer: 1, mask: 65535, trigger: false }),
  rigid: $Nothing, walker: $Nothing, planes: &empty_planes[0..0],
}

func dynamic (s: Source) =>
  s.rigid := $Some default_rigid
  return s

// Characters are positioned by their feet.
func character (id: U32) => func (position: Vec3) => $Source {
  index: 0, id, position, rotation: math.identity_quat, scale: math.one3,
  collider: $Some ($Collider { shape: $Capsule, size: math.one3, radius: 0.4, height: 1.8, offset: math.vec3 0.0 0.9 0.0, friction: 0.6, restitution: 0.0, layer: 1, mask: 65535, trigger: false }),
  rigid: $Nothing, walker: $Some default_walker, planes: &empty_planes[0..0],
}

// A static triangle mesh authored in world space (see `shapes.cook_mesh`).
func level (id: U32) => func (m: mesh.Mesh) => $Source {
  index: 0, id, position: math.zero3, rotation: math.identity_quat, scale: math.one3,
  collider: $Some ($Collider { shape: $Mesh m, size: math.one3, radius: 0.5, height: 2.0, offset: math.zero3, friction: 0.6, restitution: 0.0, layer: 1, mask: 65535, trigger: false }),
  rigid: $Nothing, walker: $Nothing, planes: &empty_planes[0..0],
}

// Finite terrain is authored in world space and remains immovable.
func ground (id: U32) => func (t: terrain.Terrain) => $Source {
  index: 0, id, position: t.origin, rotation: math.identity_quat, scale: math.one3,
  collider: $Some ($Collider { shape: $Heightfield t, size: math.one3, radius: 0.5, height: 2.0, offset: math.zero3, friction: 0.6, restitution: 0.0, layer: 1, mask: 65535, trigger: false }),
  rigid: $Nothing, walker: $Nothing, planes: &empty_planes[0..0],
}

// Compose a local pose with a parent pose.
func rotate (q: Quat) => func (v: Vec3) => math.Quat.rotate q v
func compose (a: Quat) => func (b: Quat) => a * b
func scale_by (a: Vec3) => func (b: Vec3) => shapes.mul3 a b

// The world-space shape of a source, its principal inertia per unit mass and
// the radius of the largest sphere inside it; or nothing if it has no shape.
// Pose arithmetic stays scalar, in Vec3 operation order: each Vec3 temporary
// costs a heap allocation.
func pack_heightfield (geometry: own shapes.Geometry) -> (t: terrain.Terrain) : (terrain.Stored, shapes.Geometry) =>
  let $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes } = geometry
  let (stored, heights) = terrain.pack heights t
  return (stored, $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes })

func shape_of (geometry: own shapes.Geometry) -> (source: Source) -> (collider: Collider) : (Maybe (shapes.StoredShape, Vec3, F32), shapes.Geometry) =>
  if not (is_finite source.position.x and is_finite source.position.y and is_finite source.position.z and is_finite source.scale.x and is_finite source.scale.y and is_finite source.scale.z and is_finite source.rotation.x and is_finite source.rotation.y and is_finite source.rotation.z and is_finite source.rotation.w and is_finite collider.offset.x and is_finite collider.offset.y and is_finite collider.offset.z):
    return ($Nothing, geometry)
  let sx = abs source.scale.x
  let sy = abs source.scale.y
  let sz = abs source.scale.z
  let cx = source.position.x
  let cy = source.position.y
  let cz = source.position.z
  if collider.offset.x != 0.0 or collider.offset.y != 0.0 or collider.offset.z != 0.0:
    let (ox, oy, oz) = math.rotate_parts source.rotation.x source.rotation.y source.rotation.z source.rotation.w (collider.offset.x * source.scale.x) (collider.offset.y * source.scale.y) (collider.offset.z * source.scale.z)
    cx := self + ox
    cy := self + oy
    cz := self + oz
  if not (is_finite cx and is_finite cy and is_finite cz):
    return ($Nothing, geometry)
  let center = $Vec3 { x: cx, y: cy, z: cz }
  if let $Heightfield t = collider.shape:
    let (stored_t, next_geom) = pack_heightfield geometry t
    let (stored, next_geom) = shapes.store_heightfield next_geom stored_t
    return ($Some (stored, math.zero3, 0.0), next_geom)
  if let $Mesh m = collider.shape:
    let (stored_m, next_geom) = shapes.pack_mesh geometry m
    let (stored, next_geom) = shapes.store_mesh next_geom stored_m
    return ($Some (stored, math.zero3, 0.0), next_geom)
  if let $Box = collider.shape:
    if not (is_finite collider.size.x and is_finite collider.size.y and is_finite collider.size.z):
      return ($Nothing, geometry)
    let hx = abs collider.size.x * sx * 0.5
    let hy = abs collider.size.y * sy * 0.5
    let hz = abs collider.size.z * sz * 0.5
    let half = $Vec3 { x: hx, y: hy, z: hz }
    let inertia = shapes.box_inertia half
    let inscribed = min hx (min hy hz)
    let span = hx + hy + hz
    if not (is_finite hx and is_finite hy and is_finite hz and is_finite inertia.x and is_finite inertia.y and is_finite inertia.z and is_finite inscribed and is_finite span and is_finite (abs cx + span) and is_finite (abs cy + span) and is_finite (abs cz + span)):
      return ($Nothing, geometry)
    let (poly, next_geom) = shapes.box_poly geometry center source.rotation half
    let (stored, next_geom) = shapes.store_hull next_geom poly
    return ($Some (stored, inertia, inscribed), next_geom)
  if let $Sphere = collider.shape:
    if not (is_finite collider.radius):
      return ($Nothing, geometry)
    let radius = max 0.0 collider.radius * max sx (max sy sz)
    let i = shapes.sphere_inertia radius
    if not (is_finite radius and is_finite i and is_finite (abs cx + radius) and is_finite (abs cy + radius) and is_finite (abs cz + radius)):
      return ($Nothing, geometry)
    return ($Some ($shapes.StoredCapsule { a: center, b: center, radius }, $Vec3 { x: i, y: i, z: i }, radius), geometry)
  if let $Capsule = collider.shape:
    if not (is_finite collider.radius and is_finite collider.height):
      return ($Nothing, geometry)
    let radius = max 0.0 collider.radius * max sx sz
    let half_segment = max 0.0 (max 0.0 collider.height * sy * 0.5 - radius)
    let (ux, uy, uz) = math.rotate_parts source.rotation.x source.rotation.y source.rotation.z source.rotation.w 0.0 1.0 0.0
    let ax = ux * half_segment
    let ay = uy * half_segment
    let az = uz * half_segment
    let a = $Vec3 { x: cx - ax, y: cy - ay, z: cz - az }
    let b = $Vec3 { x: cx + ax, y: cy + ay, z: cz + az }
    let inertia = shapes.capsule_inertia radius half_segment
    if not (is_finite radius and is_finite half_segment and is_finite a.x and is_finite a.y and is_finite a.z and is_finite b.x and is_finite b.y and is_finite b.z and is_finite inertia.x and is_finite inertia.y and is_finite inertia.z):
      return ($Nothing, geometry)
    if not (is_finite (min a.x b.x - radius) and is_finite (max a.x b.x + radius) and is_finite (min a.y b.y - radius) and is_finite (max a.y b.y + radius) and is_finite (min a.z b.z - radius) and is_finite (max a.z b.z + radius)):
      return ($Nothing, geometry)
    return ($Some ($shapes.StoredCapsule { a, b, radius }, inertia, radius), geometry)
  if sx <= 1.0e-12 or sy <= 1.0e-12 or sz <= 1.0e-12:
    return ($Nothing, geometry)
  let (maybe_local, scratch) = shapes.hull_poly (shapes.empty ()) source.planes
  if let $Some stored_local = maybe_local:
    let local = shapes.unpack_poly scratch stored_local
    let (low, high) = shapes.bounds ($shapes.Hull local)
    let half = $Vec3 { x: (high.x - low.x) * sx * 0.5, y: (high.y - low.y) * sy * 0.5, z: (high.z - low.z) * sz * 0.5 }
    let inertia = shapes.box_inertia half
    let inscribed = min half.x (min half.y half.z)
    if not (math.finite3 low and math.finite3 high and math.finite3 half and math.finite3 inertia and is_finite inscribed):
      return ($Nothing, geometry)
    let (poly, next_geom) = shapes.poly_place geometry local source.position source.rotation source.scale
    let (stored, next_geom) = shapes.store_hull next_geom poly
    return ($Some (stored, inertia, inscribed), next_geom)
  return ($Nothing, geometry)

func kind_of (source: Source) => body_kind source.rigid source.walker

private func body_kind (rigid: Maybe Rigid) -> (walker: Maybe Walker) : U32 => case rigid of
  $Some r => case r.kind of
    $Dynamic => kind_dynamic
    $Kinematic => kind_kinematic
    $Static => kind_static
  $Nothing => case walker of
    $Some _ => kind_kinematic
    $Nothing => kind_static

private func sphere_proxy_row (index: U32) -> (kind: U32) -> (is_walker: Bool) -> source -> collider : Maybe ProxyRow =>
  let ox_in = if kind == kind_dynamic then 0.0 else collider.offset.x
  let oy_in = if kind == kind_dynamic then 0.0 else collider.offset.y
  let oz_in = if kind == kind_dynamic then 0.0 else collider.offset.z
  let sc_x = if is_walker then 1.0 else source.scale.x
  let sc_y = if is_walker then 1.0 else source.scale.y
  let sc_z = if is_walker then 1.0 else source.scale.z
  let qx = if is_walker then 0.0 else source.rotation.x
  let qy = if is_walker then 0.0 else source.rotation.y
  let qz = if is_walker then 0.0 else source.rotation.z
  let qw = if is_walker then 1.0 else source.rotation.w
  if not (is_finite source.position.x and is_finite source.position.y and is_finite source.position.z and is_finite sc_x and is_finite sc_y and is_finite sc_z and is_finite qx and is_finite qy and is_finite qz and is_finite qw and is_finite ox_in and is_finite oy_in and is_finite oz_in and is_finite collider.radius and is_finite collider.friction and is_finite collider.restitution):
    return $Nothing
  let sx = abs sc_x
  let sy = abs sc_y
  let sz = abs sc_z
  let cx = source.position.x
  let cy = source.position.y
  let cz = source.position.z
  if ox_in != 0.0 or oy_in != 0.0 or oz_in != 0.0:
    let (ox, oy, oz) = math.rotate_parts qx qy qz qw (ox_in * sc_x) (oy_in * sc_y) (oz_in * sc_z)
    cx := self + ox
    cy := self + oy
    cz := self + oz
  let radius = max 0.0 collider.radius * max sx (max sy sz)
  let i = shapes.sphere_inertia radius
  if not (is_finite cx and is_finite cy and is_finite cz and is_finite radius and is_finite i and is_finite (abs cx + radius) and is_finite (abs cy + radius) and is_finite (abs cz + radius)):
    return $Nothing
  return $Some (sphere_row index source.id kind is_walker collider cx cy cz radius i)

private func sphere_row (index: U32) -> (id: U32) -> (kind: U32) -> (walker: Bool) -> collider -> (cx: F32) -> (cy: F32) -> (cz: F32) -> (radius: F32) -> (i: F32) : ProxyRow =>
  let center = $Vec3 { x: cx, y: cy, z: cz }
  return $ProxyRow {
    source: index,
    id,
    kind,
    walker: walker,
    shape: $shapes.StoredCapsule { a: center, b: center, radius },
    inertia: $Vec3 { x: i, y: i, z: i },
    inscribed: radius,
    low: $Vec3 { x: cx - radius, y: cy - radius, z: cz - radius },
    high: $Vec3 { x: cx + radius, y: cy + radius, z: cz + radius },
    layer: collider.layer,
    mask: collider.mask,
    friction: collider.friction,
    restitution: collider.restitution,
    trigger: collider.trigger,
  }

func proxy_of (geometry: own shapes.Geometry) -> (index: U32) -> (source: Source) : (Maybe ProxyRow, shapes.Geometry) =>
  let collider = case source.collider of
    $Some c => c
    $Nothing => default_collider
  if source.planes.length == 0:
    let $Some _ = source.collider else:
      return ($Nothing, geometry)
  if let $Sphere = collider.shape:
    return (sphere_proxy_row index (kind_of source) (Maybe.is_some source.walker) source collider, geometry)
  let kind = kind_of source
  if let $Heightfield _ = collider.shape:
    kind := kind_static
  if let $Mesh _ = collider.shape:
    kind := kind_static
  let is_walker = case source.walker of
    $Some _ => true
    $Nothing => false
  // A dynamic body turns about its origin: it has no collider offset. A
  // character is as big as its capsule says and always stands upright,
  // whatever its transform's scale and rotation (a first-person camera
  // turns the transform).
  if kind == kind_dynamic:
    collider.offset := math.zero3
  if is_walker:
    source.scale := math.one3
    source.rotation := math.identity_quat
  let (maybe_shape, geometry) = shape_of geometry source collider
  let $Some (stored_shape, inertia, inscribed) = maybe_shape else:
    return ($Nothing, geometry)
  // Bounds without unpacking hulls or allocating temporary Vec3s.
  let (low, high) = case stored_shape of
    $shapes.StoredCapsule { a, b, radius } => ($Vec3 { x: min a.x b.x - radius, y: min a.y b.y - radius, z: min a.z b.z - radius }, $Vec3 { x: max a.x b.x + radius, y: max a.y b.y + radius, z: max a.z b.z + radius })
    $shapes.StoredHull idx => do:
      let poly = geometry.hulls[idx]
      if poly.verts.count == 0:
        break (shapes.zero, shapes.zero)
      let start = poly.verts.start
      let v0 = geometry.points[start]
      let lx = v0.x
      let ly = v0.y
      let lz = v0.z
      let hx = v0.x
      let hy = v0.y
      let hz = v0.z
      for k in 1 .. poly.verts.count:
        let v = geometry.points[start + k]
        lx := min self v.x
        ly := min self v.y
        lz := min self v.z
        hx := max self v.x
        hy := max self v.y
        hz := max self v.z
      break ($Vec3 { x: lx, y: ly, z: lz }, $Vec3 { x: hx, y: hy, z: hz })
    _ => shapes.bounds (shapes.unpack geometry stored_shape)
  if not (is_finite low.x and is_finite low.y and is_finite low.z and is_finite high.x and is_finite high.y and is_finite high.z and is_finite inertia.x and is_finite inertia.y and is_finite inertia.z and is_finite inscribed and is_finite collider.friction and is_finite collider.restitution):
    return ($Nothing, geometry)
  return ($Some ($ProxyRow {
    source: index,
    id: source.id,
    kind,
    walker: is_walker,
    shape: stored_shape,
    inertia,
    inscribed,
    low,
    high,
    layer: collider.layer,
    mask: collider.mask,
    friction: collider.friction,
    restitution: collider.restitution,
    trigger: collider.trigger,
  }), geometry)

private func replace_proxy_shape (geometry: own shapes.Geometry) -> (old: shapes.StoredShape) -> (scratch: shapes.Geometry) -> (next: shapes.StoredShape) : (shapes.StoredShape, shapes.Geometry) =>
  if let $shapes.StoredHull next_idx = next:
    let next_poly = scratch.hulls[next_idx]
    if next_poly.rings.start == shapes.box_topology:
      if let $shapes.StoredHull previous_idx = old:
        return shapes.replace_box geometry previous_idx (shapes.unpack_poly scratch next_poly)
  return shapes.replace geometry old (shapes.unpack scratch next)

// Explicit dirty source indices mutate the live scene without rebuilding unchanged geometry.
// Source order/count or shape presence changes rebuild the tree as needed.
func update (sources: #[Source]) -> (previous: own Scene) -> (changed: #[U32]) : Scene =>
  if sources.length != previous.source_count:
    return build_into previous sources
  if changed.is_empty:
    return previous
  let n = sources.length
  let changed = if changed.length == 1 then (if changed[0] < n then changed else #[]) else array.filter (func i => i < n) (changes.unique changed)
  if changed.length == 0:
    return previous
  let $Scene {geometry: storage, proxies, index, slots, source_count} = previous
  let count = proxies.length
  if changed.length == 1:
    let src_idx = changed[0]
    let slot = slots[src_idx]
    let src = sources[src_idx]
    if slot < count and src.planes.length == 0:
      if let $Some col = src.collider:
        if let $Sphere = col.shape:
          if let $Some row = sphere_proxy_row src_idx (body_kind src.rigid src.walker) (Maybe.is_some src.walker) src col:
            if let $shapes.StoredCapsule _ = proxies[slot].shape:
              proxies[slot] := row
              let index = spatial.refit_one index slot ($spatial.Bounds { low: row.low, high: row.high })
              return $Scene {geometry: storage, proxies, index, slots, source_count}
  // Slot `count` stands for a source without a proxy, which refit skips.
  let dirty = @array.fill changed.length count
  for k in 0 .. changed.length:
    dirty[k] := slots[changed[k]]
  // New proxy geometry is scratch. The live scene keeps only the packed spans.
  let scratch = shapes.empty ()
  let next: #[Maybe ProxyRow] = #[]
  for k in 0 .. changed.length:
    let (row, next_scratch) = proxy_of scratch changed[k] sources[changed[k]]
    scratch := next_scratch
    @storage.push next row
  let rebuild = false
  for k in 0..changed.length:
    if let $Some _ = next[k]:
      if dirty[k] >= count:
        rebuild := true
    else:
      if dirty[k] < count:
        rebuild := true
  if rebuild:
    return build_into ($Scene {geometry: storage, proxies, index, slots, source_count}) sources
  for k in 0 .. dirty.length:
    if let $Some row = next[k]:
      let slot = dirty[k]
      let both_capsule = false
      if let $shapes.StoredCapsule _ = row.shape:
        if let $shapes.StoredCapsule _ = proxies[slot].shape:
          both_capsule := true
      if both_capsule:
        proxies[slot] := row
      else:
        let (shape, geometry) = replace_proxy_shape storage proxies[slot].shape scratch row.shape
        storage := geometry
        row.shape := shape
        proxies[slot] := row
  let bounds = @array.generate changed.length (func (k: U32) => case next[k] of
    $Some p => $spatial.Bounds { low: p.low, high: p.high }
    $Nothing => $spatial.Bounds { low: math.zero3, high: math.zero3 })
  let index = spatial.refit index dirty bounds
  return $Scene {geometry: storage, proxies, index, slots, source_count}

// Queries ---------------------------------------------------------------------------

// Do the bounds [low, high] (grown by `grow`) overlap the proxy's?
func touches_bounds (proxy: Proxy) => func (low: Vec3) => func (high: Vec3) => return
  low.x <= proxy.high.x and high.x >= proxy.low.x and low.y <= proxy.high.y and high.y >= proxy.low.y and low.z <= proxy.high.z and high.z >= proxy.low.z

const hit_eps = 0.0003

// Analytic ray-vs-convex-polytope intersection (Kay-Kajiya slabs), returning
// (time, point, normal, surface, depth).
private func ray_hull (poly: shapes.Poly) -> (origin: Vec3) -> (delta: Vec3) : Maybe (F32, Vec3, Vec3, Vec3, F32) =>
  let planes = poly.planes
  let count = planes.length
  if count == 0 or not (math.finite3 origin and math.finite3 delta):
    return $Nothing
  let enter = 0.0
  let leave = 1.0
  let enter_face = count
  let inside = true
  for f in 0 .. count:
    let pl = planes[f]
    let side = pl.x * origin.x + pl.y * origin.y + pl.z * origin.z - pl.w
    let slope = pl.x * delta.x + pl.y * delta.y + pl.z * delta.z
    if not (is_finite side and is_finite slope):
      return $Nothing
    if side > 0.0:
      inside := false
    if abs slope < 0.0000001:
      if side > 0.0:
        return $Nothing
    else:
      let hit_t = F32.neg side / slope
      if not (is_finite hit_t):
        return $Nothing
      if slope < 0.0:
        if hit_t > enter:
          enter := hit_t
          enter_face := f
      else:
        if hit_t < leave:
          leave := hit_t
      if not (enter <= leave):
        return $Nothing
  if inside:
    let (dist, qx, qy, qz, nx, ny, nz) = shapes.poly_point_xyz poly origin.x origin.y origin.z
    let pt = $Vec3 { x: qx, y: qy, z: qz }
    let nrm = $Vec3 { x: nx, y: ny, z: nz }
    return $Some (0.0, pt, nrm, shapes.poly_surface poly pt nrm, max 0.0 (F32.neg dist))
  if enter_face < count and enter >= 0.0 and enter <= 1.0 and enter <= leave:
    let pt = $Vec3 { x: origin.x + delta.x * enter, y: origin.y + delta.y * enter, z: origin.z + delta.z * enter }
    let pl = planes[enter_face]
    let nrm = $Vec3 { x: pl.x, y: pl.y, z: pl.z }
    return $Some (enter, pt, nrm, shapes.poly_surface poly pt nrm, 0.0)
  return $Nothing

// Analytic ray-vs-sphere intersection when a capsule has zero spine length.
private func ray_sphere_entry (a_val: F32) -> (b_val: F32) -> (dist2: F32) -> (r2: F32) : Maybe F32 =>
  if b_val >= 0.0 or a_val <= 0.0 or not (is_finite a_val and is_finite b_val):
    return $Nothing
  let c_val = dist2 - r2
  let disc = b_val * b_val - a_val * c_val
  if not (is_finite disc) or disc < 0.0:
    return $Nothing
  let t = (F32.neg b_val - sqrt disc) / a_val
  return if is_finite t and t >= 0.0 and t <= 1.0 then $Some t else $Nothing

private func ray_sphere (center: Vec3) -> (rad: F32) -> (origin: Vec3) -> (delta: Vec3) : Maybe (F32, Vec3, Vec3, Vec3, F32) =>
  if not (math.finite3 origin and math.finite3 delta and is_finite rad) or rad < 0.0:
    return $Nothing
  let ox = origin.x - center.x
  let oy = origin.y - center.y
  let oz = origin.z - center.z
  let dist2 = ox * ox + oy * oy + oz * oz
  let r2 = rad * rad
  if dist2 <= r2:
    let d = sqrt dist2
    let nx = if d > 0.00001 then ox / d else 0.0
    let ny = if d > 0.00001 then oy / d else 1.0
    let nz = if d > 0.00001 then oz / d else 0.0
    let nrm = $Vec3 { x: nx, y: ny, z: nz }
    let pt = $Vec3 { x: center.x + nx * rad, y: center.y + ny * rad, z: center.z + nz * rad }
    return $Some (0.0, pt, nrm, nrm, max 0.0 (rad - d))
  let a_val = delta.x * delta.x + delta.y * delta.y + delta.z * delta.z
  let b_val = ox * delta.x + oy * delta.y + oz * delta.z
  let $Some t = ray_sphere_entry a_val b_val dist2 r2 else:
    return $Nothing
  let px = origin.x + delta.x * t
  let py = origin.y + delta.y * t
  let pz = origin.z + delta.z * t
  let vx = px - center.x
  let vy = py - center.y
  let vz = pz - center.z
  let vl = sqrt (vx * vx + vy * vy + vz * vz)
  let nrm = if vl > 0.00001 then $Vec3 { x: vx / vl, y: vy / vl, z: vz / vl } else $Vec3 { x: 0.0, y: 1.0, z: 0.0 }
  return $Some (t, $Vec3 { x: px, y: py, z: pz }, nrm, nrm, 0.0)

// Cast traversal compares sphere times before constructing the winning hit.
private func ray_sphere_time (center: Vec3) -> (rad: F32) -> (origin: Vec3) -> (delta: Vec3) -> (a_val: F32) : Maybe F32 =>
  if not (is_finite rad) or rad < 0.0:
    return $Nothing
  let ox = origin.x - center.x
  let oy = origin.y - center.y
  let oz = origin.z - center.z
  let dist2 = ox * ox + oy * oy + oz * oz
  let r2 = rad * rad
  if dist2 <= r2:
    return $Some 0.0
  let b_val = ox * delta.x + oy * delta.y + oz * delta.z
  return ray_sphere_entry a_val b_val dist2 r2

// Move a capsule (segment ab, radius) by `delta` against one shape. Returns
// the first contact along the way: the fraction of `delta` travelled, the
// contact point on the shape, the normal pointing from the shape to the
// capsule, and how deep the capsule already was. If it overlaps at the start
// the fraction is 0.
func cast_shape (shape: Shape) => func (a: Vec3) => func (b: Vec3) => func (radius: F32) => func (delta: Vec3) =>
  // Exact analytic paths for zero-radius point rays against meshes, hulls, and spheres.
  if radius == 0.0 and a.x == b.x and a.y == b.y and a.z == b.z:
    case shape of
      $shapes.Mesh m => do:
        let found = mesh.ray_hit m a delta
        let $Some (time, point, normal, surface, _) = found else:
          return $Nothing
        return $Some (time, point, normal, surface, 0.0)
      $shapes.Hull poly => do:
        return ray_hull poly a delta
      $shapes.Capsule { a: ca, b: cb, radius: cr } => do:
        if ca.x == cb.x and ca.y == cb.y and ca.z == cb.z:
          return ray_sphere ca cr a delta
        break ()
      _ => ()
  let t = 0.0
  let heightfield = false
  if let $shapes.Heightfield _ = shape:
    heightfield := true
  let steps = 40
  let delta_len = 0.0
  if heightfield:
    steps := 96
    delta_len := delta.length
  for 0..steps:
    let gap = shapes.segment_gap shape ($Vec3 { x: a.x + delta.x * t, y: a.y + delta.y * t, z: a.z + delta.z * t }) ($Vec3 { x: b.x + delta.x * t, y: b.y + delta.y * t, z: b.z + delta.z * t })
    let clearance = gap.dist - radius
    if clearance <= hit_eps:
      return $Some (t, gap.on_shape, gap.normal, gap.surface, if t == 0.0 then max 0.0 (F32.neg clearance) else 0.0)
    let closing = if heightfield then delta_len else F32.neg (gap.normal.dot delta)
    if closing <= 0.000001:
      return $Nothing
    t := self + clearance / closing
    if t > 1.0:
      return $Nothing
  return $Nothing

// Bounds swept by a moving capsule: the corners' least and greatest
// coordinates, before and after the move, widened by the radius. Scalars keep
// the Vec3 operation order without allocating temporaries.
func swept_bounds (a: Vec3) => func (b: Vec3) => func (radius: F32) => func (delta: Vec3) =>
  let ex = a.x + delta.x
  let ey = a.y + delta.y
  let ez = a.z + delta.z
  let fx = b.x + delta.x
  let fy = b.y + delta.y
  let fz = b.z + delta.z
  let low = $Vec3 { x: min (min a.x b.x) (min ex fx) - radius, y: min (min a.y b.y) (min ey fy) - radius, z: min (min a.z b.z) (min ez fz) - radius }
  let high = $Vec3 { x: max (max a.x b.x) (max ex fx) + radius, y: max (max a.y b.y) (max ey fy) + radius, z: max (max a.z b.z) (max ez fz) + radius }
  return (low, high)

// What a cast can touch: proxies on `mask` layers, never `skip` (an entity id),
// triggers only if `triggers`, characters only if `walkers`, dynamic bodies
// only if `dynamics`.
type Filter is data = $Filter { mask: U32, skip: U32, triggers: Bool, walkers: Bool, dynamics: Bool }

func accepts (f: Filter) => func (proxy: Proxy) => return
  (proxy.layer & f.mask) != 0 and proxy.id != f.skip and (f.triggers or not proxy.trigger) and (f.walkers or not proxy.walker) and (f.dynamics or proxy.kind != kind_dynamic)

// The nearest hit of a moving capsule, if any.
// Conservative time lower bound for the capsule's moving AABB. Match the
// original swept candidate box, then allow narrow-phase tolerance and F32
// coordinate roundoff before pruning against an earlier hit.
private func accepts_row (f: Filter) -> (row: ProxyRow) : Bool => return
  (row.layer & f.mask) != 0 and row.id != f.skip and (f.triggers or not row.trigger) and (f.walkers or not row.walker) and (f.dynamics or row.kind != kind_dynamic)
private func touches_bounds_row (row: ProxyRow) -> (low: Vec3) -> (high: Vec3) : Bool => return
  low.x <= row.high.x and high.x >= row.low.x and low.y <= row.high.y and high.y >= row.low.y and low.z <= row.high.z and high.z >= row.low.z

func lower_time (low: Vec3) -> (high: Vec3) -> (a: Vec3) -> (b: Vec3) -> (radius: F32) -> (delta: Vec3) -> (bounds: &[F32]) -> (offset: U32) =>
  if not (low.x <= bounds[offset + 3] and high.x >= bounds[offset] and low.y <= bounds[offset + 4] and high.y >= bounds[offset + 1] and low.z <= bounds[offset + 5] and high.z >= bounds[offset + 2]):
    return 1.0 / 0.0
  let lower = 0.0
  let lx = min a.x b.x - radius
  let ly = min a.y b.y - radius
  let lz = min a.z b.z - radius
  let hx = max a.x b.x + radius
  let hy = max a.y b.y + radius
  let hz = max a.z b.z + radius
  let blx = bounds[offset]
  let bly = bounds[offset + 1]
  let blz = bounds[offset + 2]
  let bhx = bounds[offset + 3]
  let bhy = bounds[offset + 4]
  let bhz = bounds[offset + 5]
  if delta.x > 0.0:
    let safety = hit_eps + 0.00001 * (abs lx + abs hx + abs blx + abs bhx + delta.x)
    lower := max self ((blx - hx - safety) / delta.x)
  else:
    if delta.x < 0.0:
      let safety = hit_eps + 0.00001 * (abs lx + abs hx + abs blx + abs bhx - delta.x)
      lower := max self ((bhx - lx + safety) / delta.x)
  if delta.y > 0.0:
    let safety = hit_eps + 0.00001 * (abs ly + abs hy + abs bly + abs bhy + delta.y)
    lower := max self ((bly - hy - safety) / delta.y)
  else:
    if delta.y < 0.0:
      let safety = hit_eps + 0.00001 * (abs ly + abs hy + abs bly + abs bhy - delta.y)
      lower := max self ((bhy - ly + safety) / delta.y)
  if delta.z > 0.0:
    let safety = hit_eps + 0.00001 * (abs lz + abs hz + abs blz + abs bhz + delta.z)
    lower := max self ((blz - hz - safety) / delta.z)
  else:
    if delta.z < 0.0:
      let safety = hit_eps + 0.00001 * (abs lz + abs hz + abs blz + abs bhz - delta.z)
      lower := max self ((bhz - lz + safety) / delta.z)
  return lower
func cast scene => func (a: Vec3) => func (b: Vec3) => func (radius: F32) => func (delta: Vec3) => func (filter: Filter) =>
  let (low, high) = swept_bounds a b radius delta
  let proxies = scene.proxies
  if proxies.length <= 4:
    let best_time = 2.0
    let best_index: U32 = 0
    let best_hit: Maybe (F32, Vec3, Vec3, Vec3, F32) = $Nothing
    for index in 0 .. proxies.length:
      let row = proxies[index]
      if accepts_row filter row and touches_bounds_row row low high:
        if let $Some found = cast_shape (shapes.unpack scene.geometry row.shape) a b radius delta:
          let (t, _, _, _, _) = found
          if t <= 2.0 and t < best_time:
            best_time := t
            best_index := index
            best_hit := $Some found
    if let $Some (t, point, normal, surface, depth) = best_hit:
      let row = proxies[best_index]
      return $Some ($Hit {id: row.id, proxy: best_index, time: t, distance: t * delta.length, point, normal, surface, depth})
    return $Nothing
  let low_x = low.x
  let low_y = low.y
  let low_z = low.z
  let high_x = high.x
  let high_y = high.y
  let high_z = high.z
  let lx = min a.x b.x - radius
  let ly = min a.y b.y - radius
  let lz = min a.z b.z - radius
  let hx = max a.x b.x + radius
  let hy = max a.y b.y + radius
  let hz = max a.z b.z + radius
  let dx = delta.x
  let dy = delta.y
  let dz = delta.z
  let inv_dx = if dx != 0.0 then 1.0 / dx else 0.0
  let inv_dy = if dy != 0.0 then 1.0 / dy else 0.0
  let inv_dz = if dz != 0.0 then 1.0 / dz else 0.0
  let use_inv_x = is_finite inv_dx
  let use_inv_y = is_finite inv_dy
  let use_inv_z = is_finite inv_dz
  let base_sx = abs lx + abs hx + abs dx
  let base_sy = abs ly + abs hy + abs dy
  let base_sz = abs lz + abs hz + abs dz
  let lower_fast = func (bounds: &[F32]) -> (offset: U32) : F32 =>
    let blx = bounds[offset]
    let bhx = bounds[offset + 3]
    if low_x > bhx or high_x < blx:
      return 1.0 / 0.0
    let bly = bounds[offset + 1]
    let bhy = bounds[offset + 4]
    if low_y > bhy or high_y < bly:
      return 1.0 / 0.0
    let blz = bounds[offset + 2]
    let bhz = bounds[offset + 5]
    if low_z > bhz or high_z < blz:
      return 1.0 / 0.0
    let lower = 0.0
    if dx > 0.0:
      let safety = hit_eps + 0.00001 * (base_sx + abs blx + abs bhx)
      let num = blx - hx - safety
      lower := max self (if use_inv_x then num * inv_dx else num / dx)
    else:
      if dx < 0.0:
        let safety = hit_eps + 0.00001 * (base_sx + abs blx + abs bhx)
        let num = bhx - lx + safety
        lower := max self (if use_inv_x then num * inv_dx else num / dx)
    if dy > 0.0:
      let safety = hit_eps + 0.00001 * (base_sy + abs bly + abs bhy)
      let num = bly - hy - safety
      lower := max self (if use_inv_y then num * inv_dy else num / dy)
    else:
      if dy < 0.0:
        let safety = hit_eps + 0.00001 * (base_sy + abs bly + abs bhy)
        let num = bhy - ly + safety
        lower := max self (if use_inv_y then num * inv_dy else num / dy)
    if dz > 0.0:
      let safety = hit_eps + 0.00001 * (base_sz + abs blz + abs bhz)
      let num = blz - hz - safety
      lower := max self (if use_inv_z then num * inv_dz else num / dz)
    else:
      if dz < 0.0:
        let safety = hit_eps + 0.00001 * (base_sz + abs blz + abs bhz)
        let num = bhz - lz + safety
        lower := max self (if use_inv_z then num * inv_dz else num / dz)
    return lower
  let found = spatial.closest scene.index lower_fast (func (index: U32) =>
    let row = proxies[index]
    if accepts_row filter row and touches_bounds_row row low high:
      return cast_shape (shapes.unpack scene.geometry row.shape) a b radius delta
    return $Nothing) (func (value: (F32, Vec3, Vec3, Vec3, F32)) =>
      let (time, _, _, _, _) = value
      return time) 2.0
  return Maybe.map (func found =>
    let row = proxies[found.index]
    let (t, point, normal, surface, depth) = found.value
    return $Hit {id: row.id, proxy: found.index, time: t, distance: t * delta.length, point, normal, surface, depth}) found

func solid_filter (mask: U32) => $Filter { mask, skip: 0, triggers: false, walkers: true, dynamics: true }

// A ray: the nearest hit within `reach` along `direction`, never entity `skip`.
func ray scene => func (origin: Vec3) => func (direction: Vec3) => func (reach: F32) => func (mask: U32) => func (skip: U32) =>
  // Vec3.normalized, then scaled by the reach.
  let length = sqrt (direction.x * direction.x + direction.y * direction.y + direction.z * direction.z)
  let delta = if length == 0.0 then $Vec3 { x: direction.x * reach, y: direction.y * reach, z: direction.z * reach } else $Vec3 { x: direction.x / length * reach, y: direction.y / length * reach, z: direction.z / length * reach }
  return cast scene origin origin 0.0 delta ($Filter { mask, skip, triggers: false, walkers: true, dynamics: true })

// Analytic ray-vs-convex-polytope boolean hit test (skipping surface/normal work).
private func ray_hull_any (poly: shapes.Poly) -> (origin: Vec3) -> (delta: Vec3) : Bool =>
  let planes = poly.planes
  let count = planes.length
  if count == 0 or not (math.finite3 origin and math.finite3 delta):
    return false
  let enter = 0.0
  let leave = 1.0
  let enter_face = count
  let inside = true
  for f in 0 .. count:
    let pl = planes[f]
    let side = pl.x * origin.x + pl.y * origin.y + pl.z * origin.z - pl.w
    let slope = pl.x * delta.x + pl.y * delta.y + pl.z * delta.z
    if not (is_finite side and is_finite slope):
      return false
    if side > 0.0:
      inside := false
    if abs slope < 0.0000001:
      if side > 0.0:
        return false
    else:
      let hit_t = F32.neg side / slope
      if not (is_finite hit_t):
        return false
      if slope < 0.0:
        if hit_t > enter:
          enter := hit_t
          enter_face := f
      else:
        if hit_t < leave:
          leave := hit_t
      if not (enter <= leave):
        return false
  return inside or (enter_face < count and enter >= 0.0 and enter <= 1.0 and enter <= leave)

// Analytic ray-vs-sphere boolean hit test (skipping hit point/normal sqrt).
func ray_sphere_any (center: Vec3) -> (rad: F32) -> (origin: Vec3) -> (delta: Vec3) : Bool =>
  if not (math.finite3 origin and math.finite3 delta and is_finite rad) or rad < 0.0:
    return false
  let ox = origin.x - center.x
  let oy = origin.y - center.y
  let oz = origin.z - center.z
  let dist2 = ox * ox + oy * oy + oz * oz
  let r2 = rad * rad
  if dist2 <= r2:
    return true
  let a_val = delta.x * delta.x + delta.y * delta.y + delta.z * delta.z
  let b_val = ox * delta.x + oy * delta.y + oz * delta.z
  if b_val >= 0.0 or a_val <= 0.0 or not (is_finite a_val and is_finite b_val):
    return false
  let disc = b_val * b_val - a_val * (dist2 - r2)
  if not (is_finite disc) or disc < 0.0:
    return false
  let t = (F32.neg b_val - sqrt disc) / a_val
  return is_finite t and t >= 0.0 and t <= 1.0

func ray_hits_stored geometry -> (stored: shapes.StoredShape) -> (origin: Vec3) -> (delta: Vec3) : Bool => case stored of
  $shapes.StoredHull idx => ray_hull_any (shapes.unpack_poly geometry geometry.hulls[idx]) origin delta
  $shapes.StoredCapsule { a: ca, b: cb, radius: cr } =>
    if ca.x == cb.x and ca.y == cb.y and ca.z == cb.z then ray_sphere_any ca cr origin delta else Maybe.is_some (cast_shape ($shapes.Capsule { a: ca, b: cb, radius: cr }) origin origin 0.0 delta)
  _ => Maybe.is_some (cast_shape (shapes.unpack geometry stored) origin origin 0.0 delta)

// Whether any solid proxy blocks the ray within `reach` (early-exits on first hit).
func ray_any scene => func (origin: Vec3) => func (direction: Vec3) => func (reach: F32) => func (mask: U32) => func (skip: U32) : Bool =>
  let length = sqrt (direction.x * direction.x + direction.y * direction.y + direction.z * direction.z)
  let delta = if length == 0.0 then $Vec3 { x: direction.x * reach, y: direction.y * reach, z: direction.z * reach } else $Vec3 { x: direction.x / length * reach, y: direction.y / length * reach, z: direction.z / length * reach }
  let (low, high) = swept_bounds origin origin 0.0 delta
  let filter = $Filter { mask, skip, triggers: false, walkers: true, dynamics: true }
  let proxies = scene.proxies
  if proxies.length <= 4:
    for index in 0 .. proxies.length:
      let row = proxies[index]
      if accepts_row filter row and touches_bounds_row row low high:
        if ray_hits_stored scene.geometry row.shape origin delta:
          return true
    return false
  return spatial.any scene.index low high (func (index: U32) =>
    let row = proxies[index]
    if accepts_row filter row and touches_bounds_row row low high:
      return ray_hits_stored scene.geometry row.shape origin delta
    return false)

// Every proxy overlapping a sphere, by ascending source index.
func overlap_sphere scene => func (center: Vec3) => func (radius: F32) => func (mask: U32) =>
  let low = $Vec3 { x: center.x - radius, y: center.y - radius, z: center.z - radius }
  let high = $Vec3 { x: center.x + radius, y: center.y + radius, z: center.z + radius }
  let found: #[U32] = #[]
  for index in spatial.query scene.index low high:
    let row = scene.proxies[index]
    if (row.layer & mask) != 0 and touches_bounds_row row low high:
      let gap = shapes.segment_gap (shapes.unpack scene.geometry row.shape) center center
      if gap.dist <= radius:
        @storage.push found row.id
  return found

// Every proxy overlapping a capsule.
func overlap_capsule scene => func (a: Vec3) => func (b: Vec3) => func (radius: F32) => func (mask: U32) =>
  let (low, high) = swept_bounds a b radius shapes.zero
  let found: #[U32] = #[]
  for index in spatial.query scene.index low high:
    let row = scene.proxies[index]
    if (row.layer & mask) != 0 and touches_bounds_row row low high:
      let gap = shapes.segment_gap (shapes.unpack scene.geometry row.shape) a b
      if gap.dist <= radius:
        @storage.push found row.id
  return found

// Is the point inside any solid (non-trigger) proxy?
func point_solid scene => func (p: Vec3) => func (mask: U32) => return
  spatial.any scene.index p p (func index =>
    let row = scene.proxies[index]
    if (row.layer & mask) != 0 and not row.trigger and touches_bounds_row row p p:
      return (shapes.segment_gap (shapes.unpack scene.geometry row.shape) p p).dist <= 0.0
    return false)

// Share the caller's invalidation batch with other derived views. Sources remain authoritative.
func update_changes (sources: #[Source]) -> (previous: own Scene) -> change : Scene =>
  if change.reset:
    return build_into previous sources
  return update sources previous (changes.affected change)

// The simulation has a moving and an optional static scene. Keep their access
// bundles explicit; no collection owns other independently growing scenes.
type Queries is data = $Queries { primary: Read, secondary: Read, paired: Bool }
func single (sc: Read): Queries => $Queries { primary: sc, secondary: sc, paired: false }
func queries (sc: Scene): Queries => single (read sc)
func together (a: Queries) -> (b: Queries): Queries =>
  if a.paired or b.paired:
    return panic "query composition supports one moving and one static scene"
  return $Queries { primary: a.primary, secondary: b.primary, paired: true }
func query_parts (queries: Queries): U32 => if queries.paired then 2 else 1
func query_part (queries: Queries) -> (index: U32): Read =>
  if index == 0:
    return queries.primary
  if index == 1 and queries.paired:
    return queries.secondary
  return panic "scene query part outside composition"
func query_cast (queries: Queries) => func a => func b => func radius => func delta => func filter =>
  let best: Maybe Hit = $Nothing
  let best_time = 2.0
  let offset = 0
  for part_index in 0 .. query_parts queries:
    let part = query_part queries part_index
    if let $Some hit = cast part a b radius delta filter:
      if hit.time < best_time:
        best_time := hit.time
        best := $Some ($Hit { id: hit.id, proxy: offset + hit.proxy, time: hit.time, distance: hit.distance,
          point: hit.point, normal: hit.normal, surface: hit.surface, depth: hit.depth })
    offset := self + count part
  return best
func query_overlap_sphere (queries: Queries) -> center -> radius -> mask =>
  let found: #[U32] = #[]
  for part_index in 0 .. query_parts queries:
    for id in overlap_sphere (query_part queries part_index) center radius mask:
      @storage.push found id
  return found
func query_overlap_capsule (queries: Queries) -> a -> b -> radius -> mask =>
  let found: #[U32] = #[]
  for part_index in 0 .. query_parts queries:
    for id in overlap_capsule (query_part queries part_index) a b radius mask:
      @storage.push found id
  return found
func query_point_solid (queries: Queries) => func point => func mask =>
  for part_index in 0 .. query_parts queries:
    let part = query_part queries part_index
    if point_solid part point mask:
      return true
  return false
func query_ray (queries: Queries) => func origin => func direction => func reach => func mask => func skip =>
  let best: Maybe Hit = $Nothing
  let best_time = 2.0
  let offset = 0
  for part_index in 0 .. query_parts queries:
    let part = query_part queries part_index
    if let $Some hit = ray part origin direction reach mask skip:
      if hit.time < best_time:
        best_time := hit.time
        best := $Some ($Hit { id: hit.id, proxy: offset + hit.proxy, time: hit.time, distance: hit.distance,
          point: hit.point, normal: hit.normal, surface: hit.surface, depth: hit.depth })
    offset := self + count part
  return best


// Build and restore replace the scene rows. Earlier geometry/query borrows end
// before this boundary.
func access (geometry: own shapes.Geometry) -> (proxies: own #[ProxyRow]) -> (bounds: own #[F32]) -> (order: own #[U32]) -> (leaves: own #[U32]) -> (slots: own #[U32]) : Scene => return
  $Scene { geometry, proxies, index: spatial.access 0 bounds order leaves, slots, source_count: 0 }
func empty () : Scene =>
  let proxies: #[ProxyRow] = #[]
  let bounds: #[F32] = #[]
  let order: #[U32] = #[]
  let leaves: #[U32] = #[]
  let slots: #[U32] = #[]
  return access (shapes.empty ()) proxies bounds order leaves slots
// Primitive-only builds carry just the written columns across the loop.
private func build_box_columns (points: own #[shapes.Point3]) -> (planes: own #[shapes.Plane4]) -> (hulls: own #[shapes.StoredPoly]) -> (index: U32) -> (kind: U32) -> (is_walker: Bool) -> source -> collider : (Maybe ProxyRow, #[shapes.Point3], #[shapes.Plane4], #[shapes.StoredPoly]) =>
  let scale = if is_walker then math.one3 else source.scale
  let rotation = if is_walker then math.identity_quat else source.rotation
  let offset = if kind == kind_dynamic then math.zero3 else collider.offset
  if not (math.finite3 source.position and math.finite3 scale and math.finite_quat rotation and math.finite3 offset):
    return ($Nothing, points, planes, hulls)
  let cx = source.position.x
  let cy = source.position.y
  let cz = source.position.z
  if offset.x != 0.0 or offset.y != 0.0 or offset.z != 0.0:
    let (ox, oy, oz) = math.rotate_parts rotation.x rotation.y rotation.z rotation.w (offset.x * scale.x) (offset.y * scale.y) (offset.z * scale.z)
    cx := self + ox
    cy := self + oy
    cz := self + oz
  if not (is_finite cx and is_finite cy and is_finite cz and math.finite3 collider.size):
    return ($Nothing, points, planes, hulls)
  let hx = abs collider.size.x * abs scale.x * 0.5
  let hy = abs collider.size.y * abs scale.y * 0.5
  let hz = abs collider.size.z * abs scale.z * 0.5
  let half = $Vec3 { x: hx, y: hy, z: hz }
  let inertia = shapes.box_inertia half
  let inscribed = min hx (min hy hz)
  let span = hx + hy + hz
  if not (math.finite3 half and math.finite3 inertia and is_finite inscribed and is_finite span and is_finite (abs cx + span) and is_finite (abs cy + span) and is_finite (abs cz + span)):
    return ($Nothing, points, planes, hulls)
  let (poly, points, planes) = shapes.box_columns points planes ($Vec3 { x: cx, y: cy, z: cz }) rotation half
  let low_x = points[poly.verts.start].x
  let low_y = points[poly.verts.start].y
  let low_z = points[poly.verts.start].z
  let high_x = low_x
  let high_y = low_y
  let high_z = low_z
  if rotation.x == 0.0 and rotation.y == 0.0 and rotation.z == 0.0:
    let last = points[poly.verts.start + 7]
    if hx > 0.0 and hy > 0.0 and hz > 0.0:
      high_x := last.x
      high_y := last.y
      high_z := last.z
    else:
      let left = points[poly.verts.start + 6]
      let bottom = points[poly.verts.start + 5]
      let front = points[poly.verts.start + 3]
      low_x := min left.x last.x
      low_y := min bottom.y last.y
      low_z := min front.z last.z
      high_x := max left.x last.x
      high_y := max bottom.y last.y
      high_z := max front.z last.z
  else:
    for i in 1 .. 8:
      let point = points[poly.verts.start + i]
      low_x := min self point.x
      low_y := min self point.y
      low_z := min self point.z
      high_x := max self point.x
      high_y := max self point.y
      high_z := max self point.z
  let low = $Vec3 { x: low_x, y: low_y, z: low_z }
  let high = $Vec3 { x: high_x, y: high_y, z: high_z }
  if not (math.finite3 low and math.finite3 high and is_finite collider.friction and is_finite collider.restitution):
    return ($Nothing, points, planes, hulls)
  let hull_idx = hulls.length
  @storage.push hulls poly
  return ($Some ($ProxyRow { source: index, id: source.id, kind, walker: is_walker,
    shape: $shapes.StoredHull hull_idx, inertia, inscribed, low, high, layer: collider.layer,
    mask: collider.mask, friction: collider.friction, restitution: collider.restitution, trigger: collider.trigger }), points, planes, hulls)

// Capsules have no payload spans, so they do not make the surrounding
// box build carry geometry through its loop.
private func primitive_capsule_row (i: U32) -> (source: Source) : Maybe ProxyRow =>
  let (row, _) = proxy_of (shapes.empty ()) i source
  return row

// 0 is a sphere, 1 is a box or capsule, and 2 needs the general builder.
private func source_class (source: Source) : U32 =>
  if let $Some col = source.collider:
    return case col.shape of
      $Sphere => 0
      $Box => 1
      $Capsule => 1
      _ => 2
  return 2

private func finish_slots (slots: own #[U32]) -> (count: U32) : #[U32] =>
  if count < slots.length:
    for i in 0 .. slots.length:
      if slots[i] == 0xFFFFFFFF:
        slots[i] := count
  return slots

private func proxy_extents (stored: #[ProxyRow]) : #[F32] =>
  let n = stored.length
  let extents = @array.fill (n * 6) 0.0
  for i in 0 .. n:
    let row = stored[i]
    let o = i * 6
    extents[o] := row.low.x
    extents[o + 1] := row.low.y
    extents[o + 2] := row.low.z
    extents[o + 3] := row.high.x
    extents[o + 4] := row.high.y
    extents[o + 5] := row.high.z
  return extents

private func build_sphere_rows_direct (rows: own #[ProxyRow]) -> (slots: own #[U32]) -> (sources: #[Source]) : (#[ProxyRow], #[U32], #[F32]) =>
  let n = sources.length
  @storage.reserve rows n
  @storage.reserve slots n
  let extents: #[F32] = @storage.with_capacity (n * 6)
  for i in 0 .. n:
    let src = sources[i]
    let slot = 0xFFFFFFFF
    if let $Some collider = src.collider:
      let unit_scale = src.scale.x == 1.0 and src.scale.y == 1.0 and src.scale.z == 1.0
      let unit_rotation = src.rotation.x == 0.0 and src.rotation.y == 0.0 and src.rotation.z == 0.0 and src.rotation.w == 1.0
      let centered = collider.offset.x == 0.0 and collider.offset.y == 0.0 and collider.offset.z == 0.0
      if unit_scale and unit_rotation and centered and not (Maybe.is_some src.rigid or Maybe.is_some src.walker):
        let cx = src.position.x
        let cy = src.position.y
        let cz = src.position.z
        let radius = max 0.0 collider.radius
        let inertia = shapes.sphere_inertia radius
        let material_ok = is_finite collider.radius and is_finite collider.friction and is_finite collider.restitution
        let bounds_ok = is_finite (abs cx + radius) and is_finite (abs cy + radius) and is_finite (abs cz + radius)
        if material_ok and bounds_ok and is_finite inertia:
          slot := rows.length
          @storage.push rows (sphere_row i src.id kind_static false collider cx cy cz radius inertia)
          @storage.push extents (cx - radius)
          @storage.push extents (cy - radius)
          @storage.push extents (cz - radius)
          @storage.push extents (cx + radius)
          @storage.push extents (cy + radius)
          @storage.push extents (cz + radius)
      else:
        if let $Some row = sphere_proxy_row i (body_kind src.rigid src.walker) (Maybe.is_some src.walker) src collider:
          slot := rows.length
          @storage.push rows row
          @storage.push extents row.low.x
          @storage.push extents row.low.y
          @storage.push extents row.low.z
          @storage.push extents row.high.x
          @storage.push extents row.high.y
          @storage.push extents row.high.z
    @storage.push slots slot
  slots := finish_slots self rows.length
  return (rows, slots, extents)

private func build_primitive_rows_direct (points: own #[shapes.Point3]) -> (planes: own #[shapes.Plane4]) -> (hulls: own #[shapes.StoredPoly]) -> (rows: own #[ProxyRow]) -> (slots: own #[U32]) -> (sources: #[Source]) : (#[ProxyRow], #[U32], #[F32], #[shapes.Point3], #[shapes.Plane4], #[shapes.StoredPoly]) =>
  let n = sources.length
  @storage.reserve rows n
  @storage.reserve slots n
  let extents: #[F32] = @storage.with_capacity (n * 6)
  for i in 0 .. n:
    let src = sources[i]
    let row = $Nothing
    if let $Some col = src.collider:
      if let $Box = col.shape:
        let (value, next_points, next_planes, next_hulls) = build_box_columns points planes hulls i (body_kind src.rigid src.walker) (Maybe.is_some src.walker) src col
        points := next_points
        planes := next_planes
        hulls := next_hulls
        row := value
      else:
        if let $Sphere = col.shape:
          row := sphere_proxy_row i (body_kind src.rigid src.walker) (Maybe.is_some src.walker) src col
        else:
          row := primitive_capsule_row i src
    let slot = 0xFFFFFFFF
    if let $Some value = row:
      slot := rows.length
      @storage.push rows value
      @storage.push extents value.low.x
      @storage.push extents value.low.y
      @storage.push extents value.low.z
      @storage.push extents value.high.x
      @storage.push extents value.high.y
      @storage.push extents value.high.z
    @storage.push slots slot
  slots := finish_slots self rows.length
  return (rows, slots, extents, points, planes, hulls)

private func build_rows_direct (geometry: own shapes.Geometry) -> (rows: own #[ProxyRow]) -> (slots: own #[U32]) -> (sources: #[Source]) : (#[ProxyRow], #[U32], shapes.Geometry) =>
  @storage.truncate rows 0
  @storage.truncate slots 0
  let n = sources.length
  let all_spheres = true
  let primitives = true
  for i in 0 .. n:
    let kind = source_class sources[i]
    if kind != 0:
      all_spheres := false
      if kind == 2:
        primitives := false
        break
  if all_spheres:
    let (rows, slots, _) = build_sphere_rows_direct rows slots sources
    return (rows, slots, geometry)
  if primitives:
    let $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes } = geometry
    let (rows, slots, _, points, planes, hulls) = build_primitive_rows_direct points planes hulls rows slots sources
    return (rows, slots, $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes })
  @storage.reserve rows n
  @storage.reserve slots n
  for i in 0 .. n:
    let (maybe_row, next_geom) = proxy_of geometry i sources[i]
    geometry := next_geom
    let slot = 0xFFFFFFFF
    if let $Some row = maybe_row:
      slot := rows.length
      @storage.push rows row
    @storage.push slots slot
  slots := finish_slots self rows.length
  return (rows, slots, geometry)

func build_rows_into (geometry: own shapes.Geometry) -> (rows: own #[ProxyRow]) -> (slots: own #[U32]) -> (sources: #[Source]) : (#[ProxyRow], #[U32], shapes.Geometry) =>
  return build_rows_direct geometry rows slots sources

func build_into (destination: own Scene) -> (sources: #[Source]) : Scene =>
  let $Scene { geometry, proxies, index, slots, source_count: _ } = destination
  let n = sources.length
  @storage.truncate proxies 0
  @storage.truncate slots 0
  let all_spheres = true
  let primitives = true
  let box_count: U32 = 0
  for i in 0 .. n:
    let kind = source_class sources[i]
    if kind != 0:
      all_spheres := false
      if kind == 2:
        primitives := false
        break
      if let $Some col = sources[i].collider:
        if let $Box = col.shape:
          box_count := self + 1
  if all_spheres:
    let (stored, slots, extents) = build_sphere_rows_direct proxies slots sources
    let index = spatial.build_flat index extents
    return $Scene { geometry, proxies: stored, index, slots, source_count: n }
  if primitives:
    let $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes } = geometry
    if box_count > 0:
      @storage.reserve points (box_count * 17)
      @storage.reserve planes (box_count * 6)
      @storage.reserve hulls box_count
    let (stored, slots, extents, points, planes, hulls) = build_primitive_rows_direct points planes hulls proxies slots sources
    let index = spatial.build_flat index extents
    return $Scene { geometry: $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes }, proxies: stored, index, slots, source_count: n }
  @storage.reserve proxies n
  @storage.reserve slots n
  for i in 0 .. n:
    let (maybe_row, next_geom) = proxy_of geometry i sources[i]
    geometry := next_geom
    let slot = 0xFFFFFFFF
    if let $Some row = maybe_row:
      slot := proxies.length
      @storage.push proxies row
    @storage.push slots slot
  slots := finish_slots self proxies.length
  let extents = proxy_extents proxies
  let index = spatial.build_flat index extents
  return $Scene { geometry, proxies, index, slots, source_count: n }

// The complete consumer ends before any temporary geometry/tree owner closes.
func with_built (sources: #[Source]) -> consume => return
  consume (own (build_into (empty ()) sources))

func copied_rows (geometry: own shapes.Geometry) -> (source: Scene) : (#[ProxyRow], shapes.Geometry) =>
  let rows: #[ProxyRow] = @storage.with_capacity (count source)
  for i in 0 .. count source:
    let value = proxy source i
    let (packed, next_geom) = pack_proxy geometry value
    geometry := next_geom
    @storage.push rows packed
  return (rows, geometry)
func copy_into (destination: own Scene) -> (source: Scene) : Scene =>
  let (rows, geometry) = copied_rows destination.geometry source
  destination.geometry := geometry
  destination.proxies := spatial.replace_fixed self rows
  destination.slots := spatial.replace self source.slots
  destination.index := spatial.copy_into self source.index
  destination.source_count := source.source_count
  return destination


// Authored source persistence uses the same flat schema boundary as proxies.
// Optional dynamic/walker payloads live in side pools so static rows stay slim.
const no_body: U32 = 0xFFFFFFFF
type Bodies is data = $Bodies { rigids: #[Rigid], walkers: #[Walker] }
type BodiesRead is data = $BodiesRead { rigids: &[Rigid], walkers: &[Walker] }
func empty_bodies () : Bodies =>
  let rigids: #[Rigid] = #[]
  let walkers: #[Walker] = #[]
  return $Bodies { rigids, walkers }
func clear_bodies (bodies: own Bodies) : Bodies =>
  @storage.truncate bodies.rigids 0
  @storage.truncate bodies.walkers 0
  return bodies
func read_bodies (bodies: Bodies) : BodiesRead =>
  return $BodiesRead {
    rigids: bodies.rigids.view 0 bodies.rigids.length,
    walkers: bodies.walkers.view 0 bodies.walkers.length,
  }
type StoredKind is data = $StoredBox | $StoredSphere | $StoredCapsule | $StoredBrush | $StoredHeightfield U32 | $StoredLevel U32
type ColliderRow is data = $ColliderRow {
  shape: StoredKind,
  size: Vec3,
  radius: F32,
  height: F32,
  offset: Vec3,
  friction: F32,
  restitution: F32,
  layer: U32,
  mask: U32,
  trigger: Bool,
}
type SourceRow is data = $SourceRow {
  collider: Maybe ColliderRow, planes: shapes.Span,
  index: U32,
  id: U32,
  position: Vec3,
  rotation: Quat,
  scale: Vec3,
  rigid: U32,
  walker: U32,
}
func row_rigid bodies -> (row: SourceRow) : Maybe Rigid =>
  if row.rigid != no_body then $Some (bodies.rigids.at row.rigid) else $Nothing
func row_walker bodies -> (row: SourceRow) : Maybe Walker =>
  if row.walker != no_body then $Some (bodies.walkers.at row.walker) else $Nothing
private func row_body_kind (rigids: &[Rigid]) -> (row: SourceRow) : U32 =>
  if row.rigid != no_body:
    return case rigids[row.rigid].kind of
      $Dynamic => kind_dynamic
      $Kinematic => kind_kinematic
      $Static => kind_static
  return if row.walker != no_body then kind_kinematic else kind_static
func pack_collider_row (shape: StoredKind) -> (value: Collider) : ColliderRow => $ColliderRow {
  shape,
  size: value.size,
  radius: value.radius,
  height: value.height,
  offset: value.offset,
  friction: value.friction,
  restitution: value.restitution,
  layer: value.layer,
  mask: value.mask,
  trigger: value.trigger,
}
func pack_collider (geometry: own shapes.Geometry) -> (value: Collider) : (ColliderRow, shapes.Geometry) =>
  if let $Box = value.shape:
    return (pack_collider_row $StoredBox value, geometry)
  if let $Sphere = value.shape:
    return (pack_collider_row $StoredSphere value, geometry)
  if let $Capsule = value.shape:
    return (pack_collider_row $StoredCapsule value, geometry)
  if let $Brush = value.shape:
    return (pack_collider_row $StoredBrush value, geometry)
  if let $Heightfield ground = value.shape:
    let (stored, next_geom) = pack_heightfield geometry ground
    let $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes } = next_geom
    let idx = heightfields.length
    @storage.push heightfields stored
    return (pack_collider_row ($StoredHeightfield idx) value, $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes })
  let $Mesh m = value.shape else:
    return (pack_collider_row $StoredBox value, geometry)
  let (stored, next_geom) = shapes.pack_mesh geometry m
  let $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes } = next_geom
  let idx = meshes.length
  @storage.push meshes stored
  return (pack_collider_row ($StoredLevel idx) value, $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes })
func unpack_collider geometry -> (value: ColliderRow) =>
  let shape = case value.shape of
    $StoredBox => $Box
    $StoredSphere => $Sphere
    $StoredCapsule => $Capsule
    $StoredBrush => $Brush
    $StoredHeightfield idx => $Heightfield (terrain.unpack geometry.heights geometry.heightfields[idx])
    $StoredLevel idx => $Mesh (shapes.unpack_mesh geometry geometry.meshes[idx])
  return $Collider { shape,
    size: value.size,
    radius: value.radius,
    height: value.height,
    offset: value.offset,
    friction: value.friction,
    restitution: value.restitution,
    layer: value.layer,
    mask: value.mask,
    trigger: value.trigger,
  }
func pack_source_planes (geometry: own shapes.Geometry) -> (values: &[math.Vec4]) : (shapes.Span, shapes.Geometry) =>
  let $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes } = geometry
  let (span, source_planes) = shapes.pack_span source_planes values
  return (span, $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes })
func pack_source (geometry: own shapes.Geometry) -> (bodies: own Bodies) -> (value: Source) : (SourceRow, shapes.Geometry, Bodies) =>
  let collider: Maybe ColliderRow = $Nothing
  if let $Some c = value.collider:
    let (packed, next_geom) = pack_collider geometry c
    collider := $Some packed
    geometry := next_geom
  let (planes, geometry) = pack_source_planes geometry value.planes
  let $Bodies { rigids, walkers } = bodies
  let rigid_idx = no_body
  if let $Some body = value.rigid:
    rigid_idx := rigids.length
    @storage.push rigids body
  let walker_idx = no_body
  if let $Some w = value.walker:
    walker_idx := walkers.length
    @storage.push walkers w
  return (packed_source value collider planes rigid_idx walker_idx, geometry, $Bodies { rigids, walkers })

private func packed_source (value: Source) -> (collider: Maybe ColliderRow) -> (planes: shapes.Span) -> (rigid: U32) -> (walker: U32) : SourceRow =>
  $SourceRow {
    collider,
    planes,
    index: value.index,
    id: value.id,
    position: value.position,
    rotation: value.rotation,
    scale: value.scale,
    rigid,
    walker,
  }
func unpack_source geometry -> bodies -> (value: SourceRow) => $Source {
  collider: Maybe.map (unpack_collider geometry) value.collider,
  planes: shapes.span_view geometry.source_planes value.planes,
  index: value.index,
  id: value.id,
  position: value.position,
  rotation: value.rotation,
  scale: value.scale,
  rigid: row_rigid bodies value,
  walker: row_walker bodies value,
}
// Primitive descriptors have no nested payload. Keep the Geometry owner
// outside their packing loop so its temporary records can be reclaimed.
func pack_sources_into (geometry: own shapes.Geometry) -> (bodies: own Bodies) -> (rows: own #[SourceRow]) -> (values: #[Source]) : (#[SourceRow], shapes.Geometry, Bodies) =>
  @storage.truncate rows 0
  @storage.reserve rows values.length
  let ordinary = true
  for value in values:
    if value.planes.length != 0 or (Maybe.is_some value.collider and source_class value == 2):
      ordinary := false
      break
  if ordinary:
    let planes: shapes.Span = { start: geometry.source_planes.length, count: 0 }
    let $Bodies { rigids, walkers } = bodies
    for value in values:
      let collider: Maybe ColliderRow = case value.collider of
        $Some col => do:
          let tag = case col.shape of
            $Sphere => $StoredSphere
            $Capsule => $StoredCapsule
            _ => $StoredBox
          break $Some (pack_collider_row tag col)
        $Nothing => $Nothing
      let rigid_idx = no_body
      if let $Some body = value.rigid:
        rigid_idx := rigids.length
        @storage.push rigids body
      let walker_idx = no_body
      if let $Some w = value.walker:
        walker_idx := walkers.length
        @storage.push walkers w
      @storage.push rows (packed_source value collider planes rigid_idx walker_idx)
    return (rows, geometry, $Bodies { rigids, walkers })
  for value in values:
    let (row, next_geom, next_bodies) = pack_source geometry bodies value
    geometry := next_geom
    bodies := next_bodies
    @storage.push rows row
  return (rows, geometry, bodies)

func source_rows (geometry: own shapes.Geometry) -> (bodies: own Bodies) -> (values: #[Source]) : (#[SourceRow], shapes.Geometry, Bodies) =>
  let rows: #[SourceRow] = #[]
  return pack_sources_into geometry bodies rows values
func source_values geometry -> bodies -> (values: &[SourceRow]) => return
  array.generate values.length (func i => unpack_source geometry bodies values[i])


// Rebuilt physics already owns stored source rows. Read their payload views
// only while constructing each proxy.
private func stored_source_class (source: SourceRow) : U32 =>
  if let $Some col = source.collider:
    return case col.shape of
      $StoredSphere => 0
      $StoredBox => 1
      $StoredCapsule => 1
      _ => 2
  return 2

private func unpack_primitive_source (bodies: BodiesRead) -> (value: SourceRow) : Source =>
  let collider: Maybe Collider = case value.collider of
    $Some col => do:
      let shape = case col.shape of
        $StoredSphere => $Sphere
        $StoredCapsule => $Capsule
        _ => $Box
      break $Some ($Collider {
        shape,
        size: col.size,
        radius: col.radius,
        height: col.height,
        offset: col.offset,
        friction: col.friction,
        restitution: col.restitution,
        layer: col.layer,
        mask: col.mask,
        trigger: col.trigger,
      })
    $Nothing => $Nothing
  return $Source {
    collider,
    planes: &empty_planes[0..0],
    index: value.index,
    id: value.id,
    position: value.position,
    rotation: value.rotation,
    scale: value.scale,
    rigid: row_rigid bodies value,
    walker: row_walker bodies value,
  }

private func build_sphere_source_rows (rows: own #[ProxyRow]) -> (slots: own #[U32]) -> (bodies: BodiesRead) -> (sources: &[SourceRow]) : (#[ProxyRow], #[U32], #[F32]) =>
  let n = sources.length
  @storage.reserve rows n
  @storage.reserve slots n
  let extents: #[F32] = @storage.with_capacity (n * 6)
  for i in 0 .. n:
    let src = sources[i]
    let slot = 0xFFFFFFFF
    if let $Some collider = src.collider:
      let kind = row_body_kind bodies.rigids src
      if let $Some row = sphere_proxy_row i kind (src.walker != no_body) src collider:
        slot := rows.length
        @storage.push rows row
        @storage.push extents row.low.x
        @storage.push extents row.low.y
        @storage.push extents row.low.z
        @storage.push extents row.high.x
        @storage.push extents row.high.y
        @storage.push extents row.high.z
    @storage.push slots slot
  slots := finish_slots self rows.length
  return (rows, slots, extents)

private func build_primitive_source_rows (points: own #[shapes.Point3]) -> (planes: own #[shapes.Plane4]) -> (hulls: own #[shapes.StoredPoly]) -> (rows: own #[ProxyRow]) -> (slots: own #[U32]) -> (bodies: BodiesRead) -> (sources: &[SourceRow]) : (#[ProxyRow], #[U32], #[F32], #[shapes.Point3], #[shapes.Plane4], #[shapes.StoredPoly]) =>
  let n = sources.length
  @storage.reserve rows n
  @storage.reserve slots n
  let extents: #[F32] = @storage.with_capacity (n * 6)
  for i in 0 .. n:
    let src = sources[i]
    let row = $Nothing
    if let $Some col = src.collider:
      let kind = row_body_kind bodies.rigids src
      let is_walker = src.walker != no_body
      if let $StoredBox = col.shape:
        let (value, next_points, next_planes, next_hulls) = build_box_columns points planes hulls i kind is_walker src col
        points := next_points
        planes := next_planes
        hulls := next_hulls
        row := value
      else:
        if let $StoredSphere = col.shape:
          row := sphere_proxy_row i kind is_walker src col
        else:
          row := primitive_capsule_row i (unpack_primitive_source bodies src)
    let slot = 0xFFFFFFFF
    if let $Some value = row:
      slot := rows.length
      @storage.push rows value
      @storage.push extents value.low.x
      @storage.push extents value.low.y
      @storage.push extents value.low.z
      @storage.push extents value.high.x
      @storage.push extents value.high.y
      @storage.push extents value.high.z
    @storage.push slots slot
  slots := finish_slots self rows.length
  return (rows, slots, extents, points, planes, hulls)

private func build_rows_from_stored (geometry: own shapes.Geometry) -> (rows: own #[ProxyRow]) -> (slots: own #[U32]) -> (src_geom: shapes.Geometry) -> (bodies: BodiesRead) -> (sources: &[SourceRow]) : (#[ProxyRow], #[U32], #[F32], shapes.Geometry) =>
  @storage.truncate rows 0
  @storage.truncate slots 0
  let n = sources.length
  let all_spheres = true
  let primitives = true
  let box_count: U32 = 0
  for i in 0 .. n:
    let kind = stored_source_class sources[i]
    if kind != 0:
      all_spheres := false
      if kind == 2:
        primitives := false
        break
      if let $Some col = sources[i].collider:
        if let $StoredBox = col.shape:
          box_count := self + 1
  if all_spheres:
    let (rows, slots, extents) = build_sphere_source_rows rows slots bodies sources
    return (rows, slots, extents, geometry)
  if primitives:
    let $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes } = geometry
    if box_count > 0:
      @storage.reserve points (box_count * 17)
      @storage.reserve planes (box_count * 6)
      @storage.reserve hulls box_count
    let (rows, slots, extents, points, planes, hulls) = build_primitive_source_rows points planes hulls rows slots bodies sources
    return (rows, slots, extents, $shapes.Geometry { points, planes, rings, indices, heights, source_planes, hulls, heightfields, meshes })
  @storage.reserve rows n
  @storage.reserve slots n
  let extents: #[F32] = @storage.with_capacity (n * 6)
  for i in 0 .. n:
    let (maybe_row, next_geom) = proxy_of geometry i (unpack_source src_geom bodies sources[i])
    geometry := next_geom
    let slot = 0xFFFFFFFF
    if let $Some row = maybe_row:
      slot := rows.length
      @storage.push rows row
      @storage.push extents row.low.x
      @storage.push extents row.low.y
      @storage.push extents row.low.z
      @storage.push extents row.high.x
      @storage.push extents row.high.y
      @storage.push extents row.high.z
    @storage.push slots slot
  slots := finish_slots self rows.length
  return (rows, slots, extents, geometry)

func build_source_rows (destination: own Scene) -> (geometry: shapes.Geometry) -> (bodies: BodiesRead) -> (sources: &[SourceRow]) : Scene =>
  let $Scene { geometry: dst_geom, proxies, index, slots, source_count: _ } = destination
  let (stored, slots, extents, dst_geom) = build_rows_from_stored dst_geom proxies slots geometry bodies sources
  let index = spatial.build_flat index extents
  return $Scene { geometry: dst_geom, proxies: stored, index, slots, source_count: sources.length }
