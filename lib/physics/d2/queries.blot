import { Vec2 } from "std/vector"
import { Aabb2, Body2D, Filter2D } from "./shapes"
import * as shapes from "./shapes"
import * as narrowphase from "./narrowphase"

// 2D spatial queries: analytic raycasts (closest & all hits sorted by t),
// point and AABB overlaps, and swept TOI shapecasts for Circle, Box, Capsule,
// Polygon, and Edge — all respecting Filter2D layers/masks and trigger flags.

type RayHit2D is data = $RayHit2D { body: U32, t: F32, point: Vec2, normal: Vec2 }

type SweepHit2D is data = $SweepHit2D { body: U32, toi: F32, point: Vec2, normal: Vec2 }

// Analytic ray vs circle centered at `center` with radius `r`.
private func ray_circle (origin: Vec2) -> (dir: Vec2) -> (max_t: F32) -> (center: Vec2) -> (r: F32) -> (idx: U32) : Maybe RayHit2D =>
  if r <= 0.0:
    return $Nothing
  let oc = shapes.sub2 origin center
  let a = shapes.len_sq2 dir
  if not (shapes.finite a) or a <= 1.0e-12:
    return $Nothing
  let b = shapes.dot2 oc dir
  let c = shapes.len_sq2 oc - r * r
  if c <= 0.0:
    let n = shapes.norm2 oc ($Vec2 { x: 0.0, y: 1.0 })
    return $Some ($RayHit2D { body: idx, t: 0.0, point: origin, normal: n })
  let disc = b * b - a * c
  if not (shapes.finite disc) or disc < 0.0:
    return $Nothing
  let t = ((-b) - sqrt disc) / a
  if not (shapes.finite t) or t < 0.0 or t > max_t:
    return $Nothing
  let pt = shapes.add2 origin (shapes.scale2 t dir)
  let n = shapes.norm2 (shapes.sub2 pt center) (shapes.neg2 (shapes.norm2 dir ($Vec2 { x: 1.0, y: 0.0 })))
  return $Some ($RayHit2D { body: idx, t, point: pt, normal: n })

// Analytic ray vs convex CCW polygon (half-space slab intersection).
private func ray_poly (origin: Vec2) -> (dir: Vec2) -> (max_t: F32) -> (b: Body2D) -> (idx: U32) : Maybe RayHit2D =>
  let wp = shapes.body_world_poly b
  let n = min wp.count 8
  if n < 3:
    return $Nothing
  let t_min = 0.0
  let t_max = max_t
  let hit_n = shapes.neg2 (shapes.norm2 dir ($Vec2 { x: 1.0, y: 0.0 }))
  for i in 0 .. n:
    let va = shapes.poly_vert wp i
    let vb = shapes.poly_vert wp ((i + 1) % n)
    let en = shapes.norm2 (shapes.right_perp (shapes.sub2 vb va)) ($Vec2 { x: 0.0, y: 1.0 })
    let num = shapes.dot2 (shapes.sub2 va origin) en
    let den = shapes.dot2 dir en
    if abs den <= 1.0e-12:
      if num < 0.0:
        return $Nothing
    else:
      let t = num / den
      if den < 0.0:
        if t > t_min:
          t_min := t
          hit_n := en
      else:
        if t < t_max:
          t_max := t
      if t_min > t_max:
        return $Nothing
  if t_min < 0.0 or t_min > max_t:
    return $Nothing
  let pt = shapes.add2 origin (shapes.scale2 t_min dir)
  return $Some ($RayHit2D { body: idx, t: t_min, point: pt, normal: hit_n })

// Analytic ray vs 2D segment [ea, eb].
private func ray_edge (origin: Vec2) -> (dir: Vec2) -> (max_t: F32) -> (ea: Vec2) -> (eb: Vec2) -> (idx: U32) : Maybe RayHit2D =>
  let e = shapes.sub2 eb ea
  let denom = shapes.cross2 dir e
  if not (shapes.finite denom) or abs denom <= 1.0e-12:
    return $Nothing
  let ao = shapes.sub2 ea origin
  let t = shapes.cross2 ao e / denom
  let u = shapes.cross2 ao dir / denom
  if not (shapes.finite t) or not (shapes.finite u) or t < 0.0 or t > max_t or u < 0.0 or u > 1.0:
    return $Nothing
  let pt = shapes.add2 origin (shapes.scale2 t dir)
  let raw_n = shapes.norm2 (shapes.left_perp e) ($Vec2 { x: 0.0, y: 1.0 })
  let n = if shapes.dot2 raw_n dir <= 0.0 then raw_n else shapes.neg2 raw_n
  return $Some ($RayHit2D { body: idx, t, point: pt, normal: n })

// Analytic ray vs Capsule (two end-cap circles + central OBB slab).
private func ray_capsule (origin: Vec2) -> (dir: Vec2) -> (max_t: F32) -> (b: Body2D) -> (hl: F32) -> (r: F32) -> (idx: U32) : Maybe RayHit2D =>
  let radius = shapes.safe_nonneg r
  if radius <= 0.0:
    return $Nothing
  if shapes.safe_nonneg hl <= 1.0e-6:
    return ray_circle origin dir max_t b.pos radius idx
  let (s0, s1) = shapes.capsule_segment_world b hl
  let best: Maybe RayHit2D = $Nothing
  let best_t = max_t + 1.0
  // Test central oriented box of half_w = radius, half_h = hl.
  let box_body = $Body2D {
    pos: b.pos,
    vel: b.vel,
    angle: b.angle,
    ang_vel: b.ang_vel,
    inv_mass: 0.0,
    inv_inertia: 0.0,
    restitution: 0.0,
    friction: 0.0,
    linear_damping: 0.0,
    angular_damping: 0.0,
    gravity_scale: 0.0,
    filter: b.filter,
    trigger: false,
    bullet: false,
    one_way: false,
    asleep: false,
    sleep_timer: 0.0,
    shape: $shapes.Box { half_w: radius, half_h: shapes.safe_nonneg hl },
  }
  case ray_poly origin dir max_t box_body idx of
    $Some h => do:
      // Only keep hits on the side walls (not flat box caps), plus end caps below.
      let loc = shapes.to_local b h.point
      if abs loc.y <= shapes.safe_nonneg hl + 1.0e-4:
        best := $Some h
        best_t := h.t
    $Nothing => ()
  case ray_circle origin dir max_t s0 radius idx of
    $Some h => do:
      if h.t < best_t:
        best := $Some h
        best_t := h.t
    $Nothing => ()
  case ray_circle origin dir max_t s1 radius idx of
    $Some h => do:
      if h.t < best_t:
        best := $Some h
        best_t := h.t
    $Nothing => ()
  return best

func raycast_body (origin: Vec2) -> (dir: Vec2) -> (max_t: F32) -> (idx: U32) -> (b: Body2D) : Maybe RayHit2D =>
  if not (shapes.finite_v2 origin) or not (shapes.finite_v2 dir) or not (shapes.finite max_t) or max_t < 0.0:
    return $Nothing
  if not (shapes.finite_v2 b.pos):
    return $Nothing
  return case b.shape of
    $shapes.Circle { radius } => ray_circle origin dir max_t b.pos (shapes.safe_nonneg radius) idx
    $shapes.Box _ => ray_poly origin dir max_t b idx
    $shapes.Polygon _ => ray_poly origin dir max_t b idx
    $shapes.Capsule { half_length, radius } => ray_capsule origin dir max_t b half_length radius idx
    $shapes.Edge { a, b: eb, prev: _, next: _, has_prev: _, has_next: _ } => do:
      let (ea, eb_w) = shapes.edge_world b a eb
      break ray_edge origin dir max_t ea eb_w idx

// Closest raycast hit across `bodies`, honoring Filter2D and trigger flag.
func raycast (origin: Vec2) -> (dir: Vec2) -> (max_t: F32) -> (filter: Filter2D) -> (include_triggers: Bool) -> (bodies: #[Body2D]) : Maybe RayHit2D =>
  let best: Maybe RayHit2D = $Nothing
  let best_t = max_t
  for i in 0 .. bodies.length:
    let b = bodies[i]
    if (include_triggers or not b.trigger) and shapes.filter_collides filter b.filter:
      case raycast_body origin dir best_t i b of
        $Some h => do:
          if h.t <= best_t:
            best := $Some h
            best_t := h.t
        $Nothing => ()
  return best

// All raycast hits sorted by ascending hit parameter `t`.
func raycast_all (origin: Vec2) -> (dir: Vec2) -> (max_t: F32) -> (filter: Filter2D) -> (include_triggers: Bool) -> (bodies: #[Body2D]) : #[RayHit2D] =>
  let hits: #[RayHit2D] = #[]
  for i in 0 .. bodies.length:
    let b = bodies[i]
    if (include_triggers or not b.trigger) and shapes.filter_collides filter b.filter:
      case raycast_body origin dir max_t i b of
        $Some h => @storage.push hits h
        $Nothing => ()
  // Insertion sort by ascending t (deterministic tie-break by body index).
  let n = hits.length
  for i in 1 .. n:
    let key = hits[i]
    let j = i
    for 0 .. i:
      if j == 0:
        break
      let prev = hits[j - 1]
      if prev.t < key.t or (prev.t == key.t and prev.body <= key.body):
        break
      hits[j] := prev
      j := self - 1
    hits[j] := key
  return hits

func point_in_body (p: Vec2) -> (b: Body2D) : Bool =>
  if not (shapes.finite_v2 p) or not (shapes.finite_v2 b.pos):
    return false
  return case b.shape of
    $shapes.Circle { radius } => do:
      let r = shapes.safe_nonneg radius
      break shapes.len_sq2 (shapes.sub2 p b.pos) <= r * r
    $shapes.Box _ => do:
      let wp = shapes.body_world_poly b
      let inside = wp.count >= 3
      for i in 0 .. (min wp.count 8):
        let va = shapes.poly_vert wp i
        let vb = shapes.poly_vert wp ((i + 1) % wp.count)
        let en = shapes.right_perp (shapes.sub2 vb va)
        if shapes.dot2 (shapes.sub2 p va) en > 0.0:
          inside := false
          break
      break inside
    $shapes.Polygon _ => do:
      let wp = shapes.body_world_poly b
      let inside = wp.count >= 3
      for i in 0 .. (min wp.count 8):
        let va = shapes.poly_vert wp i
        let vb = shapes.poly_vert wp ((i + 1) % wp.count)
        let en = shapes.right_perp (shapes.sub2 vb va)
        if shapes.dot2 (shapes.sub2 p va) en > 0.0:
          inside := false
          break
      break inside
    $shapes.Capsule { half_length, radius } => do:
      let (s0, s1) = shapes.capsule_segment_world b half_length
      let (cl, _) = narrowphase.closest_point_segment p s0 s1
      let r = shapes.safe_nonneg radius
      break shapes.len_sq2 (shapes.sub2 p cl) <= r * r
    $shapes.Edge { a, b: eb, prev: _, next: _, has_prev: _, has_next: _ } => do:
      let (ea, eb_w) = shapes.edge_world b a eb
      let (cl, _) = narrowphase.closest_point_segment p ea eb_w
      break shapes.len_sq2 (shapes.sub2 p cl) <= 1.0e-6

func overlap_point (p: Vec2) -> (filter: Filter2D) -> (include_triggers: Bool) -> (bodies: #[Body2D]) : #[U32] =>
  let out: #[U32] = #[]
  for i in 0 .. bodies.length:
    let b = bodies[i]
    if (include_triggers or not b.trigger) and shapes.filter_collides filter b.filter:
      if shapes.aabb_contains_point (shapes.body_aabb b) p and point_in_body p b:
        @storage.push out i
  return out

func overlap_aabb (query: Aabb2) -> (filter: Filter2D) -> (include_triggers: Bool) -> (bodies: #[Body2D]) : #[U32] =>
  let out: #[U32] = #[]
  for i in 0 .. bodies.length:
    let b = bodies[i]
    if (include_triggers or not b.trigger) and shapes.filter_collides filter b.filter:
      if shapes.aabb_overlaps query (shapes.body_aabb b):
        @storage.push out i
  return out

private func segment_core (count: U32) -> (a: Vec2) -> (b: Vec2) : shapes.Poly2D =>
  let z = shapes.zero2
  return $shapes.Poly2D { count, v0: a, v1: b, v2: z, v3: z, v4: z, v5: z, v6: z, v7: z }

// A convex core dilated by a disk describes every supported shape.
private func sweep_core (b: Body2D) : (shapes.Poly2D, F32) =>
  return case b.shape of
    $shapes.Circle { radius } => (segment_core 1 b.pos b.pos, shapes.safe_nonneg radius)
    $shapes.Capsule { half_length, radius } => do:
      let (a, z) = shapes.capsule_segment_world b half_length
      break (segment_core 2 a z, shapes.safe_nonneg radius)
    $shapes.Edge { a, b: z, prev: _, next: _, has_prev: _, has_next: _ } => do:
      let (wa, wz) = shapes.edge_world b a z
      break (segment_core 2 wa wz, 0.0)
    $shapes.Box _ => (shapes.body_world_poly b, 0.0)
    $shapes.Polygon _ => (shapes.body_world_poly b, 0.0)

private func cast_side (origin: Vec2) -> (dir: Vec2) -> (limit: F32) -> (radius: F32) -> (a: Vec2) -> (b: Vec2) : Maybe (F32, Vec2, Vec2) =>
  let edge = shapes.sub2 b a
  let tangent = shapes.norm2 edge shapes.zero2
  let face = shapes.left_perp tangent
  let speed = shapes.dot2 dir face
  if speed == 0.0:
    return $Nothing
  let normal = if speed < 0.0 then face else shapes.neg2 face
  let offset = shapes.sub2 origin a
  let travel = (shapes.dot2 offset normal - radius) / abs speed
  if travel < 0.0 or travel > limit:
    return $Nothing
  let along = shapes.dot2 offset tangent + travel * shapes.dot2 dir tangent
  if along < 0.0 or along > shapes.dot2 edge tangent:
    return $Nothing
  return $Some (travel, shapes.add2 a (shapes.scale2 along tangent), normal)

private func cast_vertex (origin: Vec2) -> (dir: Vec2) -> (limit: F32) -> (radius: F32) -> (center: Vec2) : Maybe (F32, Vec2, Vec2) =>
  let offset = shapes.sub2 origin center
  let perpendicular = shapes.cross2 dir offset
  if abs perpendicular > radius:
    return $Nothing
  // Compute the discriminant from perpendicular distance to avoid
  // subtracting two large squared distances on a long cast.
  let depth = sqrt ((radius - abs perpendicular) * (radius + abs perpendicular))
  let travel = (-(shapes.dot2 offset dir)) - depth
  if travel < 0.0 or travel > limit:
    return $Nothing
  let radial = shapes.add2 (shapes.scale2 perpendicular (shapes.left_perp dir)) (shapes.scale2 (-depth) dir)
  return $Some (travel, center, shapes.norm2 radial (shapes.neg2 dir))

// All boundary features of the swept Minkowski difference come from an edge
// and an opposing vertex, or two vertices rounded by the sum of their radii.
private func cast_sides (vertices: shapes.Poly2D) -> (dir: Vec2) -> (limit: F32) -> (radius: F32) -> (edges: shapes.Poly2D) : Maybe (F32, Vec2, Vec2) =>
  let edge_count = if edges.count <= 2 then edges.count - 1 else edges.count
  let best: Maybe (F32, Vec2, Vec2) = $Nothing
  let distance = limit
  for j in 0 .. edge_count:
    let a = shapes.poly_vert edges j
    let b = shapes.poly_vert edges ((j + 1) % edges.count)
    for i in 0 .. vertices.count:
      let hit = cast_side (shapes.poly_vert vertices i) dir distance radius a b
      let $Some (travel, _, _) = hit else:
        continue
      if travel < distance or not (Maybe.is_some best):
        distance := travel
        best := hit
  return best

private func support_range (core: shapes.Poly2D) -> (axis: Vec2) -> (tangent: Vec2) -> (origin: Vec2) : (F32, F32) =>
  let depth = (-1.0e30)
  let lo = 0.0
  let hi = 0.0
  for i in 0 .. core.count:
    let v = shapes.sub2 (shapes.poly_vert core i) origin
    let dn = shapes.dot2 v axis
    let dt = shapes.dot2 v tangent
    if dn > depth + 1.0e-6:
      lo := dt
      hi := dt
    else:
      if dn >= depth - 1.0e-6:
        lo := min lo dt
        hi := max hi dt
    depth := max depth dn
  return (lo, hi)

// Exact translational cast against a stationary target with fixed orientations.
func shapecast_body (mover: Body2D) -> (delta: Vec2) -> (target_idx: U32) -> (target: Body2D) : Maybe SweepHit2D =>
  if not (shapes.finite_v2 delta) or not (shapes.finite_v2 mover.pos) or not (shapes.finite_v2 target.pos):
    return $Nothing
  if not (shapes.aabb_overlaps (shapes.aabb_swept mover delta) (shapes.body_aabb target)):
    return $Nothing
  case narrowphase.collide_bodies 0 mover target_idx target of
    $Some m => do:
      return $Some ($SweepHit2D { body: target_idx, toi: 0.0, point: m.p0.point, normal: shapes.neg2 m.normal })
    $Nothing => ()
  let dir = shapes.norm2 delta shapes.zero2
  let speed = shapes.dot2 delta dir
  if not (shapes.finite speed) or speed <= 0.0:
    return $Nothing
  let (a, ra) = sweep_core mover
  let (b, rb) = sweep_core target
  if a.count == 0 or b.count == 0:
    return $Nothing
  let radius = ra + rb
  let best: Maybe (F32, Vec2, Vec2) = cast_sides a dir speed radius b
  let distance = case best of
    $Some (travel, _, _) => travel
    $Nothing => speed
  case cast_sides b (shapes.neg2 dir) distance radius a of
    $Some (travel, point, normal) => do:
      if travel < distance or not (Maybe.is_some best):
        distance := travel
        let center = shapes.add2 point (shapes.scale2 travel dir)
        best := $Some (travel, shapes.add2 center (shapes.scale2 radius normal), shapes.neg2 normal)
    $Nothing => ()
  for i in 0 .. a.count:
    let origin = shapes.poly_vert a i
    for j in 0 .. b.count:
      let hit = cast_vertex origin dir distance radius (shapes.poly_vert b j)
      let $Some (travel, _, _) = hit else:
        continue
      if travel < distance or not (Maybe.is_some best):
        distance := travel
        best := hit
  let $Some (travel, core_point, normal) = best else:
    return $Nothing
  let point = shapes.add2 core_point (shapes.scale2 rb normal)
  // Center the witness over any shared face span so a symmetric face hit
  // does not apply the entire impulse at an arbitrary corner.
  let tangent = shapes.left_perp normal
  let shift = shapes.scale2 travel dir
  let (a0, a1) = support_range a (shapes.neg2 normal) tangent (shapes.sub2 point shift)
  let (b0, b1) = support_range b normal tangent point
  let lo = max a0 b0
  let hi = min a1 b1
  let contact = if lo < hi then shapes.add2 point (shapes.scale2 (0.5 * (lo + hi)) tangent) else point
  let target_normal = narrowphase.edge_normal_at target contact normal
  let mover_normal = narrowphase.edge_normal_at mover (shapes.sub2 contact shift) (shapes.neg2 target_normal)
  return $Some ($SweepHit2D { body: target_idx, toi: travel / speed, point: contact, normal: shapes.neg2 mover_normal })

// Closest swept TOI shapecast across `bodies`, skipping `ignore_idx` (pass 0xFFFFFFFF to ignore none).
func shapecast (mover: Body2D) -> (delta: Vec2) -> (ignore_idx: U32) -> (include_triggers: Bool) -> (bodies: #[Body2D]) : Maybe SweepHit2D =>
  let best: Maybe SweepHit2D = $Nothing
  let best_toi = 2.0
  for i in 0 .. bodies.length:
    if i != ignore_idx:
      let b = bodies[i]
      if (include_triggers or not b.trigger) and shapes.filter_collides mover.filter b.filter:
        case shapecast_body mover delta i b of
          $Some h => do:
            if h.toi < best_toi:
              best := $Some h
              best_toi := h.toi
          $Nothing => ()
  return best
