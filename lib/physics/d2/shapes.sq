func set_damping (linear: F32) -> (angular: F32) -> (b: Body2D) : Body2D =>
  return $Body2D {
    pos: b.pos,
    vel: b.vel,
    angle: b.angle,
    ang_vel: b.ang_vel,
    inv_mass: b.inv_mass,
    inv_inertia: b.inv_inertia,
    restitution: b.restitution,
    friction: b.friction,
    linear_damping: safe_nonneg linear,
    angular_damping: safe_nonneg angular,
    gravity_scale: b.gravity_scale,
    filter: b.filter,
    trigger: b.trigger,
    bullet: b.bullet,
    one_way: b.one_way,
    asleep: b.asleep,
    sleep_timer: b.sleep_timer,
    shape: b.shape,
  }

func lock_rotation (b: Body2D) : Body2D =>
  return $Body2D {
    pos: b.pos,
    vel: b.vel,
    angle: b.angle,
    ang_vel: 0.0,
    inv_mass: b.inv_mass,
    inv_inertia: 0.0,
    restitution: b.restitution,
    friction: b.friction,
    linear_damping: b.linear_damping,
    angular_damping: b.angular_damping,
    gravity_scale: b.gravity_scale,
    filter: b.filter,
    trigger: b.trigger,
    bullet: b.bullet,
    one_way: b.one_way,
    asleep: b.asleep,
    sleep_timer: b.sleep_timer,
    shape: b.shape,
  }

func wake (b: Body2D) : Body2D =>
  return body_with_sleep false 0.0 b
