//! Full deterministic 2D rigid-body simulation world:
//! - Spatial-hash broadphase with Filter2D bitmasks
//! - 2-point Sutherland-Hodgman clipped contact manifolds across all 5 shapes
//! - Persistent U32 feature-key warm-start impulse cache (keys stay U32!)
//! - Box2D-style 2x2 block normal solver for 2-point manifolds + precomputed
//!   restitution velocity bias + accumulated Coulomb friction clamping
//! - Nonlinear positional correction (Baumgarte / slop)
//! - 2D joints (Distance, Spring, Revolute, Prismatic, Weld, Wheel)
//! - Swept CCD anti-tunneling for fast `bullet` bodies
//! - One-way semi-solid platforms, linear/angular damping, deterministic sleep/wake
//! - Stateful Enter/Stay/Exit trigger lifecycle events via `ink/physics/triggers`
//!
//! Key items: [`CachedImpulse2D`], [`WorldConfig2D`], [`StepStats2D`], [`default_config`], [`step`].
//!
//! ```blot
//! import * as test from "std/test"
//! import * as math from "ink/math"
//! import * as shapes from "ink/physics/d2/shapes"
//! import * as world from "ink/physics/d2/world"
//!
//! @[test.suite]
//! test "2D body falls under gravity":
//!   let b = shapes.dynamic_circle (math.vec2 0.0 10.0) 0.5 1.0 0.2 0.5
//!   let (bodies, _) = world.step_world (math.vec2 0.0 (-9.81)) (1.0 / 60.0) 10 #[b]
//!   use test.holds "fell downward" (bodies[0].pos.y < 10.0)
//!   return ()
//! ```

import * as array from "std/array"
import { Vec2 } from "std/vector"
import * as triggers from "../triggers"
import { Body2D } from "./shapes"
import * as shapes from "./shapes"
import * as broadphase from "./broadphase"
import { Manifold2D } from "./narrowphase"
import * as narrowphase from "./narrowphase"
import { Joint2D } from "./joints"
import * as joints from "./joints"
import * as queries from "./queries"

type CachedImpulse2D is data = $CachedImpulse2D {
  body_a: U32,
  body_b: U32,
  feature: U32,
  normal_impulse: F32,
  tangent_impulse: F32,
}

type WorldConfig2D is data = $WorldConfig2D {
  gravity: Vec2,
  iterations: U32,
  pos_iterations: U32,
  cell_size: F32,
  baumgarte: F32,
  slop: F32,
  enable_sleep: Bool,
  sleep_lin_eps: F32,
  sleep_ang_eps: F32,
  sleep_time: F32,
  enable_ccd: Bool,
  warm_start_scale: F32,
}

type StepStats2D is data = $StepStats2D {
  contacts: U32,
  manifolds: U32,
  awake_bodies: U32,
}

// Precomputed per-manifold contact geometry and effective masses; impulses live
// in flat F32 scratch arrays so velocity iterations do zero heap allocations.
private type PreparedManifold is data = $PreparedManifold {
  a: U32,
  b: U32,
  count: U32,
  nx: F32,
  ny: F32,
  tx: F32,
  ty: F32,
  friction: F32,
  ra0x: F32,
  ra0y: F32,
  rb0x: F32,
  rb0y: F32,
  kt0: F32,
  kn0: F32,
  bias0: F32,
  feature0: U32,
  ra1x: F32,
  ra1y: F32,
  rb1x: F32,
  rb1y: F32,
  kt1: F32,
  kn1: F32,
  bias1: F32,
  feature1: U32,
  k00: F32,
  k11: F32,
  k01: F32,
  inv_det: F32,
  use_block: Bool,
}

func default_config (gravity: Vec2) : WorldConfig2D =>
  return $WorldConfig2D {
    gravity: $Vec2 { x: shapes.safe_f32 gravity.x 0.0, y: shapes.safe_f32 gravity.y (-9.81) },
    iterations: 8,
    pos_iterations: 3,
    cell_size: 2.0,
    baumgarte: 0.25,
    slop: 0.005,
    enable_sleep: true,
    sleep_lin_eps: 0.04,
    sleep_ang_eps: 0.04,
    sleep_time: 0.5,
    enable_ccd: true,
    warm_start_scale: 1.0,
  }

private func cache_precedes (entry: CachedImpulse2D) -> (a: U32) -> (b: U32) -> (feature: U32) : Bool =>
  if entry.body_a != a:
    return entry.body_a < a
  if entry.body_b != b:
    return entry.body_b < b
  return entry.feature < feature

private func cache_less (a: CachedImpulse2D) -> (b: CachedImpulse2D) : Bool =>
  return cache_precedes a b.body_a b.body_b b.feature

// Sort by full U32 contact identity for binary search (O(N) zero-copy fast path when already sorted).
private func sort_cache_in_place (entries: own #[CachedImpulse2D]) : #[CachedImpulse2D] =>
  let n = entries.length
  if n <= 1:
    return entries
  let already = true
  for i in 1 .. n:
    if cache_less entries[i] entries[i - 1]:
      already := false
      break
  if already:
    return entries
  let dst = @storage.copy entries
  let from_src = true
  let width = 1
  for 0 .. 32:
    if width >= n:
      break
    let left = 0
    for 0 .. n:
      if left >= n:
        break
      let mid = min (left + width) n
      let right = min (left + width * 2) n
      let i = left
      let j = mid
      if from_src:
        for k in left .. right:
          if i < mid and (j >= right or not (cache_less entries[j] entries[i])):
            dst[k] := entries[i]
            i := self + 1
          else:
            dst[k] := entries[j]
            j := self + 1
      else:
        for k in left .. right:
          if i < mid and (j >= right or not (cache_less dst[j] dst[i])):
            entries[k] := dst[i]
            i := self + 1
          else:
            entries[k] := dst[j]
            j := self + 1
      left := right
    from_src := not from_src
    width := self * 2
  if not from_src:
    for i in 0 .. n:
      entries[i] := dst[i]
  return entries

private func lookup_cache (cache: #[CachedImpulse2D]) -> (a: U32) -> (b: U32) -> (feature: U32) : (F32, F32) =>
  let n = cache.length
  if n == 0:
    return (0.0, 0.0)
  let lo = 0
  let hi = n
  for 0 .. 32:
    if lo >= hi:
      break
    let mid = lo + (hi - lo) / 2
    let e = cache[mid]
    if e.body_a == a and e.body_b == b and e.feature == feature:
      return (shapes.safe_nonneg e.normal_impulse, shapes.safe_f32 e.tangent_impulse 0.0)
    if cache_precedes e a b feature:
      lo := mid + 1
    else:
      hi := mid
  return (0.0, 0.0)

private func sanitize_body (b: Body2D) : Body2D =>
  let px = shapes.safe_f32 b.pos.x 0.0
  let py = shapes.safe_f32 b.pos.y 0.0
  let vx = shapes.safe_f32 b.vel.x 0.0
  let vy = shapes.safe_f32 b.vel.y 0.0
  return $Body2D {
    pos: $Vec2 { x: px, y: py },
    vel: $Vec2 { x: vx, y: vy },
    angle: shapes.wrap_angle b.angle,
    ang_vel: shapes.safe_f32 b.ang_vel 0.0,
    inv_mass: shapes.safe_nonneg b.inv_mass,
    inv_inertia: shapes.safe_nonneg b.inv_inertia,
    restitution: shapes.safe_clamp b.restitution 0.0 1.0,
    friction: shapes.safe_nonneg b.friction,
    linear_damping: shapes.safe_nonneg b.linear_damping,
    angular_damping: shapes.safe_nonneg b.angular_damping,
    gravity_scale: shapes.safe_f32 b.gravity_scale 1.0,
    filter: b.filter,
    trigger: b.trigger,
    bullet: b.bullet,
    one_way: b.one_way,
    asleep: b.asleep,
    sleep_timer: shapes.safe_nonneg b.sleep_timer,
    shape: b.shape,
  }

private func pair_suppressed_by_joint (ia: U32) -> (ib: U32) -> (jlist: #[Joint2D]) : Bool =>
  for i in 0 .. jlist.length:
    let j = jlist[i]
    if not j.collide_connected:
      if (j.a == ia and j.b == ib) or (j.a == ib and j.b == ia):
        return true
  return false

private func one_way_ignore (a: Body2D) -> (b: Body2D) -> (normal: Vec2) : Bool =>
  if a.one_way and b.inv_mass > 0.0:
    let plat_top = (shapes.body_aabb a).max.y
    let dyn_bot = (shapes.body_aabb b).min.y
    if normal.y < 0.5 or b.vel.y > 0.05 or dyn_bot < plat_top - 0.15:
      return true
  if b.one_way and a.inv_mass > 0.0:
    let plat_top = (shapes.body_aabb b).max.y
    let dyn_bot = (shapes.body_aabb a).min.y
    if normal.y > (-0.5) or a.vel.y > 0.05 or dyn_bot < plat_top - 0.15:
      return true
  return false

private func apply_contact_impulse (a: Body2D) -> (b: Body2D) -> (pt: Vec2) -> (imp: Vec2) : (Body2D, Body2D) =>
  let ra = shapes.sub2 pt a.pos
  let rb = shapes.sub2 pt b.pos
  let va = shapes.sub2 a.vel (shapes.scale2 a.inv_mass imp)
  let wa = a.ang_vel - a.inv_inertia * shapes.cross2 ra imp
  let vb = shapes.add2 b.vel (shapes.scale2 b.inv_mass imp)
  let wb = b.ang_vel + b.inv_inertia * shapes.cross2 rb imp
  if not (shapes.finite_v2 va) or not (shapes.finite wa) or not (shapes.finite_v2 vb) or not (shapes.finite wb):
    return (a, b)
  return (shapes.body_with_vel va wa a, shapes.body_with_vel vb wb b)

private func rel_vel_at (a: Body2D) -> (b: Body2D) -> (pt: Vec2) : Vec2 =>
  let ra = shapes.sub2 pt a.pos
  let rb = shapes.sub2 pt b.pos
  let va = shapes.add2 a.vel (shapes.cross_sv a.ang_vel ra)
  let vb = shapes.add2 b.vel (shapes.cross_sv b.ang_vel rb)
  return shapes.sub2 vb va

// Solve friction for one contact point with accumulated Coulomb clamping.
private func solve_friction_1pt (a: Body2D) -> (b: Body2D) -> (pt: Vec2) -> (tang: Vec2) -> (mu: F32) -> (jn: F32) -> (old_jt: F32) : (F32, Body2D, Body2D) =>
  let im = a.inv_mass + b.inv_mass
  let ra = shapes.sub2 pt a.pos
  let rb = shapes.sub2 pt b.pos
  let vt = shapes.dot2 (rel_vel_at a b pt) tang
  let txa = shapes.cross2 ra tang
  let txb = shapes.cross2 rb tang
  let kt = im + txa * txa * a.inv_inertia + txb * txb * b.inv_inertia
  if not (shapes.finite kt) or kt <= 1.0e-12:
    return (old_jt, a, b)
  let djt = (-vt) / kt
  let max_f = mu * jn
  let new_jt = shapes.safe_clamp (old_jt + djt) (-max_f) max_f
  let apply_t = new_jt - old_jt
  let (a1, b1) = apply_contact_impulse a b pt (shapes.scale2 apply_t tang)
  return (new_jt, a1, b1)

// Solve 1-point normal impulse against precomputed velocity target `bias`.
private func solve_normal_1pt (a: Body2D) -> (b: Body2D) -> (pt: Vec2) -> (normal: Vec2) -> (bias: F32) -> (old_jn: F32) : (F32, Body2D, Body2D) =>
  let im = a.inv_mass + b.inv_mass
  let ra = shapes.sub2 pt a.pos
  let rb = shapes.sub2 pt b.pos
  let vn = shapes.dot2 (rel_vel_at a b pt) normal
  let rxa = shapes.cross2 ra normal
  let rxb = shapes.cross2 rb normal
  let kn = im + rxa * rxa * a.inv_inertia + rxb * rxb * b.inv_inertia
  if not (shapes.finite kn) or kn <= 1.0e-12:
    return (old_jn, a, b)
  let djn = (-(vn - bias)) / kn
  let new_jn = max (old_jn + djn) 0.0
  let apply_n = new_jn - old_jn
  let (a1, b1) = apply_contact_impulse a b pt (shapes.scale2 apply_n normal)
  return (new_jn, a1, b1)

// Precompute contact geometry, tangent, restitution bias, and 1x1 / 2x2 effective masses.
private func prepare_manifold (m: Manifold2D) -> (a: Body2D) -> (b: Body2D) -> (ima: F32) -> (iia: F32) -> (imb: F32) -> (iib: F32) -> (vax: F32) -> (vay: F32) -> (wa: F32) -> (vbx: F32) -> (vby: F32) -> (wb: F32) -> (cache: #[CachedImpulse2D]) -> (warm_scale: F32) : (PreparedManifold, F32, F32, F32, F32) =>
  let rest = max a.restitution b.restitution
  let fric = sqrt (max (a.friction * b.friction) 0.0)
  let nx = m.normal.x
  let ny = m.normal.y
  let tx = -ny
  let ty = nx
  let im = ima + imb
  let ra0x = m.p0.point.x - a.pos.x
  let ra0y = m.p0.point.y - a.pos.y
  let rb0x = m.p0.point.x - b.pos.x
  let rb0y = m.p0.point.y - b.pos.y
  let rvx0 = (vbx - wb * rb0y) - (vax - wa * ra0y)
  let rvy0 = (vby + wb * rb0x) - (vay + wa * ra0x)
  let vn0 = rvx0 * nx + rvy0 * ny
  let bias0 = if vn0 < (-1.0) then (-rest) * vn0 else 0.0
  let txa0 = ra0x * ty - ra0y * tx
  let txb0 = rb0x * ty - rb0y * tx
  let kt0 = im + txa0 * txa0 * iia + txb0 * txb0 * iib
  let rxa0 = ra0x * ny - ra0y * nx
  let rxb0 = rb0x * ny - rb0y * nx
  let kn0 = im + rxa0 * rxa0 * iia + rxb0 * rxb0 * iib
  let (jn0, jt0) = lookup_cache cache m.a m.b m.p0.feature
  let ra1x = 0.0
  let ra1y = 0.0
  let rb1x = 0.0
  let rb1y = 0.0
  let kt1 = 0.0
  let kn1 = 0.0
  let bias1 = 0.0
  let jn1 = 0.0
  let jt1 = 0.0
  let k00 = kn0
  let k11 = 0.0
  let k01 = 0.0
  let inv_det = 0.0
  let use_block = false
  if m.count >= 2:
    ra1x := m.p1.point.x - a.pos.x
    ra1y := m.p1.point.y - a.pos.y
    rb1x := m.p1.point.x - b.pos.x
    rb1y := m.p1.point.y - b.pos.y
    let rvx1 = (vbx - wb * rb1y) - (vax - wa * ra1y)
    let rvy1 = (vby + wb * rb1x) - (vay + wa * ra1x)
    let vn1 = rvx1 * nx + rvy1 * ny
    if vn1 < (-1.0):
      bias1 := (-rest) * vn1
    let txa1 = ra1x * ty - ra1y * tx
    let txb1 = rb1x * ty - rb1y * tx
    kt1 := im + txa1 * txa1 * iia + txb1 * txb1 * iib
    let rxa1 = ra1x * ny - ra1y * nx
    let rxb1 = rb1x * ny - rb1y * nx
    kn1 := im + rxa1 * rxa1 * iia + rxb1 * rxb1 * iib
    k11 := kn1
    k01 := im + rxa0 * rxa1 * iia + rxb0 * rxb1 * iib
    let det = k00 * k11 - k01 * k01
    if shapes.finite det and det > 1.0e-8 and k00 > 1.0e-12 and k11 > 1.0e-12 and k00 * k00 < 1000.0 * det:
      inv_det := 1.0 / det
      use_block := true
    let (cjn1, cjt1) = lookup_cache cache m.a m.b m.p1.feature
    jn1 := cjn1
    jt1 := cjt1
  let pm = $PreparedManifold {
    a: m.a,
    b: m.b,
    count: m.count,
    nx,
    ny,
    tx,
    ty,
    friction: fric,
    ra0x,
    ra0y,
    rb0x,
    rb0y,
    kt0,
    kn0,
    bias0,
    feature0: m.p0.feature,
    ra1x,
    ra1y,
    rb1x,
    rb1y,
    kt1,
    kn1,
    bias1,
    feature1: m.p1.feature,
    k00,
    k11,
    k01,
    inv_det,
    use_block,
  }
  return (pm, jn0 * warm_scale, jt0 * warm_scale, jn1 * warm_scale, jt1 * warm_scale)

private func freeze_as_static (b: Body2D) : Body2D =>
  if b.asleep:
    return $Body2D {
      pos: b.pos,
      vel: shapes.zero2,
      angle: b.angle,
      ang_vel: 0.0,
      inv_mass: 0.0,
      inv_inertia: 0.0,
      restitution: b.restitution,
      friction: b.friction,
      linear_damping: b.linear_damping,
      angular_damping: b.angular_damping,
      gravity_scale: b.gravity_scale,
      filter: b.filter,
      trigger: b.trigger,
      bullet: b.bullet,
      one_way: b.one_way,
      asleep: true,
      sleep_timer: b.sleep_timer,
      shape: b.shape,
    }
  return b

private type Motion is data = $Motion { linear: Vec2, angular: F32 }

private func step_motion (dt: F32) -> (b: Body2D) : Motion =>
  if b.inv_mass <= 0.0 or b.asleep:
    return $Motion { linear: shapes.zero2, angular: 0.0 }
  return $Motion { linear: shapes.scale2 dt b.vel, angular: dt * b.ang_vel }

private func advance_pose (b: Body2D) -> (motion: Motion) : Body2D =>
  let pos = shapes.add2 b.pos motion.linear
  if not (shapes.finite_v2 pos) or not (shapes.finite motion.angular):
    return b
  return shapes.body_with_pose pos (shapes.wrap_angle (b.angle + motion.angular)) b

private func cast_ccd (i: U32) -> (bodies: #[Body2D]) -> (motions: #[Motion]) -> (joint_list: #[Joint2D]) : Maybe queries.SweepHit2D =>
  let bullet = bodies[i]
  let disp = motions[i].linear
  let best: Maybe queries.SweepHit2D = $Nothing
  let toi = 2.0
  for j in 0 .. bodies.length:
    let target = bodies[j]
    if i == j or target.trigger or not (shapes.filter_collides bullet.filter target.filter):
      continue
    let target_disp = motions[j].linear
    let relative_disp = shapes.sub2 disp target_disp
    if relative_disp.x == 0.0 and relative_disp.y == 0.0:
      continue
    let $Some hit = queries.shapecast_body bullet relative_disp j target else:
      continue
    if hit.toi >= toi or pair_suppressed_by_joint i j joint_list:
      continue
    let target_shift = shapes.scale2 hit.toi target_disp
    let point = shapes.add2 hit.point target_shift
    let a = shapes.body_with_pose (shapes.add2 bullet.pos (shapes.scale2 hit.toi disp)) bullet.angle bullet
    let b = shapes.body_with_pose (shapes.add2 target.pos target_shift) target.angle target
    let normal = shapes.neg2 hit.normal
    if not (one_way_ignore a b normal) and shapes.dot2 (rel_vel_at a b point) normal < 0.0:
      best := $Some ($queries.SweepHit2D { body: j, toi: hit.toi, point, normal: hit.normal })
      toi := hit.toi
  return best

private func after_impact (motion: Motion) -> (remaining: F32) -> (before: Body2D) -> (after: Body2D) : Motion =>
  return $Motion {
    linear: shapes.add2 motion.linear (shapes.scale2 remaining (shapes.sub2 after.vel before.vel)),
    angular: motion.angular + remaining * (after.ang_vel - before.ang_vel),
  }

private func integrate_ccd (dt: F32) -> (joint_list: #[Joint2D]) -> (bodies: own #[Body2D]) : #[Body2D] =>
  let count = bodies.length
  let motions: #[Motion] = #[]
  for i in 0 .. count:
    @storage.push motions (step_motion dt bodies[i])
  for i in 0 .. count:
    let bullet = bodies[i]
    if not bullet.bullet or bullet.trigger or bullet.inv_mass <= 0.0 or bullet.asleep:
      continue
    let $Some hit = cast_ccd i bodies motions joint_list else:
      continue
    let j = hit.body
    let target = bodies[j]
    let a = shapes.body_with_pose (shapes.add2 bullet.pos (shapes.scale2 hit.toi motions[i].linear)) bullet.angle bullet
    let b = shapes.body_with_pose (shapes.add2 target.pos (shapes.scale2 hit.toi motions[j].linear)) target.angle target
    let normal = shapes.neg2 hit.normal
    let vn = shapes.dot2 (rel_vel_at a b hit.point) normal
    let restitution = max a.restitution b.restitution
    let (jn, an, bn) = solve_normal_1pt a b hit.point normal ((-restitution) * vn) 0.0
    let friction = sqrt (max (a.friction * b.friction) 0.0)
    let (_, af, bf) = solve_friction_1pt an bn hit.point (shapes.left_perp normal) friction jn 0.0
    let remain = (1.0 - hit.toi) * dt
    motions[i] := after_impact motions[i] remain bullet af
    bodies[i] := shapes.body_with_vel af.vel af.ang_vel bullet
    if target.inv_mass > 0.0 and jn > 0.0:
      motions[j] := after_impact motions[j] remain target bf
      bodies[j] := shapes.set_velocity bf.vel bf.ang_vel target
  for i in 0 .. count:
    let b = bodies[i]
    bodies[i] := advance_pose b motions[i]
  return bodies

// Advance the full 2D physics world by caller-supplied `dt` seconds.
// Caller owns `cache` (persistent U32 warm-start impulses) and `prev_triggers`
// (persistent overlap pairs for Enter/Stay/Exit lifecycle events); both are
// mutated in place and returned alongside the stepped bodies, trigger events,
// and step diagnostics.
func step (cfg: WorldConfig2D) -> (dt: F32) -> (bodies_in: #[Body2D]) -> (joint_list: #[Joint2D]) -> (cache: own #[CachedImpulse2D]) -> (prev_triggers: own #[triggers.Pair]) : (#[Body2D], #[triggers.Event], #[CachedImpulse2D], #[triggers.Pair], StepStats2D) =>
  let n = bodies_in.length
  let cur: #[Body2D] = #[]
  for i in 0 .. n:
    let b = sanitize_body bodies_in[i]
    @storage.push cur (if cfg.enable_sleep then b else shapes.wake b)
  if not (shapes.finite dt) or dt <= 0.0 or n == 0:
    return (cur, #[], cache, prev_triggers, $StepStats2D { contacts: 0, manifolds: 0, awake_bodies: 0 })
  let gx = shapes.safe_f32 cfg.gravity.x 0.0
  let gy = shapes.safe_f32 cfg.gravity.y 0.0
  let wake_lin2 = cfg.sleep_lin_eps * cfg.sleep_lin_eps * 4.0
  let wake_ang = cfg.sleep_ang_eps * 2.0
  // Record which bodies were genuinely moving before gravity so resting neighbors do not ping-pong wake sleeping stacks.
  let pre_fast: #[Bool] = #[]
  let has_bullet = false
  for i in 0 .. n:
    let b = cur[i]
    if b.bullet and b.inv_mass > 0.0 and not b.trigger:
      has_bullet := true
    @storage.push pre_fast (b.inv_mass > 0.0 and not b.asleep and (shapes.len_sq2 b.vel > wake_lin2 or abs b.ang_vel > wake_ang))
  // 1. Integrate gravity & damping for awake dynamic bodies.
  for i in 0 .. n:
    let b = cur[i]
    if b.inv_mass > 0.0 and not b.asleep:
      let lin_damp = 1.0 / (1.0 + b.linear_damping * dt)
      let ang_damp = 1.0 / (1.0 + b.angular_damping * dt)
      let vx = (b.vel.x + gx * b.gravity_scale * dt) * lin_damp
      let vy = (b.vel.y + gy * b.gravity_scale * dt) * lin_damp
      let w = b.ang_vel * ang_damp
      if shapes.finite vx and shapes.finite vy and shapes.finite w:
        cur[i] := shapes.body_with_vel ($Vec2 { x: vx, y: vy }) w b
  // 2. Deterministic spatial-hash broadphase.
  let pairs = broadphase.broadphase_pairs cfg.cell_size (if cfg.enable_ccd then dt else 0.0) cur
  // 3. Narrowphase -> solid manifolds + trigger Pairs.
  cache := sort_cache_in_place self
  let has_suppressed_joints = false
  for j in joint_list:
    if not j.collide_connected:
      has_suppressed_joints := true
      break
  let warm = shapes.safe_clamp cfg.warm_start_scale 0.0 1.0
  let raw_mans: #[Manifold2D] = #[]
  let solid_pairs: #[broadphase.Pair2D] = #[]
  let trig_pairs: #[triggers.Pair] = #[]
  let contact_count = 0
  for pi in 0 .. pairs.length:
    let pr = pairs[pi]
    let ia = pr.a
    let ib = pr.b
    let ba = cur[ia]
    let bb = cur[ib]
    if not (has_suppressed_joints and pair_suppressed_by_joint ia ib joint_list):
      case narrowphase.collide_bodies ia ba ib bb of
        $Some m => do:
          if m.is_trigger:
            let trig_id = if ba.trigger then ia else ib
            let other_id = if ba.trigger then ib else ia
            @storage.push trig_pairs ($triggers.Pair { trigger: trig_id, body: other_id })
          else:
            if not (one_way_ignore ba bb m.normal):
              @storage.push solid_pairs pr
              if ba.asleep and pre_fast[ib]:
                cur[ia] := shapes.wake ba
              if bb.asleep and pre_fast[ia]:
                cur[ib] := shapes.wake bb
              contact_count := self + m.count
              @storage.push raw_mans m
        $Nothing => ()
  // Wake bodies connected by a joint to a moving awake body.
  for ji in 0 .. joint_list.length:
    let j = joint_list[ji]
    if j.a < n and j.b < n:
      let ba = cur[j.a]
      let bb = cur[j.b]
      if ba.asleep and pre_fast[j.b]:
        cur[j.a] := shapes.wake ba
      if bb.asleep and pre_fast[j.a]:
        cur[j.b] := shapes.wake bb
  // Flat per-body velocity/mass scratch for allocation-free velocity solving.
  let vx = @array.fill n 0.0
  let vy = @array.fill n 0.0
  let vw = @array.fill n 0.0
  let inv_m = @array.fill n 0.0
  let inv_i = @array.fill n 0.0
  for i in 0 .. n:
    let b = cur[i]
    if not b.asleep:
      vx[i] := b.vel.x
      vy[i] := b.vel.y
      vw[i] := b.ang_vel
      inv_m[i] := b.inv_mass
      inv_i[i] := b.inv_inertia
  // Precompute manifold effective masses and warm-start impulses once.
  let mcount = raw_mans.length
  let pmans: #[PreparedManifold] = #[]
  let sm_jn0 = @array.fill mcount 0.0
  let sm_jt0 = @array.fill mcount 0.0
  let sm_jn1 = @array.fill mcount 0.0
  let sm_jt1 = @array.fill mcount 0.0
  for k in 0 .. mcount:
    let m = raw_mans[k]
    let ia = m.a
    let ib = m.b
    let (pm, jn0, jt0, jn1, jt1) = prepare_manifold m cur[ia] cur[ib] inv_m[ia] inv_i[ia] inv_m[ib] inv_i[ib] vx[ia] vy[ia] vw[ia] vx[ib] vy[ib] vw[ib] cache warm
    @storage.push pmans pm
    sm_jn0[k] := jn0
    sm_jt0[k] := jt0
    sm_jn1[k] := jn1
    sm_jt1[k] := jt1
  // 4. Apply warm-started impulses from U32-keyed cache before velocity iterations.
  for k in 0 .. mcount:
    let pm = pmans[k]
    let ia = pm.a
    let ib = pm.b
    let ima = inv_m[ia]
    let imb = inv_m[ib]
    if ima + imb > 0.0:
      let iia = inv_i[ia]
      let iib = inv_i[ib]
      let vax = vx[ia]
      let vay = vy[ia]
      let wa = vw[ia]
      let vbx = vx[ib]
      let vby = vy[ib]
      let wb = vw[ib]
      let jn0 = sm_jn0[k]
      let jt0 = sm_jt0[k]
      if jn0 > 0.0 or abs jt0 > 0.0:
        let ix = pm.nx * jn0 + pm.tx * jt0
        let iy = pm.ny * jn0 + pm.ty * jt0
        let nvax = vax - ima * ix
        let nvay = vay - ima * iy
        let nwa = wa - iia * (pm.ra0x * iy - pm.ra0y * ix)
        let nvbx = vbx + imb * ix
        let nvby = vby + imb * iy
        let nwb = wb + iib * (pm.rb0x * iy - pm.rb0y * ix)
        if shapes.finite nvax and shapes.finite nvay and shapes.finite nwa and shapes.finite nvbx and shapes.finite nvby and shapes.finite nwb:
          vax := nvax
          vay := nvay
          wa := nwa
          vbx := nvbx
          vby := nvby
          wb := nwb
      let jn1 = sm_jn1[k]
      let jt1 = sm_jt1[k]
      if pm.count >= 2 and (jn1 > 0.0 or abs jt1 > 0.0):
        let ix = pm.nx * jn1 + pm.tx * jt1
        let iy = pm.ny * jn1 + pm.ty * jt1
        let nvax = vax - ima * ix
        let nvay = vay - ima * iy
        let nwa = wa - iia * (pm.ra1x * iy - pm.ra1y * ix)
        let nvbx = vbx + imb * ix
        let nvby = vby + imb * iy
        let nwb = wb + iib * (pm.rb1x * iy - pm.rb1y * ix)
        if shapes.finite nvax and shapes.finite nvay and shapes.finite nwa and shapes.finite nvbx and shapes.finite nvby and shapes.finite nwb:
          vax := nvax
          vay := nvay
          wa := nwa
          vbx := nvbx
          vby := nvby
          wb := nwb
      if ima > 0.0:
        vx[ia] := vax
        vy[ia] := vay
        vw[ia] := wa
      if imb > 0.0:
        vx[ib] := vbx
        vy[ib] := vby
        vw[ib] := wb
  // 5. Sequential-impulse velocity iterations (2x2 block normal contacts + joints).
  let motor_impulses = @array.fill joint_list.length 0.0
  let vel_iters = max (min cfg.iterations 64) 1
  for _ in 0 .. vel_iters:
    for ji in 0 .. joint_list.length:
      let j = joint_list[ji]
      if j.a < n and j.b < n and j.a != j.b:
        let ba = cur[j.a]
        let bb = cur[j.b]
        if not ba.asleep or not bb.asleep:
          let a_in = if ba.asleep then freeze_as_static ba else shapes.body_with_vel ($Vec2 { x: vx[j.a], y: vy[j.a] }) vw[j.a] ba
          let b_in = if bb.asleep then freeze_as_static bb else shapes.body_with_vel ($Vec2 { x: vx[j.b], y: vy[j.b] }) vw[j.b] bb
          let (a1, b1, total) = joints.solve_joint_velocity_accumulated dt j a_in b_in motor_impulses[ji]
          motor_impulses[ji] := total
          if not ba.asleep:
            vx[j.a] := a1.vel.x
            vy[j.a] := a1.vel.y
            vw[j.a] := a1.ang_vel
          if not bb.asleep:
            vx[j.b] := b1.vel.x
            vy[j.b] := b1.vel.y
            vw[j.b] := b1.ang_vel
    for k in 0 .. mcount:
      let pm = pmans[k]
      let ia = pm.a
      let ib = pm.b
      let ima = inv_m[ia]
      let imb = inv_m[ib]
      if ima + imb <= 0.0:
        continue
      let iia = inv_i[ia]
      let iib = inv_i[ib]
      let vax = vx[ia]
      let vay = vy[ia]
      let wa = vw[ia]
      let vbx = vx[ib]
      let vby = vy[ib]
      let wb = vw[ib]
      let nx = pm.nx
      let ny = pm.ny
      let tx = pm.tx
      let ty = pm.ty
      let mu = pm.friction
      let jn0 = sm_jn0[k]
      let jt0 = sm_jt0[k]
      // Friction point 0.
      if shapes.finite pm.kt0 and pm.kt0 > 1.0e-12:
        let rvx = (vbx - wb * pm.rb0y) - (vax - wa * pm.ra0y)
        let rvy = (vby + wb * pm.rb0x) - (vay + wa * pm.ra0x)
        let vt = rvx * tx + rvy * ty
        let max_f = mu * jn0
        let new_jt = shapes.safe_clamp (jt0 - vt / pm.kt0) (-max_f) max_f
        let apply_t = new_jt - jt0
        let ix = tx * apply_t
        let iy = ty * apply_t
        let nvax = vax - ima * ix
        let nvay = vay - ima * iy
        let nwa = wa - iia * (pm.ra0x * iy - pm.ra0y * ix)
        let nvbx = vbx + imb * ix
        let nvby = vby + imb * iy
        let nwb = wb + iib * (pm.rb0x * iy - pm.rb0y * ix)
        if shapes.finite nvax and shapes.finite nvay and shapes.finite nwa and shapes.finite nvbx and shapes.finite nvby and shapes.finite nwb:
          vax := nvax
          vay := nvay
          wa := nwa
          vbx := nvbx
          vby := nvby
          wb := nwb
        jt0 := new_jt
      sm_jt0[k] := jt0
      if pm.count >= 2:
        let jn1 = sm_jn1[k]
        let jt1 = sm_jt1[k]
        // Friction point 1.
        if shapes.finite pm.kt1 and pm.kt1 > 1.0e-12:
          let rvx = (vbx - wb * pm.rb1y) - (vax - wa * pm.ra1y)
          let rvy = (vby + wb * pm.rb1x) - (vay + wa * pm.ra1x)
          let vt = rvx * tx + rvy * ty
          let max_f = mu * jn1
          let new_jt = shapes.safe_clamp (jt1 - vt / pm.kt1) (-max_f) max_f
          let apply_t = new_jt - jt1
          let ix = tx * apply_t
          let iy = ty * apply_t
          let nvax = vax - ima * ix
          let nvay = vay - ima * iy
          let nwa = wa - iia * (pm.ra1x * iy - pm.ra1y * ix)
          let nvbx = vbx + imb * ix
          let nvby = vby + imb * iy
          let nwb = wb + iib * (pm.rb1x * iy - pm.rb1y * ix)
          if shapes.finite nvax and shapes.finite nvay and shapes.finite nwa and shapes.finite nvbx and shapes.finite nvby and shapes.finite nwb:
            vax := nvax
            vay := nvay
            wa := nwa
            vbx := nvbx
            vby := nvby
            wb := nwb
          jt1 := new_jt
        sm_jt1[k] := jt1
        if pm.use_block:
          let rvx0 = (vbx - wb * pm.rb0y) - (vax - wa * pm.ra0y)
          let rvy0 = (vby + wb * pm.rb0x) - (vay + wa * pm.ra0x)
          let rvx1 = (vbx - wb * pm.rb1y) - (vax - wa * pm.ra1y)
          let rvy1 = (vby + wb * pm.rb1x) - (vay + wa * pm.ra1x)
          let vn0 = rvx0 * nx + rvy0 * ny - pm.bias0
          let vn1 = rvx1 * nx + rvy1 * ny - pm.bias1
          let b0 = vn0 - (pm.k00 * jn0 + pm.k01 * jn1)
          let b1 = vn1 - (pm.k01 * jn0 + pm.k11 * jn1)
          let x0 = 0.0
          let x1 = 0.0
          let solved = false
          let c0 = (-(pm.k11 * b0 - pm.k01 * b1)) * pm.inv_det
          let c1 = (-((-pm.k01) * b0 + pm.k00 * b1)) * pm.inv_det
          if c0 >= 0.0 and c1 >= 0.0:
            x0 := c0
            x1 := c1
            solved := true
          if not solved:
            let s0 = (-b0) / pm.k00
            if s0 >= 0.0 and pm.k01 * s0 + b1 >= 0.0:
              x0 := s0
              x1 := 0.0
              solved := true
          if not solved:
            let s1 = (-b1) / pm.k11
            if s1 >= 0.0 and pm.k01 * s1 + b0 >= 0.0:
              x0 := 0.0
              x1 := s1
              solved := true
          let d0 = x0 - jn0
          let d1 = x1 - jn1
          let ix0 = nx * d0
          let iy0 = ny * d0
          let nvax0 = vax - ima * ix0
          let nvay0 = vay - ima * iy0
          let nwa0 = wa - iia * (pm.ra0x * iy0 - pm.ra0y * ix0)
          let nvbx0 = vbx + imb * ix0
          let nvby0 = vby + imb * iy0
          let nwb0 = wb + iib * (pm.rb0x * iy0 - pm.rb0y * ix0)
          if shapes.finite nvax0 and shapes.finite nvay0 and shapes.finite nwa0 and shapes.finite nvbx0 and shapes.finite nvby0 and shapes.finite nwb0:
            vax := nvax0
            vay := nvay0
            wa := nwa0
            vbx := nvbx0
            vby := nvby0
            wb := nwb0
          let ix1 = nx * d1
          let iy1 = ny * d1
          let nvax1 = vax - ima * ix1
          let nvay1 = vay - ima * iy1
          let nwa1 = wa - iia * (pm.ra1x * iy1 - pm.ra1y * ix1)
          let nvbx1 = vbx + imb * ix1
          let nvby1 = vby + imb * iy1
          let nwb1 = wb + iib * (pm.rb1x * iy1 - pm.rb1y * ix1)
          if shapes.finite nvax1 and shapes.finite nvay1 and shapes.finite nwa1 and shapes.finite nvbx1 and shapes.finite nvby1 and shapes.finite nwb1:
            vax := nvax1
            vay := nvay1
            wa := nwa1
            vbx := nvbx1
            vby := nvby1
            wb := nwb1
          sm_jn0[k] := x0
          sm_jn1[k] := x1
        else:
          if shapes.finite pm.kn0 and pm.kn0 > 1.0e-12:
            let rvx = (vbx - wb * pm.rb0y) - (vax - wa * pm.ra0y)
            let rvy = (vby + wb * pm.rb0x) - (vay + wa * pm.ra0x)
            let vn = rvx * nx + rvy * ny
            let new_jn = max (jn0 - (vn - pm.bias0) / pm.kn0) 0.0
            let apply_n = new_jn - jn0
            let ix = nx * apply_n
            let iy = ny * apply_n
            let nvax = vax - ima * ix
            let nvay = vay - ima * iy
            let nwa = wa - iia * (pm.ra0x * iy - pm.ra0y * ix)
            let nvbx = vbx + imb * ix
            let nvby = vby + imb * iy
            let nwb = wb + iib * (pm.rb0x * iy - pm.rb0y * ix)
            if shapes.finite nvax and shapes.finite nvay and shapes.finite nwa and shapes.finite nvbx and shapes.finite nvby and shapes.finite nwb:
              vax := nvax
              vay := nvay
              wa := nwa
              vbx := nvbx
              vby := nvby
              wb := nwb
            sm_jn0[k] := new_jn
          if shapes.finite pm.kn1 and pm.kn1 > 1.0e-12:
            let rvx = (vbx - wb * pm.rb1y) - (vax - wa * pm.ra1y)
            let rvy = (vby + wb * pm.rb1x) - (vay + wa * pm.ra1x)
            let vn = rvx * nx + rvy * ny
            let new_jn = max (jn1 - (vn - pm.bias1) / pm.kn1) 0.0
            let apply_n = new_jn - jn1
            let ix = nx * apply_n
            let iy = ny * apply_n
            let nvax = vax - ima * ix
            let nvay = vay - ima * iy
            let nwa = wa - iia * (pm.ra1x * iy - pm.ra1y * ix)
            let nvbx = vbx + imb * ix
            let nvby = vby + imb * iy
            let nwb = wb + iib * (pm.rb1x * iy - pm.rb1y * ix)
            if shapes.finite nvax and shapes.finite nvay and shapes.finite nwa and shapes.finite nvbx and shapes.finite nvby and shapes.finite nwb:
              vax := nvax
              vay := nvay
              wa := nwa
              vbx := nvbx
              vby := nvby
              wb := nwb
            sm_jn1[k] := new_jn
      else:
        if shapes.finite pm.kn0 and pm.kn0 > 1.0e-12:
          let rvx = (vbx - wb * pm.rb0y) - (vax - wa * pm.ra0y)
          let rvy = (vby + wb * pm.rb0x) - (vay + wa * pm.ra0x)
          let vn = rvx * nx + rvy * ny
          let new_jn = max (jn0 - (vn - pm.bias0) / pm.kn0) 0.0
          let apply_n = new_jn - jn0
          let ix = nx * apply_n
          let iy = ny * apply_n
          let nvax = vax - ima * ix
          let nvay = vay - ima * iy
          let nwa = wa - iia * (pm.ra0x * iy - pm.ra0y * ix)
          let nvbx = vbx + imb * ix
          let nvby = vby + imb * iy
          let nwb = wb + iib * (pm.rb0x * iy - pm.rb0y * ix)
          if shapes.finite nvax and shapes.finite nvay and shapes.finite nwa and shapes.finite nvbx and shapes.finite nvby and shapes.finite nwb:
            vax := nvax
            vay := nvay
            wa := nwa
            vbx := nvbx
            vby := nvby
            wb := nwb
          sm_jn0[k] := new_jn
      if ima > 0.0:
        vx[ia] := vax
        vy[ia] := vay
        vw[ia] := wa
      if imb > 0.0:
        vx[ib] := vbx
        vy[ib] := vby
        vw[ib] := wb
  // Write solved velocities back to awake dynamic bodies once.
  for i in 0 .. n:
    if inv_m[i] > 0.0 or inv_i[i] > 0.0:
      cur[i] := shapes.body_with_vel ($Vec2 { x: vx[i], y: vy[i] }) vw[i] cur[i]
  // 6. Resolve bullet impacts before integrating any body poses.
  if cfg.enable_ccd and has_bullet:
    cur := integrate_ccd dt joint_list self
  else:
    for i in 0 .. n:
      let b = cur[i]
      if b.inv_mass > 0.0 and not b.asleep:
        cur[i] := advance_pose b (step_motion dt b)
  // 7. Positional correction (Baumgarte contact depenetration + rigid joint projection).
  let pos_iters = min cfg.pos_iterations 16
  let baum = shapes.safe_clamp cfg.baumgarte 0.0 0.8
  let slop = shapes.safe_nonneg cfg.slop
  for _ in 0 .. pos_iters:
    for ji in 0 .. joint_list.length:
      let j = joint_list[ji]
      if j.a < n and j.b < n and j.a != j.b:
        let (a1, b1) = joints.solve_joint_position j cur[j.a] cur[j.b]
        cur[j.a] := a1
        cur[j.b] := b1
    for pi in 0 .. solid_pairs.length:
      let pr = solid_pairs[pi]
      let ba = cur[pr.a]
      let bb = cur[pr.b]
      let im = ba.inv_mass + bb.inv_mass
      if im > 0.0 and (not ba.asleep or not bb.asleep):
        case narrowphase.collide_bodies pr.a ba pr.b bb of
          $Some m => do:
            if not m.is_trigger and not (one_way_ignore ba bb m.normal):
              let max_pen = if m.count >= 2 then max m.p0.penetration m.p1.penetration else m.p0.penetration
              let excess = max (max_pen - slop) 0.0
              if excess > 0.0:
                let corr = shapes.scale2 (baum * excess / im) m.normal
                let pa = shapes.sub2 ba.pos (shapes.scale2 ba.inv_mass corr)
                let pb = shapes.add2 bb.pos (shapes.scale2 bb.inv_mass corr)
                if shapes.finite_v2 pa and shapes.finite_v2 pb:
                  cur[pr.a] := shapes.body_with_pose pa ba.angle ba
                  cur[pr.b] := shapes.body_with_pose pb bb.angle bb
          $Nothing => ()
  // 8. Deterministic sleep/wake update.
  let awake_count = 0
  let lin2_eps = cfg.sleep_lin_eps * cfg.sleep_lin_eps
  for i in 0 .. n:
    let b = cur[i]
    if b.inv_mass > 0.0:
      if cfg.enable_sleep:
        let slow = shapes.len_sq2 b.vel <= lin2_eps and abs b.ang_vel <= cfg.sleep_ang_eps
        if slow:
          let t = b.sleep_timer + dt
          if t >= cfg.sleep_time:
            cur[i] := shapes.body_with_sleep true t b
          else:
            cur[i] := shapes.body_with_sleep false t b
            awake_count := self + 1
        else:
          cur[i] := shapes.body_with_sleep false 0.0 b
          awake_count := self + 1
      else:
        awake_count := self + 1
  // 9. Update caller-owned warm-start cache (U32 keys, sorted by feature per pair) and trigger lifecycle state.
  @storage.truncate cache 0
  for k in 0 .. mcount:
    let pm = pmans[k]
    if pm.count >= 2:
      if pm.feature0 <= pm.feature1:
        @storage.push cache ($CachedImpulse2D { body_a: pm.a, body_b: pm.b, feature: pm.feature0, normal_impulse: sm_jn0[k], tangent_impulse: sm_jt0[k] })
        @storage.push cache ($CachedImpulse2D { body_a: pm.a, body_b: pm.b, feature: pm.feature1, normal_impulse: sm_jn1[k], tangent_impulse: sm_jt1[k] })
      else:
        @storage.push cache ($CachedImpulse2D { body_a: pm.a, body_b: pm.b, feature: pm.feature1, normal_impulse: sm_jn1[k], tangent_impulse: sm_jt1[k] })
        @storage.push cache ($CachedImpulse2D { body_a: pm.a, body_b: pm.b, feature: pm.feature0, normal_impulse: sm_jn0[k], tangent_impulse: sm_jt0[k] })
    else:
      @storage.push cache ($CachedImpulse2D { body_a: pm.a, body_b: pm.b, feature: pm.feature0, normal_impulse: sm_jn0[k], tangent_impulse: sm_jt0[k] })
  let (trig_events, next_prev) = triggers.step prev_triggers trig_pairs
  let stats = $StepStats2D { contacts: contact_count, manifolds: mcount, awake_bodies: awake_count }
  return (cur, trig_events, cache, next_prev, stats)

// Stateless convenience entry point for quick simulations without persistent caches or joints.
func step_world (gravity: Vec2) -> (dt: F32) -> (iterations: U32) -> (bodies: #[Body2D]) : (#[Body2D], #[triggers.Pair]) =>
  let cfg0 = default_config gravity
  let cfg = $WorldConfig2D {
    gravity: cfg0.gravity,
    iterations,
    pos_iterations: 3,
    cell_size: 2.0,
    baumgarte: 0.25,
    slop: 0.005,
    enable_sleep: false,
    sleep_lin_eps: 0.04,
    sleep_ang_eps: 0.04,
    sleep_time: 0.5,
    enable_ccd: true,
    warm_start_scale: 0.0,
  }
  let cache: #[CachedImpulse2D] = #[]
  let prev: #[triggers.Pair] = #[]
  let (out_bodies, _, _, next_pairs, _) = step cfg dt bodies #[] cache prev
  return (out_bodies, next_pairs)
