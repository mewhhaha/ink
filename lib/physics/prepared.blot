import * as changes from "../changes"
import * as array from "std/array"
import * as math from "../math"
import * as physics from "../physics"
import * as scene from "./scene"
import * as sort from "../sort"
import { Vec3 } from "std/vector"
import * as spatial from "../spatial"
import * as joints from "./joints"
import * as shapes from "./shapes"

// Prepared authored geometry lives in separately named caller-owned pools.
// Static is an invocation read: its views end before a changed-key refresh.
// Bodies supplied to simulate remain caller-owned; joint endpoints address
// [moving sources, fixed sources], including authored noncollider anchors.
type Key = { lineage: U32, revision: U32 }
type State = { ready: Bool, revision: Key }
const initial: State = {ready: false, revision: {lineage: 0, revision: 0}}
type Access is data = $Access {
  state: State, sources: #[scene.SourceRow],
  scene: scene.Scene, ids: #[U32], by_id: #[U32],
}
type Static is data = $Static { revision: Key, sources: &[scene.SourceRow], scene: scene.Read, ids: &[U32], by_id: &[U32] }
func read (destination: Access): Static =>
  if not destination.state.ready:
    return panic "prepared geometry has not been built"
  return $Static {revision: destination.state.revision,
    sources: destination.sources.view 0 destination.sources.length,
    scene: scene.read destination.scene,
    ids: destination.ids.view 0 destination.ids.length,
    by_id: destination.by_id.view 0 destination.by_id.length}
func admissible (sources: #[scene.Source]) =>
  for source in sources:
    if Maybe.is_some source.walker:
      return false
    if let $Some body = source.rigid:
      let fixed = case body.kind of
        $scene.Static => true
        _ => false
      if not fixed:
        return false
  return true
func valid (revision: Key) -> (fixed: Static) => return
  fixed.revision.lineage == revision.lineage and fixed.revision.revision == revision.revision
// A caller supplies independent authored inputs. Reusing a destination is an
// explicit structural boundary: no old Static/shape view survives it. Copy all
// nested source geometry into these owners; restoring starts a new lineage.
func prepare_into (revision: Key) -> (sources: #[scene.Source]) -> (destination: own Access) : Access =>
  if not (admissible sources):
    return panic "prepared geometry requires static sources"
  destination.scene.geometry := shapes.clear self
  destination.scene := scene.build_into self sources
  @storage.truncate destination.sources 0
  for source in sources:
    let (row, next_geom) = scene.pack_source destination.scene.geometry source
    destination.scene.geometry := next_geom
    @storage.push destination.sources row
  let keys: #[U32] = array.fill (scene.count destination.scene) 0
  for i in 0 .. keys.length:
    keys[i] := (scene.proxy destination.scene i).id
  let order: #[U32] = sort.order_u32 keys
  @storage.truncate destination.ids 0
  @storage.truncate destination.by_id 0
  for key in keys:
    @storage.push destination.ids key
  for index in order:
    @storage.push destination.by_id index
  destination.state := {ready: true, revision}
  return destination
func refresh_into (revision: Key) -> (sources: #[scene.Source]) -> (destination: own Access) : Access =>
  let state = destination.state
  if state.ready and state.revision.lineage == revision.lineage and state.revision.revision == revision.revision:
    return destination
  return prepare_into revision sources destination
func find (fixed: Static) => func id =>
  let low = 0
  let high = fixed.ids.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if fixed.ids[fixed.by_id[middle]] < id:
      low := middle + 1
    else:
      high := middle
  if low < fixed.ids.length:
    let index = fixed.by_id[low]
    if fixed.ids[index] == id:
      return $Some index
  return $Nothing

// Static source slots, in authored order. Explicit joint endpoints are included
// even when they have no collider, so anchors retain their original poses.
func select (fixed: Static) => func (proxies: #[scene.ProxyRow]) => func (velocities: #[Vec3]) => func (seconds: F32) => func (cache: physics.Cache) => func (moving_count: U32) => func (links: #[joints.Joint]) =>
  let candidates: #[U32] = #[]
  for i in 0 .. proxies.length:
    let p = proxies[i]
    let v = velocities[i]
    let speed = sqrt (v.x * v.x + v.y * v.y + v.z * v.z)
    let grow = if is_finite speed and is_finite (speed * seconds * 2.0) then 0.04 + speed * seconds * 2.0 else 0.04
    let low = math.vec3 (p.low.x - grow) (p.low.y - grow) (p.low.z - grow)
    let high = math.vec3 (p.high.x + grow) (p.high.y + grow) (p.high.z + grow)
    for index in spatial.query fixed.scene.index low high:
      @storage.push candidates (scene.proxy fixed.scene index).source
  for contact in cache.contacts:
    if let $Some index = find fixed contact.a:
      @storage.push candidates (scene.proxy fixed.scene index).source
    if let $Some index = find fixed contact.b:
      @storage.push candidates (scene.proxy fixed.scene index).source
  for link in links:
    let a_ok = link.a < moving_count or link.a - moving_count < fixed.sources.length
    let b_ok = link.b < moving_count or link.b - moving_count < fixed.sources.length
    if joints.valid link and a_ok and b_ok:
      if link.a >= moving_count:
        @storage.push candidates (link.a - moving_count)
      if link.b >= moving_count:
        @storage.push candidates (link.b - moving_count)
  return changes.unique candidates

func remap (moving: U32) => func (selected: #[U32]) => func (source: U32) =>
  if source < moving:
    return source
  let target = source - moving
  let low = 0
  let high = selected.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if selected[middle] < target:
      low := middle + 1
    else:
      high := middle
  if low < selected.length and selected[low] == target:
    return moving + low
  return moving + selected.length
func copy_geometry (g: shapes.Geometry) : shapes.Geometry => $shapes.Geometry {
  points: copy g.points, planes: copy g.planes, rings: copy g.rings,
  indices: copy g.indices, heights: copy g.heights, source_planes: copy g.source_planes,
}
func pack_proxy_step (p: scene.Proxy) -> (acc: own (shapes.Geometry, #[scene.ProxyRow])) : (shapes.Geometry, #[scene.ProxyRow]) =>
  let (geom, rows) = acc
  let (packed, next_geom) = scene.pack_proxy geom p
  @storage.push rows packed
  return (next_geom, rows)
func select_for_cache (fixed: Static) -> (walk: physics.Walkers) -> (seconds: F32) -> (cache: physics.CacheAccess) -> (moving_count: U32) -> (links: #[joints.Joint]) : #[U32] =>
  let c = physics.read_cache cache
  return select fixed walk.proxies walk.velocities seconds c moving_count links
func run_prepared_step (fixed: Static) -> (links: #[joints.Joint]) -> (config: physics.Config) -> (seconds: F32) -> (source_rows: &[scene.SourceRow]) -> (step_geom: shapes.Geometry) -> (cache: own physics.CacheAccess) -> (results: own #[physics.Result]) : (Bool, physics.CacheAccess, #[physics.Result]) =>
  let moving = scene.source_values step_geom source_rows
  let built = scene.build_into (scene.empty ()) moving
  let queries = scene.together (scene.queries built) (scene.single fixed.scene)
  let (walk_geom, walk) = physics.run_walkers queries moving built seconds
  let selected = select_for_cache fixed walk seconds cache moving.length links
  let sources = array.generate (moving.length + selected.length) (func i => return
    if i < moving.length then moving[i] else scene.unpack_source fixed.scene.geometry fixed.sources[selected[i - moving.length]])
  let shaped: #[U32] = #[]
  for i in 0 .. selected.length:
    if fixed.scene.slots[selected[i]] < (scene.count fixed.scene):
      @storage.push shaped i
  let pack_acc = (copy_geometry built.geometry, copy built.proxies)
  for j in 0 .. shaped.length:
    let selected_at = shaped[j]
    let p = scene.proxy fixed.scene fixed.scene.slots[selected[selected_at]]
    p.source := moving.length + selected_at
    pack_acc := pack_proxy_step p self
  let (work_geom, rows) = pack_acc
  let slots = array.fill sources.length rows.length
  for i in 0 .. rows.length:
    slots[rows[i].source] := i
  // Queries use the original independent indexes. This private work scene only
  // supplies the solver's source/proxy mapping and needs no rebuilt BVH.
  let bounds: #[F32] = #[]
  let order: #[U32] = #[]
  let leaves: #[U32] = #[]
  let index = spatial.build_into (spatial.access 0 bounds order leaves) #[]
  let work = $scene.Scene {geometry: work_geom, proxies: rows, index,
    slots, source_count: sources.length}
  let mapped = array.map (func (link: joints.Joint) =>
    link.a := remap moving.length selected self
    link.b := remap moving.length selected self
    return link) links
  let expanded = physics.extend_walkers walk sources work
  return physics.simulate_walked_into queries mapped config seconds sources work cache results walk_geom expanded
func simulate_joints_into (fixed: Static) -> (links: #[joints.Joint]) -> (config: physics.Config) -> (seconds: F32) -> (step: own physics.StepAccess) : physics.StepAccess =>
  if not (seconds > 0.0 and is_finite seconds):
    @storage.truncate step.results 0
    return step
  let $physics.StepAccess { sources: source_rows, geometry: step_geom, cache, results } = step
  let (solved, cache, results) = run_prepared_step fixed links config seconds (&source_rows[0..source_rows.length]) step_geom cache results
  return physics.swap_cache solved ($physics.StepAccess { sources: source_rows, geometry: step_geom, cache, results })
func simulate_into (fixed: Static) -> (config: physics.Config) -> (seconds: F32) -> (step: own physics.StepAccess) : physics.StepAccess => return
  simulate_joints_into fixed #[] config seconds step
