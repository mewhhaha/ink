import * as changes from "../changes"
import * as array from "std/array"
import * as math from "../math"
import * as physics from "../physics"
import * as scene from "../scene"
import * as sort from "../sort"
import { Vec3 } from "std/vector"
import * as spatial from "../spatial"
import * as joints from "../joints"
import * as shapes from "../shapes"

// Prepared authored geometry lives in separately named caller-owned pools.
// Static is an invocation read: its views end before a changed-key refresh.
// Bodies supplied to simulate remain caller-owned; joint endpoints address
// [moving sources, fixed sources], including authored noncollider anchors.
type Key = { lineage: U32, revision: U32 }
type State = { ready: Bool, revision: Key }
const initial: State = {ready: false, revision: {lineage: 0, revision: 0}}
type Access is data = $Access {
  state: State, sources: ResizeArray scene.SourceRow,
  scene: scene.Scene, ids: ResizeArray U32, by_id: ResizeArray U32,
}
type Static is data = $Static { revision: Key, sources: &[scene.SourceRow], scene: scene.Read, ids: &[U32], by_id: &[U32] }
func read (destination: Access): Static => return do:
  if Bool.not destination.state.ready:
    return @panic "prepared geometry has not been built"
  return $Static {revision: destination.state.revision,
    sources: destination.sources.view 0 destination.sources.length,
    scene: scene.read destination.scene,
    ids: destination.ids.view 0 destination.ids.length,
    by_id: destination.by_id.view 0 destination.by_id.length}
func admissible (sources: Array scene.Source) => return do:
  for source in sources:
    if Maybe.is_some source.walker:
      return false
    if let $Some body = source.rigid:
      let fixed = case body.kind of
        $scene.Static => true
        _ => false
      if Bool.not fixed:
        return false
  return true
func valid (revision: Key) -> (fixed: Static) => return
  fixed.revision.lineage == revision.lineage and fixed.revision.revision == revision.revision
// A caller supplies independent authored inputs. Reusing a destination is an
// explicit structural boundary: no old Static/shape view survives it. Copy all
// nested source geometry into these owners; restoring starts a new lineage.
func prepare_into (revision: Key) -> (sources: Array scene.Source) -> (destination: own Access) : Access => return do:
  if Bool.not (admissible sources):
    return @panic "prepared geometry requires static sources"
  shapes.clear destination.scene.geometry
  destination.scene := scene.build_into self sources
  destination.sources.truncate 0
  for source in sources:
    destination.sources.push (scene.pack_source destination.scene.geometry source)
  let keys: Array U32 = array.fill (scene.count destination.scene) 0
  for i in 0 .. keys.length:
    keys[i] := (scene.proxy destination.scene i).id
  let order: Array U32 = sort.order_u32 keys
  destination.ids.truncate 0
  destination.by_id.truncate 0
  for key in keys:
    destination.ids.push key
  for index in order:
    destination.by_id.push index
  destination.state := {ready: true, revision}
  return destination
func refresh_into (revision: Key) -> (sources: Array scene.Source) -> (destination: own Access) : Access => return do:
  let state = destination.state
  if state.ready and state.revision.lineage == revision.lineage and state.revision.revision == revision.revision:
    return destination
  return prepare_into revision sources destination
func find (fixed: Static) => return func id => return do:
  let low = 0
  let high = fixed.ids.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if fixed.ids[fixed.by_id[middle]] < id:
      low := middle + 1
    else:
      high := middle
  if low < fixed.ids.length:
    let index = fixed.by_id[low]
    if fixed.ids[index] == id:
      return $Some index
  return $Nothing

// Static source slots, in authored order. Explicit joint endpoints are included
// even when they have no collider, so anchors retain their original poses.
func select (fixed: Static) => return func (proxies: Array scene.Proxy) => return func (velocities: Array Vec3) => return func (seconds: F32) => return func (cache: physics.Cache) => return func (moving_count: U32) => return func (links: Array joints.Joint) => return do:
  let candidates: GrowArray U32 = #[]
  for i in 0 .. proxies.length:
    let p = proxies[i]
    let v = velocities[i]
    let speed = sqrt (v.x * v.x + v.y * v.y + v.z * v.z)
    let grow = 0.04 + speed * seconds * 2.0
    let low = math.vec3 (p.low.x - grow) (p.low.y - grow) (p.low.z - grow)
    let high = math.vec3 (p.high.x + grow) (p.high.y + grow) (p.high.z + grow)
    for index in spatial.query fixed.scene.index low high:
      candidates.push (scene.proxy fixed.scene index).source
  for contact in cache.contacts:
    if let $Some index = find fixed contact.a:
      candidates.push (scene.proxy fixed.scene index).source
    if let $Some index = find fixed contact.b:
      candidates.push (scene.proxy fixed.scene index).source
  for link in links:
    if joints.valid link and link.a < moving_count + fixed.sources.length and link.b < moving_count + fixed.sources.length:
      if link.a >= moving_count:
        candidates.push (link.a - moving_count)
      if link.b >= moving_count:
        candidates.push (link.b - moving_count)
  return changes.unique ((@storage.freeze candidates))

// The walker pass is handed on to the consumer untouched.
func with_assembled (fixed: Static) -> (moving: Array scene.Source) -> (built: scene.Scene) -> (selected: Array U32) -> (walk: own physics.Walkers) -> consume => return do:
  let sources = array.generate (moving.length + selected.length) (func i => return
    if i < moving.length then moving[i] else scene.unpack_source fixed.scene.geometry fixed.sources[selected[i - moving.length]])
  let shaped: GrowArray U32 = #[]
  for i in 0 .. selected.length:
    if fixed.scene.slots[selected[i]] < (scene.count fixed.scene):
      shaped.push i
  let shaped = (@storage.freeze shaped)
  let first = (scene.count built)
  let proxies = array.generate (first + shaped.length) (func i => return do:
    if i < first:
      return (scene.proxy built i)
    let selected_at = shaped[i - first]
    let proxy = (scene.proxy fixed.scene fixed.scene.slots[selected[selected_at]])
    proxy.source := moving.length + selected_at
    return proxy)
  let slots = array.fill sources.length proxies.length
  for i in 0 .. proxies.length:
    slots[proxies[i].source] := i
  // Queries use the original independent indexes. This private work scene only
  // supplies the solver's source/proxy mapping and needs no rebuilt BVH.
  let rows: ResizeArray scene.ProxyRow = spatial.owned (array.map (scene.pack_proxy built.geometry) proxies)
  let source_slots: ResizeArray U32 = spatial.owned slots
  let bounds: ResizeArray F32 = #[]
  let order: ResizeArray U32 = #[]
  let leaves: ResizeArray U32 = #[]
  let index = spatial.build_into (spatial.access 0 bounds order leaves) #[]
  let work = $scene.Scene {geometry: built.geometry, proxies: rows, index,
    slots: source_slots, source_count: sources.length}
  return consume sources work (own walk)
func remap (moving: U32) => return func (selected: Array U32) => return func (source: U32) => return do:
  if source < moving:
    return source
  let target = source - moving
  let low = 0
  let high = selected.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if selected[middle] < target:
      low := middle + 1
    else:
      high := middle
  if low < selected.length and selected[low] == target:
    return moving + low
  return moving + selected.length
func simulate_joints_into (fixed: Static) -> (links: Array joints.Joint) -> (config: physics.Config) -> (seconds: F32) -> (step: own physics.StepAccess) : physics.StepAccess => return do:
  if Bool.not (seconds > 0.0 and is_finite seconds):
    step.results.truncate 0
    return step
  let solved = physics.with_sources step (func moving => return scene.with_built moving (func built => return do:
    let queries = scene.together (scene.queries built) (scene.single fixed.scene)
    return physics.with_walkers queries moving built seconds (func geometry -> (own walk) => return do:
      // Finish each bank read before writing its disjoint successor.
      let selected = if step.cache.first_active then select fixed walk.proxies walk.velocities seconds ($physics.Cache {contacts: step.cache.first.view 0 step.cache.first.length}) moving.length links else select fixed walk.proxies walk.velocities seconds ($physics.Cache {contacts: step.cache.second.view 0 step.cache.second.length}) moving.length links
      return with_assembled fixed moving built selected walk (func sources -> sc -> (own walk) => return do:
        let mapped = array.map (func (link: joints.Joint) => return do:
          link.a := remap moving.length selected self
          link.b := remap moving.length selected self
          return link) links
        return physics.with_extended_walkers walk sources sc (func (own expanded) => return
          physics.simulate_walked_into queries mapped config seconds sources sc step geometry expanded)))))
  return physics.swap_cache solved step
func simulate_into (fixed: Static) -> (config: physics.Config) -> (seconds: F32) -> (step: own physics.StepAccess) : physics.StepAccess => return
  simulate_joints_into fixed #[] config seconds step
