import * as changes from "../changes"
import * as array from "std/array"
import * as pages from "../pages"
import * as math from "../math"
import * as physics from "../physics"
import * as scene from "../scene"
import * as sort from "../sort"
import { Vec3 } from "std/vector"
import * as spatial from "../spatial"
import * as joints from "../joints"

// Immutable authored colliders. Bodies supplied to simulate remain caller-owned;
// result.source and joint indices address [moving sources, fixed sources].
// Fixed sources never produce movement results. Rebuild this value when static
// geometry changes; old prepared worlds and contact caches remain usable.
type Static is data = #Static { sources: Array scene.Source, scene: scene.Scene, ids: Array U32, by_id: Array U32 }
const prepare = fn (sources: Array scene.Source) => do:
  for source in sources:
    if Maybe.is_some source.walker:
      return #Nothing
    if let #Some body = source.rigid:
      let fixed = case body.kind of
        #scene.Static => #True
        _ => #False
      if Bool.not fixed:
        return #Nothing
  let built = scene.build sources
  let ids = array.map (fn (p: scene.Proxy) => p.id) (scene.proxies built)
  return #Some (#Static { sources, scene: built, ids, by_id: sort.order_u32 ids })
const find = fn (fixed: Static) => fn id => do:
  let low = 0
  let high = fixed.ids.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if fixed.ids[fixed.by_id[middle]] < id:
      low := middle + 1
    else:
      high := middle
  if low < fixed.ids.length:
    let index = fixed.by_id[low]
    if fixed.ids[index] == id:
      return #Some index
  return #Nothing

// Static source slots, in authored order. Explicit joint endpoints are included
// even when they have no collider, so anchors retain their original poses.
const select = fn (fixed: Static) => fn (proxies: Array scene.Proxy) => fn (velocities: Array Vec3) => fn (seconds: F32) => fn (cache: physics.Cache) => fn (moving_count: U32) => fn (links: Array joints.Joint) => do:
  let candidates: List U32 = []
  for i in 0 .. proxies.length:
    let p = proxies[i]
    let v = velocities[i]
    let speed = sqrt (v.x * v.x + v.y * v.y + v.z * v.z)
    let grow = 0.04 + speed * seconds * 2.0
    let low = math.vec3 (p.low.x - grow) (p.low.y - grow) (p.low.z - grow)
    let high = math.vec3 (p.high.x + grow) (p.high.y + grow) (p.high.z + grow)
    for index in spatial.query fixed.scene.index low high:
      candidates := [...self, (scene.proxy fixed.scene index).source]
  for contact in cache.contacts:
    if let #Some index = find fixed contact.a:
      candidates := [...self, (scene.proxy fixed.scene index).source]
    if let #Some index = find fixed contact.b:
      candidates := [...self, (scene.proxy fixed.scene index).source]
  for link in links:
    if joints.valid link && link.a < moving_count + fixed.sources.length && link.b < moving_count + fixed.sources.length:
      if link.a >= moving_count:
        candidates := [...self, link.a - moving_count]
      if link.b >= moving_count:
        candidates := [...self, link.b - moving_count]
  return changes.unique (Array.from_list candidates)

const assemble = fn (fixed: Static) => fn (moving: Array scene.Source) => fn (built: scene.Scene) => fn (selected: Array U32) => do:
  let sources = array.generate (moving.length + selected.length) (fn i =>
    if i < moving.length then moving[i] else fixed.sources[selected[i - moving.length]])
  let shaped: List U32 = []
  for i in 0 .. selected.length:
    if fixed.scene.slots[selected[i]] < (scene.count fixed.scene):
      shaped := [...self, i]
  let shaped = Array.from_list shaped
  let first = (scene.count built)
  let proxies = array.generate (first + shaped.length) (fn i => do:
    if i < first:
      return (scene.proxy built i)
    let selected_at = shaped[i - first]
    let proxy = (scene.proxy fixed.scene fixed.scene.slots[selected[selected_at]])
    proxy.source := moving.length + selected_at
    return proxy)
  let slots = array.fill sources.length proxies.length
  for i in 0 .. proxies.length:
    slots[proxies[i].source] := i
  // Queries use the original independent indexes. This private work scene only
  // supplies the solver's source/proxy mapping and needs no rebuilt BVH.
  return (sources, #scene.Scene { proxies: pages.from proxies, index: spatial.build #[], slots, source_count: sources.length })
const remap = fn (moving: U32) => fn (selected: Array U32) => fn (source: U32) => do:
  if source < moving:
    return source
  let target = source - moving
  let low = 0
  let high = selected.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if selected[middle] < target:
      low := middle + 1
    else:
      high := middle
  if low < selected.length && selected[low] == target:
    return moving + low
  return moving + selected.length
const simulate_joints = fn (fixed: Static) => fn (links: Array joints.Joint) => fn config => fn (seconds: F32) => fn (moving: Array scene.Source) => fn cache => do:
  if Bool.not (seconds > 0.0 && is_finite seconds):
    return (#[], cache)
  let built = scene.build moving
  let queries = scene.together (scene.queries built) (scene.queries fixed.scene)
  let walk = physics.move_walkers queries moving built seconds
  let selected = select fixed walk.proxies walk.velocities seconds cache moving.length links
  let (sources, sc) = assemble fixed moving built selected
  let mapped = array.map (fn (link: joints.Joint) => do:
    link.a := remap moving.length selected self
    link.b := remap moving.length selected self
    return link) links
  return physics.simulate_walked queries mapped config seconds sources sc cache (physics.extend_walkers walk sources sc)
const simulate = fn fixed => simulate_joints fixed #[]
