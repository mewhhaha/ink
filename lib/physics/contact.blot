import { Vec3 } from "std/vector"
import { Vec4 } from "../math"
import * as shapes from "./shapes"
import * as mesh from "../mesh"
import { Gap } from "../mesh"
import { Point3, Poly, Shape } from "./shapes"
import * as terrain from "../terrain"
import * as spatial from "../spatial"
import * as math from "../math"

// The narrow phase: contact points between two shapes. A contact has a world
// position, a normal leading from the first shape to the second, and a
// separation: negative when the shapes overlap, positive but within the
// margin when they are close (speculative contacts let a solver stop a body
// exactly at a surface instead of after it has sunk in).

type Contact is data = $Contact { point: Vec3, normal: Vec3, sep: F32 }

func sphere (center: Vec3) -> (radius: F32) => $shapes.Capsule { a: center, b: center, radius }

// Spheres are capsules without a segment: the only round shape.
func is_sphere (shape: Shape) => case shape of
  $shapes.Capsule { a, b } => a.x == b.x and a.y == b.y and a.z == b.z
  $shapes.Hull _ => false
  $shapes.Heightfield _ => false
  $shapes.Mesh _ => false

func flip (c: Contact) => $Contact { point: c.point, normal: shapes.neg c.normal, sep: c.sep }

// Does a contact near this point already exist?
func known (found: #[Contact]) -> (x: F32) -> (y: F32) -> (z: F32) =>
  let result = false
  for c in found:
    let dx = c.point.x - x
    let dy = c.point.y - y
    let dz = c.point.z - z
    if dx * dx + dy * dy + dz * dz < 0.0004:
      result := true
  return result

// The unit vector along (x, y, z), rounded as `Vec3.normalized`.
func unit_xyz (x: F32) -> (y: F32) -> (z: F32) =>
  let length = sqrt (x * x + y * y + z * z)
  if length == 0.0:
    return (x, y, z)
  return (x / length, y / length, z / length)

// Capsule against capsule. Normals lead from the first to the second.
func capsule_capsule (a0: Vec3) -> (a1: Vec3) -> (ra: F32) -> (b0: Vec3) -> (b1: Vec3) -> (rb: F32) -> (margin: F32) =>
  let radius = ra + rb
  let found: #[Contact] = #[]
  let dax = a1.x - a0.x
  let day = a1.y - a0.y
  let daz = a1.z - a0.z
  let dbx = b1.x - b0.x
  let dby = b1.y - b0.y
  let dbz = b1.z - b0.z
  let (s, t) = mesh.segment_params a0.x a0.y a0.z dax day daz b0.x b0.y b0.z dbx dby dbz
  let pax = a0.x + dax * s
  let pay = a0.y + day * s
  let paz = a0.z + daz * s
  let pbx = b0.x + dbx * t
  let pby = b0.y + dby * t
  let pbz = b0.z + dbz * t
  let dx = pbx - pax
  let dy = pby - pay
  let dz = pbz - paz
  let length = sqrt (dx * dx + dy * dy + dz * dz)
  let nx = 0.0
  let ny = 1.0
  let nz = 0.0
  if length > 0.00001:
    nx := dx / length
    ny := dy / length
    nz := dz / length
  if length - radius < margin:
    @storage.push found ($Contact { point: $Vec3 { x: (pax + pbx) * 0.5, y: (pay + pby) * 0.5, z: (paz + pbz) * 0.5 }, normal: $Vec3 { x: nx, y: ny, z: nz }, sep: length - radius })
  // Parallel capsules touch along a stretch: add the end points.
  if dax * dax + day * day + daz * daz > 0.0001 and dbx * dbx + dby * dby + dbz * dbz > 0.0001:
    let (ux, uy, uz) = unit_xyz dax day daz
    let (vx, vy, vz) = unit_xyz dbx dby dbz
    if abs (ux * vx + uy * vy + uz * vz) > 0.95:
      for e in 0..4:
        // Ends of a against b, then ends of b against a.
        let on_a = e < 2
        let end = if e == 0 then a0 else if e == 1 then a1 else if e == 2 then b0 else b1
        let (_, cx, cy, cz) = if on_a then mesh.segment_point_xyz b0.x b0.y b0.z b1.x b1.y b1.z end.x end.y end.z else mesh.segment_point_xyz a0.x a0.y a0.z a1.x a1.y a1.z end.x end.y end.z
        let px = if on_a then end.x else cx
        let py = if on_a then end.y else cy
        let pz = if on_a then end.z else cz
        let qx = if on_a then cx else end.x
        let qy = if on_a then cy else end.y
        let qz = if on_a then cz else end.z
        let ddx = qx - px
        let ddy = qy - py
        let ddz = qz - pz
        let l = sqrt (ddx * ddx + ddy * ddy + ddz * ddz)
        let mx = nx
        let my = ny
        let mz = nz
        if l > 0.00001:
          mx := ddx / l
          my := ddy / l
          mz := ddz / l
        let cpx = (px + qx) * 0.5
        let cpy = (py + qy) * 0.5
        let cpz = (pz + qz) * 0.5
        if l - radius < margin and not (known found cpx cpy cpz):
          @storage.push found ($Contact { point: $Vec3 { x: cpx, y: cpy, z: cpz }, normal: $Vec3 { x: mx, y: my, z: mz }, sep: l - radius })
  return (found)

// The contact for a gap between a capsule's core and a polytope. The
// returned normal leads from the polytope to the capsule.
func gap_contact (gap: Gap) -> (radius: F32) =>
  let n = gap.normal
  let x = (gap.on_shape.x + (gap.on_segment.x - n.x * radius)) * 0.5
  let y = (gap.on_shape.y + (gap.on_segment.y - n.y * radius)) * 0.5
  let z = (gap.on_shape.z + (gap.on_segment.z - n.z * radius)) * 0.5
  return $Contact { point: $Vec3 { x, y, z }, normal: n, sep: gap.dist - radius }

// Capsule against polytope. Normals lead from the polytope to the capsule.
// Is the segment ab farther than `reach` from the plane of some face? Then it
// cannot touch the polytope (a quick test on the face axes alone).
func apart_from_faces (poly: Poly) -> (a: Vec3) -> (b: Vec3) -> (reach: F32) =>
  for plane4 in poly.planes:
    let da = plane4.x * a.x + plane4.y * a.y + plane4.z * a.z - plane4.w
    let db = plane4.x * b.x + plane4.y * b.y + plane4.z * b.z - plane4.w
    if (if da < db then da else db) > reach:
      return true
  return false

func poly_capsule (poly: Poly) -> (a: Vec3) -> (b: Vec3) -> (radius: F32) -> (margin: F32) =>
  if apart_from_faces poly a b (radius + margin):
    return #[]
  let found: #[Contact] = #[]
  let gap = shapes.segment_poly poly a b
  if gap.dist - radius < margin:
    @storage.push found (gap_contact gap radius)
  let ax = b.x - a.x
  let ay = b.y - a.y
  let az = b.z - a.z
  // A capsule lying on a face touches along it: add both end points.
  if ax * ax + ay * ay + az * az > 0.0001:
    let (ux, uy, uz) = unit_xyz ax ay az
    if abs (ux * gap.normal.x + uy * gap.normal.y + uz * gap.normal.z) < 0.35:
      for e in 0..2:
        let p = if e == 0 then a else b
        let (distance, qx, qy, qz, nx, ny, nz) = shapes.poly_point_xyz poly p.x p.y p.z
        if distance - radius < margin:
          let x = (qx + (p.x - nx * radius)) * 0.5
          let y = (qy + (p.y - ny * radius)) * 0.5
          let z = (qz + (p.z - nz * radius)) * 0.5
          if not (known found x y z):
            @storage.push found ($Contact { point: $Vec3 { x, y, z }, normal: $Vec3 { x: nx, y: ny, z: nz }, sep: distance - radius })
  return (found)

// Convex polytopes ----------------------------------------------------------------

// The least and greatest n . v over the vertices.
func support_min (verts: &[shapes.Point3]) -> (nx: F32) -> (ny: F32) -> (nz: F32) =>
  let best = shapes.far
  for v in verts:
    best := min self (nx * v.x + ny * v.y + nz * v.z)
  return best

func support_max (verts: &[shapes.Point3]) -> (nx: F32) -> (ny: F32) -> (nz: F32) =>
  let best = (-1000000000.0)
  for v in verts:
    best := max self (nx * v.x + ny * v.y + nz * v.z)
  return best

// Sutherland-Hodgman: the part of a polygon on the side m . p <= e. Points
// are packed scalar rows.
func clip_polygon (points: #[(F32, F32, F32)]) -> (mx: F32) -> (my: F32) -> (mz: F32) -> (e: F32) =>
  let n = points.length
  let out: #[(F32, F32, F32)] = #[]
  for i in 0..n:
    let (cx, cy, cz) = points[i]
    let (nx, ny, nz) = points[(i + 1) % n]
    let dc = mx * cx + my * cy + mz * cz - e
    let dn = mx * nx + my * ny + mz * nz - e
    if dc <= 0.0:
      @storage.push out ((cx, cy, cz))
      if dn > 0.0:
        let f = dc / (dc - dn)
        @storage.push out ((cx + (nx - cx) * f, cy + (ny - cy) * f, cz + (nz - cz) * f))
    else:
      if dn <= 0.0:
        let f = dc / (dc - dn)
        @storage.push out ((cx + (nx - cx) * f, cy + (ny - cy) * f, cz + (nz - cz) * f))
  return (out)

// The vertices of a face ring as packed scalar rows.
func ring_points (poly: Poly) -> (face: U32) =>
  let ring = poly.rings[face]
  return @array.generate ring.length (func (i: U32) =>
    let v = (poly.verts.at (shapes.ring_vertex poly ring i))
    return (v.x, v.y, v.z))

// Keep at most four contacts: the deepest, the one farthest from it, and the
// two that span the largest area on either side.
func reduce (found: own #[Contact]) -> (n: Vec3) =>
  if found.length <= 4:
    return found
  let first = 0
  for i in 1..found.length:
    if found[i].sep < found[first].sep:
      first := i
  let origin = found[first].point
  let ox = origin.x
  let oy = origin.y
  let oz = origin.z
  let second = first
  let far_d = (-1.0)
  for i in 0..found.length:
    let p = found[i].point
    let dx = p.x - ox
    let dy = p.y - oy
    let dz = p.z - oz
    let d = dx * dx + dy * dy + dz * dz
    if d > far_d:
      far_d := d
      second := i
  let lx = found[second].point.x - ox
  let ly = found[second].point.y - oy
  let lz = found[second].point.z - oz
  let third = first
  let fourth = first
  let high = 0.0
  let low = 0.0
  for i in 0..found.length:
    let p = found[i].point
    let wx = p.x - ox
    let wy = p.y - oy
    let wz = p.z - oz
    let side = n.x * (ly * wz - lz * wy) + n.y * (lz * wx - lx * wz) + n.z * (lx * wy - ly * wx)
    if side > high:
      high := side
      third := i
    if side < low:
      low := side
      fourth := i
  let picks: #[Contact] = #[found[first]]
  if second != first:
    @storage.push picks (found[second])
  if third != first and third != second:
    @storage.push picks (found[third])
  if fourth != first and fourth != second and fourth != third:
    @storage.push picks (found[fourth])
  return (picks)

// Contacts from clipping the incident face against the reference face.
// `reference` owns the face; the normal leads from the reference polytope out.
func face_contacts (reference: Poly) -> (incident: Poly) -> (face: U32) -> (margin: F32) =>
  let plane = reference.planes[face]
  let nx = plane.x
  let ny = plane.y
  let nz = plane.z
  // The incident face: the one facing the reference most directly.
  let inc = 0
  let facing = shapes.far
  for i in 0..incident.planes.length:
    let other = incident.planes[i]
    let d = other.x * nx + other.y * ny + other.z * nz
    if d < facing:
      facing := d
      inc := i
  let ring = incident.rings[inc]
  // Sutherland-Hodgman against each side plane of the reference face, on
  // flat coordinates. A clip emits at most two points per input point.
  let size = ring.length
  let polygon: #[F32] = #[]
  for 0..(size * 3):
    @storage.push polygon 0.0
  let clipped: #[F32] = #[]
  for k in 0..size:
    let v = (incident.verts.at (shapes.ring_vertex incident ring k))
    polygon[k * 3] := v.x
    polygon[k * 3 + 1] := v.y
    polygon[k * 3 + 2] := v.z
  let ref_ring = reference.rings[face]
  let centroid = reference.centers[face]
  let count = ref_ring.length
  for i in 0..count:
    let v0 = (reference.verts.at (shapes.ring_vertex reference ref_ring i))
    let v1 = (reference.verts.at (shapes.ring_vertex reference ref_ring ((i + 1) % count)))
    let ex = v1.x - v0.x
    let ey = v1.y - v0.y
    let ez = v1.z - v0.z
    let (ux, uy, uz) = unit_xyz (ny * ez - nz * ey) (nz * ex - nx * ez) (nx * ey - ny * ex)
    let flip = ux * (centroid.x - v0.x) + uy * (centroid.y - v0.y) + uz * (centroid.z - v0.z) > 0.0
    let mx = if flip then F32.neg ux else ux
    let my = if flip then F32.neg uy else uy
    let mz = if flip then F32.neg uz else uz
    let e = mx * v0.x + my * v0.y + mz * v0.z + 0.00001
    @storage.truncate clipped 0
    for 0..(size * 6):
      @storage.push clipped 0.0
    let out = 0
    for k in 0..size:
      let o = k * 3
      let q = (k + 1) % size * 3
      let cx = polygon[o]
      let cy = polygon[o + 1]
      let cz = polygon[o + 2]
      let qx = polygon[q]
      let qy = polygon[q + 1]
      let qz = polygon[q + 2]
      let dc = mx * cx + my * cy + mz * cz - e
      let dn = mx * qx + my * qy + mz * qz - e
      let behind = dc <= 0.0
      if behind:
        clipped[out * 3] := cx
        clipped[out * 3 + 1] := cy
        clipped[out * 3 + 2] := cz
        out := self + 1
      // The edge crosses the side plane: emit the crossing too.
      if (if behind then dn > 0.0 else dn <= 0.0):
        let f = dc / (dc - dn)
        clipped[out * 3] := cx + (qx - cx) * f
        clipped[out * 3 + 1] := cy + (qy - cy) * f
        clipped[out * 3 + 2] := cz + (qz - cz) * f
        out := self + 1
    @storage.truncate polygon 0
    for value in clipped:
      @storage.push polygon value
    size := out
  let normal = shapes.face_normal plane
  let keep = @array.fill size 0
  let kept = 0
  for k in 0..size:
    if nx * polygon[k * 3] + ny * polygon[k * 3 + 1] + nz * polygon[k * 3 + 2] - plane.w <= margin:
      keep[kept] := k
      kept := self + 1
  if kept > 0:
    let found = @array.generate kept (func (j: U32) =>
      let o = keep[j] * 3
      let px = polygon[o]
      let py = polygon[o + 1]
      let pz = polygon[o + 2]
      let s = nx * px + ny * py + nz * pz - plane.w
      let half = s * 0.5
      return $Contact { point: $Vec3 { x: px - nx * half, y: py - ny * half, z: pz - nz * half }, normal, sep: s })
    return reduce found normal
  // Clipping removed everything (a grazing numerical case): use the
  // deepest vertex of the incident face.
  let deepest = shapes.far
  let at = (incident.verts.at (shapes.ring_vertex incident ring 0))
  for index in 0..ring.length:
    let v = (incident.verts.at (shapes.ring_vertex incident ring index))
    let s = nx * v.x + ny * v.y + nz * v.z - plane.w
    if s < deepest:
      deepest := s
      at := v
  if deepest <= margin:
    let half = deepest * 0.5
    return #[$Contact { point: $Vec3 { x: at.x - nx * half, y: at.y - ny * half, z: at.z - nz * half }, normal, sep: deepest }]
  return #[]

// The extremal vertices of a polytope along n (an edge, a vertex or a face's
// corners): the two farthest apart.
func extreme_edge (poly: Poly) -> (nx: F32) -> (ny: F32) -> (nz: F32) -> (top: F32) =>
  let first = (poly.verts.at (0))
  let found = false
  for v in poly.verts:
    if not found and nx * v.x + ny * v.y + nz * v.z >= top - 0.002:
      first := v
      found := true
  let second = first
  let best = (-1.0)
  for v in poly.verts:
    if nx * v.x + ny * v.y + nz * v.z >= top - 0.002:
      let dx = v.x - first.x
      let dy = v.y - first.y
      let dz = v.z - first.z
      let d = dx * dx + dy * dy + dz * dz
      if d > best:
        best := d
        second := v
  return (first, second)

func array_flip (found: #[Contact]) => @array.generate found.length (func (i: U32) => flip found[i])

// Polytope against polytope by the separating axis theorem. Normals lead from
// `a` to `b`.
func poly_poly (a: Poly) -> (b: Poly) -> (margin: F32) =>
  let best_a = (-1000000000.0)
  let face_a = 0
  for i in 0..a.planes.length:
    let p = a.planes[i]
    let s = support_min b.verts p.x p.y p.z - p.w
    if s > best_a:
      best_a := s
      face_a := i
  if best_a > margin:
    return #[]
  let best_b = (-1000000000.0)
  let face_b = 0
  for i in 0..b.planes.length:
    let p = b.planes[i]
    let s = support_min a.verts p.x p.y p.z - p.w
    if s > best_b:
      best_b := s
      face_b := i
  if best_b > margin:
    return #[]
  let best_e = (-1000000000.0)
  let axis_x = 0.0
  let axis_y = 0.0
  let axis_z = 0.0
  let tx = b.center.x - a.center.x
  let ty = b.center.y - a.center.y
  let tz = b.center.z - a.center.z
  for da in a.dirs:
    for db in b.dirs:
      let cx = da.y * db.z - da.z * db.y
      let cy = da.z * db.x - da.x * db.z
      let cz = da.x * db.y - da.y * db.x
      let length2 = cx * cx + cy * cy + cz * cz
      if length2 > 0.000001:
        let root = sqrt length2
        let n0x = cx / root
        let n0y = cy / root
        let n0z = cz / root
        let away = n0x * tx + n0y * ty + n0z * tz < 0.0
        let nx = if away then F32.neg n0x else n0x
        let ny = if away then F32.neg n0y else n0y
        let nz = if away then F32.neg n0z else n0z
        let s = support_min b.verts nx ny nz - support_max a.verts nx ny nz
        if s > best_e:
          best_e := s
          axis_x := nx
          axis_y := ny
          axis_z := nz
  if best_e > margin:
    return #[]
  let face_best = max best_a (best_b - 0.0005)
  if best_e > face_best + 0.002:
    let top_a = support_max a.verts axis_x axis_y axis_z
    let (a0, a1) = extreme_edge a axis_x axis_y axis_z top_a
    let low_b = support_min b.verts axis_x axis_y axis_z
    let (b0, b1) = extreme_edge b (F32.neg axis_x) (F32.neg axis_y) (F32.neg axis_z) (F32.neg low_b)
    let d1x = a1.x - a0.x
    let d1y = a1.y - a0.y
    let d1z = a1.z - a0.z
    let d2x = b1.x - b0.x
    let d2y = b1.y - b0.y
    let d2z = b1.z - b0.z
    let (s, t) = mesh.segment_params a0.x a0.y a0.z d1x d1y d1z b0.x b0.y b0.z d2x d2y d2z
    let point = $Vec3 {
      x: (a0.x + d1x * s + (b0.x + d2x * t)) * 0.5,
      y: (a0.y + d1y * s + (b0.y + d2y * t)) * 0.5,
      z: (a0.z + d1z * s + (b0.z + d2z * t)) * 0.5,
    }
    return #[$Contact { point, normal: $Vec3 { x: axis_x, y: axis_y, z: axis_z }, sep: best_e }]
  if best_a >= best_b - 0.0005:
    return face_contacts a b face_a margin
  let from_b = face_contacts b a face_b margin
  return array_flip from_b

// Any two shapes -----------------------------------------------------------------

func terrain_capsule (t: terrain.Terrain) -> (a: Vec3) -> (b: Vec3) -> (radius: F32) -> (margin: F32) =>
  let found: #[Contact] = #[]
  let gap = shapes.segment_terrain t a b
  if gap.dist - radius <= margin:
    @storage.push found (gap_contact gap radius)
  if (b - a).length_squared > 0.0001:
    for e in 0..2:
      let p = a
      if e == 1:
        p := b
      let end = shapes.segment_terrain t p p
      if end.dist - radius <= margin:
        let c = gap_contact end radius
        if not (known found c.point.x c.point.y c.point.z):
          @storage.push found (c)
  return reduce ((found)) gap.normal

// The bottom of a convex body at an x/z coordinate. Intersect the vertical
// line with its planes; this also rejects points outside a rotated footprint.
func poly_bottom (poly: Poly) -> (x: F32) -> (z: F32) =>
  if not (is_finite x and is_finite z):
    return $Nothing
  let low = F32.neg shapes.far
  let high = shapes.far
  for p in poly.planes:
    let side = p.w - p.x * x - p.z * z
    if not (is_finite side):
      return $Nothing
    if abs p.y < 0.000001:
      if side < (-0.00001):
        return $Nothing
    else:
      let y = side / p.y
      if not (is_finite y):
        return $Nothing
      if p.y < 0.0:
        low := max self y
      else:
        high := min self y
  if not (is_finite low and is_finite high) or low > high + 0.00001:
    return $Nothing
  return $Some ($Vec3 { x, y: low, z })

// A submerged body near the footprint can leave through a boundary wall.
// Clip its incident face to the finite wall before comparing that escape
// distance with the surface manifold.
func terrain_walls (t: terrain.Terrain) -> (poly: Poly) -> (margin: F32) =>
  let normals = #[math.vec3 1.0 0.0 0.0, math.vec3 (-1.0) 0.0 0.0, math.vec3 0.0 0.0 1.0, math.vec3 0.0 0.0 (-1.0)]
  let best = F32.neg shapes.far
  let found: #[Contact] = #[]
  for n in normals:
    let d = n.dot t.origin + t.half
    let sep = support_min poly.verts n.x n.y n.z - d
    if sep <= margin and sep > best:
      let face = 0
      let toward = shapes.far
      for i in 0..poly.planes.length:
        let side = poly.planes[i]
        let dot = side.x * n.x + side.y * n.y + side.z * n.z
        if dot < toward:
          toward := dot
          face := i
      let along = math.vec3 (abs n.z) 0.0 (abs n.x)
      let reach = along.dot t.origin
      let first_polygon = clip_polygon (ring_points poly face) along.x along.y along.z (reach + t.half)
      let polygon = clip_polygon first_polygon (F32.neg along.x) (F32.neg along.y) (F32.neg along.z) (F32.neg reach + t.half)
      let candidates: #[Contact] = #[]
      for (px, py, pz) in polygon:
        let distance = n.x * px + n.y * py + n.z * pz - d
        let qx = px - n.x * distance
        let qz = pz - n.z * distance
        if py <= terrain.height t qx qz and distance <= margin:
          let qy = py - n.y * distance
          @storage.push candidates ($Contact { point: $Vec3 { x: (px + qx) * 0.5, y: (py + qy) * 0.5, z: (pz + qz) * 0.5 }, normal: n, sep: distance })
      if candidates.length != 0:
        best := sep
        let selected = reduce (candidates) n
        @storage.truncate found 0
        for contact in selected:
          @storage.push found contact
  return found

func terrain_poly (t: terrain.Terrain) -> (poly: Poly) -> (margin: F32) =>
  let found: #[Contact] = #[]
  let (low, high) = shapes.bounds ($shapes.Hull poly)
  let x0 = max low.x (t.origin.x - t.half)
  let x1 = min high.x (t.origin.x + t.half)
  let z0 = max low.z (t.origin.z - t.half)
  let z1 = min high.z (t.origin.z + t.half)
  if x0 > x1 or z0 > z1:
    return terrain_walls t poly margin
  let (_, top) = terrain.range t x0 z0 x1 z1
  if low.y > top + margin:
    return #[]
  // The body's vertices give the full supporting face on flat ground, even
  // when the sampling lattice does not coincide with its corners.
  for v in poly.verts:
    if terrain.inside t v.x v.z:
      if let $Some p = poly_bottom poly v.x v.z:
        if abs (p.y - v.y) < 0.002:
          let q = terrain.ground t p
          let normal = terrain.collision_normal t q.x q.z
          let sep = normal.dot (p - q)
          if sep <= margin:
            @storage.push found ($Contact { point: (p + q) * 0.5, normal, sep })
  // Interior samples catch peaks underneath a face and terrain boundaries
  // under a body wider than the finite footprint.
  let step = terrain.collision_step t
  let span_x = x1 - x0
  let span_z = z1 - z0
  let raw_nx = ceil (span_x / step)
  let raw_nz = ceil (span_z / step)
  let nx: U32 = 1
  let nz: U32 = 1
  if is_finite x0 and is_finite x1 and is_finite z0 and is_finite z1 and is_finite raw_nx and is_finite raw_nz and raw_nx <= 65536.0 and raw_nz <= 65536.0 and max 1.0 raw_nx * max 1.0 raw_nz <= 65536.0:
    nx := max 1 (F32.to_u32 raw_nx)
    nz := max 1 (F32.to_u32 raw_nz)
  else:
    let eff_step = max step (max span_x span_z / 256.0)
    if is_finite eff_step and eff_step > 0.0:
      let sx = ceil (span_x / eff_step)
      let sz = ceil (span_z / eff_step)
      nx := if is_finite sx then max 1 (min 256 (F32.to_u32 sx)) else 1
      nz := if is_finite sz then max 1 (min 256 (F32.to_u32 sz)) else 1
  for iz in 0..(nz + 1):
    let z = F32.lerp z0 z1 (U32.to_f32 iz / U32.to_f32 nz)
    for ix in 0..(nx + 1):
      let x = F32.lerp x0 x1 (U32.to_f32 ix / U32.to_f32 nx)
      if let $Some p = poly_bottom poly x z:
        let q = terrain.ground t p
        let normal = terrain.collision_normal t x z
        let sep = normal.dot (p - q)
        let middle = (p + q) * 0.5
        if sep <= margin and not (known found middle.x middle.y middle.z):
          @storage.push found ($Contact { point: middle, normal, sep })
  let surface = reduce ((found)) shapes.unit_y
  let walls = terrain_walls t poly margin
  if surface.length == 0:
    return walls
  if walls.length > 0:
    let surface_sep = shapes.far
    let wall_sep = shapes.far
    for c in surface:
      surface_sep := min self c.sep
    for c in walls:
      wall_sep := min self c.sep
    if wall_sep > surface_sep + 0.002:
      return walls
  return surface


// Static triangle meshes ------------------------------------------------------------

// The index of an earlier contact that stands for `c`, or the count: within
// the warm-start radius (a cached impulse is matched by position within 0.15 m,
// so contacts of one pair closer than that would share, and double, one
// impulse) and facing the same way.
func similar_contact (found: #[Contact]) -> (c: Contact) : U32 =>
  for i in 0 .. found.length:
    let other = found[i]
    let dx = other.point.x - c.point.x
    let dy = other.point.y - c.point.y
    let dz = other.point.z - c.point.z
    if dx * dx + dy * dy + dz * dz < 0.0144 and other.normal.dot c.normal > 0.95:
      return i
  return found.length

// Keep at most four contacts of a mesh manifold: the deepest (the one farthest
// from the others when several are equally deep), the one farthest from it and
// the two spanning the greatest area on either side of that line.
func reduce_spread (found: own #[Contact]) : #[Contact] =>
  if found.length <= 4:
    return found
  let cx = 0.0
  let cy = 0.0
  let cz = 0.0
  let deepest = shapes.far
  for c in found:
    cx := self + c.point.x
    cy := self + c.point.y
    cz := self + c.point.z
    deepest := min self c.sep
  let share = U32.to_f32 found.length
  cx := self / share
  cy := self / share
  cz := self / share
  let first = 0
  let reach = (-1.0)
  for i in 0 .. found.length:
    let c = found[i]
    if c.sep <= deepest + 0.001:
      let dx = c.point.x - cx
      let dy = c.point.y - cy
      let dz = c.point.z - cz
      let d = dx * dx + dy * dy + dz * dz
      if d > reach:
        reach := d
        first := i
  let normal = found[first].normal
  let origin = found[first].point
  let second = first
  let far_d = (-1.0)
  for i in 0 .. found.length:
    let p = found[i].point
    let dx = p.x - origin.x
    let dy = p.y - origin.y
    let dz = p.z - origin.z
    let d = dx * dx + dy * dy + dz * dz
    if d > far_d:
      far_d := d
      second := i
  let lx = found[second].point.x - origin.x
  let ly = found[second].point.y - origin.y
  let lz = found[second].point.z - origin.z
  let third = first
  let fourth = first
  let high = 0.0
  let low = 0.0
  for i in 0 .. found.length:
    let p = found[i].point
    let wx = p.x - origin.x
    let wy = p.y - origin.y
    let wz = p.z - origin.z
    let side = normal.x * (ly * wz - lz * wy) + normal.y * (lz * wx - lx * wz) + normal.z * (lx * wy - ly * wx)
    if side > high:
      high := side
      third := i
    if side < low:
      low := side
      fourth := i
  let picks: #[Contact] = #[found[first]]
  if second != first:
    @storage.push picks (found[second])
  if third != first and third != second:
    @storage.push picks (found[third])
  if fourth != first and fourth != second and fourth != third:
    @storage.push picks (found[fourth])
  return picks

// The most downward-facing hull face against direction n: the incident face.
func incident_face (poly: Poly) -> (nx: F32) -> (ny: F32) -> (nz: F32) : U32 =>
  let inc = 0
  let facing = shapes.far
  for i in 0 .. poly.planes.length:
    let other = poly.planes[i]
    let d = other.x * nx + other.y * ny + other.z * nz
    if d < facing:
      facing := d
      inc := i
  return inc

// Is direction n a legitimate contact normal at the triangle's support
// feature? Face-parallel axes always are; an edge or vertex only when its state
// on the hull's side is active (2): across smooth or concave seams only the
// face normal applies, so seams never push sideways.
func feature_valid (m: mesh.Mesh) -> (t: U32) -> (nx: F32) -> (ny: F32) -> (nz: F32) : Bool =>
  let d0 = nx * (mesh.corner m t 0).x + ny * (mesh.corner m t 0).y + nz * (mesh.corner m t 0).z
  let d1 = nx * (mesh.corner m t 1).x + ny * (mesh.corner m t 1).y + nz * (mesh.corner m t 1).z
  let d2 = nx * (mesh.corner m t 2).x + ny * (mesh.corner m t 2).y + nz * (mesh.corner m t 2).z
  let top = max d0 (max d1 d2)
  let tolerance = 0.0005
  let on0 = d0 >= top - tolerance
  let on1 = d1 >= top - tolerance
  let on2 = d2 >= top - tolerance
  let count = (if on0 then 1 else 0) + (if on1 then 1 else 0) + (if on2 then 1 else 0)
  if count >= 3:
    return true
  let plane = m.planes[t]
  let side = if plane.x * nx + plane.y * ny + plane.z * nz >= 0.0 then 0 else 1
  let flags = mesh.flags_of m t
  if count == 2:
    let edge = if on0 and on1 then 0 else if on1 and on2 then 1 else 2
    return mesh.edge_state flags edge side == 2
  let vertex = if on0 then 0 else if on1 then 1 else 2
  return mesh.vertex_state flags vertex side == 2

// Capsule against a static mesh. Normals lead from the mesh to the capsule.
func mesh_capsule (m: mesh.Mesh) -> (a: Vec3) -> (b: Vec3) -> (radius: F32) -> (margin: F32) : #[Contact] =>
  if not (mesh.finite_vec a and mesh.finite_vec b and is_finite radius and is_finite margin):
    return #[]
  let reach = radius + margin
  let low = $Vec3 { x: min a.x b.x - reach, y: min a.y b.y - reach, z: min a.z b.z - reach }
  let high = $Vec3 { x: max a.x b.x + reach, y: max a.y b.y + reach, z: max a.z b.z + reach }
  let found: #[Contact] = #[]
  let long = (b - a).length_squared > 0.0001
  let (ux, uy, uz) = unit_xyz (b.x - a.x) (b.y - a.y) (b.z - a.z)
  for t in spatial.query m.index low high:
    let n = mesh.near m t a b
    if n.dist - radius < margin:
      if mesh.near_state m t n != 0:
        let c = gap_contact (mesh.triangle_gap m t n) radius
        let at = similar_contact found c
        if at == found.length:
          @storage.push found c
        else:
          if c.sep < found[at].sep:
            found[at] := c
      // A capsule lying along a face touches along it: add the end points
      // that lie over this triangle's interior.
      if long and abs (ux * n.face.x + uy * n.face.y + uz * n.face.z) < 0.35:
        let p0 = mesh.corner m t 0
        let p1 = mesh.corner m t 1
        let p2 = mesh.corner m t 2
        for e in 0 .. 2:
          let end = if e == 0 then a else b
          let (qx, qy, qz, region) = mesh.point_triangle p0.x p0.y p0.z p1.x p1.y p1.z p2.x p2.y p2.z end.x end.y end.z
          if region == 0:
            let plane = m.planes[t]
            let lean = plane.x * (end.x - qx) + plane.y * (end.y - qy) + plane.z * (end.z - qz)
            let sign = if lean >= 0.0 then 1.0 else (-1.0)
            let nx = plane.x * sign
            let ny = plane.y * sign
            let nz = plane.z * sign
            let distance = lean * sign
            if distance - radius < margin:
              let c = $Contact {
                point: $Vec3 { x: (qx + (end.x - nx * radius)) * 0.5, y: (qy + (end.y - ny * radius)) * 0.5, z: (qz + (end.z - nz * radius)) * 0.5 },
                normal: $Vec3 { x: nx, y: ny, z: nz }, sep: distance - radius,
              }
              let at = similar_contact found c
              if at == found.length:
                @storage.push found c
              else:
                if c.sep < found[at].sep:
                  found[at] := c
  return reduce_spread (found)

// One hull against one triangle by the separating axis theorem over the valid
// axes (see `feature_valid`). Normals lead from the triangle to the hull.
func triangle_poly (m: mesh.Mesh) -> (t: U32) -> (poly: Poly) -> (margin: F32) : #[Contact] =>
  let p0 = mesh.corner m t 0
  let p1 = mesh.corner m t 1
  let p2 = mesh.corner m t 2
  let plane = m.planes[t]
  let nx = plane.x
  let ny = plane.y
  let nz = plane.z
  let center = poly.center
  let mid_x = (p0.x + p1.x + p2.x) / 3.0
  let mid_y = (p0.y + p1.y + p2.y) / 3.0
  let mid_z = (p0.z + p1.z + p2.z) / 3.0
  // The triangle's own faces, both ways. Kind 0: triangle face.
  let up = support_min poly.verts nx ny nz - plane.w
  let down = F32.neg (support_max poly.verts nx ny nz) + plane.w
  let best_t = up
  let sign_t = 1.0
  if down > up:
    best_t := down
    sign_t := (-1.0)
  if best_t > margin:
    return #[]
  // Hull faces.
  let best_h = (-1000000000.0)
  let face_h = 0
  for i in 0 .. poly.planes.length:
    let p = poly.planes[i]
    let s = min (p.x * p0.x + p.y * p0.y + p.z * p0.z) (min (p.x * p1.x + p.y * p1.y + p.z * p1.z) (p.x * p2.x + p.y * p2.y + p.z * p2.z)) - p.w
    if s > best_h and feature_valid m t (F32.neg p.x) (F32.neg p.y) (F32.neg p.z):
      best_h := s
      face_h := i
  if best_h > margin:
    return #[]
  // Hull edge directions against the triangle's edges.
  let best_e = (-1000000000.0)
  let axis_x = 0.0
  let axis_y = 0.0
  let axis_z = 0.0
  let edge_e = 0
  for e in 0 .. 3:
    let u = mesh.corner m t e
    let w = mesh.corner m t ((e + 1) % 3)
    let ex = w.x - u.x
    let ey = w.y - u.y
    let ez = w.z - u.z
    for d in poly.dirs:
      let cx = d.y * ez - d.z * ey
      let cy = d.z * ex - d.x * ez
      let cz = d.x * ey - d.y * ex
      let length2 = cx * cx + cy * cy + cz * cz
      if length2 > 0.000001 * (ex * ex + ey * ey + ez * ez):
        let root = sqrt length2
        let away = (cx * (center.x - mid_x) + cy * (center.y - mid_y) + cz * (center.z - mid_z)) < 0.0
        let ax = if away then F32.neg cx / root else cx / root
        let ay = if away then F32.neg cy / root else cy / root
        let az = if away then F32.neg cz / root else cz / root
        let hull_low = support_min poly.verts ax ay az
        let tri_high = max (ax * p0.x + ay * p0.y + az * p0.z) (max (ax * p1.x + ay * p1.y + az * p1.z) (ax * p2.x + ay * p2.y + az * p2.z))
        let s = hull_low - tri_high
        if s > best_e and feature_valid m t ax ay az:
          best_e := s
          axis_x := ax
          axis_y := ay
          axis_z := az
          edge_e := e
  if best_e > margin:
    return #[]
  let face_best = max best_t (best_h - 0.0005)
  if best_e > face_best + 0.002:
    let low_b = support_min poly.verts axis_x axis_y axis_z
    let (b0, b1) = extreme_edge poly (F32.neg axis_x) (F32.neg axis_y) (F32.neg axis_z) (F32.neg low_b)
    let u = mesh.corner m t edge_e
    let w = mesh.corner m t ((edge_e + 1) % 3)
    let d1x = w.x - u.x
    let d1y = w.y - u.y
    let d1z = w.z - u.z
    let d2x = b1.x - b0.x
    let d2y = b1.y - b0.y
    let d2z = b1.z - b0.z
    let (s, r) = mesh.segment_params u.x u.y u.z d1x d1y d1z b0.x b0.y b0.z d2x d2y d2z
    return #[$Contact {
      point: $Vec3 { x: (u.x + d1x * s + (b0.x + d2x * r)) * 0.5, y: (u.y + d1y * s + (b0.y + d2y * r)) * 0.5, z: (u.z + d1z * s + (b0.z + d2z * r)) * 0.5 },
      normal: $Vec3 { x: axis_x, y: axis_y, z: axis_z }, sep: best_e,
    }]
  if best_t >= best_h - 0.0005:
    // The triangle is the reference: its side planes clip the hull's incident face.
    let rx = nx * sign_t
    let ry = ny * sign_t
    let rz = nz * sign_t
    let inc = incident_face poly rx ry rz
    let polygon = ring_points poly inc
    for e in 0 .. 3:
      let u = mesh.corner m t e
      let w = mesh.corner m t ((e + 1) % 3)
      let ex = w.x - u.x
      let ey = w.y - u.y
      let ez = w.z - u.z
      let (sx, sy, sz) = unit_xyz (ey * nz - ez * ny) (ez * nx - ex * nz) (ex * ny - ey * nx)
      let inward = sx * (mid_x - u.x) + sy * (mid_y - u.y) + sz * (mid_z - u.z) < 0.0
      let mx = if inward then sx else F32.neg sx
      let my = if inward then sy else F32.neg sy
      let mz = if inward then sz else F32.neg sz
      polygon := clip_polygon polygon mx my mz (mx * u.x + my * u.y + mz * u.z + 0.00001)
    let found: #[Contact] = #[]
    for (px, py, pz) in polygon:
      let s = rx * px + ry * py + rz * pz - plane.w * sign_t
      if s <= margin:
        let half = s * 0.5
        @storage.push found ($Contact { point: $Vec3 { x: px - rx * half, y: py - ry * half, z: pz - rz * half }, normal: $Vec3 { x: rx, y: ry, z: rz }, sep: s })
    return found
  // The hull face is the reference: its side planes clip the triangle.
  let face = poly.planes[face_h]
  let ring = poly.rings[face_h]
  let centroid = poly.centers[face_h]
  let polygon: #[(F32, F32, F32)] = #[(p0.x, p0.y, p0.z), (p1.x, p1.y, p1.z), (p2.x, p2.y, p2.z)]
  for i in 0 .. ring.length:
    let v0 = poly.verts.at (shapes.ring_vertex poly ring i)
    let v1 = poly.verts.at (shapes.ring_vertex poly ring ((i + 1) % ring.length))
    let ex = v1.x - v0.x
    let ey = v1.y - v0.y
    let ez = v1.z - v0.z
    let (sx, sy, sz) = unit_xyz (face.y * ez - face.z * ey) (face.z * ex - face.x * ez) (face.x * ey - face.y * ex)
    let flip = sx * (centroid.x - v0.x) + sy * (centroid.y - v0.y) + sz * (centroid.z - v0.z) > 0.0
    let mx = if flip then F32.neg sx else sx
    let my = if flip then F32.neg sy else sy
    let mz = if flip then F32.neg sz else sz
    polygon := clip_polygon polygon mx my mz (mx * v0.x + my * v0.y + mz * v0.z + 0.00001)
  let found: #[Contact] = #[]
  for (px, py, pz) in polygon:
    let s = face.x * px + face.y * py + face.z * pz - face.w
    if s <= margin:
      let half = s * 0.5
      @storage.push found ($Contact { point: $Vec3 { x: px - face.x * half, y: py - face.y * half, z: pz - face.z * half }, normal: $Vec3 { x: F32.neg face.x, y: F32.neg face.y, z: F32.neg face.z }, sep: s })
  return found

// Hull against a static mesh. Normals lead from the mesh to the hull.
func mesh_poly (m: mesh.Mesh) -> (poly: Poly) -> (margin: F32) : #[Contact] =>
  let (low, high) = shapes.bounds ($shapes.Hull poly)
  if not (mesh.finite_vec low and mesh.finite_vec high and is_finite margin):
    return #[]
  let found: #[Contact] = #[]
  let reach = margin
  for t in spatial.query m.index ($Vec3 { x: low.x - reach, y: low.y - reach, z: low.z - reach }) ($Vec3 { x: high.x + reach, y: high.y + reach, z: high.z + reach }):
    for c in triangle_poly m t poly margin:
      let at = similar_contact found c
      if at == found.length:
        @storage.push found c
      else:
        if c.sep < found[at].sep:
          found[at] := c
  return reduce_spread (found)

// Contacts between two shapes, normals leading from `a` to `b`.
func between (a: Shape) -> (b: Shape) -> (margin: F32) => case a of
  $shapes.Capsule {a: a0, b: a1, radius: ra} => case b of
    $shapes.Capsule {a: b0, b: b1, radius: rb} => capsule_capsule a0 a1 ra b0 b1 rb margin
    $shapes.Hull poly => array_flip (poly_capsule poly a0 a1 ra margin)
    $shapes.Heightfield t => array_flip (terrain_capsule t a0 a1 ra margin)
    $shapes.Mesh m => array_flip (mesh_capsule m a0 a1 ra margin)
  $shapes.Hull pa => case b of
    $shapes.Capsule {a: b0, b: b1, radius: rb} => poly_capsule pa b0 b1 rb margin
    $shapes.Hull pb => poly_poly pa pb margin
    $shapes.Heightfield t => array_flip (terrain_poly t pa margin)
    $shapes.Mesh m => array_flip (mesh_poly m pa margin)
  $shapes.Heightfield t => case b of
    $shapes.Capsule {a: b0, b: b1, radius: rb} => terrain_capsule t b0 b1 rb margin
    $shapes.Hull poly => terrain_poly t poly margin
    $shapes.Heightfield _ => #[]
    $shapes.Mesh _ => #[]
  $shapes.Mesh m => case b of
    $shapes.Capsule {a: b0, b: b1, radius: rb} => mesh_capsule m b0 b1 rb margin
    $shapes.Hull poly => mesh_poly m poly margin
    $shapes.Heightfield _ => #[]
    $shapes.Mesh _ => #[]
