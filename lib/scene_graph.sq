//! Runtime hierarchical scene graph & prefab override resolver for Squid games.
//! Nodes are stored in parent-before-child topological order (`parent == no_parent`
//! marks a root). World transforms compose via `transform.Affine3` so rotated
//! non-uniform scales preserve shear without losing precision, and visibility
//! propagates top-down.
//!
//! Key items: [`Node`], [`WorldNode`], [`PrefabOverride`], [`root_node`], [`child_node`].

import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as math from "./math"
import * as transform from "./transform"

const no_parent: U32 = 4294967295
const no_mesh: U32 = 4294967295

type Node is data = $Node {
  id: U32,
  parent: U32,
  local: transform.Pose3,
  visible: Bool,
  mesh: U32,
  material: U32,
  tag: U32,
}

type WorldNode is data = $WorldNode {
  id: U32,
  world: transform.Affine3,
  visible: Bool,
  mesh: U32,
  material: U32,
  tag: U32,
}

// Sparse prefab override applied to a matching node `target_id`.
// `override_flags` bitmask: bit 0 = position, bit 1 = rotation, bit 2 = scale,
// bit 3 = visible, bit 4 = material, bit 5 = tag.
const ov_position: U32 = 1
const ov_rotation: U32 = 2
const ov_scale: U32 = 4
const ov_visible: U32 = 8
const ov_material: U32 = 16
const ov_tag: U32 = 32

type PrefabOverride is data = $PrefabOverride {
  target_id: U32,
  flags: U32,
  position: Vec3,
  rotation: math.Quat,
  scale: Vec3,
  visible: Bool,
  material: U32,
  tag: U32,
}

func root_node (id: U32) -> (local: transform.Pose3) -> (mesh: U32) -> (material: U32) : Node =>
  return $Node { id, parent: no_parent, local, visible: true, mesh, material, tag: 0 }

func child_node (id: U32) -> (parent: U32) -> (local: transform.Pose3) -> (mesh: U32) -> (material: U32) : Node =>
  return $Node { id, parent, local, visible: true, mesh, material, tag: 0 }

// Applies sparse overrides to a prefab node table under a dedicated placement root
// (`id = root_id`, `local = root_pose`, `mesh = no_mesh`), returning a fresh owned
// array without mutating the source template. Because `resolve` composes parent and
// child transforms via `transform.Affine3`, non-uniform `root_pose` scales combined
// with rotated prefab roots preserve shear exactly.
func instantiate_prefab (root_id: U32) -> (template: &[Node]) -> (root_pose: transform.Pose3) -> (overrides: &[PrefabOverride]) : #[Node] =>
  let out: #[Node] = #[]
  let count = template.length
  @storage.push out ($Node { id: root_id, parent: no_parent, local: root_pose, visible: true, mesh: no_mesh, material: 0, tag: 0 })
  for i in 0 .. count:
    let n = template[i]
    let pos = n.local.position
    let rot = n.local.rotation
    let sc = n.local.scale
    let vis = n.visible
    let mat = n.material
    let tg = n.tag
    for j in 0 .. overrides.length:
      let ov = overrides[j]
      if ov.target_id == n.id:
        if (ov.flags & ov_position) != 0:
          pos := ov.position
        if (ov.flags & ov_rotation) != 0:
          rot := ov.rotation
        if (ov.flags & ov_scale) != 0:
          sc := ov.scale
        if (ov.flags & ov_visible) != 0:
          vis := ov.visible
        if (ov.flags & ov_material) != 0:
          mat := ov.material
        if (ov.flags & ov_tag) != 0:
          tg := ov.tag
    let next_pose = $transform.Pose3 { position: pos, rotation: rot, scale: sc }
    let parent = if n.parent == no_parent then 0 else if n.parent < count then n.parent + 1 else count + 1
    @storage.push out ($Node { id: n.id, parent, local: next_pose, visible: vis, mesh: n.mesh, material: mat, tag: tg })
  return out

// Validates that `nodes` are in parent-before-child topological order (`parent < index`
// for every child) and contain no duplicate node IDs.
func valid_topology (nodes: &[Node]) : Bool =>
  let count = nodes.length
  for i in 0 .. count:
    let n = nodes[i]
    if n.parent != no_parent and n.parent >= i:
      return false
    for j in 0 .. i:
      if nodes[j].id == n.id:
        return false
  return true

// Propagates hierarchical world transforms and visibility across a topologically
// ordered node slice (`parent < index` for every child).
func resolve (nodes: &[Node]) : #[WorldNode] =>
  let out: #[WorldNode] = #[]
  let count = nodes.length
  for i in 0 .. count:
    let n = nodes[i]
    let local_aff = transform.affine3 n.local
    let world_aff = local_aff
    let vis = n.visible
    if n.parent != no_parent and n.parent < i:
      let p = out[n.parent]
      world_aff := transform.compose3 p.world local_aff
      vis := p.visible and n.visible
    @storage.push out ($WorldNode { id: n.id, world: world_aff, visible: vis, mesh: n.mesh, material: n.material, tag: n.tag })
  return out

private func finite_pose (p: transform.Pose3) : Bool =>
  return math.finite3 p.position and math.finite_quat p.rotation and math.finite3 p.scale

private func finite_affine (a: transform.Affine3) : Bool =>
  return math.finite3 a.position and math.finite3 a.x and math.finite3 a.y and math.finite3 a.z

// Validated counterpart to `resolve`: returns `$Nothing` when topology, ID
// uniqueness, local poses, or composed world transforms are invalid/non-finite.
func resolve_checked (nodes: &[Node]) : Maybe #[WorldNode] =>
  if not (valid_topology nodes):
    return $Nothing
  for i in 0 .. nodes.length:
    if not (finite_pose nodes[i].local):
      return $Nothing
  let out = resolve nodes
  for i in 0 .. out.length:
    if not (finite_affine out[i].world):
      return $Nothing
  return $Some out

// Returns the resolved world transform of `nodes[index]`'s parent, `$Some transform.identity3`
// for a root, or `$Nothing` if `nodes` and `resolved` disagree in length/IDs, `index` is out
// of bounds, or the parent index violates parent-before-child topological order.
func parent_world_of (nodes: &[Node]) -> (resolved: &[WorldNode]) -> (index: U32) : Maybe transform.Affine3 =>
  if nodes.length != resolved.length or index >= nodes.length:
    return $Nothing
  if nodes[index].id != resolved[index].id:
    return $Nothing
  let p = nodes[index].parent
  if p == no_parent:
    return $Some transform.identity3
  if p >= index:
    return $Nothing
  if nodes[p].id != resolved[p].id:
    return $Nothing
  return $Some resolved[p].world

// Finds the world-space position of node `id` inside a resolved table.
func world_position_of (resolved: &[WorldNode]) -> (id: U32) : Maybe Vec3 =>
  for i in 0 .. resolved.length:
    if resolved[i].id == id:
      return $Some (resolved[i].world.position)
  return $Nothing
