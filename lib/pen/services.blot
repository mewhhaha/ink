import * as array from "std/array"
import * as protocol from "pen/protocol"
import * as requests from "../services"

// Requests of each service.

// Steam: achievements and stats by their API names, as the app's Steamworks
// page lists them.
func unlock_achievement state => return func name => return
  requests.tell state protocol.service_steam protocol.steam_op_unlock_achievement 0.0 0.0 0.0 0.0 (requests.text_values name)

// An integer stat (a whole number) set to `value`.
func set_stat state => return func name => return func (value: U32) => return
  requests.tell state protocol.service_steam protocol.steam_op_set_stat (U32.to_f32 value) 0.0 0.0 0.0 (requests.text_values name)

// Rich presence: `key` set to `value`, as Steam's friends list shows it.
func set_presence state => return func key => return func value => return
  requests.tell state protocol.service_steam protocol.steam_op_set_presence (U32.to_f32 key.length) 0.0 0.0 0.0 (requests.text_values (array.concat key value))

// The clipboard: `text` copied to it.
func copy_text state => return func text => return
  requests.tell state protocol.service_clipboard protocol.clipboard_op_copy 0.0 0.0 0.0 0.0 (requests.text_values text)

// The clipboard's text, as the answer's values.
func paste_text state => return func () => return
  requests.ask state protocol.service_clipboard protocol.clipboard_op_paste 0.0 0.0 0.0 0.0 #[]

// An http or https address opened in the player's browser.
func open_url state => return func address => return
  requests.tell state protocol.service_url protocol.url_op_open 0.0 0.0 0.0 0.0 (requests.text_values address)

// What the game runs on: one of protocol.platform_op_*, answered as text.
func platform state => return func (operation: U32) => return
  requests.ask state protocol.service_platform operation 0.0 0.0 0.0 0.0 #[]

// Whether Steam runs for the game: the answer's status is ok if it does.
func steam_status state => return func () => return
  requests.ask state protocol.service_steam protocol.steam_op_status 0.0 0.0 0.0 0.0 #[]

// The shortest path over a grid of `columns` by `rows` cells (`blocked`, row
// by row, 0 open), from cell `start` to cell `goal` (row * columns +
// column), by the host's native pathfinding: the answer's values are the
// path's cells in order, its value their count, none when there is no path.
func find_path state => return func (columns: U32) => return func (rows: U32) => return func (blocked: Array F32) => return func (start: U32) => return func (goal: U32) => return
  requests.ask state protocol.service_pathfinding protocol.pathfinding_op_find
    (U32.to_f32 columns) (U32.to_f32 rows) (U32.to_f32 start) (U32.to_f32 goal) blocked
