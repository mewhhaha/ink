import * as array from "std/array"
import * as lanes from "../lanes"

// Native Pen's explicit pure-job callback. The module exports
// `entry const plan: Array F32 -> Array F32`; each job uses a fresh isolated
// guest. This call joins the whole batch in input order before returning.
// It never transports a live task, world, pointer or effect continuation.
const magic = -4670545.0
const max_jobs = 32
const max_lanes = 16384
const encode = fn (jobs: Array (Array F32)) => do:
  if jobs.length > max_jobs:
    return @panic "too many worker jobs"
  let rows = array.map (fn values => do:
    if values.length > max_lanes:
      return @panic "worker input is too large"
    return array.concat #[from values.length] values) jobs
  return array.concat #[magic, from jobs.length] (array.flatten rows)
const decode = fn (count: U32) (packet: Array F32) => do:
  use lanes.require (packet.length >= 2 && packet[0] == magic)
  use lanes.require (lanes.integer packet[1] max_jobs == count)
  let at = 2
  let values = array.generate count (fn i => #[])
  for job in 0 .. count:
    use lanes.require (at < packet.length)
    let size = lanes.integer packet[at] max_lanes
    at := self + 1
    use lanes.require (size <= packet.length - at)
    values[job] := array.slice at size packet
    at := self + size
  use lanes.require (at == packet.length)
  return values
const run = fn (host: Array F32 -> Array F32 ! { Foreign }) (jobs: Array (Array F32)) => do:
  if jobs.length == 0:
    return #[]
  use packet <- host (encode jobs)
  return decode jobs.length packet
