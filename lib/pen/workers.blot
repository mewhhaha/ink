import * as lanes from "../lanes"

// Native isolated copied-buffer jobs. Input/output rows contain spans only;
// each payload occupies its own caller-owned flat numeric pool.
const magic: F32 = -4670545.0
const max_jobs: U32 = 32
const max_lanes: U32 = 16384
type Span is data = $Span {start: U32, count: U32}
const encode = func jobs -> payload -> (packet: ResizeArray F32) => return do:
  lanes.require (jobs.length <= max_jobs)
  @storage.truncate packet 0
  @storage.push packet magic
  @storage.push packet (U32.to_f32 jobs.length)
  let read_job: U32 -> Span = jobs.at
  let read_value: U32 -> F32 = payload.at
  for at in 0 .. jobs.length:
    let job: Span = read_job at
    lanes.require (job.count <= max_lanes and job.start <= payload.length and job.count <= payload.length - job.start)
    @storage.push packet (U32.to_f32 job.count)
    for i in 0 .. job.count:
      @storage.push packet (read_value (job.start + i))
const decode = func (count: U32) -> (packet: Array F32) -> (jobs: ResizeArray Span) -> (payload: ResizeArray F32) => return do:
  lanes.require (packet.length >= 2 and packet[0] == magic and lanes.integer packet[1] max_jobs == count)
  @storage.truncate jobs 0
  @storage.truncate payload 0
  let at = 2
  for 0 .. count:
    lanes.require (at < packet.length)
    let size = lanes.integer packet[at] max_lanes
    at := at + 1
    lanes.require (size <= packet.length - at)
    let start = payload.length
    for i in 0 .. size:
      @storage.push payload packet[at + i]
    @storage.push jobs ($Span {start, count: size})
    at := at + size
  lanes.require (at == packet.length)
const run = func host -> jobs -> input -> request_packet -> responses -> output => return do:
  encode jobs input request_packet
  use response <- host (@storage.freeze (@storage.copy request_packet))
  decode jobs.length response responses output
