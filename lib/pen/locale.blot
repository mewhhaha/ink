import * as locale from "../locale"
import * as services from "../services"
import * as protocol from "pen/protocol"
func ask (state: own services.Services) -> key -> amount : (U32, services.Services) => case amount of
  $Nothing => services.ask state protocol.service_locale protocol.locale_op_text 0.0 0.0 0.0 0.0 (services.text_values key)
  $Some n => services.ask state protocol.service_locale protocol.locale_op_text (U32.to_f32 n) 1.0 0.0 0.0 (services.text_values key)
// Host separates shaped display text and reading-order text with a zero.
func parts input : locale.Text =>
  let text: #[U32] = #[]
  for value in input:
    if is_finite value and value >= 0.0 and value <= 1114111.0:
      let code = F32.to_u32 value
      if code <= 0x10FFFF and not (code >= 0xD800 and code <= 0xDFFF):
        @storage.push text code
  for at in 0 .. text.length:
    if text[at] == 0:
      let drawn = @array.slice text 0 at
      let spoken = @array.slice text (at + 1) (text.length - at - 1)
      return $locale.Text {drawn, spoken}
  let spoken = copy text
  return $locale.Text {drawn: text, spoken}
func decoded state -> (answer: services.Answer) : Maybe locale.Text => return
  if answer.status == protocol.service_status_ok then $Some (parts (services.values state answer.values)) else $Nothing
