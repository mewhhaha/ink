import * as array from "std/array"
import * as locale from "../locale"
import * as services from "../services"
import * as protocol from "pen/protocol"

const ask = fn (key: Array U32) (count: Maybe U32) => case count of
  #Nothing => services.ask protocol.service_locale protocol.locale_op_text 0.0 0.0 0.0 0.0 (services.text_values key)
  #Some n => services.ask protocol.service_locale protocol.locale_op_text (from n) 1.0 0.0 0.0 (services.text_values key)
// Pen separates shaped display text from reading-order text with a zero lane.
// No separator means both use the same text. Shaping stays in the host.
const parts = fn (values: Array F32) => do:
  let all = services.text values
  for at in 0 .. all.length:
    if all[at] == 0:
      return #locale.Text { drawn: array.slice 0 at all, spoken: array.slice (at + 1) (all.length - at - 1) all }
  return #locale.Text { drawn: all, spoken: all }
const decoded = fn (answer: services.Answer) =>
  if answer.status == protocol.service_status_ok then #Some (parts answer.values) else #Nothing
