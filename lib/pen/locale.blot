//! Optional Pen adapter issuing and decoding localized text service requests.
//!
//! Key items: [`ask`], [`parts`], [`decoded`].

import * as locale from "../locale"
import * as services from "../services"
import * as protocol from "pen/protocol"
// A zero request ID reports an unsupported key or an inexact wire count.
func ask (state: own services.Services) -> key -> (amount: Maybe U32) : (U32, services.Services) =>
  for i in 0 .. key.length:
    if key.at i == 0:
      return (0, state)
  let count = 0.0
  let counted = 0.0
  if let $Some n = amount:
    count := U32.to_f32 n
    if count >= 4294967296.0 or F32.to_u32 count != n:
      return (0, state)
    counted := 1.0
  return services.ask state protocol.service_locale protocol.locale_op_text count counted 0.0 0.0 (services.text_values key)
// U+0000 is reserved for the wire separator between drawn and spoken text.
// A reply without a separator uses the same text for both channels.
func parts input : locale.Text =>
  let text: #[U32] = #[]
  for value in input:
    if is_finite value and value >= 0.0 and value <= 1114111.0:
      let code = F32.to_u32 value
      if U32.to_f32 code == value and not (code >= 0xD800 and code <= 0xDFFF):
        @storage.push text code
  for at in 0 .. text.length:
    if text[at] == 0:
      let drawn = @array.slice text 0 at
      let spoken = @array.slice text (at + 1) (text.length - at - 1)
      return $locale.Text {drawn, spoken}
  let spoken = copy text
  return $locale.Text {drawn: text, spoken}
func decoded state -> (answer: services.Answer) : Maybe locale.Text => return
  if answer.status == protocol.service_status_ok then $Some (parts (services.values state answer.values)) else $Nothing
