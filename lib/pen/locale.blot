import * as locale from "../locale"
import * as services from "../services"
import * as protocol from "pen/protocol"
func ask state -> key -> amount => case amount of
  $Nothing => services.ask state protocol.service_locale protocol.locale_op_text 0.0 0.0 0.0 0.0 (services.text_values key)
  $Some n => services.ask state protocol.service_locale protocol.locale_op_text (U32.to_f32 n) 1.0 0.0 0.0 (services.text_values key)
// Host separates shaped display text and reading-order text with a zero.
// The returned Text borrows a caller-owned text buffer, never a local array.
func parts input -> (text: #[~U32]) =>
  @storage.truncate text 0
  for value in input:
    let code = F32.to_u32 (max 0.0 value)
    if code <= 0x10FFFF and not (code >= 0xD800 and code <= 0xDFFF):
      @storage.push text code
  for at in 0 .. text.length:
    if text[at] == 0:
      return $locale.Text {drawn: &text[0..at], spoken: &text[at + 1..text.length]}
  return $locale.Text {drawn: &text[0..text.length], spoken: &text[0..text.length]}
func decoded state -> (answer: services.Answer) -> text => return
  if answer.status == protocol.service_status_ok then $Some (parts (services.values state answer.values) text) else $Nothing
