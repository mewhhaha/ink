import * as lanes from "../lanes"
import * as program from "./program"
import * as workers from "./workers"
import * as array from "std/array"

// An isolated native context owner and named packets outlive each iteration.
// prepare context payload mutates context; plan context payload output appends
// its result. No owning array or context value is carried across a backedge.
const magic: F32 = -4670546.0
const max_lanes: U32 = 16384
const serve = func prepare -> plan -> context -> (incoming: ResizeArray F32) -> (outgoing: ResizeArray F32) -> (host: Array F32 -> Array F32 ! { Foreign }) : Unit ! { Foreign } => return do:
  @storage.truncate outgoing 0
  @storage.push outgoing magic
  let prepared = false
  for ever:
    use request <- host (@storage.freeze (@storage.copy outgoing))
    lanes.require (request.length >= 1 and request.length <= max_lanes + 1)
    lanes.finite request
    @storage.truncate incoming 0
    program.append request incoming
    let command = lanes.integer incoming[0] 2
    if command == 0:
      lanes.require (incoming.length == 1)
      return ()
    @storage.truncate outgoing 0
    if command == 1:
      prepare context (&incoming[1..incoming.length])
      prepared := true
      @storage.push outgoing 1.0
    else:
      lanes.require prepared
      @storage.push outgoing 2.0
      plan context (&incoming[1..incoming.length]) outgoing
      lanes.require (outgoing.length - 1 <= max_lanes)
      lanes.require (program.valid_state outgoing)

// Existing copied-buffer client framing is unchanged. Revision halves retain
// all U32 bits; only explicit reset/configure replaces a prepared context.
const client_magic: F32 = -4670547.0
const acknowledgement = func command -> packet => return do:
  lanes.require (packet.length == 2 and packet[0] == client_magic and packet[1] == command)
const configure = func host -> revision -> (context: Array F32) => return do:
  lanes.require (context.length <= max_lanes)
  lanes.finite context
  let request = array.concat #[client_magic, 1.0, U32.to_f32 (revision & 65535), U32.to_f32 (revision >> 16), U32.to_f32 context.length] context
  use response <- host request
  acknowledgement 1.0 response
const reset = func host => return do:
  use response <- host #[client_magic, 0.0]
  acknowledgement 0.0 response
const run = func host -> jobs -> input -> request_packet -> responses -> output => return do:
  workers.encode jobs input request_packet
  let request = array.generate (request_packet.length + 2) (func i => return if i == 0 then client_magic else if i == 1 then 2.0 else request_packet[i - 2])
  use response <- host request
  lanes.finite response
  workers.decode jobs.length response responses output
