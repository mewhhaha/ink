import * as array from "std/array"
import * as preferences from "../preferences"
import * as ui from "../ui"

// The settings every game has: pages for the player's controls,
// picture quality and sound volumes, and what
// changing each of them does to them. The game supplies the words, in its
// own font, and lays the page out with the caller's menu.

// The words the page shows.
type Words is data = $Words {
  antialiasing: &[U32], render_scale: &[U32], filtering: &[U32], shadows: &[U32],
  occlusion: &[U32], sky: &[U32], fog: &[U32], effects: &[U32], bloom: &[U32],
  master: &[U32], effects_volume: &[U32], music: &[U32], back: &[U32],
  off: &[U32], fxaa: &[U32], msaa: &[U32], msaa_fxaa: &[U32],
  linear: &[U32], trilinear: &[U32], anisotropic_4: &[U32], anisotropic_8: &[U32], anisotropic_16: &[U32],
  low: &[U32], medium: &[U32], high: &[U32], percent: &[U32],
  handedness: &[U32], right_hand: &[U32], left_hand: &[U32],
}

const graphics = 0
const audio = 1
const input = 2
const pages = 3

const scales = #[0.5, 0.75, 1.0, 1.5, 2.0]
const filters = #[0, 1, 4, 8, 16]
const shadow_sizes = #[0, 1024, 2048, 4096]

func index_of (values: Array U32) => return func (wanted: U32) => return do:
  for index in 0 .. values.length:
    if values[index] == wanted:
      return index
  return 0

func scale_index (wanted: F32) => return do:
  for index in 0 .. scales.length:
    if abs (scales[index] - wanted) < 0.01:
      return index
  return 2

func percent (words: Words) => return func (value: F32) => return
  array.concat (ui.digits (F32.to_u32 (floor (value * 100.0 + 0.5)))) words.percent

// A volume's slider.
func volume label => return func (value: F32) => return $ui.Slider { label, value, low: 0.0, high: 1.0, step: 0.05 }

// Both owners are caller/frame-local. Labels precede options, which precede
// returned Control rows, so no borrowed payload escapes a younger owner.
func options_of (options: ResizeArray (&[U32])) -> values => return do:
  let start = options.length
  for value in values:
    @storage.push options value
  return &options[start..options.length]
func scale_options words -> labels -> (options: ResizeArray (&[U32])) => return do:
  let start = options.length
  for value in scales:
    let text = percent words value
    @storage.push options (ui.store_text text labels)
  return &options[start..options.length]

// The page's controls for `kept`, in order, ending with a button back.
func controls (words: Words) => return func (page: U32) => return func (kept: preferences.Preferences) => return func labels -> options => return do:
  let q = kept.quality
  let v = kept.volumes
  let antialiasing = 0
  if q.msaa == 4:
    antialiasing := 2
  if q.fxaa:
    antialiasing := self + 1
  if page == input:
    let chosen = 0
    if kept.controls.left_handed:
      chosen := 1
    return #[
      $ui.Choice { label: words.handedness, options: options_of options #[words.right_hand, words.left_hand], chosen },
      $ui.Button { label: words.back },
    ]
  if page == audio:
    return #[volume words.master v.master, volume words.effects_volume v.effects, volume words.music v.music,
      $ui.Button { label: words.back }]
  return #[
    $ui.Choice { label: words.antialiasing, options: options_of options #[words.off, words.fxaa, words.msaa, words.msaa_fxaa], chosen: antialiasing },
    $ui.Choice { label: words.render_scale, options: scale_options words labels options, chosen: scale_index q.scale },
    $ui.Choice { label: words.filtering, options: options_of options #[words.linear, words.trilinear, words.anisotropic_4, words.anisotropic_8, words.anisotropic_16], chosen: index_of filters q.filtering },
    $ui.Choice { label: words.shadows, options: options_of options #[words.off, words.low, words.medium, words.high], chosen: index_of shadow_sizes q.shadows },
    $ui.Toggle { label: words.occlusion, on: q.occlusion },
    $ui.Toggle { label: words.sky, on: q.sky },
    $ui.Slider { label: words.fog, value: q.fog, low: 0.0, high: 2.0, step: 0.1 },
    $ui.Toggle { label: words.effects, on: q.effects },
    $ui.Toggle { label: words.bloom, on: q.bloom },
    $ui.Button { label: words.back },
  ]

// The row of the button back.
func back (page: U32) => return do:
  if page == graphics:
    return 9
  if page == audio:
    return 3
  return 1

// `kept` after control `index` of the page became `control`.
func adopt (kept: preferences.Preferences) => return func (page: U32) => return func (index: U32) => return func (control: ui.Control) => return do:
  let q = kept.quality
  let v = kept.volumes
  let chosen = case control of
    $ui.Choice { chosen } => chosen
    _ => 0
  let on = case control of
    $ui.Toggle { on } => on
    _ => false
  let value = case control of
    $ui.Slider { value } => value
    _ => 0.0
  if page == input:
    if index == 0:
      kept.controls.left_handed := chosen == 1
    kept.changed := true
    return kept
  if page == audio:
    if index == 0:
      kept.volumes.master := value
    if index == 1:
      kept.volumes.effects := value
    if index == 2:
      kept.volumes.music := value
    kept.changed := true
    return kept
  if index == 0:
    q.msaa := 1
    if chosen >= 2:
      q.msaa := 4
    q.fxaa := chosen % 2 == 1
  if index == 1:
    q.scale := scales[chosen]
  if index == 2:
    q.filtering := filters[chosen]
  if index == 3:
    q.shadows := shadow_sizes[chosen]
  if index == 4:
    q.occlusion := on
  if index == 5:
    q.sky := on
  if index == 6:
    q.fog := value
  if index == 7:
    q.effects := on
  if index == 8:
    q.bloom := on
  return $preferences.Preferences { quality: q, volumes: v, controls: kept.controls, changed: true }
