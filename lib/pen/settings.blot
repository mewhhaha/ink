import * as array from "std/array"
import * as preferences from "../preferences"
import * as ui from "../ui"
import * as tree from "../ui/tree"

// The settings every game has: pages for the player's controls,
// picture quality and sound volumes, and what
// changing each of them does to them. The game supplies the words, in its
// own font, and lays the page out with the caller's menu.

// The words the page shows.
type Words is data = $Words {
  antialiasing: &[U32], render_scale: &[U32], filtering: &[U32], shadows: &[U32],
  occlusion: &[U32], sky: &[U32], fog: &[U32], volumetrics: &[U32], effects: &[U32], bloom: &[U32],
  master: &[U32], effects_volume: &[U32], music: &[U32], back: &[U32],
  off: &[U32], fxaa: &[U32], msaa: &[U32], msaa_fxaa: &[U32],
  linear: &[U32], trilinear: &[U32], anisotropic_4: &[U32], anisotropic_8: &[U32], anisotropic_16: &[U32],
  low: &[U32], medium: &[U32], high: &[U32], percent: &[U32],
  handedness: &[U32], right_hand: &[U32], left_hand: &[U32],
}

const graphics = 0
const audio = 1
const input = 2
const pages = 3

const scales = #[0.5, 0.75, 1.0, 1.5, 2.0]
const filters = #[0, 1, 4, 8, 16]
const shadow_sizes = #[0, 1024, 2048, 4096]

func index_of (values: #[U32]) => func (wanted: U32) =>
  for index in 0 .. values.length:
    if values[index] == wanted:
      return index
  return 0

func scale_index (wanted: F32) =>
  for index in 0 .. scales.length:
    if abs (scales[index] - wanted) < 0.01:
      return index
  return 2

func percent (words: Words) => func (value: F32) =>
  let rounded = if is_finite value then clamp 0.0 4294967040.0 (floor (value * 100.0 + 0.5)) else 0.0
  return array.concat (ui.digits (F32.to_u32 rounded)) words.percent

// A volume's slider.
func volume (label: tree.Span) => func (value: F32) => $ui.Slider { label, value, low: 0.0, high: 1.0, step: 0.05 }

// Both owners are caller/frame-local flat pools; controls carry spans, never
// raw views that could dangle when either pool grows.
func options_of (labels: own #[U32]) -> (options: own #[tree.Span]) -> (values: #[&[U32]]) : (tree.Span, #[U32], #[tree.Span]) =>
  let start = options.length
  for value in values:
    let (span, next_labels) = tree.store_text value labels
    labels := next_labels
    @storage.push options span
  return ($tree.Span { start, count: values.length }, labels, options)
func scale_options (words: Words) -> (labels: own #[U32]) -> (options: own #[tree.Span]) : (tree.Span, #[U32], #[tree.Span]) =>
  let start = options.length
  for value in scales:
    let text = percent words value
    let (span, next_labels) = tree.store_text text labels
    labels := next_labels
    @storage.push options span
  return ($tree.Span { start, count: scales.length }, labels, options)

// The page's controls for `kept`, in order, ending with a button back.
func controls (words: Words) -> (page: U32) -> (kept: preferences.Preferences) -> (labels: own #[U32]) -> (options: own #[tree.Span]) : (#[ui.Control], #[U32], #[tree.Span]) =>
  let q = kept.quality
  let v = kept.volumes
  let antialiasing = 0
  if q.msaa == 4:
    antialiasing := 2
  if q.fxaa:
    antialiasing := self + 1
  if page == input:
    let chosen = 0
    if kept.controls.left_handed:
      chosen := 1
    let (l_hand, labels) = tree.store_text words.handedness labels
    let (o_hand, labels, options) = options_of labels options #[words.right_hand, words.left_hand]
    let (l_back, labels) = tree.store_text words.back labels
    return (#[
      $ui.Choice { label: l_hand, options: o_hand, chosen },
      $ui.Button { label: l_back },
    ], labels, options)
  if page == audio:
    let (l_master, labels) = tree.store_text words.master labels
    let (l_fx, labels) = tree.store_text words.effects_volume labels
    let (l_music, labels) = tree.store_text words.music labels
    let (l_back, labels) = tree.store_text words.back labels
    return (#[volume l_master v.master, volume l_fx v.effects, volume l_music v.music,
      $ui.Button { label: l_back }], labels, options)
  let (l_aa, labels) = tree.store_text words.antialiasing labels
  let (o_aa, labels, options) = options_of labels options #[words.off, words.fxaa, words.msaa, words.msaa_fxaa]
  let (l_scale, labels) = tree.store_text words.render_scale labels
  let (o_scale, labels, options) = scale_options words labels options
  let (l_filt, labels) = tree.store_text words.filtering labels
  let (o_filt, labels, options) = options_of labels options #[words.linear, words.trilinear, words.anisotropic_4, words.anisotropic_8, words.anisotropic_16]
  let (l_shad, labels) = tree.store_text words.shadows labels
  let (o_shad, labels, options) = options_of labels options #[words.off, words.low, words.medium, words.high]
  let (l_occ, labels) = tree.store_text words.occlusion labels
  let (l_sky, labels) = tree.store_text words.sky labels
  let (l_fog, labels) = tree.store_text words.fog labels
  let (l_vol, labels) = tree.store_text words.volumetrics labels
  let (o_vol, labels, options) = options_of labels options #[words.off, words.low, words.high]
  let (l_eff, labels) = tree.store_text words.effects labels
  let (l_bloom, labels) = tree.store_text words.bloom labels
  let (l_back, labels) = tree.store_text words.back labels
  return (#[
    $ui.Choice { label: l_aa, options: o_aa, chosen: antialiasing },
    $ui.Choice { label: l_scale, options: o_scale, chosen: scale_index q.scale },
    $ui.Choice { label: l_filt, options: o_filt, chosen: index_of filters q.filtering },
    $ui.Choice { label: l_shad, options: o_shad, chosen: index_of shadow_sizes q.shadows },
    $ui.Toggle { label: l_occ, on: q.occlusion },
    $ui.Toggle { label: l_sky, on: q.sky },
    $ui.Slider { label: l_fog, value: q.fog, low: 0.0, high: 2.0, step: 0.1 },
    $ui.Choice { label: l_vol, options: o_vol, chosen: q.volumetrics },
    $ui.Toggle { label: l_eff, on: q.effects },
    $ui.Toggle { label: l_bloom, on: q.bloom },
    $ui.Button { label: l_back },
  ], labels, options)

// The row of the button back.
func back (page: U32) =>
  if page == graphics:
    return 10
  if page == audio:
    return 3
  return 1

// `kept` after control `index` of the page became `control`.
func adopt (kept: preferences.Preferences) => func (page: U32) => func (index: U32) => func (control: ui.Control) =>
  let q = kept.quality
  let v = kept.volumes
  let chosen = case control of
    $ui.Choice { chosen } => chosen
    _ => 0
  let on = case control of
    $ui.Toggle { on } => on
    _ => false
  let value = case control of
    $ui.Slider { value } => value
    _ => 0.0
  if page == input:
    if index == 0:
      kept.controls.left_handed := chosen == 1
    kept.changed := true
    return kept
  if page == audio:
    if index == 0:
      kept.volumes.master := value
    if index == 1:
      kept.volumes.effects := value
    if index == 2:
      kept.volumes.music := value
    kept.changed := true
    return kept
  if index == 0:
    q.msaa := 1
    if chosen >= 2:
      q.msaa := 4
    q.fxaa := chosen % 2 == 1
  if index == 1 and chosen < scales.length:
    q.scale := scales[chosen]
  if index == 2 and chosen < filters.length:
    q.filtering := filters[chosen]
  if index == 3 and chosen < shadow_sizes.length:
    q.shadows := shadow_sizes[chosen]
  if index == 4:
    q.occlusion := on
  if index == 5:
    q.sky := on
  if index == 6:
    q.fog := value
  if index == 7:
    q.volumetrics := chosen
  if index == 8:
    q.effects := on
  if index == 9:
    q.bloom := on
  return $preferences.Preferences { quality: q, volumes: v, controls: kept.controls, changed: true }
