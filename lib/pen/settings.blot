import * as array from "std/array"
import * as preferences from "../preferences"
import * as ui from "../ui"

// The settings every game has: pages for the player's controls,
// picture quality and sound volumes, and what
// changing each of them does to them. The game supplies the words, in its
// own font, and lays the page out with the caller's menu.

// The words the page shows.
type Words is data = #Words {
  antialiasing: Array U32, render_scale: Array U32, filtering: Array U32, shadows: Array U32,
  occlusion: Array U32, sky: Array U32, fog: Array U32, effects: Array U32, bloom: Array U32,
  master: Array U32, effects_volume: Array U32, music: Array U32, back: Array U32,
  off: Array U32, fxaa: Array U32, msaa: Array U32, msaa_fxaa: Array U32,
  linear: Array U32, trilinear: Array U32, anisotropic_4: Array U32, anisotropic_8: Array U32, anisotropic_16: Array U32,
  low: Array U32, medium: Array U32, high: Array U32, percent: Array U32,
  handedness: Array U32, right_hand: Array U32, left_hand: Array U32,
}

const graphics = 0
const audio = 1
const input = 2
const pages = 3

const scales = #[0.5, 0.75, 1.0, 1.5, 2.0]
const filters = #[0, 1, 4, 8, 16]
const shadow_sizes = #[0, 1024, 2048, 4096]

const index_of = fn (values: Array U32) => fn (wanted: U32) => do:
  for index in 0 .. values.length:
    if values[index] == wanted:
      return index
  return 0

const scale_index = fn (wanted: F32) => do:
  for index in 0 .. scales.length:
    if abs (scales[index] - wanted) < 0.01:
      return index
  return 2

const percent = fn (words: Words) => fn (value: F32) =>
  array.concat (ui.digits (F32.to_u32 (floor (value * 100.0 + 0.5)))) words.percent

// The page's controls for `kept`, in order, ending with a button back.
const controls = fn (words: Words) => fn (page: U32) => fn (kept: preferences.Preferences) => do:
  let q = kept.quality
  let v = kept.volumes
  let antialiasing = 0
  if q.msaa == 4:
    antialiasing := 2
  if q.fxaa:
    antialiasing := self + 1
  let volume = fn (label: Array U32) => fn (value: F32) => #ui.Slider { label, value, low: 0.0, high: 1.0, step: 0.05 }
  if page == input:
    let chosen = 0
    if kept.controls.left_handed:
      chosen := 1
    return #[
      #ui.Choice { label: words.handedness, options: #[words.right_hand, words.left_hand], chosen },
      #ui.Button { label: words.back },
    ]
  if page == audio:
    return #[volume words.master v.master, volume words.effects_volume v.effects, volume words.music v.music,
      #ui.Button { label: words.back }]
  return #[
    #ui.Choice { label: words.antialiasing, options: #[words.off, words.fxaa, words.msaa, words.msaa_fxaa], chosen: antialiasing },
    #ui.Choice { label: words.render_scale, options: #[percent words scale | scale <- scales], chosen: scale_index q.scale },
    #ui.Choice { label: words.filtering, options: #[words.linear, words.trilinear, words.anisotropic_4, words.anisotropic_8, words.anisotropic_16], chosen: index_of filters q.filtering },
    #ui.Choice { label: words.shadows, options: #[words.off, words.low, words.medium, words.high], chosen: index_of shadow_sizes q.shadows },
    #ui.Toggle { label: words.occlusion, on: q.occlusion },
    #ui.Toggle { label: words.sky, on: q.sky },
    #ui.Slider { label: words.fog, value: q.fog, low: 0.0, high: 2.0, step: 0.1 },
    #ui.Toggle { label: words.effects, on: q.effects },
    #ui.Toggle { label: words.bloom, on: q.bloom },
    #ui.Button { label: words.back },
  ]

// The row of the button back.
const back = fn (page: U32) => do:
  if page == graphics:
    return 9
  if page == audio:
    return 3
  return 1

// `kept` after control `index` of the page became `control`.
const adopt = fn (kept: preferences.Preferences) => fn (page: U32) => fn (index: U32) => fn (control: ui.Control) => do:
  let q = kept.quality
  let v = kept.volumes
  let chosen = case control of
    #ui.Choice { chosen } => chosen
    _ => 0
  let on = case control of
    #ui.Toggle { on } => on
    _ => #False
  let value = case control of
    #ui.Slider { value } => value
    _ => 0.0
  if page == input:
    if index == 0:
      kept.controls.left_handed := chosen == 1
    kept.changed := #True
    return kept
  if page == audio:
    if index == 0:
      kept.volumes.master := value
    if index == 1:
      kept.volumes.effects := value
    if index == 2:
      kept.volumes.music := value
    kept.changed := #True
    return kept
  if index == 0:
    q.msaa := 1
    if chosen >= 2:
      q.msaa := 4
    q.fxaa := chosen % 2 == 1
  if index == 1:
    q.scale := scales[chosen]
  if index == 2:
    q.filtering := filters[chosen]
  if index == 3:
    q.shadows := shadow_sizes[chosen]
  if index == 4:
    q.occlusion := on
  if index == 5:
    q.sky := on
  if index == 6:
    q.fog := value
  if index == 7:
    q.effects := on
  if index == 8:
    q.bloom := on
  return #preferences.Preferences { quality: q, volumes: v, controls: kept.controls, changed: #True }
