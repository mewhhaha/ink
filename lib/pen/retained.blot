import * as array from "std/array"
import * as host from "./host"
import * as instances from "./instances"
import * as render from "../render"
import * as protocol from "pen/protocol_render"
import * as wire from "pen/types"

// Opt in with matching retained Pen bindings and runtime. The ordinary host
// adapter remains independent of the retained protocol extension.
const encode_frame = fn schema requests sound kept interface frame requested state => do:
  let packet = host.wire_frame schema requests sound kept interface frame requested state
  if let #Some delta = frame.retained:
    let updates = array.map (fn (value: render.Instance) => #instances.Update { id: value.id, order: value.order, draw: value.draw }) delta.updates
    let #Some attached = instances.attach delta.reset updates delta.removed packet else:
      return @panic "retained draw exceeds host limits"
    packet := attached
  let frame = render.finish frame
  let encoded = protocol.encode_render_draws packet frame.draws host.draw_metadata host.draw_transform host.draw_parameters host.draw_extra
  if frame.extensions.length == 0:
    return encoded
  let extensions = array.map (fn (value: render.Extension) => #wire.Extension { tag: value.tag, values: value.values }) frame.extensions
  return array.concat encoded (protocol.encode_extensions extensions)
const decode_frame = host.decode_frame
const frame = fn application schema world input => host.frame_using encode_frame application schema world input
const execute = host.execute_using frame
const run = host.run_using execute
const run_traced = host.run_traced_using execute
