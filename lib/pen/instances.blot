import * as array from "std/array"
import * as host from "./host"
import * as render from "../render"
import * as protocol from "pen/protocol"
import * as wire from "pen/types"

// Stable IDs belong to callers; recycle a slot only with a new identity.
// On create, restore, reload or loss of host state, send a full reset.
type Update is data = #Update { id: U32, order: U32, draw: render.Draw }
const attach = fn (reset: Bool) => fn (updates: Array Update) => fn (removals: Array U32) => fn (packet: wire.RenderFrame) => do:
  if updates.length > protocol.max_instances || removals.length > protocol.max_instances:
    return #Nothing
  for value in updates:
    if value.draw.extra.length != 0 || value.order > 16777215:
      return #Nothing
  packet.retained_enabled := #True
  packet.retained_reset := reset
  packet.instances := array.map (fn (value: Update) => do:
    let draw = host.wire_draw value.draw
    return #wire.Instance { id_low: value.id % 65536, id_high: value.id / 65536, order: value.order,
      mesh: draw.mesh, material: draw.material, transform: draw.transform, parameters: draw.parameters }) updates
  packet.instance_removals := array.map (fn id => #wire.InstanceRemoval { id_low: id % 65536, id_high: id / 65536 }) removals
  return #Some packet
