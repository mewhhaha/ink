import * as render from "../render"
import * as protocol from "pen/protocol"
type Update is data = $Update {id: U32, order: U32, draw: render.Draw}
// Validate before replacing the output transaction. CPU/GPU retained caches
// remain in Pen; rejection requires a full reset on the next explicit stream.
func attach reset -> updates -> removals -> (frame: render.FrameAccess) => return do:
  let update_count: U32 = updates.length
  let removal_count: U32 = removals.length
  let read_update: U32 -> Update = updates.at
  let read_removal: U32 -> U32 = removals.at
  if update_count > protocol.max_instances or removal_count > protocol.max_instance_removals:
    return false
  for index in 0 .. update_count:
    let value: Update = read_update index
    if value.draw.extra.length != 0 or value.order > 16777215:
      return false
  @storage.truncate frame.updates 0
  @storage.truncate frame.removed 0
  for index in 0 .. update_count:
    let value: Update = read_update index
    @storage.push frame.updates ($render.Instance {id: value.id, order: value.order, draw: value.draw})
  for index in 0 .. removal_count:
    @storage.push frame.removed (read_removal index)
  frame.settings[0].retained_enabled = true
  frame.settings[0].retained_reset = reset
  return true
