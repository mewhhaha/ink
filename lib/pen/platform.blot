import * as array from "std/array"
import * as lanes from "../lanes"
import * as protocol from "pen/protocol"
import * as services from "../services"
import * as pen_services from "./services"
import * as window from "../events"

// What the game runs on, as the host's platform service answers it
// (services.blot): the operating system, the player's locale, the device and
// whether it is a Steam Deck, and whether Steam runs for the game. A settings
// or about page shows it; a game may also pick its defaults by it.
//
// It is asked once, on the first fixed step; until the answers come its text
// is empty and `steam` is services.unanswered. It is saved with the state
// (not with scenes), as the requests it waits on are (services.blot), so a
// restored moment neither asks again nor loses an answer. A quicksave
// carries what it knows: one loaded on another machine shows the machine it
// was saved on.
type State is data = $State {os_start: U32, os_count: U32, locale_start: U32, locale_count: U32, device_start: U32, device_count: U32, deck: Bool, steam: U32}
type Access is data = $Access {state: Array State, text: ResizeArray U32, asked: ResizeArray U32}
type Platform is data = $Platform {os: &[U32], locale: &[U32], device: &[U32], deck: Bool, steam: U32, asked: &[U32]}
const initial = $State {os_start: 0, os_count: 0, locale_start: 0, locale_count: 0, device_start: 0, device_count: 0, deck: false, steam: services.unanswered}
lent func access state -> text -> asked => return $Access {state, text, asked}
func initialize (access: Access) => return do:
  access.state[0] = initial
  @storage.truncate access.text 0
  @storage.truncate access.asked 0
func read (access: Access) => return do:
  let state = access.state[0]
  return $Platform {os: &access.text[state.os_start..state.os_start + state.os_count],
    locale: &access.text[state.locale_start..state.locale_start + state.locale_count],
    device: &access.text[state.device_start..state.device_start + state.device_count],
    deck: state.deck, steam: state.steam, asked: &access.asked[0..access.asked.length]}
func append_codes codes -> (destination: ResizeArray U32) => return do:
  let start = destination.length
  for code in codes:
    @storage.push destination code
  return start
func encode (known: Platform) : Array F32 => return do:
  let out: GrowArray F32 = #[]
  @storage.push out (lanes.bit known.deck)
  @storage.push out (U32.to_f32 known.steam)
  @storage.push out (U32.to_f32 known.os.length)
  for code in known.os:
    @storage.push out (U32.to_f32 code)
  @storage.push out (U32.to_f32 known.locale.length)
  for code in known.locale:
    @storage.push out (U32.to_f32 code)
  @storage.push out (U32.to_f32 known.device.length)
  for code in known.device:
    @storage.push out (U32.to_f32 code)
  @storage.push out (U32.to_f32 known.asked.length)
  for id in known.asked:
    @storage.push out (U32.to_f32 id)
  return @storage.freeze out
func read_codes (input: Array F32) -> at -> most -> (destination: ResizeArray U32) => return do:
  lanes.require (at < input.length)
  let count = lanes.integer input[at] protocol.max_service_data
  lanes.require (count <= input.length - at - 1)
  let start = destination.length
  for i in 0 .. count:
    @storage.push destination (lanes.integer input[at + 1 + i] most)
  return (start, count, at + 1 + count)
func decode (values: Array F32) -> (access: Access) => return do:
  lanes.require (values.length >= 2)
  initialize access
  let (os_start, os_count, next) = read_codes values 2 126 access.text
  let (locale_start, locale_count, next) = read_codes values next 126 access.text
  let (device_start, device_count, next) = read_codes values next 126 access.text
  let (_, asked_count, next) = read_codes values next protocol.max_service_id access.asked
  lanes.require (next == values.length and (asked_count == 0 or asked_count == 4))
  access.state[0] = $State {os_start, os_count, locale_start, locale_count, device_start, device_count,
    deck: lanes.flag values[0], steam: lanes.integer values[1] services.unanswered}
const codec = {key: 16, version: 1}
func ask (access: Access) -> service_state -> seconds => return do:
  if access.asked.length > 0:
    return ()
  @storage.push access.asked (pen_services.platform service_state protocol.platform_op_os)
  @storage.push access.asked (pen_services.platform service_state protocol.platform_op_locale)
  @storage.push access.asked (pen_services.platform service_state protocol.platform_op_device)
  @storage.push access.asked (pen_services.steam_status service_state ())
func take (access: Access) -> service_state => return do:
  if access.asked.length < 4:
    return ()
  if let $Some answer = services.take service_state access.asked[0]:
    let codes = services.text (services.values service_state answer.values)
    access.state[0].os_start = append_codes codes access.text
    access.state[0].os_count = codes.length
  if let $Some answer = services.take service_state access.asked[1]:
    let codes = services.text (services.values service_state answer.values)
    access.state[0].locale_start = append_codes codes access.text
    access.state[0].locale_count = codes.length
  if let $Some answer = services.take service_state access.asked[2]:
    let codes = services.text (services.values service_state answer.values)
    access.state[0].device_start = append_codes codes access.text
    access.state[0].device_count = codes.length
    access.state[0].deck = answer.value > 0.5
  if let $Some answer = services.take service_state access.asked[3]:
    access.state[0].steam = answer.status
func answered access -> service_state -> (event: window.Event) => return case event of
  $window.ServiceAnswer {} => take access service_state
  $window.ServiceData {} => take access service_state
  _ => ()
func steam_running (known: Platform) => return known.steam == protocol.service_status_ok
