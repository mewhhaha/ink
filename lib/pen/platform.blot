//! What the game runs on, as the host's platform service answers it
//! (services.blot): the operating system, the player's locale, the device and
//! whether it is a Steam Deck, and whether Steam runs for the game. A settings
//! or about page shows it; a game may also pick its defaults by it.
//!
//! It is asked once, on the first fixed step; until the answers come its text
//! is empty and `steam` is services.unanswered. It is saved with the state
//! (not with scenes), as the requests it waits on are (services.blot), so a
//! restored moment neither asks again nor loses an answer. A quicksave
//! carries what it knows: one loaded on another machine shows the machine it
//! was saved on.
//!
//! Key items: [`State`], [`Access`], [`Platform`], [`access`], [`initialize`].

import * as array from "std/array"
import * as lanes from "../lanes"
import * as protocol from "pen/protocol"
import * as services from "../services"
import * as pen_services from "./services"
import * as window from "../events"

type State is data = $State {os_start: U32, os_count: U32, locale_start: U32, locale_count: U32, device_start: U32, device_count: U32, deck: Bool, steam: U32}
type Access is data = $Access {state: #[State], text: #[U32], asked: #[U32]}
type Platform is data = $Platform {os: &[U32], locale: &[U32], device: &[U32], deck: Bool, steam: U32, asked: &[U32]}
const initial = $State {os_start: 0, os_count: 0, locale_start: 0, locale_count: 0, device_start: 0, device_count: 0, deck: false, steam: services.unanswered}
func access (own state) -> (own text) -> (own asked) => $Access {state, text, asked}
func initialize (access: own Access): Access =>
  access.state[0] := initial
  @storage.truncate access.text 0
  @storage.truncate access.asked 0
  return access
func read (access: Access) =>
  let state = access.state[0]
  return $Platform {os: &access.text[state.os_start..state.os_start + state.os_count],
    locale: &access.text[state.locale_start..state.locale_start + state.locale_count],
    device: &access.text[state.device_start..state.device_start + state.device_count],
    deck: state.deck, steam: state.steam, asked: &access.asked[0..access.asked.length]}
func append_codes codes -> (destination: own #[U32]) : (U32, #[U32]) =>
  let start = destination.length
  for code in codes:
    @storage.push destination code
  return (start, destination)
func encode (known: Platform) : #[F32] =>
  let out: #[F32] = #[]
  @storage.push out (lanes.bit known.deck)
  @storage.push out (U32.to_f32 known.steam)
  @storage.push out (U32.to_f32 known.os.length)
  for code in known.os:
    @storage.push out (U32.to_f32 code)
  @storage.push out (U32.to_f32 known.locale.length)
  for code in known.locale:
    @storage.push out (U32.to_f32 code)
  @storage.push out (U32.to_f32 known.device.length)
  for code in known.device:
    @storage.push out (U32.to_f32 code)
  @storage.push out (U32.to_f32 known.asked.length)
  for id in known.asked:
    @storage.push out (U32.to_f32 id)
  return out
func read_codes (input: #[F32]) -> at -> most -> (destination: own #[U32]) : (U32, U32, U32, #[U32]) =>
  lanes.require (at < input.length)
  let count = lanes.integer input[at] protocol.max_service_data
  lanes.require (count <= input.length - at - 1)
  let start = destination.length
  for i in 0 .. count:
    @storage.push destination (lanes.integer input[at + 1 + i] most)
  return (start, count, at + 1 + count, destination)
func decode (values: #[F32]) -> (access: own Access): Access =>
  lanes.require (values.length >= 2)
  access := initialize access
  let (os_start, os_count, next, text) = read_codes values 2 126 access.text
  let (locale_start, locale_count, next, text) = read_codes values next 126 text
  let (device_start, device_count, next, text) = read_codes values next 126 text
  access.text := text
  let (_, asked_count, next, asked) = read_codes values next protocol.max_service_id access.asked
  access.asked := asked
  lanes.require (next == values.length and (asked_count == 0 or asked_count == 4))
  access.state[0] := $State {os_start, os_count, locale_start, locale_count, device_start, device_count,
    deck: lanes.flag values[0], steam: lanes.integer values[1] services.unanswered}
  return access
const codec = {key: 16, version: 1}
func ask_services (asked: own #[U32]) -> (service_state: own services.Services) : (#[U32], services.Services) =>
  if asked.length > 0:
    return (asked, service_state)
  let (os_id, s0) = pen_services.platform service_state protocol.platform_op_os
  @storage.push asked os_id
  let (locale_id, s1) = pen_services.platform s0 protocol.platform_op_locale
  @storage.push asked locale_id
  let (device_id, s2) = pen_services.platform s1 protocol.platform_op_device
  @storage.push asked device_id
  let (steam_id, s3) = pen_services.steam_status s2 ()
  @storage.push asked steam_id
  return (asked, s3)
func ask (access: own Access) -> (service_state: own services.Services) -> seconds : (Access, services.Services) =>
  let (asked, service_state) = ask_services access.asked service_state
  access.asked := asked
  return (access, service_state)
func ask_on (own access) -> seconds =>
  let (platform, next_services) = ask access.platform access.services seconds
  access.platform := platform
  access.services := next_services
  return access
func take_platform (access: own Access) -> (service_state: services.Services) : Access =>
  if access.asked.length < 4:
    return access
  if let $Some answer = services.answer service_state access.asked[0]:
    let codes = services.text (services.values service_state answer.values)
    let (start, text) = append_codes codes access.text
    access.text := text
    access.state[0].os_start := start
    access.state[0].os_count := codes.length
  if let $Some answer = services.answer service_state access.asked[1]:
    let codes = services.text (services.values service_state answer.values)
    let (start, text) = append_codes codes access.text
    access.text := text
    access.state[0].locale_start := start
    access.state[0].locale_count := codes.length
  if let $Some answer = services.answer service_state access.asked[2]:
    let codes = services.text (services.values service_state answer.values)
    let (start, text) = append_codes codes access.text
    access.text := text
    access.state[0].device_start := start
    access.state[0].device_count := codes.length
    access.state[0].deck := answer.value > 0.5
  if let $Some answer = services.answer service_state access.asked[3]:
    access.state[0].steam := answer.status
  return access
func dismiss_platform (asked: #[U32]) -> (service_state: own services.Services) : services.Services =>
  if asked.length < 4:
    return service_state
  service_state := services.dismiss self asked[0]
  service_state := services.dismiss self asked[1]
  service_state := services.dismiss self asked[2]
  service_state := services.dismiss self asked[3]
  return service_state
func take (access: own Access) -> (service_state: own services.Services) : (Access, services.Services) =>
  access := take_platform access service_state
  service_state := dismiss_platform access.asked self
  return (access, service_state)
func take_on (own access) =>
  access.platform := take_platform self access.services
  access.services := dismiss_platform access.platform.asked self
  return access
func answered (access: own Access) -> (service_state: own services.Services) -> (event: window.Event) : (Access, services.Services) => case event of
  $window.ServiceAnswer {} => take access service_state
  $window.ServiceData {} => take access service_state
  _ => (access, service_state)
func answered_on (own access) -> (event: window.Event) => case event of
  $window.ServiceAnswer {} => take_on access
  $window.ServiceData {} => take_on access
  _ => access
func steam_running (known: Platform) => known.steam == protocol.service_status_ok
