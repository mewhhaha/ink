import * as array from "std/array"
import * as protocol from "pen/protocol"
import * as events from "../events"

const from_packet = func (event: protocol.Event) => return case event of
  $protocol.SessionStarted { restored } => $events.SessionStarted { restored: restored != 0 }
  $protocol.KeyDown code => $events.KeyDown code
  $protocol.KeyUp code => $events.KeyUp code
  $protocol.PointerDown { button, x, y } => $events.PointerDown { button, x, y }
  $protocol.PointerUp { button, x, y } => $events.PointerUp { button, x, y }
  $protocol.PointerMove { x, y } => $events.PointerMove { x, y }
  $protocol.Wheel { x, y, delta } => $events.Wheel { delta, x, y }
  $protocol.FocusLost => $events.FocusLost
  $protocol.AssetChanged => $events.AssetChanged
  $protocol.RendererReady => $events.RendererReady
  $protocol.Console { command, argument } => $events.Console { command, argument }
  $protocol.Preference { index, value } => $events.Preference { index, value }
  $protocol.Tune { index, value } => $events.Tune { index, value }
  $protocol.UiAction { node, action, value } => $events.UiAction { node, action, value }
  $protocol.ServiceAnswer { request, status, value, length } => $events.ServiceAnswer { request, status, value, length }
  $protocol.ServiceData { request, a, b, c } => $events.ServiceData { request, a, b, c }
  $protocol.GamepadConnected { pad, standard } => $events.GamepadConnected { pad, standard }
  $protocol.GamepadDisconnected { pad } => $events.GamepadDisconnected { pad }
  $protocol.GamepadButton { button, pad, value, pressed } => $events.GamepadButton { button, pad, value, pressed }
  $protocol.GamepadAxis { axis, pad, value } => $events.GamepadAxis { axis, pad, value }
  $protocol.Action { action, value, device } => $events.Action { action, value, device }
  $protocol.TextInput { character, composing } => $events.TextInput { character, composing }
  $protocol.Composition { length, cursor } => $events.Composition { length, cursor }
  $protocol.MouseMotion { dx, dy } => $events.MouseMotion { dx, dy }
  $protocol.Touch { id, x, y, phase } => $events.Touch { id, x, y, phase }
  $protocol.Pan { touches, dx, dy } => $events.Pan { touches, dx, dy }
  $protocol.Pinch { x, y, scale } => $events.Pinch { x, y, scale }
  $protocol.Player { index } => $events.Player { index }

const event_lanes = protocol.event_floats

const decode_event = func values => return func start => return from_packet (protocol.decode_event values start)

const decode_events = func values => return func start => return func count => return
  array.generate count (func index => return decode_event values (start + index * event_lanes))
