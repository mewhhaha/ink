import * as array from "std/array"
import * as profile from "../profile"

func valid_integer (value: F32) => is_finite value and value >= 0.0 and value <= 4294967040.0 and floor value == value
func valid_positive (value: F32) => is_finite value and value >= 0.0
func valid_name (packet: #[F32]) -> start -> count =>
  for i in start .. start + count:
    let value = packet[i]
    if not (valid_integer value) or value > 1114111.0 or (value >= 55296.0 and value <= 57343.0):
      return false
  return true
func name_at (text: own #[U32]) -> packet -> start -> count : (profile.Span, #[U32]) =>
  let at = text.length
  for i in 0 .. count:
    @storage.push text (F32.to_u32 packet[start + i])
  return ($profile.Span { start: at, count }, text)

// Name bytes append to a caller-owned text buffer.
private func flame_using (partial: Bool) -> (text: own #[U32]) -> (hot_output: own #[profile.Hot]) -> (node_output: own #[profile.Node]) -> (packet: #[F32]) : Maybe profile.Flame =>
  if packet.length == 0:
    return $Some (profile.empty text hot_output node_output)
  if not (valid_integer packet[0]) or packet[0] > U32.to_f32 ((packet.length - 1) / 3):
    return $Nothing
  let count = F32.to_u32 packet[0]
  let hot_offsets = array.fill count 0
  let at = 1
  let valid = true
  for i in 0 .. count:
    if packet.length - at < 3:
      valid := false
      break
    if not (valid_integer packet[at] and valid_positive packet[at + 1] and valid_integer packet[at + 2]):
      valid := false
      break
    let length = F32.to_u32 packet[at + 2]
    if length > packet.length - at - 3 or not (valid_name packet (at + 3) length):
      valid := false
      break
    hot_offsets[i] := at
    at := at + 3 + length
  if not valid:
    return $Nothing
  let node_offsets = array.fill ((packet.length - at) / 6) 0
  let used = 0
  for i in 0 .. node_offsets.length:
    if packet.length - at < 6:
      break
    if not (valid_integer packet[at] and valid_integer packet[at + 1] and valid_positive packet[at + 2] and valid_positive packet[at + 3] and valid_positive packet[at + 4] and valid_integer packet[at + 5]):
      valid := false
      break
    let length = F32.to_u32 packet[at + 5]
    if packet[at + 4] > packet[at + 3]:
      valid := false
      break
    if length > packet.length - at - 6:
      break
    if not (valid_name packet (at + 6) length):
      valid := false
      break
    node_offsets[i] := at
    used := used + 1
    at := at + 6 + length
  if not valid or (not partial and at != packet.length):
    return $Nothing
  @storage.truncate text 0
  @storage.truncate hot_output 0
  @storage.truncate node_output 0
  for at in hot_offsets:
    let (name, next_text) = name_at text packet (at + 3) (F32.to_u32 packet[at + 2])
    text := next_text
    @storage.push hot_output ($profile.Hot {function: F32.to_u32 packet[at], samples: packet[at + 1], name})
  for i in 0 .. used:
    let at = node_offsets[i]
    let (name, next_text) = name_at text packet (at + 6) (F32.to_u32 packet[at + 5])
    text := next_text
    @storage.push node_output ($profile.Node {depth: F32.to_u32 packet[at], function: F32.to_u32 packet[at + 1], first: packet[at + 2], samples: packet[at + 3], alone: packet[at + 4], name})
  return $Some ($profile.Flame {text, hottest: hot_output, nodes: node_output})

func flame (own text) -> (own hottest) -> (own nodes) -> values => flame_using false text hottest nodes values
func flame_prefix (own text) -> (own hottest) -> (own nodes) -> values => flame_using true text hottest nodes values

type Counter is data = $Counter { name: profile.Span, value: F32 }
type Memory is data = $Memory { committed: F32, most: F32, text: #[U32], counters: #[Counter] }
private func memory_using (partial: Bool) -> (text: own #[U32]) -> (output: own #[Counter]) -> (values: #[F32]) : Maybe Memory =>
  if values.length < 2 or not (valid_positive values[0] and valid_positive values[1]):
    return $Nothing
  let offsets = array.fill ((values.length - 2) / 3) 0
  let valid = true
  let at = 2
  let used = 0
  for 0 .. offsets.length:
    if values.length - at < 3:
      break
    if not (valid_integer values[at]):
      valid := false
      break
    let length = F32.to_u32 values[at]
    if length > values.length - at - 3:
      break
    if not (valid_name values (at + 1) length):
      valid := false
      break
    let high = values[at + 1 + length]
    let low = values[at + 2 + length]
    if not (valid_integer high and valid_integer low) or low >= 16777216.0:
      valid := false
      break
    offsets[used] := at
    used := self + 1
    at := self + 3 + length
  if not valid or (not partial and at != values.length):
    return $Nothing
  @storage.truncate text 0
  @storage.truncate output 0
  for i in 0 .. used:
    let offset = offsets[i]
    let length = F32.to_u32 values[offset]
    let (name, next_text) = name_at text values (offset + 1) length
    text := next_text
    @storage.push output ($Counter {name, value: values[offset + 1 + length] * 16777216.0 + values[offset + 2 + length]})
  return $Some ($Memory {committed: values[0], most: values[1], text, counters: output})

func memory (own text) -> (own counters) -> values => memory_using false text counters values
func memory_prefix (own text) -> (own counters) -> values => memory_using true text counters values
