import * as array from "std/array"
import * as profile from "../profile"

const valid_integer = func (value: F32) => return is_finite value and value >= 0.0 and value <= 4294967040.0 and floor value == value
const valid_positive = func (value: F32) => return is_finite value and value >= 0.0
const valid_name = func (packet: Array F32) -> start -> count => return do:
  for i in start .. start + count:
    let value = packet[i]
    if Bool.not (valid_integer value) or value > 1114111.0 or (value >= 55296.0 and value <= 57343.0):
      return false
  return true
const name_at = func (text: ResizeArray U32) -> packet -> start -> count => return do:
  let at = text.length
  for i in 0 .. count:
    @storage.push text (F32.to_u32 packet[start + i])
  return &text[at..text.length]

// Name bytes append to a caller-owned text buffer. Reset that buffer only
// after every returned Flame/Memory view has ended.
private const flame_using = func (partial: Bool) -> (text: ResizeArray U32) -> (hot_output: ResizeArray profile.Hot) -> (node_output: ResizeArray profile.Node) -> (packet: Array F32) : Maybe profile.Flame => return do:
  if packet.length == 0:
    return $Some (profile.empty hot_output node_output)
  if Bool.not (valid_integer packet[0]) or packet[0] > U32.to_f32 ((packet.length - 1) / 3):
    return $Nothing
  let count = F32.to_u32 packet[0]
  let hot_offsets = array.fill count 0
  let at = 1
  let valid = true
  for i in 0 .. count:
    if packet.length - at < 3:
      valid := false
      break
    if Bool.not (valid_integer packet[at] and valid_positive packet[at + 1] and valid_integer packet[at + 2]):
      valid := false
      break
    let length = F32.to_u32 packet[at + 2]
    if length > packet.length - at - 3 or Bool.not (valid_name packet (at + 3) length):
      valid := false
      break
    hot_offsets[i] := at
    at := at + 3 + length
  if Bool.not valid:
    return $Nothing
  let node_offsets = array.fill ((packet.length - at) / 6) 0
  let used = 0
  for i in 0 .. node_offsets.length:
    if packet.length - at < 6:
      break
    if Bool.not (valid_integer packet[at] and valid_integer packet[at + 1] and valid_positive packet[at + 2] and valid_positive packet[at + 3] and valid_positive packet[at + 4] and valid_integer packet[at + 5]):
      valid := false
      break
    let length = F32.to_u32 packet[at + 5]
    if packet[at + 4] > packet[at + 3]:
      valid := false
      break
    if length > packet.length - at - 6:
      break
    if Bool.not (valid_name packet (at + 6) length):
      valid := false
      break
    node_offsets[i] := at
    used := used + 1
    at := at + 6 + length
  if Bool.not valid or (Bool.not partial and at != packet.length):
    return $Nothing
  let hot_start = hot_output.length
  let node_start = node_output.length
  for at in hot_offsets:
    hot_output.push ($profile.Hot {function:F32.to_u32 packet[at],samples:packet[at+1],name:name_at text packet (at+3) (F32.to_u32 packet[at+2])})
  for i in 0 .. used:
    let at = node_offsets[i]
    node_output.push ($profile.Node {depth:F32.to_u32 packet[at],function:F32.to_u32 packet[at+1],first:packet[at+2],samples:packet[at+3],alone:packet[at+4],name:name_at text packet (at+6) (F32.to_u32 packet[at+5])})
  return $Some ($profile.Flame {hottest:&hot_output[hot_start..hot_output.length],nodes:&node_output[node_start..node_output.length]})

const flame = func text -> hottest -> nodes -> values => return flame_using false text hottest nodes values
const flame_prefix = func text -> hottest -> nodes -> values => return flame_using true text hottest nodes values

type Counter is data = $Counter { name: &[U32], value: F32 }
type Memory is data = $Memory { committed: F32, most: F32, counters: &[Counter] }
private const memory_using = func (partial: Bool) -> (text: ResizeArray U32) -> (output: ResizeArray Counter) -> (values: Array F32) => return do:
  if values.length < 2 or Bool.not (valid_positive values[0] and valid_positive values[1]):
    return $Nothing
  let offsets = array.fill ((values.length - 2) / 3) 0
  let valid = true
  let at = 2
  let used = 0
  for 0 .. offsets.length:
    if values.length - at < 3:
      break
    if Bool.not (valid_integer values[at]):
      valid := false
      break
    let length = F32.to_u32 values[at]
    if length > values.length - at - 3:
      break
    if Bool.not (valid_name values (at + 1) length):
      valid := false
      break
    let high = values[at + 1 + length]
    let low = values[at + 2 + length]
    if Bool.not (valid_integer high and valid_integer low) or low >= 16777216.0:
      valid := false
      break
    offsets[used] := at
    used := self + 1
    at := self + 3 + length
  if Bool.not valid or (Bool.not partial and at != values.length):
    return $Nothing
  let start = output.length
  for i in 0 .. used:
    let offset = offsets[i]
    let length = F32.to_u32 values[offset]
    output.push ($Counter {name:name_at text values (offset+1) length,value:values[offset+1+length]*16777216.0+values[offset+2+length]})
  return $Some ($Memory {committed:values[0],most:values[1],counters:&output[start..output.length]})

const memory = func text -> counters -> values => return memory_using false text counters values
const memory_prefix = func text -> counters -> values => return memory_using true text counters values
