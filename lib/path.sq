//! Paths: polylines through their points, which things travel along by
//! distance, e.g. walkers along a road or a cart behind its puller.
//!
//! Key items: [`Leg`], [`Prepared`], [`length`], [`along`], [`prepare`].

import { Vec3 } from "std/vector"
import * as math from "./math"

private func leg_length (a: Vec3) -> (b: Vec3) : F32 =>
  let x = b.x - a.x
  let y = b.y - a.y
  let z = b.z - a.z
  let sq = x * x + y * y + z * z
  if is_finite sq:
    return sqrt sq
  let hx = abs (b.x * 0.5 - a.x * 0.5)
  let hy = abs (b.y * 0.5 - a.y * 0.5)
  let hz = abs (b.z * 0.5 - a.z * 0.5)
  let m = max hx (max hy hz)
  if not (is_finite m):
    return 1.0 / 0.0
  if m == 0.0:
    return 0.0
  let sx = hx / m
  let sy = hy / m
  let sz = hz / m
  return 2.0 * m * sqrt (sx * sx + sy * sy + sz * sz)

// How long `path` is. Legs are measured in scalars, as Vec3.length would.
// Returns 0.0 if any point is non-finite or the total length overflows F32.
func length (path: #[Vec3]) =>
  if path.length < 2:
    return 0.0
  let begin = path[0]
  if not (math.finite3 begin):
    return 0.0
  let total = 0.0
  for index in 1 .. path.length:
    let finish = path[index]
    if not (math.finite3 finish):
      return 0.0
    let leg = leg_length begin finish
    let next = total + leg
    if not (is_finite leg and is_finite next):
      return 0.0
    total := next
    begin := finish
  return total

// Where along `path`, `distance` from its start (held to its ends): the
// point, and the way the path heads there as a yaw about the vertical, 0
// facing +z.
func along (path: #[Vec3]) => func (distance: F32) =>
  if path.length == 0 or not (is_finite distance):
    return $Nothing
  let begin = path[0]
  if not (math.finite3 begin):
    return $Nothing
  if path.length == 1:
    return $Some (begin, 0.0)
  let left = max 0.0 distance
  let x = 0.0
  let z = 0.0
  for index in 1 .. path.length:
    let finish = path[index]
    if not (math.finite3 finish):
      return $Nothing
    x := finish.x - begin.x
    let y = finish.y - begin.y
    z := finish.z - begin.z
    let leg = sqrt (x * x + y * y + z * z)
    if not (is_finite leg):
      return $Nothing
    if left < leg:
      let t = left / leg
      let point = $Vec3 { x: F32.lerp begin.x finish.x t, y: F32.lerp begin.y finish.y t, z: F32.lerp begin.z finish.z t }
      if not (math.finite3 point):
        return $Nothing
      for remaining in index + 1 .. path.length:
        if not (math.finite3 path[remaining]):
          return $Nothing
      return $Some (point, math.atan2 x z)
    left := self - leg
    begin := finish
  return $Some (begin, math.atan2 x z)

// Validated polyline with cumulative distances. Preparation owns no cursor;
// any number of callers can sample the immutable path independently.
type Leg is data = $Leg { distance: F32, yaw: F32 }
type Prepared is data = $Prepared { points: &[Vec3], legs: #[Leg] }
func prepare (points: #[Vec3]) : Maybe Prepared =>
  if points.length == 0 or not (math.finite3 points[0]):
    return $Nothing
  let legs = @array.fill points.length ($Leg {distance: 0.0, yaw: 0.0})
  let distance = 0.0
  for i in 1 .. points.length:
    let a = points[i - 1]
    let b = points[i]
    let x = b.x - a.x
    let y = b.y - a.y
    let z = b.z - a.z
    distance := self + sqrt (x * x + y * y + z * z)
    if not (is_finite distance):
      return $Nothing
    legs[i] := $Leg {distance, yaw: math.atan2 x z}
  return $Some ($Prepared {points: &points[0..points.length], legs})
func sample (path: Prepared) -> (distance: F32) =>
  if not (is_finite distance) or path.points.length == 0 or path.legs.length != path.points.length:
    return $Nothing
  if path.points.length == 1:
    return $Some (path.points[0], path.legs[0].yaw)
  let last = path.points.length - 1
  let target = max 0.0 distance
  if target >= path.legs[last].distance:
    return $Some (path.points[last], path.legs[last].yaw)
  // Upper bound skips zero-length legs, including a leading run of duplicates.
  let low = 1
  let high = path.points.length
  for 0 .. 32:
    if low >= high:
      break
    let mid = low + (high - low) / 2
    if path.legs[mid].distance <= target:
      low := mid + 1
    else:
      high := mid
  if low >= path.points.length:
    return $Some (path.points[last], path.legs[last].yaw)
  let start = low - 1
  let a = path.points[start]
  let b = path.points[low]
  let span = path.legs[low].distance - path.legs[start].distance
  if not (is_finite span) or span <= 0.0:
    return $Some (a, path.legs[low].yaw)
  let t = (target - path.legs[start].distance) / span
  return $Some ($Vec3 { x: F32.lerp a.x b.x t, y: F32.lerp a.y b.y t, z: F32.lerp a.z b.z t }, path.legs[low].yaw)
