//! First-class host-independent internationalization (i18n):
//! - BCP 47 tag normalization, fallback chain and RTL language/script detection
//! - Unicode CLDR cardinal and ordinal plural category selection
//! - Composable single-pass {key} / {0} / {count} message formatting
//! - Locale-aware decimal, grouped number and percentage formatting
//! - Flat caller-owned translation catalogs with fallback and dual drawn/spoken text
//!
//! Category codes match pen_protocol::plural_category and pen_runtime::locale.
//!
//! Key items: [`Span`], [`Entry`], [`Catalog`], [`Param`], [`ascii_lower`].
//!
//! ```blot
//! same_ignore_case "en-US" "EN-us" // => true
//! ```

import * as array from "std/array"
import * as ui from "./ui"

const plural_zero: U32 = 0
const plural_one: U32 = 1
const plural_two: U32 = 2
const plural_few: U32 = 3
const plural_many: U32 = 4
const plural_other: U32 = 5

type Span is data = $Span { start: U32, count: U32 }
const no_span = $Span { start: 0, count: 0 }

// A single catalog entry whose text forms live in the catalog's flat U32 pool.
type Entry is data = $Entry {
  key: Span,
  zero: Span,
  one: Span,
  two: Span,
  few: Span,
  many: Span,
  other: Span,
  is_plural: Bool,
}

// A caller-owned translation table for one BCP 47 language tag.
type Catalog is data = $Catalog {
  tag: Span,
  rtl: Bool,
  entries: #[Entry],
  text: #[U32],
}

// Named or positional formatting parameter referencing a flat codepoint pool.
type Param is data = $Param { key: Span, value: Span }

// Dual text channels: visual shaped glyphs for rendering and reading-order text
// for assistive technology, paired with the line's base reading direction.
type DisplayText is data = $DisplayText {
  drawn: #[U32],
  spoken: #[U32],
  rtl: Bool,
}

// Locale number formatting punctuation (decimal point, grouping separator, group digits).
type NumberStyle is data = $NumberStyle {
  decimal: U32,
  group: U32,
  group_size: U32,
}

func ascii_lower (code: U32) : U32 =>
  if code >= 65 and code <= 90:
    return code + 32
  return code

// Simple case folding for Latin, Greek and Cyrillic. Ranges encode the first
