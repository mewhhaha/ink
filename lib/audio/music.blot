// Interactive / adaptive music scheduler: tempo-locked beat & bar clock,
// quantized horizontal segment transitions (immediate, next beat, next bar),
// stinger cues, and vertical stem layer crossfades.

type Quantize is data = $Immediate | $Beat | $Bar

type Clock is data = $Clock {
  bpm: F32,
  beats_per_bar: U32,
  beat: F32,
  segment: U32,
  pending: U32,
  quantize: Quantize,
}

type Tick is data = $Tick {
  clock: Clock,
  beat_crossed: Bool,
  bar_crossed: Bool,
  transitioned: Bool,
  beat_index: U32,
  bar_index: U32,
}

const none = 4294967295

func start (bpm: F32) -> (beats_per_bar: U32) -> (segment: U32) : Maybe Clock =>
  if not (is_finite bpm) or bpm <= 0.0 or beats_per_bar == 0:
    return $Nothing
  return $Some ($Clock { bpm, beats_per_bar, beat: 0.0, segment, pending: none, quantize: $Bar })

func queue (next_segment: U32) -> (quantize: Quantize) -> (clock: Clock) : Clock =>
  return $Clock {
    bpm: clock.bpm,
    beats_per_bar: clock.beats_per_bar,
    beat: clock.beat,
    segment: clock.segment,
    pending: next_segment,
    quantize,
  }

// Advance the music clock by `dt` seconds and fire quantized segment switches.
func advance (dt: F32) -> (clock: Clock) : Tick =>
  if not (is_finite dt) or dt < 0.0 or clock.bpm <= 0.0 or clock.beats_per_bar == 0:
    let b = F32.to_u32 (max 0.0 (floor clock.beat))
    return $Tick { clock, beat_crossed: false, bar_crossed: false, transitioned: false, beat_index: b, bar_index: b / max 1 clock.beats_per_bar }
  let prev_beat = clock.beat
  let next_beat = prev_beat + dt * (clock.bpm / 60.0)
  let prev_idx = F32.to_u32 (max 0.0 (floor prev_beat))
  let next_idx = F32.to_u32 (max 0.0 (floor next_beat))
  let prev_bar = prev_idx / clock.beats_per_bar
  let next_bar = next_idx / clock.beats_per_bar
  let beat_crossed = next_idx > prev_idx
  let bar_crossed = next_bar > prev_bar
  let seg = clock.segment
  let pend = clock.pending
  let fired = false
  if pend != none:
    let ready = case clock.quantize of
      $Immediate => true
      $Beat => beat_crossed
      $Bar => bar_crossed
    if ready:
      seg := pend
      pend := none
      fired := true
  let next_clock = $Clock {
    bpm: clock.bpm,
    beats_per_bar: clock.beats_per_bar,
    beat: next_beat,
    segment: seg,
    pending: pend,
    quantize: clock.quantize,
  }
  return $Tick { clock: next_clock, beat_crossed, bar_crossed, transitioned: fired, beat_index: next_idx, bar_index: next_bar }

// Step vertical stem gains toward `targets` at linear `rate` per second.
func step_stems (targets: #[F32]) -> (rate: F32) -> (dt: F32) -> (gains: own #[F32]) : #[F32] =>
  let count = min gains.length targets.length
  let step = max 0.0 rate * max 0.0 dt
  for i in 0 .. count:
    let t = clamp 0.0 1.0 targets[i]
    let g = gains[i]
    let diff = t - g
    if abs diff <= step:
      gains[i] := t
    else:
      gains[i] := g + (if diff > 0.0 then step else F32.neg step)
  return gains
