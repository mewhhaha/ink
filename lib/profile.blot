import * as array from "std/array"
import * as sort from "./sort"
import * as ui from "./ui"

// Caller-supplied observations and labels, independent of profiler/host format.
type Node is data = #Node { depth: U32, function: U32, first: F32, samples: F32, alone: F32, name: Array U32 }
type Hot is data = #Hot { function: U32, samples: F32, name: Array U32 }
type Flame is data = #Flame { hottest: Array Hot, nodes: Array Node }
const empty = #Flame { hottest: #[], nodes: #[] }

// Aggregate self samples without changing the order of additions within each
// function. Equal totals retain first-observation order, including full U32 IDs.
// Labels come from that function's first node. Never sum inclusive samples here.
const hottest = fn (nodes: Array Node) (most: U32) => do:
  let order = sort.order_u32 (array.map (fn (node: Node) => node.function) nodes)
  let sums = array.fill nodes.length 0.0
  let first = array.fill nodes.length 0
  let groups = 0
  for i in 0 .. order.length:
    let at = order[i]
    let weight = nodes[at].alone
    if Bool.not (is_finite weight) || weight < 0.0:
      return @panic "profile self samples must be finite and nonnegative"
    let fresh = if i == 0 then #True else nodes[order[i - 1]].function != nodes[at].function
    if fresh:
      first[groups] := at
      groups := self + 1
    let group = groups - 1
    sums[group] := self + weight
    if Bool.not (is_finite sums[group]):
      return @panic "profile total overflow"
  let appeared = sort.order_u32 (array.slice 0 groups first)
  let descending = sort.order (array.generate groups (fn i => -sums[appeared[i]]))
  let positive = 0
  for group in appeared:
    if sums[group] > 0.0:
      positive := self + 1
  return array.generate (min most positive) (fn i => do:
    let group = appeared[descending[i]]
    let node = nodes[first[group]]
    return #Hot { function: node.function, samples: sums[group], name: node.name })

// Number of consecutive depths whose widest span reaches fraction of total.
// A missing depth ends the trunk. Memory is bounded by node count, not a
// potentially sparse/untrusted depth ID. fraction is caller policy in (0,1].
const trunk = fn (nodes: Array Node) (total: F32) (fraction: F32) => do:
  if Bool.not (is_finite total && is_finite fraction) || total <= 0.0 || fraction <= 0.0 || fraction > 1.0:
    return 0
  let widest = array.fill nodes.length 0.0
  for node in nodes:
    if node.depth < widest.length:
      widest[node.depth] := max self node.samples
  let depth = 0
  for value in widest:
    if value < total * fraction:
      break
    depth := self + 1
  return depth

type Block is data = #Block { node: U32, rect: ui.Rect }
// Raw clipped rectangles in node order. The caller adds gutters, minimum
// display widths, colors, text and interaction; layout owns none of them.
const rectangle = fn (bounds: ui.Rect) (row_height: F32) (skipped: U32) (total: F32) (node: Node) => do:
  if total <= 0.0 || row_height <= 0.0 || node.depth < skipped || node.samples <= 0.0:
    return #Nothing
  let y = U32.to_f32 (node.depth - skipped) * row_height
  let low = clamp 0.0 total node.first
  let high = clamp 0.0 total (node.first + node.samples)
  if y >= bounds.height || high <= low || bounds.width <= 0.0:
    return #Nothing
  return #Some #ui.Rect { x: bounds.x + low / total * bounds.width, y: bounds.y + y,
    width: (high - low) / total * bounds.width, height: min row_height (bounds.height - y) }
const layout = fn (bounds: ui.Rect) (row_height: F32) (skipped: U32) (total: F32) (nodes: Array Node) => do:
  if Bool.not (is_finite total && is_finite row_height && is_finite bounds.x && is_finite bounds.y && is_finite bounds.width && is_finite bounds.height):
    return @panic "profile layout requires finite bounds"
  let output = array.fill nodes.length (#Block { node: 0, rect: bounds })
  let count = 0
  for index in 0 .. nodes.length:
    let node = nodes[index]
    if Bool.not (is_finite node.first && is_finite node.samples && is_finite (node.first + node.samples)):
      return @panic "profile spans must be finite"
    if let #Some rect = rectangle bounds row_height skipped total node:
      output[count] := #Block { node: index, rect }
      count := self + 1
  return array.slice 0 count output
