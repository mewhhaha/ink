import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as math from "./math"

// Multi-track cinematic and animation sequencer for deterministic Blot games.
// Supports Step, Linear, and Cubic Hermite scalar/Vec3 curves, shortest-arc
// Quaternion SLERP rotation tracks, and exact event trigger firing across
// `(prev, next]` including seamless loop wrap-around.

const interp_step: U32 = 0
const interp_linear: U32 = 1
const interp_hermite: U32 = 2

type ScalarKey is data = $ScalarKey {
  time: F32,
  value: F32,
  interp: U32,
  out_tangent: F32,
  next_in_tangent: F32,
}

type Vec3Key is data = $Vec3Key {
  time: F32,
  value: Vec3,
  interp: U32,
}

type QuatKey is data = $QuatKey {
  time: F32,
  value: math.Quat,
  interp: U32,
}

type TriggerKey is data = $TriggerKey {
  time: F32,
  tag: U32,
  payload: F32,
}

type Player is data = $Player {
  time: F32,
  duration: F32,
  speed: F32,
  playing: Bool,
  looping: Bool,
}

type StepResult is data = $StepResult {
  player: Player,
  prev_time: F32,
  wrapped: Bool,
}

func make_player (duration: F32) -> (looping: Bool) : Player =>
  let d = if is_finite duration then max 0.0 duration else 0.0
  return $Player { time: 0.0, duration: d, speed: 1.0, playing: true, looping }

func scrub (player: Player) -> (time: F32) : Player =>
  let dur = if is_finite player.duration then max 0.0 player.duration else 0.0
  let clamped = if is_finite time then clamp 0.0 dur time else 0.0
  return $Player { time: clamped, duration: dur, speed: player.speed, playing: player.playing, looping: player.looping }

// Advances playback by `dt` seconds, returning the updated player plus the
// crossed interval `(prev_time, player.time]` and wrap flag for trigger evaluation.
func advance (player: Player) -> (dt: F32) : StepResult =>
  if not player.playing or not (is_finite dt and is_finite player.time and is_finite player.duration and is_finite player.speed) or dt <= 0.0 or player.duration <= 0.0:
    let safe_time = if is_finite player.time then player.time else 0.0
    let safe_dur = if is_finite player.duration then max 0.0 player.duration else 0.0
    let safe_speed = if is_finite player.speed then player.speed else 0.0
    let safe_p = $Player { time: safe_time, duration: safe_dur, speed: safe_speed, playing: player.playing, looping: player.looping }
    return $StepResult { player: safe_p, prev_time: safe_time, wrapped: false }
  let prev = player.time
  let raw = prev + dt * player.speed
  if not (is_finite raw):
    return $StepResult { player, prev_time: prev, wrapped: false }
  if player.looping and (raw >= player.duration or raw < 0.0):
    let next = raw - floor (raw / player.duration) * player.duration
    let safe_next = if is_finite next then clamp 0.0 player.duration next else 0.0
    if safe_next >= player.duration:
      safe_next := 0.0
    let p = $Player { time: safe_next, duration: player.duration, speed: player.speed, playing: true, looping: true }
    return $StepResult { player: p, prev_time: prev, wrapped: true }
  let clamped = clamp 0.0 player.duration raw
  let still_playing = player.looping or (if player.speed < 0.0 then clamped > 0.0 else if player.speed > 0.0 then clamped < player.duration else true)
  let p = $Player { time: clamped, duration: player.duration, speed: player.speed, playing: still_playing, looping: player.looping }
  return $StepResult { player: p, prev_time: prev, wrapped: false }

func hermite (v0: F32) -> (v1: F32) -> (dt: F32) -> (u: F32) -> (m0: F32) -> (m1: F32) : F32 =>
  let u2 = u * u
  let u3 = u2 * u
  let h00 = 2.0 * u3 - 3.0 * u2 + 1.0
  let h10 = u3 - 2.0 * u2 + u
  let h01 = (F32.neg 2.0) * u3 + 3.0 * u2
  let h11 = u3 - u2
  return h00 * v0 + h10 * dt * m0 + h01 * v1 + h11 * dt * m1

func sample_scalar (keys: &[ScalarKey]) -> (time: F32) : F32 =>
  let n = keys.length
  if n == 0:
    return 0.0
  if n == 1 or not (is_finite time) or time <= keys[0].time:
    return keys[0].value
  if time >= keys[n - 1].time:
    return keys[n - 1].value
  for i in 0 .. (n - 1):
    let k0 = keys[i]
    let k1 = keys[i + 1]
    if time >= k0.time and time <= k1.time:
      if k0.interp == interp_step:
        return k0.value
      let dt = max 0.000001 (k1.time - k0.time)
      let u = clamp 0.0 1.0 ((time - k0.time) / dt)
      if k0.interp == interp_hermite:
        return hermite k0.value k1.value dt u k0.out_tangent k0.next_in_tangent
      return k0.value + (k1.value - k0.value) * u
  return keys[n - 1].value

func sample_vec3 (keys: &[Vec3Key]) -> (time: F32) : Vec3 =>
  let n = keys.length
  if n == 0:
    return math.zero3
  if n == 1 or not (is_finite time) or time <= keys[0].time:
    return keys[0].value
  if time >= keys[n - 1].time:
    return keys[n - 1].value
  for i in 0 .. (n - 1):
    let k0 = keys[i]
    let k1 = keys[i + 1]
    if time >= k0.time and time <= k1.time:
      if k0.interp == interp_step:
        return k0.value
      let dt = max 0.000001 (k1.time - k0.time)
      let u = clamp 0.0 1.0 ((time - k0.time) / dt)
      let a = k0.value
      let b = k1.value
      return math.vec3 (a.x + (b.x - a.x) * u) (a.y + (b.y - a.y) * u) (a.z + (b.z - a.z) * u)
  return keys[n - 1].value

func sample_quat (keys: &[QuatKey]) -> (time: F32) : math.Quat =>
  let n = keys.length
  if n == 0:
    return math.identity_quat
  if n == 1 or not (is_finite time) or time <= keys[0].time:
    return math.Quat.normalized keys[0].value
  if time >= keys[n - 1].time:
    return math.Quat.normalized keys[n - 1].value
  for i in 0 .. (n - 1):
    let k0 = keys[i]
    let k1 = keys[i + 1]
    if time >= k0.time and time <= k1.time:
      if k0.interp == interp_step:
        return math.Quat.normalized k0.value
      let dt = max 0.000001 (k1.time - k0.time)
      let u = clamp 0.0 1.0 ((time - k0.time) / dt)
      return math.Quat.slerp k0.value k1.value u
  return math.Quat.normalized keys[n - 1].value

// Collects all triggers whose timestamp fell inside `(step.prev_time, step.player.time]`,
// including both pre-wrap and post-wrap cues when `step.wrapped` is true.
func fired_triggers (triggers: &[TriggerKey]) -> (step: StepResult) : #[TriggerKey] =>
  let out: #[TriggerKey] = #[]
  let prev = step.prev_time
  let curr = step.player.time
  let dur = step.player.duration
  let reverse = step.player.speed < 0.0
  for i in 0 .. triggers.length:
    let tr = triggers[i]
    let hit = if reverse
      then (if step.wrapped then ((tr.time >= 0.0 and tr.time < prev) or (tr.time >= curr and tr.time <= dur)) else (tr.time >= curr and tr.time < prev))
      else (if step.wrapped then ((tr.time > prev and tr.time <= dur) or (tr.time >= 0.0 and tr.time <= curr)) else (tr.time > prev and tr.time <= curr))
    if hit:
      @storage.push out tr
  return out
