import * as array from "std/array"
import * as sort from "./sort"

// Match unique full-width keys without owning their values or lifetime.
// previous addresses the old array in NEW order; before_count means absent.
// added and removed are indices in their respective input order.
type Plan is data = #Plan { before_count: U32, previous: Array U32, added: Array U32, removed: Array U32 }
const match_keys = fn (before: Array U32) (after: Array U32) => do:
  let old = sort.order_u32 before
  let next = sort.order_u32 after
  let unique = #True
  for i in 1 .. old.length:
    unique := self && before[old[i - 1]] != before[old[i]]
  for i in 1 .. next.length:
    unique := self && after[next[i - 1]] != after[next[i]]
  if Bool.not unique:
    return #Nothing
  let previous = array.fill after.length before.length
  let retained = array.fill before.length #False
  let cursor = 0
  for at in next:
    let key = after[at]
    for cursor .. old.length:
      if before[old[cursor]] >= key:
        break
      cursor := self + 1
    if cursor < old.length && before[old[cursor]] == key:
      let index = old[cursor]
      previous[at] := index
      retained[index] := #True
  let added_count = 0
  let removed_count = 0
  for index in previous:
    if index == before.length:
      added_count := self + 1
  for kept in retained:
    if Bool.not kept:
      removed_count := self + 1
  let added = array.fill added_count 0
  let removed = array.fill removed_count 0
  let count = 0
  for i in 0 .. previous.length:
    if previous[i] == before.length:
      added[count] := i
      count := self + 1
  count := 0
  for i in 0 .. retained.length:
    if Bool.not retained[i]:
      removed[count] := i
      count := self + 1
  return #Some #Plan { before_count: before.length, previous, added, removed }

// Each output invokes exactly one callback. Retained receives old/new indices;
// added receives the new index. Old values stay owned by the caller.
const build = fn (plan: Plan) retained added => array.generate plan.previous.length (fn index =>
  if plan.previous[index] == plan.before_count then added index else retained plan.previous[index] index)
