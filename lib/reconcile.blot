import * as array from "std/array"
import * as sort from "./sort"

// Match unique full-width keys without owning their values or lifetime.
// previous addresses the old array in NEW order; before_count means absent.
// added and removed are indices in their respective input order.
type Plan is data = $Plan { before_count: U32, previous: &[U32], added: &[U32], removed: &[U32] }
func match_keys (before: #[U32]) -> (after: #[U32]) -> (previous: #[~U32]) -> (added: #[~U32]) -> (removed: #[~U32]) : Maybe Plan =>
  let old = sort.order_u32 before
  let next = sort.order_u32 after
  let unique = true
  for i in 1 .. old.length:
    unique := self and before[old[i - 1]] != before[old[i]]
  for i in 1 .. next.length:
    unique := self and after[next[i - 1]] != after[next[i]]
  if not unique:
    return $Nothing
  previous.truncate 0
  for _ in 0 .. after.length:
    previous.push before.length
  let retained = array.fill before.length false
  let cursor = 0
  for at in next:
    let key = after[at]
    for cursor .. old.length:
      if before[old[cursor]] >= key:
        break
      cursor := self + 1
    if cursor < old.length and before[old[cursor]] == key:
      let index = old[cursor]
      previous[at] = index
      retained[index] := true
  added.truncate 0
  removed.truncate 0
  for i in 0 .. previous.length:
    if previous[i] == before.length:
      added.push i
  for i in 0 .. retained.length:
    if not retained[i]:
      removed.push i
  return $Some $Plan {before_count: before.length,
    previous: previous.view 0 previous.length, added: added.view 0 added.length,
    removed: removed.view 0 removed.length}

// Each output invokes exactly one callback. Retained receives old/new indices;
// added receives the new index. Old values stay owned by the caller.
func build (plan: Plan) -> retained -> added => array.generate plan.previous.length (func index => return
  if plan.previous[index] == plan.before_count then added index else retained plan.previous[index] index)
