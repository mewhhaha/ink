import * as array from "std/array"
import { Vec3 } from "std/vector"
import { Quat, Vec4 } from "./math"
import * as math from "./math"
import * as shapes from "./shapes"
import * as terrain from "./terrain"
import * as spatial from "./spatial"
import { Shape } from "./shapes"

// What physics sees of a world: every entity with a collider, a body, a
// character or a brush becomes a proxy with a world-space shape and bounds.
// Callers build `Source` values from their own data. Queries (ray, shape cast,
// overlap) run against the scene built from those sources.

type ShapeKind is data = #Box | #Sphere | #Capsule | #Brush | #Heightfield terrain.Terrain
type BodyKind is data = #Dynamic | #Kinematic | #Static

// A collider as authored on an entity.
type Collider is data = #Collider {
  shape: ShapeKind,
  size: Vec3,
  radius: F32,
  height: F32,
  offset: Vec3,
  friction: F32,
  restitution: F32,
  layer: U32,
  mask: U32,
  trigger: Bool,
}

// A rigid body as authored, plus its simulation state.
type Rigid is data = #Rigid {
  kind: BodyKind,
  mass: F32,
  gravity_scale: F32,
  linear_damping: F32,
  angular_damping: F32,
  can_sleep: Bool,
  continuous: Bool,
  linear_velocity: Vec3,
  angular_velocity: Vec3,
  sleeping: Bool,
  sleep_time: F32,
}

// A character controller as authored, plus its state.
type Walker is data = #Walker {
  max_slope: F32,
  step_height: F32,
  snap_distance: F32,
  push: F32,
  velocity: Vec3,
  grounded: Bool,
  ground: U32,
  ground_normal: Vec3,
}

// One entity as physics reads it. Pose is in world space.
type Source is data = #Source {
  index: U32,
  id: U32,
  position: Vec3,
  rotation: Quat,
  scale: Vec3,
  collider: Maybe Collider,
  rigid: Maybe Rigid,
  walker: Maybe Walker,
  planes: Array Vec4,
}

// Proxy kinds.
const kind_static: U32 = 0
const kind_kinematic: U32 = 1
const kind_dynamic: U32 = 2

type Proxy is data = #Proxy {
  source: U32,
  id: U32,
  kind: U32,
  walker: Bool,
  shape: Shape,
  inertia: Vec3,
  inscribed: F32,
  low: Vec3,
  high: Vec3,
  layer: U32,
  mask: U32,
  friction: F32,
  restitution: F32,
  trigger: Bool,
}

type Scene is data = #Scene { proxies: Array Proxy, index: spatial.Index, slots: Array U32, source_count: U32 }

// The proxy moved by `shift` (translation only).
const shifted = fn (proxy: Proxy) => fn (shift: Vec3) => do:
  let shape = case proxy.shape of
    #shapes.Capsule { a, b, radius } => #shapes.Capsule { a: a + shift, b: b + shift, radius }
    #shapes.Hull poly => #shapes.Hull (shapes.poly_place poly shift math.identity_quat math.one3)
    #shapes.Heightfield t => do:
      t.origin := self + shift
      return #shapes.Heightfield t
  proxy.shape := shape
  proxy.low := self + shift
  proxy.high := self + shift
  return proxy

// A cast hit: the entity, the fraction of the motion travelled before
// touching, the contact point and normal (from the shape toward the moving
// capsule), and how deep the capsule started inside if it did.
type Hit is data = #Hit { id: U32, proxy: U32, time: F32, distance: F32, point: Vec3, normal: Vec3, surface: Vec3, depth: F32 }

const default_collider = #Collider {
  shape: #Brush,
  size: math.one3,
  radius: 0.5,
  height: 2.0,
  offset: math.zero3,
  friction: 0.6,
  restitution: 0.0,
  layer: 1,
  mask: 65535,
  trigger: #False,
}

const default_rigid = #Rigid {
  kind: #Dynamic, mass: 1.0, gravity_scale: 1.0,
  linear_damping: 0.0, angular_damping: 0.05,
  can_sleep: #True, continuous: #True,
  linear_velocity: math.zero3, angular_velocity: math.zero3,
  sleeping: #False, sleep_time: 0.0,
}
const default_walker = #Walker {
  max_slope: 50.0, step_height: 0.4, snap_distance: 0.3, push: 1.0,
  velocity: math.zero3, grounded: #False, ground: 0, ground_normal: math.up,
}

const source = fn (id: U32) => fn (position: Vec3) => #Source {
  index: 0, id, position, rotation: math.identity_quat, scale: math.one3,
  collider: #Nothing, rigid: #Nothing, walker: #Nothing, planes: #[],
}

// The default collider with a shape and its dimensions, and a source holding
// one, each made at once: every field update copies the whole record.
const shaped = fn (shape: ShapeKind) => fn (size: Vec3) => fn (radius: F32) => fn (height: F32) => fn (offset: Vec3) => do:
  let d = default_collider
  return #Collider { shape, size, radius, height, offset, friction: d.friction, restitution: d.restitution, layer: d.layer, mask: d.mask, trigger: d.trigger }

const holding = fn (id: U32) => fn (position: Vec3) => fn (collider: Collider) => fn (walker: Maybe Walker) => #Source {
  index: 0, id, position, rotation: math.identity_quat, scale: math.one3,
  collider: #Some collider, rigid: #Nothing, walker, planes: #[],
}

const box = fn (id: U32) => fn (position: Vec3) => fn (size: Vec3) => do:
  let d = default_collider
  return holding id position (shaped #Box size d.radius d.height d.offset) #Nothing

const sphere = fn (id: U32) => fn (position: Vec3) => fn (radius: F32) => do:
  let d = default_collider
  return holding id position (shaped #Sphere d.size radius d.height d.offset) #Nothing

const capsule = fn (id: U32) => fn (position: Vec3) => fn (radius: F32) => fn (height: F32) => do:
  let d = default_collider
  return holding id position (shaped #Capsule d.size radius height d.offset) #Nothing

const dynamic = fn (s: Source) => do:
  s.rigid := #Some default_rigid
  return s

// Characters are positioned by their feet.
const character = fn (id: U32) => fn (position: Vec3) => do:
  let d = default_collider
  return holding id position (shaped #Capsule d.size 0.4 1.8 (math.vec3 0.0 0.9 0.0)) (#Some default_walker)

// Finite terrain is authored in world space and remains immovable.
const ground = fn (id: U32) => fn (t: terrain.Terrain) => do:
  let d = default_collider
  return holding id t.origin (shaped (#Heightfield t) d.size d.radius d.height d.offset) #Nothing

// Compose a local pose with a parent pose.
const rotate = fn (q: Quat) => fn (v: Vec3) => math.Quat.rotate q v
const compose = fn (a: Quat) => fn (b: Quat) => a * b
const scale_by = fn (a: Vec3) => fn (b: Vec3) => shapes.mul3 a b

// `math.Quat.rotate q v` with the same operations on scalar parts:
// v + t w + u × t for u = q's vector part and t = 2 (u × v).
const rotate_parts = fn (q: Quat) => fn (vx: F32) => fn (vy: F32) => fn (vz: F32) => do:
  let tx = (q.y * vz - q.z * vy) * 2.0
  let ty = (q.z * vx - q.x * vz) * 2.0
  let tz = (q.x * vy - q.y * vx) * 2.0
  return #Vec3 {
    x: vx + tx * q.w + (q.y * tz - q.z * ty),
    y: vy + ty * q.w + (q.z * tx - q.x * tz),
    z: vz + tz * q.w + (q.x * ty - q.y * tx),
  }

// The world-space shape of a source, its principal inertia per unit mass and
// the radius of the largest sphere inside it; or nothing if it has no shape.
// Pose arithmetic stays scalar, in Vec3 operation order: each Vec3 temporary
// costs a heap allocation.
const shape_of = fn (source: Source) => fn (collider: Collider) => do:
  let sx = abs source.scale.x
  let sy = abs source.scale.y
  let sz = abs source.scale.z
  let q = source.rotation
  let turned = rotate_parts q (collider.offset.x * source.scale.x) (collider.offset.y * source.scale.y) (collider.offset.z * source.scale.z)
  let p = source.position
  let center = #Vec3 { x: p.x + turned.x, y: p.y + turned.y, z: p.z + turned.z }
  return case collider.shape of
    #Heightfield t => #Some (#shapes.Heightfield t, math.zero3, 0.0)
    #Box => do:
      let half = #Vec3 { x: collider.size.x * sx * 0.5, y: collider.size.y * sy * 0.5, z: collider.size.z * sz * 0.5 }
      let poly = shapes.box_poly center q half
      return #Some (#shapes.Hull poly, shapes.box_inertia half, min half.x (min half.y half.z))
    #Sphere => do:
      let radius = collider.radius * max sx (max sy sz)
      let i = shapes.sphere_inertia radius
      return #Some (#shapes.Capsule { a: center, b: center, radius }, #Vec3 { x: i, y: i, z: i }, radius)
    #Capsule => do:
      let radius = collider.radius * max sx sz
      let half_segment = max 0.0 (collider.height * sy * 0.5 - radius)
      let up = rotate_parts q 0.0 1.0 0.0
      let ax = up.x * half_segment
      let ay = up.y * half_segment
      let az = up.z * half_segment
      let a = #Vec3 { x: center.x - ax, y: center.y - ay, z: center.z - az }
      let b = #Vec3 { x: center.x + ax, y: center.y + ay, z: center.z + az }
      return #Some (#shapes.Capsule { a, b, radius }, shapes.capsule_inertia radius half_segment, radius)
    #Brush => do:
      let #Some local = shapes.hull_poly source.planes else:
        return #Nothing
      let (low, high) = shapes.bounds (#shapes.Hull local)
      let half = #Vec3 { x: (high.x - low.x) * sx * 0.5, y: (high.y - low.y) * sy * 0.5, z: (high.z - low.z) * sz * 0.5 }
      let poly = shapes.poly_place local source.position q source.scale
      return #Some (#shapes.Hull poly, shapes.box_inertia half, min half.x (min half.y half.z))

const kind_of = fn (source: Source) => case source.rigid of
  #Some r => case r.kind of
    #Dynamic => kind_dynamic
    #Kinematic => kind_kinematic
    #Static => kind_static
  #Nothing => case source.walker of
    #Some _ => kind_kinematic
    #Nothing => kind_static

const proxy_of = fn (index: U32) => fn (source: Source) => do:
  let collider = case source.collider of
    #Some c => c
    #Nothing => default_collider
  if source.planes.is_empty:
    let #Some _ = source.collider else:
      return #Nothing
  let kind = kind_of source
  if let #Heightfield _ = collider.shape:
    kind := kind_static
  let is_walker = case source.walker of
    #Some _ => #True
    #Nothing => #False
  // A dynamic body turns about its origin: it has no collider offset. A
  // character is as big as its capsule says and always stands upright,
  // whatever its transform's scale and rotation (a first-person camera
  // turns the transform).
  if kind == kind_dynamic:
    collider.offset := math.zero3
  if is_walker:
    source.scale := math.one3
    source.rotation := math.identity_quat
  let #Some (shape, inertia, inscribed) = shape_of source collider else:
    return #Nothing
  // A capsule's bounds as shapes.bounds makes them, without temporaries.
  let (low, high) = case shape of
    #shapes.Capsule { a, b, radius } => (#Vec3 { x: min a.x b.x - radius, y: min a.y b.y - radius, z: min a.z b.z - radius }, #Vec3 { x: max a.x b.x + radius, y: max a.y b.y + radius, z: max a.z b.z + radius })
    _ => shapes.bounds shape
  return #Some (#Proxy {
    source: index,
    id: source.id,
    kind,
    walker: is_walker,
    shape,
    inertia,
    inscribed,
    low,
    high,
    layer: collider.layer,
    mask: collider.mask,
    friction: collider.friction,
    restitution: collider.restitution,
    trigger: collider.trigger,
  })

// Proxies for every source that has a shape, in source order. Boxed proxies
// fill exactly sized arrays: appending them to a List one at a time is
// quadratic on the pinned compiler.
const build = fn (sources: Array Source) => do:
  let n = sources.length
  let candidates = @array.generate n (fn (i: U32) => proxy_of i sources[i])
  let count = 0
  for candidate in candidates:
    if let #Some _ = candidate:
      count := self + 1
  let slots = @array.fill n count
  let owners = @array.fill count 0
  let next = 0
  for i in 0..n:
    if let #Some _ = candidates[i]:
      slots[i] := next
      owners[next] := i
      next := self + 1
  let proxies = @array.generate count (fn (k: U32) => case candidates[owners[k]] of
    #Some proxy => proxy
    #Nothing => @panic "scene proxy owner has no shape")
  let index = spatial.build (@array.generate count (fn (i: U32) => #spatial.Bounds { low: proxies[i].low, high: proxies[i].high }))
  return #Scene { proxies, index, slots, source_count: n }

// Explicit dirty source indices avoid inspecting/rebuilding unchanged geometry.
// Source order/count or shape presence changes rebuild the tree as needed.
const update = fn (sources: Array Source) => fn (previous: Scene) => fn (changed: Array U32) => do:
  if sources.length != previous.source_count:
    return build sources
  if changed.is_empty:
    return previous
  let n = sources.length
  let count = previous.proxies.length
  // Each changed slot's proxy is made once. Slot `count` stands for a source
  // out of range or without a proxy, which refit skips. Exactly sized arrays
  // and no early exit keep the proxy copy's writes in place.
  let next = @array.generate changed.length (fn (k: U32) => do:
    let source = changed[k]
    if source < n:
      return proxy_of source sources[source]
    return #Nothing)
  let dirty = @array.generate changed.length (fn (k: U32) => do:
    let source = changed[k]
    if source < n:
      return previous.slots[source]
    return count)
  let rebuild = #False
  for k in 0..changed.length:
    if let #Some _ = next[k]:
      if dirty[k] >= count:
        rebuild := #True
    else:
      if dirty[k] < count:
        rebuild := #True
  if rebuild:
    return build sources
  let proxies = @array.generate count (fn (i: U32) => previous.proxies[i])
  for k in 0..changed.length:
    if let #Some p = next[k]:
      proxies[dirty[k]] := p
  let bounds = @array.generate changed.length (fn (k: U32) => case next[k] of
    #Some p => #spatial.Bounds { low: p.low, high: p.high }
    #Nothing => #spatial.Bounds { low: math.zero3, high: math.zero3 })
  let index = spatial.refit previous.index dirty bounds
  return #Scene { proxies, index, slots: previous.slots, source_count: n }

// Queries ---------------------------------------------------------------------------

// Do the bounds [low, high] (grown by `grow`) overlap the proxy's?
const touches_bounds = fn (proxy: Proxy) => fn (low: Vec3) => fn (high: Vec3) =>
  low.x <= proxy.high.x && high.x >= proxy.low.x && low.y <= proxy.high.y && high.y >= proxy.low.y && low.z <= proxy.high.z && high.z >= proxy.low.z

const hit_eps = 0.0003

// Move a capsule (segment ab, radius) by `delta` against one shape. Returns
// the first contact along the way: the fraction of `delta` travelled, the
// contact point on the shape, the normal pointing from the shape to the
// capsule, and how deep the capsule already was. If it overlaps at the start
// the fraction is 0.
const cast_shape = fn (shape: Shape) => fn (a: Vec3) => fn (b: Vec3) => fn (radius: F32) => fn (delta: Vec3) => do:
  let t = 0.0
  let heightfield = #False
  if let #shapes.Heightfield _ = shape:
    heightfield := #True
  let steps = 40
  if heightfield:
    steps := 96
  for 0..steps:
    let gap = shapes.segment_gap shape (a + delta * t) (b + delta * t)
    let clearance = gap.dist - radius
    if clearance <= hit_eps:
      return #Some (t, gap.on_shape, gap.normal, gap.surface, if t == 0.0 then max 0.0 (F32.neg clearance) else 0.0)
    let closing = F32.neg (gap.normal.dot delta)
    if heightfield:
      closing := delta.length
    if closing <= 0.000001:
      return #Nothing
    t := self + clearance / closing
    if t > 1.0:
      return #Nothing
  return #Nothing

// Bounds swept by a moving capsule.
const swept_bounds = fn (a: Vec3) => fn (b: Vec3) => fn (radius: F32) => fn (delta: Vec3) => do:
  let r = #Vec3 { x: radius, y: radius, z: radius }
  let low = shapes.min3 (shapes.min3 a b) (shapes.min3 (a + delta) (b + delta)) - r
  let high = shapes.max3 (shapes.max3 a b) (shapes.max3 (a + delta) (b + delta)) + r
  return (low, high)

// What a cast can touch: proxies on `mask` layers, never `skip` (an entity id),
// triggers only if `triggers`, characters only if `walkers`, dynamic bodies
// only if `dynamics`.
type Filter is data = #Filter { mask: U32, skip: U32, triggers: Bool, walkers: Bool, dynamics: Bool }

const accepts = fn (f: Filter) => fn (proxy: Proxy) =>
  (proxy.layer & f.mask) != 0 && proxy.id != f.skip && (f.triggers || Bool.not proxy.trigger) && (f.walkers || Bool.not proxy.walker) && (f.dynamics || proxy.kind != kind_dynamic)

// The nearest hit of a moving capsule, if any.
const cast = fn (scene: Scene) => fn (a: Vec3) => fn (b: Vec3) => fn (radius: F32) => fn (delta: Vec3) => fn (filter: Filter) => do:
  let (low, high) = swept_bounds a b radius delta
  let best: Maybe Hit = #Nothing
  let best_time = 2.0
  for index in spatial.query scene.index low high:
    let proxy = scene.proxies[index]
    if accepts filter proxy && touches_bounds proxy low high:
      if let #Some (t, point, normal, surface, depth) = cast_shape proxy.shape a b radius delta:
        if t < best_time:
          best_time := t
          best := #Some (#Hit { id: proxy.id, proxy: index, time: t, distance: t * delta.length, point, normal, surface, depth })
  return best

const solid_filter = fn (mask: U32) => #Filter { mask, skip: 0, triggers: #False, walkers: #True, dynamics: #True }

// A ray: the nearest hit within `reach` along `direction`, never entity `skip`.
const ray = fn (scene: Scene) => fn (origin: Vec3) => fn (direction: Vec3) => fn (reach: F32) => fn (mask: U32) => fn (skip: U32) => do:
  let delta = direction.normalized * reach
  return cast scene origin origin 0.0 delta (#Filter { mask, skip, triggers: #False, walkers: #True, dynamics: #True })

// Every proxy overlapping a sphere, by ascending source index.
const overlap_sphere = fn (scene: Scene) => fn (center: Vec3) => fn (radius: F32) => fn (mask: U32) => do:
  let r = #Vec3 { x: radius, y: radius, z: radius }
  let low = center - r
  let high = center + r
  let found: List U32 = []
  for index in spatial.query scene.index low high:
    let proxy = scene.proxies[index]
    if (proxy.layer & mask) != 0 && touches_bounds proxy low high:
      let gap = shapes.segment_gap proxy.shape center center
      if gap.dist <= radius:
        found := [...self, proxy.id]
  return Array.from_list found

// Every proxy overlapping a capsule.
const overlap_capsule = fn (scene: Scene) => fn (a: Vec3) => fn (b: Vec3) => fn (radius: F32) => fn (mask: U32) => do:
  let (low, high) = swept_bounds a b radius shapes.zero
  let found: List U32 = []
  for index in spatial.query scene.index low high:
    let proxy = scene.proxies[index]
    if (proxy.layer & mask) != 0 && touches_bounds proxy low high:
      let gap = shapes.segment_gap proxy.shape a b
      if gap.dist <= radius:
        found := [...self, proxy.id]
  return Array.from_list found

// Is the point inside any solid (non-trigger) proxy?
const point_solid = fn (scene: Scene) => fn (p: Vec3) => fn (mask: U32) => do:
  for index in spatial.query scene.index p p:
    let proxy = scene.proxies[index]
    if (proxy.layer & mask) != 0 && Bool.not proxy.trigger && touches_bounds proxy p p:
      let gap = shapes.segment_gap proxy.shape p p
      if gap.dist <= 0.0:
        return #True
  return #False
