import * as changes from "./changes"
import * as array from "std/array"
import { Vec3 } from "std/vector"
import { Quat, Vec4 } from "./math"
import * as math from "./math"
import * as shapes from "./shapes"
import * as terrain from "./terrain"
import * as spatial from "./spatial"
import * as mesh from "./mesh"
import { Shape } from "./shapes"

// What physics sees of a world: every entity with a collider, a body, a
// character or a brush becomes a proxy with a world-space shape and bounds.
// Callers build `Source` values from their own data. Queries (ray, shape cast,
// overlap) run against the scene built from those sources.

type ShapeKind is data = $Box | $Sphere | $Capsule | $Brush | $Heightfield terrain.Terrain | $Mesh mesh.Mesh
type BodyKind is data = $Dynamic | $Kinematic | $Static

// A collider as authored on an entity.
type Collider is data = $Collider {
  shape: ShapeKind,
  size: Vec3,
  radius: F32,
  height: F32,
  offset: Vec3,
  friction: F32,
  restitution: F32,
  layer: U32,
  mask: U32,
  trigger: Bool,
}

// A rigid body as authored, plus its simulation state.
type Rigid is data = $Rigid {
  kind: BodyKind,
  mass: F32,
  gravity_scale: F32,
  linear_damping: F32,
  angular_damping: F32,
  can_sleep: Bool,
  continuous: Bool,
  linear_velocity: Vec3,
  angular_velocity: Vec3,
  sleeping: Bool,
  sleep_time: F32,
}

// A character controller as authored, plus its state.
type Walker is data = $Walker {
  max_slope: F32,
  step_height: F32,
  snap_distance: F32,
  push: F32,
  velocity: Vec3,
  grounded: Bool,
  ground: U32,
  ground_normal: Vec3,
}

// One entity as physics reads it. Pose is in world space.
type Source is data = $Source {
  index: U32,
  id: U32,
  position: Vec3,
  rotation: Quat,
  scale: Vec3,
  collider: Maybe Collider,
  rigid: Maybe Rigid,
  walker: Maybe Walker,
  planes: &[Vec4],
}

// Proxy kinds.
const kind_static: U32 = 0
const kind_kinematic: U32 = 1
const kind_dynamic: U32 = 2

type Proxy is data = $Proxy {
  source: U32,
  id: U32,
  kind: U32,
  walker: Bool,
  shape: Shape,
  inertia: Vec3,
  inscribed: F32,
  low: Vec3,
  high: Vec3,
  layer: U32,
  mask: U32,
  friction: F32,
  restitution: F32,
  trigger: Bool,
}

// Persistent proxy payloads contain scalar spans, never borrowed descriptors.
type ProxyRow is data = $ProxyRow {
  source: U32,
  id: U32,
  kind: U32,
  walker: Bool,
  shape: shapes.StoredShape,
  inertia: Vec3,
  inscribed: F32,
  low: Vec3,
  high: Vec3,
  layer: U32,
  mask: U32,
  friction: F32,
  restitution: F32,
  trigger: Bool,
}
func packed_proxy (shape: shapes.StoredShape) -> (value: Proxy) => $ProxyRow {
  source: value.source,
  id: value.id,
  kind: value.kind,
  walker: value.walker,
  shape,
  inertia: value.inertia,
  inscribed: value.inscribed,
  low: value.low,
  high: value.high,
  layer: value.layer,
  mask: value.mask,
  friction: value.friction,
  restitution: value.restitution,
  trigger: value.trigger,
}
func pack_proxy (geometry: own shapes.Geometry) -> (value: Proxy) : (ProxyRow, shapes.Geometry) =>
  let (shape, geometry) = shapes.pack geometry value.shape
  return (packed_proxy shape value, geometry)
func unpack_proxy geometry -> (value: ProxyRow) => $Proxy {
  source: value.source,
  id: value.id,
  kind: value.kind,
  walker: value.walker,
  shape: shapes.unpack geometry value.shape,
  inertia: value.inertia,
  inscribed: value.inscribed,
  low: value.low,
  high: value.high,
  layer: value.layer,
  mask: value.mask,
  friction: value.friction,
  restitution: value.restitution,
  trigger: value.trigger,
}

type Scene is data = $Scene { geometry: shapes.Geometry, proxies: #[ProxyRow], index: spatial.Index, slots: #[U32], source_count: U32 }
type Read is data = $Read { geometry: shapes.Read, proxies: &[ProxyRow], index: spatial.Read, slots: &[U32] }
func read (scene: Scene): Read => $Read {geometry: shapes.read scene.geometry,
  proxies: &scene.proxies[0..scene.proxies.length], index: spatial.read scene.index, slots: &scene.slots[0..scene.slots.length]}
func count scene => scene.proxies.length
func proxy scene -> index => unpack_proxy scene.geometry scene.proxies[index]
func proxies (scene: Scene) : #[Proxy] =>
  let values: #[Proxy] = #[]
  for i in 0 .. scene.proxies.length:
    @storage.push values (proxy scene i)
  return values


// The stored proxy row moved by `shift` (translation only).
// `row`'s shape must already reside in `geometry` if it is a hull.
func shifted_row (geometry: own shapes.Geometry) -> (row: ProxyRow) -> (shift: Vec3) : (ProxyRow, shapes.Geometry) =>
  if let $shapes.StoredCapsule { a, b, radius } = row.shape:
    row.shape := $shapes.StoredCapsule { a: a + shift, b: b + shift, radius }
  else:
    if let $shapes.StoredHull poly = row.shape:
      let (placed, next_geom) = shapes.poly_place_stored geometry poly shift math.identity_quat math.one3
      geometry := next_geom
      row.shape := $shapes.StoredHull placed
    else:
      if let $shapes.StoredHeightfield t = row.shape:
        t.origin := self + shift
        row.shape := $shapes.StoredHeightfield t
  row.low := self + shift
  row.high := self + shift
  return (row, geometry)

// A cast hit: the entity, the fraction of the motion travelled before
// touching, the contact point and normal (from the shape toward the moving
// capsule), and how deep the capsule started inside if it did.
type Hit is data = $Hit { id: U32, proxy: U32, time: F32, distance: F32, point: Vec3, normal: Vec3, surface: Vec3, depth: F32 }

const default_collider = $Collider {
  shape: $Brush,
  size: math.one3,
  radius: 0.5,
  height: 2.0,
  offset: math.zero3,
  friction: 0.6,
  restitution: 0.0,
  layer: 1,
  mask: 65535,
  trigger: false,
}

const default_rigid = $Rigid {
  kind: $Dynamic, mass: 1.0, gravity_scale: 1.0,
  linear_damping: 0.0, angular_damping: 0.05,
  can_sleep: true, continuous: true,
  linear_velocity: math.zero3, angular_velocity: math.zero3,
  sleeping: false, sleep_time: 0.0,
}
const default_walker = $Walker {
  max_slope: 50.0, step_height: 0.4, snap_distance: 0.3, push: 1.0,
  velocity: math.zero3, grounded: false, ground: 0, ground_normal: math.up,
}

const empty_planes: #[Vec4] = #[]
func source (id: U32) => func (position: Vec3) => $Source {
  index: 0, id, position, rotation: math.identity_quat, scale: math.one3,
  collider: $Nothing, rigid: $Nothing, walker: $Nothing, planes: &empty_planes[0..0],
}

// The default collider with a shape and its dimensions, and a source holding
// one, each made at once: every field update copies the whole record.
func shaped (shape: ShapeKind) => func (size: Vec3) => func (radius: F32) => func (height: F32) => func (offset: Vec3) =>
  let d = default_collider
  return $Collider { shape, size, radius, height, offset, friction: d.friction, restitution: d.restitution, layer: d.layer, mask: d.mask, trigger: d.trigger }

func holding (id: U32) => func (position: Vec3) => func (collider: Collider) => func (walker: Maybe Walker) => $Source {
  index: 0, id, position, rotation: math.identity_quat, scale: math.one3,
  collider: $Some collider, rigid: $Nothing, walker, planes: &empty_planes[0..0],
}

func box (id: U32) => func (position: Vec3) => func (size: Vec3) =>
  let d = default_collider
  return holding id position (shaped $Box size d.radius d.height d.offset) $Nothing

func sphere (id: U32) => func (position: Vec3) => func (radius: F32) =>
  let d = default_collider
  return holding id position (shaped $Sphere d.size radius d.height d.offset) $Nothing

func capsule (id: U32) => func (position: Vec3) => func (radius: F32) => func (height: F32) =>
  let d = default_collider
  return holding id position (shaped $Capsule d.size radius height d.offset) $Nothing

func dynamic (s: Source) =>
  s.rigid := $Some default_rigid
  return s

// Characters are positioned by their feet.
func character (id: U32) => func (position: Vec3) =>
  let d = default_collider
  return holding id position (shaped $Capsule d.size 0.4 1.8 (math.vec3 0.0 0.9 0.0)) ($Some default_walker)

// A static triangle mesh authored in world space (see `shapes.cook_mesh`).
func level (id: U32) => func (m: mesh.Mesh) =>
  let d = default_collider
  return holding id math.zero3 (shaped ($Mesh m) d.size d.radius d.height d.offset) $Nothing

// Finite terrain is authored in world space and remains immovable.
func ground (id: U32) => func (t: terrain.Terrain) =>
  let d = default_collider
  return holding id t.origin (shaped ($Heightfield t) d.size d.radius d.height d.offset) $Nothing

// Compose a local pose with a parent pose.
func rotate (q: Quat) => func (v: Vec3) => math.Quat.rotate q v
func compose (a: Quat) => func (b: Quat) => a * b
func scale_by (a: Vec3) => func (b: Vec3) => shapes.mul3 a b

// The world-space shape of a source, its principal inertia per unit mass and
// the radius of the largest sphere inside it; or nothing if it has no shape.
// Pose arithmetic stays scalar, in Vec3 operation order: each Vec3 temporary
// costs a heap allocation.
func pack_heightfield (geometry: own shapes.Geometry) -> (t: terrain.Terrain) : (terrain.Stored, shapes.Geometry) =>
  let $shapes.Geometry { points, planes, rings, indices, heights, source_planes } = geometry
  let (stored, heights) = terrain.pack heights t
  return (stored, $shapes.Geometry { points, planes, rings, indices, heights, source_planes })

func shape_of (geometry: own shapes.Geometry) -> (source: Source) -> (collider: Collider) : (Maybe (shapes.StoredShape, Vec3, F32), shapes.Geometry) =>
  if not (math.finite3 source.position and math.finite3 source.scale and math.finite_quat source.rotation and math.finite3 collider.offset):
    return ($Nothing, geometry)
  let sx = abs source.scale.x
  let sy = abs source.scale.y
  let sz = abs source.scale.z
  let q = source.rotation
  let (ox, oy, oz) = math.rotate_parts q.x q.y q.z q.w (collider.offset.x * source.scale.x) (collider.offset.y * source.scale.y) (collider.offset.z * source.scale.z)
  let p = source.position
  let center = $Vec3 { x: p.x + ox, y: p.y + oy, z: p.z + oz }
  if let $Heightfield t = collider.shape:
    let (stored_t, next_geom) = pack_heightfield geometry t
    return ($Some ($shapes.StoredHeightfield stored_t, math.zero3, 0.0), next_geom)
  if let $Mesh m = collider.shape:
    let (stored, next_geom) = shapes.pack_mesh geometry m
    return ($Some ($shapes.StoredMeshShape stored, math.zero3, 0.0), next_geom)
  if let $Box = collider.shape:
    if not (math.finite3 collider.size):
      return ($Nothing, geometry)
    let half = $Vec3 { x: abs collider.size.x * sx * 0.5, y: abs collider.size.y * sy * 0.5, z: abs collider.size.z * sz * 0.5 }
    let (poly, next_geom) = shapes.box_poly geometry center q half
    return ($Some ($shapes.StoredHull poly, shapes.box_inertia half, min half.x (min half.y half.z)), next_geom)
  if let $Sphere = collider.shape:
    if not (is_finite collider.radius):
      return ($Nothing, geometry)
    let radius = max 0.0 collider.radius * max sx (max sy sz)
    let i = shapes.sphere_inertia radius
    return ($Some ($shapes.StoredCapsule { a: center, b: center, radius }, $Vec3 { x: i, y: i, z: i }, radius), geometry)
  if let $Capsule = collider.shape:
    if not (is_finite collider.radius and is_finite collider.height):
      return ($Nothing, geometry)
    let radius = max 0.0 collider.radius * max sx sz
    let half_segment = max 0.0 (max 0.0 collider.height * sy * 0.5 - radius)
    let (ux, uy, uz) = math.rotate_parts q.x q.y q.z q.w 0.0 1.0 0.0
    let ax = ux * half_segment
    let ay = uy * half_segment
    let az = uz * half_segment
    let a = $Vec3 { x: center.x - ax, y: center.y - ay, z: center.z - az }
    let b = $Vec3 { x: center.x + ax, y: center.y + ay, z: center.z + az }
    return ($Some ($shapes.StoredCapsule { a, b, radius }, shapes.capsule_inertia radius half_segment, radius), geometry)
  if sx <= 1.0e-12 or sy <= 1.0e-12 or sz <= 1.0e-12:
    return ($Nothing, geometry)
  let (maybe_local, scratch) = shapes.hull_poly (shapes.empty ()) source.planes
  if let $Some stored_local = maybe_local:
    let local = shapes.unpack_poly scratch stored_local
    let (low, high) = shapes.bounds ($shapes.Hull local)
    let half = $Vec3 { x: (high.x - low.x) * sx * 0.5, y: (high.y - low.y) * sy * 0.5, z: (high.z - low.z) * sz * 0.5 }
    let (poly, next_geom) = shapes.poly_place geometry local source.position q source.scale
    return ($Some ($shapes.StoredHull poly, shapes.box_inertia half, min half.x (min half.y half.z)), next_geom)
  return ($Nothing, geometry)

func kind_of (source: Source) => case source.rigid of
  $Some r => case r.kind of
    $Dynamic => kind_dynamic
    $Kinematic => kind_kinematic
    $Static => kind_static
  $Nothing => case source.walker of
    $Some _ => kind_kinematic
    $Nothing => kind_static

func proxy_of (geometry: own shapes.Geometry) -> (index: U32) -> (source: Source) : (Maybe ProxyRow, shapes.Geometry) =>
  let collider = case source.collider of
    $Some c => c
    $Nothing => default_collider
  if source.planes.length == 0:
    let $Some _ = source.collider else:
      return ($Nothing, geometry)
  let kind = kind_of source
  if let $Heightfield _ = collider.shape:
    kind := kind_static
  if let $Mesh _ = collider.shape:
    kind := kind_static
  let is_walker = case source.walker of
    $Some _ => true
    $Nothing => false
  // A dynamic body turns about its origin: it has no collider offset. A
  // character is as big as its capsule says and always stands upright,
  // whatever its transform's scale and rotation (a first-person camera
  // turns the transform).
  if kind == kind_dynamic:
    collider.offset := math.zero3
  if is_walker:
    source.scale := math.one3
    source.rotation := math.identity_quat
  let (maybe_shape, geometry) = shape_of geometry source collider
  let $Some (stored_shape, inertia, inscribed) = maybe_shape else:
    return ($Nothing, geometry)
  // A capsule's bounds as shapes.bounds makes them, without temporaries.
  let (low, high) = case stored_shape of
    $shapes.StoredCapsule { a, b, radius } => ($Vec3 { x: min a.x b.x - radius, y: min a.y b.y - radius, z: min a.z b.z - radius }, $Vec3 { x: max a.x b.x + radius, y: max a.y b.y + radius, z: max a.z b.z + radius })
    _ => shapes.bounds (shapes.unpack geometry stored_shape)
  return ($Some ($ProxyRow {
    source: index,
    id: source.id,
    kind,
    walker: is_walker,
    shape: stored_shape,
    inertia,
    inscribed,
    low,
    high,
    layer: collider.layer,
    mask: collider.mask,
    friction: collider.friction,
    restitution: collider.restitution,
    trigger: collider.trigger,
  }), geometry)

// Explicit dirty source indices mutate the live scene without rebuilding unchanged geometry.
// Source order/count or shape presence changes rebuild the tree as needed.
func update (sources: #[Source]) -> (previous: own Scene) -> (changed: #[U32]) : Scene =>
  if sources.length != previous.source_count:
    return build_into previous sources
  if changed.is_empty:
    return previous
  let n = sources.length
  let changed = array.filter (func i => i < n) (changes.unique changed)
  if changed.length == 0:
    return previous
  let $Scene {geometry: storage, proxies, index, slots, source_count} = previous
  let count = proxies.length
  // Slot `count` stands for a source without a proxy, which refit skips.
  let dirty = @array.fill changed.length count
  for k in 0 .. changed.length:
    dirty[k] := slots[changed[k]]
  // New proxy geometry is scratch. The live scene keeps only the packed spans.
  let scratch = shapes.empty ()
  let next: #[Maybe ProxyRow] = #[]
  for k in 0 .. changed.length:
    let (row, next_scratch) = proxy_of scratch changed[k] sources[changed[k]]
    scratch := next_scratch
    @storage.push next row
  let rebuild = false
  for k in 0..changed.length:
    if let $Some _ = next[k]:
      if dirty[k] >= count:
        rebuild := true
    else:
      if dirty[k] < count:
        rebuild := true
  if rebuild:
    return build_into ($Scene {geometry: storage, proxies, index, slots, source_count}) sources
  for k in 0 .. dirty.length:
    if let $Some row = next[k]:
      let slot = dirty[k]
      let unpacked = shapes.unpack scratch row.shape
      let (shape, geometry) = shapes.replace storage proxies[slot].shape unpacked
      storage := geometry
      row.shape := shape
      proxies[slot] := row
  let bounds = @array.generate changed.length (func (k: U32) => case next[k] of
    $Some p => $spatial.Bounds { low: p.low, high: p.high }
    $Nothing => $spatial.Bounds { low: math.zero3, high: math.zero3 })
  let index = spatial.refit index dirty bounds
  return $Scene {geometry: storage, proxies, index, slots, source_count}

// Queries ---------------------------------------------------------------------------

// Do the bounds [low, high] (grown by `grow`) overlap the proxy's?
func touches_bounds (proxy: Proxy) => func (low: Vec3) => func (high: Vec3) => return
  low.x <= proxy.high.x and high.x >= proxy.low.x and low.y <= proxy.high.y and high.y >= proxy.low.y and low.z <= proxy.high.z and high.z >= proxy.low.z

const hit_eps = 0.0003

// Move a capsule (segment ab, radius) by `delta` against one shape. Returns
// the first contact along the way: the fraction of `delta` travelled, the
// contact point on the shape, the normal pointing from the shape to the
// capsule, and how deep the capsule already was. If it overlaps at the start
// the fraction is 0.
func cast_shape (shape: Shape) => func (a: Vec3) => func (b: Vec3) => func (radius: F32) => func (delta: Vec3) =>
  // A ray against a mesh is exact: the nearest triangle along the segment.
  if let $shapes.Mesh m = shape:
    if radius == 0.0 and a.x == b.x and a.y == b.y and a.z == b.z:
      let found = mesh.ray_hit m a delta
      let $Some (time, point, normal, surface, _) = found else:
        return $Nothing
      return $Some (time, point, normal, surface, 0.0)
  let t = 0.0
  let heightfield = false
  if let $shapes.Heightfield _ = shape:
    heightfield := true
  let steps = 40
  if heightfield:
    steps := 96
  for 0..steps:
    let gap = shapes.segment_gap shape ($Vec3 { x: a.x + delta.x * t, y: a.y + delta.y * t, z: a.z + delta.z * t }) ($Vec3 { x: b.x + delta.x * t, y: b.y + delta.y * t, z: b.z + delta.z * t })
    let clearance = gap.dist - radius
    if clearance <= hit_eps:
      return $Some (t, gap.on_shape, gap.normal, gap.surface, if t == 0.0 then max 0.0 (F32.neg clearance) else 0.0)
    let closing = F32.neg (gap.normal.dot delta)
    if heightfield:
      closing := delta.length
    if closing <= 0.000001:
      return $Nothing
    t := self + clearance / closing
    if t > 1.0:
      return $Nothing
  return $Nothing

// Bounds swept by a moving capsule: the corners' least and greatest
// coordinates, before and after the move, widened by the radius. Scalars keep
// the Vec3 operation order without allocating temporaries.
func swept_bounds (a: Vec3) => func (b: Vec3) => func (radius: F32) => func (delta: Vec3) =>
  let ex = a.x + delta.x
  let ey = a.y + delta.y
  let ez = a.z + delta.z
  let fx = b.x + delta.x
  let fy = b.y + delta.y
  let fz = b.z + delta.z
  let low = $Vec3 { x: min (min a.x b.x) (min ex fx) - radius, y: min (min a.y b.y) (min ey fy) - radius, z: min (min a.z b.z) (min ez fz) - radius }
  let high = $Vec3 { x: max (max a.x b.x) (max ex fx) + radius, y: max (max a.y b.y) (max ey fy) + radius, z: max (max a.z b.z) (max ez fz) + radius }
  return (low, high)

// What a cast can touch: proxies on `mask` layers, never `skip` (an entity id),
// triggers only if `triggers`, characters only if `walkers`, dynamic bodies
// only if `dynamics`.
type Filter is data = $Filter { mask: U32, skip: U32, triggers: Bool, walkers: Bool, dynamics: Bool }

func accepts (f: Filter) => func (proxy: Proxy) => return
  (proxy.layer & f.mask) != 0 and proxy.id != f.skip and (f.triggers or not proxy.trigger) and (f.walkers or not proxy.walker) and (f.dynamics or proxy.kind != kind_dynamic)

// The nearest hit of a moving capsule, if any.
// Conservative time lower bound for the capsule's moving AABB. Match the
// original swept candidate box, then allow narrow-phase tolerance and F32
// coordinate roundoff before pruning against an earlier hit.
func lower_time (low: Vec3) -> (high: Vec3) -> (a: Vec3) -> (b: Vec3) -> (radius: F32) -> (delta: Vec3) -> (bounds: &[F32]) -> (offset: U32) =>
  if not (low.x <= bounds[offset + 3] and high.x >= bounds[offset] and low.y <= bounds[offset + 4] and high.y >= bounds[offset + 1] and low.z <= bounds[offset + 5] and high.z >= bounds[offset + 2]):
    return 1.0 / 0.0
  let lower = 0.0
  let starts = (min a.x b.x - radius, min a.y b.y - radius, min a.z b.z - radius)
  let ends = (max a.x b.x + radius, max a.y b.y + radius, max a.z b.z + radius)
  let (lx, ly, lz) = starts
  let (hx, hy, hz) = ends
  for axis in 0 .. 3:
    let lo = if axis == 0 then lx else if axis == 1 then ly else lz
    let hi = if axis == 0 then hx else if axis == 1 then hy else hz
    let speed = if axis == 0 then delta.x else if axis == 1 then delta.y else delta.z
    let left = bounds[offset + axis]
    let right = bounds[offset + 3 + axis]
    let safety = hit_eps + 0.00001 * (abs lo + abs hi + abs left + abs right + abs speed)
    if speed > 0.0:
      lower := max self ((left - hi - safety) / speed)
    if speed < 0.0:
      lower := max self ((right - lo + safety) / speed)
  return lower
func cast scene => func (a: Vec3) => func (b: Vec3) => func (radius: F32) => func (delta: Vec3) => func (filter: Filter) =>
  let (low, high) = swept_bounds a b radius delta
  let found = spatial.closest scene.index (lower_time low high a b radius delta) (func (index: U32) =>
    let p = proxy scene index
    if accepts filter p and touches_bounds p low high:
      return cast_shape p.shape a b radius delta
    return $Nothing) (func (value: (F32, Vec3, Vec3, Vec3, F32)) =>
      let (time, _, _, _, _) = value
      return time) 2.0
  return Maybe.map (func found =>
    let p = proxy scene found.index
    let (t, point, normal, surface, depth) = found.value
    return $Hit {id: p.id, proxy: found.index, time: t, distance: t * delta.length, point, normal, surface, depth}) found

func solid_filter (mask: U32) => $Filter { mask, skip: 0, triggers: false, walkers: true, dynamics: true }

// A ray: the nearest hit within `reach` along `direction`, never entity `skip`.
func ray scene => func (origin: Vec3) => func (direction: Vec3) => func (reach: F32) => func (mask: U32) => func (skip: U32) =>
  // Vec3.normalized, then scaled by the reach.
  let length = sqrt (direction.x * direction.x + direction.y * direction.y + direction.z * direction.z)
  let delta = if length == 0.0 then $Vec3 { x: direction.x * reach, y: direction.y * reach, z: direction.z * reach } else $Vec3 { x: direction.x / length * reach, y: direction.y / length * reach, z: direction.z / length * reach }
  return cast scene origin origin 0.0 delta ($Filter { mask, skip, triggers: false, walkers: true, dynamics: true })

// Every proxy overlapping a sphere, by ascending source index.
func overlap_sphere scene => func (center: Vec3) => func (radius: F32) => func (mask: U32) =>
  let low = $Vec3 { x: center.x - radius, y: center.y - radius, z: center.z - radius }
  let high = $Vec3 { x: center.x + radius, y: center.y + radius, z: center.z + radius }
  let found: #[U32] = #[]
  for index in spatial.query scene.index low high:
    let proxy = unpack_proxy scene.geometry scene.proxies[index]
    if (proxy.layer & mask) != 0 and touches_bounds proxy low high:
      let gap = shapes.segment_gap proxy.shape center center
      if gap.dist <= radius:
        @storage.push found proxy.id
  return found

// Every proxy overlapping a capsule.
func overlap_capsule scene => func (a: Vec3) => func (b: Vec3) => func (radius: F32) => func (mask: U32) =>
  let (low, high) = swept_bounds a b radius shapes.zero
  let found: #[U32] = #[]
  for index in spatial.query scene.index low high:
    let proxy = unpack_proxy scene.geometry scene.proxies[index]
    if (proxy.layer & mask) != 0 and touches_bounds proxy low high:
      let gap = shapes.segment_gap proxy.shape a b
      if gap.dist <= radius:
        @storage.push found proxy.id
  return found

// Is the point inside any solid (non-trigger) proxy?
func point_solid scene => func (p: Vec3) => func (mask: U32) => return
  spatial.any scene.index p p (func index =>
    let value = proxy scene index
    if (value.layer & mask) != 0 and not value.trigger and touches_bounds value p p:
      return (shapes.segment_gap value.shape p p).dist <= 0.0
    return false)

// Share the caller's invalidation batch with other derived views. Sources remain authoritative.
func update_changes (sources: #[Source]) -> (previous: own Scene) -> change : Scene =>
  if change.reset:
    return build_into previous sources
  return update sources previous (changes.affected change)

// The simulation has a moving and an optional static scene. Keep their access
// bundles explicit; no collection owns other independently growing scenes.
type Queries is data = $Queries { primary: Read, secondary: Read, paired: Bool }
func single (sc: Read): Queries => $Queries { primary: sc, secondary: sc, paired: false }
func queries (sc: Scene): Queries => single (read sc)
func together (a: Queries) -> (b: Queries): Queries =>
  if a.paired or b.paired:
    return panic "query composition supports one moving and one static scene"
  return $Queries { primary: a.primary, secondary: b.primary, paired: true }
func query_parts (queries: Queries): U32 => if queries.paired then 2 else 1
func query_part (queries: Queries) -> (index: U32): Read =>
  if index == 0:
    return queries.primary
  if index == 1 and queries.paired:
    return queries.secondary
  return panic "scene query part outside composition"
func query_cast (queries: Queries) => func a => func b => func radius => func delta => func filter =>
  let best: Maybe Hit = $Nothing
  let best_time = 2.0
  let offset = 0
  for part_index in 0 .. query_parts queries:
    let part = query_part queries part_index
    if let $Some hit = cast part a b radius delta filter:
      if hit.time < best_time:
        best_time := hit.time
        best := $Some ($Hit { id: hit.id, proxy: offset + hit.proxy, time: hit.time, distance: hit.distance,
          point: hit.point, normal: hit.normal, surface: hit.surface, depth: hit.depth })
    offset := self + count part
  return best
func query_overlap_sphere (queries: Queries) -> center -> radius -> mask =>
  let found: #[U32] = #[]
  for part_index in 0 .. query_parts queries:
    for id in overlap_sphere (query_part queries part_index) center radius mask:
      @storage.push found id
  return found
func query_overlap_capsule (queries: Queries) -> a -> b -> radius -> mask =>
  let found: #[U32] = #[]
  for part_index in 0 .. query_parts queries:
    for id in overlap_capsule (query_part queries part_index) a b radius mask:
      @storage.push found id
  return found
func query_point_solid (queries: Queries) => func point => func mask =>
  for part_index in 0 .. query_parts queries:
    let part = query_part queries part_index
    if point_solid part point mask:
      return true
  return false
func query_ray (queries: Queries) => func origin => func direction => func reach => func mask => func skip =>
  let best: Maybe Hit = $Nothing
  let best_time = 2.0
  let offset = 0
  for part_index in 0 .. query_parts queries:
    let part = query_part queries part_index
    if let $Some hit = ray part origin direction reach mask skip:
      if hit.time < best_time:
        best_time := hit.time
        best := $Some ($Hit { id: hit.id, proxy: offset + hit.proxy, time: hit.time, distance: hit.distance,
          point: hit.point, normal: hit.normal, surface: hit.surface, depth: hit.depth })
    offset := self + count part
  return best


// Build and restore replace the scene rows. Earlier geometry/query borrows end
// before this boundary.
func access (geometry: own shapes.Geometry) -> (proxies: own #[ProxyRow]) -> (bounds: own #[F32]) -> (order: own #[U32]) -> (leaves: own #[U32]) -> (slots: own #[U32]) : Scene => return
  $Scene { geometry, proxies, index: spatial.access 0 bounds order leaves, slots, source_count: 0 }
func empty () : Scene =>
  let proxies: #[ProxyRow] = #[]
  let bounds: #[F32] = #[]
  let order: #[U32] = #[]
  let leaves: #[U32] = #[]
  let slots: #[U32] = #[]
  return access (shapes.empty ()) proxies bounds order leaves slots
func build_rows (geometry: own shapes.Geometry) -> (sources: #[Source]) : (#[ProxyRow], #[U32], shapes.Geometry) =>
  let rows: #[ProxyRow] = #[]
  let slots: #[U32] = @array.fill sources.length 0xFFFFFFFF
  for i in 0 .. sources.length:
    let (maybe_row, next_geom) = proxy_of geometry i sources[i]
    geometry := next_geom
    if let $Some row = maybe_row:
      slots[i] := rows.length
      @storage.push rows row
  for i in 0 .. slots.length:
    if slots[i] == 0xFFFFFFFF:
      slots[i] := rows.length
  return (rows, slots, geometry)
func build_into (destination: own Scene) -> (sources: #[Source]) : Scene =>
  let (stored, slots, geometry) = build_rows destination.geometry sources
  destination.geometry := geometry
  let bounds: #[spatial.Bounds] = @array.generate stored.length (func (i: U32) : spatial.Bounds => return
    $spatial.Bounds {low: stored[i].low, high: stored[i].high})
  destination.proxies := spatial.replace_fixed self stored
  destination.slots := spatial.replace_fixed self slots
  destination.index := spatial.build_into self bounds
  destination.source_count := sources.length
  return destination

// The complete consumer ends before any temporary geometry/tree owner closes.
func with_built (sources: #[Source]) -> consume => return
  consume (own (build_into (empty ()) sources))

func copied_rows (geometry: own shapes.Geometry) -> (source: Scene) : (#[ProxyRow], shapes.Geometry) =>
  let rows: #[ProxyRow] = #[]
  for i in 0 .. count source:
    let value = proxy source i
    let (packed, next_geom) = pack_proxy geometry value
    geometry := next_geom
    @storage.push rows packed
  return (rows, geometry)
func copy_into (destination: own Scene) -> (source: Scene) : Scene =>
  let (rows, geometry) = copied_rows destination.geometry source
  destination.geometry := geometry
  destination.proxies := spatial.replace_fixed self rows
  destination.slots := spatial.replace self source.slots
  destination.index := spatial.copy_into self source.index
  destination.source_count := source.source_count
  return destination


// Authored source persistence uses the same flat schema boundary as proxies.
// Source and Collider remain convenient invocation-local borrowed values.
type StoredKind is data = $StoredBox | $StoredSphere | $StoredCapsule | $StoredBrush | $StoredHeightfield terrain.Stored | $StoredLevel shapes.StoredMesh
type ColliderRow is data = $ColliderRow {
  shape: StoredKind,
  size: Vec3,
  radius: F32,
  height: F32,
  offset: Vec3,
  friction: F32,
  restitution: F32,
  layer: U32,
  mask: U32,
  trigger: Bool,
}
type SourceRow is data = $SourceRow {
  collider: Maybe ColliderRow, planes: shapes.Span,
  index: U32,
  id: U32,
  position: Vec3,
  rotation: Quat,
  scale: Vec3,
  rigid: Maybe Rigid,
  walker: Maybe Walker,
}
func pack_collider_row (shape: StoredKind) -> (value: Collider) : ColliderRow => $ColliderRow {
  shape,
  size: value.size,
  radius: value.radius,
  height: value.height,
  offset: value.offset,
  friction: value.friction,
  restitution: value.restitution,
  layer: value.layer,
  mask: value.mask,
  trigger: value.trigger,
}
func pack_collider (geometry: own shapes.Geometry) -> (value: Collider) : (ColliderRow, shapes.Geometry) =>
  if let $Box = value.shape:
    return (pack_collider_row $StoredBox value, geometry)
  if let $Sphere = value.shape:
    return (pack_collider_row $StoredSphere value, geometry)
  if let $Capsule = value.shape:
    return (pack_collider_row $StoredCapsule value, geometry)
  if let $Brush = value.shape:
    return (pack_collider_row $StoredBrush value, geometry)
  if let $Heightfield ground = value.shape:
    let (stored, next_geom) = pack_heightfield geometry ground
    return (pack_collider_row ($StoredHeightfield stored) value, next_geom)
  let $Mesh m = value.shape else:
    return (pack_collider_row $StoredBox value, geometry)
  let (stored, next_geom) = shapes.pack_mesh geometry m
  return (pack_collider_row ($StoredLevel stored) value, next_geom)
func unpack_collider geometry -> (value: ColliderRow) =>
  let shape = case value.shape of
    $StoredBox => $Box
    $StoredSphere => $Sphere
    $StoredCapsule => $Capsule
    $StoredBrush => $Brush
    $StoredHeightfield ground => $Heightfield (terrain.unpack geometry.heights ground)
    $StoredLevel m => $Mesh (shapes.unpack_mesh geometry m)
  return $Collider { shape,
    size: value.size,
    radius: value.radius,
    height: value.height,
    offset: value.offset,
    friction: value.friction,
    restitution: value.restitution,
    layer: value.layer,
    mask: value.mask,
    trigger: value.trigger,
  }
func pack_source_planes (geometry: own shapes.Geometry) -> (values: &[math.Vec4]) : (shapes.Span, shapes.Geometry) =>
  let $shapes.Geometry { points, planes, rings, indices, heights, source_planes } = geometry
  let (span, source_planes) = shapes.pack_span source_planes values
  return (span, $shapes.Geometry { points, planes, rings, indices, heights, source_planes })
func pack_source (geometry: own shapes.Geometry) -> (value: Source) : (SourceRow, shapes.Geometry) =>
  let collider: Maybe ColliderRow = $Nothing
  if let $Some c = value.collider:
    let (packed, next_geom) = pack_collider geometry c
    collider := $Some packed
    geometry := next_geom
  let (planes, geometry) = pack_source_planes geometry value.planes
  return ($SourceRow {
    collider,
    planes,
    index: value.index,
    id: value.id,
    position: value.position,
    rotation: value.rotation,
    scale: value.scale,
    rigid: value.rigid,
    walker: value.walker,
  }, geometry)
func unpack_source geometry -> (value: SourceRow) => $Source {
  collider: Maybe.map (unpack_collider geometry) value.collider,
  planes: shapes.span_view geometry.source_planes value.planes,
  index: value.index,
  id: value.id,
  position: value.position,
  rotation: value.rotation,
  scale: value.scale,
  rigid: value.rigid,
  walker: value.walker,
}
func source_rows (geometry: own shapes.Geometry) -> (values: #[Source]) : (#[SourceRow], shapes.Geometry) =>
  let rows: #[SourceRow] = #[]
  for value in values:
    let (row, next_geom) = pack_source geometry value
    geometry := next_geom
    @storage.push rows row
  return (rows, geometry)
func source_values geometry -> (values: &[SourceRow]) => return
  array.generate values.length (func i => unpack_source geometry values[i])
