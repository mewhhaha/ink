import * as array from "std/array"
import * as changes from "./changes"
import * as graph from "./graph"

// Access planning with a serial reference executor. Applications identify independent
// state channels and must validate their declarations. Unknown/ordered work is
// a full barrier. Pure work reads a snapshot and returns an explicit delta;
// commit deltas in source order, never write one ECS world from several CPUs.
type Access is data = #Access { reads: Array U32, writes: Array U32 }
type Mode is data = #Pure | #Ordered | #Unknown
type Node is data = #Node { access: Access, mode: Mode, after: Array U32 }
type Plan is data = #Plan { dependencies: Array (Array U32), waves: Array (Array U32) }
// Construct through prepare; retain only while the plan/access declarations
// remain unchanged. The normalized waves own their immutable snapshot.
type Prepared is data = #Prepared { waves: Array (Array U32) }
const access = fn reads writes => #Access { reads: changes.unique reads, writes: changes.unique writes }
const overlaps = fn left right => do:
  for value in left:
    if changes.contains right value:
      return #True
  return #False
const conflicts = fn (a: Node) (b: Node) => do:
  let #Pure = a.mode else:
    return #True
  let #Pure = b.mode else:
    return #True
  return overlaps a.access.writes b.access.writes || overlaps a.access.writes b.access.reads || overlaps a.access.reads b.access.writes
const plan = fn (width: U32) (nodes: Array Node) => do:
  if width == 0 || width > 32 || nodes.length > 1024:
    return #Nothing
  let normalized = #[#Node { access: access node.access.reads node.access.writes, mode: node.mode, after: node.after } | node <- nodes]
  let dependencies = array.generate nodes.length (fn index => do:
    let edges = normalized[index].after
    for earlier in 0 .. index:
      if conflicts normalized[earlier] normalized[index]:
        edges := array.push earlier self
    return changes.unique edges)
  for index in 0 .. nodes.length:
    for dependency in dependencies[index]:
      if dependency >= nodes.length || dependency == index:
        return #Nothing
  let #Some waves = graph.waves width (graph.from_lists dependencies) else:
    return #Nothing
  return #Some (#Plan { dependencies, waves })

// Validate the complete graph and normalize wave order before any work runs.
// Access declarations remain the application's responsibility.
const validate = fn (plan: Plan) => do:
  let count = plan.dependencies.length
  if count > 1024 || plan.waves.length > count:
    return #Nothing
  let done = array.fill count #False
  let order = array.generate plan.waves.length (fn _ => array.fill 0 0)
  let visited = 0
  let wave_at = 0
  for wave in plan.waves:
    let sorted = changes.unique wave
    if wave.length == 0 || wave.length > 32 || sorted.length != wave.length:
      return #Nothing
    for index in sorted:
      if index >= count || done[index]:
        return #Nothing
      for dependency in plan.dependencies[index]:
        if dependency >= count || Bool.not done[dependency]:
          return #Nothing
    for index in sorted:
      done[index] := #True
    visited := self + sorted.length
    order[wave_at] := sorted
    wave_at := self + 1
  if visited != count:
    return #Nothing
  return #Some order
const prepare = fn plan => Maybe.map (fn waves => #Prepared {waves}) (validate plan)

// Dispatch receives one immutable snapshot and a complete dependency wave.
// It may use a host executor; results must correspond to input order. Validate
// the whole plan before any dispatch, and commit only complete returned waves.
const execute_with = fn (plan: Plan) initial dispatch (commit: state -> U32 -> delta -> state) => do:
  let #Some prepared = prepare plan else:
    return #Nothing
  use result <- execute_prepared_with prepared initial dispatch commit
  return #Some result
const execute_prepared_with = fn (prepared: Prepared) initial dispatch (commit: state -> U32 -> delta -> state) => do:
  let state = initial
  for wave in prepared.waves:
    use deltas <- dispatch state wave
    if deltas.length != wave.length:
      return @panic "scheduler result count differs from its wave"
    for slot in 0 .. wave.length:
      state := commit self wave[slot] deltas[slot]
  return state
const execute_prepared = fn prepared initial (run: U32 -> state -> delta) commit =>
  execute_prepared_with prepared initial (fn state wave => array.map (fn index => run index state) wave) commit
const execute = fn (plan: Plan) initial (run: U32 -> state -> delta) commit =>
  execute_with plan initial (fn state wave => array.map (fn index => run index state) wave) commit
