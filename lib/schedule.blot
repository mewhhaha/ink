//! Declarations are fixed rows. All channel keys and explicit predecessor IDs
//! occupy one caller-owned flat input buffer, addressed by checked spans.
//!
//! Key items: [`Span`], [`Access`], [`Mode`], [`Node`], [`span`].

import * as array from "std/array"
import * as graph from "./graph"

type Span is data = $Span { start: U32, count: U32 }
type Access is data = $Access { reads: Span, writes: Span }
type Mode is data = $Pure | $Ordered | $Unknown
type Node is data = $Node { access: Access, mode: Mode, after: Span }
type Plan is data = $Plan { dependency_starts: #[U32], dependency_targets: #[U32], waves: graph.Waves }
type Prepared is data = $Prepared { starts: &[U32], nodes: &[U32] }
func span start -> count => $Span {start, count}
func access reads -> writes => $Access {reads, writes}
func valid_span (span: Span) -> channels => span.start <= channels.length and span.count <= channels.length - span.start
func overlaps (left: Span) -> (right: Span) -> channels =>
  for i in 0 .. left.count:
    for j in 0 .. right.count:
      if channels[left.start + i] == channels[right.start + j]:
        return true
  return false
func conflicts (a: Node) -> (b: Node) -> channels =>
  let $Pure = a.mode else:
    return true
  let $Pure = b.mode else:
    return true
  return overlaps a.access.writes b.access.writes channels or overlaps a.access.writes b.access.reads channels or overlaps a.access.reads b.access.writes channels
func compute_waves (width: U32) -> (starts: #[U32]) -> (targets: #[U32]) -> (wave_starts: own #[U32]) -> (wave_nodes: own #[U32]) : Maybe graph.Waves =>
  let $Some dependencies = graph.bind starts targets else:
    return panic "schedule adjacency invariant"
  return graph.waves width dependencies wave_starts wave_nodes
// Output buffers are separately named owners and must be distinct from inputs.
// Failed planning publishes no Plan; output buffers are construction scratch.
func plan (width: U32) -> (nodes: #[Node]) -> channels -> (dependency_starts: own #[U32]) -> (dependency_targets: own #[U32]) -> (wave_starts: own #[U32]) -> (wave_nodes: own #[U32]) : Maybe Plan =>
  if width == 0 or width > 32 or nodes.length > 1024:
    return $Nothing
  for node in nodes:
    if not (valid_span node.access.reads channels) or not (valid_span node.access.writes channels) or not (valid_span node.after channels):
      return $Nothing
  @storage.truncate dependency_starts 0
  @storage.truncate dependency_targets 0
  @storage.push dependency_starts 0
  for index in 0 .. nodes.length:
    let selected = array.fill nodes.length false
    let after = nodes[index].after
    for i in 0 .. after.count:
      let dependency = channels[after.start + i]
      if dependency >= nodes.length or dependency == index:
        return $Nothing
      selected[dependency] := true
    for earlier in 0 .. index:
      if conflicts nodes[earlier] nodes[index] channels:
        selected[earlier] := true
    // Dedupe and commit predecessor IDs in source order.
    for dependency in 0 .. nodes.length:
      if selected[dependency]:
        @storage.push dependency_targets dependency
    @storage.push dependency_starts dependency_targets.length
  let built = compute_waves width dependency_starts dependency_targets wave_starts wave_nodes
  if let $Some waves = built:
    let copied_waves = $graph.Waves { starts: copy waves.starts, nodes: copy waves.nodes }
    return $Some ($Plan {dependency_starts, dependency_targets, waves: copied_waves})
  return $Nothing
// Validate before dispatch. A prepared plan borrows static schedule owners;
// callers rebuild it when declarations change rather than mutate its buffers.
func validate (plan: Plan) =>
  let dependencies = graph.borrow plan.dependency_starts plan.dependency_targets
  if not (graph.valid dependencies):
    return false
  let count = dependencies.starts.length - 1
  let starts = plan.waves.starts
  let nodes = plan.waves.nodes
  if count > 1024 or starts.length == 0 or starts[0] != 0 or starts[starts.length - 1] != nodes.length or starts.length - 1 > count:
    return false
  let done = array.fill count false
  let visited = 0
  for wave in 0 .. starts.length - 1:
    let start = starts[wave]
    let end = starts[wave + 1]
    if end < start or end > nodes.length or end - start == 0 or end - start > 32:
      return false
    for at in start .. end:
      let index = nodes[at]
      if index >= count or done[index]:
        return false
      // Published wave order is strictly ascending and deterministic.
      if at > start and nodes[at - 1] >= index:
        return false
      for dependency_at in dependencies.starts[index] .. dependencies.starts[index + 1]:
        let dependency = dependencies.targets[dependency_at]
        if dependency >= count or not done[dependency]:
          return false
    for at in start .. end:
      done[nodes[at]] := true
    visited := visited + end - start
  return visited == count
func prepare (plan: Plan) => return
  if validate plan then $Some ($Prepared {starts: &plan.waves.starts[0..plan.waves.starts.length], nodes: &plan.waves.nodes[0..plan.waves.nodes.length]}) else $Nothing
// Known dispatch borrows explicit input (or copies a worker batch); only a
// complete returned wave commits, in ascending source order. No callable array.
func execute_prepared (prepared: Prepared) -> (own access) -> dispatch -> commit =>
  for wave in 0 .. prepared.starts.length - 1:
    let start = prepared.starts[wave]
    let end = prepared.starts[wave + 1]
    let selected = &prepared.nodes[start..end]
    use deltas <- dispatch access selected
    if deltas.length != selected.length:
      return panic "scheduler result count differs from its wave"
    for slot in 0 .. selected.length:
      access := commit (own self) selected[slot] deltas[slot]
  return access
func execute (plan: Plan) -> (own access) -> dispatch -> commit =>
  let $Some prepared = prepare plan else:
    return (false, access)
  use next_access <- execute_prepared prepared (own access) dispatch commit
  return (true, next_access)
