import * as simd from "std/simd"
import * as motion from "../motion"

// Shared rates and timestep, prepared once for any number of scalar springs.
// The caller retains this immutable value until one of those inputs changes.
type Prepared is data = $Still | $Free F32
  | $Critical { w: F32, dt: F32, e: F32 }
  | $Under { w: F32, a: F32, b: F32, sn: F32, cs: F32, e: F32 }
  | $Over { r1: F32, r2: F32, e1: F32, e2: F32 }
func prepare (frequency: F32) -> (damping: F32) -> (dt: F32) => return do:
  if Bool.not (is_finite frequency and is_finite damping and is_finite dt):
    return $Nothing
  if frequency < 0.0 or damping < 0.0 or dt < 0.0 or frequency * dt > 8192.0:
    return $Nothing
  if dt == 0.0:
    return $Some $Still
  let w = max 0.0 frequency
  let z = max 0.0 damping
  if w == 0.0:
    return $Some ($Free dt)
  if abs (z - 1.0) < 0.00001:
    return $Some ($Critical { w, dt, e: motion.decay (w * dt) })
  if z < 1.0:
    let a = z * w
    let b = w * sqrt (1.0 - z * z)
    if b == 0.0 or Bool.not (is_finite (w * w) and is_finite a and is_finite b):
      return $Nothing
    return $Some ($Under { w, a, b, sn: sin (b * dt), cs: cos (b * dt), e: motion.decay (a * dt) })
  let root = sqrt (z * z - 1.0)
  let r1 = (F32.neg w) / (z + root)
  let r2 = (F32.neg w) * (z + root)
  if Bool.not (is_finite r1 and is_finite r2 and is_finite (r1 - r2)) or r1 == r2:
    return $Nothing
  return $Some ($Over { r1, r2, e1: motion.decay ((F32.neg r1) * dt), e2: motion.decay ((F32.neg r2) * dt) })

// Finite input values and representable results, as for motion.spring. Keep
// each expression's scalar operation order; do not fuse or reassociate it.
func step (prepared: Prepared) -> (s: motion.Spring) -> (target: F32) => return do:
  let x = s.value - target
  let v = s.velocity
  return case prepared of
    $Still => s
    $Free dt => $motion.Spring { value: s.value + v * dt, velocity: v }
    $Critical {w, dt, e} => do:
      let b = v + w * x
      break $motion.Spring { value: target + (x + b * dt) * e, velocity: (v - w * b * dt) * e }
    $Under {w, a, b, sn, cs, e} => $motion.Spring {
      value: target + e * (x * cs + (v + a * x) * sn / b),
      velocity: e * (v * cs - (a * v + w * w * x) * sn / b) }
    $Over {r1, r2, e1, e2} => do:
      let c1 = (v - r2 * x) / (r1 - r2)
      let c2 = x - c1
      break $motion.Spring { value: target + c1 * e1 + c2 * e2, velocity: r1 * c1 * e1 + r2 * c2 * e2 }

func step4 (prepared: Prepared) -> (values: simd.F32x4) -> (velocities: simd.F32x4) -> (targets: simd.F32x4) => return do:
  let x = simd.f32_sub values targets
  let v = velocities
  return case prepared of
    $Still => (values, velocities)
    $Free dt => (simd.f32_add values (simd.f32_mul v (simd.f32_splat dt)), velocities)
    $Critical {w, dt, e} => do:
      let w4 = simd.f32_splat w
      let dt4 = simd.f32_splat dt
      let e4 = simd.f32_splat e
      let b = simd.f32_add v (simd.f32_mul w4 x)
      let p = simd.f32_add targets (simd.f32_mul (simd.f32_add x (simd.f32_mul b dt4)) e4)
      let speed = simd.f32_mul (simd.f32_sub v (simd.f32_mul (simd.f32_mul w4 b) dt4)) e4
      break (p, speed)
    $Under {w, a, b, sn, cs, e} => do:
      let a4 = simd.f32_splat a
      let b4 = simd.f32_splat b
      let sn4 = simd.f32_splat sn
      let cs4 = simd.f32_splat cs
      let e4 = simd.f32_splat e
      let drift = simd.f32_div (simd.f32_mul (simd.f32_add v (simd.f32_mul a4 x)) sn4) b4
      let force = simd.f32_add (simd.f32_mul a4 v) (simd.f32_mul (simd.f32_splat (w * w)) x)
      let p = simd.f32_add targets (simd.f32_mul e4 (simd.f32_add (simd.f32_mul x cs4) drift))
      let speed = simd.f32_mul e4 (simd.f32_sub (simd.f32_mul v cs4) (simd.f32_div (simd.f32_mul force sn4) b4))
      break (p, speed)
    $Over {r1, r2, e1, e2} => do:
      let r14 = simd.f32_splat r1
      let r24 = simd.f32_splat r2
      let e14 = simd.f32_splat e1
      let e24 = simd.f32_splat e2
      let c1 = simd.f32_div (simd.f32_sub v (simd.f32_mul r24 x)) (simd.f32_splat (r1 - r2))
      let c2 = simd.f32_sub x c1
      let p = simd.f32_add (simd.f32_add targets (simd.f32_mul c1 e14)) (simd.f32_mul c2 e24)
      let speed = simd.f32_add (simd.f32_mul (simd.f32_mul r14 c1) e14) (simd.f32_mul (simd.f32_mul r24 c2) e24)
      break (p, speed)

// Retain columns between steps; converting records on every call can cost more
// than SIMD saves. Outputs are separately named; retain input snapshots only
// with independent output owners. Targets have one value per row.
func columns_into (prepared: Prepared) -> (values: Array F32) -> (velocities: Array F32) -> (targets: Array F32) -> (p: own Array F32) -> (v: own Array F32) : (Array F32, Array F32) => return do:
  if values.length != velocities.length or values.length != targets.length:
    return @panic "spring columns must have equal lengths"
  if p.length != values.length or v.length != values.length:
    return @panic "spring outputs must match input length"
  if let $Still = prepared:
    for i in 0 .. values.length:
      p[i] := values[i]
      v[i] := velocities[i]
    return (p, v)
  for group in 0 .. values.length / 4:
    let i = group * 4
    let (next_p, next_v) = step4 prepared (simd.load i values) (simd.load i velocities) (simd.load i targets)
    p := @simd.store p i next_p
    v := @simd.store v i next_v
  for i in values.length / 4 * 4 .. values.length:
    let next = step prepared ($motion.Spring {value: values[i], velocity: velocities[i]}) targets[i]
    p[i] := next.value
    v[i] := next.velocity
  return (p, v)
