import * as array from "std/array"
import * as sort from "./sort"
import * as codec from "./codec"

type Operation [action, condition] is data =
  | $Act { action: action, next: U32 }
  | $Delay { seconds: F32, next: U32 }
  | $Until { condition: condition, next: U32 }
  | $Choose { condition: condition, yes: U32, no: U32 }
  | $Repeat { count: U32, body: U32, next: U32 }
  | $Again U32
  | $Stop
type Node [action, condition] is data = $Node { id: U32, operation: Operation [action, condition] }
type Program [action, condition] is data = $Program { version: U32, entry: U32, nodes: &[Node [action, condition]] }
type Frame = { owner: U32, remaining: U32 }
type Status is data = $Running | $Time | $Condition | $Action U32 | $Finished | $Interrupted U32 | $Budget | $StackFull
type State local is data = $State { version: U32, step: U32, elapsed: F32, local: local, status: Status }
type Tick is data = $Tick { seconds: F32, elapsed: F32 }
type Result local is data = $Done { local: local, remaining: F32 } | $Waiting { local: local, reason: U32 } | $Abort { local: local, reason: U32 }
type Advanced local is data = $Advanced { state: State local, remaining: F32, transitions: U32, visited: &[U32] }

func locate (id: U32) -> (program: Program [action, condition]) : Maybe (Node [action, condition]) =>
  let low = 0
  let high = program.nodes.length
  for 0 .. 32:
    if low >= high:
      break
    if low < high:
      let middle = low + (high - low) / 2
      if program.nodes[middle].id < id:
        low := middle + 1
      else:
        high := middle
  if low < program.nodes.length:
    if program.nodes[low].id == id:
      return $Some program.nodes[low]
  return $Nothing

func program (version: U32) -> (entry: U32) -> (nodes: &[Node [action, condition]]) : Maybe (Program [action, condition]) =>
  let program = $Program {version, entry, nodes}
  if not (Maybe.is_some (locate entry program)):
    return $Nothing
  for i in 0 .. nodes.length:
    if i > 0:
      if nodes[i - 1].id >= nodes[i].id:
        return $Nothing
    let targets = case nodes[i].operation of
      $Act { next } => #[next]
      $Delay { next, seconds } => if is_finite seconds and seconds >= 0.0 then #[next] else #[entry, entry, entry]
      $Until { next } => #[next]
      $Choose { yes, no } => #[yes, no]
      $Repeat { body, next } => #[body, next]
      $Again target => do:
        let $Some owner = locate target program else:
          return $Nothing
        let $Repeat {} = owner.operation else:
          return $Nothing
        break #[target]
      $Stop => #[]
    if targets.length == 3:
      return $Nothing
    for target in targets:
      if not (Maybe.is_some (locate target program)):
        return $Nothing
  return $Some program

// Sort authored nodes into the caller's named owner, then bind a borrowed
// program. No node array is buried inside the returned descriptor.
func build_into (destination: #[~Node [action, condition]]) -> (version: U32) -> (entry: U32) -> (nodes: #[Node [action, condition]]) =>
  let indices = sort.order_u32 (array.map (func node => node.id) nodes)
  let sorted = array.generate nodes.length (func i => nodes[indices[i]])
  destination.truncate 0
  for node in sorted:
    destination.push node
  return program version entry (destination.view 0 destination.length)

func action (id: U32) => func value => func (next: U32) => $Node { id, operation: $Act { action: value, next } }
func wait (id: U32) => func (seconds: F32) => func (next: U32) => $Node { id, operation: $Delay { seconds, next } }
func until (id: U32) => func condition => func (next: U32) => $Node { id, operation: $Until { condition, next } }
func branch (id: U32) => func condition => func (yes: U32) => func (no: U32) => $Node { id, operation: $Choose { condition, yes, no } }
func repeat (id: U32) => func (count: U32) => func (body: U32) => func (next: U32) => $Node { id, operation: $Repeat { count, body, next } }
func again (id: U32) => func (owner: U32) => $Node { id, operation: $Again owner }
func stop (id: U32) => $Node { id, operation: $Stop }
func start (program: Program [action, condition]) -> (local: local) : State local => return
  $State { version: program.version, step: program.entry, elapsed: 0.0, local, status: $Running }
func terminal status => case status of
  $Finished => true
  $Interrupted _ => true
  _ => false
func interrupt (reason: U32) -> cleanup -> (state: State local) -> (frames: #[~Frame]) =>
  if terminal state.status:
    return state
  state.local := cleanup reason self
  frames.truncate 0
  state.status := $Interrupted reason
  return state

func repeat_next (owner: U32) -> program -> (frames: #[~Frame]) : Maybe U32 =>
  if frames.length == 0:
    return $Nothing
  let at = frames.length - 1
  let frame = frames[at]
  if frame.owner != owner:
    return $Nothing
  let $Some repeated = locate owner program else:
    return $Nothing
  let $Repeat {body, next} = repeated.operation else:
    return $Nothing
  if frame.remaining > 1:
    frame.remaining := self - 1
    frames[at] = frame
    return $Some body
  frames.truncate at
  return $Some next

// Publish only successful advances. Invalid input/action results leave both
// retained frame state and the caller's previous trace unchanged.
func publish (destination_frames: #[~Frame]) -> (destination_visited: #[~U32]) -> (state: State local) -> (remaining: F32) -> (transitions: U32) -> (frames: #[~Frame]) -> (visited: #[+U32]) : Maybe (Advanced local) =>
  destination_frames.truncate 0
  for frame in frames:
    destination_frames.push frame
  destination_visited.truncate 0
  for id in visited:
    destination_visited.push id
  return $Some ($Advanced {state, remaining, transitions, visited: destination_visited.view 0 destination_visited.length})

// Time is consumed once as it crosses immediate steps. Budget exhaustion
// returns remaining seconds; callers choose whether to carry or drop them.
// A pending action consumes the tick; a completed action explicitly returns its
// unused time. All callbacks are pure and local state is ordinary saved data.
func advance (program: Program [action, condition]) => func (state: State local) -> (destination_frames: #[~Frame]) -> (destination_visited: #[~U32]) => return
  func (seconds: F32) => func (budget: U32) => func (max_frames: U32) => return
  func (act: action -> Tick -> local -> Result local) => func (ready: condition -> local -> Bool) => return
  func (cleanup: U32 -> local -> local) : Maybe (Advanced local) =>
    let step = state.step
    let age = state.elapsed
    let local_value = state.local
    let frames: #[~Frame] = copy destination_frames
    let status = state.status
    if state.version != program.version or not (is_finite seconds) or seconds < 0.0:
      return $Nothing
    if frames.length > max_frames or not (is_finite age) or age < 0.0:
      return $Nothing
    let remaining = seconds
    let transitions = 0
    let visited: #[+U32] = #[]
    if terminal status:
      return publish destination_frames destination_visited state remaining transitions frames visited
    let waiting = false
    status := $Running
    for used in 0 .. budget:
      if waiting or terminal status:
        break
      if not waiting and not (terminal status):
        let $Some node = locate step program else:
          return $Nothing
        visited.push node.id
        let next = $Nothing
        let invalid = false
        let elapsed = age + remaining
        if not (is_finite elapsed):
          return $Nothing
        let outcome = case node.operation of
          $Act { action, next } => act action ($Tick { seconds: remaining, elapsed: age }) local_value
          _ => $Done { local: local_value, remaining }
        local_value := case outcome of
          $Done { local } => local
          $Waiting { local } => local
          $Abort { local } => local
        let abort = case outcome of
          $Abort { reason } => $Some reason
          _ => $Nothing
        if let $Some reason = abort:
          local_value := cleanup reason self
          frames.truncate 0
          status := $Interrupted reason
        else:
          let blocked = case outcome of
            $Waiting { reason } => $Some reason
            _ => $Nothing
          if let $Some reason = blocked:
            status := $Action reason
            age := elapsed
            remaining := 0.0
            waiting := true
          else:
            let $Done { remaining: rest } = outcome else:
              return $Nothing
            if not (is_finite rest) or rest < 0.0 or rest > remaining:
              return $Nothing
            remaining := rest
            next := case node.operation of
              $Act { next } => $Some next
              $Delay { seconds, next } => if elapsed >= seconds then $Some next else $Nothing
              $Until { condition, next } => if ready condition local_value then $Some next else $Nothing
              $Choose { condition, yes, no } => $Some (if ready condition local_value then yes else no)
              $Repeat { count, next } => if count == 0 then $Some next else $Nothing
              _ => $Nothing
            case node.operation of
              $Delay { seconds } => do:
                remaining := max 0.0 (elapsed - seconds)
                if not (Maybe.is_some next):
                  age := elapsed
                  status := $Time
                  waiting := true
              $Until { condition } => do:
                if not (Maybe.is_some next):
                  age := elapsed
                  status := $Condition
                  remaining := 0.0
                  waiting := true
              $Repeat { count, body } => do:
                if count > 0:
                  if frames.length >= max_frames:
                    status := $StackFull
                    waiting := true
                  else:
                    frames.push {owner: node.id, remaining: count}
                    next := $Some body
              $Again owner => do:
                case repeat_next owner program frames of
                  $Nothing => do:
                    invalid := true
                  $Some id => do:
                    next := $Some id
              $Stop => do:
                status := $Finished
                frames.truncate 0
              _ => ()
            if invalid:
              return $Nothing
            if let $Some id = next:
              step := id
              age := 0.0
              transitions := self + 1
    if not waiting and not (terminal status):
      status := $Budget
    return publish destination_frames destination_visited ($State {version: state.version, step, elapsed: age, local: local_value, status}) remaining transitions frames visited

func status_words status => case status of
  $Running => #[0, 0]
  $Time => #[1, 0]
  $Condition => #[2, 0]
  $Action reason => #[3, reason]
  $Finished => #[4, 0]
  $Interrupted reason => #[5, reason]
  $Budget => #[6, 0]
  $StackFull => #[7, 0]
func encode encode_local -> (state: State local) -> (frames: #[~Frame]) =>
  let local = encode_local state.local
  let age = codec.float_encode state.elapsed
  let status = status_words state.status
  let out: #[+U32] = #[1, state.version, state.step, age[0], status[0], status[1], frames.length, local.length]
  for frame in frames:
    out.push frame.owner
    out.push frame.remaining
  for word in local:
    out.push word
  return seal out

func restore_into (destination: #[~Frame]) -> (program: Program [action, condition]) -> (max_frames: U32) => return
  func (decode_local: #[U32] -> Maybe local) -> (words: #[U32]) : Maybe (State local) =>
    if words.length < 8 or words[0] != 1 or words[1] != program.version or words[6] > max_frames or words[6] > (words.length - 8) / 2:
      return $Nothing
    let count = words[6]
    let offset = 8 + count * 2
    if words[7] != words.length - offset or words[4] > 7 or (words[4] != 3 and words[4] != 5 and words[5] != 0):
      return $Nothing
    let $Some node = locate words[2] program else:
      return $Nothing
    let $Some elapsed = codec.float_decode #[words[3]] else:
      return $Nothing
    if elapsed < 0.0:
      return $Nothing
    let $Some local = decode_local (array.slice offset words[7] words) else:
      return $Nothing
    let frames = array.generate count (func i => { owner: words[8 + i * 2], remaining: words[9 + i * 2] })
    for frame in frames:
      let $Some owner = locate frame.owner program else:
        return $Nothing
      let $Repeat { count } = owner.operation else:
        return $Nothing
      if frame.remaining == 0 or frame.remaining > count:
        return $Nothing
    let status = case words[4] of
      0 => $Running
      1 => $Time
      2 => $Condition
      3 => $Action words[5]
      4 => $Finished
      5 => $Interrupted words[5]
      6 => $Budget
      _ => $StackFull
    let compatible = case status of
      $Time => case node.operation of
        $Delay { seconds } => elapsed < seconds
        _ => false
      $Condition => case node.operation of
        $Until {} => true
        _ => false
      $Action _ => case node.operation of
        $Act {} => true
        _ => false
      $Finished => case node.operation of
        $Stop => true
        _ => false
      $StackFull => case node.operation of
        $Repeat {} => true
        _ => false
      _ => true
    if not compatible:
      return $Nothing
    if terminal status and count != 0:
      return $Nothing
    destination.truncate 0
    for frame in frames:
      destination.push frame
    return $Some ($State {version: program.version, step: node.id, elapsed, local, status})
