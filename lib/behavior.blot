import * as array from "std/array"
import * as sort from "./sort"
import * as codec from "./codec"

type Operation [action, condition] is data =
  | $Act { action: action, next: U32 }
  | $Delay { seconds: F32, next: U32 }
  | $Until { condition: condition, next: U32 }
  | $Choose { condition: condition, yes: U32, no: U32 }
  | $Repeat { count: U32, body: U32, next: U32 }
  | $Again U32
  | $Stop
type Node [action, condition] is data = $Node { id: U32, operation: Operation [action, condition] }
type Program [action, condition] is data = $Program { version: U32, entry: U32, nodes: Array (Node [action, condition]) }
type Frame = { owner: U32, remaining: U32 }
type Status is data = $Running | $Time | $Condition | $Action U32 | $Finished | $Interrupted U32 | $Budget | $StackFull
type State local is data = $State { version: U32, step: U32, elapsed: F32, local: local, frames: Array Frame, status: Status }
type Tick is data = $Tick { seconds: F32, elapsed: F32 }
type Result local is data = $Done { local: local, remaining: F32 } | $Waiting { local: local, reason: U32 } | $Abort { local: local, reason: U32 }
type Advanced local is data = $Advanced { state: State local, remaining: F32, transitions: U32, visited: Array U32 }

const locate = func (id: U32) => return func (program: Program [action, condition]) => return do:
  let low = 0
  let high = program.nodes.length
  for 0 .. 32:
    if low >= high:
      break
    if low < high:
      let middle = low + (high - low) / 2
      if program.nodes[middle].id < id:
        low := middle + 1
      else:
        high := middle
  if low < program.nodes.length:
    if program.nodes[low].id == id:
      return $Some program.nodes[low]
  return $Nothing

const build = func (version: U32) => return func (entry: U32) => return func nodes => return do:
  let indices = sort.order_u32 (array.map (func node => return node.id) nodes)
  let nodes = array.generate nodes.length (func i => return nodes[indices[i]])
  let program = $Program { version, entry, nodes }
  if Bool.not (Maybe.is_some (locate entry program)):
    return $Nothing
  for i in 0 .. nodes.length:
    if i > 0:
      if nodes[i - 1].id == nodes[i].id:
        return $Nothing
    let targets = case nodes[i].operation of
      $Act { next } => #[next]
      $Delay { next, seconds } => if is_finite seconds and seconds >= 0.0 then #[next] else #[entry, entry, entry]
      $Until { next } => #[next]
      $Choose { yes, no } => #[yes, no]
      $Repeat { body, next } => #[body, next]
      $Again target => do:
        let $Some owner = locate target program else:
          return $Nothing
        let $Repeat {} = owner.operation else:
          return $Nothing
        break #[target]
      $Stop => #[]
    if targets.length == 3:
      return $Nothing
    for target in targets:
      if Bool.not (Maybe.is_some (locate target program)):
        return $Nothing
  return $Some program

const action = func (id: U32) => return func value => return func (next: U32) => return $Node { id, operation: $Act { action: value, next } }
const wait = func (id: U32) => return func (seconds: F32) => return func (next: U32) => return $Node { id, operation: $Delay { seconds, next } }
const until = func (id: U32) => return func condition => return func (next: U32) => return $Node { id, operation: $Until { condition, next } }
const branch = func (id: U32) => return func condition => return func (yes: U32) => return func (no: U32) => return $Node { id, operation: $Choose { condition, yes, no } }
const repeat = func (id: U32) => return func (count: U32) => return func (body: U32) => return func (next: U32) => return $Node { id, operation: $Repeat { count, body, next } }
const again = func (id: U32) => return func (owner: U32) => return $Node { id, operation: $Again owner }
const stop = func (id: U32) => return $Node { id, operation: $Stop }
const start = func (program: Program [action, condition]) => return func local => return
  $State { version: program.version, step: program.entry, elapsed: 0.0, local, frames: #[], status: $Running }
const terminal = func status => return case status of
  $Finished => true
  $Interrupted _ => true
  _ => false
const interrupt = func (reason: U32) => return func cleanup => return func (state: State local) => return do:
  if terminal state.status:
    return state
  state.local := cleanup reason self
  state.frames := #[]
  state.status := $Interrupted reason
  return state

const repeat_next = func (owner: U32) => return func program => return func (frames: Array Frame) => return do:
  if frames.length == 0:
    return $Nothing
  let at = frames.length - 1
  let frame = frames[at]
  if frame.owner != owner:
    return $Nothing
  let $Some repeated = locate owner program else:
    return $Nothing
  let $Repeat { body, next } = repeated.operation else:
    return $Nothing
  if frame.remaining > 1:
    frame.remaining := self - 1
    frames[at] := frame
    return $Some (frames, body)
  return $Some (array.slice 0 at frames, next)

// Time is consumed once as it crosses immediate steps. Budget exhaustion
// returns remaining seconds; callers choose whether to carry or drop them.
// A pending action consumes the tick; a completed action explicitly returns its
// unused time. All callbacks are pure and local state is ordinary saved data.
const advance = func (program: Program [action, condition]) => return func (state: State local) => return
  func (seconds: F32) => return func (budget: U32) => return func (max_frames: U32) => return
  func (act: action -> Tick -> local -> Result local) => return func (ready: condition -> local -> Bool) => return
  func (cleanup: U32 -> local -> local) => return do:
    let step = state.step
    let age = state.elapsed
    let local_value = state.local
    let frames = state.frames
    let status = state.status
    if state.version != program.version or Bool.not (is_finite seconds) or seconds < 0.0:
      return $Nothing
    if frames.length > max_frames or Bool.not (is_finite age) or age < 0.0:
      return $Nothing
    let remaining = seconds
    let transitions = 0
    let visited = #[]
    if terminal status:
      return $Some ($Advanced { state, remaining, transitions, visited })
    let waiting = false
    status := $Running
    for used in 0 .. budget:
      if waiting or terminal status:
        break
      if Bool.not waiting and Bool.not (terminal status):
        let $Some node = locate step program else:
          return $Nothing
        visited := array.push node.id self
        let next = $Nothing
        let invalid = false
        let elapsed = age + remaining
        if Bool.not (is_finite elapsed):
          return $Nothing
        let outcome = case node.operation of
          $Act { action, next } => act action ($Tick { seconds: remaining, elapsed: age }) local_value
          _ => $Done { local: local_value, remaining }
        local_value := case outcome of
          $Done { local } => local
          $Waiting { local } => local
          $Abort { local } => local
        let abort = case outcome of
          $Abort { reason } => $Some reason
          _ => $Nothing
        if let $Some reason = abort:
          local_value := cleanup reason self
          frames := #[]
          status := $Interrupted reason
        else:
          let blocked = case outcome of
            $Waiting { reason } => $Some reason
            _ => $Nothing
          if let $Some reason = blocked:
            status := $Action reason
            age := elapsed
            remaining := 0.0
            waiting := true
          else:
            let $Done { remaining: rest } = outcome else:
              return $Nothing
            if Bool.not (is_finite rest) or rest < 0.0 or rest > remaining:
              return $Nothing
            remaining := rest
            next := case node.operation of
              $Act { next } => $Some next
              $Delay { seconds, next } => if elapsed >= seconds then $Some next else $Nothing
              $Until { condition, next } => if ready condition local_value then $Some next else $Nothing
              $Choose { condition, yes, no } => $Some (if ready condition local_value then yes else no)
              $Repeat { count, next } => if count == 0 then $Some next else $Nothing
              _ => $Nothing
            case node.operation of
              $Delay { seconds } => do:
                remaining := max 0.0 (elapsed - seconds)
                if Bool.not (Maybe.is_some next):
                  age := elapsed
                  status := $Time
                  waiting := true
              $Until { condition } => do:
                if Bool.not (Maybe.is_some next):
                  age := elapsed
                  status := $Condition
                  remaining := 0.0
                  waiting := true
              $Repeat { count, body } => do:
                if count > 0:
                  if frames.length >= max_frames:
                    status := $StackFull
                    waiting := true
                  else:
                    frames := array.push { owner: node.id, remaining: count } self
                    next := $Some body
              $Again owner => do:
                case repeat_next owner program frames of
                  $Nothing => do:
                    invalid := true
                  $Some (next_frames, id) => do:
                    frames := next_frames
                    next := $Some id
              $Stop => do:
                status := $Finished
                frames := #[]
              _ => ()
            if invalid:
              return $Nothing
            if let $Some id = next:
              step := id
              age := 0.0
              transitions := self + 1
    if Bool.not waiting and Bool.not (terminal status):
      status := $Budget
    return $Some ($Advanced { state: $State { version: state.version, step, elapsed: age, local: local_value, frames, status }, remaining, transitions, visited })

const status_words = func status => return case status of
  $Running => #[0, 0]
  $Time => #[1, 0]
  $Condition => #[2, 0]
  $Action reason => #[3, reason]
  $Finished => #[4, 0]
  $Interrupted reason => #[5, reason]
  $Budget => #[6, 0]
  $StackFull => #[7, 0]
const encode = func encode_local => return func (state: State local) => return do:
  let local = encode_local state.local
  let age = codec.float_encode state.elapsed
  let status = status_words state.status
  let out = #[1, state.version, state.step, age[0], status[0], status[1], state.frames.length, local.length]
  for frame in state.frames:
    out := array.concat self #[frame.owner, frame.remaining]
  return array.concat out local

const restore = func (program: Program [action, condition]) => return func (max_frames: U32) => return
  func (decode_local: Array U32 -> Maybe local) => return func (words: Array U32) => return do:
    if words.length < 8 or words[0] != 1 or words[1] != program.version or words[6] > max_frames or words[6] > (words.length - 8) / 2:
      return $Nothing
    let count = words[6]
    let offset = 8 + count * 2
    if words[7] != words.length - offset or words[4] > 7 or (words[4] != 3 and words[4] != 5 and words[5] != 0):
      return $Nothing
    let $Some node = locate words[2] program else:
      return $Nothing
    let $Some elapsed = codec.float_decode #[words[3]] else:
      return $Nothing
    if elapsed < 0.0:
      return $Nothing
    let $Some local = decode_local (array.slice offset words[7] words) else:
      return $Nothing
    let frames = array.generate count (func i => return { owner: words[8 + i * 2], remaining: words[9 + i * 2] })
    for frame in frames:
      let $Some owner = locate frame.owner program else:
        return $Nothing
      let $Repeat { count } = owner.operation else:
        return $Nothing
      if frame.remaining == 0 or frame.remaining > count:
        return $Nothing
    let status = case words[4] of
      0 => $Running
      1 => $Time
      2 => $Condition
      3 => $Action words[5]
      4 => $Finished
      5 => $Interrupted words[5]
      6 => $Budget
      _ => $StackFull
    let compatible = case status of
      $Time => case node.operation of
        $Delay { seconds } => elapsed < seconds
        _ => false
      $Condition => case node.operation of
        $Until {} => true
        _ => false
      $Action _ => case node.operation of
        $Act {} => true
        _ => false
      $Finished => case node.operation of
        $Stop => true
        _ => false
      $StackFull => case node.operation of
        $Repeat {} => true
        _ => false
      _ => true
    if Bool.not compatible:
      return $Nothing
    if terminal status and count != 0:
      return $Nothing
    return $Some ($State { version: program.version, step: node.id, elapsed, local, frames, status })
