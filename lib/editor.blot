import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as app from "./app"
import * as brush from "./brush"
import * as camera from "./view"
import * as ecs from "./ecs"
import * as gizmos from "./gizmos"
import * as input from "./input"
import * as keys from "./input/keys"
import * as lanes from "./lanes"
import * as math from "./math"
import * as persist from "./persist"
import * as render from "./render"
import * as transform from "./transform"
import * as vocabulary from "./ui/vocabulary"
import * as ui from "./ui"
import * as tree from "./ui/tree"
import * as window from "./events"
import * as scene_history from "./editor/history"

// A TrenchBroom-style level editor for convex brushes. Tab swaps between
// editing and playing; the level as edited comes back when play stops.

type Mode is data = $Play | $Edit
// Brushes selects, moves, resizes and draws brushes; Vertices drags the
// selection's corners; Clipper cuts it along a plane through picked points;
// Rotate turns the selection by dragging.
type Tool is data = $Brushes | $Vertices | $Clipper | $Rotate
// What the primary button is doing. Each drag works from where it started:
// Draw extrudes a new box from the plane through `start` facing `axis`
// toward `side`, spawning `created` once it has an area. Move translates
// `origin` by the snapped motion of the point grabbed at `anchor`, vertically
// when `vertical`. Resize moves face `face` of `origin` along its normal as far
// as the pointer moves from `anchor` on it, in the shape's coordinates.
// Reshape drags corner `corner` of `origin`. Turn rotates `origin` as the
// pointer moves from (`x`, `y`): sideways about the vertical, or up and down
// about the camera's horizontal axis when `tilt`.
// `face` is a face of the selected brush picked with Shift. `paint` indexes
// Settings.materials. `clips` are the Clipper's points. `view` is the camera
// not in use: the editor's while playing, otherwise the last play camera.
type Editor is data = $Editor { mode: Mode, tool: Tool, selected: Maybe U32, face: Maybe U32, grid: F32, paint: U32, clips: &[Vec3], drag: StoredDrag, view: camera.Camera }
// `materials` are the brush materials M cycles through; new brushes use the
// current one and extrude `depth`. The styles draw the selected brush, its
// selected face, corners and clip points; `level` draws the translucent plane
// at the bottom of a brush moving up or down, to compare heights against.
// `view` is where the editor camera starts, and `begin` runs with the editor
// camera whenever play starts.
type Settings [begin, copy] is data = $Settings { materials: #[U32], depth: F32, selection: gizmos.Style, face: gizmos.Style, corner: gizmos.Style, clip: gizmos.Style, level: gizmos.Style, view: camera.Camera, begin: begin, copy: copy }

// Logical reads borrow clipping points. Drag origins are fixed spans into a
// separately owned before-image pool and are copied exactly at drag start.
type StoredDrag is data = $StoredIdle
  | $StoredDraw {start: Vec3, axis: math.Axis, side: F32, created: Maybe U32}
  | $StoredMove {origin: brush.Stored, anchor: Vec3, vertical: Bool}
  | $StoredResize {origin: brush.Stored, face: U32, anchor: Vec3}
  | $StoredReshape {origin: brush.Stored, corner: U32, anchor: Vec3, vertical: Bool}
  | $StoredTurn {origin: brush.Stored, x: F32, y: F32, tilt: Bool}
type StoredEditor is data = $StoredEditor {mode: Mode, tool: Tool, selected: Maybe U32, face: Maybe U32, grid: F32, paint: U32, clips_count: U32, drag: StoredDrag, view: camera.Camera}
type BrushSource is data = $BrushSource {rows: &[Maybe brush.Stored], faces: &[render.Face], length: U32}
func initial view => $StoredEditor {mode: $Edit, tool: $Brushes, selected: $Nothing, face: $Nothing, grid: 0.5, paint: 0, clips_count: 0, drag: $StoredIdle, view}
func text_view words => words.view 0 words.length
func solid_at (source: BrushSource) -> entity =>
  if entity < source.length:
    if let $Some row = source.rows[entity]:
      return $Some (brush.unpack row source.faces)
  return $Nothing
func read_state access -> unit =>
  let owned: #[StoredEditor] = access.editor
  let clips: #[Vec3] = access.editor_clips
  let row = owned[0]
  return $Editor {mode: row.mode, tool: row.tool, selected: row.selected, face: row.face,
    grid: row.grid, paint: row.paint, clips: clips.view 0 row.clips_count,
    drag: row.drag, view: row.view}
// At most three point values are copied before writes, including overlapping
// input views. Physical storage never contracts while event views are alive.
func store_clips (clips: own #[Vec3]) -> points: #[Vec3] =>
  let count = points.length
  lanes.require (count <= max_clips)
  let a = if count > 0 then points.at 0 else math.zero3
  let b = if count > 1 then points.at 1 else math.zero3
  let c = if count > 2 then points.at 2 else math.zero3
  for i in 0 .. count:
    let point = case i of
      0 => a
      1 => b
      _ => c
    if i < clips.length:
      clips[i] := point
    else:
      @storage.push clips point
  return clips
func write_state (own access) -> (state: Editor) =>
  let count = state.clips.length
  lanes.require (count <= max_clips)
  let a = if count > 0 then state.clips[0] else math.zero3
  let b = if count > 1 then state.clips[1] else math.zero3
  let c = if count > 2 then state.clips[2] else math.zero3
  let copied = case count of
    0 => #[]
    1 => #[a]
    2 => #[a, b]
    _ => #[a, b, c]
  access.editor_clips := store_clips self copied
  access.editor[0] := $StoredEditor {mode: state.mode, tool: state.tool, selected: state.selected, face: state.face,
    grid: state.grid, paint: state.paint, clips_count: count, drag: state.drag, view: state.view}
  return access
// A new drag copies its world brush into this independent before-image owner.
// Later edits overwrite the live brush, never the origin. Regrabs deliberately
// replace the before-image only after their scalar anchor has been calculated.
func store_origin_faces (destination: own #[render.Face]) -> (faces: &[render.Face]): #[render.Face] =>
  let count = faces.length
  lanes.require (count <= brush.max_faces)
  for i in 0 .. count:
    let plane = faces[i]
    if i < destination.length:
      destination[i] := plane
    else:
      @storage.push destination plane
  return destination
func store_origin (destination: own #[render.Face]) -> (solid: brush.Brush): (brush.Stored, #[render.Face]) =>
  let next = store_origin_faces destination (&solid.faces[0..solid.faces.length])
  return ($brush.Stored {faces_start: 0, faces_count: solid.faces.length, min: solid.min, max: solid.max, offset: solid.offset, rotation: solid.rotation}, next)
func origin_brush (faces: &[render.Face]) -> stored => brush.unpack stored faces
type CopiedBrush is data = $CopiedBrush {faces: #[render.Face], min: Vec3, max: Vec3, offset: Vec3, rotation: math.Quat}
func copy_brush (solid: brush.Brush): CopiedBrush =>
  return $CopiedBrush {faces: copy solid.faces, min: solid.min, max: solid.max, offset: solid.offset, rotation: solid.rotation}
func save_drag_origin (own access) -> (copied: CopiedBrush) =>
  access.editor_drag_faces := store_origin_faces self (&copied.faces[0..copied.faces.length])
  return ($brush.Stored {faces_start: 0, faces_count: copied.faces.length, min: copied.min, max: copied.max, offset: copied.offset, rotation: copied.rotation}, access)
func put_camera (own access) -> (current: camera.Camera) =>
  access.camera[0] := current
  return access
func write_brush_faces (faces: own #[render.Face]) -> (previous: Maybe brush.Stored) -> (copied: #[render.Face]): #[render.Face] =>
  if let $Some before = previous:
    if before.faces_count == copied.length:
      for i in 0 .. copied.length:
        faces[before.faces_start + i] := copied[i]
      return faces
  for plane in copied:
    @storage.push faces plane
  return faces
func store_brush_copied (own access) -> entity -> (copied: CopiedBrush) =>
  let previous = ecs.read access.brushes entity
  let start = case previous of
    $Some before if before.faces_count == copied.faces.length => before.faces_start
    _ => access.brush_faces.length
  access.brush_faces := write_brush_faces self previous copied.faces
  let stored = $brush.Stored {faces_start: start, faces_count: copied.faces.length,
    min: copied.min, max: copied.max, offset: copied.offset, rotation: copied.rotation}
  let was = ecs.contains access.brushes entity
  access.brushes := ecs.put_row access.entities self entity stored
  access.brushes_meta := ecs.bump_insert was self
  return access
func store_brush (own access) -> entity -> (solid: brush.Brush) =>
  return store_brush_copied access entity (copy_brush solid)
func spawn_brush_copied (own access) -> (copied: CopiedBrush) =>
  let id = access.entities.length
  access.entities := ecs.spawn_entity self
  access.entities_meta := ecs.bump_membership self
  access := store_brush_copied access id copied
  return (id, access)
func spawn_brush (own access) -> (solid: brush.Brush) =>
  return spawn_brush_copied access (copy_brush solid)
func pack_brushes access -> (scratch: own #[render.Face]): (#[(U32, brush.Stored)], #[render.Face]) =>
  let faces: #[render.Face] = access.brush_faces
  let rows: ecs.Pool brush.Stored = access.brushes
  let out: #[(U32, brush.Stored)] = #[]
  for id in 0 .. rows.length:
    if let $Some stored = rows.at id:
      let copied = brush.unpack stored (&faces[0..faces.length])
      scratch := do:
        let (packed, next_scratch) = brush.pack copied self
        @storage.push out (id, packed)
        break next_scratch
  return (out, scratch)
func replace_faces (destination: own #[render.Face]) -> (source: #[render.Face]) : #[render.Face] =>
  @storage.truncate destination 0
  for face in source:
    @storage.push destination face
  return destination
func compact_brush_faces (own access) =>
  let scratch: #[render.Face] = #[]
  let (packed, scratch) = pack_brushes access scratch
  for pair in packed:
    let (id, stored) = pair
    access.brushes[id] := $Some stored
  access.brush_faces := replace_faces self scratch
  return access

const min_grid = 0.0625
const max_grid = 4.0
// Radians per pixel of mouse look, units per second of flight, the Shift
// multiplier and units per wheel unit of dolly.
const look_speed = 0.004
const fly_speed = 6.0
const boost = 4.0
const dolly_speed = 0.01
// Corners within this angle (radians, roughly) of the pointer can be grabbed.
const corner_reach = 0.025
// Gizmo thickness per unit of distance from the camera, so lines keep their
// width on screen.
const line_width = 0.0025
// The selected face's outline is this much wider, so it shows over the brush's.
const face_width = 1.8
// Turns snap to 15 degrees, or 1 degree with Shift; dragging turns a radian
// per 100 pixels.
const turn_step = 0.2617994
const fine_turn_step = 0.01745329
const turn_rate = 0.01

func brushes access -> () =>
  let faces: #[render.Face] = access.brush_faces
  return $BrushSource {rows: ecs.rows access.brushes, faces: &faces[0..faces.length], length: access.brushes.length}

func playing access => func () =>
  use state <- read_state access ()
  return case state.mode of
    $Play => true
    $Edit => false

// The selected brush, while it exists.
func selection_of (selected: Maybe U32) -> (solids: BrushSource) =>
  if let $Some entity = selected:
    if entity < solids.length:
      if let $Some row = solids.rows[entity]:
        return $Some (entity, brush.unpack row solids.faces)
  return $Nothing

func selection (state: Editor) => func (solids: BrushSource) => selection_of state.selected solids

// The nearest brush in front of `ray`: entity, distance and the face it hits.
// Brushes around the ray's origin are skipped, so the camera sees out of them.
func nearest (solids: BrushSource) => func ray =>
  let best = $Nothing
  for index in 0 .. solids.length:
    let candidate = case (solid_at solids index) of
      $Some solid => brush.hit_faces ray (brush.world_faces solid)
      $Nothing => $Nothing
    best := case candidate, self of
      $Some (distance, _), _ if distance <= 0.0 => self
      $Some (distance, _), $Some (_, closest, _) if distance >= closest => self
      $Some (distance, face), _ => $Some (index, distance, face)
      $Nothing, _ => self
  return best

func point_at (ray: math.Ray) => func distance => ray.origin + ray.direction * distance

func sign (value: F32) => if value < 0.0 then -1.0 else 1.0

func vec_min (a: Vec3) => func (b: Vec3) => math.vec3 (min a.x b.x) (min a.y b.y) (min a.z b.z)
func vec_max (a: Vec3) => func (b: Vec3) => math.vec3 (max a.x b.x) (max a.y b.y) (max a.z b.z)

// The world axis nearest the camera's horizontal heading, and the one to its right.
func heading (view: camera.Camera) =>
  let forward = view.rotation.forward
  let axis = if abs forward.x > abs forward.z then math.vec3 (sign forward.x) 0.0 0.0 else math.vec3 0.0 0.0 (sign forward.z)
  return (axis, axis.cross math.up)

func material_at settings -> (paint: U32) =>
  let $Settings { materials } = settings
  return Maybe.unwrap_or 0 (materials.get(paint))

func material settings => func (state: Editor) => material_at settings state.paint

func set_brush (own access) -> entity -> (solid: brush.Brush) => store_brush access entity solid

func set_selected_copied (own access) -> (selected: Maybe U32) -> (copied: CopiedBrush) => case selected of
  $Nothing => access
  $Some entity => store_brush_copied access entity copied

func set_selected (own access) -> (state: StoredEditor) -> (solid: brush.Brush) =>
  return set_selected_copied access state.selected (copy_brush solid)

func select (own access) -> (state: StoredEditor) -> selected -> face =>
  state.selected := selected
  state.face := face
  state.drag := $StoredIdle
  access.editor[0] := state
  return access

// Switches mode. Play keeps the level aside and starts from the editor camera;
// Edit puts the level back and returns to the editor camera.
func toggle hooks -> (own access) -> settings =>
  let $Settings { begin } = settings
  let current: camera.Camera = access.camera[0]
  let state: StoredEditor = access.editor[0]
  let previous_mode = state.mode
  let previous_view = state.view
  state.drag := $StoredIdle
  state.clips_count := 0
  state.view := current
  return case previous_mode of
    $Edit => do:
      state.mode := $Play
      access.editor[0] := state
      access := hooks.stash_scene (own access)
      break begin (own access) current
    $Play => do:
      state.mode := $Edit
      access.editor[0] := state
      access.camera[0] := previous_view
      access.camera_previous[0] := previous_view
      break hooks.restore_scene (own access)

// Yaw about world up and pitch about the camera's right axis, short of vertical.
func look (own access) -> (dx: F32) -> (dy: F32) =>
  let current: camera.Camera = access.camera[0]
  let yaw = math.Quat.from_axis_angle math.up (-dx * look_speed)
  let pitch = math.Quat.from_axis_angle math.right (-dy * look_speed)
  let turned = (yaw * current.rotation).normalized
  let tilted = (turned * pitch).normalized
  let level = if abs tilted.forward.y < 0.98 then tilted else turned
  let (next_cam, next_prev) = camera.turn level access.camera[0] access.camera_previous[0]
  access.camera[0] := next_cam
  access.camera_previous[0] := next_prev
  return access

// Flies the editor camera while the secondary button is held: WASD, Q/E down/up.
func fly_camera access -> (seconds: F32): Maybe camera.Camera =>
  let state: StoredEditor = access.editor[0]
  let editing = case state.mode of
    $Edit => true
    $Play => false
  let controls = input.read access.input_pointer access.input_held access.input_fresh access.input_buttons
  if not (editing and input.button_held controls input.secondary):
    return $Nothing
  let current: camera.Camera = access.camera[0]
  let speed = if input.pressed controls keys.shift then fly_speed * boost * seconds else fly_speed * seconds
  let forward = current.rotation.forward * input.axis controls keys.s keys.w
  let right = current.rotation.rotate math.right * input.axis controls keys.a keys.d
  let lift = math.up * input.axis controls keys.q keys.e
  current.position := self + (forward + right + lift) * speed
  return $Some current
func fly (own access) -> (seconds: F32) =>
  if let $Some current = fly_camera access seconds:
    return put_camera access current
  return access

func dolly (own access) -> (delta: F32) =>
  let (next_cam, next_prev) = camera.adjust (func (view: camera.Camera) =>
    view.position := self + view.rotation.forward * (-delta * dolly_speed)
    return view) access.camera[0] access.camera_previous[0]
  access.camera[0] := next_cam
  access.camera_previous[0] := next_prev
  return access

// Backs the editor camera away from `solid` along its view direction.
func focus_bounds (own access) -> (low: Vec3) -> (high: Vec3) =>
  let current: camera.Camera = access.camera[0]
  let distance = max 3.0 ((high - low).length * 1.5)
  current.position := (low + high) * 0.5 - current.rotation.forward * distance
  return put_camera access current

func focus (own access) -> (solid: brush.Brush) =>
  let (low, high) = brush.world_bounds solid
  return focus_bounds access low high

// Where a drag of the point at `anchor` goes: across the horizontal plane
// through it, or up and down a vertical plane facing the camera.
func drag_plane (view: camera.Camera) => func anchor => func vertical => func ray =>
  let forward = view.rotation.forward
  let normal = if vertical then (math.vec3 forward.x 0.0 forward.z).normalized else math.up
  return math.ray_plane ray anchor normal

// How far `point` has moved from `anchor` in whole grid steps: across the
// horizontal axes, or only up and down.
func snapped_delta_grid (grid: F32) -> anchor -> point -> vertical =>
  let snapped = brush.snap_vec grid (point - anchor)
  return if vertical then math.vec3 0.0 snapped.y 0.0 else math.vec3 snapped.x 0.0 snapped.z

func snapped_delta (state: Editor) => func anchor => func point => func vertical => snapped_delta_grid state.grid anchor point vertical

// Whether Alt or Ctrl, which switch drags to up and down, is held.
func vertical_held (controls: input.Input) => return
  input.pressed controls keys.alt or input.pressed controls keys.control

// A press that is not on the selection: select what is under the pointer and
// get ready to draw a new brush on the face there, or on the ground.
func draw_start access -> under -> ray =>
  let solids = brushes access ()
  return case under of
    $Some (entity, distance, face) => case (solid_at solids entity) of
      $Some solid => do:
        let normal = (brush.world_faces solid)[face].normal
        let axis = math.Axis.dominant normal
        break $Some (point_at ray distance, axis, sign (axis.coordinate normal))
      $Nothing => $Nothing
    $Nothing => Maybe.map (func point => (point, $math.Y, 1.0)) (math.ray_plane ray math.zero3 math.up)
func begin_draw (own access) -> (state: StoredEditor) -> under -> ray -> shift =>
  let start = draw_start access under ray
  state.selected := case under of
    $Some (entity, _, _) => $Some entity
    $Nothing => $Nothing
  state.face := case under, shift of
    $Some (_, _, face), true => $Some face
    _, _ => $Nothing
  state.drag := case start of
    $Some (point, axis, side) => $StoredDraw { start: brush.snap_vec state.grid point, axis, side, created: $Nothing }
    $Nothing => $StoredIdle
  access.editor[0] := state
  return access

func grab_brush access -> selected -> under -> ray =>
  let solids = brushes access ()
  return case under, selection_of selected solids of
    $Some (entity, distance, face), $Some (chosen, solid) if entity == chosen => $Some (copy_brush solid, point_at ray distance, face, brush.to_shape solid (point_at ray distance))
    _, _ => $Nothing
func press_brushes (own access) -> (state: StoredEditor) -> under -> ray -> (px: F32) -> (py: F32) -> shift -> vertical =>
  let grabbed = grab_brush access state.selected under ray
  let turning = case state.tool of
    $Rotate => true
    _ => false
  if let $Some (copied, point, face, shape_point) = grabbed:
    let (origin, next_access) = save_drag_origin access copied
    access := next_access
    if turning:
      state.drag := $StoredTurn {origin, x: px, y: py, tilt: vertical}
    else:
      if shift:
        state.face := $Some face
        state.drag := $StoredResize {origin, face, anchor: shape_point}
      else:
        state.face := $Nothing
        state.drag := $StoredMove {origin, anchor: point, vertical}
    access.editor[0] := state
    return access
  return begin_draw access state under ray shift

// The corner of the selection nearest along `ray` within reach of it.
func pick_corner points => func (ray: math.Ray): Maybe U32 =>
  let count: U32 = points.length
  let read: U32 -> Vec3 = points.at
  let best: Maybe (U32, F32) = $Nothing
  for index in 0 .. count:
    let offset: Vec3 = read index - ray.origin
    let along: F32 = offset.dot ray.direction
    let miss: F32 = (offset - ray.direction * along).length
    let reached = along > 0.0 and miss < along * corner_reach
    best := case reached, self of
      true, $Some (_, closest) if along >= closest => self
      true, _ => $Some (index, along)
      false, _ => self
  return case best of
    $Some (index, _) => $Some index
    $Nothing => $Nothing

// The selection's corners where it stands, in the order of its shape's corners.
func world_corners (solid: brush.Brush) => array.map (brush.to_world solid) (brush.corners (&solid.faces[0..solid.faces.length]))

func grab_vertex access -> selected -> ray =>
  let solids = brushes access ()
  let $Some (_, solid) = selection_of selected solids else:
    return $Nothing
  let points = world_corners solid
  let $Some corner = pick_corner points ray else:
    return $Nothing
  return $Some (copy_brush solid, corner, points[corner])
func press_vertices (own access) -> (state: StoredEditor) -> under -> ray -> (px: F32) -> (py: F32) -> shift -> vertical =>
  let grabbed = grab_vertex access state.selected ray
  if let $Some (copied, corner, point) = grabbed:
    let (origin, next_access) = save_drag_origin access copied
    access := next_access
    // Reshaping renumbers the faces.
    state.face := $Nothing
    state.drag := $StoredReshape { origin, corner, anchor: point, vertical }
    access.editor[0] := state
    return access
  return press_brushes access state under ray px py shift vertical

// Adds a clip point on the surface under the pointer, or on the ground.
func press_clipper (own access) -> (state: StoredEditor) -> under -> ray =>
  let point = case under of
    $Some (_, distance, _) => $Some (point_at ray distance)
    $Nothing => math.ray_plane ray math.zero3 math.up
  let $Some found = point else:
    return access
  let snapped = brush.snap_vec state.grid found
  let points = if state.clips_count < 3 then array.push snapped (array.generate state.clips_count (func i => access.editor_clips[i])) else #[snapped]
  access.editor_clips := store_clips self points
  state.clips_count := points.length
  access.editor[0] := state
  return access

func press (own access) -> (state: StoredEditor) -> ray -> (px: F32) -> (py: F32) -> (shift: Bool) -> (vertical: Bool) =>
  let under = nearest (brushes access ()) ray
  return case state.tool of
    $Vertices => press_vertices access state under ray px py shift vertical
    $Clipper => press_clipper access state under ray
    _ => press_brushes access state under ray px py shift vertical

// Draws the new brush from the drag's start to the grid point under `ray`.
func draw_to (own access) -> settings -> (state: StoredEditor) -> start -> (axis: math.Axis) -> side -> created -> ray =>
  let $Settings { depth } = settings
  let $Some point = math.ray_plane ray start axis.unit else:
    return access
  let corner = axis.set (brush.snap_vec state.grid point) (axis.coordinate start)
  let far = axis.set start (axis.coordinate start + side * depth)
  let low = vec_min (vec_min start corner) far
  let high = vec_max (vec_max start corner) far
  let size = high - low
  let tiny = state.grid * 0.5
  if size.x < tiny or size.y < tiny or size.z < tiny:
    return access
  let made = copy_brush (brush.box low high (material_at settings state.paint))
  if let $Some entity = created:
    return store_brush_copied access entity made
  let (entity, next_access) = spawn_brush_copied access made
  access := next_access
  state.selected := $Some entity
  state.face := $Nothing
  state.drag := $StoredDraw { start, axis, side, created: $Some entity }
  access.editor[0] := state
  return access

// The rotation a turn drag has reached, `amount` radians snapped to the step.
func turn_by (view: camera.Camera) => func tilt => func (amount: F32) => func fine =>
  let step = if fine then fine_turn_step else turn_step
  let angle = floor (amount / step + 0.5) * step
  let (_, right) = heading view
  let axis = if tilt then right else math.up
  return math.Quat.from_axis_angle axis angle

func drag_brush access -> (state: StoredEditor) -> view -> ray -> (px: F32) -> (py: F32) -> (shift: Bool): Maybe CopiedBrush =>
  let raw_drag: #[render.Face] = access.editor_drag_faces
  let drag_faces: &[render.Face] = &raw_drag[0..raw_drag.length]
  return case state.drag of
    $StoredIdle => $Nothing
    $StoredDraw {} => $Nothing
    $StoredMove {origin, anchor, vertical} => do:
      let solid = origin_brush drag_faces origin
      break case drag_plane view anchor vertical ray of
        $Nothing => $Nothing
        $Some point => $Some (copy_brush (brush.shift (snapped_delta_grid state.grid anchor point vertical) solid))
    $StoredTurn {origin, x, y, tilt} => do:
      let solid = origin_brush drag_faces origin
      let amount = if tilt then (py - y) * turn_rate else (px - x) * turn_rate
      break $Some (copy_brush (brush.turn (turn_by view tilt amount shift) solid))
    $StoredResize {origin, face, anchor} => do:
      let solid = origin_brush drag_faces origin
      let plane = solid.faces[face]
      let target = case math.ray_line (brush.ray_to_shape solid ray) anchor plane.normal of
        $Some (_, along) => brush.snap state.grid (plane.distance + along)
        $Nothing => plane.distance
      break case brush.move_face solid face (target - plane.distance) of
        $Some resized => $Some (copy_brush resized)
        $Nothing => $Nothing
    $StoredReshape {origin, corner, anchor, vertical} => do:
      let solid = origin_brush drag_faces origin
      break case drag_plane view anchor vertical ray of
        $Nothing => $Nothing
        $Some point => do:
          let target = brush.to_shape solid (brush.snap_vec state.grid (anchor + snapped_delta_grid state.grid anchor point vertical))
          let points = brush.corners (&solid.faces[0..solid.faces.length])
          if corner < points.length:
            points[corner] := target
          break case brush.keep_placement solid (brush.hull points solid.faces) of
            $Some shaped => $Some (copy_brush shaped)
            $Nothing => $Nothing
func drag_to (own access) -> settings -> (state: StoredEditor) -> view -> ray -> (px: F32) -> (py: F32) -> (shift: Bool) =>
  if let $StoredDraw {start, axis, side, created} = state.drag:
    return draw_to access settings state start axis side created ray
  if let $Some copied = drag_brush access state view ray px py shift:
    return set_selected_copied access state.selected copied
  return access

// Whether `key` is Alt or Ctrl while the primary button drags.
func switching (controls: input.Input) => func key =>
  let modifier = case key of
    ^keys.alt | ^keys.control => true
    _ => false
  return modifier and input.button_held controls input.primary

// The world corner of `solid` nearest the line of `ray`.
func closest_corner (solid: brush.Brush) => func (ray: math.Ray) =>
  let points = world_corners solid
  let best = (0, 1e30)
  for index in 0 .. points.length:
    let offset = points[index] - ray.origin
    let miss = (offset - ray.direction * offset.dot ray.direction).length
    let (_, closest) = best
    best := if miss < closest then (index, miss) else self
  let (index, _) = best
  return (index, points[index])

// Pressing or releasing Alt or Ctrl mid-drag switches between moving across
// and up and down, or between turning and tilting: the drag starts again from
// where the brush is now and where the pointer is, so nothing jumps.
type RegrabPlan is data = $NoRegrab
  | $RegrabMove {copied: CopiedBrush, anchor: Vec3, vertical: Bool}
  | $RegrabReshape {copied: CopiedBrush, corner: U32, anchor: Vec3, vertical: Bool}
  | $RegrabTurn {copied: CopiedBrush, x: F32, y: F32, tilt: Bool}
func plan_regrab access -> (state: StoredEditor) -> (view: camera.Camera) -> ray -> (px: F32) -> (py: F32) -> (vertical: Bool): RegrabPlan =>
  let solids = brushes access ()
  return case state.drag, selection_of state.selected solids of
    $StoredMove { origin, anchor }, $Some (_, solid) => do:
      let grabbed = anchor + (solid.offset - origin.offset)
      let restart = Maybe.unwrap_or grabbed (drag_plane view grabbed vertical ray)
      break $RegrabMove { copied: copy_brush solid, anchor: restart, vertical }
    $StoredReshape {}, $Some (_, solid) => do:
      let (corner, point) = closest_corner solid ray
      break $RegrabReshape { copied: copy_brush solid, corner, anchor: point, vertical }
    $StoredTurn {}, $Some (_, solid) => $RegrabTurn { copied: copy_brush solid, x: px, y: py, tilt: vertical }
    _, _ => $NoRegrab
func regrab (own access) -> (state: StoredEditor) -> (view: camera.Camera) -> ray -> (px: F32) -> (py: F32) -> (vertical: Bool) =>
  let plan = plan_regrab access state view ray px py vertical
  case plan of
    $NoRegrab => ()
    $RegrabMove { copied, anchor, vertical } => do:
      let (origin, next_access) = save_drag_origin access copied
      access := next_access
      state.drag := $StoredMove { origin, anchor, vertical }
      access.editor[0] := state
    $RegrabReshape { copied, corner, anchor, vertical } => do:
      let (origin, next_access) = save_drag_origin access copied
      access := next_access
      state.drag := $StoredReshape { origin, corner, anchor, vertical }
      access.editor[0] := state
    $RegrabTurn { copied, x, y, tilt } => do:
      let (origin, next_access) = save_drag_origin access copied
      access := next_access
      state.drag := $StoredTurn { origin, x, y, tilt }
      access.editor[0] := state
  return access

// Ends a drag; whatever it changed becomes a step to undo.
func release (own access) -> (state: StoredEditor) =>
  let changed = case state.drag of
    $StoredIdle => false
    $StoredDraw { created: $Nothing } => false
    _ => true
  state.drag := $StoredIdle
  access.editor[0] := state
  if changed:
    access.requests := persist.request self $persist.Checkpoint
  return access

// U steps back through finished edits and Shift+U forward again, between
// drags.
func history (own access) -> (state: StoredEditor) -> forward =>
  if let $StoredIdle = state.drag:
    access.requests := persist.request self (if forward then $persist.Redo else $persist.Undo)
  return access

func delete hooks -> (own access) =>
  let state: StoredEditor = access.editor[0]
  if let $Some entity = state.selected:
    access := hooks.despawn (own access) entity
  state.selected := $Nothing
  state.face := $Nothing
  state.drag := $StoredIdle
  access.editor[0] := state
  return access

// The clip plane through the picked points: two points and straight up, or three.
func clip_plane (state: Editor) => func (view: camera.Camera) =>
  let points = state.clips
  return case points.length of
    2 => do:
      let across = points[1] - points[0]
      let up = points[0] + math.up
      let beside = if abs across.y > 0.999 * across.length then points[0] + view.rotation.rotate math.right else up
      break brush.plane_through points[0] points[1] beside 0
    3 => brush.plane_through points[0] points[1] points[2] 0
    _ => $Nothing

// Splits the selection along the clip plane into two brushes.
func clip_parts access -> (view: camera.Camera): Maybe (U32, CopiedBrush, CopiedBrush) =>
  let full = read_state access ()
  let solids = brushes access ()
  return case selection full solids, clip_plane full view of
    $Some (entity, solid), $Some plane => case brush.clip solid (brush.plane_to_shape solid plane) of
      ($Some back, $Some front) => $Some (entity, copy_brush back, copy_brush front)
      _ => $Nothing
    _, _ => $Nothing
func apply_clip (own access) -> (state: StoredEditor) -> (view: camera.Camera) =>
  let parts = clip_parts access view
  state.clips_count := 0
  if let $Some (entity, back, front) = parts:
    access := store_brush_copied access entity back
    let (_, next_access) = spawn_brush_copied access front
    access := next_access
    return select access state ($Some entity) $Nothing
  access.editor[0] := state
  return access

func painted_brush access -> selected -> face -> chosen: Maybe (U32, CopiedBrush) =>
  let solids = brushes access ()
  return case selection_of selected solids, face of
    $Some (entity, solid), $Some f if f < solid.faces.length => $Some (entity, copy_brush (brush.paint_face f chosen solid))
    $Some (entity, solid), _ => $Some (entity, copy_brush (brush.paint chosen solid))
    $Nothing, _ => $Nothing
func paint (own access) -> settings -> (state: StoredEditor) =>
  let $Settings { materials } = settings
  state.paint := if self + 1 < materials.length then self + 1 else 0
  let chosen = material_at settings state.paint
  let painted = painted_brush access state.selected state.face chosen
  access.editor[0] := state
  if let $Some (entity, copied) = painted:
    return store_brush_copied access entity copied
  return access

// Scalar placement changes borrow faces. Baking writes its geometry only
// into the caller's frame scratch before publishing a world component copy.
func nudged_brush access -> (state: StoredEditor) -> (direction: Vec3): Maybe (U32, CopiedBrush) =>
  return case selection_of state.selected (brushes access ()) of
    $Some (entity, solid) => $Some (entity, copy_brush (brush.shift (direction * state.grid) solid))
    $Nothing => $Nothing
func nudge (own access) -> (state: StoredEditor) -> (direction: Vec3) =>
  if let $Some (entity, copied) = nudged_brush access state direction:
    return store_brush_copied access entity copied
  return access
func placed_back_brush access -> (state: StoredEditor) -> bake: Maybe (U32, CopiedBrush) =>
  return case selection_of state.selected (brushes access ()) of
    $Some (entity, solid) => $Some (entity, copy_brush (if bake then brush.placed solid else brush.reset solid))
    $Nothing => $Nothing
func place_back (own access) -> (state: StoredEditor) -> bake =>
  if let $Some (entity, copied) = placed_back_brush access state bake:
    return store_brush_copied access entity copied
  return access
func turned_step_brush access -> (state: StoredEditor) -> (angle: F32): Maybe (U32, CopiedBrush) =>
  return case selection_of state.selected (brushes access ()) of
    $Some (entity, solid) => $Some (entity, copy_brush (brush.turn (math.Quat.from_axis_angle math.up angle) solid))
    $Nothing => $Nothing
func turn_step_by (own access) -> (state: StoredEditor) -> back =>
  let angle = if back then turn_step else -turn_step
  if let $Some (entity, copied) = turned_step_brush access state angle:
    return store_brush_copied access entity copied
  return access

// Copies the selection beside itself, to the camera's right, and selects it.
func duplicated_brush access -> selected -> (view: camera.Camera): Maybe CopiedBrush =>
  let solids = brushes access ()
  let $Some (_, solid) = selection_of selected solids else:
    return $Nothing
  let (_, right) = heading view
  let (low, high) = brush.world_bounds solid
  let size = high - low
  return $Some (copy_brush (brush.shift (right * abs (size.dot right)) solid))
func duplicate (own access) -> (state: StoredEditor) -> (view: camera.Camera) =>
  let $Some next_brush = duplicated_brush access state.selected view else:
    return access
  let (entity, next_access) = spawn_brush_copied access next_brush
  return select next_access state ($Some entity) $Nothing

func use_tool (own access) -> (state: StoredEditor) -> tool =>
  state.tool := case self, tool of
    $Vertices, $Vertices => $Brushes
    $Clipper, $Clipper => $Brushes
    $Rotate, $Rotate => $Brushes
    _, _ => tool
  state.clips_count := 0
  state.drag := $StoredIdle
  access.editor[0] := state
  return access

func regrid (own access) -> (state: StoredEditor) -> (factor: F32) =>
  state.grid := clamp min_grid max_grid (self * factor)
  access.editor[0] := state
  return access

// Whether Esc would back out of anything while editing: clip points, a tool
// other than brushes, or the selection. Playing, there is nothing to.
func backs_out (state: Editor) => case state.mode, (state.clips.length == 0), state.tool, state.selected of
  $Play, _, _, _ => false
  _, false, _, _ => true
  _, true, $Brushes, $Nothing => false
  _, _, _, _ => true

// Esc backs out one step: clip points, then the tool, then the selection.
func escape (own access) -> (state: StoredEditor) => case (state.clips_count == 0), state.tool of
  false, _ => do:
    state.clips_count := 0
    access.editor[0] := state
    break access
  true, $Brushes => select access state $Nothing $Nothing
  true, _ => use_tool access state $Brushes

func erase hooks -> (own access) =>
  let state: StoredEditor = access.editor[0]
  if let $Clipper = state.tool:
    if state.clips_count > 0:
      state.clips_count := self - 1
      access.editor[0] := state
      return access
  return delete hooks access

func selected_bounds access -> selected: Maybe (Vec3, Vec3) =>
  return case selection_of selected (brushes access ()) of
    $Some (_, solid) => $Some (brush.world_bounds solid)
    $Nothing => $Nothing
func edit_key hooks -> (own access) -> settings -> (view: camera.Camera) -> (shift: Bool) -> (key: U32) =>
  if key == keys.backspace:
    return erase hooks access
  if key == keys.delete or key == keys.x:
    return delete hooks access
  let state: StoredEditor = access.editor[0]
  let (ahead, right) = heading view
  return case key of
    ^keys.escape => escape access state
    ^keys.v => use_tool access state $Vertices
    ^keys.c => use_tool access state $Clipper
    ^keys.e => use_tool access state $Rotate
    ^keys.u => history access state shift
    ^keys.r => turn_step_by access state shift
    ^keys.o => place_back access state shift
    ^keys.enter => apply_clip access state view
    ^keys.m => paint access settings state
    ^keys.bracket_left => regrid access state 0.5
    ^keys.bracket_right => regrid access state 2.0
    ^keys.up => nudge access state ahead
    ^keys.down => nudge access state (ahead * -1.0)
    ^keys.right => nudge access state right
    ^keys.left => nudge access state (right * -1.0)
    ^keys.page_up => nudge access state math.up
    ^keys.page_down => nudge access state (math.vec3 0.0 (-1.0) 0.0)
    ^keys.f => case selected_bounds access state.selected of
      $Some (low, high) => focus_bounds access low high
      $Nothing => access
    _ => access

// The selected brush's corners as it stands, low then high, in metres:
// "-1.5 0 2, 1.5 1 3", to the clipboard (the host's clipboard service).
func copy_selection (own access) -> settings -> (selected: Maybe U32) =>
  let $Settings { copy } = settings
  let $Some (low, high) = selected_bounds access selected else:
    return access
  let number = func (value: F32) => ui.decimal value 4
  let space = #[32]
  let corner = func (point: Vec3) => (array.concat (array.concat (array.concat (array.concat (number point.x) (space)) (number point.y)) (space)) (number point.z))
  return copy (own access) ((array.concat (array.concat (corner low) (#[44, 32])) (corner high)))

func key_action hooks -> (own access) -> settings -> (view: camera.Camera) -> (key: U32) -> (shift: Bool) -> (command: Bool) -> (flying: Bool) =>
  let state: StoredEditor = access.editor[0]
  return case key, state.mode, command of
    ^keys.tab, _, _ => toggle hooks access settings
    ^keys.f6, _, _ => do:
      access.requests := persist.request self $persist.Save
      break access
    ^keys.f9, _, _ => do:
      access.requests := persist.request self $persist.Load
      break access
    ^keys.s, $Edit, true => do:
      access.requests := persist.request self $persist.SaveScene
      break access
    ^keys.r, $Edit, true => do:
      access.requests := persist.request self $persist.LoadScene
      break access
    ^keys.d, $Edit, true => do:
      access := duplicate access state view
      access.requests := persist.request self $persist.Checkpoint
      break access
    ^keys.c, $Edit, true => copy_selection access settings state.selected
    // Simulation can change a scene even during a non-editing key press.
    // Only brush-edit commands may create a checkpoint; in particular Undo
    // must not save the moving simulation immediately before stepping back.
    _, $Edit, false if not flying => do:
      access := edit_key hooks access settings view shift key
      let checkpoint = case key of
        ^keys.r | ^keys.o | ^keys.enter | ^keys.backspace
        | ^keys.delete | ^keys.x | ^keys.m
        | ^keys.up | ^keys.down | ^keys.right | ^keys.left
        | ^keys.page_up | ^keys.page_down => true
        _ => false
      if checkpoint:
        access.requests := persist.request self $persist.Checkpoint
      break access
    _, _, _ => access

func key_down_controls access -> (key: U32) =>
  let controls = input.read access.input_pointer access.input_held access.input_fresh access.input_buttons
  if not (input.just_pressed controls key):
    return (true, false, false, false, false, 0.0, 0.0, false)
  return (false, switching controls key, input.pressed controls keys.shift, input.pressed controls keys.control, input.button_held controls input.secondary, controls.x, controls.y, vertical_held controls)
func event_controls access -> (event: window.Event) =>
  let controls = input.read access.input_pointer access.input_held access.input_fresh access.input_buttons
  let sw = case event of
    $window.KeyUp key => switching controls key
    _ => false
  return (controls.x, controls.y, controls.dx, controls.dy, input.button_held controls input.secondary, input.button_held controls input.primary, controls.claimed, input.pressed controls keys.shift, vertical_held controls, sw)
func receive hooks -> (own access) -> settings -> (context: app.EventContext) =>
  let view: camera.Camera = access.camera[0]
  let lens: camera.Lens = access.lens[0]
  if let $window.KeyDown key = context.event:
    let (ignore, regrab_now, shift, command, flying, px, py, vertical) = key_down_controls access key
    if ignore:
      return access
    if regrab_now:
      let ray = camera.viewport_ray lens view px py context.width context.height
      return regrab access access.editor[0] view ray px py vertical
    return key_action hooks access settings view key shift command flying
  let (px, py, dx, dy, flying, primary_held, claimed, shift, vertical, sw_up) = event_controls access context.event
  let ray = camera.viewport_ray lens view px py context.width context.height
  let state: StoredEditor = access.editor[0]
  return case context.event, state.mode of
    $window.KeyUp _, _ => if sw_up then regrab access state view ray px py vertical else access
    // A press another system claimed selects nothing.
    $window.PointerDown { button: 0 }, $Edit => if flying or claimed then access else press access state ray px py shift vertical
    $window.PointerUp { button: 0 }, $Edit => release access state
    $window.PointerMove {}, $Edit => case flying, primary_held of
      true, _ => look access dx dy
      false, true => drag_to access settings state view ray px py shift
      false, false => access
    $window.Wheel { delta }, $Edit => dolly access delta
    _, _ => access

// `style` thick enough to read from `distance` away.
func sized (style: gizmos.Style) => func (distance: F32) =>
  style.thickness := max self (distance * line_width)
  return style

func long (edge: (Vec3, Vec3)) =>
  let (start, end) = edge
  return (end - start).length > 0.000001

func edge_segment (style: gizmos.Style) => func (edge: (Vec3, Vec3)) =>
  let (start, end) = edge
  return gizmos.segment style start end

// A segment per edge of nonzero length.
func lines (style: gizmos.Style) -> (edges: #[(Vec3, Vec3)]) -> (frame: own render.FrameAccess) : render.FrameAccess => return
  gizmos.append frame #[edge_segment style edge | edge <- edges, long edge]

// A small cube at each point.
func markers (style: gizmos.Style) -> points -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let size = style.thickness * 2.0
  let marker = func point => render.draw (transform.with_scale (math.vec3 size size size) (transform.from_position point)) (gizmos.appearance style)
  return gizmos.append frame (array.map marker points)

// The clip points, the path through them and where the cut would run.
func draw_clip access -> (style: gizmos.Style) -> (state: Editor) -> view -> chosen -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let points = state.clips
  let path = if points.length == 0 then #[] else array.generate (points.length - 1) (func index => (points[index], points[index + 1]))
  let cut = case chosen, clip_plane state view of
    $Some (_, solid), $Some plane => case brush.clip solid (brush.plane_to_shape solid plane) of
      ($Some back, _) => #[edge | edge <- brush.edges (brush.placed back), brush.on_edge plane edge]
      _ => #[]
    _, _ => #[]
  frame := lines style (array.concat path cut) self
  return markers style points frame

// A translucent plane at the bottom of `shown`, around the camera and out past
// the far plane, so it reaches the horizon.
func level_plane (lens: camera.Lens) -> (style: gizmos.Style) -> (view: camera.Camera) -> (shown: brush.Brush) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let extent = math.vec3 lens.far 0.001 lens.far
  let pose = transform.with_scale extent (transform.from_xyz view.position.x shown.min.y view.position.z)
  return gizmos.append frame #[render.draw pose (gizmos.appearance style)]

// In Edit mode, outlines the selection where it stands, its selected face and
// the current tool's handles, and shows the level plane while it moves up or
// down.
func draw access -> settings -> (presentation: app.Presentation) -> (frame: own render.FrameAccess) : render.FrameAccess =>
  let camera_owner: #[camera.Camera] = access.camera
  let $Settings {selection: outline, face: face_style, corner: corner_style, clip: clip_style, level} = settings
  let state = read_state access ()
  let solids = brushes access ()
  let view: camera.Camera = camera_owner[0]
  if let $Play = state.mode:
    return frame
  let lens: camera.Lens = access.lens[0]
  let chosen = selection state solids
  let shown = case chosen of
    $Some (_, solid) => $Some (brush.placed solid)
    $Nothing => $Nothing
  let distance = case shown of
    $Some solid => (brush.center solid - view.position).length
    $Nothing => 10.0
  if let $Some solid = shown:
    if let $StoredMove {vertical: true} = state.drag:
      frame := level_plane lens level view solid self
    frame := lines (sized outline distance) (brush.edges solid) self
    if let $Some face = state.face:
      if face < solid.faces.length:
        frame := lines (sized face_style (distance * face_width)) (brush.face_edges solid face) self
    if let $Vertices = state.tool:
      frame := markers (sized corner_style distance) (brush.corners (&solid.faces[0..solid.faces.length])) self
  if let $Clipper = state.tool:
    frame := draw_clip access (sized clip_style distance) state view chosen self
  return frame

func encode_maybe (value: Maybe U32) => case value of
  $Nothing => #[0.0, 0.0]
  $Some inner => #[1.0, from inner]

func decode_maybe (values: #[F32]) => func start =>
  let inner = lanes.integer values[start + 1] lanes.max_integer
  if lanes.flag values[start]:
    return $Some inner
  use lanes.require (inner == 0)
  return $Nothing

// Numeric layout remains version 1; no owning Editor or Drag is decoded.
const head_lanes = 25
const max_clips = 3

func encode_stored_drag drag -> (faces: &[render.Face]) => case drag of
  $StoredIdle => #[0.0]
  $StoredDraw {start, axis, side, created} => array.concat #[1.0, start.x, start.y, start.z, from axis.index, side] (encode_maybe created)
  $StoredMove {origin, anchor, vertical} => array.concat #[2.0, anchor.x, anchor.y, anchor.z, lanes.bit vertical] (brush.encode_stored origin faces)
  $StoredResize {origin, face, anchor} => array.concat #[3.0, from face, anchor.x, anchor.y, anchor.z] (brush.encode_stored origin faces)
  $StoredReshape {origin, corner, anchor, vertical} => array.concat #[4.0, from corner, anchor.x, anchor.y, anchor.z, lanes.bit vertical] (brush.encode_stored origin faces)
  $StoredTurn {origin, x, y, tilt} => array.concat #[5.0, x, y, lanes.bit tilt] (brush.encode_stored origin faces)
func encode_storage access =>
  let owned: #[StoredEditor] = access.editor
  let clips: #[Vec3] = access.editor_clips
  let faces: #[render.Face] = access.editor_drag_faces
  let state = owned[0]
  let drag = encode_stored_drag state.drag (&faces[0..faces.length])
  let output: #[F32] = array.fill (head_lanes + drag.length) 0.0
  output[0] := case state.mode of
    $Play => 0.0
    $Edit => 1.0
  output[1] := case state.tool of
    $Brushes => 0.0
    $Vertices => 1.0
    $Clipper => 2.0
    $Rotate => 3.0
  if let $Some selected = state.selected:
    output[2] := 1.0
    output[3] := U32.to_f32 selected
  if let $Some face = state.face:
    output[4] := 1.0
    output[5] := U32.to_f32 face
  output[6] := state.grid
  output[7] := U32.to_f32 state.paint
  output[8] := U32.to_f32 state.clips_count
  for index in 0..state.clips_count:
    let point = clips.at index
    output[9 + index * 3] := point.x
    output[10 + index * 3] := point.y
    output[11 + index * 3] := point.z
  let view = camera.encode state.view
  for index in 0..7:
    output[18 + index] := view[index]
  for index in 0..drag.length:
    output[head_lanes + index] := drag[index]
  return output

// Decode into independent scratch owners, then publish only fixed rows and spans.
func decode_stored_drag (values: #[F32]) -> (faces: own #[render.Face]) : (StoredDrag, #[render.Face]) =>
  let tag = lanes.integer values[0] 5
  if tag == 0:
    lanes.exact values 1
    return ($StoredIdle, faces)
  if tag == 1:
    lanes.exact values 8
    lanes.require (abs values[5] == 1.0)
    return ($StoredDraw {start: lanes.vec3 values 1, axis: math.Axis.from_index (lanes.integer values[4] 2), side: values[5], created: decode_maybe values 6}, faces)
  if tag == 2:
    lanes.exact values (5 + brush.width)
    let anchor = lanes.vec3 values 1
    let vertical = lanes.flag values[4]
    let (origin, faces) = brush.decode_into (array.slice 5 brush.width values) faces
    return ($StoredMove {origin, anchor, vertical}, faces)
  if tag == 3:
    lanes.exact values (5 + brush.width)
    let (origin, faces) = brush.decode_into (array.slice 5 brush.width values) faces
    let face = lanes.integer values[1] (origin.faces_count - 1)
    return ($StoredResize {origin, face, anchor: lanes.vec3 values 2}, faces)
  if tag == 4:
    lanes.exact values (6 + brush.width)
    let corner = lanes.integer values[1] 63
    let anchor = lanes.vec3 values 2
    let vertical = lanes.flag values[5]
    let (origin, faces) = brush.decode_into (array.slice 6 brush.width values) faces
    return ($StoredReshape {origin, corner, anchor, vertical}, faces)
  lanes.exact values (4 + brush.width)
  let tilt = lanes.flag values[3]
  let (origin, faces) = brush.decode_into (array.slice 4 brush.width values) faces
  return ($StoredTurn {origin, x: values[1], y: values[2], tilt}, faces)
func decode_into (values: #[F32]) -> (own access) =>
  lanes.require (values.length > head_lanes)
  lanes.finite values
  let mode = if lanes.flag values[0] then $Edit else $Play
  let tool = case lanes.integer values[1] 3 of
    0 => $Brushes
    1 => $Vertices
    2 => $Clipper
    _ => $Rotate
  let selected = decode_maybe values 2
  let face = decode_maybe values 4
  let grid = values[6]
  lanes.require (grid >= min_grid and grid <= max_grid)
  let paint = lanes.integer values[7] lanes.max_integer
  let clips_count = lanes.integer values[8] max_clips
  lanes.zeros values (9 + clips_count * 3) ((max_clips - clips_count) * 3)
  let view = camera.decode (array.slice 18 7 values)
  let faces: #[render.Face] = #[]
  let (drag, faces) = decode_stored_drag (array.slice head_lanes (values.length - head_lanes) values) faces
  let decoded_clips = array.generate clips_count (func index => lanes.vec3 values (9 + index * 3))
  access.editor_clips := store_clips self decoded_clips
  access.editor_drag_faces := store_origin_faces self (&faces[0..faces.length])
  access.editor[0] := $StoredEditor {mode, tool, selected, face, grid, paint, clips_count, drag, view}
  return access
func reset_storage (own access) =>
  // Logical reset retains bounded physical capacity and any active read views.
  let current: camera.Camera = access.camera[0]
  access.editor[0] := initial current
  return access

const codec = {key: 8, version: 1, encode: encode_storage, migrate: lanes.no_migration}

// Requires input, camera, render and brush plugins. Starts in Edit mode.
func initialize settings -> (own access) =>
  access.editor[0] := initial settings.view
  return access

type Words is data = $Words {
  toolbar: &[U32], edit: &[U32], edit_keys: &[U32],
  tools: #[&[U32]], tool_keys: #[&[U32]],
  grid: &[U32], grid_keys: &[U32], metres: &[U32],
  material: &[U32], material_keys: &[U32], out_of: &[U32],
  brushes: &[U32], brush: &[U32], selection: &[U32], nothing: &[U32],
  by: &[U32], at: &[U32], comma: &[U32],
  commands: #[&[U32]], command_keys: #[&[U32]],
}

// The commands, in the order of Words.commands: delete, duplicate, undo,
// redo, turn, look at the selection, split along the clip, save and revert
// the scene, quicksave and quickload; the key each presses, with Shift or
// Ctrl, and whether it needs a selection.
type Shortcut is data = $Shortcut { key: U32, shift: Bool, control: Bool, selection: Bool }
const shortcuts = #[
  $Shortcut { key: keys.x, shift: false, control: false, selection: true },
  $Shortcut { key: keys.d, shift: false, control: true, selection: true },
  $Shortcut { key: keys.u, shift: false, control: false, selection: false },
  $Shortcut { key: keys.u, shift: true, control: false, selection: false },
  $Shortcut { key: keys.r, shift: false, control: false, selection: true },
  $Shortcut { key: keys.f, shift: false, control: false, selection: true },
  $Shortcut { key: keys.enter, shift: false, control: false, selection: true },
  $Shortcut { key: keys.s, shift: false, control: true, selection: false },
  $Shortcut { key: keys.r, shift: false, control: true, selection: false },
  $Shortcut { key: keys.f6, shift: false, control: false, selection: false },
  $Shortcut { key: keys.f9, shift: false, control: false, selection: false },
]
// The split, which only the clipper has.
const split_command = 6
const tools = #[$Brushes, $Vertices, $Clipper, $Rotate]
// At most this many brushes are listed, the first by entity.
const most_listed = 64

// Its nodes use scope 5.
const scope = 5
const toolbar_node = ui.node_id scope 0
const edit_node = ui.node_id scope 1
const grid_node = ui.node_id scope 2
const material_node = ui.node_id scope 3
const selection_node = ui.node_id scope 4
const brushes_node = ui.node_id scope 5
func tool_node (index: U32) => ui.node_id scope (16 + index)
func command_node (index: U32) => ui.node_id scope (32 + index)
// A brush's node, by its entity.
func brush_node (entity: U32) => ui.node_id scope (1024 + entity)

func same_tool (a: Tool) => func (b: Tool) => case a, b of
  $Brushes, $Brushes => true
  $Vertices, $Vertices => true
  $Clipper, $Clipper => true
  $Rotate, $Rotate => true
  _, _ => false

// Where the box from `low` to `high` lies on a `width` by `height` screen
// seen from `view`: round the corners in front of it, or nowhere.
func on_screen (lens: camera.Lens) => func (view: camera.Camera) => func (low: Vec3) => func (high: Vec3) => func (width: F32) => func (height: F32) =>
  let left = width
  let top = height
  let right = 0.0
  let bottom = 0.0
  let seen = false
  for corner in 0 .. 8:
    let point = math.vec3 (if corner % 2 == 0 then low.x else high.x) (if (corner / 2) % 2 == 0 then low.y else high.y) (if corner / 4 == 0 then low.z else high.z)
    if let $Some (x, y) = camera.viewport_point lens view point width height:
      seen := true
      left := min self x
      top := min self y
      right := max self x
      bottom := max self y
  let x = max left 0.0
  let y = max top 0.0
  let across = min right width - x
  let down = min bottom height - y
  if not seen or across <= 0.0 or down <= 0.0:
    return ui.nowhere
  return $ui.Rect { x, y, width: across, height: down }

// What a brush is, in words: its size and where it stands.
func brush_words (words: Words) => func (solid: brush.Brush) =>
  let (low, high) = brush.world_bounds solid
  let size = high - low
  let middle = (low + high) * 0.5
  return (array.concat (array.concat (array.concat (array.concat (array.concat (array.concat (array.concat (array.concat (array.concat (array.concat (ui.decimal size.x 2) (words.by)) (ui.decimal size.y 2)) (words.by)) (ui.decimal size.z 2)) (words.at)) (ui.decimal middle.x 2)) (words.comma)) (ui.decimal middle.y 2)) (words.comma)) (ui.decimal middle.z 2))

func brush_name (words: Words) => func (entity: U32) => array.concat words.brush (ui.digits entity)

func push_stored_node (nodes: own #[tree.StoredNode]) -> (stored: tree.StoredNode) : #[tree.StoredNode] =>
  @storage.push nodes stored
  return nodes
func declare_node (own access) -> (node: tree.Node) =>
  let (stored, labels) = tree.store_node node access.ui_labels
  access.ui_labels := labels
  access.ui_nodes := push_stored_node self stored
  return access

func declare_toolbar (own access) -> settings -> (words: Words) -> (presentation: app.Presentation) -> (frame: render.FrameAccess) =>
  let lens: camera.Lens = access.lens[0]
  let view: camera.Camera = access.camera[0]
  let $Settings { materials } = settings
  let state: StoredEditor = access.editor[0]
  let editing = case state.mode of
    $Edit => true
    $Play => false
  access := declare_node self (ui.toolbar_node toolbar_node 0 words.toolbar ui.nowhere)
  access := declare_node self (ui.described words.edit_keys (ui.toggle_node edit_node toolbar_node words.edit editing ui.nowhere))
  if not editing:
    return access
  for index in 0 .. tools.length:
    access := declare_node self (ui.described words.tool_keys[index] (ui.toggle_node (tool_node index) toolbar_node words.tools[index] (same_tool state.tool tools[index]) ui.nowhere))
  let grid_words = array.concat (ui.decimal state.grid 4) words.metres
  access := declare_node self (ui.described words.grid_keys (ui.spin_node grid_node toolbar_node words.grid state.grid min_grid max_grid state.grid (text_view grid_words) ui.nowhere))
  let material_words = (array.concat (array.concat (ui.digits (state.paint + 1)) (words.out_of)) (ui.digits materials.length))
  access := declare_node self (ui.valued (text_view material_words) (ui.described words.material_keys (ui.button_node material_node toolbar_node words.material ui.nowhere)))
  let chosen = selection_of state.selected (brushes access ())
  let clipping = same_tool state.tool $Clipper
  for index in 0 .. shortcuts.length:
    let shortcut = shortcuts[index]
    if index != split_command or clipping:
      access := declare_node self (ui.disabled_when (shortcut.selection and not (Maybe.is_some chosen))
        (ui.described words.command_keys[index] (ui.button_node (command_node index) toolbar_node words.commands[index] ui.nowhere)))
  let shown = func (solid: brush.Brush) =>
    let (low, high) = brush.world_bounds solid
    return on_screen lens view low high presentation.width presentation.height
  if let $Some (entity, solid) = chosen:
    let text = array.concat (array.concat (brush_name words entity) (words.comma)) (brush_words words solid)
    access := declare_node self (ui.status_node selection_node 0 words.selection (text_view text) (shown solid))
  else:
    access := declare_node self (ui.status_node selection_node 0 words.selection words.nothing ui.nowhere)
  access := declare_node self (ui.list_node brushes_node 0 words.brushes ui.nowhere)
  let brush_count = access.brushes.length
  let listed = 0
  for entity in 0 .. brush_count:
    if let $Some solid = solid_at (brushes access ()) entity:
      if listed < most_listed:
        listed := self + 1
        let name = brush_name words entity
        let desc = brush_words words solid
        let item = ui.operable ui.pressable (ui.item_node (brush_node entity) brushes_node (text_view name) (shown solid))
        item.selected := ui.state (case state.selected of
          $Some picked => picked == entity
          $Nothing => false)
        access := declare_node self (ui.valued (text_view desc) item)
  return access

// The toolbar supplies its own modifiers, independent of held controls.
func invoke_shortcut hooks -> (own access) -> settings -> view -> (shortcut: Shortcut) => return
  key_action hooks access settings view shortcut.key shortcut.shift shortcut.control false

// The grid nearest `wanted`: a power of two between the least and the most.
func nearest_grid (wanted: F32) =>
  let grid = min_grid
  for 0 .. 8:
    if grid * 1.5 <= wanted and grid * 2.0 <= max_grid:
      grid := self * 2.0
  return grid

// UiActions on the toolbar's nodes: each does what its key does.
func toolbar_receive hooks -> (own access) -> settings -> (context: app.EventContext) =>
  let $window.UiAction { node, action, value } = context.event else:
    return access
  let state: StoredEditor = access.editor[0]
  let view: camera.Camera = access.camera[0]
  let pressing = action == vocabulary.action_activate
  if node == edit_node:
    if pressing:
      return toggle hooks access settings
    return access
  if let $Edit = state.mode:
    let chosen_tool: Maybe Tool = $Nothing
    for index in 0 .. tools.length:
      if pressing and node == tool_node index:
        chosen_tool := $Some tools[index]
    if let $Some tool = chosen_tool:
      return use_tool access state tool
    if node == grid_node:
      if action == vocabulary.action_increment:
        return regrid access state 2.0
      if action == vocabulary.action_decrement:
        return regrid access state 0.5
      if action == vocabulary.action_set_value:
        return regrid access state (nearest_grid value / state.grid)
      return access
    if pressing and node == material_node:
      return invoke_shortcut hooks access settings view ($Shortcut { key: keys.m, shift: false, control: false, selection: false })
    if pressing and node >= command_node 0 and node < command_node shortcuts.length:
      return invoke_shortcut hooks access settings view shortcuts[node - command_node 0]
    if pressing and node >= brush_node 0 and node <= ui.node_id scope 65535:
      return select access state ($Some (node - brush_node 0)) $Nothing
  return access

// The toolbar, after the editor's own plugin: `words` in the game's words.
// Applications call toolbar_receive and declare_toolbar in their static stages.
const history_checkpoint = scene_history.checkpoint
const history_step_to = scene_history.step_to
const history_moved = scene_history.moved
