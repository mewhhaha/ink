//! Navigation mesh: convex polygons on the XZ plane, with a height at every
//! vertex. Positions are flat x,y,z triples (y is height). Polygons are spans
//! of `corners` (vertex ids) with a parallel `links` pool: links[c] is the
//! polygon across the edge from corner c to the next corner, or `none`.
//!
//! Winding: each polygon is counter-clockwise in the (x, z) plane, meaning
//! cross(a, b, c) = (bx-ax)(cz-az) - (bz-az)(cx-ax) is positive for consecutive
//! corners. The interior is to the left of every edge a -> b. Collinear corners
//! are allowed (they appear when a grid rectangle is split along neighbours).
//!
//! Adjacency comes from shared edges only: polygon P links to Q when P has the
//! directed edge a -> b and Q has b -> a. Vertex ids, not coordinates, decide
//! this, so two polygons that touch along partly overlapping edges (a
//! T-junction) are NOT linked: split the long edge with the extra vertex.
//! Three polygons on one edge, or two with the same directed edge, are rejected.
//!
//! Key items: [`Poly`], [`Storage`], [`Mesh`], [`Spot`], [`read`].

import * as navigation from "../navigation"

type Poly is data = $Poly { start: U32, count: U32 }
type Storage is data = $Storage { vertices: #[F32], corners: #[U32], links: #[U32], polys: #[Poly], centers: #[F32] }
type Mesh is data = $Mesh { vertices: &[F32], corners: &[U32], links: &[U32], polys: &[Poly], centers: &[F32] }
// A located point: `poly` is `none` when the query found no polygon.
type Spot is data = $Spot { poly: U32, x: F32, y: F32, z: F32 }
const none = 0xFFFFFFFF
// Points this close (metres) outside an edge still count as inside.
const tolerance = 0.00001

func read (storage: Storage) : Mesh => $Mesh {
  vertices: &storage.vertices[0..storage.vertices.length], corners: &storage.corners[0..storage.corners.length],
  links: &storage.links[0..storage.links.length], polys: &storage.polys[0..storage.polys.length],
  centers: &storage.centers[0..storage.centers.length],
}
func empty () : Storage =>
  let vertices: #[F32] = #[]
  let corners: #[U32] = #[]
  let links: #[U32] = #[]
  let polys: #[Poly] = #[]
  let centers: #[F32] = #[]
  return $Storage { vertices, corners, links, polys, centers }
func cleared (storage: own Storage) : Storage =>
  @storage.truncate storage.vertices 0
  @storage.truncate storage.corners 0
  @storage.truncate storage.links 0
  @storage.truncate storage.polys 0
  @storage.truncate storage.centers 0
  return storage

func cycle (i: U32) -> (count: U32) : U32 => if i + 1 == count then 0 else i + 1
func previous (i: U32) -> (count: U32) : U32 => if i == 0 then count - 1 else i - 1
func cross (ax: F32) -> (az: F32) -> (bx: F32) -> (bz: F32) -> (cx: F32) -> (cz: F32) : F32 =>
  (bx - ax) * (cz - az) - (bz - az) * (cx - ax)

// The vertex id of corner `i` of polygon `p`.
func corner (mesh: Mesh) -> (p: U32) -> (i: U32) : U32 => mesh.corners[mesh.polys[p].start + i]
func px (mesh: Mesh) -> (v: U32) : F32 => mesh.vertices[v * 3]
func py (mesh: Mesh) -> (v: U32) : F32 => mesh.vertices[v * 3 + 1]
func pz (mesh: Mesh) -> (v: U32) : F32 => mesh.vertices[v * 3 + 2]

// Sign changes of the edge direction along one axis around a ring: a convex
// simple polygon has at most two per axis.
func reversals (positions: &[F32]) -> (indices: &[U32]) -> (start: U32) -> (count: U32) -> (axis: U32) : U32 =>
  let changes = 0
  let last = 0.0
  let first = 0.0
  for i in 0 .. count:
    let a = indices[start + i]
    let b = indices[start + cycle i count]
    let d = positions[b * 3 + axis] - positions[a * 3 + axis]
    if d != 0.0:
      if first == 0.0:
        first := d
      if last != 0.0 and (d > 0.0) != (last > 0.0):
        changes := self + 1
      last := d
  if first != 0.0 and last != 0.0 and (first > 0.0) != (last > 0.0):
    changes := self + 1
  return changes

// Valid when every polygon has at least three corners, finite positions,
// distinct consecutive points, nonnegative turns and positive area, and the
// ring is convex and simple.
func valid_polygon (positions: &[F32]) -> (indices: &[U32]) -> (start: U32) -> (count: U32) : Bool =>
  let area = 0.0
  let a0 = indices[start]
  let x0 = positions[a0 * 3]
  let z0 = positions[a0 * 3 + 2]
  for i in 0 .. count:
    let a = indices[start + i]
    let b = indices[start + cycle i count]
    let c = indices[start + cycle (cycle i count) count]
    let ax = positions[a * 3]
    let az = positions[a * 3 + 2]
    let bx = positions[b * 3]
    let bz = positions[b * 3 + 2]
    let cx = positions[c * 3]
    let cz = positions[c * 3 + 2]
    if a == b or (ax == bx and az == bz):
      return false
    let turn = cross ax az bx bz cx cz
    if not (is_finite turn and turn >= 0.0):
      return false
    area := self + cross x0 z0 ax az bx bz
  if not (is_finite area and area > 0.0):
    return false
  return reversals positions indices start count 0 <= 2 and reversals positions indices start count 2 <= 2

// Builds a mesh from positions (x,y,z triples), per-polygon corner counts and
// the flat corner vertex ids. Returns false and leaves `storage` untouched when
// any input is invalid (see the module comment). Nothing is clamped or repaired.
private func make_with_links (storage: own Storage) -> (positions: &[F32]) -> (counts: &[U32]) -> (indices: &[U32]) -> (grid_links: &[U32]) : (Bool, Storage) =>
  if positions.length % 3 != 0 or counts.length == 0 or counts.length >= none:
    return (false, storage)
  let vertex_count = positions.length / 3
  for value in positions:
    if not is_finite value:
      return (false, storage)
  let total = 0
  for count in counts:
    if count < 3 or count > indices.length - total:
      return (false, storage)
    total := self + count
  if total != indices.length:
    return (false, storage)
  for vertex in indices:
    if vertex >= vertex_count:
      return (false, storage)
  let starts: #[U32] = @storage.with_capacity counts.length
  let direct = grid_links.length == total
  let at = 0
  for p in 0 .. counts.length:
    if not (valid_polygon positions indices at counts[p]):
      return (false, storage)
    @storage.push starts at
    at := self + counts[p]
  let links: #[U32] = #[]
  if not direct:
    links := link_edges positions counts indices starts
    if links.length != total:
      return (false, storage)
  let $Storage { vertices: out_verts, corners: out_corners, links: out_links, polys: out_polys, centers: out_centers } = storage
  @storage.truncate out_verts 0
  @storage.truncate out_corners 0
  @storage.truncate out_links 0
  @storage.truncate out_polys 0
  @storage.truncate out_centers 0
  @storage.reserve out_verts positions.length
  @storage.reserve out_corners total
  @storage.reserve out_links total
  @storage.reserve out_polys counts.length
  @storage.reserve out_centers (counts.length * 3)
  @storage.extend out_verts positions
  @storage.extend out_corners indices
  if direct:
    @storage.extend out_links grid_links
  else:
    @storage.extend out_links links
  for p in 0 .. counts.length:
    @storage.push out_polys ($Poly { start: starts[p], count: counts[p] })
    // Area centroid of the fan around corner 0.
    let first = starts[p]
    let a = indices[first]
    let ax = positions[a * 3]
    let ay = positions[a * 3 + 1]
    let az = positions[a * 3 + 2]
    let area = 0.0
    let sx = 0.0
    let sy = 0.0
    let sz = 0.0
    for i in 1 .. counts[p] - 1:
      let b = indices[first + i]
      let c = indices[first + i + 1]
      let weight = cross ax az positions[b * 3] positions[b * 3 + 2] positions[c * 3] positions[c * 3 + 2]
      area := self + weight
      sx := self + weight * (ax + positions[b * 3] + positions[c * 3])
      sy := self + weight * (ay + positions[b * 3 + 1] + positions[c * 3 + 1])
      sz := self + weight * (az + positions[b * 3 + 2] + positions[c * 3 + 2])
    let denom = area * 3.0
    let cx = if is_finite denom and denom > 0.0 then sx / denom else ax
    let cy = if is_finite denom and denom > 0.0 then sy / denom else ay
    let cz = if is_finite denom and denom > 0.0 then sz / denom else az
    @storage.push out_centers (if is_finite cx then cx else ax)
    @storage.push out_centers (if is_finite cy then cy else ay)
    @storage.push out_centers (if is_finite cz then cz else az)
  return (true, $Storage { vertices: out_verts, corners: out_corners, links: out_links, polys: out_polys, centers: out_centers })

private func link_edges (positions: &[F32]) -> (counts: &[U32]) -> (indices: &[U32]) -> (starts: #[U32]) : #[U32] =>
  let vertex_count = positions.length / 3
  let total = indices.length
  let owners = @array.fill total 0
  for p in 0 .. counts.length:
    let start = starts[p]
    for c in start .. start + counts[p]:
      owners[c] := p
  // Directed edges bucketed by their first vertex.
  let heads = @array.fill (vertex_count + 1) 0
  for c in 0 .. total:
    heads[indices[c] + 1] := self + 1
  for v in 0 .. vertex_count:
    heads[v + 1] := self + heads[v]
  let fills = @array.fill vertex_count 0
  let bucket = @array.fill total 0
  for c in 0 .. total:
    let v = indices[c]
    bucket[heads[v] + fills[v]] := c
    fills[v] := self + 1
  let links = @array.fill total none
  for c in 0 .. total:
    let p = owners[c]
    let first = starts[p]
    let count = counts[p]
    let a = indices[c]
    let b = indices[first + cycle (c - first) count]
    let found = none
    let matches = 0
    for k in heads[b] .. heads[b + 1]:
      let other = bucket[k]
      let q = owners[other]
      let end = indices[starts[q] + cycle (other - starts[q]) counts[q]]
      if end == a:
        matches := self + 1
        found := q
    for k in heads[a] .. heads[a + 1]:
      let other = bucket[k]
      let q = owners[other]
      let end = indices[starts[q] + cycle (other - starts[q]) counts[q]]
      if end == b and other != c:
        return #[]
    if matches > 1 or (matches == 1 and found == p):
      return #[]
    links[c] := found
  return links

func make_into (storage: own Storage) -> (positions: &[F32]) -> (counts: &[U32]) -> (indices: &[U32]) : (Bool, Storage) =>
  let links: #[U32] = #[]
  return make_with_links storage positions counts indices (&links[0..0])

// Derives a mesh from a cost grid: walkable cells (positive cost) of exactly
// equal cost merge greedily into rectangles, scanning row-major; each
// rectangle extends right as far as it can, then down while whole rows match.
// Cell (column, row) covers x in [left + column * size, +size] and z in
// [front + row * size, +size]. Heights are zero. Every grid vertex on a
// rectangle's boundary becomes a corner, so neighbouring rectangles share whole
// unit edges and link without T-junctions. Returns false for a non-positive or
// nonfinite size or when the grid has no walkable cell.
func from_grid_into (storage: own Storage) -> (grid: navigation.Grid) -> (left: F32) -> (front: F32) -> (size: F32) : (Bool, Storage) =>
  if not (size > 0.0 and is_finite size and is_finite left and is_finite front):
    return (false, storage)
  let width = grid.width
  let height = grid.height
  let cells = grid.costs
  let n = cells.length
  let first_walkable = n
  for cell in 0 .. n:
    if cells[cell] > 0.0:
      first_walkable := cell
      break
  if first_walkable == n:
    return (false, storage)
  let max_x = left + U32.to_f32 width * size
  let max_z = front + U32.to_f32 height * size
  let prev_x = left + U32.to_f32 (width - 1) * size
  let prev_z = front + U32.to_f32 (height - 1) * size
  let span_ok = is_finite max_x and is_finite max_z and left + size > left and max_x > prev_x and front + size > front and max_z > prev_z
  let area_ok = is_finite ((max_x - left) * (max_z - front) * 3.0)
  if span_ok and area_ok:
    let owner = @array.fill n none
    let stride = width + 1
    let slots = @array.fill (stride * (height + 1)) none
    let $Storage { vertices: out_verts, corners: out_corners, links: out_links, polys: out_polys, centers: out_centers } = storage
    @storage.truncate out_verts 0
    @storage.truncate out_corners 0
    @storage.truncate out_links 0
    @storage.truncate out_polys 0
    @storage.truncate out_centers 0
    let vertices: U32 = 0
    let col_mask = width - 1
    let power_of_two = (width & col_mask) == 0
    let width_shift: U32 = 0
    if power_of_two:
      let w = width
      for 0 .. 32:
        if w <= 1:
          break
        w := self >> 1
        width_shift := self + 1
    for cell in first_walkable .. n:
      let cost = cells[cell]
      if cost <= 0.0 or owner[cell] != none:
        continue
      let column = if power_of_two then cell & col_mask else cell % width
      let row = if power_of_two then cell >> width_shift else cell / width
      let run: U32 = 1
      for k in column + 1 .. width:
        let idx = cell + k - column
        if cells[idx] != cost or owner[idx] != none:
          break
        run := self + 1
      let rows: U32 = 1
      for r in row + 1 .. height:
        let row_base = r * width + column
        let same = true
        for k in 0 .. run:
          let other = row_base + k
          if cells[other] != cost or owner[other] != none:
            same := false
            break
        if not same:
          break
        rows := self + 1
      let poly = out_polys.length
      for r in 0 .. rows:
        let row_base = (row + r) * width + column
        for k in 0 .. run:
          owner[row_base + k] := poly
      let before = out_corners.length
      let perim = (run + rows) * 2
      @storage.reserve out_corners perim
      @storage.reserve out_links perim
      // Bottom edge: (column .. column + run, row)
      let z_bot = front + U32.to_f32 row * size
      let row_above = if row > 0 then (row - 1) * width else n
      for s in 0 .. run:
        let cx = column + s
        let key = row * stride + cx
        let v = slots[key]
        if v == none:
          v := vertices
          slots[key] := v
          vertices := self + 1
          @storage.push out_verts (left + U32.to_f32 cx * size)
          @storage.push out_verts 0.0
          @storage.push out_verts z_bot
        @storage.push out_corners v
        @storage.push out_links (if row > 0 then row_above + cx else n)
      // Right edge: (column + run, row .. row + rows)
      let cx_right = column + run
      let x_right = left + U32.to_f32 cx_right * size
      for s in 0 .. rows:
        let cz = row + s
        let key = cz * stride + cx_right
        let v = slots[key]
        if v == none:
          v := vertices
          slots[key] := v
          vertices := self + 1
          @storage.push out_verts x_right
          @storage.push out_verts 0.0
          @storage.push out_verts (front + U32.to_f32 cz * size)
        @storage.push out_corners v
        @storage.push out_links (if cx_right < width then cz * width + cx_right else n)
      // Top edge (reversed): (column + run .. column, row + rows)
      let cz_top = row + rows
      let z_top = front + U32.to_f32 cz_top * size
      let row_below = if cz_top < height then cz_top * width else n
      for s in 0 .. run:
        let cx = cx_right - s
        let key = cz_top * stride + cx
        let v = slots[key]
        if v == none:
          v := vertices
          slots[key] := v
          vertices := self + 1
          @storage.push out_verts (left + U32.to_f32 cx * size)
          @storage.push out_verts 0.0
          @storage.push out_verts z_top
        @storage.push out_corners v
        @storage.push out_links (if cz_top < height then row_below + cx - 1 else n)
      // Left edge (reversed): (column, row + rows .. row)
      let x_left = left + U32.to_f32 column * size
      for s in 0 .. rows:
        let cz = cz_top - s
        let key = cz * stride + column
        let v = slots[key]
        if v == none:
          v := vertices
          slots[key] := v
          vertices := self + 1
          @storage.push out_verts x_left
          @storage.push out_verts 0.0
          @storage.push out_verts (front + U32.to_f32 cz * size)
        @storage.push out_corners v
        @storage.push out_links (if column > 0 then (cz - 1) * width + column - 1 else n)
      @storage.push out_polys ($Poly { start: before, count: perim })
      @storage.push out_centers ((x_left + x_right) * 0.5)
      @storage.push out_centers 0.0
      @storage.push out_centers ((z_bot + z_top) * 0.5)
    for i in 0 .. out_links.length:
      let other = out_links[i]
      out_links[i] := if other == n then none else owner[other]
    return (true, $Storage { vertices: out_verts, corners: out_corners, links: out_links, polys: out_polys, centers: out_centers })
  let owner = @array.fill n none
  let slots = @array.fill ((width + 1) * (height + 1)) none
  let positions: #[F32] = #[]
  let counts: #[U32] = #[]
  let indices: #[U32] = #[]
  let outside: #[U32] = #[]
  let vertices = 0
  for cell in first_walkable .. n:
    if cells[cell] <= 0.0 or owner[cell] != none:
      continue
    let cost = cells[cell]
    let column = cell % width
    let row = cell / width
    let run = 1
    for k in column + 1 .. width:
      if cells[cell + k - column] != cost or owner[cell + k - column] != none:
        break
      run := self + 1
    let rows = 1
    for r in row + 1 .. height:
      let same = true
      for k in 0 .. run:
        let other = r * width + column + k
        if cells[other] != cost or owner[other] != none:
          same := false
          break
      if not same:
        break
      rows := self + 1
    let poly = counts.length
    for r in 0 .. rows:
      for k in 0 .. run:
        owner[(row + r) * width + column + k] := poly
    // Counter-clockwise boundary: bottom, right, top (reversed), left (reversed).
    let before = indices.length
    for step in 0 .. (run + rows) * 2:
      let cx = column
      let cz = row
      let other = n
      if step < run:
        cx := column + step
        if row > 0:
          other := (row - 1) * width + cx
      else:
        if step < run + rows:
          cx := column + run
          cz := row + (step - run)
          if cx < width:
            other := cz * width + cx
        else:
          if step < run * 2 + rows:
            cx := column + run - (step - run - rows)
            cz := row + rows
            if cz < height:
              other := cz * width + cx - 1
          else:
            cz := row + rows - (step - run * 2 - rows)
            if column > 0:
              other := (cz - 1) * width + column - 1
      let key = cz * (width + 1) + cx
      if slots[key] == none:
        slots[key] := vertices
        vertices := self + 1
        @storage.push positions (left + U32.to_f32 cx * size)
        @storage.push positions 0.0
        @storage.push positions (front + U32.to_f32 cz * size)
      @storage.push indices slots[key]
      @storage.push outside other
    @storage.push counts (indices.length - before)
  if counts.length == 0:
    return (false, storage)
  for i in 0 .. outside.length:
    let other = outside[i]
    outside[i] := if other == n then none else owner[other]
  return make_with_links storage (&positions[0..positions.length]) (&counts[0..counts.length]) (&indices[0..indices.length]) (&outside[0..outside.length])

// ---- Point queries --------------------------------------------------------

// Whether (x, z) lies inside polygon `p`, within `tolerance` metres of an edge.
func contains (mesh: Mesh) -> (p: U32) -> (x: F32) -> (z: F32) : Bool =>
  let poly = mesh.polys[p]
  let p_start = poly.start
  let p_count = poly.count
  let corners = mesh.corners
  let verts = mesh.vertices
  for i in 0 .. p_count:
    let a = corners[p_start + i]
    let b = corners[p_start + cycle i p_count]
    let ax = verts[a * 3]
    let az = verts[a * 3 + 2]
    let bx = verts[b * 3]
    let bz = verts[b * 3 + 2]
    let c = cross ax az bx bz x z
    if c < 0.0:
      let length = sqrt ((bx - ax) * (bx - ax) + (bz - az) * (bz - az))
      if not (c >= (0.0 - tolerance) * length):
        return false
    else:
      if not (c >= 0.0):
        return false
  return true

// Interpolated height of polygon `p` at (x, z): the fan triangle that contains
// the point best (largest smallest barycentric weight) is interpolated, so
// points slightly outside use the nearest triangle's plane.
func height_at (mesh: Mesh) -> (p: U32) -> (x: F32) -> (z: F32) : F32 =>
  let poly = mesh.polys[p]
  let a = mesh.corners[poly.start]
  let ax = mesh.vertices[a * 3]
  let ay = mesh.vertices[a * 3 + 1]
  let az = mesh.vertices[a * 3 + 2]
  let best = (-3e38)
  let height = ay
  for i in 1 .. poly.count - 1:
    let b = mesh.corners[poly.start + i]
    let c = mesh.corners[poly.start + i + 1]
    let bx = mesh.vertices[b * 3]
    let bz = mesh.vertices[b * 3 + 2]
    let cx = mesh.vertices[c * 3]
    let cz = mesh.vertices[c * 3 + 2]
    let area = cross ax az bx bz cx cz
    if area > 0.0:
      let wa = cross x z bx bz cx cz / area
      let wb = cross ax az x z cx cz / area
      let wc = cross ax az bx bz x z / area
      let low = min wa (min wb wc)
      if low > best:
        best := low
        height := wa * ay + wb * mesh.vertices[b * 3 + 1] + wc * mesh.vertices[c * 3 + 1]
  return height

// ---- Spatial bucket index -------------------------------------------------

// A caller-owned uniform grid over the mesh's XZ bounds. Each cell lists the
// polygons whose bounds touch it, in ascending polygon order.
type IndexStorage is data = $IndexStorage { starts: #[U32], items: #[U32] }
type Frame is data = $Frame { left: F32, front: F32, size: F32, columns: U32, rows: U32 }
type Index is data = $Index { frame: Frame, starts: &[U32], items: &[U32] }
const max_cells = 1048576
func index_storage () : IndexStorage =>
  let starts: #[U32] = #[]
  let items: #[U32] = #[]
  return $IndexStorage { starts, items }
func index_read (storage: IndexStorage) -> (frame: Frame) : Index =>
  $Index { frame, starts: &storage.starts[0..storage.starts.length], items: &storage.items[0..storage.items.length] }

func bounds_of (mesh: Mesh) : (F32, F32, F32, F32) =>
  let low_x = 3e38
  let low_z = 3e38
  let high_x = (-3e38)
  let high_z = (-3e38)
  for v in 0 .. mesh.vertices.length / 3:
    low_x := min self mesh.vertices[v * 3]
    high_x := max self mesh.vertices[v * 3]
    low_z := min self mesh.vertices[v * 3 + 2]
    high_z := max self mesh.vertices[v * 3 + 2]
  return (low_x, low_z, high_x, high_z)

// Buckets the polygons into cells of about `size` metres; a cell size that
// would make over a million cells is enlarged. The frame is empty (zero
// columns) for an empty mesh or a non-positive size.
type XzBounds is data = $XzBounds { min_x: F32, min_z: F32, max_x: F32, max_z: F32 }

private func poly_bounds (polys: &[Poly]) -> (corners: &[U32]) -> (vertices: &[F32]) -> (p: U32) : XzBounds =>
  let poly = polys[p]
  let min_x = 3e38
  let min_z = 3e38
  let max_x = (-3e38)
  let max_z = (-3e38)
  for i in poly.start .. poly.start + poly.count:
    let v = corners[i] * 3
    let vx = vertices[v]
    let vz = vertices[v + 2]
    min_x := min self vx
    max_x := max self vx
    min_z := min self vz
    max_z := max self vz
  return $XzBounds {min_x, min_z, max_x, max_z}

// The caller can retain these rows for the same immutable mesh revision.
func polygon_bounds_into (out: own #[XzBounds]) -> (mesh: Mesh) : #[XzBounds] =>
  @storage.truncate out 0
  let polys = mesh.polys
  let corners = mesh.corners
  let vertices = mesh.vertices
  for p in 0 .. polys.length:
    @storage.push out (poly_bounds polys corners vertices p)
  return out

func index_into (storage: own IndexStorage) -> (mesh: Mesh) -> (size: F32) : (IndexStorage, Frame) =>
  let empty_bounds: #[XzBounds] = #[]
  return index_with_bounds storage mesh size false (&empty_bounds[0..0])

func index_into_prepared (storage: own IndexStorage) -> (mesh: Mesh) -> (size: F32) -> (bounds: &[XzBounds]) : (IndexStorage, Frame) =>
  if bounds.length != mesh.polys.length:
    return index_into storage mesh size
  return index_with_bounds storage mesh size true bounds

private func index_with_bounds (storage: own IndexStorage) -> (mesh: Mesh) -> (size: F32) -> (use_bounds: Bool) -> (bounds: &[XzBounds]) : (IndexStorage, Frame) =>
  let $IndexStorage { starts: out_starts, items: out_items } = storage
  @storage.truncate out_starts 0
  @storage.truncate out_items 0
  let polys = mesh.polys
  if polys.length == 0 or not (size > 0.0 and is_finite size):
    return ($IndexStorage { starts: out_starts, items: out_items }, $Frame { left: 0.0, front: 0.0, size: 1.0, columns: 0, rows: 0 })
  let (low_x, low_z, high_x, high_z) = bounds_of mesh
  if not (is_finite low_x and is_finite low_z and is_finite high_x and is_finite high_z):
    return ($IndexStorage { starts: out_starts, items: out_items }, $Frame { left: 0.0, front: 0.0, size: 1.0, columns: 0, rows: 0 })
  let cell = size
  let span_x = high_x - low_x
  let span_z = high_z - low_z
  let span = max span_x span_z
  if not (is_finite span):
    cell := max 1.0 (max (max (abs low_x) (abs high_x)) (max (abs low_z) (abs high_z)))
  else:
    if not (is_finite (span / cell)) or span / cell > 1000.0:
      cell := max 0.0001 (span / 1000.0)
  let raw_cols = floor (span_x / cell)
  let raw_rows = floor (span_z / cell)
  let columns = if is_finite raw_cols and raw_cols >= 0.0 then min 1001 (F32.to_u32 raw_cols + 1) else 1
  let rows = if is_finite raw_rows and raw_rows >= 0.0 then min 1001 (F32.to_u32 raw_rows + 1) else 1
  let frame = $Frame { left: low_x, front: low_z, size: cell, columns, rows }
  let np = polys.length
  let corners = mesh.corners
  let vertices = mesh.vertices
  let cell_count = columns * rows
  let counts = @array.fill (cell_count + 1) 0
  let spans = @array.fill (np * 4) 0
  let inv_cell = 1.0 / cell
  let use_inv = is_finite inv_cell
  for p in 0 .. np:
    let $XzBounds {min_x, min_z, max_x, max_z} = if use_bounds then bounds[p] else poly_bounds polys corners vertices p
    let rc0 = floor (if use_inv then (min_x - low_x) * inv_cell else (min_x - low_x) / cell)
    let rc1 = floor (if use_inv then (max_x - low_x) * inv_cell else (max_x - low_x) / cell)
    let rr0 = floor (if use_inv then (min_z - low_z) * inv_cell else (min_z - low_z) / cell)
    let rr1 = floor (if use_inv then (max_z - low_z) * inv_cell else (max_z - low_z) / cell)
    let c0 = if is_finite rc0 then min (columns - 1) (F32.to_u32 (max 0.0 rc0)) else 0
    let c1 = if is_finite rc1 then min (columns - 1) (F32.to_u32 (max 0.0 rc1)) else (columns - 1)
    let r0 = if is_finite rr0 then min (rows - 1) (F32.to_u32 (max 0.0 rr0)) else 0
    let r1 = if is_finite rr1 then min (rows - 1) (F32.to_u32 (max 0.0 rr1)) else (rows - 1)
    let sp = p * 4
    spans[sp] := c0
    spans[sp + 1] := c1
    spans[sp + 2] := r0
    spans[sp + 3] := r1
    for r in r0 .. r1 + 1:
      let row_off = r * columns + 1
      for c in c0 .. c1 + 1:
        counts[row_off + c] := self + 1
  for k in 0 .. cell_count:
    counts[k + 1] := self + counts[k]
  let total_items = counts[cell_count]
  @storage.reserve out_items total_items
  for _ in 0 .. total_items:
    @storage.push out_items 0
  @storage.reserve out_starts (cell_count + 1)
  @storage.extend out_starts counts
  for p in 0 .. np:
    let sp = p * 4
    let c0 = spans[sp]
    let c1 = spans[sp + 1]
    let r0 = spans[sp + 2]
    let r1 = spans[sp + 3]
    for r in r0 .. r1 + 1:
      let row_off = r * columns
      for c in c0 .. c1 + 1:
        let slot = row_off + c
        out_items[counts[slot]] := p
        counts[slot] := self + 1
  return ($IndexStorage { starts: out_starts, items: out_items }, frame)

func spot_none () : Spot => $Spot { poly: none, x: 0.0, y: 0.0, z: 0.0 }

// The lowest-numbered polygon containing (x, z), or `none`. Points outside the
// index, NaN points and empty meshes give `none`.
func locate (mesh: Mesh) -> (index: Index) -> (x: F32) -> (z: F32) : U32 =>
  let frame = index.frame
  if frame.columns == 0 or frame.rows == 0 or not (is_finite x and is_finite z and is_finite frame.size and frame.size > 0.0 and x >= frame.left and z >= frame.front):
    return none
  let raw_c = floor ((x - frame.left) / frame.size)
  let raw_r = floor ((z - frame.front) / frame.size)
  if not (is_finite raw_c and is_finite raw_r):
    return none
  let column = F32.to_u32 raw_c
  let row = F32.to_u32 raw_r
  if column >= frame.columns or row >= frame.rows:
    return none
  let cell = row * frame.columns + column
  for k in index.starts[cell] .. index.starts[cell + 1]:
    let p = index.items[k]
    if contains mesh p x z:
      return p
  return none

// A point in the mesh at (x, z) with its interpolated height, or a Spot with
// poly `none`.
func locate_spot (mesh: Mesh) -> (index: Index) -> (x: F32) -> (z: F32) : Spot =>
  let p = locate mesh index x z
  if p == none:
    return spot_none ()
  return $Spot { poly: p, x, y: height_at mesh p x z, z }

// Closest point on the polygon's closed region to (x, z), as (x, z, squared
// distance). Inside points map to themselves.
func clamp_to (mesh: Mesh) -> (p: U32) -> (x: F32) -> (z: F32) : (F32, F32, F32) =>
  if contains mesh p x z:
    return (x, z, 0.0)
  let poly = mesh.polys[p]
  let best = 3e38
  let bx = x
  let bz = z
  for i in 0 .. poly.count:
    let a = mesh.corners[poly.start + i]
    let b = mesh.corners[poly.start + cycle i poly.count]
    let ax = mesh.vertices[a * 3]
    let az = mesh.vertices[a * 3 + 2]
    let ex = mesh.vertices[b * 3] - ax
    let ez = mesh.vertices[b * 3 + 2] - az
    let t = clamp 0.0 1.0 (((x - ax) * ex + (z - az) * ez) / (ex * ex + ez * ez))
    let qx = ax + ex * t
    let qz = az + ez * t
    let d = (x - qx) * (x - qx) + (z - qz) * (z - qz)
    if d < best:
      best := d
      bx := qx
      bz := qz
  return (bx, bz, best)

// The nearest point of the mesh to (x, z) (any polygon, ties to the lowest id),
// or a Spot with poly `none` for an empty mesh or nonfinite query. Buckets are
// searched in growing square rings until no unvisited ring can be closer.
func closest (mesh: Mesh) -> (index: Index) -> (x: F32) -> (z: F32) : Spot =>
  let frame = index.frame
  if frame.columns == 0 or frame.rows == 0 or not (is_finite x and is_finite z and is_finite frame.size and frame.size > 0.0):
    return spot_none ()
  let rc = floor ((x - frame.left) / frame.size)
  let rr = floor ((z - frame.front) / frame.size)
  let max_c = U32.to_f32 (frame.columns - 1)
  let max_r = U32.to_f32 (frame.rows - 1)
  let fc = if is_finite rc then clamp 0.0 max_c rc else if rc > 0.0 then max_c else 0.0
  let fr = if is_finite rr then clamp 0.0 max_r rr else if rr > 0.0 then max_r else 0.0
  let column = F32.to_u32 fc
  let row = F32.to_u32 fr
  let best = 3e38
  let best_poly = none
  let best_x = x
  let best_z = z
  let rings = max frame.columns frame.rows
  for ring in 0 .. rings:
    if best_poly != none and best <= (U32.to_f32 ring - 1.0) * frame.size * (U32.to_f32 ring - 1.0) * frame.size and ring > 0:
      break
    let r0 = if row >= ring then row - ring else 0
    let r1 = min (frame.rows - 1) (row + ring)
    let c0 = if column >= ring then column - ring else 0
    let c1 = min (frame.columns - 1) (column + ring)
    for r in r0 .. r1 + 1:
      for c in c0 .. c1 + 1:
        let edge = r + ring == row or r == row + ring or c + ring == column or c == column + ring
        if not edge:
          continue
        let cell = r * frame.columns + c
        for k in index.starts[cell] .. index.starts[cell + 1]:
          let p = index.items[k]
          let (qx, qz, d) = clamp_to mesh p x z
          if d < best or (d == best and p < best_poly):
            best := d
            best_poly := p
            best_x := qx
            best_z := qz
  if best_poly == none:
    return spot_none ()
  return $Spot { poly: best_poly, x: best_x, y: height_at mesh best_poly best_x best_z, z: best_z }

// ---- Straight walk --------------------------------------------------------

// Result of walking a straight line from a point inside polygon `poly`. `t` is
// the reached fraction of the segment; `blocked` is true when the walk left the
// mesh across a boundary edge before t = 1. `poly` is the last polygon entered.
type Walk is data = $Walk { blocked: Bool, poly: U32, t: F32, steps: U32 }

// Walks from (sx, sz), which must lie in `start`, toward (ex, ez) across shared
// edges until the segment ends or leaves the mesh. Each polygon's exit is the
// smallest parameter over edges the direction leaves through (lowest edge on
// ties). Visits at most one polygon per mesh polygon.
func walk (mesh: Mesh) -> (start: U32) -> (sx: F32) -> (sz: F32) -> (ex: F32) -> (ez: F32) : Walk =>
  let dx = ex - sx
  let dz = ez - sz
  if not (is_finite dx and is_finite dz and is_finite sx and is_finite sz) or start >= mesh.polys.length:
    return $Walk { blocked: true, poly: none, t: 0.0, steps: 0 }
  let p = start
  let steps = 0
  for 0 .. mesh.polys.length + 1:
    let poly = mesh.polys[p]
    let exit = 1.0
    let through = none
    for i in 0 .. poly.count:
      let a = mesh.corners[poly.start + i]
      let b = mesh.corners[poly.start + cycle i poly.count]
      let ax = mesh.vertices[a * 3]
      let az = mesh.vertices[a * 3 + 2]
      let ex2 = mesh.vertices[b * 3] - ax
      let ez2 = mesh.vertices[b * 3 + 2] - az
      // Interior is left of the edge: distance in is cross(edge, point - a).
      let rate = ex2 * dz - ez2 * dx
      if rate < 0.0:
        let t = (ex2 * (sz - az) - ez2 * (sx - ax)) / (0.0 - rate)
        if t < exit:
          exit := max 0.0 t
          through := i
    if through == none:
      return $Walk { blocked: false, poly: p, t: 1.0, steps }
    let next = mesh.links[poly.start + through]
    steps := self + 1
    if next == none:
      return $Walk { blocked: true, poly: p, t: exit, steps }
    p := next
  return $Walk { blocked: true, poly: p, t: 0.0, steps }
