import { Vec3 } from "std/vector"
import * as math from "../math"
import * as transform from "../transform"
import * as ground from "./ground"

type Motion is data = #Motion { yaw: F32, speed: F32, phase: F32 }
type Gait is data = #Gait { height: F32, turn: F32, phase_per_unit: F32, phases: F32 }
type Request is data = #Request { target: Vec3, speed: F32, reach: F32 }
type Result is data = #Result { motion: Motion, pose: transform.Pose3, arrived: Bool }
const toward = fn (solids: ground.Ground) => fn (gait: Gait) => fn (seconds: F32) => fn (request: Request) => fn (motion: Motion) => fn (pose: transform.Pose3) => do:
  if Bool.not (ground.clear solids pose.position.x pose.position.z):
    pose.position := ground.reachable solids self
  let distance = fn at => do:
    let x = request.target.x - at.x
    let z = request.target.z - at.z
    return x * x + z * z
  motion.speed := 0.0
  if distance pose.position <= request.reach * request.reach && ground.clear solids pose.position.x pose.position.z:
    return #Result { motion, pose, arrived: #True }
  if seconds <= 0.0 || Bool.not (is_finite seconds):
    return #Result { motion, pose, arrived: #False }
  let #Some moved = ground.step solids pose.position.x pose.position.z motion.yaw request.target (gait.turn * seconds) (request.speed * seconds) else:
    return #Result { motion, pose, arrived: #False }
  motion.yaw := moved.yaw
  motion.speed := moved.moved / seconds
  motion.phase := wrap gait.phases (self + moved.moved * gait.phase_per_unit)
  pose.position := math.vec3 moved.x gait.height moved.z
  pose.rotation := math.Quat.yaw moved.yaw
  return #Result { motion, pose, arrived: distance pose.position <= request.reach * request.reach }
