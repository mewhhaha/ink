//! Ground motion steering requests and gait helpers decoupled from gameplay and animation policy.
//!
//! Key items: [`Motion`], [`Gait`], [`Request`], [`Result`], [`toward`].

import { Vec3 } from "std/vector"
import * as math from "../math"
import * as transform from "../transform"
import * as ground from "./ground"

type Motion is data = $Motion { yaw: F32, speed: F32, phase: F32 }
type Gait is data = $Gait { height: F32, turn: F32, phase_per_unit: F32, phases: F32 }
type Request is data = $Request { target: Vec3, speed: F32, reach: F32 }
type Result is data = $Result { motion: Motion, pose: transform.Pose3, arrived: Bool }
type PositionResult is data = $PositionResult { motion: Motion, position: Vec3, turned: Bool, arrived: Bool }

func toward_position (solids: ground.Read) -> (gait: Gait) -> (seconds: F32) -> (request: Request) -> (motion: Motion) -> (position: Vec3) : PositionResult =>
  let start_clear = ground.clear solids position.x position.z
  if not start_clear:
    position := ground.reachable solids self
  let distance = func (at: Vec3): F32 =>
    let x: F32 = request.target.x - at.x
    let z: F32 = request.target.z - at.z
    return x * x + z * z
  motion.speed := 0.0
  let reach_ok = is_finite request.reach and request.reach >= 0.0
  if reach_ok and distance position <= request.reach * request.reach and (start_clear or ground.clear solids position.x position.z):
    return $PositionResult { motion, position, turned: false, arrived: true }
  if seconds <= 0.0 or not (is_finite seconds):
    return $PositionResult { motion, position, turned: false, arrived: false }
  let $Some moved = ground.step_from solids position.x position.z motion.yaw request.target (gait.turn * seconds) (request.speed * seconds) start_clear else:
    return $PositionResult { motion, position, turned: false, arrived: false }
  motion.yaw := moved.yaw
  motion.speed := moved.moved / seconds
  if is_finite gait.phases and gait.phases > 0.0 and is_finite gait.phase_per_unit:
    motion.phase := wrap gait.phases (self + moved.moved * gait.phase_per_unit)
  position := math.vec3 moved.x gait.height moved.z
  return $PositionResult { motion, position, turned: true, arrived: reach_ok and distance position <= request.reach * request.reach }

func toward (solids: ground.Read) -> (gait: Gait) -> (seconds: F32) -> (request: Request) -> (motion: Motion) -> (pose: transform.Pose3) : Result =>
  let next = toward_position solids gait seconds request motion pose.position
  pose.position := next.position
  if next.turned:
    pose.rotation := math.Quat.yaw next.motion.yaw
  return $Result { motion: next.motion, pose, arrived: next.arrived }
