//! String pulling (the funnel algorithm) over the corridor in work.corridor.
//! Writes the taut corner path to work.path as x, y, z triples: start, the
//! corners that bend the path, goal. Heights come from the vertices (linearly
//! along inset portals) and from the start/goal spots.
//!
//! Portal p between corridor polygons is the run of edges of the earlier polygon
//! that link to the later one. With the interior left of every edge a -> b, a
//! walker crossing it has `a` on the right and `b` on the left. Clearance: each
//! portal's endpoints are moved `radius` metres toward each other along the
//! portal, collapsing to its midpoint when it is not wider than 2 * radius.
//! This keeps corner points `radius` away from the wall vertices the path bends
//! around; it does not offset walls, so crossings at oblique angles can pass
//! closer than `radius`. Pre-shrink the mesh when walls need exact clearance.
//!
//! Key items: [`portal_into`], [`emit`], [`pull_into`].

import * as corridor from "./corridor"
import * as mesh from "./mesh"

private func safe_interp (a: F32) -> (b: F32) -> (t: F32) : F32 =>
  let d = b - a
  if is_finite d:
    let v = a + d * t
    if is_finite v:
      return v
  return a * (1.0 - t) + b * t

func portal_into (work: own corridor.Work) -> (m: mesh.Mesh) -> (a: U32) -> (b: U32) -> (radius: F32) : corridor.Work =>
  if a > 1431655764 or b > 1431655764 or a * 3 + 2 >= m.vertices.length or b * 3 + 2 >= m.vertices.length:
    return work
  let ax = m.vertices[a * 3]
  let ay = m.vertices[a * 3 + 1]
  let az = m.vertices[a * 3 + 2]
  let bx = m.vertices[b * 3]
  let by = m.vertices[b * 3 + 1]
  let bz = m.vertices[b * 3 + 2]
  if not (is_finite ax and is_finite ay and is_finite az and is_finite bx and is_finite by and is_finite bz and is_finite radius):
    return work
  let dx = bx - ax
  let dz = bz - az
  let raw_len = sqrt (dx * dx + dz * dz)
  let inset = max 0.0 radius
  let from = 0.0
  let to = 1.0
  if inset > 0.0:
    if is_finite raw_len:
      if raw_len > 0.0:
        if raw_len <= inset * 2.0:
          from := 0.5
          to := 0.5
        else:
          from := inset / raw_len
          to := 1.0 - inset / raw_len
    else:
      let hdx = bx * 0.5 - ax * 0.5
      let hdz = bz * 0.5 - az * 0.5
      let scale = max (abs hdx) (abs hdz)
      if is_finite scale and scale > 0.0:
        let sx = hdx / scale
        let sz = hdz / scale
        let s_len = sqrt (sx * sx + sz * sz)
        let ratio = inset / scale
        if not (is_finite ratio) or s_len <= ratio:
          from := 0.5
          to := 0.5
        else:
          let frac = ((inset * 0.5) / scale) / s_len
          from := if is_finite frac then clamp 0.0 0.5 frac else 0.0
          to := 1.0 - from
  // Left end first (b side), then right end (a side); validate before atomic append.
  let lx = safe_interp ax bx to
  let ly = safe_interp ay by to
  let lz = safe_interp az bz to
  let rx = safe_interp ax bx from
  let ry = safe_interp ay by from
  let rz = safe_interp az bz from
  if not (is_finite lx and is_finite ly and is_finite lz and is_finite rx and is_finite ry and is_finite rz):
    return work
  @storage.push work.portals lx
  @storage.push work.portals ly
  @storage.push work.portals lz
  @storage.push work.portals rx
  @storage.push work.portals ry
  @storage.push work.portals rz
  return work

func emit (work: own corridor.Work) -> (x: F32) -> (y: F32) -> (z: F32) : corridor.Work =>
  let n = work.path.length
  if n >= 3 and work.path[n - 3] == x and work.path[n - 1] == z:
    return work
  @storage.push work.path x
  @storage.push work.path y
  @storage.push work.path z
  return work

// Pulls work.corridor taut between `start` and `goal` (which must lie in the
// corridor's first and last polygons). Leaves work.path empty when the corridor
// is empty, a portal is missing, or a point is nonfinite. A corridor of one
// polygon yields the two endpoints.
func pull_into (work: own corridor.Work) -> (m: mesh.Mesh) -> (start: mesh.Spot) -> (goal: mesh.Spot) -> (radius: F32) : corridor.Work =>
  @storage.truncate work.path 0
  @storage.truncate work.portals 0
  let count = work.corridor.length
  if count == 0 or not (is_finite start.x and is_finite start.y and is_finite start.z and is_finite goal.x and is_finite goal.y and is_finite goal.z and is_finite radius):
    return work
  // Portal 0 is the start point, the last portal the goal.
  for _ in 0 .. 2:
    @storage.push work.portals start.x
    @storage.push work.portals start.y
    @storage.push work.portals start.z
  for k in 0 .. count - 1:
    let p = work.corridor[k]
    let q = work.corridor[k + 1]
    if p >= m.polys.length or q >= m.polys.length:
      return work
    let (first, length) = corridor.run_of m p q
    if length == 0:
      @storage.truncate work.portals 0
      return work
    let poly = m.polys[p]
    if poly.count == 0 or poly.start > m.corners.length or poly.count > m.corners.length - poly.start or first >= poly.count or length > poly.count:
      @storage.truncate work.portals 0
      return work
    let a = m.corners[poly.start + first]
    let b = m.corners[poly.start + (first + length) % poly.count]
    let before_len = work.portals.length
    work := portal_into work m a b radius
    if work.portals.length != before_len + 6:
      @storage.truncate work.portals 0
      return work
  for _ in 0 .. 2:
    @storage.push work.portals goal.x
    @storage.push work.portals goal.y
    @storage.push work.portals goal.z
  let n = count + 1
  let apex_x = start.x
  let apex_y = start.y
  let apex_z = start.z
  let left_x = start.x
  let left_y = start.y
  let left_z = start.z
  let right_x = start.x
  let right_y = start.y
  let right_z = start.z
  let apex_i = 0
  let left_i = 0
  let right_i = 0
  work := emit work start.x start.y start.z
  let i = 1
  let step_cap = if n > 4096 then 16777216 else n * n + n
  for 0 .. step_cap:
    if i >= n:
      break
    let lx = work.portals[i * 6]
    let ly = work.portals[i * 6 + 1]
    let lz = work.portals[i * 6 + 2]
    let rx = work.portals[i * 6 + 3]
    let ry = work.portals[i * 6 + 4]
    let rz = work.portals[i * 6 + 5]
    let restart = false
    // The right side tightens when the new point is not clockwise of the ray.
    if mesh.cross apex_x apex_z right_x right_z rx rz >= 0.0:
      if (apex_x == right_x and apex_z == right_z) or mesh.cross apex_x apex_z left_x left_z rx rz < 0.0:
        right_x := rx
        right_y := ry
        right_z := rz
        right_i := i
      else:
        if left_i > apex_i:
          work := emit work left_x left_y left_z
          apex_x := left_x
          apex_y := left_y
          apex_z := left_z
          apex_i := left_i
          right_x := apex_x
          right_y := apex_y
          right_z := apex_z
          right_i := apex_i
          i := apex_i + 1
          restart := true
    if restart:
      continue
    if mesh.cross apex_x apex_z left_x left_z lx lz <= 0.0:
      if (apex_x == left_x and apex_z == left_z) or mesh.cross apex_x apex_z right_x right_z lx lz > 0.0:
        left_x := lx
        left_y := ly
        left_z := lz
        left_i := i
      else:
        if right_i > apex_i:
          work := emit work right_x right_y right_z
          apex_x := right_x
          apex_y := right_y
          apex_z := right_z
          apex_i := right_i
          left_x := apex_x
          left_y := apex_y
          left_z := apex_z
          left_i := apex_i
          i := apex_i + 1
          restart := true
    if restart:
      continue
    i := self + 1
  work := emit work goal.x goal.y goal.z
  return work
