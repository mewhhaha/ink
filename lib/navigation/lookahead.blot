import * as array from "std/array"
import * as math from "../math"
import * as transform from "../transform"
import { Vec3 } from "std/vector"
import * as ground from "./ground"
import * as locomotion from "./locomotion"

// Bounded speculative movement over one immutable geometry snapshot. Callers
// own the input revision and must revalidate it before applying an answer.
// A forecast is data, never a controller or a deferred side effect.
type Request is data = $Request {
  points: &[Vec3], seconds: F32, steps: U32, speed: F32, reach: F32,
}
type End is data = $Arrived | $Blocked | $Budget
type Forecast is data = $Forecast {
  end: End, pose: transform.Pose3, motion: locomotion.Motion,
  points: #[Vec3], elapsed: F32, distance: F32, remaining: F32,
}
func arrived (value: Forecast) => case value.end of
  $Arrived => true
  _ => false
func forecast_into (destination: own #[Vec3]) -> (solids: ground.Read) -> (gait: locomotion.Gait) -> (request: Request) -> (motion: locomotion.Motion) -> (pose: transform.Pose3) : Maybe Forecast =>
  let valid = is_finite request.seconds and request.seconds > 0.0 and request.seconds <= 1.0 and
    is_finite request.speed and request.speed >= 0.0 and is_finite request.reach and request.reach >= 0.0 and
    math.finite3 pose.position and is_finite motion.yaw and is_finite motion.phase and
    is_finite gait.turn and gait.turn >= 0.0 and is_finite gait.height and
    is_finite gait.phase_per_unit and is_finite gait.phases and gait.phases > 0.0
  if request.points.length == 0 or request.points.length > 8 or request.steps > 128 or not valid:
    return $Nothing
  for point in request.points:
    if not (math.finite3 point):
      return $Nothing
  // Snapshot at most eight input points before reusing the destination.
  // On a failed movement calculation, discard its partial scratch output.
  use route <- array.map identity request.points
  @storage.truncate destination 0
  @storage.push destination pose.position
  let elapsed = 0.0
  let travelled = 0.0
  let target = 0
  let end = $Budget
  for 0 .. request.steps:
    let next = locomotion.toward solids gait request.seconds
      ($locomotion.Request { target: route[target], speed: request.speed, reach: request.reach }) motion pose
    let distance = (next.pose.position - pose.position).length
    if not (math.finite3 next.pose.position and is_finite next.motion.yaw and is_finite next.motion.speed and is_finite next.motion.phase and is_finite distance and is_finite (travelled + distance)):
      return $Nothing
    motion := next.motion
    pose := next.pose
    @storage.push destination pose.position
    elapsed := self + request.seconds
    travelled := self + distance
    if next.arrived:
      target := self + 1
      if target == request.points.length:
        end := $Arrived
        break
    else:
      if distance < 0.000001:
        end := $Blocked
        break
  let goal = route[route.length - 1]
  let remaining = (goal - pose.position).length
  if not (is_finite remaining):
    return $Nothing
  return $Some ($Forecast { end, pose, motion, points: destination, elapsed, distance: travelled, remaining })

// A completed route beats an unfinished one. Prefer shorter completed travel;
// otherwise prefer progress, then shorter travel. Exact ties keep input order.
// This function knows no wall-clock completion order or worker identities.
func choose (forecasts: #[Maybe Forecast]) : Maybe U32 =>
  if forecasts.length > 8:
    return $Nothing
  let selected: U32 = 0
  let present: Bool = false
  for index in 0 .. forecasts.length:
    let $Some candidate = forecasts[index] else:
      continue
    let replace: Bool = true
    if present:
      let $Some old = forecasts[selected] else:
        return panic "missing selected forecast"
      replace := if arrived candidate != arrived old then arrived candidate
        else if arrived candidate then candidate.distance < old.distance
        else candidate.remaining < old.remaining or (candidate.remaining == old.remaining and candidate.distance < old.distance)
    if replace:
      selected := index
      present := true
  return if present then $Some selected else $Nothing
