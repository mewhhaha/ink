import { Vec3 } from "std/vector"
import * as array from "std/array"
import * as brush from "../brush"
import * as logic from "../logic"
import * as math from "../math"
import * as spatial from "../spatial"

// Getting about on the ground, for agents of one size: the floor plane (x,
// z) with what stands on it. Obstacles are kept widened by the agents' body
// radius, so a point is `clear` exactly when an agent's middle fits there.
// Boxes stand square to the axes and rounds are circles; agents keep within
// `radius` of the middle.
type Box is data = #Box { left: F32, right: F32, front: F32, back: F32 }
type Round is data = #Round { x: F32, z: F32, radius: F32 }

// The obstacles bucketed once (`make`), so a query visits only those near
// it. `cells` lists rounds as 0 .. rounds.length and boxes after them, each
// in every cell it may cover; `shapes` keeps four numbers per listing in the
// cells' order: a round's x, z, radius and squared radius, or a box's left,
// right, front and back. `slack` is the widening that keeps rounding at
// cell edges from losing an obstacle.
type Ground is data = #Ground { boxes: Array Box, rounds: Array Round, radius: F32, cells: spatial.Cells, shapes: Array F32, slack: F32 }

// Up to this many obstacles share one cell: scanning three costs about what
// finding cells does.
const few = 3

// The ground of `radius` with these obstacles, or Nothing when the radius
// is negative or anything is non-finite or a box is empty. Obstacles are
// static: build once, then query freely. Building is linear in the
// obstacles and the cells they cover.
const make = fn (boxes: Array Box) => fn (rounds: Array Round) => fn (radius: F32) -> Maybe Ground => do:
  if Bool.not (is_finite radius) || radius < 0.0:
    return #Nothing
  for box in boxes:
    if Bool.not (is_finite box.left && is_finite box.right && is_finite box.front && is_finite box.back) || box.left >= box.right || box.front >= box.back:
      return #Nothing
  for round in rounds:
    if Bool.not (is_finite round.x && is_finite round.z && is_finite round.radius) || round.radius < 0.0:
      return #Nothing
  // Only what lies within the arena's square can meet a query; the square
  // is widened past rounding, even where squares underflow. Obstacles cut
  // at its edge stay listed in the edge cells, where points past it fall.
  let edge = radius + radius * 0.00001 + 1e-20
  let count = rounds.length
  let reach = @array.generate (count + boxes.length) (fn (i: U32) => do:
    if i < count:
      let round = rounds[i]
      return #spatial.Bounds { low: math.vec3 (max (0.0 - edge) (round.x - round.radius)) 0.0 (max (0.0 - edge) (round.z - round.radius)), high: math.vec3 (min edge (round.x + round.radius)) 0.0 (min edge (round.z + round.radius)) }
    let box = boxes[i - count]
    return #spatial.Bounds { low: math.vec3 (max (0.0 - edge) box.left) 0.0 (max (0.0 - edge) box.front), high: math.vec3 (min edge box.right) 0.0 (min edge box.back) })
  let scale = 0.0
  for b in reach:
    if b.low.x <= b.high.x && b.low.z <= b.high.z:
      scale := max self (max (max (abs b.low.x) (abs b.high.x)) (max (abs b.low.z) (abs b.high.z)))
  let slack = scale * 0.00001
  let widened = @array.generate reach.length (fn (i: U32) => do:
    let b = reach[i]
    return #spatial.Bounds { low: math.vec3 (b.low.x - slack) 0.0 (b.low.z - slack), high: math.vec3 (b.high.x + slack) 0.0 (b.high.z + slack) })
  let size = 0.0
  if reach.length <= few:
    size := 3e38
  let cells = spatial.areas size widened
  let listed = cells.items
  let shapes = @array.generate (listed.length * 4) (fn (k: U32) => do:
    let item = listed[k / 4]
    let part = k % 4
    if item < count:
      let round = rounds[item]
      if part == 0:
        return round.x
      if part == 1:
        return round.z
      if part == 2:
        return round.radius
      return round.radius * round.radius
    let box = boxes[item - count]
    if part == 0:
      return box.left
    if part == 1:
      return box.right
    if part == 2:
      return box.front
    return box.back)
  return #Some #Ground { boxes, rounds, radius, cells, shapes, slack }

// A ground with nowhere to go but its middle: no obstacles, radius zero. A
// fallback for when `make` refuses the obstacles given it.
const closed = #Ground { boxes: #[], rounds: #[], radius: 0.0, cells: spatial.areas 0.0 #[], shapes: #[], slack: 0.0 }

// Reuse an existing spatial index only for exactly the same ordered shapes.
// Callers own this discardable cache; edits, radius changes and restored
// worlds take the ordinary validated build path.
const matches = fn (previous: Ground) => fn (boxes: Array Box) => fn (rounds: Array Round) => fn (radius: F32) => do:
  let same = radius == previous.radius && boxes.length == previous.boxes.length && rounds.length == previous.rounds.length
  if same:
    for index in 0 .. boxes.length:
      let a = boxes[index]
      let b = previous.boxes[index]
      if a.left != b.left || a.right != b.right || a.front != b.front || a.back != b.back:
        same := #False
        break
  if same:
    for index in 0 .. rounds.length:
      let a = rounds[index]
      let b = previous.rounds[index]
      if a.x != b.x || a.z != b.z || a.radius != b.radius:
        same := #False
        break
  return same

const reuse = fn (previous: Ground) => fn (boxes: Array Box) => fn (rounds: Array Round) => fn (radius: F32) => do:
  if matches previous boxes rounds radius:
    return #Some previous
  return make boxes rounds radius

// The span from `low` to `high`, widened by `body`.
const box_of = fn (body: F32) => fn (span: (Vec3, Vec3)) => do:
  let (low, high) = span
  return #Box { left: low.x - body, right: high.x + body, front: low.z - body, back: high.z + body }

// A circle of `radius` round `center`, widened by `body`.
const round_of = fn (body: F32) => fn (center: Vec3) => fn (radius: F32) =>
  #Round { x: center.x, z: center.z, radius: radius + body }

// Where a brush stands, low corner and high. Most are unrotated, whose
// placed bounds need only an offset, without rebuilding faces or corners.
const brush_span = fn (solid: brush.Brush) => do:
  if brush.turned solid:
    let placed = brush.placed solid
    return (placed.min, placed.max)
  return (solid.min + solid.offset, solid.max + solid.offset)

// Whether a span stands up from the floor, so agents walk round it rather
// than over it.
const raised = fn (span: (Vec3, Vec3)) => do:
  let (_, high) = span
  return high.y > 0.05

// (x, z), or the nearest point to it within `radius` of the middle.
const within = fn (radius: F32) => fn (x: F32) => fn (z: F32) => do:
  let apart = sqrt (x * x + z * z)
  if apart <= radius:
    return (x, z)
  return (x * radius / apart, z * radius / apart)

// The listings of the cell holding (x, z), as a slot range. A single row or
// column needs no arithmetic; `F32.to_u32` saturates, so only the high end
// needs a bound. `spatial.areas` lists by the same cells.
const cell = fn (grid: spatial.Cells) => fn (x: F32) => fn (z: F32) => do:
  let columns = grid.columns
  let column = 0
  let row = 0
  if columns > 1:
    column := min (columns - 1) (F32.to_u32 (floor ((x - grid.left) / grid.size)))
  if grid.rows > 1:
    row := min (grid.rows - 1) (F32.to_u32 (floor ((z - grid.front) / grid.size)))
  let index = row * columns + column
  return (grid.starts[index], grid.starts[index + 1])

// Whether an agent's middle fits at (x, z). Visits the obstacles listed in
// the point's cell.
const clear = fn (ground: Ground) => fn (x: F32) => fn (z: F32) => do:
  if Bool.not (is_finite x && is_finite z) || Bool.not (is_finite (x * x + z * z)) || x * x + z * z > ground.radius * ground.radius:
    return #False
  let (first_slot, last_slot) = cell ground.cells x z
  let items = ground.cells.items
  let shapes = ground.shapes
  let count = ground.rounds.length
  for slot in first_slot .. last_slot:
    let o = slot * 4
    let first = shapes[o]
    let second = shapes[o + 1]
    let third = shapes[o + 2]
    let fourth = shapes[o + 3]
    if items[slot] < count:
      let dx = x - first
      let dz = z - second
      if dx * dx + dz * dz < fourth:
        return #False
    else:
      if logic.both (logic.both (x > first) (x < second)) (logic.both (z > third) (z < fourth)):
        return #False
  return #True

// Analytic finite segments cannot tunnel through obstacles narrower than a
// sampling stride. A circular arena is convex, so checking its ends suffices.
// Box sides are open slab intervals, so boundaries remain traversable,
// matching `clear`. Visits the obstacles listed in the cells the segment
// crosses, row by row.
const line_clear = fn (ground: Ground) => fn (a: Vec3) => fn (b: Vec3) => do:
  if Bool.not (math.finite3 a && math.finite3 b) || Bool.not (clear ground a.x a.z && clear ground b.x b.z):
    return #False
  let dx = b.x - a.x
  let dz = b.z - a.z
  let squared = dx * dx + dz * dz
  if Bool.not (is_finite squared):
    return #False
  let ax = a.x
  let az = a.z
  let grid = ground.cells
  let left = grid.left
  let front = grid.front
  let size = grid.size
  let columns = grid.columns
  let rows = grid.rows
  let starts = grid.starts
  let items = grid.items
  let shapes = ground.shapes
  let count = ground.rounds.length
  // Widened past rounding in the walk and in the tests themselves.
  let slack = 0.0
  let low_x = ax
  let high_x = ax
  let top = 0
  let bottom = 0
  if logic.either (columns > 1) (rows > 1):
    slack := ground.slack + (abs ax + abs az + abs b.x + abs b.z) * 0.00001
    low_x := min ax b.x - slack
    high_x := max ax b.x + slack
  if rows > 1:
    top := min (rows - 1) (F32.to_u32 (floor ((min az b.z - slack - front) / size)))
    bottom := min (rows - 1) (F32.to_u32 (floor ((max az b.z + slack - front) / size)))
  for row in top .. bottom + 1:
    let low = 0
    let high = 0
    if columns > 1:
      let from_x = low_x
      let to_x = high_x
      if logic.both (dz != 0.0) (top < bottom):
        let near = front + U32.to_f32 row * size - slack
        let far = near + size + slack * 2.0
        let x0 = ax + dx * clamp 0.0 1.0 ((near - az) / dz)
        let x1 = ax + dx * clamp 0.0 1.0 ((far - az) / dz)
        from_x := min x0 x1 - slack
        to_x := max x0 x1 + slack
      low := min (columns - 1) (F32.to_u32 (floor ((from_x - left) / size)))
      high := min (columns - 1) (F32.to_u32 (floor ((to_x - left) / size)))
    for slot in starts[row * columns + low] .. starts[row * columns + high + 1]:
      let o = slot * 4
      let first = shapes[o]
      let second = shapes[o + 1]
      let third = shapes[o + 2]
      let fourth = shapes[o + 3]
      if items[slot] < count:
        let t = 0.0
        if squared > 0.0:
          t := clamp 0.0 1.0 (((first - ax) * dx + (second - az) * dz) / squared)
        let x = ax + dx * t - first
        let z = az + dz * t - second
        if x * x + z * z < fourth:
          return #False
      else:
        // Nothing enters a slab whose open interval the segment never meets.
        let across = #True
        let x0 = -1e30
        let x1 = 1e30
        if dx == 0.0:
          if ax <= first || ax >= second:
            across := #False
        else:
          let p = (first - ax) / dx
          let q = (second - ax) / dx
          x0 := min p q
          x1 := max p q
        let z0 = -1e30
        let z1 = 1e30
        if dz == 0.0:
          if az <= third || az >= fourth:
            across := #False
        else:
          let p = (third - az) / dz
          let q = (fourth - az) / dz
          z0 := min p q
          z1 := max p q
        if logic.both across (max 0.0 (max x0 z0) < min 1.0 (min x1 z1)):
          return #False
  return #True

type Edge is data = #Edge { start: Vec3, end: Vec3 }
const closest = fn (edge: Edge) => fn (point: Vec3) => do:
  let way = edge.end - edge.start
  let t = clamp 0.0 1.0 ((point - edge.start).dot way / max 0.0001 (way.dot way))
  return edge.start + way * t
const on_network = fn (edges: Array Edge) => fn (width: F32) => fn (point: Vec3) =>
  array.any (fn edge => (closest edge point - point).length <= width) edges

// A shortest travel-time route through reachable network segments. The first
// waypoint is the entry point, then connected ends, then the exit. Blocked
// edges are excluded; no useful network route leaves ordinary steering intact.
const route = fn (ground: Ground) => fn (edges: Array Edge) => fn (boost: F32) => fn (start: Vec3) => fn (target: Vec3) => do:
  if edges.length == 0 || Bool.not (is_finite boost) || boost <= 0.0:
    return target
  let at = math.vec3 start.x 0.0 start.z
  let goal = reachable ground (math.vec3 target.x 0.0 target.z)
  let kept = #[edge | edge <- edges, line_clear ground edge.start edge.end]
  if kept.length == 0:
    return target
  let nodes = array.flatten #[#[edge.start, edge.end] | edge <- kept]
  let costs = array.generate nodes.length (fn _ => 1000000.0)
  let waypoints = array.generate nodes.length (fn _ => goal)
  let visited = array.generate nodes.length (fn _ => #False)
  for index in 0 .. nodes.length:
    let entry = closest kept[index / 2] at
    if line_clear ground at entry:
      costs[index] := (entry - at).length +(nodes[index] - entry).length / boost
      waypoints[index] := nodes[index]
      if (entry - at).length > 0.2:
        waypoints[index] := entry
  for 0 .. nodes.length:
    let chosen = #Nothing
    let least = 1000000.0
    for index in 0 .. nodes.length:
      if Bool.not visited[index] && costs[index] < least:
        least := costs[index]
        chosen := #Some index
    let #Some current = chosen else:
      break
    visited[current] := #True
    for other in 0 .. nodes.length:
      let apart = (nodes[other] - nodes[current]).length
      if Bool.not visited[other] && (current / 2 == other / 2 || apart < 0.6) && line_clear ground nodes[current] nodes[other]:
        let cost = least + apart / boost
        if cost < costs[other]:
          costs[other] := cost
          waypoints[other] := waypoints[current]
          if (waypoints[current] - at).length <= 0.25:
            waypoints[other] := nodes[other]
  let best = (goal - at).length * 1.05
  let waypoint = target
  for index in 0 .. nodes.length:
    let exit = closest kept[index / 2] goal
    if line_clear ground exit goal:
      let cost = costs[index] +(exit - nodes[index]).length / boost +(goal - exit).length
      if cost < best:
        best := cost
        waypoint := target
        if (exit - at).length > 0.25:
          waypoint := exit
        if (waypoints[index] - at).length > 0.25:
          waypoint := waypoints[index]
  return waypoint

// (x, z) moved just clear of the first obstacle it is in: back within the
// ground's radius, out from a round's middle, or out of a box's nearest side.
// Rounds come first, then boxes, each in order.
const push_out = fn (ground: Ground) => fn (x: F32) => fn (z: F32) => do:
  if x * x + z * z > ground.radius * ground.radius:
    return within (ground.radius - 0.05) x z
  if Bool.not (is_finite x && is_finite z):
    return (x, z)
  let (first_slot, last_slot) = cell ground.cells x z
  let items = ground.cells.items
  let shapes = ground.shapes
  let count = ground.rounds.length
  for slot in first_slot .. last_slot:
    let o = slot * 4
    let first = shapes[o]
    let second = shapes[o + 1]
    let third = shapes[o + 2]
    let fourth = shapes[o + 3]
    if items[slot] < count:
      let dx = x - first
      let dz = z - second
      let apart = sqrt (dx * dx + dz * dz)
      if apart < third:
        let out = third + 0.05
        if apart < 0.001:
          return (first + out, second)
        return (first + dx / apart * out, second + dz / apart * out)
    else:
      if logic.both (logic.both (x > first) (x < second)) (logic.both (z > third) (z < fourth)):
        let to_left = x - first
        let to_right = second - x
        let to_front = z - third
        let to_back = fourth - z
        let least = min (min to_left to_right) (min to_front to_back)
        if least == to_left:
          return (first - 0.05, z)
        if least == to_right:
          return (second + 0.05, z)
        if least == to_front:
          return (x, third - 0.05)
        return (x, fourth + 0.05)
  return (x, z)

// Where an agent could stand nearest `point`: there if it is clear, or else
// pushed clear of what is in the way, in a few pushes if one lands it in
// something else.
const reachable = fn (ground: Ground) => fn (point: Vec3) => do:
  let x = point.x
  let z = point.z
  for 0 .. 6:
    if clear ground x z:
      return math.vec3 x point.y z
    let (moved_x, moved_z) = push_out ground x z
    x := moved_x
    z := moved_z
  return math.vec3 x point.y z

// How an agent moves in one step, as its place (x, z) and its heading (a yaw
// about the vertical, 0 facing +z).
type Step is data = #Step { x: F32, z: F32, yaw: F32, moved: F32 }

// The ways an agent swerves to get round something, tried in turn.
const detours = #[0.0, 0.7, -0.7, 1.4, -1.4, 2.1, -2.1]

// One step of an agent at (x, z) heading `yaw` toward `target`: it turns at
// most `turn` radians toward it and goes at most `stride` (no further than
// the target), swerving by the first of `detours` that keeps it clear. When
// something has come to stand where it is, it walks out of that first.
// Nothing when every way is blocked.
const step = fn (ground: Ground) => fn (x: F32) => fn (z: F32) => fn (yaw: F32) => fn (target: Vec3) => fn (turn: F32) => fn (stride: F32) => do:
  if Bool.not (is_finite x && is_finite z && is_finite yaw && math.finite3 target && is_finite turn && is_finite stride) || turn < 0.0 || stride < 0.0:
    return #Nothing
  if Bool.not (clear ground x z):
    let (out_x, out_z) = push_out ground x z
    let away_x = out_x - x
    let away_z = out_z - z
    let apart = max 0.0001 (sqrt (away_x * away_x + away_z * away_z))
    let going = min stride apart
    return #Some #Step { x: x + away_x / apart * going, z: z + away_z / apart * going, yaw: math.atan2 away_x away_z, moved: going }
  let dx = target.x - x
  let dz = target.z - z
  let distance = sqrt (dx * dx + dz * dz)
  let difference = wrap tau (math.atan2 dx dz - yaw + pi) - pi
  let heading = yaw + clamp (-turn) turn difference
  // Ease forward motion while turning. Stopping before the projected
  // target lets the heading catch up instead of orbiting around it.
  // Facing away turns in place; aligned travel keeps its full stride.
  let forward = max 0.0 (cos (difference - clamp (-turn) turn difference))
  let going = min stride (distance * forward * forward)
  for detour in detours:
    let way = wrap tau (heading + detour)
    let (sine, cosine) = sin_cos way
    let next_x = x + sine * going
    let next_z = z + cosine * going
    if line_clear ground (math.vec3 x 0.0 z) (math.vec3 next_x 0.0 next_z):
      return #Some #Step { x: next_x, z: next_z, yaw: way, moved: going }
  return #Nothing
