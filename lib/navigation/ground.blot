//! Getting about on the ground, for agents of one size: the floor plane (x,
//! z) with what stands on it. Obstacles are kept widened by the agents' body
//! radius, so a point is `clear` exactly when an agent's middle fits there.
//! Boxes stand square to the axes and rounds are circles; agents keep within
//! `radius` of the middle.
//!
//! Key items: [`Box`], [`Round`], [`Ground`], [`Read`], [`with_built`].

import { Vec3 } from "std/vector"
import * as array from "std/array"
import * as brush from "../brush"
import * as logic from "../logic"
import * as math from "../math"
import * as spatial from "../spatial"

type Box is data = $Box { left: F32, right: F32, front: F32, back: F32 }
type Round is data = $Round { x: F32, z: F32, radius: F32 }

// The obstacles bucketed once (`make`), so a query visits only those near
// it. `cells` lists rounds as 0 .. rounds.length and boxes after them, each
// in every cell it may cover; `shapes` keeps four numbers per listing in the
// cells' order: a round's x, z, radius and squared radius, or a box's left,
// right, front and back. `slack` is the widening that keeps rounding at
// cell edges from losing an obstacle.
type Ground [boxes, rounds, cells, shapes] is data = $Ground { boxes: boxes, rounds: rounds, radius: F32, cells: cells, shapes: shapes, slack: F32 }

type Read = Ground [&[Box], &[Round], spatial.Cells [&[U32], &[U32]], &[F32]]

// Up to this many obstacles share one cell: scanning three costs about what
// finding cells does.
const few = 3

// The ground of `radius` with these obstacles, or Nothing when the radius
// is negative or anything is non-finite or a box is empty. Obstacles are
// static: build once, then query freely. Building is linear in the
// obstacles and the cells they cover.
func with_built (boxes: &[Box]) -> (rounds: &[Round]) -> (radius: F32) -> consume =>
  // Only what lies within the arena's square can meet a query; the square
  // is widened past rounding, even where squares underflow. Obstacles cut
  // at its edge stay listed in the edge cells, where points past it fall.
  let edge = radius + radius * 0.00001 + 1e-20
  let count = rounds.length
  let reach = @array.generate (count + boxes.length) (func (i: U32) =>
    if i < count:
      let round = rounds[i]
      return $spatial.Bounds { low: math.vec3 (max (0.0 - edge) (round.x - round.radius)) 0.0 (max (0.0 - edge) (round.z - round.radius)), high: math.vec3 (min edge (round.x + round.radius)) 0.0 (min edge (round.z + round.radius)) }
    let box = boxes[i - count]
    return $spatial.Bounds { low: math.vec3 (max (0.0 - edge) box.left) 0.0 (max (0.0 - edge) box.front), high: math.vec3 (min edge box.right) 0.0 (min edge box.back) })
  let scale = 0.0
  for b in reach:
    if b.low.x <= b.high.x and b.low.z <= b.high.z:
      scale := max self (max (max (abs b.low.x) (abs b.high.x)) (max (abs b.low.z) (abs b.high.z)))
  let slack = scale * 0.00001
  let widened = @array.generate reach.length (func (i: U32) =>
    let b = reach[i]
    return $spatial.Bounds { low: math.vec3 (b.low.x - slack) 0.0 (b.low.z - slack), high: math.vec3 (b.high.x + slack) 0.0 (b.high.z + slack) })
  let size = 0.0
  if reach.length <= few:
    size := 3e38
  return spatial.with_areas size widened (func (cells: spatial.Cells [&[U32], &[U32]]) =>
    let listed = cells.items
    let shapes = @array.generate (listed.length * 4) (func (k: U32) =>
      let item = listed[k / 4]
      let part = k % 4
      if item < count:
        let round = rounds[item]
        if part == 0:
          return round.x
        if part == 1:
          return round.z
        if part == 2:
          return round.radius
        return round.radius * round.radius
      let box = boxes[item - count]
      if part == 0:
        return box.left
      if part == 1:
        return box.right
      if part == 2:
        return box.front
      return box.back)
    return consume ($Ground {boxes: &boxes[0..boxes.length], rounds: &rounds[0..rounds.length], radius, cells, shapes: &shapes[0..shapes.length], slack}))

// Reuse an existing spatial index only for exactly the same ordered shapes.
// Callers own this discardable cache; edits, radius changes and restored
// worlds take the ordinary validated build path.
func matches (previous: Read) => func (boxes: &[Box]) => func (rounds: &[Round]) => func (radius: F32) =>
  let same = radius == previous.radius and boxes.length == previous.boxes.length and rounds.length == previous.rounds.length
  if same:
    for index in 0 .. boxes.length:
      let a = boxes[index]
      let b = previous.boxes[index]
      if a.left != b.left or a.right != b.right or a.front != b.front or a.back != b.back:
        same := false
        break
  if same:
    for index in 0 .. rounds.length:
      let a = rounds[index]
      let b = previous.rounds[index]
      if a.x != b.x or a.z != b.z or a.radius != b.radius:
        same := false
        break
  return same

// Storage is an invocation-local access bundle of separately named pools.
// Stored is plain data and may appear in persistent cache rows and ADTs.
type Storage is data = $Storage { boxes: #[Box], rounds: #[Round], words: #[U32], shapes: #[F32] }
type Span is data = $Span { start: U32, count: U32, capacity: U32 }
type Stored is data = $Stored { boxes: Span, rounds: Span, starts: Span, items: Span, shapes: Span, radius: F32, slack: F32, left: F32, front: F32, size: F32, columns: U32, rows: U32 }
const empty_starts: #[U32] = #[0, 0]
const empty_span = $Span {start: 0, count: 0, capacity: 0}
const closed_stored = $Stored {boxes: empty_span, rounds: empty_span, starts: empty_span, items: empty_span, shapes: empty_span, radius: 0.0, slack: 0.0, left: 0.0, front: 0.0, size: 1.0, columns: 1, rows: 1}
func append_rows (destination: own #[a]) -> (values: &[a]): (Span, #[a]) =>
  let start = destination.length
  let capacity = 0
  if values.length > 0:
    capacity := 16
    for _ in 0 .. 28:
      if capacity >= values.length:
        break
      capacity := self * 2
    for index in 0 .. capacity:
      @storage.push destination (values[if index < values.length then index else 0])
  return ($Span {start, count: values.length, capacity}, destination)
func store (storage: own Storage) -> (ground: Read): (Stored, Storage) =>
  let (boxes, next_boxes) = append_rows storage.boxes ground.boxes
  storage.boxes := next_boxes
  let (rounds, next_rounds) = append_rows storage.rounds ground.rounds
  storage.rounds := next_rounds
  let (starts, next_starts) = append_rows storage.words ground.cells.starts
  storage.words := next_starts
  let (items, next_items) = append_rows storage.words ground.cells.items
  storage.words := next_items
  let (shapes, next_shapes) = append_rows storage.shapes ground.shapes
  storage.shapes := next_shapes
  return ($Stored {boxes, rounds, starts, items, shapes, radius: ground.radius, slack: ground.slack,
    left: ground.cells.left, front: ground.cells.front, size: ground.cells.size, columns: ground.cells.columns, rows: ground.cells.rows}, storage)
func replace_rows (destination: own #[a]) -> (previous: Span) -> (values: &[a]): (Span, #[a]) =>
  if values.length > previous.capacity:
    return append_rows destination values
  for index in 0 .. values.length:
    destination[previous.start + index] := values[index]
  return ($Span {start: previous.start, count: values.length, capacity: previous.capacity}, destination)
func store_replace (storage: own Storage) -> (previous: Stored) -> (ground: Read): (Stored, Storage) =>
  let (boxes, next_boxes) = replace_rows storage.boxes previous.boxes ground.boxes
  storage.boxes := next_boxes
  let (rounds, next_rounds) = replace_rows storage.rounds previous.rounds ground.rounds
  storage.rounds := next_rounds
  let (starts, next_starts) = replace_rows storage.words previous.starts ground.cells.starts
  storage.words := next_starts
  let (items, next_items) = replace_rows storage.words previous.items ground.cells.items
  storage.words := next_items
  let (shapes, next_shapes) = replace_rows storage.shapes previous.shapes ground.shapes
  storage.shapes := next_shapes
  return ($Stored {boxes, rounds, starts, items, shapes, radius: ground.radius, slack: ground.slack,
    left: ground.cells.left, front: ground.cells.front, size: ground.cells.size, columns: ground.cells.columns, rows: ground.cells.rows}, storage)
func read (storage: Storage) -> (stored: Stored) =>
  let cells = $spatial.Cells {left: stored.left, front: stored.front, size: stored.size, columns: stored.columns, rows: stored.rows,
    starts: if stored.starts.count == 0 then &empty_starts[0..2] else &storage.words[stored.starts.start..stored.starts.start + stored.starts.count],
    items: &storage.words[stored.items.start..stored.items.start + stored.items.count]}
  return $Ground {radius: stored.radius, slack: stored.slack, cells,
    boxes: &storage.boxes[stored.boxes.start..stored.boxes.start + stored.boxes.count],
    rounds: &storage.rounds[stored.rounds.start..stored.rounds.start + stored.rounds.count],
    shapes: &storage.shapes[stored.shapes.start..stored.shapes.start + stored.shapes.count]}
func valid (boxes: &[Box]) -> (rounds: &[Round]) -> (radius: F32) =>
  if not (is_finite radius) or radius < 0.0:
    return false
  for box in boxes:
    if not (is_finite box.left and is_finite box.right and is_finite box.front and is_finite box.back) or box.left >= box.right or box.front >= box.back:
      return false
  for round in rounds:
    if not (is_finite round.x and is_finite round.z and is_finite round.radius) or round.radius < 0.0:
      return false
  return true
func make_into (storage: own Storage) -> (boxes: &[Box]) -> (rounds: &[Round]) -> (radius: F32): (Maybe Stored, Storage) =>
  if not (valid boxes rounds radius):
    return ($Nothing, storage)
  let (starts, items, shapes, slack, left, front, size, columns, rows) = with_built boxes rounds radius (func (ground: Read) =>
    return (array.map identity ground.cells.starts, array.map identity ground.cells.items, array.map identity ground.shapes,
      ground.slack, ground.cells.left, ground.cells.front, ground.cells.size, ground.cells.columns, ground.cells.rows))
  let cells = $spatial.Cells {left, front, size, columns, rows, starts: &starts[0..starts.length], items: &items[0..items.length]}
  let built = $Ground {boxes, rounds, radius, cells, shapes: &shapes[0..shapes.length], slack}
  let (next, storage) = store storage built
  return ($Some next, storage)
func reuse_into (storage: own Storage) -> (previous: Stored) -> (boxes: &[Box]) -> (rounds: &[Round]) -> (radius: F32): (Maybe Stored, Storage) =>
  if not (valid boxes rounds radius):
    return ($Nothing, storage)
  if matches (read storage previous) boxes rounds radius:
    return ($Some previous, storage)
  let (starts, items, shapes, slack, left, front, size, columns, rows) = with_built boxes rounds radius (func (ground: Read) =>
    return (array.map identity ground.cells.starts, array.map identity ground.cells.items, array.map identity ground.shapes,
      ground.slack, ground.cells.left, ground.cells.front, ground.cells.size, ground.cells.columns, ground.cells.rows))
  let cells = $spatial.Cells {left, front, size, columns, rows, starts: &starts[0..starts.length], items: &items[0..items.length]}
  let built = $Ground {boxes, rounds, radius, cells, shapes: &shapes[0..shapes.length], slack}
  let (next, storage) = store_replace storage previous built
  return ($Some next, storage)

// The span from `low` to `high`, widened by `body`.
func box_of (body: F32) => func (span: (Vec3, Vec3)) =>
  let (low, high) = span
  return $Box { left: low.x - body, right: high.x + body, front: low.z - body, back: high.z + body }

// A circle of `radius` round `center`, widened by `body`.
func round_of (body: F32) => func (center: Vec3) => func (radius: F32) => return
  $Round { x: center.x, z: center.z, radius: radius + body }

// Where a brush stands, low corner and high. Most are unrotated, whose
// placed bounds need only an offset, without rebuilding faces or corners.
func brush_span (solid: brush.Brush) =>
  return brush.world_bounds solid

// Whether a span stands up from the floor, so agents walk round it rather
// than over it.
func raised (span: (Vec3, Vec3)) =>
  let (_, high) = span
  return high.y > 0.05

// (x, z), or the nearest point to it within `radius` of the middle.
func within (radius: F32) => func (x: F32) => func (z: F32) =>
  if not (is_finite radius and is_finite x and is_finite z) or radius <= 0.0:
    return (0.0, 0.0)
  let scale = max (abs x) (abs z)
  if scale == 0.0:
    return (0.0, 0.0)
  let sx = x / scale
  let sz = z / scale
  let norm = sqrt (sx * sx + sz * sz)
  let apart = scale * norm
  if apart <= radius:
    return (x, z)
  return (sx / norm * radius, sz / norm * radius)

// The listings of the cell holding (x, z), as a slot range. A single row or
// column needs no arithmetic; `F32.to_u32` saturates, so only the high end
// needs a bound. `spatial.areas` lists by the same cells.
func cell (grid: spatial.Cells [&[U32], &[U32]]) => func (x: F32) => func (z: F32) =>
  let columns = grid.columns
  let column = 0
  let row = 0
  if columns > 1:
    column := min (columns - 1) (F32.to_u32 (floor ((x - grid.left) / grid.size)))
  if grid.rows > 1:
    row := min (grid.rows - 1) (F32.to_u32 (floor ((z - grid.front) / grid.size)))
  let index = row * columns + column
  return (grid.starts[index], grid.starts[index + 1])

// Whether an agent's middle fits at (x, z). Visits the obstacles listed in
// the point's cell.
func clear (ground: Read) => func (x: F32) => func (z: F32) =>
  if not (is_finite x and is_finite z) or not (is_finite (x * x + z * z)) or x * x + z * z > ground.radius * ground.radius:
    return false
  let (first_slot, last_slot) = cell ground.cells x z
  let items = ground.cells.items
  let shapes = ground.shapes
  let count = ground.rounds.length
  for slot in first_slot .. last_slot:
    let o = slot * 4
    let first = shapes[o]
    let second = shapes[o + 1]
    let third = shapes[o + 2]
    let fourth = shapes[o + 3]
    if items[slot] < count:
      let dx = x - first
      let dz = z - second
      if dx * dx + dz * dz < fourth:
        return false
    else:
      if logic.both (logic.both (x > first) (x < second)) (logic.both (z > third) (z < fourth)):
        return false
  return true

// Analytic finite segments cannot tunnel through obstacles narrower than a
// sampling stride. A circular arena is convex, so checking its ends suffices.
// Box sides are open slab intervals, so boundaries remain traversable,
// matching `clear`. Visits the obstacles listed in the cells the segment
// crosses, row by row.
func line_clear (ground: Read) => func (a: Vec3) => func (b: Vec3) =>
  if not (math.finite3 a and math.finite3 b) or not (clear ground a.x a.z and clear ground b.x b.z):
    return false
  let dx = b.x - a.x
  let dz = b.z - a.z
  let squared = dx * dx + dz * dz
  if not (is_finite squared):
    return false
  let ax = a.x
  let az = a.z
  let grid = ground.cells
  let left = grid.left
  let front = grid.front
  let size = grid.size
  let columns = grid.columns
  let rows = grid.rows
  let starts = grid.starts
  let items = grid.items
  let shapes = ground.shapes
  let count = ground.rounds.length
  // Widened past rounding in the walk and in the tests themselves.
  let slack = 0.0
  let low_x = ax
  let high_x = ax
  let top = 0
  let bottom = 0
  if logic.either (columns > 1) (rows > 1):
    slack := ground.slack + (abs ax + abs az + abs b.x + abs b.z) * 0.00001
    low_x := min ax b.x - slack
    high_x := max ax b.x + slack
  if rows > 1:
    top := min (rows - 1) (F32.to_u32 (floor ((min az b.z - slack - front) / size)))
    bottom := min (rows - 1) (F32.to_u32 (floor ((max az b.z + slack - front) / size)))
  for row in top .. bottom + 1:
    let low = 0
    let high = 0
    if columns > 1:
      let from_x = low_x
      let to_x = high_x
      if logic.both (dz != 0.0) (top < bottom):
        let near = front + U32.to_f32 row * size - slack
        let far = near + size + slack * 2.0
        let x0 = ax + dx * clamp 0.0 1.0 ((near - az) / dz)
        let x1 = ax + dx * clamp 0.0 1.0 ((far - az) / dz)
        from_x := min x0 x1 - slack
        to_x := max x0 x1 + slack
      low := min (columns - 1) (F32.to_u32 (floor ((from_x - left) / size)))
      high := min (columns - 1) (F32.to_u32 (floor ((to_x - left) / size)))
    for slot in starts[row * columns + low] .. starts[row * columns + high + 1]:
      let o = slot * 4
      let first = shapes[o]
      let second = shapes[o + 1]
      let third = shapes[o + 2]
      let fourth = shapes[o + 3]
      if items[slot] < count:
        let t = 0.0
        if squared > 0.0:
          t := clamp 0.0 1.0 (((first - ax) * dx + (second - az) * dz) / squared)
        let x = ax + dx * t - first
        let z = az + dz * t - second
        if x * x + z * z < fourth:
          return false
      else:
        // Nothing enters a slab whose open interval the segment never meets.
        let across = true
        let x0 = -1e30
        let x1 = 1e30
        if dx == 0.0:
          if ax <= first or ax >= second:
            across := false
        else:
          let p = (first - ax) / dx
          let q = (second - ax) / dx
          x0 := min p q
          x1 := max p q
        let z0 = -1e30
        let z1 = 1e30
        if dz == 0.0:
          if az <= third or az >= fourth:
            across := false
        else:
          let p = (third - az) / dz
          let q = (fourth - az) / dz
          z0 := min p q
          z1 := max p q
        if logic.both across (max 0.0 (max x0 z0) < min 1.0 (min x1 z1)):
          return false
  return true

type Edge is data = $Edge { start: Vec3, end: Vec3 }
func closest (edge: Edge) => func (point: Vec3) =>
  let way = edge.end - edge.start
  let t = clamp 0.0 1.0 ((point - edge.start).dot way / max 0.0001 (way.dot way))
  return edge.start + way * t
func on_network (edges: #[Edge]) => func (width: F32) => func (point: Vec3) => return
  array.any (func edge => (closest edge point - point).length <= width) edges

// A shortest travel-time route through reachable network segments. The first
// waypoint is the entry point, then connected ends, then the exit. Blocked
// edges are excluded; no useful network route leaves ordinary steering intact.
func route (ground: Read) => func (edges: #[Edge]) => func (boost: F32) => func (start: Vec3) => func (target: Vec3) =>
  if edges.length == 0 or not (is_finite boost) or boost <= 0.0:
    return target
  let at = math.vec3 start.x 0.0 start.z
  let goal = reachable ground (math.vec3 target.x 0.0 target.z)
  let kept = #[edge | edge <- edges, line_clear ground edge.start edge.end]
  if kept.length == 0:
    return target
  let nodes = array.generate (kept.length * 2) (func index =>
    let edge = kept[index / 2]
    return if index % 2 == 0 then edge.start else edge.end)
  let costs = array.generate nodes.length (func _ => 1000000.0)
  let waypoints = array.generate nodes.length (func _ => goal)
  let visited = array.generate nodes.length (func _ => false)
  for index in 0 .. nodes.length:
    let entry = closest kept[index / 2] at
    if line_clear ground at entry:
      costs[index] := (entry - at).length +(nodes[index] - entry).length / boost
      waypoints[index] := nodes[index]
      if (entry - at).length > 0.2:
        waypoints[index] := entry
  for 0 .. nodes.length:
    let chosen = $Nothing
    let least = 1000000.0
    for index in 0 .. nodes.length:
      if not visited[index] and costs[index] < least:
        least := costs[index]
        chosen := $Some index
    let $Some current = chosen else:
      break
    visited[current] := true
    for other in 0 .. nodes.length:
      let apart = (nodes[other] - nodes[current]).length
      if not visited[other] and (current / 2 == other / 2 or apart < 0.6) and line_clear ground nodes[current] nodes[other]:
        let cost = least + apart / boost
        if cost < costs[other]:
          costs[other] := cost
          waypoints[other] := waypoints[current]
          if (waypoints[current] - at).length <= 0.25:
            waypoints[other] := nodes[other]
  let best = (goal - at).length * 1.05
  let waypoint = target
  for index in 0 .. nodes.length:
    let exit = closest kept[index / 2] goal
    if line_clear ground exit goal:
      let cost = costs[index] +(exit - nodes[index]).length / boost +(goal - exit).length
      if cost < best:
        best := cost
        waypoint := target
        if (exit - at).length > 0.25:
          waypoint := exit
        if (waypoints[index] - at).length > 0.25:
          waypoint := waypoints[index]
  return waypoint

// (x, z) moved just clear of the first obstacle it is in: back within the
// ground's radius, out from a round's middle, or out of a box's nearest side.
// Rounds come first, then boxes, each in order.
func push_out (ground: Read) => func (x: F32) => func (z: F32) =>
  if not (is_finite x and is_finite z):
    return (x, z)
  let r2 = x * x + z * z
  if not (is_finite r2) or r2 > ground.radius * ground.radius:
    return within (max 0.0 (ground.radius - 0.05)) x z
  let (first_slot, last_slot) = cell ground.cells x z
  let items = ground.cells.items
  let shapes = ground.shapes
  let count = ground.rounds.length
  for slot in first_slot .. last_slot:
    let o = slot * 4
    let first = shapes[o]
    let second = shapes[o + 1]
    let third = shapes[o + 2]
    let fourth = shapes[o + 3]
    if items[slot] < count:
      let dx = x - first
      let dz = z - second
      let apart = sqrt (dx * dx + dz * dz)
      if apart < third:
        let out = third + 0.05
        if apart < 0.001:
          return (first + out, second)
        return (first + dx / apart * out, second + dz / apart * out)
    else:
      if logic.both (logic.both (x > first) (x < second)) (logic.both (z > third) (z < fourth)):
        let to_left = x - first
        let to_right = second - x
        let to_front = z - third
        let to_back = fourth - z
        let least = min (min to_left to_right) (min to_front to_back)
        if least == to_left:
          return (first - 0.05, z)
        if least == to_right:
          return (second + 0.05, z)
        if least == to_front:
          return (x, third - 0.05)
        return (x, fourth + 0.05)
  return (x, z)

// Where an agent could stand nearest `point`: there if it is clear, or else
// pushed clear of what is in the way, in a few pushes if one lands it in
// something else.
func reachable (ground: Read) => func (point: Vec3) =>
  let x = point.x
  let z = point.z
  for 0 .. 6:
    if clear ground x z:
      return math.vec3 x point.y z
    let (moved_x, moved_z) = push_out ground x z
    x := moved_x
    z := moved_z
  return math.vec3 x point.y z

// How an agent moves in one step, as its place (x, z) and its heading (a yaw
// about the vertical, 0 facing +z).
type Step is data = $Step { x: F32, z: F32, yaw: F32, moved: F32 }

// The ways an agent swerves to get round something, tried in turn.
const detours = #[0.0, 0.7, -0.7, 1.4, -1.4, 2.1, -2.1]

// One step of an agent at (x, z) heading `yaw` toward `target`: it turns at
// most `turn` radians toward it and goes at most `stride` (no further than
// the target), swerving by the first of `detours` that keeps it clear. When
// something has come to stand where it is, it walks out of that first.
// Nothing when every way is blocked.
func step (ground: Read) => func (x: F32) => func (z: F32) => func (yaw: F32) => func (target: Vec3) => func (turn: F32) => func (stride: F32) =>
  if not (is_finite x and is_finite z and is_finite yaw and math.finite3 target and is_finite turn and is_finite stride) or turn < 0.0 or stride < 0.0:
    return $Nothing
  if not (clear ground x z):
    let (out_x, out_z) = push_out ground x z
    let away_x = out_x - x
    let away_z = out_z - z
    let apart = max 0.0001 (sqrt (away_x * away_x + away_z * away_z))
    let going = min stride apart
    return $Some $Step { x: x + away_x / apart * going, z: z + away_z / apart * going, yaw: math.atan2 away_x away_z, moved: going }
  let dx = target.x - x
  let dz = target.z - z
  let distance = sqrt (dx * dx + dz * dz)
  let difference = wrap tau (math.atan2 dx dz - yaw + pi) - pi
  let heading = yaw + clamp (-turn) turn difference
  // Ease forward motion while turning. Stopping before the projected
  // target lets the heading catch up instead of orbiting around it.
  // Facing away turns in place; aligned travel keeps its full stride.
  let forward = max 0.0 (cos (difference - clamp (-turn) turn difference))
  let going = if forward > 0.0 then (if is_finite distance then min stride (distance * forward * forward) else stride) else 0.0
  for detour in detours:
    let way = wrap tau (heading + detour)
    let (sine, cosine) = sin_cos way
    let next_x = x + sine * going
    let next_z = z + cosine * going
    if line_clear ground (math.vec3 x 0.0 z) (math.vec3 next_x 0.0 next_z):
      return $Some $Step { x: next_x, z: next_z, yaw: way, moved: going }
  return $Nothing
