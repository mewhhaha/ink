import * as array from "std/array"
import * as ground from "./ground"

// Explicit numeric transport for immutable continuous-navigation geometry.
// The spatial index is rebuilt and never accepted from an untrusted worker.
// Coordinates are limited so downstream squared distances remain finite.
const most_shapes: U32 = 1024
const extent = 1000000.0
func encode (source: ground.Read) =>
  let out = array.fill (4 + source.boxes.length * 4 + source.rounds.length * 3) 0.0
  out[0] := 1.0
  out[1] := source.radius
  out[2] := from source.boxes.length
  out[3] := from source.rounds.length
  for index in 0 .. source.boxes.length:
    let box = source.boxes[index]
    let at = 4 + index * 4
    out[at] := box.left
    out[at + 1] := box.right
    out[at + 2] := box.front
    out[at + 3] := box.back
  let start = 4 + source.boxes.length * 4
  for index in 0 .. source.rounds.length:
    let round = source.rounds[index]
    let at = start + index * 3
    out[at] := round.x
    out[at + 1] := round.z
    out[at + 2] := round.radius
  return out
func decode_into (storage: own ground.Storage) -> (values: #[F32]) : (Maybe ground.Stored, ground.Storage) =>
  if values.length < 4 or values.length > 4 + most_shapes * 4 or values[0] != 1.0:
    return ($Nothing, storage)
  for value in values:
    if not (is_finite value) or abs value > extent:
      return ($Nothing, storage)
  if values[2] < 0.0 or values[3] < 0.0 or values[2] + values[3] > U32.to_f32 most_shapes or floor values[2] != values[2] or floor values[3] != values[3]:
    return ($Nothing, storage)
  let boxes = F32.to_u32 values[2]
  let rounds = F32.to_u32 values[3]
  if values.length != 4 + boxes * 4 + rounds * 3:
    return ($Nothing, storage)
  let standing = array.generate boxes (func index =>
    let at = 4 + index * 4
    return $ground.Box { left: values[at], right: values[at + 1], front: values[at + 2], back: values[at + 3] })
  let start = 4 + boxes * 4
  let circular = array.generate rounds (func index =>
    let at = start + index * 3
    return $ground.Round { x: values[at], z: values[at + 1], radius: values[at + 2] })
  return ground.make_into storage (&standing[0..standing.length]) (&circular[0..circular.length]) values[1]
