// A lazy binary min-heap of (key, tie, id) rows in three parallel pools. Entries
// are never decreased; a stale duplicate is skipped by the caller when popped.
// Order is smaller key, then larger tie (more progress), then smaller id, so
// every search that uses it breaks ties deterministically.
type Heap is data = $Heap { keys: #[~F32], ties: #[~F32], ids: #[~U32] }

func before (key: F32) -> (tie: F32) -> (id: U32) -> (other_key: F32) -> (other_tie: F32) -> (other_id: U32) =>
  if key != other_key:
    return key < other_key
  if tie != other_tie:
    return tie > other_tie
  return id < other_id

func clear (heap: own Heap) : Heap =>
  @storage.truncate heap.keys 0
  @storage.truncate heap.ties 0
  @storage.truncate heap.ids 0
  return heap

func push (heap: own Heap) -> (key: F32) -> (tie: F32) -> (id: U32) : Heap =>
  let k = heap.ids.length
  @storage.push heap.keys key
  @storage.push heap.ties tie
  @storage.push heap.ids id
  for 0 .. 32:
    if k == 0:
      break
    let parent = (k - 1) / 2
    if not (before key tie id heap.keys[parent] heap.ties[parent] heap.ids[parent]):
      break
    heap.keys[k] := heap.keys[parent]
    heap.ties[k] := heap.ties[parent]
    heap.ids[k] := heap.ids[parent]
    heap.keys[parent] := key
    heap.ties[parent] := tie
    heap.ids[parent] := id
    k := parent
  return heap

// The least row's id; the heap must not be empty. Returns the successor heap.
func top (heap: Heap) : U32 => heap.ids[0]

func pop (heap: own Heap) : Heap =>
  let last = heap.ids.length - 1
  let key = heap.keys[last]
  let tie = heap.ties[last]
  let id = heap.ids[last]
  @storage.truncate heap.keys last
  @storage.truncate heap.ties last
  @storage.truncate heap.ids last
  if last == 0:
    return heap
  heap.keys[0] := key
  heap.ties[0] := tie
  heap.ids[0] := id
  let k = 0
  for 0 .. 32:
    let left = k * 2 + 1
    if left >= last:
      break
    let child = left
    if left + 1 < last and before heap.keys[left + 1] heap.ties[left + 1] heap.ids[left + 1] heap.keys[left] heap.ties[left] heap.ids[left]:
      child := left + 1
    if not (before heap.keys[child] heap.ties[child] heap.ids[child] key tie id):
      break
    heap.keys[k] := heap.keys[child]
    heap.ties[k] := heap.ties[child]
    heap.ids[k] := heap.ids[child]
    heap.keys[child] := key
    heap.ties[child] := tie
    heap.ids[child] := id
    k := child
  return heap
