//! A lazy binary min-heap of (key, tie, id) rows in three parallel pools. Entries
//! are never decreased; a stale duplicate is skipped by the caller when popped.
//! Order is smaller key, then larger tie (more progress), then smaller id, so
//! every search that uses it breaks ties deterministically.
//!
//! Key items: [`Heap`], [`before`], [`clear`], [`push`], [`top`].

type Heap is data = $Heap { keys: #[F32], ties: #[F32], ids: #[U32] }

func before (key: F32) -> (tie: F32) -> (id: U32) -> (other_key: F32) -> (other_tie: F32) -> (other_id: U32) =>
  if key != other_key:
    return key < other_key
  if tie != other_tie:
    return tie > other_tie
  return id < other_id

func clear (heap: own Heap) : Heap =>
  @storage.truncate heap.keys 0
  @storage.truncate heap.ties 0
  @storage.truncate heap.ids 0
  return heap

func push (heap: own Heap) -> (key: F32) -> (tie: F32) -> (id: U32) : Heap =>
  if heap.keys.length != heap.ids.length or heap.ties.length != heap.ids.length:
    return panic "navigation heap lanes have mismatched lengths"
  let k = heap.ids.length
  @storage.push heap.keys key
  @storage.push heap.ties tie
  @storage.push heap.ids id
  for 0 .. 32:
    if k == 0:
      break
    let parent = (k - 1) / 2
    let pk = heap.keys[parent]
    let pt = heap.ties[parent]
    let pi = heap.ids[parent]
    if not (before key tie id pk pt pi):
      break
    heap.keys[k] := pk
    heap.ties[k] := pt
    heap.ids[k] := pi
    k := parent
  heap.keys[k] := key
  heap.ties[k] := tie
  heap.ids[k] := id
  return heap

// The least row's id; the heap must not be empty.
func top (heap: Heap) : U32 =>
  if heap.ids.length == 0 or heap.keys.length != heap.ids.length or heap.ties.length != heap.ids.length:
    return panic "navigation heap is empty or malformed"
  return heap.ids[0]

func pop (heap: own Heap) : Heap =>
  if heap.ids.length == 0 or heap.keys.length != heap.ids.length or heap.ties.length != heap.ids.length:
    return heap
  let last = heap.ids.length - 1
  let key = heap.keys[last]
  let tie = heap.ties[last]
  let id = heap.ids[last]
  @storage.truncate heap.keys last
  @storage.truncate heap.ties last
  @storage.truncate heap.ids last
  if last == 0:
    return heap
  let k = 0
  for 0 .. 32:
    let left = k * 2 + 1
    if left >= last:
      break
    let child = left
    let ck = heap.keys[left]
    let ct = heap.ties[left]
    let ci = heap.ids[left]
    let right = left + 1
    if right < last:
      let rk = heap.keys[right]
      let rt = heap.ties[right]
      let ri = heap.ids[right]
      if before rk rt ri ck ct ci:
        child := right
        ck := rk
        ct := rt
        ci := ri
    if not (before ck ct ci key tie id):
      break
    heap.keys[k] := ck
    heap.ties[k] := ct
    heap.ids[k] := ci
    k := child
  heap.keys[k] := key
  heap.ties[k] := tie
  heap.ids[k] := id
  return heap

// The least row's key; the heap must not be empty.
func top_key (heap: Heap) : F32 =>
  if heap.ids.length == 0 or heap.keys.length != heap.ids.length or heap.ties.length != heap.ids.length:
    return panic "navigation heap is empty or malformed"
  return heap.keys[0]
