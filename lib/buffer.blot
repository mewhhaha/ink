// A named growable owner, not a persistent collection of shared chunks.
// Element payloads are fixed-layout rows; variable data uses caller-owned
// pools plus spans/borrowed views/links, never owning array fields.
type Buffer a = #[a]
func empty () : Buffer a => #[]
func append (values: #[a]) -> (buffer: own Buffer a) : Buffer a =>
  if values.length > 0xFFFFFFFF - buffer.length:
    return panic "buffer length overflows"
  let count = values.length
  for i in 0 .. count:
    @storage.push buffer values[i]
  return buffer
func push value -> (buffer: own Buffer a) : Buffer a =>
  @storage.push buffer value
  return buffer
func count (buffer: Buffer a) => buffer.length
func view (buffer: Buffer a) => &buffer[0..buffer.length]
func finish (buffer: Buffer a) => copy buffer
func clear (buffer: own Buffer a) : Buffer a =>
  @storage.truncate buffer 0
  return buffer
