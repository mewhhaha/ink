// A named growable owner, not a persistent collection of shared chunks.
// Element payloads are fixed-layout rows; variable data uses caller-owned
// pools plus spans/borrowed views/links, never owning array fields.
type Buffer a = ResizeArray a
func empty () : Buffer a => return #[]
func append (values: Array a) -> (buffer: Buffer a) => return do:
  if values.length > 0xFFFFFFFF - buffer.length:
    return @panic "buffer length overflows"
  // Capture the source length: appending an alias must not extend iteration.
  let count = values.length
  for i in 0 .. count:
    @storage.push buffer values[i]
func push value -> (buffer: Buffer a) => return @storage.push buffer value
func count (buffer: Buffer a) => return buffer.length
func view (buffer: Buffer a) => return &buffer[0..buffer.length]
func finish (buffer: Buffer a) => return @storage.freeze (@storage.copy buffer)
func clear (buffer: Buffer a) => return @storage.truncate buffer 0
