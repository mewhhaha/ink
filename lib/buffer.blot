import * as array from "std/array"
import * as pages from "./pages"

// Chunked persistent construction. Append a complete caller batch without
// copying previous payloads; finish materializes one contiguous output.
type Buffer a is data = #Buffer { count: U32, chunks: pages.Pages (Array a) }
const empty = fn () => #Buffer { count: 0, chunks: pages.from #[] }
const append = fn (values: Array a) (before: Buffer a) => do:
  if values.length == 0:
    return before
  if values.length > 0xFFFFFFFF - before.count:
    return @panic "buffer length overflows"
  return #Buffer { count: before.count + values.length, chunks: pages.push values before.chunks }
const push = fn value before => append #[value] before
const finish = fn (buffer: Buffer a) => array.flatten (pages.flatten buffer.chunks)
const count = fn (buffer: Buffer a) => buffer.count
