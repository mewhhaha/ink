import * as camera from "./view"
import * as input from "./input"
import * as lanes from "./lanes"
import * as math from "./math"
import * as transform from "./transform"

// Marks entities that pointer picking can hit.
type Pickable is data = $Pickable

// The ray under the pointer.
const pointer_ray = func (view: camera.Camera) -> (lens: camera.Lens) -> (controls: input.Input) -> width -> height => return
  camera.viewport_ray lens view controls.x controls.y width height

// Distance along `ray` to a pose's -1..1 box, the extent of the bundled cube
// mesh, when it hits.
const hit = func (ray: math.Ray) => return func (pose: transform.Pose3) => return
  math.ray_box ray pose.position pose.rotation pose.scale

const nearest = func poses => return func markers => return func ray => return do:
  let best = $Nothing
  for index in 0 .. poses.length:
    let distance = case poses[index], (if index < markers.length then markers[index] else $Nothing) of
      $Some pose, $Some _ => hit ray pose
      _, _ => $Nothing
    best := case distance, self of
      $Some found, $Some (_, closest) if found >= closest => self
      $Some found, _ => $Some (index, found)
      $Nothing, _ => self
  return case best of
    $Some (selected, _) => $Some selected
    $Nothing => $Nothing

// The nearest pickable entity along `ray`.
const pick = func poses -> markers -> ray => return nearest poses markers ray

// Ground point under the pointer on the plane y = height, unless the ray runs
// parallel to it.
const ground = func (ray: math.Ray) => return func height => return math.ray_plane_y ray.origin ray.direction height

const encode = func (marker: Pickable) => return #[]

const decode = func (values: Array F32) => return do:
  use lanes.exact values 0
  return $Pickable

const codec = $lanes.Codec { key: 10, version: 1, encode, decode, migrate: lanes.no_migration }

// The application's static schema owns Pickable and transform pool declarations.
