import * as app from "./app"
import * as camera from "./view"
import * as ecs from "./ecs"
import * as input from "./input"
import * as lanes from "./lanes"
import * as math from "./math"
import * as transform from "./transform"

// Marks entities that pointer picking can hit.
type Pickable is data = #Pickable

// The ray under the pointer.
const pointer_ray = fn width => fn height => do:
  use view <- ecs.get #camera.Camera
  use controls <- ecs.get #input.Input
  use lens <- ecs.get #camera.Lens
  return camera.viewport_ray lens view controls.x controls.y width height

// Distance along `ray` to a pose's -1..1 box, the extent of the bundled cube
// mesh, when it hits.
const hit = fn (ray: math.Ray) => fn (pose: transform.Pose3) =>
  math.ray_box ray pose.position pose.rotation pose.scale

const nearest = fn poses => fn markers => fn ray => do:
  let best = #Nothing
  for index in 0 .. poses.length:
    let distance = case poses[index], Maybe.flatten (markers.get(index)) of
      #Some pose, #Some _ => hit ray pose
      _, _ => #Nothing
    best := case distance, self of
      #Some found, #Some (_, closest) if found >= closest => self
      #Some found, _ => #Some (index, found)
      #Nothing, _ => self
  return case best of
    #Some (selected, _) => #Some selected
    #Nothing => #Nothing

// The nearest pickable entity along `ray`.
const pick = fn ray => do:
  use poses <- ecs.components #transform.Pose3
  use markers <- ecs.components (fn () => #Pickable)
  return nearest poses markers ray

// Ground point under the pointer on the plane y = height, unless the ray runs
// parallel to it.
const ground = fn (ray: math.Ray) => fn height => math.ray_plane_y ray.origin ray.direction height

const encode = fn (marker: Pickable) => #[]

const decode = fn (values: Array F32) => do:
  use lanes.exact values 0
  return #Pickable

const codec = #lanes.Codec { key: 10, version: 1, encode, decode, migrate: lanes.no_migration }

// Requires transform.plugin, input.plugin and camera.plugin.
const plugin = fn builder => app.register_component codec #Pickable builder
