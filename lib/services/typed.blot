import * as services from "../services"

// Known method policies specialize at calls. Arguments are local results whose
// numeric payload is a borrowed view into a separate caller-owned input pool.
type Arguments is data = $Arguments {a: F32, b: F32, c: F32, d: F32, values: &[F32]}
type Method [input, output] is data = $Method {service: U32, operation: U32, encode: input -> Arguments, decode: services.Services -> services.Answer -> Maybe output}
type Pending output is data = $Pending {id: U32, service: U32, operation: U32}
type Response output is data = $Received output | $Invalid services.Answer
func id (pending: Pending output) => pending.id
func restored (method: Method [input, output]) -> (id: U32) : Pending output => $Pending {id, service: method.service, operation: method.operation}
func ask (method: Method [input, output]) -> (state: services.Services) -> (value: input) : Pending output =>
  let arguments = method.encode value
  let id = services.ask state method.service method.operation arguments.a arguments.b arguments.c arguments.d arguments.values
  return restored method id
func tell (method: Method [input, output]) -> (state: services.Services) -> (value: input) =>
  let arguments = method.encode value
  services.tell state method.service method.operation arguments.a arguments.b arguments.c arguments.d arguments.values
  return ()
func receive (method: Method [input, output]) -> (state: services.Services) -> (answer: services.Answer) : Response output => case method.decode state answer of
  $Some value => $Received value
  $Nothing => $Invalid answer
func take (method: Method [input, output]) -> (state: services.Services) -> (pending: Pending output) : Maybe (Response output) =>
  if method.service != pending.service or method.operation != pending.operation:
    return panic "Pending service belongs to another method"
  return case services.take state pending.id of
    $Some answer => $Some (receive method state answer)
    $Nothing => $Nothing
