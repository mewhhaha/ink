import * as services from "../services"

// Known method policies specialize at calls. Arguments are local results whose
// numeric payload is a borrowed view into a separate caller-owned input pool.
type Arguments is data = $Arguments {a: F32, b: F32, c: F32, d: F32, values: &[F32]}
type Method [input, output] is data = $Method {service: U32, operation: U32, encode: input -> Arguments, decode: services.Services -> services.Answer -> Maybe output}
type Pending output is data = $Pending {id: U32, service: U32, operation: U32}
type Response output is data = $Received output | $Invalid services.Answer
func id (pending: Pending output) => pending.id
func restored (method: Method [input, output]) -> (id: U32) : Pending output => $Pending {id, service: method.service, operation: method.operation}
func ask (method: Method [input, output]) -> (state: own services.Services) -> (value: input) : (Pending output, services.Services) =>
  let arguments = method.encode value
  let (id, state) = services.ask state method.service method.operation arguments.a arguments.b arguments.c arguments.d arguments.values
  return (restored method id, state)
func ask_on (method: Method [input, output]) -> (own access) -> (value: input) =>
  let arguments = method.encode value
  let (id, access) = services.ask_on access method.service method.operation arguments.a arguments.b arguments.c arguments.d arguments.values
  return (restored method id, access)
func tell (method: Method [input, output]) -> (state: own services.Services) -> (value: input) : services.Services =>
  let arguments = method.encode value
  return services.tell state method.service method.operation arguments.a arguments.b arguments.c arguments.d arguments.values
func receive (method: Method [input, output]) -> (state: services.Services) -> (answer: services.Answer) : Response output => case method.decode state answer of
  $Some value => $Received value
  $Nothing => $Invalid answer
func take (method: Method [input, output]) -> (state: own services.Services) -> (pending: Pending output) : (Maybe (Response output), services.Services) =>
  if method.service != pending.service or method.operation != pending.operation:
    return panic "Pending service belongs to another method"
  let found = case services.answer state pending.id of
    $Some answer => $Some (receive method state answer)
    $Nothing => $Nothing
  return (found, services.dismiss state pending.id)
func take_on (method: Method [input, output]) -> (own access) -> (pending: Pending output) =>
  if method.service != pending.service or method.operation != pending.operation:
    return panic "Pending service belongs to another method"
  let found = case services.answer access.services pending.id of
    $Some answer => $Some (receive method access.services answer)
    $Nothing => $Nothing
  access.services := services.dismiss self pending.id
  return (found, access)
