import { Vec3 } from "std/vector"
import * as math from "./math"
import * as camera from "./camera"
import * as color from "./color"

// Practical split scheme. Blend zero is linear, one is logarithmic.
const splits = fn (near: F32) => fn (far: F32) => fn (count: U32) => fn (blend: F32) => do:
  if near <= 0.0 || far <= near || count == 0 || Bool.not (is_finite near) || Bool.not (is_finite far) || Bool.not (is_finite blend):
    return #[]
  let log_near = color.log2 near
  let log_far = color.log2 far
  return @array.generate count (fn (i: U32) => do:
    if i + 1 == count:
      return far
    let t = U32.to_f32 (i + 1) / U32.to_f32 count
    let weight = saturate blend
    let linear = near + (far - near) * t
    let logarithmic = color.exp2 (F32.lerp log_near log_far t)
    return linear * (1.0 - weight) + logarithmic * weight)

// Fit an orthographic shadow camera to a frustum slice. A sphere bounds the
// corners, rounded radius and light-space texel snapping prevent camera pan
// shimmer. Include extra depth for off-screen casters above the receiver slice.
const fit = fn (corners: Array Vec3) => fn (direction: Vec3) => fn (resolution: U32) => fn (padding: F32) -> Maybe camera.Camera => do:
  let #Vec3 { x: dx, y: dy, z: dz } = direction
  let squared = dx * dx + dy * dy + dz * dz
  if corners.length == 0 || resolution < 2 || squared == 0.0:
    return #Nothing
  // The centre and radius run in scalars, as the vector sums would.
  let cx = 0.0
  let cy = 0.0
  let cz = 0.0
  for corner in corners:
    cx := self + corner.x
    cy := self + corner.y
    cz := self + corner.z
  let count = U32.to_f32 corners.length
  cx := self / count
  cy := self / count
  cz := self / count
  let radius = 0.0
  for corner in corners:
    let x = corner.x - cx
    let y = corner.y - cy
    let z = corner.z - cz
    radius := max radius (sqrt (x * x + y * y + z * z))
  radius := max 0.0625 (ceil (radius * 16.0) / 16.0)
  // Reserve half a texel on each side for the snapping displacement.
  // Resolution must be at least two; R >= sphere_radius + R/resolution.
  radius := self / (1.0 - 1.0 / U32.to_f32 resolution)
  let rotation = math.look_rotation direction math.up
  let #math.Quat { x: qx, y: qy, z: qz, w: qw } = rotation
  let local = math.rotate_parts (F32.neg qx) (F32.neg qy) (F32.neg qz) qw cx cy cz
  let texel = 2.0 * radius / U32.to_f32 resolution
  let target = math.rotate_parts qx qy qz qw (floor (local.x / texel + 0.5) * texel) (floor (local.y / texel + 0.5) * texel) local.z
  let depth = radius + max 0.0 padding
  // Back off along the direction, normalized as Vec3.normalized does.
  let length = sqrt squared
  if length != 0.0:
    dx := self / length
    dy := self / length
    dz := self / length
  return #Some (#camera.Camera { position: #Vec3 { x: target.x - dx * depth, y: target.y - dy * depth, z: target.z - dz * depth }, rotation,
    projection: #camera.Orthographic { height: radius * 2.0, aspect: 1.0, near: 0.0, far: depth * 2.0, reversed: #False } })
