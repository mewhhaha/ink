//! Declarative frame descriptors, caller-owned [`FrameAccess`] reuse, lighting, post-processing, and frustum [`Sight`].

import * as array from "std/array"
import { Vec2, Vec3 } from "std/vector"
import * as app from "./app"
import * as color from "./color"
import * as codec_lib from "./codec"
import * as lanes from "./lanes"
import * as math from "./math"
import * as transform from "./transform"

// Flat range into one of FrameAccess's per-frame payload pools.
type Span is data = $Span { start: U32, count: U32 }
const no_span = $Span { start: 0, count: 0 }

// Mesh and material IDs refer to the caller's asset catalog.
type Appearance is data = $Appearance { mesh: U32, material: U32 }
// `parameters` override the material's four instance parameters. `extra` is a
// span into FrameAccess.vectors for shader-specific vectors after the parameters.
type Draw is data = $Draw { mesh: U32, material: U32, matrix: math.Mat4, parameters: Maybe math.Vec4, extra: Span }

// A convex solid: the points p with dot(normal, p) <= distance for every face.
// The host meshes it with world-aligned texture coordinates.
type Face is data = $Face { normal: Vec3, distance: F32, material: U32 }
type Solid is data = $Solid { faces: Span }
// Clear RGBA, ambient RGB, and one directional light: the direction its rays
// travel and its RGB color.
type Lighting is data = $Lighting { clear: math.Vec4, ambient: Vec3, direction: Vec3, color: Vec3 }
// Linear RGB intensity falls off with distance and reaches zero at radius. A
// spot light also points along the unit `direction`: full strength inside the
// cone whose half-angle has cosine `inner`, none beyond the one with cosine
// `outer`. An `outer` of -1.0 is a point light, which ignores `direction` and
// `inner`. `shadow` asks the host to cast shadows from the light; it admits
// the player's allowance of them, nearest first, and `id` breaks ties between
// equally near lights and names the light's shadow map between frames, so keep
// it stable (and distinct) for the same light.
type PointLight is data = $PointLight {
  position: Vec3, radius: F32, intensity: Vec3,
  direction: Vec3, inner: F32, outer: F32, shadow: Bool, id: U32,
}

// A light shining equally in every direction, casting no shadow.
func point_light (position: Vec3) => func (radius: F32) => func (intensity: Vec3) => return
  $PointLight { position, radius, intensity, direction: math.up, inner: 1.0, outer: -1.0, shadow: false, id: 0 }

// A cone of light from `position` along `direction` (any length), full within
// the half-angle `inner` and fading to none at `outer`, both in radians from 0
// to pi. It casts no shadow; set `shadow` and `id` to ask for one.
func spot_light (position: Vec3) => func (direction: Vec3) => func (radius: F32) => func (intensity: Vec3) => func (inner: F32) => func (outer: F32) => return
  $PointLight { position, radius, intensity, direction: direction.normalized, inner: cos inner, outer: cos outer, shadow: false, id: 0 }
// A decal lays a material's texture onto the surfaces inside its box, the
// cube -1..1 under `matrix`, projected along the box's y axis, on materials
// that take decals; `opacity` fades it.
type Decal is data = $Decal { material: U32, matrix: math.Mat4, opacity: F32 }
// A rectangle on the screen, in pixels from its top left, drawn by its
// material's sprite shader: an image's texture between (u0, v0) and (u1, v1)
// tinted by `color`, or a font's distance field. `parameters`
// are the shader's to read. Sprites draw over everything else, in order.
type Sprite is data = $Sprite {
  x: F32, y: F32, width: F32, height: F32,
  u0: F32, v0: F32, u1: F32, v1: F32,
  color: math.Vec4, material: U32, parameters: math.Vec4,
}
// A small 3D view drawn over the screen in the rectangle at (x, y), e.g. a
// menu's model preview, lit by its own `light` (its clear color unused),
// without shadows. `after_sprites` places it after that many frame sprites,
// so complete UI layers can include both text and model previews.
type Inset is data = $Inset {
  x: F32, y: F32, width: F32, height: F32, pixel_size: F32, after_sprites: U32,
  view: math.Mat4, projection: math.Mat4, light: Lighting, draws: Span,
}
// A volume of baked light probes (`ink/probes`): `nx` x `ny` x `nz` probes
// `spacing` apart from `origin`, `values` their `probes.stride` floats each
// (an empty view keeps the probes the host already holds for this
// `revision`, which is how a volume costs nothing between bakes). Revisions
// count up to 16,777,215; the host uses a volume only while the revision
// it holds matches.
type ProbeSet is data = $ProbeSet { origin: Vec3, spacing: F32, nx: U32, ny: U32, nz: U32, revision: U32, values: &[F32] }
// Flat descriptor stored in `Settings.probes`; values live in `FrameAccess.probe_values`.
type ProbeGrid is data = $ProbeGrid { origin: Vec3, spacing: F32, nx: U32, ny: U32, nz: U32, revision: U32, values: Span }
// A local reflection probe: the host draws the scene from `position` as a cube
// of six faces when the probe's `revision` changes (or `capture` rises from
// false to true), a few faces a frame (`Settings.reflection_budget`), keeps it
// prefiltered under `id`, and glossy surfaces inside the influence box (the
// box of half size `extent` round `centre`) reflect it. Inside the box's faces
// the probe fades in over `blend` metres (0 for a hard edge), and where boxes
// overlap the higher `priority` takes the reflection first while equal ones
// share it by their weights (`ink/reflections` is the reference). The cube is
// looked up as if its surroundings were the box of half size `parallax_extent`
// round `parallax_centre` (box projection: a room's walls where its walls
// are); a half size of 0 or less on any axis looks it up as if infinitely far.
// `far` is how far the capture sees. The influence box must include the
// surfaces that should reflect it, floors included (a floor on a face of the
// box is outside it). At most 64 probes a frame; the host keeps 8 cubes.
type ReflectionProbe is data = $ReflectionProbe {
  id: U32, revision: U32, priority: U32, capture: Bool,
  position: Vec3, centre: Vec3, extent: Vec3, blend: F32,
  parallax_centre: Vec3, parallax_extent: Vec3, far: F32,
}
// A frame's reflection probes, borrowed from an owner the game keeps.
type ReflectionProbes is data = $ReflectionProbes { list: &[ReflectionProbe] }

// A probe in the room `centre` +- `half`, captured from its middle, whose
// influence and parallax boxes are the room's.
func room_probe (id: U32) => func (revision: U32) => func (centre: Vec3) => func (half: Vec3) => return
  $ReflectionProbe { id, revision, priority: 0, capture: false, position: centre, centre, extent: half, blend: 0.0,
    parallax_centre: centre, parallax_extent: half, far: 2.0 * half.length }
// The participating medium: a mist beyond `radius` of the origin, whose
// extinction `density` per world unit falls off exponentially with height above
// y = 0 over `height`, drawn through a froxel volume out to `distance` ahead
// of the camera (lit by the sun, the lights and the sky, with shafts and
// shadows; `ink/volumetrics` is the reference) and analytically beyond it;
// density 0 and no fog volumes for none. `edge` is how far past `radius` the
// mist takes to rise from nothing to its full density, smoothly (0 for a hard
// edge). `distance` 0 draws the mist analytically alone, with no local
// volumes. `albedo` is the share of light the mist scatters, by channel, and
// `anisotropy` the Henyey-Greenstein g (-0.95 to 0.95) of its phase function:
// positive scatters toward where the light is going (shafts toward the sun),
// negative back toward it, 0 evenly. `sun` scales the sun's in-scattering (0
// for none) and `ambient` the sky's and the probes'; `sky` (0 to 1) is how far
// the ambient colour is the sky's own in the direction looked rather than its
// mean light all round (1 fades distant objects into the sky behind them).
// `noise` (0 to 1) is how much a 3D value noise varies the global mist's
// density (0 uniform, 1 from nothing to twice the mean; the mean stays what it
// was), `noise_scale` the size in world units of its coarsest cell (finer
// octaves follow, as many as the volumetrics tier allows) and `drift` how far
// the game has carried it along x, y and z (wind times time): the same drift
// draws the same mist.
type Fog is data = $Fog {
  radius: F32, density: F32, height: F32, edge: F32, distance: F32,
  albedo: Vec3, anisotropy: F32, sun: F32, ambient: F32, sky: F32,
  noise: F32, noise_scale: F32, drift: Vec3,
}
// A local fog volume: an axis-aligned box (`shape` 0) or ellipsoid (1) of the
// world round `centre`, with half sizes `extent` (an ellipsoid's semi-axes),
// whose medium adds to the global mist's inside it, when `Fog.distance` is above 0 and
// the volumetrics tier is on. `density` is its extinction at full strength per
// world unit, `albedo` the share of light it scatters by channel (the rest it
// absorbs) and `emission` the light it gives out, as radiance per unit of
// density (a thicker volume glows more; 0 for none). `falloff` is the share of
// the half size, from the edge in, over which the density rises smoothly from
// nothing to full (0 to 1; 0 for a hard edge). At most 32 volumes a frame.
type FogVolume is data = $FogVolume {
  shape: U32, centre: Vec3, extent: Vec3, density: F32, albedo: Vec3, emission: Vec3, falloff: F32,
}
// A frame's local fog volumes, borrowed from an owner the game keeps.
type FogVolumes is data = $FogVolumes { list: &[FogVolume] }
// Clouds project soft shadows onto world surfaces: `cover`
// how much of the sky they cover, 0 for none to 1 overcast, and `drift` how
// far the wind has carried them, in units along x and z (`y`).
type Clouds is data = $Clouds { cover: F32, drift: Vec2 }
// The reach and softness of the sun's shadows; the player's quality choice
// decides how many cascades and what filtering they get (`graphics.shadow`).
// `distance` is how far ahead of the camera, along its view, shadows reach.
// `softness` is the penumbra's width per unit of distance between a shadow's
// caster and receiver, the sun's size seen from the ground (0 for hard edges).
// `contact_length` is how far toward the sun, in world units, fine contact
// shadows reach from a surface, where the quality allows them.
type ShadowSettings is data = $ShadowSettings { distance: F32, softness: F32, contact_length: F32 }
// How the camera exposes the frame. With `auto` off, `compensation` is a fixed
// exposure in stops (a game's brightness option belongs here; 0 leaves the
// light as it is). With `auto` on, the host meters the scene on the GPU and
// the exposure adapts toward the one that brings the trimmed average of the
// light to `target` (0.18, middle grey) plus `compensation`: the average is of
// the log2 luminance of the pixels between the `low` and `high` percentiles
// (shares of the picture, so the darkest and brightest are ignored), `centre`
// 0 to 1 weighs the middle of the picture more than its edges, and the
// histogram tells luminances apart from `range_low` to `range_high` stops of
// log2 (1 is SDR white). The exposure stays within `min` and `max` stops and
// moves toward the goal by 1 - exp(-rate * dt) of the distance each frame, at
// the `brighten` rate (per second) when the scene darkens and `darken` when it
// brightens, so frame rate does not change the curve. `dt` is the game's
// seconds since the last frame: the host's adapter sets it (0 while the game
// is paused, which holds the exposure). `cut` jumps to the goal this frame, for
// a camera cut or a teleport; the adapter also sets it for the first frame
// after a restore (`app.invalidate`), so an earlier moment is not shown with
// the exposure of the one it replaced. The exposure itself stays on the GPU,
// never read back to the game. Reset every frame by `begin_frame`.
type Exposure is data = $Exposure {
  auto: Bool, compensation: F32, min: F32, max: F32, brighten: F32, darken: F32,
  low: F32, high: F32, centre: F32, range_low: F32, range_high: F32, target: F32,
  dt: F32, cut: Bool,
}
// A fixed exposure of nothing.
const fixed_exposure = $Exposure {
  auto: false, compensation: 0.0, min: (-6.0), max: 6.0, brighten: 3.0, darken: 1.0,
  low: 0.1, high: 0.9, centre: 0.0, range_low: (-10.0), range_high: 6.0, target: 0.18,
  dt: 0.0, cut: false,
}
// Auto exposure with the usual limits and speeds: brightens with a time
// constant of a third of a second and darkens over a second.
const auto_exposure = $Exposure {
  auto: true, compensation: 0.0, min: (-6.0), max: 6.0, brighten: 3.0, darken: 1.0,
  low: 0.1, high: 0.9, centre: 0.0, range_low: (-10.0), range_high: 6.0, target: 0.18,
  dt: 0.0, cut: false,
}
// `aberration` splits the colors of the surfaces whose material asks for it:
// red moves that far, in screen heights across and down, and blue as far the
// other way. `blur` smears the whole picture toward the middle of the screen,
// as speed does, over that share of the way there (0 for none, at most 0.5).
// The host's last pass draws both when screen effects are on.
// `fields` are patches of the values the host keeps for some materials (see
// Field). `poses` pose skinned draws, and `emitters` give off particles.
// `occlusion` allows ambient occlusion for this frame, subject to the player's
// quality preference. Disable it for scenes that supply their own shading.
// `render_scale` caps the player's scene resolution scale, clamped to 0.5..2.0.
// Sprites and UI retain the screen's resolution; preferences are unchanged.
// `show_captions` opts into host sound captions, according to the game's preferences.
// `loading` draws the sprites above the startup cover while scene assets load.
// Optional application publications. Hosts interpret declared tags; core Ink
// carries their numeric payloads without assigning a format or side effect.
type Extension is data = $Extension { tag: U32, values: Span }
// Caller-owned retained draws. Hosts insert these at retained_after in the immediate draws.
// A replacement world sends a reset before its first delta.
type Instance is data = $Instance { id: U32, order: U32, draw: Draw }
type Instances is data = $Instances { reset: Bool, updates: &[Instance], removed: &[U32] }

type MotionBlur is data = $MotionBlur { strength: F32, max_radius: F32, samples: U32 }
const no_motion_blur = $MotionBlur { strength: 0.0, max_radius: 0.05, samples: 8 }

type DepthOfField is data = $DepthOfField { focus_distance: F32, focus_range: F32, aperture: F32, max_blur: F32 }
const no_dof = $DepthOfField { focus_distance: 0.0, focus_range: 0.0, aperture: 0.0, max_blur: 0.025 }

// Shared audio reverb room RT60 decay (seconds, 0 = default 1.5 s) and
// high-frequency damping in 0..1 (0 = default curve).
type ReverbRoom is data = $ReverbRoom { decay: F32, damping: F32 }
const default_reverb = $ReverbRoom { decay: 0.0, damping: 0.0 }

// Dual-motor gamepad rumble / haptic command for pad `pad`.
type Haptic is data = $Haptic { pad: U32, low: F32, high: F32, duration: F32 }

// Previous-frame model transform for a moving scene draw, feeding per-object
// screen-space velocity vectors for TAA reprojection and motion blur.
type Motion is data = $Motion { draw: U32, previous: math.Mat4 }

// Filmic display operator (`color.tonemap_*_mode`) and post-processing polish
// parameters (`sharpness`, `grain`, `flare`, `outline_strength`), kept compact
// beside `color.Grade` for Blot's per-field array-update lane budget.
type PostLook is data = $PostLook {
  tonemap: U32, sharpness: F32, grain: F32, flare: F32, outline_strength: F32,
}
const neutral_look = $PostLook {
  tonemap: 0, sharpness: 0.0, grain: 0.0, flare: 0.0, outline_strength: 0.0,
}

// Per-frame optional render pipeline toggles (`oit`, `physical_sky`, `upscale`,
// hardware/compute `ray_tracing` tier 0..2, and `ddgi` diffuse probe volume).
type Features is data = $Features {
  oit: Bool, physical_sky: Bool, upscale: Bool, ray_tracing: U32, ddgi: Bool,
}
const default_features = $Features {
  oit: false, physical_sky: false, upscale: false, ray_tracing: 0, ddgi: false,
}

// Linearly Transformed Cosine (LTC) area lights: rectangle (0), disk (1), tube (2).
const area_light_rect: U32 = 0
const area_light_disk: U32 = 1
const area_light_tube: U32 = 2
type AreaLight is data = $AreaLight {
  kind: U32, position: Vec3, right: Vec3, up: Vec3, color: Vec3,
  intensity: F32, width: F32, height: F32, range: F32,
  cookie_material: U32, two_sided: Bool,
}

// Deferred PBR box decal affecting albedo, normal, roughness, metallic and emissive.
type PbrDecal is data = $PbrDecal {
  material: U32, matrix: math.Mat4, albedo: math.Vec4,
  normal_strength: F32, roughness: F32, metallic: F32,
  emissive_strength: F32, fade: F32,
}

// Secondary camera rendered into a material texture (`split_screen = false`) or
// composited directly into a normalized screen viewport (`split_screen = true`).
type CameraTarget is data = $CameraTarget {
  material: U32, width: U32, height: U32,
  viewport_x: F32, viewport_y: F32, viewport_w: F32, viewport_h: F32,
  split_screen: Bool, view: math.Mat4, projection: math.Mat4,
}

// Declarative playback state for a GPU-uploaded material video stream.
type VideoStream is data = $VideoStream {
  material: U32, time: F32, playing: Bool, looping: Bool, speed: F32,
}

type RenderFrame is data = $RenderFrame {
  probes: Maybe ProbeSet,
  reflection_probes: Maybe ReflectionProbes, reflection_budget: U32, screen_reflections: U32,
  fog_volumes: Maybe FogVolumes, volumetrics: U32,
  extensions: &[Extension],
  retained: Maybe Instances,
  retained_after: U32,
  hide_cursor: Bool, occlusion: Bool, taa: Bool, ssgi: Bool, render_scale: F32, loading: Bool, show_captions: Bool,
  view: math.Mat4, projection: math.Mat4, lighting: Lighting, shadow: ShadowSettings, fog: Fog, clouds: Clouds,
  aberration: Vec2, blur: F32, motion_blur: MotionBlur, dof: DepthOfField, reverb: ReverbRoom,
  exposure: Exposure, grade: color.Grade, cdl: color.Cdl, post_look: PostLook, features: Features,
  draws: &[Draw], solids: &[Solid], decals: &[Decal], sprites: &[Sprite], insets: &[Inset],
  lights: &[PointLight], fields: &[Field], poses: &[Pose], bone_matrices: &[BoneMatrix], morph_weights: &[MorphWeight],
  motions: &[Motion], emitters: &[Emitter], ribbons: &[RibbonPoint], haptics: &[Haptic],
  area_lights: &[AreaLight], pbr_decals: &[PbrDecal], camera_targets: &[CameraTarget], video_streams: &[VideoStream],
  vectors: &[math.Vec4], faces: &[Face], inset_draws: &[Draw], field_values: &[F32], extension_values: &[F32],
}

// A layer of a skinned draw's pose: clip `clip` of the draw's mesh (in the
// order its glTF file lists them), sampled `time` seconds in (round the clip
// as often as need be), counting `weight` among the draw's layers. `inset` is
// 0 for the main scene's `draws`, or `1 + k` for `insets[k].draws`.
type Pose is data = $Pose { draw: U32, clip: U32, time: F32, weight: F32, inset: U32 }

// One explicit joint skinning matrix (world joint transform * inverse bind),
// matching `ink/animation::skin_matrices`. Overrides any clip pose on the same
// draw, or poses the draw from identity when no clip layers are declared.
type BoneMatrix is data = $BoneMatrix { inset: U32, draw: U32, joint: U32, matrix: math.Mat4 }

// One blendshape / morph target weight evaluated on the GPU before skinning.
type MorphWeight is data = $MorphWeight { inset: U32, draw: U32, target: U32, weight: F32 }

func pose (draw: U32) -> (clip: U32) -> (time: F32) -> (weight: F32) : Pose =>
  return $Pose { draw, clip, time, weight, inset: 0 }

func inset_pose (inset: U32) -> (draw: U32) -> (clip: U32) -> (time: F32) -> (weight: F32) : Pose =>
  return $Pose { draw, clip, time, weight, inset: inset + 1 }

func bone_matrix (draw: U32) -> (joint: U32) -> (matrix: math.Mat4) : BoneMatrix =>
  return $BoneMatrix { inset: 0, draw, joint, matrix }

func morph_weight (draw: U32) -> (target: U32) -> (weight: F32) : MorphWeight =>
  return $MorphWeight { inset: 0, draw, target, weight }

func motion (draw: U32) -> (previous: math.Mat4) : Motion =>
  return $Motion { draw, previous }

// Push a full joint matrix palette (e.g. from `ink/animation::skin_matrices`)
// for a scene draw (`inset == 0`) or inset draw (`inset == 1 + k`).
func push_skin_palette (inset: U32) -> (draw: U32) -> (matrices: #[math.Mat4]) -> (access: own FrameAccess) : FrameAccess =>
  for joint in 0 .. matrices.length:
    @storage.push access.bone_matrices ($BoneMatrix { inset, draw, joint, matrix: matrices[joint] })
  return access

// Particles the host simulates on the GPU from the emitter alone: `rate` a
// second are born from `time` 0 (for `duration` seconds, 0 for as long as
// frames keep it), each living `lifetime` seconds, in a ball of `radius`
// round `matrix`'s origin, with `velocity` (in the emitter's space) and a
// random one up to `spread`, under `gravity` (world space) and `drag`. Their
// width and color go from start to end over their lives, tinted by
// `material`'s color and shaped by its texture (soft dots without one).
// `seed` chooses their randomness, so the same emitter at the same time
// draws the same particles. `additive` ones add their light.
type Emitter is data = $Emitter {
  material: U32, matrix: math.Mat4, seed: U32, time: F32, duration: F32, rate: F32, lifetime: F32,
  radius: F32, velocity: Vec3, spread: F32, gravity: Vec3, drag: F32,
  size_start: F32, size_end: F32, color_start: math.Vec4, color_end: math.Vec4, additive: Bool,
  soft_depth: F32, lit: F32, flipbook_cols: U32, flipbook_rows: U32, flipbook_fps: F32,
}

// One control point along a camera-facing GPU ribbon trail (`ribbon` groups
// consecutive points into one strip; `soft_depth` fades near opaque geometry).
type RibbonPoint is data = $RibbonPoint {
  ribbon: U32, material: U32, additive: Bool, position: Vec3, width: F32, color: math.Vec4, soft_depth: F32,
}

// A patch of a field: a grid of `width` x `height` values the host keeps for
// `material`, which every draw of it reads as a texture (its shader's
// binding 3, red channel, half-float precision; read it with textureLoad).
// The patch's values, `columns` to a row, land row by row at column `x`, row
// `z`. The host keeps each value until a later patch overwrites it, so a game
// sends what changed, and every value again now and then for a frame it
// may have skipped. A field draws as zero until its values arrive; its
// draws carry no data of their own, so they can share an instanced draw.
type Field is data = $Field { material: U32, width: U32, height: U32, x: U32, z: U32, columns: U32, values: Span }


const default_lighting = $Lighting {
  clear: math.vec4 0.025 0.035 0.06 1.0,
  ambient: math.vec3 0.22 0.22 0.28,
  direction: math.vec3 (-0.4) (-1.0) (-0.3),
  color: math.vec3 0.9 0.85 0.75,
}

// The light of a studio, for small 3D views of things such as icons: from
// above, to the left and in front, whatever the time of day.
const studio = $Lighting {
  clear: math.vec4 0.0 0.0 0.0 1.0,
  ambient: math.vec3 0.45 0.46 0.52,
  direction: (math.vec3 0.45 (-0.7) (-0.55)).normalized,
  color: math.vec3 0.95 0.9 0.82,
}

// A decal of `material` lying on the surface at `point` that faces `normal`:
// a disc `radius` across reaching `depth` above and below the surface.
func lying (material: U32) => func (point: Vec3) => func (normal: Vec3) => func (radius: F32) => func (depth: F32) => func (opacity: F32) =>
  let up = normal.normalized
  let reference = math.right
  if abs up.y < 0.9:
    reference := math.up
  let side = (up.cross reference).normalized
  let ahead = side.cross up
  return $Decal { material, opacity, matrix: (math.Mat4.from_columns (math.vec4 (side.x * radius) (side.y * radius) (side.z * radius) 0.0) (math.vec4 (up.x * depth) (up.y * depth) (up.z * depth) 0.0) (math.vec4 (ahead.x * radius) (ahead.y * radius) (ahead.z * radius) 0.0) (math.vec4 point.x point.y point.z 1.0)) }

// Narrows a clip-space column to the part of the screen an inset covers:
// `sx`, `sy` scale it and `cx`, `cy` are the inset's middle in clip space.
func narrowed (sx: F32) => func (sy: F32) => func (cx: F32) => func (cy: F32) => func (column: math.Vec4) => return
  math.vec4 (sx * (column.x - cx * column.w)) (sy * (column.y - cy * column.w)) column.z column.w

// An inset of `draws` as `frame`'s camera sees them and lit as it is, cut to
// the rectangle `x`, `y`, `width`, `height` of a `screen_width` by
// `screen_height` screen: for what lies over every other inset, such as
// something held in a cursor hand.
func seen frame -> (after_sprites: U32) => func (x: F32) => func (y: F32) => func (width: F32) => func (height: F32) => func (screen_width: F32) => func (screen_height: F32) => func (draws: Span) =>
  let view: math.Mat4 = frame.view
  let projection: math.Mat4 = frame.projection
  let sx = if is_finite width and is_finite screen_width and abs width > 0.000001 then screen_width / width else 1.0
  let sy = if is_finite height and is_finite screen_height and abs height > 0.000001 then screen_height / height else 1.0
  let cx = if is_finite screen_width and abs screen_width > 0.000001 then (x + width * 0.5) / screen_width * 2.0 - 1.0 else 0.0
  let cy = if is_finite screen_height and abs screen_height > 0.000001 then 1.0 - (y + height * 0.5) / screen_height * 2.0 else 0.0
  let cut = narrowed sx sy cx cy
  let a = projection.x
  let b = projection.y
  let c = projection.z
  let d = projection.w
  return $Inset { x, y, width, height, pixel_size: 0.0, after_sprites, view,
    projection: (math.Mat4.from_columns (cut a) (cut b) (cut c) (cut d)), light: frame.lighting, draws }

// Every owner is declared separately by the application. This invocation-local
// record carries aliases, never copied ownership or a saved world payload.
type Settings is data = $Settings {
  retained_enabled: Bool, retained_reset: Bool, retained_after: U32,
  hide_cursor: Bool, occlusion: Bool, taa: Bool, ssgi: Bool, render_scale: F32, loading: Bool, show_captions: Bool,
  view: math.Mat4, projection: math.Mat4, lighting: Lighting, shadow: ShadowSettings, fog: Fog, clouds: Clouds,
  aberration: Vec2, blur: F32, motion_blur: MotionBlur, dof: DepthOfField, reverb: ReverbRoom,
  probes: Maybe ProbeGrid, exposure: Exposure, grade: color.Grade, cdl: color.Cdl, post_look: PostLook, features: Features,
  // `reflection_budget` faces of probe cubes the host may draw in a frame, and
  // the screen-space reflections the scene wants (0 off, 1 low, 2 high), which
  // the player's `reflections` quality caps.
  reflection_budget: U32, screen_reflections: U32,
  // The volumetrics tier the scene wants (0 off, 1 low, 2 high), which
  // the player's `volumetrics` quality caps.
  volumetrics: U32,
}
type FrameAccess is data = $FrameAccess {
  settings: #[Settings],
  draws: #[Draw], solids: #[Solid], decals: #[Decal],
  sprites: #[Sprite], insets: #[Inset], fields: #[Field],
  lights: #[PointLight], poses: #[Pose], bone_matrices: #[BoneMatrix], morph_weights: #[MorphWeight],
  motions: #[Motion], emitters: #[Emitter], ribbons: #[RibbonPoint], haptics: #[Haptic], extensions: #[Extension],
  area_lights: #[AreaLight], pbr_decals: #[PbrDecal], camera_targets: #[CameraTarget], video_streams: #[VideoStream],
  updates: #[Instance], removed: #[U32],
  vectors: #[math.Vec4], faces: #[Face], inset_draws: #[Draw], field_values: #[F32], extension_values: #[F32],
  probe_values: #[F32], reflection_probes: #[ReflectionProbe], fog_volumes: #[FogVolume],
}
func empty_frame () : FrameAccess => $FrameAccess {
  settings: #[defaults],
  draws: #[], solids: #[], decals: #[], sprites: #[], insets: #[], fields: #[],
  lights: #[], poses: #[], bone_matrices: #[], morph_weights: #[],
  motions: #[], emitters: #[], ribbons: #[], haptics: #[], extensions: #[],
  area_lights: #[], pbr_decals: #[], camera_targets: #[], video_streams: #[],
  updates: #[], removed: #[],
  vectors: #[], faces: #[], inset_draws: #[], field_values: #[], extension_values: #[],
  probe_values: #[], reflection_probes: #[], fog_volumes: #[],
}
const defaults = $Settings {
  retained_enabled: false, retained_reset: false, retained_after: 0,
  hide_cursor: false, loading: false, show_captions: false, occlusion: true, taa: false, ssgi: false, render_scale: 2.0,
  view: math.Mat4.identity, projection: math.Mat4.identity,
  lighting: $Lighting {clear: math.vec4 0.0 0.0 0.0 1.0, ambient: math.zero3,
    direction: math.vec3 0.0 (-1.0) 0.0, color: math.zero3},
  aberration: math.vec2 0.0 0.0, blur: 0.0, motion_blur: no_motion_blur, dof: no_dof, reverb: default_reverb,
  probes: $Nothing, exposure: fixed_exposure, grade: color.neutral, cdl: color.neutral_cdl,
  post_look: neutral_look, features: default_features,
  reflection_budget: 2, screen_reflections: 2,
  volumetrics: 2,
  shadow: $ShadowSettings {distance: 80.0, softness: 0.04, contact_length: 0.5},
  fog: $Fog {radius: 0.0, density: 0.0, height: 1.0, edge: 0.0, distance: 0.0, albedo: math.one3, anisotropy: 0.0,
    sun: 1.0, ambient: 1.0, sky: 0.0, noise: 0.0, noise_scale: 16.0, drift: math.zero3},
  clouds: $Clouds {cover: 0.0, drift: math.vec2 0.0 0.0},
}
// The frame's fog set to `fog`. `settings[0].fog := fog` does not compile: a
// record of more than 16 lanes cannot be written into a field of an array
// element, and `Fog` has 17 (see docs/blot.md). Write `access.frame.settings :=
// render.set_fog fog self`.
func set_fog (fog: Fog) -> (settings: own #[Settings]) : #[Settings] =>
  let row = settings[0]
  row.fog := fog
  settings[0] := row
  return settings
// The same on a frame, for an `access` whose type is not yet known where it is
// written: `access.frame := render.prepare_fog fog self`.
func prepare_fog (fog: Fog) -> (access: own FrameAccess): FrameAccess =>
  access.settings := set_fog fog self
  return access
// Call only after the previous borrowed frame has been completely encoded.
// Payload pools backing nested views must follow the same boundary or outlive it.
func begin_frame (access: own FrameAccess): FrameAccess =>
  if access.settings.length != 1:
    return panic "frame settings require one row"
  @storage.truncate access.draws 0
  @storage.truncate access.solids 0
  @storage.truncate access.decals 0
  @storage.truncate access.sprites 0
  @storage.truncate access.insets 0
  @storage.truncate access.fields 0
  @storage.truncate access.poses 0
  @storage.truncate access.bone_matrices 0
  @storage.truncate access.morph_weights 0
  @storage.truncate access.motions 0
  @storage.truncate access.lights 0
  @storage.truncate access.emitters 0
  @storage.truncate access.ribbons 0
  @storage.truncate access.haptics 0
  @storage.truncate access.extensions 0
  @storage.truncate access.area_lights 0
  @storage.truncate access.pbr_decals 0
  @storage.truncate access.camera_targets 0
  @storage.truncate access.video_streams 0
  @storage.truncate access.updates 0
  @storage.truncate access.removed 0
  @storage.truncate access.vectors 0
  @storage.truncate access.faces 0
  @storage.truncate access.inset_draws 0
  @storage.truncate access.field_values 0
  @storage.truncate access.extension_values 0
  @storage.truncate access.probe_values 0
  @storage.truncate access.reflection_probes 0
  @storage.truncate access.fog_volumes 0
  access.settings[0] := defaults
  return access
func finish (access: FrameAccess) =>
  let settings = access.settings[0]
  let instances = $Instances {reset: settings.retained_reset,
    updates: &access.updates[0..access.updates.length], removed: &access.removed[0..access.removed.length]}
  let probes = case settings.probes of
    $Some p => do:
      if p.values.start <= access.probe_values.length and p.values.count <= access.probe_values.length - p.values.start:
        break $Some ($ProbeSet {
          origin: p.origin, spacing: p.spacing, nx: p.nx, ny: p.ny, nz: p.nz, revision: p.revision,
          values: &access.probe_values[p.values.start..p.values.start + p.values.count],
        })
      break $Nothing
    $Nothing => $Nothing
  let reflection_probes = if access.reflection_probes.length > 0 then $Some ($ReflectionProbes { list: &access.reflection_probes[0..access.reflection_probes.length] }) else $Nothing
  let fog_volumes = if access.fog_volumes.length > 0 then $Some ($FogVolumes { list: &access.fog_volumes[0..access.fog_volumes.length] }) else $Nothing
  return $RenderFrame {
    retained: if settings.retained_enabled then $Some instances else $Nothing,
    retained_after: settings.retained_after, hide_cursor: settings.hide_cursor,
    occlusion: settings.occlusion, taa: settings.taa, ssgi: settings.ssgi, render_scale: settings.render_scale, loading: settings.loading,
    show_captions: settings.show_captions, view: settings.view, projection: settings.projection,
    lighting: settings.lighting, shadow: settings.shadow, fog: settings.fog, clouds: settings.clouds,
    aberration: settings.aberration, blur: settings.blur, motion_blur: settings.motion_blur, dof: settings.dof,
    reverb: settings.reverb,
    probes,
    exposure: settings.exposure, grade: settings.grade, cdl: settings.cdl,
    post_look: settings.post_look, features: settings.features,
    reflection_probes, reflection_budget: settings.reflection_budget,
    screen_reflections: settings.screen_reflections,
    fog_volumes, volumetrics: settings.volumetrics,
    extensions: &access.extensions[0..access.extensions.length], draws: &access.draws[0..access.draws.length],
    solids: &access.solids[0..access.solids.length], decals: &access.decals[0..access.decals.length],
    sprites: &access.sprites[0..access.sprites.length], insets: &access.insets[0..access.insets.length],
    fields: &access.fields[0..access.fields.length], poses: &access.poses[0..access.poses.length],
    bone_matrices: &access.bone_matrices[0..access.bone_matrices.length],
    morph_weights: &access.morph_weights[0..access.morph_weights.length],
    motions: &access.motions[0..access.motions.length],
    lights: &access.lights[0..access.lights.length], emitters: &access.emitters[0..access.emitters.length],
    ribbons: &access.ribbons[0..access.ribbons.length],
    haptics: &access.haptics[0..access.haptics.length],
    area_lights: &access.area_lights[0..access.area_lights.length],
    pbr_decals: &access.pbr_decals[0..access.pbr_decals.length],
    camera_targets: &access.camera_targets[0..access.camera_targets.length],
    video_streams: &access.video_streams[0..access.video_streams.length],
    vectors: &access.vectors[0..access.vectors.length],
    faces: &access.faces[0..access.faces.length],
    inset_draws: &access.inset_draws[0..access.inset_draws.length],
    field_values: &access.field_values[0..access.field_values.length],
    extension_values: &access.extension_values[0..access.extension_values.length],
  }

// Lanes: face count, then normal3, distance, material per face, zero-filled
// up to `capacity` faces.
func encode_faces (faces: &[Face]) => func (capacity: U32) =>
  let cap = min capacity ((4294967295 - 1) / 5)
  let written = min faces.length cap
  let encoded = @array.fill (1 + cap * 5) 0.0
  encoded[0] := from written
  for index in 0 .. written:
    let face = faces[index]
    let start = 1 + index * 5
    encoded[start] := face.normal.x
    encoded[start + 1] := face.normal.y
    encoded[start + 2] := face.normal.z
    encoded[start + 3] := face.distance
    encoded[start + 4] := from face.material
  return encoded

func draw pose => func (appearance: Appearance) => return
  $Draw { mesh: appearance.mesh, material: appearance.material, matrix: transform.matrix pose, parameters: $Nothing, extra: no_span }

// `mesh` in `material` at `position`, turned `yaw` about the vertical and
// sized by `scale`: the usual way to set a model in the world.
func placed (mesh: U32) => func (material: U32) => func (position: Vec3) => func (yaw: F32) => func (scale: Vec3) => return
  draw $transform.Pose3 { position, rotation: math.Quat.yaw yaw, scale } $Appearance { mesh, material }

// What a frame's camera sees, prepared once a frame to test many spheres
// against (`sees`): its view, its projection's focal lengths and their
// planes' slants, and its near and far depths, as the projection rounds them.
type Sight is data = $Sight { view: math.Mat4, fx: F32, fy: F32, horizontal: F32, vertical: F32, near: F32, far: F32 }

func sight frame: Sight =>
  let view: math.Mat4 = frame.view
  let projection: math.Mat4 = frame.projection
  let fx = projection.x.x
  let fy = projection.y.y
  return $Sight {
    view, fx, fy,
    horizontal: sqrt (fx * fx + 1.0), vertical: sqrt (fy * fy + 1.0),
    near: projection.w.z / projection.z.z, far: projection.w.z / (projection.z.z + 1.0),
  }

// Whether a sphere at `center` of `radius` may show in `seen`: conservative,
// never culling one that does. For culling what is drawn, not what is done.
func sees (seen: Sight) => func (center: Vec3) => func (radius: F32) =>
  let view = seen.view
  let p = center
  let depth = -(view.x.z * p.x + view.y.z * p.y + view.z.z * p.z + view.w.z)
  if depth + radius < seen.near:
    return false
  if depth - radius > seen.far:
    return false
  let camera_x = view.x.x * p.x + view.y.x * p.y + view.z.x * p.z + view.w.x
  if abs (camera_x * seen.fx) > depth + radius * seen.horizontal:
    return false
  let camera_y = view.x.y * p.x + view.y.y * p.y + view.z.y * p.z + view.w.y
  return abs (camera_y * seen.fy) <= depth + radius * seen.vertical

// Where `point` shows on a `width` by `height` screen seen through
// `frame`'s view and projection, in pixels from its top left, or nothing
// when it lies behind the eye.
func on_screen frame -> (width: F32) -> (height: F32) -> (point: Vec3): Maybe Vec2 =>
  let view: math.Mat4 = frame.view
  let projection: math.Mat4 = frame.projection
  let vx: math.Vec4 = view.x
  let vy: math.Vec4 = view.y
  let vz: math.Vec4 = view.z
  let vw: math.Vec4 = view.w
  let ex: F32 = vx.x * point.x + vy.x * point.y + vz.x * point.z + vw.x
  let ey: F32 = vx.y * point.x + vy.y * point.y + vz.y * point.z + vw.y
  let ez: F32 = vx.z * point.x + vy.z * point.y + vz.z * point.z + vw.z
  let px: math.Vec4 = projection.x
  let py: math.Vec4 = projection.y
  let pz: math.Vec4 = projection.z
  let pw: math.Vec4 = projection.w
  let cx: F32 = px.x * ex + py.x * ey + pz.x * ez + pw.x
  let cy: F32 = px.y * ex + py.y * ey + pz.y * ez + pw.y
  let cw: F32 = px.w * ex + py.w * ey + pz.w * ez + pw.w
  if cw < 0.1:
    return $Nothing
  return $Some $Vec2 { x: (cx / cw * 0.5 + 0.5) * width, y: (0.5 - cy / cw * 0.5) * height }

// Immediate output copies rows into one caller-owned frame pool, in order.
func emit draws -> (access: own FrameAccess) : FrameAccess =>
  let count = draws.length
  for index in 0 .. count:
    @storage.push access.draws (draws.at index)
  return access
func emit_many groups -> (access: own FrameAccess) : FrameAccess =>
  for group in groups:
    access := emit group self
  return access
func push (next: Draw) -> (access: own FrameAccess) : FrameAccess =>
  @storage.push access.draws next
  return access

// One draw per live entity with a Transform and an Appearance that `visible`
// accepts, interpolated from its previous Transform when it has one.
// Visibility is tested against the current pose before allocating interpolated
// transforms or matrices, so predicates must include bounds and motion padding.
// Select once, then fill the exact output length without per-entity arrays.
func draw_columns_using present => func visible => func current => func previous => func appearances => func alpha =>
  let current_count: U32 = current.length
  let previous_count: U32 = previous.length
  let appearance_count: U32 = appearances.length
  if previous_count < current_count or appearance_count < current_count:
    return panic "short render column"
  let out = #[]
  for index in 0 .. current_count:
    if let $Some pose = current.at index:
      if let $Some appearance = appearances.at index:
        if visible pose appearance:
          let shown: transform.Pose3 = case previous.at index of
            $Some old => transform.interpolate old pose alpha
            $Nothing => pose
          @storage.push out (present index shown appearance)
  return out

// Borrow distinct current/previous pools; neither view is an implicit snapshot.
func draw_views_using present => func visible => return
  draw_views_indexed present (func index => visible)

func draw_views_indexed present => func visible => func current => func previous => func appearances => func alpha =>
  let current_count: U32 = current.length
  let previous_count: U32 = previous.length
  let appearance_count: U32 = appearances.length
  let limit = min current_count appearance_count
  let out = #[]
  for index in 0 .. limit:
    if let $Some pose = current.at index:
      if let $Some appearance = appearances.at index:
        if visible index pose appearance:
          let shown: transform.Pose3 = if index < previous_count then (case previous.at index of
            $Some old => transform.interpolate old pose alpha
            $Nothing => pose) else pose
          @storage.push out (present index shown appearance)
  return out

func always_visible (pose: transform.Pose3) => func (appearance: Appearance) => true

const draw_columns_where = draw_columns_using (func index => draw)

func draw_columns current => func previous => func appearances => func alpha => return
  draw_columns_where always_visible current previous appearances alpha

func prepare_lighting (lighting: Lighting) -> (access: own FrameAccess): FrameAccess =>
  access.settings[0].lighting := lighting
  return access
func collect_mesh_draws visible -> current -> previous -> appearances -> (alpha: F32) -> (access: FrameAccess) : #[Draw] => return
  draw_views_using (func index => draw) (visible (finish access)) current previous appearances alpha
// Applications compose this direct stage with explicit borrowed columns.
func draw_meshes_where visible -> current -> previous -> appearances -> (presentation: app.Presentation) -> (access: own FrameAccess) : FrameAccess =>
  let draws = collect_mesh_draws visible current previous appearances presentation.alpha access
  return emit draws access
func all_visible frame => always_visible
const draw_meshes = draw_meshes_where all_visible

// Lanes: mesh, material.
func encode (appearance: Appearance) => codec_lib.encode_lanes appearance

func decode (values: #[F32]) =>
  use lanes.exact values 2
  return $Appearance { mesh: lanes.integer values[0] lanes.max_integer, material: lanes.integer values[1] lanes.max_integer }

const codec = $lanes.Codec { key: 6, version: 1, encode, decode, migrate: lanes.no_migration }

// A known UI stage appends into the existing pools. Offset only new insets;
// earlier scene/UI output retains its order and identity.
func layer (draw: own FrameAccess -> app.Presentation -> FrameAccess ! {|e}) -> (access: own FrameAccess) -> (presentation: app.Presentation): FrameAccess ! {|e} =>
  let below_sprites = access.sprites.length
  let below_insets = access.insets.length
  access := draw access presentation
  for index in below_insets .. access.insets.length:
    let cur = access.insets[index].after_sprites
    access.insets[index].after_sprites := if cur <= 4294967295 - below_sprites then cur + below_sprites else 4294967295
  return access

// Payload helpers append flat data into FrameAccess's own pools and return
// stable spans (never raw views that could dangle on pool growth).
func store_vectors values -> (access: own FrameAccess) : (Span, FrameAccess) =>
  let start = access.vectors.length
  let count = values.length
  for index in 0 .. count:
    @storage.push access.vectors (values.at index)
  return ($Span { start, count }, access)
func push_extra (draw: Draw) -> values -> (access: own FrameAccess) : FrameAccess =>
  let (extra, access) = store_vectors values access
  draw.extra := extra
  @storage.push access.draws draw
  return access
func store_inset_draws draws -> (access: own FrameAccess) : (Span, FrameAccess) =>
  let start = access.inset_draws.length
  let count = draws.length
  for index in 0 .. count:
    @storage.push access.inset_draws (draws.at index)
  return ($Span { start, count }, access)
func push_solid faces -> (access: own FrameAccess) : FrameAccess =>
  let start = access.faces.length
  let count = faces.length
  for index in 0 .. count:
    @storage.push access.faces (faces.at index)
  @storage.push access.solids ($Solid { faces: $Span { start, count } })
  return access
func push_field (material: U32) -> (width: U32) -> (height: U32) -> (x: U32) -> (z: U32) -> (columns: U32) -> values -> (access: own FrameAccess) : FrameAccess =>
  let start = access.field_values.length
  let count = values.length
  for index in 0 .. count:
    @storage.push access.field_values (values.at index)
  @storage.push access.fields ($Field { material, width, height, x, z, columns, values: $Span { start, count } })
  return access
func push_extension (tag: U32) -> values -> (access: own FrameAccess) : FrameAccess =>
  let start = access.extension_values.length
  let count = values.length
  for index in 0 .. count:
    @storage.push access.extension_values (values.at index)
  @storage.push access.extensions ($Extension { tag, values: $Span { start, count } })
  return access
