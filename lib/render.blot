import * as array from "std/array"
import { Vec2, Vec3 } from "std/vector"
import * as app from "./app"
import * as ecs from "./ecs"
import * as lanes from "./lanes"
import * as math from "./math"
import * as transform from "./transform"

// Mesh and material IDs refer to the caller's asset catalog.
type Appearance is data = #Appearance { mesh: U32, material: U32 }
// `parameters` override the material's four instance parameters. `extra` is
// shader-specific vectors after the parameters. The host chooses capacity
// limits and whether those values permit instancing.
type Draw is data = #Draw { mesh: U32, material: U32, matrix: math.Mat4, parameters: Maybe math.Vec4, extra: Array math.Vec4 }

// A convex solid: the points p with dot(normal, p) <= distance for every face.
// The host meshes it with world-aligned texture coordinates.
type Face is data = #Face { normal: Vec3, distance: F32, material: U32 }
type Solid is data = #Solid { faces: Array Face }
// Clear RGBA, ambient RGB, and one directional light: the direction its rays
// travel and its RGB color.
type Lighting is data = #Lighting { clear: math.Vec4, ambient: Vec3, direction: Vec3, color: Vec3 }
// A decal lays a material's texture onto the surfaces inside its box, the
// cube -1..1 under `matrix`, projected along the box's y axis, on materials
// that take decals; `opacity` fades it.
type Decal is data = #Decal { material: U32, matrix: math.Mat4, opacity: F32 }
// A rectangle on the screen, in pixels from its top left, drawn by its
// material's sprite shader: an image's texture between (u0, v0) and (u1, v1)
// tinted by `color`, or a font's distance field. `parameters`
// are the shader's to read. Sprites draw over everything else, in order.
type Sprite is data = #Sprite {
  x: F32, y: F32, width: F32, height: F32,
  u0: F32, v0: F32, u1: F32, v1: F32,
  color: math.Vec4, material: U32, parameters: math.Vec4,
}
// A small 3D view drawn over the screen in the rectangle at (x, y), e.g. a
// menu's model preview, lit by its own `light` (its clear color unused),
// without shadows. `after_sprites` places it after that many frame sprites,
// so complete UI layers can include both text and model previews.
type Inset is data = #Inset {
  x: F32, y: F32, width: F32, height: F32, pixel_size: F32, after_sprites: U32,
  view: math.Mat4, projection: math.Mat4, light: Lighting, draws: Array Draw,
}
// Mist beyond `radius` of the middle, thickening by `density` per unit and
// thinning with height over `height`; density 0 for none.
type Fog is data = #Fog { radius: F32, density: F32, height: F32 }
// Clouds project soft shadows onto world surfaces: `cover`
// how much of the sky they cover, 0 for none to 1 overcast, and `drift` how
// far the wind has carried them, in units along x and z (`y`).
type Clouds is data = #Clouds { cover: F32, drift: Vec2 }
// `aberration` splits the colors of the surfaces whose material asks for it:
// red moves that far, in screen heights across and down, and blue as far the
// other way. `blur` smears the whole picture toward the middle of the screen,
// as speed does, over that share of the way there (0 for none, at most 0.5).
// The host's last pass draws both when screen effects are on.
// `fields` are patches of the values the host keeps for some materials (see
// Field). `poses` pose skinned draws, and `emitters` give off particles.
// `occlusion` allows ambient occlusion for this frame, subject to the player's
// quality preference. Disable it for scenes that supply their own shading.
// `render_scale` caps the player's scene resolution scale, clamped to 0.5..2.0.
// Sprites and UI retain the screen's resolution; preferences are unchanged.
// `show_captions` opts into host sound captions, according to the game's preferences.
// `loading` draws the sprites above the startup cover while scene assets load.
// Optional application publications. Hosts interpret declared tags; core Ink
// carries their numeric payloads without assigning a format or side effect.
type Extension is data = #Extension { tag: U32, values: Array F32 }
// Caller-owned retained draws. Hosts insert these at retained_after in the immediate draws.
// A replacement world sends a reset before its first delta.
type Instance is data = #Instance { id: U32, order: U32, draw: Draw }
type Instances is data = #Instances { reset: Bool, updates: Array Instance, removed: Array U32 }

type RenderFrame is data = #RenderFrame {
  extensions: Array Extension,
  retained: Maybe Instances,
  retained_after: U32,
  hide_cursor: Bool, occlusion: Bool, render_scale: F32, loading: Bool, show_captions: Bool,
  view: math.Mat4, projection: math.Mat4, lighting: Lighting, fog: Fog, clouds: Clouds, aberration: Vec2, blur: F32,
  draws: Array Draw, draw_chunks: Array (Array Draw), solids: Array Solid, decals: Array Decal, sprites: Array Sprite, insets: Array Inset,
  fields: Array Field, poses: Array Pose, emitters: Array Emitter,
}

// A layer of a skinned draw's pose: clip `clip` of the draw's mesh (in the
// order its glTF file lists them), sampled `time` seconds in (round the clip
// as often as need be), counting `weight` among the draw's layers. `draw` is
// the draw's place in the frame's draws. A draw is posed when its mesh has a
// skin and its material's shader a `vertex_skinned` entry point; the host
// works out its joints and draws it alone.
type Pose is data = #Pose { draw: U32, clip: U32, time: F32, weight: F32 }

// Particles the host simulates on the GPU from the emitter alone: `rate` a
// second are born from `time` 0 (for `duration` seconds, 0 for as long as
// frames keep it), each living `lifetime` seconds, in a ball of `radius`
// round `matrix`'s origin, with `velocity` (in the emitter's space) and a
// random one up to `spread`, under `gravity` (world space) and `drag`. Their
// width and color go from start to end over their lives, tinted by
// `material`'s color and shaped by its texture (soft dots without one).
// `seed` chooses their randomness, so the same emitter at the same time
// draws the same particles. `additive` ones add their light.
type Emitter is data = #Emitter {
  material: U32, matrix: math.Mat4, seed: U32, time: F32, duration: F32, rate: F32, lifetime: F32,
  radius: F32, velocity: Vec3, spread: F32, gravity: Vec3, drag: F32,
  size_start: F32, size_end: F32, color_start: math.Vec4, color_end: math.Vec4, additive: Bool,
}

// A patch of a field: a grid of `width` x `height` values the host keeps for
// `material`, which every draw of it reads as a texture (its shader's
// binding 3, red channel, half-float precision; read it with textureLoad).
// The patch's values, `columns` to a row, land row by row at column `x`, row
// `z`. The host keeps each value until a later patch overwrites it, so a game
// sends what changed, and every value again now and then for a frame it
// may have skipped. A field draws as zero until its values arrive; its
// draws carry no data of their own, so they can share an instanced draw.
type Field is data = #Field { material: U32, width: U32, height: U32, x: U32, z: U32, columns: U32, values: Array F32 }


const default_lighting = #Lighting {
  clear: math.vec4 0.025 0.035 0.06 1.0,
  ambient: math.vec3 0.22 0.22 0.28,
  direction: math.vec3 (-0.4) (-1.0) (-0.3),
  color: math.vec3 0.9 0.85 0.75,
}

// The light of a studio, for small 3D views of things such as icons: from
// above, to the left and in front, whatever the time of day.
const studio = #Lighting {
  clear: math.vec4 0.0 0.0 0.0 1.0,
  ambient: math.vec3 0.45 0.46 0.52,
  direction: (math.vec3 0.45 (-0.7) (-0.55)).normalized,
  color: math.vec3 0.95 0.9 0.82,
}

// A decal of `material` lying on the surface at `point` that faces `normal`:
// a disc `radius` across reaching `depth` above and below the surface.
const lying = fn (material: U32) => fn (point: Vec3) => fn (normal: Vec3) => fn (radius: F32) => fn (depth: F32) => fn (opacity: F32) => do:
  let up = normal.normalized
  let reference = math.right
  if abs up.y < 0.9:
    reference := math.up
  let side = (up.cross reference).normalized
  let ahead = side.cross up
  return #Decal { material, opacity, matrix: (math.Mat4.from_columns (math.vec4 (side.x * radius) (side.y * radius) (side.z * radius) 0.0) (math.vec4 (up.x * depth) (up.y * depth) (up.z * depth) 0.0) (math.vec4 (ahead.x * radius) (ahead.y * radius) (ahead.z * radius) 0.0) (math.vec4 point.x point.y point.z 1.0)) }

// Narrows a clip-space column to the part of the screen an inset covers:
// `sx`, `sy` scale it and `cx`, `cy` are the inset's middle in clip space.
const narrowed = fn (sx: F32) => fn (sy: F32) => fn (cx: F32) => fn (cy: F32) => fn (column: math.Vec4) =>
  math.vec4 (sx * (column.x - cx * column.w)) (sy * (column.y - cy * column.w)) column.z column.w

// An inset of `draws` as `frame`'s camera sees them and lit as it is, cut to
// the rectangle `x`, `y`, `width`, `height` of a `screen_width` by
// `screen_height` screen: for what lies over every other inset, such as
// something held in a cursor hand.
const seen = fn (frame: RenderFrame) => fn (x: F32) => fn (y: F32) => fn (width: F32) => fn (height: F32) => fn (screen_width: F32) => fn (screen_height: F32) => fn (draws: Array Draw) => do:
  let cut = narrowed (screen_width / width) (screen_height / height)
    ((x + width * 0.5) / screen_width * 2.0 - 1.0) (1.0 - (y + height * 0.5) / screen_height * 2.0)
  let a = frame.projection.x
  let b = frame.projection.y
  let c = frame.projection.z
  let d = frame.projection.w
  return #Inset { x, y, width, height, pixel_size: 0.0, after_sprites: frame.sprites.length, view: frame.view,
    projection: (math.Mat4.from_columns (cut a) (cut b) (cut c) (cut d)), light: frame.lighting, draws }

// The frame every render schedule starts from.
const empty = #RenderFrame {
  retained: #Nothing,
  retained_after: 0,
  extensions: #[],
  hide_cursor: #False,
  loading: #False,
  show_captions: #False,
  occlusion: #True,
  render_scale: 2.0,
  view: math.Mat4.identity,
  projection: math.Mat4.identity,
  lighting: #Lighting {
    clear: math.vec4 0.0 0.0 0.0 1.0,
    ambient: math.zero3,
    direction: math.vec3 0.0 (-1.0) 0.0,
    color: math.zero3,
  },
  aberration: #Vec2 { x: 0.0, y: 0.0 },
  blur: 0.0,
  draws: #[],
  draw_chunks: #[],
  solids: #[],
  fog: #Fog { radius: 0.0, density: 0.0, height: 1.0 },
  clouds: #Clouds { cover: 0.0, drift: #Vec2 { x: 0.0, y: 0.0 } },
  decals: #[],
  sprites: #[],
  insets: #[],
  fields: #[],
  poses: #[],
  emitters: #[],
}

// Lanes: face count, then normal3, distance, material per face, zero-filled
// up to `capacity` faces.
const encode_faces = fn (faces: Array Face) => fn (capacity: U32) => do:
  let encoded = @array.fill (1 + capacity * 5) 0.0
  encoded[0] := from faces.length
  for index in 0 .. faces.length:
    let face = faces[index]
    let start = 1 + index * 5
    encoded[start] := face.normal.x
    encoded[start + 1] := face.normal.y
    encoded[start + 2] := face.normal.z
    encoded[start + 3] := face.distance
    encoded[start + 4] := from face.material
  return encoded

const draw = fn pose => fn (appearance: Appearance) =>
  #Draw { mesh: appearance.mesh, material: appearance.material, matrix: transform.matrix pose, parameters: #Nothing, extra: #[] }

// `mesh` in `material` at `position`, turned `yaw` about the vertical and
// sized by `scale`: the usual way to set a model in the world.
const placed = fn (mesh: U32) => fn (material: U32) => fn (position: Vec3) => fn (yaw: F32) => fn (scale: Vec3) =>
  draw #transform.Pose3 { position, rotation: math.Quat.yaw yaw, scale } #Appearance { mesh, material }

// What a frame's camera sees, prepared once a frame to test many spheres
// against (`sees`): its view, its projection's focal lengths and their
// planes' slants, and its near and far depths, as the projection rounds them.
type Sight is data = #Sight { view: math.Mat4, fx: F32, fy: F32, horizontal: F32, vertical: F32, near: F32, far: F32 }

const sight = fn (frame: RenderFrame) => do:
  let #RenderFrame { view, projection } = frame
  let fx = projection.x.x
  let fy = projection.y.y
  return #Sight {
    view, fx, fy,
    horizontal: sqrt (fx * fx + 1.0), vertical: sqrt (fy * fy + 1.0),
    near: projection.w.z / projection.z.z, far: projection.w.z / (projection.z.z + 1.0),
  }

// Whether a sphere at `center` of `radius` may show in `seen`: conservative,
// never culling one that does. For culling what is drawn, not what is done.
const sees = fn (seen: Sight) => fn (center: Vec3) => fn (radius: F32) => do:
  let view = seen.view
  let p = center
  let depth = -(view.x.z * p.x + view.y.z * p.y + view.z.z * p.z + view.w.z)
  if depth + radius < seen.near:
    return #False
  if depth - radius > seen.far:
    return #False
  let camera_x = view.x.x * p.x + view.y.x * p.y + view.z.x * p.z + view.w.x
  if abs (camera_x * seen.fx) > depth + radius * seen.horizontal:
    return #False
  let camera_y = view.x.y * p.x + view.y.y * p.y + view.z.y * p.z + view.w.y
  return abs (camera_y * seen.fy) <= depth + radius * seen.vertical

// Where `point` shows on a `width` by `height` screen seen through
// `frame`'s view and projection, in pixels from its top left, or nothing
// when it lies behind the eye.
const on_screen = fn (frame: RenderFrame) => fn (width: F32) => fn (height: F32) => fn (point: Vec3) => do:
  let vx = frame.view.x
  let vy = frame.view.y
  let vz = frame.view.z
  let vw = frame.view.w
  let ex = vx.x * point.x + vy.x * point.y + vz.x * point.z + vw.x
  let ey = vx.y * point.x + vy.y * point.y + vz.y * point.z + vw.y
  let ez = vx.z * point.x + vy.z * point.y + vz.z * point.z + vw.z
  let px = frame.projection.x
  let py = frame.projection.y
  let pz = frame.projection.z
  let pw = frame.projection.w
  let cx = px.x * ex + py.x * ey + pz.x * ez + pw.x
  let cy = px.y * ex + py.y * ey + pz.y * ez + pw.y
  let cw = px.w * ex + py.w * ey + pz.w * ez + pw.w
  if cw < 0.1:
    return #Nothing
  return #Some #Vec2 { x: (cx / cw * 0.5 + 0.5) * width, y: (0.5 - cy / cw * 0.5) * height }

// Append complete draw groups without copying earlier world draws. `draws`
// is the pending tail, preserving ordinary callers that append there. Flush
// before inspecting/replacing the whole draw list or handing it to a host.
const emit_many = fn (groups: Array (Array Draw)) => fn (frame: RenderFrame) => do:
  let kept = #[group | group <- groups, group.length > 0]
  if kept.length == 0:
    return frame
  if frame.draws.length > 0:
    frame.draw_chunks := array.push frame.draws self
    frame.draws := #[]
  frame.draw_chunks := array.concat self kept
  return frame
const emit = fn (draws: Array Draw) => fn (frame: RenderFrame) =>
  emit_many #[draws] frame
const finish = fn (frame: RenderFrame) => do:
  if frame.draw_chunks.length == 0:
    return frame
  frame.draws := array.flatten (array.push frame.draws frame.draw_chunks)
  frame.draw_chunks := #[]
  return frame

const push = fn next => fn (frame: RenderFrame) => do:
  frame.draws := array.push next self
  return frame

// One draw per live entity with a Transform and an Appearance that `visible`
// accepts, interpolated from its previous Transform when it has one.
// Visibility is tested against the current pose before allocating interpolated
// transforms or matrices, so predicates must include bounds and motion padding.
// Select once, then fill the exact output length without per-entity arrays.
const draw_columns_using = fn present => fn visible => fn current => fn previous => fn appearances => fn alpha => do:
  if previous.length < current.length || appearances.length < current.length:
    return @panic "short render column"
  let selected = array.fill current.length 0
  let count = 0
  for index in 0 .. current.length:
    let keep = case current[index], appearances[index] of
      #Some pose, #Some appearance => visible pose appearance
      _, _ => #False
    if keep:
      selected[count] := index
      count := self + 1
  return array.generate count (fn slot => do:
    let index = selected[slot]
    let #Some pose = current[index] else:
      return @panic "selected missing pose"
    let #Some appearance = appearances[index] else:
      return @panic "selected missing appearance"
    let shown = case previous[index] of
      #Some old => transform.interpolate old pose alpha
      #Nothing => pose
    return present index shown appearance)

// Draw immutable ECS snapshots without materializing entity-sized columns.
const draw_views_using = fn present => fn visible =>
  draw_views_indexed present (fn index => visible)

const draw_views_indexed = fn present => fn visible => fn current => fn previous => fn appearances => fn alpha => do:
  let selected = array.fill current.count 0
  let count = 0
  for index in 0 .. current.count:
    let keep = case ecs.read current index, ecs.read appearances index of
      #Some pose, #Some appearance => visible index pose appearance
      _, _ => #False
    if keep:
      selected[count] := index
      count := self + 1
  return array.generate count (fn slot => do:
    let index = selected[slot]
    let #Some pose = ecs.read current index else:
      return @panic "selected missing pose"
    let #Some appearance = ecs.read appearances index else:
      return @panic "selected missing appearance"
    let shown = case ecs.read previous index of
      #Some old => transform.interpolate old pose alpha
      #Nothing => pose
    return present index shown appearance)

const always_visible = fn (pose: transform.Pose3) => fn (appearance: Appearance) => #True

const draw_columns_where = draw_columns_using (fn index => draw)

const draw_columns = fn current => fn previous => fn appearances => fn alpha =>
  draw_columns_where always_visible current previous appearances alpha

const prepare_lighting = fn (lighting: Lighting) => fn (presentation: app.Presentation) => fn (frame: RenderFrame) => do:
  frame.lighting := lighting
  return frame

// Draws every entity with a Transform and an Appearance that `visible frame`
// accepts, interpolated between the last two fixed steps. Appends a draw chunk;
// finish the frame before inspecting the complete draw list.
const draw_meshes_where = fn visible => fn (presentation: app.Presentation) => fn (frame: RenderFrame) => do:
  use poses <- ecs.view #transform.Pose3
  use previous_poses <- ecs.previous_view #transform.Pose3
  use appearances <- ecs.view #Appearance
  let predicate = visible frame
  return emit (draw_views_using (fn index => draw) predicate poses previous_poses appearances presentation.alpha) frame

const all_visible = fn (frame: RenderFrame) => always_visible
const draw_meshes = draw_meshes_where all_visible

// Lanes: mesh, material.
const encode = fn (appearance: Appearance) => #[from appearance.mesh, from appearance.material]

const decode = fn (values: Array F32) => do:
  use lanes.exact values 2
  return #Appearance { mesh: lanes.integer values[0] lanes.max_integer, material: lanes.integer values[1] lanes.max_integer }

const codec = #lanes.Codec { key: 6, version: 1, encode, decode, migrate: lanes.no_migration }

// Requires transform.plugin.
const plugin_prepared = fn lighting => fn prepare => fn builder => do:
  builder := app.register_component codec #Appearance { mesh: 0, material: 0 } self
  builder := app.add_system #app.Render (prepare_lighting lighting) self
  builder := app.add_system #app.Render prepare self
  return builder

const plugin_culled = fn lighting => fn visible => plugin_prepared lighting (draw_meshes_where visible)
const plugin = fn lighting => plugin_culled lighting all_visible

// Compose a UI layer above everything already declared, preserving local
// sprite/inset interleaving. Scene draws and other frame data remain intact.
const layer = fn draw => fn (presentation: app.Presentation) => fn (frame: RenderFrame) => do:
  let below_sprites = frame.sprites
  let below_insets = frame.insets
  frame.sprites := #[]
  frame.insets := #[]
  use layer <- draw presentation frame
  layer.insets := array.concat below_insets (array.map (fn (inset: Inset) => do:
    inset.after_sprites := self + below_sprites.length
    return inset) layer.insets)
  layer.sprites := array.concat below_sprites self
  return layer
