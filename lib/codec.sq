const Quat.ByteSliceDecode: ByteSliceDecode math.Quat = { from_byte_slice: read_byte_slice_quat }

func push_byte_color (c: math.Color) -> (out: own #[U8]): #[U8] =>
  out := push_le_f32 c.r self
  out := push_le_f32 c.g self
  out := push_le_f32 c.b self
  return push_le_f32 c.a out
func read_byte_color (values: #[U8]) -> (at: U32): Maybe (math.Color, U32) =>
  let $Some (r, at) = read_byte_f32 values at else:
    return $Nothing
  let $Some (g, at) = read_byte_f32 values at else:
    return $Nothing
  let $Some (b, at) = read_byte_f32 values at else:
    return $Nothing
  let $Some (a, at) = read_byte_f32 values at else:
    return $Nothing
  return $Some ($math.Color { r, g, b, a }, at)
func read_byte_slice_color (values: &[U8]) -> (at: U32): Maybe (math.Color, U32) =>
  let $Some (r, at) = read_byte_slice_f32 values at else:
    return $Nothing
  let $Some (g, at) = read_byte_slice_f32 values at else:
    return $Nothing
  let $Some (b, at) = read_byte_slice_f32 values at else:
    return $Nothing
  let $Some (a, at) = read_byte_slice_f32 values at else:
    return $Nothing
  return $Some ($math.Color { r, g, b, a }, at)
const Color.ByteEncode: ByteEncode math.Color = { byte_width: func _ => 16, push_bytes: push_byte_color }
const Color.ByteDecode: ByteDecode math.Color = { from_bytes: read_byte_color }
const Color.ByteSliceDecode: ByteSliceDecode math.Color = { from_byte_slice: read_byte_slice_color }

func byte_count (value: t): U32 =>
  let count: U32 = 0
  #for field in #fields t:
    #if not (field.has_tag $Skip):
      count := self + ByteEncode.byte_width value.(field)
  return count

func encode_bytes (value: t): #[U8] =>
  let out: #[U8] = Array.with_capacity (byte_count value)
  #for field in #fields t:
    #if not (field.has_tag $Skip):
      out := ByteEncode.push_bytes value.(field) self
  return out

func decode_bytes (values: #[U8]): Maybe t =>
  let at: U32 = 0
  let built: t = #for field in #fields t:
    #if field.has_tag $Skip:
      break field.default
    #else:
      let $Some (value, next) = ByteDecode.from_bytes values at else:
        return $Nothing
      at := next
      break value
  if at != values.length:
    return $Nothing
  return $Some built

func decode_bytes_slice (values: &[U8]): Maybe t =>
  let at: U32 = 0
  let built: t = #for field in #fields t:
    #if field.has_tag $Skip:
      break field.default
    #else:
      let $Some (value, next) = ByteSliceDecode.from_byte_slice values at else:
        return $Nothing
      at := next
      break value
  if at != values.length:
    return $Nothing
  return $Some built

// Count non-Skip fields of a record type at compile time.
func record_field_count (value: t): U32 =>
  let count: U32 = 0
  #for field in #fields t:
    #if not (field.has_tag $Skip):
      count := self + 1
  return count

// Generic comptime word-framed encoder for any single-constructor record `t`
// whose non-Skip fields implement `Codec`. Emits Ink's exact framed word layout:
//   [version, tag, field_count, id0, len0, ...words0, ...]
// Fields annotated with `@[$FieldId n]` use `n`; otherwise 1-based ordinals.
func encode_record (version: U32) -> (tag: U32) -> (value: t): #[U32] =>
  let out: #[U32] = #[version, tag, 0]
  let count: U32 = 0
  let ordinal: U32 = 1
  #for field in #fields t:
    #if not (field.has_tag $Skip):
      let id: U32 = 0
      #if field.has_tag $FieldId:
        id := field.tag $FieldId
      #else:
        id := ordinal
      let payload = Codec.encode value.(field)
      @storage.push out id
      @storage.push out payload.length
      for word in payload:
        @storage.push out word
      count := self + 1
    ordinal := self + 1
  out[2] := count
  return out

// Comptime framed header check + cursor field reader paired with `encode_record`.
func check_header (version: U32) -> (tag: U32) -> (expected_fields: U32) -> (words: #[U32]): Bool =>
  return words.length >= 3 and words[0] == version and words[1] == tag and words[2] == expected_fields

func read_field (words: #[U32]) -> (cursor: U32) -> (expected_id: U32): Maybe (a, U32) where { Codec a } =>
  if cursor > words.length or words.length - cursor < 2:
    return $Nothing
  if words[cursor] != expected_id:
    return $Nothing
  let width = words[cursor + 1]
  let start = cursor + 2
  if width > words.length - start:
    return $Nothing
  let decoded: Maybe a = Codec.decode (@array.slice words start width)
  let $Some value = decoded else:
    return $Nothing
  return $Some (value, start + width)

// Generic comptime word-framed decoder paired with `encode_record`. Checks the
// header, reads non-Skip fields in declared order by `@[$FieldId n]` (or
// 1-based ordinal), and restores `@[$Skip]` fields from `field.default`.
func decode_record (version: U32) -> (tag: U32) -> (words: #[U32]): Maybe t =>
  let expected: U32 = 0
  #for field in #fields t:
    #if not (field.has_tag $Skip):
      expected := self + 1
  if not (check_header version tag expected words):
    return $Nothing
  let cursor: U32 = 3
  let ordinal: U32 = 1
  let built: t = #for field in #fields t:
    let this_ordinal = ordinal
    ordinal := self + 1
    #if field.has_tag $Skip:
      break field.default
    #else:
      let id: U32 = 0
      #if field.has_tag $FieldId:
        id := field.tag $FieldId
      #else:
        id := this_ordinal
      let $Some (value, next) = read_field words cursor id else:
        return $Nothing
      cursor := next
      break value
  if cursor != words.length:
    return $Nothing
  return $Some built

// Zero-copy slice header check + cursor reader paired with `encode_record`.
func check_header_slice (version: U32) -> (tag: U32) -> (expected_fields: U32) -> (words: &[U32]): Bool =>
  return words.length >= 3 and words[0] == version and words[1] == tag and words[2] == expected_fields

func read_field_slice (words: &[U32]) -> (cursor: U32) -> (expected_id: U32): Maybe (a, U32) where { Codec a } =>
  if cursor > words.length or words.length - cursor < 2:
    return $Nothing
  if words[cursor] != expected_id:
    return $Nothing
  let width = words[cursor + 1]
  let start = cursor + 2
  if width > words.length - start:
    return $Nothing
  let field_words = array.generate width (func i => words[start + i])
  let decoded: Maybe a = Codec.decode field_words
  let $Some value = decoded else:
    return $Nothing
  return $Some (value, start + width)

func decode_record_slice (version: U32) -> (tag: U32) -> (words: &[U32]): Maybe t =>
  let expected: U32 = 0
  #for field in #fields t:
    #if not (field.has_tag $Skip):
      expected := self + 1
  if not (check_header_slice version tag expected words):
    return $Nothing
  let cursor: U32 = 3
  let ordinal: U32 = 1
  let built: t = #for field in #fields t:
    let this_ordinal = ordinal
    ordinal := self + 1
    #if field.has_tag $Skip:
      break field.default
    #else:
      let id: U32 = 0
      #if field.has_tag $FieldId:
        id := field.tag $FieldId
      #else:
        id := this_ordinal
      let $Some (value, next) = read_field_slice words cursor id else:
        return $Nothing
      cursor := next
      break value
  if cursor != words.length:
    return $Nothing
  return $Some built

// Comptime field-id and variant-tag metadata builders using `#for #fields` / `#for #variants`.
func record_field_ids (value: t): #[U32] =>
  let ids: #[U32] = #[]
  let ordinal: U32 = 1
  #for field in #fields t:
    #if not (field.has_tag $Skip):
      #if field.has_tag $FieldId:
        @storage.push ids (field.tag $FieldId)
      #else:
        @storage.push ids ordinal
    ordinal := self + 1
  return ids

func variant_tags (value: t): #[U32] =>
  let tags: #[U32] = #[]
  #for variant in #variants t:
    #if not (variant.has_tag $Skip):
      #if variant.has_tag $VariantTag:
        @storage.push tags (variant.tag $VariantTag)
      #else:
        @storage.push tags (variant.index + 1)
  return tags

func variant_count (value: t): U32 =>
  let count: U32 = 0
  #for variant in #variants t:
    #if not (variant.has_tag $Skip):
      count := self + 1
  return count

func describe_record_parts (tag: U32) -> (type_name: #[U32]) -> (value: t): (#[Variant], #[Field], #[U32]) =>
  let text: #[U32] = #[]
  let label_start = text.length
  for ch in type_name:
    @storage.push text ch
  let type_label = $Span { start: label_start, count: type_name.length }
  let fields: #[Field] = #[]
  let ordinal: U32 = 1
  #for field in #fields t:
    #if not (field.has_tag $Skip):
      let id: U32 = 0
      #if field.has_tag $FieldId:
        id := field.tag $FieldId
      #else:
        id := ordinal
      let fname = field.name
      let fstart = text.length
      for ch in fname:
        @storage.push text ch
      @storage.push fields ($Field {
        id,
        label: $Span { start: fstart, count: fname.length },
        type_name: $Span { start: 0, count: 0 },
        kind: $Encoded,
      })
    ordinal := self + 1
  let variants: #[Variant] = #[$Variant { tag, label: type_label, fields: $Span { start: 0, count: fields.length } }]
  return (variants, fields, text)
