//! Library-owned word and F32-lane serialization traits plus `#for #fields` comptime record codecs.
//!
//! Key items: [`Codec`], [`LaneEncode`], [`LaneDecode`], [`Persistence`], [`encode`].
//!
//! ```squid
//! type Header is data = $Header { tick: U32, seed: U32 }
//! let words = encode_record 1 7 ($Header { tick: 12, seed: 99 })
//! let dec: Maybe Header = decode_record 1 7 words
//! let $Some h = dec else:
//!   return #[]
//! #[h.tick, h.seed] // => #[12, 99]
//! ```

import * as array from "std/array"
import * as words from "std/codec"
import * as simd from "std/simd"
import { Vec2, Vec3 } from "std/vector"
import * as lanes from "./lanes"
import * as math from "./math"

// Squid's orphan rule prevents adding a std/codec implementation for F32 from
// Ink. This library-owned contract uses the same framing and generator, while
// admitting Ink's finite F32 policy and caller-owned custom implementations.
type Codec a is trait = {
  encode: a -> #[U32],
  decode: #[U32] -> Maybe a,
}
func encode (value: a): #[U32] where { Codec a } => Codec.encode value
func unsigned_word (value: U32) => value
func unsigned_from_word (word: U32) => $Some word
func boolean_word (value: Bool) : U32 => if value then 1 else 0
func boolean_from_word (word: U32) : Maybe Bool => if word <= 1 then $Some (word == 1) else $Nothing
const U32.Codec: Codec U32 = {
  encode: func value => #[value],
  decode: func values => if values.length == 1 then $Some values[0] else $Nothing,
}
const Bool.Codec: Codec Bool = {
  encode: func value => #[if value then 1 else 0],
  decode: func values => if values.length == 1 and values[0] <= 1 then $Some (values[0] == 1) else $Nothing,
}
func frame id => func payload => words.frame id payload
func take_field id => func payload => words.take_field id payload

// IEEE-754 bits, not a numeric cast. Signed zero and subnormals round trip.
func float_word (value: F32) =>
  use lanes.require (is_finite value)
  let (bits, _, _, _) = simd.f32_bits (value, 0.0, 0.0, 0.0)
  return bits
func float_encode (value: F32) => #[float_word value]
func float_from_word (word: U32) : Maybe F32 =>
  let (value, _, _, _) = simd.f32_from_bits (word, 0, 0, 0)
  if not (is_finite value):
    return $Nothing
  return $Some value
func float_decode (payload: #[U32]) : Maybe F32 =>
  if payload.length != 1:
    return $Nothing
  return float_from_word payload[0]
const F32.Codec: Codec F32 = {
  encode: func value => float_encode value,
  decode: func values => float_decode values,
}

func sequence_encode (values: #[a]): #[U32] where { Codec a } =>
  let out: #[U32] = Array.with_capacity (1 + values.length * 2)
  @storage.push out values.length
  for value in values:
    let payload = encode value
    @storage.push out payload.length
    @storage.extend out payload
  return out
func sequence_decode (words: #[U32]): Maybe #[a] where { Codec a } =>
  if words.length == 0 or words[0] > words.length - 1:
    return $Nothing
  let count = words[0]
  let cursor = 1
  let output: #[a] = Array.with_capacity count
  for ignored in 0 .. count:
    if cursor >= words.length:
      return $Nothing
    let width = words[cursor]
    cursor := self + 1
    if width > words.length - cursor:
      return $Nothing
    let decoded: Maybe a = Codec.decode (@array.slice words cursor width)
    let $Some value = decoded else:
      return $Nothing
    @storage.push output value
    cursor := self + width
  if cursor != words.length:
    return $Nothing
  return $Some output
const Array.Codec: Codec #[a] where { Codec a } = {
  encode: func values => sequence_encode values,
  decode: func words => sequence_decode words,
}

// Adapter format 1: exact U32 count in two F32 halves, then low/high halves
// for each word. Optional zero padding makes a bounded component fixed-width.
func pack (capacity: U32) => func (payload: #[U32]) =>
  let size = if capacity == 0 then payload.length else capacity
  use lanes.require (payload.length <= size and size <= (lanes.max_integer - 2) / 2)
  let result = @array.fill (2 + size * 2) 0.0
  result[0] := U32.to_f32 (payload.length & 65535)
  result[1] := U32.to_f32 (payload.length >> 16)
  let low_mask = (65535, 65535, 65535, 65535)
  for group in 0 .. payload.length / 4:
    let i = group * 4
    let words = @simd.load payload i
    let low = @simd.u32x4.to_f32 (@simd.u32x4.bit_and words low_mask)
    let high = @simd.u32x4.to_f32 (@simd.u32x4.shr words 16)
    @simd.store result (2 + i * 2) (@simd.f32x4.shuffle (0, 4, 1, 5) (low, high))
    @simd.store result (6 + i * 2) (@simd.f32x4.shuffle (2, 6, 3, 7) (low, high))
  for i in payload.length / 4 * 4 .. payload.length:
    let word = payload[i]
    result[2 + i * 2] := U32.to_f32 (word & 65535)
    result[3 + i * 2] := U32.to_f32 (word >> 16)
  return result

func unpack (capacity: U32) -> (payload: #[F32]) : Maybe (#[U32]) =>
  return unpack_range capacity (&payload[0..payload.length])

func unpack_range (capacity: U32) -> (payload: &[F32]) : Maybe (#[U32]) =>
  let plen = payload.length
  if plen < 2 or (plen & 1) != 0:
    return $Nothing
  let p0 = payload[0]
  let p1 = payload[1]
  if not (p0 >= 0.0 and p0 <= 65535.0 and floor p0 == p0 and p1 >= 0.0 and p1 <= 65535.0 and floor p1 == p1):
    return $Nothing
  let count = F32.to_u32 p0 | (F32.to_u32 p1 << 16)
  let size = (plen - 2) / 2
  if count > size or (capacity == 0 and count != size) or (capacity != 0 and size != capacity):
    return $Nothing
  let padding = 2 + count * 2
  let padding_groups = (plen - padding) / 4
  let zero = (0.0, 0.0, 0.0, 0.0)
  for group in 0 .. padding_groups:
    if not (@simd.u32x4.all_true (@simd.f32x4.eq (@simd.load payload (padding + group * 4)) zero)):
      return $Nothing
  for i in padding + padding_groups * 4 .. plen:
    if payload[i] != 0.0:
      return $Nothing
  let result = @array.fill count 0
  let maximum = (65535.0, 65535.0, 65535.0, 65535.0)
  for group in 0 .. count / 4:
    let i = group * 4
    let a = @simd.load payload (2 + i * 2)
    let b = @simd.load payload (6 + i * 2)
    let range_a = @simd.u32x4.bit_and (@simd.f32x4.ge a zero) (@simd.f32x4.le a maximum)
    let range_b = @simd.u32x4.bit_and (@simd.f32x4.ge b zero) (@simd.f32x4.le b maximum)
    let integers = @simd.u32x4.bit_and (@simd.f32x4.eq (@simd.f32x4.floor a) a) (@simd.f32x4.eq (@simd.f32x4.floor b) b)
    if not (@simd.u32x4.all_true (@simd.u32x4.bit_and integers (@simd.u32x4.bit_and range_a range_b))):
      return $Nothing
    let lo = @simd.f32x4.to_u32 (@simd.f32x4.shuffle (0, 2, 4, 6) (a, b))
    let hi = @simd.f32x4.to_u32 (@simd.f32x4.shuffle (1, 3, 5, 7) (a, b))
    @simd.store result i (@simd.u32x4.bit_or lo (@simd.u32x4.shl hi 16))
  for i in count / 4 * 4 .. count:
    let at = 2 + i * 2
    let lo = payload[at]
    let hi = payload[at + 1]
    if not (lo >= 0.0 and lo <= 65535.0 and floor lo == lo and hi >= 0.0 and hi <= 65535.0 and floor hi == hi):
      return $Nothing
    result[i] := F32.to_u32 lo | (F32.to_u32 hi << 16)
  return $Some result

// Append directly to a packet owner. Fixed capacity uses the same zero padding as pack.
func append_packed (capacity: U32) -> (words: #[U32]) -> (out: own #[F32]) : #[F32] =>
  let count = words.length
  let size = if capacity == 0 then count else capacity
  lanes.require (count <= size and size <= (lanes.max_integer - 2) / 2)
  @storage.reserve out (2 + size * 2)
  @storage.push out (U32.to_f32 (count & 65535))
  @storage.push out (U32.to_f32 (count >> 16))
  for word in words:
    @storage.push out (U32.to_f32 (word & 65535))
    @storage.push out (U32.to_f32 (word >> 16))
  for 0 .. (size - count) * 2:
    @storage.push out 0.0
  return out

func no_migration (version: U32) -> (values: #[U32]) : Maybe (#[U32]) => $Nothing

// Metadata for word-native persistence and U32 host boundaries. Variable-width
// values need no F32 halves or component padding.
type Persistence a is data = $Persistence {
  key: U32, version: U32, encode: a -> #[U32],
  decode: #[U32] -> Maybe a,
  migrate: U32 -> #[U32] -> Maybe (#[U32]),
}
func saved key => func version => func encode => func decode => func migrate => return
  $Persistence { key, version, encode, decode, migrate }

// capacity=0 is variable-width (resources). For components, the caller chooses
// a positive maximum encoded word count; overflow rejects instead of truncating.
// Migrations receive old words independent of the old padding capacity.
func bridge (key: U32) => func (version: U32) => func (capacity: U32) => return
  func (encode: value -> #[U32]) => func (decode: #[U32] -> Maybe value) => func migrate =>
    let read = func payload =>
      let $Some payload = unpack capacity payload else:
        return panic "invalid Ink word framing"
      let $Some value = decode payload else:
        return panic "invalid derived Ink value"
      return value
    let migration = func saved -> payload =>
      if payload.length < 2:
        return panic "invalid migrated word framing"
      let $Some old = unpack ((payload.length - 2) / 2) payload else:
        return panic "invalid migrated word framing"
      return case migrate saved old of
        $Nothing => $Nothing
        $Some converted => $Some (pack capacity converted)
    return $lanes.Codec { key, version, encode: func value => pack capacity (encode value), decode: read, migrate: migration }

type Kind is data = $Unsigned | $Float | $Boolean | $Encoded
type Span is data = $Span {start: U32, count: U32}
type Field is data = $Field {id: U32, label: Span, type_name: Span, kind: Kind}
type Variant is data = $Variant {tag: U32, label: Span, fields: Span}
type Descriptor is data = $Descriptor {version: U32, variants: &[Variant], fields: &[Field], text: &[U32]}
func descriptor_text (descriptor: Descriptor) -> (span: Span) =>
  if span.start > descriptor.text.length or span.count > descriptor.text.length - span.start:
    return &descriptor.text[0..0]
  return &descriptor.text[span.start..span.start + span.count]
func variant_fields (descriptor: Descriptor) -> (variant: Variant) =>
  if variant.fields.start > descriptor.fields.length or variant.fields.count > descriptor.fields.length - variant.fields.start:
    return &descriptor.fields[0..0]
  return &descriptor.fields[variant.fields.start..variant.fields.start + variant.fields.count]
type Value is data = $UnsignedValue U32 | $FloatValue F32 | $BooleanValue Bool | $EncodedValue (&[U32])
type FieldView is data = $FieldView { field: Field, value: Value, words: &[U32] }
type View is data = $View { tag: U32, label: &[U32], fields: #[FieldView] }

func field_value (kind: Kind) -> (payload: &[U32]) : Maybe Value => case kind of
  $Unsigned => if payload.length == 1 then $Some ($UnsignedValue payload[0]) else $Nothing
  $Float => if payload.length == 1 then Maybe.map (func value => $FloatValue value) (float_from_word payload[0]) else $Nothing
  $Boolean => if payload.length == 1 and payload[0] <= 1 then $Some ($BooleanValue (payload[0] == 1)) else $Nothing
  $Encoded => $Some ($EncodedValue (&payload[0..payload.length]))
// Metadata and payload owners belong to the caller. Output FieldView rows are
// flat borrowed descriptors, never owners hidden inside a collection element.
func inspect (descriptor: Descriptor) -> decode -> payload -> (fields: own #[FieldView]) =>
  let encoded = array.generate payload.length (func i => payload[i])
  let $Some decoded = decode encoded else:
    return $Nothing
  if payload.length < 3 or payload[0] != descriptor.version:
    return $Nothing
  let found = $Nothing
  for variant in descriptor.variants:
    if variant.tag == payload[1]:
      found := $Some variant
  let $Some variant = found else:
    return $Nothing
  if variant.fields.start > descriptor.fields.length or variant.fields.count > descriptor.fields.length - variant.fields.start:
    return $Nothing
  if variant.label.start > descriptor.text.length or variant.label.count > descriptor.text.length - variant.label.start:
    return $Nothing
  let selected_fields = variant_fields descriptor variant
  if payload[2] != selected_fields.length:
    return $Nothing
  @storage.truncate fields 0
  let cursor = 3
  for field in selected_fields:
    if cursor > payload.length or payload.length - cursor < 2:
      return $Nothing
    let width = payload[cursor + 1]
    if payload[cursor] != field.id or width > payload.length - cursor - 2:
      return $Nothing
    let words = &payload[cursor + 2..cursor + 2 + width]
    let $Some value = field_value field.kind words else:
      return $Nothing
    @storage.push fields ($FieldView {field, value, words})
    cursor := cursor + 2 + width
  if cursor != payload.length:
    return $Nothing
  return $Some (decoded, $View {tag: variant.tag, label: descriptor_text descriptor variant.label, fields})

func same_words a => func b =>
  if a.length != b.length:
    return false
  for i in 0 .. a.length:
    if (a.at i) != (b.at i):
      return false
  return true

// Changed stable field ids. A variant change reports every new field; callers
// compare the separate tags to represent removed fields or nullary variants.
func changed (before: View) => func (after: View) =>
  let ids: #[U32] = #[]
  for current in after.fields:
    let equal = false
    if before.tag == after.tag:
      for old in before.fields:
        if old.field.id == current.field.id:
          equal := same_words old.words current.words
    if not equal:
      @storage.push ids current.field.id
  return ids

func Persistence.words (c: Persistence a) => {
  key: c.key, version: c.version, encode: c.encode, decode: c.decode, migrate: c.migrate,
}

// Comptime field/variant attribute tags for generic `#for #fields` / `#variants` codecs.
type FieldId is data = $FieldId U32
type Skip is data = $Skip
type VariantTag is data = $VariantTag U32

// Flat F32 lane encoding for `$lanes.Codec` records. These instances retain
// the original numeric casts and F32 bits; callers own save validation.
type LaneEncode a is trait = {
  to_lanes: a -> #[F32],
}
const F32.LaneEncode: LaneEncode F32 = {
  to_lanes: func value => #[value],
}
const U32.LaneEncode: LaneEncode U32 = {
  to_lanes: func value => #[U32.to_f32 value],
}
const Bool.LaneEncode: LaneEncode Bool = {
  to_lanes: func value => #[lanes.bit value],
}
const Vec2.LaneEncode: LaneEncode Vec2 = {
  to_lanes: func v => #[v.x, v.y],
}
const Vec3.LaneEncode: LaneEncode Vec3 = {
  to_lanes: func v => #[v.x, v.y, v.z],
}
const Vec4.LaneEncode: LaneEncode math.Vec4 = {
  to_lanes: func v => #[v.x, v.y, v.z, v.w],
}
const Quat.LaneEncode: LaneEncode math.Quat = {
  to_lanes: func q => #[q.x, q.y, q.z, q.w],
}
const Color.LaneEncode: LaneEncode math.Color = {
  to_lanes: func c => #[c.r, c.g, c.b, c.a],
}

// Fixed-width cursor readers return Nothing on malformed or truncated lanes.
// Record decoders impose their own field ranges and domain invariants.
type LaneDecode a is trait = {
  lane_width: a -> U32,
  from_lanes: #[F32] -> U32 -> Maybe (a, U32),
}

func read_lane (values: #[F32]) -> (at: U32): Maybe (a, U32) where { LaneDecode a } =>
  LaneDecode.from_lanes values at

func available (values: #[F32]) -> (at: U32) -> (width: U32) =>
  at <= values.length and width <= values.length - at

func finite_lanes (values: #[F32]) -> (at: U32) -> (width: U32) =>
  if not (available values at width):
    return false
  for i in at .. at + width:
    if not (is_finite values[i]):
      return false
  return true

func read_lane_f32 (values: #[F32]) -> (at: U32): Maybe (F32, U32) =>
  if not (finite_lanes values at 1):
    return $Nothing
  return $Some (values[at], at + 1)

const F32.LaneDecode: LaneDecode F32 = {
  lane_width: func _ => 1,
  from_lanes: read_lane_f32,
}

// Accept any U32 exactly representable in a lane. A particular wire format
// can require a smaller maximum, such as lanes.max_integer or a field limit.
func read_lane_u32 (values: #[F32]) -> (at: U32): Maybe (U32, U32) =>
  if not (available values at 1):
    return $Nothing
  let value = values[at]
  if not (value >= 0.0 and value < 4294967296.0 and floor value == value):
    return $Nothing
  return $Some (F32.to_u32 value, at + 1)

const U32.LaneDecode: LaneDecode U32 = {
  lane_width: func _ => 1,
  from_lanes: read_lane_u32,
}

func read_lane_bool (values: #[F32]) -> (at: U32): Maybe (Bool, U32) =>
  if not (available values at 1):
    return $Nothing
  let value = values[at]
  if value != 0.0 and value != 1.0:
    return $Nothing
  return $Some (value == 1.0, at + 1)

const Bool.LaneDecode: LaneDecode Bool = {
  lane_width: func _ => 1,
  from_lanes: read_lane_bool,
}

func read_lane_vec2 (values: #[F32]) -> (at: U32): Maybe (Vec2, U32) =>
  if not (finite_lanes values at 2):
    return $Nothing
  return $Some ($Vec2 { x: values[at], y: values[at + 1] }, at + 2)

const Vec2.LaneDecode: LaneDecode Vec2 = {
  lane_width: func _ => 2,
  from_lanes: read_lane_vec2,
}

func read_lane_vec3 (values: #[F32]) -> (at: U32): Maybe (Vec3, U32) =>
  if not (finite_lanes values at 3):
    return $Nothing
  return $Some ($Vec3 { x: values[at], y: values[at + 1], z: values[at + 2] }, at + 3)

const Vec3.LaneDecode: LaneDecode Vec3 = {
  lane_width: func _ => 3,
  from_lanes: read_lane_vec3,
}

func read_lane_vec4 (values: #[F32]) -> (at: U32): Maybe (math.Vec4, U32) =>
  if not (finite_lanes values at 4):
    return $Nothing
  return $Some ($math.Vec4 { x: values[at], y: values[at + 1], z: values[at + 2], w: values[at + 3] }, at + 4)

const Vec4.LaneDecode: LaneDecode math.Vec4 = {
  lane_width: func _ => 4,
  from_lanes: read_lane_vec4,
}

// Quat reads finite components. Existing pose codecs also require unit length.
func read_lane_quat (values: #[F32]) -> (at: U32): Maybe (math.Quat, U32) =>
  if not (finite_lanes values at 4):
    return $Nothing
  return $Some ($math.Quat { x: values[at], y: values[at + 1], z: values[at + 2], w: values[at + 3] }, at + 4)

const Quat.LaneDecode: LaneDecode math.Quat = {
  lane_width: func _ => 4,
  from_lanes: read_lane_quat,
}

func read_lane_color (values: #[F32]) -> (at: U32): Maybe (math.Color, U32) =>
  if not (finite_lanes values at 4):
    return $Nothing
  return $Some ($math.Color { r: values[at], g: values[at + 1], b: values[at + 2], a: values[at + 3] }, at + 4)

const Color.LaneDecode: LaneDecode math.Color = {
  lane_width: func _ => 4,
  from_lanes: read_lane_color,
}

// Generic comptime flat-lane encoder for any nominal record whose non-Skip
// fields implement `LaneEncode`. Visits fields in declared order and produces
// the exact flat `#[F32]` wire layout expected by `$lanes.Codec`.
func encode_lanes (value: t): #[F32] =>
  let out: #[F32] = #[]
  #for field in #fields t:
    #if not (field.has_tag $Skip):
      let part = LaneEncode.to_lanes value.(field)
      for lane in part:
        @storage.push out lane
  return out

// The value supplies field types for trait resolution. Widths are fixed by
// those types, and fields marked Skip need no LaneDecode instance.
func lane_count (value: t): U32 =>
  let count: U32 = 0
  #for field in #fields t:
    #if not (field.has_tag $Skip):
      count := self + LaneDecode.lane_width value.(field)
  return count

// Generic comptime flat-lane decoder paired with `encode_lanes`. Visits fields
// in declared order, decodes each non-Skip field through `LaneDecode`, and
// fills `@[$Skip]` fields from their declared `field.default`.
func decode_lanes (values: #[F32]): Maybe t =>
  let at: U32 = 0
  let built: t = #for field in #fields t:
    #if field.has_tag $Skip:
      break field.default
    #else:
      let $Some (value, next) = LaneDecode.from_lanes values at else:
        return $Nothing
      at := next
      break value
  if at != values.length:
    return $Nothing
  return $Some built

// Strict wrapper over `decode_lanes` matching `lanes.Codec`'s trap contract.
func require_lanes (values: #[F32]): t =>
  let decoded: Maybe t = decode_lanes values
  let $Some built = decoded else:
    return panic "invalid Ink numeric lanes"
  return built

// Zero-copy `&[F32]` slice flat-lane readers paired with `decode_lanes`.
type LaneSliceDecode a is trait = {
  from_lane_slice: &[F32] -> U32 -> Maybe (a, U32),
}

func read_lane_slice (values: &[F32]) -> (at: U32): Maybe (a, U32) where { LaneSliceDecode a } =>
  LaneSliceDecode.from_lane_slice values at

func slice_available (values: &[F32]) -> (at: U32) -> (width: U32): Bool =>
  at <= values.length and width <= values.length - at

func slice_finite (values: &[F32]) -> (at: U32) -> (width: U32): Bool =>
  if not (slice_available values at width):
    return false
  for i in at .. at + width:
    if not (is_finite values[i]):
      return false
  return true

func read_lane_slice_f32 (values: &[F32]) -> (at: U32): Maybe (F32, U32) =>
  if not (slice_finite values at 1):
    return $Nothing
  return $Some (values[at], at + 1)

const F32.LaneSliceDecode: LaneSliceDecode F32 = {
  from_lane_slice: read_lane_slice_f32,
}

func read_lane_slice_u32 (values: &[F32]) -> (at: U32): Maybe (U32, U32) =>
  if not (slice_available values at 1):
    return $Nothing
  let value = values[at]
  if not (value >= 0.0 and value < 4294967296.0 and floor value == value):
    return $Nothing
  return $Some (F32.to_u32 value, at + 1)

const U32.LaneSliceDecode: LaneSliceDecode U32 = {
  from_lane_slice: read_lane_slice_u32,
}

func read_lane_slice_bool (values: &[F32]) -> (at: U32): Maybe (Bool, U32) =>
  if not (slice_available values at 1):
    return $Nothing
  let value = values[at]
  if value != 0.0 and value != 1.0:
    return $Nothing
  return $Some (value == 1.0, at + 1)

const Bool.LaneSliceDecode: LaneSliceDecode Bool = {
  from_lane_slice: read_lane_slice_bool,
}

func read_lane_slice_vec2 (values: &[F32]) -> (at: U32): Maybe (Vec2, U32) =>
  if not (slice_finite values at 2):
    return $Nothing
  return $Some ($Vec2 { x: values[at], y: values[at + 1] }, at + 2)

const Vec2.LaneSliceDecode: LaneSliceDecode Vec2 = {
  from_lane_slice: read_lane_slice_vec2,
}

func read_lane_slice_vec3 (values: &[F32]) -> (at: U32): Maybe (Vec3, U32) =>
  if not (slice_finite values at 3):
    return $Nothing
  return $Some ($Vec3 { x: values[at], y: values[at + 1], z: values[at + 2] }, at + 3)

const Vec3.LaneSliceDecode: LaneSliceDecode Vec3 = {
  from_lane_slice: read_lane_slice_vec3,
}

func read_lane_slice_vec4 (values: &[F32]) -> (at: U32): Maybe (math.Vec4, U32) =>
  if not (slice_finite values at 4):
    return $Nothing
  return $Some ($math.Vec4 { x: values[at], y: values[at + 1], z: values[at + 2], w: values[at + 3] }, at + 4)

const Vec4.LaneSliceDecode: LaneSliceDecode math.Vec4 = {
  from_lane_slice: read_lane_slice_vec4,
}

func read_lane_slice_quat (values: &[F32]) -> (at: U32): Maybe (math.Quat, U32) =>
  if not (slice_finite values at 4):
    return $Nothing
  return $Some ($math.Quat { x: values[at], y: values[at + 1], z: values[at + 2], w: values[at + 3] }, at + 4)

const Quat.LaneSliceDecode: LaneSliceDecode math.Quat = {
  from_lane_slice: read_lane_slice_quat,
}

func read_lane_slice_color (values: &[F32]) -> (at: U32): Maybe (math.Color, U32) =>
  if not (slice_finite values at 4):
    return $Nothing
  return $Some ($math.Color { r: values[at], g: values[at + 1], b: values[at + 2], a: values[at + 3] }, at + 4)

const Color.LaneSliceDecode: LaneSliceDecode math.Color = {
  from_lane_slice: read_lane_slice_color,
}

func decode_lanes_slice (values: &[F32]): Maybe t =>
  let at: U32 = 0
  let built: t = #for field in #fields t:
    #if field.has_tag $Skip:
      break field.default
    #else:
      let $Some (value, next) = LaneSliceDecode.from_lane_slice values at else:
        return $Nothing
      at := next
      break value
  if at != values.length:
    return $Nothing
  return $Some built

// Flat little-endian `#[U8]` byte-lane codecs for compact binary wire formats.
// IEEE-754 F32/F64 lanes preserve exact finite bit patterns (signed zero,
// subnormals) and reject NaN/Inf on decode.
type ByteEncode a is trait = {
  byte_width: a -> U32,
  push_bytes: a -> own #[U8] -> #[U8],
}

type ByteDecode a is trait = {
  from_bytes: #[U8] -> U32 -> Maybe (a, U32),
}

type ByteSliceDecode a is trait = {
  from_byte_slice: &[U8] -> U32 -> Maybe (a, U32),
}

func push_le_u32 (word: U32) -> (out: own #[U8]): #[U8] =>
  @storage.push out (U32.to_u8 (word & 0xFF))
  @storage.push out (U32.to_u8 ((word >> 8) & 0xFF))
  @storage.push out (U32.to_u8 ((word >> 16) & 0xFF))
  @storage.push out (U32.to_u8 ((word >> 24) & 0xFF))
  return out

func push_le_u64 (word: U64) -> (out: own #[U8]): #[U8] =>
  out := push_le_u32 (U64.to_u32 word) self
  return push_le_u32 (U64.to_u32 (word >> 32)) out

func bytes_available (values: #[U8]) -> (at: U32) -> (width: U32): Bool =>
  at <= values.length and width <= values.length - at

func byte_slice_available (values: &[U8]) -> (at: U32) -> (width: U32): Bool =>
  at <= values.length and width <= values.length - at

func read_le_u32 (values: #[U8]) -> (at: U32): U32 =>
  U8.to_u32 values[at] | (U8.to_u32 values[at + 1] << 8) | (U8.to_u32 values[at + 2] << 16) | (U8.to_u32 values[at + 3] << 24)

func read_le_u32_slice (values: &[U8]) -> (at: U32): U32 =>
  U8.to_u32 values[at] | (U8.to_u32 values[at + 1] << 8) | (U8.to_u32 values[at + 2] << 16) | (U8.to_u32 values[at + 3] << 24)

func read_le_u64 (values: #[U8]) -> (at: U32): U64 =>
  U32.to_u64 (read_le_u32 values at) | (U32.to_u64 (read_le_u32 values (at + 4)) << 32)

func read_le_u64_slice (values: &[U8]) -> (at: U32): U64 =>
  U32.to_u64 (read_le_u32_slice values at) | (U32.to_u64 (read_le_u32_slice values (at + 4)) << 32)

func push_byte_u8 (v: U8) -> (out: own #[U8]): #[U8] =>
  @storage.push out v
  return out
func read_byte_u8 (values: #[U8]) -> (at: U32): Maybe (U8, U32) =>
  if not (bytes_available values at 1):
    return $Nothing
  return $Some (values[at], at + 1)
func read_byte_slice_u8 (values: &[U8]) -> (at: U32): Maybe (U8, U32) =>
  if not (byte_slice_available values at 1):
    return $Nothing
  return $Some (values[at], at + 1)
const U8.ByteEncode: ByteEncode U8 = { byte_width: func _ => 1, push_bytes: push_byte_u8 }
const U8.ByteDecode: ByteDecode U8 = { from_bytes: read_byte_u8 }
const U8.ByteSliceDecode: ByteSliceDecode U8 = { from_byte_slice: read_byte_slice_u8 }

func push_byte_bool (v: Bool) -> (out: own #[U8]): #[U8] =>
  let b: U8 = if v then 1 else 0
  @storage.push out b
  return out
func read_byte_bool (values: #[U8]) -> (at: U32): Maybe (Bool, U32) =>
  if not (bytes_available values at 1) or values[at] > 1:
    return $Nothing
  return $Some (values[at] == 1, at + 1)
func read_byte_slice_bool (values: &[U8]) -> (at: U32): Maybe (Bool, U32) =>
  if not (byte_slice_available values at 1) or values[at] > 1:
    return $Nothing
  return $Some (values[at] == 1, at + 1)
const Bool.ByteEncode: ByteEncode Bool = { byte_width: func _ => 1, push_bytes: push_byte_bool }
const Bool.ByteDecode: ByteDecode Bool = { from_bytes: read_byte_bool }
const Bool.ByteSliceDecode: ByteSliceDecode Bool = { from_byte_slice: read_byte_slice_bool }

func read_byte_u32 (values: #[U8]) -> (at: U32): Maybe (U32, U32) =>
  if not (bytes_available values at 4):
    return $Nothing
  return $Some (read_le_u32 values at, at + 4)
func read_byte_slice_u32 (values: &[U8]) -> (at: U32): Maybe (U32, U32) =>
  if not (byte_slice_available values at 4):
    return $Nothing
  return $Some (read_le_u32_slice values at, at + 4)
const U32.ByteEncode: ByteEncode U32 = { byte_width: func _ => 4, push_bytes: push_le_u32 }
const U32.ByteDecode: ByteDecode U32 = { from_bytes: read_byte_u32 }
const U32.ByteSliceDecode: ByteSliceDecode U32 = { from_byte_slice: read_byte_slice_u32 }

func push_byte_i32 (v: I32) -> (out: own #[U8]): #[U8] => push_le_u32 (I32.to_u32 v) out
func read_byte_i32 (values: #[U8]) -> (at: U32): Maybe (I32, U32) =>
  if not (bytes_available values at 4):
    return $Nothing
  return $Some (U32.to_i32 (read_le_u32 values at), at + 4)
func read_byte_slice_i32 (values: &[U8]) -> (at: U32): Maybe (I32, U32) =>
  if not (byte_slice_available values at 4):
    return $Nothing
  return $Some (U32.to_i32 (read_le_u32_slice values at), at + 4)
const I32.ByteEncode: ByteEncode I32 = { byte_width: func _ => 4, push_bytes: push_byte_i32 }
const I32.ByteDecode: ByteDecode I32 = { from_bytes: read_byte_i32 }
const I32.ByteSliceDecode: ByteSliceDecode I32 = { from_byte_slice: read_byte_slice_i32 }

func read_byte_u64 (values: #[U8]) -> (at: U32): Maybe (U64, U32) =>
  if not (bytes_available values at 8):
    return $Nothing
  return $Some (read_le_u64 values at, at + 8)
func read_byte_slice_u64 (values: &[U8]) -> (at: U32): Maybe (U64, U32) =>
  if not (byte_slice_available values at 8):
    return $Nothing
  return $Some (read_le_u64_slice values at, at + 8)
const U64.ByteEncode: ByteEncode U64 = { byte_width: func _ => 8, push_bytes: push_le_u64 }
const U64.ByteDecode: ByteDecode U64 = { from_bytes: read_byte_u64 }
const U64.ByteSliceDecode: ByteSliceDecode U64 = { from_byte_slice: read_byte_slice_u64 }

func push_byte_i64 (v: I64) -> (out: own #[U8]): #[U8] => push_le_u64 (I64.to_u64 v) out
func read_byte_i64 (values: #[U8]) -> (at: U32): Maybe (I64, U32) =>
  if not (bytes_available values at 8):
    return $Nothing
  return $Some (U64.to_i64 (read_le_u64 values at), at + 8)
func read_byte_slice_i64 (values: &[U8]) -> (at: U32): Maybe (I64, U32) =>
  if not (byte_slice_available values at 8):
    return $Nothing
  return $Some (U64.to_i64 (read_le_u64_slice values at), at + 8)
const I64.ByteEncode: ByteEncode I64 = { byte_width: func _ => 8, push_bytes: push_byte_i64 }
const I64.ByteDecode: ByteDecode I64 = { from_bytes: read_byte_i64 }
const I64.ByteSliceDecode: ByteSliceDecode I64 = { from_byte_slice: read_byte_slice_i64 }

func push_le_f32 (v: F32) -> (out: own #[U8]): #[U8] =>
  use lanes.require (is_finite v)
  return push_le_u32 (F32.to_bits v) out
func read_byte_f32 (values: #[U8]) -> (at: U32): Maybe (F32, U32) =>
  if not (bytes_available values at 4):
    return $Nothing
  let v = F32.from_bits (read_le_u32 values at)
  if not (is_finite v):
    return $Nothing
  return $Some (v, at + 4)
func read_byte_slice_f32 (values: &[U8]) -> (at: U32): Maybe (F32, U32) =>
  if not (byte_slice_available values at 4):
    return $Nothing
  let v = F32.from_bits (read_le_u32_slice values at)
  if not (is_finite v):
    return $Nothing
  return $Some (v, at + 4)
const F32.ByteEncode: ByteEncode F32 = { byte_width: func _ => 4, push_bytes: push_le_f32 }
const F32.ByteDecode: ByteDecode F32 = { from_bytes: read_byte_f32 }
const F32.ByteSliceDecode: ByteSliceDecode F32 = { from_byte_slice: read_byte_slice_f32 }

func push_le_f64 (v: F64) -> (out: own #[U8]): #[U8] =>
  use lanes.require (F64.is_finite v)
  return push_le_u64 (F64.to_bits v) out
func read_byte_f64 (values: #[U8]) -> (at: U32): Maybe (F64, U32) =>
  if not (bytes_available values at 8):
    return $Nothing
  let v = F64.from_bits (read_le_u64 values at)
  if not (F64.is_finite v):
    return $Nothing
  return $Some (v, at + 8)
func read_byte_slice_f64 (values: &[U8]) -> (at: U32): Maybe (F64, U32) =>
  if not (byte_slice_available values at 8):
    return $Nothing
  let v = F64.from_bits (read_le_u64_slice values at)
  if not (F64.is_finite v):
    return $Nothing
  return $Some (v, at + 8)
const F64.ByteEncode: ByteEncode F64 = { byte_width: func _ => 8, push_bytes: push_le_f64 }
const F64.ByteDecode: ByteDecode F64 = { from_bytes: read_byte_f64 }
const F64.ByteSliceDecode: ByteSliceDecode F64 = { from_byte_slice: read_byte_slice_f64 }

func push_byte_vec2 (v: Vec2) -> (out: own #[U8]): #[U8] =>
  out := push_le_f32 v.x self
  return push_le_f32 v.y out
func read_byte_vec2 (values: #[U8]) -> (at: U32): Maybe (Vec2, U32) =>
  let $Some (x, at) = read_byte_f32 values at else:
    return $Nothing
  let $Some (y, at) = read_byte_f32 values at else:
    return $Nothing
  return $Some ($Vec2 { x, y }, at)
func read_byte_slice_vec2 (values: &[U8]) -> (at: U32): Maybe (Vec2, U32) =>
  let $Some (x, at) = read_byte_slice_f32 values at else:
    return $Nothing
  let $Some (y, at) = read_byte_slice_f32 values at else:
    return $Nothing
  return $Some ($Vec2 { x, y }, at)
const Vec2.ByteEncode: ByteEncode Vec2 = { byte_width: func _ => 8, push_bytes: push_byte_vec2 }
const Vec2.ByteDecode: ByteDecode Vec2 = { from_bytes: read_byte_vec2 }
const Vec2.ByteSliceDecode: ByteSliceDecode Vec2 = { from_byte_slice: read_byte_slice_vec2 }

func push_byte_vec3 (v: Vec3) -> (out: own #[U8]): #[U8] =>
  out := push_le_f32 v.x self
  out := push_le_f32 v.y self
  return push_le_f32 v.z out
func read_byte_vec3 (values: #[U8]) -> (at: U32): Maybe (Vec3, U32) =>
  let $Some (x, at) = read_byte_f32 values at else:
    return $Nothing
  let $Some (y, at) = read_byte_f32 values at else:
    return $Nothing
  let $Some (z, at) = read_byte_f32 values at else:
    return $Nothing
  return $Some ($Vec3 { x, y, z }, at)
func read_byte_slice_vec3 (values: &[U8]) -> (at: U32): Maybe (Vec3, U32) =>
  let $Some (x, at) = read_byte_slice_f32 values at else:
    return $Nothing
  let $Some (y, at) = read_byte_slice_f32 values at else:
    return $Nothing
  let $Some (z, at) = read_byte_slice_f32 values at else:
    return $Nothing
  return $Some ($Vec3 { x, y, z }, at)
const Vec3.ByteEncode: ByteEncode Vec3 = { byte_width: func _ => 12, push_bytes: push_byte_vec3 }
const Vec3.ByteDecode: ByteDecode Vec3 = { from_bytes: read_byte_vec3 }
const Vec3.ByteSliceDecode: ByteSliceDecode Vec3 = { from_byte_slice: read_byte_slice_vec3 }

func push_byte_vec4 (v: math.Vec4) -> (out: own #[U8]): #[U8] =>
