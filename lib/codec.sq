const Vec4.ByteEncode: ByteEncode math.Vec4 = { byte_width: func _ => 16, push_bytes: push_byte_vec4 }
const Vec4.ByteDecode: ByteDecode math.Vec4 = { from_bytes: read_byte_vec4 }
const Vec4.ByteSliceDecode: ByteSliceDecode math.Vec4 = { from_byte_slice: read_byte_slice_vec4 }

func push_byte_quat (q: math.Quat) -> (out: own #[U8]): #[U8] =>
  out := push_le_f32 q.x self
  out := push_le_f32 q.y self
  out := push_le_f32 q.z self
  return push_le_f32 q.w out
func read_byte_quat (values: #[U8]) -> (at: U32): Maybe (math.Quat, U32) =>
