//! xorshift32 with explicit caller-owned state. Zero would stay zero; it
//! restarts from a fixed odd seed instead.
//!
//! Key items: [`next`], [`unit`], [`between`], [`angle`], [`chance`].
//!
//! ```squid
//! let s1 = next 12345
//! let s2 = next s1
//! s1 != 0 and s1 != s2 and unit s1 >= 0.0 and unit s1 < 1.0 // => true
//! ```

func next (state: U32) : U32 =>
  let x = state
  if x == 0:
    x := 2654435769
  x := self ^ (self << 13)
  x := self ^ (self >> 17)
  x := self ^ (self << 5)
  return x

// A number in [0, 1) from the state's high 24 bits.
func unit (state: U32) => U32.to_f32 (state >> 8) / 16777216.0

func between (low: F32) => func (high: F32) => func (seed: U32) =>
  let u = unit seed
  let span = high - low
  if is_finite span:
    return low + span * u
  return low * (1.0 - u) + high * u
func angle (seed: U32) => unit seed * tau
func chance (probability: F32) => func (seed: U32) => unit seed < probability
func below (count: U32) => func (seed: U32) =>
  if count == 0:
    return 0
  return seed % count
func branch (seed: U32) => func (index: U32) => next (seed ^ (index * 2654435769))
