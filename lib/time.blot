// Seconds and state belong to the caller. No clock or simulation is hidden here.
type Step is data = $Step { steps: U32, remainder: F32, alpha: F32, dropped: F32 }
type Timer is data = $Timer { remaining: F32 }
type Tick is data = $Tick { timer: Timer, expired: Bool, overshoot: F32 }

// Carry remainder into the next call. Run `steps` updates of `step` seconds.
// Excess whole steps are discarded; their seconds are reported as `dropped`.
// The fractional remainder is retained, with alpha in [0, 1).
// Zero limit discards every whole step. Invalid/overflowing inputs return Nothing.
//
// The checks and arithmetic live in scalar helpers, keeping `and`/`or` out of
// `fixed` and `tick` so that loops inline them and keep their results in
// locals.

// Whole ticks in remainder + delta, or -1 for invalid input.
private func whole_ticks (step: F32) => return func (remainder: F32) => return func (delta: F32) => return do:
  if Bool.not (is_finite step) or step <= 0.0 or Bool.not (is_finite remainder) or remainder < 0.0 or Bool.not (is_finite delta) or delta < 0.0:
    return (-1.0)
  let total = remainder + delta
  let whole = floor (total / step)
  if Bool.not (is_finite total) or Bool.not (is_finite whole):
    return (-1.0)
  // Count and residue must share the same rounded product. Division can round
  // up to a whole tick whose product exceeds total by an ULP; clamp that tiny
  // negative residue instead of wrapping it into another tick of elapsed time.
  let rest = max 0.0 (total - whole * step)
  if rest >= step:
    whole := self + floor (rest / step)
  return whole

// The residue after `whole` ticks. At huge quotients, a tick is below F32's
// elapsed-time resolution, and the residue is dropped.
private func residue (total: F32) => return func (step: F32) => return func (whole: F32) => return do:
  let rest = max 0.0 (total - whole * step)
  if rest >= step:
    return 0.0
  return rest

// Bound before integer conversion. At equality a large limit may have
// rounded down in F32, so retain the exact U32 minimum when conversion fits.
private func bounded_steps (whole: F32) => return func (limit: U32) => return do:
  let steps = limit
  if whole <= U32.to_f32 limit and whole < 4294967296.0:
    steps := F32.to_u32 whole
    if steps > limit:
      steps := limit
  return steps

func fixed (step: F32) => return func (limit: U32) => return func (remainder: F32) => return func (delta: F32) : Maybe Step => return do:
  let whole = whole_ticks step remainder delta
  if whole < 0.0:
    return $Nothing
  let total = remainder + delta
  let rest = residue total step whole
  let steps = bounded_steps whole limit
  let consumed = U32.to_f32 steps * step
  if Bool.not (is_finite consumed):
    return $Nothing
  return $Some ($Step { steps, remainder: rest, alpha: rest / step, dropped: max 0.0 (total - rest - consumed) })

// A timer at zero is already finished. Negative/non-finite durations are invalid.
func timer (duration: F32) : Maybe Timer => return do:
  if Bool.not (is_finite duration):
    return $Nothing
  if duration < 0.0:
    return $Nothing
  return $Some ($Timer { remaining: duration })

func done (value: Timer) => return value.remaining == 0.0

private func valid_tick (remaining: F32) => return func (delta: F32) => return
  is_finite remaining and remaining >= 0.0 and is_finite delta and delta >= 0.0

// `expired` is the transition to zero, fired once. `overshoot` is the unused
// part of this delta, including all of it when the timer was already finished.
func tick (value: Timer) => return func (delta: F32) : Maybe Tick => return do:
  let previous = value.remaining
  if Bool.not (valid_tick previous delta):
    return $Nothing
  let remaining = max 0.0 (previous - delta)
  return $Some ($Tick {
    timer: $Timer { remaining },
    expired: if previous > 0.0 then remaining == 0.0 else false,
    overshoot: max 0.0 (delta - previous),
  })
