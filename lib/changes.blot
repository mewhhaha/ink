import * as array from "std/array"
import * as sort from "./sort"

// Explicit caller-owned invalidation. Removal wins within a batch; a later
// batch wins when composing. Reset discards every earlier retained value.
type Changes is data = #Changes { reset: Bool, updated: Array U32, removed: Array U32 }
const unique = fn (values: Array U32) => do:
  let ordered = #True
  for i in 1 .. values.length:
    if values[i] <= values[i - 1]:
      ordered := #False
      break
  if ordered:
    return values
  let order = sort.order_u32 values
  let output = array.fill values.length 0
  let count = 0
  for at in order:
    let value = values[at]
    if count == 0 || output[count - 1] != value:
      output[count] := value
      count := self + 1
  return array.slice 0 count output
const contains = fn (values: Array U32) => fn (value: U32) => do:
  let low = 0
  let high = values.length
  for 0 .. 32:
    if low >= high:
      break
    let middle = low + (high - low) / 2
    if values[middle] < value:
      low := middle + 1
    else:
      high := middle
  return low < values.length && values[low] == value
const without = fn (values: Array U32) => fn (excluded: Array U32) => do:
  if excluded.length == 0:
    return values
  let out = array.fill values.length 0
  let count = 0
  for value in values:
    if Bool.not (contains excluded value):
      out[count] := value
      count := self + 1
  return array.slice 0 count out
const make = fn reset => fn updated => fn removed => do:
  let removed = unique removed
  return #Changes { reset, updated: difference (unique updated) removed, removed }
const empty = #Changes { reset: #False, updated: #[], removed: #[] }
const affected = fn (changes: Changes) => do:
  if changes.removed.length == 0:
    return unique changes.updated
  if changes.updated.length == 0:
    return unique changes.removed
  return union (unique changes.updated) (unique changes.removed)
const compose = fn (earlier: Changes) => fn (later: Changes) => do:
  let later = make later.reset later.updated later.removed
  if later.reset:
    return later
  let touched = union later.updated later.removed
  let removed = union (difference (unique earlier.removed) touched) later.removed
  let updated = union (difference (unique earlier.updated) touched) later.updated
  return #Changes { reset: earlier.reset, updated: difference updated removed, removed }

// Apply a membership delta to sorted unique keys. This is also an explicit
// active set: updated wakes keys, removed sleeps them, and reset starts empty.
// Full-width keys have no reserved sentinel. The old set remains a snapshot.
const apply = fn (change: Changes) (before: Array U32) => do:
  let delta = make change.reset change.updated change.removed
  let kept = if delta.reset then #[] else difference before delta.removed
  return union kept delta.updated

// Sorted unique set operations. Keep `without` for arbitrary source order.
// Binary search wins when scanning the larger exclusion set would dominate.
const difference = fn (values: Array U32) (excluded: Array U32) => do:
  if values.length == 0 || excluded.length == 0:
    return values
  if values.length < excluded.length / 16:
    return without values excluded
  let out = array.fill values.length 0
  let count = 0
  let next = 0
  for value in values:
    for next .. excluded.length:
      if excluded[next] >= value:
        break
      next := self + 1
    if next == excluded.length || excluded[next] != value:
      out[count] := value
      count := self + 1
  return array.slice 0 count out
const union = fn (a: Array U32) (b: Array U32) => do:
  if a.length == 0:
    return b
  if b.length == 0:
    return a
  if a.length > 0xFFFFFFFF - b.length:
    return @panic "set union capacity overflows"
  let out = array.fill (a.length + b.length) 0
  let left = 0
  let right = 0
  let count = 0
  for 0 .. out.length:
    if left == a.length && right == b.length:
      break
    let value = 0
    if right == b.length:
      value := a[left]
      left := self + 1
    else:
      if left == a.length:
        value := b[right]
        right := self + 1
      else:
        value := min a[left] b[right]
        if a[left] == value:
          left := self + 1
        if b[right] == value:
          right := self + 1
    out[count] := value
    count := self + 1
  return array.slice 0 count out
