import * as array from "std/array"
import { Vec3 } from "std/vector"

// Append-only floor-plane points with caller-owned flat hash chains. Source
// indices stay stable; payloads and deletion/eligibility belong to the caller.
type Point is data = $Point { x: F32, z: F32, cx: F32, cz: F32, next: U32 }
type Grid [heads, points] is data = $Grid { size: F32, mask: U32, heads: heads, points: points }
type Storage is data = $Storage {heads: ResizeArray U32, points: ResizeArray Point}
type Span is data = $Span {start: U32, count: U32, capacity: U32}
type Stored is data = $Stored {size: F32, mask: U32, heads: Span, points: Span}
const save_rows = func (destination: ResizeArray a) -> (previous: Span) -> source => return do:
  let start = previous.start
  let capacity = previous.capacity
  if source.length > capacity:
    start := destination.length
    capacity := max source.length (max 16 (capacity * 2))
    for _ in 0 .. capacity:
      @storage.push destination (source.at 0)
  for index in 0 .. source.length:
    if start + index < destination.length:
      destination[start + index] := source.at index
    else:
      @storage.push destination (source.at index)
  return $Span {start, count: source.length, capacity}
const empty_span = $Span {start: 0, count: 0, capacity: 0}
const store = func (storage: Storage) -> (previous: Maybe Stored) -> grid => return do:
  let heads = case previous of
    $Some old => old.heads
    $Nothing => empty_span
  let points = case previous of
    $Some old => old.points
    $Nothing => empty_span
  return $Stored {size: grid.size, mask: grid.mask, heads: save_rows storage.heads heads grid.heads, points: save_rows storage.points points grid.points}
const read = func (storage: Storage) -> (stored: Stored) => return $Grid {size: stored.size, mask: stored.mask,
  heads: &storage.heads[stored.heads.start..stored.heads.start + stored.heads.count],
  points: &storage.points[stored.points.start..stored.points.start + stored.points.count]}
const word = func (cell: F32) => return F32.to_u32 (abs cell) * 2 + (if cell < 0.0 then 1 else 0)
const bucket = func (mask: U32) -> (x: F32) -> (z: F32) => return ((word x * 73856093) ^ (word z * 19349663)) & mask
const point = func (size: F32) -> (at: Vec3) -> (next: U32) => return do:
  let cx = floor (at.x / size)
  let cz = floor (at.z / size)
  if Bool.not (is_finite cx and is_finite cz) or abs cx >= 1073741824.0 or abs cz >= 1073741824.0:
    return @panic "point grid coordinate exceeds its integer range"
  return $Point { x: at.x, z: at.z, cx, cz, next }
// The caller retains the two destination owners. Construction temporaries
// are individually named flat arrays, and only a plain descriptor returns.
const build_into = func (storage: Storage) -> previous -> (size: F32) -> (hint: U32) -> positions => return do:
  if Bool.not (is_finite size) or size <= 0.0:
    return @panic "point grid size must be positive"
  let buckets: U32 = 16
  for _ in 0 .. 16:
    if buckets >= min 1048576 hint:
      break
    buckets := self * 2
  let mask = buckets - 1
  let heads = array.fill buckets 0
  let links = array.fill positions.length 0
  for index in 0 .. positions.length:
    let p = point size positions[index] 0
    let key = bucket mask p.cx p.cz
    links[index] := heads[key]
    heads[key] := index + 1
  let points = array.generate positions.length (func index => return point size positions[index] links[index])
  return store storage previous $Grid {size, mask, heads, points}
// Stored indices grow their point extent geometrically. Heads and source
// indices remain stable; callers publish the returned plain descriptor.
const push_stored = func (storage: Storage) -> (stored: Stored) -> (at: Vec3) => return do:
  let p = point stored.size at 0
  let key = bucket stored.mask p.cx p.cz
  p.next := storage.heads[stored.heads.start + key]
  let index = stored.points.count
  if index >= stored.points.capacity:
    let old = stored.points
    let start = storage.points.length
    let capacity = max 16 (max (index + 1) (old.capacity * 2))
    for _ in 0 .. capacity:
      @storage.push storage.points p
    for offset in 0 .. old.count:
      storage.points[start + offset] := storage.points[old.start + offset]
    stored.points := $Span {start, count: old.count, capacity}
  storage.points[stored.points.start + index] := p
  storage.heads[stored.heads.start + key] := index + 1
  stored.points.count := index + 1
  return stored
// Each source appears once, including hash collisions and cell boundaries.
// Order is intentionally unspecified; callers resolve ties by source index.
const within = func (grid: Grid [&[U32], &[Point]]) -> (x: F32) -> (z: F32) -> (radius: F32) : Array U32 => return do:
  if Bool.not (is_finite x and is_finite z and is_finite radius) or radius < 0.0:
    return #[]
  let left = floor ((x - radius) / grid.size)
  let top = floor ((z - radius) / grid.size)
  let columns = floor ((x + radius) / grid.size) - left + 1.0
  let rows = floor ((z + radius) / grid.size) - top + 1.0
  // A broad query should cost at most a scan, not millions of empty cells.
  // Check before converting its cell extent to an integer.
  if Bool.not (is_finite columns and is_finite rows) or columns * rows > U32.to_f32 grid.points.length:
    let found: GrowArray U32 = #[]
    for index in 0 .. grid.points.length:
      let p = grid.points[index]
      let dx = p.x - x
      let dz = p.z - z
      if dx * dx + dz * dz <= radius * radius:
        @storage.push found index
    return @storage.freeze found
  let width = F32.to_u32 columns
  let height = F32.to_u32 rows
  let found: GrowArray U32 = #[]
  for row in 0 .. height:
    let cz = top + U32.to_f32 row
    for col in 0 .. width:
      let cx = left + U32.to_f32 col
      let link = grid.heads[bucket grid.mask cx cz]
      for _ in 0 .. grid.points.length:
        if link == 0:
          break
        let index = link - 1
        let p = grid.points[index]
        if p.cx == cx and p.cz == cz:
          let dx = p.x - x
          let dz = p.z - z
          if dx * dx + dz * dz <= radius * radius:
            @storage.push found index
        link := p.next
  return @storage.freeze found
