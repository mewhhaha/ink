import { Vec3 } from "std/vector"
import * as array from "std/array"
import * as spatial from "../spatial"

// Exact nearest points in the x/z plane. Caller indices break equal-distance
// ties. Keep this immutable index with its source positions and rebuild when
// membership or positions change; counts and other payloads do not matter.
const build = fn (points: Array Vec3) => do:
  for point in points:
    if Bool.not (is_finite point.x && is_finite point.z):
      return @panic "point index requires finite coordinates"
  return spatial.build (array.map (fn p => do:
    let point = #Vec3 { x: p.x, y: 0.0, z: p.z }
    return #spatial.Bounds { low: point, high: point }) points)

const distance = fn (bounds: Array F32) (node: U32) (at: Vec3) => do:
  let offset = node * 6
  let x = max 0.0 (max (bounds[offset] - at.x) (at.x - bounds[offset + 3]))
  let z = max 0.0 (max (bounds[offset + 2] - at.z) (at.z - bounds[offset + 5]))
  return x * x + z * z

const nearest = fn index at => nearest_where (fn id => #True) index at
const nearest_where = fn eligible (index: spatial.Index) (at: Vec3) => do:
  if index.order.length == 0 || Bool.not (is_finite at.x && is_finite at.z):
    return #Nothing
  let stack = array.fill 64 0
  stack[0] := 1
  let top = 1
  let best = 4294967295
  let closest = (1.0 / 0.0)
  for 0 .. index.base * 2:
    if top == 0:
      break
    top := self - 1
    let node = stack[top]
    let apart = distance index.bounds node at
    if apart <= closest:
      if node >= index.base:
        let leaf = node - index.base
        if leaf < index.order.length:
          let id = index.order[leaf]
          if eligible id && (apart < closest || (apart == closest && id < best)):
            best := id
            closest := apart
      else:
        let a = node * 2
        let b = a + 1
        let first = if distance index.bounds a at <= distance index.bounds b at then a else b
        stack[top] := if first == a then b else a
        stack[top + 1] := first
        top := self + 2
  return if best == 4294967295 then #Nothing else #Some best
