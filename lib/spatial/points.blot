import { Vec3 } from "std/vector"
import * as array from "std/array"
import * as spatial from "../spatial"

// Exact nearest points in the x/z plane. Caller indices break equal-distance
// ties. Keep this immutable index with its source positions and rebuild when
// membership or positions change; counts and other payloads do not matter.
type Index is data = $Index {base: U32, bounds: &[F32], order: &[U32]}
type Storage is data = $Storage {bounds: #[F32], order: #[U32], leaves: #[U32]}
type Stored is data = $Stored {base: U32, count: U32}
const empty = $Stored {base: 1, count: 0}
func build_into (storage: own Storage) -> (points: #[Vec3]) : (Stored, Storage) =>
  for point in points:
    if not (is_finite point.x and is_finite point.z):
      return panic "point index requires finite coordinates"
  let bounds = array.map (func p =>
    let point = $Vec3 {x: p.x, y: 0.0, z: p.z}
    return $spatial.Bounds {low: point, high: point}) points
  let (base, tree_bounds, order, leaves) = spatial.build_columns bounds
  storage.bounds := spatial.replace_fixed self tree_bounds
  storage.order := spatial.replace_fixed self order
  storage.leaves := spatial.replace_fixed self leaves
  return ($Stored {base, count: points.length}, storage)
func read (storage: Storage) -> (stored: Stored) => $Index {
  base: stored.base, bounds: &storage.bounds[0..if stored.count == 0 then 0 else stored.base * 12], order: &storage.order[0..stored.count]}
func with_index (positions: #[Vec3]) -> consume =>
  let bounds: #[F32] = #[]
  let order: #[U32] = #[]
  let leaves: #[U32] = #[]
  let storage = $Storage {bounds, order, leaves}
  let (stored, storage) = build_into storage positions
  return consume (read storage stored)

const distance = distance_offset 0.0
func distance_offset (vertical_squared: F32) -> (bounds: &[F32]) -> (node: U32) -> (at: Vec3) =>
  let offset = node * 6
  let x = max 0.0 (max (bounds[offset] - at.x) (at.x - bounds[offset + 3]))
  let z = max 0.0 (max (bounds[offset + 2] - at.z) (at.z - bounds[offset + 5]))
  return (x * x + vertical_squared) + z * z

private func half_distance (vertical_half: F32) -> (bounds: &[F32]) -> (node: U32) -> (at: Vec3) : F32 =>
  let offset = node * 6
  let hx = max 0.0 (max (bounds[offset] * 0.5 - at.x * 0.5) (at.x * 0.5 - bounds[offset + 3] * 0.5))
  let hz = max 0.0 (max (bounds[offset + 2] * 0.5 - at.z * 0.5) (at.z * 0.5 - bounds[offset + 5] * 0.5))
  let m = max vertical_half (max hx hz)
  if m == 0.0:
    return 0.0
  let sx = hx / m
  let sz = hz / m
  let sv = vertical_half / m
  // Scale by 0.5 so even maximum F32 separation * sqrt(3) stays finite.
  return (m * 0.5) * sqrt (sx * sx + sz * sz + sv * sv)

private func box_within_radius (bounds: &[F32]) -> (node: U32) -> (at: Vec3) -> (radius: F32) : Bool =>
  let offset = node * 6
  let hx = max 0.0 (max (bounds[offset] * 0.5 - at.x * 0.5) (at.x * 0.5 - bounds[offset + 3] * 0.5))
  let hz = max 0.0 (max (bounds[offset + 2] * 0.5 - at.z * 0.5) (at.z * 0.5 - bounds[offset + 5] * 0.5))
  let hr = radius * 0.5
  let m = max hx hz
  if not (is_finite m and is_finite hr):
    return false
  if m == 0.0:
    return true
  if m > hr:
    return false
  let sx = hx / m
  let sz = hz / m
  let sr = hr / m
  return sx * sx + sz * sz <= sr * sr

func nearest index -> at => nearest_where (func id => true) index at
const nearest_where = nearest_where_offset 0.0
// Preserve the caller's squared-distance rounding to a common horizontal plane.
func nearest_where_offset (vertical_squared: F32) -> eligible -> (index: Index) -> (at: Vec3) =>
  if index.order.length == 0 or not (is_finite at.x and is_finite at.z and is_finite vertical_squared) or vertical_squared < 0.0:
    return $Nothing
  let vertical_half = sqrt vertical_squared * 0.5
  let stack = array.fill 64 0
  stack[0] := 1
  let top = 1
  let best = 4294967295
  let closest = (1.0 / 0.0)
  let closest_half = (1.0 / 0.0)
  for 0 .. index.base * 2:
    if top == 0:
      break
    top := self - 1
    let node = stack[top]
    let apart = distance_offset vertical_squared index.bounds node at
    let apart_ok = is_finite apart
    let hd = if apart_ok and is_finite closest then 0.0 else half_distance vertical_half index.bounds node at
    let may_improve = if is_finite closest then (apart_ok and apart <= closest) else (hd <= closest_half)
    if may_improve:
      if node >= index.base:
        let leaf = node - index.base
        if leaf < index.order.length:
          let id = index.order[leaf]
          let better = if apart_ok then (apart < closest or (apart == closest and id < best)) else (not (is_finite closest) and (hd < closest_half or (hd == closest_half and id < best)))
          if eligible id and better:
            best := id
            closest := apart
            closest_half := if apart_ok then half_distance vertical_half index.bounds node at else hd
      else:
        let a = node * 2
        let b = a + 1
        let da = distance_offset vertical_squared index.bounds a at
        let db = distance_offset vertical_squared index.bounds b at
        let a_first = if is_finite da or is_finite db then da <= db else half_distance vertical_half index.bounds a at <= half_distance vertical_half index.bounds b at
        let first = if a_first then a else b
        stack[top] := if first == a then b else a
        stack[top + 1] := first
        top := self + 2
  return if best == 4294967295 then $Nothing else $Some best

func within_into (index: Index) -> (at: Vec3) -> (radius: F32) -> (out: own #[U32]) : #[U32] =>
  if index.order.length == 0 or not (is_finite at.x and is_finite at.z) or not (is_finite radius) or radius < 0.0:
    return out
  let r2 = radius * radius
  let r2_ok = is_finite r2
  let stack = array.fill 64 0
  stack[0] := 1
  let top = 1
  for 0 .. index.base * 2:
    if top == 0:
      break
    top := self - 1
    let node = stack[top]
    let apart = distance index.bounds node at
    let inside = if r2_ok and is_finite apart then apart <= r2 else box_within_radius index.bounds node at radius
    if inside:
      if node >= index.base:
        let leaf = node - index.base
        if leaf < index.order.length:
          @storage.push out index.order[leaf]
      else:
        let a = node * 2
        let b = a + 1
        stack[top] := b
        stack[top + 1] := a
        top := self + 2
  return out
