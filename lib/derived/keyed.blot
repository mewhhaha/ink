// A discardable value and the complete dependency key that produced it.
// Callers own revisions, equality, storage and rebuilding. Restores start cold.
type Cache [key, value] is data = $Cold | $Cached { key: key, value: value }
func read equal => func key => func cached => case cached of
  $Cached { key: before, value } if equal key before => $Some value
  _ => $Nothing
func keep key => func value => $Cached { key, value }
func resolve equal => func build => func key => func cached => case read equal key cached of
  $Some value => (cached, value)
  $Nothing => do:
    let value = build key
    break (keep key value, value)
// Revisions are keys only: callers bump them at the operation that owns a change.
// An epoch distinguishes replacement from an explicitly retained snapshot.
type Revision is data = $Revision { epoch: U32, change: U32 }
const initial = $Revision { epoch: 0, change: 0 }
func bump (revision: Revision) =>
  if revision.change < 0xFFFFFFFF:
    return $Revision {epoch: revision.epoch, change: revision.change + 1}
  if revision.epoch == 0xFFFFFFFF:
    return panic "derived revision exhausted"
  return $Revision {epoch: revision.epoch + 1, change: 0}
func same_revision (a: Revision) => func (b: Revision) => a.epoch == b.epoch and a.change == b.change
func same_u32 (a: #[U32]) => func (b: #[U32]) =>
  if a.length != b.length:
    return false
  for index in 0 .. a.length:
    if a[index] != b[index]:
      return false
  return true
