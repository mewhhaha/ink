import { Vec3 } from "std/vector"
import * as math from "./math"
import * as scene from "./scene"
import * as spatial from "./spatial"

// Desired velocity and acceleration are separate so callers choose integration.
const limit = fn (v: Vec3) => fn (maximum: F32) => do:
  if maximum <= 0.0:
    return math.zero3
  let length = v.length
  if length > maximum:
    return v * (maximum / length)
  return v

// The vector kernels below work on scalar components, in the same order as
// the Vec3 operators, so they allocate only their result.
const seek = fn (position: Vec3) => fn (target: Vec3) => fn (speed: F32) => do:
  let dx = target.x - position.x
  let dy = target.y - position.y
  let dz = target.z - position.z
  let squared = dx * dx + dy * dy + dz * dz
  if squared <= 0.00000001 || speed <= 0.0:
    return math.zero3
  let length = sqrt squared
  return math.vec3 (dx / length * speed) (dy / length * speed) (dz / length * speed)

const arrive = fn (position: Vec3) => fn (target: Vec3) => fn (speed: F32) => fn (slow_radius: F32) => fn (stop_radius: F32) => do:
  let dx = target.x - position.x
  let dy = target.y - position.y
  let dz = target.z - position.z
  let distance = sqrt (dx * dx + dy * dy + dz * dz)
  if distance <= max 0.0 stop_radius:
    return math.zero3
  let desired = max 0.0 speed
  if slow_radius > stop_radius:
    desired := self * min 1.0 ((distance - stop_radius) / (slow_radius - stop_radius))
  return seek position target desired

const accelerate = fn (velocity: Vec3) => fn (desired: Vec3) => fn (response: F32) => fn (maximum: F32) => do:
  if response <= 0.0:
    return math.zero3
  let scale = 1.0 / response
  return limit (math.vec3 ((desired.x - velocity.x) * scale) ((desired.y - velocity.y) * scale) ((desired.z - velocity.z) * scale)) maximum

// Supply neighbours from the caller's spatial partition; self/duplicates and
// coincident points contribute zero. Linear in the supplied neighbour count.
const separation = fn (position: Vec3) => fn (neighbours: Array Vec3) => fn (radius: F32) => fn (maximum: F32) => do:
  let px = position.x
  let py = position.y
  let pz = position.z
  let reach = radius * radius
  let sx = 0.0
  let sy = 0.0
  let sz = 0.0
  if radius > 0.0:
    for other in neighbours:
      let dx = px - other.x
      let dy = py - other.y
      let dz = pz - other.z
      let squared = dx * dx + dy * dy + dz * dz
      if squared > 0.00000001 && squared < reach:
        let share = 1.0 / squared
        sx := self + dx * share
        sy := self + dy * share
        sz := self + dz * share
  return limit (math.vec3 sx sy sz) maximum

// The neighbours' mean velocity less `velocity`, at most `maximum` long: the
// change that would match their heading and pace. Zero without neighbours.
const alignment = fn (velocity: Vec3) => fn (velocities: Array Vec3) => fn (maximum: F32) => do:
  if velocities.is_empty:
    return math.zero3
  let sx = 0.0
  let sy = 0.0
  let sz = 0.0
  for other in velocities:
    sx := self + other.x
    sy := self + other.y
    sz := self + other.z
  let share = 1.0 / U32.to_f32 velocities.length
  return limit (math.vec3 (sx * share - velocity.x) (sy * share - velocity.y) (sz * share - velocity.z)) maximum

// A desired velocity of `speed` toward the neighbours' centre (`seek`). Zero
// without neighbours or at their centre.
const cohesion = fn (position: Vec3) => fn (neighbours: Array Vec3) => fn (speed: F32) => do:
  if neighbours.is_empty:
    return math.zero3
  let sx = 0.0
  let sy = 0.0
  let sz = 0.0
  for other in neighbours:
    sx := self + other.x
    sy := self + other.y
    sz := self + other.z
  let share = 1.0 / U32.to_f32 neighbours.length
  return seek position (math.vec3 (sx * share) (sy * share) (sz * share)) speed

// `to`, keeping its length, turned toward `from` until it lies within `most`
// radians of it. Unchanged when either is zero, `most` is pi or more, or it
// already does. Exactly opposite vectors turn about the vertical (about x
// for a vertical `from`).
const within_angle = fn (from: Vec3) => fn (to: Vec3) => fn (most: F32) => do:
  if Bool.not (most < pi):
    return to
  let a_squared = from.length_squared
  let b_squared = to.length_squared
  if a_squared <= 0.000000000001 || b_squared <= 0.000000000001:
    return to
  let (sine_most, cosine_most) = sin_cos (max 0.0 most)
  if from.dot to >= cosine_most * sqrt (a_squared * b_squared):
    return to
  let a = sqrt a_squared
  let b = sqrt b_squared
  let u = from * (1.0 / a)
  let w = to * (1.0 / b)
  let cosine = clamp (-1.0) 1.0 (u.dot w)
  let side = w - u * cosine
  if side.length <= 0.000001:
    if abs u.y < 0.9:
      side := math.vec3 u.z 0.0 (F32.neg u.x)
    else:
      side := math.vec3 0.0 u.z (F32.neg u.y)
  return (u * cosine_most + side * (sine_most / side.length)) * b

// Boids: members' positions, velocities and groups (parallel arrays; extra
// entries in a longer one are ignored), bucketed in cells of `size`
// (spatial.cells) for neighbourhood queries. A size near the query radius
// visits fewest candidates. Rebuild it from the members' state each step.
// It also keeps the members' places and groups in the cells' order (`xs`,
// `ys`, `zs`, `kinds`), which a query reads straight through.
type Flock is data = #Flock {
  cells: spatial.Cells, positions: Array Vec3, velocities: Array Vec3, groups: Array U32,
  xs: Array F32, ys: Array F32, zs: Array F32, kinds: Array U32,
}

// A position that leaves a member out: it neither sees nor is seen.
const nowhere = math.vec3 (0.0 / 0.0) 0.0 0.0

const flock = fn (size: F32) => fn (positions: Array Vec3) => fn (velocities: Array Vec3) => fn (groups: Array U32) => do:
  let n = min positions.length (min velocities.length groups.length)
  let kept = positions
  if n < positions.length:
    kept := @array.generate n (fn (i: U32) => positions[i])
  let cells = spatial.cells size kept
  let items = cells.items
  let xs = @array.generate items.length (fn (slot: U32) => kept[items[slot]].x)
  let ys = @array.generate items.length (fn (slot: U32) => kept[items[slot]].y)
  let zs = @array.generate items.length (fn (slot: U32) => kept[items[slot]].z)
  let kinds = @array.generate items.length (fn (slot: U32) => groups[items[slot]])
  return #Flock { cells, positions: kept, velocities, groups, xs, ys, zs, kinds }

// What one member makes of the others: of those within the radius in its own
// group, how many, their centre and their mean velocity (zero for none); and
// the separation push (as `separation`, unlimited) from every member closer
// than the spacing, any group. Coincident members push along a direction
// about the vertical fixed by the member's index, so a stack parts. A flat
// record of the count and the centre (cx, cy, cz), heading (hx, hy, hz) and
// push (px, py, pz), so a query returns one small object rather than one per
// vector; `centre`, `heading` and `push` give the vectors.
type Neighbourhood = { count: U32, cx: F32, cy: F32, cz: F32, hx: F32, hy: F32, hz: F32, px: F32, py: F32, pz: F32 }
const alone: Neighbourhood = { count: 0, cx: 0.0, cy: 0.0, cz: 0.0, hx: 0.0, hy: 0.0, hz: 0.0, px: 0.0, py: 0.0, pz: 0.0 }

const centre = fn (near: Neighbourhood) => math.vec3 near.cx near.cy near.cz

const heading = fn (near: Neighbourhood) => math.vec3 near.hx near.hy near.hz

const push = fn (near: Neighbourhood) => math.vec3 near.px near.py near.pz

// Member `index`'s neighbourhood within `radius`, pushed apart within
// `spacing`. At most `most` others within either are taken, the first met
// in the cells' order, which bounds the work in a crowd. Linear in the
// members in the cells visited.
const neighbourhood = fn (members: Flock) => fn (index: U32) => fn (radius: F32) => fn (spacing: F32) => fn (most: U32) => do:
  let positions = members.positions
  if index >= positions.length || Bool.not (is_finite radius && is_finite spacing):
    return alone
  let at = positions[index]
  if Bool.not (math.finite3 at):
    return alone
  let ax = at.x
  let ay = at.y
  let az = at.z
  let group = members.groups[index]
  let velocities = members.velocities
  let grid = members.cells
  let xs = members.xs
  let ys = members.ys
  let zs = members.zs
  let kinds = members.kinds
  let reach = max 0.0 (max radius spacing)
  let near = max 0.0 radius
  let apart = max 0.0 spacing
  let reach_squared = reach * reach
  let near_squared = near * near
  let apart_squared = apart * apart
  let (low_x, high_x, low_z, high_z) = spatial.span grid ax az reach
  // The golden angle's turn per index, kept within one turn: trigonometry
  // gives NaN past 8192 radians.
  let turns = U32.to_f32 (index % 4096) * 0.618034
  let (sine, cosine) = sin_cos ((turns - floor turns) * tau)
  let stacked = 4.0 / max 0.000001 spacing
  let stacked_x = sine * stacked
  let stacked_z = cosine * stacked
  let columns = grid.columns
  let starts = grid.starts
  let items = grid.items
  let count = 0
  let seen = 0
  let cx = 0.0
  let cy = 0.0
  let cz = 0.0
  let hx = 0.0
  let hy = 0.0
  let hz = 0.0
  let px = 0.0
  let py = 0.0
  let pz = 0.0
  for row in low_z..(high_z + 1):
    if seen >= most:
      break
    let first = starts[row * columns + low_x]
    let last = starts[row * columns + high_x + 1]
    for slot in first..last:
      if seen >= most:
        break
      let dx = ax - xs[slot]
      let dy = ay - ys[slot]
      let dz = az - zs[slot]
      let squared = dx * dx + dy * dy + dz * dz
      if squared <= reach_squared:
        let other = items[slot]
        if other != index:
          seen := self + 1
          if squared < apart_squared:
            if squared > 0.00000001:
              let share = 1.0 / squared
              px := self + dx * share
              py := self + dy * share
              pz := self + dz * share
            else:
              px := self + stacked_x
              pz := self + stacked_z
          if squared <= near_squared && kinds[slot] == group:
            let moving = velocities[other]
            count := self + 1
            cx := self + xs[slot]
            cy := self + ys[slot]
            cz := self + zs[slot]
            hx := self + moving.x
            hy := self + moving.y
            hz := self + moving.z
  if count == 0:
    let pushed: Neighbourhood = { count: 0, cx: 0.0, cy: 0.0, cz: 0.0, hx: 0.0, hy: 0.0, hz: 0.0, px, py, pz }
    return pushed
  let share = 1.0 / U32.to_f32 count
  let found: Neighbourhood = {
    count, cx: cx * share, cy: cy * share, cz: cz * share,
    hx: hx * share, hy: hy * share, hz: hz * share, px, py, pz,
  }
  return found

// How flock members steer. Gains (per second) on the goal (toward the
// desired velocity), alignment (toward the group's mean velocity), cohesion
// (toward its centre, per second squared per metre) and separation (on the
// push); the most acceleration, the top speed, the fastest turn in radians a
// second, and how far in radians the heading may stray from the goal's
// direction (pi or more leaves it free; less keeps a member with a goal
// making headway, so it cannot circle it).
type Flocking is data = #Flocking { goal: F32, alignment: F32, cohesion: F32, separation: F32, force: F32, speed: F32, turn: F32, stray: F32 }

// A member's velocity after `seconds`, from its `position` and `velocity`,
// its own desired velocity `goal` (from seek, arrive or a wander) and its
// neighbourhood: the weighted forces, limited to the most acceleration, then
// held within the stray of the goal, within the turn of the old velocity and
// under the top speed. Always finite: with a non-finite input it keeps the
// old velocity, under the top speed, or stops.
const flocking = fn (rules: Flocking) => fn (position: Vec3) => fn (velocity: Vec3) => fn (goal: Vec3) => fn (near: Neighbourhood) => fn (seconds: F32) => do:
  let vx = velocity.x
  let vy = velocity.y
  let vz = velocity.z
  let sx = (goal.x - vx) * rules.goal + near.px * rules.separation
  let sy = (goal.y - vy) * rules.goal + near.py * rules.separation
  let sz = (goal.z - vz) * rules.goal + near.pz * rules.separation
  if near.count > 0:
    sx := self + (near.hx - vx) * rules.alignment + (near.cx - position.x) * rules.cohesion
    sy := self + (near.hy - vy) * rules.alignment + (near.cy - position.y) * rules.cohesion
    sz := self + (near.hz - vz) * rules.alignment + (near.cz - position.z) * rules.cohesion
  let elapsed = max 0.0 seconds
  let force = sqrt (sx * sx + sy * sy + sz * sz)
  let scale = if rules.force <= 0.0 then 0.0 else if force > rules.force then rules.force / force * elapsed else elapsed
  let next = within_angle goal (math.vec3 (vx + sx * scale) (vy + sy * scale) (vz + sz * scale)) rules.stray
  next := within_angle velocity self (rules.turn * elapsed)
  let result = limit next rules.speed
  if math.finite3 result:
    return result
  // Non-finite inputs: keep the old velocity, or stop.
  if math.finite3 velocity:
    return limit velocity rules.speed
  return math.zero3

// cos_half_angle defines the cone without trigonometry per candidate.
const in_fov = fn (position: Vec3) => fn (forward: Vec3) => fn (target: Vec3) => fn (range: F32) => fn (cos_half_angle: F32) => do:
  let dx = target.x - position.x
  let dy = target.y - position.y
  let dz = target.z - position.z
  let distance = sqrt (dx * dx + dy * dy + dz * dz)
  if range < 0.0 || distance > range:
    return #False
  if distance <= 0.000001:
    return #True
  let facing = forward.x * forward.x + forward.y * forward.y + forward.z * forward.z
  if facing <= 0.00000001:
    return #False
  let length = sqrt facing
  let share = 1.0 / distance
  return forward.x / length * (dx * share) + forward.y / length * (dy * share) + forward.z / length * (dz * share) >= clamp (-1.0) 1.0 cos_half_angle

// The target's own collider counts as visible. Blockers use scene's solid ray
// filter, including layers and skip observer id; triggers do not occlude.
const line_of_sight = fn (world: scene.Scene) => fn (position: Vec3) => fn (target: Vec3) => fn (mask: U32) => fn (observer: U32) => fn (target_id: U32) => do:
  let delta = target - position
  let distance = delta.length
  if distance <= 0.000001:
    return #True
  return case scene.ray world position delta distance mask observer of
    #Nothing => #True
    #Some hit => hit.id == target_id || hit.distance >= distance - 0.0003

const visible = fn (world: scene.Scene) => fn (position: Vec3) => fn (forward: Vec3) => fn (target: Vec3) => fn (range: F32) => fn (cos_half_angle: F32) => fn (mask: U32) => fn (observer: U32) => fn (target_id: U32) =>
  in_fov position forward target range cos_half_angle && line_of_sight world position target mask observer target_id

// The change to add to a member's `goal` (its desired velocity, before
// `flocking`) that keeps a sphere of `radius` at `position` off the scene's
// solids. One cast of the sphere along `velocity` for `ahead` seconds, with
// scene's solid filter: `mask` layers, never entity `skip`, no triggers.
// Zero for a clear way, no motion or a non-finite input. A hit at distance d
// of the reach L has the urgency u = 1 - d / L. The change takes u of the
// goal's part into the surface away and turns it along the surface, so a
// member slides along a wall rather than stopping: the way the member
// already slides, else the way the goal leans, else to its right (about the
// vertical, as `within_angle`; about x for a vertical normal). It pushes out
// along the normal by u times the goal's speed, which also frees a member
// that starts inside a solid (a hit at distance zero). It scales with the
// goal rather than the velocity, so a member slowed by a wall still resists
// a goal behind it. Always finite.
const avoid = fn (world: scene.Scene) => fn (position: Vec3) => fn (velocity: Vec3) => fn (goal: Vec3) => fn (radius: F32) => fn (ahead: F32) => fn (mask: U32) => fn (skip: U32) => do:
  let speed = velocity.length
  let reach = speed * ahead
  let wanted = goal.length
  if Bool.not (math.finite3 position && is_finite reach && is_finite wanted && is_finite radius) || reach <= 0.000001:
    return math.zero3
  let filter = scene.solid_filter mask
  filter.skip := skip
  let #Some hit = scene.cast world position position (max 0.0 radius) (velocity * ahead) filter else:
    return math.zero3
  let n = hit.normal
  let length = n.length
  if length > 0.000001 && is_finite length:
    n := self * (1.0 / length)
  else:
    n := velocity * (F32.neg 1.0 / speed)
  let urgency = clamp 0.0 1.0 (1.0 - hit.distance / reach)
  let change = n * (urgency * wanted)
  let into = goal.dot n
  if into < 0.0:
    let moving = velocity.dot n
    let slide = velocity - n * moving
    if slide.length <= speed * 0.0001:
      slide := goal - n * into
      if slide.length <= wanted * 0.0001:
        if abs n.y < 0.9:
          slide := math.vec3 n.z 0.0 (F32.neg n.x)
        else:
          slide := math.vec3 0.0 n.z (F32.neg n.y)
    change := self - (slide * (1.0 / slide.length) + n) * (into * urgency)
  if math.finite3 change:
    return change
  return math.zero3
