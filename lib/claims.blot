import * as array from "std/array"

// Resolve proposals against one immutable resource inventory. Lower priority,
// then lower owner wins; submission/completion order never breaks a tie.
// Resource indices are local to this snapshot, not persistent handles. Callers
// reject stale inventories before applying grants. One owner may request more
// than one resource; all-or-nothing multi-resource transactions are separate.
type Bid is data = $Bid { resource: U32, owner: U32, priority: U32 }
func earlier (a: Bid) -> (b: Bid) => a.priority < b.priority or (a.priority == b.priority and a.owner < b.owner)
func resolve_into (resources: U32) -> (bids: &[Bid]) -> (grants: #[~Maybe Bid]): Bool =>
  if resources > 65536 or bids.length > 65536:
    return false
  let limit = min resources grants.length
  for i in 0 .. limit:
    grants[i] = $Nothing
  for _ in grants.length .. resources:
    @storage.push grants $Nothing
  @storage.truncate grants resources
  for bid in bids:
    if bid.resource >= resources:
      return false
    let accepts = case grants[bid.resource] of
      $Nothing => true
      $Some before => earlier bid before
    if accepts:
      grants[bid.resource] = $Some bid
  return true

func resolve (resources: U32) -> (bids: #[Bid]) =>
  if resources > 65536 or bids.length > 65536:
    return $Nothing
  let grants: #[Maybe Bid] = array.fill resources $Nothing
  for bid in bids:
    if bid.resource >= resources:
      return $Nothing
    let accepts = case grants[bid.resource] of
      $Nothing => true
      $Some before => earlier bid before
    if accepts:
      grants[bid.resource] := $Some bid
  return $Some grants
func owns (owner: U32) -> (grant: Maybe Bid) => case grant of
  $Some bid => bid.owner == owner
  $Nothing => false
