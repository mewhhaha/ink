import * as array from "std/array"
import * as lanes from "./lanes"
import * as window from "./events"

const status_unavailable: U32 = 1
const max_requests: U32 = 256
const max_data: U32 = 16384
const max_operation: U32 = 255
const max_id: U32 = 16777215
const unanswered: U32 = 255
type Policy is data = $Policy {retry_ticks: U32, tries: U32, most_answers: U32}
type Span is data = $Span {start: U32, count: U32}
type Request is data = $Request {id: U32, service: U32, operation: U32, a: F32, b: F32, c: F32, d: F32, values: Span, kept: Bool, sent: U32, tries: U32}
type Answer is data = $Answer {id: U32, status: U32, value: F32, values: Span}
type Filling is data = $Filling {answer: Answer, missing: U32, service: U32, kept: Bool}
// Services gathers the named request, result and numeric payload owners.
type Services is data = $Services {next: #[U32], outbox: #[Request], waiting: #[Request], filling: #[Filling], answers: #[Answer], statuses: #[U32], payload: #[F32]}
func access (own next) -> (own outbox) -> (own waiting) -> (own filling) -> (own answers) -> (own statuses) -> (own payload) => $Services {next, outbox, waiting, filling, answers, statuses, payload}
func idle (services: own Services) -> (count: U32) : Services =>
  services.next[0] := 1
  @storage.truncate services.outbox 0
  @storage.truncate services.waiting 0
  @storage.truncate services.filling 0
  @storage.truncate services.answers 0
  @storage.truncate services.statuses 0
  @storage.truncate services.payload 0
  for 0 .. count:
    @storage.push services.statuses unanswered
  return services
func values (services: Services) -> (span: Span) =>
  lanes.require (span.start <= services.payload.length and span.count <= services.payload.length - span.start)
  return &services.payload[span.start..span.start + span.count]
func store (services: own Services) -> input : (Span, Services) =>
  let start = services.payload.length
  let count = min input.length max_data
  for i in 0 .. count:
    @storage.push services.payload (input.at i)
  return ($Span {start, count}, services)
func text_values codes => array.generate codes.length (func i => U32.to_f32 (codes.at i))
func text input =>
  let codes: #[U32] = #[]
  for index in 0 .. input.length:
    let raw = input.at index
    if is_finite raw and raw >= 0.0 and raw <= 1114111.0:
      let code = F32.to_u32 raw
      if code <= 0x10FFFF and not (code >= 0xD800 and code <= 0xDFFF):
        @storage.push codes code
  return codes
func place rows -> id =>
  for i in 0 .. rows.length:
    if (rows.at i).id == id:
      return $Some i
  return $Nothing
func remove_at (rows: own #[a]) -> at : #[a] =>
  if at >= rows.length:
    return rows
  for i in at + 1 .. rows.length:
    rows[i - 1] := rows[i]
  @storage.truncate rows (rows.length - 1)
  return rows
func matching (services: Services) -> (rows: #[Request]) -> service -> operation -> a -> b -> c -> d -> input =>
  for i in 0 .. rows.length:
    let row = rows[i]
    if row.service == service and row.operation == operation and row.a == a and row.b == b and row.c == c and row.d == d and row.values.count == min input.length max_data:
      let equal = true
      for j in 0 .. row.values.count:
        equal := equal and services.payload[row.values.start + j] == input.at j
      if equal:
        return $Some i
  return $Nothing
func taken (services: Services) -> id =>
  if Maybe.is_some (place services.outbox id) or Maybe.is_some (place services.waiting id) or Maybe.is_some (place services.answers id):
    return true
  for row in services.filling:
    if row.answer.id == id:
      return true
  return false
func peek_id (services: Services) -> service -> operation -> a -> b -> c -> d -> input : U32 =>
  lanes.require (service <= lanes.max_integer and operation <= max_operation)
  if let $Some i = matching services services.outbox service operation a b c d input:
    return services.outbox[i].id
  if let $Some i = matching services services.waiting service operation a b c d input:
    return services.waiting[i].id
  if services.outbox.length + services.waiting.length >= max_requests:
    return 0
  let id = services.next[0]
  for 0 .. services.outbox.length + services.waiting.length + services.filling.length + services.answers.length + 1:
    if not (taken services id):
      break
    id := if id == max_id then 1 else id + 1
  return id
func make_only kept -> (services: own Services) -> service -> operation -> a -> b -> c -> d -> input : Services =>
  lanes.require (service <= lanes.max_integer and operation <= max_operation)
  if let $Some i = matching services services.outbox service operation a b c d input:
    if kept:
      services.outbox[i].kept := true
    return services
  if let $Some i = matching services services.waiting service operation a b c d input:
    if kept:
      services.waiting[i].kept := true
    return services
  if services.outbox.length + services.waiting.length >= max_requests:
    return services
  let id = services.next[0]
  for 0 .. services.outbox.length + services.waiting.length + services.filling.length + services.answers.length + 1:
    if not (taken services id):
      break
    id := if id == max_id then 1 else id + 1
  let (span, services) = store services input
  @storage.push services.outbox ($Request {id, service, operation, a, b, c, d, values: span, kept, sent: 0, tries: 0})
  services.next[0] := if id == max_id then 1 else id + 1
  return services
func ask_only (services: own Services) -> service -> operation -> a -> b -> c -> d -> input : Services =>
  return make_only true services service operation a b c d input
func ask (services: own Services) -> service -> operation -> a -> b -> c -> d -> input : (U32, Services) =>
  let id = peek_id services service operation a b c d input
  return (id, make_only true services service operation a b c d input)
func ask_on (own access) -> service -> operation -> a -> b -> c -> d -> input =>
  let id = peek_id access.services service operation a b c d input
  access.services := make_only true self service operation a b c d input
  return (id, access)
func tell (services: own Services) -> service -> operation -> a -> b -> c -> d -> input : Services =>
  return make_only false services service operation a b c d input
func answer (services: Services) -> id => case place services.answers id of
  $Some i => $Some services.answers[i]
  $Nothing => $Nothing
func dismiss (services: own Services) -> id : Services =>
  if let $Some i = place services.answers id:
    services.answers := remove_at self i
  return services
func take (services: own Services) -> id : (Maybe Answer, Services) =>
  let found = answer services id
  return (found, dismiss services id)
func take_on (own access) -> id =>
  let found = answer access.services id
  access.services := dismiss self id
  return (found, access)
func waiting (services: Services) -> id => Maybe.is_some (place services.outbox id) or Maybe.is_some (place services.waiting id)
func status (services: Services) -> service => if service < services.statuses.length then services.statuses[service] else unanswered
func finished (policy: Policy) -> (services: own Services) -> (filling: Filling) : Services =>
  if filling.service < services.statuses.length:
    services.statuses[filling.service] := filling.answer.status
  if filling.kept and policy.most_answers > 0:
    @storage.push services.answers filling.answer
    for 0 .. services.answers.length:
      if services.answers.length <= policy.most_answers:
        break
      services.answers := remove_at self 0
  return services
func receive (services: own Services) -> (policy: Policy) -> event : Services =>
  case event of
    $window.ServiceAnswer {request, status: answered, value, length} => do:
      let $Some i = place services.waiting request else:
        return services
      let asked = services.waiting[i]
      services.waiting := remove_at self i
      let count = min length max_data
      let start = services.payload.length
      // Reserve the whole answer once: interleaved ServiceData packets write
      // disjoint stable spans without reallocating another answer's payload.
      for 0 .. count:
        @storage.push services.payload 0.0
      let filling = $Filling {answer: $Answer {id: request, status: answered, value, values: $Span {start, count: 0}}, missing: count, service: asked.service, kept: asked.kept}
      if count == 0:
        return finished policy services filling
      @storage.push services.filling filling
    $window.ServiceData {request, a, b, c} => do:
      for i in 0 .. services.filling.length:
        if services.filling[i].answer.id == request:
          let filling = services.filling[i]
          let taking = min filling.missing 3
          for j in 0 .. taking:
            let value = if j == 0 then a else if j == 1 then b else c
            services.payload[filling.answer.values.start + filling.answer.values.count + j] := value
          filling.answer.values.count := filling.answer.values.count + taking
          filling.missing := filling.missing - taking
          if filling.missing == 0:
            services.filling := remove_at self i
            return finished policy services filling
          services.filling[i] := filling
          return services
    _ => ()
  return services
func send (services: own Services) -> (policy: Policy) -> (tick: U32) -> (outgoing: own #[Request]) : (Services, #[Request]) =>
  @storage.truncate outgoing 0
  let i = 0
  for 0 .. services.waiting.length:
    if i >= services.waiting.length:
      break
    let request = services.waiting[i]
    if tick - request.sent >= policy.retry_ticks:
      services.waiting := remove_at self i
      if request.tries < policy.tries:
        @storage.push services.outbox request
      else:
        services := finished policy services ($Filling {answer: $Answer {id: request.id, status: status_unavailable, value: 0.0, values: $Span {start: 0, count: 0}}, missing: 0, service: request.service, kept: request.kept})
    else:
      i := i + 1
  let count = min max_requests services.outbox.length
  for i in 0 .. count:
    let request = services.outbox[i]
    request.sent := tick
    request.tries := request.tries + 1
    @storage.push outgoing request
    @storage.push services.waiting request
  for i in count .. services.outbox.length:
    services.outbox[i - count] := services.outbox[i]
  @storage.truncate services.outbox (services.outbox.length - count)
  return (services, outgoing)
// Compact only at a declared frame boundary after output/answer views end.
// Scratch is another named numeric owner; IDs and logical saved values stay put.
func copy_span input -> span -> reserved -> (output: own #[F32]) : (Span, #[F32]) =>
  let start = output.length
  for i in 0 .. reserved:
    @storage.push output (input.at (span.start + i))
  return ($Span {start, count: span.count}, output)
func compact (services: own Services) -> (scratch: own #[F32]) : (Services, #[F32]) =>
  @storage.truncate scratch 0
  for i in 0 .. services.outbox.length:
    let span = services.outbox[i].values
    let (next_span, next_scratch) = copy_span services.payload span span.count scratch
    scratch := next_scratch
    services.outbox[i].values := next_span
  for i in 0 .. services.waiting.length:
    let span = services.waiting[i].values
    let (next_span, next_scratch) = copy_span services.payload span span.count scratch
    scratch := next_scratch
    services.waiting[i].values := next_span
  for i in 0 .. services.filling.length:
    let span = services.filling[i].answer.values
    let (next_span, next_scratch) = copy_span services.payload span (span.count + services.filling[i].missing) scratch
    scratch := next_scratch
    services.filling[i].answer.values := next_span
  for i in 0 .. services.answers.length:
    let span = services.answers[i].values
    let (next_span, next_scratch) = copy_span services.payload span span.count scratch
    scratch := next_scratch
    services.answers[i].values := next_span
  @storage.truncate services.payload 0
  for value in scratch:
    @storage.push services.payload value
  return (services, scratch)

// Version-1 saved service framing is preserved exactly; only in-memory payload
// spans changed. Static application schemas invoke encode/decode directly.
func append_lanes input -> (output: own #[F32]) : #[F32] =>
  for index in 0 .. input.length:
    @storage.push output (input.at index)
  return output
func encode_request (services: Services) -> request -> (output: own #[F32]) : #[F32] =>
  output := append_lanes #[U32.to_f32 request.id, U32.to_f32 request.service, U32.to_f32 request.operation,
    request.a, request.b, request.c, request.d, lanes.bit request.kept,
    U32.to_f32 (request.sent & 65535), U32.to_f32 (request.sent >> 16), U32.to_f32 request.tries,
    U32.to_f32 request.values.count] self
  return append_lanes (values services request.values) output
func encode_answer (services: Services) -> answer -> (output: own #[F32]) : #[F32] =>
  output := append_lanes #[U32.to_f32 answer.id, U32.to_f32 answer.status, answer.value, U32.to_f32 answer.values.count] self
  return append_lanes (values services answer.values) output
func encode (services: Services) : #[F32] =>
  let output: #[F32] = #[]
  @storage.push output (U32.to_f32 services.next[0])
  @storage.push output (U32.to_f32 services.statuses.length)
  for status in services.statuses:
    @storage.push output (U32.to_f32 status)
  @storage.push output (U32.to_f32 services.outbox.length)
  for request in services.outbox:
    output := encode_request services request self
  @storage.push output (U32.to_f32 services.waiting.length)
  for request in services.waiting:
    output := encode_request services request self
  @storage.push output (U32.to_f32 services.filling.length)
  for filling in services.filling:
    output := append_lanes #[U32.to_f32 filling.missing, U32.to_f32 filling.service, lanes.bit filling.kept] self
    output := encode_answer services filling.answer self
  @storage.push output (U32.to_f32 services.answers.length)
  for answer in services.answers:
    output := encode_answer services answer self
  return output
func read_request (input: #[F32]) -> at -> (services: own Services) : (Request, U32, Services) =>
  lanes.bounds input at 12
  let count = lanes.integer input[at + 11] max_data
  lanes.bounds input (at + 12) count
  let (span, services) = store services (&input[at + 12..at + 12 + count])
  return ($Request {id: lanes.integer input[at] max_id, service: lanes.integer input[at + 1] lanes.max_integer,
    operation: lanes.integer input[at + 2] max_operation, a: input[at + 3], b: input[at + 4], c: input[at + 5], d: input[at + 6],
    kept: lanes.flag input[at + 7], sent: lanes.whole input (at + 8), tries: lanes.integer input[at + 10] lanes.max_integer,
    values: span}, at + 12 + count, services)
func read_answer (input: #[F32]) -> at -> (services: own Services) : (Answer, U32, Services) =>
  lanes.bounds input at 4
  let count = lanes.integer input[at + 3] max_data
  lanes.bounds input (at + 4) count
  let (span, services) = store services (&input[at + 4..at + 4 + count])
  return ($Answer {id: lanes.integer input[at] max_id, status: lanes.integer input[at + 1] unanswered, value: input[at + 2], values: span}, at + 4 + count, services)
func decode (input: #[F32]) -> (services: own Services) : Services =>
  lanes.finite input
  lanes.bounds input 0 2
  let next = lanes.integer input[0] max_id
  lanes.require (next >= 1)
  // Restore happens in a fresh candidate instance. A malformed inner payload
  // traps and invalidates that candidate; no whole-world rollback is implied.
  services := idle services 0
  services.next[0] := next
  let at = 2
  let statuses = lanes.integer input[1] lanes.max_integer
  lanes.bounds input at statuses
  for i in 0 .. statuses:
    @storage.push services.statuses (lanes.integer input[at + i] unanswered)
  at := at + statuses
  lanes.bounds input at 1
  let outbox = lanes.integer input[at] max_requests
  at := at + 1
  for 0 .. outbox:
    let (request, after, next_services) = read_request input at services
    services := next_services
    @storage.push services.outbox request
    at := after
  lanes.bounds input at 1
  let waiting = lanes.integer input[at] max_requests
  at := at + 1
  for 0 .. waiting:
    let (request, after, next_services) = read_request input at services
    services := next_services
    @storage.push services.waiting request
    at := after
  lanes.bounds input at 1
  let filling = lanes.integer input[at] max_requests
  at := at + 1
  for 0 .. filling:
    lanes.bounds input at 3
    let missing = lanes.integer input[at] max_data
    let service = lanes.integer input[at + 1] lanes.max_integer
    let kept = lanes.flag input[at + 2]
    let (answer, after, next_services) = read_answer input (at + 3) services
    services := next_services
    lanes.require (answer.values.count <= max_data - missing)
    for 0 .. missing:
      @storage.push services.payload 0.0
    @storage.push services.filling ($Filling {answer, missing, service, kept})
    at := after
  lanes.bounds input at 1
  let answers = lanes.integer input[at] max_requests
  at := at + 1
  for 0 .. answers:
    let (answer, after, next_services) = read_answer input at services
    services := next_services
    @storage.push services.answers answer
    at := after
  lanes.require (at == input.length)
  return services
const codec = {key: 12, version: 1}
