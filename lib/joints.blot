import { Vec3 } from "std/vector"
import { Quat } from "./math"
import * as math from "./math"
import * as shapes from "./shapes"
import * as arrays from "./arrays"

// Endpoints refer to source array slots, never entity IDs. Anchors and hinge
// axes are local to each source; static/kinematic endpoint poses are authored
// by the caller. Distance uses metres, spring N/m and N*s/m, motor rad/s and Nm.
type Kind is data = #Distance | #Spring | #Hinge
type Joint is data = #Joint {
  a: U32, b: U32, anchor_a: Vec3, anchor_b: Vec3,
  kind: Kind, length: F32, stiffness: F32, damping: F32,
  axis_a: Vec3, axis_b: Vec3, motor_speed: F32, motor_torque: F32,
}

const distance = fn (a: U32) => fn (b: U32) => fn (anchor_a: Vec3) => fn (anchor_b: Vec3) => fn (length: F32) => #Joint {
  a, b, anchor_a, anchor_b, kind: #Distance, length: max 0.0 length,
  stiffness: 0.0, damping: 0.0, axis_a: math.up, axis_b: math.up,
  motor_speed: 0.0, motor_torque: 0.0,
}
const spring = fn (a: U32) => fn (b: U32) => fn (anchor_a: Vec3) => fn (anchor_b: Vec3) => fn (length: F32) => fn (stiffness: F32) => fn (damping: F32) => do:
  let j = distance a b anchor_a anchor_b length
  j.kind := #Spring
  j.stiffness := max 0.0 stiffness
  j.damping := max 0.0 damping
  return j
const hinge = fn (a: U32) => fn (b: U32) => fn (anchor_a: Vec3) => fn (anchor_b: Vec3) => fn (axis_a: Vec3) => fn (axis_b: Vec3) => do:
  let j = distance a b anchor_a anchor_b 0.0
  j.kind := #Hinge
  j.axis_a := axis_a.normalized
  j.axis_b := axis_b.normalized
  return j
const motor = fn (j: Joint) => fn (speed: F32) => fn (torque: F32) => do:
  j.motor_speed := speed
  j.motor_torque := max 0.0 torque
  return j

const finite_vector = fn (v: Vec3) => is_finite v.x && is_finite v.y && is_finite v.z
const valid = fn (j: Joint) => do:
  if j.a == j.b || Bool.not (finite_vector j.anchor_a && finite_vector j.anchor_b) || Bool.not (is_finite j.length && is_finite j.stiffness && is_finite j.damping && is_finite j.motor_speed && is_finite j.motor_torque):
    return #False
  if j.length < 0.0 || j.stiffness < 0.0 || j.damping < 0.0 || j.motor_torque < 0.0:
    return #False
  if let #Hinge = j.kind:
    return finite_vector j.axis_a && finite_vector j.axis_b && j.axis_a.length_squared > 0.000001 && j.axis_b.length_squared > 0.000001
  return #True

// Prepared once per physics step; -1 means an endpoint outside the mover table.
type Link is data = #Link { joint: Joint, a: F32, b: F32, position_a: Vec3, position_b: Vec3, rotation_a: Quat, rotation_b: Quat, velocity_a: Vec3, velocity_b: Vec3, angular_a: Vec3, angular_b: Vec3 }
const vector = fn (a: Array F32) => fn (i: U32) => math.vec3 a[i] a[i + 1] a[i + 2]
const rotation = fn (a: Array F32) => fn (i: U32) => #Quat { x: a[i], y: a[i + 1], z: a[i + 2], w: a[i + 3] }
const inertia = fn (iw: Array F32) => fn (i: U32) => fn (v: Vec3) => do:
  let k = i * 6
  return math.vec3 (iw[k] * v.x + iw[k + 3] * v.y + iw[k + 4] * v.z) (iw[k + 3] * v.x + iw[k + 1] * v.y + iw[k + 5] * v.z) (iw[k + 4] * v.x + iw[k + 5] * v.y + iw[k + 2] * v.z)

// Bilateral sequential impulses. Springs use implicit stiffness/damping; hinges
// solve three point rows and two angular rows, retaining twist about their axis.
// A motor applies at most torque*h impulse per substep. No hidden persistent state.
// The vector arithmetic runs on scalars in `math`'s operation order.
const solve = fn (h: F32) => fn (elapsed: F32) => fn (pos: Array F32) => fn (rot: Array F32) => fn (inv_mass: Array F32) => fn (iw: Array F32) => fn (links: Array Link) => fn (vel_in: Array F32) => do:
  let vel = arrays.copy vel_in
  for link in links:
    let j = link.joint
    let has_a = link.a >= 0.0
    let has_b = link.b >= 0.0
    let ia = if has_a then F32.to_u32 link.a else 0
    let ib = if has_b then F32.to_u32 link.b else 0
    let pa = if has_a then vector pos (ia * 3) else link.position_a
    let pb = if has_b then vector pos (ib * 3) else link.position_b
    let qa = if has_a then rotation rot (ia * 4) else link.rotation_a
    let qb = if has_b then rotation rot (ib * 4) else link.rotation_b
    let ma = if has_a then inv_mass[ia] else 0.0
    let mb = if has_b then inv_mass[ib] else 0.0
    // Kinematic sources stay caller-owned. Predict their anchor pose within
    // this step, so their authored velocity and constraint position agree.
    if ma == 0.0:
      pa := self + link.velocity_a * elapsed
      if link.angular_a.length_squared > 0.00000001:
        qa := math.axis_angle link.angular_a.normalized (link.angular_a.length * elapsed) * self
    if mb == 0.0:
      pb := self + link.velocity_b * elapsed
      if link.angular_b.length_squared > 0.00000001:
        qb := math.axis_angle link.angular_b.normalized (link.angular_b.length * elapsed) * self
    let (rax, ray, raz) = math.rotate_parts qa.x qa.y qa.z qa.w j.anchor_a.x j.anchor_a.y j.anchor_a.z
    let (rbx, rby, rbz) = math.rotate_parts qb.x qb.y qb.z qb.w j.anchor_b.x j.anchor_b.y j.anchor_b.z
    let dx = pb.x + rbx - pa.x - rax
    let dy = pb.y + rby - pa.y - ray
    let dz = pb.z + rbz - pa.z - raz
    let (aax, aay, aaz) = math.rotate_parts qa.x qa.y qa.z qa.w j.axis_a.x j.axis_a.y j.axis_a.z
    let (abx, aby, abz) = math.rotate_parts qb.x qb.y qb.z qb.w j.axis_b.x j.axis_b.y j.axis_b.z
    let hinge_kind = #False
    if let #Hinge = j.kind:
      hinge_kind := #True
    let spring_kind = #False
    if let #Spring = j.kind:
      spring_kind := #True
    let rows = 1
    if hinge_kind:
      rows := 6
    let (px, py, pz) = shapes.perpendicular_xyz aax aay aaz
    let ex = aay * abz - aaz * aby
    let ey = aaz * abx - aax * abz
    let ez = aax * aby - aay * abx
    // Antiparallel axes have zero cross product but are not aligned. Choose a
    // deterministic correction axis instead of leaving the hinge inverted.
    if aax * abx + aay * aby + aaz * abz < 0.0 && ex * ex + ey * ey + ez * ez < 0.00000001:
      ex := px
      ey := py
      ez := pz
    let squared = dx * dx + dy * dy + dz * dz
    let separation = sqrt squared
    let stretch = separation - j.length
    let ux = 0.0
    let uy = 1.0
    let uz = 0.0
    if squared > 0.00000001:
      ux := dx / separation
      uy := dy / separation
      uz := dz / separation
    for row in 0..rows:
      let vel_a = ia * 6
      let vel_b = ib * 6
      let vax = if has_a then vel[vel_a] else link.velocity_a.x
      let vay = if has_a then vel[vel_a + 1] else link.velocity_a.y
      let vaz = if has_a then vel[vel_a + 2] else link.velocity_a.z
      let wax = if has_a then vel[vel_a + 3] else link.angular_a.x
      let way = if has_a then vel[vel_a + 4] else link.angular_a.y
      let waz = if has_a then vel[vel_a + 5] else link.angular_a.z
      let vbx = if has_b then vel[vel_b] else link.velocity_b.x
      let vby = if has_b then vel[vel_b + 1] else link.velocity_b.y
      let vbz = if has_b then vel[vel_b + 2] else link.velocity_b.z
      let wbx = if has_b then vel[vel_b + 3] else link.angular_b.x
      let wby = if has_b then vel[vel_b + 4] else link.angular_b.y
      let wbz = if has_b then vel[vel_b + 5] else link.angular_b.z
      let angular = hinge_kind && row >= 3
      let nx = ux
      let ny = uy
      let nz = uz
      let error = stretch
      if hinge_kind:
        if row == 0:
          nx := 1.0
          ny := 0.0
          nz := 0.0
        if row == 1:
          nx := 0.0
          ny := 1.0
          nz := 0.0
        if row == 2:
          nx := 0.0
          ny := 0.0
          nz := 1.0
        if row == 3:
          nx := px
          ny := py
          nz := pz
        if row == 4:
          nx := aay * pz - aaz * py
          ny := aaz * px - aax * pz
          nz := aax * py - aay * px
        if row == 5:
          nx := aax
          ny := aay
          nz := aaz
        error := dx * nx + dy * ny + dz * nz
        if angular:
          error := ex * nx + ey * ny + ez * nz
      let jax = if angular then nx else ray * nz - raz * ny
      let jay = if angular then ny else raz * nx - rax * nz
      let jaz = if angular then nz else rax * ny - ray * nx
      let jbx = if angular then nx else rby * nz - rbz * ny
      let jby = if angular then ny else rbz * nx - rbx * nz
      let jbz = if angular then nz else rbx * ny - rby * nx
      let iax = 0.0
      let iay = 0.0
      let iaz = 0.0
      if ma > 0.0:
        let k = ia * 6
        iax := iw[k] * jax + iw[k + 3] * jay + iw[k + 4] * jaz
        iay := iw[k + 3] * jax + iw[k + 1] * jay + iw[k + 5] * jaz
        iaz := iw[k + 4] * jax + iw[k + 5] * jay + iw[k + 2] * jaz
      let ibx = 0.0
      let iby = 0.0
      let ibz = 0.0
      if mb > 0.0:
        let k = ib * 6
        ibx := iw[k] * jbx + iw[k + 3] * jby + iw[k + 4] * jbz
        iby := iw[k + 3] * jbx + iw[k + 1] * jby + iw[k + 5] * jbz
        ibz := iw[k + 4] * jbx + iw[k + 5] * jby + iw[k + 2] * jbz
      let k = jax * iax + jay * iay + jaz * iaz + (jbx * ibx + jby * iby + jbz * ibz)
      let speed = wbx * jbx + wby * jby + wbz * jbz - (wax * jax + way * jay + waz * jaz)
      if Bool.not angular:
        k := self + ma + mb
        speed := self + ((vbx - vax) * nx + (vby - vay) * ny + (vbz - vaz) * nz)
      let bias = clamp (-3.0) 3.0 (0.2 * error / h)
      let gamma = 0.0
      let active = #True
      if spring_kind:
        let denominator = h * (j.damping + h * j.stiffness)
        active := denominator > 0.0
        if active:
          gamma := 1.0 / denominator
          bias := error * h * j.stiffness * gamma
      if hinge_kind && row == 5:
        bias := F32.neg j.motor_speed
        active := j.motor_torque > 0.0
      if active && k > 0.0:
        let impulse = F32.neg (speed + bias) / (k + gamma)
        if hinge_kind && row == 5:
          impulse := clamp (F32.neg (j.motor_torque * h)) (j.motor_torque * h) self
        let qx = nx * impulse
        let qy = ny * impulse
        let qz = nz * impulse
        if ma > 0.0:
          if Bool.not angular:
            vel[vel_a] := vel[vel_a] - qx * ma
            vel[vel_a + 1] := vel[vel_a + 1] - qy * ma
            vel[vel_a + 2] := vel[vel_a + 2] - qz * ma
          vel[vel_a + 3] := vel[vel_a + 3] - iax * impulse
          vel[vel_a + 4] := vel[vel_a + 4] - iay * impulse
          vel[vel_a + 5] := vel[vel_a + 5] - iaz * impulse
        if mb > 0.0:
          if Bool.not angular:
            vel[vel_b] := vel[vel_b] + qx * mb
            vel[vel_b + 1] := vel[vel_b + 1] + qy * mb
            vel[vel_b + 2] := vel[vel_b + 2] + qz * mb
          vel[vel_b + 3] := vel[vel_b + 3] + ibx * impulse
          vel[vel_b + 4] := vel[vel_b + 4] + iby * impulse
          vel[vel_b + 5] := vel[vel_b + 5] + ibz * impulse
  return vel
