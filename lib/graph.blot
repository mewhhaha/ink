import * as array from "std/array"

// Caller-owned compressed adjacency. Edges retain input order, including
// duplicates. Construction rejects invalid endpoints and arithmetic overflow.
type Graph is data = #Graph { starts: Array U32, targets: Array U32 }
const from_edges = fn (count: U32) (sources: Array U32) (targets: Array U32) => do:
  if count == 0xFFFFFFFF || sources.length != targets.length:
    return #Nothing
  let valid = #True
  for i in 0 .. sources.length:
    if sources[i] >= count || targets[i] >= count:
      valid := #False
      break
  if Bool.not valid:
    return #Nothing
  let sizes = array.fill count 0
  for source in sources:
    sizes[source] := self + 1
  let starts = array.fill (count + 1) 0
  for i in 0 .. count:
    starts[i + 1] := starts[i] + sizes[i]
  let cursor = array.generate count (fn i => starts[i])
  let edges = array.fill targets.length 0
  for i in 0 .. sources.length:
    let source = sources[i]
    let at = cursor[source]
    edges[at] := targets[i]
    cursor[source] := at + 1
  return #Some (#Graph { starts, targets: edges })
const reverse = fn (graph: Graph) => do:
  let count = graph.starts.length - 1
  let sources = array.fill graph.targets.length 0
  for source in 0 .. count:
    for i in graph.starts[source] .. graph.starts[source + 1]:
      sources[i] := source
  let #Some result = from_edges count graph.targets sources else:
    return @panic "graph adjacency invariant"
  return result
const from_lists = fn (lists: Array (Array U32)) => do:
  let count = 0
  for list in lists:
    if list.length > 0xFFFFFFFF - count:
      return @panic "graph edge count overflows"
    count := self + list.length
  let starts = array.fill (lists.length + 1) 0
  let targets = array.fill count 0
  let at = 0
  for i in 0 .. lists.length:
    for target in lists[i]:
      if target >= lists.length:
        return @panic "graph target outside graph"
      targets[at] := target
      at := self + 1
    starts[i + 1] := at
  return #Graph { starts, targets }
// Seeds are always included. Only allowed target nodes may be discovered.
const reachable = fn (graph: Graph) (roots: Array U32) (allowed: Array Bool) => do:
  let count = graph.starts.length - 1
  if allowed.length != count:
    return @panic "graph allowed mask length mismatch"
  let seen = array.fill count #False
  let queue = array.fill count 0
  let used = 0
  for root in roots:
    if root >= count:
      return @panic "graph root outside graph"
    if Bool.not seen[root]:
      seen[root] := #True
      queue[used] := root
      used := self + 1
  for head in 0 .. count:
    if head >= used:
      break
    let source = queue[head]
    for i in graph.starts[source] .. graph.starts[source + 1]:
      let target = graph.targets[i]
      if allowed[target] && Bool.not seen[target]:
        seen[target] := #True
        queue[used] := target
        used := self + 1
  return seen
// Stable Kahn waves. The minimum ready source index wins; newly ready nodes
// enter the following wave, so all nodes in a wave read the same snapshot.
const waves = fn (width: U32) (dependencies: Graph) => do:
  if width == 0:
    return #Nothing
  let count = dependencies.starts.length - 1
  let dependents = reverse dependencies
  let remaining = array.generate count (fn i => dependencies.starts[i + 1] - dependencies.starts[i])
  let heap = array.fill count 0
  let used = 0
  for i in 0 .. count:
    if remaining[i] == 0:
      heap[used] := i
      used := self + 1
  let result = array.generate count (fn unused => array.fill 0 0)
  let wave_count = 0
  let visited = 0
  for 0 .. count:
    if used == 0:
      break
    let size = min width used
    let wave = array.fill size 0
    for i in 0 .. size:
      wave[i] := heap[0]
      used := self - 1
      let moved = heap[used]
      let at = 0
      for 0 .. 32:
        let left = at * 2 + 1
        if left >= used:
          break
        let child = if left + 1 < used && heap[left + 1] < heap[left] then left + 1 else left
        if moved <= heap[child]:
          break
        heap[at] := heap[child]
        at := child
      heap[at] := moved
    visited := self + size
    for source in wave:
      for i in dependents.starts[source] .. dependents.starts[source + 1]:
        let target = dependents.targets[i]
        remaining[target] := self - 1
        if remaining[target] == 0:
          let at = used
          used := self + 1
          for 0 .. 32:
            if at == 0:
              break
            let parent = (at - 1) / 2
            if heap[parent] <= target:
              break
            heap[at] := heap[parent]
            at := parent
          heap[at] := target
    result[wave_count] := wave
    wave_count := self + 1
  return if visited == count then #Some (array.slice 0 wave_count result) else #Nothing
