import { Vec3 } from "std/vector"
import * as app from "./app"
import * as lanes from "./lanes"
import * as math from "./math"
import * as render from "./render"

// The view pose. Camera coordinates are right-handed and look down -Z.
type Camera is data = $Camera { position: Vec3, rotation: math.Quat }

// Caller-owned perspective settings; no world extent or FOV policy.
type Lens is data = $Lens { focal_length: F32, near: F32, far: F32 }
func perspective (lens: Lens) => func (aspect: F32) => math.Mat4.perspective lens.focal_length aspect lens.near lens.far
func perspective_with (lens: Lens) => func (focal: F32) => func (aspect: F32) => math.Mat4.perspective focal aspect lens.near lens.far

func view (camera: Camera) => math.Mat4.view camera.position camera.rotation

func interpolate (previous: Camera) => func (current: Camera) => func alpha => $Camera {
  position: previous.position.lerp current.position alpha,
  rotation: previous.rotation.nlerp current.rotation alpha,
}

// Precomputed camera basis and pixel focal scale for repeated viewport queries.
type Projection is data = $Projection {
  position: Vec3,
  right: Vec3,
  up: Vec3,
  forward: Vec3,
  scale: F32,
  inv_scale: F32,
  half_width: F32,
  half_height: F32,
}

func prepare_projection (lens: Lens) -> (camera: Camera) -> (width: F32) -> (height: F32): Projection =>
  let q = camera.rotation
  let right = q.rotate math.right
  let up = q.rotate math.up
  let forward = q.rotate math.forward
  let scale = lens.focal_length * 0.5 * height
  return $Projection {
    position: camera.position,
    right, up, forward,
    scale,
    inv_scale: 1.0 / scale,
    half_width: width * 0.5,
    half_height: height * 0.5,
  }

func project_point (proj: Projection) -> (point: Vec3): Maybe (F32, F32) =>
  let dx = point.x - proj.position.x
  let dy = point.y - proj.position.y
  let dz = point.z - proj.position.z
  let depth = dx * proj.forward.x + dy * proj.forward.y + dz * proj.forward.z
  if depth < 0.001:
    return $Nothing
  let lx = dx * proj.right.x + dy * proj.right.y + dz * proj.right.z
  let ly = dx * proj.up.x + dy * proj.up.y + dz * proj.up.z
  let factor = proj.scale / depth
  return $Some (proj.half_width + lx * factor, proj.half_height - ly * factor)

func project_ray (proj: Projection) -> (x: F32) -> (y: F32): math.Ray =>
  let rx = (x - proj.half_width) * proj.inv_scale
  let ry = (proj.half_height - y) * proj.inv_scale
  let dx = proj.right.x * rx + proj.up.x * ry + proj.forward.x
  let dy = proj.right.y * rx + proj.up.y * ry + proj.forward.y
  let dz = proj.right.z * rx + proj.up.z * ry + proj.forward.z
  let length = sqrt (dx * dx + dy * dy + dz * dz)
  let direction = if length == 0.0 then $Vec3 { x: dx, y: dy, z: dz } else $Vec3 { x: dx / length, y: dy / length, z: dz / length }
  return $math.Ray { origin: proj.position, direction }

// The world-space ray through viewport pixel (x, y).
func viewport_ray (lens: Lens) => func (camera: Camera) => func (x: F32) => func (y: F32) => func (width: F32) => func (height: F32) =>
  let inv_scale = 1.0 / (lens.focal_length * 0.5 * height)
  let q = camera.rotation
  let (dx, dy, dz) = math.rotate_parts q.x q.y q.z q.w ((x - width * 0.5) * inv_scale) ((height * 0.5 - y) * inv_scale) (-1.0)
  // Vec3.normalized: unchanged when its length is zero.
  let length = sqrt (dx * dx + dy * dy + dz * dz)
  let direction = if length == 0.0 then $Vec3 { x: dx, y: dy, z: dz } else $Vec3 { x: dx / length, y: dy / length, z: dz / length }
  return $math.Ray { origin: camera.position, direction }

// Where world point `point` falls in a `width` x `height` viewport, in its
// pixels, as viewport_ray casts rays through them; nothing for a point behind
// the camera.
func viewport_point (lens: Lens) => func (camera: Camera) => func (point: Vec3) => func (width: F32) => func (height: F32) =>
  let q = camera.rotation
  let p = camera.position
  let (lx, ly, lz) = math.rotate_parts (F32.neg q.x) (F32.neg q.y) (F32.neg q.z) q.w (point.x - p.x) (point.y - p.y) (point.z - p.z)
  if lz > -0.001:
    return $Nothing
  let factor = lens.focal_length * 0.5 * height / (0.0 - lz)
  return $Some (width * 0.5 + lx * factor, height * 0.5 - ly * factor)

// Changes the camera without interpolating from its previous step: turning with
// the pointer and jumps show at once, whether or not a step runs this frame.
func adjust change -> (current: #[Camera]) -> (previous: #[Camera]) =>
  current[0] = change current[0]
  previous[0] = change previous[0]
  return ()

// Points the camera along `rotation` at once.
func turn (rotation: math.Quat) -> current -> previous => return
  adjust (func (view: Camera) =>
    view.rotation := rotation
    return view) current previous

func prepare (current: Camera) -> (previous: Camera) -> (lens: Lens) -> (presentation: app.Presentation) -> (access: render.FrameAccess) =>
  access.settings[0].view = view (interpolate previous current presentation.alpha)
  access.settings[0].projection = perspective lens (presentation.width / presentation.height)
  return ()

// Lanes: position3, rotation4.
func encode (camera: Camera) =>
  let $Camera { position: p, rotation: r } = camera
  return #[p.x, p.y, p.z, r.x, r.y, r.z, r.w]

func decode (values: #[F32]) =>
  use lanes.exact values 7
  return $Camera { position: lanes.vec3 values 0, rotation: lanes.quaternion values 3 }

const codec = $lanes.Codec { key: 5, version: 1, encode, decode, migrate: lanes.no_migration }

// Applications declare current/previous camera owners and call prepare directly.
