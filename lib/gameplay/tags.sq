//! Hierarchical Gameplay Tags over flat U32 path segments (e.g., #[1, 4, 9]
//! representing `State.Movement.Airborne`). A tag matches an ancestor query
//! when the query is a prefix of the tag. Containers support add/remove/query
//! operations without heap-allocating nested tag arrays.
//!
//! Key items: [`Tag`], [`Pool`], [`matches`], [`exact`], [`has_tag`].
//!
//! ```squid
//! let pool = $Pool { segments: #[10, 10, 20], tags: #[$Tag { start: 0, count: 1 }, $Tag { start: 1, count: 2 }] }
//! matches pool 1 0 and not (matches pool 0 1) // => true
//! ```

// One tag's span in a shared flat segment pool.
type Tag is data = $Tag { start: U32, count: U32 }

type Pool is data = $Pool {
  segments: #[U32],
  tags: #[Tag],
}

// True iff `tag` equals `query` or is a descendant of `query` (prefix match).
func matches (pool: Pool) -> (tag_id: U32) -> (query_id: U32) : Bool =>
  if tag_id >= pool.tags.length or query_id >= pool.tags.length:
    return false
  let t = pool.tags[tag_id]
  let q = pool.tags[query_id]
  if q.count == 0 or t.count < q.count:
    return false
  if t.start > pool.segments.length or t.count > pool.segments.length - t.start:
    return false
  if q.start > pool.segments.length or q.count > pool.segments.length - q.start:
    return false
  for i in 0 .. q.count:
    if pool.segments[t.start + i] != pool.segments[q.start + i]:
      return false
  return true

// True iff `tag_id` and `other_id` have identical segment paths.
func exact (pool: Pool) -> (tag_id: U32) -> (other_id: U32) : Bool =>
  if tag_id >= pool.tags.length or other_id >= pool.tags.length:
    return false
  let t = pool.tags[tag_id]
  let q = pool.tags[other_id]
  if t.count != q.count:
    return false
  return matches pool tag_id other_id

// True iff `held` contains any tag matching `query_id` (or its descendants).
func has_tag (pool: Pool) -> (held: #[U32]) -> (query_id: U32) : Bool =>
  let tags = pool.tags
  let tags_len = tags.length
  if query_id >= tags_len:
    return false
  let segs = pool.segments
  let segs_len = segs.length
  let q = tags[query_id]
  let q_count = q.count
  let q_start = q.start
  if q_count == 0 or q_start > segs_len or q_count > segs_len - q_start:
    return false
  let q_first = segs[q_start]
  for tid in held:
    if tid == query_id:
      return true
    if tid < tags_len:
      let t = tags[tid]
      let t_start = t.start
      if t.count >= q_count and t_start <= segs_len and t.count <= segs_len - t_start and segs[t_start] == q_first:
        let ok = true
        for i in 1 .. q_count:
          if segs[t_start + i] != segs[q_start + i]:
            ok := false
            break
        if ok:
          return true
  return false

// True iff `held` satisfies every tag in `required`.
func has_all (pool: Pool) -> (held: #[U32]) -> (required: #[U32]) : Bool =>
  for req in required:
    if not (has_tag pool held req):
      return false
  return true

// True iff `held` matches at least one tag in `any_of`.
func has_any (pool: Pool) -> (held: #[U32]) -> (any_of: #[U32]) : Bool =>
  for q in any_of:
    if has_tag pool held q:
      return true
  return false

// True iff `held` matches none of `blocked`.
func has_none (pool: Pool) -> (held: #[U32]) -> (blocked: #[U32]) : Bool =>
  return not (has_any pool held blocked)

// Add `tag_id` to caller-owned `held` if not already present (exact ID).
func add (tag_id: U32) -> (held: own #[U32]) : #[U32] =>
  for t in held:
    if t == tag_id:
      return held
  @storage.push held tag_id
  return held

// Remove all tags matching `query_id` (itself or any descendant) from `held`.
func remove_matching (pool: Pool) -> (query_id: U32) -> (held: own #[U32]) : #[U32] =>
  let write = 0
  let n = held.length
  for i in 0 .. n:
    let t = held[i]
    if not (matches pool t query_id):
      held[write] := t
      write := self + 1
  @storage.truncate held write
  return held
