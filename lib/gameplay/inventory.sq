//! Reusable Inventory, 2D-Grid Packing, Crafting Recipes & Weighted Loot Tables.
//!
//! Key items: [`Slot`], [`ItemDef`], [`Ingredient`], [`Recipe`], [`empty_slot`].

import * as random from "../random"

type Slot is data = $Slot {
  item: U32,
  count: U32,
}

type ItemDef is data = $ItemDef {
  id: U32,
  max_stack: U32,
  width: U32,
  height: U32,
}

type Ingredient is data = $Ingredient {
  item: U32,
  count: U32,
}

type Recipe is data = $Recipe {
  in_start: U32,
  in_count: U32,
  out_item: U32,
  out_count: U32,
}

type LootEntry is data = $LootEntry {
  item: U32,
  weight: F32,
  min_count: U32,
  max_count: U32,
}

const empty_item: U32 = 0

func empty_slot () : Slot => $Slot { item: empty_item, count: 0 }

func max_stack_of (defs: #[ItemDef]) -> (item: U32) : U32 =>
  for d in defs:
    if d.id == item:
      return if d.max_stack == 0 then 1 else d.max_stack
  return 1

private func span_ok (start_idx: U32) -> (count: U32) -> (len: U32) : Bool =>
  return start_idx <= len and count <= len - start_idx

private func sat_add (a: U32) -> (b: U32) : U32 =>
  return if b > 4294967295 - a then 4294967295 else a + b

func count_item (slots: #[Slot]) -> (item: U32) : U32 =>
  if item == empty_item:
    return 0
  let total = 0
  for s in slots:
    if s.item == item:
      total := sat_add self s.count
  return total

// Insert `amount` of `item`, filling partial stacks first then empty slots.
// Returns `(leftover, slots)`.
func add_item (defs: #[ItemDef]) -> (item: U32) -> (amount: U32) -> (slots: own #[Slot]) : (U32, #[Slot]) =>
  if amount == 0:
    return (0, slots)
  if item == empty_item:
    return (amount, slots)
  let cap = max_stack_of defs item
  let rem = amount
  for i in 0 .. slots.length:
    if rem == 0:
      break
    let s = slots[i]
    if s.item == item and s.count < cap:
      let take = min rem (cap - s.count)
      slots[i] := $Slot { item, count: s.count + take }
      rem := self - take
  for i in 0 .. slots.length:
    if rem == 0:
      break
    let s = slots[i]
    if s.item == empty_item or s.count == 0:
      let take = min rem cap
      slots[i] := $Slot { item, count: take }
      rem := self - take
  return (rem, slots)

// Remove up to `amount` of `item`. If `all_or_nothing` is true and insufficient
// quantity exists, slots are untouched and returns `(false, slots)`.
func remove_item (item: U32) -> (amount: U32) -> (all_or_nothing: Bool) -> (slots: own #[Slot]) : (Bool, #[Slot]) =>
  if amount == 0:
    return (true, slots)
  if item == empty_item:
    return (false, slots)
  if all_or_nothing and count_item slots item < amount:
    return (false, slots)
  let rem = amount
  for i in 0 .. slots.length:
    if rem == 0:
      break
    let s = slots[i]
    if s.item == item and s.count > 0:
      let take = min rem s.count
      let left = s.count - take
      slots[i] := if left == 0 then empty_slot () else $Slot { item, count: left }
      rem := self - take
  return (rem == 0, slots)

// Checks whether `slots` satisfy every aggregated ingredient requirement of `recipe`
// and that the recipe's output item is valid (non-zero when `out_count > 0`).
func can_craft (recipe: Recipe) -> (ingredients: #[Ingredient]) -> (slots: #[Slot]) : Bool =>
  if recipe.out_count > 0 and recipe.out_item == empty_item:
    return false
  if not (span_ok recipe.in_start recipe.in_count ingredients.length):
    return false
  for i in 0 .. recipe.in_count:
    let item = ingredients[recipe.in_start + i].item
    if item == empty_item and ingredients[recipe.in_start + i].count > 0:
      return false
    // Aggregate total demand for `item` across all ingredient rows (handles duplicate item rows).
    let needed = 0
    for j in 0 .. recipe.in_count:
      let ing = ingredients[recipe.in_start + j]
      if ing.item == item:
        if ing.count > 4294967295 - needed:
          return false
        needed := self + ing.count
    if count_item slots item < needed:
      return false
  return true

// Consume ingredients and add output atomically (verifies space before mutating).
func craft (defs: #[ItemDef]) -> (recipe: Recipe) -> (ingredients: #[Ingredient]) -> (slots: own #[Slot]) : (Bool, #[Slot]) =>
  if not (can_craft recipe ingredients slots):
    return (false, slots)
  let scratch = @storage.copy slots
  for i in 0 .. recipe.in_count:
    let ing = ingredients[recipe.in_start + i]
    let (ok, next_s) = remove_item ing.item ing.count true scratch
    scratch := next_s
    if not ok:
      return (false, slots)
  let (leftover, after_add) = add_item defs recipe.out_item recipe.out_count scratch
  if leftover != 0:
    return (false, slots)
  for i in 0 .. slots.length:
    slots[i] := after_add[i]
  return (true, slots)

// 2D spatial grid inventory: `cells` is `grid_w * grid_h` occupancy (0 = free).
// Overflow-safe bounds checking against wrapped U32 coordinates and dimensions.
func grid_fits (cells: #[U32]) -> (grid_w: U32) -> (grid_h: U32) -> (x: U32) -> (y: U32) -> (w: U32) -> (h: U32) : Bool =>
  if grid_w == 0 or grid_h == 0 or w == 0 or h == 0:
    return false
  if grid_w > cells.length or grid_h > cells.length / grid_w:
    return false
  if x > grid_w or w > grid_w - x or y > grid_h or h > grid_h - y:
    return false
  for dy in 0 .. h:
    for dx in 0 .. w:
      if cells[(y + dy) * grid_w + (x + dx)] != 0:
        return false
  return true

func grid_place (grid_w: U32) -> (grid_h: U32) -> (x: U32) -> (y: U32) -> (w: U32) -> (h: U32) -> (token: U32) -> (cells: own #[U32]) : (Bool, #[U32]) =>
  if token == 0 or not (grid_fits cells grid_w grid_h x y w h):
    return (false, cells)
  for dy in 0 .. h:
    for dx in 0 .. w:
      cells[(y + dy) * grid_w + (x + dx)] := token
  return (true, cells)

func grid_remove (token: U32) -> (cells: own #[U32]) : #[U32] =>
  for i in 0 .. cells.length:
    if cells[i] == token:
      cells[i] := 0
  return cells

// Deterministic weighted loot drop roll from `table` using `ink/random`.
// Scales weights by `1 / max_weight` so large finite weights never overflow to Inf,
// and samples full-width U32 quantity ranges `[lo, hi]` without wrapping.
func roll_loot (table: #[LootEntry]) -> (seed: U32) : (Slot, U32) =>
  let max_w = 0.0
  for e in table:
    if is_finite e.weight and e.weight > max_w:
      max_w := e.weight
  if max_w <= 0.0:
    return (empty_slot (), seed)
  let total = 0.0
  for e in table:
    if is_finite e.weight and e.weight > 0.0:
      total := self + (e.weight / max_w)
  if total <= 0.0 or not (is_finite total):
    return (empty_slot (), seed)
  let s1 = random.next seed
  let target = random.unit s1 * total
  let acc = 0.0
  let chosen = 0
  let found = false
  for i in 0 .. table.length:
    let w = table[i].weight
    if is_finite w and w > 0.0:
      acc := self + (w / max_w)
      chosen := i
      found := true
      if target < acc:
        break
  if not found:
    return (empty_slot (), s1)
  let e = table[chosen]
  let lo = min e.min_count e.max_count
  let hi = max e.min_count e.max_count
  let s2 = random.next s1
  let diff = hi - lo
  let qty = if diff == 4294967295 then s2 else lo + (s2 % (diff + 1))
  return ($Slot { item: e.item, count: qty }, s2)
