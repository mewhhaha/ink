//! Gameplay Attribute & Modifier Stack (GAS-style): deterministic evaluation of
//! base values + stacked Add, Multiply and Override modifiers with min/max
//! clamping, plus timed effect and cooldown ticking.
//!
//! Key items: [`Op`], [`Modifier`], [`Spec`], [`Cooldown`], [`evaluate`].
//!
//! ```squid
//! import * as attrs from "ink/gameplay/attributes"
//! let spec = $attrs.Spec { base: 10.0, min_val: 0.0, max_val: 100.0 }
//! let mods = #[$attrs.Modifier { attribute: 0, source: 1, op: $attrs.Add, value: 5.0, remaining: 1.0 }]
//! attrs.evaluate 0 spec mods // => 15.0
//! ```

type Op is data = $Add | $Multiply | $Override

// `remaining < 0.0` denotes a permanent modifier; `remaining >= 0.0` ticks down.
type Modifier is data = $Modifier {
  attribute: U32,
  source: U32,
  op: Op,
  value: F32,
  remaining: F32,
}

type Spec is data = $Spec {
  base: F32,
  min_val: F32,
  max_val: F32,
}

type Cooldown is data = $Cooldown {
  ability: U32,
  remaining: F32,
  duration: F32,
}

// Compute the current value of `attribute` given `spec` and active `modifiers`:
// `(base + sum(Add)) * product(Multiply)` (or last `Override` if present),
// clamped to `[spec.min_val, spec.max_val]`.
func evaluate (attribute: U32) -> (spec: Spec) -> (modifiers: #[Modifier]) : F32 =>
  let base = if is_finite spec.base then spec.base else 0.0
  let add_sum = 0.0
  let mul_prod = 1.0
  let has_override = false
  let override_val = base
  for m in modifiers:
    if m.attribute == attribute and is_finite m.value:
      case m.op of
        $Add => do:
          add_sum := self + m.value
        $Multiply => do:
          mul_prod := self * m.value
        $Override => do:
          has_override := true
          override_val := m.value
  let lo = if is_finite spec.min_val then spec.min_val else (-3.4028234e38)
  let hi = if is_finite spec.max_val then spec.max_val else 3.4028234e38
  let low = min lo hi
  let high = max lo hi
  let raw = if has_override then override_val else (base + add_sum) * mul_prod
  if not (is_finite raw):
    if raw > 0.0:
      return high
    if raw < 0.0:
      return low
    return clamp low high base
  return clamp low high raw

// Evaluate every attribute in `specs` in a single O(A + M) pass.
func evaluate_all (specs: #[Spec]) -> (modifiers: #[Modifier]) : #[F32] =>
  let n = specs.length
  let adds = @array.fill n 0.0
  let muls = @array.fill n 1.0
  let has_ov = @array.fill n false
  let ovs = @array.fill n 0.0
  for m in modifiers:
    let attr = m.attribute
    if attr < n and is_finite m.value:
      case m.op of
        $Add => do:
          adds[attr] := adds[attr] + m.value
        $Multiply => do:
          muls[attr] := muls[attr] * m.value
        $Override => do:
          has_ov[attr] := true
          ovs[attr] := m.value
  let out = @array.fill n 0.0
  for i in 0 .. n:
    let spec = specs[i]
    let base = if is_finite spec.base then spec.base else 0.0
    let lo = if is_finite spec.min_val then spec.min_val else (-3.4028234e38)
    let hi = if is_finite spec.max_val then spec.max_val else 3.4028234e38
    let low = min lo hi
    let high = max lo hi
    let raw = if has_ov[i] then ovs[i] else (base + adds[i]) * muls[i]
    if not (is_finite raw):
      if raw > 0.0:
        out[i] := high
      else:
        if raw < 0.0:
          out[i] := low
        else:
          out[i] := clamp low high base
    else:
      out[i] := clamp low high raw
  return out

// Advance timed modifiers by `dt` seconds, compacting expired ones (`remaining <= 0`).
// Permanent modifiers (`remaining < 0`) are untouched.
func tick_modifiers (dt: F32) -> (modifiers: own #[Modifier]) : #[Modifier] =>
  if not (is_finite dt) or dt <= 0.0:
    return modifiers
  let write = 0
  let n = modifiers.length
  for i in 0 .. n:
    let m = modifiers[i]
    if m.remaining < 0.0:
      modifiers[write] := m
      write := self + 1
    else:
      let rem = m.remaining - dt
      if rem > 0.0:
        modifiers[write] := $Modifier { attribute: m.attribute, source: m.source, op: m.op, value: m.value, remaining: rem }
        write := self + 1
  @storage.truncate modifiers write
  return modifiers

// Remove all modifiers belonging to `source`.
func remove_source (source: U32) -> (modifiers: own #[Modifier]) : #[Modifier] =>
  let write = 0
  let n = modifiers.length
  for i in 0 .. n:
    let m = modifiers[i]
    if m.source != source:
      modifiers[write] := m
      write := self + 1
  @storage.truncate modifiers write
  return modifiers

// Start or refresh an ability cooldown; returns false if already on cooldown.
func trigger_cooldown (ability: U32) -> (duration: F32) -> (cooldowns: own #[Cooldown]) : (Bool, #[Cooldown]) =>
  if not (is_finite duration) or duration <= 0.0:
    return (false, cooldowns)
  for c in cooldowns:
    if c.ability == ability and c.remaining > 0.0:
      return (false, cooldowns)
  @storage.push cooldowns ($Cooldown { ability, remaining: duration, duration })
  return (true, cooldowns)

func ready (ability: U32) -> (cooldowns: #[Cooldown]) : Bool =>
  for c in cooldowns:
    if c.ability == ability and c.remaining > 0.0:
      return false
  return true

func tick_cooldowns (dt: F32) -> (cooldowns: own #[Cooldown]) : #[Cooldown] =>
  if not (is_finite dt) or dt <= 0.0:
    return cooldowns
  let write = 0
  let n = cooldowns.length
  for i in 0 .. n:
    let c = cooldowns[i]
    let rem = c.remaining - dt
    if rem > 0.0:
      cooldowns[write] := $Cooldown { ability: c.ability, remaining: rem, duration: c.duration }
      write := self + 1
  @storage.truncate cooldowns write
  return cooldowns
