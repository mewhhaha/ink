import * as array from "std/array"
import * as sort from "./sort"

// Full-width counters are subtracted before conversion to F32. A reset,
// changed channel count, or invalid elapsed time has no meaningful rate.
const counters_reset = fn (before: Array U32) (after: Array U32) => do:
  if before.length != after.length:
    return #True
  for i in 0 .. before.length:
    if after[i] < before[i]:
      return #True
  return #False
const counter_rates = fn (elapsed: F32) (before: Array U32) (after: Array U32) => do:
  if elapsed <= 0.0 || Bool.not (is_finite elapsed) || counters_reset before after:
    return #Nothing
  return #Some (array.generate before.length (fn i => from (after[i] - before[i]) / elapsed))
// Exact nearest-rank quantile. Endpoints select min/max; NaNs/infinities are
// rejected rather than assigned a platform-dependent sorting position.
const quantile = fn (fraction: F32) (values: Array F32) => do:
  if values.length == 0 || Bool.not (is_finite fraction) || fraction < 0.0 || fraction > 1.0:
    return #Nothing
  if Bool.not (array.all is_finite values):
    return #Nothing
  let order = sort.order values
  let rank = max 1 (F32.to_u32 (ceil (from values.length * fraction))) - 1
  return #Some values[order[min rank (values.length - 1)]]
// The largest finite samples, descending. Small requested ranks avoid sorting
// the full input; callers choose count (zero is an empty result).
const largest = fn (count: U32) (values: Array F32) => do:
  let top: Array F32 = #[]
  if count == 0:
    return top
  for value in values:
    if Bool.not (is_finite value):
      return @panic "statistics requires finite samples"
    if top.length < count || value > top[top.length - 1]:
      let at = top.length
      for index in 0 .. top.length:
        if at == top.length && value > top[index]:
          at := index
      top := array.flatten #[array.slice 0 at self, #[value], array.slice at (self.length - at) self]
      if top.length > count:
        top := array.slice 0 count self
  return top
