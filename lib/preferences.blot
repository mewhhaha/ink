import * as array from "std/array"
import * as ecs from "./ecs"
import * as lanes from "./lanes"
import * as window from "./events"

// The player's preferences: rendering quality, volumes and controls. The host
// keeps them between sessions: it plays the stored values back as Preference
// events when the game starts and after a load or reload, and stores them
// whenever a frame carries them, which it does after they change. The game's
// state holds them too (`codec`, not scenes), so a moment restored for time
// travel draws and sounds as it did; a load's own then give way to the
// player's, which the host plays back.
//
// Quality: samples per pixel (1, or 4 for MSAA), FXAA over the finished image,
// rendered pixels per screen pixel along each axis, texture filtering (0
// linear, 1 trilinear, otherwise that many anisotropic samples), the shadow
// map's texels a side (0 for none), ambient occlusion, a sky rather than the
// clear color, how thick the fog is (0 none, 1 as the game sets it, up to 2),
// screen effects such as the rock's colors splitting, and bloom: light past
// white spilling round it.
type Quality is data = #Quality {
  msaa: U32, fxaa: Bool, scale: F32, filtering: U32, shadows: U32,
  occlusion: Bool, sky: Bool, fog: F32, effects: Bool, bloom: Bool,
}
type Volumes is data = #Volumes { master: F32, effects: F32, music: F32 }
type Controls is data = #Controls { left_handed: Bool }
type Preferences is data = #Preferences { quality: Quality, volumes: Volumes, controls: Controls, changed: Bool }

// Applications choose the initial quality, volume and control policy.
const make = fn (quality: Quality) => fn (volumes: Volumes) => fn (controls: Controls) =>
  #Preferences { quality, volumes, controls, changed: #False }

// Lanes: msaa, fxaa, scale, filtering, shadows, occlusion, sky, fog, effects,
// then master, effects and music volume, bloom, and left-handed controls.
const encode = fn (preferences: Preferences) => do:
  let q = preferences.quality
  let v = preferences.volumes
  return #[
    from q.msaa, lanes.bit q.fxaa, q.scale, from q.filtering, from q.shadows,
    lanes.bit q.occlusion, lanes.bit q.sky, q.fog, lanes.bit q.effects,
    v.master, v.effects, v.music, lanes.bit q.bloom, lanes.bit preferences.controls.left_handed,
  ]
const lanes_count = 14

const fraction = fn (value: F32) => clamp 0.0 1.0 value
const filtering_option = fn (wanted: U32) => wanted == 0 || wanted == 1 || wanted == 4 || wanted == 8 || wanted == 16
const shadow_option = fn (wanted: U32) => wanted == 0 || wanted == 1024 || wanted == 2048 || wanted == 4096
const one_of = fn (allowed: Array U32) => fn (fallback: U32) => fn (value: F32) => do:
  let wanted = F32.to_u32 (max 0.0 value)
  if value != U32.to_f32 wanted:
    return fallback
  if array.any (fn (option: U32) => option == wanted) allowed:
    return wanted
  return fallback

// Preference `index` set to `value`, or unchanged if `value` does not fit.
const apply = fn (preferences: Preferences) => fn (index: U32) => fn (value: F32) => do:
  if Bool.not (is_finite value):
    return preferences
  let q = preferences.quality
  let v = preferences.volumes
  let controls = preferences.controls
  let on = value >= 0.5
  if index == 0:
    q.msaa := one_of #[1, 4] self value
  if index == 1:
    q.fxaa := on
  if index == 2:
    q.scale := clamp 0.5 2.0 value
  if index == 3:
    q.filtering := one_of #[0, 1, 4, 8, 16] self value
  if index == 4:
    q.shadows := one_of #[0, 1024, 2048, 4096] self value
  if index == 5:
    q.occlusion := on
  if index == 6:
    q.sky := on
  if index == 7:
    q.fog := clamp 0.0 2.0 value
  if index == 8:
    q.effects := on
  if index == 9:
    v.master := fraction value
  if index == 10:
    v.effects := fraction value
  if index == 11:
    v.music := fraction value
  if index == 12:
    q.bloom := on
  if index == 13:
    controls.left_handed := on
  return #Preferences { quality: q, volumes: v, controls, changed: preferences.changed }

// The host's stored values arrive as Preference events.
const receive = fn (event: window.Event) => do:
  let #window.Preference { index, value } = event else:
    return ()
  use current <- ecs.get #Preferences
  return ecs.set (apply current index value)

// Changes the preferences and has the next frame carry them to the host.
const change = fn (next: Preferences) => do:
  next.changed := #True
  return ecs.set next

// The saved lanes: those `encode` gives the host, then whether the next frame
// carries them.
const encode_saved = fn (preferences: Preferences) => do:
  let q = preferences.quality
  let v = preferences.volumes
  return #[
    from q.msaa, lanes.bit q.fxaa, q.scale, from q.filtering, from q.shadows,
    lanes.bit q.occlusion, lanes.bit q.sky, q.fog, lanes.bit q.effects,
    v.master, v.effects, v.music, lanes.bit q.bloom, lanes.bit preferences.controls.left_handed,
    lanes.bit preferences.changed,
  ]

const decode = fn (values: Array F32) => do:
  use lanes.exact values (lanes_count + 1)
  use lanes.finite values
  let quality = #Quality {
    msaa: lanes.integer values[0] lanes.max_integer, fxaa: lanes.flag values[1], scale: values[2],
    filtering: lanes.integer values[3] lanes.max_integer, shadows: lanes.integer values[4] lanes.max_integer,
    occlusion: lanes.flag values[5], sky: lanes.flag values[6], fog: values[7],
    effects: lanes.flag values[8], bloom: lanes.flag values[12],
  }
  use lanes.require (quality.msaa == 1 || quality.msaa == 4)
  use lanes.require (quality.scale >= 0.5 && quality.scale <= 2.0)
  use lanes.require (filtering_option quality.filtering)
  use lanes.require (shadow_option quality.shadows)
  use lanes.require (quality.fog >= 0.0 && quality.fog <= 2.0)
  let volumes = #Volumes { master: values[9], effects: values[10], music: values[11] }
  use lanes.require (volumes.master >= 0.0 && volumes.master <= 1.0 && volumes.effects >= 0.0 && volumes.effects <= 1.0 && volumes.music >= 0.0 && volumes.music <= 1.0)
  return #Preferences { quality, volumes, controls: #Controls { left_handed: lanes.flag values[13] }, changed: lanes.flag values[14] }

const codec = #lanes.Codec { key: 14, version: 1, encode: encode_saved, decode, migrate: lanes.no_migration }
