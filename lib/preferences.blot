import * as array from "std/array"
import * as lanes from "./lanes"
import * as window from "./events"

// The player's preferences: rendering quality, volumes and controls. The host
// keeps them between sessions: it plays the stored values back as Preference
// events when the game starts and after a load or reload, and stores them
// whenever a frame carries them, which it does after they change. The game's
// state holds them too (`codec`, not scenes), so a moment restored for time
// travel draws and sounds as it did; a load's own then give way to the
// player's, which the host plays back.
//
// Quality: samples per pixel (1, or 4 for MSAA), FXAA over the finished image,
// rendered pixels per screen pixel along each axis, texture filtering (0
// linear, 1 trilinear, otherwise that many anisotropic samples), the shadow
// map's texels a side (0 for none), ambient occlusion, a sky rather than the
// clear color, how thick the fog is (0 none, 1 as the game sets it, up to 2),
// screen effects such as the rock's colors splitting, bloom: light past
// white spilling round it, and reflections: how far glossy surfaces look
// beyond the sky (0 the sky alone, 1 local probes and a short screen-space
// march, 2 a longer march), which caps the scene's own `screen_reflections`,
// and volumetrics: how the fog is lit (0 the analytic mist alone, 1 a coarse
// froxel volume with shafts and local volumes, 2 a finer one), which caps the
// scene's own `volumetrics`. `fog` stays how thick it is.
type Quality is data = $Quality {
  msaa: U32, fxaa: Bool, scale: F32, filtering: U32, shadows: U32,
  occlusion: Bool, sky: Bool, fog: F32, effects: Bool, bloom: Bool, reflections: U32, volumetrics: U32,
}
type Volumes is data = $Volumes { master: F32, effects: F32, music: F32 }
type Controls is data = $Controls { left_handed: Bool }
type Preferences is data = $Preferences { quality: Quality, volumes: Volumes, controls: Controls, changed: Bool }

// Applications choose the initial quality, volume and control policy.
func make (quality: Quality) => func (volumes: Volumes) => func (controls: Controls) => return
  $Preferences { quality, volumes, controls, changed: false }

// Lanes: msaa, fxaa, scale, filtering, shadows, occlusion, sky, fog, effects,
// then master, effects and music volume, bloom, left-handed controls,
// reflections and volumetrics.
func encode (preferences: Preferences) =>
  let q = preferences.quality
  let v = preferences.volumes
  return #[
    from q.msaa, lanes.bit q.fxaa, q.scale, from q.filtering, from q.shadows,
    lanes.bit q.occlusion, lanes.bit q.sky, q.fog, lanes.bit q.effects,
    v.master, v.effects, v.music, lanes.bit q.bloom, lanes.bit preferences.controls.left_handed,
    from q.reflections, from q.volumetrics,
  ]
const lanes_count = 16

func fraction (value: F32) => clamp 0.0 1.0 value
func filtering_option (wanted: U32) => wanted == 0 or wanted == 1 or wanted == 4 or wanted == 8 or wanted == 16
func shadow_option (wanted: U32) => wanted == 0 or wanted == 1024 or wanted == 2048 or wanted == 4096
func one_of (allowed: #[U32]) => func (fallback: U32) => func (value: F32) =>
  if not (is_finite value) or value < 0.0 or value >= 4294967296.0:
    return fallback
  let wanted = F32.to_u32 value
  if value != U32.to_f32 wanted:
    return fallback
  if array.any (func (option: U32) => option == wanted) allowed:
    return wanted
  return fallback

// Preference `index` set to `value`, or unchanged if `value` does not fit.
func apply (preferences: Preferences) => func (index: U32) => func (value: F32) =>
  if not (is_finite value):
    return preferences
  let q = preferences.quality
  let v = preferences.volumes
  let controls = preferences.controls
  let on = value >= 0.5
  if index == 0:
    q.msaa := one_of #[1, 4] self value
  if index == 1:
    q.fxaa := on
  if index == 2:
    q.scale := clamp 0.5 2.0 value
  if index == 3:
    q.filtering := one_of #[0, 1, 4, 8, 16] self value
  if index == 4:
    q.shadows := one_of #[0, 1024, 2048, 4096] self value
  if index == 5:
    q.occlusion := on
  if index == 6:
    q.sky := on
  if index == 7:
    q.fog := clamp 0.0 2.0 value
  if index == 8:
    q.effects := on
  if index == 9:
    v.master := fraction value
  if index == 10:
    v.effects := fraction value
  if index == 11:
    v.music := fraction value
  if index == 12:
    q.bloom := on
  if index == 13:
    controls.left_handed := on
  if index == 14:
    q.reflections := one_of #[0, 1, 2] self value
  if index == 15:
    q.volumetrics := one_of #[0, 1, 2] self value
  return $Preferences { quality: q, volumes: v, controls, changed: preferences.changed }

// The host's stored values arrive as Preference events.
func receive (owned: own #[Preferences]) -> (event: window.Event): #[Preferences] =>
  if owned.length == 0:
    return owned
  let $window.Preference { index, value } = event else:
    return owned
  owned[0] := apply owned[0] index value
  return owned

// Changes the preferences and has the next frame carry them to the host.
func change (owned: own #[Preferences]) -> (next: Preferences): #[Preferences] =>
  if owned.length == 0:
    return owned
  next.changed := true
  owned[0] := next
  return owned

// The saved lanes: those `encode` gives the host, then whether the next frame
// carries them.
func encode_saved (preferences: Preferences) =>
  let q = preferences.quality
  let v = preferences.volumes
  return #[
    from q.msaa, lanes.bit q.fxaa, q.scale, from q.filtering, from q.shadows,
    lanes.bit q.occlusion, lanes.bit q.sky, q.fog, lanes.bit q.effects,
    v.master, v.effects, v.music, lanes.bit q.bloom, lanes.bit preferences.controls.left_handed,
    from q.reflections, from q.volumetrics, lanes.bit preferences.changed,
  ]

func decode (values: #[F32]) =>
  use lanes.exact values (lanes_count + 1)
  use lanes.finite values
  let quality = $Quality {
    msaa: lanes.integer values[0] lanes.max_integer, fxaa: lanes.flag values[1], scale: values[2],
    filtering: lanes.integer values[3] lanes.max_integer, shadows: lanes.integer values[4] lanes.max_integer,
    occlusion: lanes.flag values[5], sky: lanes.flag values[6], fog: values[7],
    effects: lanes.flag values[8], bloom: lanes.flag values[12],
    reflections: lanes.integer values[14] lanes.max_integer, volumetrics: lanes.integer values[15] lanes.max_integer,
  }
  use lanes.require (quality.msaa == 1 or quality.msaa == 4)
  use lanes.require (quality.scale >= 0.5 and quality.scale <= 2.0)
  use lanes.require (filtering_option quality.filtering)
  use lanes.require (shadow_option quality.shadows)
  use lanes.require (quality.fog >= 0.0 and quality.fog <= 2.0)
  use lanes.require (quality.reflections <= 2)
  use lanes.require (quality.volumetrics <= 2)
  let volumes = $Volumes { master: values[9], effects: values[10], music: values[11] }
  use lanes.require (volumes.master >= 0.0 and volumes.master <= 1.0 and volumes.effects >= 0.0 and volumes.effects <= 1.0 and volumes.music >= 0.0 and volumes.music <= 1.0)
  return $Preferences { quality, volumes, controls: $Controls { left_handed: lanes.flag values[13] }, changed: lanes.flag values[16] }

const codec = $lanes.Codec { key: 14, version: 3, encode: encode_saved, decode, migrate: lanes.no_migration }
