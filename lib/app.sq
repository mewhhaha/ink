//! Application composition is static. A known stage-policy record contains
//! direct helpers, never a runtime array of functions or a world/scope closure.
//! Resource/component owners are named independently by the application; access
//! only aliases those owners during a call.
//!
//! Key items: [`EventContext`], [`Presentation`], [`Pause`], [`Wall`], [`control`].

import * as codec_lib from "./codec"
import * as lanes from "./lanes"
import * as time from "./clock"
import * as window from "./events"

type EventContext is data = $EventContext { event: window.Event, width: F32, height: F32 }
type Presentation is data = $Presentation { alpha: F32, width: F32, height: F32 }
type Pause is data = $Pause { on: Bool }
type Wall is data = $Wall { seconds: F32 }
// Control owner: normalization pending, pause enabled, hold next simulation frame.
type Control = #[U32]
// Lanes: normalization pending, paused, hold the next frame, and a cut pending for
// the host's presentation (the exposure it adapted to belongs to an earlier moment).
func control () : Control => #[1, 0, 0, 0]
func wall () : #[Wall] => #[$Wall {seconds: 0.0}]
func encode_pause (held: Pause) => codec_lib.encode_lanes held
func decode_pause (values: #[F32]): Pause => codec_lib.require_lanes values
const pause_codec = $lanes.Codec {key: 13, version: 1, encode: encode_pause, decode: decode_pause, migrate: lanes.no_migration}
func no_action (own access) => access
func no_event (own access) -> context => access
func no_update (own access) -> seconds => access
func no_render (own access) -> presentation => access
func route_event (own access) -> context => (context, access)
// For a hook that is lent the world and has nothing to do with it.
func no_keep (own access) => access
// A stage out of a function that writes through the world it is lent.
func lent step => func (own access) =>
  use step access
  return access
func lent_with step => func (own access) -> argument =>
  use step access argument
  return access
// A stage takes the world and hands it back; `route` also produces the routed
// event that `interface` and `event` are given.
// All stages use the same world. Each has its own latent effects.
func stages (reset: own a -> a ! {| reset_effect})
  -> (start: own a -> a ! {| start_effect})
  -> (normalize: own a -> a ! {| normalize_effect})
  -> (checkpoint: own a -> a ! {| checkpoint_effect})
  -> (route: own a -> (EventContext -> (EventContext, a) ! {| route_effect}))
  -> (interface: own a -> (EventContext -> a ! {| interface_effect}))
  -> (event: own a -> (EventContext -> a ! {| event_effect}))
  -> (update: own a -> (F32 -> a ! {| update_effect}))
  -> (render: own a -> (Presentation -> a ! {| render_effect}))
  -> (settle: own a -> a ! {| settle_effect}) => return
  {reset, start, normalize, checkpoint, route, interface, event, update, render, settle}
func paused (control: Control) => control[1] != 0
func pause (control: own Control) -> (on: Bool): Control =>
  control[1] := if on then 1 else 0
  return control
func hold_frame (control: own Control): Control =>
  control[2] := 1
  return control
func invalidate (control: own Control): Control =>
  control[0] := 1
  control[3] := 1
  return control
// Whether the next presented frame is a cut, as one after a restore is.
func cut (control: Control) => control[3] != 0
func clear_cut (control: own Control): Control =>
  control[3] := 0
  return control
func stale (control: Control) => control[0] != 0
func held (control: Control) => control[2] != 0
func ensure_normalized stages -> (own access) =>
  if stale access.control:
    use normalized <- stages.normalize (own access)
    use checkpointed <- stages.checkpoint (own normalized)
    access := checkpointed
    access.control[0] := 0
  return access
func start stages -> (own access) =>
  use access <- stages.start (own access)
  access.control[0] := 1
  return ensure_normalized stages access
// Begin only after the previous output's borrowed ranges have been encoded.
func begin_frame stages -> (own access) => stages.reset (own access)
func run_event stages -> (own access) -> event -> width -> height =>
  let original = $EventContext {event, width, height}
  use routed <- stages.route (own access) original
  let (context, next_access) = routed
  access := next_access
  let was_paused = paused access.control
  use access <- stages.interface (own access) context
  if not was_paused and not (paused access.control):
    return stages.event (own access) context
  return access
// The world after the frame's events and fixed steps, with the plan of
// those steps. The clock, the control cell and the wall are its own.
func advance stages -> (own access) -> (policy: time.Policy) -> (elapsed: F32) -> events -> width -> height =>
  let clock: #[time.Clock] = access.clock
  let control: Control = access.control
  let wall: #[Wall] = access.wall
  lanes.require (clock.length == 1 and control.length == 4 and wall.length == 1)
  lanes.require (is_finite elapsed and elapsed >= 0.0)
  use access <- ensure_normalized stages access
  access.wall[0] := $Wall {seconds: min policy.max_elapsed elapsed}
  for event in events:
    use routed <- run_event stages access event width height
    access := routed
  let frame_held = held access.control
  access.control[2] := 0
  let delta = if paused access.control or frame_held then 0.0 else elapsed
  return time.advance policy access stages.checkpoint stages.update delta
// `advance` for a caller that has no use for the plan.
func advanced stages -> (own access) -> (policy: time.Policy) -> (elapsed: F32) -> events -> width -> height =>
  use result <- advance stages access policy elapsed events width height
  let (_, next) = result
  return next
func render stages -> (own access) -> alpha -> width -> height =>
  use access <- ensure_normalized stages access
  use access <- stages.render (own access) ($Presentation {alpha, width, height})
  return stages.settle (own access)
// Creation/restore/reset are explicit static schema operations. Restoring a
// checkpoint clears derived caches/journal epochs in the application's decoder,
// then calls invalidate. There is no general preview or discarded world fork.
