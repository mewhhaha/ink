import { Vec3 } from "std/vector"
import * as math from "./math"

// Splines: smooth curves through their points that cameras and other movers
// travel along by distance, at constant speed. The curve is centripetal
// Catmull-Rom (alpha 0.5): it passes through every point, with no cusps or
// self-intersections within a segment and no overshoot past close points.
// Distances are metres along the curve.

// One segment, a u^3 + b u^2 + c u + d for u in [0, 1].
type Cubic is data = #Cubic { a: Vec3, b: Vec3, c: Vec3, d: Vec3 }

// `lengths` is the arc length from the start to each of `samples` equal steps
// of u in every segment, so it has a segment count times `samples` plus one
// entries, starting at zero and ending at `length`.
type Spline is data = #Spline { closed: Bool, cubics: Array Cubic, lengths: Array F32, length: F32 }

const samples = 16

// A point this close to the one kept before it is skipped.
const apart = 0.000001

// The cubic from p1 to p2, with p0 before and p3 after, in Hermite form: its
// end tangents come from the centripetal knot spacing, the square root of
// each chord's length.
const segment = fn (p0: Vec3) => fn (p1: Vec3) => fn (p2: Vec3) => fn (p3: Vec3) => do:
  let t01 = sqrt (p1 - p0).length
  let t12 = sqrt (p2 - p1).length
  let t23 = sqrt (p3 - p2).length
  let chord = p2 - p1
  let m1 = chord + ((p1 - p0) * (1.0 / t01) - (p2 - p0) * (1.0 / (t01 + t12))) * t12
  let m2 = chord + ((p3 - p2) * (1.0 / t23) - (p3 - p1) * (1.0 / (t12 + t23))) * t12
  return #Cubic { a: m1 + m2 - chord * 2.0, b: chord * 3.0 - m1 * 2.0 - m2, c: m1, d: p1 }

const point = fn (cubic: Cubic) => fn (u: F32) => ((cubic.a * u + cubic.b) * u + cubic.c) * u + cubic.d

const velocity = fn (cubic: Cubic) => fn (u: F32) => cubic.a * (3.0 * u * u) + cubic.b * (2.0 * u) + cubic.c

const speed = fn (cubic: Cubic) => fn (u: F32) => (velocity cubic u).length

// Arc length from u0 to u1 by three-point Gauss-Legendre quadrature, exact
// where the speed is a polynomial of degree five or less, as on a line.
const arc = fn (cubic: Cubic) => fn (u0: F32) => fn (u1: F32) => do:
  let half = (u1 - u0) * 0.5
  let middle = u0 + half
  let offset = half * 0.774596669
  let sum = speed cubic (middle - offset) * 5.0 + speed cubic middle * 8.0 + speed cubic (middle + offset) * 5.0
  return sum * half / 9.0

// The points, skipping each within `apart` of the last one kept; Nothing if
// any is not finite.
const distinct = fn (points: Array Vec3) => do:
  for p in points:
    if Bool.not (math.finite3 p):
      return #Nothing
  let kept: List Vec3 = []
  let last = math.zero3
  let count = 0
  for p in points:
    if count == 0 || (p - last).length > apart:
      kept := [...self, p]
      last := p
      count := self + 1
  return #Some (Array.from_list kept)

// Measures the cubics; Nothing when the length overflows. The running total
// is compensated (Kahan), so long curves keep F32 precision.
const measured = fn (closed: Bool) => fn (cubics: Array Cubic) => do:
  let lengths = @array.fill (cubics.length * samples + 1) 0.0
  let step = 1.0 / U32.to_f32 samples
  let total = 0.0
  let carry = 0.0
  for i in 0..cubics.length:
    let cubic = cubics[i]
    for k in 0..samples:
      let u0 = U32.to_f32 k * step
      let piece = arc cubic u0 (u0 + step) - carry
      let next = total + piece
      carry := (next - total) - piece
      total := next
      lengths[i * samples + k + 1] := total
  if Bool.not (is_finite total && total > 0.0):
    return #Nothing
  return #Some (#Spline { closed, cubics, lengths, length: total })

// An open curve from the first point to the last. Each end continues its
// first chord, as if mirrored past the end. Needs two distinct points;
// Nothing for fewer or for a non-finite point.
const make = fn (points: Array Vec3) -> Maybe Spline => do:
  let #Some p = distinct points else:
    return #Nothing
  let n = p.length
  if n < 2:
    return #Nothing
  let before = p[0] * 2.0 - p[1]
  let after = p[n - 1] * 2.0 - p[n - 2]
  let cubics = @array.generate (n - 1) (fn (i: U32) => do:
    let p0 = before
    if i > 0:
      p0 := p[i - 1]
    let p3 = after
    if i + 2 < n:
      p3 := p[i + 2]
    return segment p0 p[i] p[i + 1] p3)
  return measured #False cubics

// A closed loop through the points and back to the first. A last point on
// the first is dropped. Needs three distinct points.
const make_loop = fn (points: Array Vec3) -> Maybe Spline => do:
  let #Some p = distinct points else:
    return #Nothing
  let n = p.length
  if n > 1 && (p[n - 1] - p[0]).length <= apart:
    n := self - 1
  if n < 3:
    return #Nothing
  let cubics = @array.generate n (fn (i: U32) => segment p[(i + n - 1) % n] p[i] p[(i + 1) % n] p[(i + 2) % n])
  return measured #True cubics

const length = fn (spline: Spline) => spline.length

// How far along the curve each kept point lies, in order: from 0 to the
// length on an open curve; a loop lists each point once, its first at 0.
const marks = fn (spline: Spline) => do:
  let count = spline.cubics.length
  if Bool.not spline.closed:
    count := self + 1
  let lengths = spline.lengths
  return @array.generate count (fn (i: U32) => lengths[i * samples])

// `distance` within the curve: held to its ends, or wrapped around a loop.
// A non-finite distance is the start.
const within = fn (spline: Spline) => fn (distance: F32) => do:
  if Bool.not (is_finite distance):
    return 0.0
  if spline.closed:
    return wrap spline.length distance
  return clamp 0.0 spline.length distance

// The segment and its u at `distance` metres along: the table's sample by
// binary search, then u within it by two Newton steps on the arc length, so
// equal distances stay equal on the curve, not just on the table. One step
// leaves errors of a tenth of a percent at tight corners.
const locate = fn (spline: Spline) => fn (distance: F32) => do:
  let s = within spline distance
  let table = spline.lengths
  let low = 1
  let high = table.length - 1
  for 0..32:
    if low < high:
      let middle = low + (high - low) / 2
      let value = table[middle]
      if s < value:
        high := middle
      else:
        low := middle + 1
  let start = table[low - 1]
  let finish = table[low]
  let index = (low - 1) / samples
  let step = 1.0 / U32.to_f32 samples
  let u0 = U32.to_f32 ((low - 1) % samples) * step
  let fraction = 0.0
  if finish > start:
    fraction := clamp 0.0 1.0 ((s - start) / (finish - start))
  let cubic = spline.cubics[index]
  let u = u0 + fraction * step
  for 0..2:
    let rate = speed cubic u
    if rate > 0.0:
      u := clamp u0 (u0 + step) (u - (start + arc cubic u0 u - s) / rate)
  return (cubic, u)

// The point `distance` metres along the curve.
const at = fn (spline: Spline) => fn (distance: F32) => do:
  let (cubic, u) = locate spline distance
  return point cubic u

// The unit direction the curve heads `distance` metres along. Where the
// curve's speed vanishes, the segment's chord.
const tangent = fn (spline: Spline) => fn (distance: F32) => do:
  let (cubic, u) = locate spline distance
  let #Some direction = math.normalize3 (velocity cubic u) else:
    return (point cubic 1.0 - cubic.d).normalized
  return direction
