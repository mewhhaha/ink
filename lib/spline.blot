import * as simd from "std/simd"
import { Vec3 } from "std/vector"
import * as math from "./math"

// Splines: smooth curves through their points that cameras and other movers
// travel along by distance, at constant speed. The curve is centripetal
// Catmull-Rom (alpha 0.5): it passes through every point, with no cusps or
// self-intersections within a segment and no overshoot past close points.
// Distances are metres along the curve.

// Each segment is a u^3 + b u^2 + c u + d for u in [0, 1], stored as twelve
// F32 coefficients, ax ay az bx by bz cx cy cz dx dy dz, in `coefficients`:
// reading them straight from one flat array keeps the hot arithmetic on
// scalars, with no vector allocated per step.
// `lengths` is the arc length from the start to each of `samples` equal steps
// of u in every segment, so it has a segment count times `samples` plus one
// entries, starting at zero and ending at `length`.
type Spline is data = $Spline { closed: Bool, segments: U32, coefficients: &[F32], lengths: &[F32], length: F32 }

// A multiple of four: the table measures four samples per vector.
const samples = 16

// Coefficients per segment.
const width = 12

// A point this close to the one kept before it is skipped.
const apart = 0.000001

// One axis of the end tangents of the cubic from p1 to p2, with p0 before and
// p3 after: `inward` scales p1 - p0 by 1 / t01 and `across` p2 - p0 by
// 1 / (t01 + t12), both times t12, from the centripetal knot spacing.
const tangent_axis = func (chord: F32) => return func (inward: F32) => return func (across: F32) => return func (near: F32) => return func (far: F32) => return func (t12: F32) => return
  chord + (inward * near - across * far) * t12

// The chord's centripetal knot spacing, the square root of its length.
const knot = func (x: F32) => return func (y: F32) => return func (z: F32) => return sqrt (sqrt (x * x + y * y + z * z))

// The cubic from p1 to p2, with p0 before and p3 after, in Hermite form, as
// its twelve coefficients: its end tangents come from the centripetal knot
// spacing, the square root of each chord's length.
const segment = func (p0: Vec3) => return func (p1: Vec3) => return func (p2: Vec3) => return func (p3: Vec3) => return do:
  let t01 = knot (p1.x - p0.x) (p1.y - p0.y) (p1.z - p0.z)
  let t12 = knot (p2.x - p1.x) (p2.y - p1.y) (p2.z - p1.z)
  let t23 = knot (p3.x - p2.x) (p3.y - p2.y) (p3.z - p2.z)
  let in1 = 1.0 / t01
  let across1 = 1.0 / (t01 + t12)
  let in2 = 1.0 / t23
  let across2 = 1.0 / (t12 + t23)
  let cx = p2.x - p1.x
  let cy = p2.y - p1.y
  let cz = p2.z - p1.z
  let m1x = tangent_axis cx (p1.x - p0.x) (p2.x - p0.x) in1 across1 t12
  let m1y = tangent_axis cy (p1.y - p0.y) (p2.y - p0.y) in1 across1 t12
  let m1z = tangent_axis cz (p1.z - p0.z) (p2.z - p0.z) in1 across1 t12
  let m2x = tangent_axis cx (p3.x - p2.x) (p3.x - p1.x) in2 across2 t12
  let m2y = tangent_axis cy (p3.y - p2.y) (p3.y - p1.y) in2 across2 t12
  let m2z = tangent_axis cz (p3.z - p2.z) (p3.z - p1.z) in2 across2 t12
  return (
    m1x + m2x - cx * 2.0, m1y + m2y - cy * 2.0, m1z + m2z - cz * 2.0,
    cx * 3.0 - m1x * 2.0 - m2x, cy * 3.0 - m1y * 2.0 - m2y, cz * 3.0 - m1z * 2.0 - m2z,
    m1x, m1y, m1z, p1.x, p1.y, p1.z,
  )

// The segment at `base` at u.
const point = func (c: &[F32]) => return func (base: U32) => return func (u: F32) => return $Vec3 {
  x: ((c[base] * u + c[base + 3]) * u + c[base + 6]) * u + c[base + 9],
  y: ((c[base + 1] * u + c[base + 4]) * u + c[base + 7]) * u + c[base + 10],
  z: ((c[base + 2] * u + c[base + 5]) * u + c[base + 8]) * u + c[base + 11],
}

const velocity = func (c: &[F32]) => return func (base: U32) => return func (u: F32) => return do:
  let k3 = 3.0 * u * u
  let k2 = 2.0 * u
  return $Vec3 {
    x: c[base] * k3 + c[base + 3] * k2 + c[base + 6],
    y: c[base + 1] * k3 + c[base + 4] * k2 + c[base + 7],
    z: c[base + 2] * k3 + c[base + 5] * k2 + c[base + 8],
  }

const speed = func (c: &[F32]) => return func (base: U32) => return func (u: F32) => return do:
  let k3 = 3.0 * u * u
  let k2 = 2.0 * u
  let x = c[base] * k3 + c[base + 3] * k2 + c[base + 6]
  let y = c[base + 1] * k3 + c[base + 4] * k2 + c[base + 7]
  let z = c[base + 2] * k3 + c[base + 5] * k2 + c[base + 8]
  return sqrt (x * x + y * y + z * z)

// Arc length from u0 to u1 by three-point Gauss-Legendre quadrature, exact
// where the speed is a polynomial of degree five or less, as on a line.
const arc = func (c: &[F32]) => return func (base: U32) => return func (u0: F32) => return func (u1: F32) => return do:
  let half = (u1 - u0) * 0.5
  let middle = u0 + half
  let offset = half * 0.774596669
  let sum = speed c base (middle - offset) * 5.0 + speed c base middle * 8.0 + speed c base (middle + offset) * 5.0
  return sum * half / 9.0

// The points, skipping each within `apart` of the last one kept; Nothing if
// any is not finite. When none is skipped, the points themselves.
const distinct = func (points: Array Vec3) => return do:
  for p in points:
    if Bool.not (math.finite3 p):
      return $Nothing
  let count = 0
  let last = math.zero3
  for p in points:
    if count == 0 or (p - last).length > apart:
      last := p
      count := self + 1
  if count == points.length:
    return $Some points
  let kept = @array.fill count math.zero3
  let index = 0
  for p in points:
    if index == 0 or (p - last).length > apart:
      kept[index] := p
      last := p
      index := self + 1
  return $Some kept

// Measures the segments; Nothing when the length overflows. The running total
// is compensated (Kahan), so long curves keep F32 precision.
const measured_into = func (closed: Bool) -> (segments: U32) -> (coefficients: Array F32) -> (out_coefficients: ResizeArray F32) -> (out_lengths: ResizeArray F32) : Maybe Spline => return do:
  let lengths = @array.fill (segments * samples + 1) 0.0
  let step = 1.0 / U32.to_f32 samples
  let total = 0.0
  let carry = 0.0
  for i in 0..segments:
    let base = i * width
    let ax = coefficients[base]
    let ay = coefficients[base + 1]
    let az = coefficients[base + 2]
    let bx = coefficients[base + 3]
    let by = coefficients[base + 4]
    let bz = coefficients[base + 5]
    let cx = coefficients[base + 6]
    let cy = coefficients[base + 7]
    let cz = coefficients[base + 8]
    // `arc` for four samples at a time, with the segment's coefficients read
    // once; the compensated total then takes the pieces in order.
    for q in 0..samples / 4:
      let k = q * 4
      let u0 = simd.f32_mul (simd.to_f32 (k, k + 1, k + 2, k + 3)) (simd.f32_splat step)
      let half = simd.f32_mul (simd.f32_sub (simd.f32_add u0 (simd.f32_splat step)) u0) (simd.f32_splat 0.5)
      let middle = simd.f32_add u0 half
      let offset = simd.f32_mul half (simd.f32_splat 0.774596669)
      let three = simd.f32_splat 3.0
      let two = simd.f32_splat 2.0
      let ax4 = simd.f32_splat ax
      let ay4 = simd.f32_splat ay
      let az4 = simd.f32_splat az
      let bx4 = simd.f32_splat bx
      let by4 = simd.f32_splat by
      let bz4 = simd.f32_splat bz
      let cx4 = simd.f32_splat cx
      let cy4 = simd.f32_splat cy
      let cz4 = simd.f32_splat cz
      let low = simd.f32_sub middle offset
      let high = simd.f32_add middle offset
      let k30 = simd.f32_mul (simd.f32_mul three low) low
      let k20 = simd.f32_mul two low
      let x0 = simd.f32_add (simd.f32_add (simd.f32_mul ax4 k30) (simd.f32_mul bx4 k20)) cx4
      let y0 = simd.f32_add (simd.f32_add (simd.f32_mul ay4 k30) (simd.f32_mul by4 k20)) cy4
      let z0 = simd.f32_add (simd.f32_add (simd.f32_mul az4 k30) (simd.f32_mul bz4 k20)) cz4
      let r0 = simd.f32_sqrt (simd.f32_add (simd.f32_add (simd.f32_mul x0 x0) (simd.f32_mul y0 y0)) (simd.f32_mul z0 z0))
      let k31 = simd.f32_mul (simd.f32_mul three middle) middle
      let k21 = simd.f32_mul two middle
      let x1 = simd.f32_add (simd.f32_add (simd.f32_mul ax4 k31) (simd.f32_mul bx4 k21)) cx4
      let y1 = simd.f32_add (simd.f32_add (simd.f32_mul ay4 k31) (simd.f32_mul by4 k21)) cy4
      let z1 = simd.f32_add (simd.f32_add (simd.f32_mul az4 k31) (simd.f32_mul bz4 k21)) cz4
      let r1 = simd.f32_sqrt (simd.f32_add (simd.f32_add (simd.f32_mul x1 x1) (simd.f32_mul y1 y1)) (simd.f32_mul z1 z1))
      let k32 = simd.f32_mul (simd.f32_mul three high) high
      let k22 = simd.f32_mul two high
      let x2 = simd.f32_add (simd.f32_add (simd.f32_mul ax4 k32) (simd.f32_mul bx4 k22)) cx4
      let y2 = simd.f32_add (simd.f32_add (simd.f32_mul ay4 k32) (simd.f32_mul by4 k22)) cy4
      let z2 = simd.f32_add (simd.f32_add (simd.f32_mul az4 k32) (simd.f32_mul bz4 k22)) cz4
      let r2 = simd.f32_sqrt (simd.f32_add (simd.f32_add (simd.f32_mul x2 x2) (simd.f32_mul y2 y2)) (simd.f32_mul z2 z2))
      let sum = simd.f32_add (simd.f32_add (simd.f32_mul r0 (simd.f32_splat 5.0)) (simd.f32_mul r1 (simd.f32_splat 8.0))) (simd.f32_mul r2 (simd.f32_splat 5.0))
      let at = i * samples + k + 1
      lengths := simd.store at (simd.f32_div (simd.f32_mul sum half) (simd.f32_splat 9.0)) self
      for j in at..at + 4:
        let piece = lengths[j] - carry
        let next = total + piece
        carry := (next - total) - piece
        total := next
        lengths[j] := total
  if Bool.not (is_finite total and total > 0.0):
    return $Nothing
  @storage.truncate out_coefficients 0
  @storage.truncate out_lengths 0
  for value in coefficients:
    @storage.push out_coefficients value
  for value in lengths:
    @storage.push out_lengths value
  return $Some ($Spline {closed, segments, length: total,
    coefficients: &out_coefficients[0..out_coefficients.length], lengths: &out_lengths[0..out_lengths.length]})

// The cubics through the first `count` points of `p`, measured. A loop wraps
// around; an open curve continues past its ends to `before` and `after`. The
// coefficients are written here, in the loop that owns them, so the array is
// filled in place.
const built_into = func (closed: Bool) -> (p: Array Vec3) -> (count: U32) -> (before: Vec3) -> (after: Vec3) -> (out_coefficients: ResizeArray F32) -> (out_lengths: ResizeArray F32) : Maybe Spline => return do:
  let segments = count - 1
  if closed:
    segments := count
  let coefficients = @array.fill (segments * width) 0.0
  for i in 0..segments:
    let p0 = before
    let p3 = after
    if closed:
      p0 := p[(i + count - 1) % count]
      p3 := p[(i + 2) % count]
    else:
      if i > 0:
        p0 := p[i - 1]
      if i + 2 < count:
        p3 := p[i + 2]
    let (ax, ay, az, bx, by, bz, cx, cy, cz, dx, dy, dz) = segment p0 p[i] p[(i + 1) % count] p3
    let base = i * width
    coefficients[base] := ax
    coefficients[base + 1] := ay
    coefficients[base + 2] := az
    coefficients[base + 3] := bx
    coefficients[base + 4] := by
    coefficients[base + 5] := bz
    coefficients[base + 6] := cx
    coefficients[base + 7] := cy
    coefficients[base + 8] := cz
    coefficients[base + 9] := dx
    coefficients[base + 10] := dy
    coefficients[base + 11] := dz
  return measured_into closed segments coefficients out_coefficients out_lengths

// An open curve from the first point to the last. Each end continues its
// first chord, as if mirrored past the end. Needs two distinct points;
// Nothing for fewer or for a non-finite point.
const make_into = func (points: Array Vec3) -> (coefficients: ResizeArray F32) -> (lengths: ResizeArray F32) : Maybe Spline => return do:
  let $Some p = distinct points else:
    return $Nothing
  let n = p.length
  if n < 2:
    return $Nothing
  let before = p[0] * 2.0 - p[1]
  let after = p[n - 1] * 2.0 - p[n - 2]
  return built_into false p n before after coefficients lengths

// A closed loop through the points and back to the first. A last point on
// the first is dropped. Needs three distinct points.
const make_loop_into = func (points: Array Vec3) -> (coefficients: ResizeArray F32) -> (lengths: ResizeArray F32) : Maybe Spline => return do:
  let $Some p = distinct points else:
    return $Nothing
  let n = p.length
  if n > 1 and (p[n - 1] - p[0]).length <= apart:
    n := self - 1
  if n < 3:
    return $Nothing
  return built_into true p n p[0] p[0] coefficients lengths

const length = func (spline: Spline) => return spline.length

// How far along the curve each kept point lies, in order: from 0 to the
// length on an open curve; a loop lists each point once, its first at 0.
const marks = func (spline: Spline) => return do:
  let count = spline.segments
  if Bool.not spline.closed:
    count := self + 1
  let lengths = spline.lengths
  return @array.generate count (func (i: U32) => return lengths[i * samples])

// `distance` within the curve: held to its ends, or wrapped around a loop.
// A non-finite distance is the start.
const within = func (spline: Spline) => return func (distance: F32) => return do:
  if Bool.not (is_finite distance):
    return 0.0
  if spline.closed:
    return wrap spline.length distance
  return clamp 0.0 spline.length distance

// The table entry ending the sample that holds distance `s` (within the
// curve), by binary search: the sample's segment is (entry - 1) / samples.
const entry = func (spline: Spline) => return func (s: F32) => return do:
  let table = spline.lengths
  let low = 1
  let high = table.length - 1
  for 0..32:
    if low < high:
      let middle = low + (high - low) / 2
      let value = table[middle]
      if s < value:
        high := middle
      else:
        low := middle + 1
  return low

// The u, within the sample ending at table entry `low`, at distance `s`: two
// Newton steps on the arc length from the table's linear guess, so equal
// distances stay equal on the curve, not just on the table. One step leaves
// errors of a tenth of a percent at tight corners. The search and the steps
// return scalars, so finding a place allocates nothing.
const parameter = func (spline: Spline) => return func (s: F32) => return func (low: U32) => return do:
  let table = spline.lengths
  let start = table[low - 1]
  let finish = table[low]
  let base = (low - 1) / samples * width
  let step = 1.0 / U32.to_f32 samples
  let u0 = U32.to_f32 ((low - 1) % samples) * step
  let fraction = 0.0
  if finish > start:
    fraction := clamp 0.0 1.0 ((s - start) / (finish - start))
  let c = spline.coefficients
  let u = u0 + fraction * step
  for 0..2:
    let rate = speed c base u
    if rate > 0.0:
      u := clamp u0 (u0 + step) (u - (start + arc c base u0 u - s) / rate)
  return u

// The point `distance` metres along the curve.
const at = func (spline: Spline) => return func (distance: F32) => return do:
  let s = within spline distance
  let low = entry spline s
  return point spline.coefficients ((low - 1) / samples * width) (parameter spline s low)

// The unit direction the curve heads `distance` metres along. Where the
// curve's speed vanishes, the segment's chord.
const tangent = func (spline: Spline) => return func (distance: F32) => return do:
  let s = within spline distance
  let low = entry spline s
  let base = (low - 1) / samples * width
  let u = parameter spline s low
  let c = spline.coefficients
  // The velocity, normalized as math.normalize3 does, in scalars: scaled by
  // its largest component first, so tiny and huge speeds keep their
  // direction. Calling normalize3 allocates its argument and result.
  let k3 = 3.0 * u * u
  let k2 = 2.0 * u
  let x = c[base] * k3 + c[base + 3] * k2 + c[base + 6]
  let y = c[base + 1] * k3 + c[base + 4] * k2 + c[base + 7]
  let z = c[base + 2] * k3 + c[base + 5] * k2 + c[base + 8]
  let scale = max (max (abs x) (abs y)) (abs z)
  if Bool.not (is_finite x and is_finite y and is_finite z) or scale == 0.0:
    return (point c base 1.0 - math.vec3 c[base + 9] c[base + 10] c[base + 11]).normalized
  let sx = x / scale
  let sy = y / scale
  let sz = z / scale
  let length = sqrt (sx * sx + sy * sy + sz * sz)
  return math.vec3 (sx / length) (sy / length) (sz / length)
