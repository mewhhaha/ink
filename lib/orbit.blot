import { Vec3 } from "std/vector"
import * as app from "./app"
import * as camera from "./view"
import * as input from "./input"
import * as lanes from "./lanes"
import * as math from "./math"
import * as window from "./events"

// A god camera. It looks down at `focus` from `distance` away, turned `yaw`
// about the vertical (0 looks toward -z) and tilted `pitch` below level.
// The caller selects drag/pan/boost bindings and motion speeds.
type Orbit is data = $Orbit { focus: Vec3, yaw: F32, pitch: F32, distance: F32 }
// Where the camera starts, how near and far it zooms, how low and how steeply
// it may look down (its pitch), and how far the camera itself may go from
// the origin along the floor. The focus may look beyond that boundary.
// `overlook` also allows backing outside while the view still reaches the room.
type Bindings is data = $Bindings { ahead: U32, back: U32, left: U32, right: U32, fast: U32, button: U32 }
type Settings is data = $Settings { start: Orbit, nearest: F32, farthest: F32, lowest: F32, steepest: F32, room: F32, overlook: Bool, bindings: Bindings }

// How far a wheel unit zooms, as a share of the distance, and how fast WASD
// pan, in camera distances per second: the game says as they are used, so it
// can tune them live. `turn` is radians per pixel; `boost` scales fast panning.
type Speeds is data = $Speeds { zoom: F32, pan: F32, turn: F32, boost: F32 }

const view = func (settings: Settings) => return func (orbit: Orbit) => return do:
  let (rotation, back) = turning orbit
  let reach = back * orbit.distance
  let position = constrained settings reach (orbit.focus + reach)
  return $camera.Camera { position, rotation }

// The orbit's rotation and the way back from its focus to the camera: +Z
// turned by math.Quat.rotate's v + 2w (u x v) + u x (2 (u x v)), in scalars.
// Inline: math.rotate_parts' tuple adds an allocation per call.
const turning = func (orbit: Orbit) => return do:
  let rotation = math.Quat.from_axis_angle math.up orbit.yaw * math.Quat.from_axis_angle math.right (-orbit.pitch)
  let ux = rotation.x
  let uy = rotation.y
  let uz = rotation.z
  let w = rotation.w
  let vx = 0.0
  let vy = 0.0
  let vz = 1.0
  let tx = (uy * vz - uz * vy) * 2.0
  let ty = (uz * vx - ux * vz) * 2.0
  let tz = (ux * vy - uy * vx) * 2.0
  let back = math.vec3 (vx + tx * w + (uy * tz - uz * ty)) (vy + ty * w + (uz * tx - ux * tz)) (vz + tz * w + (ux * ty - uy * tx))
  return (rotation, back)

// A cylinder around the play space. Only the camera is constrained: looking
// toward its edge must not stop a whole viewing distance short of it.
const bounded = func (room: F32) => return func (point: Vec3) => return do:
  let scale = within room point.x point.z
  return math.vec3 (point.x * scale) point.y (point.z * scale)

// Sweep the room backwards by the viewing distance. Outside its original
// circle, the camera must still look into it. The capsule changes smoothly
// while turning and keeps an outward-facing camera at the original boundary.
const constrained = func (settings: Settings) => return func (reach: Vec3) => return func (point: Vec3) => return do:
  if Bool.not settings.overlook:
    return bounded settings.room point
  let squared = reach.x * reach.x + reach.z * reach.z
  let along = clamp 0.0 1.0 ((point.x * reach.x + point.z * reach.z) / max 0.000001 squared)
  let x = reach.x * along
  let z = reach.z * along
  let scale = within settings.room (point.x - x) (point.z - z)
  return math.vec3 (x + (point.x - x) * scale) point.y (z + (point.z - z) * scale)

// The scale that brings floor coordinates x and z within the room.
const within = func (room: F32) => return func (x: F32) => return func (z: F32) => return do:
  let distance = sqrt (x * x + z * z)
  if distance > room:
    return room / distance
  return 1.0

const panned = func (settings: Settings) => return func (orbit: Orbit) => return func (movement: Vec3) => return do:
  let (_, back) = turning orbit
  let reach = back * orbit.distance
  let held = constrained settings reach (orbit.focus + reach)
  let moved = constrained settings reach (math.vec3 (held.x + movement.x) held.y (held.z + movement.z))
  // Rebase the pivot on the capped camera. After rotating against the wall,
  // panning inward responds immediately, with no hidden distance to unwind.
  orbit.focus := math.vec3 (moved.x - reach.x) self.y (moved.z - reach.z)
  return orbit

// Keeps `orbit` and shows it at once, without interpolating from the previous
// step, so dragging and zooming respond in the frame they happen.
const show = func (settings: Settings) -> (orbit: Orbit) -> (state: Array Orbit) -> current -> previous => return do:
  state[0] := orbit
  let seen = view settings orbit
  camera.adjust (func (ignored: camera.Camera) => return seen) current previous
const enter = func settings -> (state: Array Orbit) -> current -> previous => return
  show settings state[0] state current previous

const turned = func (settings: Settings) => return func (speed: F32) => return func (orbit: Orbit) => return func (dx: F32) => return func (dy: F32) => return do:
  orbit.yaw := wrap tau (self - dx * speed)
  orbit.pitch := clamp settings.lowest settings.steepest (self + dy * speed)
  return orbit

const zoomed = func (settings: Settings) => return func (speed: F32) => return func (orbit: Orbit) => return func (delta: F32) => return do:
  orbit.distance := clamp settings.nearest settings.farthest (self * (1.0 + delta * speed))
  return orbit

const receive = func (settings: Settings) -> (speeds: Speeds) -> (controls: input.Input) -> (context: app.EventContext) -> (state: Array Orbit) -> current -> previous => return do:
  if controls.claimed:
    return ()
  let orbit = state[0]
  case context.event of
    $window.PointerMove {} => do:
      if input.button_held controls settings.bindings.button:
        show settings (turned settings speeds.turn orbit controls.dx controls.dy) state current previous
    $window.Wheel {delta} => show settings (zoomed settings speeds.zoom orbit delta) state current previous
    _ => ()
const update = func (settings: Settings) -> (speeds: Speeds) -> (controls: input.Input) -> (seconds: F32) -> (state: Array Orbit) -> current -> previous => return do:
  let ahead = input.axis controls settings.bindings.back settings.bindings.ahead
  let across = input.axis controls settings.bindings.left settings.bindings.right
  if ahead == 0.0 and across == 0.0:
    return ()
  let orbit = state[0]
  let (sine, cosine) = sin_cos orbit.yaw
  let forward = math.vec3 (-sine) 0.0 (-cosine)
  let right = math.vec3 cosine 0.0 (-sine)
  let speed = speeds.pan * orbit.distance * seconds
  if input.pressed controls settings.bindings.fast:
    speed := self * speeds.boost
  show settings (panned settings orbit ((forward * ahead + right * across) * speed)) state current previous

// Lanes: focus3, yaw, pitch, distance.
const encode = func (orbit: Orbit) => return #[orbit.focus.x, orbit.focus.y, orbit.focus.z, orbit.yaw, orbit.pitch, orbit.distance]

const decode = func (values: Array F32) => return do:
  use lanes.exact values 6
  use lanes.finite values
  use lanes.require (values[4] > 0.0 and values[4] < pi * 0.5)
  use lanes.require (values[5] > 0.0)
  return $Orbit { focus: lanes.vec3 values 0, yaw: values[3], pitch: values[4], distance: values[5] }

const codec = $lanes.Codec { key: 9, version: 1, encode, decode, migrate: lanes.no_migration }

// Applications compose receive/update directly with explicit owners and speeds.
