import { Vec3 } from "std/vector"
import * as app from "./app"
import * as camera from "./view"
import * as ecs from "./ecs"
import * as input from "./input"
import * as lanes from "./lanes"
import * as math from "./math"
import * as window from "./events"

// A god camera. It looks down at `focus` from `distance` away, turned `yaw`
// about the vertical (0 looks toward -z) and tilted `pitch` below level.
// The caller selects drag/pan/boost bindings and motion speeds.
type Orbit is data = #Orbit { focus: Vec3, yaw: F32, pitch: F32, distance: F32 }
// Where the camera starts, how near and far it zooms, how low and how steeply
// it may look down (its pitch), and how far the camera itself may go from
// the origin along the floor. The focus may look beyond that boundary.
type Bindings is data = #Bindings { ahead: U32, back: U32, left: U32, right: U32, fast: U32, button: U32 }
type Settings is data = #Settings { start: Orbit, nearest: F32, farthest: F32, lowest: F32, steepest: F32, room: F32, bindings: Bindings }

// How far a wheel unit zooms, as a share of the distance, and how fast WASD
// pan, in camera distances per second: the game says as they are used, so it
// can tune them live. `turn` is radians per pixel; `boost` scales fast panning.
type Speeds is data = #Speeds { zoom: F32, pan: F32, turn: F32, boost: F32 }

const view = fn (settings: Settings) => fn (orbit: Orbit) => do:
  let (rotation, back) = turning orbit
  let position = bounded settings.room (orbit.focus + back * orbit.distance)
  return #camera.Camera { position, rotation }

// The orbit's rotation and the way back from its focus to the camera: +Z
// turned by math.Quat.rotate's v + 2w (u x v) + u x (2 (u x v)), in scalars.
// Inline: math.rotate_parts' tuple adds an allocation per call.
const turning = fn (orbit: Orbit) => do:
  let rotation = math.Quat.from_axis_angle math.up orbit.yaw * math.Quat.from_axis_angle math.right (-orbit.pitch)
  let ux = rotation.x
  let uy = rotation.y
  let uz = rotation.z
  let w = rotation.w
  let vx = 0.0
  let vy = 0.0
  let vz = 1.0
  let tx = (uy * vz - uz * vy) * 2.0
  let ty = (uz * vx - ux * vz) * 2.0
  let tz = (ux * vy - uy * vx) * 2.0
  let back = math.vec3 (vx + tx * w + (uy * tz - uz * ty)) (vy + ty * w + (uz * tx - ux * tz)) (vz + tz * w + (ux * ty - uy * tx))
  return (rotation, back)

// A cylinder around the play space. Only the camera is constrained: looking
// toward its edge must not stop a whole viewing distance short of it.
const bounded = fn (room: F32) => fn (point: Vec3) => do:
  let scale = within room point.x point.z
  return math.vec3 (point.x * scale) point.y (point.z * scale)

// The scale that brings floor coordinates x and z within the room.
const within = fn (room: F32) => fn (x: F32) => fn (z: F32) => do:
  let distance = sqrt (x * x + z * z)
  if distance > room:
    return room / distance
  return 1.0

const panned = fn (settings: Settings) => fn (orbit: Orbit) => fn (movement: Vec3) => do:
  let (_, back) = turning orbit
  let distance = orbit.distance
  let room = settings.room
  // The camera, as `view` places it, then moved and bounded again, worked
  // on the floor coordinates alone: height does not bound it.
  let x = orbit.focus.x + back.x * distance
  let z = orbit.focus.z + back.z * distance
  let held = within room x z
  let moved_x = x * held + movement.x
  let moved_z = z * held + movement.z
  let again = within room moved_x moved_z
  // Rebase the pivot on the capped camera. After rotating against the wall,
  // panning inward responds immediately, with no hidden distance to unwind.
  orbit.focus := math.vec3 (moved_x * again - back.x * distance) self.y (moved_z * again - back.z * distance)
  return orbit

// Keeps `orbit` and shows it at once, without interpolating from the previous
// step, so dragging and zooming respond in the frame they happen.
const show = fn (orbit: Orbit) => do:
  use ecs.set orbit
  use settings <- ecs.get #Settings
  let seen = view settings orbit
  return camera.adjust (fn (ignored: camera.Camera) => seen)

// For editor.Settings.begin: play starts from the orbit as it was left.
const enter = fn (ignored: camera.Camera) => do:
  use orbit <- ecs.get #Orbit
  return show orbit

const turned = fn (settings: Settings) => fn (speed: F32) => fn (orbit: Orbit) => fn (dx: F32) => fn (dy: F32) => do:
  orbit.yaw := wrap tau (self - dx * speed)
  orbit.pitch := clamp settings.lowest settings.steepest (self + dy * speed)
  return orbit

const zoomed = fn (settings: Settings) => fn (speed: F32) => fn (orbit: Orbit) => fn (delta: F32) => do:
  orbit.distance := clamp settings.nearest settings.farthest (self * (1.0 + delta * speed))
  return orbit

const receive = fn (settings: Settings) => fn speeds => fn (context: app.EventContext) => do:
  use controls <- ecs.get #input.Input
  use orbit <- ecs.get #Orbit
  return case context.event of
    #window.PointerMove {} => do:
      if input.button_held controls settings.bindings.button:
        use current <- speeds ()
        return show (turned settings current.turn orbit controls.dx controls.dy)
    #window.Wheel { delta } => do:
      use current <- speeds ()
      return show (zoomed settings current.zoom orbit delta)
    _ => ()

// Pans the focus along the floor relative to where the camera faces.
const update = fn (settings: Settings) => fn speeds => fn (seconds: F32) => do:
  use controls <- ecs.get #input.Input
  let ahead = input.axis controls settings.bindings.back settings.bindings.ahead
  let across = input.axis controls settings.bindings.left settings.bindings.right
  if ahead == 0.0 && across == 0.0:
    return ()
  use orbit <- ecs.get #Orbit
  use current <- speeds ()
  let (sine, cosine) = sin_cos orbit.yaw
  let forward = math.vec3 (-sine) 0.0 (-cosine)
  let right = math.vec3 cosine 0.0 (-sine)
  let speed = current.pan * orbit.distance * seconds
  if input.pressed controls settings.bindings.fast:
    speed := self * current.boost
  orbit := panned settings self ((forward * ahead + right * across) * speed)
  use ecs.set orbit
  return ecs.set (view settings orbit)

// Lanes: focus3, yaw, pitch, distance.
const encode = fn (orbit: Orbit) => #[orbit.focus.x, orbit.focus.y, orbit.focus.z, orbit.yaw, orbit.pitch, orbit.distance]

const decode = fn (values: Array F32) => do:
  use lanes.exact values 6
  use lanes.finite values
  use lanes.require (values[4] > 0.0 && values[4] < pi * 0.5)
  use lanes.require (values[5] > 0.0)
  return #Orbit { focus: lanes.vec3 values 0, yaw: values[3], pitch: values[4], distance: values[5] }

const codec = #lanes.Codec { key: 9, version: 1, encode, decode, migrate: lanes.no_migration }

// Requires the input and camera plugins. `speeds ()` gives the `Speeds` to
// zoom and pan at as they are used. Pair it with app.run_if so it only steers
// while playing, and give the editor `enter` as what runs when play starts.
const plugin = fn (settings: Settings) => fn speeds => fn builder => do:
  builder := app.insert_resource codec settings.start self
  builder := app.insert_unsaved_resource settings self
  builder := app.add_system #app.Event (receive settings speeds) self
  builder := app.add_system #app.Update (update settings speeds) self
  return builder
