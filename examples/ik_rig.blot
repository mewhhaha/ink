// Asset-free interactive Procedural IK, Springs & Game Feel demo for Pen.
// Combines `ink/animation/ik` (two-bone analytic IK + 6-segment FABRIK),
// `ink/motion/springs`, `ink/feel` trauma shake, `ink/render/lines`, and `ink/ui/sketch`.
import { Vec2, Vec3 } from "std/vector"
import * as ik from "ink/animation/ik"
import * as events from "ink/events"
import * as feel from "ink/feel"
import * as math from "ink/math"
import * as motion from "ink/motion"
import * as springs from "ink/motion/springs"
import * as pen_events from "ink/pen/events"
import * as host_frame from "ink/pen/host"
import * as program from "ink/pen/program"
import * as persist from "ink/persist"
import * as preferences from "ink/preferences"
import * as render from "ink/render"
import * as d2 from "ink/render/d2"
import * as lines from "ink/render/lines"
import * as services from "ink/services"
import * as sound from "ink/sound"
import * as sketch from "ink/ui/sketch"
import * as tree from "ink/ui/tree"
import * as protocol from "pen/protocol"

type RigScalars is data = $RigScalars {
  ui: sketch.State,
  time: F32,
  goal_x: F32,
  goal_y: F32,
  spring_x: motion.Spring,
  spring_y: motion.Spring,
  hz: F32,
  damping: F32,
  soft_reach: F32,
  auto_motion: Bool,
  cone_limit: Bool,
  trauma: feel.Trauma,
}

type RigState is data = $RigState {
  scalars: #[RigScalars],
  chain: #[Vec3],
}

private func init_scalars () : RigScalars =>
  return $RigScalars {
    ui: sketch.init_state (),
    time: 0.0,
    goal_x: 560.0,
    goal_y: 260.0,
    spring_x: $motion.Spring { value: 560.0, velocity: 0.0 },
    spring_y: $motion.Spring { value: 260.0, velocity: 0.0 },
    hz: 8.5,
    damping: 0.65,
    soft_reach: 0.14,
    auto_motion: true,
    cone_limit: false,
    trauma: feel.trauma_new 1.4 18.0 (math.vec3 14.0 14.0 0.0) math.zero3 901,
  }

private func seed_chain (root: Vec3) : #[Vec3] =>
  let pts: #[Vec3] = #[]
  for i in 0 .. 7:
    @storage.push pts (math.vec3 (root.x + U32.to_f32 i * 44.0) root.y 0.0)
  return pts

private func build_frame (state: own RigState) -> (dt: F32) -> (viewport: Vec2) -> (evs: &[events.Event]) : (RigState, render.FrameAccess, #[tree.StoredNode], #[U32]) =>
  let sc = state.scalars[0]
  let logical = math.vec2 960.0 600.0
  let fit = sketch.fit_logical logical viewport
  let mapped = sketch.map_events fit evs
  let s = sketch.feed_events (&mapped[0..mapped.length]) sc.ui
  let safe_dt = clamp 0.0 0.05 dt
  sc.time := sc.time + safe_dt
  let stage_x = 278.0
  let stage_w = max 240.0 (logical.x - stage_x - 24.0)
  let stage_h = max 240.0 (logical.y - 48.0)
  let cx = stage_x + stage_w * 0.5
  let cy = 24.0 + stage_h * 0.5
  for ev in mapped:
    case ev of
      $events.PointerMove { x, y } => do:
        if x > stage_x:
          sc.goal_x := x
          sc.goal_y := y
          sc.auto_motion := false
        break ()
      $events.PointerDown { button, x, y } => do:
        if button == 0 and x > stage_x:
          sc.goal_x := x
          sc.goal_y := y
          sc.auto_motion := false
          sc.trauma := feel.add_trauma 0.65 self
        break ()
      _ => ()
  if sc.auto_motion:
    sc.goal_x := cx + cos (sc.time * 1.45) * (stage_w * 0.34)
    sc.goal_y := cy + sin (sc.time * 2.1) * (stage_h * 0.30)

  if let $Some prep = springs.prepare sc.hz sc.damping safe_dt:
    sc.spring_x := springs.step prep self sc.goal_x
    sc.spring_y := springs.step prep self sc.goal_y
  sc.trauma := feel.step_trauma safe_dt self
  let shake = feel.sample_shake sc.trauma
  let ox = shake.offset.x
  let oy = shake.offset.y
  let target = math.vec3 (sc.spring_x.value + ox) (sc.spring_y.value + oy) 0.0

  // Solve Left 2-Bone Analytic IK arm
  let arm_root = math.vec3 (stage_x + stage_w * 0.24 + ox) (cy + 36.0 + oy) 0.0
  let l1 = min 128.0 (stage_w * 0.22)
  let l2 = l1 * 0.86
  let arm_mid = arm_root + math.vec3 l1 (-20.0) 0.0
  let arm_end = arm_mid + math.vec3 l2 0.0 0.0
  let pole = math.vec3 0.0 (-1.0) 0.0
  let solved_arm = case ik.two_bone arm_root arm_mid arm_end target pole sc.soft_reach 1.0 of
    $Some ch => (ch.mid, ch.end)
    $Nothing => (arm_mid, arm_end)
  let (mid_p, end_p) = solved_arm

  // Solve Right 6-Segment FABRIK chain
  let fab_root = math.vec3 (stage_x + stage_w * 0.78 + ox) (cy + 80.0 + oy) 0.0
  let rest_chain = seed_chain fab_root
  let seg_len = min 48.0 (stage_w * 0.08)
  for i in 0 .. 7:
    rest_chain[i] := math.vec3 (fab_root.x - U32.to_f32 i * seg_len) (fab_root.y - U32.to_f32 i * 10.0) 0.0
  let limits: #[F32] = if sc.cone_limit then #[0.0, 0.55, 0.55, 0.55, 0.55, 0.55, 0.55] else #[]
  let fab_pts = case ik.fabrik rest_chain target (math.vec3 0.0 (-1.0) 0.0) limits 12 0.5 1.0 of
    $Some pts => pts
    $Nothing => rest_chain

  let frame = render.empty_frame ()
  let settings = frame.settings[0]
  settings.lighting.clear := math.vec4 0.07 0.08 0.13 1.0
  frame.settings[0] := settings

  let ui = sketch.begin s logical sc.time sketch.chalkboard_theme
  // Stage card backdrop
  let stage_card = d2.rounded_rect (math.vec4 (stage_x + ox) (24.0 + oy) stage_w stage_h) (math.vec4 12.0 12.0 12.0 12.0) (math.vec4 0.10 0.12 0.18 1.0)
  stage_card.border_color := math.vec4 0.28 0.35 0.50 0.85
  stage_card.border_width_px := 2.0
  stage_card.overlay := true
  @storage.push ui.shapes stage_card

  // Dashed reach ring around 2-bone arm
  let ring_style = $lines.LineStyle { width_px: 1.4, dash_len_px: 6.0, gap_len_px: 5.0, feather_px: 1.0, layer: $lines.OnTop }
  ui.segments := lines.push_d2_circle (math.vec2 arm_root.x arm_root.y) (l1 + l2) 48 true (math.vec4 0.96 0.78 0.30 0.35) ring_style self
  // Spring tether line from raw goal to spring-damped target
  let tether_style = $lines.LineStyle { width_px: 1.8, dash_len_px: 4.0, gap_len_px: 4.0, feather_px: 1.0, layer: $lines.OnTop }
  ui.segments := lines.push_segment_2d (math.vec2 (sc.goal_x + ox) (sc.goal_y + oy)) (math.vec2 target.x target.y) (math.vec4 0.98 0.45 0.62 0.8) tether_style self

  // Draw 2-Bone arm bones + joint circles
  let bone_style = $lines.LineStyle { width_px: 7.0, dash_len_px: 0.0, gap_len_px: 0.0, feather_px: 1.2, layer: $lines.OnTop }
  ui.segments := lines.push_segment_2d (math.vec2 arm_root.x arm_root.y) (math.vec2 mid_p.x mid_p.y) (math.vec4 0.98 0.76 0.28 1.0) bone_style self
  ui.segments := lines.push_segment_2d (math.vec2 mid_p.x mid_p.y) (math.vec2 end_p.x end_p.y) (math.vec4 0.98 0.44 0.38 1.0) bone_style self
  for jp in #[arm_root, mid_p, end_p]:
    let jdot = d2.circle (math.vec2 jp.x jp.y) 7.5 (math.vec4 1.0 0.96 0.88 1.0)
    jdot.border_color := math.vec4 0.14 0.14 0.18 1.0
    jdot.border_width_px := 2.0
    jdot.overlay := true
    @storage.push ui.shapes jdot

  // Draw 6-segment FABRIK chain
  let fab_style = $lines.LineStyle { width_px: 5.5, dash_len_px: 0.0, gap_len_px: 0.0, feather_px: 1.2, layer: $lines.OnTop }
  for i in 1 .. fab_pts.length:
    let a = fab_pts[i - 1]
    let b = fab_pts[i]
    let t = U32.to_f32 i / 6.0
    let col = math.vec4 (0.20 + 0.30 * t) (0.86 - 0.12 * t) 0.96 1.0
    ui.segments := lines.push_line_2d (math.vec2 a.x a.y) (math.vec2 b.x b.y) (i > 1) col fab_style self
  for i in 0 .. fab_pts.length:
    let jp = fab_pts[i]
    let r = if i == 0 then 8.0 else 5.5
    let jdot = d2.circle (math.vec2 jp.x jp.y) r (math.vec4 0.85 0.98 1.0 1.0)
    jdot.border_color := math.vec4 0.10 0.18 0.26 1.0
    jdot.border_width_px := 1.6
    jdot.overlay := true
    @storage.push ui.shapes jdot

  // Draw raw goal crosshair + spring-smoothed target orb
  let g_ring = d2.circle (math.vec2 (sc.goal_x + ox) (sc.goal_y + oy)) 6.0 (math.vec4 0.98 0.40 0.56 0.45)
  g_ring.overlay := true
  @storage.push ui.shapes g_ring
  let t_orb = d2.circle (math.vec2 target.x target.y) 9.5 (math.vec4 0.99 0.38 0.58 1.0)
  t_orb.border_color := math.vec4 1.0 0.96 0.96 1.0
  t_orb.border_width_px := 2.0
  t_orb.overlay := true
  @storage.push ui.shapes t_orb

  // Sketch UI panel
  ui := sketch.panel "IK + SPRINGS" (math.vec4 16.0 18.0 246.0 342.0) self
  ui := sketch.muted_label "Move cursor or click stage" self
  ui := sketch.row_begin 2 self
  let (shake_hit, ui) = sketch.button "SHAKE!" ui
  let (reset_hit, ui) = sketch.button "RESET" ui
  ui := sketch.row_end self
  let (auto_on, ui) = sketch.toggle "AUTO MOTION" sc.auto_motion ui
  let (cone_on, ui) = sketch.toggle "CONE LIMIT" sc.cone_limit ui
  let (hz_val, ui) = sketch.slider "SPRING HZ" sc.hz 2.0 18.0 ui
  let (dmp_val, ui) = sketch.slider "DAMPING" sc.damping 0.15 1.5 ui
  let (soft_val, ui) = sketch.slider "SOFT REACH" sc.soft_reach 0.0 0.40 ui
  ui := sketch.end_panel self
  ui := sketch.apply_fit fit self

  let (next_ui, frame, nodes, labels) = sketch.finish_with_tree ui frame
  sc.ui := next_ui
  sc.auto_motion := auto_on
  sc.cone_limit := cone_on
  sc.hz := hz_val
  sc.damping := dmp_val
  sc.soft_reach := soft_val
  if shake_hit:
    sc.trauma := feel.add_trauma 0.85 self
  if reset_hit:
    sc := init_scalars ()
    sc.ui := next_ui
  state.scalars[0] := sc
  return (state, frame, nodes, labels)

private const schema: U32 = 1

private func encode (frame: render.FrameAccess) -> (nodes: &[tree.StoredNode]) -> (labels: &[U32]) -> (out: own #[F32]) : #[F32] =>
  let kept = preferences.make
    ($preferences.Quality { msaa: 1, fxaa: false, scale: 1.0, filtering: 0, shadows: 0,
      occlusion: false, sky: false, fog: 0.0, effects: false, bloom: false, reflections: 0, volumetrics: 0 })
    ($preferences.Volumes { master: 0.0, effects: 0.0, music: 0.0 })
    ($preferences.Controls { left_handed: false })
  let audio = sound.empty_access ()
  let next: #[U32] = #[1]
  let requests: #[services.Request] = #[]
  let waiting: #[services.Request] = #[]
  let filling: #[services.Filling] = #[]
  let answers: #[services.Answer] = #[]
  let statuses: #[U32] = #[]
  let payload: #[F32] = #[]
  let service_state = services.access next requests waiting filling answers statuses payload
  return host_frame.append_frame schema (persist.requests ()) (sound.read audio) kept nodes
    labels (render.finish frame) (&service_state.outbox[0..0]) service_state out

private func dispatch (state: own RigState) -> (operation: U32) -> (payload: &[F32]) -> (out: own #[F32]) : (RigState, #[F32]) =>
  if operation == 1:
    state.scalars[0] := init_scalars ()
    let sc = state.scalars[0]
    return (state, program.append #[sc.hz, sc.damping] out)
  if operation == 2:
    let raw: #[protocol.Event] = #[]
    let input = protocol.decode_input_into payload raw
    let evs: #[events.Event] = #[]
    for r in input.events:
      @storage.push evs (pen_events.from_packet r)
    let (next_state, frame, nodes, labels) = build_frame state input.elapsed (math.vec2 input.width input.height) (&evs[0..evs.length])
    return (next_state, encode frame (&nodes[0..nodes.length]) (&labels[0..labels.length]) out)
  if operation == 3:
    let sc = state.scalars[0]
    return (state, program.append #[sc.hz, sc.damping] out)
  if operation == 4:
    return (state, program.append #[1.0] out)
  return (state, out)

io main (host: #[F32] -> #[F32] ! {Foreign}) : Unit ! {Foreign} =>
  let incoming: #[F32] = #[]
  let outgoing: #[F32] = #[]
  let scalars: #[RigScalars] = #[init_scalars ()]
  let state = $RigState { scalars, chain: seed_chain (math.vec3 600.0 300.0 0.0) }
  use _ <- program.run dispatch (func (own s) -> (_: Bool) => s) state schema false incoming outgoing host
  return ()

io test_ik_rig () : #[F32] =>
  let scalars: #[RigScalars] = #[init_scalars ()]
  let state = $RigState { scalars, chain: seed_chain (math.vec3 600.0 300.0 0.0) }
  let empty_evs: #[events.Event] = #[]
  let (_, frame, nodes, _) = build_frame state (1.0 / 60.0) (math.vec2 960.0 600.0) (&empty_evs[0..0])
  let ok = frame.extensions.length == 2 and nodes.length >= 6
  return if ok then #[1.0, 0.0] else #[1.0, 1.0]
