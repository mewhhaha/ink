import * as array from "std/array"
import * as ecs from "ink/ecs"
import * as query from "ink/ecs/query"
import * as commands from "ink/ecs/commands"
import * as recipe from "ink/ecs/recipe"
import * as messages from "ink/messages"
import * as relations from "ink/relations"
import * as map from "ink/map"

type Position is data = #Position U32
type Velocity is data = #Velocity U32
type Notice is data = #Moved U32
const simulation = do:
  let builder = ecs.new ()
  builder := ecs.register_tracked_component 1 64 (#Position 0) self
  builder := ecs.register_component (#Velocity 0) self
  break ecs.build builder
const present = fn key => do:
  use id <- ecs.entity ()
  if key == 1:
    use value <- ecs.component_of #Position id
    return Maybe.is_some value
  use value <- ecs.component_of #Velocity id
  return Maybe.is_some value
const defaults = fn key => do:
  if key == 1:
    return ecs.set (#Position 0)
  return ecs.set (#Velocity 1)

// All plans, retention choices, identities and defaults belong to this caller.
// A real application keeps readers, caches and streams alongside its world.
entry const example = fn () => do:
  let #recipe.Ok plan = recipe.plan #[#recipe.Requirement {key: 1, requires: #[2]}, #recipe.Requirement {key: 2, requires: #[]}] #[1] else:
    return @panic "invalid recipe"
  let (_, result) = ecs.create simulation (fn () => do:
    use first <- recipe.spawn plan (fn () => ecs.set (#Position 10)) present defaults
    use second <- recipe.spawn plan (fn () => ()) present defaults
    let owners = relations.link map.u32 map.u32 second first (relations.empty ())
    use reader <- ecs.component_cursor #Position
    use a <- query.source 1 #Position
    use b <- query.source 2 #Velocity
    use selected <- query.select (#query.All #[#query.With 1, #query.Optional 2]) #[a, b]
    let queue = commands.append #[#commands.Put {entity: first, value: #Position 20}, #commands.Put {entity: second, value: #Position 30}] (commands.empty ())
    // A whole column batch is one commit. A queue of application commands can
    // instead use commands.flush with an effect-checked interpreter.
    use commands.apply #Position queue.values
    use delta <- ecs.component_changes reader #Position
    let #ecs.Delta {changes} = delta else:
      return @panic "reader needs a rebuild"
    let stream: messages.Messages Notice = messages.empty 1 8
    let listener = messages.cursor stream
    stream := messages.write_many (array.map (fn id => #Moved id) changes.updated) stream
    let #messages.Items {values} = messages.read listener stream else:
      return @panic "listener fell behind"
    return #[selected.indices.length, changes.updated.length, values.length, (relations.sources map.u32 first owners).length])
  return result
