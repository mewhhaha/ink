import * as owned from "./physics_owners"
import * as math from "ink/math"
import * as physics from "ink/physics"
import * as scene from "ink/physics/scene"
import * as terrain from "ink/terrain"
import * as time from "ink/time"
import * as transform from "ink/transform"

func pose (s: scene.Source) => $transform.Pose3 { position: s.position, rotation: s.rotation, scale: s.scale }
func pose_at (step: physics.StepAccess) -> (index: U32) =>
  let row = step.sources[index]
  return $transform.Pose3 {position: row.position, rotation: row.rotation, scale: row.scale}

// One caller-supplied frame. Carry its remainder, sources and cache in your game.
#entry func advance (delta: F32) : #[F32] =>
  let $Some frame = time.fixed (1.0 / 60.0) 8 0.0 delta else:
    return #[]
  let heights = #[0.0,0.0,0.0,0.0]
  let ground = terrain.make math.zero3 40.0 1 (heights.view 0 heights.length) 0.0 1.0 0 0
  let body = scene.dynamic (scene.box 2 (math.vec3 0.0 10.0 0.0) math.one3)
  let sources = #[scene.ground 1 ground, body]
  return owned.with_step sources #[] (func (own step) =>
    let world = scene.build_into (scene.empty ()) sources
    let before = pose body
    for 0..frame.steps:
      before := pose_at step 1
      step := physics.simulate_into physics.default_config (1.0 / 60.0) step world
      step := physics.apply_into step
      let changed = @array.fill step.results.length 0
      for i in 0 .. changed.length:
        changed[i] := step.results[i].source
      let live = scene.source_values step.geometry (step.sources.view 0 step.sources.length)
      world := scene.update live world changed
    let current = pose_at step 1
    let display = transform.lerp3 before current frame.alpha
    return #[current.position.y,display.position.y,frame.alpha,frame.remainder,frame.dropped,U32.to_f32 frame.steps])
