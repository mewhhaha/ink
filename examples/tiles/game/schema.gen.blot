const decode_text = fn (v: Array F32) => fn (o: U32) => #Text { message: packet.u32 v o, a: v[o + 1], b: v[o + 2], size: v[o + 3], color: #Color { r: v[o + 4], g: v[o + 4 + 1], b: v[o + 4 + 2], a: v[o + 4 + 3] }, align: decode_text_align (packet.u32 v (o + 8)), outline: v[o + 9], outline_color: #Color { r: v[o + 10], g: v[o + 10 + 1], b: v[o + 10 + 2], a: v[o + 10 + 3] }, layer: v[o + 14] }
const encode_text = fn (value: Text) => #[U32.to_f32 value.message, value.a, value.b, value.size, value.color.r, value.color.g, value.color.b, value.color.a, encode_text_align value.align, value.outline, value.outline_color.r, value.outline_color.g, value.outline_color.b, value.outline_color.a, value.layer]
const decode_hero = fn (v: Array F32) => fn (o: U32) => #Hero { run_speed: v[o], ground_accel: v[o + 1], friction: v[o + 2], air_accel: v[o + 3], jump_speed: v[o + 4], jump_cut: v[o + 5], rise_gravity: v[o + 6], fall_gravity: v[o + 7], max_fall: v[o + 8], coyote: v[o + 9], buffer: v[o + 10], climb_speed: v[o + 11], size: #Vec2 { x: v[o + 12], y: v[o + 12 + 1] }, velocity: #Vec2 { x: v[o + 14], y: v[o + 14 + 1] }, grounded: packet.bool v (o + 16), climbing: packet.bool v (o + 17), facing: v[o + 18], coyote_left: v[o + 19], buffer_left: v[o + 20], drop_left: v[o + 21], spawn: #Vec2 { x: v[o + 22], y: v[o + 22 + 1] } }
const encode_hero = fn (value: Hero) => #[value.run_speed, value.ground_accel, value.friction, value.air_accel, value.jump_speed, value.jump_cut, value.rise_gravity, value.fall_gravity, value.max_fall, value.coyote, value.buffer, value.climb_speed, value.size.x, value.size.y, value.velocity.x, value.velocity.y, packet.flag value.grounded, packet.flag value.climbing, value.facing, value.coyote_left, value.buffer_left, value.drop_left, value.spawn.x, value.spawn.y]
const decode_coin = fn (v: Array F32) => fn (o: U32) => #Coin { radius: v[o] }
const encode_coin = fn (value: Coin) => #[value.radius]
const decode_slime = fn (v: Array F32) => fn (o: U32) => #Slime { speed: v[o], direction: v[o + 1], size: #Vec2 { x: v[o + 2], y: v[o + 2 + 1] } }
const encode_slime = fn (value: Slime) => #[value.speed, value.direction, value.size.x, value.size.y]
const decode_goal = fn (v: Array F32) => fn (o: U32) => #Goal { radius: v[o] }
const encode_goal = fn (value: Goal) => #[value.radius]
const decode_follow = fn (v: Array F32) => fn (o: U32) => #Follow { target: packet.u32 v o, smoothing: v[o + 1], lookahead: v[o + 2], min: #Vec2 { x: v[o + 3], y: v[o + 3 + 1] }, max: #Vec2 { x: v[o + 5], y: v[o + 5 + 1] } }
const encode_follow = fn (value: Follow) => #[U32.to_f32 value.target, value.smoothing, value.lookahead, value.min.x, value.min.y, value.max.x, value.max.y]
const decode_terrain = fn (v: Array F32) => fn (o: U32) => #Terrain { kill_below: v[o] }
const encode_terrain = fn (value: Terrain) => #[value.kill_below]
const decode_flicker = fn (v: Array F32) => fn (o: U32) => #Flicker { base: v[o], amount: v[o + 1], speed: v[o + 2] }
const encode_flicker = fn (value: Flicker) => #[value.base, value.amount, value.speed]
const decode_hud = fn (v: Array F32) => fn (o: U32) => #Hud { slot: decode_hud_slot (packet.u32 v o) }
const encode_hud = fn (value: Hud) => #[encode_hud_slot value.slot]
const decode_game = fn (v: Array F32) => fn (o: U32) => #Game { coins: packet.u32 v o, total: packet.u32 v (o + 1), deaths: packet.u32 v (o + 2), time: v[o + 3], finished: packet.bool v (o + 4) }
const encode_game = fn (value: Game) => #[U32.to_f32 value.coins, U32.to_f32 value.total, U32.to_f32 value.deaths, value.time, packet.flag value.finished]

const decode_entity = fn (v: Array F32) => fn (o: U32) => do:
  let at = o + 3
  let c_transform = if v[at] == 0.0 then #Nothing else #Some (decode_transform v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 11)
  let c_camera = if v[at] == 0.0 then #Nothing else #Some (decode_camera v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 7)
  let c_environment = if v[at] == 0.0 then #Nothing else #Some (decode_environment v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 43)
  let c_sprite = if v[at] == 0.0 then #Nothing else #Some (decode_sprite v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 20)
  let c_tilemap = if v[at] == 0.0 then #Nothing else #Some (decode_tilemap v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 1 + size_tilemap v (at + 1))
  let c_light2d = if v[at] == 0.0 then #Nothing else #Some (decode_light2d v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 12)
  let c_text = if v[at] == 0.0 then #Nothing else #Some (decode_text v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 16)
  let c_hero = if v[at] == 0.0 then #Nothing else #Some (decode_hero v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 25)
  let c_coin = if v[at] == 0.0 then #Nothing else #Some (decode_coin v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 2)
  let c_slime = if v[at] == 0.0 then #Nothing else #Some (decode_slime v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 5)
  let c_goal = if v[at] == 0.0 then #Nothing else #Some (decode_goal v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 2)
  let c_follow = if v[at] == 0.0 then #Nothing else #Some (decode_follow v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 8)
  let c_terrain = if v[at] == 0.0 then #Nothing else #Some (decode_terrain v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 2)
  let c_flicker = if v[at] == 0.0 then #Nothing else #Some (decode_flicker v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 4)
  let c_hud = if v[at] == 0.0 then #Nothing else #Some (decode_hud v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 2)
  return #Entity { id: packet.u32 v o, parent: packet.u32 v (o + 1), name_id: packet.u32 v (o + 2), transform: c_transform, camera: c_camera, environment: c_environment, sprite: c_sprite, tilemap: c_tilemap, light2d: c_light2d, text: c_text, hero: c_hero, coin: c_coin, slime: c_slime, goal: c_goal, follow: c_follow, terrain: c_terrain, flicker: c_flicker, hud: c_hud }
const encode_entity = fn (e: Entity) => do:
  let id: F32 = U32.to_f32 e.id
  let parent: F32 = U32.to_f32 e.parent
  let name_id: F32 = U32.to_f32 e.name_id
  return array.flatten #[
    #[id, parent, name_id],
    packet.optional encode_transform e.transform,
    packet.optional encode_camera e.camera,
    packet.optional encode_environment e.environment,
    packet.optional encode_sprite e.sprite,
    packet.optional encode_tilemap e.tilemap,
    packet.optional encode_light2d e.light2d,
    packet.optional encode_text e.text,
    packet.optional encode_hero e.hero,
    packet.optional encode_coin e.coin,
    packet.optional encode_slime e.slime,
    packet.optional encode_goal e.goal,
    packet.optional encode_follow e.follow,
    packet.optional encode_terrain e.terrain,
    packet.optional encode_flicker e.flicker,
    packet.optional encode_hud e.hud,
  ]
const decode_resources = fn (v: Array F32) => fn (o: U32) => do:
  let at = o
  let r_game = decode_game v at
  at := self + 5
  return #Resources { game: r_game }
const encode_resources = fn (value: Resources) => array.flatten #[encode_game value.game]

const decode_world = fn (v: Array F32) => fn (base: U32) => do:
  if packet.u32 v base != layout_hash:
    return @panic "state packet was written by a different schema"
  let count = packet.u32 v (base + 5)
  let high = packet.u32 v (base + 3)
  let low = packet.u32 v (base + 4)
  return #World {
    tick: packet.u32 v (base + 1),
    next_entity: packet.u32 v (base + 2),
    seed: (high << 16) | low,
    entities: @array.generate count (fn index => decode_entity v (base + packet.u32 v (base + 7 + index))),
    resources: decode_resources v (base + packet.u32 v (base + 6)),
  }



// The step result, written in place: the state's lane count, the state packet
// (see codec.ts) and then the events.
const encode_result = fn (w: World) => fn (tail: Array F32) => do:
  let entities = w.entities
  let count = entities.length
  let starts = @array.fill count 0
  let at = 7 + count
  for index in 0..count:
    let e = entities[index]
    starts[index] := at
    at := self + 3
    at := self + (case e.transform of
      #Some _ => 1 + 10
      #Nothing => 1)
    at := self + (case e.camera of
      #Some _ => 1 + 6
      #Nothing => 1)
    at := self + (case e.environment of
      #Some _ => 1 + 42
      #Nothing => 1)
    at := self + (case e.sprite of
      #Some _ => 1 + 19
      #Nothing => 1)
    at := self + (case e.tilemap of
      #Some value => 1 + 12 + (1 + value.cells.length * 1)
      #Nothing => 1)
    at := self + (case e.light2d of
      #Some _ => 1 + 11
      #Nothing => 1)
    at := self + (case e.text of
      #Some _ => 1 + 15
      #Nothing => 1)
    at := self + (case e.hero of
      #Some _ => 1 + 24
      #Nothing => 1)
    at := self + (case e.coin of
      #Some _ => 1 + 1
      #Nothing => 1)
    at := self + (case e.slime of
      #Some _ => 1 + 4
      #Nothing => 1)
    at := self + (case e.goal of
      #Some _ => 1 + 1
      #Nothing => 1)
    at := self + (case e.follow of
      #Some _ => 1 + 7
      #Nothing => 1)
    at := self + (case e.terrain of
      #Some _ => 1 + 1
      #Nothing => 1)
    at := self + (case e.flicker of
      #Some _ => 1 + 3
      #Nothing => 1)
    at := self + (case e.hud of
      #Some _ => 1 + 1
      #Nothing => 1)
  let resources_at = at
  at := self + 5
  let out = @array.fill (1 + at + tail.length) 0.0
  out[0] := U32.to_f32 at
  out[1] := U32.to_f32 layout_hash
  out[2] := U32.to_f32 w.tick
  out[3] := U32.to_f32 w.next_entity
  out[4] := U32.to_f32 (w.seed >> 16)
  out[5] := U32.to_f32 (w.seed & 65535)
  out[6] := U32.to_f32 count
  out[7] := U32.to_f32 resources_at
  for index in 0..count:
    let e = entities[index]
    let start = starts[index]
    out[8 + index] := U32.to_f32 start
    let q = 1 + start
    out[q] := U32.to_f32 e.id
    out[q + 1] := U32.to_f32 e.parent
    out[q + 2] := U32.to_f32 e.name_id
    q := self + 3
    if let #Some c_transform = e.transform:
      out[q] := 1.0
      out[q + 1] := c_transform.position.x
      out[q + 2] := c_transform.position.y
      out[q + 3] := c_transform.position.z
      out[q + 4] := c_transform.rotation.x
      out[q + 5] := c_transform.rotation.y
      out[q + 6] := c_transform.rotation.z
      out[q + 7] := c_transform.rotation.w
      out[q + 8] := c_transform.scale.x
      out[q + 9] := c_transform.scale.y
      out[q + 10] := c_transform.scale.z
      q := self + 11
    else:
      q := self + 1
    if let #Some c_camera = e.camera:
      out[q] := 1.0
      out[q + 1] := c_camera.fov
      out[q + 2] := c_camera.near
      out[q + 3] := c_camera.far
      out[q + 4] := packet.flag c_camera.orthographic
      out[q + 5] := c_camera.size
      out[q + 6] := packet.flag c_camera.active
      q := self + 7
    else:
      q := self + 1
    if let #Some c_environment = e.environment:
      out[q] := 1.0
      out[q + 1] := packet.flag c_environment.active
      out[q + 2] := encode_sky_kind c_environment.sky
      out[q + 3] := c_environment.sky_color.r
      out[q + 4] := c_environment.sky_color.g
      out[q + 5] := c_environment.sky_color.b
      out[q + 6] := c_environment.sky_color.a
      out[q + 7] := c_environment.horizon_color.r
      out[q + 8] := c_environment.horizon_color.g
      out[q + 9] := c_environment.horizon_color.b
      out[q + 10] := c_environment.horizon_color.a
      out[q + 11] := c_environment.ground_color.r
      out[q + 12] := c_environment.ground_color.g
      out[q + 13] := c_environment.ground_color.b
      out[q + 14] := c_environment.ground_color.a
      out[q + 15] := c_environment.sky_intensity
      out[q + 16] := c_environment.sky_altitude
      out[q + 17] := c_environment.cloud_coverage
      out[q + 18] := c_environment.cloud_height
      out[q + 19] := c_environment.cloud_scale
      out[q + 20] := c_environment.cloud_offset
      out[q + 21] := c_environment.ambient
      out[q + 22] := c_environment.ambient_occlusion
      out[q + 23] := c_environment.reflections
      out[q + 24] := c_environment.indirect
      out[q + 25] := c_environment.ao_radius
      out[q + 26] := c_environment.shadow_distance
      out[q + 27] := c_environment.exposure
      out[q + 28] := packet.flag c_environment.auto_exposure
      out[q + 29] := encode_tonemap c_environment.tonemap
      out[q + 30] := c_environment.bloom
      out[q + 31] := c_environment.contrast
      out[q + 32] := c_environment.saturation
      out[q + 33] := c_environment.temperature
      out[q + 34] := c_environment.vignette
      out[q + 35] := c_environment.grain
      out[q + 36] := c_environment.fog_density
      out[q + 37] := c_environment.fog_color.r
      out[q + 38] := c_environment.fog_color.g
      out[q + 39] := c_environment.fog_color.b
      out[q + 40] := c_environment.fog_color.a
      out[q + 41] := c_environment.fog_height
      out[q + 42] := c_environment.fog_falloff
      q := self + 43
    else:
      q := self + 1
    if let #Some c_sprite = e.sprite:
      out[q] := 1.0
      out[q + 1] := U32.to_f32 c_sprite.atlas
      out[q + 2] := U32.to_f32 c_sprite.frame
      out[q + 3] := U32.to_f32 c_sprite.anim
      out[q + 4] := c_sprite.anim_time
      out[q + 5] := U32.to_f32 c_sprite.texture
      out[q + 6] := c_sprite.color.r
      out[q + 7] := c_sprite.color.g
      out[q + 8] := c_sprite.color.b
      out[q + 9] := c_sprite.color.a
      out[q + 10] := packet.flag c_sprite.flip_x
      out[q + 11] := packet.flag c_sprite.flip_y
      out[q + 12] := c_sprite.pivot.x
      out[q + 13] := c_sprite.pivot.y
      out[q + 14] := c_sprite.pixels_per_unit
      out[q + 15] := c_sprite.layer
      out[q + 16] := packet.flag c_sprite.y_sort
      out[q + 17] := packet.flag c_sprite.lit
      out[q + 18] := packet.flag c_sprite.smooth
      out[q + 19] := packet.flag c_sprite.snap
      q := self + 20
    else:
      q := self + 1
    if let #Some c_tilemap = e.tilemap:
      out[q] := 1.0
      out[q + 1] := U32.to_f32 c_tilemap.tileset
      out[q + 2] := U32.to_f32 c_tilemap.width
      out[q + 3] := U32.to_f32 c_tilemap.height
      out[q + 4] := c_tilemap.cell.x
      out[q + 5] := c_tilemap.cell.y
      out[q + 6] := c_tilemap.color.r
      out[q + 7] := c_tilemap.color.g
      out[q + 8] := c_tilemap.color.b
      out[q + 9] := c_tilemap.color.a
      out[q + 10] := c_tilemap.layer
      out[q + 11] := packet.flag c_tilemap.lit
      out[q + 12] := packet.flag c_tilemap.occluder
      q := self + 13
      out[q] := U32.to_f32 c_tilemap.cells.length
      for i_0 in 0..c_tilemap.cells.length:
        let item_0 = c_tilemap.cells[i_0]
        out[q + 1 + i_0 * 1] := U32.to_f32 item_0
      q := self + (1 + c_tilemap.cells.length * 1)
    else:
      q := self + 1
    if let #Some c_light2d = e.light2d:
      out[q] := 1.0
      out[q + 1] := encode_light2d_kind c_light2d.kind
      out[q + 2] := c_light2d.color.r
      out[q + 3] := c_light2d.color.g
      out[q + 4] := c_light2d.color.b
      out[q + 5] := c_light2d.color.a
      out[q + 6] := c_light2d.intensity
      out[q + 7] := c_light2d.radius
      out[q + 8] := c_light2d.falloff
      out[q + 9] := c_light2d.height
      out[q + 10] := c_light2d.angle
      out[q + 11] := packet.flag c_light2d.shadows
      q := self + 12
    else:
      q := self + 1
    if let #Some c_text = e.text:
      out[q] := 1.0
      out[q + 1] := U32.to_f32 c_text.message
      out[q + 2] := c_text.a
      out[q + 3] := c_text.b
      out[q + 4] := c_text.size
      out[q + 5] := c_text.color.r
      out[q + 6] := c_text.color.g
      out[q + 7] := c_text.color.b
      out[q + 8] := c_text.color.a
      out[q + 9] := encode_text_align c_text.align
      out[q + 10] := c_text.outline
      out[q + 11] := c_text.outline_color.r
      out[q + 12] := c_text.outline_color.g
      out[q + 13] := c_text.outline_color.b
      out[q + 14] := c_text.outline_color.a
      out[q + 15] := c_text.layer
      q := self + 16
    else:
      q := self + 1
    if let #Some c_hero = e.hero:
      out[q] := 1.0
      out[q + 1] := c_hero.run_speed
      out[q + 2] := c_hero.ground_accel
      out[q + 3] := c_hero.friction
      out[q + 4] := c_hero.air_accel
      out[q + 5] := c_hero.jump_speed
      out[q + 6] := c_hero.jump_cut
      out[q + 7] := c_hero.rise_gravity
      out[q + 8] := c_hero.fall_gravity
      out[q + 9] := c_hero.max_fall
      out[q + 10] := c_hero.coyote
      out[q + 11] := c_hero.buffer
      out[q + 12] := c_hero.climb_speed
      out[q + 13] := c_hero.size.x
      out[q + 14] := c_hero.size.y
      out[q + 15] := c_hero.velocity.x
      out[q + 16] := c_hero.velocity.y
      out[q + 17] := packet.flag c_hero.grounded
      out[q + 18] := packet.flag c_hero.climbing
      out[q + 19] := c_hero.facing
      out[q + 20] := c_hero.coyote_left
      out[q + 21] := c_hero.buffer_left
      out[q + 22] := c_hero.drop_left
      out[q + 23] := c_hero.spawn.x
      out[q + 24] := c_hero.spawn.y
      q := self + 25
    else:
      q := self + 1
    if let #Some c_coin = e.coin:
      out[q] := 1.0
      out[q + 1] := c_coin.radius
      q := self + 2
    else:
      q := self + 1
    if let #Some c_slime = e.slime:
      out[q] := 1.0
      out[q + 1] := c_slime.speed
      out[q + 2] := c_slime.direction
      out[q + 3] := c_slime.size.x
      out[q + 4] := c_slime.size.y
      q := self + 5
    else:
      q := self + 1
    if let #Some c_goal = e.goal:
      out[q] := 1.0
      out[q + 1] := c_goal.radius
      q := self + 2
    else:
      q := self + 1
    if let #Some c_follow = e.follow:
      out[q] := 1.0
      out[q + 1] := U32.to_f32 c_follow.target
      out[q + 2] := c_follow.smoothing
      out[q + 3] := c_follow.lookahead
      out[q + 4] := c_follow.min.x
      out[q + 5] := c_follow.min.y
      out[q + 6] := c_follow.max.x
      out[q + 7] := c_follow.max.y
      q := self + 8
    else:
      q := self + 1
    if let #Some c_terrain = e.terrain:
      out[q] := 1.0
      out[q + 1] := c_terrain.kill_below
      q := self + 2
    else:
      q := self + 1
    if let #Some c_flicker = e.flicker:
      out[q] := 1.0
      out[q + 1] := c_flicker.base
      out[q + 2] := c_flicker.amount
      out[q + 3] := c_flicker.speed
      q := self + 4
    else:
      q := self + 1
    if let #Some c_hud = e.hud:
      out[q] := 1.0
      out[q + 1] := encode_hud_slot c_hud.slot
      q := self + 2
    else:
      q := self + 1
  let q = 1 + resources_at
  out[q] := U32.to_f32 w.resources.game.coins
  out[q + 1] := U32.to_f32 w.resources.game.total
  out[q + 2] := U32.to_f32 w.resources.game.deaths
  out[q + 3] := w.resources.game.time
  out[q + 4] := packet.flag w.resources.game.finished
  q := self + 5
  for index in 0..tail.length:
    out[1 + at + index] := tail[index]
  return out

const decode_actions = fn (v: Array F32) => fn (o: U32) => #Actions { move: v[o], climb: v[o + 1], jump: packet.button v (o + 2) }
const decode_player_input = fn (v: Array F32) => fn (o: U32) => #PlayerInput {
  id: packet.u32 v o,
  viewport: packet.vec2 v (o + 1),
  pointer: packet.pointer v (o + 3),
  actions: decode_actions v (o + 20),
}

const decode_input = fn (v: Array F32) => fn (o: U32) => #Input {
  tick: packet.u32 v o,
  dt: v[o + 1],
  time: v[o + 2],
  viewport: packet.vec2 v (o + 3),
  pointer: packet.pointer v (o + 5),
  actions: decode_actions v (o + 22),
  players: @array.generate (packet.u32 v (o + 27)) (fn index => decode_player_input v (o + 28 + index * 25)),
}

// Offline games use the ordinary controls. Network games select their owner.
const player_input = fn (input: Input) => fn (id: U32) => do:
  for player in input.players:
    if player.id == id:
      return player
  if input.players.length == 0:
    return #PlayerInput { id: id, viewport: input.viewport, pointer: input.pointer, actions: input.actions }
  return decode_player_input (@array.fill 25 0.0) 0

const encode_event = fn (event: Event) => case event of
  #Particles { emitter: e_emitter, position: e_position, count: e_count, seed: e_seed } => #[0.0, U32.to_f32 e_emitter, e_position.x, e_position.y, e_position.z, U32.to_f32 e_count, U32.to_f32 e_seed]
  #Log { message: e_message, a: e_a, b: e_b } => #[1.0, U32.to_f32 e_message, e_a, e_b]
  #Line { start: e_start, end: e_end, color: e_color } => #[2.0, e_start.x, e_start.y, e_start.z, e_end.x, e_end.y, e_end.z, e_color.r, e_color.g, e_color.b, e_color.a]
  #Sound { clip: e_clip, volume: e_volume, pitch: e_pitch, position: e_position, spatial: e_spatial } => #[3.0, U32.to_f32 e_clip, e_volume, e_pitch, e_position.x, e_position.y, e_position.z, packet.flag e_spatial]
const encode_events = fn (events: List Event) => do:
  let rows = array.map encode_event (Array.from_list events)
  let count: F32 = U32.to_f32 rows.length
  return array.flatten #[#[count], ...rows]

// Effects a step may use. `emit` sends an event to the host; `random`
// draws from the world's seed.
type Emit is effect = Event -> Unit
type Random is effect = { get: Unit -> U32, set: U32 -> Unit }

const emit = fn (event: Event) => Emit event

// A number in [0, 1).
const random = fn () => do:
  use state <- Random.get ()
  let next = rng.next state
  use Random.set next
  return rng.unit next

// A number in [low, high).
const random_range = fn (low: F32) => fn (high: F32) => do:
  use t <- random ()
  return low + (high - low) * t

const collect = fn computation => do:
  let events: List Event = []
  for request in @requests computation:
    case request of
      effect Emit event =>
        events := [...self, event]
        yield ()
      complete value =>
        return (value, events)

// Run one step: `update input world` returns the next world and may use
// emit and random. Games export it as an entry:
//   entry const step = fn (lanes: Array F32) -> Array F32 => s.run update lanes
const run = fn update => fn (lanes: Array F32) -> Array F32 => do:
  let input_lanes = packet.u32 lanes 0
  let input = decode_input lanes 1
  let world = decode_world lanes (1 + input_lanes)
  let (seed, (next, events)) = do (@effect.state Random.get Random.set world.seed):
    return collect (@computation (fn () => update input world))
  let finished: World = next
  finished.seed := seed
  return encode_result finished (encode_events events)

// World helpers. Entities keep their order; ids are never reused.

// Add `entity` with a fresh id; returns the id and the world.
const spawn = fn (entity: Entity) => fn (world: World) => do:
  let id = world.next_entity
  entity.id := id
  world.next_entity := self + 1
  world.entities := array.push entity self
  return (id, world)

const find = fn (id: U32) => fn (world: World) => do:
  for entity in world.entities:
    if entity.id == id:
      return #Some entity
  return #Nothing

// Replace the entity with the same id.
const replace = fn (entity: Entity) => fn (world: World) => do:
  world.entities := array.map (fn (other: Entity) => if other.id == entity.id then entity else other) self
  return world

// Apply `change` to every entity, in order. `change` may use effects.
const each = fn change => fn (world: World) => do:
  let entities = world.entities
  for index in 0..entities.length:
    use next <- change entities[index]
    entities[index] := next
  world.entities := entities
  return world

// Remove an entity and everything parented under it.
const despawn = fn (id: U32) => fn (world: World) => do:
  let entities = world.entities
  let count = entities.length
  let slots = @array.fill world.next_entity 0
  for index in 0..count:
    let entity = entities[index]
    if entity.id < slots.length:
      slots[entity.id] := index + 1
  let dead = @array.fill count #False
  for 0..count:
    let changed = #False
    for index in 0..count:
      let entity = entities[index]
      let parent_dead = if entity.parent != 0 && entity.parent < slots.length && slots[entity.parent] != 0 then dead[slots[entity.parent] - 1] else #False
      if Bool.not dead[index] && (entity.id == id || parent_dead):
        dead[index] := #True
        changed := #True
    if Bool.not changed:
      break
  let kept: List Entity = []
  for index in 0..count:
    if Bool.not dead[index]:
      kept := [...self, entities[index]]
  world.entities := Array.from_list kept
  return world

const children = fn (id: U32) => fn (world: World) =>
  array.filter (fn (entity: Entity) => entity.parent == id) world.entities


