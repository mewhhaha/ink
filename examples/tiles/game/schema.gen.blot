const decode_light2d = fn (v: Array F32) => fn (o: U32) => #Light2d { kind: decode_light2d_kind (packet.u32 v o), color: #Color { r: v[o + 1], g: v[o + 1 + 1], b: v[o + 1 + 2], a: v[o + 1 + 3] }, intensity: v[o + 5], radius: v[o + 6], falloff: v[o + 7], height: v[o + 8], angle: v[o + 9], shadows: packet.bool v (o + 10) }
