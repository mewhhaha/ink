import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as math from "ink/math"
import * as s from "./schema.gen"

// A small third-person collector: run and jump across platforms, pick up
// every coin. The camera follows the player; moving platforms carry it.

const zero = #Vec3 { x: 0.0, y: 0.0, z: 0.0 }

const position_of = fn (entity: s.Entity) => case entity.transform of
  #Some t => t.position
  #Nothing => zero

// Where a mover is at `time`, and how fast it moves there.
const mover_at = fn (mover: s.Mover) => fn (time: F32) => do:
  let phase = time * tau / mover.period
  let (sine, cosine) = sin_cos phase
  let along = 0.5 - 0.5 * cosine
  let speed = 0.5 * sine * tau / mover.period
  return (mover.origin + mover.offset * along, mover.offset * speed)

// Ground-plane forward of the first follow camera, so W moves away from it.
const view_forward = fn (world: s.World) => do:
  for e in world.entities:
    if let #Some _ = e.follow:
      if let #Some t = e.transform:
        let f = math.flat t.rotation.forward
        if f.length_squared > 0.0001:
          return f.normalized
  return math.forward

const move_player = fn (input: s.Input) => fn (world: s.World) => fn (entity: s.Entity) => do:
  let #Some player = entity.player else:
    return entity
  let #Some transform = entity.transform else:
    return entity
  let #Some character = entity.character else:
    return entity
  let dt = input.dt
  let forward = view_forward world
  let right = forward.cross math.up
  let stick = input.actions.move
  let wish = (right * stick.x + forward * stick.y) * player.speed
  // The character controller moves the capsule in the physics step; here the
  // game only says how it wants to move.
  let velocity = #Vec3 { x: wish.x, y: character.velocity.y - player.gravity * dt, z: wish.z }
  if character.grounded && input.actions.jump.pressed:
    velocity.y := player.jump
  character.velocity := velocity
  // Fell off the world: back to the start.
  if transform.position.y < (-15.0):
    transform.position := #Vec3 { x: 0.0, y: 3.0, z: 0.0 }
    character.velocity := zero
  if wish.length_squared > 0.01:
    transform.rotation := math.Quat.nlerp self (math.facing wish) (min 1.0 (12.0 * dt))
  entity.transform := #Some transform
  entity.character := #Some character
  return entity

const spin = fn (input: s.Input) => fn (entity: s.Entity) => do:
  let #Some spinner = entity.spinner else:
    return entity
  let #Some transform = entity.transform else:
    return entity
  transform.rotation := self * math.axis_angle math.up (spinner.speed * input.dt)
  transform.position.y := spinner.base + spinner.bob * sin (input.time * 2.5)
  entity.transform := #Some transform
  return entity

const slide = fn (input: s.Input) => fn (entity: s.Entity) => do:
  let #Some mover = entity.mover else:
    return entity
  let #Some transform = entity.transform else:
    return entity
  let (position, velocity) = mover_at mover input.time
  transform.position := position
  entity.transform := #Some transform
  // Kinematic: the game moves it and says how fast, so characters standing on
  // it are carried and bodies it touches are pushed.
  if let #Some body = entity.body:
    body.linear_velocity := velocity
    entity.body := #Some body
  return entity

const follow = fn (input: s.Input) => fn (world: s.World) => fn (entity: s.Entity) => do:
  let #Some follow = entity.follow else:
    return entity
  let #Some transform = entity.transform else:
    return entity
  let #Some target = s.find follow.target world else:
    return entity
  let focus = position_of target + #Vec3 { x: 0.0, y: 1.0, z: 0.0 }
  let wanted = focus + #Vec3 { x: 0.0, y: follow.height, z: follow.distance }
  let t = min 1.0 (follow.stiffness * input.dt)
  transform.position := self.lerp wanted t
  transform.rotation := math.look_rotation (focus - transform.position) math.up
  entity.transform := #Some transform
  return entity

// The sun turns about a world axis; the procedural sky follows its light.
const turn_sun = fn (input: s.Input) => fn (entity: s.Entity) => do:
  let #Some day = entity.daylight else:
    return entity
  let #Some transform = entity.transform else:
    return entity
  let angle = day.speed * input.dt * pi / 180.0
  transform.rotation := math.Quat.normalized (math.axis_angle day.axis angle * self)
  entity.transform := #Some transform
  return entity

// Coins touched by the player this step.
const collect = fn (world: s.World) => do:
  let player_at = do:
    for e in world.entities:
      if let #Some _ = e.player:
        return #Some (position_of e)
    return #Nothing
  let #Some p = player_at else:
    return world
  let taken: List U32 = []
  let score = world.resources.score
  for e in world.entities:
    if let #Some coin = e.coin:
      let c = position_of e
      let d = c - (p + #Vec3 { x: 0.0, y: 0.5, z: 0.0 })
      if d.length < coin.radius + 0.4:
        taken := [...self, e.id]
        score.value := self + coin.value
  for id in taken:
    world := s.despawn id self
    let got: F32 = from score.value
    let total: F32 = from score.total
    use s.emit (#s.Log { message: s.message_coin, a: got, b: total })
    if score.value >= score.total:
      use s.emit (#s.Log { message: s.message_won, a: total, b: 0.0 })
  world.resources.score := score
  return world

// With the debug.paths resource on, draw a line to the nearest coin.
const show_path = fn (world: s.World) => do:
  if Bool.not world.resources.debug.paths:
    return ()
  let player = #Nothing
  for e in world.entities:
    if let #Some _ = e.player:
      player := #Some (position_of e + #Vec3 { x: 0.0, y: 1.0, z: 0.0 })
  let #Some from_point = player else:
    return ()
  let nearest = #Nothing
  let best = 1000000.0
  for e in world.entities:
    if let #Some _ = e.coin:
      let d = (position_of e - from_point).length
      if d < best:
        best := d
        nearest := #Some (position_of e)
  let #Some to_point = nearest else:
    return ()
  use s.emit (#s.Line { start: from_point, end: to_point, color: math.rgb 1.0 0.85 0.2 })

// Burst-only emitters in the effects scene respond to the same recorded input
// as gameplay. The host retains these events for rewind and hand-offs.
const burst_effects = fn (input: s.Input) => fn (world: s.World) => do:
  if input.actions.jump.pressed:
    for e in world.entities:
      if let #Some emitter = e.emitter:
        if emitter.active && emitter.rate == 0.0:
          use s.emit (#s.Particles { emitter: e.id, position: position_of e, count: 96, seed: input.tick })

// F or the left mouse button: a ball leaves the player along its facing.
const fire = fn (input: s.Input) => fn (world: s.World) => do:
  if Bool.not input.actions.fire.pressed:
    return world
  let count = 0
  let shooter = #Nothing
  for e in world.entities:
    if let #Some _ = e.projectile:
      count := self + 1
    if let #Some _ = e.player:
      shooter := #Some e
  let #Some who = shooter else:
    return world
  if count >= 24:
    return world
  let at = position_of who + #Vec3 { x: 0.0, y: 1.0, z: 0.0 }
  let aim = case who.transform of
    #Some t => math.Quat.rotate t.rotation math.forward
    #Nothing => math.forward
  let ball = s.blank
  let transform = s.default_transform
  transform.position := at + aim * 0.9
  transform.scale := #Vec3 { x: 0.5, y: 0.5, z: 0.5 }
  ball.transform := #Some transform
  let mesh = s.default_mesh
  mesh.shape := s.mesh_sphere
  mesh.color := math.rgb 0.95 0.45 0.2
  ball.mesh := #Some mesh
  let collider = s.default_collider
  collider.shape := #s.Sphere
  collider.restitution := 0.35
  ball.collider := #Some collider
  let body = s.default_body
  body.linear_velocity := aim * 14.0 + #Vec3 { x: 0.0, y: 2.0, z: 0.0 }
  body.mass := 2.0
  ball.body := #Some body
  ball.projectile := #Some s.default_projectile
  let (_, spawned) = s.spawn ball world
  return spawned

// Fired balls vanish after a few seconds.
const expire = fn (input: s.Input) => fn (world: s.World) => do:
  let gone: List U32 = []
  world.entities := array.map (fn (e: s.Entity) => do:
    let #Some projectile = e.projectile else:
      return e
    projectile.life := self - input.dt
    e.projectile := #Some projectile
    return e) self
  for e in world.entities:
    if let #Some projectile = e.projectile:
      if projectile.life <= 0.0:
        gone := [...self, e.id]
  for id in gone:
    world := s.despawn id self
  return world

const update = fn (input: s.Input) => fn (world: s.World) => do:
  use burst_effects input world
  world.entities := array.map (turn_sun input) self
  world.entities := array.map (slide input) self
  world.entities := array.map (spin input) self
  world.entities := array.map (move_player input world) self
  world := s.physics_step input.dt self
  world := fire input self
  world := expire input self
  use collected <- collect world
  collected.entities := array.map (follow input collected) self
  use show_path collected
  return collected

// Play starts: remember where bobbing coins rest and count the coins.
const begin = fn (input: s.Input) => fn (world: s.World) => do:
  let total = 0
  let entities = world.entities
  for index in 0..entities.length:
    let e = entities[index]
    if let #Some coin = e.coin:
      total := self + coin.value
    if let #Some spinner = e.spinner:
      spinner.base := (position_of e).y
      e.spinner := #Some spinner
    if let #Some mover = e.mover:
      mover.origin := position_of e
      mover.started := #True
      e.mover := #Some mover
    entities[index] := e
  world.entities := entities
  world.resources.score.total := world.resources.score.value + total
  return world

entry const step = fn (lanes: Array F32) -> Array F32 => s.run update lanes
entry const start = fn (lanes: Array F32) -> Array F32 => s.run begin lanes
