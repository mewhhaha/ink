const decode_light = fn (v: Array F32) => fn (o: U32) => #Light { kind: decode_light_kind (packet.u32 v o), color: #Color { r: v[o + 1], g: v[o + 1 + 1], b: v[o + 1 + 2], a: v[o + 1 + 3] }, intensity: v[o + 5], range: v[o + 6], angle: v[o + 7], shadows: packet.bool v (o + 8), softness: v[o + 9] }
const encode_light = fn (value: Light) => #[encode_light_kind value.kind, value.color.r, value.color.g, value.color.b, value.color.a, value.intensity, value.range, value.angle, packet.flag value.shadows, value.softness]
const decode_environment = fn (v: Array F32) => fn (o: U32) => #Environment { active: packet.bool v o, sky: decode_sky_kind (packet.u32 v (o + 1)), sky_color: #Color { r: v[o + 2], g: v[o + 2 + 1], b: v[o + 2 + 2], a: v[o + 2 + 3] }, horizon_color: #Color { r: v[o + 6], g: v[o + 6 + 1], b: v[o + 6 + 2], a: v[o + 6 + 3] }, ground_color: #Color { r: v[o + 10], g: v[o + 10 + 1], b: v[o + 10 + 2], a: v[o + 10 + 3] }, sky_intensity: v[o + 14], sky_altitude: v[o + 15], cloud_coverage: v[o + 16], cloud_height: v[o + 17], cloud_scale: v[o + 18], cloud_offset: v[o + 19], ambient: v[o + 20], ambient_occlusion: v[o + 21], reflections: v[o + 22], indirect: v[o + 23], ao_radius: v[o + 24], shadow_distance: v[o + 25], exposure: v[o + 26], auto_exposure: packet.bool v (o + 27), tonemap: decode_tonemap (packet.u32 v (o + 28)), bloom: v[o + 29], contrast: v[o + 30], saturation: v[o + 31], temperature: v[o + 32], vignette: v[o + 33], grain: v[o + 34], fog_density: v[o + 35], fog_color: #Color { r: v[o + 36], g: v[o + 36 + 1], b: v[o + 36 + 2], a: v[o + 36 + 3] }, fog_height: v[o + 40], fog_falloff: v[o + 41] }
const encode_environment = fn (value: Environment) => #[packet.flag value.active, encode_sky_kind value.sky, value.sky_color.r, value.sky_color.g, value.sky_color.b, value.sky_color.a, value.horizon_color.r, value.horizon_color.g, value.horizon_color.b, value.horizon_color.a, value.ground_color.r, value.ground_color.g, value.ground_color.b, value.ground_color.a, value.sky_intensity, value.sky_altitude, value.cloud_coverage, value.cloud_height, value.cloud_scale, value.cloud_offset, value.ambient, value.ambient_occlusion, value.reflections, value.indirect, value.ao_radius, value.shadow_distance, value.exposure, packet.flag value.auto_exposure, encode_tonemap value.tonemap, value.bloom, value.contrast, value.saturation, value.temperature, value.vignette, value.grain, value.fog_density, value.fog_color.r, value.fog_color.g, value.fog_color.b, value.fog_color.a, value.fog_height, value.fog_falloff]
const decode_brush = fn (v: Array F32) => fn (o: U32) => do:
  let at = o
  let f_bake_lighting = packet.bool v at
  at := self + 1
  let f_visible = packet.bool v at
