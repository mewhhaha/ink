import * as camera from "ink/camera"
import * as particles from "ink/particles"
import * as motion from "ink/motion"
import * as animation from "ink/animation"
import * as placement from "ink/placement"
import * as debug from "ink/debug"
import * as math from "ink/math"
import * as transform from "ink/transform"

// State and clocks belong to the application; no rendering runtime is needed.
entry func sample (seconds: F32) : #[F32] =>
  let eye = $camera.Camera { position: math.vec3 0.0 2.0 5.0, rotation: math.identity_quat, projection: $camera.Perspective { fov_y: 1.2, aspect: 1.7777778, near: 0.1, far: 1000.0, reversed: true } }
  let emitter = $particles.Emitter { position: math.zero3, velocity: math.up * 4.0, spread: math.one3, lifetime: 2.0, lifetime_spread: 0.2, size: 0.1 }
  let emitted = particles.emit 123 20 emitter
  let alive = particles.update emitted.particles (math.up * (-9.8)) seconds
  let spring = motion.spring ($motion.Spring { value: 0.0,velocity: 0.0 }) 1.0 8.0 1.0 seconds
  let points = placement.chunk 42 1.0 1.5 (-4.0) (-4.0) 8 8
  let ray = case camera.pick_ray eye 0.0 0.0 of
    $Nothing => $math.Ray { origin: math.zero3,direction: math.forward }
    $Some value => value
  let lines = debug.ray ray 10.0 (math.rgb 1.0 1.0 0.0)
  let pose = $transform.Pose3 { position: math.zero3,rotation: math.identity_quat,scale: math.one3 }
  let keys = #[$animation.Key {time: 0.0,pose},$animation.Key {time: 1.0,pose: $transform.Pose3 {position: math.right,rotation: math.identity_quat,scale: math.one3}}]
  let tracks = #[$animation.Track {start: 0,count: keys.length}]
  let events: #[animation.Event] = #[]
  let clip = $animation.Clip {duration: 1.0,keys: keys.view 0 keys.length,tracks: tracks.view 0 tracks.length,events: events.view 0 0}
  let bones = animation.sample clip seconds true
  return #[spring.value,U32.to_f32 alive.length,U32.to_f32 points.length,U32.to_f32 lines.length,bones[0].position.x]
