import * as map from "ink/map"
import * as set from "ink/set"

// Rows and hash buckets have separate owners. An independent retained value
// needs an explicit copy; text keys borrow the older, named codepoint pools.
entry func example () => return do:
  let wood = "wood"
  let stone = "stone"
  let iron = "iron"
  let wood_key = wood.view 0 wood.length
  let stone_key = stone.view 0 stone.length
  let iron_key = iron.view 0 iron.length
  let original: map.Map [&[U32], U32] = map.empty ()
  let original_slots = map.buckets ()
  map.from map.text #[(wood_key, 12), (stone_key, 7)] original original_slots
  let changed: map.Map [&[U32], U32] = map.empty ()
  let changed_slots = map.buckets ()
  map.copy_into map.text identity identity changed changed_slots original
  map.alter map.text wood_key (func before => return
    $Some (Maybe.unwrap_or 0 before + 3)) changed changed_slots
  let requested: set.Set (&[U32]) = set.empty ()
  let requested_slots = set.buckets ()
  set.from set.text #[wood_key, iron_key, wood_key] requested requested_slots
  let available: set.Set (&[U32]) = set.empty ()
  let available_slots = set.buckets ()
  set.from set.text (map.keys changed) available available_slots
  set.difference set.text requested requested_slots available
  return #[Maybe.unwrap_or 0 (map.get map.text wood_key original original_slots),
    Maybe.unwrap_or 0 (map.get map.text wood_key changed changed_slots), set.count requested_slots]
