import * as map from "ink/map"
import * as set from "ink/set"

// Values own their storage. Keep snapshots by retaining earlier values; the
// key policy is supplied separately and stays consistent across operations.
entry const example = fn () => do:
  let original = map.from map.text #[("wood", 12), ("stone", 7)]
  let changed = map.alter map.text "wood" (fn before =>
    #Some (Maybe.unwrap_or 0 before + 3)) original
  let requested = set.from set.text #["wood", "iron", "wood"]
  let available = set.from set.text (map.keys changed)
  let missing = set.difference set.text requested available
  return #[Maybe.unwrap_or 0 (map.get map.text "wood" original),
    Maybe.unwrap_or 0 (map.get map.text "wood" changed), set.count missing]
