import * as map from "ink/map"
import * as set from "ink/set"

// A Map owns its rows and hash buckets together. An independent retained value
// needs an explicit copy; text keys borrow the older, named codepoint pools.
#entry func example () =>
  let wood = "wood"
  let stone = "stone"
  let iron = "iron"
  let wood_key = wood.view 0 wood.length
  let stone_key = stone.view 0 stone.length
  let iron_key = iron.view 0 iron.length
  let original: map.Map [&[U32], U32] = map.from map.text #[(wood_key, 12), (stone_key, 7)] (map.empty ())
  let changed: map.Map [&[U32], U32] = map.copy_into map.text identity identity (map.empty ()) original
  changed := map.alter map.text wood_key (func before => return
    $Some (Maybe.unwrap_or 0 before + 3)) changed
  let requested: set.Set (&[U32]) = set.from set.text #[wood_key, iron_key, wood_key] (set.empty ())
  let available: set.Set (&[U32]) = set.from set.text (map.keys changed) (set.empty ())
  requested := set.difference set.text requested available
  return #[Maybe.unwrap_or 0 (map.get map.text wood_key original),
    Maybe.unwrap_or 0 (map.get map.text wood_key changed), set.count requested]
