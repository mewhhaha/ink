import * as joints from "ink/joints"
import * as physics from "ink/physics"
import * as scene from "ink/scene"
import * as math from "ink/math"

// Carry sources and contact cache between frames in your application. A
// collider-free static source is sufficient for the fixed world anchor.
entry const pendulum = func (ticks: U32) : Array F32 => return do:
  let sources = #[scene.source 1 (math.vec3 0.0 2.0 0.0), scene.dynamic (scene.sphere 2 (math.vec3 1.0 2.0 0.0) 0.3)]
  let constraints = #[joints.distance 0 1 math.zero3 math.zero3 1.0]
  let cache = physics.empty_cache
  // Bounded example batch; guest allocation arenas reset between frame calls.
  for 0..(min ticks 16):
    let (next, saved) = physics.step_joints constraints physics.default_config (1.0 / 60.0) sources cache
    sources := next
    cache := saved
  let delta = sources[1].position - sources[0].position
  return #[sources[1].position.x, sources[1].position.y, delta.length]
