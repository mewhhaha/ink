import * as owned from "./physics_owners"
import * as joints from "ink/physics/joints"
import * as physics from "ink/physics"
import * as scene from "ink/physics/scene"
import * as math from "ink/math"

// Carry sources and contact cache between frames in your application. A
// collider-free static source is sufficient for the fixed world anchor.
entry func pendulum (ticks: U32) : #[F32] =>
  let sources = #[scene.source 1 (math.vec3 0.0 2.0 0.0), scene.dynamic (scene.sphere 2 (math.vec3 1.0 2.0 0.0) 0.3)]
  let constraints = #[joints.distance 0 1 math.zero3 math.zero3 1.0]
  return owned.with_step sources #[] (func (own step) =>
    // The same named source, geometry and contact owners survive every tick.
    for 0..(min ticks 16):
      step := physics.step_joints_into constraints physics.default_config (1.0 / 60.0) step
    let anchor = physics.source step 0
    let body = physics.source step 1
    let delta = body.position - anchor.position
    return #[body.position.x,body.position.y,delta.length])
