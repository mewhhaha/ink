import * as array from "std/array"
import * as ecs from "ink/ecs"

type Position is data = $Position F32
type Speed is data = $Speed F32

// Every live column and its revision metadata have separate named owners.
// Retaining previous positions requires an explicit checkpoint destination.
entry func move (seconds: F32) : #[F32] =>
  let alive: ecs.Entities = ecs.entities ()
  let entity_meta = ecs.metadata 1
  let positions: ecs.Pool Position = ecs.pool ()
  let position_meta = ecs.metadata 1
  let speeds: ecs.Pool Speed = ecs.pool ()
  let speed_meta = ecs.metadata 1
  let previous: ecs.Pool Position = ecs.pool ()
  let (ids, alive, entity_meta) = ecs.spawn_many alive entity_meta 3
  let (positions, position_meta) = ecs.insert_many alive positions position_meta ids #[$Position 1.0, $Position 2.0, $Position 3.0]
  let (speeds, speed_meta) = ecs.insert_many alive speeds speed_meta ids #[$Speed 2.0, $Speed 4.0, $Speed 6.0]
  previous := ecs.checkpoint identity self positions
  for id in ids:
    let $Some ($Position x) = ecs.read positions id else:
      return panic "position missing"
    let $Some ($Speed v) = ecs.read speeds id else:
      return panic "speed missing"
    positions := ecs.write_row self id ($Position (x + v * seconds))
    position_meta := ecs.bump_payload self
  return array.map (func id =>
    let $Some ($Position x) = ecs.read positions id else:
      return panic "position missing"
    return x) ids
