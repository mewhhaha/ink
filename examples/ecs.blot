import * as array from "std/array"
import * as ecs from "ink/ecs"

type Position is data = #Position F32
type Speed is data = #Speed F32

const simulation = do:
  let builder = ecs.new ()
  builder := ecs.register_snapshotted_component (#Position 0.0) self
  builder := ecs.register_component (#Speed 0.0) self
  break ecs.build builder

// Callers keep the returned world; snapshots remain independent.
entry const move = fn (seconds: F32) -> Array F32 => do:
  let (_, positions) = ecs.create simulation (fn () => do:
    use first <- ecs.spawn_many 3
    use ecs.insert_many #Position first #[#Position 1.0, #Position 2.0, #Position 3.0]
    use ecs.insert_many #Speed first #[#Speed 2.0, #Speed 4.0, #Speed 6.0]
    use ecs.checkpoint simulation
    use ecs.update_pair #Position #Speed (fn position => fn speed => do:
      let #Position x = position
      let #Speed v = speed
      return (#Position (x + v * seconds), speed))
    return ecs.present #Position)
  return array.map (fn position => do:
    let #Position x = position
    return x) positions
