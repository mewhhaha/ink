import * as director from "ink/director"
import * as math from "ink/math"
import * as motion from "ink/motion"
import * as rig from "ink/rig"
import * as spline from "ink/spline"
import * as timeline from "ink/timeline"
import * as tween from "ink/tween"

// A short cutscene: the camera dollies round a statue while zooming in, then
// hands off to a follow camera on a walker, and a thud shakes it. The timeline
// owns when things happen; the director blends the two shots.
type Beat is data = $Handoff | $Impact

func handoff (beat: Beat) => case beat of
  $Handoff => true
  $Impact => false

const statue = math.vec3 0.0 1.5 0.0
const walk = math.vec3 1.5 0.0 0.0
const settings = $rig.Follow { offset: math.vec3 0.0 2.5 6.0, turns: false, dead_zone: 0.5, lookahead: 0.4, frequency: 4.0, damping: 1.0, turn_rate: 8.0 }

// The pose after `seconds` at 60 frames a second: position, focal length, the
// cues fired and whether a blend is still under way.
entry func cinematic (seconds: F32) : #[F32] =>
  let spline_coefficients_1: #[F32] = #[]
  let spline_lengths_1: #[F32] = #[]
  let $Some path = spline.make_into #[math.vec3 (-8.0) 3.0 8.0, math.vec3 0.0 4.0 10.0, math.vec3 8.0 3.0 6.0, math.vec3 9.0 2.0 (-2.0)] spline_coefficients_1 spline_lengths_1 else:
    return #[]
  let $Some dolly = timeline.track #[
    $timeline.Key { time: 0.0, value: 0.0, ease: $tween.Linear },
    $timeline.Key { time: 4.0, value: spline.length path, ease: $tween.Smoother },
  ] else:
    return #[]
  let $Some zoom = timeline.track #[
    $timeline.Key { time: 0.0, value: 1.5, ease: $tween.Linear },
    $timeline.Key { time: 4.0, value: 2.4, ease: $tween.Smooth },
  ] else:
    return #[]
  let $Some beats = timeline.cues #[{ time: 4.0, value: $Handoff }, { time: 5.0, value: $Impact }] else:
    return #[]
  let $Some playback = timeline.play 6.0 $timeline.Once else:
    return #[]
  let start = math.vec3 (-3.0) 0.0 0.0
  let follower = rig.follower settings start walk 0.0
  let editing = director.start 0
  let shake = motion.empty_impulse
  let shown = $director.Pose { camera: rig.dolly path 0.0 ($rig.At statue), focal_length: 1.5 }
  let fired = 0
  let dt = 1.0 / 60.0
  let frames = F32.to_u32 (clamp 0.0 3600.0 (seconds * 60.0))
  for frame in 0 .. frames:
    let walker = start + walk * (U32.to_f32 (frame + 1) * dt)
    let $Some advanced = timeline.advance playback dt else:
      return #[]
    playback := advanced.playback
    let now = timeline.position playback
    let (next, following) = rig.follow settings follower walker walk 0.0 dt
    follower := next
    let dollying = rig.dolly path (timeline.sample dolly now) ($rig.At statue)
    let focal = timeline.sample zoom now
    let shots = func (id: U32) => if id == 0 then $director.Pose { camera: dollying, focal_length: focal } else $director.Pose { camera: following, focal_length: 1.8 }
    for beat in timeline.fired beats advanced.passes:
      fired := self + 1
      if handoff beat:
        let $Some blended = director.blend editing 1 1.5 $tween.CubicInOut shots else:
          return #[]
        editing := blended
      else:
        shake := motion.kick shake (math.vec3 0.0 0.3 0.0) (math.vec3 0.04 0.0 0.0)
    let $Some moved = director.advance editing dt else:
      return #[]
    editing := moved
    shake := motion.settle shake 18.0 0.4 dt
    shown := director.shaken (director.pose editing shots) shake
  let p = shown.camera.position
  let blending = if director.blending editing then 1.0 else 0.0
  return #[p.x, p.y, p.z, shown.focal_length, U32.to_f32 fired, blending]
