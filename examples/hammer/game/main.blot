import * as array from "std/array"
import * as list from "std/list"
import { Vec3 } from "std/vector"
import { Vec4 } from "ink/math"
import * as math from "ink/math"
import * as collide from "ink/collide"
import * as s from "./schema.gen"

// A Hammer-style puzzle: walk first person through brush rooms, press buttons
// with E and trip trigger zones. Everything that happens is entity I/O: an
// entity's `outputs` say "when <event> happens here, send <input> to <target>
// after <delay> seconds". Fired outputs go onto a queue (resource `wiring`);
// each step delivers the ones whose delay ran out.


// Position in the schema's enum order (see ioEvents / ioInputs in schema.ts).
const in_open: F32 = 0.0
const in_close: F32 = 1.0
const in_toggle: F32 = 2.0
const in_turn_on: F32 = 3.0
const in_turn_off: F32 = 4.0
const in_trigger: F32 = 5.0
const in_increment: F32 = 6.0
const in_reset: F32 = 7.0
const in_enable: F32 = 8.0
const in_disable: F32 = 9.0
const in_end_level: F32 = 10.0

const degrees: F32 = tau / 360.0
const body_radius: F32 = 0.4
const feet_drop = #Vec3 { x: 0.0, y: 1.2, z: 0.0 }
const head_rise = #Vec3 { x: 0.0, y: 0.9, z: 0.0 }
const mid_drop = #Vec3 { x: 0.0, y: 0.8, z: 0.0 }

const position_of = fn (entity: s.Entity) => case entity.transform of
  #Some t => t.position
  #Nothing => math.zero3

// ---- wiring ------------------------------------------------------------------

// Put every matching, unspent output of `id` on the queue and report it.
const fire = fn (id: U32) => fn (event: s.IoEvent) => fn (world: s.World) => do:
  let entities = world.entities
  let queue = world.resources.wiring.queue
  let code = s.encode_io_event event
  for index in 0..entities.length:
    let e = entities[index]
    if e.id == id:
      if let #Some outputs = e.outputs:
        let connections = outputs.connections
        for c in 0..connections.length:
          let connection = connections[c]
          if s.encode_io_event connection.event == code && Bool.not (connection.once && connection.fired) && queue.length < 48:
            queue := array.push (#s.Pending { time: connection.delay, source: id, index: c }) self
            connection.fired := #True
            connections[c] := connection
            use s.emit (#s.Io { source: id, event: code, target: connection.target, input: s.encode_io_input connection.input, delay: connection.delay })
            if let #Some target = s.find connection.target world:
              use s.emit (#s.Line { start: position_of e, end: position_of target, color: #math.Color { r: 1.0, g: 0.85, b: 0.2, a: 1.0 } })
        outputs.connections := connections
        e.outputs := #Some outputs
        entities[index] := e
  world.entities := entities
  world.resources.wiring.queue := queue
  return world

const flush = fn (fired: List (U32, s.IoEvent)) => fn (world: s.World) => do:
  for (id, event) in fired:
    use next <- fire id event world
    world := next
  return world

// Tell `target` to do `input`. Returns the world and what that made happen.
const deliver = fn (input: s.IoInput) => fn (target: U32) => fn (world: s.World) => do:
  let code = s.encode_io_input input
  let entities = world.entities
  let fired: List (U32, s.IoEvent) = []
  let finished = world.resources.game.finished
  for index in 0..entities.length:
    let e = entities[index]
    if e.id == target:
      if let #Some door = e.door:
        if code == in_open:
          door.goal := 1.0
        if code == in_close:
          door.goal := 0.0
        if code == in_toggle:
          door.goal := 1.0 - self
        e.door := #Some door
      if let #Some lamp = e.lamp:
        if code == in_turn_on:
          lamp.on := #True
        if code == in_turn_off:
          lamp.on := #False
        if code == in_toggle:
          lamp.on := Bool.not self
        e.lamp := #Some lamp
      if let #Some relay = e.relay:
        if code == in_enable:
          relay.enabled := #True
        if code == in_disable:
          relay.enabled := #False
        if code == in_trigger && relay.enabled:
          fired := [...self, (e.id, #s.OnTrigger)]
        e.relay := #Some relay
      if let #Some counter = e.counter:
        if code == in_reset:
          counter.count := 0
        if code == in_increment:
          counter.count := self + 1
          if counter.count == counter.max:
            fired := [...self, (e.id, #s.OnHitMax)]
        e.counter := #Some counter
      if let #Some zone = e.trigger_zone:
        if code == in_enable:
          zone.enabled := #True
        if code == in_disable:
          zone.enabled := #False
        e.trigger_zone := #Some zone
      if let #Some push = e.push_button:
        if code == in_enable:
          push.locked := #False
        if code == in_disable:
          push.locked := #True
        e.push_button := #Some push
      if code == in_end_level:
        finished := #True
      entities[index] := e
  world.entities := entities
  if finished && Bool.not world.resources.game.finished:
    use s.emit (#s.Log { message: s.message_level_finished, a: 0.0, b: 0.0 })
  world.resources.game.finished := finished
  return (world, fired)

// Count down the queue and deliver everything that came due.
const run_queue = fn (dt: F32) => fn (world: s.World) => do:
  let due: List (U32, U32) = []
  let keep: List s.Pending = []
  for pending in world.resources.wiring.queue:
    let left = pending.time - dt
    if left <= 0.0:
      due := [...self, (pending.source, pending.index)]
    else:
      keep := [...self, #s.Pending { time: left, source: pending.source, index: pending.index }]
  world.resources.wiring.queue := Array.from_list keep
  for (source, index) in due:
    let found = s.find source world
    if let #Some e = found:
      if let #Some outputs = e.outputs:
        if index < outputs.connections.length:
          let connection = outputs.connections[index]
          use result <- deliver connection.input connection.target world
          let (delivered, fired) = result
          use next <- flush fired delivered
          world := next
  return world

// ---- level geometry --------------------------------------------------------------

const brush_planes = fn (e: s.Entity) => case e.brush of
  #Some brush => collide.planes_at (position_of e) (array.map (fn (face: s.Face) => face.plane) brush.faces)
  #Nothing => #[]

const solids_of = fn (world: s.World) => array.filter (fn (planes: Array Vec4) => Bool.not planes.is_empty) (array.map (fn (e: s.Entity) => case e.trigger_zone of
  #Some _ => #[]
  #Nothing => brush_planes e
) world.entities)

// Invert the hierarchy one transform at a time, preserving parent scale and
// shear. Bound the walk so malformed cyclic parents cannot trap the game.
const trigger_local = fn (world: s.World) => fn (entity: s.Entity) => fn (point: Vec3) => do:
  let chain: List s.Transform = []
  let current = entity
  for 0..world.entities.length:
    if let #Some t = current.transform:
      chain := [t, ...self]
    if current.parent == 0:
      break
    let #Some parent = s.find current.parent world else:
      break
    current := parent
  let p = point
  for t in chain:
    if abs t.scale.x < 0.000001 || abs t.scale.y < 0.000001 || abs t.scale.z < 0.000001:
      return #Nothing
    let q = math.Quat.rotate (math.Quat.conjugate t.rotation) (p - t.position)
    p := #Vec3 { x: q.x / t.scale.x, y: q.y / t.scale.y, z: q.z / t.scale.z }
  return #Some p

const inside_trigger = fn (world: s.World) => fn (entity: s.Entity) => fn (point: Vec3) => do:
  let #Some brush = entity.brush else:
    return #False
  if brush.faces.is_empty:
    return #False
  let #Some p = trigger_local world entity point else:
    return #False
  for face in brush.faces:
    let n = face.plane
    if n.x * p.x + n.y * p.y + n.z * p.z > n.w + 0.00001:
      return #False
  return #True

// Is level geometry between `origin` and the point `distance` along `direction`?
const blocked = fn (solids: Array (Array Vec4)) => fn (origin: Vec3) => fn (direction: Vec3) => fn (distance: F32) => do:
  for planes in solids:
    if let #Some t = collide.ray_brush planes origin direction distance:
      return #True
  return #False

// ---- the player ----------------------------------------------------------------------

const move_player = fn (input: s.Input) => fn (world: s.World) => do:
  let solids = solids_of world
  let entities = world.entities
  let dt = input.dt
  let focus = 0
  for index in 0..entities.length:
    let e = entities[index]
    if let #Some player = e.player:
      if let #Some transform = e.transform:
        let turn = input.actions.turn
        let mouse = if input.pointer.locked then input.pointer.delta else math.zero2
        let yaw = player.yaw - (mouse.x * 0.12 + turn.x * 110.0 * dt)
        let pitch = max (-88.0) (min 88.0 (player.pitch + turn.y * 80.0 * dt - mouse.y * 0.12))
        let (sn, cs) = sin_cos (yaw * degrees)
        let ahead = #Vec3 { x: 0.0 - sn, y: 0.0, z: 0.0 - cs }
        let side = #Vec3 { x: cs, y: 0.0, z: 0.0 - sn }
        let stick = input.actions.move
        let wish = side * stick.x + ahead * stick.y
        let strength = wish.length
        if strength > 1.0:
          wish := wish * (1.0 / strength)
        let velocity = #Vec3 { x: wish.x * player.speed, y: player.velocity.y - player.gravity * dt, z: wish.z * player.speed }
        if player.grounded && input.actions.jump.pressed:
          velocity.y := player.jump
        // Two spheres, feet and head, slide along the brushes.
        let feet = transform.position - feet_drop
        let (f1, v1, grounded) = collide.slide solids (feet + velocity * dt) body_radius velocity
        let (h1, v2, _) = collide.slide solids (f1 + head_rise) body_radius v1
        let (f2, v3, standing) = collide.slide solids (h1 - head_rise) body_radius v2
        let eye = f2 + feet_drop
        transform.position := eye
        transform.rotation := math.yaw_pitch (yaw * degrees) (pitch * degrees)
        player.yaw := yaw
        player.pitch := pitch
        player.velocity := v3
        player.grounded := grounded || standing
        // The button under the crosshair, if nothing solid is in front of it.
        let look = math.Quat.forward transform.rotation
        let nearest = player.reach
        for other in entities:
          if let #Some push = other.push_button:
            let to_button = position_of other - eye
            let along = to_button.dot look
            if along > 0.0 && along < nearest && Bool.not push.locked && push.wait <= 0.0 && along < push.reach:
              let off = (to_button - look * along).length
              if off < push.radius && Bool.not (blocked solids eye look (along - 0.15)):
                nearest := along
                focus := other.id
        e.transform := #Some transform
        e.player := #Some player
        if let #Some camera = e.camera:
          e.camera := #Some camera
        entities[index] := e
  world.entities := entities
  world.resources.game.focus := focus
  return (world, input.actions.press.pressed && focus != 0)

// Count button cooldowns, press the focused button, show its state.
const buttons = fn (input: s.Input) => fn (pressed: Bool) => fn (world: s.World) => do:
  let focus = world.resources.game.focus
  let fired: List (U32, s.IoEvent) = []
  let entities = world.entities
  let presses = world.resources.game.presses
  for index in 0..entities.length:
    let e = entities[index]
    if let #Some push = e.push_button:
      push.wait := max 0.0 (push.wait - input.dt)
      if pressed && e.id == focus:
        push.wait := push.cooldown
        presses := self + 1
        fired := [...self, (e.id, #s.OnPressed)]
      if let #Some mesh = e.mesh:
        if push.locked:
          mesh.emissive := #math.Color { r: 0.2, g: 0.2, b: 0.2, a: 1.0 }
        else:
          if push.wait > 0.0:
            mesh.emissive := #math.Color { r: 0.1, g: 0.9, b: 0.3, a: 1.0 }
          else:
            mesh.emissive := #math.Color { r: 0.9, g: 0.15, b: 0.1, a: 1.0 }
        e.mesh := #Some mesh
      e.push_button := #Some push
      entities[index] := e
  world.entities := entities
  world.resources.game.presses := presses
  return (world, fired)

// Trigger zones: OnStartTouch / OnEndTouch as the player's body enters and leaves.
const zones = fn (world: s.World) => do:
  let fired: List (U32, s.IoEvent) = []
  let body = do:
    for e in world.entities:
      if let #Some _ = e.player:
        return #Some (position_of e - mid_drop)
    return #Nothing
  let #Some p = body else:
    return (world, fired)
  let entities = world.entities
  for index in 0..entities.length:
    let e = entities[index]
    if let #Some zone = e.trigger_zone:
      let inside = zone.enabled && inside_trigger world e p
      if inside && Bool.not zone.inside:
        fired := [...self, (e.id, #s.OnStartTouch)]
      if Bool.not inside && zone.inside:
        fired := [...self, (e.id, #s.OnEndTouch)]
      zone.inside := inside
      e.trigger_zone := #Some zone
      entities[index] := e
  world.entities := entities
  return (world, fired)

// ---- doors and lamps -----------------------------------------------------------------

const doors = fn (input: s.Input) => fn (world: s.World) => do:
  let fired: List (U32, s.IoEvent) = []
  let entities = world.entities
  for index in 0..entities.length:
    let e = entities[index]
    if let #Some door = e.door:
      if let #Some transform = e.transform:
        let travel = max 0.001 door.offset.length
        let step = door.speed * input.dt / travel
        let before = door.progress
        door.progress := math.approach door.goal step before
        if before < 1.0 && door.progress >= 1.0:
          fired := [...self, (e.id, #s.OnOpened)]
        if before > 0.0 && door.progress <= 0.0:
          fired := [...self, (e.id, #s.OnClosed)]
        transform.position := door.origin + door.offset * door.progress
        e.transform := #Some transform
        e.door := #Some door
        entities[index] := e
  world.entities := entities
  return (world, fired)

const lamps = fn (entity: s.Entity) => do:
  let #Some lamp = entity.lamp else:
    return entity
  if let #Some light = entity.light:
    light.intensity := if lamp.on then lamp.brightness else 0.0
    entity.light := #Some light
  if let #Some mesh = entity.mesh:
    mesh.emissive := if lamp.on then #math.Color { r: 1.0, g: 0.9, b: 0.65, a: 1.0 } else #math.Color { r: 0.05, g: 0.05, b: 0.05, a: 1.0 }
    entity.mesh := #Some mesh
  return entity

// ---- step ---------------------------------------------------------------------------

const update = fn (input: s.Input) => fn (world: s.World) => do:
  use queued <- run_queue input.dt world
  let (moving, door_events) = doors input queued
  let (walked, pressed) = move_player input moving
  let (pushed, button_events) = buttons input pressed walked
  let (stepped, zone_events) = zones pushed
  stepped.entities := array.map lamps self
  use with_doors <- flush door_events stepped
  use with_buttons <- flush button_events with_doors
  use done <- flush zone_events with_buttons
  return done

// Play starts: remember where doors rest, face the player, hide editor markers.
const begin = fn (input: s.Input) => fn (world: s.World) => do:
  let entities = world.entities
  for index in 0..entities.length:
    let e = entities[index]
    if let #Some door = e.door:
      door.origin := position_of e
      door.progress := 0.0
      door.goal := 0.0
      e.door := #Some door
    if let #Some player = e.player:
      player.pitch := 0.0
      player.velocity := math.zero3
      if let #Some transform = e.transform:
        transform.rotation := math.yaw_pitch (player.yaw * degrees) 0.0
        e.transform := #Some transform
      e.player := #Some player
    if let #Some _ = e.marker:
      e.mesh := #Nothing
    if let #Some outputs = e.outputs:
      outputs.connections := array.map (fn (c: s.Connection) => #s.Connection { event: c.event, target: c.target, input: c.input, delay: c.delay, once: c.once, fired: #False }) self
      e.outputs := #Some outputs
    if let #Some counter = e.counter:
      counter.count := 0
      e.counter := #Some counter
    entities[index] := e
  world.entities := entities
  world.resources.wiring.queue := #[]
  world.resources.game.finished := #False
  world.resources.game.focus := 0
  world.resources.game.presses := 0
  return world

entry const step = fn (lanes: Array F32) -> Array F32 => s.run update lanes
entry const start = fn (lanes: Array F32) -> Array F32 => s.run begin lanes
