const decode_mesh = fn (v: Array F32) => fn (o: U32) => #Mesh { shape: packet.u32 v o, color: #Color { r: v[o + 1], g: v[o + 1 + 1], b: v[o + 1 + 2], a: v[o + 1 + 3] }, texture: packet.u32 v (o + 5), roughness: v[o + 6], metallic: v[o + 7], emissive: #Color { r: v[o + 8], g: v[o + 8 + 1], b: v[o + 8 + 2], a: v[o + 8 + 3] }, emissive_strength: v[o + 12], normal_map: packet.u32 v (o + 13), normal_strength: v[o + 14], orm_map: packet.u32 v (o + 15), uv_scale: #Vec2 { x: v[o + 16], y: v[o + 16 + 1] }, alpha_mode: decode_alpha_mode (packet.u32 v (o + 18)), alpha_cutoff: v[o + 19], double_sided: packet.bool v (o + 20), use_materials: packet.bool v (o + 21), cast_shadows: packet.bool v (o + 22), bake_lighting: packet.bool v (o + 23) }
const encode_mesh = fn (value: Mesh) => #[U32.to_f32 value.shape, value.color.r, value.color.g, value.color.b, value.color.a, U32.to_f32 value.texture, value.roughness, value.metallic, value.emissive.r, value.emissive.g, value.emissive.b, value.emissive.a, value.emissive_strength, U32.to_f32 value.normal_map, value.normal_strength, U32.to_f32 value.orm_map, value.uv_scale.x, value.uv_scale.y, encode_alpha_mode value.alpha_mode, value.alpha_cutoff, packet.flag value.double_sided, packet.flag value.use_materials, packet.flag value.cast_shadows, packet.flag value.bake_lighting]
const decode_camera = fn (v: Array F32) => fn (o: U32) => #Camera { fov: v[o], near: v[o + 1], far: v[o + 2], orthographic: packet.bool v (o + 3), size: v[o + 4], active: packet.bool v (o + 5) }
const encode_camera = fn (value: Camera) => #[value.fov, value.near, value.far, packet.flag value.orthographic, value.size, packet.flag value.active]
const decode_light = fn (v: Array F32) => fn (o: U32) => #Light { kind: decode_light_kind (packet.u32 v o), color: #Color { r: v[o + 1], g: v[o + 1 + 1], b: v[o + 1 + 2], a: v[o + 1 + 3] }, intensity: v[o + 5], range: v[o + 6], angle: v[o + 7], shadows: packet.bool v (o + 8), softness: v[o + 9] }
const encode_light = fn (value: Light) => #[encode_light_kind value.kind, value.color.r, value.color.g, value.color.b, value.color.a, value.intensity, value.range, value.angle, packet.flag value.shadows, value.softness]
const decode_environment = fn (v: Array F32) => fn (o: U32) => #Environment { active: packet.bool v o, sky: decode_sky_kind (packet.u32 v (o + 1)), sky_color: #Color { r: v[o + 2], g: v[o + 2 + 1], b: v[o + 2 + 2], a: v[o + 2 + 3] }, horizon_color: #Color { r: v[o + 6], g: v[o + 6 + 1], b: v[o + 6 + 2], a: v[o + 6 + 3] }, ground_color: #Color { r: v[o + 10], g: v[o + 10 + 1], b: v[o + 10 + 2], a: v[o + 10 + 3] }, sky_intensity: v[o + 14], sky_altitude: v[o + 15], cloud_coverage: v[o + 16], cloud_height: v[o + 17], cloud_scale: v[o + 18], cloud_offset: v[o + 19], ambient: v[o + 20], ambient_occlusion: v[o + 21], reflections: v[o + 22], indirect: v[o + 23], ao_radius: v[o + 24], shadow_distance: v[o + 25], exposure: v[o + 26], auto_exposure: packet.bool v (o + 27), tonemap: decode_tonemap (packet.u32 v (o + 28)), bloom: v[o + 29], contrast: v[o + 30], saturation: v[o + 31], temperature: v[o + 32], vignette: v[o + 33], grain: v[o + 34], fog_density: v[o + 35], fog_color: #Color { r: v[o + 36], g: v[o + 36 + 1], b: v[o + 36 + 2], a: v[o + 36 + 3] }, fog_height: v[o + 40], fog_falloff: v[o + 41] }
const encode_environment = fn (value: Environment) => #[packet.flag value.active, encode_sky_kind value.sky, value.sky_color.r, value.sky_color.g, value.sky_color.b, value.sky_color.a, value.horizon_color.r, value.horizon_color.g, value.horizon_color.b, value.horizon_color.a, value.ground_color.r, value.ground_color.g, value.ground_color.b, value.ground_color.a, value.sky_intensity, value.sky_altitude, value.cloud_coverage, value.cloud_height, value.cloud_scale, value.cloud_offset, value.ambient, value.ambient_occlusion, value.reflections, value.indirect, value.ao_radius, value.shadow_distance, value.exposure, packet.flag value.auto_exposure, encode_tonemap value.tonemap, value.bloom, value.contrast, value.saturation, value.temperature, value.vignette, value.grain, value.fog_density, value.fog_color.r, value.fog_color.g, value.fog_color.b, value.fog_color.a, value.fog_height, value.fog_falloff]
const decode_brush = fn (v: Array F32) => fn (o: U32) => do:
  let at = o
  let f_bake_lighting = packet.bool v at
  at := self + 1
  let f_visible = packet.bool v at
  at := self + 1
  let f_faces = decode_list_face v at
  at := self + (1 + packet.u32 v at * 22)
  return #Brush { bake_lighting: f_bake_lighting, visible: f_visible, faces: f_faces }
const size_brush = fn (v: Array F32) => fn (o: U32) -> U32 => do:
  let at = o
  at := self + 1
  at := self + 1
  at := self + (1 + packet.u32 v at * 22)
  return at - o
const lanes_brush = fn (value: Brush) -> U32 => 2 + (1 + value.faces.length * 22)
const encode_brush = fn (value: Brush) => array.flatten #[#[packet.flag value.bake_lighting, packet.flag value.visible], encode_list_face value.faces]
const decode_emitter = fn (v: Array F32) => fn (o: U32) => #Emitter { active: packet.bool v o, seed: packet.u32 v (o + 1), start_tick: packet.u32 v (o + 2), rate: v[o + 3], lifetime: v[o + 4], velocity: #Vec3 { x: v[o + 5], y: v[o + 5 + 1], z: v[o + 5 + 2] }, spread: #Vec3 { x: v[o + 8], y: v[o + 8 + 1], z: v[o + 8 + 2] }, gravity: #Vec3 { x: v[o + 11], y: v[o + 11 + 1], z: v[o + 11 + 2] }, radius: v[o + 14], size: #Vec2 { x: v[o + 15], y: v[o + 15 + 1] }, color: #Color { r: v[o + 17], g: v[o + 17 + 1], b: v[o + 17 + 2], a: v[o + 17 + 3] }, end_color: #Color { r: v[o + 21], g: v[o + 21 + 1], b: v[o + 21 + 2], a: v[o + 21 + 3] }, intensity: v[o + 25], additive: packet.bool v (o + 26), shape: decode_particle_shape (packet.u32 v (o + 27)), texture: packet.u32 v (o + 28) }
const encode_emitter = fn (value: Emitter) => #[packet.flag value.active, U32.to_f32 value.seed, U32.to_f32 value.start_tick, value.rate, value.lifetime, value.velocity.x, value.velocity.y, value.velocity.z, value.spread.x, value.spread.y, value.spread.z, value.gravity.x, value.gravity.y, value.gravity.z, value.radius, value.size.x, value.size.y, value.color.r, value.color.g, value.color.b, value.color.a, value.end_color.r, value.end_color.g, value.end_color.b, value.end_color.a, value.intensity, packet.flag value.additive, encode_particle_shape value.shape, U32.to_f32 value.texture]
const decode_animation = fn (v: Array F32) => fn (o: U32) => #Animation { clip: packet.u32 v o, time: v[o + 1], loop: packet.bool v (o + 2), previous_clip: packet.u32 v (o + 3), previous_time: v[o + 4], previous_loop: packet.bool v (o + 5), blend: v[o + 6] }
const encode_animation = fn (value: Animation) => #[U32.to_f32 value.clip, value.time, packet.flag value.loop, U32.to_f32 value.previous_clip, value.previous_time, packet.flag value.previous_loop, value.blend]
const decode_attachment = fn (v: Array F32) => fn (o: U32) => #Attachment { target: packet.u32 v o, node: packet.u32 v (o + 1) }
const encode_attachment = fn (value: Attachment) => #[U32.to_f32 value.target, U32.to_f32 value.node]
const decode_collider = fn (v: Array F32) => fn (o: U32) => #Collider { shape: decode_collider_shape (packet.u32 v o), size: #Vec3 { x: v[o + 1], y: v[o + 1 + 1], z: v[o + 1 + 2] }, radius: v[o + 4], height: v[o + 5], offset: #Vec3 { x: v[o + 6], y: v[o + 6 + 1], z: v[o + 6 + 2] }, friction: v[o + 9], restitution: v[o + 10], layer: packet.u32 v (o + 11), mask: packet.u32 v (o + 12), trigger: packet.bool v (o + 13) }
const encode_collider = fn (value: Collider) => #[encode_collider_shape value.shape, value.size.x, value.size.y, value.size.z, value.radius, value.height, value.offset.x, value.offset.y, value.offset.z, value.friction, value.restitution, U32.to_f32 value.layer, U32.to_f32 value.mask, packet.flag value.trigger]
const decode_body = fn (v: Array F32) => fn (o: U32) => #Body { kind: decode_body_kind (packet.u32 v o), mass: v[o + 1], gravity_scale: v[o + 2], linear_damping: v[o + 3], angular_damping: v[o + 4], can_sleep: packet.bool v (o + 5), continuous: packet.bool v (o + 6), linear_velocity: #Vec3 { x: v[o + 7], y: v[o + 7 + 1], z: v[o + 7 + 2] }, angular_velocity: #Vec3 { x: v[o + 10], y: v[o + 10 + 1], z: v[o + 10 + 2] }, sleeping: packet.bool v (o + 13), sleep_time: v[o + 14] }
const encode_body = fn (value: Body) => #[encode_body_kind value.kind, value.mass, value.gravity_scale, value.linear_damping, value.angular_damping, packet.flag value.can_sleep, packet.flag value.continuous, value.linear_velocity.x, value.linear_velocity.y, value.linear_velocity.z, value.angular_velocity.x, value.angular_velocity.y, value.angular_velocity.z, packet.flag value.sleeping, value.sleep_time]
const decode_character = fn (v: Array F32) => fn (o: U32) => #Character { max_slope: v[o], step_height: v[o + 1], snap_distance: v[o + 2], push: v[o + 3], velocity: #Vec3 { x: v[o + 4], y: v[o + 4 + 1], z: v[o + 4 + 2] }, grounded: packet.bool v (o + 7), ground: packet.u32 v (o + 8), ground_normal: #Vec3 { x: v[o + 9], y: v[o + 9 + 1], z: v[o + 9 + 2] } }
const encode_character = fn (value: Character) => #[value.max_slope, value.step_height, value.snap_distance, value.push, value.velocity.x, value.velocity.y, value.velocity.z, packet.flag value.grounded, U32.to_f32 value.ground, value.ground_normal.x, value.ground_normal.y, value.ground_normal.z]
const decode_outputs = fn (v: Array F32) => fn (o: U32) => do:
  let at = o
  let f_connections = decode_list_connection v at
  at := self + (1 + packet.u32 v at * 6)
  return #Outputs { connections: f_connections }
const size_outputs = fn (v: Array F32) => fn (o: U32) -> U32 => do:
  let at = o
  at := self + (1 + packet.u32 v at * 6)
  return at - o
const lanes_outputs = fn (value: Outputs) -> U32 => (1 + value.connections.length * 6)
const encode_outputs = fn (value: Outputs) => encode_list_connection value.connections
const decode_player = fn (v: Array F32) => fn (o: U32) => #Player { speed: v[o], jump: v[o + 1], gravity: v[o + 2], reach: v[o + 3], yaw: v[o + 4], pitch: v[o + 5] }
const encode_player = fn (value: Player) => #[value.speed, value.jump, value.gravity, value.reach, value.yaw, value.pitch]
const decode_push_button = fn (v: Array F32) => fn (o: U32) => #PushButton { reach: v[o], radius: v[o + 1], cooldown: v[o + 2], wait: v[o + 3], locked: packet.bool v (o + 4) }
const encode_push_button = fn (value: PushButton) => #[value.reach, value.radius, value.cooldown, value.wait, packet.flag value.locked]
const decode_trigger_zone = fn (v: Array F32) => fn (o: U32) => #TriggerZone { enabled: packet.bool v o, inside: packet.bool v (o + 1) }
const encode_trigger_zone = fn (value: TriggerZone) => #[packet.flag value.enabled, packet.flag value.inside]
const decode_door = fn (v: Array F32) => fn (o: U32) => #Door { offset: #Vec3 { x: v[o], y: v[o + 1], z: v[o + 2] }, speed: v[o + 3], progress: v[o + 4], goal: v[o + 5], origin: #Vec3 { x: v[o + 6], y: v[o + 6 + 1], z: v[o + 6 + 2] } }
const encode_door = fn (value: Door) => #[value.offset.x, value.offset.y, value.offset.z, value.speed, value.progress, value.goal, value.origin.x, value.origin.y, value.origin.z]
const decode_lamp = fn (v: Array F32) => fn (o: U32) => #Lamp { on: packet.bool v o, brightness: v[o + 1] }
const encode_lamp = fn (value: Lamp) => #[packet.flag value.on, value.brightness]
const decode_relay = fn (v: Array F32) => fn (o: U32) => #Relay { enabled: packet.bool v o }
const encode_relay = fn (value: Relay) => #[packet.flag value.enabled]
const decode_counter = fn (v: Array F32) => fn (o: U32) => #Counter { count: packet.u32 v o, max: packet.u32 v (o + 1) }
const encode_counter = fn (value: Counter) => #[U32.to_f32 value.count, U32.to_f32 value.max]
const decode_marker = fn (v: Array F32) => fn (o: U32) => #Marker
const encode_marker = fn (value: Marker) -> Array F32 => #[]
const decode_physics = fn (v: Array F32) => fn (o: U32) => do:
  let at = o
  let f_gravity = #Vec3 { x: v[at], y: v[at + 1], z: v[at + 2] }
  at := self + 3
  let f_substeps = packet.u32 v at
  at := self + 1
  let f_sleep_time = v[at]
  at := self + 1
  let f_linear_sleep = v[at]
  at := self + 1
  let f_angular_sleep = v[at]
  at := self + 1
  let f_contacts = decode_list_f32 v at
  at := self + (1 + packet.u32 v at * 1)
  return #Physics { gravity: f_gravity, substeps: f_substeps, sleep_time: f_sleep_time, linear_sleep: f_linear_sleep, angular_sleep: f_angular_sleep, contacts: f_contacts }
const size_physics = fn (v: Array F32) => fn (o: U32) -> U32 => do:
  let at = o
  at := self + 3
  at := self + 1
  at := self + 1
  at := self + 1
  at := self + 1
  at := self + (1 + packet.u32 v at * 1)
  return at - o
const lanes_physics = fn (value: Physics) -> U32 => 7 + (1 + value.contacts.length * 1)
const encode_physics = fn (value: Physics) => array.flatten #[#[value.gravity.x, value.gravity.y, value.gravity.z, U32.to_f32 value.substeps, value.sleep_time, value.linear_sleep, value.angular_sleep], encode_list_f32 value.contacts]
const decode_game = fn (v: Array F32) => fn (o: U32) => #Game { finished: packet.bool v o, focus: packet.u32 v (o + 1), presses: packet.u32 v (o + 2) }
const encode_game = fn (value: Game) => #[packet.flag value.finished, U32.to_f32 value.focus, U32.to_f32 value.presses]
const decode_wiring = fn (v: Array F32) => fn (o: U32) => do:
  let at = o
  let f_queue = decode_list_pending v at
  at := self + (1 + packet.u32 v at * 3)
  return #Wiring { queue: f_queue }
const size_wiring = fn (v: Array F32) => fn (o: U32) -> U32 => do:
  let at = o
  at := self + (1 + packet.u32 v at * 3)
  return at - o
const lanes_wiring = fn (value: Wiring) -> U32 => (1 + value.queue.length * 3)
const encode_wiring = fn (value: Wiring) => encode_list_pending value.queue

const decode_entity = fn (v: Array F32) => fn (o: U32) => do:
  let at = o + 3
  let c_reflection_probe = if v[at] == 0.0 then #Nothing else #Some (decode_reflection_probe v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 6)
  let c_transform = if v[at] == 0.0 then #Nothing else #Some (decode_transform v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 11)
  let c_mesh = if v[at] == 0.0 then #Nothing else #Some (decode_mesh v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 25)
  let c_camera = if v[at] == 0.0 then #Nothing else #Some (decode_camera v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 7)
  let c_light = if v[at] == 0.0 then #Nothing else #Some (decode_light v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 11)
  let c_environment = if v[at] == 0.0 then #Nothing else #Some (decode_environment v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 43)
  let c_brush = if v[at] == 0.0 then #Nothing else #Some (decode_brush v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 1 + size_brush v (at + 1))
  let c_emitter = if v[at] == 0.0 then #Nothing else #Some (decode_emitter v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 30)
  let c_animation = if v[at] == 0.0 then #Nothing else #Some (decode_animation v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 8)
  let c_attachment = if v[at] == 0.0 then #Nothing else #Some (decode_attachment v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 3)
  let c_collider = if v[at] == 0.0 then #Nothing else #Some (decode_collider v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 15)
  let c_body = if v[at] == 0.0 then #Nothing else #Some (decode_body v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 16)
  let c_character = if v[at] == 0.0 then #Nothing else #Some (decode_character v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 13)
  let c_outputs = if v[at] == 0.0 then #Nothing else #Some (decode_outputs v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 1 + size_outputs v (at + 1))
  let c_player = if v[at] == 0.0 then #Nothing else #Some (decode_player v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 7)
  let c_push_button = if v[at] == 0.0 then #Nothing else #Some (decode_push_button v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 6)
  let c_trigger_zone = if v[at] == 0.0 then #Nothing else #Some (decode_trigger_zone v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 3)
  let c_door = if v[at] == 0.0 then #Nothing else #Some (decode_door v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 10)
  let c_lamp = if v[at] == 0.0 then #Nothing else #Some (decode_lamp v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 3)
  let c_relay = if v[at] == 0.0 then #Nothing else #Some (decode_relay v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 2)
  let c_counter = if v[at] == 0.0 then #Nothing else #Some (decode_counter v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 3)
  let c_marker = if v[at] == 0.0 then #Nothing else #Some (decode_marker v (at + 1))
  at := self + (if v[at] == 0.0 then 1 else 1)
  return #Entity { id: packet.u32 v o, parent: packet.u32 v (o + 1), name_id: packet.u32 v (o + 2), reflection_probe: c_reflection_probe, transform: c_transform, mesh: c_mesh, camera: c_camera, light: c_light, environment: c_environment, brush: c_brush, emitter: c_emitter, animation: c_animation, attachment: c_attachment, collider: c_collider, body: c_body, character: c_character, outputs: c_outputs, player: c_player, push_button: c_push_button, trigger_zone: c_trigger_zone, door: c_door, lamp: c_lamp, relay: c_relay, counter: c_counter, marker: c_marker }
const encode_entity = fn (e: Entity) => do:
  let id: F32 = U32.to_f32 e.id
  let parent: F32 = U32.to_f32 e.parent
  let name_id: F32 = U32.to_f32 e.name_id
  return array.flatten #[
    #[id, parent, name_id],
    packet.optional encode_reflection_probe e.reflection_probe,
    packet.optional encode_transform e.transform,
    packet.optional encode_mesh e.mesh,
    packet.optional encode_camera e.camera,
    packet.optional encode_light e.light,
    packet.optional encode_environment e.environment,
    packet.optional encode_brush e.brush,
    packet.optional encode_emitter e.emitter,
    packet.optional encode_animation e.animation,
    packet.optional encode_attachment e.attachment,
    packet.optional encode_collider e.collider,
    packet.optional encode_body e.body,
    packet.optional encode_character e.character,
    packet.optional encode_outputs e.outputs,
    packet.optional encode_player e.player,
    packet.optional encode_push_button e.push_button,
    packet.optional encode_trigger_zone e.trigger_zone,
    packet.optional encode_door e.door,
    packet.optional encode_lamp e.lamp,
    packet.optional encode_relay e.relay,
    packet.optional encode_counter e.counter,
    packet.optional encode_marker e.marker,
  ]
const decode_resources = fn (v: Array F32) => fn (o: U32) => do:
  let at = o
  let r_physics = decode_physics v at
  at := self + size_physics v at
  let r_game = decode_game v at
  at := self + 3
  let r_wiring = decode_wiring v at
  at := self + size_wiring v at
  return #Resources { physics: r_physics, game: r_game, wiring: r_wiring }
const encode_resources = fn (value: Resources) => array.flatten #[encode_physics value.physics, encode_game value.game, encode_wiring value.wiring]

const decode_world = fn (v: Array F32) => fn (base: U32) => do:
  if packet.u32 v base != layout_hash:
    return @panic "state packet was written by a different schema"
  let count = packet.u32 v (base + 5)
  let high = packet.u32 v (base + 3)
  let low = packet.u32 v (base + 4)
  return #World {
    tick: packet.u32 v (base + 1),
    next_entity: packet.u32 v (base + 2),
    seed: (high << 16) | low,
    entities: @array.generate count (fn index => decode_entity v (base + packet.u32 v (base + 7 + index))),
    resources: decode_resources v (base + packet.u32 v (base + 6)),
  }



// The step result, written in place: the state's lane count, the state packet
// (see codec.ts) and then the events.
const encode_result = fn (w: World) => fn (tail: Array F32) => do:
  let entities = w.entities
  let count = entities.length
  let starts = @array.fill count 0
  let at = 7 + count
  for index in 0..count:
    let e = entities[index]
    starts[index] := at
    at := self + 3
    at := self + (case e.reflection_probe of
      #Some _ => 1 + 5
      #Nothing => 1)
    at := self + (case e.transform of
      #Some _ => 1 + 10
      #Nothing => 1)
    at := self + (case e.mesh of
      #Some _ => 1 + 24
      #Nothing => 1)
    at := self + (case e.camera of
      #Some _ => 1 + 6
      #Nothing => 1)
    at := self + (case e.light of
      #Some _ => 1 + 10
      #Nothing => 1)
    at := self + (case e.environment of
      #Some _ => 1 + 42
      #Nothing => 1)
    at := self + (case e.brush of
      #Some value => 1 + 2 + (1 + value.faces.length * 22)
      #Nothing => 1)
    at := self + (case e.emitter of
      #Some _ => 1 + 29
      #Nothing => 1)
    at := self + (case e.animation of
      #Some _ => 1 + 7
      #Nothing => 1)
    at := self + (case e.attachment of
      #Some _ => 1 + 2
      #Nothing => 1)
    at := self + (case e.collider of
      #Some _ => 1 + 14
      #Nothing => 1)
    at := self + (case e.body of
      #Some _ => 1 + 15
      #Nothing => 1)
    at := self + (case e.character of
      #Some _ => 1 + 12
      #Nothing => 1)
    at := self + (case e.outputs of
      #Some value => 1 + (1 + value.connections.length * 6)
      #Nothing => 1)
    at := self + (case e.player of
      #Some _ => 1 + 6
      #Nothing => 1)
    at := self + (case e.push_button of
      #Some _ => 1 + 5
      #Nothing => 1)
    at := self + (case e.trigger_zone of
      #Some _ => 1 + 2
      #Nothing => 1)
    at := self + (case e.door of
      #Some _ => 1 + 9
      #Nothing => 1)
    at := self + (case e.lamp of
      #Some _ => 1 + 2
      #Nothing => 1)
    at := self + (case e.relay of
      #Some _ => 1 + 1
      #Nothing => 1)
    at := self + (case e.counter of
      #Some _ => 1 + 2
      #Nothing => 1)
    at := self + (case e.marker of
      #Some _ => 1 + 0
      #Nothing => 1)
  let resources_at = at
  at := self + 7 + (1 + w.resources.physics.contacts.length * 1)
  at := self + 3
  at := self + (1 + w.resources.wiring.queue.length * 3)
  let out = @array.fill (1 + at + tail.length) 0.0
  out[0] := U32.to_f32 at
  out[1] := U32.to_f32 layout_hash
  out[2] := U32.to_f32 w.tick
  out[3] := U32.to_f32 w.next_entity
  out[4] := U32.to_f32 (w.seed >> 16)
  out[5] := U32.to_f32 (w.seed & 65535)
  out[6] := U32.to_f32 count
  out[7] := U32.to_f32 resources_at
  for index in 0..count:
    let e = entities[index]
    let start = starts[index]
    out[8 + index] := U32.to_f32 start
    let q = 1 + start
    out[q] := U32.to_f32 e.id
    out[q + 1] := U32.to_f32 e.parent
    out[q + 2] := U32.to_f32 e.name_id
    q := self + 3
    if let #Some c_reflection_probe = e.reflection_probe:
      out[q] := 1.0
      out[q + 1] := c_reflection_probe.size.x
      out[q + 2] := c_reflection_probe.size.y
      out[q + 3] := c_reflection_probe.size.z
      out[q + 4] := c_reflection_probe.blend
      out[q + 5] := c_reflection_probe.intensity
      q := self + 6
    else:
      q := self + 1
    if let #Some c_transform = e.transform:
      out[q] := 1.0
      out[q + 1] := c_transform.position.x
      out[q + 2] := c_transform.position.y
      out[q + 3] := c_transform.position.z
      out[q + 4] := c_transform.rotation.x
      out[q + 5] := c_transform.rotation.y
      out[q + 6] := c_transform.rotation.z
      out[q + 7] := c_transform.rotation.w
      out[q + 8] := c_transform.scale.x
      out[q + 9] := c_transform.scale.y
      out[q + 10] := c_transform.scale.z
      q := self + 11
    else:
      q := self + 1
    if let #Some c_mesh = e.mesh:
      out[q] := 1.0
      out[q + 1] := U32.to_f32 c_mesh.shape
      out[q + 2] := c_mesh.color.r
      out[q + 3] := c_mesh.color.g
      out[q + 4] := c_mesh.color.b
      out[q + 5] := c_mesh.color.a
      out[q + 6] := U32.to_f32 c_mesh.texture
      out[q + 7] := c_mesh.roughness
      out[q + 8] := c_mesh.metallic
      out[q + 9] := c_mesh.emissive.r
      out[q + 10] := c_mesh.emissive.g
      out[q + 11] := c_mesh.emissive.b
      out[q + 12] := c_mesh.emissive.a
      out[q + 13] := c_mesh.emissive_strength
      out[q + 14] := U32.to_f32 c_mesh.normal_map
      out[q + 15] := c_mesh.normal_strength
      out[q + 16] := U32.to_f32 c_mesh.orm_map
      out[q + 17] := c_mesh.uv_scale.x
      out[q + 18] := c_mesh.uv_scale.y
      out[q + 19] := encode_alpha_mode c_mesh.alpha_mode
      out[q + 20] := c_mesh.alpha_cutoff
      out[q + 21] := packet.flag c_mesh.double_sided
      out[q + 22] := packet.flag c_mesh.use_materials
      out[q + 23] := packet.flag c_mesh.cast_shadows
      out[q + 24] := packet.flag c_mesh.bake_lighting
      q := self + 25
    else:
      q := self + 1
    if let #Some c_camera = e.camera:
      out[q] := 1.0
      out[q + 1] := c_camera.fov
      out[q + 2] := c_camera.near
      out[q + 3] := c_camera.far
      out[q + 4] := packet.flag c_camera.orthographic
      out[q + 5] := c_camera.size
      out[q + 6] := packet.flag c_camera.active
      q := self + 7
    else:
      q := self + 1
    if let #Some c_light = e.light:
      out[q] := 1.0
      out[q + 1] := encode_light_kind c_light.kind
      out[q + 2] := c_light.color.r
      out[q + 3] := c_light.color.g
      out[q + 4] := c_light.color.b
      out[q + 5] := c_light.color.a
      out[q + 6] := c_light.intensity
      out[q + 7] := c_light.range
      out[q + 8] := c_light.angle
      out[q + 9] := packet.flag c_light.shadows
      out[q + 10] := c_light.softness
      q := self + 11
    else:
      q := self + 1
    if let #Some c_environment = e.environment:
      out[q] := 1.0
      out[q + 1] := packet.flag c_environment.active
      out[q + 2] := encode_sky_kind c_environment.sky
      out[q + 3] := c_environment.sky_color.r
      out[q + 4] := c_environment.sky_color.g
      out[q + 5] := c_environment.sky_color.b
      out[q + 6] := c_environment.sky_color.a
      out[q + 7] := c_environment.horizon_color.r
      out[q + 8] := c_environment.horizon_color.g
      out[q + 9] := c_environment.horizon_color.b
      out[q + 10] := c_environment.horizon_color.a
      out[q + 11] := c_environment.ground_color.r
      out[q + 12] := c_environment.ground_color.g
      out[q + 13] := c_environment.ground_color.b
      out[q + 14] := c_environment.ground_color.a
      out[q + 15] := c_environment.sky_intensity
      out[q + 16] := c_environment.sky_altitude
      out[q + 17] := c_environment.cloud_coverage
      out[q + 18] := c_environment.cloud_height
      out[q + 19] := c_environment.cloud_scale
      out[q + 20] := c_environment.cloud_offset
      out[q + 21] := c_environment.ambient
      out[q + 22] := c_environment.ambient_occlusion
      out[q + 23] := c_environment.reflections
      out[q + 24] := c_environment.indirect
      out[q + 25] := c_environment.ao_radius
      out[q + 26] := c_environment.shadow_distance
      out[q + 27] := c_environment.exposure
      out[q + 28] := packet.flag c_environment.auto_exposure
      out[q + 29] := encode_tonemap c_environment.tonemap
      out[q + 30] := c_environment.bloom
      out[q + 31] := c_environment.contrast
      out[q + 32] := c_environment.saturation
      out[q + 33] := c_environment.temperature
      out[q + 34] := c_environment.vignette
      out[q + 35] := c_environment.grain
      out[q + 36] := c_environment.fog_density
      out[q + 37] := c_environment.fog_color.r
      out[q + 38] := c_environment.fog_color.g
      out[q + 39] := c_environment.fog_color.b
      out[q + 40] := c_environment.fog_color.a
      out[q + 41] := c_environment.fog_height
      out[q + 42] := c_environment.fog_falloff
      q := self + 43
    else:
      q := self + 1
    if let #Some c_brush = e.brush:
      out[q] := 1.0
      out[q + 1] := packet.flag c_brush.bake_lighting
      out[q + 2] := packet.flag c_brush.visible
      q := self + 3
      out[q] := U32.to_f32 c_brush.faces.length
      for i_0 in 0..c_brush.faces.length:
        let item_0 = c_brush.faces[i_0]
        out[q + 1 + i_0 * 22] := item_0.plane.x
        out[q + 1 + i_0 * 22 + 1] := item_0.plane.y
        out[q + 1 + i_0 * 22 + 2] := item_0.plane.z
        out[q + 1 + i_0 * 22 + 3] := item_0.plane.w
        out[q + 1 + i_0 * 22 + 4] := U32.to_f32 item_0.texture
        out[q + 1 + i_0 * 22 + 5] := item_0.color.r
        out[q + 1 + i_0 * 22 + 6] := item_0.color.g
        out[q + 1 + i_0 * 22 + 7] := item_0.color.b
        out[q + 1 + i_0 * 22 + 8] := item_0.color.a
        out[q + 1 + i_0 * 22 + 9] := item_0.offset.x
        out[q + 1 + i_0 * 22 + 10] := item_0.offset.y
        out[q + 1 + i_0 * 22 + 11] := item_0.scale.x
        out[q + 1 + i_0 * 22 + 12] := item_0.scale.y
        out[q + 1 + i_0 * 22 + 13] := item_0.rotation
        out[q + 1 + i_0 * 22 + 14] := item_0.uv_u.x
        out[q + 1 + i_0 * 22 + 15] := item_0.uv_u.y
        out[q + 1 + i_0 * 22 + 16] := item_0.uv_u.z
        out[q + 1 + i_0 * 22 + 17] := item_0.uv_u.w
        out[q + 1 + i_0 * 22 + 18] := item_0.uv_v.x
        out[q + 1 + i_0 * 22 + 19] := item_0.uv_v.y
        out[q + 1 + i_0 * 22 + 20] := item_0.uv_v.z
        out[q + 1 + i_0 * 22 + 21] := item_0.uv_v.w
      q := self + (1 + c_brush.faces.length * 22)
    else:
      q := self + 1
    if let #Some c_emitter = e.emitter:
      out[q] := 1.0
      out[q + 1] := packet.flag c_emitter.active
      out[q + 2] := U32.to_f32 c_emitter.seed
      out[q + 3] := U32.to_f32 c_emitter.start_tick
      out[q + 4] := c_emitter.rate
      out[q + 5] := c_emitter.lifetime
      out[q + 6] := c_emitter.velocity.x
      out[q + 7] := c_emitter.velocity.y
      out[q + 8] := c_emitter.velocity.z
      out[q + 9] := c_emitter.spread.x
      out[q + 10] := c_emitter.spread.y
      out[q + 11] := c_emitter.spread.z
      out[q + 12] := c_emitter.gravity.x
      out[q + 13] := c_emitter.gravity.y
      out[q + 14] := c_emitter.gravity.z
      out[q + 15] := c_emitter.radius
      out[q + 16] := c_emitter.size.x
      out[q + 17] := c_emitter.size.y
      out[q + 18] := c_emitter.color.r
      out[q + 19] := c_emitter.color.g
      out[q + 20] := c_emitter.color.b
      out[q + 21] := c_emitter.color.a
      out[q + 22] := c_emitter.end_color.r
      out[q + 23] := c_emitter.end_color.g
      out[q + 24] := c_emitter.end_color.b
      out[q + 25] := c_emitter.end_color.a
      out[q + 26] := c_emitter.intensity
      out[q + 27] := packet.flag c_emitter.additive
      out[q + 28] := encode_particle_shape c_emitter.shape
      out[q + 29] := U32.to_f32 c_emitter.texture
      q := self + 30
    else:
      q := self + 1
    if let #Some c_animation = e.animation:
      out[q] := 1.0
      out[q + 1] := U32.to_f32 c_animation.clip
      out[q + 2] := c_animation.time
      out[q + 3] := packet.flag c_animation.loop
      out[q + 4] := U32.to_f32 c_animation.previous_clip
      out[q + 5] := c_animation.previous_time
      out[q + 6] := packet.flag c_animation.previous_loop
      out[q + 7] := c_animation.blend
      q := self + 8
    else:
      q := self + 1
    if let #Some c_attachment = e.attachment:
      out[q] := 1.0
      out[q + 1] := U32.to_f32 c_attachment.target
      out[q + 2] := U32.to_f32 c_attachment.node
      q := self + 3
    else:
      q := self + 1
    if let #Some c_collider = e.collider:
      out[q] := 1.0
      out[q + 1] := encode_collider_shape c_collider.shape
      out[q + 2] := c_collider.size.x
      out[q + 3] := c_collider.size.y
      out[q + 4] := c_collider.size.z
      out[q + 5] := c_collider.radius
      out[q + 6] := c_collider.height
      out[q + 7] := c_collider.offset.x
      out[q + 8] := c_collider.offset.y
      out[q + 9] := c_collider.offset.z
      out[q + 10] := c_collider.friction
      out[q + 11] := c_collider.restitution
      out[q + 12] := U32.to_f32 c_collider.layer
      out[q + 13] := U32.to_f32 c_collider.mask
      out[q + 14] := packet.flag c_collider.trigger
      q := self + 15
    else:
      q := self + 1
    if let #Some c_body = e.body:
      out[q] := 1.0
      out[q + 1] := encode_body_kind c_body.kind
      out[q + 2] := c_body.mass
      out[q + 3] := c_body.gravity_scale
      out[q + 4] := c_body.linear_damping
      out[q + 5] := c_body.angular_damping
      out[q + 6] := packet.flag c_body.can_sleep
      out[q + 7] := packet.flag c_body.continuous
      out[q + 8] := c_body.linear_velocity.x
      out[q + 9] := c_body.linear_velocity.y
      out[q + 10] := c_body.linear_velocity.z
      out[q + 11] := c_body.angular_velocity.x
      out[q + 12] := c_body.angular_velocity.y
      out[q + 13] := c_body.angular_velocity.z
      out[q + 14] := packet.flag c_body.sleeping
      out[q + 15] := c_body.sleep_time
      q := self + 16
    else:
      q := self + 1
    if let #Some c_character = e.character:
      out[q] := 1.0
      out[q + 1] := c_character.max_slope
      out[q + 2] := c_character.step_height
      out[q + 3] := c_character.snap_distance
      out[q + 4] := c_character.push
      out[q + 5] := c_character.velocity.x
      out[q + 6] := c_character.velocity.y
      out[q + 7] := c_character.velocity.z
      out[q + 8] := packet.flag c_character.grounded
      out[q + 9] := U32.to_f32 c_character.ground
      out[q + 10] := c_character.ground_normal.x
      out[q + 11] := c_character.ground_normal.y
      out[q + 12] := c_character.ground_normal.z
      q := self + 13
    else:
      q := self + 1
    if let #Some c_outputs = e.outputs:
      out[q] := 1.0
      q := self + 1
      out[q] := U32.to_f32 c_outputs.connections.length
      for i_0 in 0..c_outputs.connections.length:
        let item_0 = c_outputs.connections[i_0]
        out[q + 1 + i_0 * 6] := encode_io_event item_0.event
        out[q + 1 + i_0 * 6 + 1] := U32.to_f32 item_0.target
        out[q + 1 + i_0 * 6 + 2] := encode_io_input item_0.input
        out[q + 1 + i_0 * 6 + 3] := item_0.delay
        out[q + 1 + i_0 * 6 + 4] := packet.flag item_0.once
        out[q + 1 + i_0 * 6 + 5] := packet.flag item_0.fired
      q := self + (1 + c_outputs.connections.length * 6)
    else:
      q := self + 1
    if let #Some c_player = e.player:
      out[q] := 1.0
      out[q + 1] := c_player.speed
      out[q + 2] := c_player.jump
      out[q + 3] := c_player.gravity
      out[q + 4] := c_player.reach
      out[q + 5] := c_player.yaw
      out[q + 6] := c_player.pitch
      q := self + 7
    else:
      q := self + 1
    if let #Some c_push_button = e.push_button:
      out[q] := 1.0
      out[q + 1] := c_push_button.reach
      out[q + 2] := c_push_button.radius
      out[q + 3] := c_push_button.cooldown
      out[q + 4] := c_push_button.wait
      out[q + 5] := packet.flag c_push_button.locked
      q := self + 6
    else:
      q := self + 1
    if let #Some c_trigger_zone = e.trigger_zone:
      out[q] := 1.0
      out[q + 1] := packet.flag c_trigger_zone.enabled
      out[q + 2] := packet.flag c_trigger_zone.inside
      q := self + 3
    else:
      q := self + 1
    if let #Some c_door = e.door:
      out[q] := 1.0
      out[q + 1] := c_door.offset.x
      out[q + 2] := c_door.offset.y
      out[q + 3] := c_door.offset.z
      out[q + 4] := c_door.speed
      out[q + 5] := c_door.progress
      out[q + 6] := c_door.goal
      out[q + 7] := c_door.origin.x
      out[q + 8] := c_door.origin.y
      out[q + 9] := c_door.origin.z
      q := self + 10
    else:
      q := self + 1
    if let #Some c_lamp = e.lamp:
      out[q] := 1.0
      out[q + 1] := packet.flag c_lamp.on
      out[q + 2] := c_lamp.brightness
      q := self + 3
    else:
      q := self + 1
    if let #Some c_relay = e.relay:
      out[q] := 1.0
      out[q + 1] := packet.flag c_relay.enabled
      q := self + 2
    else:
      q := self + 1
    if let #Some c_counter = e.counter:
      out[q] := 1.0
      out[q + 1] := U32.to_f32 c_counter.count
      out[q + 2] := U32.to_f32 c_counter.max
      q := self + 3
    else:
      q := self + 1
    if let #Some c_marker = e.marker:
      out[q] := 1.0
      q := self + 1
    else:
      q := self + 1
  let q = 1 + resources_at
  out[q] := w.resources.physics.gravity.x
  out[q + 1] := w.resources.physics.gravity.y
  out[q + 2] := w.resources.physics.gravity.z
  out[q + 3] := U32.to_f32 w.resources.physics.substeps
  out[q + 4] := w.resources.physics.sleep_time
  out[q + 5] := w.resources.physics.linear_sleep
  out[q + 6] := w.resources.physics.angular_sleep
  q := self + 7
  out[q] := U32.to_f32 w.resources.physics.contacts.length
  for i_0 in 0..w.resources.physics.contacts.length:
    let item_0 = w.resources.physics.contacts[i_0]
    out[q + 1 + i_0 * 1] := item_0
  q := self + (1 + w.resources.physics.contacts.length * 1)
  out[q] := packet.flag w.resources.game.finished
  out[q + 1] := U32.to_f32 w.resources.game.focus
  out[q + 2] := U32.to_f32 w.resources.game.presses
  q := self + 3
  out[q] := U32.to_f32 w.resources.wiring.queue.length
  for i_0 in 0..w.resources.wiring.queue.length:
    let item_0 = w.resources.wiring.queue[i_0]
    out[q + 1 + i_0 * 3] := item_0.time
    out[q + 1 + i_0 * 3 + 1] := U32.to_f32 item_0.source
    out[q + 1 + i_0 * 3 + 2] := U32.to_f32 item_0.index
  q := self + (1 + w.resources.wiring.queue.length * 3)
  for index in 0..tail.length:
    out[1 + at + index] := tail[index]
  return out

const decode_actions = fn (v: Array F32) => fn (o: U32) => #Actions { move: packet.vec2 v o, turn: packet.vec2 v (o + 2), jump: packet.button v (o + 4), press: packet.button v (o + 7) }
const decode_player_input = fn (v: Array F32) => fn (o: U32) => #PlayerInput {
  id: packet.u32 v o,
  viewport: packet.vec2 v (o + 1),
  pointer: packet.pointer v (o + 3),
  actions: decode_actions v (o + 20),
}

const decode_input = fn (v: Array F32) => fn (o: U32) => #Input {
  tick: packet.u32 v o,
  dt: v[o + 1],
  time: v[o + 2],
  viewport: packet.vec2 v (o + 3),
  pointer: packet.pointer v (o + 5),
  actions: decode_actions v (o + 22),
  players: @array.generate (packet.u32 v (o + 32)) (fn index => decode_player_input v (o + 33 + index * 30)),
}

// Offline games use the ordinary controls. Network games select their owner.
const player_input = fn (input: Input) => fn (id: U32) => do:
  for player in input.players:
    if player.id == id:
      return player
  if input.players.length == 0:
    return #PlayerInput { id: id, viewport: input.viewport, pointer: input.pointer, actions: input.actions }
  return decode_player_input (@array.fill 30 0.0) 0

const encode_event = fn (event: Event) => case event of
  #Particles { emitter: e_emitter, position: e_position, count: e_count, seed: e_seed } => #[0.0, U32.to_f32 e_emitter, e_position.x, e_position.y, e_position.z, U32.to_f32 e_count, U32.to_f32 e_seed]
  #Log { message: e_message, a: e_a, b: e_b } => #[1.0, U32.to_f32 e_message, e_a, e_b]
  #Line { start: e_start, end: e_end, color: e_color } => #[2.0, e_start.x, e_start.y, e_start.z, e_end.x, e_end.y, e_end.z, e_color.r, e_color.g, e_color.b, e_color.a]
  #Sound { clip: e_clip, volume: e_volume, pitch: e_pitch, position: e_position, spatial: e_spatial } => #[3.0, U32.to_f32 e_clip, e_volume, e_pitch, e_position.x, e_position.y, e_position.z, packet.flag e_spatial]
  #Io { source: e_source, event: e_event, target: e_target, input: e_input, delay: e_delay } => #[4.0, U32.to_f32 e_source, e_event, U32.to_f32 e_target, e_input, e_delay]
const encode_events = fn (events: List Event) => do:
  let rows = array.map encode_event (Array.from_list events)
  let count: F32 = U32.to_f32 rows.length
  return array.flatten #[#[count], ...rows]

// Effects a step may use. `emit` sends an event to the host; `random`
// draws from the world's seed.
type Emit is effect = Event -> Unit
type Random is effect = { get: Unit -> U32, set: U32 -> Unit }

const emit = fn (event: Event) => Emit event

// A number in [0, 1).
const random = fn () => do:
  use state <- Random.get ()
  let next = rng.next state
  use Random.set next
  return rng.unit next

// A number in [low, high).
const random_range = fn (low: F32) => fn (high: F32) => do:
  use t <- random ()
  return low + (high - low) * t

const collect = fn computation => do:
  let events: List Event = []
  for request in @requests computation:
    case request of
      effect Emit event =>
        events := [...self, event]
        yield ()
      complete value =>
        return (value, events)

// Run one step: `update input world` returns the next world and may use
// emit and random. Games export it as an entry:
//   entry const step = fn (lanes: Array F32) -> Array F32 => s.run update lanes
const run = fn update => fn (lanes: Array F32) -> Array F32 => do:
  let input_lanes = packet.u32 lanes 0
  let input = decode_input lanes 1
  let world = decode_world lanes (1 + input_lanes)
  let (seed, (next, events)) = do (@effect.state Random.get Random.set world.seed):
    return collect (@computation (fn () => update input world))
  let finished: World = next
  finished.seed := seed
  return encode_result finished (encode_events events)

// World helpers. Entities keep their order; ids are never reused.

// Add `entity` with a fresh id; returns the id and the world.
const spawn = fn (entity: Entity) => fn (world: World) => do:
  let id = world.next_entity
  entity.id := id
  world.next_entity := self + 1
  world.entities := array.push entity self
  return (id, world)

const find = fn (id: U32) => fn (world: World) => do:
  for entity in world.entities:
    if entity.id == id:
      return #Some entity
  return #Nothing

// Replace the entity with the same id.
const replace = fn (entity: Entity) => fn (world: World) => do:
  world.entities := array.map (fn (other: Entity) => if other.id == entity.id then entity else other) self
  return world

// Apply `change` to every entity, in order. `change` may use effects.
const each = fn change => fn (world: World) => do:
  let entities = world.entities
  for index in 0..entities.length:
    use next <- change entities[index]
    entities[index] := next
  world.entities := entities
  return world

// Remove an entity and everything parented under it.
const despawn = fn (id: U32) => fn (world: World) => do:
  let entities = world.entities
  let count = entities.length
  let slots = @array.fill world.next_entity 0
  for index in 0..count:
    let entity = entities[index]
    if entity.id < slots.length:
      slots[entity.id] := index + 1
  let dead = @array.fill count #False
  for 0..count:
    let changed = #False
    for index in 0..count:
      let entity = entities[index]
      let parent_dead = if entity.parent != 0 && entity.parent < slots.length && slots[entity.parent] != 0 then dead[slots[entity.parent] - 1] else #False
      if Bool.not dead[index] && (entity.id == id || parent_dead):
        dead[index] := #True
        changed := #True
    if Bool.not changed:
      break
  let kept: List Entity = []
  for index in 0..count:
    if Bool.not dead[index]:
      kept := [...self, entities[index]]
  world.entities := Array.from_list kept
  return world

const children = fn (id: U32) => fn (world: World) =>
  array.filter (fn (entity: Entity) => entity.parent == id) world.entities


// Physics glue (generated from the standard collider, body, character and
// brush components): see packages/schema/physics.ts and ink/physics.

const phys_shape = fn (kind: ColliderShape) => case kind of
  #Box => #phys_scene.Box
  #Sphere => #phys_scene.Sphere
  #Capsule => #phys_scene.Capsule
  #Hull => #phys_scene.Brush

const phys_kind = fn (kind: BodyKind) => case kind of
  #Dynamic => #phys_scene.Dynamic
  #Kinematic => #phys_scene.Kinematic
  #Static => #phys_scene.Static

// An entity's pose in world space, through its parents.
const phys_pose = fn (world: World) => fn (e: Entity) => do:
  let #Some t = e.transform else:
    return (#Vec3 { x: 0.0, y: 0.0, z: 0.0 }, #Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }, #Vec3 { x: 1.0, y: 1.0, z: 1.0 })
  let position = t.position
  let rotation = t.rotation
  let scale = t.scale
  let parent = e.parent
  for 0..8:
    if parent != 0:
      if let #Some p = find parent world:
        if let #Some pt = p.transform:
          position := pt.position + phys_scene.rotate pt.rotation (phys_scene.scale_by position pt.scale)
          rotation := phys_scene.compose pt.rotation self
          scale := phys_scene.scale_by self pt.scale
        parent := p.parent
      else:
        parent := 0
  return (position, rotation, scale)

// The entities physics cares about, as the library sees them.
const phys_sources = fn (world: World) => do:
  let found: List phys_scene.Source = []
  let entities = world.entities
  for index in 0..entities.length:
    let e = entities[index]
    let collider = case e.collider of
      #Some c => #Some (#phys_scene.Collider {
        shape: phys_shape c.shape,
        size: c.size,
        radius: c.radius,
        height: c.height,
        offset: c.offset,
        friction: c.friction,
        restitution: c.restitution,
        layer: c.layer,
        mask: c.mask,
        trigger: c.trigger,
      })
      #Nothing => #Nothing
    let rigid = case e.body of
      #Some b => #Some (#phys_scene.Rigid {
        kind: phys_kind b.kind,
        mass: b.mass,
        gravity_scale: b.gravity_scale,
        linear_damping: b.linear_damping,
        angular_damping: b.angular_damping,
        can_sleep: b.can_sleep,
        continuous: b.continuous,
        linear_velocity: b.linear_velocity,
        angular_velocity: b.angular_velocity,
        sleeping: b.sleeping,
        sleep_time: b.sleep_time,
      })
      #Nothing => #Nothing
    let walker = case e.character of
      #Some c => #Some (#phys_scene.Walker {
        max_slope: c.max_slope,
        step_height: c.step_height,
        snap_distance: c.snap_distance,
        push: c.push,
        velocity: c.velocity,
        grounded: c.grounded,
        ground: c.ground,
        ground_normal: c.ground_normal,
      })
      #Nothing => #Nothing
    let planes = case e.brush of
      #Some brush => array.map (fn (f: Face) => f.plane) brush.faces
      #Nothing => #[]
    let relevant = case collider of
      #Some _ => #True
      #Nothing => case rigid of
        #Some _ => #True
        #Nothing => case walker of
          #Some _ => #True
          #Nothing => Bool.not planes.is_empty
    if relevant:
      let (position, rotation, scale) = phys_pose world e
      found := [...self, #phys_scene.Source { index, id: e.id, position, rotation, scale, collider, rigid, walker, planes }]
  return Array.from_list found

// Write what a step changed back into the entities.
const phys_apply = fn (sources: Array phys_scene.Source) => fn (results: Array phys.Result) => fn (world: World) => do:
  let old = world.entities
  let entities = @array.generate old.length (fn (i: U32) => old[i])
  for r in results:
    let index = sources[r.source].index
    let e = entities[index]
    if e.parent == 0:
      if let #Some t = e.transform:
        t.position := r.position
        t.rotation := r.rotation
        e.transform := #Some t
    if let #Some state = r.rigid:
      if let #Some b = e.body:
        b.linear_velocity := state.linear_velocity
        b.angular_velocity := state.angular_velocity
        b.sleeping := state.sleeping
        b.sleep_time := state.sleep_time
        e.body := #Some b
    if let #Some state = r.walker:
      if let #Some c = e.character:
        c.velocity := state.velocity
        c.grounded := state.grounded
        c.ground := state.ground
        c.ground_normal := state.ground_normal
        e.character := #Some c
    entities[index] := e
  world.entities := entities
  return world

// Move the characters and simulate the rigid bodies by `dt`.
const physics_step = fn (dt: F32) => fn (world: World) => do:
  let sources = phys_sources world
  // Nothing awake and nothing moving: the step changes nothing.
  if phys.at_rest sources:
    return world
  let sc = phys_scene.build sources
  let p = world.resources.physics
  let config = #phys.Config { gravity: p.gravity, substeps: p.substeps, sleep_time: p.sleep_time, linear_sleep: p.linear_sleep, angular_sleep: p.angular_sleep }
  let (results, contacts) = phys.simulate config dt sources sc p.contacts
  world := phys_apply sources results self
  world.resources.physics.contacts := contacts
  return world

// The world's colliders, for ray, shape-cast and overlap queries.
const physics_scene = fn (world: World) => phys_scene.build (phys_sources world)

