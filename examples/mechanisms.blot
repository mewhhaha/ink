// A sensor dashboard: no ECS, host, game vocabulary or assets required.
import * as field from "ink/field"
import * as history from "ink/history"
import * as statistics from "ink/statistics"
import * as anchor from "ink/ui/anchor"
import * as outline from "ink/ui/outline"
import * as console from "ink/ui/console"
import * as locale from "ink/locale"
import * as ui from "ink/ui"
import * as math from "ink/math"

entry func dashboard (unused: U32) : Array F32 => return do:
  let grid = field.grid 32 16 8 8
  let changed = field.affected grid #[{left:7,top:7,right:9,bottom:9}]
  let readings: history.Buffer (history.Sample U32) = history.empty ()
  let reading_meta = history.metadata 16
  let (readings, reading_meta) = history.sample 0.0 100 readings reading_meta
  let (readings, reading_meta) = history.sample 2.0 110 readings reading_meta
  let first = history.get readings reading_meta 0
  let last = history.get readings reading_meta 1
  let $Some rate = statistics.counter_rates (last.at-first.at) #[first.value] #[last.value] else:
    return #[]
  let bounds = $ui.Rect {x:0.0,y:0.0,width:800.0,height:600.0}
  let panel = anchor.fit bounds (anchor.attach $anchor.Below 0.5 8.0 (math.vec2 200.0 100.0) (math.vec2 400.0 40.0))
  let border = outline.rounded panel 8.0
  let cursor = outline.point border 20.0
  let name = #[114,101,115,101,116]
  let empty_text: Array U32 = #[]
  let options: Array console.Choice = #[]
  let catalog = #[$console.Entry {name:name.view 0 name.length,about:empty_text.view 0 0,options:options.view 0 0,argument:false}]
  let suggestions: ResizeArray console.Suggestion = #[]
  let suggestion_text: ResizeArray U32 = #[]
  console.named #[] #[32] (catalog.view 0 catalog.length) #[114] suggestion_text suggestions
  let words = locale.empty ()
  let word_text: ResizeArray U32 = #[]
  let direction = #[false]
  locale.grow 1 words
  let words = locale.begin 0 1 words
  let drawn = #[176,67]
  let spoken = #[67]
  let (words, word_text, direction) = locale.resolve 0 1 ($Some $locale.Text {drawn:drawn.view 0 drawn.length,spoken:spoken.view 0 spoken.length}) false words word_text direction
  let reading_meta = history.expire 1.0 readings reading_meta
  return #[rate[0], U32.to_f32 reading_meta[2], panel.x, panel.y,
    cursor.x,cursor.y,U32.to_f32 suggestions.length,U32.to_f32 (locale.word words word_text 0 (empty_text.view 0 0)).length,
    if changed[0] and changed[1] and changed[4] and changed[5] then 1.0 else 0.0]
