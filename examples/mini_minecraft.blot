// 1:1 Mini Minecraft voxel world in Blot for Pen (native + WebGPU),
// matching Goose's `30_mini_minecraft.goose`:
// 80 x 40 x 80 deterministic world (hills, lake, ridge, walk-in cave tunnel,
// coal veins, oak trees), 1/120 s walking/swimming/ledge-sneak physics,
// 3D DDA mining & placement, 8-slot hotbar, 4 crafting recipes (+ Shift craft-all),
// 16 warm lamps, 48 mining debris chips, 10-minute day/night cycle, F5/F9 saves,
// and 5x7 pixel-font HUD.
import { Vec2, Vec3 } from "std/vector"
import * as color from "ink/color"
import * as events from "ink/events"
import * as keys from "ink/input/keys"
import * as math from "ink/math"
import * as pen_events from "ink/pen/events"
import * as host_frame from "ink/pen/host"
import * as program from "ink/pen/program"
import * as persist from "ink/persist"
import * as preferences from "ink/preferences"
import * as render from "ink/render"
import * as services from "ink/services"
import * as sound from "ink/sound"
import * as tree from "ink/ui/tree"
import * as protocol from "pen/protocol"

// Catalog indices generated by `minecraft_assets.rs`
private const mesh_screen_quad: U32 = 0
private const mesh_chip_quad: U32 = 1
private const mat_world: U32 = 0
private const mat_chip: U32 = 1
private const mat_hud: U32 = 2
private const schema: U32 = 2

// World constants (exact match to 30_mini_minecraft.goose)
private const world_w: U32 = 80
private const world_h: U32 = 40
private const world_d: U32 = 80
private const world_vol: U32 = 256000
private const field_w: U32 = 640
private const field_h: U32 = 410
private const sea_level: U32 = 12
private const slot_count: U32 = 8
private const max_lamps: U32 = 16
private const max_debris: U32 = 48
private const day_length: F32 = 600.0
private const default_seed: U32 = 2026

// Block IDs
private const blk_air: U32 = 0
private const blk_grass: U32 = 1
private const blk_dirt: U32 = 2
private const blk_stone: U32 = 3
private const blk_sand: U32 = 4
private const blk_wood: U32 = 5
private const blk_leaves: U32 = 6
private const blk_planks: U32 = 7
private const blk_cobble: U32 = 8
private const blk_coal: U32 = 9
private const blk_water: U32 = 10
private const blk_bedrock: U32 = 11
private const blk_lamp: U32 = 12

// Player physics constants
private const player_radius: F32 = 0.29
private const body_height: F32 = 1.8
private const eye_height: F32 = 1.62
private const fixed_step: F32 = 1.0 / 120.0
private const fov_rad: F32 = 1.15

// Keycodes not listed in ink/input/keys
private const key_f5: U32 = 0x110205
private const key_1: U32 = 49
private const key_8: U32 = 56

// Held-key bitmask flags
private const kh_w: U32 = 1
private const kh_s: U32 = 2
private const kh_a: U32 = 4
private const kh_d: U32 = 8
private const kh_space: U32 = 16
private const kh_shift: U32 = 32
private const kh_ctrl: U32 = 64
private const kh_left: U32 = 128
private const kh_right: U32 = 256
private const kh_up: U32 = 512
private const kh_down: U32 = 1024
private const kh_e: U32 = 2048

// HUD palette (exact sRGB values from 30_mini_minecraft.goose)
private const col_ink = math.vec4 (235.0 / 255.0) (237.0 / 255.0) (223.0 / 255.0) 1.0
private const col_muted = math.vec4 (166.0 / 255.0) (183.0 / 255.0) (181.0 / 255.0) 1.0
private const col_gold = math.vec4 (250.0 / 255.0) (209.0 / 255.0) (116.0 / 255.0) 1.0
private const col_panel = math.vec4 (22.0 / 255.0) (34.0 / 255.0) (40.0 / 255.0) (225.0 / 255.0)
private const col_row = math.vec4 (42.0 / 255.0) (57.0 / 255.0) (60.0 / 255.0) (250.0 / 255.0)
private const col_white = math.vec4 1.0 1.0 1.0 1.0

// Message IDs (status toasts)
private const msg_none: U32 = 0
