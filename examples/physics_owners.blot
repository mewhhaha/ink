import * as physics from "ink/physics"
import * as scene from "ink/scene"
import * as spatial from "ink/spatial"
import * as shapes from "ink/shapes"
import * as math from "ink/math"

// The callback encloses the complete sequence of ticks. Only a final
// numeric packet/scalar leaves the known consumer, never owner-bearing state.
func with_step (sources: Array scene.Source) -> (contacts: Array physics.CachedContact) -> consume => return do:
  let points: ResizeArray shapes.Point3 = #[]
  let planes: ResizeArray shapes.Plane4 = #[]
  let rings: ResizeArray shapes.Ring = #[]
  let indices: ResizeArray U32 = #[]
  let heights: ResizeArray F32 = #[]
  let source_planes: ResizeArray math.Vec4 = #[]
  let geometry = $shapes.Geometry {points, planes, rings, indices, heights, source_planes}
  let rows: ResizeArray scene.SourceRow = #[]
  let selector: Array U32 = #[0]
  let first: ResizeArray physics.CachedContact = #[]
  let second: ResizeArray physics.CachedContact = #[]
  let results: ResizeArray physics.Result = #[]
  let access = $physics.StepAccess {sources: rows, geometry,
    cache: $physics.CacheAccess {selector, first, second}, results}
  physics.load_sources_into sources access
  physics.seed_cache_into (&contacts[0..contacts.length]) access.cache
  return consume access

// A separately owned scene can retain/refit its caches across those ticks.
func with_scene (sources: Array scene.Source) -> consume => return do:
  let points: ResizeArray shapes.Point3 = #[]
  let planes: ResizeArray shapes.Plane4 = #[]
  let rings: ResizeArray shapes.Ring = #[]
  let indices: ResizeArray U32 = #[]
  let heights: ResizeArray F32 = #[]
  let source_planes: ResizeArray math.Vec4 = #[]
  let geometry = $shapes.Geometry {points, planes, rings, indices, heights, source_planes}
  let proxies: ResizeArray scene.ProxyRow = #[]
  let bounds: ResizeArray F32 = #[]
  let order: ResizeArray U32 = #[]
  let leaves: ResizeArray U32 = #[]
  let slots: ResizeArray U32 = #[]
  let metadata: Array U32 = #[0,0]
  let destination = scene.access geometry proxies bounds order leaves slots metadata
  let world = scene.build_into metadata destination sources
  return consume world

func with_geometry consume => return do:
  let points: ResizeArray shapes.Point3 = #[]
  let planes: ResizeArray shapes.Plane4 = #[]
  let rings: ResizeArray shapes.Ring = #[]
  let indices: ResizeArray U32 = #[]
  let heights: ResizeArray F32 = #[]
  let source_planes: ResizeArray math.Vec4 = #[]
  return consume ($shapes.Geometry {points, planes, rings, indices, heights, source_planes})

func with_index items -> consume => return do:
  let bounds: ResizeArray F32 = #[]
  let order: ResizeArray U32 = #[]
  let leaves: ResizeArray U32 = #[]
  let destination = spatial.access 0 bounds order leaves
  let index = spatial.build_into destination items
  return consume index
