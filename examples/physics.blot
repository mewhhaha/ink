import * as owned from "./physics_owners"
import * as math from "ink/math"
import * as physics from "ink/physics"
import * as scene from "ink/physics/scene"

entry func fall (height: F32) : #[F32] =>
  let body = scene.dynamic (scene.box 1 (math.vec3 0.0 height 0.0) math.one3)
  return owned.with_step #[body] #[] (func (own step) =>
    step := physics.step_into physics.default_config (1.0 / 60.0) step
    return #[(physics.source step 0).position.y])
