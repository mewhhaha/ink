import * as math from "ink/math"
import * as physics from "ink/physics"
import * as scene from "ink/scene"

entry const fall = func (height: F32) : Array F32 => return do:
  let body = scene.dynamic (scene.box 1 (math.vec3 0.0 height 0.0) math.one3)
  let (sources, cache) = physics.step physics.default_config (1.0 / 60.0) #[body] physics.empty_cache
  return #[sources[0].position.y]
