open {} = (@import "blot:prelude") ();

const FIXED = 1000000;
const TURN = 65536;

const clamp = fn (value, minimum, maximum) =>
  if value < minimum then minimum
  else if value > maximum then maximum
  else value
  end;

const absolute = fn value => if value < 0 then -value else value end;

const fixed_mul = fn (left, right) => left * right / FIXED;
const fixed_div = fn (left, right) => left * FIXED / right;

return {
  .fixed = FIXED;
  .turn = TURN;
  .clamp = clamp;
  .absolute = absolute;
  .fixed_mul = fixed_mul;
  .fixed_div = fixed_div;
};
