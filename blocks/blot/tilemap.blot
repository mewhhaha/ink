open {} = (@import "blot:prelude") ();

const tile_index = fn (column, row, columns) => row * columns + column;
const tile_column = fn (index, columns) => @int.rem index columns;
const tile_row = fn (index, columns) => index / columns;
const world_coordinate = fn (cell, tile_size) => cell * tile_size;

return {
  .tile_index = tile_index;
  .tile_column = tile_column;
  .tile_row = tile_row;
  .world_coordinate = world_coordinate;
};
