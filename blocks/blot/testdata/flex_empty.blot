open {} = (@import "blot:prelude") ();

const Flex = (@import "../flex.blot") ();

let container = {
  .left = 0;
  .top = 0;
  .width = 100;
  .height = 100;
  .direction = Flex.column;
  .justify = Flex.space_evenly;
  .align = Flex.stretch;
  .gap = 10;
  .padding_left = 5;
  .padding_right = 5;
  .padding_top = 5;
  .padding_bottom = 5;
};

return Flex.layout (container, []);
