open {} = (@import "blot:prelude") ();

const Flex = (@import "../flex.blot") ();

let container = {
  .left = 5;
  .top = 10;
  .width = 40;
  .height = 100;
  .direction = Flex.column;
  .justify = Flex.end;
  .align = Flex.start;
  .gap = 10;
  .padding_left = 0;
  .padding_right = 0;
  .padding_top = 0;
  .padding_bottom = 0;
};
let based = {
  .width = 10;
  .height = 20;
  .flex_basis = 30;
  .flex_grow = 0;
  .flex_shrink = 0;
  .align_self = Flex.auto;
  .margin_left = 0;
  .margin_right = 0;
  .margin_top = 0;
  .margin_bottom = 0;
};
let sized = {
  .width = 10;
  .height = 20;
  .flex_basis = Flex.auto_size;
  .flex_grow = 0;
  .flex_shrink = 0;
  .align_self = Flex.auto;
  .margin_left = 0;
  .margin_right = 0;
  .margin_top = 0;
  .margin_bottom = 0;
};

return Flex.layout (container, [based, sized]);
