open {} = (@import "blot:prelude") ();

const Flex = (@import "../flex.blot") ();

let container = {
  .left = 5;
  .top = 7;
  .width = 100;
  .height = 30;
  .direction = Flex.row_reverse;
  .justify = Flex.space_between;
  .align = Flex.start;
  .gap = 5;
  .padding_left = 10;
  .padding_right = 20;
  .padding_top = 0;
  .padding_bottom = 0;
};
let child = {
  .width = 10;
  .height = 10;
  .flex_basis = Flex.auto_size;
  .flex_grow = 0;
  .flex_shrink = 0;
  .align_self = Flex.auto;
  .margin_left = 0;
  .margin_right = 0;
  .margin_top = 0;
  .margin_bottom = 0;
};

return Flex.layout (container, [child, child]);
