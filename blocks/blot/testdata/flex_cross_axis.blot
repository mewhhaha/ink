open {} = (@import "blot:prelude") ();

const Flex = (@import "../flex.blot") ();

let container = {
  .left = 10;
  .top = 20;
  .width = 100;
  .height = 60;
  .direction = Flex.row;
  .justify = Flex.start;
  .align = Flex.centre;
  .gap = 0;
  .padding_left = 0;
  .padding_right = 0;
  .padding_top = 10;
  .padding_bottom = 5;
};
let centred = {
  .width = 20;
  .height = 10;
  .flex_basis = Flex.auto_size;
  .flex_grow = 0;
  .flex_shrink = 1;
  .align_self = Flex.auto;
  .margin_left = 0;
  .margin_right = 0;
  .margin_top = 2;
  .margin_bottom = 3;
};
let stretched = {
  .width = 20;
  .height = Flex.auto_size;
  .flex_basis = Flex.auto_size;
  .flex_grow = 0;
  .flex_shrink = 1;
  .align_self = Flex.stretch;
  .margin_left = 0;
  .margin_right = 0;
  .margin_top = 2;
  .margin_bottom = 3;
};
let ended = {
  .width = 20;
  .height = 10;
  .flex_basis = Flex.auto_size;
  .flex_grow = 0;
  .flex_shrink = 1;
  .align_self = Flex.end;
  .margin_left = 0;
  .margin_right = 0;
  .margin_top = 2;
  .margin_bottom = 3;
};

return Flex.layout (container, [centred, stretched, ended]);
