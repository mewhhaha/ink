open {} = (@import "blot:prelude") ();

const Flex = (@import "../flex.blot") ();

let container = {
  .left = 10;
  .top = 20;
  .width = 110;
  .height = 40;
  .direction = Flex.row;
  .justify = Flex.start;
  .align = Flex.start;
  .gap = 10;
  .padding_left = 0;
  .padding_right = 0;
  .padding_top = 0;
  .padding_bottom = 0;
};
let first = {
  .width = 20;
  .height = 10;
  .flex_basis = Flex.auto_size;
  .flex_grow = 1;
  .flex_shrink = 1;
  .align_self = Flex.auto;
  .margin_left = 0;
  .margin_right = 0;
  .margin_top = 0;
  .margin_bottom = 0;
};
let second = {
  .width = 20;
  .height = 10;
  .flex_basis = Flex.auto_size;
  .flex_grow = 3;
  .flex_shrink = 1;
  .align_self = Flex.auto;
  .margin_left = 0;
  .margin_right = 0;
  .margin_top = 0;
  .margin_bottom = 0;
};

return Flex.layout (container, [first, second]);
