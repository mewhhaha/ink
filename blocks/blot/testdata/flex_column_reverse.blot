open {} = (@import "blot:prelude") ();

const Flex = (@import "../flex.blot") ();

let container = {
  .left = 10;
  .top = 20;
  .width = 60;
  .height = 100;
  .direction = Flex.column_reverse;
  .justify = Flex.centre;
  .align = Flex.end;
  .gap = 5;
  .padding_left = 10;
  .padding_right = 10;
  .padding_top = 5;
  .padding_bottom = 15;
};
let child = {
  .width = 10;
  .height = 20;
  .flex_basis = Flex.auto_size;
  .flex_grow = 0;
  .flex_shrink = 0;
  .align_self = Flex.auto;
  .margin_left = 0;
  .margin_right = 0;
  .margin_top = 0;
  .margin_bottom = 0;
};

return Flex.layout (container, [child, child]);
