open {} = (@import "blot:prelude") ();

const G = (@import "../../blocks/blot/geometry.blot") ();

const Semantic = @effect.host {
  .region = {
    .description = Str;
    .height = Int;
    .id = Str;
    .label = Str;
    .left = Int;
    .order = Int;
    .pressed = Bool;
    .selected = Bool;
    .top = Int;
    .width = Int;
  } -> Unit;
  .status = { .done = Bool; .label = Str; .value = Str; } -> Unit;
};

const Render = @effect.host {
  .projection = Int -> Unit;
  .beacon = {
    .id = Int;
    .lit = Bool;
    .selected = Bool;
    .x = Int;
    .y = Int;
    .z = Int;
  } -> Unit;
};

const lit_mask = fn state => @int.rem state 8;
const selected_code = fn state => @int.rem (state / 8) 4;
const projection = fn state => @int.rem (state / 32) 2;

const is_lit = fn (mask, id) =>
  if id == 0 then @int.rem mask 2 == 1
  else if id == 1 then @int.rem (mask / 2) 2 == 1
  else @int.rem (mask / 4) 2 == 1
  end;

const beacon_bit = fn id => if id == 0 then 1 else if id == 1 then 2 else 4 end;

const toggle_lit = fn (mask, id) =>
  if is_lit (mask, id) then mask - beacon_bit id else mask + beacon_bit id end;

const rebuild = fn (mask, selected, lens) => mask + selected * 8 + lens * 32;

sig init = Int -> Int;
let init = fn previous => if previous < 0 then 0 else previous end;

sig step = Int -> Int -> Int -> Int -> Int -> Int;
let step = fn state => fn action_kind => fn target => fn _value => fn _delta_us => do
  let mask = lit_mask state;
  let selected = selected_code state;
  let lens = projection state;
  in if action_kind == 1
    then rebuild (mask, target + 1, lens)
    else if action_kind == 2
      then rebuild (toggle_lit (mask, target), target + 1, lens)
      else if action_kind == 3
        then rebuild (mask, selected, if lens == 0 then 1 else 0 end)
        else state
      end
end;

const beacon_label = fn id =>
  if id == 0 then "Amber beacon"
  else if id == 1 then "Cyan beacon"
  else "Violet beacon"
  end;

const beacon_description = fn (id, lit) => do
  let position = if id == 0 then "left and near"
    else if id == 1 then "centre and far"
    else "right and middle distance"
    end;
  let state = if lit then "lit" else "unlit" end;
  in Text.append (Text.append position ", ") state
end;

const beacon_x = fn id =>
  if id == 0 then -1800000 else if id == 1 then 0 else 1800000 end;
const beacon_y = fn id => if id == 1 then 700000 else 0 end;
const beacon_z = fn id => if id == 0 then 1000000 else if id == 1 then -1200000 else 0 end;

let emit_region = fn (state, id, width, height) => do
  let mask = lit_mask state;
  let lens = projection state;
  let lit = is_lit (mask, id);
  let bounds = G.bounds (
    beacon_x id,
    beacon_y id,
    beacon_z id,
    1600000,
    lens,
    width,
    height
  );
  in Semantic.region {
    .description = beacon_description (id, lit);
    .height = bounds.height;
    .id = Text.append "beacon-" (@text.of_int id);
    .label = beacon_label id;
    .left = bounds.left;
    .order = id;
    .pressed = lit;
    .selected = selected_code state == id + 1;
    .top = bounds.top;
    .width = bounds.width;
  }
end;

let observe = fn state => fn width => fn height => do
  let _a = emit_region (state, 0, width, height);
  let _b = emit_region (state, 1, width, height);
  let _c = emit_region (state, 2, width, height);
  let mask = lit_mask state;
  let count =
    (if is_lit (mask, 0) then 1 else 0 end) +
    (if is_lit (mask, 1) then 1 else 0 end) +
    (if is_lit (mask, 2) then 1 else 0 end);
  let _status = Semantic.status {
    .done = count == 3;
    .label = "Beacon progress";
    .value = Text.append (@text.of_int count) " of 3 beacons lit";
  };
  in count
end;

sig prepare_render = Unit -> Unit;
let prepare_render = fn _ => ();

let emit_beacon = fn (state, id) => Render.beacon {
  .id = id;
  .lit = is_lit (lit_mask state, id);
  .selected = selected_code state == id + 1;
  .x = beacon_x id;
  .y = beacon_y id;
  .z = beacon_z id;
};

let render = fn state => fn _width => fn _height => do
  let _viewport = _width + _height;
  let _projection = Render.projection (projection state);
  let _a = emit_beacon (state, 0);
  let _b = emit_beacon (state, 1);
  let _c = emit_beacon (state, 2);
  in ()
end;

return {
  .init = init;
  .step = step;
  .observe = observe;
  .prepare_render = prepare_render;
  .render = render;
};
