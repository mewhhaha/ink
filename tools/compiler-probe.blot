import * as array from "std/array"
import * as navigation from "ink/navigation"
import * as sort from "ink/sort"

// Bounded paired probes: identical outputs, deliberately different reuse shape.
entry func inline_writes (count: U32) : Array F32 => return do:
  let values = @array.fill count 0.0
  for i in 0..count:
    values[i] := U32.to_f32 i
  let checksum = 0.0
  for value in values:
    checksum := self + value
  return #[values[count - 1], checksum]

entry func break_writes (count: U32) : Array F32 => return do:
  let values = @array.fill count 0.0
  for i in 0..count:
    if i == count:
      break
    values[i] := U32.to_f32 i
  let checksum = 0.0
  for value in values:
    checksum := self + value
  return #[values[count - 1], checksum]

entry func pathfinding (count: U32) : Array F32 => return do:
  let costs = @array.fill count 1.0
  let $Some grid = navigation.grid count 1 (costs.view 0 costs.length) else:
    return #[]
  let cells: ResizeArray U32 = #[]
  let $Some path = navigation.astar_into cells grid 0 (count - 1) count else:
    return #[]
  return #[path.cost, U32.to_f32 path.cells.length, U32.to_f32 path.expanded]

entry func unsigned_sort (count: U32) : Array U32 => return do:
  let keys = @array.generate count (func (i: U32) => return count - i)
  let result = sort.order_u32 keys
  let checksum = 0
  for i in 0..count:
    checksum := self + (i + 1) * result[i]
  return #[result[0], result[count - 1], result.length, checksum]
