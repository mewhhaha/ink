// All entries return small witnesses. Work stays in the guest; host checks and
// source compilation are excluded from the measured call.
func pose (x: F32) => $transform.Pose3 { position: math.vec3 x 2.0 3.0, rotation: math.yaw_pitch (x * 0.01) 0.2, scale: math.vec3 1.0 2.0 3.0 }
let floor = do:
  let sources = #[scene.box 1 (math.vec3 0.0 (-0.5) 0.0) (math.vec3 2000.0 1.0 2000.0)]
  break scene.build_into (scene.empty ()) sources

entry func math_batch (count: U32) : #[F32] =>
  let sum = 0.0
  let error = 0.0
  for i in 0..count:
    let x = U32.to_f32 (i % 1024) * 0.001
    let q = math.axis_angle (math.vec3 1.0 2.0 3.0) x
    let p = math.Quat.rotate q math.forward
    let r = math.look_rotation p math.up
    error := max self (abs (math.Quat.dot r r - 1.0))
    let a = math.vec4 x 2.0 3.0 4.0
    let b = math.Vec4.mul (math.Vec4.sub (math.Vec4.add a a) a) 0.5
    let ray = $math.Ray { origin: math.zero3, direction: math.forward }
    let distance = case math.Ray.plane ray math.forward (math.vec3 0.0 0.0 (-2.0)) of
      $Some value => value
      $Nothing => (-1000.0)
    sum := self + math.Vec4.dot a b + distance + math.approach 1.0 0.1 x + (math.flat p).x + (math.Quat.forward q).z + (math.Quat.right q).x + (math.Quat.up q).y
  return #[U32.to_f32 count, sum, error]

entry func arrays_batch (count: U32) : #[F32] =>
  let values = @array.generate count U32.to_f32
  let ids = @array.generate count (func (i: U32) => 4294967295 - i)
  let copied = arrays.copy values
  let copied_ids = arrays.copy_u32 ids
  copied[0] := (-1.0)
  copied_ids[0] := 0
  let sum = 0.0
  for i in 0..count:
    sum := self + copied[i]
  return #[U32.to_f32 count, sum, values[0], U32.to_f32 ids[0]]

entry func random_batch (count: U32) : #[U32] =>
  let seed = 123
  let bad = 0
  for i in 0..count:
    seed := random.next self
    let unit = random.unit seed
    if unit < 0.0 or unit >= 1.0:
      bad := self + 1
  return #[count, seed, bad]

entry func noise_batch (count: U32) : #[F32] =>
  let sum = 0.0
  let largest = 0.0
  for i in 0..count:
    let x = U32.to_f32 (i % 1000) * 0.017 - 8.0
    let p = math.vec3 x (x * 0.3) (x * 0.7)
    let v = noise.fbm3 123 6 p
    largest := max self (abs v)
    sum := self + v + noise.fbm2 123 3 (math.vec2 x x) + noise.perlin1 123 x + noise.perlin2 123 (math.vec2 x x) + noise.perlin3 123 p + noise.value2 123 (math.vec2 x x) + noise.at 123 i (i + 1)
  return #[U32.to_f32 count, sum, largest]

entry func time_batch (count: U32) : #[F32] =>
  let remainder = 0.0
  let ticks = 0
  let $Some initial = time.timer 1.0 else:
    return #[]
  let timer = initial
  let expired = 0
  for i in 0..count:
    let $Some step = time.fixed 0.125 4 remainder 0.03125 else:
      return #[]
    remainder := step.remainder
    ticks := self + step.steps
    let $Some tick = time.tick timer 0.03125 else:
      return #[]
    timer := tick.timer
    if tick.expired:
      expired := self + 1
  let done = 0.0
  if time.done timer:
    done := 1.0
  return #[U32.to_f32 count, U32.to_f32 ticks, remainder, U32.to_f32 expired, done]

entry func transform_batch (count: U32) : #[F32] =>
  let error = 0.0
  let sum = 0.0
  for i in 0..count:
    let x = U32.to_f32 (i % 100) * 0.01
    let a = transform.affine3 (pose x)
    let b = transform.affine3 (transform.lerp3 (pose x) (pose (x + 1.0)) 0.3)
    let c = transform.compose3 a b
    let $Some inverse = transform.inverse3 c else:
      return #[]
    let p = transform.point3 c math.one3
    error := max self ((transform.point3 inverse p - math.one3).length)
    let a2 = $transform.Pose2 { position: math.vec2 x 2.0, angle: x, scale: math.vec2 2.0 3.0 }
    let c2 = transform.compose2 (transform.affine2 a2) (transform.affine2 (transform.lerp2 a2 a2 0.5))
    let $Some inverse2 = transform.inverse2 c2 else:
      return #[]
    let p2 = math.vec2 1.0 2.0
    error := max self ((transform.point2 inverse2 (transform.point2 c2 p2) - p2).length)
    sum := self + p.x + (transform.vector3 c math.up).y + (transform.vector2 c2 p2).x
  return #[U32.to_f32 count, sum, error]

entry func color_batch (count: U32) : #[F32] =>
  let sum = 0.0
  let error = 0.0
  for i in 0..count:
    let x = U32.to_f32 (i % 1000) * 0.001
    let c = math.rgba x (x * 0.5) (x * 0.25) 0.3
    let encoded = color.srgb (color.linear c)
    error := max self (abs (encoded.r - c.r))
    let shown = color.display 2.0 (math.Color.mul c 16.0)
    sum := self + color.luminance shown + color.power (x + 0.01) 2.4 + color.exp2 (x * 20.0 - 10.0)
    let $Some logarithm = color.logarithm (x + 0.01) else:
      return #[]
    sum := self + logarithm
  return #[U32.to_f32 count, sum, error]

entry func lighting_batch (count: U32) : #[F32] =>
  let sum = 0.0
  let smallest = 1000000000.0
  for i in 0..count:
    let p = math.vec3 (U32.to_f32 (i % 100) * 0.02) 0.0 0.0
    let lights = #[$lighting.Directional { direction: math.up * (-1.0), radiance: math.rgb 1.0 2.0 3.0 }, $lighting.Point { position: math.vec3 0.0 3.0 0.0, intensity: math.rgb 10.0 20.0 30.0, range: 10.0 }, $lighting.Spot { position: math.vec3 0.0 3.0 0.0, direction: math.up * (-1.0), intensity: math.rgb 10.0 20.0 30.0, range: 10.0, inner_cos: 0.9, outer_cos: 0.6 }]
    for light in lights:
      let c = lighting.shade lighting.default_material math.up math.up (lighting.sample light p)
      sum := self + c.r + c.g + c.b
      smallest := min self (min c.r (min c.g c.b))
  return #[U32.to_f32 count, sum, smallest]

entry func environment_batch (count: U32) : #[F32] =>
  let directions = #[math.up, math.up * (-1.0), math.right, math.right * (-1.0), math.forward, math.forward * (-1.0)]
  let samples = @array.generate count (func (i: U32) => $environment.Sample { direction: directions[i % 6], radiance: math.rgb 1.0 1.0 1.0, solid_angle: 12.5663706144 / U32.to_f32 count })
  let irradiance = environment.integrate samples
  let sum = 0.0
  let error = 0.0
  for direction in directions:
    let value = environment.evaluate irradiance direction
    error := max self (abs (value.r - 3.1415926536))
    let sky = environment.sky environment.default_sky direction
    sum := self + value.r + sky.r + sky.g + sky.b
  return #[U32.to_f32 count, sum, error]

// Cascades fitted to a camera that sways about, with the first slice's corners
// projected through its window as the host would: `error` is the greatest
// amount any lies outside it, and `sum` collects the cascades' texels.
entry func shadow_batch (count: U32) : #[F32] =>
  let sum = 0.0
  let error = 0.0
  let splits = shadow.splits 0.1 100.0 4 0.5
  let projection = math.Mat4.perspective 1.7320508 1.5 0.1 100.0
  for i in 0..count:
    let eye = math.vec3 (U32.to_f32 (i % 100) * 0.01) 1.0 0.0
    let rotation = math.yaw_pitch (U32.to_f32 (i % 7) * 0.1) (-0.2)
    let $Some fitted = shadow.fit (math.Mat4.view eye rotation) projection (math.vec3 1.0 (-2.0) 1.0) 3 1024 80.0 0.75 else:
      return #[]
    let window = fitted.cascades[0]
    for k in 0..8:
      let depth = if k < 4 then 0.1 else window.far
      let x = depth / 1.7320508 * 1.5
      let y = depth / 1.7320508
      let p = eye + math.Quat.rotate rotation (math.vec3 (if (k & 1) == 0 then -x else x) (if (k & 2) == 0 then -y else y) (-depth))
      let v = fitted.view
      let vx = v.xx * p.x + v.yx * p.y + v.zx * p.z + v.wx
      let vy = v.xy * p.x + v.yy * p.y + v.zy * p.z + v.wy
      let vz = v.xz * p.x + v.yz * p.y + v.zz * p.z + v.wz
      let w = window.projection
      let nx = w.xx * vx + w.wx
      let ny = w.yy * vy + w.wy
      let nz = w.zz * vz + w.wz
      error := max self (max 0.0 (max (abs nx - 1.0) (abs ny - 1.0)))
      error := max self (max 0.0 (max (0.0 - nz) (nz - 1.0)))
      sum := self + nz
    sum := self + window.texel
  return #[U32.to_f32 count, sum, error, splits[3]]

entry func motion_batch (count: U32) : #[F32] =>
  let sum = 0.0
  let seed = 123
  for i in 0..count:
    let x = U32.to_f32 (i % 100) * 0.01
    let $Some spring = motion.checked_spring ($motion.Spring { value: x, velocity: 1.0 }) 1.0 12.0 (x * 2.0) 0.016 else:
      return #[]
    let (kicked, next_seed) = motion.seeded_kick motion.empty_impulse seed 1.0
    seed := next_seed
    let impulse = motion.settle kicked 12.0 0.7 0.016
    let position = motion.bezier math.zero3 math.right math.up math.one3 x
    let tangent = motion.tangent math.zero3 math.right math.up math.one3 x
    sum := self + spring.value + impulse.translation.value.x + position.x + tangent.y + motion.smooth x + motion.smoother x + motion.cubic_in x + motion.cubic_out x
  return #[U32.to_f32 count, sum, U32.to_f32 seed]

// Every easing on Vec3 tweens, redirects and slerp. The linear tweens' sum is
// checked on the host; redirect jumps and slerp's angular speed are errors.
entry func tween_batch (count: U32) : #[F32] =>
  let eases = #[$tween.Linear, $tween.Smooth, $tween.Smoother, $tween.CubicIn, $tween.CubicOut, $tween.CubicInOut, $tween.Back, $tween.Hold, $tween.Steps 4]
  let target = math.axis_angle math.up 2.0
  let linear = 0.0
  let sum = 0.0
  let error = 0.0
  for i in 0..count:
    let x = U32.to_f32 (i % 100) * 0.01
    let $Some moving = tween.make (math.vec3 x 0.0 0.0) (math.vec3 x 1.0 2.0) 0.0 2.0 eases[i % 9] else:
      return #[]
    let p = tween.at moving (x * 2.0)
    if i % 9 == 0:
      linear := self + p.y
    let $Some redirected = tween.toward moving x math.one3 1.0 $tween.Smooth else:
      return #[]
    error := max self ((tween.at redirected x - tween.at moving x).length)
    let q = math.Quat.slerp math.identity_quat target x
    error := max self (abs (2.0 * math.atan2 (sqrt (q.x * q.x + q.y * q.y + q.z * q.z)) q.w - 2.0 * x))
    sum := self + p.y + p.z + q.y
  return #[U32.to_f32 count, linear, error, sum]

// A looping timeline with `count` keys and cues, advanced through 32 cycles in
// eighths, then once past the pass budget.
entry func timeline_batch (count: U32) : #[F32] =>
  let keys = @array.generate count (func (i: U32) => $timeline.Key { time: U32.to_f32 i / U32.to_f32 count, value: U32.to_f32 i, ease: $tween.Linear })
  let list = @array.generate count (func (i: U32) => { time: U32.to_f32 i / U32.to_f32 count, value: i })
  let $Some track = timeline.track keys else:
    return #[]
  let $Some sheet = timeline.cues list else:
    return #[]
  let $Some started = timeline.play 1.0 $timeline.Loop else:
    return #[]
  let playback = started
  let fired = 0
  let sum = 0.0
  for 0..256:
    let $Some advanced = timeline.advance playback 0.125 else:
      return #[]
    playback := advanced.playback
    fired := self + (timeline.fired sheet advanced.passes).length
    sum := self + timeline.sample track (timeline.position playback)
  let $Some long = timeline.advance playback 1000.5 else:
    return #[]
  let crossed = timeline.fired sheet long.passes
  return #[U32.to_f32 count, U32.to_f32 fired, sum, U32.to_f32 crossed.length, long.dropped]

entry func steering_batch (count: U32) : #[F32] =>
  let neighbours = @array.generate 16 (func (i: U32) => math.vec3 (U32.to_f32 i * 0.1) 0.0 1.0)
  let sum = 0.0
  let error = 0.0
  for i in 0..count:
    let p = math.vec3 (U32.to_f32 (i % 100) * 0.01) 0.0 0.0
    let desired = steering.arrive p math.one3 4.0 2.0 0.1 + steering.seek p math.one3 4.0 + steering.separation p neighbours 2.0 3.0
    let force = steering.accelerate math.zero3 desired 1.0 8.0
    let velocity = steering.limit force 4.0
    error := max self (max 0.0 (velocity.length - 4.0))
    if steering.in_fov p math.forward (p + math.forward) 10.0 0.7:
      sum := self + velocity.x + 1.0
    if steering.visible floor (p + math.up) math.forward (p + math.up + math.forward) 10.0 0.7 65535 0 0:
      sum := self + 1.0
  return #[U32.to_f32 count, sum, error]

// A loop through `count` points on a circle of radius 10, walked in `count`
// equal steps, and an open line through `count` unevenly spaced points: the
// loop's length, how far any step strays from the circle or its tangent from
// level, and how far the line's length is from its span.
entry func spline_batch (count: U32) : #[F32] =>
  let ring = @array.generate count (func (i: U32) =>
    let (s, c) = sin_cos (U32.to_f32 i * tau / U32.to_f32 count)
    return math.vec3 (c * 10.0) 1.0 (s * 10.0))
  let line = @array.generate count (func (i: U32) => math.vec3 (U32.to_f32 i + U32.to_f32 (i * i % 7) * 0.01) 0.0 0.0)
  let spline_coefficients_1: #[F32] = #[]
  let spline_lengths_1: #[F32] = #[]
  let $Some round = spline.make_loop_into ring spline_coefficients_1 spline_lengths_1 else:
    return #[]
  let spline_coefficients_2: #[F32] = #[]
  let spline_lengths_2: #[F32] = #[]
  let $Some straight = spline.make_into line spline_coefficients_2 spline_lengths_2 else:
    return #[]
  let total = spline.length round
  let stray = 0.0
  for i in 0..count:
    let distance = total * U32.to_f32 i / U32.to_f32 count
    let p = spline.at round distance
    let t = spline.tangent round distance
    stray := max self (max (abs (sqrt (p.x * p.x + p.z * p.z) - 10.0)) (abs t.y))
  let span = line[count - 1].x - line[0].x
  return #[U32.to_f32 count, total, stray, abs (spline.length straight - span)]

// A follow camera chasing a target around a loop for `count` steps at 60 Hz,
// each step also framing points about the target, pulling a sunk eye out of
// the floor and riding a dolly on the loop. The farthest the eye drifts from
// the focus plus the offset, the farthest a pulled eye sits from 0.25 above
// the floor, how many framings succeed, and how far a dolly looking along the
// loop turns from its tangent.
entry func rig_batch (count: U32) : #[F32] =>
  let spline_coefficients_3: #[F32] = #[]
  let spline_lengths_3: #[F32] = #[]
  let $Some path = spline.make_loop_into #[math.vec3 10.0 0.0 0.0, math.vec3 0.0 0.0 (-8.0), math.vec3 (-10.0) 0.0 0.0, math.vec3 0.0 0.0 8.0] spline_coefficients_3 spline_lengths_3 else:
    return #[]
  let rules = $rig.Follow { offset: math.vec3 0.0 2.0 5.0, turns: false, dead_zone: 0.5, lookahead: 0.3, frequency: 6.0, damping: 1.0, turn_rate: 8.0 }
  let lens = $view.Lens { focal_length: 1.7320508, near: 0.1, far: 500.0 }
  let state = rig.follower rules (spline.at path 0.0) (spline.tangent path 0.0 * 4.0) 0.0
  let drift = 0.0
  let sunk = 0.0
  let framed = 0
  let turned = 0.0
  for i in 0..count:
    let distance = U32.to_f32 i * (4.0 / 60.0)
    let target = spline.at path distance
    let (next, camera) = rig.follow rules state target (spline.tangent path distance * 4.0) 0.0 (1.0 / 60.0)
    state := next
    drift := max self (next.eye.value - next.focus.value - rules.offset).length
    let pulled = rig.collide floor (target + math.up) (camera.position - math.up * 6.0) 0.25 65535 0
    sunk := max self (abs (pulled.y - 0.25))
    let around = #[target + math.right, target - math.right, target + math.up, target - math.up]
    if let $Some _ = rig.frame lens 1.6 camera.rotation around 0.05:
      framed := self + 1
    let dolly = rig.dolly path distance $rig.Along
    turned := max self (1.0 - dolly.rotation.forward.dot (spline.tangent path distance))
  return #[U32.to_f32 count, drift, sunk, U32.to_f32 framed, turned]

entry func audio_batch (count: U32) : #[F32] =>
  let listener = $audio.Listener { position: math.up, velocity: math.zero3, right: math.right }
  let sum = 0.0
  let error = 0.0
  for i in 0..count:
    let emitter = $audio.Emitter { position: math.vec3 (U32.to_f32 (i % 100) * 0.01) 2.0 3.0, velocity: math.forward, gain: 1.0 }
    let $Some mixed = audio.mix audio.default_config listener emitter false else:
      return #[]
    let $Some queried = audio.query audio.default_config listener emitter floor 65535 0 else:
      return #[]
    error := max self (abs (mixed.gain - queried.gain))
    sum := self + mixed.gain + mixed.pan + mixed.rate + audio.fade 1.0 (U32.to_f32 (i % 100) * 0.01) 0.0 1.0
  return #[U32.to_f32 count, sum, error]

entry func terrain_batch (count: U32) : #[F32] =>
  let heights = @array.fill 289 0.0
  let ground = terrain.make math.zero3 128.0 16 (heights.view 0 heights.length) 1.0 16.0 3 123
  let sum = 0.0
  let error = 0.0
  for i in 0..count:
    let x = U32.to_f32 (i % 100) - 50.0
    let p = math.vec3 x 3.0 (x * 0.7)
    let h = terrain.height ground p.x p.z
    let n = terrain.normal ground p.x p.z
    let stood = terrain.stand ground p 0.1
    let stuck = terrain.stick ground p 0.1 4.0
    let (low, high) = terrain.range ground (x - 1.0) (p.z - 1.0) (x + 1.0) (p.z + 1.0)
    if h < low or h > high:
      error := self + 1.0
    error := max self (abs (n.length - 1.0))
    sum := self + h + n.y + terrain.slope ground p.x p.z + (terrain.gradient ground p.x p.z).x + (terrain.ground ground p).y + terrain.above ground p + stood.position.y + stuck.position.y
  return #[U32.to_f32 count, sum, error]

entry func terrain_range (size: U32) : #[F32] =>
  let heights = @array.generate ((size + 1) * (size + 1)) (func (i: U32) => U32.to_f32 (i % 17))
  let ground = terrain.make math.zero3 128.0 size (heights.view 0 heights.length) 0.0 1.0 0 0
  let (low, high) = terrain.range ground (-64.0) (-64.0) 64.0 64.0
  return #[U32.to_f32 size, low, high]

entry func terrain_segment (length: U32) : #[F32] =>
  let heights = @array.fill 4225 0.0
  let ground = terrain.make math.zero3 128.0 64 (heights.view 0 heights.length) 0.0 1.0 0 0
  let half = U32.to_f32 length * 0.5
  let gap = shapes.segment_terrain ground (math.vec3 (0.0 - half) 1.0 0.0) (math.vec3 half 1.0 0.0)
  return #[U32.to_f32 length, gap.dist, gap.normal.y]

entry func tiles_batch (count: U32) : #[F32] =>
  let ids: #[U32] = @array.generate 256 (func (i: U32) : U32 =>
    if i < 16:
      return 1
    return 0)
  let grid = tiles.grid 16 16 (math.vec2 1.0 1.0) math.zero2 ids #[0, tiles.solid, tiles.oneway, (tiles.ladder | tiles.hazard)]
  let sum = 0.0
  let grounded = 0
  for i in 0..count:
    let p = tiles.centre_of grid (U32.to_f32 (i % 14) + 1.0) 1.0
    let moved = tiles.slide grid (math.vec2 0.25 0.5) false p (math.vec2 1.0 (-1.0)) 0.016
    if moved.grounded and tiles.point_has grid tiles.solid (math.vec2 p.x 0.5) and tiles.touches grid tiles.solid p (math.vec2 0.25 0.51):
      grounded := self + 1
    sum := self + moved.pos.x + moved.pos.y + U32.to_f32 (tiles.flags_at grid 1.0 0.0)
  return #[U32.to_f32 count, sum, U32.to_f32 grounded]

entry func spatial_batch (count: U32) : #[F32] =>
  let bounds = @array.generate count (func (i: U32) =>
    let p = math.vec3 (U32.to_f32 i * 3.0) 0.0 0.0
    return $spatial.Bounds { low: p, high: p + math.one3 })
  return owned.with_index bounds (func original => owned.with_index bounds (func (own current) =>
    let moved = spatial.refit current #[0] #[$spatial.Bounds { low: math.one3 * (-5.0), high: math.one3 * (-4.0) }]
    let a = spatial.query original math.zero3 math.one3
    let b = spatial.query moved math.zero3 math.one3
    let c = spatial.query moved (math.one3 * (-5.0)) (math.one3 * (-4.0))
    return #[U32.to_f32 count, U32.to_f32 a.length, U32.to_f32 b.length, U32.to_f32 c.length]))

entry func scene_batch (count: U32) : #[F32] =>
  let sources = @array.generate count (func (i: U32) => scene.sphere (i + 1) (math.vec3 (U32.to_f32 i * 3.0) 0.0 0.0) 0.5)
  return owned.with_scene sources (func (own current) =>
    let changed = arrays.copy_u32 #[0]
    let next = sources.copy
    next[0].position := math.vec3 (-5.0) 0.0 0.0
    let moved = scene.update next current changed
    let hit = scene.ray moved (math.vec3 (-5.0) 2.0 0.0) (math.up * (-1.0)) 4.0 65535 0
    let hits = scene.overlap_sphere moved (math.vec3 (-5.0) 0.0 0.0) 1.0 65535
    let found = 0.0
    if let $Some value = hit:
      found := value.distance
    let helpers = scene.scale_by (scene.rotate math.identity_quat math.one3) math.one3
    let q = scene.compose math.identity_quat math.identity_quat
    return #[U32.to_f32 count, found, U32.to_f32 hits.length, helpers.x + q.w])

entry func spatial_dense (count: U32) : #[F32] =>
  let bounds = @array.fill count ($spatial.Bounds { low: math.zero3, high: math.one3 })
  return owned.with_index bounds (func original => owned.with_index bounds (func (own current) =>
    let changed = @array.generate count (func (i: U32) => i)
    let replacements = @array.fill count ($spatial.Bounds { low: math.one3 * 4.0, high: math.one3 * 5.0 })
    let moved = spatial.refit current changed replacements
    let before = spatial.query original math.zero3 math.one3
    let miss = spatial.query moved math.zero3 math.one3
    let after = spatial.query moved (math.one3 * 4.0) (math.one3 * 5.0)
    let error = 0.0
    for i in 0..after.length:
      error := max self (abs (U32.to_f32 after[i] - U32.to_f32 i))
    return #[U32.to_f32 count, U32.to_f32 before.length, U32.to_f32 miss.length, U32.to_f32 after.length, error]))

entry func scene_dense_update (count: U32) : #[F32] =>
  let sources = @array.generate count (func (i: U32) => scene.sphere (i + 1) math.zero3 0.5)
  return owned.with_scene sources (func original => owned.with_scene sources (func (own current) =>
    let changed = @array.generate count (func (i: U32) => i)
    let next = @array.generate count (func (i: U32) =>
      let source = sources[i]
      source.position := math.right * 4.0
      return source)
    let moved = scene.update next current changed
    let before = scene.overlap_sphere original math.zero3 0.1 65535
    let miss = scene.overlap_sphere moved math.zero3 0.1 65535
    let after = scene.overlap_sphere moved (math.right * 4.0) 0.1 65535
    let error = 0.0
    for i in 0..after.length:
      error := max self (abs (U32.to_f32 after[i] - U32.to_f32 (i + 1)))
    return #[U32.to_f32 count, U32.to_f32 before.length, U32.to_f32 miss.length, U32.to_f32 after.length, error]))

entry func scene_sparse_update (count: U32) : #[F32] =>
  let sources: #[scene.Source] = #[]
  for i in 0 .. count:
    @storage.push sources (scene.sphere (i + 1) (math.vec3 (U32.to_f32 i * 4.0) 0.0 0.0) 0.5)
  return owned.with_scene sources (func original => owned.with_scene sources (func (own current) =>
    let next = @storage.copy sources
    for step in 0 .. 16:
      next[count / 2].position := math.vec3 (-(U32.to_f32 step + 1.0)) 0.0 0.0
      current := scene.update next self #[count / 2]
    let found = scene.overlap_sphere current (math.vec3 (-16.0) 0.0 0.0) 0.1 65535
    let before = scene.overlap_sphere original (math.vec3 (-16.0) 0.0 0.0) 0.1 65535
    return #[U32.to_f32 count, U32.to_f32 found.length, U32.to_f32 found[0], U32.to_f32 before.length]))

entry func shapes_batch (count: U32) : #[F32] =>
  let sum = 0.0
  let error = 0.0
  for i in 0..count:
    let (value, normal_error) = owned.with_geometry (func (own geometry) =>
      let rotation = math.yaw_pitch (U32.to_f32 (i % 100) * 0.01) 0.2
      let (poly, geometry) = shapes.box_poly geometry math.zero3 rotation math.one3
      let (placed_stored, geometry) = shapes.poly_place_stored geometry poly math.up math.identity_quat math.one3
      let shape = $shapes.Hull (shapes.unpack_poly geometry placed_stored)
      let (low, high) = shapes.bounds shape
      let gap = shapes.segment_gap shape (math.vec3 0.0 4.0 0.0) (math.vec3 0.0 5.0 0.0)
      return (sum + gap.dist + high.y - low.y + shapes.sphere_inertia 1.0 + (shapes.box_inertia math.one3).y + (shapes.capsule_inertia 0.5 1.0).y, abs (gap.normal.length - 1.0)))
    error := max self normal_error
    sum := value
  return #[U32.to_f32 count, sum, error]

entry func hull_planes (count: U32) : #[F32] => owned.with_geometry (func (own geometry) =>
  let normals = #[math.right, math.right * (-1.0), math.up, math.up * (-1.0), math.forward, math.forward * (-1.0)]
  let planes = @array.generate count (func (i: U32) => shapes.plane normals[i % 6] 1.0)
  let (found, geometry) = shapes.hull_poly geometry (planes.view 0 planes.length)
  let $Some stored = found else:
    return #[]
  let poly = shapes.unpack_poly geometry stored
  return #[U32.to_f32 count, U32.to_f32 poly.verts.length, U32.to_f32 poly.planes.length])

entry func contact_batch (count: U32) : #[F32] => owned.with_geometry (func (own geometry) =>
  let capsule = $shapes.Capsule { a: math.zero3, b: math.up, radius: 0.5 }
  let (box_stored, geometry) = shapes.box_poly geometry math.zero3 math.identity_quat math.one3
  let (other_stored, geometry) = shapes.box_poly geometry (math.vec3 0.0 1.5 0.0) math.identity_quat math.one3
  let box = $shapes.Hull (shapes.unpack_poly geometry box_stored)
  let other = $shapes.Hull (shapes.unpack_poly geometry other_stored)
  let sum = 0.0
  let error = 0.0
  for i in 0..count:
    for pair in #[(box, other), (box, capsule), (capsule, contact.sphere math.up 0.5)]:
      let (a, b) = pair
      let contacts = contact.between a b 0.02
      for c in contacts:
        sum := self + c.sep
        error := max self (abs (c.normal.length - 1.0))
    if contact.is_sphere (contact.sphere math.zero3 0.5):
      sum := self + 1.0
  return #[U32.to_f32 count, sum, error])

entry func physics_sparse (count: U32) : #[F32] =>
  let sources = @array.generate count (func (i: U32) => scene.dynamic (scene.sphere (i + 1) (math.vec3 (U32.to_f32 i * 3.0) 10.0 0.0) 0.5))
  return owned.with_step sources #[] (func (own step) =>
    step := physics.step_into physics.default_config (1.0 / 60.0) step
    return physics.with_sources step (func next => owned.with_scene next (func world =>
      let overlaps = physics.overlap_capsule world math.zero3 math.up 0.2 65535
      return #[U32.to_f32 count,next[0].position.y,U32.to_f32 (physics.contact_count (physics.read_cache step.cache)),U32.to_f32 overlaps.length])))

entry func physics_dense (count: U32) : #[F32] =>
  let sources = @array.generate count (func (i: U32) => scene.dynamic (scene.sphere (i + 1) (math.vec3 (U32.to_f32 (i % 8) * 0.05) 10.0 (U32.to_f32 (i / 8) * 0.05)) 0.5))
  return owned.with_step sources #[] (func (own step) =>
    step := physics.step_into physics.default_config (1.0 / 60.0) step
    let sum = 0.0
    for index in 0 .. step.sources.length:
      sum := self + (physics.source step index).position.y
    return #[U32.to_f32 count,sum,U32.to_f32 (physics.contact_count (physics.read_cache step.cache))])

entry func rigid_batch (count: U32) : #[F32] =>
  let positions = @array.generate (count * 3) (func (i: U32) =>
    if i % 3 == 0:
      return U32.to_f32 (i / 3) * 3.0
    if i % 3 == 1:
      return 0.5
    return 0.0)
  let rotations = @array.generate (count * 4) (func (i: U32) =>
    if i % 4 == 3:
      return 1.0
    return 0.0)
  let velocities = @array.fill (count * 6) 0.0
  let inverse_mass = @array.fill count 1.0
  let inverse_inertia = @array.fill (count * 3) 1.0
  let gravity_scale = @array.fill count 1.0
  let linear_damping = @array.fill count 0.0
  let angular_damping = @array.fill count 0.0
  let bodies = $rigid.Bodies {pos: positions, rot: rotations, vel: velocities,
    inv_mass: inverse_mass, inv_inertia: inverse_inertia, gravity_scale, linear_damping, angular_damping}
  let iw = rigid.inertia_table rotations bodies.inv_inertia
  let rows = @array.fill (count * rigid.stride) 0.0
  for i in 0 .. count:
    let row = rigid.prepare_row bodies iw (-1.0) (U32.to_f32 i) math.up (math.vec3 (U32.to_f32 i * 3.0) 0.0 0.0) 0.0 0.6 0.0
    for lane in 0 .. rigid.stride:
      rows[i * rigid.stride + lane] := row[lane]
  let pos: #[F32] = @array.fill bodies.pos.length 0.0
  let rot: #[F32] = @array.fill bodies.rot.length 0.0
  let vel: #[F32] = @array.fill bodies.vel.length 0.0
  let initial_impulses: #[F32] = @array.fill (count * rigid.impulse_stride) 0.0
  let impulses: #[F32] = @array.fill initial_impulses.length 0.0
  let (pos, rot, vel, impulses) = rigid.solve_into (1.0 / 60.0) 4 (math.up * (-9.81)) bodies rows initial_impulses pos rot vel impulses
  let sum = 0.0
  let error = 0.0
  for i in 0..count:
    let q = rigid.quat rot (i * 4)
    error := max self (abs (math.Quat.dot q q - 1.0))
    sum := self + pos[i * 3 + 1] + vel[i * 6 + 1] + impulses[i * rigid.impulse_stride]
  return #[U32.to_f32 count, sum, error]

entry func character_batch (count: U32) : #[F32] =>
  let body = $character.Body { low: math.vec3 0.0 0.4 0.0, high: math.vec3 0.0 1.4 0.0, radius: 0.4 }
  let filter = scene.solid_filter 65535
  let walker = scene.default_walker
  walker.velocity := math.vec3 1.0 (-1.0) 0.0
  let grounded = 0
  let sum = 0.0
  for i in 0..count:
    let hits: #[scene.Hit] = #[]
    let moved = character.move hits floor body filter (math.vec3 (U32.to_f32 (i % 100)) 0.002 0.0) walker math.zero3 (1.0 / 60.0)
    if moved.walker.grounded:
      grounded := self + 1
    sum := self + moved.position.y
  return #[U32.to_f32 count, sum, U32.to_f32 grounded]

entry func placement_batch (width: U32) : #[F32] =>
  let points = placement.chunk 123 1.0 1.2 (-16.0) (-16.0) width 16
  let sum = 0.0
  for point in points:
    sum := self + point.position.x + point.position.z
  let $Some choice = placement.choose #[0.0, 1.0, 2.0, 0.0] 123 else:
    return #[]
  return #[U32.to_f32 width, U32.to_f32 points.length, sum, U32.to_f32 choice.index]

entry func debug_batch (count: U32) : #[F32] => owned.with_geometry (func (own geometry) =>
  let (box_stored, geometry) = shapes.box_poly geometry math.zero3 math.identity_quat math.one3
  let box = $shapes.Hull (shapes.unpack_poly geometry box_stored)
  let color = math.rgb 1.0 0.5 0.25
  let lines = @array.generate count (func (i: U32) => debug.line (math.vec3 (U32.to_f32 i) 0.0 0.0) math.one3 color)
  let packed = debug.vertices lines
  let bounds = debug.bounds ($spatial.Bounds { low: math.zero3, high: math.one3 }) color
  let colliders = debug.collider box 16 color
  let path = debug.path #[math.zero3, math.up, math.right] true color
  let ray = debug.ray ($math.Ray { origin: math.zero3, direction: math.forward }) 2.0 color
  let contacts = debug.contacts #[$contact.Contact { point: math.zero3, normal: math.up, sep: (-0.1) }] 0.5 color
  return #[U32.to_f32 count, U32.to_f32 packed.length, U32.to_f32 (bounds.length + colliders.length + path.length + ray.length + contacts.length), packed[3]])

entry func animation_events (count: U32) : #[F32] =>
  let events = @array.generate count (func (i: U32) => { time: U32.to_f32 i / U32.to_f32 count, id: i })
  let tracks: #[animation.Track] = #[]
  let keys: #[animation.Key] = #[]
  let clip = $animation.Clip {duration: 1.0,keys: keys.view 0 0,tracks: tracks.view 0 0,events: events.view 0 events.length}
  let crossed = animation.events clip 0.0 32.0 true
  return #[U32.to_f32 count, U32.to_f32 crossed.length]

entry func sort_ties (count: U32) : #[F32] =>
  let floats = @array.generate count (func (i: U32) => U32.to_f32 (i % 16))
  let ids = @array.generate count (func (i: U32) => 4294967295 - (i % 16))
  let a = sort.order floats
  let b = sort.order_u32 ids
  let errors = 0
  for i in 1..count:
    if floats[a[i]] < floats[a[i - 1]] or ids[b[i]] < ids[b[i - 1]]:
      errors := self + 1
    if floats[a[i]] == floats[a[i - 1]] and a[i] < a[i - 1]:
      errors := self + 1
    if ids[b[i]] == ids[b[i - 1]] and b[i] < b[i - 1]:
      errors := self + 1
  return #[U32.to_f32 count, U32.to_f32 errors, U32.to_f32 a[0], U32.to_f32 b[0]]

entry func particles_expired (count: U32) : #[F32] =>
  let emitter = $particles.Emitter { position: math.zero3, velocity: math.up, spread: math.one3, lifetime: 1.0, lifetime_spread: 0.0, size: 1.0 }
  let emitted = particles.emit 123 count emitter
  let all = particles.update emitted.particles math.up 2.0
  let mixed = @array.generate count (func (i: U32) =>
    let particle = emitted.particles[i]
    if i % 2 == 0:
      particle.age := 1.0
    return particle)
  let half = particles.update mixed math.up 0.25
  let errors = 0
  for i in 0..half.length:
    if half[i].seed != emitted.particles[i * 2 + 1].seed:
      errors := self + 1
  return #[U32.to_f32 count, U32.to_f32 all.length, U32.to_f32 half.length, U32.to_f32 errors]

func unreachable_costs (size: U32) =>
  let costs = @array.generate (size * size) (func (i: U32) =>
    if i % size == size / 2:
      return 0.0
    return 1.0)
  return costs

entry func navigation_unreachable (size: U32) : #[F32] =>
  let costs = unreachable_costs size
  let $Some grid = navigation.grid size size (costs.view 0 costs.length) else:
    return #[]
  let found = 0.0
  if let $Some _ = navigation.astar grid 0 (size * size - 1) (size * size):
    found := 1.0
  return #[U32.to_f32 size, found]

entry func navigation_budget (size: U32) : #[F32] =>
  let costs = @array.fill (size * size) 1.0
  let $Some grid = navigation.grid size size (costs.view 0 costs.length) else:
    return #[]
  let found = 0.0
  if let $Some _ = navigation.astar grid 0 (size * size - 1) 16:
    found := 1.0
  return #[U32.to_f32 size, found]

entry func placement_neighbours (spacing: U32) : #[F32] =>
  let points = placement.chunk 123 1.0 (U32.to_f32 spacing) (-16.0) (-16.0) 32 32
  return #[U32.to_f32 spacing, U32.to_f32 points.length]

entry func terrain_detail (octaves: U32) : #[F32] =>
  let heights = @array.fill 81 0.0
  let ground = terrain.make math.zero3 16.0 8 (heights.view 0 heights.length) 0.1 8.0 octaves 123
  let gap = shapes.segment_terrain ground (math.vec3 (-2.0) 2.0 0.0) (math.vec3 2.0 2.0 0.0)
  return #[U32.to_f32 octaves, gap.dist, gap.normal.y]

entry func hull_unique (count: U32) : #[F32] => owned.with_geometry (func (own geometry) =>
  let axes = #[math.right, math.right * (-1.0), math.up, math.up * (-1.0), math.forward, math.forward * (-1.0)]
  let planes = @array.generate count (func (i: U32) =>
    if i < 6:
      return shapes.plane axes[i] 1.0
    let y = 1.0 - 2.0 * (U32.to_f32 (i - 6) + 0.5) / U32.to_f32 (count - 6)
    let radius = sqrt (max 0.0 (1.0 - y * y))
    let (s, c) = sin_cos (U32.to_f32 i * 2.3999632297)
    return shapes.plane (math.vec3 (c * radius) y (s * radius)) 1.0)
  let (found, geometry) = shapes.hull_poly geometry (planes.view 0 planes.length)
  let $Some stored = found else:
    return #[]
  let poly = shapes.unpack_poly geometry stored
  let (low, high) = shapes.bounds ($shapes.Hull poly)
  return #[U32.to_f32 count, U32.to_f32 poly.verts.length, U32.to_f32 poly.planes.length, high.x - low.x])

// Walls on a lattice leave doorways, so merged rectangles form many corridors.
func lattice_costs (size: U32) : #[F32] =>
  return @array.generate (size * size) (func (i: U32) =>
    let x = i % size
    let y = i / size
    if (x % 8 == 4 and y % 8 != 2) or (y % 8 == 6 and x % 8 != 5):
      return 0.0
    return 1.0)

// Grid -> mesh -> index -> corridor -> funnel across the lattice. Witness: size,
// route status, polygon count above zero, and a corner count of at least two.
entry func navmesh_route (size: U32) : #[F32] =>
  let costs = lattice_costs size
  let $Some grid = navigation.grid size size (costs.view 0 costs.length) else:
    return #[]
  let storage = navmesh.empty ()
  let (ok, storage) = navmesh.from_grid_into storage grid 0.0 0.0 1.0
  let m = navmesh.read storage
  let lookup = navmesh.index_storage ()
  let (lookup, frame) = navmesh.index_into lookup m 8.0
  let index = navmesh.index_read lookup frame
  let start = navmesh.locate_spot m index 0.5 0.5
  let goal = navmesh.locate_spot m index (U32.to_f32 size - 0.5) (U32.to_f32 size - 0.5)
  let w = corridor.work ()
  let (w, route) = corridor.search_into w m start goal 4294967295
  w := funnel.pull_into w m start goal 0.25
  return #[U32.to_f32 size, U32.to_f32 route.status, if m.polys.length > 0 and ok then 1.0 else 0.0, if w.path.length >= 6 then 1.0 else 0.0]

entry func grid_theta (size: U32) : #[F32] =>
  let costs = lattice_costs size
  let $Some grid = navigation.grid size size (costs.view 0 costs.length) else:
    return #[]
  let w = anyangle.work ()
  let (w, result) = anyangle.theta_into w grid 0 (size * size - 1) (size * size)
  return #[U32.to_f32 size, U32.to_f32 result.status, if w.cells.length >= 2 then 1.0 else 0.0]

entry func grid_flow (size: U32) : #[F32] =>
  let costs = lattice_costs size
  let $Some grid = navigation.grid size size (costs.view 0 costs.length) else:
    return #[]
  let goals: #[U32] = #[size * size - 1, size * size - 2]
  let f = flow.flow ()
  f := flow.flow_into f grid (&goals[0..2])
  return #[U32.to_f32 size, f.costs[0], U32.to_f32 f.directions.length]

// A ring of agents swapping places, each seeing its eight nearest ring
// neighbours; a few ORCA steps. Witness: size and the final minimum gap flag.
entry func orca_crowd (count: U32) : #[F32] =>
  let agents = @array.fill (count * 5) 0.0
  for i in 0 .. count:
    let angle = U32.to_f32 i * 6.2831855 / U32.to_f32 count
    agents[i * 5] := 50.0 * cos angle
    agents[i * 5 + 1] := 50.0 * sin angle
    agents[i * 5 + 4] := 0.4
  let set = avoidance.obstacles ()
  let none: #[U32] = #[]
  let params = $avoidance.Params { time_horizon: 5.0, time_horizon_obstacles: 5.0, time_step: 0.1, max_speed: 1.5, max_neighbours: 8 }
  let w = avoidance.work ()
  let neighbours = @array.fill 8 0
  let sum = 0.0
  for _ in 0 .. 4:
    for i in 0 .. count:
      for k in 0 .. 8:
        neighbours[k] := (i + count + k + 1 - 4) % count
      let (next, v) = avoidance.velocity_into w (&agents[0..agents.length]) i (&neighbours[0..8]) set (&none[0..0]) (0.0 - agents[i * 5] * 0.03) (0.0 - agents[i * 5 + 1] * 0.03) params
      w := next
      sum := self + v.x + v.y
  return #[U32.to_f32 count, if is_finite sum then 1.0 else 0.0]

// A line of `count` probes through the middle of a closed room, 16 rays each:
// the probes baked, those found valid, and the largest gap between a probe's
// stored light and the sample taken at its own centre.
entry func probes_batch (count: U32) : #[F32] =>
  let walls = #[
    scene.box 1 (math.vec3 0.0 (-3.5) 0.0) (math.vec3 8.0 1.0 8.0),
    scene.box 2 (math.vec3 0.0 3.5 0.0) (math.vec3 8.0 1.0 8.0),
    scene.box 3 (math.vec3 (-3.5) 0.0 0.0) (math.vec3 1.0 8.0 8.0),
    scene.box 4 (math.vec3 0.0 0.0 (-3.5)) (math.vec3 8.0 8.0 1.0),
    scene.box 5 (math.vec3 0.0 0.0 3.5) (math.vec3 8.0 8.0 1.0),
    scene.box 6 (math.vec3 3.5 0.0 0.0) (math.vec3 1.0 8.0 8.0)]
  let sources = @array.generate walls.length (func (i: U32) =>
    let source = walls[i]
    source.index := i
    return source)
  let sky = environment.default_sky
  let diffuse = environment.diffuse (environment.project sky 4 8) (math.rgb 0.3 0.3 0.3)
  let light = $probes.Light {
    sky, tint: diffuse.tint, ambient: $environment.Irradiance { coefficients: diffuse.coefficients },
    direction: (math.vec3 0.3 (-1.0) 0.2).normalized, sun: math.rgb 1.0 0.9 0.8, rays: 16, reach: 40.0, mask: 65535,
  }
  let grid = $probes.Grid { origin: math.vec3 (-2.5) 0.0 0.0, spacing: 5.0 / U32.to_f32 count, nx: count, ny: 1, nz: 1 }
  return scene.with_built sources (func built =>
    let values = probes.empty_values grid
    values := probes.bake_range built light grid (func (id: U32) => math.rgb 0.5 0.5 0.5) #[] 0 count values
    let valid = 0.0
    let error = 0.0
    for index in 0 .. count:
      valid := self + values[index * probes.stride + 27]
      let at = probes.lattice_position grid index
      let found = probes.sample grid values at math.up 0.0
      let direct = environment.evaluate ($environment.Irradiance { coefficients: @array.generate 9 (func (i: U32) => math.rgb values[index * probes.stride + i * 3] values[index * probes.stride + i * 3 + 1] values[index * probes.stride + i * 3 + 2]) }) math.up
      error := max self (abs (found.light.r - direct.r))
    return #[U32.to_f32 count, valid, error])

// `count` probes along x, each box overlapping the next, in three priorities,
// and `count` points through them: the points inside a box, the points whose
// shares add up to their coverage, and the largest gap between a sum and its coverage.
entry func reflections_batch (count: U32) : #[F32] =>
  let list = array.generate count (func (i: U32) =>
    return $render.ReflectionProbe {
      id: i + 1, revision: 1, priority: i % 3, capture: false,
      position: math.vec3 (U32.to_f32 i) 1.0 0.0, centre: math.vec3 (U32.to_f32 i) 1.0 0.0,
      extent: math.vec3 1.25 1.0 1.0, blend: 0.5,
      parallax_centre: math.vec3 (U32.to_f32 i) 1.0 0.0, parallax_extent: math.vec3 1.25 1.0 1.0, far: 10.0,
    })
  let inside = 0.0
  let agree = 0.0
  let gap = 0.0
  for q in 0 .. count:
    let at = math.vec3 (U32.to_f32 q + 0.3) 1.0 0.2
    let shares = reflections.shares (&list[0..list.length]) at
    let sum = 0.0
    for i in 0 .. shares.length:
      sum := self + shares[i]
    let coverage = reflections.coverage (&list[0..list.length]) at
    if coverage > 0.0:
      inside := self + 1.0
    if abs (sum - coverage) <= 0.000001 and sum <= 1.000001:
      agree := self + 1.0
    gap := max self (abs (sum - coverage))
  return #[U32.to_f32 count, if inside > 0.0 then U32.to_f32 count else 0.0, gap]

// `count` columns of 32 froxels along rays through a noisy mist with a box and an
// ellipsoid of fog in it, each froxel's source the light its extinction would
// hold in equilibrium: the integrated light and the attenuated light add up to
// that light whatever the column, so the columns that do, the columns that are
// thick enough to matter and the largest gap are counted.
entry func volumetrics_batch (count: U32) : #[F32] =>
  let fog = render.defaults.fog
  fog.density := 0.4
  fog.height := 6.0
  fog.radius := 4.0
  fog.edge := 3.0
  fog.noise := 0.6
  fog.noise_scale := 5.0
  fog.drift := math.vec3 3.0 0.0 (-2.0)
  let list = #[
    $render.FogVolume { shape: 0, centre: math.vec3 0.0 2.0 (-30.0), extent: math.vec3 12.0 4.0 10.0, density: 0.5,
      albedo: math.vec3 0.8 0.9 1.0, emission: math.vec3 0.0 0.1 0.0, falloff: 0.5 },
    $render.FogVolume { shape: 1, centre: math.vec3 15.0 1.0 (-50.0), extent: math.vec3 9.0 9.0 9.0, density: 0.3,
      albedo: math.vec3 1.0 0.9 0.7, emission: math.zero3, falloff: 0.0 },
  ]
  let light = math.vec3 0.25 0.5 2.0
  let agree = 0.0
  let thick = 0.0
  let gap = 0.0
  for i in 0 .. count:
    let angle = U32.to_f32 (i % 97) * 0.0647
    let ray = math.vec3 (sin angle) (0.1 * cos (3.0 * angle)) (-1.0)
    let slices = array.generate 32 (func (k: U32) =>
      let depth = volumetrics.slice_centre 120.0 32 k
      let at = math.vec3 (ray.x * depth) (ray.y * depth + 1.5) (ray.z * depth)
      let found = volumetrics.medium_at fog (&list[0..list.length]) 3 at
      return $volumetrics.Slice { source: light * found.extinction, extinction: found.extinction, delta: volumetrics.slice_length 120.0 32 ray k })
    let column = volumetrics.integrate_column (&slices[0..slices.length])
    let seen = volumetrics.column_light column 32
    let tau = volumetrics.column_depth column 32
    let kept = volumetrics.exp (0.0 - tau)
    let error = max (abs (seen.x + light.x * kept - light.x)) (max (abs (seen.y + light.y * kept - light.y)) (abs (seen.z + light.z * kept - light.z)))
    gap := max self error
    if error <= 0.00005:
      agree := self + 1.0
    if tau > 0.1:
      thick := self + 1.0
  return #[U32.to_f32 count, agree, gap, thick]
