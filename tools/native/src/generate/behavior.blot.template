const @NAME@_nodes: #[_behavior.Node [@ACTION@, @CONDITION@]] = #[@AUTHORED@]
const @NAME@_program: _behavior.Program [@ACTION@, @CONDITION@] = do:
  let $Some program = _behavior.program @VERSION@ @ENTRY@ (copy @NAME@_nodes) else:
    break panic "invalid generated behavior program"
  break program
func @NAME@_advance (state: _behavior.State @LOCAL@) -> (destination_frames: own #[_behavior.Frame]) -> (destination_visited: own #[U32]) -> (seconds: F32) -> (budget: U32) -> (max_frames: U32) : (Maybe (_behavior.Advanced @LOCAL@), #[_behavior.Frame]) =>
  if state.version != @VERSION@ or not (is_finite seconds) or seconds < 0.0:
    return ($Nothing, destination_frames)
  if destination_frames.length > max_frames or not (is_finite state.elapsed) or state.elapsed < 0.0:
    return ($Nothing, destination_frames)
  let remaining = seconds
  let transitions = 0
  let visited: #[U32] = #[]
  let frames: #[_behavior.Frame] = copy destination_frames
  if _behavior.terminal state.status:
    return _behavior.publish destination_frames destination_visited state remaining transitions frames visited
  let step = state.step
  let age = state.elapsed
  let local_value = state.local
  let status = $_behavior.Running
  let waiting = false
  for used in 0 .. budget:
    if waiting or _behavior.terminal status:
      break
    let elapsed = age + remaining
    if not (is_finite elapsed):
      return ($Nothing, destination_frames)
    case step of
@ARMS@
      _ => do:
        return ($Nothing, destination_frames)
  if not waiting and not (_behavior.terminal status):
    status := $_behavior.Budget
  return _behavior.publish destination_frames destination_visited ($_behavior.State {version: state.version, step, elapsed: age, local: local_value, status}) remaining transitions frames visited
