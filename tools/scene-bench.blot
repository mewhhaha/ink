import * as owned from "../examples/physics_owners"
import * as array from "std/array"
import { Vec3 } from "std/vector"
import * as math from "ink/math"
import * as physics from "ink/physics"
import * as scene from "ink/scene"

func vec (x: F32) => func (y: F32) => func (z: F32) => $Vec3 { x, y, z }
func collider (kind: U32) => $scene.Collider {
  shape: if kind == 0 then $scene.Box else if kind == 1 then $scene.Brush else $scene.Sphere,
  size: vec 1.2 1.0 0.8,
  radius: 0.55,
  height: 1.4,
  offset: math.zero3,
  friction: 0.6,
  restitution: 0.0,
  layer: 1,
  mask: 65535,
  trigger: false,
}

const cube_planes = #[
  $math.Vec4 { x: 1.0, y: 0.0, z: 0.0, w: 0.6 },
  $math.Vec4 { x: (-1.0), y: 0.0, z: 0.0, w: 0.6 },
  $math.Vec4 { x: 0.0, y: 1.0, z: 0.0, w: 0.5 },
  $math.Vec4 { x: 0.0, y: (-1.0), z: 0.0, w: 0.5 },
  $math.Vec4 { x: 0.0, y: 0.0, z: 1.0, w: 0.4 },
  $math.Vec4 { x: 0.0, y: 0.0, z: (-1.0), w: 0.4 },
]

func source (index: U32) => func (static_count: U32) => func (kind: U32) =>
  let i = U32.to_f32 index
  // Incommensurate strides produce a repeatable, non-axis-aligned 3D spread.
  let x = index % 97
  let y = (index * 37) % 89
  let z = (index * 53) % 83
  let position = vec (U32.to_f32 x * 2.7 - 129.6) (U32.to_f32 y * 2.3 - 101.2) (U32.to_f32 z * 2.9 - 118.9)
  let is_mover = index >= static_count
  let rigid = if is_mover then $Some ($scene.Rigid {
    kind: $scene.Kinematic,
    mass: 1.0,
    gravity_scale: 0.0,
    linear_damping: 0.0,
    angular_damping: 0.0,
    can_sleep: false,
    continuous: false,
    linear_velocity: math.zero3,
    angular_velocity: math.zero3,
    sleeping: false,
    sleep_time: 0.0,
  }) else $Nothing
  return $scene.Source {
    index,
    id: index + 1,
    position,
    rotation: math.yaw_pitch (i * 0.013) (i * 0.007),
    scale: math.one3,
    collider: $Some (collider kind),
    rigid,
    walker: $Nothing,
    planes: if kind == 1 then cube_planes.view 0 cube_planes.length else cube_planes.view 0 0,
  }

func sources (count: U32) => func (kind: U32) => @array.generate (count + 4) (func (i: U32) => source i count kind)
func with_scene_of (count: U32) -> (kind: U32) -> consume =>
  let values = sources count kind
  return owned.with_scene values consume

func checksum_scene (sc: scene.Scene) =>
  let sum = U32.to_f32 sc.proxies.length
  for proxy in sc.proxies:
    sum := self + U32.to_f32 proxy.id * 0.0001 + proxy.low.x * 0.000001 + proxy.high.z * 0.000001
  return sum

func query_batch (sc: scene.Scene) => func (count: U32) => func (rounds: U32) => func (offset: U32) =>
  let ray_sum = 0.0
  let overlap_sum = 0.0
  let ray_hit_count = 0.0
  let ray_miss_count = 0.0
  let overlap_hit_count = 0.0
  let overlap_miss_count = 0.0
  for r in 0..rounds:
    let q = r + offset
    let target = (q * 7919 + 127) % count
    let target_i = U32.to_f32 target
    let tx = U32.to_f32 (target % 97) * 2.7 - 129.6
    let ty = U32.to_f32 ((target * 37) % 89) * 2.3 - 101.2
    let tz = U32.to_f32 ((target * 53) % 83) * 2.9 - 118.9
    let aim = vec tx ty tz
    let direction = vec 0.713 0.391 (-0.582)
    let hit_origin = aim - direction * 4.0
    let miss_origin = vec 9000.0 (9000.0 + target_i) (-9000.0)
    let hit = physics.ray sc hit_origin direction 8.0 1 0
    let miss = physics.ray sc miss_origin direction 8.0 1 0
    let hit_value = case hit of
      $Some h => U32.to_f32 h.id + h.distance * 0.01 + h.normal.x * 0.001
      $Nothing => 0.0
    let miss_value = case miss of
      $Some h => U32.to_f32 h.id + h.distance * 0.01
      $Nothing => 0.0
    let hit_present = case hit of
      $Some _ => 1.0
      $Nothing => 0.0
    let miss_present = case miss of
      $Some _ => 1.0
      $Nothing => 0.0
    ray_sum := self + hit_value + miss_value
    ray_hit_count := self + hit_present + miss_present
    ray_miss_count := self + 2.0 - hit_present - miss_present
    let overlapping = physics.overlap_sphere sc aim 1.0 1
    let absent = physics.overlap_sphere sc miss_origin 1.0 1
    let has_overlap = if overlapping.length > 0 then 1.0 else 0.0
    let has_absent = if absent.length == 0 then 1.0 else 0.0
    overlap_hit_count := self + has_overlap
    overlap_miss_count := self + has_absent
    let overlap_value = if overlapping.length > 0 then U32.to_f32 overlapping[0] * 0.0001 else 0.0
    overlap_sum := self + U32.to_f32 overlapping.length * 0.25 + U32.to_f32 absent.length + overlap_value
  return #[ray_sum, overlap_sum, ray_hit_count, ray_miss_count, overlap_hit_count, overlap_miss_count]

entry func build (a: #[F32]) =>
  let count = F32.to_u32 a[0]
  let kind = F32.to_u32 a[1]
  return with_scene_of count kind (func sc => #[checksum_scene sc])

// Both batches share a scene. The host estimates query cost by subtracting a
// paired build-only call; construction jitter remains visible in the report.
entry func queries (a: #[F32]) =>
  let count = F32.to_u32 a[0]
  let kind = F32.to_u32 a[1]
  return with_scene_of count kind (func sc =>
    let sum = checksum_scene sc
    let baseline = query_batch sc count (F32.to_u32 a[2]) 0
    let extended = query_batch sc count (F32.to_u32 a[3]) 37
    return array.concat #[sum] (array.concat baseline extended))

func static_checksum (sc: scene.Scene) => func (static_count: U32) =>
  let sum = 0.0
  for proxy in sc.proxies:
    if proxy.source < static_count:
      sum := self + U32.to_f32 proxy.id * 0.0001 + proxy.low.x * 0.000001 + proxy.high.z * 0.000001
  return sum

func mover_checksum (sc: scene.Scene) => func (static_count: U32) =>
  let sum = 0.0
  for proxy in sc.proxies:
    if proxy.source >= static_count:
      sum := self + U32.to_f32 proxy.id * 0.0001 + proxy.low.x * 0.001 + proxy.low.y * 0.001 + proxy.low.z * 0.001
  return sum

entry func refresh (a: #[F32]) =>
  let count = F32.to_u32 a[0]
  let kind = F32.to_u32 a[1]
  let rounds = F32.to_u32 a[2]
  let src = sources count kind
  return owned.with_scene src (func (own previous) =>
    let src = src.copy
    let static_before = static_checksum previous count
    let movers_before = mover_checksum previous count
    for step in 0..rounds:
      for mover in 0..4:
        let index = count + mover
        let item = src[index]
        let amount = U32.to_f32 (step + mover + 1) * 0.013
        item.position := self + vec amount (amount * (-0.7)) (amount * 0.4)
        src[index] := item
      previous := scene.update src previous #[count, count + 1, count + 2, count + 3]
    return #[static_before, static_checksum previous count, movers_before, mover_checksum previous count, checksum_scene previous])

entry func noop (a: #[F32]) => #[a[0] + 1.0]
