diff --git a/crates/pen-protocol/tests/instances.rs b/crates/pen-protocol/tests/instances.rs
new file mode 100644
index 0000000..c0fcf82
--- /dev/null
+++ b/crates/pen-protocol/tests/instances.rs
@@ -0,0 +1,25 @@
+use pen_protocol::Catalog;
+use pen_protocol::boundary::*;
+#[test]
+fn instance_fields_are_bounded_and_every_truncation_is_rejected() {
+    let catalog = Catalog { meshes: vec!["mesh".into()], materials: vec!["mat".into()], sounds: vec![] };
+    let mut packet = vec![0.0; PACKET_HEADER_FLOATS + INSTANCE_FLOATS + INSTANCE_REMOVAL_FLOATS];
+    packet[0] = PACKET_MAGIC;
+    packet[1] = 1.0;
+    packet[lanes::header::RETAINED_ENABLED] = 1.0;
+    packet[lanes::header::RETAINED_RESET] = 1.0;
+    packet[lanes::header::INSTANCE_COUNT] = 1.0;
+    packet[lanes::header::INSTANCE_REMOVAL_COUNT] = 1.0;
+    packet[PACKET_HEADER_FLOATS] = 65535.0;
+    packet[PACKET_HEADER_FLOATS + 1] = 65535.0;
+    let decoded = decode_frame(&packet, 1, &catalog).unwrap();
+    assert_eq!(decoded.render.instances[0].id_high, 65535);
+    for end in 0..packet.len() {
+        assert!(decode_frame(&packet[..end], 1, &catalog).is_err());
+    }
+    for (offset, value) in [(0, 65536.0), (1, -1.0), (2, 16777216.0), (3, 1.0), (4, 1.0), (5, f32::NAN), (21, 3.0)] {
+        let mut bad = packet.clone();
+        bad[PACKET_HEADER_FLOATS + offset] = value;
+        assert!(decode_frame(&bad, 1, &catalog).is_err(), "offset {offset}");
+    }
+}
