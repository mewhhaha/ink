+import * as output from "game/output"
+import * as array from "std/array"
+import * as station from "game/station"
+import * as trace from "game/shop_trace"
+import * as ui from "ink/ui"
+import * as math from "ink/math"
+import { Vec2 } from "std/vector"
+import * as check from "test/support/check"
+const original_box = fn (w: F32) (h: F32) (x: F32) (y: F32) (reserved: F32) (first_height: F32) => do:
+  let screen = station.scale w h
+  let s = screen * 0.8
+  let width = 536.0 * s
+  let box = #ui.Rect { x: clamp (20.0 * s) (w - width - 20.0 * s) (x - width * 0.5),
+    y: max (160.0 * screen) (y - (reserved + 36.0) * s), width, height: reserved * s }
+  // Tall station lists cannot always fit above the chimney. Move beside it
+  // rather than covering the anchor and losing the connection to the building.
+  if box.y + box.height > y - 36.0 * s:
+    // Stay beside the roof dot, with only a short connector to the panel.
+    let beside = if x > w * 0.5 then x - width - 32.0 * s else x + 32.0 * s
+    box.x := clamp (20.0 * s) (w - width - 20.0 * s) beside
+    // Reserve below the HUD too, so later upward growth cannot cover the
+    // level bar or make already visible purchase rows change position.
+    box.y := clamp (148.0 * screen) (h - reserved * s - 24.0 * s) (y - 60.0 * s - (reserved - first_height) * s)
+  return box
+
+const original_head = fn (trace: trace.Trace) => fn (distance: F32) -> Vec2 => do:
+  let vertical = abs (trace.join.y - trace.origin.y)
+  if distance < vertical:
+    return math.vec2 trace.origin.x (trace.origin.y + (trace.join.y - trace.origin.y) * distance / max 0.001 vertical)
+  if distance < trace.stem:
+    return math.vec2 (trace.origin.x + (trace.join.x - trace.origin.x) * (distance - vertical) / max 0.001 (trace.stem - vertical)) trace.join.y
+  let r = trace.radius
+  let h = trace.box.width - 2.0 * r
+  let v = trace.box.height - 2.0 * r
+  let q = r * pi * 0.5
+  let t = wrap trace.loop (trace.start + distance - trace.stem)
+  let placed = fn (at: Vec2) => at + math.vec2 trace.box.x trace.box.y
+  if t < h:
+    return placed (math.vec2 (r + t) 0.0)
+  if t < h + q:
+    let a = (t - h) / r
+    return placed (math.vec2 (trace.box.width - r + sin a * r) (r - cos a * r))
+  if t < h + q + v:
+    return placed (math.vec2 trace.box.width (r + t - h - q))
+  if t < h + 2.0 * q + v:
+    let a = (t - h - q - v) / r
+    return placed (math.vec2 (trace.box.width - r + cos a * r) (trace.box.height - r + sin a * r))
+  if t < 2.0 * h + 2.0 * q + v:
+    return placed (math.vec2 (trace.box.width - r - (t - h - 2.0 * q - v)) trace.box.height)
+  if t < 2.0 * h + 3.0 * q + v:
+    let a = (t - 2.0 * h - 2.0 * q - v) / r
+    return placed (math.vec2 (r - sin a * r) (trace.box.height - r + cos a * r))
+  if t < 2.0 * h + 3.0 * q + 2.0 * v:
+    return placed (math.vec2 0.0 (trace.box.height - r - (t - 2.0 * h - 3.0 * q - v)))
+  let a = (t - 2.0 * h - 3.0 * q - 2.0 * v) / r
+  return placed (math.vec2 (r - cos a * r) (r - sin a * r))
+
+entry const test_shared_layout_preserves_panel_policy_and_trace_positions = fn () => do:
+  let checks = #[]
+  for width in #[640.0,960.0,1280.0,1920.0]:
+    for height in #[480.0,720.0,1080.0]:
+      for x in #[width*0.1,width*0.5,width*0.9]:
+        for y in #[height*0.1,height*0.5,height*0.9]:
+          for reserved in #[126.0,396.0,550.0]:
+            let a = original_box width height x y reserved 72.0
+            let b = station.anchored_box width height x y reserved 72.0
+            checks := array.push (check.near 0.001 #[a.x,a.y,a.width,a.height] #[b.x,b.y,b.width,b.height]) self
+  let box = #ui.Rect {x:40.0,y:80.0,width:536.0,height:396.0}
+  for x in #[0.0,300.0,700.0]:
+    for y in #[0.0,300.0,700.0]:
+      let t = trace.make box x y 0.5
+      for i in 0 .. 100:
+        let d = (t.stem+t.loop)*from i/99.0
+        let a = original_head t d
+        let b = trace.head t d
+        checks := array.push (check.near 0.001 #[a.x,a.y] #[b.x,b.y]) self
+  return check.report checks
+
+// Independent age-based reference for the timestamp migration. Binary-exact
+// steps exercise expiry, pauses, counter resets and many clock-origin shifts.
+type OldSample is data = #OldSample { age: F32, values: Array U32 }
+type OldRates is data = #OldRates { samples: Array OldSample, rates: Array F32 }
+const old_empty = #OldRates {samples:#[],rates:#[0.0,0.0]}
+const old_rates = fn (seconds: F32) (counts: Array U32) (kept: OldRates) => do:
+  if kept.samples.length > 0 && array.any (fn index => counts[index] < kept.samples[0].values[index]) (array.generate counts.length identity):
+    kept := old_empty
+  kept.samples := #[#OldSample {age:sample.age+seconds,values:sample.values} | sample <- self, sample.age+seconds <= 10.0]
+  if kept.samples.length == 0 || kept.samples[kept.samples.length-1].age >= 0.25:
+    kept.samples := array.push (#OldSample {age:0.0,values:counts}) self
+  let first = kept.samples[0]
+  kept.rates := array.generate counts.length (fn index => from (counts[index]-first.values[index]) / max 1.0 first.age)
+  return kept
+entry const test_shared_history_preserves_rates_through_expiry_pause_reset_and_rebase = fn () => do:
+  let old = old_empty
+  let next = output.empty
+  let valid = #True
+  for i in 0 .. 1600:
+    let dt = if i % 7 == 0 then 0.0 else 0.125
+    let counts = #[i%400, 0xFFFF0000 + (i%400)*3]
+    old := old_rates dt counts self
+    next := output.advanced dt counts self
+    valid := self && old.rates[0] == next.rates[0] && old.rates[1] == next.rates[1]
+  return check.report #[check.holds valid,check.holds (next.now < 16.0)]
