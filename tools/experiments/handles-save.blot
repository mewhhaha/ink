import * as h from "ink/handles"
import * as array from "std/array"
type Item is data = $Item
func encode_value (v: U32) => array.generate (v % 5) (func i => v + i)
func decode_value (words: #[U32]) => if words.length == 0 then $Some 0 else $Some words[0]
func with_store count -> run =>
  let rows: #[~U32] = #[]
  let store = h.store $Item rows
  let owners: #[~U32] = #[]
  let slots: #[~h.Slot] = #[]
  let free: #[~U32] = #[]
  let meta = h.metadata 7 11 0xFFFFFFFF
  for value in 0 .. count:
    let $Some id = h.insert $Item value store owners slots free meta else:
      return panic "dense handle fixture capacity exhausted"
  return run store owners slots free meta
entry func save (count: U32) => with_store count (func store -> owners -> slots -> free -> meta => return
  h.encode encode_value store owners slots free meta)
entry func roundtrip (count: U32) => with_store count (func store -> owners -> slots -> free -> meta =>
  let saved = h.encode encode_value store owners slots free meta
  let restored_rows: #[~U32] = #[]
  let restored = h.store $Item restored_rows
  let restored_owners: #[~U32] = #[]
  let restored_slots: #[~h.Slot] = #[]
  let restored_free: #[~U32] = #[]
  let restored_meta = h.metadata 0 0 0
  if not (h.decode $Item decode_value saved restored restored_owners restored_slots restored_free restored_meta):
    return #[]
  return h.encode encode_value restored restored_owners restored_slots restored_free restored_meta)
