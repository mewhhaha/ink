import * as h from "ink/handles"
import * as array from "std/array"
type Item is data = $Item
const encode_value = func (v: U32) => return array.generate (v % 5) (func i => return v + i)
const decode_value = func (words: Array U32) => return if words.length == 0 then $Some 0 else $Some words[0]
const with_store = func count -> run => return do:
  let rows: ResizeArray U32 = #[]
  let store = h.store $Item rows
  let owners: ResizeArray U32 = #[]
  let slots: ResizeArray h.Slot = #[]
  let free: ResizeArray U32 = #[]
  let meta = h.metadata 7 11 0xFFFFFFFF
  for value in 0 .. count:
    let $Some id = h.insert $Item value store owners slots free meta else:
      return @panic "dense handle fixture capacity exhausted"
  return run store owners slots free meta
entry const save = func (count: U32) => return with_store count (func store -> owners -> slots -> free -> meta => return
  h.encode encode_value store owners slots free meta)
entry const roundtrip = func (count: U32) => return with_store count (func store -> owners -> slots -> free -> meta => return do:
  let saved = h.encode encode_value store owners slots free meta
  let restored_rows: ResizeArray U32 = #[]
  let restored = h.store $Item restored_rows
  let restored_owners: ResizeArray U32 = #[]
  let restored_slots: ResizeArray h.Slot = #[]
  let restored_free: ResizeArray U32 = #[]
  let restored_meta = h.metadata 0 0 0
  if Bool.not (h.decode $Item decode_value saved restored restored_owners restored_slots restored_free restored_meta):
    return #[]
  return h.encode encode_value restored restored_owners restored_slots restored_free restored_meta)
