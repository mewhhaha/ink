import * as h from "ink/handles"
import * as array from "std/array"
type Item is data = #Item
const encode_value = fn (v: U32) => array.generate (v % 5) (fn i => v + i)
const decode_value = fn (words: Array U32) => if words.length == 0 then #Some 0 else #Some words[0]
entry const save = fn (count: U32) => do:
  let (store, _) = h.from_dense #Item 7 11 (array.generate count identity)
  return h.encode encode_value store
entry const roundtrip = fn (count: U32) => do:
  let (store, _) = h.from_dense #Item 7 11 (array.generate count identity)
  let #Some restored = h.decode #Item decode_value (h.encode encode_value store) else:
    return #[]
  return h.encode encode_value restored
