import * as array from "std/array"

// Historical regression: compiler fd2119f5 corrupted inferred generic rows.
// Both controls retain their original fields and use a caller-named queue owner.
type Ticket is data = $Ticket { epoch: U32, sequence: U32 }
type State value is data = $Pending | $Ready value
type Row [request, value, local] is data = $Row {ticket: Ticket, request: request, continuation: local, state: State value}
type Queue [request, value, local] is data = $Queue {rows: #[~Row [request,value,local]], next: U32}
func check (actual: #[U32]) =>
  let expected = #[42,17,1]
  let valid = actual.length == expected.length
  for i in 0 .. min actual.length expected.length:
    valid := self and actual[i] == expected[i]
  if valid:
    return #[1.0,0.0]
  return array.concat #[1.0,1.0,1.0,3.0,42.0,17.0,1.0,3.0] (array.map U32.to_f32 actual)
func batch (requests: #[request]) -> (locals: #[local]) -> (q: Queue [request,value,local]) =>
  let tickets = array.generate requests.length (func i => $Ticket {epoch: 1, sequence: q.next + i})
  let rows = array.generate requests.length (func i => $Row {ticket: tickets[i], request: requests[i], continuation: locals[i], state: $Pending})
  let destination: #[~Row [request,value,local]] = q.rows
  for row in rows:
    destination.push row
  return q
func batch_annotated (requests: #[request]) -> (locals: #[local]) -> (q: Queue [request,value,local]) =>
  let tickets: #[Ticket] = array.generate requests.length (func i => $Ticket {epoch: 1, sequence: q.next + i})
  let rows: #[Row [request,value,local]] = array.generate requests.length (func (i: U32) : Row [request,value,local] => return
    $Row {ticket: tickets[i], request: requests[i], continuation: locals[i], state: $Pending})
  let destination: #[~Row [request,value,local]] = q.rows
  for row in rows:
    destination.push row
  return q
entry func test_inferred_rows () =>
  let rows: #[~Row [U32,U32,U32]] = #[]
  let q: Queue [U32,U32,U32] = $Queue {rows, next: 1}
  let result = batch #[42] #[17] q
  return check #[result.rows[0].request, result.rows[0].continuation, result.rows[0].ticket.sequence]
entry func test_annotated_rows () =>
  let rows: #[~Row [U32,U32,U32]] = #[]
  let q: Queue [U32,U32,U32] = $Queue {rows, next: 1}
  let result = batch_annotated #[42] #[17] q
  return check #[result.rows[0].request, result.rows[0].continuation, result.rows[0].ticket.sequence]
