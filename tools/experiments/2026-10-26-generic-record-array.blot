import * as array from "std/array"

// Compiler reduction: the inferred generic array corrupts its nominal rows on
// compiler fd2119f5; the explicitly annotated construction remains correct.
type Ticket is data = $Ticket { epoch: U32, sequence: U32 }
type State value is data = $Pending | $Ready value
type Row [request, value, local] is data = $Row {ticket: Ticket, request: request, continuation: local, state: State value}
type Queue [request, value, local] is data = $Queue {rows: Array (Row [request,value,local]), next: U32}
const check = func (actual: Array U32) => return do:
  let expected = #[42,17,1]
  let valid = actual.length == expected.length
  for i in 0 .. min actual.length expected.length:
    valid := self && actual[i] == expected[i]
  if valid:
    return #[1.0,0.0]
  return array.concat #[1.0,1.0,1.0,3.0,42.0,17.0,1.0,3.0] (array.map U32.to_f32 actual)
const batch = func (requests: Array request) -> (locals: Array local) -> (q: Queue [request,value,local]) => return do:
  let tickets = array.generate requests.length (func i => return $Ticket {epoch: 1, sequence: q.next + i})
  let rows = array.generate requests.length (func i => return $Row {ticket: tickets[i], request: requests[i], continuation: locals[i], state: $Pending})
  q.rows := array.concat self rows
  return q
const batch_annotated = func (requests: Array request) -> (locals: Array local) -> (q: Queue [request,value,local]) => return do:
  let tickets: Array Ticket = array.generate requests.length (func i => return $Ticket {epoch: 1, sequence: q.next + i})
  let rows: Array (Row [request,value,local]) = array.generate requests.length (func (i: U32) : Row [request,value,local] => return
    $Row {ticket: tickets[i], request: requests[i], continuation: locals[i], state: $Pending})
  q.rows := array.concat self rows
  return q
entry const test_inferred_rows = func () => return do:
  let q: Queue [U32,U32,U32] = $Queue {rows: #[], next: 1}
  let result = batch #[42] #[17] q
  return check #[result.rows[0].request, result.rows[0].continuation, result.rows[0].ticket.sequence]
entry const test_annotated_rows = func () => return do:
  let q: Queue [U32,U32,U32] = $Queue {rows: #[], next: 1}
  let result = batch_annotated #[42] #[17] q
  return check #[result.rows[0].request, result.rows[0].continuation, result.rows[0].ticket.sequence]
