import * as array from "std/array"
import * as simd from "std/simd"
import * as batch from "./general-motion-batches"
type Old is data = $Old { id: U32, x: F32, z: F32, count: U32, turn: F32, lift: F32, fall: F32, jolt: F32, credited: U32 }
type Row = { id: U32, x: F32, z: F32, count: U32, turn: F32, lift: F32, fall: F32, jolt: F32, credited: U32 }
func input count => return array.generate count (func i => return $Old { id: i, x: U32.to_f32 (i % 37), z: U32.to_f32 (i / 37), count: 40, turn: 0.125,
  lift: if i % 10 == 0 then 1.0 else 0.0, fall: 0.4, jolt: if i % 10 == 1 then 0.3 else 0.0, credited: 7 })
func packed (a: Old) : Row => return { id: a.id, x: a.x, z: a.z, count: a.count, turn: a.turn, lift: a.lift, fall: a.fall, jolt: a.jolt, credited: a.credited }
func old_step (seconds: F32) -> (stack: Old) => return do:
  if seconds >= 0.0 and stack.lift <= 0.0 and stack.jolt == 0.0:
    return stack
  stack.jolt := max 0.0 (self - seconds)
  if stack.lift <= 0.0:
    return stack
  stack.fall := self + 24.0 * seconds
  stack.lift := self - stack.fall * seconds
  if stack.lift <= 0.0:
    stack.lift := 0.0
    stack.fall := 0.0
    stack.jolt := 0.6
  return stack
func step (seconds: F32) -> (stack: Row) => return do:
  if seconds >= 0.0 and stack.lift <= 0.0 and stack.jolt == 0.0:
    return stack
  let jolt = max 0.0 (stack.jolt - seconds)
  if stack.lift <= 0.0:
    return { id: stack.id, x: stack.x, z: stack.z, count: stack.count, turn: stack.turn, lift: stack.lift, fall: stack.fall, jolt, credited: stack.credited }
  let (position, fall) = batch.integrate 24.0 seconds (-stack.lift) stack.fall
  let landed = position >= 0.0
  return { id: stack.id, x: stack.x, z: stack.z, count: stack.count, turn: stack.turn,
    lift: if landed then 0.0 else -position, fall: if landed then 0.0 else fall,
    jolt: if landed then 0.6 else jolt, credited: stack.credited }
func finish seconds -> (stack: Row) -> position -> fall => return do:
  let falling = stack.lift > 0.0
  let landed = falling and position >= 0.0
  return { id: stack.id, x: stack.x, z: stack.z, count: stack.count, turn: stack.turn,
    lift: if landed then 0.0 else if falling then -position else stack.lift,
    fall: if landed then 0.0 else if falling then fall else stack.fall,
    jolt: if landed then 0.6 else max 0.0 (stack.jolt - seconds), credited: stack.credited }
func step4 seconds -> (a: Row) -> (b: Row) -> (c: Row) -> (d: Row) => return do:
  let ((p0,p1,p2,p3),(v0,v1,v2,v3)) = batch.integrate4 24.0 seconds
    (-a.lift,-b.lift,-c.lift,-d.lift) (a.fall,b.fall,c.fall,d.fall)
  return (finish seconds a p0 v0, finish seconds b p1 v1, finish seconds c p2 v2, finish seconds d p3 v3)
func packed_output (rows: Array Row) : Array F32 => return array.generate (rows.length * 9) (func index => return do:
  let r = rows[index / 9]
  return case index % 9 of
    0 => U32.to_f32 r.id
    1 => r.x
    2 => r.z
    3 => U32.to_f32 r.count
    4 => r.turn
    5 => r.lift
    6 => r.fall
    7 => r.jolt
    _ => U32.to_f32 r.credited)
func old_output (rows: Array Old) : Array F32 => return array.generate (rows.length * 9) (func index => return do:
  let r = rows[index / 9]
  return case index % 9 of
    0 => U32.to_f32 r.id
    1 => r.x
    2 => r.z
    3 => U32.to_f32 r.count
    4 => r.turn
    5 => r.lift
    6 => r.fall
    7 => r.jolt
    _ => U32.to_f32 r.credited)
func old_work (count: U32) => return do:
  let rows: Array Old = input count
  for 0 .. 32:
    for i in 0 .. rows.length:
      rows[i] := old_step 0.016 rows[i]
  return old_output rows
func work change -> (count: U32) => return do:
  let rows: Array Row = array.map packed (input count)
  for 0 .. 32:
    change rows
  return packed_output rows
func scalar_step (rows: Array Row) => return do:
  for i in 0 .. rows.length:
    rows[i] := step 0.016 rows[i]
func columns_step (seconds: F32) -> (rows: Array Row) => return do:
  let input_positions = array.map (func (r: Row) => return -r.lift) rows
  let input_velocities = array.map (func (r: Row) => return r.fall) rows
  let positions = array.fill rows.length 0.0
  let velocities = array.fill rows.length 0.0
  batch.integrate_columns_into 24.0 seconds input_positions input_velocities positions velocities
  for i in 0 .. rows.length:
    rows[i] := finish seconds rows[i] positions[i] velocities[i]
entry func original (count: U32) => return old_work count
entry func packed_rows (count: U32) => return work scalar_step count
entry func vector (count: U32) => return work (batch.map4_into (step4 0.016) (step 0.016)) count
entry func sparse (count: U32) => return work (batch.map_where_into (func (r: Row) => return r.lift > 0.0 or r.jolt != 0.0) (step 0.016)) count
entry func columns (count: U32) => return work (columns_step 0.016) count
