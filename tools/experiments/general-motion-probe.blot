import * as array from "std/array"
import * as simd from "std/simd"
import * as batch from "./general-motion-batches"
type Old is data = #Old { id: U32, x: F32, z: F32, count: U32, turn: F32, lift: F32, fall: F32, jolt: F32, credited: U32 }
type Row = { id: U32, x: F32, z: F32, count: U32, turn: F32, lift: F32, fall: F32, jolt: F32, credited: U32 }
const input = fn count => array.generate count (fn i => #Old { id: i, x: U32.to_f32 (i % 37), z: U32.to_f32 (i / 37), count: 40, turn: 0.125,
  lift: if i % 10 == 0 then 1.0 else 0.0, fall: 0.4, jolt: if i % 10 == 1 then 0.3 else 0.0, credited: 7 })
const packed = fn (a: Old) -> Row => { id: a.id, x: a.x, z: a.z, count: a.count, turn: a.turn, lift: a.lift, fall: a.fall, jolt: a.jolt, credited: a.credited }
const old_step = fn (seconds: F32) (stack: Old) => do:
  if seconds >= 0.0 && stack.lift <= 0.0 && stack.jolt == 0.0:
    return stack
  stack.jolt := max 0.0 (self - seconds)
  if stack.lift <= 0.0:
    return stack
  stack.fall := self + 24.0 * seconds
  stack.lift := self - stack.fall * seconds
  if stack.lift <= 0.0:
    stack.lift := 0.0
    stack.fall := 0.0
    stack.jolt := 0.6
  return stack
const step = fn (seconds: F32) (stack: Row) => do:
  if seconds >= 0.0 && stack.lift <= 0.0 && stack.jolt == 0.0:
    return stack
  let jolt = max 0.0 (stack.jolt - seconds)
  if stack.lift <= 0.0:
    return { id: stack.id, x: stack.x, z: stack.z, count: stack.count, turn: stack.turn, lift: stack.lift, fall: stack.fall, jolt, credited: stack.credited }
  let (position, fall) = batch.integrate 24.0 seconds (-stack.lift) stack.fall
  let landed = position >= 0.0
  return { id: stack.id, x: stack.x, z: stack.z, count: stack.count, turn: stack.turn,
    lift: if landed then 0.0 else -position, fall: if landed then 0.0 else fall,
    jolt: if landed then 0.6 else jolt, credited: stack.credited }
const finish = fn seconds (stack: Row) position fall => do:
  let falling = stack.lift > 0.0
  let landed = falling && position >= 0.0
  return { id: stack.id, x: stack.x, z: stack.z, count: stack.count, turn: stack.turn,
    lift: if landed then 0.0 else if falling then -position else stack.lift,
    fall: if landed then 0.0 else if falling then fall else stack.fall,
    jolt: if landed then 0.6 else max 0.0 (stack.jolt - seconds), credited: stack.credited }
const step4 = fn seconds (a: Row) (b: Row) (c: Row) (d: Row) => do:
  let ((p0,p1,p2,p3),(v0,v1,v2,v3)) = batch.integrate4 24.0 seconds
    (-a.lift,-b.lift,-c.lift,-d.lift) (a.fall,b.fall,c.fall,d.fall)
  return (finish seconds a p0 v0, finish seconds b p1 v1, finish seconds c p2 v2, finish seconds d p3 v3)
const old_work = fn count => do:
  let rows = input count
  for 0 .. 32:
    rows := array.map (old_step 0.016) self
  return array.flatten (array.map (fn (r: Old) => #[U32.to_f32 r.id,r.x,r.z,U32.to_f32 r.count,r.turn,r.lift,r.fall,r.jolt,U32.to_f32 r.credited]) rows)
const work = fn change count => do:
  let rows = array.map packed (input count)
  for 0 .. 32:
    rows := change self
  return array.flatten (array.map (fn (r: Row) => #[U32.to_f32 r.id,r.x,r.z,U32.to_f32 r.count,r.turn,r.lift,r.fall,r.jolt,U32.to_f32 r.credited]) rows)
entry const original = old_work
entry const packed_rows = work (array.map (step 0.016))
entry const vector = work (batch.map4 (step4 0.016) (step 0.016))
entry const sparse = work (batch.map_where (fn (r: Row) => r.lift > 0.0 || r.jolt != 0.0) (step 0.016))
const columns_step = fn seconds (rows: Array Row) => do:
  let (positions, velocities) = batch.integrate_columns 24.0 seconds
    (array.map (fn (r: Row) => -r.lift) rows) (array.map (fn (r: Row) => r.fall) rows)
  return array.generate rows.length (fn i => finish seconds rows[i] positions[i] velocities[i])
entry const columns = work (columns_step 0.016)
