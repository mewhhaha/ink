diff --git a/tests/salt_motion.blot b/tests/salt_motion.blot
new file mode 100644
--- /dev/null
+++ b/tests/salt_motion.blot
@@ -0,0 +1,46 @@
+import * as salt from "game/salt"
+import * as array from "std/array"
+import * as codec from "ink/codec"
+import * as check from "test/support/check"
+
+const reference = fn seconds (stack: salt.Stack) => do:
+  if seconds >= 0.0 && stack.lift <= 0.0 && stack.jolt == 0.0:
+    return stack
+  stack.jolt := max 0.0 (self - seconds)
+  if stack.lift <= 0.0:
+    return stack
+  stack.fall := self + salt.gravity * seconds
+  stack.lift := self - stack.fall * seconds
+  if stack.lift <= 0.0:
+    stack.lift := 0.0
+    stack.fall := 0.0
+    stack.jolt := salt.jolt_time
+  return stack
+const words = fn (s: salt.Stack) => #[s.id, codec.float_word s.x, codec.float_word s.z, s.count,
+  codec.float_word s.turn, codec.float_word s.lift, codec.float_word s.fall, codec.float_word s.jolt, s.credited]
+const same_bits = fn (a: Array U32) (b: Array U32) => do:
+  if a.length != b.length:
+    return #False
+  for i in 0 .. a.length:
+    if a[i] != b[i]:
+      return #False
+  return #True
+entry const test_shared_integration_keeps_landing_rules_full_id_bits_and_old_snapshots = fn () => do:
+  let initial = array.generate 65 (fn i => do:
+    let row = salt.resting (U32.to_f32 i * 0.25) (-1.0) 40 0.5
+    row.id := 4294967295 - i
+    row.credited := i % 41
+    row.lift := if i % 3 == 0 then 0.0 else U32.to_f32 (i % 5) * 0.1
+    row.fall := if i % 2 == 0 then 0.0 else U32.to_f32 i * 0.125
+    row.jolt := if i % 7 == 0 then salt.jolt_time else 0.0
+    return row)
+  let saved = array.flatten (array.map words initial)
+  let expected = initial
+  let actual = initial
+  let valid = #True
+  for seconds in #[0.0, 0.016, 0.033, 0.4, -0.01, 0.0]:
+    expected := array.map (reference seconds) self
+    actual := salt.settle_all seconds self
+    valid := self && same_bits (array.flatten (array.map words expected)) (array.flatten (array.map words actual))
+  return check.report #[check.holds valid,
+    check.holds (same_bits saved (array.flatten (array.map words initial)))]
