 // A row of the trodden field after a stamp: its wear and its rest.
 type Row is data = #Row { wear: Array F32, rest: Array F32 }
 
+// Apply a row's overlapping footprints in their original order. Columns
+// outside those footprints retain their exact old samples and storage.
+const stamped_row = fn (z: F32) (stamps: Array Vec3) (row: Row) => do:
+  let wear = row.wear
+  let rest = row.rest
+  for stamp in stamps:
+    let (left, right) = reach stamp.x footprint
+    let dz = z - stamp.y
+    for column in left .. right + 1:
+      let x = shader.origin + U32.to_f32 column * shader.spacing
+      let shape = weight_at (x - stamp.x) dz
+      wear[column] := trodden_by self stamp.z shape
+      if shape > 0.0:
+        rest[column] := 0.0
+  break #Row { wear, rest }
+
 // Gather one movement stamp per grounded actor, then rebuild each affected
 // row once. This keeps large crowds from repeatedly copying the whole field.
