+//! Host-only provenance for a resolved retained draw list. It never crosses
+//! the packet boundary. Pointer identity detects skipped frames and new games.
+//! Clear this metadata if a host edits the resolved draw list independently.
+use std::sync::Arc;
+
+#[derive(Debug, Default, PartialEq)]
+pub struct DrawRevision;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct DrawChanges {
+    pub before: Arc<DrawRevision>,
+    pub after: Arc<DrawRevision>,
+    pub first: usize,
+    /// Sorted absolute draw indices. None means membership or ordering changed;
+    /// every retained slot is dirty.
+    pub changed: Option<Arc<[usize]>>,
+}
