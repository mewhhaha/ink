new file mode 100644
--- /dev/null
+++ b/crates/blot-host/examples/replay_cpu.rs
@@ -0,0 +1,153 @@
+//! Linux guest-thread CPU replay; validation and hashing are outside timings.
+use anyhow::{Result, ensure};
+use blot_host::{Argument, Guest, GuestModule, Value};
+use pen_protocol::boundary::{canonical_render, decode_frame, read_catalog};
+use pen_protocol::{Draw, RenderFrame};
+use pen_runtime::instances::Instances;
+use sha2::{Digest, Sha256};
+use std::{
+    path::Path,
+    sync::{Arc, Mutex},
+    time::Instant,
+};
+#[repr(C)]
+struct Timespec {
+    seconds: std::os::raw::c_long,
+    nanos: std::os::raw::c_long,
+}
+unsafe extern "C" {
+    fn clock_gettime(clock: std::os::raw::c_int, time: *mut Timespec) -> std::os::raw::c_int;
+}
+fn cpu() -> f64 {
+    let mut t = Timespec { seconds: 0, nanos: 0 };
+    // Linux CLOCK_THREAD_CPUTIME_ID; a writable timespec with the C layout.
+    assert_eq!(unsafe { clock_gettime(3, &mut t) }, 0);
+    t.seconds as f64 * 1000.0 + t.nanos as f64 / 1e6
+}
+fn bits(frame: &RenderFrame) -> Vec<u32> {
+    canonical_render(frame, 26, &[]).iter().map(|v| v.to_bits()).collect()
+}
+fn draw_key(draw: &Draw) -> Vec<u32> {
+    let mut frame = RenderFrame::default();
+    frame.draws.push(draw.clone());
+    bits(&frame)
+}
+fn normalize(frame: &mut RenderFrame) {
+    // Retained opaque piles are after immediate draws. Remap poses alongside
+    // a stable draw sort; compare every other field unchanged.
+    let mut ordered: Vec<_> = frame.draws.iter().enumerate().map(|(i, d)| (draw_key(d), i, d.clone())).collect();
+    ordered.sort_by(|a, b| a.0.cmp(&b.0));
+    let mut remap = vec![0; ordered.len()];
+    for (new, (_, old, _)) in ordered.iter().enumerate() {
+        remap[*old] = u32::try_from(new).unwrap();
+    }
+    for pose in &mut frame.poses {
+        pose.draw = remap[usize::try_from(pose.draw).unwrap()];
+    }
+    frame.draws = ordered.into_iter().map(|(_, _, d)| d).collect();
+    frame.retained_enabled = false;
+    frame.retained_reset = false;
+    frame.instances.clear();
+    frame.instance_removals.clear();
+    frame.draw_changes = None;
+}
+
+fn main() -> Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    ensure!((3..=4).contains(&args.len()), "replay_cpu WASM ASSETS OUTPUT.json [PACKETS]");
+    let packets = args.get(3).map(std::path::PathBuf::from);
+    if let Some(path) = &packets {
+        std::fs::create_dir_all(path)?;
+    }
+    let bytes = std::fs::read(&args[0])?;
+    let wasm = format!("{:x}", Sha256::digest(&bytes));
+    let engine = blot_host::engine()?;
+    let module = GuestModule::new(&engine, &bytes, None)?;
+    let catalog = read_catalog(Path::new(&args[1]))?;
+    let captured = Arc::new(Mutex::new(serde_json::Value::Null));
+    let output = captured.clone();
+    let mut phase = 0;
+    let mut tick = 0;
+    let mut schema = 0;
+    let mut started = 0.0;
+    let mut wall = Instant::now();
+    let mut samples = Vec::new();
+    let mut wall_samples = Vec::new();
+    let mut packet_bytes = Vec::new();
+    let mut cache = Instances::default();
+    let mut frame_hash = Sha256::new();
+    let mut updates = 0usize;
+    let mut removals = 0usize;
+    let callback = Box::new(move |value: Value| -> Result<Value> {
+        let duration = cpu() - started;
+        let wall_ms = wall.elapsed().as_secs_f64() * 1000.0;
+        let packet = value.into_f32_array()?;
+        let next = match phase {
+            0 => {
+                ensure!(packet[0] == 4670544.0, "handshake");
+                schema = packet[2] as u32;
+                if let Some(path) = &packets {
+                    std::fs::write(path.join("schema.txt"), schema.to_string())?;
+                }
+                phase = 1;
+                vec![1.0, 1.0]
+            }
+            1 => {
+                ensure!(packet[0] == 1.0, "create");
+                phase = 2;
+                vec![1.0, 2.0, 1.0 / 60.0, 1280.0, 720.0, 0.0, 0.0]
+            }
+            2 => {
+                ensure!(packet[0] == 2.0, "frame");
+                if tick < 120 {
+                    if let Some(path) = &packets {
+                        let raw: Vec<u8> = packet[1..].iter().flat_map(|v| v.to_le_bytes()).collect();
+                        std::fs::write(path.join(format!("{tick:04}.f32")), raw)?;
+                    }
+                }
+                let mut frame = decode_frame(&packet[1..], schema, &catalog)?.render;
+                updates += frame.instances.len();
+                removals += frame.instance_removals.len();
+                cache.prepare(&mut frame)?.commit(&mut cache);
+                normalize(&mut frame);
+                for word in bits(&frame) {
+                    frame_hash.update(word.to_le_bytes());
+                }
+                if tick >= 120 {
+                    samples.push(duration);
+                    wall_samples.push(wall_ms);
+                    packet_bytes.push(packet.len() * 4);
+                }
+                tick += 1;
+                if tick == 600 {
+                    phase = 3;
+                    vec![1.0, 3.0]
+                } else {
+                    vec![1.0, 2.0, 1.0 / 60.0, 1280.0, 720.0, 0.0, 0.0]
+                }
+            }
+            _ => {
+                ensure!(packet[0] == 3.0, "snapshot");
+                let saved: Vec<u8> = packet.iter().flat_map(|v| v.to_le_bytes()).collect();
+                let mut sorted = samples.clone();
+                sorted.sort_by(f64::total_cmp);
+                *output.lock().unwrap() = serde_json::json!({"cpuMs":samples,"wallMs":wall_samples,"medianCpuMs":sorted[sorted.len()/2],"p95CpuMs":sorted[sorted.len()*95/100],"p99CpuMs":sorted[sorted.len()*99/100],"frameSha256":format!("{:x}",frame_hash.clone().finalize()),"instanceUpdates":updates,"instanceRemovals":removals,"saveSha256":format!("{:x}",Sha256::digest(&saved)),"packetBytes":packet_bytes});
+                vec![1.0, 0.0]
+            }
+        };
+        started = cpu();
+        wall = Instant::now();
+        Ok(Value::ArrayF32(next))
+    });
+    let mut guest = Guest::new(&engine, &module)?;
+    guest.call("main", Argument::Callback(callback))?;
+    let memory = guest.memory_bytes();
+    let counters = guest.runtime_counters();
+    guest.dispose()?;
+    let mut result = captured.lock().unwrap().clone();
+    result["wasm"] = serde_json::json!(wasm);
+    result["memoryBytes"] = serde_json::json!(memory);
+    result["runtimeCounters"] = serde_json::json!(counters);
+    std::fs::write(&args[2], serde_json::to_vec_pretty(&result)?)?;
+    Ok(())
+}
