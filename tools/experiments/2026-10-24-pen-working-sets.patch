diff --git a/crates/blot-host/examples/compare_projection.rs b/crates/blot-host/examples/compare_projection.rs
new file mode 100644
--- /dev/null
+++ b/crates/blot-host/examples/compare_projection.rs
@@ -0,0 +1,55 @@
+//! Compare two compiler outputs with an independent scalar result witness.
+use anyhow::{Result, ensure};
+use blot_host::{Guest, GuestModule, Value};
+use serde_json::json;
+use sha2::{Digest, Sha256};
+use std::time::Instant;
+fn main() -> Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    ensure!(args.len() == 3, "compare_projection BASELINE.wasm CANDIDATE.wasm OUTPUT.json");
+    let engine = blot_host::engine()?;
+    let bytes = [std::fs::read(&args[0])?, std::fs::read(&args[1])?];
+    let modules = [GuestModule::new(&engine, &bytes[0], None)?, GuestModule::new(&engine, &bytes[1], None)?];
+    let mut guests = [Guest::new(&engine, &modules[0])?, Guest::new(&engine, &modules[1])?];
+    let mut output = vec![];
+    for count in [256u32, 1024, 4096] {
+        let mut sum = 0f32;
+        for _ in 0..32 {
+            for i in 0..count {
+                sum += i as f32;
+            }
+        }
+        let expected = vec![sum, 1.0];
+        let mut samples = [vec![], vec![]];
+        for round in 0..25 {
+            for mode in [round % 2, (round + 1) % 2] {
+                let before = Instant::now();
+                let actual = guests[mode].call("nested_read", Value::U32(count))?.into_f32_array()?;
+                let elapsed = before.elapsed().as_secs_f64() * 1000.;
+                ensure!(actual == expected, "scalar witness changed");
+                if round >= 4 {
+                    samples[mode].push(elapsed);
+                }
+            }
+        }
+        let median: Vec<_> = samples
+            .iter()
+            .map(|s| {
+                let mut s = s.clone();
+                s.sort_by(f64::total_cmp);
+                s[s.len() / 2]
+            })
+            .collect();
+        output.push(json!({"count":count,"medianMs":median,"samplesMs":samples,"witness":expected,"memoryBytes":[guests[0].memory_bytes(),guests[1].memory_bytes()]}));
+    }
+    for guest in &mut guests {
+        guest.dispose()?;
+    }
+    std::fs::write(
+        &args[2],
+        serde_json::to_vec_pretty(
+            &json!({"wasmSha256":bytes.iter().map(|b|format!("{:x}",Sha256::digest(b))).collect::<Vec<_>>(),"rows":output}),
+        )?,
+    )?;
+    Ok(())
+}
