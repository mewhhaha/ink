diff --git a/crates/pen-runtime/src/instances.rs b/crates/pen-runtime/src/instances.rs
new file mode 100644
--- /dev/null
+++ b/crates/pen-runtime/src/instances.rs
@@ -0,0 +1,219 @@
+//! Transactional retained draw state. Wire IDs contain two exact 16-bit lanes.
+use anyhow::{Result, ensure};
+use pen_protocol::{Draw, DrawChanges, DrawRevision, Instance, RenderFrame};
+use std::collections::{BTreeMap, BTreeSet};
+use std::sync::Arc;
+
+#[derive(Default)]
+pub struct Instances {
+    initialized: bool,
+    values: BTreeMap<u32, Instance>,
+    positions: BTreeMap<u32, usize>,
+    draws: Vec<Draw>,
+    revision: Arc<DrawRevision>,
+}
+pub struct Update {
+    enabled: bool,
+    reset: bool,
+    upserts: Vec<Instance>,
+    removals: Vec<u32>,
+    rebuilt: Option<(BTreeMap<u32, usize>, Vec<Draw>)>,
+    revision: Arc<DrawRevision>,
+}
+fn id(low: u32, high: u32) -> Result<u32> {
+    ensure!(low <= 65535 && high <= 65535, "invalid retained instance ID");
+    Ok(low | (high << 16))
+}
+fn draw(value: &Instance) -> Draw {
+    Draw {
+        mesh: value.mesh,
+        material: value.material,
+        transform: value.transform,
+        parameters: value.parameters,
+        extra: None,
+    }
+}
+impl Instances {
+    /// Prepare an independent candidate; rejection never edits accepted state.
+    pub fn prepare(&self, frame: &mut RenderFrame) -> Result<Update> {
+        let enabled = frame.retained_enabled;
+        ensure!(
+            enabled || (!frame.retained_reset && frame.instances.is_empty() && frame.instance_removals.is_empty()),
+            "disabled retained instances carry changes"
+        );
+        ensure!(
+            !enabled || frame.retained_reset || self.initialized,
+            "retained instances require a reset after create or restore"
+        );
+        let mut changed = BTreeSet::new();
+        let mut structural = frame.retained_reset;
+        for item in &frame.instances {
+            let key = id(item.id_low, item.id_high)?;
+            ensure!(changed.insert(key), "duplicate retained instance ID");
+            structural |= self.values.get(&key).is_none_or(|old| old.order != item.order);
+        }
+        let mut removals = Vec::with_capacity(frame.instance_removals.len());
+        for item in &frame.instance_removals {
+            let key = id(item.id_low, item.id_high)?;
+            ensure!(changed.insert(key), "duplicate retained instance ID");
+            structural |= self.values.contains_key(&key);
+            removals.push(key);
+        }
+        let revision = Arc::new(DrawRevision);
+        let mut rebuilt = None;
+        frame.draw_changes = None;
+        if enabled {
+            let first = frame.draws.len();
+            let dirty = if structural {
+                let mut ordered = Vec::new();
+                if !frame.retained_reset {
+                    ordered.extend(
+                        self.values
+                            .iter()
+                            .filter(|(key, _)| !changed.contains(key))
+                            .map(|(&key, value)| (value.order, key, value)),
+                    );
+                }
+                ordered.extend(
+                    frame.instances.iter().map(|value| (value.order, value.id_low | (value.id_high << 16), value)),
+                );
+                ensure!(ordered.len() + first <= 100_000, "too many retained and immediate draws");
+                ordered.sort_unstable_by_key(|(order, key, _)| (*order, *key));
+                let mut positions = BTreeMap::new();
+                let mut draws = Vec::with_capacity(ordered.len());
+                for (_, key, value) in ordered {
+                    positions.insert(key, draws.len());
+                    draws.push(draw(value));
+                }
+                frame.draws.extend_from_slice(&draws);
+                rebuilt = Some((positions, draws));
+                None
+            } else {
+                ensure!(self.draws.len() + first <= 100_000, "too many retained and immediate draws");
+                frame.draws.extend_from_slice(&self.draws);
+                let mut dirty = Vec::with_capacity(frame.instances.len());
+                for value in &frame.instances {
+                    let slot = self.positions[&(value.id_low | (value.id_high << 16))];
+                    frame.draws[first + slot] = draw(value);
+                    dirty.push(first + slot);
+                }
+                dirty.sort_unstable();
+                Some(Arc::from(dirty))
+            };
+            frame.draw_changes =
+                Some(DrawChanges { before: self.revision.clone(), after: revision.clone(), first, changed: dirty });
+        }
+        Ok(Update {
+            enabled,
+            reset: frame.retained_reset,
+            upserts: frame.instances.clone(),
+            removals,
+            rebuilt,
+            revision,
+        })
+    }
+}
+impl Update {
+    pub fn commit(self, cache: &mut Instances) {
+        if self.reset || !self.enabled {
+            cache.values.clear();
+            cache.positions.clear();
+            cache.draws.clear();
+        }
+        cache.initialized = self.enabled;
+        cache.revision = self.revision;
+        for key in self.removals {
+            cache.values.remove(&key);
+        }
+        for value in self.upserts {
+            let key = value.id_low | (value.id_high << 16);
+            if self.rebuilt.is_none()
+                && let Some(&slot) = cache.positions.get(&key)
+            {
+                cache.draws[slot] = draw(&value);
+            }
+            cache.values.insert(key, value);
+        }
+        if let Some((positions, draws)) = self.rebuilt {
+            cache.positions = positions;
+            cache.draws = draws;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pen_protocol::InstanceRemoval;
+    fn instance(id: u32, order: u32, x: f32) -> Instance {
+        let mut item = Instance { id_low: id & 65535, id_high: id >> 16, order, ..Instance::default() };
+        item.transform[12] = x;
+        item
+    }
+    #[test]
+    fn reset_deltas_removals_reordering_and_rejection_preserve_full_ids() {
+        let mut cache = Instances::default();
+        let delta = || RenderFrame { retained_enabled: true, ..RenderFrame::default() };
+        assert!(cache.prepare(&mut delta()).is_err());
+        let mut initial = delta();
+        initial.retained_reset = true;
+        initial.instances = vec![instance(u32::MAX, 0, -0.0), instance(16777217, 0, 2.0)];
+        cache.prepare(&mut initial).unwrap().commit(&mut cache);
+        assert_eq!(initial.draws[0].transform[12], 2.0);
+        assert_eq!(initial.draws[1].transform[12].to_bits(), (-0.0_f32).to_bits());
+        let snapshot = initial.clone();
+        let mut rejected = delta();
+        rejected.instances = vec![instance(16777217, 1, 99.0)];
+        let _uncommitted = cache.prepare(&mut rejected).unwrap();
+        let mut unchanged = delta();
+        cache.prepare(&mut unchanged).unwrap().commit(&mut cache);
+        assert_eq!(unchanged.draws, initial.draws);
+        let mut update = delta();
+        update.instances = vec![instance(16777217, 1, 7.0)];
+        cache.prepare(&mut update).unwrap().commit(&mut cache);
+        assert_eq!(update.draws[1].transform[12], 7.0);
+        assert_eq!(initial, snapshot);
+        let mut remove = delta();
+        remove.instance_removals = vec![InstanceRemoval { id_low: 65535, id_high: 65535 }];
+        cache.prepare(&mut remove).unwrap().commit(&mut cache);
+        assert_eq!(remove.draws.len(), 1);
+        let mut duplicate = delta();
+        duplicate.instances = vec![instance(1, 0, 0.0), instance(1, 0, 1.0)];
+        assert!(cache.prepare(&mut duplicate).is_err());
+        let mut clear = delta();
+        clear.retained_reset = true;
+        cache.prepare(&mut clear).unwrap().commit(&mut cache);
+        assert!(clear.draws.is_empty());
+        cache.prepare(&mut RenderFrame::default()).unwrap().commit(&mut cache);
+        assert!(cache.prepare(&mut delta()).is_err());
+    }
+    #[test]
+    fn dirty_slots_link_only_accepted_frames_and_include_immediate_offsets() {
+        let mut cache = Instances::default();
+        let mut initial = RenderFrame {
+            retained_enabled: true,
+            retained_reset: true,
+            instances: vec![instance(10, 0, 1.0), instance(20, 0, 2.0)],
+            ..RenderFrame::default()
+        };
+        cache.prepare(&mut initial).unwrap().commit(&mut cache);
+        let initial_revision = initial.draw_changes.as_ref().unwrap().after.clone();
+        let mut rejected =
+            RenderFrame { retained_enabled: true, instances: vec![instance(20, 0, 99.0)], ..RenderFrame::default() };
+        let _candidate = cache.prepare(&mut rejected).unwrap();
+        let mut accepted = RenderFrame {
+            retained_enabled: true,
+            draws: vec![Draw::default()],
+            instances: vec![instance(20, 0, 7.0)],
+            ..RenderFrame::default()
+        };
+        cache.prepare(&mut accepted).unwrap().commit(&mut cache);
+        let changes = accepted.draw_changes.as_ref().unwrap();
+        assert!(Arc::ptr_eq(&changes.before, &initial_revision));
+        assert!(!Arc::ptr_eq(&changes.before, &rejected.draw_changes.as_ref().unwrap().after));
+        assert_eq!(changes.first, 1);
+        assert_eq!(changes.changed.as_deref(), Some([2].as_slice()));
+        assert_eq!(accepted.draws[2].transform[12], 7.0);
+        assert_eq!(initial.draws[1].transform[12], 2.0);
+    }
+}
