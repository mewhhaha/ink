+import * as array from "std/array"
+import { Vec3 } from "std/vector"
+import * as spatial from "ink/spatial"
+import * as points from "ink/spatial/points"
+import * as salt from "./salt"
+type Search is data = #Search { positions: Array Vec3, index: spatial.Index }
+const empty = #Search { positions: #[], index: points.build #[] }
+const prepare = fn (previous: Search) (stacks: Array salt.Stack) => do:
+  let same = previous.positions.length == stacks.length
+  if same:
+    for i in 0 .. stacks.length:
+      if previous.positions[i].x != stacks[i].x || previous.positions[i].z != stacks[i].z:
+        same := #False
+        break
+  if same:
+    return previous
+  let positions = array.map (fn (stack: salt.Stack) => #Vec3 { x: stack.x, y: 0.0, z: stack.z }) stacks
+  return #Search { positions, index: points.build positions }
+const nearest = fn (search: Search) (_: Array salt.Stack) at => points.nearest search.index at
