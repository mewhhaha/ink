diff --git a/performance/modernize/batch_planning.blot b/performance/modernize/batch_planning.blot
new file mode 100644
--- /dev/null
+++ b/performance/modernize/batch_planning.blot
@@ -0,0 +1,12 @@
+import * as fixture from "../../test_support/path_plans"
+import * as packet from "ink/navigation/packet"
+import * as workers from "ink/pen/workers"
+import * as array from "std/array"
+// Coarse, pure route forecasts. Every input carries its complete geometry;
+// no mutable ECS state or inventory crosses to a worker.
+const jobs = fn () => array.generate 32 (fn i => array.concat #[from (i % 4)] (packet.encode (fixture.solids (i / 4))))
+entry const plan = fn (input: Array F32) => fixture.from_packet (array.slice 1 (input.length - 1) input) (from input[0])
+entry const sequential = fn () => array.flatten (array.map plan (jobs ()))
+entry const batch = fn (host: Array F32 -> Array F32 ! { Foreign }) => do:
+  use results <- workers.run host (jobs ())
+  return array.flatten results
