+import * as salt from "./salt"
+import * as trails from "./trails"
+import * as level from "./level"
+import { game } from "./game"
+
+const own = game level.start_camera level.editing level.seed level.roam
+const picked = fn hit => case hit of
+  #Some (index, distance) => #[from index, distance]
+  #Nothing => #[]
+
+entry const test_surface_tiles_cover_all_spline_neighbours_at_edges_and_world_bounds = fn () => do:
+  let checks = #[]
+  for x in #[(-100.0), (-48.0), (-40.5), (-40.0), (-39.5), 0.0, 47.5, 100.0]:
+    for z in #[(-100.0), (-40.5), (-40.0), (-39.5), 0.0, 100.0]:
+      for row in trails.surface_corner z .. trails.surface_corner z + 4:
+        for column in trails.surface_corner x .. trails.surface_corner x + 4:
+          let changed = array.fill trails.surface_tile_count #False
+          changed[(row / trails.surface_tile_size) * trails.surface_side + column / trails.surface_tile_size] := #True
+          let epoch = trails.surface_changed changed trails.fresh_surface
+          checks := array.push (check.holds (Bool.not (trails.same_surface_at trails.fresh_surface epoch x z))) self
+  break check.report checks
+
+entry const test_distant_terrain_edits_reuse_height_but_a_neighbour_edit_resamples_it = fn () => do:
+  let stack = salt.resting (-40.0) (-40.0) 8 0.6
+  let flat = fn (_: F32) (_: F32) => 0.0
+  let raised = fn (_: F32) (_: F32) => 0.25
+  let no_read = fn (_: F32) (_: F32) -> F32 => @panic "unaffected pile sampled terrain"
+  let first = salt.stack_pictures_terrain (#Some trails.fresh_surface) #True salt.no_pictures #[stack] flat 0.0
+  let dirty = array.fill trails.surface_tile_count #False
+  dirty[trails.surface_tile_count - 1] := #True
+  let far = trails.surface_changed dirty trails.fresh_surface
+  let reused = salt.stack_pictures_terrain (#Some far) #True first #[stack] no_read 0.0
+  dirty := array.fill trails.surface_tile_count #False
+  // The pile centre is in tile (1,1); its spline reaches back into (0,0).
+  dirty[0] := #True
+  let near = trails.surface_changed dirty far
+  let changed = salt.stack_pictures_terrain (#Some near) #True reused #[stack] raised 0.0
+  let restored = salt.stack_pictures_terrain (#Some trails.fresh_surface) #True changed #[stack] flat 0.0
+  break check.report #[
+    check.equal #[0.0, 0.25, 0.0] #[reused.stacks[0].ground, changed.stacks[0].ground, restored.stacks[0].ground],
+    check.equal #[0.0] #[first.stacks[0].ground],
+    check.holds (reused.chunks.length == 1 && changed.chunks.length == 1),
+  ]
+
+entry const test_replacing_wear_clearings_and_old_snapshots_advances_only_affected_tiles = fn () => do:
+  let (_, checks) = app.run own (app.create_world own ()) (fn () => do:
+    use original <- ecs.get #trails.Trails
+    use trails.replace (trails.tread 8.0 4.0 0.2 original)
+    use ground <- ecs.get #trails.Trails
+    use first <- ecs.get #trails.SurfaceEpoch
+    ground.rest := array.fill trails.cells (array.fill trails.cells 100.0)
+    ground.drift := array.fill trails.cells (array.fill trails.cells 0.5)
+    use trails.replace ground
+    use only_time <- ecs.get #trails.SurfaceEpoch
+    use trails.replace original
+    use restored <- ecs.get #trails.SurfaceEpoch
+    use clearings <- ecs.get #trails.Clearings
+    let edited = clearings
+    edited.bare := array.fill trails.cells trails.no_row
+    edited.bare[104][112] := 1.0
+    use trails.replace_clearings edited
+    use cleared <- ecs.get #trails.SurfaceEpoch
+    break #[
+      check.holds (derived.same_revision first.surface only_time.surface),
+      check.holds (Bool.not (trails.same_surface_at first restored 8.0 4.0)),
+      check.holds (trails.same_surface_at first restored (-40.0) (-40.0)),
+      check.holds (Bool.not (derived.same_revision restored.surface cleared.surface)),
+      check.holds (trails.same_surface_at first cleared (-40.0) (-40.0)),
+      check.holds (trails.same_surface_at first first 8.0 4.0),
+    ])
