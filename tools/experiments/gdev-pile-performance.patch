+        let ray = #math.Ray { origin: math.vec3 (8.0 + offset) 30.0 4.0, direction: math.vec3 0.0 (-1.0) 0.0 }
+        let expected = salt.stack_under rise ray town
+        use actual <- salt.cached_stack_under ray town
+        use repeated <- salt.cached_stack_under ray town
+        use cache <- ecs.get #salt.Picking
+        checks := array.concat self #[check.equal (picked expected) (picked actual), check.equal (picked expected) (picked repeated), check.holds (cache.queries.length <= 4)]
+    break checks)
+  break check.report checks
