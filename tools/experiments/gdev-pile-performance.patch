+    for mutation in 0 .. 8:
+      if mutation == 1:
+        town.stacks[0].lift := 4.0
+      if mutation == 2:
+        town.stacks[0].count := 12
+      if mutation == 3:
+        town.stacks[0].x := 20.0
+      if mutation == 4:
+        town.stacks := #[town.stacks[1], town.stacks[0]]
+      if mutation == 5:
+        use ground <- ecs.get #trails.Trails
+        use trails.replace (trails.tread 8.0 4.0 0.4 ground)
+      if mutation == 6:
