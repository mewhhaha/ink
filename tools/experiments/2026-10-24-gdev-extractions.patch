+entry const test_extracted_trajectory_preserves_brick_positions_and_cannon_contacts = fn () => do:
+  let checks = #[]
+  for i in 0 .. 100:
+    let from = math.vec3 (U32.to_f32 (i%13)) 2.0 (-4.0)
+    let to = math.vec3 (-2.0) (U32.to_f32 (i%4)) (U32.to_f32 (i%17))
+    let hop = 4.0 + U32.to_f32 (i%7)*0.25
+    let brick = #salt.Brick {from,to,hop,age:0.0,turn:0.0,flail:0.0,credited:#False,delivery_job:0}
+    let total = (sqrt (2.0*salt.gravity*hop) + sqrt (2.0*salt.gravity*max 0.0 (from.y+hop-to.y)))/salt.gravity
+    let up = sqrt (2.0*salt.gravity*hop)
+    for fraction in #[0.0,0.125,0.5,0.875,1.0,1.25]:
+      let age = min (total*fraction) total
+      let part = age / total
+      let expected = math.vec3 (lerp from.x to.x part) (from.y+up*age-0.5*salt.gravity*age*age) (lerp from.z to.z part)
+      let actual = salt.brick_position brick (total*fraction)
+      checks := array.push (check.equal #[expected.x,expected.y,expected.z] #[actual.x,actual.y,actual.z]) self
+    let shot = #cannon.Shot {kind:0,from:from+math.vec3 10.0 0.0 0.0,to,age:0.0,seed:i}
+    let values = fn (hit: Maybe Impact) => case hit of
+      #Some hit => #[1.0,hit.at.x,hit.at.y,hit.at.z,hit.toward.x,hit.toward.y,hit.toward.z]
+      #Nothing => #[0.0]
+    checks := array.push (check.equal (values (original_impact rock.still shot (duration shot))) (values (cannon.impact rock.still shot (duration shot)))) self
+  return check.report checks
+
