+import { meshes } from "game/assets/catalog.json"
+import * as motion from "ink/motion"
+import * as sort from "ink/sort"
+import * as procedural from "ink/noise"
+import * as math from "ink/math"
+import * as render from "ink/render"
+import { Vec3 } from "std/vector"
+
+type Row = chart.Row
+type Chart = chart.Chart
+type Trails = trails.Trails
+type Clearings = trails.Clearings
+type Shot = cannon.Shot
+type Impact = cannon.Impact
+const row_height = chart.row_height
+const section_height = chart.section_height
+const first_row = chart.first_row
+const cells = trails.cells
+const no_row = trails.no_row
+const packing = trails.packing
+const heaping = trails.heaping
+const duration = cannon.duration
+const ranked = fn (channel: U32) (visible: Array Bool) (rates: Array F32) (previous: Chart) => do:
+  // Stable ties keep the last ranking; reaching equal rates is not overtaking.
+  let jobs = #[row.job | row <- previous.rows, row.channel == channel && visible[channel * salt.job_count + row.job]]
+  for job in 0 .. salt.job_count:
+    if visible[channel * salt.job_count + job] && Bool.not (array.any (fn known => known == job) jobs):
+      jobs := array.push job self
+  let order = sort.order #[0.0 - rates[channel * salt.job_count + job] | job <- jobs]
+  return #[jobs[index] | index <- order]
+const original_chart = fn (seconds: F32) (still: Bool) (visible: Array Bool) (rates: Array F32) (previous: Chart) => do:
+  let snap = still || previous.rows.length == 0
+  let amount = if snap then 1.0 else 1.0 - motion.decay (seconds * 10.0)
+  let getting = ranked 1 visible rates previous
+  let producing = ranked 0 visible rates previous
+  let production_y = first_row + from getting.length * row_height + section_height
+  let height = production_y + from producing.length * row_height + 12.0
+  let rows = #[]
+  for channel in #[1, 0]:
+    let jobs = if channel == 1 then getting else producing
+    let sum = 0.0
+    for job in jobs:
+      sum := self + rates[channel * salt.job_count + job]
+    for index in 0 .. jobs.length:
+      let job = jobs[index]
+      let rate = rates[channel * salt.job_count + job]
+      let share = if sum > 0.0 then rate / sum else 0.0
+      let y = (if channel == 1 then first_row else production_y) + from index * row_height
+      let old = Maybe.unwrap_or (#chart.Row { channel, job, y, share: 0.0, rate: 0.0, shown: 0.0 })
+        (#[row | row <- previous.rows, row.channel == channel && row.job == job].get(0))
+      rows := array.push (#chart.Row { channel, job, y: lerp old.y y amount, share: lerp old.share share amount,
+        rate, shown: lerp old.shown 1.0 amount }) self
+  return #chart.Chart { rows, production_y: lerp previous.production_y production_y amount,
+    height: lerp previous.height height amount, seconds: if still then 0.0 else wrap tau (previous.seconds + seconds * 0.35) }
+const original_surface = fn (ground: Trails) (clearings: Clearings) (x: F32) (z: F32) => do:
+  let sx = (x - shader.origin) / shader.spacing
+  let sz = (z - shader.origin) / shader.spacing
+  let corner_x = clamp 1.0 (U32.to_f32 (cells - 3)) (floor sx)
+  let corner_z = clamp 1.0 (U32.to_f32 (cells - 3)) (floor sz)
+  let wx = procedural.bspline_weights (sx - corner_x)
+  let wz = procedural.bspline_weights (sz - corner_z)
+  let first_x = F32.to_u32 corner_x - 1
+  let first_z = F32.to_u32 corner_z - 1
+  let w = 0.0
+  for b in 0 .. 4:
+    // Each spline row contributes four neighbours; resolve its arrays once.
+    let worn = Maybe.unwrap_or no_row (ground.wear.get(first_z + b))
+    let cleared = Maybe.unwrap_or no_row (clearings.bare.get(first_z + b))
+    for a in 0 .. 4:
+      let value = max worn[first_x + a] (cleared[first_x + a] * 2.0)
+      w := self + value * wx[a] * wz[b]
+  let powder = shader.depth + shader.drift * procedural.authored_value2 shader.hash_scale shader.hash_offset (x * shader.drift_scale) (z * shader.drift_scale)
+  let packs = packing w
+  let laid = powder + (shader.packed - powder) * packs + shader.bank * heaping w
+  let cleared = clamp 0.0 1.0 (w - 1.0)
+  return laid + (shader.bare - laid) * cleared
+
+const original_tile = fn (seen: render.Sight) (pixel_height: F32) (center: Vec3) => do:
+  let view = seen.view
+  let depth = -(view.x.z * center.x + view.y.z * center.y + view.z.z * center.z + view.w.z)
+  let nearest = max seen.near (depth - shader.tile_size * 0.75)
+  let pixels = pixel_height * seen.fy * shader.tile_size / (2.0 * nearest)
+  if pixels <= shader.mesh_pixels * U32.to_f32 shader.mesh_far:
+    return meshes.salt_surface_far
+  if pixels <= shader.mesh_pixels * U32.to_f32 shader.mesh_medium:
+    return meshes.salt_surface_medium
+  return meshes.salt_surface
+
+const position = fn (shot: Shot) (age: F32) => do:
+  let t = clamp 0.0 1.0 (age / duration shot)
+  let rise = max 1.5 ((shot.to - shot.from).length * 0.12)
+  return shot.from.lerp shot.to t + math.up * (4.0 * rise * t * (1.0 - t))
+const original_impact = fn (stone: rock.Rock) (shot: Shot) (until: F32) => do:
+  let steps = max 1 (F32.to_u32 (ceil ((until - shot.age) / duration shot * 32.0)))
+  let before = position shot shot.age
+  for index in 0 .. steps:
+    let at = position shot (shot.age + (until - shot.age) * from (index + 1) / from steps)
+    let travel = at - before
+    let distance = travel.length
+    if distance > 0.000001:
+      let toward = travel / distance
+      // A restored ball can already touch the boundary. Ray picking only
+      // reports positive entry distances, so handle that contact directly.
+      let relative = before - rock.center
+      let inside = relative.x * relative.x + relative.z * relative.z <= square (rock.footprint stone)
+      if inside && relative.y >= 0.0 && relative.y <= rock.height stone:
+        return #Some #cannon.Impact { kind: shot.kind, at: before, toward, seed: shot.seed, hit: #True }
+      if let #Some reach = rock.hit stone #math.Ray { origin: before, direction: toward }:
+        if reach <= distance + 0.0001:
+          return #Some #cannon.Impact { kind: shot.kind, at: before + toward * min reach distance, toward, seed: shot.seed, hit: #True }
+    before := at
+  return #Nothing
+
+
+const chart_values = fn (value: Chart) => array.concat #[value.production_y,value.height,value.seconds]
+  (array.flatten (array.map (fn (row: Row) => #[from row.channel,from row.job,row.y,row.share,row.rate,row.shown]) value.rows))
+entry const test_extracted_reconciliation_preserves_chart_reordering_reveals_and_ties = fn () => do:
+  let expected = chart.empty
+  let actual = chart.empty
+  let checks = #[]
+  for frame in 0 .. 160:
+    let visible = array.generate (salt.job_count*2) (fn i => (frame+i)%7 != 0)
+    let rates = array.generate (salt.job_count*2) (fn i => U32.to_f32 ((i*7+frame*13)%27)*0.125)
+    let before = chart_values actual
+    expected := original_chart 0.016 (frame%31 == 0) visible rates self
+    let next = chart.advanced 0.016 (frame%31 == 0) visible rates actual
+    checks := array.push (check.equal before (chart_values actual)) self
+    actual := next
+    checks := array.push (check.equal (chart_values expected) (chart_values actual)) self
+  return check.report checks
+
+entry const test_extracted_field_kernel_preserves_every_surface_value = fn () => do:
