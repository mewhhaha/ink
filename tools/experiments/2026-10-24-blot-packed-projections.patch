diff --git a/zig-native/tests/packed_rows_execution.test.ts b/zig-native/tests/packed_rows_execution.test.ts
--- a/zig-native/tests/packed_rows_execution.test.ts
+++ b/zig-native/tests/packed_rows_execution.test.ts
@@ -299,3 +299,42 @@
     },
   );
 });
+
+Deno.test("direct nested numeric projections preserve scalar bits bounds producers and snapshots", async () => {
+  await compileAndRun(`
+type Point is data = #Point { x: F32, z: F32 }
+type Row is data = #Row { id: U32, point: Point }
+let rows = @array.generate 1024 (fn i => #Row {id: i, point: #Point {x: from i, z: -0.0}})
+const produced = fn count => do:
+  if count == 0:
+    return @panic "producer must execute"
+  return rows
+entry const total = fn count => do:
+  let sum = 0.0
+  for i in 0 .. count:
+    sum := self + rows[i % 1024].point.x
+  return sum
+entry const selected = fn index => #[(produced 1)[index].point.x, rows[index].point.z]
+entry const producer_trap = fn () => (produced 0)[0].point.x
+entry const cursor = fn count => do:
+  let cursor = (@list.from_array rows).iter
+  for i in 0 .. count:
+    cursor := @cursor.advance self
+  return (@cursor.value cursor).point.x
+entry const snapshot = fn index => do:
+  let next = rows
+  next[index].point.x := 9.0
+  return #[rows[index].point.x, next[index].point.x, from next[index].id]
+`, (guest) => {
+    deepStrictEqual(guest.call("selected", 1023), Float32Array.of(1023, -0));
+    deepStrictEqual(guest.call("snapshot", 127), Float32Array.of(127, 9, 127));
+    for (const n of [0, 1, 82, 83, 255, 1023]) equal(guest.call("cursor", n), n);
+    throws(() => guest.call("selected", 1024));
+    throws(() => guest.call("cursor", 1024));
+    throws(() => guest.call("producer_trap", undefined));
+    equal(guest.call("total", 1024), 523776);
+    const warm = guest.memoryBytes();
+    equal(guest.call("total", 32768), 16760832);
+    equal(guest.memoryBytes() <= warm + 65536, true);
+  });
+});
