import * as array from "std/array"
import * as window from "ink/events"
import * as runtime from "ink/pen/retained"
import * as program from "ink/pen/program"
import * as game from "game/game"
import * as fixture from "./native_fixture"
// Pen's CPU-only benchmark starts with Create. Restore the frozen workload
// at that boundary; initialization is outside its measured frame interval.
const execute = func stored -> command => return do:
  if let $program.Frame payload = command:
    let $Some world = stored else:
      return @panic "fixture must be created first"
    let input = runtime.decode_frame payload
    input.events := array.filter (func event => return case event of
      $window.SessionStarted _ => $False
      _ => $True) self
    let (next, response) = runtime.frame game.played game.state_schema world input
    return ($Some next, response)
  return runtime.execute game.played game.state_schema stored (case command of
    $program.Create => $program.Restore fixture.state
    _ => command)
entry const main = func (host: Array F32 -> Array F32 ! { Foreign }) : Unit ! { Foreign } => return
  program.run execute game.state_schema $False host
