import * as simd from "std/simd"

const integrate = fn (acceleration: F32) (dt: F32) (position: F32) (velocity: F32) => do:
  let next = velocity + acceleration * dt
  return (position + next * dt, next)
const integrate4 = fn (acceleration: F32) (dt: F32) (positions: simd.F32x4) (velocities: simd.F32x4) => do:
  let next = simd.f32_add velocities (simd.f32_splat (acceleration * dt))
  return (simd.f32_add positions (simd.f32_mul next (simd.f32_splat dt)), next)

const integrate_columns = fn (acceleration: F32) (dt: F32) (positions: Array F32) (velocities: Array F32) => do:
  if positions.length != velocities.length:
    return @panic "motion columns must have equal lengths"
  let p = @array.fill positions.length 0.0
  let v = @array.fill positions.length 0.0
  let gain = simd.f32_splat (acceleration * dt)
  let seconds = simd.f32_splat dt
  for group in 0 .. positions.length / 4:
    let i = group * 4
    let next = simd.f32_add (simd.load i velocities) gain
    p := simd.store i (simd.f32_add (simd.load i positions) (simd.f32_mul next seconds)) self
    v := simd.store i next self
  for i in positions.length / 4 * 4 .. positions.length:
    let next = velocities[i] + acceleration * dt
    p[i] := positions[i] + next * dt
    v[i] := next
  return (p,v)

const map4 = fn four one (values: Array a) => do:
  if values.length == 0:
    return #[]
  let output = @array.fill values.length (one values[0])
  let count = values.length / 4
  for group in 0 .. count:
    let i = group * 4
    let (a, b, c, d) = four values[i] values[i + 1] values[i + 2] values[i + 3]
    output[i] := a
    output[i + 1] := b
    output[i + 2] := c
    output[i + 3] := d
  for i in count * 4 .. values.length:
    output[i] := one values[i]
  return output

const map_where = fn predicate transform (values: Array a) => do:
  let first = values.length
  for i in 0 .. values.length:
    if predicate values[i]:
      first := i
      break
  if first == values.length:
    return values
  return @array.generate values.length (fn i =>
    if i >= first && predicate values[i] then transform values[i] else values[i])
