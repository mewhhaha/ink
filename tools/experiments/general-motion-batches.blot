import * as simd from "std/simd"

const integrate = func (acceleration: F32) -> (dt: F32) -> (position: F32) -> (velocity: F32) => return do:
  let next = velocity + acceleration * dt
  return (position + next * dt, next)
const integrate4 = func (acceleration: F32) -> (dt: F32) -> (positions: simd.F32x4) -> (velocities: simd.F32x4) => return do:
  let next = simd.f32_add velocities (simd.f32_splat (acceleration * dt))
  return (simd.f32_add positions (simd.f32_mul next (simd.f32_splat dt)), next)

const integrate_columns_into = func (acceleration: F32) -> (dt: F32) -> (positions: Array F32) -> (velocities: Array F32) -> (p: Array F32) -> (v: Array F32) => return do:
  if positions.length != velocities.length or p.length != positions.length or v.length != positions.length:
    return @panic "motion columns must have equal lengths"
  let gain = simd.f32_splat (acceleration * dt)
  let seconds = simd.f32_splat dt
  for group in 0 .. positions.length / 4:
    let i = group * 4
    let next = simd.f32_add (simd.load i velocities) gain
    simd.store i (simd.f32_add (simd.load i positions) (simd.f32_mul next seconds)) p
    simd.store i next v
  for i in positions.length / 4 * 4 .. positions.length:
    let next = velocities[i] + acceleration * dt
    p[i] := positions[i] + next * dt
    v[i] := next
  return ()

const map4_into = func four -> one -> (values: Array a) => return do:
  let count = values.length / 4
  for group in 0 .. count:
    let i = group * 4
    let (a, b, c, d) = four values[i] values[i + 1] values[i + 2] values[i + 3]
    values[i] := a
    values[i + 1] := b
    values[i + 2] := c
    values[i + 3] := d
  for i in count * 4 .. values.length:
    values[i] := one values[i]
  return ()

const map_where_into = func predicate -> transform -> (values: Array a) => return do:
  let first = values.length
  for i in 0 .. values.length:
    if predicate values[i]:
      first := i
      break
  if first == values.length:
    return ()
  for i in first .. values.length:
    if predicate values[i]:
      values[i] := transform values[i]
  return ()
