+import * as simd from "std/simd"
+import * as check from "test/support/check"
+import * as array from "std/array"
+import * as math from "ink/math"
+import * as changes from "ink/changes"
+import * as salt from "game/salt"
+import * as trails from "game/trails"
+import * as reference from "test/performance_levers/reference_rows"
+
+entry const test_pile_mutations_track_sleep_wake_removal_and_restore = fn () => do:
+  let before = salt.replace_stacks (array.generate 2000 (fn i => salt.resting (from i) 0.0 4 0.0)) salt.none
+  let clean = before
+  clean.changed := changes.empty
+  let (_, lifted) = salt.pull 777 clean
+  let removed = salt.take 4 2 0.0 lifted
+  let dropped = salt.drop_cargo (math.vec3 3000.0 0.0 0.0) 3 removed
+  let restored = salt.decode (salt.encode dropped)
+  return check.report #[check.holds (before.awake.length == 0),
+    check.holds (lifted.awake.length == 1 && lifted.awake[0] == before.stacks[777].id),
+    check.holds (lifted.changed.updated.length == 1 && lifted.changed.updated[0] == lifted.awake[0]),
+    check.holds (removed.changed.removed.length == 1 && removed.changed.removed[0] == before.stacks[2].id),
+    check.holds (dropped.awake.length == 2 && restored.awake.length == 2),
+    check.holds restored.changed.reset, check.equal (salt.encode dropped) (salt.encode restored),
+    check.holds (before.stacks[777].lift == 0.0 && before.stacks.length == 2000)]
+
+const bits_equal = fn (a: Array F32) (b: Array F32) => do:
+  if a.length != b.length:
+    return #False
+  for i in 0 .. a.length:
+    let (left, _, _, _) = simd.f32_bits (a[i],0.0,0.0,0.0)
+    let (right, _, _, _) = simd.f32_bits (b[i],0.0,0.0,0.0)
+    if left != right:
+      return #False
+  return #True
+entry const test_bounded_stamping_matches_original_every_cell_and_preserves_inputs = fn () => do:
+  let initial = trails.tread 1.0 1.0 0.4 trails.empty
+  let old = initial
+  let now = initial
+  let matched = #True
+  for step in 0 .. 12:
+    let stamps = array.generate (step*7+1) (fn i => math.vec3
+      (U32.to_f32 ((i*113+step*19)%800) * 0.25 - 100.0)
+      (U32.to_f32 ((i*71+step*3)%800) * 0.25 - 100.0)
+      (U32.to_f32 (i%9+1) * 0.1))
+    old := reference.stamped stamps self
+    now := trails.stamped stamps self
+    for row in 0 .. trails.cells:
+      matched := self && bits_equal old.wear[row] now.wear[row] && bits_equal old.rest[row] now.rest[row]
+  return check.report #[check.holds matched,
+    check.equal (trails.encode (trails.tread 1.0 1.0 0.4 trails.empty)) (trails.encode initial)]
