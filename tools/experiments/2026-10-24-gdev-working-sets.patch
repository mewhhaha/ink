diff --git a/tests/performance_levers/reference_rows.blot b/tests/performance_levers/reference_rows.blot
new file mode 100644
--- /dev/null
+++ b/tests/performance_levers/reference_rows.blot
@@ -0,0 +1,38 @@
+import * as array from "std/array"
+import * as trails from "../../src/trails"
+import * as shader from "../../src/assets/salt_surface.wgsl"
+import { Vec3 } from "std/vector"
+const cells = trails.cells
+const footprint = trails.footprint
+const no_row = trails.no_row
+const trodden_by = trails.trodden_by
+const weight_at = trails.weight_at
+type Row = trails.Row
+const stamped = fn (stamps: Array Vec3) (regrown: trails.Trails) => do:
+  let rows = array.generate cells $ fn row => do:
+    let z = shader.origin + U32.to_f32 row * shader.spacing
+    let near = #[stamp | stamp <- stamps, abs (stamp.y - z) < footprint]
+    // `no_row` rather than a fresh row: `unwrap_or` takes its default made,
+    // and a stamp that made two rows a row for the whole field each time ran
+    // long walks out of memory.
+    let old = Maybe.unwrap_or no_row (regrown.wear.get(row))
+    let rested = Maybe.unwrap_or no_row (regrown.rest.get(row))
+    if near.length == 0:
+      return #trails.Row { wear: old, rest: rested }
+    let wear = array.generate cells $ fn column => do:
+      let x = shader.origin + U32.to_f32 column * shader.spacing
+      let value = old[column]
+      for stamp in near:
+        let dx = x - stamp.x
+        let dz = z - stamp.y
+        value := trodden_by self stamp.z (weight_at dx dz)
+      return value
+    let rest = array.generate cells $ fn column => do:
+      let x = shader.origin + U32.to_f32 column * shader.spacing
+      for stamp in near:
+        if weight_at (x - stamp.x) (z - stamp.y) > 0.0:
+          return 0.0
+      return rested[column]
+    return #trails.Row { wear, rest }
+  let drift = if regrown.drift.length == 0 then array.fill cells no_row else regrown.drift
+  return #trails.Trails { wear: #[row.wear | row <- rows], rest: #[row.rest | row <- rows], drift }
diff --git a/tests/performance_levers/replay.blot b/tests/performance_levers/replay.blot
new file mode 100644
--- /dev/null
+++ b/tests/performance_levers/replay.blot
@@ -0,0 +1,23 @@
+import * as array from "std/array"
+import * as window from "ink/events"
+import * as runtime from "ink/pen/retained"
+import * as program from "ink/pen/program"
+import * as game from "game/game"
+import * as fixture from "./native_fixture"
+// Pen's CPU-only benchmark starts with Create. Restore the frozen workload
+// at that boundary; initialization is outside its measured frame interval.
+const execute = fn stored command => do:
+  if let #program.Frame payload = command:
+    let #Some world = stored else:
+      return @panic "fixture must be created first"
+    let input = runtime.decode_frame payload
+    input.events := array.filter (fn event => case event of
+      #window.SessionStarted _ => #False
+      _ => #True) self
+    let (next, response) = runtime.frame game.played game.state_schema world input
+    return (#Some next, response)
+  return runtime.execute game.played game.state_schema stored (case command of
+    #program.Create => #program.Restore fixture.state
+    _ => command)
+entry const main = fn (host: Array F32 -> Array F32 ! { Foreign }) -> Unit ! { Foreign } =>
+  program.run execute game.state_schema #False host
