import * as array from "std/array"
import * as math from "ink/math"
import * as codec from "ink/codec"
import * as transform from "ink/transform"
const matrix = fn a => fn b => fn t => transform.matrix (transform.interpolate a b t)
entry const matrices = fn count => do:
  let out = array.fill (count * 16) 0
  for i in 0 .. count:
    let x = U32.to_f32 (i % 100) * 0.01
    let q = if i % 7 == 0 then 1.0e30 else if i % 7 == 1 then 1.0e-30 else if i % 7 == 2 then 0.0 else 1.0
    let a = #transform.Pose3 { position: math.vec3 x (-1.0) 2.0, rotation: #math.Quat { x: q * x, y: q, z: q * 0.2, w: q * 0.5 }, scale: math.vec3 0.0 (-2.0) 3.0 }
    let b = #transform.Pose3 { position: math.vec3 (-x) 3.0 (-2.0), rotation: #math.Quat { x: q * 0.3, y: q * x, z: q * 0.7, w: F32.neg q }, scale: math.vec3 (-4.0) 5.0 0.0 }
    let m = matrix a b (x * 3.0 - 1.0)
    let values = array.map codec.float_word #[m.xx, m.xy, m.xz, m.xw, m.yx, m.yy, m.yz, m.yw, m.zx, m.zy, m.zz, m.zw, m.wx, m.wy, m.wz, m.ww]
    for lane in 0 .. 16:
      out[i * 16 + lane] := values[lane]
  return out
