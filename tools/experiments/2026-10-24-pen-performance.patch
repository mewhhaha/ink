@@ -0,0 +1,11 @@
+//! Generate packet bindings without building the renderer or desktop host.
+fn main() -> anyhow::Result<()> {
+    let args: Vec<String> = std::env::args().collect();
+    let value = |key: &str| args.iter().position(|arg| arg == key).and_then(|i| args.get(i + 1));
+    let project = value("--project").ok_or_else(|| anyhow::anyhow!("missing --project"))?;
+    pen_codegen::generate(
+        std::path::Path::new(project),
+        value("--rust").map(std::path::Path::new),
+        args.iter().any(|arg| arg == "--check"),
+    )
+}
