diff --git a/crates/blot-host/examples/compare_batch.rs b/crates/blot-host/examples/compare_batch.rs
new file mode 100644
--- /dev/null
+++ b/crates/blot-host/examples/compare_batch.rs
@@ -0,0 +1,60 @@
+//! End-to-end guest -> copied batch -> isolated CPU workers -> guest comparison.
+use anyhow::{Result, ensure};
+use blot_host::{Argument, Guest, GuestModule, Value, workers::Batches};
+use serde_json::json;
+use std::time::Instant;
+fn main() -> Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    ensure!(args.len() == 2, "compare_batch MODULE.wasm OUTPUT.json");
+    let engine = blot_host::engine()?;
+    let bytes = std::fs::read(&args[0])?;
+    let module = GuestModule::new(&engine, &bytes, None)?;
+    let mut direct = Guest::new(&engine, &module)?;
+    let reference = direct.call("sequential", Value::Unit)?.into_f32_array()?;
+    let reference: Vec<_> = reference.iter().map(|v| v.to_bits()).collect();
+    let mut rows = Vec::new();
+    for count in [1, 4] {
+        let mut samples = [Vec::new(), Vec::new()];
+        for round in 0..16 {
+            for method in if round % 2 == 0 { [0, 1] } else { [1, 0] } {
+                let started = Instant::now();
+                let result = if method == 0 {
+                    direct.call("sequential", Value::Unit)?.into_f32_array()?
+                } else {
+                    let mut guest = Guest::new(&engine, &module)?;
+                    let mut batches = Batches::new(&engine, &module, count)?;
+                    let callback =
+                        Box::new(move |value: Value| Ok(Value::ArrayF32(batches.run(&value.into_f32_array()?)?)));
+                    let result = guest.call("batch", Argument::Callback(callback))?.into_f32_array()?;
+                    guest.dispose()?;
+                    result
+                };
+                let elapsed = started.elapsed().as_secs_f64() * 1000.0;
+                ensure!(
+                    result.iter().map(|v| v.to_bits()).collect::<Vec<_>>() == reference,
+                    "different planning result"
+                );
+                if round >= 5 {
+                    samples[method].push(elapsed);
+                }
+            }
+        }
+        let median: Vec<_> = samples
+            .iter()
+            .map(|s| {
+                let mut s = s.clone();
+                s.sort_by(f64::total_cmp);
+                s[5]
+            })
+            .collect();
+        rows.push(json!({"workers":count,"samplesMs":samples,"medianMs":median,"ratio":median[1]/median[0]}));
+    }
+    direct.dispose()?;
+    std::fs::write(
+        &args[1],
+        serde_json::to_vec_pretty(
+            &json!({"includes":"input geometry encoding, guest batch transport, cold pool and instances, ordered results, output decoding, pool shutdown; compiled module excluded", "rows":rows}),
+        )?,
+    )?;
+    Ok(())
+}
diff --git a/crates/blot-host/examples/replay_cpu.rs b/crates/blot-host/examples/replay_cpu.rs
new file mode 100644
--- /dev/null
+++ b/crates/blot-host/examples/replay_cpu.rs
@@ -0,0 +1,98 @@
+//! Linux guest-thread CPU replay; validation and hashing are outside timings.
+use anyhow::{Result, ensure};
+use blot_host::{Argument, Guest, GuestModule, Value};
+use pen_protocol::boundary::{decode_frame, read_catalog};
+use pen_runtime::instances::Instances;
+use sha2::{Digest, Sha256};
+use std::{
+    path::Path,
+    sync::{Arc, Mutex},
+    time::Instant,
+};
+#[repr(C)]
+struct Timespec {
+    seconds: std::os::raw::c_long,
+    nanos: std::os::raw::c_long,
+}
+unsafe extern "C" {
+    fn clock_gettime(clock: std::os::raw::c_int, time: *mut Timespec) -> std::os::raw::c_int;
+}
+fn cpu() -> f64 {
+    let mut t = Timespec { seconds: 0, nanos: 0 };
+    // Linux CLOCK_THREAD_CPUTIME_ID; a writable timespec with the C layout.
+    assert_eq!(unsafe { clock_gettime(3, &mut t) }, 0);
+    t.seconds as f64 * 1000.0 + t.nanos as f64 / 1e6
+}
+fn main() -> Result<()> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    ensure!(args.len() == 3, "replay_cpu WASM ASSETS OUTPUT.json");
+    let bytes = std::fs::read(&args[0])?;
+    let wasm = format!("{:x}", Sha256::digest(&bytes));
+    let engine = blot_host::engine()?;
+    let module = GuestModule::new(&engine, &bytes, None)?;
+    let catalog = read_catalog(Path::new(&args[1]))?;
+    let captured = Arc::new(Mutex::new(serde_json::Value::Null));
+    let output = captured.clone();
+    let mut phase = 0;
+    let mut tick = 0;
+    let mut schema = 0;
+    let mut started = 0.0;
+    let mut wall = Instant::now();
+    let mut samples = Vec::new();
+    let mut wall_samples = Vec::new();
+    let mut packet_bytes = Vec::new();
+    let mut cache = Instances::default();
+    let callback = Box::new(move |value: Value| -> Result<Value> {
+        let duration = cpu() - started;
+        let wall_ms = wall.elapsed().as_secs_f64() * 1000.0;
+        let packet = value.into_f32_array()?;
+        let next = match phase {
+            0 => {
+                ensure!(packet[0] == 4670544.0, "handshake");
+                schema = packet[2] as u32;
+                phase = 1;
+                vec![1.0, 1.0]
+            }
+            1 => {
+                ensure!(packet[0] == 1.0, "create");
+                phase = 2;
+                vec![1.0, 2.0, 1.0 / 60.0, 1280.0, 720.0, 0.0, 0.0]
+            }
+            2 => {
+                ensure!(packet[0] == 2.0, "frame");
+                let mut frame = decode_frame(&packet[1..], schema, &catalog)?.render;
+                cache.prepare(&mut frame)?.commit(&mut cache);
+                if tick >= 120 {
+                    samples.push(duration);
+                    wall_samples.push(wall_ms);
+                    packet_bytes.push(packet.len() * 4);
+                }
+                tick += 1;
+                if tick == 600 {
+                    phase = 3;
+                    vec![1.0, 3.0]
+                } else {
+                    vec![1.0, 2.0, 1.0 / 60.0, 1280.0, 720.0, 0.0, 0.0]
+                }
+            }
+            _ => {
+                ensure!(packet[0] == 3.0, "snapshot");
+                let saved: Vec<u8> = packet.iter().flat_map(|v| v.to_le_bytes()).collect();
+                let mut sorted = samples.clone();
+                sorted.sort_by(f64::total_cmp);
+                *output.lock().unwrap() = serde_json::json!({"cpuMs":samples,"wallMs":wall_samples,"medianCpuMs":sorted[sorted.len()/2],"p95CpuMs":sorted[sorted.len()*95/100],"saveSha256":format!("{:x}",Sha256::digest(&saved)),"packetBytes":packet_bytes});
+                vec![1.0, 0.0]
+            }
+        };
+        started = cpu();
+        wall = Instant::now();
+        Ok(Value::ArrayF32(next))
+    });
+    let mut guest = Guest::new(&engine, &module)?;
+    guest.call("main", Argument::Callback(callback))?;
+    guest.dispose()?;
+    let mut result = captured.lock().unwrap().clone();
+    result["wasm"] = serde_json::json!(wasm);
+    std::fs::write(&args[2], serde_json::to_vec_pretty(&result)?)?;
+    Ok(())
+}
diff --git a/crates/blot-host/src/workers.rs b/crates/blot-host/src/workers.rs
--- a/crates/blot-host/src/workers.rs
+++ b/crates/blot-host/src/workers.rs
@@ -150,3 +150,88 @@
         let _ = self.close();
     }
 }
+
+/// Native main(host) pure planning exchange, separate from frame packets.
+/// No work survives the call: all answers join in input order, and a reload
+/// drops the pool. The guest commits intentions only after this returns.
+pub const BATCH_MAGIC: f32 = -4_670_545.0;
+fn integer(value: f32, limit: usize) -> Result<usize> {
+    ensure!(
+        value.is_finite() && value >= 0.0 && value <= limit as f32 && value.fract() == 0.0,
+        "invalid worker batch length"
+    );
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss, reason = "bounded integral lane")]
+    Ok(value as usize)
+}
+fn decode_batch(packet: &[f32]) -> Result<Vec<Value>> {
+    ensure!(packet.len() >= 2 && packet[0] == BATCH_MAGIC, "invalid worker batch header");
+    let count = integer(packet[1], MAX_BATCH)?;
+    let mut at = 2;
+    let mut inputs = Vec::with_capacity(count);
+    for _ in 0..count {
+        let length = integer(*packet.get(at).context("truncated worker length")?, MAX_LANES)?;
+        at += 1;
+        let values = packet.get(at..at + length).context("truncated worker input")?;
+        inputs.push(Value::ArrayF32(values.to_vec()));
+        at += length;
+    }
+    ensure!(at == packet.len(), "trailing worker input");
+    Ok(inputs)
+}
+pub struct Batches {
+    engine: Engine,
+    module: GuestModule,
+    pool: Option<Workers>,
+    count: usize,
+}
+impl Batches {
+    pub fn new(engine: &Engine, module: &GuestModule, count: usize) -> Result<Self> {
+        ensure!((1..=MAX_WORKERS).contains(&count), "worker count must be 1..={MAX_WORKERS}");
+        Ok(Self { engine: engine.clone(), module: module.clone(), pool: None, count })
+    }
+    /// Lazily start workers only for a valid nonempty batch. Malformed input
+    /// never starts partial work. Array lengths, including outputs, are bounded.
+    pub fn run(&mut self, packet: &[f32]) -> Result<Vec<f32>> {
+        let inputs = decode_batch(packet)?;
+        if inputs.is_empty() {
+            return Ok(vec![BATCH_MAGIC, 0.0]);
+        }
+        if self.pool.is_none() {
+            let entry = self.module.abi().function("plan").context("missing pure plan entry")?;
+            ensure!(
+                entry.parameter == Parameter::Value(crate::ValueType::ArrayF32)
+                    && entry.result == crate::ValueType::ArrayF32,
+                "plan must be Array F32 -> Array F32"
+            );
+            self.pool = Some(Workers::new(&self.engine, &self.module, "plan", self.count)?);
+        }
+        let mut output = vec![BATCH_MAGIC, inputs.len() as f32];
+        let answers = self.pool.as_mut().expect("started pool").run(inputs)?;
+        for answer in answers {
+            let values = answer.map_err(anyhow::Error::msg)?.into_f32_array()?;
+            output.push(values.len() as f32);
+            output.extend(values);
+        }
+        Ok(output)
+    }
+}
+#[cfg(test)]
+mod batch_tests {
+    use super::*;
+    #[test]
+    fn validates_whole_batches_before_execution() {
+        assert_eq!(decode_batch(&[BATCH_MAGIC, 0.0]).unwrap().len(), 0);
+        assert_eq!(decode_batch(&[BATCH_MAGIC, 2.0, 1.0, 4.0, 0.0]).unwrap().len(), 2);
+        for packet in [
+            vec![],
+            vec![BATCH_MAGIC, 33.0],
+            vec![BATCH_MAGIC, f32::NAN],
+            vec![BATCH_MAGIC, 1.0, 16385.0],
+            vec![BATCH_MAGIC, 1.0, 2.0, 1.0],
+            vec![BATCH_MAGIC, 0.0, 1.0],
+            vec![BATCH_MAGIC, 1.0, -1.0],
+        ] {
+            assert!(decode_batch(&packet).is_err());
+        }
+    }
+}
