+//! Headless retained protocol comparison. Includes packet decode and view assembly;
+//! excludes GPU rendering, guest serialization and initial packet construction.
+use pen_protocol::boundary::*;
+use pen_protocol::{Catalog, RenderFrame};
+use pen_runtime::instances::Instances;
+use std::time::Instant;
+fn packet(count: usize, tick: usize, retained: bool) -> Vec<f32> {
+    let changes = if retained && tick > 0 { count / 100 } else { count };
+    let stride = if retained { INSTANCE_FLOATS } else { DRAW_FLOATS };
+    let mut packet = vec![0.0; PACKET_HEADER_FLOATS + changes * stride];
+    packet[0] = PACKET_MAGIC;
+    packet[1] = 1.0;
+    if retained {
+        packet[lanes::header::RETAINED_ENABLED] = 1.0;
+        packet[lanes::header::RETAINED_RESET] = f32::from(tick == 0);
+        packet[lanes::header::INSTANCE_COUNT] = changes as f32;
+    } else {
+        packet[lanes::header::DRAW_COUNT] = changes as f32;
+    }
+    for i in 0..changes {
+        let base = PACKET_HEADER_FLOATS + i * stride;
+        let transform = base + if retained { lanes::instance::TRANSFORM } else { lanes::draw::TRANSFORM };
+        if retained {
+            packet[base] = (i & 65535) as f32;
+            packet[base + 1] = (i >> 16) as f32;
+            packet[base + 2] = i as f32;
+        }
+        for offset in [0, 5, 10, 15] {
+            packet[transform + offset] = 1.0;
+        }
+        packet[transform + 12] = i as f32 + if i < count / 100 { tick as f32 / 16.0 } else { 0.0 };
+    }
+    packet
+}
+fn main() -> anyhow::Result<()> {
+    let catalog = Catalog { meshes: vec!["mesh".into()], materials: vec!["mat".into()], sounds: vec![] };
+    let count = 4096;
+    let packets: Vec<Vec<Vec<f32>>> =
+        [false, true].iter().map(|&retained| (0..16).map(|tick| packet(count, tick, retained)).collect()).collect();
+    let mut samples: [Vec<f64>; 2] = Default::default();
+    let mut final_frames = [RenderFrame::default(), RenderFrame::default()];
+    for round in 0..40 {
+        for turn in 0..2 {
+            let index = (round + turn) % 2;
+            let start = Instant::now();
+            let mut cache = Instances::default();
+            let mut frame = RenderFrame::default();
+            for packet in &packets[index] {
+                decode_into(packet, 1, &catalog, &mut frame)?;
+                cache.prepare(&mut frame)?.commit(&mut cache);
+                std::hint::black_box(&frame);
+            }
+            if round >= 20 {
+                samples[index].push(start.elapsed().as_secs_f64() * 1000.0);
+            }
+            final_frames[index] = frame;
+        }
+        assert_eq!(final_frames[0].draws, final_frames[1].draws);
+    }
+    for (index, values) in samples.iter_mut().enumerate() {
+        values.sort_by(f64::total_cmp);
+        println!(
+            "{}: {:.4} ms median, {} packet bytes; 4096 instances / 16 frames / 1% dirty",
+            if index == 0 { "immediate" } else { "retained" },
+            values[values.len() / 2],
+            packets[index].iter().map(|p| p.len() * 4).sum::<usize>()
+        );
+    }
+    Ok(())
+}
