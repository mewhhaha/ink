+++ b/crates/blot-host/tests/fixtures/worker_sessions.blot
@@ -0,0 +1,26 @@
+entry const service = fn (host: Array F32 -> Array F32 ! { Foreign }) -> Unit ! { Foreign } => do:
+  let prepared = 0.0
+  let response = #[@f32.neg 4670546.0]
+  for 0 .. 0xFFFFFFFF:
+    use request <- host response
+    if @f32.eq (@array.get request 0) 0.0:
+      return ()
+    if @f32.eq (@array.get request 0) 1.0:
