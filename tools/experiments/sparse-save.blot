import * as array from "std/array"
import * as codec from "ink/codec"
import * as ecs from "ink/ecs"
import * as words from "ink/persist/words"
type Item is data = $Item U32
const item_codec = codec.saved 0xFFFFFFFF 1 (func (value: Item) => return do:
  let $Item value = value
  return #[value]) (func (values: Array U32) => return if values.length == 1 then $Some ($Item values[0]) else $Nothing) codec.no_migration
const simulation = do:
  let builder = ecs.new ()
  builder := ecs.register_snapshotted_component ($Item 0) self
  break ecs.build builder
const saves = words.snapshotted_component item_codec ($Item 0) (words.new ())
const saved = func (history: U32) => return do:
  let (_, result) = ecs.create simulation (func () => return do:
    use ecs.replace_entities (array.generate history (func i => return i >= history - 64))
    use ecs.insert_many $Item (history - 64) (array.generate 64 (func i => return $Item (0x80000000 + i)))
    use ecs.checkpoint simulation
    use ecs.at (history - 32) (func () => return ecs.set ($Item 0xFFFFFFFF))
    use ecs.despawn (history - 1)
    return words.encode_state saves 1)
  return result
entry const save = saved
entry const roundtrip = func history => return do:
  let original = saved history
  let (_, result) = ecs.create simulation (func () => return do:
    use words.decode_state saves 1 original
    return words.encode_state saves 1)
  return result
