import * as array from "std/array"
import * as codec from "ink/codec"
import * as ecs from "ink/ecs"
import * as words from "ink/persist/words"
type Item is data = #Item U32
const item_codec = codec.saved 0xFFFFFFFF 1 (fn (value: Item) => do:
  let #Item value = value
  return #[value]) (fn (values: Array U32) => if values.length == 1 then #Some (#Item values[0]) else #Nothing) codec.no_migration
const simulation = do:
  let builder = ecs.new ()
  builder := ecs.register_snapshotted_component (#Item 0) self
  break ecs.build builder
const saves = words.snapshotted_component item_codec (#Item 0) (words.new ())
const saved = fn (history: U32) => do:
  let (_, result) = ecs.create simulation (fn () => do:
    use ecs.replace_entities (array.generate history (fn i => i >= history - 64))
    use ecs.insert_many #Item (history - 64) (array.generate 64 (fn i => #Item (0x80000000 + i)))
    use ecs.checkpoint simulation
    use ecs.at (history - 32) (fn () => ecs.set (#Item 0xFFFFFFFF))
    use ecs.despawn (history - 1)
    return words.encode_state saves 1)
  return result
entry const save = saved
entry const roundtrip = fn history => do:
  let original = saved history
  let (_, result) = ecs.create simulation (fn () => do:
    use words.decode_state saves 1 original
    return words.encode_state saves 1)
  return result
