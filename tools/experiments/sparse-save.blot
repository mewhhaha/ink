import * as array from "std/array"
import * as codec from "ink/codec"
import * as ecs from "ink/ecs"
import * as persist from "ink/persist"
import * as words from "ink/persist/words"
type Item is data = $Item U32
const item_codec = codec.saved 0xFFFFFFFF 1 (func (value: Item) => return do:
  let $Item value = value
  return #[value]) (func (values: Array U32) => return if values.length == 1 then $Some ($Item values[0]) else $Nothing) codec.no_migration
type State = {alive: ecs.Entities, entity_meta: ecs.Metadata, current: ecs.Pool Item, current_meta: ecs.Metadata, previous: ecs.Pool Item, previous_meta: ecs.Metadata}
func encode (state: State) -> sections -> payload => return do:
  words.write_alive state.alive sections payload
  words.write_snapshotted_component item_codec state.current state.previous sections payload
func decode (state: own State) -> sections -> input -> outcomes => return do:
  state.entity_meta := words.restore_alive sections input state.alive state.entity_meta outcomes
  let (current, current_meta, previous, previous_meta) = words.restore_snapshotted_component item_codec state.alive state.current state.current_meta state.previous state.previous_meta sections input outcomes
  state.current := current
  state.current_meta := current_meta
  state.previous := previous
  state.previous_meta := previous_meta
  return state
func saved (history: U32) : Array U32 => return do:
  if history < 64:
    return @panic "sparse save needs at least 64 entity IDs"
  let alive: ecs.Entities = #[]
  let entity_meta = ecs.metadata 1
  let current: ecs.Pool Item = ecs.pool ()
  let current_meta = ecs.metadata 1
  let previous: ecs.Pool Item = ecs.pool ()
  let previous_meta = ecs.metadata 1
  for i in 0 .. history:
    @storage.push alive (i >= history - 64)
  ecs.insert_selected alive current current_meta (array.generate 64 (func i => return history - 64 + i)) (array.generate 64 (func i => return $Item (0x80000000 + i)))
  ecs.checkpoint identity previous current
  ecs.insert alive current current_meta (history - 32) ($Item 0xFFFFFFFF)
  ecs.remove current current_meta (history - 1)
  ecs.despawn alive entity_meta (history - 1)
  let sections: ResizeArray words.Section = #[]
  let payload: ResizeArray U32 = #[]
  let destination: ResizeArray U32 = #[]
  words.encode_state 1 sections payload encode {alive, entity_meta, current, current_meta, previous, previous_meta} destination
  return @storage.freeze destination
entry func save (history: U32) : Array U32 => return saved history
entry func restore (original: Array U32) : Array U32 => return do:
  let alive = ecs.entities ()
  let entity_meta = ecs.metadata 2
  let current: ecs.Pool Item = ecs.pool ()
  let current_meta = ecs.metadata 2
  let previous: ecs.Pool Item = ecs.pool ()
  let previous_meta = ecs.metadata 2
  let sections: ResizeArray words.Section = #[]
  let payload: ResizeArray U32 = #[]
  let outcomes: ResizeArray persist.Outcome = #[]
  let destination: ResizeArray U32 = #[]
  let state = {alive, entity_meta, current, current_meta, previous, previous_meta}
  let state = words.decode_state 1 original sections decode state outcomes
  words.encode_state 1 sections payload encode state destination
  return @storage.freeze destination
entry func roundtrip (history: U32) : Array U32 => return restore (saved history)
